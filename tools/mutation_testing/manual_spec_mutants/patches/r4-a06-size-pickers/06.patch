# MANUAL SPEC MUTANT r4-a06-size-pickers/06
# type: BitsStruct
# ops: encode
# spec: the encoding of a Bitlist of k bits is floor(k / 8) + 1 bytes (the delimiter bit always adds a bit)
# fault: the size is ceil(k / 8) (the delimiter byte is not counted when k is not a multiple of 8... and lost when it is)
# why: bits to bytes rounding without the delimiter
# file: src/obj.bend
# sym: bsz_pick,bits_sizek
--- a/src/obj.bend
+++ b/src/obj.bend
@@ -1808,3 +1808,3 @@
   (ws, +c) = pair
-  (Bits{ws, k}, pick(U32.is_le((U32.shrn(k, 5n) + 1 : U32), c), (U32.shrn(k, 3n) + 1 : U32), 4294967295))
+  (Bits{ws, k}, pick(U32.is_le((U32.shrn(k, 5n) + 1 : U32), c), U32.shrn((k + 7 : U32), 3n), 4294967295))
 
