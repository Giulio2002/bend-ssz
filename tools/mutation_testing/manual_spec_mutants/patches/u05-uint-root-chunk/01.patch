# MANUAL SPEC MUTANT u05-uint-root-chunk/01
# type: uint16
# ops: root
# spec: hash_tree_root of a uintN is its little-endian serialization right-padded to 32 bytes
# fault: the 32-bit scalar chunk is built without the byte swap (big-endian value in the first word)
# why: confusing the SHA-256 big-endian word order with SSZ little-endian bytes
# file: src/obj.bend
--- a/src/obj.bend
+++ b/src/obj.bend
@@ -1054,3 +1054,3 @@
 
-def u32_chunk(+v: U32) -> D.Digest: D.D{B.swap32(v), 0, 0, 0, 0, 0, 0, 0}
+def u32_chunk(+v: U32) -> D.Digest: D.D{v, 0, 0, 0, 0, 0, 0, 0}
 
