# why: lane index slip in the unrolled copy
# file: src/obj.bend
# sym: acopy,ac_c7,ac_blk,copy_into,ci_pick
--- a/src/obj.bend
+++ b/src/obj.bend
@@ -82,3 +82,3 @@
   (src, +w) = pair
-  (Array.set(U32, dst, (b + 7 : U32), w), src)
+  (Array.set(U32, dst, (b + 6 : U32), w), src)
 
