# MANUAL SPEC MUTANT bl01-bitlist-delimiter-decode/01
# type: bitlist_5
# ops: decode
# spec: a Bitlist value's last byte must be non-zero (it holds the delimiter bit)
# fault: a zero last byte is accepted (no delimiter required)
# why: treating the delimiter as optional
# file: src/obj.bend
--- a/src/obj.bend
+++ b/src/obj.bend
@@ -1133,3 +1133,3 @@
   (buf, +v) = pair
-  (buf, bsel(U32.is_eq(v, 0), False{},
+  (buf, bsel(U32.is_eq(v, 0), True{},
     bsel(big, U32.is_lt((len - 1 : U32), 536870912), Nat.is_le(Nat.add(Nat.mul(8n, U32.to_nat((len - 1 : U32))), U32.to_nat(high_bit(v))), U32.to_nat(lim)))))
