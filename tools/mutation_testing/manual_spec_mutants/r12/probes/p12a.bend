  (h, r) = pair
  (c, d) = r
  IO.print("c2 l2_ConsolidationRequest cached=" ++ rs(d) ++ " plain_uncache=" ++ k2_plain(K2H.l2_ConsolidationRequest_root(64n, O.hasher(), K2.l2_ConsolidationRequest_uncache(c), 0)) ++ " plain_fresh=" ++ k2_plain(K2H.l2_ConsolidationRequest_root(64n, O.hasher(), k2_two(), 0)) ++ " len_uncache=" ++ k2_len(K2.l2_ConsolidationRequest_len(K2.l2_ConsolidationRequest_uncache(K2.l2_ConsolidationRequest_cache(k2_two())))))

def k3_fst(pair: K3.l16_Withdrawal_Seq & Bool) -> K3.l16_Withdrawal_Seq:
  (o, ok) = pair
  o
def k3_two() -> K3.l16_Withdrawal_Seq: k3_fst(K3.l16_Withdrawal_append(k3_fst(K3.l16_Withdrawal_append(K3.l16_Withdrawal_default(), FuluWithdrawal_d.Withdrawal_default())), FuluWithdrawal_d.Withdrawal_default()))
