  (h, r) = pair
  (c, d) = r
  IO.print("c3 l16_Withdrawal cached=" ++ rs(d) ++ " plain_uncache=" ++ k3_plain(K3H.l16_Withdrawal_root(64n, O.hasher(), K3.l16_Withdrawal_uncache(c), 0)) ++ " plain_fresh=" ++ k3_plain(K3H.l16_Withdrawal_root(64n, O.hasher(), k3_two(), 0)) ++ " len_uncache=" ++ k3_len(K3.l16_Withdrawal_len(K3.l16_Withdrawal_uncache(K3.l16_Withdrawal_cache(k3_two())))))

def dispatch(+c: U32) -> IO(Unit):
  match c:
    case 1: k1_cmp(K1.l1_AttesterSlashing_cached_root(64n, O.hasher(), K1.l1_AttesterSlashing_cache(k1_two()), 0))
    case 2: k2_cmp(K2.l2_ConsolidationRequest_cached_root(64n, O.hasher(), K2.l2_ConsolidationRequest_cache(k2_two()), 0))
    case _: k3_cmp(K3.l16_Withdrawal_cached_root(64n, O.hasher(), K3.l16_Withdrawal_cache(k3_two()), 0))

def main() -> IO(Unit):
  do IO<Unit>:
    +c : U32 <- IOx.env_u32("SSZ_CASE")
    dispatch(c)
