# Round-12 probe a (generated by r12/mkprobe12.py): X_cache of a non-empty list, X_cached_root, X_uncache; public calls only.
# SSZ_CASE: 1 Fulu_list_AttesterSlashing_1, 2 Fulu_list_ConsolidationRequest_2, 3 Fulu_list_Withdrawal_16

def rs(d: D.Digest) -> String:
  match d:
    case D.D{+a, +b1, +c, +d1, +e, +f, +g, +h}: U32.show(a) ++ "," ++ U32.show(b1) ++ "," ++ U32.show(h)

def k1_fst(pair: K1.l1_AttesterSlashing_Seq & Bool) -> K1.l1_AttesterSlashing_Seq:
  (o, ok) = pair
  o
def k1_two() -> K1.l1_AttesterSlashing_Seq: k1_fst(K1.l1_AttesterSlashing_append(K1.l1_AttesterSlashing_default(), FuluAttesterSlashing_d.AttesterSlashing_default()))
def k1_plain(pair: B.Buf & (K1.l1_AttesterSlashing_Seq & D.Digest)) -> String:
  (h, r) = pair
  (o, d) = r
  rs(d)
def k1_len(pair: K1.l1_AttesterSlashing_Seq & U32) -> String:
  (o, +n) = pair
  U32.show(n)
def k1_cmp(pair: B.Buf & (K1.l1_AttesterSlashing_Cached & D.Digest)) -> IO(Unit):
  (h, r) = pair
  (c, d) = r
  IO.print("c1 l1_AttesterSlashing cached=" ++ rs(d) ++ " plain_uncache=" ++ k1_plain(K1H.l1_AttesterSlashing_root(64n, O.hasher(), K1.l1_AttesterSlashing_uncache(c), 0)) ++ " plain_fresh=" ++ k1_plain(K1H.l1_AttesterSlashing_root(64n, O.hasher(), k1_two(), 0)) ++ " len_uncache=" ++ k1_len(K1.l1_AttesterSlashing_len(K1.l1_AttesterSlashing_uncache(K1.l1_AttesterSlashing_cache(k1_two())))))

