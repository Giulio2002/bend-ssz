import Base
import ../../../src/buffer.bend as B
import ../../../src/digest.bend as D
import ../../../src/obj.bend as O
import ../../../types/fulu_obj_f@K@_generated.bend as G
import ../../../benchmarks/compact/objio.bend as IOx

# Crash hunt round 5 (b): a CHAIN of setter / append operations in ONE process (no re-decode between them, unlike
# tests_generated/fuzz_objects.py, whose histories re-decode after every step). SSZ_INPUT holds the start encoding
# (SSZ_SIZE bytes) and then, at the next multiple of 4, SSZ_NOPS operations of three little-endian words (sel, idx, seed)
# of the name's table (types/obj_fuzz_ops.json). Prints FLAGS (h = 31 h + accepted, over the chain), then the checked
# encoding of the result (SSZ_OUTPUT) and its root.

def check_show(out: B.Buf, d: D.Digest) -> IO(Unit):
  do IO<Unit>:
    IO.print("ROOTWORDS=" ++ IOx.words(d))
    IOx.emit_encoding(B.size(out))

def check_root(out: B.Buf, pair: B.Buf & (G.Any & D.Digest)) -> IO(Unit):
  (h, r) = pair
  (a, d) = r
  check_show(out, d)

def check_enc(pair: G.Any & B.Buf) -> IO(Unit):
  (a, out) = pair
  check_root(out, G.root(O.hasher(), a))

def st4(+h: U32, buf: B.Buf, pr: G.Any & Bool) -> B.Buf & (G.Any & U32):
  (a, ok) = pr
  (buf, (a, (h * 31 + O.pick(ok, 1, 0) : U32)))

def st3(+j: U32, +base: U32, +h: U32, +sel: U32, +idx: U32, a: G.Any, pair: B.Buf & U32) -> B.Buf & (G.Any & U32):
  (buf, +seed) = pair
  st4(h, buf, G.fuzz(a, sel, idx, seed))

def st2(+j: U32, +base: U32, +h: U32, +sel: U32, a: G.Any, pair: B.Buf & U32) -> B.Buf & (G.Any & U32):
  (buf, +idx) = pair
  st3(j, base, h, sel, idx, a, B.read32(buf, (base + 12 * j + 8 : U32)))

def st1(+j: U32, +base: U32, +h: U32, a: G.Any, pair: B.Buf & U32) -> B.Buf & (G.Any & U32):
  (buf, +sel) = pair
  st2(j, base, h, sel, a, B.read32(buf, (base + 12 * j + 4 : U32)))

def step(+j: U32, +base: U32, +h: U32, st: B.Buf & G.Any) -> B.Buf & (G.Any & U32):
  (buf, a) = st
  st1(j, base, h, a, B.read32(buf, (base + 12 * j : U32)))

def unh(pair: B.Buf & (G.Any & U32)) -> (B.Buf & G.Any) & U32:
  (buf, r) = pair
  (a, +h) = r
  ((buf, a), h)

def chain(k: Nat, +j: U32, +base: U32, +h: U32, st: B.Buf & G.Any) -> B.Buf & (G.Any & U32):
  match k:
    case 0n:
      (buf, a) = st
      (buf, (a, h))
    case 1n+q:
      (s2, +h2) = unh(step(j, base, h, st))
      chain(q, (j + 1 : U32), base, h2, s2)

def chained(pair: B.Buf & (G.Any & U32)) -> IO(Unit):
  (buf, r) = pair
  (a, +h) = r
  do IO<Unit>:
    IO.print("FLAGS=" ++ U32.show(h))
    check_enc(G.encode(a))

def on_decoded(m: Maybe<&1, G.Any>, buf: B.Buf, +nops: U32, +base: U32) -> IO(Unit):
  match m:
    case None{}: IO.die(Unit, 1, "DECODED=0")
    case Some{a}:
      do IO<Unit>:
        IO.print("DECODED=1")
        chained(chain(U32.to_nat(nops), 0, base, 0, (buf, a)))

def decoded(+nops: U32, +base: U32, pair: B.Buf & Maybe<&1, G.Any>) -> IO(Unit):
  (buf, m) = pair
  on_decoded(m, buf, nops, base)

def with_input(+i: U32, +size: U32, +nops: U32, pair: B.Buf & U32) -> IO(Unit):
  (buf, +total) = pair
  decoded(nops, ((size + 3 : U32) .&. 4294967292 : U32), G.decode(i, buf, size))

def main() -> IO(Unit):
  do IO<Unit>:
    +index : U32 <- IOx.env_u32("SSZ_INDEX")
    +size : U32 <- IOx.env_u32("SSZ_SIZE")
    +nops : U32 <- IOx.env_u32("SSZ_NOPS")
    input : B.Buf & U32 <- IOx.load()
    with_input(index, size, nops, input)
