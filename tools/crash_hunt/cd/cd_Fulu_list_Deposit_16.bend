# ---- report 2 (after the sets): the end --------------------------------------------------------------------------------
def r2b(line: String, pair: B.Buf & (Dd.l16_Deposit_Seq & D.Digest)) -> IO(Unit):
  (h, r) = pair
  (s, d2) = r
  IO.print(line ++ " plain=" ++ IOx.words(d2))
