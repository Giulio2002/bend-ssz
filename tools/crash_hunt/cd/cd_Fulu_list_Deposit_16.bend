  (h, r) = pair
  (c, d1) = r
  r2b("after_set cached=" ++ IOx.words(d1), Hh.l16_Deposit_root(64n, O.hasher(), s, 0))
def rep_set(st: St) -> IO(Unit):
  match st:
    case St{c, s}: r2a(s, Dd.l16_Deposit_cached_root(64n, O.hasher(), c, 0))

