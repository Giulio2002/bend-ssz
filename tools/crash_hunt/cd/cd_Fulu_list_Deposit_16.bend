  (st, +x) = pair
  match st:
    case St{c, s}: r1b(n, sets, x, s, Dd.l16_Deposit_cached_root(64n, O.hasher(), c, 0))

def go(+n: U32, +sets: U32, +seed: U32) -> IO(Unit): p1(n, sets, b_loop(U32.to_nat(n), seed, St{Dd.l16_Deposit_cache(Dd.l16_Deposit_default()), Dd.l16_Deposit_default()}))

