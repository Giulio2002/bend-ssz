    case T.BooleanValue{v0}:
      match rel:
    case T.UnsignedValue{v0}:
      match rel:
    case T.BytesValue{v0}:
      match rel:
    case T.BitsValue{v0}:
      match rel:
    case T.Sequence{v0}:
      match rel:
    case T.Items{v0, v1}:
      (+head, (+tail, (first, (rest, same)))) = rel
      repeat_pair(v0, v1, e, mine, head, tail, same, RS.one_root(v0, e, head, legal, first), repeat_length(v1, e, tail, legal, rest))
    case T.EmptyItems{}: RS.empty_length(mine, rel)
    case T.Selected{v0, v1}:
      match rel:
    case T.NullValue{}:
      match rel:

law repeat_count_go:
  for +items: T.Value
  for +e: T.Schema
  for +r: Maybe<&2, +List<+List<U32>>>
  for +legal: {IS.valid_go(e, False{}) == True{} : Bool}
  for known: G.forest_sound(items, T.Repeat{e}, [], r)
  G.rel_single(outs => {List.length(&2, +List<U32>, outs) == SC.count(items) : Nat}, r)
def repeat_count_go(items, e, r, legal, known):
  match r:
    case None{}: Unit{}
    case Some{rs}:
      (+mine, (rel, same)) = known
      len_rewrite(rs, mine, SC.count(items), same, pair_fst(SC.count(items), mine, R.roots(items, T.Repeat{e}, mine), repeat_length(items, e, mine, legal, rel)))

