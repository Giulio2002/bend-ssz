    %Equal.sym(Nat, IS.count(fields), TL.field_count(fields), Metadata.field_count(fields)) : {Nat.is_le(TL.field_count(fields), _) == True{} : Bool}
    Order.reflexive(TL.field_count(fields)),
    fields_count(items, fields, size, legal))


def nat_present(r: Maybe<&2, Nat>) -> Bool:
  match r:
    case None{}: False{}
    case Some{n}: True{}

law basic_fixed:
  for +schema: T.Schema
  for +w: Nat
  for +eq: {IS.basic_size(schema) == Some{w} : Maybe<&2, Nat>}
  {SS.fixed_size(schema) == Some{w} : Maybe<&2, Nat>}
def basic_fixed(schema, w, eq):
  match schema:
    case T.Boolean{}: eq
    case T.Unsigned{s0}:
      match s0:
        case Prim.U8{}: eq
        case Prim.U16{}: eq
        case Prim.U32Width{}: eq
        case Prim.U64{}: eq
        case Prim.U128{}: eq
        case Prim.U256{}: eq
    case T.ByteVector{s0}: Empty.absurd({SS.fixed_size(T.ByteVector{s0}) == Some{w} : Maybe<&2, Nat>}, W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, nat_present, None{}, Some{w}, eq)))
    case T.ByteList{s0}: Empty.absurd({SS.fixed_size(T.ByteList{s0}) == Some{w} : Maybe<&2, Nat>}, W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, nat_present, None{}, Some{w}, eq)))
    case T.BitVector{s0}: Empty.absurd({SS.fixed_size(T.BitVector{s0}) == Some{w} : Maybe<&2, Nat>}, W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, nat_present, None{}, Some{w}, eq)))
    case T.BitList{s0}: Empty.absurd({SS.fixed_size(T.BitList{s0}) == Some{w} : Maybe<&2, Nat>}, W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, nat_present, None{}, Some{w}, eq)))
    case T.Vector{s0, s1}: Empty.absurd({SS.fixed_size(T.Vector{s0, s1}) == Some{w} : Maybe<&2, Nat>}, W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, nat_present, None{}, Some{w}, eq)))
    case T.ListOf{s0, s1}: Empty.absurd({SS.fixed_size(T.ListOf{s0, s1}) == Some{w} : Maybe<&2, Nat>}, W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, nat_present, None{}, Some{w}, eq)))
    case T.Container{s0, s1}: Empty.absurd({SS.fixed_size(T.Container{s0, s1}) == Some{w} : Maybe<&2, Nat>}, W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, nat_present, None{}, Some{w}, eq)))
    case T.Union{s0}: Empty.absurd({SS.fixed_size(T.Union{s0}) == Some{w} : Maybe<&2, Nat>}, W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, nat_present, None{}, Some{w}, eq)))
    case T.Null{}: Empty.absurd({SS.fixed_size(T.Null{}) == Some{w} : Maybe<&2, Nat>}, W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, nat_present, None{}, Some{w}, eq)))
    case T.Chain{s0, s1}: Empty.absurd({SS.fixed_size(T.Chain{s0, s1}) == Some{w} : Maybe<&2, Nat>}, W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, nat_present, None{}, Some{w}, eq)))
    case T.End{}: Empty.absurd({SS.fixed_size(T.End{}) == Some{w} : Maybe<&2, Nat>}, W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, nat_present, None{}, Some{w}, eq)))
    case T.Repeat{s0}: Empty.absurd({SS.fixed_size(T.Repeat{s0}) == Some{w} : Maybe<&2, Nat>}, W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, nat_present, None{}, Some{w}, eq)))
    case T.Named{s0, s1}: Empty.absurd({SS.fixed_size(T.Named{s0, s1}) == Some{w} : Maybe<&2, Nat>}, W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, nat_present, None{}, Some{w}, eq)))
    case T.ProgressiveList{s0}: Empty.absurd({SS.fixed_size(T.ProgressiveList{s0}) == Some{w} : Maybe<&2, Nat>}, W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, nat_present, None{}, Some{w}, eq)))
    case T.ProgressiveBits{}: Empty.absurd({SS.fixed_size(T.ProgressiveBits{}) == Some{w} : Maybe<&2, Nat>}, W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, nat_present, None{}, Some{w}, eq)))
    case T.ProgressiveContainer{s0, s1, s2}: Empty.absurd({SS.fixed_size(T.ProgressiveContainer{s0, s1, s2}) == Some{w} : Maybe<&2, Nat>}, W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, nat_present, None{}, Some{w}, eq)))

    case T.CompatibleUnion{s0, s1}: Empty.absurd({SS.fixed_size(T.CompatibleUnion{s0, s1}) == Some{w} : Maybe<&2, Nat>}, W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, nat_present, None{}, Some{w}, eq)))

law one_single:
  for +schema: T.Schema
  for +value: T.Value
  for +size: Nat
  for +legal: {DG.option_ok(schema) == True{} : Bool}
  G.rel_single(outs => G.one(outs), IR.roots_go(value, schema, [], Cache.zeros(size)))
def one_single(schema, value, size, legal):
  match schema:
    case T.Boolean{}: one_map(value, T.Boolean{}, IR.roots_go(value, T.Boolean{}, [], Cache.zeros(size)), legal, RS.option_view(T.Boolean{}, value, IR.roots_go(value, T.Boolean{}, [], Cache.zeros(size)), legal, RS.sound(value, T.Boolean{}, [], size, Lookups.ok_of_option(T.Boolean{}, legal))))
    case T.Unsigned{s0}: one_map(value, T.Unsigned{s0}, IR.roots_go(value, T.Unsigned{s0}, [], Cache.zeros(size)), legal, RS.option_view(T.Unsigned{s0}, value, IR.roots_go(value, T.Unsigned{s0}, [], Cache.zeros(size)), legal, RS.sound(value, T.Unsigned{s0}, [], size, Lookups.ok_of_option(T.Unsigned{s0}, legal))))
    case T.ByteVector{s0}: one_map(value, T.ByteVector{s0}, IR.roots_go(value, T.ByteVector{s0}, [], Cache.zeros(size)), legal, RS.option_view(T.ByteVector{s0}, value, IR.roots_go(value, T.ByteVector{s0}, [], Cache.zeros(size)), legal, RS.sound(value, T.ByteVector{s0}, [], size, Lookups.ok_of_option(T.ByteVector{s0}, legal))))
    case T.ByteList{s0}: one_map(value, T.ByteList{s0}, IR.roots_go(value, T.ByteList{s0}, [], Cache.zeros(size)), legal, RS.option_view(T.ByteList{s0}, value, IR.roots_go(value, T.ByteList{s0}, [], Cache.zeros(size)), legal, RS.sound(value, T.ByteList{s0}, [], size, Lookups.ok_of_option(T.ByteList{s0}, legal))))
    case T.BitVector{s0}: one_map(value, T.BitVector{s0}, IR.roots_go(value, T.BitVector{s0}, [], Cache.zeros(size)), legal, RS.option_view(T.BitVector{s0}, value, IR.roots_go(value, T.BitVector{s0}, [], Cache.zeros(size)), legal, RS.sound(value, T.BitVector{s0}, [], size, Lookups.ok_of_option(T.BitVector{s0}, legal))))
    case T.BitList{s0}: one_map(value, T.BitList{s0}, IR.roots_go(value, T.BitList{s0}, [], Cache.zeros(size)), legal, RS.option_view(T.BitList{s0}, value, IR.roots_go(value, T.BitList{s0}, [], Cache.zeros(size)), legal, RS.sound(value, T.BitList{s0}, [], size, Lookups.ok_of_option(T.BitList{s0}, legal))))
    case T.Vector{s0, s1}: one_map(value, T.Vector{s0, s1}, IR.roots_go(value, T.Vector{s0, s1}, [], Cache.zeros(size)), legal, RS.option_view(T.Vector{s0, s1}, value, IR.roots_go(value, T.Vector{s0, s1}, [], Cache.zeros(size)), legal, RS.sound(value, T.Vector{s0, s1}, [], size, Lookups.ok_of_option(T.Vector{s0, s1}, legal))))
    case T.ListOf{s0, s1}: one_map(value, T.ListOf{s0, s1}, IR.roots_go(value, T.ListOf{s0, s1}, [], Cache.zeros(size)), legal, RS.option_view(T.ListOf{s0, s1}, value, IR.roots_go(value, T.ListOf{s0, s1}, [], Cache.zeros(size)), legal, RS.sound(value, T.ListOf{s0, s1}, [], size, Lookups.ok_of_option(T.ListOf{s0, s1}, legal))))
    case T.Container{s0, s1}: one_map(value, T.Container{s0, s1}, IR.roots_go(value, T.Container{s0, s1}, [], Cache.zeros(size)), legal, RS.option_view(T.Container{s0, s1}, value, IR.roots_go(value, T.Container{s0, s1}, [], Cache.zeros(size)), legal, RS.sound(value, T.Container{s0, s1}, [], size, Lookups.ok_of_option(T.Container{s0, s1}, legal))))
    case T.Union{s0}: one_map(value, T.Union{s0}, IR.roots_go(value, T.Union{s0}, [], Cache.zeros(size)), legal, RS.option_view(T.Union{s0}, value, IR.roots_go(value, T.Union{s0}, [], Cache.zeros(size)), legal, RS.sound(value, T.Union{s0}, [], size, Lookups.ok_of_option(T.Union{s0}, legal))))
    case T.Null{}:
      match value:
        case T.BooleanValue{v0}: Unit{}
        case T.UnsignedValue{v0}: Unit{}
        case T.BytesValue{v0}: Unit{}
        case T.BitsValue{v0}: Unit{}
        case T.Sequence{v0}: Unit{}
        case T.Items{v0, v1}: Unit{}
        case T.EmptyItems{}: Unit{}
        case T.Selected{v0, v1}: Unit{}
        case T.NullValue{}: {==}
    case T.Chain{s0, s1}: Empty.absurd(G.rel_single(outs => G.one(outs), IR.roots_go(value, T.Chain{s0, s1}, [], Cache.zeros(size))), W.false_true(legal))
    case T.End{}: Empty.absurd(G.rel_single(outs => G.one(outs), IR.roots_go(value, T.End{}, [], Cache.zeros(size))), W.false_true(legal))
    case T.Repeat{s0}: Empty.absurd(G.rel_single(outs => G.one(outs), IR.roots_go(value, T.Repeat{s0}, [], Cache.zeros(size))), W.false_true(legal))
    case T.Named{s0, s1}: one_map(value, T.Named{s0, s1}, IR.roots_go(value, T.Named{s0, s1}, [], Cache.zeros(size)), legal, RS.option_view(T.Named{s0, s1}, value, IR.roots_go(value, T.Named{s0, s1}, [], Cache.zeros(size)), legal, RS.sound(value, T.Named{s0, s1}, [], size, Lookups.ok_of_option(T.Named{s0, s1}, legal))))
    case T.ProgressiveList{s0}: one_map(value, T.ProgressiveList{s0}, IR.roots_go(value, T.ProgressiveList{s0}, [], Cache.zeros(size)), legal, RS.option_view(T.ProgressiveList{s0}, value, IR.roots_go(value, T.ProgressiveList{s0}, [], Cache.zeros(size)), legal, RS.sound(value, T.ProgressiveList{s0}, [], size, Lookups.ok_of_option(T.ProgressiveList{s0}, legal))))
    case T.ProgressiveBits{}: one_map(value, T.ProgressiveBits{}, IR.roots_go(value, T.ProgressiveBits{}, [], Cache.zeros(size)), legal, RS.option_view(T.ProgressiveBits{}, value, IR.roots_go(value, T.ProgressiveBits{}, [], Cache.zeros(size)), legal, RS.sound(value, T.ProgressiveBits{}, [], size, Lookups.ok_of_option(T.ProgressiveBits{}, legal))))
    case T.ProgressiveContainer{s0, s1, s2}: one_map(value, T.ProgressiveContainer{s0, s1, s2}, IR.roots_go(value, T.ProgressiveContainer{s0, s1, s2}, [], Cache.zeros(size)), legal, RS.option_view(T.ProgressiveContainer{s0, s1, s2}, value, IR.roots_go(value, T.ProgressiveContainer{s0, s1, s2}, [], Cache.zeros(size)), legal, RS.sound(value, T.ProgressiveContainer{s0, s1, s2}, [], size, Lookups.ok_of_option(T.ProgressiveContainer{s0, s1, s2}, legal))))
    case T.CompatibleUnion{s0, s1}: one_map(value, T.CompatibleUnion{s0, s1}, IR.roots_go(value, T.CompatibleUnion{s0, s1}, [], Cache.zeros(size)), legal, RS.option_view(T.CompatibleUnion{s0, s1}, value, IR.roots_go(value, T.CompatibleUnion{s0, s1}, [], Cache.zeros(size)), legal, RS.sound(value, T.CompatibleUnion{s0, s1}, [], size, Lookups.ok_of_option(T.CompatibleUnion{s0, s1}, legal))))

law total:
  for +value: T.Value
  for +schema: T.Schema
  for +acc: +List<+List<U32>>
  for +size: Nat
  for +legal: {F.ok(schema) == True{} : Bool}
  for +valid: {VD.root_valid(value, schema) == True{} : Bool}
  for +mixing: {VD.mixing_lengths(value, schema) == True{} : Bool}
  {TS.present(IR.roots_go(value, schema, acc, Cache.zeros(size))) == True{} : Bool}
def total(value, schema, acc, size, legal, valid, mixing):
  match value:
    case T.BooleanValue{v0}:
      match schema:
        case T.Boolean{}: {==}
        case T.Unsigned{s0}: Empty.absurd({TS.present(IR.roots_go(T.BooleanValue{v0}, T.Unsigned{s0}, acc, Cache.zeros(size))) == True{} : Bool}, W.false_true(valid))
        case T.ByteVector{s0}: Empty.absurd({TS.present(IR.roots_go(T.BooleanValue{v0}, T.ByteVector{s0}, acc, Cache.zeros(size))) == True{} : Bool}, W.false_true(valid))
        case T.ByteList{s0}: Empty.absurd({TS.present(IR.roots_go(T.BooleanValue{v0}, T.ByteList{s0}, acc, Cache.zeros(size))) == True{} : Bool}, W.false_true(valid))
        case T.BitVector{s0}: Empty.absurd({TS.present(IR.roots_go(T.BooleanValue{v0}, T.BitVector{s0}, acc, Cache.zeros(size))) == True{} : Bool}, W.false_true(valid))
        case T.BitList{s0}: Empty.absurd({TS.present(IR.roots_go(T.BooleanValue{v0}, T.BitList{s0}, acc, Cache.zeros(size))) == True{} : Bool}, W.false_true(valid))
        case T.Vector{s0, s1}: Empty.absurd({TS.present(IR.roots_go(T.BooleanValue{v0}, T.Vector{s0, s1}, acc, Cache.zeros(size))) == True{} : Bool}, W.false_true(valid))
        case T.ListOf{s0, s1}: Empty.absurd({TS.present(IR.roots_go(T.BooleanValue{v0}, T.ListOf{s0, s1}, acc, Cache.zeros(size))) == True{} : Bool}, W.false_true(valid))
        case T.Container{s0, s1}: Empty.absurd({TS.present(IR.roots_go(T.BooleanValue{v0}, T.Container{s0, s1}, acc, Cache.zeros(size))) == True{} : Bool}, W.false_true(valid))
        case T.Union{s0}: Empty.absurd({TS.present(IR.roots_go(T.BooleanValue{v0}, T.Union{s0}, acc, Cache.zeros(size))) == True{} : Bool}, W.false_true(valid))
        case T.Null{}: Empty.absurd({TS.present(IR.roots_go(T.BooleanValue{v0}, T.Null{}, acc, Cache.zeros(size))) == True{} : Bool}, W.false_true(valid))
        case T.Chain{s0, s1}: Empty.absurd({TS.present(IR.roots_go(T.BooleanValue{v0}, T.Chain{s0, s1}, acc, Cache.zeros(size))) == True{} : Bool}, W.false_true(valid))
        case T.End{}: Empty.absurd({TS.present(IR.roots_go(T.BooleanValue{v0}, T.End{}, acc, Cache.zeros(size))) == True{} : Bool}, W.false_true(valid))
        case T.Repeat{s0}: Empty.absurd({TS.present(IR.roots_go(T.BooleanValue{v0}, T.Repeat{s0}, acc, Cache.zeros(size))) == True{} : Bool}, W.false_true(valid))
        case T.Named{s0, s1}: Empty.absurd({TS.present(IR.roots_go(T.BooleanValue{v0}, T.Named{s0, s1}, acc, Cache.zeros(size))) == True{} : Bool}, W.false_true(valid))
        case T.ProgressiveList{s0}: Empty.absurd({TS.present(IR.roots_go(T.BooleanValue{v0}, T.ProgressiveList{s0}, acc, Cache.zeros(size))) == True{} : Bool}, W.false_true(valid))
        case T.ProgressiveBits{}: Empty.absurd({TS.present(IR.roots_go(T.BooleanValue{v0}, T.ProgressiveBits{}, acc, Cache.zeros(size))) == True{} : Bool}, W.false_true(valid))
        case T.ProgressiveContainer{s0, s1, s2}: Empty.absurd({TS.present(IR.roots_go(T.BooleanValue{v0}, T.ProgressiveContainer{s0, s1, s2}, acc, Cache.zeros(size))) == True{} : Bool}, W.false_true(valid))
        case T.CompatibleUnion{s0, s1}: Empty.absurd({TS.present(IR.roots_go(T.BooleanValue{v0}, T.CompatibleUnion{s0, s1}, acc, Cache.zeros(size))) == True{} : Bool}, W.false_true(valid))
    case T.UnsignedValue{v0}:
      match schema:
        case T.Boolean{}: Empty.absurd({TS.present(IR.roots_go(T.UnsignedValue{v0}, T.Boolean{}, acc, Cache.zeros(size))) == True{} : Bool}, W.false_true(valid))
        case T.Unsigned{s0}: uint_present(s0, v0, valid)
        case T.ByteVector{s0}: Empty.absurd({TS.present(IR.roots_go(T.UnsignedValue{v0}, T.ByteVector{s0}, acc, Cache.zeros(size))) == True{} : Bool}, W.false_true(valid))
        case T.ByteList{s0}: Empty.absurd({TS.present(IR.roots_go(T.UnsignedValue{v0}, T.ByteList{s0}, acc, Cache.zeros(size))) == True{} : Bool}, W.false_true(valid))
        case T.BitVector{s0}: Empty.absurd({TS.present(IR.roots_go(T.UnsignedValue{v0}, T.BitVector{s0}, acc, Cache.zeros(size))) == True{} : Bool}, W.false_true(valid))
        case T.BitList{s0}: Empty.absurd({TS.present(IR.roots_go(T.UnsignedValue{v0}, T.BitList{s0}, acc, Cache.zeros(size))) == True{} : Bool}, W.false_true(valid))
