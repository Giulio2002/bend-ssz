  G.rel_single(outs => {List.length(&2, +List<U32>, outs) == SC.count(items) : Nat}, r)
def repeat_count_go(items, e, r, legal, known):
  match r:
    case None{}: Unit{}
    case Some{rs}:
      (+mine, (rel, same)) = known
      len_rewrite(rs, mine, SC.count(items), same, pair_fst(SC.count(items), mine, R.roots(items, T.Repeat{e}, mine), repeat_length(items, e, mine, legal, rel)))

law repeat_count:
  for +items: T.Value
  for +e: T.Schema
  for +size: Nat
  for +legal: {IS.valid_go(e, False{}) == True{} : Bool}
  G.rel_single(outs => {List.length(&2, +List<U32>, outs) == SC.count(items) : Nat}, IR.roots_go(items, T.Repeat{e}, [], Cache.zeros(size)))
def repeat_count(items, e, size, legal):
  repeat_count_go(items, e, IR.roots_go(items, T.Repeat{e}, [], Cache.zeros(size)), legal, RS.sound(items, T.Repeat{e}, [], size, legal))

law fields_count_go:
