        case T.Unsigned{s0}: uint_present(s0, v0, encodable)
        case T.ByteVector{s0}: Empty.absurd({TS.present(IR.roots_go(T.UnsignedValue{v0}, T.ByteVector{s0}, acc, Cache.zeros(size))) == True{} : Bool}, W.false_true(encodable))
        case T.ByteList{s0}: Empty.absurd({TS.present(IR.roots_go(T.UnsignedValue{v0}, T.ByteList{s0}, acc, Cache.zeros(size))) == True{} : Bool}, W.false_true(encodable))
