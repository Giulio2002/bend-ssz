        case T.Container{s0, s1}: Empty.absurd({TS.present(IR.roots_go(T.UnsignedValue{v0}, T.Container{s0, s1}, acc, Cache.zeros(size))) == True{} : Bool}, W.false_true(encodable))
        case T.Union{s0}: Empty.absurd({TS.present(IR.roots_go(T.UnsignedValue{v0}, T.Union{s0}, acc, Cache.zeros(size))) == True{} : Bool}, W.false_true(encodable))
        case T.Null{}: Empty.absurd({TS.present(IR.roots_go(T.UnsignedValue{v0}, T.Null{}, acc, Cache.zeros(size))) == True{} : Bool}, W.false_true(encodable))
        case T.Chain{s0, s1}: Empty.absurd({TS.present(IR.roots_go(T.UnsignedValue{v0}, T.Chain{s0, s1}, acc, Cache.zeros(size))) == True{} : Bool}, W.false_true(encodable))
        case T.End{}: Empty.absurd({TS.present(IR.roots_go(T.UnsignedValue{v0}, T.End{}, acc, Cache.zeros(size))) == True{} : Bool}, W.false_true(encodable))
        case T.Repeat{s0}: Empty.absurd({TS.present(IR.roots_go(T.UnsignedValue{v0}, T.Repeat{s0}, acc, Cache.zeros(size))) == True{} : Bool}, W.false_true(encodable))
        case T.Named{s0, s1}: Empty.absurd({TS.present(IR.roots_go(T.UnsignedValue{v0}, T.Named{s0, s1}, acc, Cache.zeros(size))) == True{} : Bool}, W.false_true(encodable))
        case T.ProgressiveList{s0}: Empty.absurd({TS.present(IR.roots_go(T.UnsignedValue{v0}, T.ProgressiveList{s0}, acc, Cache.zeros(size))) == True{} : Bool}, W.false_true(encodable))
