    case T.BytesValue{v0}:
      match schema:
        case T.Boolean{}: Empty.absurd({TS.present(IR.roots_go(T.BytesValue{v0}, T.Boolean{}, acc, Cache.zeros(size))) == True{} : Bool}, W.false_true(encodable))
        case T.Unsigned{s0}: Empty.absurd({TS.present(IR.roots_go(T.BytesValue{v0}, T.Unsigned{s0}, acc, Cache.zeros(size))) == True{} : Bool}, W.false_true(encodable))
