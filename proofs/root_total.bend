        case T.End{}: Empty.absurd(one_facts(w, R.basic_one(T.EmptyItems{}, T.End{})), W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, size_present, None{}, Some{w}, eq)))
        case T.Repeat{s0}: Empty.absurd(one_facts(w, R.basic_one(T.EmptyItems{}, T.Repeat{s0})), W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, size_present, None{}, Some{w}, eq)))
        case T.Named{s0, s1}: Empty.absurd(one_facts(w, R.basic_one(T.EmptyItems{}, T.Named{s0, s1})), W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, size_present, None{}, Some{w}, eq)))
        case T.ProgressiveList{s0}: Empty.absurd(one_facts(w, R.basic_one(T.EmptyItems{}, T.ProgressiveList{s0})), W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, size_present, None{}, Some{w}, eq)))
        case T.ProgressiveBits{}: Empty.absurd(one_facts(w, R.basic_one(T.EmptyItems{}, T.ProgressiveBits{})), W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, size_present, None{}, Some{w}, eq)))
        case T.ProgressiveContainer{s0, s1, s2}: Empty.absurd(one_facts(w, R.basic_one(T.EmptyItems{}, T.ProgressiveContainer{s0, s1, s2})), W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, size_present, None{}, Some{w}, eq)))
        case T.CompatibleUnion{s0, s1}: Empty.absurd(one_facts(w, R.basic_one(T.EmptyItems{}, T.CompatibleUnion{s0, s1})), W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, size_present, None{}, Some{w}, eq)))
    case T.Selected{v0, v1}:
      match s:
        case T.Boolean{}: Empty.absurd(one_facts(w, R.basic_one(T.Selected{v0, v1}, T.Boolean{})), W.false_true(valid))
        case T.Unsigned{s0}: Empty.absurd(one_facts(w, R.basic_one(T.Selected{v0, v1}, T.Unsigned{s0})), W.false_true(valid))
        case T.ByteVector{s0}: Empty.absurd(one_facts(w, R.basic_one(T.Selected{v0, v1}, T.ByteVector{s0})), W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, size_present, None{}, Some{w}, eq)))
        case T.ByteList{s0}: Empty.absurd(one_facts(w, R.basic_one(T.Selected{v0, v1}, T.ByteList{s0})), W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, size_present, None{}, Some{w}, eq)))
        case T.BitVector{s0}: Empty.absurd(one_facts(w, R.basic_one(T.Selected{v0, v1}, T.BitVector{s0})), W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, size_present, None{}, Some{w}, eq)))
        case T.BitList{s0}: Empty.absurd(one_facts(w, R.basic_one(T.Selected{v0, v1}, T.BitList{s0})), W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, size_present, None{}, Some{w}, eq)))
        case T.Vector{s0, s1}: Empty.absurd(one_facts(w, R.basic_one(T.Selected{v0, v1}, T.Vector{s0, s1})), W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, size_present, None{}, Some{w}, eq)))
        case T.ListOf{s0, s1}: Empty.absurd(one_facts(w, R.basic_one(T.Selected{v0, v1}, T.ListOf{s0, s1})), W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, size_present, None{}, Some{w}, eq)))
        case T.Container{s0, s1}: Empty.absurd(one_facts(w, R.basic_one(T.Selected{v0, v1}, T.Container{s0, s1})), W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, size_present, None{}, Some{w}, eq)))
        case T.Union{s0}: Empty.absurd(one_facts(w, R.basic_one(T.Selected{v0, v1}, T.Union{s0})), W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, size_present, None{}, Some{w}, eq)))
        case T.Null{}: Empty.absurd(one_facts(w, R.basic_one(T.Selected{v0, v1}, T.Null{})), W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, size_present, None{}, Some{w}, eq)))
        case T.Chain{s0, s1}: Empty.absurd(one_facts(w, R.basic_one(T.Selected{v0, v1}, T.Chain{s0, s1})), W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, size_present, None{}, Some{w}, eq)))
        case T.End{}: Empty.absurd(one_facts(w, R.basic_one(T.Selected{v0, v1}, T.End{})), W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, size_present, None{}, Some{w}, eq)))
        case T.Repeat{s0}: Empty.absurd(one_facts(w, R.basic_one(T.Selected{v0, v1}, T.Repeat{s0})), W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, size_present, None{}, Some{w}, eq)))
        case T.Named{s0, s1}: Empty.absurd(one_facts(w, R.basic_one(T.Selected{v0, v1}, T.Named{s0, s1})), W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, size_present, None{}, Some{w}, eq)))
        case T.ProgressiveList{s0}: Empty.absurd(one_facts(w, R.basic_one(T.Selected{v0, v1}, T.ProgressiveList{s0})), W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, size_present, None{}, Some{w}, eq)))
        case T.ProgressiveBits{}: Empty.absurd(one_facts(w, R.basic_one(T.Selected{v0, v1}, T.ProgressiveBits{})), W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, size_present, None{}, Some{w}, eq)))
        case T.ProgressiveContainer{s0, s1, s2}: Empty.absurd(one_facts(w, R.basic_one(T.Selected{v0, v1}, T.ProgressiveContainer{s0, s1, s2})), W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, size_present, None{}, Some{w}, eq)))
        case T.CompatibleUnion{s0, s1}: Empty.absurd(one_facts(w, R.basic_one(T.Selected{v0, v1}, T.CompatibleUnion{s0, s1})), W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, size_present, None{}, Some{w}, eq)))
    case T.NullValue{}:
      match s:
        case T.Boolean{}: Empty.absurd(one_facts(w, R.basic_one(T.NullValue{}, T.Boolean{})), W.false_true(valid))
        case T.Unsigned{s0}: Empty.absurd(one_facts(w, R.basic_one(T.NullValue{}, T.Unsigned{s0})), W.false_true(valid))
        case T.ByteVector{s0}: Empty.absurd(one_facts(w, R.basic_one(T.NullValue{}, T.ByteVector{s0})), W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, size_present, None{}, Some{w}, eq)))
        case T.ByteList{s0}: Empty.absurd(one_facts(w, R.basic_one(T.NullValue{}, T.ByteList{s0})), W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, size_present, None{}, Some{w}, eq)))
        case T.BitVector{s0}: Empty.absurd(one_facts(w, R.basic_one(T.NullValue{}, T.BitVector{s0})), W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, size_present, None{}, Some{w}, eq)))
        case T.BitList{s0}: Empty.absurd(one_facts(w, R.basic_one(T.NullValue{}, T.BitList{s0})), W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, size_present, None{}, Some{w}, eq)))
        case T.Vector{s0, s1}: Empty.absurd(one_facts(w, R.basic_one(T.NullValue{}, T.Vector{s0, s1})), W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, size_present, None{}, Some{w}, eq)))
        case T.ListOf{s0, s1}: Empty.absurd(one_facts(w, R.basic_one(T.NullValue{}, T.ListOf{s0, s1})), W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, size_present, None{}, Some{w}, eq)))
        case T.Container{s0, s1}: Empty.absurd(one_facts(w, R.basic_one(T.NullValue{}, T.Container{s0, s1})), W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, size_present, None{}, Some{w}, eq)))
        case T.Union{s0}: Empty.absurd(one_facts(w, R.basic_one(T.NullValue{}, T.Union{s0})), W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, size_present, None{}, Some{w}, eq)))
        case T.Null{}: Empty.absurd(one_facts(w, R.basic_one(T.NullValue{}, T.Null{})), W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, size_present, None{}, Some{w}, eq)))
        case T.Chain{s0, s1}: Empty.absurd(one_facts(w, R.basic_one(T.NullValue{}, T.Chain{s0, s1})), W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, size_present, None{}, Some{w}, eq)))
        case T.End{}: Empty.absurd(one_facts(w, R.basic_one(T.NullValue{}, T.End{})), W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, size_present, None{}, Some{w}, eq)))
        case T.Repeat{s0}: Empty.absurd(one_facts(w, R.basic_one(T.NullValue{}, T.Repeat{s0})), W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, size_present, None{}, Some{w}, eq)))
        case T.Named{s0, s1}: Empty.absurd(one_facts(w, R.basic_one(T.NullValue{}, T.Named{s0, s1})), W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, size_present, None{}, Some{w}, eq)))
        case T.ProgressiveList{s0}: Empty.absurd(one_facts(w, R.basic_one(T.NullValue{}, T.ProgressiveList{s0})), W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, size_present, None{}, Some{w}, eq)))
        case T.ProgressiveBits{}: Empty.absurd(one_facts(w, R.basic_one(T.NullValue{}, T.ProgressiveBits{})), W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, size_present, None{}, Some{w}, eq)))
        case T.ProgressiveContainer{s0, s1, s2}: Empty.absurd(one_facts(w, R.basic_one(T.NullValue{}, T.ProgressiveContainer{s0, s1, s2})), W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, size_present, None{}, Some{w}, eq)))
        case T.CompatibleUnion{s0, s1}: Empty.absurd(one_facts(w, R.basic_one(T.NullValue{}, T.CompatibleUnion{s0, s1})), W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, size_present, None{}, Some{w}, eq)))

law append_domain:
  for +x: +List<U32>
  for +y: +List<U32>
  for +dx: {SP.bytes_domain(x) == True{} : Bool}
  for +dy: {SP.bytes_domain(y) == True{} : Bool}
  {SP.bytes_domain(List.append(&2, U32, x, y)) == True{} : Bool}
def append_domain(x, y, dx, dy):
  Equal.trans(Bool, SP.bytes_domain(List.append(&2, U32, x, y)), Bool.and(SP.bytes_domain(x), SP.bytes_domain(y)), True{}, LayoutLaws.bytes_append(x, y), V.and_true(SP.bytes_domain(x), SP.bytes_domain(y), dx, dy))

law append_count:
  for +x: +List<U32>
  for +y: +List<U32>
  for +count: Nat
  for +w: Nat
  for +lx: {List.length(&2, U32, x) == w : Nat}
  for +ly: {List.length(&2, U32, y) == Nat.mul(count, w) : Nat}
  {List.length(&2, U32, List.append(&2, U32, x, y)) == Nat.mul(1n+count, w) : Nat}
def append_count(x, y, count, w, lx, ly):
  Equal.trans(Nat, List.length(&2, U32, List.append(&2, U32, x, y)), Nat.add(List.length(&2, U32, x), List.length(&2, U32, y)), Nat.mul(1n+count, w), L.append_length(U32, x, y),
    Equal.trans(Nat, Nat.add(List.length(&2, U32, x), List.length(&2, U32, y)), Nat.add(w, List.length(&2, U32, y)), Nat.add(w, Nat.mul(count, w)),
      Equal.cong(Nat, Nat, a => Nat.add(a, List.length(&2, U32, y)), List.length(&2, U32, x), w, lx),
      Equal.cong(Nat, Nat, b => Nat.add(w, b), List.length(&2, U32, y), Nat.mul(count, w), ly)))

law join_facts:
  for +a: Maybe<&2, +List<U32>>
  for +b: Maybe<&2, +List<U32>>
  for +count: Nat
  for +w: Nat
  for one: one_facts(w, a)
  for rest: seq_facts(count, w, b)
  seq_facts(1n+count, w, R.join(a, b))
def join_facts(a, b, count, w, one, rest):
  match a:
    case None{}:
      match one:
    case Some{x}:
      match b:
        case None{}:
          match rest:
        case Some{y}:
          (dx, lx) = one
          (dy, ly) = rest
          (append_domain(x, y, dx, dy), append_count(x, y, count, w, lx, ly))

law basic_bytes_facts:
  for +items: T.Value
  for +s: T.Schema
  for +w: Nat
  for +eq: {R.basic_size(s) == Some{w} : Maybe<&2, Nat>}
  for +valid: {VD.root_valid(items, T.Repeat{s}) == True{} : Bool}
  seq_facts(SC.count(items), w, R.basic_bytes(items, s))
def basic_bytes_facts(items, s, w, eq, valid):
  match items:
    case T.BooleanValue{v0}: Empty.absurd(seq_facts(SC.count(T.BooleanValue{v0}), w, R.basic_bytes(T.BooleanValue{v0}, s)), W.false_true(valid))
    case T.UnsignedValue{v0}: Empty.absurd(seq_facts(SC.count(T.UnsignedValue{v0}), w, R.basic_bytes(T.UnsignedValue{v0}, s)), W.false_true(valid))
    case T.BytesValue{v0}: Empty.absurd(seq_facts(SC.count(T.BytesValue{v0}), w, R.basic_bytes(T.BytesValue{v0}, s)), W.false_true(valid))
    case T.BitsValue{v0}: Empty.absurd(seq_facts(SC.count(T.BitsValue{v0}), w, R.basic_bytes(T.BitsValue{v0}, s)), W.false_true(valid))
    case T.Sequence{v0}: Empty.absurd(seq_facts(SC.count(T.Sequence{v0}), w, R.basic_bytes(T.Sequence{v0}, s)), W.false_true(valid))
    case T.Items{h, t}:
      join_facts(R.basic_one(h, s), R.basic_bytes(t, s), SC.count(t), w,
        basic_one_facts(h, s, w, eq, V.and_left(VD.root_valid(h, s), VD.root_valid(t, T.Repeat{s}), valid)),
        basic_bytes_facts(t, s, w, eq, V.and_right(VD.root_valid(h, s), VD.root_valid(t, T.Repeat{s}), valid)))
    case T.EmptyItems{}: ({==}, {==})
    case T.Selected{v0, v1}: Empty.absurd(seq_facts(SC.count(T.Selected{v0, v1}), w, R.basic_bytes(T.Selected{v0, v1}, s)), W.false_true(valid))
    case T.NullValue{}: Empty.absurd(seq_facts(SC.count(T.NullValue{}), w, R.basic_bytes(T.NullValue{}, s)), W.false_true(valid))

law packed_bound:
  for +bytes: +List<U32>
  for +count: Nat
  for +w: Nat
  for +limit: Nat
  for +len: {List.length(&2, U32, bytes) == Nat.mul(count, w) : Nat}
  for +bound: {Nat.is_le(count, limit) == True{} : Bool}
  {Nat.is_le(List.length(&2, +List<U32>, IPack.scan(bytes, 31n, [], [])), IR.count_limit(Some{w}, limit)) == True{} : Bool}
def packed_bound(bytes, count, w, limit, len, bound):
  %Equal.sym(Nat, List.length(&2, +List<U32>, IPack.scan(bytes, 31n, [], [])), IByteList.chunk_limit(List.length(&2, U32, bytes)), ByteListLaws.packed_count(bytes)) : {Nat.is_le(_, IR.count_limit(Some{w}, limit)) == True{} : Bool}
  %Equal.sym(Nat, List.length(&2, U32, bytes), Nat.mul(count, w), len) : {Nat.is_le(IByteList.chunk_limit(_), IR.count_limit(Some{w}, limit)) == True{} : Bool}
  Count.quotient_monotone(Nat.add(Nat.mul(count, w), 31n), Nat.add(Nat.mul(limit, w), 31n), 31n, 0n, 0n, Order.add_right(Nat.mul(count, w), Nat.mul(limit, w), 31n, A.mul_coefficient(count, limit, w, bound)))

law basic_list_present:
  for +w: Nat
  for +bytes: +List<U32>
  for +limit: Nat
  for +prog: Bool
  for +length: Maybe<&2, Nat>
  for +size: Nat
  for +dom: {SP.bytes_domain(bytes) == True{} : Bool}
  for count: TS.limit_ok(prog, IPack.scan(bytes, 31n, [], []), IR.count_limit(Some{w}, limit))
  for fits: TS.fits_length(length)
  {TS.present(IR.single(IR.length_mix(IR.merkle(IR.packed(Some{bytes}), IR.count_limit(Some{w}, limit), prog, Cache.zeros(size)), length))) == True{} : Bool}
def basic_list_present(w, bytes, limit, prog, length, size, dom, count, fits):
  %Equal.sym(Bool, IPack.valid_go(bytes, True{}), True{}, TS.packed_valid(bytes, dom)) : {TS.present(IR.single(IR.length_mix(IR.merkle(IPack.checked(_, bytes), IR.count_limit(Some{w}, limit), prog, Cache.zeros(size)), length))) == True{} : Bool}
  TS.aggregate_present(IR.count_limit(Some{w}, limit), IPack.scan(bytes, 31n, [], []), prog, length, size, TS.scan_domain(bytes, dom), count, fits)

law seq_present_of:
  for +r: Maybe<&2, +List<U32>>
  for +count: Nat
  for +w: Nat
  for +limit: Nat
  for +prog: Bool
  for +length: Maybe<&2, Nat>
  for +size: Nat
  for facts: seq_facts(count, w, r)
  for count_ok: @+bytes: +List<U32> -> @+len: {List.length(&2, U32, bytes) == Nat.mul(count, w) : Nat} -> TS.limit_ok(prog, IPack.scan(bytes, 31n, [], []), IR.count_limit(Some{w}, limit))
  for fits: TS.fits_length(length)
  {TS.present(IR.single(IR.length_mix(IR.merkle(IR.packed(r), IR.count_limit(Some{w}, limit), prog, Cache.zeros(size)), length))) == True{} : Bool}
def seq_present_of(r, count, w, limit, prog, length, size, facts, count_ok, fits):
  match r:
    case None{}:
      match facts:
    case Some{bytes}:
      (dom, len) = facts
      basic_list_present(w, bytes, limit, prog, length, size, dom, count_ok(bytes, len), fits)

law basic_seq_present:
  for +items: T.Value
  for +s: T.Schema
  for +w: Nat
  for +limit: Nat
  for +prog: Bool
  for +length: Maybe<&2, Nat>
  for +size: Nat
  for +eq: {IS.basic_size(s) == Some{w} : Maybe<&2, Nat>}
  for +valid: {VD.root_valid(items, T.Repeat{s}) == True{} : Bool}
  for count_ok: @+bytes: +List<U32> -> @+len: {List.length(&2, U32, bytes) == Nat.mul(SC.count(items), w) : Nat} -> TS.limit_ok(prog, IPack.scan(bytes, 31n, [], []), IR.count_limit(Some{w}, limit))
  for fits: TS.fits_length(length)
  {TS.present(IR.single(IR.length_mix(IR.merkle(IR.packed(IR.basic_bytes(items, s)), IR.count_limit(Some{w}, limit), prog, Cache.zeros(size)), length))) == True{} : Bool}
def basic_seq_present(items, s, w, limit, prog, length, size, eq, valid, count_ok, fits):
  %Equal.sym(Maybe<&2, +List<U32>>, IR.basic_bytes(items, s), R.basic_bytes(items, s), Steps.basic_bytes_correct(items, s)) : {TS.present(IR.single(IR.length_mix(IR.merkle(IR.packed(_), IR.count_limit(Some{w}, limit), prog, Cache.zeros(size)), length))) == True{} : Bool}
  seq_present_of(R.basic_bytes(items, s), SC.count(items), w, limit, prog, length, size,
    basic_bytes_facts(items, s, w, Equal.trans(Maybe<&2, Nat>, R.basic_size(s), IS.basic_size(s), Some{w}, Equal.sym(Maybe<&2, Nat>, IS.basic_size(s), R.basic_size(s), RS.basic_size_correct(s)), eq), valid),
    count_ok, fits)

law vector_count_bound:
  for +items: T.Value
  for +n: Nat
  for +ok: {Bool.and(Nat.is_lt(0n, n), Nat.is_eq(VD.items_length(items), n)) == True{} : Bool}
  {Nat.is_le(SC.count(items), n) == True{} : Bool}
def vector_count_bound(items, n, ok):
  %Equal.sym(Nat, SC.count(items), VD.items_length(items), Steps.items_length_correct(items)) : {Nat.is_le(_, n) == True{} : Bool}
  vector_bound(VD.items_length(items), n, ok)

law list_count_bound:
  for +items: T.Value
  for +n: Nat
  for +ok: {Nat.is_le(VD.items_length(items), n) == True{} : Bool}
  {Nat.is_le(SC.count(items), n) == True{} : Bool}
def list_count_bound(items, n, ok):
  %Equal.sym(Nat, SC.count(items), VD.items_length(items), Steps.items_length_correct(items)) : {Nat.is_le(_, n) == True{} : Bool}
  ok

law union_present:
  for +found: Maybe<&2, T.Schema>
  for +v: T.Value
  for +selector: U32
  for +size: Nat
  for +valid: {VD.selected(found, s => VD.root_valid(v, s)) == True{} : Bool}
  for small: DG.selection(selector, found)
  for recur: @+s: T.Schema -> @+same: {found == Some{s} : Maybe<&2, T.Schema>} -> @+vs: {VD.root_valid(v, s) == True{} : Bool} -> TS.single_ok(IR.roots_go(v, s, [], Cache.zeros(size)))
  {TS.present(IR.with_schema(found, s => IR.selector_mix(IR.unwrap(IR.roots_go(v, s, [], Cache.zeros(size))), selector))) == True{} : Bool}
def union_present(found, v, selector, size, valid, small, recur):
  match found:
    case None{}: Empty.absurd({TS.present(IR.with_schema(None{}, s => IR.selector_mix(IR.unwrap(IR.roots_go(v, s, [], Cache.zeros(size))), selector))) == True{} : Bool}, W.false_true(valid))
    case Some{s}:
      (legal, bound) = small
      TS.unwrap_present(IR.roots_go(v, s, [], Cache.zeros(size)), selector, recur(s, {==}, valid), bound)

law shape_known:
  for +count: Nat
  for +width: Maybe<&2, Nat>
  for +r: Maybe<&2, +List<T.Part>>
  for +cps: +List<T.Part>
  for facts: F.repeat_fact(List.replicate(Maybe<&2, Nat>, count, width), r)
  for +same: {r == Some{cps} : Maybe<&2, +List<T.Part>>}
  {H.widths(cps) == List.replicate(Maybe<&2, Nat>, count, width) : +List<Maybe<&2, Nat>>}
def shape_known(count, width, r, cps, facts, same):
  match r:
    case None{}: Empty.absurd({H.widths(cps) == List.replicate(Maybe<&2, Nat>, count, width) : +List<Maybe<&2, Nat>>}, W.false_true(Equal.cong(Maybe<&2, +List<T.Part>>, Bool, TS.parts_present, None{}, Some{cps}, same)))
    case Some{ps}:
      %Equal.cong(Maybe<&2, +List<T.Part>>, +List<T.Part>, part_contents, Some{ps}, Some{cps}, same) : {H.widths(_) == List.replicate(Maybe<&2, Nat>, count, width) : +List<Maybe<&2, Nat>>}
      facts

law shape_of:
  for +e: T.Schema
  for +count: Nat
  for +r: Maybe<&2, +List<T.Part>>
  for +cps: +List<T.Part>
  for +w: Nat
  for facts: F.repeat_fact(List.replicate(Maybe<&2, Nat>, count, SS.fixed_size(e)), r)
  for +same: {r == Some{cps} : Maybe<&2, +List<T.Part>>}
  for +fixed: {SS.fixed_size(e) == Some{w} : Maybe<&2, Nat>}
  {H.widths(cps) == List.replicate(Maybe<&2, Nat>, count, Some{w}) : +List<Maybe<&2, Nat>>}
def shape_of(e, count, r, cps, w, facts, same, fixed):
  %fixed : {H.widths(cps) == List.replicate(Maybe<&2, Nat>, count, _) : +List<Maybe<&2, Nat>>}
  shape_known(count, SS.fixed_size(e), r, cps, facts, same)

law sequence_present:
  for +size_b: Maybe<&2, Nat>
  for -enc: Unit -> Maybe<&2, +List<U32>>
  for comp: Unit -> Maybe<&2, +List<+List<U32>>>
  for +limit: Nat
  for +prog: Bool
  for +length: Maybe<&2, Nat>
  for +size: Nat
  for basic: @+w: Nat -> @+eq: {size_b == Some{w} : Maybe<&2, Nat>} -> {TS.present(IR.single(IR.length_mix(IR.merkle(IR.packed(enc(Unit{})), IR.count_limit(Some{w}, limit), prog, Cache.zeros(size)), length))) == True{} : Bool}
  for +comp_present: {TS.present(comp(Unit{})) == True{} : Bool}
  for comp_scope: Scope.roots_scope(comp(Unit{}))
  for comp_count: G.rel_single(outs => TS.limit_ok(prog, outs, limit), comp(Unit{}))
  for fits: TS.fits_length(length)
  {TS.present(IR.single(IR.length_mix(IR.merkle(IR.choose_chunks(size_b, enc, comp), IR.count_limit(size_b, limit), prog, Cache.zeros(size)), length))) == True{} : Bool}
def sequence_present(size_b, enc, comp, limit, prog, length, size, basic, comp_present, comp_scope, comp_count, fits):
  match size_b:
    case None{}: TS.composite_present(comp(Unit{}), limit, prog, length, size, comp_present, comp_scope, comp_count, fits)
    case Some{w}: basic(w, {==})


