law pack_list_spec:
  for +xs: +List<U32>
  {P.pack_list(xs) == P.pack_spec(xs) : P.Packing}
def pack_list_spec(xs):
  Equal.trans(P.Packing, P.pack_list_go(xs, xs, 0n, True{}, []), P.pack_close(0n, True{}, [], P.pack_spec_go(xs, xs)), P.pack_spec_go(xs, xs),
    pack_acc(xs, 0n, True{}, []),
    pack_close_zero(P.pack_spec_go(xs, xs)))

# Every packing law therefore holds of the implementation.
law pack_list_view:
  for +xs: +List<U32>
  for +ok: {P.packing_domain(P.pack_list(xs)) == True{} : Bool}
  {P.packing_length(P.pack_list(xs)) == List.length(&2, U32, xs) : Nat} & {List.take(&2, U32, P.chunks_bytes(P.packing_chunks(P.pack_list(xs))), List.length(&2, U32, xs)) == xs : +List<U32>}
def pack_list_view(xs, ok):
  %Equal.sym(P.Packing, P.pack_list(xs), P.pack_spec(xs), pack_list_spec(xs)) : {P.packing_length(_) == List.length(&2, U32, xs) : Nat} & {List.take(&2, U32, P.chunks_bytes(P.packing_chunks(_)), List.length(&2, U32, xs)) == xs : +List<U32>}
  PP.pack_spec_view(xs, Equal.trans(Bool, P.packing_domain(P.pack_spec(xs)), P.packing_domain(P.pack_list(xs)), True{},
    Equal.cong(P.Packing, Bool, P.packing_domain, P.pack_spec(xs), P.pack_list(xs), Equal.sym(P.Packing, P.pack_list(xs), P.pack_spec(xs), pack_list_spec(xs))),
    ok))
