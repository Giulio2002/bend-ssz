    %Equal.sym(Nat, u32alg__sc(n, 0n), 0n, u32alg__sc_zero(n)) : {r1 == Nat.add(r1, _) : Nat}
    Equal.sym(Nat, Nat.add(r1, 0n), r1, nat__add_zero(r1)),
    %u32alg__sc_succ(n, q) : {Nat.add(r1, u32alg__sc(n, 0n)) == Nat.add(r2, _) : Nat}
    h)
  logic__true_false(Equal.trans(Bool, True{}, Nat.is_le(u32alg__sc(n, 1n), r1), False{}, Equal.sym(Bool, Nat.is_le(u32alg__sc(n, 1n), r1), True{}, logic__subst(Nat, z => {Nat.is_le(u32alg__sc(n, 1n), z) == True{} : Bool}, Nat.add(r2, Nat.add(u32alg__sc(n, 1n), u32alg__sc(n, q))), r1, Equal.sym(Nat, r1, Nat.add(r2, Nat.add(u32alg__sc(n, 1n), u32alg__sc(n, q))), e), u32alg__le_shift(r2, u32alg__sc(n, 1n), u32alg__sc(n, q)))), nat__lt_not_le(r1, u32alg__sc(n, 1n), b1)))

# r1 + 2^n x == r2 + 2^n y with r1, r2 < 2^n forces r1 == r2.
