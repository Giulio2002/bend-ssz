    case 0n:
      {==}
    case 1n+p:
      %Equal.sym(Nat, Nat.add(Nat.double(u32alg__sc(p, x)), Nat.double(u32alg__sc(p, y))), Nat.double(Nat.add(u32alg__sc(p, x), u32alg__sc(p, y))), nat__add_double(u32alg__sc(p, x), u32alg__sc(p, y))) : {_ == Nat.double(u32alg__sc(p, Nat.add(x, y))) : Nat}
      Equal.cong(Nat, Nat, Nat.double, Nat.add(u32alg__sc(p, x), u32alg__sc(p, y)), u32alg__sc(p, Nat.add(x, y)), u32alg__sc_add(p, x, y))

# M <= r + (M + s)
def u32alg__le_shift(+r: Nat, +m: Nat, +s: Nat) -> {Nat.is_le(m, Nat.add(r, Nat.add(m, s))) == True{} : Bool}:
  %nat__add_comm(Nat.add(m, s), r) : {Nat.is_le(m, _) == True{} : Bool}
  %Equal.sym(Nat, Nat.add(Nat.add(m, s), r), Nat.add(m, Nat.add(s, r)), nat__add_assoc(m, s, r)) : {Nat.is_le(m, _) == True{} : Bool}
  nat__le_add_right(m, Nat.add(s, r))

def u32alg__sc_succ(+n: Nat, +x: Nat) -> {u32alg__sc(n, 1n+x) == Nat.add(u32alg__sc(n, 1n), u32alg__sc(n, x)) : Nat}:
  Equal.sym(Nat, Nat.add(u32alg__sc(n, 1n), u32alg__sc(n, x)), u32alg__sc(n, Nat.add(1n, x)), u32alg__sc_add(n, 1n, x))

# r1 < 2^n cannot equal r2 + 2^n (1 + q).
def u32alg__uniq_gap(+n: Nat, +r1: Nat, +r2: Nat, +q: Nat, +h: {Nat.add(r1, u32alg__sc(n, 0n)) == Nat.add(r2, u32alg__sc(n, 1n+q)) : Nat}, +b1: {Nat.is_lt(r1, u32alg__sc(n, 1n)) == True{} : Bool}) -> Empty:
