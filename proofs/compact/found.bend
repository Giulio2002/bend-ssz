# Base List.append agrees with the specification append.
def list__base_append(-A: Data, +xs: List<&2, A>, +ys: List<&2, A>) -> {List.append(&2, A, xs, ys) == spec_common__append(A, xs, ys) : List<&2, A>}:
  match xs:
    case Nil{}:
      {==}
