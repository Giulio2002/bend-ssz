      {==}
    case Con{h1, t} 1n+p:
      list__nth_lt_length(A, t, p, x, h)

def list__nth_update_same(-A: Data, +xs: List<&2, A>, +i: Nat, +v: A, +h: {Nat.is_lt(i, spec_common__length(A, xs)) == True{} : Bool}) -> {spec_common__nth(A, spec_common__update(A, xs, i, v), i) == Some{v} : Maybe<&2, A>}:
