    case Con{h1, t} 0n:
      {==}
    case Con{+h1, t} 1n+p:
      list__cons_cong(A, h1, spec_common__update(A, spec_common__append(A, t, ys), p, v), spec_common__append(A, spec_common__update(A, t, p, v), ys), list__update_append_left(A, t, ys, p, v, h))

def list__update_append_right(-A: Data, +xs: List<&2, A>, +ys: List<&2, A>, +i: Nat, +v: A, +h: {Nat.is_le(spec_common__length(A, xs), i) == True{} : Bool}) -> {spec_common__update(A, spec_common__append(A, xs, ys), i, v) == spec_common__append(A, xs, spec_common__update(A, ys, Nat.sub(i, spec_common__length(A, xs)), v)) : List<&2, A>}:
  match xs i:
    case Nil{} _:
      %Equal.sym(Nat, Nat.sub(i, 0n), i, nat__sub_zero(i)) : {spec_common__update(A, ys, i, v) == spec_common__update(A, ys, _, v) : List<&2, A>}
      {==}
    case Con{h1, t} 0n:
      Empty.absurd({spec_common__update(A, spec_common__append(A, Con{h1, t}, ys), 0n, v) == spec_common__append(A, Con{h1, t}, spec_common__update(A, ys, Nat.sub(0n, 1n+spec_common__length(A, t)), v)) : List<&2, A>}, logic__false_true(h))
    case Con{+h1, t} 1n+p:
      list__cons_cong(A, h1, spec_common__update(A, spec_common__append(A, t, ys), p, v), spec_common__append(A, t, spec_common__update(A, ys, Nat.sub(p, spec_common__length(A, t)), v)), list__update_append_right(A, t, ys, p, v, h))

def list__length_update(-A: Data, +xs: List<&2, A>, +i: Nat, +v: A) -> {spec_common__length(A, spec_common__update(A, xs, i, v)) == spec_common__length(A, xs) : Nat}:
