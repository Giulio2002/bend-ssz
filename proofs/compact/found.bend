# Base compares high bits first. Mathematical interpretation preserves that
# exact comparison, including equality, at every width.
def lru_word_comparison__digits(a: Nat, b: Nat, x: Bool, y: Bool) -> {Nat.cmp(Nat.add(spec_numeric__bit_value(x), Nat.double(a)), Nat.add(spec_numeric__bit_value(y), Nat.double(b))) == Word.cmp.fin(x, y, Nat.cmp(a, b)) : Cmp}:
