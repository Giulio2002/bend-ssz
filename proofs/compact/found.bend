        Equal.cong(List<&2, A>, List<&2, A>, zs => spec_common__snoc(A, zs, h), spec_common__reverse(A, spec_common__append(A, t, ys)), spec_common__append(A, spec_common__reverse(A, ys), spec_common__reverse(A, t)), list__rev_append(A, t, ys)),
