def list__nth_lt_length(-A: Data, +xs: List<&2, A>, +i: Nat, +x: A, +h: {spec_common__nth(A, xs, i) == Some{x} : Maybe<&2, A>}) -> {Nat.is_lt(i, spec_common__length(A, xs)) == True{} : Bool}:
