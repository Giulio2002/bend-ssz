    case 0n: lru_word_value__le_refl(r)
    case 1n++p: lru_word_value__le_succ(r, Nat.add(p, r), lru_word_value__le_add(p, r))

# (M + r) + (1 + n) == (M + (1 + r)) + n
def lru_word_value__shift_count(+m: Nat, +r: Nat, +n: Nat) -> {Nat.add(Nat.add(m, r), 1n+n) == Nat.add(Nat.add(m, 1n+r), n) : Nat}:
  %Equal.sym(Nat, Nat.add(m, 1n+r), 1n+Nat.add(m, r), lru_nat_algebra__add_succ(m, r)) : {Nat.add(Nat.add(m, r), 1n+n) == Nat.add(_, n) : Nat}
  lru_nat_algebra__add_succ(Nat.add(m, r), n)

# (M + r) + (1 + n) == ((1+bp) + M + 0) + n when r == bp
def lru_word_value__shift_carry(+bp: Nat, +n: Nat, +m: Nat, +r: Nat, inv: {Nat.add(0n, r) == bp : Nat}) -> {Nat.add(Nat.add(m, r), 1n+n) == Nat.add(Nat.add(Nat.add(1n+bp, m), 0n), n) : Nat}:
  %Equal.sym(Nat, Nat.add(Nat.add(1n+bp, m), 0n), Nat.add(1n+bp, m), lru_nat_algebra__add_zero(Nat.add(1n+bp, m))) : {Nat.add(Nat.add(m, r), 1n+n) == Nat.add(_, n) : Nat}
  %Equal.sym(Nat, Nat.add(0n, r), bp, inv) : {Nat.add(Nat.add(m, _), 1n+n) == 1n+Nat.add(Nat.add(bp, m), n) : Nat}
  %lru_nat_algebra__add_comm(m, bp) : {Nat.add(Nat.add(m, bp), 1n+n) == 1n+Nat.add(_, n) : Nat}
  lru_nat_algebra__add_succ(Nat.add(m, bp), n)

def lru_word_value__go_equation(bp: Nat, n: Nat, m: Nat, d: Nat, r: Nat) -> Type:
  {Nat.add(Nat.add(Nat.mul(d, 1n+bp), r), n) == Nat.add(Nat.mul(Pair.fst(Nat, Nat, Nat.divmod.go(n, m, d, r)), 1n+bp), Pair.snd(Nat, Nat, Nat.divmod.go(n, m, d, r))) : Nat} & {Nat.is_le(Pair.snd(Nat, Nat, Nat.divmod.go(n, m, d, r)), bp) == True{} : Bool}

def lru_word_value__bound_zero(+bp: Nat, +m: Nat, +r: Nat, inv: {Nat.add(m, r) == bp : Nat}) -> {Nat.is_le(r, bp) == True{} : Bool}:
  %inv : {Nat.is_le(r, _) == True{} : Bool}
  lru_word_value__le_add(m, r)

def lru_word_value__extend(+a: Nat, +b: Nat, +c: Nat, -L: Type, pre: {a == b : Nat}, ih: {b == c : Nat} & L) -> {a == c : Nat} & L:
  (eq, le) = ih
  (Equal.trans(Nat, a, b, c, pre, eq), le)

# Invariant of the actual division loop: remaining countdown m plus the running
# remainder r is the divisor minus one.
def lru_word_value__go(+bp: Nat, n: Nat, m: Nat, +d: Nat, +r: Nat, +inv: {Nat.add(m, r) == bp : Nat}) -> lru_word_value__go_equation(bp, n, m, d, r):
  match n:
    case 0n:
      (lru_nat_algebra__add_zero(Nat.add(Nat.mul(d, 1n+bp), r)), lru_word_value__bound_zero(bp, m, r, inv))
    case 1n++np:
      match m:
        case 0n:
          lru_word_value__extend(Nat.add(Nat.add(Nat.mul(d, 1n+bp), r), 1n+np), Nat.add(Nat.add(Nat.mul(1n+d, 1n+bp), 0n), np), Nat.add(Nat.mul(Pair.fst(Nat, Nat, Nat.divmod.go(np, r, 1n+d, 0n)), 1n+bp), Pair.snd(Nat, Nat, Nat.divmod.go(np, r, 1n+d, 0n))), {Nat.is_le(Pair.snd(Nat, Nat, Nat.divmod.go(np, r, 1n+d, 0n)), bp) == True{} : Bool}, lru_word_value__shift_carry(bp, np, Nat.mul(d, 1n+bp), r, inv), lru_word_value__go(bp, np, r, 1n+d, 0n, Equal.trans(Nat, Nat.add(r, 0n), r, bp, lru_nat_algebra__add_zero(r), inv)))
        case 1n++mp:
          lru_word_value__extend(Nat.add(Nat.add(Nat.mul(d, 1n+bp), r), 1n+np), Nat.add(Nat.add(Nat.mul(d, 1n+bp), 1n+r), np), Nat.add(Nat.mul(Pair.fst(Nat, Nat, Nat.divmod.go(np, mp, d, 1n+r)), 1n+bp), Pair.snd(Nat, Nat, Nat.divmod.go(np, mp, d, 1n+r))), {Nat.is_le(Pair.snd(Nat, Nat, Nat.divmod.go(np, mp, d, 1n+r)), bp) == True{} : Bool}, lru_word_value__shift_count(Nat.mul(d, 1n+bp), r, np), lru_word_value__go(bp, np, mp, d, 1n+r, Equal.trans(Nat, Nat.add(mp, 1n+r), 1n+Nat.add(mp, r), bp, lru_nat_algebra__add_succ(mp, r), inv)))

# v == 2*(v/2) + v%2 and v%2 <= 1, for the actual Nat.divmod.
def lru_word_value__half(+v: Nat) -> {Nat.add(Nat.add(Nat.mul(0n, 2n), 0n), v) == Nat.add(Nat.mul(Nat.div(v, 2n), 2n), Nat.mod(v, 2n)) : Nat} & {Nat.is_le(Nat.mod(v, 2n), 1n) == True{} : Bool}:
  lru_word_value__go(1n, v, 1n, 0n, 0n, {==})

def lru_word_value__remainder_bit(r: Nat, le: {Nat.is_le(r, 1n) == True{} : Bool}) -> {spec_numeric__bit_value(Nat.is_eq(r, 1n)) == r : Nat}:
  match r:
    case 0n: {==}
    case 1n+x:
      match x:
        case 0n: {==}
        case 1n+y: Empty.absurd({spec_numeric__bit_value(Nat.is_eq(2n+y, 1n)) == 2n+y : Nat}, lru_map_routing__false_true(le))

def lru_word_value__not_below_zero(n: Nat) -> {Nat.is_lt(n, 0n) == False{} : Bool}:
  match n:
    case 0n: {==}
    case 1n+p: {==}

def lru_word_value__lt_double(q: Nat, x: Nat, +r: Nat, h: {Nat.is_lt(Nat.add(Nat.double(q), r), Nat.double(x)) == True{} : Bool}) -> {Nat.is_lt(q, x) == True{} : Bool}:
  match q x:
    case q0 0n: Empty.absurd({Nat.is_lt(q0, 0n) == True{} : Bool}, lru_map_routing__false_true(Equal.trans(Bool, False{}, Nat.is_lt(Nat.add(Nat.double(q0), r), 0n), True{}, Equal.sym(Bool, Nat.is_lt(Nat.add(Nat.double(q0), r), 0n), False{}, lru_word_value__not_below_zero(Nat.add(Nat.double(q0), r))), h)))
    case 0n 1n+xp: {==}
    case 1n+qp 1n+xp: lru_word_value__lt_double(qp, xp, r, h)

def lru_word_value__two_times(+q: Nat) -> {Nat.mul(q, 2n) == Nat.double(q) : Nat}:
  Equal.trans(Nat, Nat.mul(q, 2n), Nat.mul(2n, q), Nat.double(q), lru_nat_algebra__mul_comm(q, 2n), Equal.sym(Nat, Nat.double(q), Nat.mul(2n, q), lru_nat_algebra__double_mul(q)))

# v < 2 * 2^p, rewritten as 2*(v/2) + v%2 < double(2^p)
def lru_word_value__rescale(+p: Nat, +v: Nat, eq: {v == Nat.add(Nat.mul(Nat.div(v, 2n), 2n), Nat.mod(v, 2n)) : Nat}, bound: {Nat.is_lt(v, Nat.mul(2n, Nat.pow(2n, p))) == True{} : Bool}) -> {Nat.is_lt(Nat.add(Nat.double(Nat.div(v, 2n)), Nat.mod(v, 2n)), Nat.double(Nat.pow(2n, p))) == True{} : Bool}:
  %Equal.sym(Nat, Nat.double(Nat.pow(2n, p)), Nat.mul(2n, Nat.pow(2n, p)), lru_nat_algebra__double_mul(Nat.pow(2n, p))) : {Nat.is_lt(Nat.add(Nat.double(Nat.div(v, 2n)), Nat.mod(v, 2n)), _) == True{} : Bool}
  %lru_word_value__two_times(Nat.div(v, 2n)) : {Nat.is_lt(Nat.add(_, Nat.mod(v, 2n)), Nat.mul(2n, Nat.pow(2n, p))) == True{} : Bool}
  %eq : {Nat.is_lt(_, Nat.mul(2n, Nat.pow(2n, p))) == True{} : Bool}
  bound

def lru_word_value__from_nat_step(+p: Nat, +v: Nat, parts: {v == Nat.add(Nat.mul(Nat.div(v, 2n), 2n), Nat.mod(v, 2n)) : Nat} & {Nat.is_le(Nat.mod(v, 2n), 1n) == True{} : Bool}, bound: {Nat.is_lt(v, Nat.mul(2n, Nat.pow(2n, p))) == True{} : Bool}, ih: @+q: Nat -> @hq: {Nat.is_lt(q, Nat.pow(2n, p)) == True{} : Bool} -> {spec_numeric__unsigned(p, spec_numeric__from_nat(p, q)) == q : Nat}) -> {spec_numeric__unsigned(1n+p, spec_numeric__from_nat(1n+p, v)) == v : Nat}:
  (+eq, le) = parts
  %Equal.sym(Nat, spec_numeric__unsigned(p, spec_numeric__from_nat(p, Nat.div(v, 2n))), Nat.div(v, 2n), ih(Nat.div(v, 2n), lru_word_value__lt_double(Nat.div(v, 2n), Nat.pow(2n, p), Nat.mod(v, 2n), lru_word_value__rescale(p, v, eq, bound)))) : {Nat.add(spec_numeric__bit_value(Nat.is_eq(Nat.mod(v, 2n), 1n)), Nat.double(_)) == v : Nat}
  %Equal.sym(Nat, spec_numeric__bit_value(Nat.is_eq(Nat.mod(v, 2n), 1n)), Nat.mod(v, 2n), lru_word_value__remainder_bit(Nat.mod(v, 2n), le)) : {Nat.add(_, Nat.double(Nat.div(v, 2n))) == v : Nat}
  %Equal.sym(Nat, v, Nat.add(Nat.mul(Nat.div(v, 2n), 2n), Nat.mod(v, 2n)), eq) : {Nat.add(Nat.mod(v, 2n), Nat.double(Nat.div(v, 2n))) == _ : Nat}
  %Equal.sym(Nat, Nat.mul(Nat.div(v, 2n), 2n), Nat.double(Nat.div(v, 2n)), lru_word_value__two_times(Nat.div(v, 2n))) : {Nat.add(Nat.mod(v, 2n), Nat.double(Nat.div(v, 2n))) == Nat.add(_, Nat.mod(v, 2n)) : Nat}
  lru_nat_algebra__add_comm(Nat.mod(v, 2n), Nat.double(Nat.div(v, 2n)))

def lru_word_value__below_one(v: Nat, h: {Nat.is_lt(v, 1n) == True{} : Bool}) -> {0n == v : Nat}:
  match v:
    case 0n: {==}
    case 1n+x:
      match x:
        case 0n: Empty.absurd({0n == 1n : Nat}, lru_map_routing__false_true(h))
        case 1n+y: Empty.absurd({0n == 2n+y : Nat}, lru_map_routing__false_true(h))

def lru_word_value__half_parts(+v: Nat) -> {v == Nat.add(Nat.mul(Nat.div(v, 2n), 2n), Nat.mod(v, 2n)) : Nat} & {Nat.is_le(Nat.mod(v, 2n), 1n) == True{} : Bool}:
  lru_word_value__half(v)

def lru_word_value__from_nat_value(n: Nat, +v: Nat, h: {Nat.is_lt(v, Nat.pow(2n, n)) == True{} : Bool}) -> {spec_numeric__unsigned(n, spec_numeric__from_nat(n, v)) == v : Nat}:
  match n:
    case 0n: lru_word_value__below_one(v, h)
    case 1n++p: lru_word_value__from_nat_step(p, v, lru_word_value__half_parts(v), h, q => hq => lru_word_value__from_nat_value(p, q, hq))


# ==== proofs/lib/u32.bend ====

def u32__to_nat_word(+w: Word(32n)) -> {U32.to_nat(U32{w}) == spec_numeric__unsigned(32n, w) : Nat}:
  lru_numeric__primitive_word_interpretation(32n, w)

def u32__pow2_scale(+k: Nat) -> {spec_common__pow2(k) == spec_numeric__scale_binary(k, 1n) : Nat}:
  match k:
    case 0n:
      {==}
    case 1n+p:
      Equal.cong(Nat, Nat, Nat.double, spec_common__pow2(p), spec_numeric__scale_binary(p, 1n), u32__pow2_scale(p))

def u32__double_pow(+x: Nat) -> {Nat.double(x) == Nat.add(x, Nat.add(x, 0n)) : Nat}:
  %Equal.sym(Nat, Nat.add(x, 0n), x, nat__add_zero(x)) : {Nat.double(x) == Nat.add(x, _) : Nat}
  lru_nat_algebra__double_self(x)

def u32__pow2_pow(+k: Nat) -> {spec_common__pow2(k) == Nat.pow(2n, k) : Nat}:
  match k:
    case 0n:
      {==}
    case 1n+p:
      %u32__pow2_pow(p) : {Nat.double(spec_common__pow2(p)) == Nat.add(_, Nat.add(_, 0n)) : Nat}
      u32__double_pow(spec_common__pow2(p))

# Every word is recovered from its unsigned interpretation (reconstruct at 0).
def u32__word_from_unsigned(+w: Word(32n)) -> {spec_numeric__from_nat(32n, spec_numeric__unsigned(32n, w)) == w : Word(32n)}:
  %nat__add_zero(spec_numeric__unsigned(32n, w)) : {spec_numeric__from_nat(32n, _) == w : Word(32n)}
  lru_modular_addition__reconstruct(32n, w, 0n)

def u32__injective(+a: U32, +b: U32, +e: {U32.to_nat(a) == U32.to_nat(b) : Nat}) -> {a == b : U32}:
  match a b:
    case U32{+x} U32{+y}:
      Equal.cong(Word(32n), U32, w => U32{w}, x, y,
        Equal.trans(Word(32n), x, spec_numeric__from_nat(32n, spec_numeric__unsigned(32n, x)), y,
          Equal.sym(Word(32n), spec_numeric__from_nat(32n, spec_numeric__unsigned(32n, x)), x, u32__word_from_unsigned(x)),
          Equal.trans(Word(32n), spec_numeric__from_nat(32n, spec_numeric__unsigned(32n, x)), spec_numeric__from_nat(32n, spec_numeric__unsigned(32n, y)), y,
            Equal.cong(Nat, Word(32n), v => spec_numeric__from_nat(32n, v), spec_numeric__unsigned(32n, x), spec_numeric__unsigned(32n, y),
              Equal.trans(Nat, spec_numeric__unsigned(32n, x), U32.to_nat(U32{x}), spec_numeric__unsigned(32n, y),
                Equal.sym(Nat, U32.to_nat(U32{x}), spec_numeric__unsigned(32n, x), u32__to_nat_word(x)),
                Equal.trans(Nat, U32.to_nat(U32{x}), U32.to_nat(U32{y}), spec_numeric__unsigned(32n, y), e, u32__to_nat_word(y)))),
            u32__word_from_unsigned(y))))

def u32__pow2_le_pow(+n: Nat, +k: Nat, +hk: {Nat.is_le(k, n) == True{} : Bool}) -> {Nat.is_le(spec_common__pow2(k), Nat.pow(2n, n)) == True{} : Bool}:
  %u32__pow2_pow(n) : {Nat.is_le(spec_common__pow2(k), _) == True{} : Bool}
  nat__pow2_mono(k, n, hk)

def u32__pow2_le_scale(+n: Nat, +k: Nat, +hk: {Nat.is_le(k, n) == True{} : Bool}) -> {Nat.is_le(spec_common__pow2(k), spec_numeric__scale_binary(n, 1n)) == True{} : Bool}:
  %u32__pow2_scale(n) : {Nat.is_le(spec_common__pow2(k), _) == True{} : Bool}
  nat__pow2_mono(k, n, hk)

# Width-generic wrappers: bounds are 2^k with k <= n, never a closed 2^32.
def u32__from_nat_value_k(+n: Nat, +k: Nat, +v: Nat, +hk: {Nat.is_le(k, n) == True{} : Bool}, +hv: {Nat.is_lt(v, spec_common__pow2(k)) == True{} : Bool}) -> {spec_numeric__unsigned(n, spec_numeric__from_nat(n, v)) == v : Nat}:
  lru_word_value__from_nat_value(n, v, nat__lt_le_trans(v, spec_common__pow2(k), Nat.pow(2n, n), hv, u32__pow2_le_pow(n, k, hk)))

def u32__shl_exact_k(+n: Nat, +k: Nat, +w: Word(n), +hk: {Nat.is_le(k, n) == True{} : Bool}, +h: {Nat.is_lt(Nat.double(spec_numeric__unsigned(n, w)), spec_common__pow2(k)) == True{} : Bool}) -> {spec_numeric__unsigned(n, Word.shl(n, w)) == Nat.double(spec_numeric__unsigned(n, w)) : Nat}:
  lru_word_shift__exact(n, w, nat__lt_le_trans(Nat.double(spec_numeric__unsigned(n, w)), spec_common__pow2(k), spec_numeric__scale_binary(n, 1n), h, u32__pow2_le_scale(n, k, hk)))

def u32__from_nat_word(+i: Nat, +k: Nat, +hk: {Nat.is_le(k, 32n) == True{} : Bool}, +h: {Nat.is_lt(i, spec_common__pow2(k)) == True{} : Bool}) -> {U32.from_nat(i) == U32{spec_numeric__from_nat(32n, i)} : U32}:
  match i:
    case 0n:
      {==}
    case 1n+p:
      %Equal.sym(U32, U32.from_nat(p), U32{spec_numeric__from_nat(32n, p)}, u32__from_nat_word(p, k, hk, nat__lt_trans(p, 1n+p, spec_common__pow2(k), nat__lt_succ(p), h))) : {U32.inc(_) == U32{spec_numeric__from_nat(32n, 1n+p)} : U32}
      Equal.cong(Word(32n), U32, w => U32{w}, Word.inc(32n, spec_numeric__from_nat(32n, p)), spec_numeric__from_nat(32n, 1n+p),
        Equal.trans(Word(32n), Word.inc(32n, spec_numeric__from_nat(32n, p)), spec_numeric__from_nat(32n, 1n+spec_numeric__unsigned(32n, spec_numeric__from_nat(32n, p))), spec_numeric__from_nat(32n, 1n+p),
          lru_modular_addition__increment_refines(32n, spec_numeric__from_nat(32n, p)),
          Equal.cong(Nat, Word(32n), v => spec_numeric__from_nat(32n, 1n+v), spec_numeric__unsigned(32n, spec_numeric__from_nat(32n, p)), p,
            u32__from_nat_value_k(32n, k, p, hk, nat__lt_trans(p, 1n+p, spec_common__pow2(k), nat__lt_succ(p), h)))))

def u32__to_nat_from_nat(+i: Nat, +k: Nat, +hk: {Nat.is_le(k, 32n) == True{} : Bool}, +h: {Nat.is_lt(i, spec_common__pow2(k)) == True{} : Bool}) -> {U32.to_nat(U32.from_nat(i)) == i : Nat}:
  %Equal.sym(U32, U32.from_nat(i), U32{spec_numeric__from_nat(32n, i)}, u32__from_nat_word(i, k, hk, h)) : {U32.to_nat(_) == i : Nat}
  Equal.trans(Nat, U32.to_nat(U32{spec_numeric__from_nat(32n, i)}), spec_numeric__unsigned(32n, spec_numeric__from_nat(32n, i)), i, u32__to_nat_word(spec_numeric__from_nat(32n, i)), u32__from_nat_value_k(32n, k, i, hk, h))

def u32__is_lt_nat(+a: U32, +b: U32) -> {U32.is_lt(a, b) == Nat.is_lt(U32.to_nat(a), U32.to_nat(b)) : Bool}:
  lru_word_comparison__u32_lt(a, b)

def u32__sub_nat(+a: U32, +b: U32, +e: {Nat.is_le(U32.to_nat(b), U32.to_nat(a)) == True{} : Bool}) -> {U32.to_nat(U32.sub(a, b)) == Nat.sub(U32.to_nat(a), U32.to_nat(b)) : Nat}:
  lru_subtraction_bounds__u32_exact(a, b, e)

def u32__WB_unsigned(+n: Nat, +w: Word(n)) -> {Nat.is_lt(spec_numeric__unsigned(n, w), spec_numeric__scale_binary(n, 1n)) == True{} : Bool}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      match w:
        case WCon{b, t}:
          nat__double_lt_bit(b, spec_numeric__unsigned(p, t), spec_numeric__scale_binary(p, 1n), u32__WB_unsigned(p, t))

# ---- doubling (shl) and halving (shr) ----
def u32__shl_bound(+w: Word(32n), +k: Nat, +h: {Nat.is_lt(Nat.double(U32.to_nat(U32{w})), spec_common__pow2(k)) == True{} : Bool}) -> {Nat.is_lt(Nat.double(spec_numeric__unsigned(32n, w)), spec_common__pow2(k)) == True{} : Bool}:
  %u32__to_nat_word(w) : {Nat.is_lt(Nat.double(_), spec_common__pow2(k)) == True{} : Bool}
  h

def u32__shl_value(+x: U32, +k: Nat, +hk: {Nat.is_le(k, 32n) == True{} : Bool}, +h: {Nat.is_lt(Nat.double(U32.to_nat(x)), spec_common__pow2(k)) == True{} : Bool}) -> {U32.to_nat(U32.shl(x)) == Nat.double(U32.to_nat(x)) : Nat}:
  match x:
    case U32{+w}:
      %Equal.sym(Nat, U32.to_nat(U32{w}), spec_numeric__unsigned(32n, w), u32__to_nat_word(w)) : {U32.to_nat(U32{Word.shl(32n, w)}) == Nat.double(_) : Nat}
      Equal.trans(Nat, U32.to_nat(U32{Word.shl(32n, w)}), spec_numeric__unsigned(32n, Word.shl(32n, w)), Nat.double(spec_numeric__unsigned(32n, w)), u32__to_nat_word(Word.shl(32n, w)),
        u32__shl_exact_k(32n, k, w, hk, u32__shl_bound(w, k, h)))

def u32__pad_value(+n: Nat, +w: Word(n)) -> {spec_numeric__unsigned(1n+n, Word.shr.pad(n, w)) == spec_numeric__unsigned(n, w) : Nat}:
  match n:
    case 0n:
      match w:
        case WNil{}:
          {==}
    case 1n+p:
      match w:
        case WCon{b, t}:
          Equal.cong(Nat, Nat, v => Nat.add(spec_numeric__bit_value(b), Nat.double(v)), spec_numeric__unsigned(1n+p, Word.shr.pad(p, t)), spec_numeric__unsigned(p, t), u32__pad_value(p, t))

def u32__low_bit(x: U32) -> Bool:
  match x:
    case U32{w}:
      match w:
        case WCon{b, t}:
          b

def u32__shr_split(+x: U32) -> {U32.to_nat(x) == Nat.add(spec_numeric__bit_value(u32__low_bit(x)), Nat.double(U32.to_nat(U32.shr(x)))) : Nat}:
  match x:
    case U32{w}:
      match w:
        case WCon{+b, +t}:
          %Equal.sym(Nat, U32.to_nat(U32{WCon{b, t}}), spec_numeric__unsigned(32n, WCon{b, t}), u32__to_nat_word(WCon{b, t})) : {_ == Nat.add(spec_numeric__bit_value(b), Nat.double(U32.to_nat(U32{Word.shr.pad(31n, t)}))) : Nat}
          %Equal.sym(Nat, U32.to_nat(U32{Word.shr.pad(31n, t)}), spec_numeric__unsigned(32n, Word.shr.pad(31n, t)), u32__to_nat_word(Word.shr.pad(31n, t))) : {spec_numeric__unsigned(32n, WCon{b, t}) == Nat.add(spec_numeric__bit_value(b), Nat.double(_)) : Nat}
          %Equal.sym(Nat, spec_numeric__unsigned(32n, Word.shr.pad(31n, t)), spec_numeric__unsigned(31n, t), u32__pad_value(31n, t)) : {spec_numeric__unsigned(32n, WCon{b, t}) == Nat.add(spec_numeric__bit_value(b), Nat.double(_)) : Nat}
          {==}

# 2^d as the U32 built by Base Array.size (1, then shl per level).
def u32__pow2u(d: Nat) -> U32:
  match d:
    case 0n:
      1
    case 1n+p:
      U32.shl(u32__pow2u(p))

def u32__pow2u_shl_bound(+p: Nat, +ih: {U32.to_nat(u32__pow2u(p)) == spec_common__pow2(p) : Nat}) -> {Nat.is_lt(Nat.double(U32.to_nat(u32__pow2u(p))), spec_common__pow2(2n+p)) == True{} : Bool}:
  %Equal.sym(Nat, U32.to_nat(u32__pow2u(p)), spec_common__pow2(p), ih) : {Nat.is_lt(Nat.double(_), spec_common__pow2(2n+p)) == True{} : Bool}
  nat__pow2_lt_succ(1n+p)

def u32__pow2u_value(+d: Nat, +h: {Nat.is_lt(d, 32n) == True{} : Bool}) -> {U32.to_nat(u32__pow2u(d)) == spec_common__pow2(d) : Nat}:
  match d:
    case 0n:
      {==}
    case 1n+p:
      +ih = u32__pow2u_value(p, nat__lt_trans(p, 1n+p, 32n, nat__lt_succ(p), h))
      Equal.trans(Nat, U32.to_nat(U32.shl(u32__pow2u(p))), Nat.double(U32.to_nat(u32__pow2u(p))), Nat.double(spec_common__pow2(p)),
        u32__shl_value(u32__pow2u(p), 2n+p, nat__lt_succ_le_succ(1n+p, 32n, h), u32__pow2u_shl_bound(p, ih)),
        Equal.cong(Nat, Nat, Nat.double, U32.to_nat(u32__pow2u(p)), spec_common__pow2(p), ih))

def u32__shr_pow2u(+p: Nat, +h: {Nat.is_lt(1n+p, 32n) == True{} : Bool}) -> {U32.shr(u32__pow2u(1n+p)) == u32__pow2u(p) : U32}:
  u32__injective(U32.shr(u32__pow2u(1n+p)), u32__pow2u(p),
    Equal.trans(Nat, U32.to_nat(U32.shr(u32__pow2u(1n+p))), spec_common__pow2(p), U32.to_nat(u32__pow2u(p)),
      nat__bit_split_val(u32__low_bit(u32__pow2u(1n+p)), False{}, U32.to_nat(U32.shr(u32__pow2u(1n+p))), spec_common__pow2(p),
        Equal.trans(Nat, Nat.add(spec_numeric__bit_value(u32__low_bit(u32__pow2u(1n+p))), Nat.double(U32.to_nat(U32.shr(u32__pow2u(1n+p))))), U32.to_nat(u32__pow2u(1n+p)), Nat.double(spec_common__pow2(p)),
          Equal.sym(Nat, U32.to_nat(u32__pow2u(1n+p)), Nat.add(spec_numeric__bit_value(u32__low_bit(u32__pow2u(1n+p))), Nat.double(U32.to_nat(U32.shr(u32__pow2u(1n+p))))), u32__shr_split(u32__pow2u(1n+p))),
          u32__pow2u_value(1n+p, h))),
      Equal.sym(Nat, U32.to_nat(u32__pow2u(p)), spec_common__pow2(p), u32__pow2u_value(p, nat__lt_trans(p, 1n+p, 32n, nat__lt_succ(p), h)))))

# ---- low-bit masks ----
def u32__and_true(+b: Bool) -> {Bool.and(b, True{}) == b : Bool}:
  match b:
    case False{}:
      {==}
    case True{}:
      {==}

def u32__lt_one_zero(+v: Nat, +e: {Nat.is_lt(v, 1n) == True{} : Bool}) -> {v == 0n : Nat}:
  match v:
    case 0n:
      {==}
    case 1n+p:
      Empty.absurd({1n+p == 0n : Nat}, nat__lt_zero_absurd(p, e))

def u32__and_low_prev(d: Nat) -> Nat:
  match d:
    case 0n:
      0n
    case 1n+k:
      k

def u32__and_low_hy(+m: Nat, +d: Nat, +yb: Bool, +yt: Word(m), +hy: {Nat.add(spec_numeric__bit_value(yb), Nat.double(spec_numeric__unsigned(m, yt))) == Nat.sub(spec_common__pow2(d), 1n) : Nat}) -> {spec_numeric__unsigned(m, yt) == Nat.sub(spec_common__pow2(u32__and_low_prev(d)), 1n) : Nat}:
  match d:
    case 0n:
      nat__bit_split_val(yb, False{}, spec_numeric__unsigned(m, yt), 0n, hy)
    case 1n+k:
      nat__bit_split_val(yb, True{}, spec_numeric__unsigned(m, yt), Nat.sub(spec_common__pow2(k), 1n), Equal.trans(Nat, Nat.add(spec_numeric__bit_value(yb), Nat.double(spec_numeric__unsigned(m, yt))), Nat.sub(Nat.double(spec_common__pow2(k)), 1n), 1n+Nat.double(Nat.sub(spec_common__pow2(k), 1n)), hy, nat__pred_double(spec_common__pow2(k), nat__pow2_pos(k))))

def u32__and_low_hyb(+m: Nat, +d: Nat, +yb: Bool, +yt: Word(m), +hy: {Nat.add(spec_numeric__bit_value(yb), Nat.double(spec_numeric__unsigned(m, yt))) == Nat.sub(spec_common__pow2(d), 1n) : Nat}) -> {yb == Bool.not(nat__is_zero(d)) : Bool}:
  match d:
    case 0n:
      nat__bit_split_bit(yb, False{}, spec_numeric__unsigned(m, yt), 0n, hy)
    case 1n+k:
      nat__bit_split_bit(yb, True{}, spec_numeric__unsigned(m, yt), Nat.sub(spec_common__pow2(k), 1n), Equal.trans(Nat, Nat.add(spec_numeric__bit_value(yb), Nat.double(spec_numeric__unsigned(m, yt))), Nat.sub(Nat.double(spec_common__pow2(k)), 1n), 1n+Nat.double(Nat.sub(spec_common__pow2(k), 1n)), hy, nat__pred_double(spec_common__pow2(k), nat__pow2_pos(k))))

def u32__and_low_hx(+m: Nat, +d: Nat, +xb: Bool, +xt: Word(m), +hx: {Nat.is_lt(Nat.add(spec_numeric__bit_value(xb), Nat.double(spec_numeric__unsigned(m, xt))), spec_common__pow2(d)) == True{} : Bool}) -> {Nat.is_lt(spec_numeric__unsigned(m, xt), spec_common__pow2(u32__and_low_prev(d))) == True{} : Bool}:
  match d:
    case 0n:
      %Equal.sym(Nat, spec_numeric__unsigned(m, xt), 0n, nat__bit_split_val(xb, False{}, spec_numeric__unsigned(m, xt), 0n, u32__lt_one_zero(Nat.add(spec_numeric__bit_value(xb), Nat.double(spec_numeric__unsigned(m, xt))), hx))) : {Nat.is_lt(_, 1n) == True{} : Bool}
      {==}
    case 1n+k:
      nat__bit_double_lt(xb, spec_numeric__unsigned(m, xt), spec_common__pow2(k), hx)

def u32__and_low_hxb(+m: Nat, +xb: Bool, +xt: Word(m), +hx: {Nat.is_lt(Nat.add(spec_numeric__bit_value(xb), Nat.double(spec_numeric__unsigned(m, xt))), 1n) == True{} : Bool}) -> {xb == False{} : Bool}:
  nat__bit_split_bit(xb, False{}, spec_numeric__unsigned(m, xt), 0n, u32__lt_one_zero(Nat.add(spec_numeric__bit_value(xb), Nat.double(spec_numeric__unsigned(m, xt))), hx))

def u32__and_low_step(+m: Nat, +d: Nat, +xb: Bool, +xt: Word(m), +yb: Bool, +yt: Word(m), +hy: {Nat.add(spec_numeric__bit_value(yb), Nat.double(spec_numeric__unsigned(m, yt))) == Nat.sub(spec_common__pow2(d), 1n) : Nat}, +hx: {Nat.is_lt(Nat.add(spec_numeric__bit_value(xb), Nat.double(spec_numeric__unsigned(m, xt))), spec_common__pow2(d)) == True{} : Bool}, +ih: {Word.and(m, xt, yt) == xt : Word(m)}) -> {WCon{Bool.and(xb, yb), Word.and(m, xt, yt)} == WCon{xb, xt} : Word(1n+m)}:
  match d:
    case 0n:
      %Equal.sym(Word(m), Word.and(m, xt, yt), xt, ih) : {WCon{Bool.and(xb, yb), _} == WCon{xb, xt} : Word(1n+m)}
      %Equal.sym(Bool, yb, False{}, u32__and_low_hyb(m, 0n, yb, yt, hy)) : {WCon{Bool.and(xb, _), xt} == WCon{xb, xt} : Word(1n+m)}
      %Equal.sym(Bool, xb, False{}, u32__and_low_hxb(m, xb, xt, hx)) : {WCon{Bool.and(_, False{}), xt} == WCon{_, xt} : Word(1n+m)}
      {==}
    case 1n+k:
      %Equal.sym(Word(m), Word.and(m, xt, yt), xt, ih) : {WCon{Bool.and(xb, yb), _} == WCon{xb, xt} : Word(1n+m)}
      %Equal.sym(Bool, yb, True{}, u32__and_low_hyb(m, 1n+k, yb, yt, hy)) : {WCon{Bool.and(xb, _), xt} == WCon{xb, xt} : Word(1n+m)}
      %Equal.sym(Bool, Bool.and(xb, True{}), xb, u32__and_true(xb)) : {WCon{_, xt} == WCon{xb, xt} : Word(1n+m)}
      {==}

def u32__and_low(+n: Nat, +d: Nat, +x: Word(n), +y: Word(n), +hy: {spec_numeric__unsigned(n, y) == Nat.sub(spec_common__pow2(d), 1n) : Nat}, +hx: {Nat.is_lt(spec_numeric__unsigned(n, x), spec_common__pow2(d)) == True{} : Bool}) -> {Word.and(n, x, y) == x : Word(n)}:
  match n:
    case 0n:
      match x y:
        case WNil{} WNil{}:
          {==}
    case 1n+m:
      match x y:
        case WCon{+xb, +xt} WCon{+yb, +yt}:
          u32__and_low_step(m, d, xb, xt, yb, yt, hy, hx, u32__and_low(m, u32__and_low_prev(d), xt, yt, u32__and_low_hy(m, d, yb, yt, hy), u32__and_low_hx(m, d, xb, xt, hx)))

def u32__mask_hx(+wx: Word(32n), +d: Nat, +hx: {Nat.is_lt(U32.to_nat(U32{wx}), spec_common__pow2(d)) == True{} : Bool}) -> {Nat.is_lt(spec_numeric__unsigned(32n, wx), spec_common__pow2(d)) == True{} : Bool}:
  %u32__to_nat_word(wx) : {Nat.is_lt(_, spec_common__pow2(d)) == True{} : Bool}
  hx

def u32__mask_word(+x: U32, +y: U32, +d: Nat, +hy: {U32.to_nat(y) == Nat.sub(spec_common__pow2(d), 1n) : Nat}, +hx: {Nat.is_lt(U32.to_nat(x), spec_common__pow2(d)) == True{} : Bool}) -> {U32.and(x, y) == x : U32}:
  match x y:
    case U32{+wx} U32{+wy}:
      Equal.cong(Word(32n), U32, w => U32{w}, Word.and(32n, wx, wy), wx,
        u32__and_low(32n, d, wx, wy,
          Equal.trans(Nat, spec_numeric__unsigned(32n, wy), U32.to_nat(U32{wy}), Nat.sub(spec_common__pow2(d), 1n), Equal.sym(Nat, U32.to_nat(U32{wy}), spec_numeric__unsigned(32n, wy), u32__to_nat_word(wy)), hy),
          u32__mask_hx(wx, d, hx)))

# Base Array masks every index with size - 1; below the size this is the identity.
def u32__one_le_pow2u(+d: Nat, +hd: {Nat.is_lt(d, 32n) == True{} : Bool}) -> {Nat.is_le(U32.to_nat(1), U32.to_nat(u32__pow2u(d))) == True{} : Bool}:
  %Equal.sym(Nat, U32.to_nat(u32__pow2u(d)), spec_common__pow2(d), u32__pow2u_value(d, hd)) : {Nat.is_le(1n, _) == True{} : Bool}
  nat__pow2_pos(d)

def u32__mask_pow2u(+x: U32, +d: Nat, +hd: {Nat.is_lt(d, 32n) == True{} : Bool}, +hx: {Nat.is_lt(U32.to_nat(x), spec_common__pow2(d)) == True{} : Bool}) -> {U32.and(x, U32.sub(u32__pow2u(d), 1)) == x : U32}:
  u32__mask_word(x, U32.sub(u32__pow2u(d), 1), d,
    Equal.trans(Nat, U32.to_nat(U32.sub(u32__pow2u(d), 1)), Nat.sub(U32.to_nat(u32__pow2u(d)), 1n), Nat.sub(spec_common__pow2(d), 1n),
      u32__sub_nat(u32__pow2u(d), 1, u32__one_le_pow2u(d, hd)),
      Equal.cong(Nat, Nat, v => Nat.sub(v, 1n), U32.to_nat(u32__pow2u(d)), spec_common__pow2(d), u32__pow2u_value(d, hd))),
    hx)

def u32__u32_cmp(+a: U32, +b: U32) -> {U32.cmp(a, b) == Nat.cmp(U32.to_nat(a), U32.to_nat(b)) : Cmp}:
  lru_word_comparison__u32_refines(a, b)


# ==== proofs/lib/array.bend ====

type array__Tree<-T: Data> is Data:
  TLeaf{value: T}
  TNode{lo: array__Tree<T>, hi: array__Tree<T>}

def array__thaw(-T: Data, t: array__Tree<T>) -> Array<T>:
  match t:
    case TLeaf{x}:
      ALeaf{x}
    case TNode{l, r}:
      ANode{array__thaw(T, l), array__thaw(T, r)}

def array__freeze(-T: Data, a: Array<T>) -> array__Tree<T>:
  match a:
    case ALeaf{+x}:
      TLeaf{x}
    case ANode{xs, ys}:
      TNode{array__freeze(T, xs), array__freeze(T, ys)}

def array__slots(-T: Data, t: array__Tree<T>) -> List<&2, T>:
  match t:
    case TLeaf{x}:
      Con{x, Nil{}}
    case TNode{l, r}:
      spec_common__append(T, array__slots(T, l), array__slots(T, r))

def array__perfect(-T: Data, +d: Nat, t: array__Tree<T>) -> Bool:
  match d t:
    case 0n TLeaf{x}:
      True{}
    case 0n TNode{l, r}:
      False{}
    case 1n+p TLeaf{x}:
      False{}
    case 1n+p TNode{l, r}:
      Bool.and(array__perfect(T, p, l), array__perfect(T, p, r))

# Mirror of an update at a Nat index (proof-level description of the new tree).
# `left` is this node's branch decision (see ndec); passing it as a parameter
# avoids matching on a computed value.
def array__ndec(d: Nat, +j: Nat) -> Bool:
  match d:
    case 0n:
      False{}
    case 1n+q:
      Nat.is_lt(j, spec_common__pow2(q))

def array__tupd(-T: Data, d: Nat, t: array__Tree<T>, +j: Nat, +v: T, left: Bool) -> array__Tree<T>:
  match d t left:
    case 0n TLeaf{x} _:
      TLeaf{v}
    case 0n TNode{l, r} _:
      TNode{l, r}
    case 1n+p TLeaf{x} _:
      TLeaf{x}
    case 1n+ +p TNode{l, r} True{}:
      TNode{array__tupd(T, p, l, j, v, array__ndec(p, j)), r}
    case 1n+ +p TNode{l, r} False{}:
      TNode{l, array__tupd(T, p, r, Nat.sub(j, spec_common__pow2(p)), v, array__ndec(p, Nat.sub(j, spec_common__pow2(p))))}

def array__upd(-T: Data, +d: Nat, t: array__Tree<T>, +j: Nat, +v: T) -> array__Tree<T>:
  array__tupd(T, d, t, j, v, array__ndec(d, j))

def array__trep(-T: Data, +d: Nat, +v: T) -> array__Tree<T>:
  match d:
    case 0n:
      TLeaf{v}
    case 1n+p:
      TNode{array__trep(T, p, v), array__trep(T, p, v)}

# ---- pure tree facts ----
def array__freeze_thaw(-T: Data, +t: array__Tree<T>) -> {array__freeze(T, array__thaw(T, t)) == t : array__Tree<T>}:
  match t:
    case TLeaf{x}:
      {==}
    case TNode{+l, +r}:
      %Equal.sym(array__Tree<T>, array__freeze(T, array__thaw(T, l)), l, array__freeze_thaw(T, l)) : {TNode{_, array__freeze(T, array__thaw(T, r))} == TNode{l, r} : array__Tree<T>}
      %Equal.sym(array__Tree<T>, array__freeze(T, array__thaw(T, r)), r, array__freeze_thaw(T, r)) : {TNode{l, _} == TNode{l, r} : array__Tree<T>}
      {==}

def array__pf_left(-T: Data, +p: Nat, +l: array__Tree<T>, +r: array__Tree<T>, +pf: {array__perfect(T, 1n+p, TNode{l, r}) == True{} : Bool}) -> {array__perfect(T, p, l) == True{} : Bool}:
  logic__and_left(array__perfect(T, p, l), array__perfect(T, p, r), pf)

def array__pf_right(-T: Data, +p: Nat, +l: array__Tree<T>, +r: array__Tree<T>, +pf: {array__perfect(T, 1n+p, TNode{l, r}) == True{} : Bool}) -> {array__perfect(T, p, r) == True{} : Bool}:
  logic__and_right(array__perfect(T, p, l), array__perfect(T, p, r), pf)

def array__slots_length(-T: Data, +d: Nat, +t: array__Tree<T>, +pf: {array__perfect(T, d, t) == True{} : Bool}) -> {spec_common__length(T, array__slots(T, t)) == spec_common__pow2(d) : Nat}:
  match d t:
    case 0n TLeaf{x}:
      {==}
    case 0n TNode{l, r}:
      Empty.absurd({spec_common__length(T, array__slots(T, TNode{l, r})) == 1n : Nat}, logic__false_true(pf))
    case 1n+p TLeaf{x}:
      Empty.absurd({1n == Nat.double(spec_common__pow2(p)) : Nat}, logic__false_true(pf))
    case 1n+ +p TNode{+l, +r}:
      %Equal.sym(Nat, spec_common__length(T, spec_common__append(T, array__slots(T, l), array__slots(T, r))), Nat.add(spec_common__length(T, array__slots(T, l)), spec_common__length(T, array__slots(T, r))), list__length_append(T, array__slots(T, l), array__slots(T, r))) : {_ == Nat.double(spec_common__pow2(p)) : Nat}
      %Equal.sym(Nat, spec_common__length(T, array__slots(T, l)), spec_common__pow2(p), array__slots_length(T, p, l, array__pf_left(T, p, l, r, pf))) : {Nat.add(_, spec_common__length(T, array__slots(T, r))) == Nat.double(spec_common__pow2(p)) : Nat}
      %Equal.sym(Nat, spec_common__length(T, array__slots(T, r)), spec_common__pow2(p), array__slots_length(T, p, r, array__pf_right(T, p, l, r, pf))) : {Nat.add(spec_common__pow2(p), _) == Nat.double(spec_common__pow2(p)) : Nat}
      Equal.sym(Nat, Nat.double(spec_common__pow2(p)), Nat.add(spec_common__pow2(p), spec_common__pow2(p)), lru_nat_algebra__double_self(spec_common__pow2(p)))

def array__trep_perfect(-T: Data, +d: Nat, +v: T) -> {array__perfect(T, d, array__trep(T, d, v)) == True{} : Bool}:
  match d:
    case 0n:
      {==}
    case 1n+p:
      logic__and_intro(array__perfect(T, p, array__trep(T, p, v)), array__perfect(T, p, array__trep(T, p, v)), array__trep_perfect(T, p, v), array__trep_perfect(T, p, v))

def array__trep_slots(-T: Data, +d: Nat, +v: T) -> {array__slots(T, array__trep(T, d, v)) == spec_common__replicate(T, spec_common__pow2(d), v) : List<&2, T>}:
  match d:
    case 0n:
      {==}
    case 1n+p:
      %Equal.sym(List<&2, T>, array__slots(T, array__trep(T, p, v)), spec_common__replicate(T, spec_common__pow2(p), v), array__trep_slots(T, p, v)) : {spec_common__append(T, _, _) == spec_common__replicate(T, Nat.double(spec_common__pow2(p)), v) : List<&2, T>}
      %Equal.sym(Nat, Nat.double(spec_common__pow2(p)), Nat.add(spec_common__pow2(p), spec_common__pow2(p)), lru_nat_algebra__double_self(spec_common__pow2(p))) : {spec_common__append(T, spec_common__replicate(T, spec_common__pow2(p), v), spec_common__replicate(T, spec_common__pow2(p), v)) == spec_common__replicate(T, _, v) : List<&2, T>}
      list__replicate_add(T, spec_common__pow2(p), spec_common__pow2(p), v)

# ---- index helpers ----
def array__leaf_update(-T: Data, +x: T, +v: T, +j: Nat, +hj: {Nat.is_lt(j, 1n) == True{} : Bool}) -> {Con{v, Nil{}} == spec_common__update(T, Con{x, Nil{}}, j, v) : List<&2, T>}:
  match j:
    case 0n:
      {==}
    case 1n+q:
      Empty.absurd({Con{v, Nil{}} == Con{x, Nil{}} : List<&2, T>}, nat__lt_zero_absurd(q, hj))

def array__leaf_value(-T: Data, +y: T, +j: Nat, +x: T, +hj: {Nat.is_lt(j, 1n) == True{} : Bool}, +hx: {spec_common__nth(T, Con{y, Nil{}}, j) == Some{x} : Maybe<&2, T>}) -> {y == x : T}:
  match j:
    case 0n:
      logic__some_inj(T, y, x, hx)
    case 1n+q:
      Empty.absurd({y == x : T}, nat__lt_zero_absurd(q, hj))

def array__len_lt(-T: Data, +p: Nat, +l: array__Tree<T>, +j: Nat, +pl: {array__perfect(T, p, l) == True{} : Bool}, +h: {Nat.is_lt(j, spec_common__pow2(p)) == True{} : Bool}) -> {Nat.is_lt(j, spec_common__length(T, array__slots(T, l))) == True{} : Bool}:
  %Equal.sym(Nat, spec_common__length(T, array__slots(T, l)), spec_common__pow2(p), array__slots_length(T, p, l, pl)) : {Nat.is_lt(j, _) == True{} : Bool}
  h

def array__len_le(-T: Data, +p: Nat, +l: array__Tree<T>, +j: Nat, +pl: {array__perfect(T, p, l) == True{} : Bool}, +h: {Nat.is_le(spec_common__pow2(p), j) == True{} : Bool}) -> {Nat.is_le(spec_common__length(T, array__slots(T, l)), j) == True{} : Bool}:
  %Equal.sym(Nat, spec_common__length(T, array__slots(T, l)), spec_common__pow2(p), array__slots_length(T, p, l, pl)) : {Nat.is_le(_, j) == True{} : Bool}
  h

def array__upper_lt(+j: Nat, +p: Nat, +hj: {Nat.is_lt(j, spec_common__pow2(1n+p)) == True{} : Bool}, +le: {Nat.is_le(spec_common__pow2(p), j) == True{} : Bool}) -> {Nat.is_lt(Nat.sub(j, spec_common__pow2(p)), spec_common__pow2(p)) == True{} : Bool}:
  nat__sub_lt(j, spec_common__pow2(p), spec_common__pow2(p), le, logic__subst(Nat, n => {Nat.is_lt(j, n) == True{} : Bool}, Nat.double(spec_common__pow2(p)), Nat.add(spec_common__pow2(p), spec_common__pow2(p)), lru_nat_algebra__double_self(spec_common__pow2(p)), hj))

def array__right_update(-T: Data, +p: Nat, +l: array__Tree<T>, +r: array__Tree<T>, +j: Nat, +v: T, +pl: {array__perfect(T, p, l) == True{} : Bool}, +le: {Nat.is_le(spec_common__pow2(p), j) == True{} : Bool}) -> {spec_common__update(T, spec_common__append(T, array__slots(T, l), array__slots(T, r)), j, v) == spec_common__append(T, array__slots(T, l), spec_common__update(T, array__slots(T, r), Nat.sub(j, spec_common__pow2(p)), v)) : List<&2, T>}:
