      {==}
    case 1n+p:
      Equal.cong(Nat, Nat, x => 1n+x, Nat.add(p, 0n), p, lru_native_map__natural_add_right_zero(p))


# ==== reference/lru/proofs/numeric.bend ====

law lru_numeric__double_add:
