def list__length_take(-A: Data, +xs: List<&2, A>, +k: Nat, +h: {Nat.is_le(k, spec_common__length(A, xs)) == True{} : Bool}) -> {spec_common__length(A, List.take(&2, A, xs, k)) == k : Nat}:
