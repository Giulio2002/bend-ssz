def u32alg__w_assoc(+n: Nat, +a: Word(n), +b: Word(n), +c: Word(n)) -> {Word.add(n, Word.add(n, a, b), c) == Word.add(n, a, Word.add(n, b, c)) : Word(n)}:
  -s = Word.add(n, a, b)
  -t = Word.add(n, b, c)
  +ua = u32alg__uw(n, a)
  +ub = u32alg__uw(n, b)
  +uc = u32alg__uw(n, c)
  +us = u32alg__uw(n, Word.add(n, a, b))
  +ut = u32alg__uw(n, Word.add(n, b, c))
  +uL = u32alg__uw(n, Word.add(n, Word.add(n, a, b), c))
  +uR = u32alg__uw(n, Word.add(n, a, Word.add(n, b, c)))
  +c1 = u32alg__cy(n, a, b, False{})
  +c2 = u32alg__cy(n, b, c, False{})
  +c3 = u32alg__cy(n, Word.add(n, a, b), c, False{})
  +c4 = u32alg__cy(n, a, Word.add(n, b, c), False{})
  +e1 = u32alg__cons(n, Word.add(n, a, b), c)
  +e2 = u32alg__cons(n, a, b)
  +e3 = u32alg__cons(n, a, Word.add(n, b, c))
  +e4 = u32alg__cons(n, b, c)
  # uL + sc(c3 + c1) == (ua + ub) + uc
