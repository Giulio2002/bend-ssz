# Public Base entry points. Premises: the tree is perfect of depth d < 32 and
# the index is below 2^d; x is the value currently stored at that index.
def array__get(-T: Data, +d: Nat, +t: array__Tree<T>, +i: U32, +x: T, +hd: {Nat.is_lt(d, 32n) == True{} : Bool}, +hi: {Nat.is_lt(U32.to_nat(i), spec_common__pow2(d)) == True{} : Bool}, +hx: {spec_common__nth(T, array__slots(T, t), U32.to_nat(i)) == Some{x} : Maybe<&2, T>}, +pf: {array__perfect(T, d, t) == True{} : Bool}) -> {Array.get(T, array__thaw(T, t), i) == (array__thaw(T, t), x) : Array<T> & T}:
  %Equal.sym(Array<T> & U32, Array.size(T, array__thaw(T, t)), (array__thaw(T, t), u32__pow2u(d)), array__size_thaw(T, d, t, pf)) : {Array.get.at(T, i, _) == (array__thaw(T, t), x) : Array<T> & T}
  %Equal.sym(U32, U32.and(i, U32.sub(u32__pow2u(d), 1)), i, u32__mask_pow2u(i, d, hd, hi)) : {Array.get.go(T, array__thaw(T, t), u32__pow2u(d), _, U32.is_lt(_, U32.shr(u32__pow2u(d)))) == (array__thaw(T, t), x) : Array<T> & T}
  array__get_go(T, d, t, i, x, hd, hi, hx, U32.is_lt(i, U32.shr(u32__pow2u(d))), {==}, pf)

def array__swap(-T: Data, +d: Nat, +t: array__Tree<T>, +i: U32, +v: T, +x: T, +hd: {Nat.is_lt(d, 32n) == True{} : Bool}, +hi: {Nat.is_lt(U32.to_nat(i), spec_common__pow2(d)) == True{} : Bool}, +hx: {spec_common__nth(T, array__slots(T, t), U32.to_nat(i)) == Some{x} : Maybe<&2, T>}, +pf: {array__perfect(T, d, t) == True{} : Bool}) -> {Array.swap(T, array__thaw(T, t), i, v) == (array__thaw(T, array__upd(T, d, t, U32.to_nat(i), v)), x) : Array<T> & T}:
  %Equal.sym(Array<T> & U32, Array.size(T, array__thaw(T, t)), (array__thaw(T, t), u32__pow2u(d)), array__size_thaw(T, d, t, pf)) : {Array.swap.at(T, i, v, _) == (array__thaw(T, array__upd(T, d, t, U32.to_nat(i), v)), x) : Array<T> & T}
  %Equal.sym(U32, U32.and(i, U32.sub(u32__pow2u(d), 1)), i, u32__mask_pow2u(i, d, hd, hi)) : {Array.swap.go(T, array__thaw(T, t), u32__pow2u(d), _, v, U32.is_lt(_, U32.shr(u32__pow2u(d)))) == (array__thaw(T, array__upd(T, d, t, U32.to_nat(i), v)), x) : Array<T> & T}
  array__swap_go(T, d, t, i, v, x, hd, hi, hx, U32.is_lt(i, U32.shr(u32__pow2u(d))), {==}, pf)

def array__set(-T: Data, +d: Nat, +t: array__Tree<T>, +i: U32, +v: T, +x: T, +hd: {Nat.is_lt(d, 32n) == True{} : Bool}, +hi: {Nat.is_lt(U32.to_nat(i), spec_common__pow2(d)) == True{} : Bool}, +hx: {spec_common__nth(T, array__slots(T, t), U32.to_nat(i)) == Some{x} : Maybe<&2, T>}, +pf: {array__perfect(T, d, t) == True{} : Bool}) -> {Array.set(T, array__thaw(T, t), i, v) == array__thaw(T, array__upd(T, d, t, U32.to_nat(i), v)) : Array<T>}:
  %Equal.sym(Array<T> & T, Array.swap(T, array__thaw(T, t), i, v), (array__thaw(T, array__upd(T, d, t, U32.to_nat(i), v)), x), array__swap(T, d, t, i, v, x, hd, hi, hx, pf)) : {Array.set.fin(T, _) == array__thaw(T, array__upd(T, d, t, U32.to_nat(i), v)) : Array<T>}
  {==}

def array__new(-T: Data, +d: Nat, +v: T) -> {Array.new(T, d, v) == array__thaw(T, array__trep(T, d, v)) : Array<T>}:
  match d:
    case 0n:
      {==}
    case 1n+p:
      %Equal.sym(Array<T>, Array.new(T, p, v), array__thaw(T, array__trep(T, p, v)), array__new(T, p, v)) : {ANode{_, _} == ANode{array__thaw(T, array__trep(T, p, v)), array__thaw(T, array__trep(T, p, v))} : Array<T>}
      {==}

def array__clone(-T: Data, +t: array__Tree<T>) -> {Array.clone(T, array__thaw(T, t)) == (array__thaw(T, t), array__thaw(T, t)) : Array<T> & Array<T>}:
  match t:
    case TLeaf{x}:
      {==}
    case TNode{+l, +r}:
      %Equal.sym(Array<T> & Array<T>, Array.clone(T, array__thaw(T, l)), (array__thaw(T, l), array__thaw(T, l)), array__clone(T, l)) : {Array.clone.node(T, _, Array.clone(T, array__thaw(T, r))) == (ANode{array__thaw(T, l), array__thaw(T, r)}, ANode{array__thaw(T, l), array__thaw(T, r)}) : Array<T> & Array<T>}
      %Equal.sym(Array<T> & Array<T>, Array.clone(T, array__thaw(T, r)), (array__thaw(T, r), array__thaw(T, r)), array__clone(T, r)) : {Array.clone.node(T, (array__thaw(T, l), array__thaw(T, l)), _) == (ANode{array__thaw(T, l), array__thaw(T, r)}, ANode{array__thaw(T, l), array__thaw(T, r)}) : Array<T> & Array<T>}
      {==}

# ---- get after set (Base.Array.set then Base.Array.get) ----
def array__get_set_same(-T: Data, +d: Nat, +t: array__Tree<T>, +i: U32, +v: T, +x: T, +hd: {Nat.is_lt(d, 32n) == True{} : Bool}, +hi: {Nat.is_lt(U32.to_nat(i), spec_common__pow2(d)) == True{} : Bool}, +hx: {spec_common__nth(T, array__slots(T, t), U32.to_nat(i)) == Some{x} : Maybe<&2, T>}, +pf: {array__perfect(T, d, t) == True{} : Bool}) -> {Array.get(T, Array.set(T, array__thaw(T, t), i, v), i) == (array__thaw(T, array__upd(T, d, t, U32.to_nat(i), v)), v) : Array<T> & T}:
  +t2 = array__upd(T, d, t, U32.to_nat(i), v)
  %Equal.sym(Array<T>, Array.set(T, array__thaw(T, t), i, v), array__thaw(T, t2), array__set(T, d, t, i, v, x, hd, hi, hx, pf)) : {Array.get(T, _, i) == (array__thaw(T, t2), v) : Array<T> & T}
  array__get(T, d, t2, i, v, hd, hi,
    logic__subst(List<&2, T>, ys => {spec_common__nth(T, ys, U32.to_nat(i)) == Some{v} : Maybe<&2, T>}, spec_common__update(T, array__slots(T, t), U32.to_nat(i), v), array__slots(T, t2), Equal.sym(List<&2, T>, array__slots(T, t2), spec_common__update(T, array__slots(T, t), U32.to_nat(i), v), array__upd_slots(T, d, t, U32.to_nat(i), v, hi, pf)), list__nth_update_same(T, array__slots(T, t), U32.to_nat(i), v, list__nth_lt_length(T, array__slots(T, t), U32.to_nat(i), x, hx))),
    array__upd_perfect(T, d, t, U32.to_nat(i), v, pf))

def array__get_set_other(-T: Data, +d: Nat, +t: array__Tree<T>, +i: U32, +j: U32, +v: T, +x: T, +y: T, +hd: {Nat.is_lt(d, 32n) == True{} : Bool}, +hi: {Nat.is_lt(U32.to_nat(i), spec_common__pow2(d)) == True{} : Bool}, +hj: {Nat.is_lt(U32.to_nat(j), spec_common__pow2(d)) == True{} : Bool}, +ne: {Nat.is_eq(U32.to_nat(i), U32.to_nat(j)) == False{} : Bool}, +hx: {spec_common__nth(T, array__slots(T, t), U32.to_nat(i)) == Some{x} : Maybe<&2, T>}, +hy: {spec_common__nth(T, array__slots(T, t), U32.to_nat(j)) == Some{y} : Maybe<&2, T>}, +pf: {array__perfect(T, d, t) == True{} : Bool}) -> {Array.get(T, Array.set(T, array__thaw(T, t), i, v), j) == (array__thaw(T, array__upd(T, d, t, U32.to_nat(i), v)), y) : Array<T> & T}:
  +t2 = array__upd(T, d, t, U32.to_nat(i), v)
  %Equal.sym(Array<T>, Array.set(T, array__thaw(T, t), i, v), array__thaw(T, t2), array__set(T, d, t, i, v, x, hd, hi, hx, pf)) : {Array.get(T, _, j) == (array__thaw(T, t2), y) : Array<T> & T}
  array__get(T, d, t2, j, y, hd, hj,
    logic__subst(List<&2, T>, ys => {spec_common__nth(T, ys, U32.to_nat(j)) == Some{y} : Maybe<&2, T>}, spec_common__update(T, array__slots(T, t), U32.to_nat(i), v), array__slots(T, t2), Equal.sym(List<&2, T>, array__slots(T, t2), spec_common__update(T, array__slots(T, t), U32.to_nat(i), v), array__upd_slots(T, d, t, U32.to_nat(i), v, hi, pf)), Equal.trans(Maybe<&2, T>, spec_common__nth(T, spec_common__update(T, array__slots(T, t), U32.to_nat(i), v), U32.to_nat(j)), spec_common__nth(T, array__slots(T, t), U32.to_nat(j)), Some{y}, list__nth_update_other(T, array__slots(T, t), U32.to_nat(i), U32.to_nat(j), v, ne), hy)),
    array__upd_perfect(T, d, t, U32.to_nat(i), v, pf))


# ==== proofs/lib/flat.bend ====

def flat__nthc(xs: List<&2, U32>, q: Nat) -> U32:
  match xs q:
    case Nil{} _:
      0
    case Con{x, t} 0n:
      x
    case Con{x, t} 1n+p:
      flat__nthc(t, p)

def flat__nthc_nth(xs: List<&2, U32>, q: Nat, +h: {Nat.is_lt(q, spec_common__length(U32, xs)) == True{} : Bool}) -> {spec_common__nth(U32, xs, q) == Some{flat__nthc(xs, q)} : Maybe<&2, U32>}:
  match xs q:
    case Nil{} _:
      Empty.absurd({spec_common__nth(U32, Nil{}, q) == Some{flat__nthc(Nil{}, q)} : Maybe<&2, U32>}, nat__lt_zero_absurd(q, h))
    case Con{x, t} 0n:
      {==}
    case Con{x, t} 1n+p:
      flat__nthc_nth(t, p, h)

def flat__add_one(+o: Nat) -> {Nat.add(o, 1n) == 1n+o : Nat}:
  %Equal.sym(Nat, Nat.add(o, 1n), 1n+Nat.add(o, 0n), nat__add_succ(o, 0n)) : {_ == 1n+o : Nat}
  nat__succ_cong(Nat.add(o, 0n), o, nat__add_zero(o))

def flat__pow2_split(+q: Nat) -> {spec_common__pow2(1n+q) == Nat.add(spec_common__pow2(q), spec_common__pow2(q)) : Nat}:
  lru_nat_algebra__double_self(spec_common__pow2(q))

# o < o + 2^q
# o < o + 2^q
def flat__lt_split(+o: Nat, +q: Nat) -> {Nat.is_lt(o, Nat.add(o, spec_common__pow2(q))) == True{} : Bool}:
  nat__succ_le_lt(o, Nat.add(o, spec_common__pow2(q)),
    %flat__add_one(o) : {Nat.is_le(_, Nat.add(o, spec_common__pow2(q))) == True{} : Bool}
    nat__le_add_left(1n, spec_common__pow2(q), o, nat__pow2_pos(q)))

# o + 2^(1+q) == (o + 2^q) + 2^q
# o + 2^(1+q) == (o + 2^q) + 2^q
def flat__split_assoc(+o: Nat, +q: Nat) -> {Nat.add(o, spec_common__pow2(1n+q)) == Nat.add(Nat.add(o, spec_common__pow2(q)), spec_common__pow2(q)) : Nat}:
  %Equal.sym(Nat, spec_common__pow2(1n+q), Nat.add(spec_common__pow2(q), spec_common__pow2(q)), flat__pow2_split(q)) : {Nat.add(o, _) == Nat.add(Nat.add(o, spec_common__pow2(q)), spec_common__pow2(q)) : Nat}
  Equal.sym(Nat, Nat.add(Nat.add(o, spec_common__pow2(q)), spec_common__pow2(q)), Nat.add(o, Nat.add(spec_common__pow2(q), spec_common__pow2(q))), nat__add_assoc(o, spec_common__pow2(q), spec_common__pow2(q)))

# o + 2^q < o + 2^(1+q)
# o + 2^q < o + 2^(1+q)
def flat__mid_lt(+o: Nat, +q: Nat) -> {Nat.is_lt(Nat.add(o, spec_common__pow2(q)), Nat.add(o, spec_common__pow2(1n+q))) == True{} : Bool}:
  %Equal.sym(Nat, Nat.add(o, spec_common__pow2(1n+q)), Nat.add(Nat.add(o, spec_common__pow2(q)), spec_common__pow2(q)), flat__split_assoc(o, q)) : {Nat.is_lt(Nat.add(o, spec_common__pow2(q)), _) == True{} : Bool}
  flat__lt_split(Nat.add(o, spec_common__pow2(q)), q)

# ---- the model tree the cells realise ----
def flat__is_eq_sym(a: Nat, b: Nat) -> {Nat.is_eq(a, b) == Nat.is_eq(b, a) : Bool}:
  match a b:
    case 0n 0n:
      {==}
    case 0n 1n+y:
      {==}
    case 1n+x 0n:
      {==}
    case 1n+x 1n+y:
      flat__is_eq_sym(x, y)

def flat__ne_gt(+a: Nat, +b: Nat, +h: {Nat.is_lt(b, a) == True{} : Bool}) -> {Nat.is_eq(a, b) == False{} : Bool}:
  %Equal.sym(Bool, Nat.is_eq(a, b), Nat.is_eq(b, a), flat__is_eq_sym(a, b)) : {_ == False{} : Bool}
  nat__is_eq_lt(b, a, h)

# 2^d <= 2^d + t
# 2^d <= 2^d + t
def flat__base_le(+d: Nat, +t: Nat) -> {Nat.is_le(spec_common__pow2(d), Nat.add(spec_common__pow2(d), t)) == True{} : Bool}:
  nat__le_add_right(spec_common__pow2(d), t)

# ---- a write below the block ----
def flat__nthc_other(cl: List<&2, U32>, j: Nat, k: Nat, +v: U32, +ne: {Nat.is_eq(j, k) == False{} : Bool}) -> {flat__nthc(spec_common__update(U32, cl, j, v), k) == flat__nthc(cl, k) : U32}:
  match cl j k:
    case Nil{} _ _:
      {==}
    case Con{x, t} 0n 0n:
      Empty.absurd({flat__nthc(Con{v, t}, 0n) == flat__nthc(Con{x, t}, 0n) : U32}, logic__false_true(Equal.sym(Bool, True{}, False{}, ne)))
    case Con{x, t} 0n 1n+b:
      {==}
    case Con{x, t} 1n+a 0n:
      {==}
    case Con{x, t} 1n+a 1n+b:
      flat__nthc_other(t, a, b, v, ne)

def flat__nthc_same(cl: List<&2, U32>, j: Nat, +v: U32, +h: {Nat.is_lt(j, spec_common__length(U32, cl)) == True{} : Bool}) -> {flat__nthc(spec_common__update(U32, cl, j, v), j) == v : U32}:
  match cl j:
    case Nil{} _:
      Empty.absurd({flat__nthc(Nil{}, j) == v : U32}, nat__lt_zero_absurd(j, h))
    case Con{x, t} 0n:
      {==}
    case Con{x, t} 1n+a:
      flat__nthc_same(t, a, v, h)

# 2^d < 2^(d+1)
def flat__base_lt(+d: Nat) -> {Nat.is_lt(spec_common__pow2(d), spec_common__pow2(1n+d)) == True{} : Bool}:
  nat__pow2_lt_succ(d)

def flat__in_cells(+cl: List<&2, U32>, +d: Nat, +k: Nat, +hk: {Nat.is_lt(k, spec_common__pow2(d)) == True{} : Bool}, +hlen: {spec_common__length(U32, cl) == spec_common__pow2(1n+d) : Nat}) -> {Nat.is_lt(k, spec_common__length(U32, cl)) == True{} : Bool}:
  logic__subst(Nat, z => {Nat.is_lt(k, z) == True{} : Bool}, spec_common__pow2(1n+d), spec_common__length(U32, cl), Equal.sym(Nat, spec_common__length(U32, cl), spec_common__pow2(1n+d), hlen),
    nat__lt_trans(k, spec_common__pow2(d), spec_common__pow2(1n+d), hk, flat__base_lt(d)))

def flat__leaf_in_cells(+cl: List<&2, U32>, +d: Nat, +o: Nat, +ho: {Nat.is_lt(o, spec_common__pow2(d)) == True{} : Bool}, +hlen: {spec_common__length(U32, cl) == spec_common__pow2(1n+d) : Nat}) -> {Nat.is_lt(Nat.add(spec_common__pow2(d), o), spec_common__length(U32, cl)) == True{} : Bool}:
  logic__subst(Nat, z => {Nat.is_lt(Nat.add(spec_common__pow2(d), o), z) == True{} : Bool}, spec_common__pow2(1n+d), spec_common__length(U32, cl), Equal.sym(Nat, spec_common__length(U32, cl), spec_common__pow2(1n+d), hlen),
    %Equal.sym(Nat, spec_common__pow2(1n+d), Nat.add(spec_common__pow2(d), spec_common__pow2(d)), flat__pow2_split(d)) : {Nat.is_lt(Nat.add(spec_common__pow2(d), o), _) == True{} : Bool}
    nat__lt_add_left(o, spec_common__pow2(d), spec_common__pow2(d), ho))

# o < 2^d when the block [o, o+2^p) fits
# o < 2^d when the block [o, o+2^p) fits
def flat__blk_lo(+o: Nat, +p: Nat, +d: Nat, +hw: {Nat.is_le(Nat.add(o, spec_common__pow2(p)), spec_common__pow2(d)) == True{} : Bool}) -> {Nat.is_lt(o, spec_common__pow2(d)) == True{} : Bool}:
  nat__lt_le_trans(o, Nat.add(o, spec_common__pow2(p)), spec_common__pow2(d), flat__lt_split(o, p), hw)

# ---- the point addition walk is the model's ----
# 2^d + o < 2^(d+1) and o + 2^q < 2^(d+1)
def flat__leaf_lt(+d: Nat, +o: Nat, +ho: {Nat.is_lt(o, spec_common__pow2(d)) == True{} : Bool}) -> {Nat.is_lt(Nat.add(spec_common__pow2(d), o), spec_common__pow2(1n+d)) == True{} : Bool}:
  %Equal.sym(Nat, spec_common__pow2(1n+d), Nat.add(spec_common__pow2(d), spec_common__pow2(d)), flat__pow2_split(d)) : {Nat.is_lt(Nat.add(spec_common__pow2(d), o), _) == True{} : Bool}
  nat__lt_add_left(o, spec_common__pow2(d), spec_common__pow2(d), ho)

def flat__node_lt(+o: Nat, +q: Nat, +d: Nat, +hw: {Nat.is_le(Nat.add(o, spec_common__pow2(1n+q)), spec_common__pow2(d)) == True{} : Bool}) -> {Nat.is_lt(Nat.add(o, spec_common__pow2(q)), spec_common__pow2(1n+d)) == True{} : Bool}:
  nat__lt_trans(Nat.add(o, spec_common__pow2(q)), spec_common__pow2(d), spec_common__pow2(1n+d),
    nat__lt_le_trans(Nat.add(o, spec_common__pow2(q)), Nat.add(o, spec_common__pow2(1n+q)), spec_common__pow2(d), flat__mid_lt(o, q), hw), flat__base_lt(d))

# ---- the prefix walk is the model's ----
# The half size a walk carries at remaining depth p: 2^(p-1), and 0 at a
# leaf (where it is unused). One machine division steps from one level to the
# next, so no walk ever recomputes a power of two.
def flat__hof(p: Nat) -> Nat:
  Nat.div(spec_common__pow2(p), 2n)

def flat__hof_succ(+q: Nat) -> {flat__hof(1n+q) == spec_common__pow2(q) : Nat}:
  nat__div2_pow2(q)

# The comparison the source makes against the carried half size is exactly
# the model's branch decision.
def flat__nthc_rep(m: Nat, k: Nat) -> {flat__nthc(spec_common__replicate(U32, m, 0), k) == 0 : U32}:
  match m k:
    case 0n _:
      {==}
    case 1n+a 0n:
      {==}
    case 1n+a 1n+b:
      flat__nthc_rep(a, b)


# ==== reference/lru/proofs/division_quotient.bend ====

def lru_division_quotient__reconstruct(+n: Nat, +word: Word(n)) -> {spec_numeric__from_nat(n, spec_numeric__unsigned(n, word)) == word : Word(n)}:
  Equal.trans(Word(n), spec_numeric__from_nat(n, spec_numeric__unsigned(n, word)), spec_numeric__from_nat(n, Nat.add(spec_numeric__unsigned(n, word), spec_numeric__scale_binary(n, 0n))), word, Equal.cong(Nat, Word(n), x => spec_numeric__from_nat(n, x), spec_numeric__unsigned(n, word), Nat.add(spec_numeric__unsigned(n, word), spec_numeric__scale_binary(n, 0n)), Equal.trans(Nat, spec_numeric__unsigned(n, word), Nat.add(spec_numeric__unsigned(n, word), 0n), Nat.add(spec_numeric__unsigned(n, word), spec_numeric__scale_binary(n, 0n)), Equal.sym(Nat, Nat.add(spec_numeric__unsigned(n, word), 0n), spec_numeric__unsigned(n, word), lru_map_difference_order__add_zero(spec_numeric__unsigned(n, word))), Equal.cong(Nat, Nat, x => Nat.add(spec_numeric__unsigned(n, word), x), 0n, spec_numeric__scale_binary(n, 0n), Equal.sym(Nat, spec_numeric__scale_binary(n, 0n), 0n, lru_counter__scale_zero(n))))), lru_modular_addition__reconstruct(n, word, 0n))


# ==== proofs/lib/u32alg.bend ====

def u32alg__sc(+n: Nat, +k: Nat) -> Nat:
  spec_numeric__scale_binary(n, k)

def u32alg__uw(+n: Nat, +w: Word(n)) -> Nat:
  spec_numeric__unsigned(n, w)

def u32alg__cy(+n: Nat, +a: Word(n), +b: Word(n), +c: Bool) -> Nat:
  spec_numeric__bit_value(lru_addition__carry_out(n, a, b, c))

# ---- Nat helpers ----
def u32alg__add_cancel_r(+a: Nat, +b: Nat, +c: Nat, +e: {Nat.add(a, c) == Nat.add(b, c) : Nat}) -> {a == b : Nat}:
  match c:
    case 0n:
      Equal.trans(Nat, a, Nat.add(a, 0n), b, Equal.sym(Nat, Nat.add(a, 0n), a, nat__add_zero(a)), Equal.trans(Nat, Nat.add(a, 0n), Nat.add(b, 0n), b, e, nat__add_zero(b)))
    case 1n+k:
      u32alg__add_cancel_r(a, b, k, nat__succ_inj(Nat.add(a, k), Nat.add(b, k), Equal.trans(Nat, 1n+Nat.add(a, k), Nat.add(a, 1n+k), 1n+Nat.add(b, k), Equal.sym(Nat, Nat.add(a, 1n+k), 1n+Nat.add(a, k), nat__add_succ(a, k)), Equal.trans(Nat, Nat.add(a, 1n+k), Nat.add(b, 1n+k), 1n+Nat.add(b, k), e, nat__add_succ(b, k)))))

# (a + b) + c == (a + c) + b
def u32alg__add_rot(+a: Nat, +b: Nat, +c: Nat) -> {Nat.add(Nat.add(a, b), c) == Nat.add(Nat.add(a, c), b) : Nat}:
  %Equal.sym(Nat, Nat.add(Nat.add(a, b), c), Nat.add(a, Nat.add(b, c)), nat__add_assoc(a, b, c)) : {_ == Nat.add(Nat.add(a, c), b) : Nat}
  %Equal.sym(Nat, Nat.add(Nat.add(a, c), b), Nat.add(a, Nat.add(c, b)), nat__add_assoc(a, c, b)) : {Nat.add(a, Nat.add(b, c)) == _ : Nat}
  %nat__add_comm(c, b) : {Nat.add(a, _) == Nat.add(a, Nat.add(c, b)) : Nat}
  {==}

def u32alg__sc_zero(+n: Nat) -> {u32alg__sc(n, 0n) == 0n : Nat}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      %Equal.sym(Nat, u32alg__sc(p, 0n), 0n, u32alg__sc_zero(p)) : {Nat.double(_) == 0n : Nat}
      {==}

def u32alg__sc_add(+n: Nat, +x: Nat, +y: Nat) -> {Nat.add(u32alg__sc(n, x), u32alg__sc(n, y)) == u32alg__sc(n, Nat.add(x, y)) : Nat}:
