      list__cons_cong(A, h, List.append(&2, A, t, ys), spec_common__append(A, t, ys), list__base_append(A, t, ys))

def list__length_zero_nil(-A: Data, +xs: List<&2, A>, +h: {spec_common__length(A, xs) == 0n : Nat}) -> {xs == Nil{} : List<&2, A>}:
  match xs:
    case Nil{}:
      {==}
    case Con{x, t}:
      Empty.absurd({Con{x, t} == Nil{} : List<&2, A>}, nat__succ_zero(spec_common__length(A, t), h))

# reverse.go(reverse.go(xs, a), b) == reverse.go(a, xs ++ b)
def list__rev_go_twice(-A: Data, +xs: List<&2, A>, +a: List<&2, A>, +b: List<&2, A>) -> {List.reverse.go(&2, A, List.reverse.go(&2, A, xs, a), b) == List.reverse.go(&2, A, a, spec_common__append(A, xs, b)) : List<&2, A>}:
  match xs:
    case Nil{}:
      {==}
    case Con{+h, +t}:
      list__rev_go_twice(A, t, Con{h, a}, b)

def list__rev_rev(-A: Data, +xs: List<&2, A>) -> {List.reverse(&2, A, List.reverse.go(&2, A, xs, Nil{})) == xs : List<&2, A>}:
  Equal.trans(List<&2, A>, List.reverse.go(&2, A, List.reverse.go(&2, A, xs, Nil{}), Nil{}), spec_common__append(A, xs, Nil{}), xs, list__rev_go_twice(A, xs, Nil{}, Nil{}), list__append_nil(A, xs))

def list__nth_update_other(-A: Data, +xs: List<&2, A>, +i: Nat, +j: Nat, +v: A, +ne: {Nat.is_eq(i, j) == False{} : Bool}) -> {spec_common__nth(A, spec_common__update(A, xs, i, v), j) == spec_common__nth(A, xs, j) : Maybe<&2, A>}:
  match xs i j:
    case Nil{} _ _:
      {==}
    case Con{h, t} 0n 0n:
      Empty.absurd({Some{v} == Some{h} : Maybe<&2, A>}, logic__true_false(ne))
    case Con{h, t} 0n 1n+q:
      {==}
    case Con{h, t} 1n+p 0n:
      {==}
    case Con{h, +t} 1n+p 1n+q:
      list__nth_update_other(A, t, p, q, v, ne)

