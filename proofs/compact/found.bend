    case 1n+p 1n+q:
      -Mn = u32alg__sc(n, 1n)
      +h1 = logic__subst(Nat, z => {Nat.add(r1, z) == Nat.add(r2, u32alg__sc(n, 1n+q)) : Nat}, u32alg__sc(n, 1n+p), Nat.add(u32alg__sc(n, 1n), u32alg__sc(n, p)), u32alg__sc_succ(n, p), h)
      +h2 = logic__subst(Nat, z => {Nat.add(r1, Nat.add(u32alg__sc(n, 1n), u32alg__sc(n, p))) == Nat.add(r2, z) : Nat}, u32alg__sc(n, 1n+q), Nat.add(u32alg__sc(n, 1n), u32alg__sc(n, q)), u32alg__sc_succ(n, q), h1)
      +l1 = Equal.trans(Nat, Nat.add(Nat.add(r1, u32alg__sc(n, p)), u32alg__sc(n, 1n)), Nat.add(r1, Nat.add(u32alg__sc(n, p), u32alg__sc(n, 1n))), Nat.add(r1, Nat.add(u32alg__sc(n, 1n), u32alg__sc(n, p))), nat__add_assoc(r1, u32alg__sc(n, p), u32alg__sc(n, 1n)), Equal.cong(Nat, Nat, z => Nat.add(r1, z), Nat.add(u32alg__sc(n, p), u32alg__sc(n, 1n)), Nat.add(u32alg__sc(n, 1n), u32alg__sc(n, p)), nat__add_comm(u32alg__sc(n, p), u32alg__sc(n, 1n))))
      +l2 = Equal.trans(Nat, Nat.add(Nat.add(r2, u32alg__sc(n, q)), u32alg__sc(n, 1n)), Nat.add(r2, Nat.add(u32alg__sc(n, q), u32alg__sc(n, 1n))), Nat.add(r2, Nat.add(u32alg__sc(n, 1n), u32alg__sc(n, q))), nat__add_assoc(r2, u32alg__sc(n, q), u32alg__sc(n, 1n)), Equal.cong(Nat, Nat, z => Nat.add(r2, z), Nat.add(u32alg__sc(n, q), u32alg__sc(n, 1n)), Nat.add(u32alg__sc(n, 1n), u32alg__sc(n, q)), nat__add_comm(u32alg__sc(n, q), u32alg__sc(n, 1n))))
