# ---- Base take / drop ----
def list__base_take_drop(-A: Data, +xs: List<&2, A>, +k: Nat) -> {spec_common__append(A, List.take(&2, A, xs, k), List.drop(&2, A, xs, k)) == xs : List<&2, A>}:
