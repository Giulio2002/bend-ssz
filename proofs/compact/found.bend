          %Equal.sym(Nat, u32alg__sc(p, 1n), Nat.add(1n, Nat.add(u32alg__uw(p, Word.not(p, bt)), u32alg__uw(p, bt))), Equal.sym(Nat, Nat.add(1n, Nat.add(u32alg__uw(p, Word.not(p, bt)), u32alg__uw(p, bt))), u32alg__sc(p, 1n), ih)) : {2n+Nat.add(Nat.double(u32alg__uw(p, Word.not(p, bt))), Nat.double(u32alg__uw(p, bt))) == Nat.double(_) : Nat}
