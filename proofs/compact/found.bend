def u32alg__cons(+n: Nat, +a: Word(n), +b: Word(n)) -> {Nat.add(u32alg__uw(n, Word.add(n, a, b)), u32alg__sc(n, u32alg__cy(n, a, b, False{}))) == Nat.add(u32alg__uw(n, a), u32alg__uw(n, b)) : Nat}:
  lru_addition__adc_conservation(n, a, b, False{})

def u32alg__uw_zero(+n: Nat) -> {u32alg__uw(n, Word.zero(n)) == 0n : Nat}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      %Equal.sym(Nat, u32alg__uw(p, Word.zero(p)), 0n, u32alg__uw_zero(p)) : {Nat.add(0n, Nat.double(_)) == 0n : Nat}
      {==}

