def list__sc_take_append_right(-A: Data, +xs: List<&2, A>, +ys: List<&2, A>, +i: Nat, +h: {Nat.is_le(spec_common__length(A, xs), i) == True{} : Bool}) -> {spec_common__take(A, spec_common__append(A, xs, ys), i) == spec_common__append(A, xs, spec_common__take(A, ys, Nat.sub(i, spec_common__length(A, xs)))) : List<&2, A>}:
