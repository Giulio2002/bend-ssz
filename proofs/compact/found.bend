def u32alg__cons_sub(+n: Nat, +x: Word(n), +a: Word(n)) -> {Nat.add(u32alg__uw(n, Word.sub(n, x, a)), u32alg__sc(n, u32alg__cy(n, x, Word.not(n, a), True{}))) == Nat.add(1n, Nat.add(u32alg__uw(n, x), u32alg__uw(n, Word.not(n, a)))) : Nat}:
  %Equal.sym(Word(n), Word.adc(n, x, a, True{}, True{}), Word.adc(n, x, Word.not(n, a), False{}, True{}), u32alg__adc_not(n, x, a, True{})) : {Nat.add(u32alg__uw(n, _), u32alg__sc(n, u32alg__cy(n, x, Word.not(n, a), True{}))) == Nat.add(1n, Nat.add(u32alg__uw(n, x), u32alg__uw(n, Word.not(n, a)))) : Nat}
  lru_addition__adc_conservation(n, x, Word.not(n, a), True{})

# (a + b) - a == b
def u32alg__arith_sub(+ux: Nat, +un: Nat, +ua: Nat, +ub: Nat, +k: Nat, +e: {Nat.add(ux, k) == Nat.add(ua, ub) : Nat}) -> {Nat.add(Nat.add(1n, Nat.add(ux, un)), k) == Nat.add(ub, Nat.add(1n, Nat.add(un, ua))) : Nat}:
  # both sides are 1 + ((ua + ub) + un)
  +p1 = nat__succ_cong(Nat.add(Nat.add(ux, un), k), Nat.add(Nat.add(ua, ub), un), Equal.trans(Nat, Nat.add(Nat.add(ux, un), k), Nat.add(Nat.add(ux, k), un), Nat.add(Nat.add(ua, ub), un), u32alg__add_rot(ux, un, k), Equal.cong(Nat, Nat, z => Nat.add(z, un), Nat.add(ux, k), Nat.add(ua, ub), e)))
  +q = Equal.trans(Nat, Nat.add(Nat.add(ua, ub), un), Nat.add(ua, Nat.add(ub, un)), Nat.add(ub, Nat.add(un, ua)), nat__add_assoc(ua, ub, un), Equal.trans(Nat, Nat.add(ua, Nat.add(ub, un)), Nat.add(Nat.add(ub, un), ua), Nat.add(ub, Nat.add(un, ua)), nat__add_comm(ua, Nat.add(ub, un)), nat__add_assoc(ub, un, ua)))
  Equal.trans(Nat, Nat.add(Nat.add(1n, Nat.add(ux, un)), k), 1n+Nat.add(Nat.add(ua, ub), un), Nat.add(ub, Nat.add(1n, Nat.add(un, ua))), p1,
    Equal.trans(Nat, 1n+Nat.add(Nat.add(ua, ub), un), 1n+Nat.add(ub, Nat.add(un, ua)), Nat.add(ub, 1n+Nat.add(un, ua)), nat__succ_cong(Nat.add(Nat.add(ua, ub), un), Nat.add(ub, Nat.add(un, ua)), q), Equal.sym(Nat, Nat.add(ub, 1n+Nat.add(un, ua)), 1n+Nat.add(ub, Nat.add(un, ua)), nat__add_succ(ub, Nat.add(un, ua)))))

# (v - a) + a == v
def u32alg__w_add_sub(+n: Nat, +a: Word(n), +b: Word(n)) -> {Word.sub(n, Word.add(n, a, b), a) == b : Word(n)}:
  +ux = u32alg__uw(n, Word.add(n, a, b))
  +ua = u32alg__uw(n, a)
  +ub = u32alg__uw(n, b)
  +un = u32alg__uw(n, Word.not(n, a))
  +r = u32alg__uw(n, Word.sub(n, Word.add(n, a, b), a))
  +c1 = u32alg__cy(n, a, b, False{})
  +c5 = u32alg__cy(n, Word.add(n, a, b), Word.not(n, a), True{})
  +e2 = u32alg__cons(n, a, b)
  +e5 = u32alg__cons_sub(n, Word.add(n, a, b), a)
  +nv = u32alg__not_value(n, a)
  # r + sc(c5 + c1) == ub + sc(1)
  +chain = Equal.trans(Nat, Nat.add(r, u32alg__sc(n, Nat.add(c5, c1))), Nat.add(Nat.add(r, u32alg__sc(n, c5)), u32alg__sc(n, c1)), Nat.add(ub, u32alg__sc(n, 1n)),
    %u32alg__sc_add(n, c5, c1) : {Nat.add(r, _) == Nat.add(Nat.add(r, u32alg__sc(n, c5)), u32alg__sc(n, c1)) : Nat}
    Equal.sym(Nat, Nat.add(Nat.add(r, u32alg__sc(n, c5)), u32alg__sc(n, c1)), Nat.add(r, Nat.add(u32alg__sc(n, c5), u32alg__sc(n, c1))), nat__add_assoc(r, u32alg__sc(n, c5), u32alg__sc(n, c1))),
    %Equal.sym(Nat, Nat.add(r, u32alg__sc(n, c5)), Nat.add(1n, Nat.add(ux, un)), e5) : {Nat.add(_, u32alg__sc(n, c1)) == Nat.add(ub, u32alg__sc(n, 1n)) : Nat}
    %nv : {Nat.add(Nat.add(1n, Nat.add(ux, un)), u32alg__sc(n, c1)) == Nat.add(ub, _) : Nat}
    u32alg__arith_sub(ux, un, ua, ub, u32alg__sc(n, c1), e2))
  u32alg__w_inj(n, Word.sub(n, Word.add(n, a, b), a), b, u32alg__uniq(n, r, ub, Nat.add(c5, c1), 1n, chain, u32__WB_unsigned(n, Word.sub(n, Word.add(n, a, b), a)), u32__WB_unsigned(n, b)))

# (v - a) + a == v
def u32alg__w_sub_add(+n: Nat, +v: Word(n), +a: Word(n)) -> {Word.add(n, Word.sub(n, v, a), a) == v : Word(n)}:
  +uv = u32alg__uw(n, v)
  +ua = u32alg__uw(n, a)
  +un = u32alg__uw(n, Word.not(n, a))
  +us = u32alg__uw(n, Word.sub(n, v, a))
  +ut = u32alg__uw(n, Word.add(n, Word.sub(n, v, a), a))
  +c5 = u32alg__cy(n, v, Word.not(n, a), True{})
  +c6 = u32alg__cy(n, Word.sub(n, v, a), a, False{})
  +e5 = u32alg__cons_sub(n, v, a)
  +e6 = u32alg__cons(n, Word.sub(n, v, a), a)
  +nv = u32alg__not_value(n, a)
  +tail = Equal.trans(Nat, Nat.add(Nat.add(1n, Nat.add(uv, un)), ua), 1n+Nat.add(uv, Nat.add(un, ua)), Nat.add(uv, u32alg__sc(n, 1n)),
    nat__succ_cong(Nat.add(Nat.add(uv, un), ua), Nat.add(uv, Nat.add(un, ua)), nat__add_assoc(uv, un, ua)),
    Equal.trans(Nat, 1n+Nat.add(uv, Nat.add(un, ua)), Nat.add(uv, 1n+Nat.add(un, ua)), Nat.add(uv, u32alg__sc(n, 1n)), Equal.sym(Nat, Nat.add(uv, 1n+Nat.add(un, ua)), 1n+Nat.add(uv, Nat.add(un, ua)), nat__add_succ(uv, Nat.add(un, ua))), Equal.cong(Nat, Nat, z => Nat.add(uv, z), Nat.add(1n, Nat.add(un, ua)), u32alg__sc(n, 1n), nv)))
  +chain = Equal.trans(Nat, Nat.add(ut, u32alg__sc(n, Nat.add(c6, c5))), Nat.add(Nat.add(ut, u32alg__sc(n, c6)), u32alg__sc(n, c5)), Nat.add(uv, u32alg__sc(n, 1n)),
    %u32alg__sc_add(n, c6, c5) : {Nat.add(ut, _) == Nat.add(Nat.add(ut, u32alg__sc(n, c6)), u32alg__sc(n, c5)) : Nat}
    Equal.sym(Nat, Nat.add(Nat.add(ut, u32alg__sc(n, c6)), u32alg__sc(n, c5)), Nat.add(ut, Nat.add(u32alg__sc(n, c6), u32alg__sc(n, c5))), nat__add_assoc(ut, u32alg__sc(n, c6), u32alg__sc(n, c5))),
    %Equal.sym(Nat, Nat.add(ut, u32alg__sc(n, c6)), Nat.add(us, ua), e6) : {Nat.add(_, u32alg__sc(n, c5)) == Nat.add(uv, u32alg__sc(n, 1n)) : Nat}
    %Equal.sym(Nat, Nat.add(Nat.add(us, ua), u32alg__sc(n, c5)), Nat.add(Nat.add(us, u32alg__sc(n, c5)), ua), u32alg__add_rot(us, ua, u32alg__sc(n, c5))) : {_ == Nat.add(uv, u32alg__sc(n, 1n)) : Nat}
    %Equal.sym(Nat, Nat.add(us, u32alg__sc(n, c5)), Nat.add(1n, Nat.add(uv, un)), e5) : {Nat.add(_, ua) == Nat.add(uv, u32alg__sc(n, 1n)) : Nat}
    tail)
  u32alg__w_inj(n, Word.add(n, Word.sub(n, v, a), a), v, u32alg__uniq(n, ut, uv, Nat.add(c6, c5), 1n, chain, u32__WB_unsigned(n, Word.add(n, Word.sub(n, v, a), a)), u32__WB_unsigned(n, v)))

# Doubling by shifting: shl.put n c w == w + w + c.
def u32alg__shl_adc(+n: Nat, +w: Word(n), +c: Bool) -> {Word.shl.put(n, c, w) == Word.adc(n, w, w, False{}, c) : Word(n)}:
  match n:
    case 0n:
      match w:
        case WNil{}:
          {==}
    case 1n+p:
      match w:
        case WCon{True{}, t}:
          match c:
            case True{}:
              Equal.cong(Word(p), Word(1n+p), x => WCon{True{}, x}, Word.shl.put(p, True{}, t), Word.adc(p, t, t, False{}, True{}), u32alg__shl_adc(p, t, True{}))
            case False{}:
              Equal.cong(Word(p), Word(1n+p), x => WCon{False{}, x}, Word.shl.put(p, True{}, t), Word.adc(p, t, t, False{}, True{}), u32alg__shl_adc(p, t, True{}))
        case WCon{False{}, t}:
          match c:
            case True{}:
              Equal.cong(Word(p), Word(1n+p), x => WCon{True{}, x}, Word.shl.put(p, False{}, t), Word.adc(p, t, t, False{}, False{}), u32alg__shl_adc(p, t, False{}))
            case False{}:
              Equal.cong(Word(p), Word(1n+p), x => WCon{False{}, x}, Word.shl.put(p, False{}, t), Word.adc(p, t, t, False{}, False{}), u32alg__shl_adc(p, t, False{}))

def u32alg__w_shl(+n: Nat, +w: Word(n)) -> {Word.shl(n, w) == Word.add(n, w, w) : Word(n)}:
  match n:
    case 0n:
      match w:
        case WNil{}:
          {==}
    case 1n+p:
      match w:
        case WCon{b, t}:
          u32alg__shl_adc(1n+p, WCon{b, t}, False{})

# ---- U32 ----
def u32alg__assoc(+a: U32, +b: U32, +c: U32) -> {U32.add(U32.add(a, b), c) == U32.add(a, U32.add(b, c)) : U32}:
  match a b c:
    case U32{x} U32{y} U32{z}:
      Equal.cong(Word(32n), U32, w => U32{w}, Word.add(32n, Word.add(32n, x, y), z), Word.add(32n, x, Word.add(32n, y, z)), u32alg__w_assoc(32n, x, y, z))

def u32alg__comm(+a: U32, +b: U32) -> {U32.add(a, b) == U32.add(b, a) : U32}:
  U32.add_comm(a, b)

def u32alg__zero_add(+b: U32) -> {U32.add(0, b) == b : U32}:
  match b:
    case U32{y}:
      Equal.cong(Word(32n), U32, w => U32{w}, Word.add(32n, Word.zero(32n), y), y, u32alg__w_zero_add(32n, y))

def u32alg__add_zero(+b: U32) -> {U32.add(b, 0) == b : U32}:
  Equal.trans(U32, U32.add(b, 0), U32.add(0, b), b, U32.add_comm(b, 0), u32alg__zero_add(b))

def u32alg__add_sub(+a: U32, +b: U32) -> {U32.sub(U32.add(a, b), a) == b : U32}:
  match a b:
    case U32{x} U32{y}:
      Equal.cong(Word(32n), U32, w => U32{w}, Word.sub(32n, Word.add(32n, x, y), x), y, u32alg__w_add_sub(32n, x, y))

def u32alg__sub_add(+v: U32, +a: U32) -> {U32.add(U32.sub(v, a), a) == v : U32}:
  match v a:
    case U32{x} U32{y}:
      Equal.cong(Word(32n), U32, w => U32{w}, Word.add(32n, Word.sub(32n, x, y), y), x, u32alg__w_sub_add(32n, x, y))

def u32alg__shl_add(+x: U32) -> {U32.shl(x) == U32.add(x, x) : U32}:
  match x:
    case U32{w}:
      Equal.cong(Word(32n), U32, v => U32{v}, Word.shl(32n, w), Word.add(32n, w, w), u32alg__w_shl(32n, w))

# a + (b + c) == b + (a + c)
def u32alg__swap(+a: U32, +b: U32, +c: U32) -> {U32.add(a, U32.add(b, c)) == U32.add(b, U32.add(a, c)) : U32}:
  %u32alg__assoc(a, b, c) : {_ == U32.add(b, U32.add(a, c)) : U32}
  %u32alg__assoc(b, a, c) : {U32.add(U32.add(a, b), c) == _ : U32}
  %U32.add_comm(a, b) : {U32.add(U32.add(a, b), c) == U32.add(_, c) : U32}
  {==}

# ---- U32 equality as a Bool ----
def u32alg__eq_of(+a: U32, +b: U32, +h: {U32.is_eq(a, b) == True{} : Bool}) -> {a == b : U32}:
  u32__injective(a, b, nat__eq_from_is_eq(U32.to_nat(a), U32.to_nat(b), logic__subst(Cmp, c => {Cmp.is_eq(c) == True{} : Bool}, U32.cmp(a, b), Nat.cmp(U32.to_nat(a), U32.to_nat(b)), u32__u32_cmp(a, b), h)))

def u32alg__eq_refl(+a: U32) -> {U32.is_eq(a, a) == True{} : Bool}:
  %Equal.sym(Cmp, U32.cmp(a, a), Nat.cmp(U32.to_nat(a), U32.to_nat(a)), u32__u32_cmp(a, a)) : {Cmp.is_eq(_) == True{} : Bool}
  nat__is_eq_refl(U32.to_nat(a))

def u32alg__eq_true(+a: U32, +b: U32, +e: {a == b : U32}) -> {U32.is_eq(a, b) == True{} : Bool}:
  %e : {U32.is_eq(a, _) == True{} : Bool}
  u32alg__eq_refl(a)


# ==== proofs/lib/u32half.bend ====

# The Nat halving the checker can compute structurally (no Nat.div).
def u32half__hlf(n: Nat) -> Nat:
  match n:
    case 0n:
      0n
    case 1n+p:
      match p:
        case 0n:
          0n
        case 1n+q:
          1n+u32half__hlf(q)

def u32half__hlf_double(+q: Nat) -> {u32half__hlf(Nat.double(q)) == q : Nat}:
  match q:
    case 0n:
      {==}
    case 1n+p:
      Equal.cong(Nat, Nat, n => 1n+n, u32half__hlf(Nat.double(p)), p, u32half__hlf_double(p))

def u32half__hlf_double_succ(+q: Nat) -> {u32half__hlf(1n+Nat.double(q)) == q : Nat}:
  match q:
    case 0n:
      {==}
    case 1n+p:
      Equal.cong(Nat, Nat, n => 1n+n, u32half__hlf(1n+Nat.double(p)), p, u32half__hlf_double_succ(p))

def u32half__hlf_bit(+b: Bool, +q: Nat) -> {u32half__hlf(Nat.add(spec_numeric__bit_value(b), Nat.double(q))) == q : Nat}:
  match b:
    case False{}:
      u32half__hlf_double(q)
    case True{}:
      u32half__hlf_double_succ(q)

def u32half__shr_value(+x: U32) -> {U32.to_nat(U32.shr(x)) == u32half__hlf(U32.to_nat(x)) : Nat}:
  %Equal.sym(Nat, U32.to_nat(x), Nat.add(spec_numeric__bit_value(u32__low_bit(x)), Nat.double(U32.to_nat(U32.shr(x)))), u32__shr_split(x)) : {U32.to_nat(U32.shr(x)) == u32half__hlf(_) : Nat}
  Equal.sym(Nat, u32half__hlf(Nat.add(spec_numeric__bit_value(u32__low_bit(x)), Nat.double(U32.to_nat(U32.shr(x))))), U32.to_nat(U32.shr(x)),
    u32half__hlf_bit(u32__low_bit(x), U32.to_nat(U32.shr(x))))

# ---- halving respects the order ----
def u32half__hlf_le(+n: Nat) -> {Nat.is_le(u32half__hlf(n), n) == True{} : Bool}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      match p:
        case 0n:
          {==}
        case 1n+q:
          nat__le_trans(u32half__hlf(q), q, 1n+q, u32half__hlf_le(q), nat__le_succ(q))

def u32half__hlf_succ_le(+q: Nat) -> {Nat.is_le(u32half__hlf(1n+q), q) == True{} : Bool}:
  match q:
    case 0n:
      {==}
    case 1n+r:
      u32half__hlf_le(r)

# The midpoint of a nonempty range lies inside it: a <= hlf(a+b) < b
# whenever a < b.
def u32half__hlf_lower(+a: Nat, +b: Nat, +h: {Nat.is_lt(a, b) == True{} : Bool}) -> {Nat.is_le(a, u32half__hlf(Nat.add(a, b))) == True{} : Bool}:
  match a b:
    case 0n b0:
      nat__zero_le(u32half__hlf(Nat.add(0n, b0)))
    case 1n+p 0n:
      Empty.absurd({Nat.is_le(1n+p, u32half__hlf(Nat.add(1n+p, 0n))) == True{} : Bool}, logic__false_true(h))
    case 1n+ +p 1n+ +q:
      %Equal.sym(Nat, Nat.add(p, 1n+q), 1n+Nat.add(p, q), nat__add_succ(p, q)) : {Nat.is_le(1n+p, u32half__hlf(1n+_)) == True{} : Bool}
      u32half__hlf_lower(p, q, h)

def u32half__hlf_upper(+a: Nat, +b: Nat, +h: {Nat.is_lt(a, b) == True{} : Bool}) -> {Nat.is_lt(u32half__hlf(Nat.add(a, b)), b) == True{} : Bool}:
  match a b:
    case 0n 0n:
      Empty.absurd({Nat.is_lt(u32half__hlf(Nat.add(0n, 0n)), 0n) == True{} : Bool}, logic__false_true(h))
    case 0n 1n+ +q:
      nat__le_lt_trans(u32half__hlf(1n+q), q, 1n+q, u32half__hlf_succ_le(q), nat__lt_succ(q))
    case 1n+p 0n:
      Empty.absurd({Nat.is_lt(u32half__hlf(Nat.add(1n+p, 0n)), 0n) == True{} : Bool}, logic__false_true(h))
    case 1n+ +p 1n+ +q:
      %Equal.sym(Nat, Nat.add(p, 1n+q), 1n+Nat.add(p, q), nat__add_succ(p, q)) : {Nat.is_lt(u32half__hlf(1n+_), 1n+q) == True{} : Bool}
      u32half__hlf_upper(p, q, h)

# ---- from_nat / sub bridges used with the halving one ----
# The graph implementation avoids `U32.add` entirely (its Nat meaning would
# need a 2^32 bound, and the checker cannot expand 2^32 as a unary Nat), so
# only halving and subtraction bridges are needed. Subtraction is
# proofs/lib/u32.bend `sub_nat`; halving is `shr_value` above.
def u32half__hlf_bound(+i: Nat, +k: Nat, +h: {Nat.is_lt(i, spec_common__pow2(k)) == True{} : Bool}) -> {Nat.is_lt(u32half__hlf(i), spec_common__pow2(k)) == True{} : Bool}:
  nat__le_lt_trans(u32half__hlf(i), i, spec_common__pow2(k), u32half__hlf_le(i), h)

def u32half__shr_bridge(+i: Nat, +k: Nat, +hk: {Nat.is_le(k, 32n) == True{} : Bool}, +hi: {Nat.is_lt(i, spec_common__pow2(k)) == True{} : Bool}) -> {U32.shr(U32.from_nat(i)) == U32.from_nat(u32half__hlf(i)) : U32}:
  +ri = u32__to_nat_from_nat(i, k, hk, hi)
  u32__injective(U32.shr(U32.from_nat(i)), U32.from_nat(u32half__hlf(i)),
    Equal.trans(Nat, U32.to_nat(U32.shr(U32.from_nat(i))), u32half__hlf(i), U32.to_nat(U32.from_nat(u32half__hlf(i))),
      Equal.trans(Nat, U32.to_nat(U32.shr(U32.from_nat(i))), u32half__hlf(U32.to_nat(U32.from_nat(i))), u32half__hlf(i),
        u32half__shr_value(U32.from_nat(i)),
        Equal.cong(Nat, Nat, u32half__hlf, U32.to_nat(U32.from_nat(i)), i, ri)),
      Equal.sym(Nat, U32.to_nat(U32.from_nat(u32half__hlf(i))), u32half__hlf(i),
        u32__to_nat_from_nat(u32half__hlf(i), k, hk, u32half__hlf_bound(i, k, hi)))))

# ---- the halving measure used by the binary search ----
# s < 2m gives s/2 < m: one narrowing step of a search range that started
# below 2^f lands below 2^(f-1).
def u32half__hlf_lt(+s: Nat, +m: Nat, +h: {Nat.is_lt(s, Nat.double(m)) == True{} : Bool}) -> {Nat.is_lt(u32half__hlf(s), m) == True{} : Bool}:
  match s m:
    case s0 0n:
      Empty.absurd({Nat.is_lt(u32half__hlf(s0), 0n) == True{} : Bool}, nat__lt_zero_absurd(s0, h))
    case 0n 1n+q:
      {==}
    case 1n+0n 1n+q:
      {==}
    case 1n+1n+r 1n+q:
      u32half__hlf_lt(r, q, h)

# The size after one step is at most s/2, so it stays below the halved bound.
def u32half__step_bound(+s2: Nat, +s: Nat, +m: Nat, +hle: {Nat.is_le(s2, u32half__hlf(s)) == True{} : Bool}, +h: {Nat.is_lt(s, Nat.double(m)) == True{} : Bool}) -> {Nat.is_lt(s2, m) == True{} : Bool}:
  nat__le_lt_trans(s2, u32half__hlf(s), m, hle, u32half__hlf_lt(s, m, h))

# ---- subtraction bridge ----
# U32.sub is exact whenever the subtrahend is not larger (no borrow), so it
# is the Nat subtraction of the two indices.
def u32half__sub_le(+a: Nat, +b: Nat) -> {Nat.is_le(Nat.sub(a, b), a) == True{} : Bool}:
  match a b:
    case a0 0n:
      logic__subst(Nat, z => {Nat.is_le(z, a0) == True{} : Bool}, a0, Nat.sub(a0, 0n), Equal.sym(Nat, Nat.sub(a0, 0n), a0, nat__sub_zero(a0)), nat__le_refl(a0))
    case 0n 1n+q:
      nat__zero_le(Nat.sub(0n, 1n+q))
    case 1n+p 1n+q:
      nat__le_trans(Nat.sub(p, q), p, 1n+p, u32half__sub_le(p, q), nat__le_succ(p))

def u32half__sub_bridge(+a: Nat, +b: Nat, +k: Nat, +hk: {Nat.is_le(k, 32n) == True{} : Bool}, +ha: {Nat.is_lt(a, spec_common__pow2(k)) == True{} : Bool}, +hb: {Nat.is_le(b, a) == True{} : Bool}) -> {U32.sub(U32.from_nat(a), U32.from_nat(b)) == U32.from_nat(Nat.sub(a, b)) : U32}:
  +hb2 = nat__le_lt_trans(b, a, spec_common__pow2(k), hb, ha)
  +ra = u32__to_nat_from_nat(a, k, hk, ha)
  +rb = u32__to_nat_from_nat(b, k, hk, hb2)
  +le = logic__subst(Nat, z => {Nat.is_le(z, U32.to_nat(U32.from_nat(a))) == True{} : Bool}, b, U32.to_nat(U32.from_nat(b)), Equal.sym(Nat, U32.to_nat(U32.from_nat(b)), b, rb),
          logic__subst(Nat, z => {Nat.is_le(b, z) == True{} : Bool}, a, U32.to_nat(U32.from_nat(a)), Equal.sym(Nat, U32.to_nat(U32.from_nat(a)), a, ra), hb))
  u32__injective(U32.sub(U32.from_nat(a), U32.from_nat(b)), U32.from_nat(Nat.sub(a, b)),
    Equal.trans(Nat, U32.to_nat(U32.sub(U32.from_nat(a), U32.from_nat(b))), Nat.sub(a, b), U32.to_nat(U32.from_nat(Nat.sub(a, b))),
      Equal.trans(Nat, U32.to_nat(U32.sub(U32.from_nat(a), U32.from_nat(b))), Nat.sub(U32.to_nat(U32.from_nat(a)), U32.to_nat(U32.from_nat(b))), Nat.sub(a, b),
        u32__sub_nat(U32.from_nat(a), U32.from_nat(b), le),
        Equal.trans(Nat, Nat.sub(U32.to_nat(U32.from_nat(a)), U32.to_nat(U32.from_nat(b))), Nat.sub(a, U32.to_nat(U32.from_nat(b))), Nat.sub(a, b),
          Equal.cong(Nat, Nat, z => Nat.sub(z, U32.to_nat(U32.from_nat(b))), U32.to_nat(U32.from_nat(a)), a, ra),
          Equal.cong(Nat, Nat, z => Nat.sub(a, z), U32.to_nat(U32.from_nat(b)), b, rb))),
      Equal.sym(Nat, U32.to_nat(U32.from_nat(Nat.sub(a, b))), Nat.sub(a, b),
        u32__to_nat_from_nat(Nat.sub(a, b), k, hk, nat__le_lt_trans(Nat.sub(a, b), a, spec_common__pow2(k), u32half__sub_le(a, b), ha)))))

