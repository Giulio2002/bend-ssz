    case 0n 0n:
      match x y:
        case False{} False{}: {==}
        case False{} True{}: {==}
        case True{} False{}: {==}
        case True{} True{}: {==}
    case 0n 1n+p:
      match x y:
        case False{} False{}: {==}
        case False{} True{}: {==}
        case True{} False{}: {==}
        case True{} True{}: {==}
    case 1n+p 0n:
      match x y:
        case False{} False{}: {==}
        case False{} True{}: {==}
        case True{} False{}: {==}
        case True{} True{}: {==}
    case 1n+p 1n+q:
      match x y:
        case False{} False{}: lru_word_comparison__digits(p, q, False{}, False{})
        case False{} True{}: lru_word_comparison__digits(p, q, False{}, True{})
        case True{} False{}: lru_word_comparison__digits(p, q, True{}, False{})
        case True{} True{}: lru_word_comparison__digits(p, q, True{}, True{})

