    %u32alg__sc_add(n, c3, c1) : {Nat.add(uL, _) == Nat.add(Nat.add(uL, u32alg__sc(n, c3)), u32alg__sc(n, c1)) : Nat}
    Equal.sym(Nat, Nat.add(Nat.add(uL, u32alg__sc(n, c3)), u32alg__sc(n, c1)), Nat.add(uL, Nat.add(u32alg__sc(n, c3), u32alg__sc(n, c1))), nat__add_assoc(uL, u32alg__sc(n, c3), u32alg__sc(n, c1))),
    %Equal.sym(Nat, Nat.add(uL, u32alg__sc(n, c3)), Nat.add(us, uc), e1) : {Nat.add(_, u32alg__sc(n, c1)) == Nat.add(Nat.add(ua, ub), uc) : Nat}
    %Equal.sym(Nat, Nat.add(Nat.add(us, uc), u32alg__sc(n, c1)), Nat.add(Nat.add(us, u32alg__sc(n, c1)), uc), u32alg__add_rot(us, uc, u32alg__sc(n, c1))) : {_ == Nat.add(Nat.add(ua, ub), uc) : Nat}
    %Equal.sym(Nat, Nat.add(us, u32alg__sc(n, c1)), Nat.add(ua, ub), e2) : {Nat.add(_, uc) == Nat.add(Nat.add(ua, ub), uc) : Nat}
    {==})
  # uR + sc(c4 + c2) == (ua + ub) + uc
  +right = Equal.trans(Nat, Nat.add(uR, u32alg__sc(n, Nat.add(c4, c2))), Nat.add(Nat.add(uR, u32alg__sc(n, c4)), u32alg__sc(n, c2)), Nat.add(Nat.add(ua, ub), uc),
    %u32alg__sc_add(n, c4, c2) : {Nat.add(uR, _) == Nat.add(Nat.add(uR, u32alg__sc(n, c4)), u32alg__sc(n, c2)) : Nat}
    Equal.sym(Nat, Nat.add(Nat.add(uR, u32alg__sc(n, c4)), u32alg__sc(n, c2)), Nat.add(uR, Nat.add(u32alg__sc(n, c4), u32alg__sc(n, c2))), nat__add_assoc(uR, u32alg__sc(n, c4), u32alg__sc(n, c2))),
    %Equal.sym(Nat, Nat.add(uR, u32alg__sc(n, c4)), Nat.add(ua, ut), e3) : {Nat.add(_, u32alg__sc(n, c2)) == Nat.add(Nat.add(ua, ub), uc) : Nat}
    %Equal.sym(Nat, Nat.add(Nat.add(ua, ut), u32alg__sc(n, c2)), Nat.add(ua, Nat.add(ut, u32alg__sc(n, c2))), nat__add_assoc(ua, ut, u32alg__sc(n, c2))) : {_ == Nat.add(Nat.add(ua, ub), uc) : Nat}
    %Equal.sym(Nat, Nat.add(ut, u32alg__sc(n, c2)), Nat.add(ub, uc), e4) : {Nat.add(ua, _) == Nat.add(Nat.add(ua, ub), uc) : Nat}
    Equal.sym(Nat, Nat.add(Nat.add(ua, ub), uc), Nat.add(ua, Nat.add(ub, uc)), nat__add_assoc(ua, ub, uc)))
  u32alg__w_inj(n, Word.add(n, Word.add(n, a, b), c), Word.add(n, a, Word.add(n, b, c)), u32alg__uniq(n, uL, uR, Nat.add(c3, c1), Nat.add(c4, c2), Equal.trans(Nat, Nat.add(uL, u32alg__sc(n, Nat.add(c3, c1))), Nat.add(Nat.add(ua, ub), uc), Nat.add(uR, u32alg__sc(n, Nat.add(c4, c2))), left, Equal.sym(Nat, Nat.add(uR, u32alg__sc(n, Nat.add(c4, c2))), Nat.add(Nat.add(ua, ub), uc), right)), u32__WB_unsigned(n, Word.add(n, Word.add(n, a, b), c)), u32__WB_unsigned(n, Word.add(n, a, Word.add(n, b, c)))))

# ---- subtraction ----
def u32alg__adc_con_not(+p: Nat, +at: Word(p), +bt: Word(p), sk: Bool & Bool, ih: @+k: Bool -> {Word.adc(p, at, bt, True{}, k) == Word.adc(p, at, Word.not(p, bt), False{}, k) : Word(p)}) -> {Word.adc.con(p, at, bt, True{}, sk) == Word.adc.con(p, at, Word.not(p, bt), False{}, sk) : Word(1n+p)}:
  match sk:
    case Tuple{s, k}:
      Equal.cong(Word(p), Word(1n+p), w => WCon{s, w}, Word.adc(p, at, bt, True{}, k), Word.adc(p, at, Word.not(p, bt), False{}, k), ih(k))

# Subtraction is addition of the complement with an incoming carry.
def u32alg__adc_not(+n: Nat, +a: Word(n), +b: Word(n), +c: Bool) -> {Word.adc(n, a, b, True{}, c) == Word.adc(n, a, Word.not(n, b), False{}, c) : Word(n)}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      match a b:
        case WCon{x, at} WCon{y, bt}:
          u32alg__adc_con_not(p, at, bt, Bool.full_add(x, Bool.not(y), c), k => u32alg__adc_not(p, at, bt, k))

# 1 + unsigned(not b) + unsigned(b) == 2^n
def u32alg__not_value(+n: Nat, +b: Word(n)) -> {Nat.add(1n, Nat.add(u32alg__uw(n, Word.not(n, b)), u32alg__uw(n, b))) == u32alg__sc(n, 1n) : Nat}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      match b:
        case WCon{True{}, bt}:
          +ih = u32alg__not_value(p, bt)
          -A = u32alg__uw(p, Word.not(p, bt))
          -B = u32alg__uw(p, bt)
          # 1 + (0 + 2A) + (1 + 2B) == 2 (1 + (A + B))
          %Equal.sym(Nat, Nat.add(Nat.double(u32alg__uw(p, Word.not(p, bt))), 1n+Nat.double(u32alg__uw(p, bt))), 1n+Nat.add(Nat.double(u32alg__uw(p, Word.not(p, bt))), Nat.double(u32alg__uw(p, bt))), nat__add_succ(Nat.double(u32alg__uw(p, Word.not(p, bt))), Nat.double(u32alg__uw(p, bt)))) : {1n+_ == Nat.double(u32alg__sc(p, 1n)) : Nat}
          %Equal.sym(Nat, u32alg__sc(p, 1n), Nat.add(1n, Nat.add(u32alg__uw(p, Word.not(p, bt)), u32alg__uw(p, bt))), Equal.sym(Nat, Nat.add(1n, Nat.add(u32alg__uw(p, Word.not(p, bt)), u32alg__uw(p, bt))), u32alg__sc(p, 1n), ih)) : {2n+Nat.add(Nat.double(u32alg__uw(p, Word.not(p, bt))), Nat.double(u32alg__uw(p, bt))) == Nat.double(_) : Nat}
          Equal.cong(Nat, Nat, z => 2n+z, Nat.add(Nat.double(u32alg__uw(p, Word.not(p, bt))), Nat.double(u32alg__uw(p, bt))), Nat.double(Nat.add(u32alg__uw(p, Word.not(p, bt)), u32alg__uw(p, bt))), nat__add_double(u32alg__uw(p, Word.not(p, bt)), u32alg__uw(p, bt)))
        case WCon{False{}, bt}:
