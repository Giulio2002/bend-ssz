def list__sc_nth_take(-A: Data, +xs: List<&2, A>, +n: Nat, +i: Nat, +h: {Nat.is_lt(i, n) == True{} : Bool}) -> {spec_common__nth(A, spec_common__take(A, xs, n), i) == spec_common__nth(A, xs, i) : Maybe<&2, A>}:
