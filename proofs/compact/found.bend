          Equal.cong(Nat, Nat, x => 1n+Nat.double(x), Word.to_nat(p, tail), spec_numeric__unsigned(p, tail), lru_numeric__primitive_word_interpretation(p, tail))


# ==== reference/lru/proofs/counter.bend ====

# Carry out is mathematical all-bits-set, not an assumed increment result.
def lru_counter__carry(n: Nat, w: Word(n)) -> Bool:
  match n:
    case 0n:
      True{}
    case 1n+p:
      match w:
        case WCon{b, tail}:
          b && lru_counter__carry(p, tail)

law lru_counter__scale_zero:
  for n: Nat
  {spec_numeric__scale_binary(n, 0n) == 0n : Nat}

def lru_counter__scale_zero(n):
  match n:
    case 0n:
      {==}
    case 1n+p:
      Equal.cong(Nat, Nat, Nat.double, spec_numeric__scale_binary(p, 0n), 0n, lru_counter__scale_zero(p))

# Exact integer conservation for the installed ripple increment at every width:
# result + (carry-out * 2^width) = input + 1. This includes width zero and proves
# all bit patterns, rather than testing only the maximum-word rollover example.
law lru_counter__increment_conservation:
  for +n: Nat
  for w: Word(n)
  {Nat.add(spec_numeric__unsigned(n, Word.inc(n, w)), spec_numeric__scale_binary(n, spec_numeric__bit_value(lru_counter__carry(n, w)))) == 1n+spec_numeric__unsigned(n, w) : Nat}

def lru_counter__increment_conservation(n, w):
  match n:
    case 0n:
      {==}
    case 1n+ +p:
      match w:
        case WCon{False{}, +tail}:
          %Equal.sym(Nat, spec_numeric__scale_binary(p, 0n), 0n, lru_counter__scale_zero(p)) : {Nat.add(1n+Nat.double(spec_numeric__unsigned(p, tail)), Nat.double(_)) == 1n+Nat.double(spec_numeric__unsigned(p, tail)) : Nat}
          lru_native_map__natural_add_right_zero(1n+Nat.double(spec_numeric__unsigned(p, tail)))
        case WCon{True{}, +tail}:
          Equal.trans(Nat, Nat.add(Nat.double(spec_numeric__unsigned(p, Word.inc(p, tail))), Nat.double(spec_numeric__scale_binary(p, spec_numeric__bit_value(lru_counter__carry(p, tail))))), Nat.double(Nat.add(spec_numeric__unsigned(p, Word.inc(p, tail)), spec_numeric__scale_binary(p, spec_numeric__bit_value(lru_counter__carry(p, tail))))), 2n+Nat.double(spec_numeric__unsigned(p, tail)), Equal.sym(Nat, Nat.double(Nat.add(spec_numeric__unsigned(p, Word.inc(p, tail)), spec_numeric__scale_binary(p, spec_numeric__bit_value(lru_counter__carry(p, tail))))), Nat.add(Nat.double(spec_numeric__unsigned(p, Word.inc(p, tail))), Nat.double(spec_numeric__scale_binary(p, spec_numeric__bit_value(lru_counter__carry(p, tail))))), lru_numeric__double_add(spec_numeric__unsigned(p, Word.inc(p, tail)), spec_numeric__scale_binary(p, spec_numeric__bit_value(lru_counter__carry(p, tail))))), Equal.cong(Nat, Nat, Nat.double, Nat.add(spec_numeric__unsigned(p, Word.inc(p, tail)), spec_numeric__scale_binary(p, spec_numeric__bit_value(lru_counter__carry(p, tail)))), 1n+spec_numeric__unsigned(p, tail), lru_counter__increment_conservation(p, tail)))


# ==== reference/lru/proofs/map_index.bend ====

# Existing Base.divmod quotient translation; no replacement division algorithm.
def lru_map_index__next_quotient(pair: Nat & Nat) -> Nat & Nat:
  (q, r) = pair
  (1n+q, r)

law lru_map_index__quotient_translation:
  for n: Nat
  for m: Nat
  for +q: Nat
  for r: Nat
  {Nat.divmod.go(n, m, 1n+q, r) == lru_map_index__next_quotient(Nat.divmod.go(n, m, q, r)) : Nat & Nat}

def lru_map_index__quotient_translation(n, m, q, r):
  match n:
    case 0n: {==}
    case 1n+p:
      match m:
        case 0n:
          lru_map_index__quotient_translation(p, r, 1n+q, 0n)
        case 1n+k:
          lru_map_index__quotient_translation(p, k, q, 1n+r)

law lru_map_index__add_right_successor:
  for a: Nat
  for +b: Nat
  {Nat.add(a, 1n+b) == 1n+Nat.add(a, b) : Nat}

def lru_map_index__add_right_successor(a, b):
  match a:
    case 0n: {==}
    case 1n+ +p:
      Equal.cong(Nat, Nat, n => 1n+n, Nat.add(p, 1n+b), 1n+Nat.add(p, b), lru_map_index__add_right_successor(p, b))


# ==== reference/lru/proofs/modular_addition.bend ====

# The binary constructor in the independent specification uses Base Nat.divmod.
# Establish its behavior against that existing algorithm, for arbitrary Nat.
