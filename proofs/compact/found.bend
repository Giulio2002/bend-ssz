# ==== proofs/lib/logic.bend ====

def logic__truth(b: Bool) -> Type:
  match b:
    case False{}:
      Empty
    case True{}:
      Unit

def logic__false_true(e: {False{} == True{} : Bool}) -> Empty:
  %Equal.sym(Bool, False{}, True{}, e) : logic__truth(_)
  Unit{}

def logic__true_false(e: {True{} == False{} : Bool}) -> Empty:
  logic__false_true(Equal.sym(Bool, True{}, False{}, e))

def logic__and_left(a: Bool, b: Bool, e: {Bool.and(a, b) == True{} : Bool}) -> {a == True{} : Bool}:
  match a:
    case False{}:
      Empty.absurd({False{} == True{} : Bool}, logic__false_true(e))
    case True{}:
      {==}

def logic__and_right(a: Bool, b: Bool, e: {Bool.and(a, b) == True{} : Bool}) -> {b == True{} : Bool}:
  match a:
    case False{}:
      Empty.absurd({b == True{} : Bool}, logic__false_true(e))
    case True{}:
      e

def logic__and_intro(a: Bool, b: Bool, ea: {a == True{} : Bool}, eb: {b == True{} : Bool}) -> {Bool.and(a, b) == True{} : Bool}:
  %Equal.sym(Bool, a, True{}, ea) : {Bool.and(_, b) == True{} : Bool}
  eb

def logic__not_true(b: Bool, e: {Bool.not(b) == True{} : Bool}) -> {b == False{} : Bool}:
  match b:
    case False{}:
      {==}
    case True{}:
      Empty.absurd({True{} == False{} : Bool}, logic__false_true(e))

def logic__not_false(b: Bool, e: {b == False{} : Bool}) -> {Bool.not(b) == True{} : Bool}:
  %Equal.sym(Bool, b, False{}, e) : {Bool.not(_) == True{} : Bool}
  {==}

def logic__bool_cases(b: Bool) -> Or({b == True{} : Bool}, {b == False{} : Bool}):
  match b:
    case True{}:
      Inl{{==}}
    case False{}:
      Inr{{==}}

def logic__true_not_false(b: Bool, t: {b == True{} : Bool}, f: {b == False{} : Bool}) -> Empty:
  logic__false_true(Equal.trans(Bool, False{}, b, True{}, Equal.sym(Bool, b, False{}, f), t))

# Cmp discrimination.
def logic__cmp_code(c: Cmp) -> Nat:
  match c:
    case LT{}:
      0n
    case EQ{}:
      1n
    case GT{}:
      2n

def logic__cmp_lt_eq(e: {LT{} == EQ{} : Cmp}) -> Empty:
  %e : logic__truth(Cmp.is_lt(_))
  Unit{}

def logic__cmp_lt_gt(e: {LT{} == GT{} : Cmp}) -> Empty:
  %e : logic__truth(Cmp.is_lt(_))
  Unit{}

def logic__cmp_eq_gt(e: {EQ{} == GT{} : Cmp}) -> Empty:
  %e : logic__truth(Cmp.is_eq(_))
  Unit{}

# Maybe discrimination.
def logic__none_some(-A: Data, x: A, e: {None{} == Some{x} : Maybe<&2, A>}) -> Empty:
  %Equal.sym(Maybe<&2, A>, None{}, Some{x}, e) : logic__truth(Maybe.is_some(&2, A, _))
  Unit{}

def logic__some_value(-A: Data, m: Maybe<&2, A>, d: A) -> A:
  match m:
    case None{}:
      d
    case Some{x}:
      x

def logic__some_inj(-A: Data, x: A, y: A, e: {Some{x} == Some{y} : Maybe<&2, A>}) -> {x == y : A}:
  Equal.cong(Maybe<&2, A>, A, m => logic__some_value(A, m, x), Some{x}, Some{y}, e)

def logic__pair_fst(-A: Type, -B: Type, a: A, b: B, c: A, d: B, e: {(a, b) == (c, d) : A & B}) -> {a == c : A}:
  Equal.cong(A & B, A, p => Pair.fst(A, B, p), (a, b), (c, d), e)

def logic__pair_snd(-A: Type, -B: Type, a: A, b: B, c: A, d: B, e: {(a, b) == (c, d) : A & B}) -> {b == d : B}:
  Equal.cong(A & B, B, p => Pair.snd(A, B, p), (a, b), (c, d), e)

def logic__pair_eq(-A: Type, -B: Type, a: A, b: B, c: A, d: B, ea: {a == c : A}, eb: {b == d : B}) -> {(a, b) == (c, d) : A & B}:
  %ea : {(a, b) == (_, d) : A & B}
  %eb : {(a, b) == (a, _) : A & B}
  {==}

# Transport a proof along an equation.
def logic__subst(-A: Type, -P: A -> Type, -a: A, -b: A, e: {a == b : A}, pa: P(a)) -> P(b):
  %e : P(_)
  pa

# Dependent pair projections (call results cannot be destructured directly).
def logic__sfst(-A: Type, -B: @-x: A -> Type, p: Sigma<&1, &1, A, B>) -> A:
  match p:
    case Tuple{a, b}:
      a

def logic__ssnd(-A: Type, -B: @-x: A -> Type, p: Sigma<&1, &1, A, B>) -> B(logic__sfst(A, B, p)):
  match p:
    case Tuple{a, b}:
      b

def logic__pair_eta(-A: Type, -B: Type, p: A & B) -> {p == (Pair.fst(A, B, p), Pair.snd(A, B, p)) : A & B}:
  match p:
    case Tuple{a, b}:
      {==}


# ==== reference/lru/proofs/nat_algebra.bend ====

# Commutative-semiring laws of Base Nat.add/Nat.mul, by induction on the actual
# definitions. Used by the host decimal/word conversion proofs.
def lru_nat_algebra__succ_equal(a: Nat, b: Nat, e: {a == b : Nat}) -> {1n+a == 1n+b : Nat}:
  Equal.cong(Nat, Nat, x => 1n+x, a, b, e)

def lru_nat_algebra__add_zero(n: Nat) -> {Nat.add(n, 0n) == n : Nat}:
  match n:
    case 0n: {==}
    case 1n++p: lru_nat_algebra__succ_equal(Nat.add(p, 0n), p, lru_nat_algebra__add_zero(p))

def lru_nat_algebra__add_succ(a: Nat, +b: Nat) -> {Nat.add(a, 1n+b) == 1n+Nat.add(a, b) : Nat}:
  match a:
    case 0n: {==}
    case 1n++p: lru_nat_algebra__succ_equal(Nat.add(p, 1n+b), 1n+Nat.add(p, b), lru_nat_algebra__add_succ(p, b))

def lru_nat_algebra__add_comm(a: Nat, +b: Nat) -> {Nat.add(a, b) == Nat.add(b, a) : Nat}:
  match a:
    case 0n: Equal.sym(Nat, Nat.add(b, 0n), b, lru_nat_algebra__add_zero(b))
    case 1n++p: Equal.trans(Nat, 1n+Nat.add(p, b), 1n+Nat.add(b, p), Nat.add(b, 1n+p), lru_nat_algebra__succ_equal(Nat.add(p, b), Nat.add(b, p), lru_nat_algebra__add_comm(p, b)), Equal.sym(Nat, Nat.add(b, 1n+p), 1n+Nat.add(b, p), lru_nat_algebra__add_succ(b, p)))

def lru_nat_algebra__add_assoc(a: Nat, +b: Nat, +c: Nat) -> {Nat.add(Nat.add(a, b), c) == Nat.add(a, Nat.add(b, c)) : Nat}:
  match a:
    case 0n: {==}
    case 1n++p: lru_nat_algebra__succ_equal(Nat.add(Nat.add(p, b), c), Nat.add(p, Nat.add(b, c)), lru_nat_algebra__add_assoc(p, b, c))

# a + (b + c) == b + (a + c)
def lru_nat_algebra__add_swap(+a: Nat, +b: Nat, +c: Nat) -> {Nat.add(a, Nat.add(b, c)) == Nat.add(b, Nat.add(a, c)) : Nat}:
  Equal.trans(Nat, Nat.add(a, Nat.add(b, c)), Nat.add(Nat.add(a, b), c), Nat.add(b, Nat.add(a, c)),
    Equal.sym(Nat, Nat.add(Nat.add(a, b), c), Nat.add(a, Nat.add(b, c)), lru_nat_algebra__add_assoc(a, b, c)),
    Equal.trans(Nat, Nat.add(Nat.add(a, b), c), Nat.add(Nat.add(b, a), c), Nat.add(b, Nat.add(a, c)),
      Equal.cong(Nat, Nat, x => Nat.add(x, c), Nat.add(a, b), Nat.add(b, a), lru_nat_algebra__add_comm(a, b)),
      lru_nat_algebra__add_assoc(b, a, c)))

def lru_nat_algebra__mul_zero(n: Nat) -> {Nat.mul(n, 0n) == 0n : Nat}:
  match n:
    case 0n: {==}
    case 1n++p: lru_nat_algebra__mul_zero(p)

def lru_nat_algebra__mul_succ(a: Nat, +b: Nat) -> {Nat.mul(a, 1n+b) == Nat.add(a, Nat.mul(a, b)) : Nat}:
  match a:
    case 0n: {==}
    case 1n++p:
      %Equal.sym(Nat, Nat.mul(p, 1n+b), Nat.add(p, Nat.mul(p, b)), lru_nat_algebra__mul_succ(p, b)) : {1n+Nat.add(b, _) == 1n+Nat.add(p, Nat.add(b, Nat.mul(p, b))) : Nat}
      lru_nat_algebra__succ_equal(Nat.add(b, Nat.add(p, Nat.mul(p, b))), Nat.add(p, Nat.add(b, Nat.mul(p, b))), lru_nat_algebra__add_swap(b, p, Nat.mul(p, b)))

def lru_nat_algebra__mul_comm(a: Nat, +b: Nat) -> {Nat.mul(a, b) == Nat.mul(b, a) : Nat}:
  match a:
    case 0n: Equal.sym(Nat, Nat.mul(b, 0n), 0n, lru_nat_algebra__mul_zero(b))
    case 1n++p:
      %Equal.sym(Nat, Nat.mul(b, 1n+p), Nat.add(b, Nat.mul(b, p)), lru_nat_algebra__mul_succ(b, p)) : {Nat.add(b, Nat.mul(p, b)) == _ : Nat}
      Equal.cong(Nat, Nat, x => Nat.add(b, x), Nat.mul(p, b), Nat.mul(b, p), lru_nat_algebra__mul_comm(p, b))

def lru_nat_algebra__double_self(n: Nat) -> {Nat.double(n) == Nat.add(n, n) : Nat}:
  match n:
    case 0n: {==}
    case 1n++p:
      %Equal.sym(Nat, Nat.double(p), Nat.add(p, p), lru_nat_algebra__double_self(p)) : {2n+_ == 1n+Nat.add(p, 1n+p) : Nat}
      lru_nat_algebra__succ_equal(1n+Nat.add(p, p), Nat.add(p, 1n+p), Equal.sym(Nat, Nat.add(p, 1n+p), 1n+Nat.add(p, p), lru_nat_algebra__add_succ(p, p)))

def lru_nat_algebra__double_mul(+n: Nat) -> {Nat.double(n) == Nat.mul(2n, n) : Nat}:
  %Equal.sym(Nat, Nat.double(n), Nat.add(n, n), lru_nat_algebra__double_self(n)) : {_ == Nat.add(n, Nat.add(n, 0n)) : Nat}
  Equal.cong(Nat, Nat, x => Nat.add(n, x), n, Nat.add(n, 0n), Equal.sym(Nat, Nat.add(n, 0n), n, lru_nat_algebra__add_zero(n)))


# ==== reference/lru/spec/numeric.bend ====

# Independent mathematical interpretation. Nat here is a specification value;
# no public executable conversion of a 64-bit number through Nat is required.
def spec_numeric__bit_value(b: Bool) -> Nat:
  match b:
    case False{}:
      0n
    case True{}:
      1n

def spec_numeric__unsigned(n: Nat, w: Word(n)) -> Nat:
  match n:
    case 0n:
      0n
    case 1n+p:
      match w:
        case WCon{b, tail}:
          Nat.add(spec_numeric__bit_value(b), Nat.double(spec_numeric__unsigned(p, tail)))

# These mathematical definitions specify modulo arithmetic through Nat values,
# independently of the implementation's ripple addition and binary long division.
def spec_numeric__from_nat(n: Nat, +value: Nat) -> Word(n):
  match n:
    case 0n:
      WNil{}
    case 1n+p:
      WCon{Nat.is_eq(Nat.mod(value, 2n), 1n), spec_numeric__from_nat(p, Nat.div(value, 2n))}

# Mathematical multiplication by 2^places, specified without machine shifts.
def spec_numeric__scale_binary(places: Nat, value: Nat) -> Nat:
  match places:
    case 0n:
      value
    case 1n+p:
      Nat.double(spec_numeric__scale_binary(p, value))


# ==== spec/common.bend ====

# 2^k as a natural number.
def spec_common__pow2(k: Nat) -> Nat:
  match k:
    case 0n:
      1n
    case 1n+p:
      Nat.double(spec_common__pow2(p))

def spec_common__length(-A: Data, xs: List<&2, A>) -> Nat:
  match xs:
    case Nil{}:
      0n
    case Con{h, t}:
      1n+spec_common__length(A, t)

# Element i, if any.
def spec_common__nth(-A: Data, xs: List<&2, A>, i: Nat) -> Maybe<&2, A>:
  match xs i:
    case Nil{} _:
      None{}
    case Con{h, t} 0n:
      Some{h}
    case Con{h, t} 1n+p:
      spec_common__nth(A, t, p)

# Replace element i (no change when i is out of range).
def spec_common__update(-A: Data, xs: List<&2, A>, i: Nat, x: A) -> List<&2, A>:
  match xs i:
    case Nil{} _:
      Nil{}
    case Con{h, t} 0n:
      Con{x, t}
    case Con{h, t} 1n+p:
      Con{h, spec_common__update(A, t, p, x)}

def spec_common__snoc(-A: Data, xs: List<&2, A>, x: A) -> List<&2, A>:
  match xs:
    case Nil{}:
      Con{x, Nil{}}
    case Con{h, t}:
      Con{h, spec_common__snoc(A, t, x)}

def spec_common__last(-A: Data, xs: List<&2, A>) -> Maybe<&2, A>:
  match xs:
    case Nil{}:
      None{}
    case Con{h, t}:
      match t:
        case Nil{}:
          Some{h}
        case Con{h2, t2}:
          spec_common__last(A, Con{h2, t2})

def spec_common__init(-A: Data, xs: List<&2, A>) -> List<&2, A>:
  match xs:
    case Nil{}:
      Nil{}
    case Con{h, t}:
      match t:
        case Nil{}:
          Nil{}
        case Con{h2, t2}:
          Con{h, spec_common__init(A, Con{h2, t2})}

def spec_common__head(-A: Data, xs: List<&2, A>) -> Maybe<&2, A>:
  match xs:
    case Nil{}:
      None{}
    case Con{h, t}:
      Some{h}

def spec_common__tail(-A: Data, xs: List<&2, A>) -> List<&2, A>:
  match xs:
    case Nil{}:
      Nil{}
    case Con{h, t}:
      t

def spec_common__append(-A: Data, xs: List<&2, A>, ys: List<&2, A>) -> List<&2, A>:
  match xs:
    case Nil{}:
      ys
    case Con{h, t}:
      Con{h, spec_common__append(A, t, ys)}

def spec_common__reverse(-A: Data, xs: List<&2, A>) -> List<&2, A>:
  match xs:
    case Nil{}:
      Nil{}
    case Con{h, t}:
      spec_common__snoc(A, spec_common__reverse(A, t), h)

def spec_common__replicate(-A: Data, n: Nat, +x: A) -> List<&2, A>:
  match n:
    case 0n:
      Nil{}
    case 1n+p:
      Con{x, spec_common__replicate(A, p, x)}

def spec_common__take(-A: Data, xs: List<&2, A>, n: Nat) -> List<&2, A>:
  match xs n:
    case Nil{} _:
      Nil{}
    case Con{h, t} 0n:
      Nil{}
    case Con{h, t} 1n+p:
      Con{h, spec_common__take(A, t, p)}

def spec_common__drop(-A: Data, xs: List<&2, A>, n: Nat) -> List<&2, A>:
  match xs n:
    case Nil{} _:
      Nil{}
    case Con{h, t} 0n:
      Con{h, t}
    case Con{h, t} 1n+p:
      spec_common__drop(A, t, p)


# ==== proofs/lib/nat.bend ====

def nat__pred(n: Nat) -> Nat:
  match n:
    case 0n:
      0n
    case 1n+p:
      p

def nat__succ_inj(+a: Nat, +b: Nat, e: {1n+a == 1n+b : Nat}) -> {a == b : Nat}:
  Equal.cong(Nat, Nat, nat__pred, 1n+a, 1n+b, e)

def nat__succ_cong(+a: Nat, +b: Nat, e: {a == b : Nat}) -> {1n+a == 1n+b : Nat}:
  Equal.cong(Nat, Nat, x => 1n+x, a, b, e)

def nat__is_zero(n: Nat) -> Bool:
  match n:
    case 0n:
      True{}
    case 1n+p:
      False{}

def nat__zero_succ(+n: Nat, e: {0n == 1n+n : Nat}) -> Empty:
  %e : logic__truth(nat__is_zero(_))
  Unit{}

def nat__succ_zero(+n: Nat, e: {1n+n == 0n : Nat}) -> Empty:
  nat__zero_succ(n, Equal.sym(Nat, 1n+n, 0n, e))

def nat__add_zero(+n: Nat) -> {Nat.add(n, 0n) == n : Nat}:
  lru_nat_algebra__add_zero(n)

def nat__add_succ(+a: Nat, +b: Nat) -> {Nat.add(a, 1n+b) == 1n+Nat.add(a, b) : Nat}:
  lru_nat_algebra__add_succ(a, b)

def nat__add_comm(+a: Nat, +b: Nat) -> {Nat.add(a, b) == Nat.add(b, a) : Nat}:
  lru_nat_algebra__add_comm(a, b)

def nat__add_assoc(+a: Nat, +b: Nat, +c: Nat) -> {Nat.add(Nat.add(a, b), c) == Nat.add(a, Nat.add(b, c)) : Nat}:
  lru_nat_algebra__add_assoc(a, b, c)

# ---- order ----
def nat__lt_irrefl(+n: Nat) -> {Nat.is_lt(n, n) == False{} : Bool}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      nat__lt_irrefl(p)

def nat__le_refl(+n: Nat) -> {Nat.is_le(n, n) == True{} : Bool}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      nat__le_refl(p)

def nat__lt_succ(+n: Nat) -> {Nat.is_lt(n, 1n+n) == True{} : Bool}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      nat__lt_succ(p)

def nat__le_succ(+n: Nat) -> {Nat.is_le(n, 1n+n) == True{} : Bool}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      nat__le_succ(p)

def nat__zero_le(+n: Nat) -> {Nat.is_le(0n, n) == True{} : Bool}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      {==}

def nat__not_lt_zero(+n: Nat) -> {Nat.is_lt(n, 0n) == False{} : Bool}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      {==}

def nat__lt_zero_absurd(+n: Nat, e: {Nat.is_lt(n, 0n) == True{} : Bool}) -> Empty:
  logic__false_true(Equal.trans(Bool, False{}, Nat.is_lt(n, 0n), True{}, Equal.sym(Bool, Nat.is_lt(n, 0n), False{}, nat__not_lt_zero(n)), e))

def nat__lt_le(+a: Nat, +b: Nat, e: {Nat.is_lt(a, b) == True{} : Bool}) -> {Nat.is_le(a, b) == True{} : Bool}:
  match a b:
    case 0n 0n:
      {==}
    case 0n 1n+q:
      {==}
    case 1n+p 0n:
      Empty.absurd({Nat.is_le(1n+p, 0n) == True{} : Bool}, logic__false_true(e))
    case 1n+p 1n+q:
      nat__lt_le(p, q, e)

def nat__le_lt_succ(+a: Nat, +b: Nat, e: {Nat.is_le(a, b) == True{} : Bool}) -> {Nat.is_lt(a, 1n+b) == True{} : Bool}:
  match a b:
    case 0n _:
      {==}
    case 1n+p 0n:
      Empty.absurd({Nat.is_lt(1n+p, 1n) == True{} : Bool}, logic__false_true(e))
    case 1n+p 1n+q:
      nat__le_lt_succ(p, q, e)

def nat__lt_succ_le(+a: Nat, +b: Nat, e: {Nat.is_lt(a, 1n+b) == True{} : Bool}) -> {Nat.is_le(a, b) == True{} : Bool}:
  match a b:
    case 0n _:
      nat__zero_le(b)
    case 1n+p 0n:
      Empty.absurd({Nat.is_le(1n+p, 0n) == True{} : Bool}, nat__lt_zero_absurd(p, e))
    case 1n+p 1n+q:
      nat__lt_succ_le(p, q, e)

def nat__succ_le_lt(+a: Nat, +b: Nat, e: {Nat.is_le(1n+a, b) == True{} : Bool}) -> {Nat.is_lt(a, b) == True{} : Bool}:
  match a b:
    case _ 0n:
      Empty.absurd({Nat.is_lt(a, 0n) == True{} : Bool}, logic__false_true(e))
    case 0n 1n+q:
      {==}
    case 1n+p 1n+q:
      nat__succ_le_lt(p, q, e)

def nat__lt_succ_le_succ(+a: Nat, +b: Nat, e: {Nat.is_lt(a, b) == True{} : Bool}) -> {Nat.is_le(1n+a, b) == True{} : Bool}:
  match a b:
    case _ 0n:
      Empty.absurd({Nat.is_le(1n+a, 0n) == True{} : Bool}, nat__lt_zero_absurd(a, e))
    case 0n 1n+q:
      nat__zero_le(q)
    case 1n+p 1n+q:
      nat__lt_succ_le_succ(p, q, e)

def nat__le_trans(+a: Nat, +b: Nat, +c: Nat, ab: {Nat.is_le(a, b) == True{} : Bool}, bc: {Nat.is_le(b, c) == True{} : Bool}) -> {Nat.is_le(a, c) == True{} : Bool}:
  match a b c:
    case 0n _ _:
      nat__zero_le(c)
    case 1n+p 0n _:
      Empty.absurd({Nat.is_le(1n+p, c) == True{} : Bool}, logic__false_true(ab))
    case 1n+p 1n+q 0n:
      Empty.absurd({Nat.is_le(1n+p, 0n) == True{} : Bool}, logic__false_true(bc))
    case 1n+p 1n+q 1n+r:
      nat__le_trans(p, q, r, ab, bc)

def nat__lt_le_trans(+a: Nat, +b: Nat, +c: Nat, ab: {Nat.is_lt(a, b) == True{} : Bool}, bc: {Nat.is_le(b, c) == True{} : Bool}) -> {Nat.is_lt(a, c) == True{} : Bool}:
  nat__succ_le_lt(a, c, nat__le_trans(1n+a, b, c, nat__lt_succ_le_succ(a, b, ab), bc))

def nat__le_lt_trans(+a: Nat, +b: Nat, +c: Nat, ab: {Nat.is_le(a, b) == True{} : Bool}, bc: {Nat.is_lt(b, c) == True{} : Bool}) -> {Nat.is_lt(a, c) == True{} : Bool}:
  nat__succ_le_lt(a, c, nat__le_trans(1n+a, 1n+b, c, ab, nat__lt_succ_le_succ(b, c, bc)))

def nat__lt_trans(+a: Nat, +b: Nat, +c: Nat, ab: {Nat.is_lt(a, b) == True{} : Bool}, bc: {Nat.is_lt(b, c) == True{} : Bool}) -> {Nat.is_lt(a, c) == True{} : Bool}:
  nat__lt_le_trans(a, b, c, ab, nat__lt_le(b, c, bc))

# is_lt(a, b) == False gives b <= a.
def nat__not_lt_le(+a: Nat, +b: Nat, e: {Nat.is_lt(a, b) == False{} : Bool}) -> {Nat.is_le(b, a) == True{} : Bool}:
  match a b:
    case _ 0n:
      nat__zero_le(a)
    case 0n 1n+q:
      Empty.absurd({Nat.is_le(1n+q, 0n) == True{} : Bool}, logic__true_false(e))
    case 1n+p 1n+q:
      nat__not_lt_le(p, q, e)

def nat__le_not_lt(+a: Nat, +b: Nat, e: {Nat.is_le(b, a) == True{} : Bool}) -> {Nat.is_lt(a, b) == False{} : Bool}:
  match a b:
    case _ 0n:
      nat__not_lt_zero(a)
    case 0n 1n+q:
      Empty.absurd({Nat.is_lt(0n, 1n+q) == False{} : Bool}, logic__false_true(e))
    case 1n+p 1n+q:
      nat__le_not_lt(p, q, e)

def nat__lt_not_le(+a: Nat, +b: Nat, e: {Nat.is_lt(a, b) == True{} : Bool}) -> {Nat.is_le(b, a) == False{} : Bool}:
  match a b:
    case _ 0n:
      Empty.absurd({Nat.is_le(0n, a) == False{} : Bool}, nat__lt_zero_absurd(a, e))
    case 0n 1n+q:
      {==}
    case 1n+p 1n+q:
      nat__lt_not_le(p, q, e)

def nat__not_le_lt(+a: Nat, +b: Nat, e: {Nat.is_le(a, b) == False{} : Bool}) -> {Nat.is_lt(b, a) == True{} : Bool}:
  match a b:
    case 0n 0n:
      Empty.absurd({Nat.is_lt(0n, 0n) == True{} : Bool}, logic__true_false(e))
    case 0n 1n+q:
      Empty.absurd({Nat.is_lt(1n+q, 0n) == True{} : Bool}, logic__true_false(e))
    case 1n+p 0n:
      {==}
    case 1n+p 1n+q:
      nat__not_le_lt(p, q, e)

def nat__lt_asym(+a: Nat, +b: Nat, ab: {Nat.is_lt(a, b) == True{} : Bool}, ba: {Nat.is_lt(b, a) == True{} : Bool}) -> Empty:
  logic__true_not_false(Nat.is_lt(a, a), nat__lt_trans(a, b, a, ab, ba), nat__lt_irrefl(a))

def nat__le_antisym(+a: Nat, +b: Nat, ab: {Nat.is_le(a, b) == True{} : Bool}, ba: {Nat.is_le(b, a) == True{} : Bool}) -> {a == b : Nat}:
  match a b:
    case 0n 0n:
      {==}
    case 0n 1n+q:
      Empty.absurd({0n == 1n+q : Nat}, logic__false_true(ba))
    case 1n+p 0n:
      Empty.absurd({1n+p == 0n : Nat}, logic__false_true(ab))
    case 1n+p 1n+q:
      nat__succ_cong(p, q, nat__le_antisym(p, q, ab, ba))

def nat__eq_le(+a: Nat, +b: Nat, e: {a == b : Nat}) -> {Nat.is_le(a, b) == True{} : Bool}:
  %e : {Nat.is_le(a, _) == True{} : Bool}
  nat__le_refl(a)

def nat__lt_ne(+a: Nat, +b: Nat, lt: {Nat.is_lt(a, b) == True{} : Bool}, e: {a == b : Nat}) -> Empty:
  logic__true_not_false(Nat.is_lt(a, a), Equal.trans(Bool, Nat.is_lt(a, a), Nat.is_lt(a, b), True{}, Equal.cong(Nat, Bool, x => Nat.is_lt(a, x), a, b, e), lt), nat__lt_irrefl(a))

def nat__eq_from_is_eq(+a: Nat, +b: Nat, e: {Nat.is_eq(a, b) == True{} : Bool}) -> {a == b : Nat}:
  match a b:
    case 0n 0n:
      {==}
    case 0n 1n+q:
      Empty.absurd({0n == 1n+q : Nat}, logic__false_true(e))
    case 1n+p 0n:
      Empty.absurd({1n+p == 0n : Nat}, logic__false_true(e))
    case 1n+p 1n+q:
      nat__succ_cong(p, q, nat__eq_from_is_eq(p, q, e))

def nat__is_eq_refl(+a: Nat) -> {Nat.is_eq(a, a) == True{} : Bool}:
  match a:
    case 0n:
      {==}
    case 1n+p:
      nat__is_eq_refl(p)

def nat__is_eq_lt(+a: Nat, +b: Nat, e: {Nat.is_lt(a, b) == True{} : Bool}) -> {Nat.is_eq(a, b) == False{} : Bool}:
  match a b:
    case _ 0n:
      Empty.absurd({Nat.is_eq(a, 0n) == False{} : Bool}, nat__lt_zero_absurd(a, e))
    case 0n 1n+q:
      {==}
    case 1n+p 1n+q:
      nat__is_eq_lt(p, q, e)

def nat__lt_or_eq(+a: Nat, +b: Nat, e: {Nat.is_le(a, b) == True{} : Bool}, ne: {Nat.is_eq(a, b) == False{} : Bool}) -> {Nat.is_lt(a, b) == True{} : Bool}:
  match a b:
    case 0n 0n:
      Empty.absurd({Nat.is_lt(0n, 0n) == True{} : Bool}, logic__true_false(ne))
    case 0n 1n+q:
      {==}
    case 1n+p 0n:
      Empty.absurd({Nat.is_lt(1n+p, 0n) == True{} : Bool}, logic__false_true(e))
    case 1n+p 1n+q:
      nat__lt_or_eq(p, q, e, ne)

# ---- addition and subtraction ----
def nat__add_sub_cancel(+a: Nat, +b: Nat) -> {Nat.sub(Nat.add(a, b), a) == b : Nat}:
  match a b:
    case 0n 0n:
      {==}
    case 0n 1n+q:
      {==}
    case 1n+p _:
      nat__add_sub_cancel(p, b)

def nat__sub_add(+a: Nat, +b: Nat, e: {Nat.is_le(b, a) == True{} : Bool}) -> {Nat.add(b, Nat.sub(a, b)) == a : Nat}:
  match a b:
    case 0n 0n:
      {==}
    case 1n+p 0n:
      {==}
    case 0n 1n+q:
      Empty.absurd({Nat.add(1n+q, Nat.sub(0n, 1n+q)) == 0n : Nat}, logic__false_true(e))
    case 1n+p 1n+q:
      nat__succ_cong(Nat.add(q, Nat.sub(p, q)), p, nat__sub_add(p, q, e))

def nat__sub_zero(+n: Nat) -> {Nat.sub(n, 0n) == n : Nat}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      {==}

def nat__sub_self(+n: Nat) -> {Nat.sub(n, n) == 0n : Nat}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      nat__sub_self(p)

def nat__sub_succ_left(+a: Nat, +b: Nat, e: {Nat.is_le(b, a) == True{} : Bool}) -> {Nat.sub(1n+a, b) == 1n+Nat.sub(a, b) : Nat}:
  match a b:
    case _ 0n:
      %Equal.sym(Nat, Nat.sub(a, 0n), a, nat__sub_zero(a)) : {1n+a == 1n+_ : Nat}
      {==}
    case 0n 1n+q:
      Empty.absurd({Nat.sub(1n, 1n+q) == 1n+Nat.sub(0n, 1n+q) : Nat}, logic__false_true(e))
    case 1n+p 1n+q:
      nat__sub_succ_left(p, q, e)

def nat__sub_lt(+a: Nat, +b: Nat, +c: Nat, le: {Nat.is_le(b, a) == True{} : Bool}, lt: {Nat.is_lt(a, Nat.add(b, c)) == True{} : Bool}) -> {Nat.is_lt(Nat.sub(a, b), c) == True{} : Bool}:
  match a b:
    case _ 0n:
      %Equal.sym(Nat, Nat.sub(a, 0n), a, nat__sub_zero(a)) : {Nat.is_lt(_, c) == True{} : Bool}
      lt
    case 0n 1n+q:
      Empty.absurd({Nat.is_lt(Nat.sub(0n, 1n+q), c) == True{} : Bool}, logic__false_true(le))
    case 1n+p 1n+q:
      nat__sub_lt(p, q, c, le, lt)

def nat__le_add_right(+a: Nat, +b: Nat) -> {Nat.is_le(a, Nat.add(a, b)) == True{} : Bool}:
  match a:
    case 0n:
      nat__zero_le(b)
    case 1n+p:
      nat__le_add_right(p, b)

def nat__lt_add_left(+a: Nat, +b: Nat, +c: Nat, e: {Nat.is_lt(a, b) == True{} : Bool}) -> {Nat.is_lt(Nat.add(c, a), Nat.add(c, b)) == True{} : Bool}:
  match c:
    case 0n:
      e
    case 1n+r:
      nat__lt_add_left(a, b, r, e)

def nat__le_add_left(+a: Nat, +b: Nat, +c: Nat, e: {Nat.is_le(a, b) == True{} : Bool}) -> {Nat.is_le(Nat.add(c, a), Nat.add(c, b)) == True{} : Bool}:
  match c:
    case 0n:
      e
    case 1n+r:
      nat__le_add_left(a, b, r, e)

# ---- doubling and powers of two (spec/common.bend pow2) ----
def nat__double_inj(+a: Nat, +b: Nat, e: {Nat.double(a) == Nat.double(b) : Nat}) -> {a == b : Nat}:
  match a b:
    case 0n 0n:
      {==}
    case 0n 1n+q:
      Empty.absurd({0n == 1n+q : Nat}, nat__zero_succ(1n+Nat.double(q), e))
    case 1n+p 0n:
      Empty.absurd({1n+p == 0n : Nat}, nat__succ_zero(1n+Nat.double(p), e))
    case 1n+p 1n+q:
      nat__succ_cong(p, q, nat__double_inj(p, q, nat__succ_inj(Nat.double(p), Nat.double(q), nat__succ_inj(1n+Nat.double(p), 1n+Nat.double(q), e))))

def nat__even_odd(+a: Nat, +b: Nat, e: {Nat.double(a) == 1n+Nat.double(b) : Nat}) -> Empty:
  match a b:
    case 0n _:
      nat__zero_succ(Nat.double(b), e)
    case 1n+p 0n:
      nat__succ_zero(Nat.double(p), nat__succ_inj(1n+Nat.double(p), 0n, e))
    case 1n+p 1n+q:
      nat__even_odd(p, q, nat__succ_inj(Nat.double(p), 1n+Nat.double(q), nat__succ_inj(1n+Nat.double(p), 2n+Nat.double(q), e)))

# bit + 2u == bit' + 2v determines both parts.
def nat__bit_split_bit(+b: Bool, +c: Bool, +u: Nat, +v: Nat, e: {Nat.add(spec_numeric__bit_value(b), Nat.double(u)) == Nat.add(spec_numeric__bit_value(c), Nat.double(v)) : Nat}) -> {b == c : Bool}:
  match b c:
    case False{} False{}:
      {==}
    case True{} True{}:
      {==}
    case False{} True{}:
      Empty.absurd({False{} == True{} : Bool}, nat__even_odd(u, v, e))
    case True{} False{}:
      Empty.absurd({True{} == False{} : Bool}, nat__even_odd(v, u, Equal.sym(Nat, 1n+Nat.double(u), Nat.double(v), e)))

def nat__bit_split_val(+b: Bool, +c: Bool, +u: Nat, +v: Nat, e: {Nat.add(spec_numeric__bit_value(b), Nat.double(u)) == Nat.add(spec_numeric__bit_value(c), Nat.double(v)) : Nat}) -> {u == v : Nat}:
  match b c:
    case False{} False{}:
      nat__double_inj(u, v, e)
    case True{} True{}:
      nat__double_inj(u, v, nat__succ_inj(Nat.double(u), Nat.double(v), e))
    case False{} True{}:
      Empty.absurd({u == v : Nat}, nat__even_odd(u, v, e))
    case True{} False{}:
      Empty.absurd({u == v : Nat}, nat__even_odd(v, u, Equal.sym(Nat, 1n+Nat.double(u), Nat.double(v), e)))

def nat__double_lt(+a: Nat, +b: Nat, e: {Nat.is_lt(a, b) == True{} : Bool}) -> {Nat.is_lt(Nat.double(a), Nat.double(b)) == True{} : Bool}:
  match a b:
    case _ 0n:
      Empty.absurd({Nat.is_lt(Nat.double(a), 0n) == True{} : Bool}, nat__lt_zero_absurd(a, e))
    case 0n 1n+q:
      {==}
    case 1n+p 1n+q:
      nat__double_lt(p, q, e)

def nat__double_le(+a: Nat, +b: Nat, e: {Nat.is_le(a, b) == True{} : Bool}) -> {Nat.is_le(Nat.double(a), Nat.double(b)) == True{} : Bool}:
  match a b:
    case 0n _:
      nat__zero_le(Nat.double(b))
    case 1n+p 0n:
      Empty.absurd({Nat.is_le(Nat.double(1n+p), 0n) == True{} : Bool}, logic__false_true(e))
    case 1n+p 1n+q:
      nat__double_le(p, q, e)

# bit + 2u < 2v gives u < v.
def nat__bit_double_lt(+b: Bool, +u: Nat, +v: Nat, e: {Nat.is_lt(Nat.add(spec_numeric__bit_value(b), Nat.double(u)), Nat.double(v)) == True{} : Bool}) -> {Nat.is_lt(u, v) == True{} : Bool}:
  match b u v:
    case _ _ 0n:
      Empty.absurd({Nat.is_lt(u, 0n) == True{} : Bool}, nat__lt_zero_absurd(Nat.add(spec_numeric__bit_value(b), Nat.double(u)), e))
    case _ 0n 1n+q:
      {==}
    case False{} 1n+p 1n+q:
      nat__bit_double_lt(False{}, p, q, e)
    case True{} 1n+p 1n+q:
      nat__bit_double_lt(True{}, p, q, e)

def nat__double_lt_bit(+b: Bool, +u: Nat, +v: Nat, e: {Nat.is_lt(u, v) == True{} : Bool}) -> {Nat.is_lt(Nat.add(spec_numeric__bit_value(b), Nat.double(u)), Nat.double(v)) == True{} : Bool}:
  match b u v:
    case _ _ 0n:
      Empty.absurd({Nat.is_lt(Nat.add(spec_numeric__bit_value(b), Nat.double(u)), 0n) == True{} : Bool}, nat__lt_zero_absurd(u, e))
    case False{} 0n 1n+q:
      {==}
    case True{} 0n 1n+q:
      {==}
    case False{} 1n+p 1n+q:
      nat__double_lt_bit(False{}, p, q, e)
    case True{} 1n+p 1n+q:
      nat__double_lt_bit(True{}, p, q, e)

def nat__double_self_le(+n: Nat) -> {Nat.is_le(n, Nat.double(n)) == True{} : Bool}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      nat__le_trans(p, Nat.double(p), 1n+Nat.double(p), nat__double_self_le(p), nat__le_succ(Nat.double(p)))

def nat__double_succ_le(+n: Nat, e: {Nat.is_le(1n, n) == True{} : Bool}) -> {Nat.is_le(1n+n, Nat.double(n)) == True{} : Bool}:
  match n:
    case 0n:
      Empty.absurd({Nat.is_le(1n, 0n) == True{} : Bool}, logic__false_true(e))
    case 1n+p:
      nat__double_self_le(p)

def nat__pow2_pos(+k: Nat) -> {Nat.is_le(1n, spec_common__pow2(k)) == True{} : Bool}:
  match k:
    case 0n:
      {==}
    case 1n+p:
      nat__le_trans(1n, spec_common__pow2(p), Nat.double(spec_common__pow2(p)), nat__pow2_pos(p), nat__double_self_le(spec_common__pow2(p)))

def nat__pow2_lt_succ(+k: Nat) -> {Nat.is_lt(spec_common__pow2(k), spec_common__pow2(1n+k)) == True{} : Bool}:
  nat__succ_le_lt(spec_common__pow2(k), Nat.double(spec_common__pow2(k)), nat__double_succ_le(spec_common__pow2(k), nat__pow2_pos(k)))

# 1 <= n gives 1 + n <= 2n.
def nat__pow2_mono(+a: Nat, +b: Nat, e: {Nat.is_le(a, b) == True{} : Bool}) -> {Nat.is_le(spec_common__pow2(a), spec_common__pow2(b)) == True{} : Bool}:
  match a b:
    case 0n _:
      nat__pow2_pos(b)
    case 1n+p 0n:
      Empty.absurd({Nat.is_le(spec_common__pow2(1n+p), 1n) == True{} : Bool}, logic__false_true(e))
    case 1n+p 1n+q:
      nat__double_le(spec_common__pow2(p), spec_common__pow2(q), nat__pow2_mono(p, q, e))

def nat__pow2_strict(+a: Nat, +b: Nat, e: {Nat.is_lt(a, b) == True{} : Bool}) -> {Nat.is_lt(spec_common__pow2(a), spec_common__pow2(b)) == True{} : Bool}:
  match b:
    case 0n:
      Empty.absurd({Nat.is_lt(spec_common__pow2(a), 1n) == True{} : Bool}, nat__lt_zero_absurd(a, e))
    case 1n+q:
      nat__lt_le_trans(spec_common__pow2(a), spec_common__pow2(1n+a), spec_common__pow2(1n+q), nat__pow2_lt_succ(a), nat__pow2_mono(1n+a, 1n+q, nat__lt_succ_le_succ(a, 1n+q, e)))

# pred(2v) == 1 + 2 pred(v) for v >= 1.
def nat__pred_double(+v: Nat, e: {Nat.is_le(1n, v) == True{} : Bool}) -> {Nat.sub(Nat.double(v), 1n) == 1n+Nat.double(Nat.sub(v, 1n)) : Nat}:
  match v:
    case 0n:
      Empty.absurd({Nat.sub(0n, 1n) == 1n+Nat.double(Nat.sub(0n, 1n)) : Nat}, logic__false_true(e))
    case 1n+p:
      %Equal.sym(Nat, Nat.sub(p, 0n), p, nat__sub_zero(p)) : {1n+Nat.double(p) == 1n+Nat.double(_) : Nat}
      {==}

def nat__add_double(+a: Nat, +b: Nat) -> {Nat.add(Nat.double(a), Nat.double(b)) == Nat.double(Nat.add(a, b)) : Nat}:
  match a:
    case 0n:
      {==}
    case 1n+p:
      nat__succ_cong(1n+Nat.add(Nat.double(p), Nat.double(b)), 1n+Nat.double(Nat.add(p, b)), nat__succ_cong(Nat.add(Nat.double(p), Nat.double(b)), Nat.double(Nat.add(p, b)), nat__add_double(p, b)))

# ---- halving ----
#
# `Nat.div(n, 2n)` is what the flat-array walks use to step from a block's
# half size to the next one (the C references use `h >> 1`). Both facts below
# come from Base's own `Nat.divmod.go`, which recurses structurally on the
# dividend, so two unfoldings of `Nat.add(2n, i)` are a definitional step.
def nat__bump2(p: Nat & Nat) -> Nat & Nat:
  (q, r) = p
  (1n+q, r)

def nat__acc2(i: Nat, m: Nat, +d: Nat, +r: Nat) -> {Nat.divmod.go(i, m, 1n+d, r) == nat__bump2(Nat.divmod.go(i, m, d, r)) : Nat & Nat}:
  match i m:
    case 0n _:
      {==}
    case 1n+np 0n:
      nat__acc2(np, r, 1n+d, 0n)
    case 1n+np 1n+mp:
      nat__acc2(np, mp, d, 1n+r)

def nat__peel2(+i: Nat, +d: Nat) -> {Nat.divmod.go(Nat.add(2n, i), 1n, d, 0n) == Nat.divmod.go(i, 1n, 1n+d, 0n) : Nat & Nat}:
  {==}

def nat__fst_bump2(p: Nat & Nat) -> {Pair.fst(Nat, Nat, nat__bump2(p)) == 1n+Pair.fst(Nat, Nat, p) : Nat}:
  (q, r) = p
  {==}

def nat__div2_step(+i: Nat) -> {Nat.div(Nat.add(2n, i), 2n) == 1n+Nat.div(i, 2n) : Nat}:
  Equal.trans(Nat, Pair.fst(Nat, Nat, Nat.divmod.go(Nat.add(2n, i), 1n, 0n, 0n)), Pair.fst(Nat, Nat, nat__bump2(Nat.divmod.go(i, 1n, 0n, 0n))), 1n+Pair.fst(Nat, Nat, Nat.divmod.go(i, 1n, 0n, 0n)),
    Equal.cong(Nat & Nat, Nat, qr => Pair.fst(Nat, Nat, qr), Nat.divmod.go(Nat.add(2n, i), 1n, 0n, 0n), nat__bump2(Nat.divmod.go(i, 1n, 0n, 0n)),
      Equal.trans(Nat & Nat, Nat.divmod.go(Nat.add(2n, i), 1n, 0n, 0n), Nat.divmod.go(i, 1n, 1n, 0n), nat__bump2(Nat.divmod.go(i, 1n, 0n, 0n)),
        nat__peel2(i, 0n), nat__acc2(i, 1n, 0n, 0n))),
    nat__fst_bump2(Nat.divmod.go(i, 1n, 0n, 0n)))

def nat__double_succ(+y: Nat) -> {Nat.double(1n+y) == Nat.add(2n, Nat.double(y)) : Nat}:
  %Equal.sym(Nat, Nat.double(y), Nat.add(y, y), lru_nat_algebra__double_self(y)) : {Nat.double(1n+y) == Nat.add(2n, _) : Nat}
  %Equal.sym(Nat, Nat.double(1n+y), Nat.add(1n+y, 1n+y), lru_nat_algebra__double_self(1n+y)) : {_ == Nat.add(2n, Nat.add(y, y)) : Nat}
  nat__succ_cong(Nat.add(y, 1n+y), 1n+Nat.add(y, y), nat__add_succ(y, y))

def nat__div2_double(x: Nat) -> {Nat.div(Nat.double(x), 2n) == x : Nat}:
  match x:
    case 0n:
      {==}
    case 1n+ +y:
      %nat__double_succ(y) : {Nat.div(_, 2n) == 1n+y : Nat}
      %Equal.sym(Nat, Nat.div(Nat.add(2n, Nat.double(y)), 2n), 1n+Nat.div(Nat.double(y), 2n), nat__div2_step(Nat.double(y))) : {_ == 1n+y : Nat}
      nat__succ_cong(Nat.div(Nat.double(y), 2n), y, nat__div2_double(y))

# 2^(1+r) / 2 = 2^r
def nat__div2_pow2(+r: Nat) -> {Nat.div(spec_common__pow2(1n+r), 2n) == spec_common__pow2(r) : Nat}:
  nat__div2_double(spec_common__pow2(r))


# ==== proofs/lib/list.bend ====

def list__cons_cong(-A: Data, +h: A, +xs: List<&2, A>, +ys: List<&2, A>, +e: {xs == ys : List<&2, A>}) -> {Con{h, xs} == Con{h, ys} : List<&2, A>}:
  Equal.cong(List<&2, A>, List<&2, A>, zs => Con{h, zs}, xs, ys, e)

def list__append_nil(-A: Data, +xs: List<&2, A>) -> {spec_common__append(A, xs, Nil{}) == xs : List<&2, A>}:
  match xs:
    case Nil{}:
      {==}
    case Con{+h, +t}:
      list__cons_cong(A, h, spec_common__append(A, t, Nil{}), t, list__append_nil(A, t))

def list__append_assoc(-A: Data, +xs: List<&2, A>, +ys: List<&2, A>, +zs: List<&2, A>) -> {spec_common__append(A, spec_common__append(A, xs, ys), zs) == spec_common__append(A, xs, spec_common__append(A, ys, zs)) : List<&2, A>}:
  match xs:
    case Nil{}:
      {==}
    case Con{+h, +t}:
      list__cons_cong(A, h, spec_common__append(A, spec_common__append(A, t, ys), zs), spec_common__append(A, t, spec_common__append(A, ys, zs)), list__append_assoc(A, t, ys, zs))

def list__length_append(-A: Data, +xs: List<&2, A>, +ys: List<&2, A>) -> {spec_common__length(A, spec_common__append(A, xs, ys)) == Nat.add(spec_common__length(A, xs), spec_common__length(A, ys)) : Nat}:
  match xs:
    case Nil{}:
      {==}
    case Con{+h, +t}:
      nat__succ_cong(spec_common__length(A, spec_common__append(A, t, ys)), Nat.add(spec_common__length(A, t), spec_common__length(A, ys)), list__length_append(A, t, ys))

def list__snoc_append(-A: Data, +xs: List<&2, A>, +x: A) -> {spec_common__snoc(A, xs, x) == spec_common__append(A, xs, Con{x, Nil{}}) : List<&2, A>}:
  match xs:
    case Nil{}:
      {==}
    case Con{+h, +t}:
      list__cons_cong(A, h, spec_common__snoc(A, t, x), spec_common__append(A, t, Con{x, Nil{}}), list__snoc_append(A, t, x))

def list__length_snoc(-A: Data, +xs: List<&2, A>, +x: A) -> {spec_common__length(A, spec_common__snoc(A, xs, x)) == 1n+spec_common__length(A, xs) : Nat}:
  match xs:
    case Nil{}:
      {==}
    case Con{+h, +t}:
      nat__succ_cong(spec_common__length(A, spec_common__snoc(A, t, x)), 1n+spec_common__length(A, t), list__length_snoc(A, t, x))

def list__length_replicate(-A: Data, +n: Nat, +x: A) -> {spec_common__length(A, spec_common__replicate(A, n, x)) == n : Nat}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      nat__succ_cong(spec_common__length(A, spec_common__replicate(A, p, x)), p, list__length_replicate(A, p, x))

def list__replicate_add(-A: Data, +m: Nat, +n: Nat, +x: A) -> {spec_common__append(A, spec_common__replicate(A, m, x), spec_common__replicate(A, n, x)) == spec_common__replicate(A, Nat.add(m, n), x) : List<&2, A>}:
  match m:
    case 0n:
      {==}
    case 1n+p:
      list__cons_cong(A, x, spec_common__append(A, spec_common__replicate(A, p, x), spec_common__replicate(A, n, x)), spec_common__replicate(A, Nat.add(p, n), x), list__replicate_add(A, p, n, x))

# ---- nth / update across append ----
def list__nth_append_left(-A: Data, +xs: List<&2, A>, +ys: List<&2, A>, +i: Nat, +h: {Nat.is_lt(i, spec_common__length(A, xs)) == True{} : Bool}) -> {spec_common__nth(A, spec_common__append(A, xs, ys), i) == spec_common__nth(A, xs, i) : Maybe<&2, A>}:
  match xs i:
    case Nil{} _:
      Empty.absurd({spec_common__nth(A, ys, i) == None{} : Maybe<&2, A>}, nat__lt_zero_absurd(i, h))
    case Con{h1, t} 0n:
      {==}
    case Con{h1, t} 1n+p:
      list__nth_append_left(A, t, ys, p, h)

def list__nth_append_right(-A: Data, +xs: List<&2, A>, +ys: List<&2, A>, +i: Nat, +h: {Nat.is_le(spec_common__length(A, xs), i) == True{} : Bool}) -> {spec_common__nth(A, spec_common__append(A, xs, ys), i) == spec_common__nth(A, ys, Nat.sub(i, spec_common__length(A, xs))) : Maybe<&2, A>}:
  match xs i:
    case Nil{} _:
      %Equal.sym(Nat, Nat.sub(i, 0n), i, nat__sub_zero(i)) : {spec_common__nth(A, ys, i) == spec_common__nth(A, ys, _) : Maybe<&2, A>}
      {==}
    case Con{h1, t} 0n:
      Empty.absurd({spec_common__nth(A, spec_common__append(A, Con{h1, t}, ys), 0n) == spec_common__nth(A, ys, Nat.sub(0n, 1n+spec_common__length(A, t))) : Maybe<&2, A>}, logic__false_true(h))
    case Con{h1, t} 1n+p:
      list__nth_append_right(A, t, ys, p, h)

def list__update_append_left(-A: Data, +xs: List<&2, A>, +ys: List<&2, A>, +i: Nat, +v: A, +h: {Nat.is_lt(i, spec_common__length(A, xs)) == True{} : Bool}) -> {spec_common__update(A, spec_common__append(A, xs, ys), i, v) == spec_common__append(A, spec_common__update(A, xs, i, v), ys) : List<&2, A>}:
  match xs i:
    case Nil{} _:
