      {==}

def list__sc_take_append_left(-A: Data, +xs: List<&2, A>, +ys: List<&2, A>, +i: Nat, +h: {Nat.is_le(i, spec_common__length(A, xs)) == True{} : Bool}) -> {spec_common__take(A, spec_common__append(A, xs, ys), i) == spec_common__take(A, xs, i) : List<&2, A>}:
