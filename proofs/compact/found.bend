def list__rev_append(-A: Data, +xs: List<&2, A>, +ys: List<&2, A>) -> {spec_common__reverse(A, spec_common__append(A, xs, ys)) == spec_common__append(A, spec_common__reverse(A, ys), spec_common__reverse(A, xs)) : List<&2, A>}:
