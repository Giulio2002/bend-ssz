# Every natural below 2^n is represented exactly by from_nat(n, v): its
# unsigned value is v. Built on the actual Base Nat.divmod definition.
def lru_word_value__le_refl(n: Nat) -> {Nat.is_le(n, n) == True{} : Bool}:
