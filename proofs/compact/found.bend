def list__nth_none(-A: Data, +xs: List<&2, A>, +i: Nat, +h: {Nat.is_le(spec_common__length(A, xs), i) == True{} : Bool}) -> {spec_common__nth(A, xs, i) == None{} : Maybe<&2, A>}:
  match xs i:
    case Nil{} _:
      {==}
    case Con{x, t} 0n:
