    %Equal.sym(Nat, u32alg__uw(n, Word.zero(n)), 0n, u32alg__uw_zero(n)) : {Nat.add(_, u32alg__uw(n, b)) == Nat.add(u32alg__uw(n, b), u32alg__sc(n, 0n)) : Nat}
