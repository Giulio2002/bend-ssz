  %Equal.sym(Nat, Nat.mod(Nat.add(spec_numeric__bit_value(bit), Nat.double(value)), 2n), spec_numeric__bit_value(bit), lru_modular_addition__binary_remainder(value, bit)) : {WCon{Nat.is_eq(_, 1n), spec_numeric__from_nat(n, value)} == WCon{bit, spec_numeric__from_nat(n, value)} : Word(1n+n)}
