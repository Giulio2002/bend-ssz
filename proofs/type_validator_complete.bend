import Base
import ../types/schema.bend as T
import ../src/schema.bend as I
import ../src/lists.bend as Lists
import ../spec/type_legality.bend as S
import ./compatibility_equivalence.bend as Compatibility
import ./validator_selectors.bend as Selectors
import ./validator_metadata.bend as Metadata
import ./validator_fields.bend as Fields
import ./primitive_invariants.bend as V
import ./lists.bend as L
import ./type_validator_soundness.bend as Sound
import ../spec/compatibility.bend as C

# Converse of type_validator_soundness: every independently legal schema is
# accepted by the actual validator. Generated by
# tools/generate_type_validator_complete.py (constructor enumeration only).
law positive:
  for +fields: T.Schema
  for legal: {Nat.is_lt(0n, S.field_count(fields)) == True{} : Bool}
  {Nat.is_lt(0n, I.count(fields)) == True{} : Bool}
def positive(fields, legal):
  %Equal.sym(Nat, I.count(fields), S.field_count(fields), Metadata.field_count(fields)) : {Nat.is_lt(0n, _) == True{} : Bool}
  legal

law limited:
  for +fields: T.Schema
  for +limit: Nat
  for legal: {Nat.is_le(S.field_count(fields), limit) == True{} : Bool}
  {Nat.is_le(I.count(fields), limit) == True{} : Bool}
def limited(fields, limit, legal):
  %Equal.sym(Nat, I.count(fields), S.field_count(fields), Metadata.field_count(fields)) : {Nat.is_le(_, limit) == True{} : Bool}
  legal

law active_length:
  for +active: +List<Bool>
  for legal: {Nat.is_le(List.length(&2, Bool, active), 256n) == True{} : Bool}
  {Nat.is_le(Lists.length(Bool, active), 256n) == True{} : Bool}
def active_length(active, legal):
  %Equal.sym(Nat, Lists.length(Bool, active), List.length(&2, Bool, active), L.length_correct(Bool, active)) : {Nat.is_le(_, 256n) == True{} : Bool}
  legal

law active_count:
  for +active: +List<Bool>
  for +fields: T.Schema
  for legal: {S.active_count(active) == S.field_count(fields) : Nat}
  {Nat.is_eq(I.active_count(active, 0n), I.count(fields)) == True{} : Bool}
def active_count(active, fields, legal):
  %Equal.sym(Nat, I.active_count(active, 0n), S.active_count(active), Metadata.active_count(active)) : {Nat.is_eq(_, I.count(fields)) == True{} : Bool}
  %Equal.sym(Nat, I.count(fields), S.field_count(fields), Metadata.field_count(fields)) : {Nat.is_eq(S.active_count(active), _) == True{} : Bool}
  Fields.equality_complete(S.active_count(active), S.field_count(fields), legal)

law selector_count:
  for +ids: +List<U32>
  for +fields: T.Schema
  for legal: {List.length(&2, U32, ids) == S.field_count(fields) : Nat}
  {Nat.is_eq(Lists.length(U32, ids), I.count(fields)) == True{} : Bool}
def selector_count(ids, fields, legal):
  %Equal.sym(Nat, Lists.length(U32, ids), List.length(&2, U32, ids), L.length_correct(U32, ids)) : {Nat.is_eq(_, I.count(fields)) == True{} : Bool}
  %Equal.sym(Nat, I.count(fields), S.field_count(fields), Metadata.field_count(fields)) : {Nat.is_eq(List.length(&2, U32, ids), _) == True{} : Bool}
  Fields.equality_complete(List.length(&2, U32, ids), S.field_count(fields), legal)

law last_active:
  for +active: +List<Bool>
  for legal: {S.last_active(active) == True{} : Bool}
  {I.ends_active(active, False{}) == True{} : Bool}
def last_active(active, legal):
  %Equal.sym(Bool, I.ends_active(active, False{}), S.last_active(active), Fields.last_active(active)) : {_ == True{} : Bool}
  legal

law options_tail:
  for +options: T.Schema
  for +valid: {I.valid_go(options, True{}) == True{} : Bool}
  for compatible: C.mutually_compatible(options)
  {Bool.and(I.valid_go(options, True{}), I.compatible_go(Nat.mul(1024n, 1n+I.weight(options)), 1, options, options)) == True{} : Bool}
def options_tail(options, valid, compatible):
  V.and_true(I.valid_go(options, True{}), I.compatible_go(Nat.mul(1024n, 1n+I.weight(options)), 1, options, options), valid, Compatibility.options_complete(options, Sound.sound(options, True{}, valid), compatible))


# One option-list head, once. The same extraction was written out for each of
# the eighteen non-null head constructors; a law statement is elaborated in
# every importing module, so those eighteen copies were a large part of this
# module's checker memory. See the mirror image in type_validator_soundness.
law union_complete_at:
  for +h: T.Schema
  for +tail: T.Schema
  for +forest: Bool
  for legal: {forest == False{} : Bool} & {Nat.is_le(S.field_count(tail), 127n) == True{} : Bool} & S.legal(h, False{}) & S.legal(tail, True{})
  for rh: @e: S.legal(h, False{}) -> {I.valid_go(h, False{}) == True{} : Bool}
  for rt: @e: S.legal(tail, True{}) -> {I.valid_go(tail, True{}) == True{} : Bool}
  {Bool.and(Bool.not(forest), Bool.and(Nat.is_le(I.count(tail), 127n), Bool.and(I.valid_go(h, False{}), I.valid_go(tail, True{})))) == True{} : Bool}
def union_complete_at(h, tail, forest, legal, rh, rt):
  (f, lim, head, rest) = legal
  V.and_true(Bool.not(forest), Bool.and(Nat.is_le(I.count(tail), 127n), Bool.and(I.valid_go(h, False{}), I.valid_go(tail, True{}))),
    Selectors.not_false(forest, f),
    V.and_true(Nat.is_le(I.count(tail), 127n), Bool.and(I.valid_go(h, False{}), I.valid_go(tail, True{})),
      limited(tail, 127n, lim),
      V.and_true(I.valid_go(h, False{}), I.valid_go(tail, True{}), rh(head), rt(rest))))

law complete:
  for +schema: T.Schema
  for +forest: Bool
  for legal: S.legal(schema, forest)
  {I.valid_go(schema, forest) == True{} : Bool}
def complete(schema, forest, legal):
  match schema:
    case T.Boolean{}:
      f = legal
      Selectors.not_false(forest, f)
    case T.Unsigned{x0}:
      f = legal
      Selectors.not_false(forest, f)
    case T.ByteVector{x0}:
      (f, pos) = legal
      V.and_true(Bool.not(forest), Nat.is_lt(0n, x0), Selectors.not_false(forest, f), pos)
    case T.ByteList{x0}:
      f = legal
      Selectors.not_false(forest, f)
    case T.BitVector{x0}:
      (f, pos) = legal
      V.and_true(Bool.not(forest), Nat.is_lt(0n, x0), Selectors.not_false(forest, f), pos)
    case T.BitList{x0}:
      f = legal
      Selectors.not_false(forest, f)
    case T.Vector{x0, x1}:
      (f, pos, e) = legal
      V.and_true(Bool.not(forest), Bool.and(Nat.is_lt(0n, x1), I.valid_go(x0, False{})), Selectors.not_false(forest, f), V.and_true(Nat.is_lt(0n, x1), I.valid_go(x0, False{}), pos, complete(x0, False{}, e)))
    case T.ListOf{x0, x1}:
      (f, e) = legal
      V.and_true(Bool.not(forest), I.valid_go(x0, False{}), Selectors.not_false(forest, f), complete(x0, False{}, e))
    case T.Container{x0, x1}:
      (f, named, fields) = legal
      V.and_true(Bool.not(forest), Bool.and(I.named_fields_valid(x0, x1), I.valid_go(x1, True{})), Selectors.not_false(forest, f), V.and_true(I.named_fields_valid(x0, x1), I.valid_go(x1, True{}), Fields.named_complete(x0, x1, named), complete(x1, True{}, fields)))
    case T.Union{T.Boolean{}}: Empty.absurd({False{} == True{} : Bool}, legal)
    case T.Union{T.Unsigned{u0}}: Empty.absurd({False{} == True{} : Bool}, legal)
    case T.Union{T.ByteVector{u0}}: Empty.absurd({False{} == True{} : Bool}, legal)
    case T.Union{T.ByteList{u0}}: Empty.absurd({False{} == True{} : Bool}, legal)
    case T.Union{T.BitVector{u0}}: Empty.absurd({False{} == True{} : Bool}, legal)
    case T.Union{T.BitList{u0}}: Empty.absurd({False{} == True{} : Bool}, legal)
    case T.Union{T.Vector{u0, u1}}: Empty.absurd({False{} == True{} : Bool}, legal)
    case T.Union{T.ListOf{u0, u1}}: Empty.absurd({False{} == True{} : Bool}, legal)
    case T.Union{T.Container{u0, u1}}: Empty.absurd({False{} == True{} : Bool}, legal)
    case T.Union{T.Union{u0}}: Empty.absurd({False{} == True{} : Bool}, legal)
    case T.Union{T.Null{}}: Empty.absurd({False{} == True{} : Bool}, legal)
    case T.Union{T.Chain{T.Boolean{}, tail}}:
      union_complete_at(T.Boolean{}, tail, forest, legal, e => complete(T.Boolean{}, False{}, e), e => complete(tail, True{}, e))
    case T.Union{T.Chain{T.Unsigned{h0}, tail}}:
      union_complete_at(T.Unsigned{h0}, tail, forest, legal, e => complete(T.Unsigned{h0}, False{}, e), e => complete(tail, True{}, e))
    case T.Union{T.Chain{T.ByteVector{h0}, tail}}:
      union_complete_at(T.ByteVector{h0}, tail, forest, legal, e => complete(T.ByteVector{h0}, False{}, e), e => complete(tail, True{}, e))
    case T.Union{T.Chain{T.ByteList{h0}, tail}}:
      union_complete_at(T.ByteList{h0}, tail, forest, legal, e => complete(T.ByteList{h0}, False{}, e), e => complete(tail, True{}, e))
    case T.Union{T.Chain{T.BitVector{h0}, tail}}:
      union_complete_at(T.BitVector{h0}, tail, forest, legal, e => complete(T.BitVector{h0}, False{}, e), e => complete(tail, True{}, e))
    case T.Union{T.Chain{T.BitList{h0}, tail}}:
      union_complete_at(T.BitList{h0}, tail, forest, legal, e => complete(T.BitList{h0}, False{}, e), e => complete(tail, True{}, e))
    case T.Union{T.Chain{T.Vector{h0, h1}, tail}}:
      union_complete_at(T.Vector{h0, h1}, tail, forest, legal, e => complete(T.Vector{h0, h1}, False{}, e), e => complete(tail, True{}, e))
    case T.Union{T.Chain{T.ListOf{h0, h1}, tail}}:
      union_complete_at(T.ListOf{h0, h1}, tail, forest, legal, e => complete(T.ListOf{h0, h1}, False{}, e), e => complete(tail, True{}, e))
    case T.Union{T.Chain{T.Container{h0, h1}, tail}}:
      union_complete_at(T.Container{h0, h1}, tail, forest, legal, e => complete(T.Container{h0, h1}, False{}, e), e => complete(tail, True{}, e))
    case T.Union{T.Chain{T.Union{h0}, tail}}:
      union_complete_at(T.Union{h0}, tail, forest, legal, e => complete(T.Union{h0}, False{}, e), e => complete(tail, True{}, e))
    case T.Union{T.Chain{T.Null{}, tail}}:
      (f, pos, lim, rest) = legal
      V.and_true(Bool.not(forest), Bool.and(Nat.is_lt(0n, I.count(tail)), Bool.and(Nat.is_le(I.count(tail), 127n), I.valid_go(tail, True{}))), Selectors.not_false(forest, f), V.and_true(Nat.is_lt(0n, I.count(tail)), Bool.and(Nat.is_le(I.count(tail), 127n), I.valid_go(tail, True{})), positive(tail, pos), V.and_true(Nat.is_le(I.count(tail), 127n), I.valid_go(tail, True{}), limited(tail, 127n, lim), complete(tail, True{}, rest))))
    case T.Union{T.Chain{T.Chain{h0, h1}, tail}}:
      union_complete_at(T.Chain{h0, h1}, tail, forest, legal, e => complete(T.Chain{h0, h1}, False{}, e), e => complete(tail, True{}, e))
    case T.Union{T.Chain{T.End{}, tail}}:
      union_complete_at(T.End{}, tail, forest, legal, e => complete(T.End{}, False{}, e), e => complete(tail, True{}, e))
    case T.Union{T.Chain{T.Repeat{h0}, tail}}:
      union_complete_at(T.Repeat{h0}, tail, forest, legal, e => complete(T.Repeat{h0}, False{}, e), e => complete(tail, True{}, e))
    case T.Union{T.Chain{T.Named{h0, h1}, tail}}:
      union_complete_at(T.Named{h0, h1}, tail, forest, legal, e => complete(T.Named{h0, h1}, False{}, e), e => complete(tail, True{}, e))
    case T.Union{T.Chain{T.ProgressiveList{h0}, tail}}:
      union_complete_at(T.ProgressiveList{h0}, tail, forest, legal, e => complete(T.ProgressiveList{h0}, False{}, e), e => complete(tail, True{}, e))
    case T.Union{T.Chain{T.ProgressiveBits{}, tail}}:
      union_complete_at(T.ProgressiveBits{}, tail, forest, legal, e => complete(T.ProgressiveBits{}, False{}, e), e => complete(tail, True{}, e))
    case T.Union{T.Chain{T.ProgressiveContainer{h0, h1, h2}, tail}}:
      union_complete_at(T.ProgressiveContainer{h0, h1, h2}, tail, forest, legal, e => complete(T.ProgressiveContainer{h0, h1, h2}, False{}, e), e => complete(tail, True{}, e))
    case T.Union{T.Chain{T.CompatibleUnion{h0, h1}, tail}}:
      union_complete_at(T.CompatibleUnion{h0, h1}, tail, forest, legal, e => complete(T.CompatibleUnion{h0, h1}, False{}, e), e => complete(tail, True{}, e))
    case T.Union{T.End{}}: Empty.absurd({False{} == True{} : Bool}, legal)
    case T.Union{T.Repeat{u0}}: Empty.absurd({False{} == True{} : Bool}, legal)
    case T.Union{T.Named{u0, u1}}: Empty.absurd({False{} == True{} : Bool}, legal)
    case T.Union{T.ProgressiveList{u0}}: Empty.absurd({False{} == True{} : Bool}, legal)
    case T.Union{T.ProgressiveBits{}}: Empty.absurd({False{} == True{} : Bool}, legal)
    case T.Union{T.ProgressiveContainer{u0, u1, u2}}: Empty.absurd({False{} == True{} : Bool}, legal)
    case T.Union{T.CompatibleUnion{u0, u1}}: Empty.absurd({False{} == True{} : Bool}, legal)
    case T.Null{}: Empty.absurd({False{} == True{} : Bool}, legal)
    case T.Chain{x0, x1}:
      (f, h, t) = legal
      V.and_true(forest, Bool.and(I.valid_go(x0, False{}), I.valid_go(x1, True{})), f, V.and_true(I.valid_go(x0, False{}), I.valid_go(x1, True{}), complete(x0, False{}, h), complete(x1, True{}, t)))
    case T.End{}: legal
    case T.Repeat{x0}: Empty.absurd({False{} == True{} : Bool}, legal)
    case T.Named{x0, x1}: Empty.absurd({False{} == True{} : Bool}, legal)
    case T.ProgressiveList{x0}:
      (f, e) = legal
      V.and_true(Bool.not(forest), I.valid_go(x0, False{}), Selectors.not_false(forest, f), complete(x0, False{}, e))
    case T.ProgressiveBits{}:
      f = legal
      Selectors.not_false(forest, f)
    case T.ProgressiveContainer{x0, x1, x2}:
      (f, named, fields, len, last, count) = legal
      V.and_true(Bool.not(forest), Bool.and(I.named_fields_valid(x0, x1), Bool.and(I.valid_go(x1, True{}), Bool.and(Nat.is_le(Lists.length(Bool, x2), 256n), Bool.and(I.ends_active(x2, False{}), Nat.is_eq(I.active_count(x2, 0n), I.count(x1)))))), Selectors.not_false(forest, f), V.and_true(I.named_fields_valid(x0, x1), Bool.and(I.valid_go(x1, True{}), Bool.and(Nat.is_le(Lists.length(Bool, x2), 256n), Bool.and(I.ends_active(x2, False{}), Nat.is_eq(I.active_count(x2, 0n), I.count(x1))))), Fields.named_complete(x0, x1, named), V.and_true(I.valid_go(x1, True{}), Bool.and(Nat.is_le(Lists.length(Bool, x2), 256n), Bool.and(I.ends_active(x2, False{}), Nat.is_eq(I.active_count(x2, 0n), I.count(x1)))), complete(x1, True{}, fields), V.and_true(Nat.is_le(Lists.length(Bool, x2), 256n), Bool.and(I.ends_active(x2, False{}), Nat.is_eq(I.active_count(x2, 0n), I.count(x1))), active_length(x2, len), V.and_true(I.ends_active(x2, False{}), Nat.is_eq(I.active_count(x2, 0n), I.count(x1)), last_active(x2, last), active_count(x2, x1, count))))))
    case T.CompatibleUnion{x0, x1}:
      (f, pos, count, ids, options, compatible) = legal
      V.and_true(Bool.not(forest), Bool.and(Nat.is_lt(0n, I.count(x1)), Bool.and(Nat.is_eq(Lists.length(U32, x0), I.count(x1)), Bool.and(I.selectors_valid(x0, []), Bool.and(I.valid_go(x1, True{}), I.compatible_go(Nat.mul(1024n, 1n+I.weight(x1)), 1, x1, x1))))), Selectors.not_false(forest, f), V.and_true(Nat.is_lt(0n, I.count(x1)), Bool.and(Nat.is_eq(Lists.length(U32, x0), I.count(x1)), Bool.and(I.selectors_valid(x0, []), Bool.and(I.valid_go(x1, True{}), I.compatible_go(Nat.mul(1024n, 1n+I.weight(x1)), 1, x1, x1)))), positive(x1, pos), V.and_true(Nat.is_eq(Lists.length(U32, x0), I.count(x1)), Bool.and(I.selectors_valid(x0, []), Bool.and(I.valid_go(x1, True{}), I.compatible_go(Nat.mul(1024n, 1n+I.weight(x1)), 1, x1, x1))), selector_count(x0, x1, count), V.and_true(I.selectors_valid(x0, []), Bool.and(I.valid_go(x1, True{}), I.compatible_go(Nat.mul(1024n, 1n+I.weight(x1)), 1, x1, x1)), Selectors.complete(x0, ids), options_tail(x1, complete(x1, True{}, options), compatible)))))

law public_complete:
  for +schema: T.Schema
  for legal: S.type_legal(schema)
  {I.valid(schema) == True{} : Bool}
def public_complete(schema, legal): complete(schema, False{}, legal)
