law option_view:
  for +schema: T.Schema
  for +value: T.Value
  for +result: Maybe<&2, +List<+List<U32>>>
  for legal: {DG.option_ok(schema) == True{} : Bool}
  for known: G.sound(value, schema, [], result)
  G.rel_single(outs => R.roots(value, schema, outs), result)
def option_view(schema, value, result, legal, known):
  match schema:
    case T.Boolean{}: known
    case T.Unsigned{s0}: known
    case T.ByteVector{s0}: known
    case T.ByteList{s0}: known
    case T.BitVector{s0}: known
    case T.BitList{s0}: known
    case T.Vector{s0, s1}: known
    case T.ListOf{s0, s1}: known
    case T.Container{s0, s1}: known
    case T.Union{s0}: known
    case T.Null{}: known
    case T.Chain{s0, s1}: Empty.absurd(G.rel_single(outs => R.roots(value, T.Chain{s0, s1}, outs), result), W.false_true(legal))
    case T.End{}: Empty.absurd(G.rel_single(outs => R.roots(value, T.End{}, outs), result), W.false_true(legal))
    case T.Repeat{s0}: Empty.absurd(G.rel_single(outs => R.roots(value, T.Repeat{s0}, outs), result), W.false_true(legal))
    case T.Named{s0, s1}: known
    case T.ProgressiveList{s0}: known
    case T.ProgressiveBits{}: known
    case T.ProgressiveContainer{s0, s1, s2}: known
    case T.CompatibleUnion{s0, s1}: known

law forest_rel:
  for +value: T.Value
  for +schema: T.Schema
  for +result: Maybe<&2, +List<+List<U32>>>
  for known: G.forest_sound(value, schema, [], result)
  G.rel_single(outs => R.roots(value, schema, outs), result)
def forest_rel(value, schema, result, known):
  match result:
    case None{}: Unit{}
    case Some{rs}:
      (mine, (rel, same)) = known
      G.chunks_rewrite(value, schema, rs, mine, rel, same)

def found_ok(found: Maybe<&2, T.Schema>, s: T.Schema) -> Type:
  {found == Some{s} : Maybe<&2, T.Schema>} -> {DG.option_ok(s) == True{} : Bool}

def found_absent(found: Maybe<&2, T.Schema>) -> Bool:
  match found:
    case None{}: False{}
    case Some{s}: True{}

def found_value(found: Maybe<&2, T.Schema>) -> T.Schema:
  match found:
    case None{}: T.Null{}
    case Some{s}: s

law index_ok:
  for +i: Nat
  for +c: Nat
  for +found: Maybe<&2, T.Schema>
  for facts: DG.index_fact(i, c, found)
  for +s: T.Schema
  found_ok(found, s)
def index_ok(i, c, found, facts, s):
  match found:
    case None{}: e => Empty.absurd({DG.option_ok(s) == True{} : Bool}, W.false_true(Equal.cong(Maybe<&2, T.Schema>, Bool, found_absent, None{}, Some{s}, e)))
    case Some{t}:
      (valid, less) = facts
      e => (%Equal.cong(Maybe<&2, T.Schema>, T.Schema, found_value, Some{t}, Some{s}, e) : {DG.option_ok(_) == True{} : Bool}
            valid)

law selection_ok:
  for +sel: U32
  for +found: Maybe<&2, T.Schema>
  for facts: DG.selection(sel, found)
  for +s: T.Schema
  found_ok(found, s)
def selection_ok(sel, found, facts, s):
  match found:
    case None{}: e => Empty.absurd({DG.option_ok(s) == True{} : Bool}, W.false_true(Equal.cong(Maybe<&2, T.Schema>, Bool, found_absent, None{}, Some{s}, e)))
    case Some{t}:
      (valid, small) = facts
      e => (%Equal.cong(Maybe<&2, T.Schema>, T.Schema, found_value, Some{t}, Some{s}, e) : {DG.option_ok(_) == True{} : Bool}
            valid)


law chain_length:
  for +head: +List<+List<U32>>
  for +tail: +List<+List<U32>>
  for +mine: +List<+List<U32>>
  for +n: Nat
  for +first: {List.length(&2, +List<U32>, head) == 1n : Nat}
  for +rest: {List.length(&2, +List<U32>, tail) == n : Nat}
  for +same: {mine == List.append(&2, +List<U32>, head, tail) : +List<+List<U32>>}
  {List.length(&2, +List<U32>, mine) == 1n+n : Nat}
def chain_length(head, tail, mine, n, first, rest, same):
  %Equal.sym(+List<+List<U32>>, mine, List.append(&2, +List<U32>, head, tail), same) : {List.length(&2, +List<U32>, _) == 1n+n : Nat}
  %Equal.sym(Nat, List.length(&2, +List<U32>, List.append(&2, +List<U32>, head, tail)), Nat.add(List.length(&2, +List<U32>, head), List.length(&2, +List<U32>, tail)), L.append_length(+List<U32>, head, tail)) : {_ == 1n+n : Nat}
  %Equal.sym(Nat, List.length(&2, +List<U32>, head), 1n, first) : {Nat.add(_, List.length(&2, +List<U32>, tail)) == 1n+n : Nat}
  Equal.cong(Nat, Nat, x => 1n+x, List.length(&2, +List<U32>, tail), n, rest)

law empty_length:
  for +mine: +List<+List<U32>>
  for +same: {mine == [] : +List<+List<U32>>}
  {List.length(&2, +List<U32>, mine) == 0n : Nat} & {mine == [] : +List<+List<U32>>}
def empty_length(mine, same):
  (%Equal.sym(+List<+List<U32>>, mine, [], same) : {List.length(&2, +List<U32>, _) == 0n : Nat}
   {==}, same)

law selected_back:
  for +s: T.Schema
  for +v: T.Value
  for +selector: U32
  for +outs: +List<+List<U32>>
  for +root: +List<U32>
  for child: R.roots(v, s, [root])
  for pair: G.one(outs) & R.single(SMixing.mix_in_selector(root, selector), outs)
  G.one(outs) & G.selected_rel(v, s, selector, outs)
def selected_back(s, v, selector, outs, root, child, pair):
  (size, mixed) = pair
  (size, (root, (child, mixed)))


law selected_one:
  for +found: Maybe<&2, T.Schema>
  for +v: T.Value
  for +selector: U32
  for +outs: +List<+List<U32>>
  for rel: R.selected(found, s => G.selected_rel(v, s, selector, outs))
  G.one(outs) & R.selected(found, s => G.selected_rel(v, s, selector, outs))
def selected_one(found, v, selector, outs, rel):
  match found:
    case None{}:
      match rel:
    case Some{s}:
      (+root, (child, mixed)) = rel
      selected_back(s, v, selector, outs, root, child, G.single_one(SMixing.mix_in_selector(root, selector), outs, mixed))

law bytevector_back:
  for +n: Nat
  for +xs: +List<U32>
  for +outs: +List<+List<U32>>
  for +depth: Nat
  for canonical: {SByteRoot.canonical_depth(xs, depth) == True{} : Bool}
  for pair: G.one(outs) & R.single(SByteRoot.at_depth(n, depth, xs), outs)
  G.one(outs) & R.roots(T.BytesValue{xs}, T.ByteVector{n}, outs)
def bytevector_back(n, xs, outs, depth, canonical, pair):
  (size, single) = pair
  (size, (depth, (canonical, single)))


law bytevector_one:
  for +n: Nat
  for +xs: +List<U32>
  for +outs: +List<+List<U32>>
  for rel: R.roots(T.BytesValue{xs}, T.ByteVector{n}, outs)
  G.one(outs) & R.roots(T.BytesValue{xs}, T.ByteVector{n}, outs)
def bytevector_one(n, xs, outs, rel):
  (+depth, (canonical, single)) = rel
  bytevector_back(n, xs, outs, depth, canonical, G.single_one(SByteRoot.at_depth(n, depth, xs), outs, single))

law bytelist_back:
  for +n: Nat
  for +xs: +List<U32>
  for +outs: +List<+List<U32>>
  for +depth: Nat
  for canonical: {SLimits.minimal(SByteList.chunk_limit(n), depth) == True{} : Bool}
  for pair: G.one(outs) & R.single(SByteList.at_depth(n, depth, xs), outs)
  G.one(outs) & R.roots(T.BytesValue{xs}, T.ByteList{n}, outs)
def bytelist_back(n, xs, outs, depth, canonical, pair):
  (size, single) = pair
  (size, (depth, (canonical, single)))


law bytelist_one:
  for +n: Nat
  for +xs: +List<U32>
  for +outs: +List<+List<U32>>
  for rel: R.roots(T.BytesValue{xs}, T.ByteList{n}, outs)
  G.one(outs) & R.roots(T.BytesValue{xs}, T.ByteList{n}, outs)
def bytelist_one(n, xs, outs, rel):
  (+depth, (canonical, single)) = rel
  bytelist_back(n, xs, outs, depth, canonical, G.single_one(SByteList.at_depth(n, depth, xs), outs, single))

law bitvector_back:
  for +n: Nat
