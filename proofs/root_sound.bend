    case T.ByteVector{s0}: {==}
    case T.ByteList{s0}: {==}
    case T.BitVector{s0}: {==}
    case T.BitList{s0}: {==}
    case T.Vector{s0, s1}: {==}
    case T.ListOf{s0, s1}: {==}
    case T.Container{s0, s1}: {==}
    case T.Union{s0}: {==}
    case T.Null{}: {==}
    case T.Chain{s0, s1}: {==}
    case T.End{}: {==}
    case T.Repeat{s0}: {==}
    case T.Named{s0, s1}: {==}
    case T.ProgressiveList{s0}: {==}
    case T.ProgressiveBits{}: {==}
    case T.ProgressiveContainer{s0, s1, s2}: {==}
    case T.CompatibleUnion{s0, s1}: {==}

law zero_limit:
  for +size: Maybe<&2, Nat>
