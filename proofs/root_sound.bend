law chain_pair:
  for +h: T.Value
  for +t: T.Value
  for +s: T.Schema
  for +rest: T.Schema
  for +mine: +List<+List<U32>>
  for +head: +List<+List<U32>>
  for +tail: +List<+List<U32>>
  for +same: {mine == List.append(&2, +List<U32>, head, tail) : +List<+List<U32>>}
  for first: G.one(head) & R.roots(h, s, head)
  for second: {List.length(&2, +List<U32>, tail) == TL.field_count(rest) : Nat} & R.roots(t, rest, tail)
  {List.length(&2, +List<U32>, mine) == TL.field_count(T.Chain{s, rest}) : Nat} & R.roots(T.Items{h, t}, T.Chain{s, rest}, mine)
def chain_pair(h, t, s, rest, mine, head, tail, same, first, second):
  (one, rh) = first
  (length, rt) = second
  (chain_length(head, tail, mine, TL.field_count(rest), one, length, same), (head, (tail, (rh, (rt, same)))))


law active_count_pair:
  for +active: +List<Bool>
  for +fields: T.Schema
  for +items: T.Value
  for +rs: +List<+List<U32>>
  for +counted: {TL.active_count(active) == TL.field_count(fields) : Nat}
  for pair: {List.length(&2, +List<U32>, rs) == TL.field_count(fields) : Nat} & R.roots(items, fields, rs)
  {TL.active_count(active) == List.length(&2, +List<U32>, rs) : Nat} & R.roots(items, fields, rs)
def active_count_pair(active, fields, items, rs, counted, pair):
  (length, rel) = pair
  (Equal.trans(Nat, TL.active_count(active), TL.field_count(fields), List.length(&2, +List<U32>, rs), counted, Equal.sym(Nat, List.length(&2, +List<U32>, rs), TL.field_count(fields), length)), rel)


law forest_length:
  for +value: T.Value
  for +schema: T.Schema
  for +mine: +List<+List<U32>>
  for +legal: {IS.valid_go(schema, True{}) == True{} : Bool}
  for rel: R.roots(value, schema, mine)
  {List.length(&2, +List<U32>, mine) == TL.field_count(schema) : Nat} & R.roots(value, schema, mine)
def forest_length(value, schema, mine, legal, rel):
  match value:
    case T.BooleanValue{v0}:
      match schema:
