    case T.Unsigned{a0} T.Vector{T.Boolean{}, b1}: Empty.absurd(F.finite(S.Pair{}, T.Unsigned{a0}, T.Vector{T.Boolean{}, b1}), W.false_true(accepted))
    case T.Unsigned{a0} T.Vector{T.Unsigned{bc0}, b1}: Empty.absurd(F.finite(S.Pair{}, T.Unsigned{a0}, T.Vector{T.Unsigned{bc0}, b1}), W.false_true(accepted))
