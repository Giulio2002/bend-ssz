    case T.Unsigned{a0} T.Vector{T.BitList{bc0}, b1}: Empty.absurd(F.finite(S.Pair{}, T.Unsigned{a0}, T.Vector{T.BitList{bc0}, b1}), W.false_true(accepted))
    case T.Unsigned{a0} T.Vector{T.Vector{bc0, bc1}, b1}: Empty.absurd(F.finite(S.Pair{}, T.Unsigned{a0}, T.Vector{T.Vector{bc0, bc1}, b1}), W.false_true(accepted))
    case T.Unsigned{a0} T.Vector{T.ListOf{bc0, bc1}, b1}: Empty.absurd(F.finite(S.Pair{}, T.Unsigned{a0}, T.Vector{T.ListOf{bc0, bc1}, b1}), W.false_true(accepted))
    case T.Unsigned{a0} T.Vector{T.Container{bc0, bc1}, b1}: Empty.absurd(F.finite(S.Pair{}, T.Unsigned{a0}, T.Vector{T.Container{bc0, bc1}, b1}), W.false_true(accepted))
    case T.Unsigned{a0} T.Vector{T.Union{bc0}, b1}: Empty.absurd(F.finite(S.Pair{}, T.Unsigned{a0}, T.Vector{T.Union{bc0}, b1}), W.false_true(accepted))
    case T.Unsigned{a0} T.Vector{T.Null{}, b1}: Empty.absurd(F.finite(S.Pair{}, T.Unsigned{a0}, T.Vector{T.Null{}, b1}), W.false_true(accepted))
    case T.Unsigned{a0} T.Vector{T.Chain{bc0, bc1}, b1}: Empty.absurd(F.finite(S.Pair{}, T.Unsigned{a0}, T.Vector{T.Chain{bc0, bc1}, b1}), W.false_true(accepted))
