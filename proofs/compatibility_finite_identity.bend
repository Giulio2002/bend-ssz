    case T.Boolean{} T.ListOf{T.Named{bc0, bc1}, b1}: Empty.absurd(F.finite(S.Pair{}, T.Boolean{}, T.ListOf{T.Named{bc0, bc1}, b1}), W.false_true(accepted))
    case T.Boolean{} T.ListOf{T.ProgressiveList{bc0}, b1}: Empty.absurd(F.finite(S.Pair{}, T.Boolean{}, T.ListOf{T.ProgressiveList{bc0}, b1}), W.false_true(accepted))
    case T.Boolean{} T.ListOf{T.ProgressiveBits{}, b1}: Empty.absurd(F.finite(S.Pair{}, T.Boolean{}, T.ListOf{T.ProgressiveBits{}, b1}), W.false_true(accepted))
    case T.Boolean{} T.ListOf{T.ProgressiveContainer{bc0, bc1, bc2}, b1}: Empty.absurd(F.finite(S.Pair{}, T.Boolean{}, T.ListOf{T.ProgressiveContainer{bc0, bc1, bc2}, b1}), W.false_true(accepted))
    case T.Boolean{} T.ListOf{T.CompatibleUnion{bc0, bc1}, b1}: Empty.absurd(F.finite(S.Pair{}, T.Boolean{}, T.ListOf{T.CompatibleUnion{bc0, bc1}, b1}), W.false_true(accepted))
    case T.Boolean{} T.Container{b0, b1}: Empty.absurd(F.finite(S.Pair{}, T.Boolean{}, T.Container{b0, b1}), W.false_true(accepted))
    case T.Boolean{} T.Union{b0}: Empty.absurd(F.finite(S.Pair{}, T.Boolean{}, T.Union{b0}), W.false_true(accepted))
    case T.Boolean{} T.Null{}: Empty.absurd(F.finite(S.Pair{}, T.Boolean{}, T.Null{}), W.false_true(accepted))
    case T.Boolean{} T.Chain{b0, b1}: Empty.absurd(F.finite(S.Pair{}, T.Boolean{}, T.Chain{b0, b1}), W.false_true(accepted))
    case T.Boolean{} T.End{}: Empty.absurd(F.finite(S.Pair{}, T.Boolean{}, T.End{}), W.false_true(accepted))
    case T.Boolean{} T.Repeat{b0}: Empty.absurd(F.finite(S.Pair{}, T.Boolean{}, T.Repeat{b0}), W.false_true(accepted))
    case T.Boolean{} T.Named{b0, b1}: Empty.absurd(F.finite(S.Pair{}, T.Boolean{}, T.Named{b0, b1}), W.false_true(accepted))
    case T.Boolean{} T.ProgressiveList{b0}: Empty.absurd(F.finite(S.Pair{}, T.Boolean{}, T.ProgressiveList{b0}), W.false_true(accepted))
    case T.Boolean{} T.ProgressiveBits{}: Empty.absurd(F.finite(S.Pair{}, T.Boolean{}, T.ProgressiveBits{}), W.false_true(accepted))
    case T.Boolean{} T.ProgressiveContainer{b0, b1, b2}: Empty.absurd(F.finite(S.Pair{}, T.Boolean{}, T.ProgressiveContainer{b0, b1, b2}), W.false_true(accepted))
    case T.Boolean{} T.CompatibleUnion{b0, b1}: Empty.absurd(F.finite(S.Pair{}, T.Boolean{}, T.CompatibleUnion{b0, b1}), W.false_true(accepted))
    case T.Unsigned{a0} T.Boolean{}: Empty.absurd(F.finite(S.Pair{}, T.Unsigned{a0}, T.Boolean{}), W.false_true(accepted))
    case T.Unsigned{a0} T.Unsigned{b0}: (1n, actual_identity(T.Unsigned{a0}, T.Unsigned{b0}, accepted))
    case T.Unsigned{a0} T.ByteVector{b0}: Empty.absurd(F.finite(S.Pair{}, T.Unsigned{a0}, T.ByteVector{b0}), W.false_true(accepted))
