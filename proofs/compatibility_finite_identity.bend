    case T.Boolean{} T.ListOf{T.Container{bc0, bc1}, b1}: Empty.absurd(F.finite(S.Pair{}, T.Boolean{}, T.ListOf{T.Container{bc0, bc1}, b1}), W.false_true(accepted))
    case T.Boolean{} T.ListOf{T.Union{bc0}, b1}: Empty.absurd(F.finite(S.Pair{}, T.Boolean{}, T.ListOf{T.Union{bc0}, b1}), W.false_true(accepted))
    case T.Boolean{} T.ListOf{T.Null{}, b1}: Empty.absurd(F.finite(S.Pair{}, T.Boolean{}, T.ListOf{T.Null{}, b1}), W.false_true(accepted))
