    case T.Unsigned{a0} T.Vector{T.ProgressiveList{bc0}, b1}: Empty.absurd(F.finite(S.Pair{}, T.Unsigned{a0}, T.Vector{T.ProgressiveList{bc0}, b1}), W.false_true(accepted))
