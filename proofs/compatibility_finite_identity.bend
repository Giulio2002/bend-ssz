import Base
import ../types/schema.bend as T
import ../src/schema.bend as I
import ../spec/compatibility.bend as S
import ./compatibility_finite.bend as F
import ./identity_total.bend as Identity
import ./compatibility_choice.bend as Choice
import ./primitive_invariants.bend as V
import ./validator_metadata.bend as M
import ./word_facts.bend as W

law actual_identity:
  for +a: T.Schema
  for +b: T.Schema
  for accepted: {S.identical(a, b) == True{} : Bool}
  {I.identical(a, b) == True{} : Bool}
def actual_identity(a, b, accepted):
  %Equal.sym(Bool, I.identical(a, b), S.identical(a, b), Identity.equal(a, b)) : {_ == True{} : Bool}
  accepted

# A finite implementation witness for every independent identity derivation.
law finite_identity:
  for +a: T.Schema
  for +b: T.Schema
  for +accepted: {S.identical(a, b) == True{} : Bool}
  F.finite(S.Pair{}, a, b)
def finite_identity(a, b, accepted):
  match a b:
    case T.Boolean{} T.Boolean{}: (1n, actual_identity(T.Boolean{}, T.Boolean{}, accepted))
    case T.Boolean{} T.Unsigned{b0}: Empty.absurd(F.finite(S.Pair{}, T.Boolean{}, T.Unsigned{b0}), W.false_true(accepted))
    case T.Boolean{} T.ByteVector{b0}: Empty.absurd(F.finite(S.Pair{}, T.Boolean{}, T.ByteVector{b0}), W.false_true(accepted))
    case T.Boolean{} T.ByteList{b0}: Empty.absurd(F.finite(S.Pair{}, T.Boolean{}, T.ByteList{b0}), W.false_true(accepted))
    case T.Boolean{} T.BitVector{b0}: Empty.absurd(F.finite(S.Pair{}, T.Boolean{}, T.BitVector{b0}), W.false_true(accepted))
    case T.Boolean{} T.BitList{b0}: Empty.absurd(F.finite(S.Pair{}, T.Boolean{}, T.BitList{b0}), W.false_true(accepted))
    case T.Boolean{} T.Vector{T.Boolean{}, b1}: Empty.absurd(F.finite(S.Pair{}, T.Boolean{}, T.Vector{T.Boolean{}, b1}), W.false_true(accepted))
    case T.Boolean{} T.Vector{T.Unsigned{bc0}, b1}: Empty.absurd(F.finite(S.Pair{}, T.Boolean{}, T.Vector{T.Unsigned{bc0}, b1}), W.false_true(accepted))
    case T.Boolean{} T.Vector{T.ByteVector{bc0}, b1}: Empty.absurd(F.finite(S.Pair{}, T.Boolean{}, T.Vector{T.ByteVector{bc0}, b1}), W.false_true(accepted))
    case T.Boolean{} T.Vector{T.ByteList{bc0}, b1}: Empty.absurd(F.finite(S.Pair{}, T.Boolean{}, T.Vector{T.ByteList{bc0}, b1}), W.false_true(accepted))
    case T.Boolean{} T.Vector{T.BitVector{bc0}, b1}: Empty.absurd(F.finite(S.Pair{}, T.Boolean{}, T.Vector{T.BitVector{bc0}, b1}), W.false_true(accepted))
    case T.Boolean{} T.Vector{T.BitList{bc0}, b1}: Empty.absurd(F.finite(S.Pair{}, T.Boolean{}, T.Vector{T.BitList{bc0}, b1}), W.false_true(accepted))
    case T.Boolean{} T.Vector{T.Vector{bc0, bc1}, b1}: Empty.absurd(F.finite(S.Pair{}, T.Boolean{}, T.Vector{T.Vector{bc0, bc1}, b1}), W.false_true(accepted))
    case T.Boolean{} T.Vector{T.ListOf{bc0, bc1}, b1}: Empty.absurd(F.finite(S.Pair{}, T.Boolean{}, T.Vector{T.ListOf{bc0, bc1}, b1}), W.false_true(accepted))
    case T.Boolean{} T.Vector{T.Container{bc0, bc1}, b1}: Empty.absurd(F.finite(S.Pair{}, T.Boolean{}, T.Vector{T.Container{bc0, bc1}, b1}), W.false_true(accepted))
    case T.Boolean{} T.Vector{T.Union{bc0}, b1}: Empty.absurd(F.finite(S.Pair{}, T.Boolean{}, T.Vector{T.Union{bc0}, b1}), W.false_true(accepted))
    case T.Boolean{} T.Vector{T.Null{}, b1}: Empty.absurd(F.finite(S.Pair{}, T.Boolean{}, T.Vector{T.Null{}, b1}), W.false_true(accepted))
    case T.Boolean{} T.Vector{T.Chain{bc0, bc1}, b1}: Empty.absurd(F.finite(S.Pair{}, T.Boolean{}, T.Vector{T.Chain{bc0, bc1}, b1}), W.false_true(accepted))
    case T.Boolean{} T.Vector{T.End{}, b1}: Empty.absurd(F.finite(S.Pair{}, T.Boolean{}, T.Vector{T.End{}, b1}), W.false_true(accepted))
    case T.Boolean{} T.Vector{T.Repeat{bc0}, b1}: Empty.absurd(F.finite(S.Pair{}, T.Boolean{}, T.Vector{T.Repeat{bc0}, b1}), W.false_true(accepted))
    case T.Boolean{} T.Vector{T.Named{bc0, bc1}, b1}: Empty.absurd(F.finite(S.Pair{}, T.Boolean{}, T.Vector{T.Named{bc0, bc1}, b1}), W.false_true(accepted))
    case T.Boolean{} T.Vector{T.ProgressiveList{bc0}, b1}: Empty.absurd(F.finite(S.Pair{}, T.Boolean{}, T.Vector{T.ProgressiveList{bc0}, b1}), W.false_true(accepted))
    case T.Boolean{} T.Vector{T.ProgressiveBits{}, b1}: Empty.absurd(F.finite(S.Pair{}, T.Boolean{}, T.Vector{T.ProgressiveBits{}, b1}), W.false_true(accepted))
    case T.Boolean{} T.Vector{T.ProgressiveContainer{bc0, bc1, bc2}, b1}: Empty.absurd(F.finite(S.Pair{}, T.Boolean{}, T.Vector{T.ProgressiveContainer{bc0, bc1, bc2}, b1}), W.false_true(accepted))
    case T.Boolean{} T.Vector{T.CompatibleUnion{bc0, bc1}, b1}: Empty.absurd(F.finite(S.Pair{}, T.Boolean{}, T.Vector{T.CompatibleUnion{bc0, bc1}, b1}), W.false_true(accepted))
