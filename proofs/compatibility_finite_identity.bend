    case T.Boolean{} T.ListOf{T.BitVector{bc0}, b1}: Empty.absurd(F.finite(S.Pair{}, T.Boolean{}, T.ListOf{T.BitVector{bc0}, b1}), W.false_true(accepted))
    case T.Boolean{} T.ListOf{T.BitList{bc0}, b1}: Empty.absurd(F.finite(S.Pair{}, T.Boolean{}, T.ListOf{T.BitList{bc0}, b1}), W.false_true(accepted))
    case T.Boolean{} T.ListOf{T.Vector{bc0, bc1}, b1}: Empty.absurd(F.finite(S.Pair{}, T.Boolean{}, T.ListOf{T.Vector{bc0, bc1}, b1}), W.false_true(accepted))
