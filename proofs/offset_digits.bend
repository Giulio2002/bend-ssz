law byte_roundtrip:
  for +x: U32
  for +small: {U32.is_lt(x, 256) == True{} : Bool}
  {U32.from_nat(U32.to_nat(x)) == x : U32}
def byte_roundtrip(x, small):
  %Equal.sym(U32, x, PD.embed8(WS.take(8n, 32n, PD.bits(x))), ID.byte_shape(x, small)) : {U32.from_nat(U32.to_nat(_)) == _ : U32}
  byte_word_roundtrip(WS.take(8n, 32n, PD.bits(x)))

law byte_bound:
  for +x: U32
  for +small: {U32.is_lt(x, 256) == True{} : Bool}
  {Nat.is_le(U32.to_nat(x), 255n) == True{} : Bool}
def byte_bound(x, small):
  DV.le_of_lt(U32.to_nat(x), 256n,
    Equal.trans(Bool, Nat.is_lt(U32.to_nat(x), U32.to_nat(256)), U32.is_lt(x, 256), True{},
      Equal.sym(Bool, U32.is_lt(x, 256), Nat.is_lt(U32.to_nat(x), U32.to_nat(256)), UO.u32_less(x, 256)), small))

law value_head:
  for +h: U32
  for +t: +List<U32>
  for +small: {Nat.is_le(U32.to_nat(h), 255n) == True{} : Bool}
  {Nat.mod(N.value(h <> t), 256n) == U32.to_nat(h) : Nat}
def value_head(h, t, small):
  %NA.add_commute(Nat.mul(N.value(t), 256n), U32.to_nat(h)) : {Nat.mod(_, 256n) == U32.to_nat(h) : Nat}
  DV.mod_exact(N.value(t), U32.to_nat(h), 255n, small)

law value_tail:
  for +h: U32
  for +t: +List<U32>
  for +small: {Nat.is_le(U32.to_nat(h), 255n) == True{} : Bool}
  {Nat.div(N.value(h <> t), 256n) == N.value(t) : Nat}
def value_tail(h, t, small):
  %NA.add_commute(Nat.mul(N.value(t), 256n), U32.to_nat(h)) : {Nat.div(_, 256n) == N.value(t) : Nat}
  DV.div_exact(N.value(t), U32.to_nat(h), 255n, small)

def nat_pred(n: Nat) -> Nat:
  match n:
    case 0n: 0n
    case 1n+p: p

law pred_equal:
  for +a: Nat
  for +b: Nat
  for +same: {1n+a == 1n+b : Nat}
  {a == b : Nat}
def pred_equal(a, b, same):
  Equal.cong(Nat, Nat, nat_pred, 1n+a, 1n+b, same)

law digits_of_value:
  for +width: Nat
  for +xs: +List<U32>
  for +sized: {List.length(&2, U32, xs) == width : Nat}
  for +scope: {SP.bytes_domain(xs) == True{} : Bool}
  {N.digits(width, N.value(xs)) == xs : +List<U32>}
def digits_of_value(width, xs, sized, scope):
  match width xs:
    case 0n Nil{}: {==}
    case 0n Con{h, t}: Empty.absurd({N.digits(0n, N.value(h <> t)) == h <> t : +List<U32>}, F.false_true(Equal.cong(Nat, Bool, n => Nat.is_eq(n, 0n), 1n+List.length(&2, U32, t), 0n, sized)))
    case 1n+p Nil{}: Empty.absurd({N.digits(1n+p, N.value([])) == [] : +List<U32>}, F.false_true(Equal.sym(Bool, True{}, False{}, Equal.cong(Nat, Bool, n => Nat.is_eq(n, 0n), 0n, 1n+p, sized))))
    case 1n+p Con{h, t}:
      %Equal.sym(Nat, Nat.mod(N.value(h <> t), 256n), U32.to_nat(h), value_head(h, t, byte_bound(h, V.and_left(U32.is_lt(h, 256), SP.bytes_domain(t), scope)))) : {U32.from_nat(_) <> N.digits(p, Nat.div(N.value(h <> t), 256n)) == h <> t : +List<U32>}
      %Equal.sym(U32, U32.from_nat(U32.to_nat(h)), h, byte_roundtrip(h, V.and_left(U32.is_lt(h, 256), SP.bytes_domain(t), scope))) : {_ <> N.digits(p, Nat.div(N.value(h <> t), 256n)) == h <> t : +List<U32>}
      %Equal.sym(Nat, Nat.div(N.value(h <> t), 256n), N.value(t), value_tail(h, t, byte_bound(h, V.and_left(U32.is_lt(h, 256), SP.bytes_domain(t), scope)))) : {h <> N.digits(p, _) == h <> t : +List<U32>}
      Equal.cong(+List<U32>, +List<U32>, ys => h <> ys, N.digits(p, N.value(t)), t, digits_of_value(p, t, pred_equal(List.length(&2, U32, t), p, sized), V.and_right(U32.is_lt(h, 256), SP.bytes_domain(t), scope)))
