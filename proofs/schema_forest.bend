law valid_forest:
  for +schema: T.Schema
  for legal: {I.valid_go(schema, True{}) == True{} : Bool}
  {S.finite(schema) == True{} : Bool}
def valid_forest(schema, legal):
  match schema:
    case T.Boolean{}: Empty.absurd({False{} == True{} : Bool}, W.false_true(legal))
    case T.Unsigned{w}: Empty.absurd({False{} == True{} : Bool}, W.false_true(legal))
    case T.ByteVector{n}: Empty.absurd({False{} == True{} : Bool}, W.false_true(legal))
    case T.ByteList{n}: Empty.absurd({False{} == True{} : Bool}, W.false_true(legal))
    case T.BitVector{n}: Empty.absurd({False{} == True{} : Bool}, W.false_true(legal))
    case T.BitList{n}: Empty.absurd({False{} == True{} : Bool}, W.false_true(legal))
    case T.Vector{e, n}: Empty.absurd({False{} == True{} : Bool}, W.false_true(legal))
    case T.ListOf{e, n}: Empty.absurd({False{} == True{} : Bool}, W.false_true(legal))
    case T.Container{names, fields}: Empty.absurd({False{} == True{} : Bool}, W.false_true(legal))
    case T.Union{options}:
      match options:
        case T.Boolean{}: Empty.absurd({False{} == True{} : Bool}, W.false_true(legal))
        case T.Unsigned{v0}: Empty.absurd({False{} == True{} : Bool}, W.false_true(legal))
        case T.ByteVector{v0}: Empty.absurd({False{} == True{} : Bool}, W.false_true(legal))
        case T.ByteList{v0}: Empty.absurd({False{} == True{} : Bool}, W.false_true(legal))
        case T.BitVector{v0}: Empty.absurd({False{} == True{} : Bool}, W.false_true(legal))
        case T.BitList{v0}: Empty.absurd({False{} == True{} : Bool}, W.false_true(legal))
        case T.Vector{v0, v1}: Empty.absurd({False{} == True{} : Bool}, W.false_true(legal))
        case T.ListOf{v0, v1}: Empty.absurd({False{} == True{} : Bool}, W.false_true(legal))
        case T.Container{v0, v1}: Empty.absurd({False{} == True{} : Bool}, W.false_true(legal))
        case T.Union{v0}: Empty.absurd({False{} == True{} : Bool}, W.false_true(legal))
        case T.Null{}: Empty.absurd({False{} == True{} : Bool}, W.false_true(legal))
        case T.Chain{h, t}:
          match h:
            case T.Boolean{}: Empty.absurd({False{} == True{} : Bool}, W.false_true(legal))
            case T.Unsigned{v0}: Empty.absurd({False{} == True{} : Bool}, W.false_true(legal))
            case T.ByteVector{v0}: Empty.absurd({False{} == True{} : Bool}, W.false_true(legal))
            case T.ByteList{v0}: Empty.absurd({False{} == True{} : Bool}, W.false_true(legal))
            case T.BitVector{v0}: Empty.absurd({False{} == True{} : Bool}, W.false_true(legal))
            case T.BitList{v0}: Empty.absurd({False{} == True{} : Bool}, W.false_true(legal))
            case T.Vector{v0, v1}: Empty.absurd({False{} == True{} : Bool}, W.false_true(legal))
            case T.ListOf{v0, v1}: Empty.absurd({False{} == True{} : Bool}, W.false_true(legal))
            case T.Container{v0, v1}: Empty.absurd({False{} == True{} : Bool}, W.false_true(legal))
            case T.Union{v0}: Empty.absurd({False{} == True{} : Bool}, W.false_true(legal))
            case T.Null{}: Empty.absurd({False{} == True{} : Bool}, W.false_true(legal))
            case T.Chain{v0, v1}: Empty.absurd({False{} == True{} : Bool}, W.false_true(legal))
            case T.End{}: Empty.absurd({False{} == True{} : Bool}, W.false_true(legal))
            case T.Repeat{v0}: Empty.absurd({False{} == True{} : Bool}, W.false_true(legal))
            case T.Named{v0, v1}: Empty.absurd({False{} == True{} : Bool}, W.false_true(legal))
            case T.ProgressiveList{v0}: Empty.absurd({False{} == True{} : Bool}, W.false_true(legal))
            case T.ProgressiveBits{}: Empty.absurd({False{} == True{} : Bool}, W.false_true(legal))
            case T.ProgressiveContainer{v0, v1, v2}: Empty.absurd({False{} == True{} : Bool}, W.false_true(legal))
            case T.CompatibleUnion{v0, v1}: Empty.absurd({False{} == True{} : Bool}, W.false_true(legal))
        case T.End{}: Empty.absurd({False{} == True{} : Bool}, W.false_true(legal))
        case T.Repeat{v0}: Empty.absurd({False{} == True{} : Bool}, W.false_true(legal))
        case T.Named{v0, v1}: Empty.absurd({False{} == True{} : Bool}, W.false_true(legal))
        case T.ProgressiveList{v0}: Empty.absurd({False{} == True{} : Bool}, W.false_true(legal))
