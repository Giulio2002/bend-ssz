    case T.ProgressiveBits{}: Empty.absurd({False{} == True{} : Bool}, W.false_true(legal))
    case T.ProgressiveContainer{names, fields, active}: Empty.absurd({False{} == True{} : Bool}, W.false_true(legal))
    case T.CompatibleUnion{selectors, options}: Empty.absurd({False{} == True{} : Bool}, W.false_true(legal))

law chain_head_well_formed:
  for +h: T.Schema
  for +t: T.Schema
  for legal: {S.well_formed(T.Chain{h, t}) == True{} : Bool}
  {S.well_formed(h) == True{} : Bool}
def chain_head_well_formed(h, t, legal):
  V.and_left(S.well_formed(h), Bool.and(S.finite(t), S.well_formed(t)), legal)

law chain_tail_finite:
  for +h: T.Schema
  for +t: T.Schema
  for legal: {S.well_formed(T.Chain{h, t}) == True{} : Bool}
  {S.finite(t) == True{} : Bool}
def chain_tail_finite(h, t, legal):
  V.and_left(S.finite(t), S.well_formed(t), V.and_right(S.well_formed(h), Bool.and(S.finite(t), S.well_formed(t)), legal))

law chain_tail_well_formed:
  for +h: T.Schema
  for +t: T.Schema
  for legal: {S.well_formed(T.Chain{h, t}) == True{} : Bool}
  {S.well_formed(t) == True{} : Bool}
def chain_tail_well_formed(h, t, legal):
  V.and_right(S.finite(t), S.well_formed(t), V.and_right(S.well_formed(h), Bool.and(S.finite(t), S.well_formed(t)), legal))

