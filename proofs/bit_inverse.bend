law octet_word:
  for +b0: Bool
  for +b1: Bool
  for +b2: Bool
  for +b3: Bool
  for +b4: Bool
  for +b5: Bool
  for +b6: Bool
  for +b7: Bool
  {P.octet(b0, b1, b2, b3, b4, b5, b6, b7) == Words.embed8(WCon{b0, WCon{b1, WCon{b2, WCon{b3, WCon{b4, WCon{b5, WCon{b6, WCon{b7, WNil{}}}}}}}}}) : U32}
def octet_word(b0, b1, b2, b3, b4, b5, b6, b7):
