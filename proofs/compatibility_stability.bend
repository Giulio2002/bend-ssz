              Empty.absurd({I.compatible_go(1n+p, 3, T.Boolean{}, T.ProgressiveContainer{b0, b1, b2}) == I.compatible_go(1n+Nat.add(p, extra), 3, T.Boolean{}, T.ProgressiveContainer{b0, b1, b2}) : Bool}, W.false_true(left_shape))
            case T.Boolean{} T.CompatibleUnion{b0, b1}:
              (left_shape, right_shape) = shape
              Empty.absurd({I.compatible_go(1n+p, 3, T.Boolean{}, T.CompatibleUnion{b0, b1}) == I.compatible_go(1n+Nat.add(p, extra), 3, T.Boolean{}, T.CompatibleUnion{b0, b1}) : Bool}, W.false_true(left_shape))
            case T.Unsigned{a0} T.Boolean{}:
