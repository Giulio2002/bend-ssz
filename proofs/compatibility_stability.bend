              Empty.absurd({I.compatible_go(1n+p, 3, T.Unsigned{a0}, T.ByteList{b0}) == I.compatible_go(1n+Nat.add(p, extra), 3, T.Unsigned{a0}, T.ByteList{b0}) : Bool}, W.false_true(left_shape))
            case T.Unsigned{a0} T.BitVector{b0}:
