              Empty.absurd({I.compatible_go(1n+p, 3, T.Boolean{}, T.ProgressiveList{b0}) == I.compatible_go(1n+Nat.add(p, extra), 3, T.Boolean{}, T.ProgressiveList{b0}) : Bool}, W.false_true(left_shape))
            case T.Boolean{} T.ProgressiveBits{}:
