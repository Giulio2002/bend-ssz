              Empty.absurd({I.compatible_go(1n+p, 3, T.Unsigned{a0}, T.Chain{T.Boolean{}, b1}) == I.compatible_go(1n+Nat.add(p, extra), 3, T.Unsigned{a0}, T.Chain{T.Boolean{}, b1}) : Bool}, W.false_true(left_shape))
            case T.Unsigned{a0} T.Chain{T.Unsigned{bc0}, b1}:
