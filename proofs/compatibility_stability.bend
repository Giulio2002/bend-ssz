import Base
import ../types/schema.bend as T
import ../src/schema.bend as I
import ../spec/compatibility.bend as S
import ./compatibility_soundness.bend as Sound
import ./compatibility_bounded.bend as B
import ./compatibility_slot_shape.bend as Shape
import ./compatibility_rank.bend as R
import ./nat_order.bend as O
import ./primitive_invariants.bend as V
import ./word_facts.bend as W
import ./compatibility_choice.bend as Choice

law and_equal:
  for +a: Bool
  for +b: Bool
  for +c: Bool
  for +d: Bool
  for left: {a == c : Bool}
  for right: {b == d : Bool}
  {Bool.and(a, b) == Bool.and(c, d) : Bool}
def and_equal(a, b, c, d, left, right):
  %left : {Bool.and(a, b) == Bool.and(_, d) : Bool}
  %right : {Bool.and(a, b) == Bool.and(a, _) : Bool}
  {==}

# Extra fuel cannot affect a traversal once the structural rank is met.
# Recursive active-list bounds are derived from legal public types separately.
law stable:
  for +fuel: Nat
  for +extra: Nat
  for +mode: S.Judgement
  for +a: T.Schema
  for +b: T.Schema
  for shape: Sound.requirement(mode, a, b)
  for +safe_a: {B.bounded(a) == True{} : Bool}
  for +safe_b: {B.bounded(b) == True{} : Bool}
  for +enough: {Nat.is_le(R.rank(mode, a, b), fuel) == True{} : Bool}
  {I.compatible_go(fuel, Sound.code(mode), a, b) == I.compatible_go(Nat.add(fuel, extra), Sound.code(mode), a, b) : Bool}
def stable(fuel, extra, mode, a, b, shape, safe_a, safe_b, enough):
  match fuel:
    case 0n: Empty.absurd({I.compatible_go(0n, Sound.code(mode), a, b) == I.compatible_go(extra, Sound.code(mode), a, b) : Bool}, W.false_true(O.transitive(1n, R.rank(mode, a, b), 0n, R.positive(mode, a, b), enough)))
    case 1n+p:
      match mode:
        case S.All{}:
          match a:
            case T.Boolean{}: {==}
            case T.Unsigned{x0}: {==}
            case T.ByteVector{x0}: {==}
            case T.ByteList{x0}: {==}
            case T.BitVector{x0}: {==}
            case T.BitList{x0}: {==}
            case T.Vector{x0, x1}: {==}
            case T.ListOf{x0, x1}: {==}
            case T.Container{x0, x1}: {==}
            case T.Union{x0}: {==}
            case T.Null{}: {==}
            case T.Chain{x0, x1}: and_equal(I.compatible_go(p, 2, x0, b), I.compatible_go(p, 1, x1, b), I.compatible_go(Nat.add(p, extra), 2, x0, b), I.compatible_go(Nat.add(p, extra), 1, x1, b), stable(p, extra, S.Row{}, x0, b, Unit{}, V.and_left(B.bounded(x0), B.bounded(x1), safe_a), safe_b, R.child_budget(R.rank(S.Row{}, x0, b), R.rank(S.All{}, T.Chain{x0, x1}, b), p, R.left_step(x0, b, T.Chain{x0, x1}, b, R.chain_head(x0, x1), O.reflexive(I.weight(b))), enough)), stable(p, extra, S.All{}, x1, b, Unit{}, V.and_right(B.bounded(x0), B.bounded(x1), safe_a), safe_b, R.child_budget(R.rank(S.All{}, x1, b), R.rank(S.All{}, T.Chain{x0, x1}, b), p, R.left_step(x1, b, T.Chain{x0, x1}, b, R.chain_tail(x0, x1), O.reflexive(I.weight(b))), enough)))
            case T.End{}: {==}
            case T.Repeat{x0}: {==}
            case T.Named{x0, x1}: {==}
            case T.ProgressiveList{x0}: {==}
            case T.ProgressiveBits{}: {==}
            case T.ProgressiveContainer{x0, x1, x2}: {==}
            case T.CompatibleUnion{x0, x1}: {==}
        case S.Row{}:
          match b:
            case T.Boolean{}: {==}
            case T.Unsigned{x0}: {==}
            case T.ByteVector{x0}: {==}
            case T.ByteList{x0}: {==}
            case T.BitVector{x0}: {==}
            case T.BitList{x0}: {==}
            case T.Vector{x0, x1}: {==}
            case T.ListOf{x0, x1}: {==}
            case T.Container{x0, x1}: {==}
            case T.Union{x0}: {==}
            case T.Null{}: {==}
            case T.Chain{x0, x1}: and_equal(I.compatible_go(p, 0, a, x0), I.compatible_go(p, 2, a, x1), I.compatible_go(Nat.add(p, extra), 0, a, x0), I.compatible_go(Nat.add(p, extra), 2, a, x1), stable(p, extra, S.Pair{}, a, x0, Unit{}, safe_a, V.and_left(B.bounded(x0), B.bounded(x1), safe_b), R.child_budget(R.rank(S.Pair{}, a, x0), R.rank(S.Row{}, a, T.Chain{x0, x1}), p, R.right_step(a, x0, a, T.Chain{x0, x1}, O.reflexive(I.weight(a)), R.chain_head(x0, x1)), enough)), stable(p, extra, S.Row{}, a, x1, Unit{}, safe_a, V.and_right(B.bounded(x0), B.bounded(x1), safe_b), R.child_budget(R.rank(S.Row{}, a, x1), R.rank(S.Row{}, a, T.Chain{x0, x1}), p, R.right_step(a, x1, a, T.Chain{x0, x1}, O.reflexive(I.weight(a)), R.chain_tail(x0, x1)), enough)))
            case T.End{}: {==}
            case T.Repeat{x0}: {==}
            case T.Named{x0, x1}: {==}
            case T.ProgressiveList{x0}: {==}
            case T.ProgressiveBits{}: {==}
            case T.ProgressiveContainer{x0, x1, x2}: {==}
            case T.CompatibleUnion{x0, x1}: {==}
        case S.Slots{}:
          match a b:
            case T.Boolean{} T.Boolean{}:
              (left_shape, right_shape) = shape
              Empty.absurd({I.compatible_go(1n+p, 3, T.Boolean{}, T.Boolean{}) == I.compatible_go(1n+Nat.add(p, extra), 3, T.Boolean{}, T.Boolean{}) : Bool}, W.false_true(left_shape))
            case T.Boolean{} T.Unsigned{b0}:
              (left_shape, right_shape) = shape
              Empty.absurd({I.compatible_go(1n+p, 3, T.Boolean{}, T.Unsigned{b0}) == I.compatible_go(1n+Nat.add(p, extra), 3, T.Boolean{}, T.Unsigned{b0}) : Bool}, W.false_true(left_shape))
            case T.Boolean{} T.ByteVector{b0}:
              (left_shape, right_shape) = shape
              Empty.absurd({I.compatible_go(1n+p, 3, T.Boolean{}, T.ByteVector{b0}) == I.compatible_go(1n+Nat.add(p, extra), 3, T.Boolean{}, T.ByteVector{b0}) : Bool}, W.false_true(left_shape))
            case T.Boolean{} T.ByteList{b0}:
              (left_shape, right_shape) = shape
              Empty.absurd({I.compatible_go(1n+p, 3, T.Boolean{}, T.ByteList{b0}) == I.compatible_go(1n+Nat.add(p, extra), 3, T.Boolean{}, T.ByteList{b0}) : Bool}, W.false_true(left_shape))
            case T.Boolean{} T.BitVector{b0}:
              (left_shape, right_shape) = shape
              Empty.absurd({I.compatible_go(1n+p, 3, T.Boolean{}, T.BitVector{b0}) == I.compatible_go(1n+Nat.add(p, extra), 3, T.Boolean{}, T.BitVector{b0}) : Bool}, W.false_true(left_shape))
            case T.Boolean{} T.BitList{b0}:
              (left_shape, right_shape) = shape
              Empty.absurd({I.compatible_go(1n+p, 3, T.Boolean{}, T.BitList{b0}) == I.compatible_go(1n+Nat.add(p, extra), 3, T.Boolean{}, T.BitList{b0}) : Bool}, W.false_true(left_shape))
            case T.Boolean{} T.Vector{b0, b1}:
              (left_shape, right_shape) = shape
              Empty.absurd({I.compatible_go(1n+p, 3, T.Boolean{}, T.Vector{b0, b1}) == I.compatible_go(1n+Nat.add(p, extra), 3, T.Boolean{}, T.Vector{b0, b1}) : Bool}, W.false_true(left_shape))
            case T.Boolean{} T.ListOf{b0, b1}:
              (left_shape, right_shape) = shape
              Empty.absurd({I.compatible_go(1n+p, 3, T.Boolean{}, T.ListOf{b0, b1}) == I.compatible_go(1n+Nat.add(p, extra), 3, T.Boolean{}, T.ListOf{b0, b1}) : Bool}, W.false_true(left_shape))
            case T.Boolean{} T.Container{b0, b1}:
              (left_shape, right_shape) = shape
              Empty.absurd({I.compatible_go(1n+p, 3, T.Boolean{}, T.Container{b0, b1}) == I.compatible_go(1n+Nat.add(p, extra), 3, T.Boolean{}, T.Container{b0, b1}) : Bool}, W.false_true(left_shape))
            case T.Boolean{} T.Union{b0}:
