              Empty.absurd({I.compatible_go(1n+p, 3, T.Boolean{}, T.Union{b0}) == I.compatible_go(1n+Nat.add(p, extra), 3, T.Boolean{}, T.Union{b0}) : Bool}, W.false_true(left_shape))
            case T.Boolean{} T.Null{}:
              (left_shape, right_shape) = shape
              Empty.absurd({I.compatible_go(1n+p, 3, T.Boolean{}, T.Null{}) == I.compatible_go(1n+Nat.add(p, extra), 3, T.Boolean{}, T.Null{}) : Bool}, W.false_true(left_shape))
            case T.Boolean{} T.Chain{T.Boolean{}, b1}:
              (left_shape, right_shape) = shape
              Empty.absurd({I.compatible_go(1n+p, 3, T.Boolean{}, T.Chain{T.Boolean{}, b1}) == I.compatible_go(1n+Nat.add(p, extra), 3, T.Boolean{}, T.Chain{T.Boolean{}, b1}) : Bool}, W.false_true(left_shape))
            case T.Boolean{} T.Chain{T.Unsigned{bc0}, b1}:
              (left_shape, right_shape) = shape
              Empty.absurd({I.compatible_go(1n+p, 3, T.Boolean{}, T.Chain{T.Unsigned{bc0}, b1}) == I.compatible_go(1n+Nat.add(p, extra), 3, T.Boolean{}, T.Chain{T.Unsigned{bc0}, b1}) : Bool}, W.false_true(left_shape))
            case T.Boolean{} T.Chain{T.ByteVector{bc0}, b1}:
              (left_shape, right_shape) = shape
              Empty.absurd({I.compatible_go(1n+p, 3, T.Boolean{}, T.Chain{T.ByteVector{bc0}, b1}) == I.compatible_go(1n+Nat.add(p, extra), 3, T.Boolean{}, T.Chain{T.ByteVector{bc0}, b1}) : Bool}, W.false_true(left_shape))
            case T.Boolean{} T.Chain{T.ByteList{bc0}, b1}:
              (left_shape, right_shape) = shape
              Empty.absurd({I.compatible_go(1n+p, 3, T.Boolean{}, T.Chain{T.ByteList{bc0}, b1}) == I.compatible_go(1n+Nat.add(p, extra), 3, T.Boolean{}, T.Chain{T.ByteList{bc0}, b1}) : Bool}, W.false_true(left_shape))
            case T.Boolean{} T.Chain{T.BitVector{bc0}, b1}:
              (left_shape, right_shape) = shape
              Empty.absurd({I.compatible_go(1n+p, 3, T.Boolean{}, T.Chain{T.BitVector{bc0}, b1}) == I.compatible_go(1n+Nat.add(p, extra), 3, T.Boolean{}, T.Chain{T.BitVector{bc0}, b1}) : Bool}, W.false_true(left_shape))
            case T.Boolean{} T.Chain{T.BitList{bc0}, b1}:
              (left_shape, right_shape) = shape
              Empty.absurd({I.compatible_go(1n+p, 3, T.Boolean{}, T.Chain{T.BitList{bc0}, b1}) == I.compatible_go(1n+Nat.add(p, extra), 3, T.Boolean{}, T.Chain{T.BitList{bc0}, b1}) : Bool}, W.false_true(left_shape))
            case T.Boolean{} T.Chain{T.Vector{bc0, bc1}, b1}:
              (left_shape, right_shape) = shape
              Empty.absurd({I.compatible_go(1n+p, 3, T.Boolean{}, T.Chain{T.Vector{bc0, bc1}, b1}) == I.compatible_go(1n+Nat.add(p, extra), 3, T.Boolean{}, T.Chain{T.Vector{bc0, bc1}, b1}) : Bool}, W.false_true(left_shape))
            case T.Boolean{} T.Chain{T.ListOf{bc0, bc1}, b1}:
              (left_shape, right_shape) = shape
              Empty.absurd({I.compatible_go(1n+p, 3, T.Boolean{}, T.Chain{T.ListOf{bc0, bc1}, b1}) == I.compatible_go(1n+Nat.add(p, extra), 3, T.Boolean{}, T.Chain{T.ListOf{bc0, bc1}, b1}) : Bool}, W.false_true(left_shape))
            case T.Boolean{} T.Chain{T.Container{bc0, bc1}, b1}:
              (left_shape, right_shape) = shape
              Empty.absurd({I.compatible_go(1n+p, 3, T.Boolean{}, T.Chain{T.Container{bc0, bc1}, b1}) == I.compatible_go(1n+Nat.add(p, extra), 3, T.Boolean{}, T.Chain{T.Container{bc0, bc1}, b1}) : Bool}, W.false_true(left_shape))
            case T.Boolean{} T.Chain{T.Union{bc0}, b1}:
              (left_shape, right_shape) = shape
              Empty.absurd({I.compatible_go(1n+p, 3, T.Boolean{}, T.Chain{T.Union{bc0}, b1}) == I.compatible_go(1n+Nat.add(p, extra), 3, T.Boolean{}, T.Chain{T.Union{bc0}, b1}) : Bool}, W.false_true(left_shape))
            case T.Boolean{} T.Chain{T.Null{}, b1}:
              (left_shape, right_shape) = shape
              Empty.absurd({I.compatible_go(1n+p, 3, T.Boolean{}, T.Chain{T.Null{}, b1}) == I.compatible_go(1n+Nat.add(p, extra), 3, T.Boolean{}, T.Chain{T.Null{}, b1}) : Bool}, W.false_true(left_shape))
            case T.Boolean{} T.Chain{T.Chain{bc0, bc1}, b1}:
              (left_shape, right_shape) = shape
              Empty.absurd({I.compatible_go(1n+p, 3, T.Boolean{}, T.Chain{T.Chain{bc0, bc1}, b1}) == I.compatible_go(1n+Nat.add(p, extra), 3, T.Boolean{}, T.Chain{T.Chain{bc0, bc1}, b1}) : Bool}, W.false_true(left_shape))
            case T.Boolean{} T.Chain{T.End{}, b1}:
              (left_shape, right_shape) = shape
              Empty.absurd({I.compatible_go(1n+p, 3, T.Boolean{}, T.Chain{T.End{}, b1}) == I.compatible_go(1n+Nat.add(p, extra), 3, T.Boolean{}, T.Chain{T.End{}, b1}) : Bool}, W.false_true(left_shape))
            case T.Boolean{} T.Chain{T.Repeat{bc0}, b1}:
              (left_shape, right_shape) = shape
              Empty.absurd({I.compatible_go(1n+p, 3, T.Boolean{}, T.Chain{T.Repeat{bc0}, b1}) == I.compatible_go(1n+Nat.add(p, extra), 3, T.Boolean{}, T.Chain{T.Repeat{bc0}, b1}) : Bool}, W.false_true(left_shape))
            case T.Boolean{} T.Chain{T.Named{bc0, bc1}, b1}:
              (left_shape, right_shape) = shape
              Empty.absurd({I.compatible_go(1n+p, 3, T.Boolean{}, T.Chain{T.Named{bc0, bc1}, b1}) == I.compatible_go(1n+Nat.add(p, extra), 3, T.Boolean{}, T.Chain{T.Named{bc0, bc1}, b1}) : Bool}, W.false_true(left_shape))
            case T.Boolean{} T.Chain{T.ProgressiveList{bc0}, b1}:
              (left_shape, right_shape) = shape
              Empty.absurd({I.compatible_go(1n+p, 3, T.Boolean{}, T.Chain{T.ProgressiveList{bc0}, b1}) == I.compatible_go(1n+Nat.add(p, extra), 3, T.Boolean{}, T.Chain{T.ProgressiveList{bc0}, b1}) : Bool}, W.false_true(left_shape))
            case T.Boolean{} T.Chain{T.ProgressiveBits{}, b1}:
              (left_shape, right_shape) = shape
              Empty.absurd({I.compatible_go(1n+p, 3, T.Boolean{}, T.Chain{T.ProgressiveBits{}, b1}) == I.compatible_go(1n+Nat.add(p, extra), 3, T.Boolean{}, T.Chain{T.ProgressiveBits{}, b1}) : Bool}, W.false_true(left_shape))
            case T.Boolean{} T.Chain{T.ProgressiveContainer{bc0, bc1, bc2}, b1}:
              (left_shape, right_shape) = shape
              Empty.absurd({I.compatible_go(1n+p, 3, T.Boolean{}, T.Chain{T.ProgressiveContainer{bc0, bc1, bc2}, b1}) == I.compatible_go(1n+Nat.add(p, extra), 3, T.Boolean{}, T.Chain{T.ProgressiveContainer{bc0, bc1, bc2}, b1}) : Bool}, W.false_true(left_shape))
            case T.Boolean{} T.Chain{T.CompatibleUnion{bc0, bc1}, b1}:
              (left_shape, right_shape) = shape
              Empty.absurd({I.compatible_go(1n+p, 3, T.Boolean{}, T.Chain{T.CompatibleUnion{bc0, bc1}, b1}) == I.compatible_go(1n+Nat.add(p, extra), 3, T.Boolean{}, T.Chain{T.CompatibleUnion{bc0, bc1}, b1}) : Bool}, W.false_true(left_shape))
            case T.Boolean{} T.End{}:
              {==}
            case T.Boolean{} T.Repeat{b0}:
              (left_shape, right_shape) = shape
              Empty.absurd({I.compatible_go(1n+p, 3, T.Boolean{}, T.Repeat{b0}) == I.compatible_go(1n+Nat.add(p, extra), 3, T.Boolean{}, T.Repeat{b0}) : Bool}, W.false_true(left_shape))
            case T.Boolean{} T.Named{b0, b1}:
