              Empty.absurd({I.compatible_go(1n+p, 3, T.Boolean{}, T.ProgressiveBits{}) == I.compatible_go(1n+Nat.add(p, extra), 3, T.Boolean{}, T.ProgressiveBits{}) : Bool}, W.false_true(left_shape))
            case T.Boolean{} T.ProgressiveContainer{b0, b1, b2}:
