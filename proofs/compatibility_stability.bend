              Empty.absurd({I.compatible_go(1n+p, 3, T.Unsigned{a0}, T.Boolean{}) == I.compatible_go(1n+Nat.add(p, extra), 3, T.Unsigned{a0}, T.Boolean{}) : Bool}, W.false_true(left_shape))
