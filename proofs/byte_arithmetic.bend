    case U32{w}:
      Equal.cong(Word(32n), U32, w => U32{w},
        Word.add(32n, Word.zero(32n), D.bits(U32.shln(U32{w}, 16n))),
        D.bits(U32.shln(U32{w}, 16n)), B.add_zero_left(32n, D.bits(U32.shln(U32{w}, 16n))))


