law multiply_shift8:
  for +x: U32
  {U32.mul(256, x) == U32.shln(x, 8n) : U32}
def multiply_shift8(x):
  match x:
    case U32{w}:
      Equal.cong(Word(32n), U32, w => U32{w},
        Word.add(32n, Word.zero(32n), D.bits(U32.shln(U32{w}, 8n))),
        D.bits(U32.shln(U32{w}, 8n)), B.add_zero_left(32n, D.bits(U32.shln(U32{w}, 8n))))


law multiply_shift16:
  for +x: U32
