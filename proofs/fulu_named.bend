law complete:
  for +name: F.Name
  for +original: T.Value
  for +shape: {Shape.shape(original, Shape.erase(F.Name.schema(name))) == True{} : Bool}
  {Complete.present(F.Name.Value(name), F.Name.from_ssz(name, original)) == True{} : Bool}
def complete(name, original, shape):
  match name:
    case F.Name_boolean{}: Complete.Node0_complete(original, shape)
    case F.Name_uint8{}: Complete.Node1_complete(original, shape)
    case F.Name_uint32{}: Complete.Node2_complete(original, shape)
    case F.Name_uint64{}: Complete.Node3_complete(original, shape)
    case F.Name_uint256{}: Complete.Node4_complete(original, shape)
    case F.Name_Bytes1{}: Complete.Node5_complete(original, shape)
    case F.Name_Bytes4{}: Complete.Node6_complete(original, shape)
    case F.Name_Bytes32{}: Complete.Node7_complete(original, shape)
    case F.Name_Bytes48{}: Complete.Node8_complete(original, shape)
    case F.Name_Bytes96{}: Complete.Node9_complete(original, shape)
    case F.Name_Bytes8{}: Complete.Node10_complete(original, shape)
    case F.Name_Bytes20{}: Complete.Node11_complete(original, shape)
    case F.Name_Slot{}: Complete.Node3_complete(original, shape)
    case F.Name_Epoch{}: Complete.Node3_complete(original, shape)
    case F.Name_Gwei{}: Complete.Node3_complete(original, shape)
    case F.Name_Hash32{}: Complete.Node7_complete(original, shape)
    case F.Name_Version{}: Complete.Node6_complete(original, shape)
    case F.Name_DomainType{}: Complete.Node6_complete(original, shape)
    case F.Name_BLSSignature{}: Complete.Node9_complete(original, shape)
    case F.Name_FinalityBranch{}: Complete.Node12_complete(original, shape)
    case F.Name_VersionedHash{}: Complete.Node7_complete(original, shape)
    case F.Name_G1Point{}: Complete.Node8_complete(original, shape)
    case F.Name_G2Point{}: Complete.Node9_complete(original, shape)
    case F.Name_Fork{}: Complete.ForkValue_complete(original, shape)
    case F.Name_SyncAggregate{}: Complete.SyncAggregateValue_complete(original, shape)
    case F.Name_SyncAggregatorSelectionData{}: Complete.SyncAggregatorSelectionDataValue_complete(original, shape)
    case F.Name_PowBlock{}: Complete.PowBlockValue_complete(original, shape)
    case F.Name_CommitteeIndex{}: Complete.Node3_complete(original, shape)
    case F.Name_ValidatorIndex{}: Complete.Node3_complete(original, shape)
