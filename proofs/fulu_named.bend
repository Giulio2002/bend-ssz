law sound:
  for +name: F.Name
  for +original: T.Value
  preserves(name, original, F.Name.from_ssz(name, original))
def sound(name, original):
  match name:
    case F.Name_boolean{}: boolean_bridge(original, F.Node0.from_value(original), Preservation.Node0_sound(original))
    case F.Name_uint8{}: uint8_bridge(original, F.Node1.from_value(original), Preservation.Node1_sound(original))
    case F.Name_uint32{}: uint32_bridge(original, F.Node2.from_value(original), Preservation.Node2_sound(original))
