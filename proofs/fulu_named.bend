def preserves(name: F.Name, original: T.Value, result: Maybe<&2, F.Name.Value(name)>) -> Type:
  match result:
    case None{}: Unit
    case Some{value}: {F.Name.to_ssz(name, value) == original : T.Value}

law boolean_bridge:
  for +original: T.Value
  for +result: Maybe<&2, F.Node0()>
  for known: Preservation.Node0_preserves(original, result)
  preserves(F.Name_boolean{}, original, result)
def boolean_bridge(original, result, known):
  match result:
    case None{}: Unit{}
    case Some{value}: known

