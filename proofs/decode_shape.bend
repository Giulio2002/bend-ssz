law head_single:
  for +schema: T.Schema
  for +value: T.Value
  for +result: Maybe<&2, +List<T.Part>>
  for legal: {I.valid_go(schema, False{}) == True{} : Bool}
  for known: F.fact(schema, value, result)
  F.single_result(SS.fixed_size(schema), result)
def head_single(schema, value, result, legal, known):
  match schema:
    case T.Boolean{}: known
    case T.Unsigned{s0}: known
    case T.ByteVector{s0}: known
    case T.ByteList{s0}: known
    case T.BitVector{s0}: known
    case T.BitList{s0}: known
    case T.Vector{s0, s1}: known
    case T.ListOf{s0, s1}: known
    case T.Container{s0, s1}: known
    case T.Union{s0}: known
    case T.Null{}: known
    case T.Chain{s0, s1}: Empty.absurd(F.single_result(SS.fixed_size(T.Chain{s0, s1}), result), W.false_true(legal))
    case T.End{}: Empty.absurd(F.single_result(SS.fixed_size(T.End{}), result), W.false_true(legal))
    case T.Repeat{s0}: Empty.absurd(F.single_result(SS.fixed_size(T.Repeat{s0}), result), W.false_true(legal))
    case T.Named{s0, s1}: known
    case T.ProgressiveList{s0}: known
    case T.ProgressiveBits{}: known
    case T.ProgressiveContainer{s0, s1, s2}: known
    case T.CompatibleUnion{s0, s1}: known

