    -> {vec_uint256_3_e.v3_u256_put(F.array__thaw(U32, D), pos, O.Words{F.array__thaw(U32, S), 96}) == vec_uint256_3_e.v3_u256_pw(False{}, F.array__thaw(U32, D), pos, F.array__thaw(U32, S), 96) : Array<U32> & O.Words}:
  +ec = vec_uint256_3_acg(U32.shrn(pos, 2n), Q, ds, dd, S, D, eq, hs, hdd, hA, hB, ps, pd)
  +pa = AC.put_al(F.array__thaw(U32, D), F.array__thaw(U32, S), pos, 96, (F.array__thaw(U32, AC.cpt(dd, 24n, 0n, Q, D, F.array__slots(U32, S))), F.array__thaw(U32, S)), {==}, e3, {==}, ec)
  %Equal.sym(Array<U32> & O.Words, O.put_words(F.array__thaw(U32, D), pos, O.Words{F.array__thaw(U32, S), 96}), O.put_fin(96, (F.array__thaw(U32, AC.cpt(dd, 24n, 0n, Q, D, F.array__slots(U32, S))), F.array__thaw(U32, S))), pa) :
    {vec_uint256_3_e.v3_u256_put(F.array__thaw(U32, D), pos, O.Words{F.array__thaw(U32, S), 96}) == _ : Array<U32> & O.Words}
  %Equal.sym(U32, U32.and(pos, 3), 0, e3) :
    {vec_uint256_3_e.v3_u256_pw(U32.is_eq(_, 0), F.array__thaw(U32, D), pos, F.array__thaw(U32, S), 96) == O.put_fin(96, (F.array__thaw(U32, AC.cpt(dd, 24n, 0n, Q, D, F.array__slots(U32, S))), F.array__thaw(U32, S))) : Array<U32> & O.Words}
