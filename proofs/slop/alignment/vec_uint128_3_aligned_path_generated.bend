    {Nat.sub(_, U32.to_nat(4)) == Nat.add(8n, Bn) : Nat}
  {==}

def vec_uint128_3_acg(+b: U32, +Bn: Nat, +ds: Nat, +dd: Nat, +S: F.array__Tree<U32>, +D: F.array__Tree<U32>, +eb: {U32.to_nat(b) == Bn : Nat}, +hs: {Nat.is_lt(ds, 32n) == True{} : Bool}, +hdd: {Nat.is_lt(dd, 32n) == True{} : Bool}, +hA: {Nat.is_le(Nat.add(12n, 0n), F.spec_common__pow2(ds)) == True{} : Bool}, +hB: {Nat.is_le(Nat.add(12n, Bn), F.spec_common__pow2(dd)) == True{} : Bool}, +ps: {F.array__perfect(U32, ds, S) == True{} : Bool}, +pd: {F.array__perfect(U32, dd, D) == True{} : Bool})
    -> {O.acopy(12, 0, b, F.array__thaw(U32, D), F.array__thaw(U32, S)) == (F.array__thaw(U32, AC.cpt(dd, 12n, 0n, Bn, D, F.array__slots(U32, S))), F.array__thaw(U32, S)) : Array<U32> & Array<U32>}:
  +hAm = F.nat__le_trans(Nat.add(8n, 0n), Nat.add(12n, 0n), F.spec_common__pow2(ds), {==}, hA)
  +hBm = F.nat__le_trans(Nat.add(8n, Bn), Nat.add(12n, Bn), F.spec_common__pow2(dd), AC.le_addl(4n, Bn), hB)
  +bk = AC.blk(1n, 8n, 0, b, 0n, Bn, ds, dd, S, D, {==}, {==}, eb, hs, hdd, hAm, hBm, ps, pd)
  %Equal.sym(Array<U32> & Array<U32>, O.ac_blk(1n, 0, b, (F.array__thaw(U32, D), F.array__thaw(U32, S))), (F.array__thaw(U32, AC.cpt(dd, 8n, 0n, Bn, D, F.array__slots(U32, S))), F.array__thaw(U32, S)), bk) :
    {O.ac_tail(4n, 8, U32.sub(U32.add(b, 12), 4), _) == (F.array__thaw(U32, AC.cpt(dd, 12n, 0n, Bn, D, F.array__slots(U32, S))), F.array__thaw(U32, S)) : Array<U32> & Array<U32>}
  %Equal.sym(F.array__Tree<U32>, AC.cpt(dd, 12n, 0n, Bn, D, F.array__slots(U32, S)), AC.cpt(dd, 4n, Nat.add(8n, 0n), Nat.add(8n, Bn), AC.cpt(dd, 8n, 0n, Bn, D, F.array__slots(U32, S)), F.array__slots(U32, S)), AC.split(dd, 8n, 4n, 0n, Bn, D, F.array__slots(U32, S))) :
    {O.ac_tail(4n, 8, U32.sub(U32.add(b, 12), 4), (F.array__thaw(U32, AC.cpt(dd, 8n, 0n, Bn, D, F.array__slots(U32, S))), F.array__thaw(U32, S))) == (F.array__thaw(U32, _), F.array__thaw(U32, S)) : Array<U32> & Array<U32>}
  ZL.tl4(8, U32.sub(U32.add(b, 12), 4), Nat.add(8n, 0n), Nat.add(8n, Bn), ds, dd, S, AC.cpt(dd, 8n, 0n, Bn, D, F.array__slots(U32, S)), {==}, vec_uint128_3_sublem(b, Bn, dd, eb, hdd, hB), hs, hdd, hA, hB, ps, AC.cpt_perfect(dd, 8n, 0n, Bn, D, F.array__slots(U32, S), pd))

def vec_uint128_3_cmp_all(+pos: U32, +Q: Nat, +ds: Nat, +dd: Nat, +S: F.array__Tree<U32>, +D: F.array__Tree<U32>, +e3: {(pos .&. 3 : U32) == 0 : U32}, +eq: {U32.to_nat(U32.shrn(pos, 2n)) == Q : Nat}, +hs: {Nat.is_lt(ds, 32n) == True{} : Bool}, +hdd: {Nat.is_lt(dd, 32n) == True{} : Bool}, +hA: {Nat.is_le(Nat.add(12n, 0n), F.spec_common__pow2(ds)) == True{} : Bool}, +hB: {Nat.is_le(Nat.add(12n, Q), F.spec_common__pow2(dd)) == True{} : Bool}, +ps: {F.array__perfect(U32, ds, S) == True{} : Bool}, +pd: {F.array__perfect(U32, dd, D) == True{} : Bool})
    -> {vec_uint128_3_e.v3_u128_put(F.array__thaw(U32, D), pos, O.Words{F.array__thaw(U32, S), 48}) == vec_uint128_3_e.v3_u128_pw(False{}, F.array__thaw(U32, D), pos, F.array__thaw(U32, S), 48) : Array<U32> & O.Words}:
  +ec = vec_uint128_3_acg(U32.shrn(pos, 2n), Q, ds, dd, S, D, eq, hs, hdd, hA, hB, ps, pd)
  +pa = AC.put_al(F.array__thaw(U32, D), F.array__thaw(U32, S), pos, 48, (F.array__thaw(U32, AC.cpt(dd, 12n, 0n, Q, D, F.array__slots(U32, S))), F.array__thaw(U32, S)), {==}, e3, {==}, ec)
  %Equal.sym(Array<U32> & O.Words, O.put_words(F.array__thaw(U32, D), pos, O.Words{F.array__thaw(U32, S), 48}), O.put_fin(48, (F.array__thaw(U32, AC.cpt(dd, 12n, 0n, Q, D, F.array__slots(U32, S))), F.array__thaw(U32, S))), pa) :
    {vec_uint128_3_e.v3_u128_put(F.array__thaw(U32, D), pos, O.Words{F.array__thaw(U32, S), 48}) == _ : Array<U32> & O.Words}
  %Equal.sym(U32, U32.and(pos, 3), 0, e3) :
    {vec_uint128_3_e.v3_u128_pw(U32.is_eq(_, 0), F.array__thaw(U32, D), pos, F.array__thaw(U32, S), 48) == O.put_fin(48, (F.array__thaw(U32, AC.cpt(dd, 12n, 0n, Q, D, F.array__slots(U32, S))), F.array__thaw(U32, S))) : Array<U32> & O.Words}
  vec_uint128_3_fch(U32.shrn(pos, 2n), Q, ds, dd, S, D, eq, hs, hdd, hA, hB, ps, pd)

def vec_uint128_3_cmp_unal(out: Array<U32>, ws: Array<U32>, +pos: U32, +n: U32, +eu: {U32.is_eq((pos .&. 3 : U32), 0) == False{} : Bool})
    -> {vec_uint128_3_e.v3_u128_put(out, pos, O.Words{ws, n}) == vec_uint128_3_e.v3_u128_pw(False{}, out, pos, ws, n) : Array<U32> & O.Words}:
  %Equal.sym(Bool, U32.is_eq((pos .&. 3 : U32), 0), False{}, eu) :
    {vec_uint128_3_e.v3_u128_pw(_, out, pos, ws, n) == vec_uint128_3_e.v3_u128_pw(False{}, out, pos, ws, n) : Array<U32> & O.Words}
  {==}

