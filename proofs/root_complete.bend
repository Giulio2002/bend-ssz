law complete:
  for +value: T.Value
  for +schema: T.Schema
  for +acc: +List<+List<U32>>
  for +size: Nat
  for +legal: {F.ok(schema) == True{} : Bool}
  for +outs: +List<+List<U32>>
  for rel: R.roots(value, schema, outs)
  complete_goal(value, schema, acc, size, outs)
def complete(value, schema, acc, size, legal, outs, rel):
  match value:
    case T.BooleanValue{v0}:
      match schema:
        case T.Boolean{}: C.boolean_complete(v0, outs, rel)
        case T.Unsigned{s0}:
          match rel:
        case T.ByteVector{s0}:
          match rel:
        case T.ByteList{s0}:
          match rel:
        case T.BitVector{s0}:
          match rel:
        case T.BitList{s0}:
          match rel:
        case T.Vector{s0, s1}:
          match rel:
        case T.ListOf{s0, s1}:
          match rel:
        case T.Container{s0, s1}:
          match rel:
        case T.Union{s0}:
          match rel:
        case T.Null{}:
          match rel:
        case T.Chain{s0, s1}:
          match rel:
        case T.End{}:
          match rel:
        case T.Repeat{s0}:
          match rel:
        case T.Named{s0, s1}:
          match rel:
        case T.ProgressiveList{s0}:
          match rel:
        case T.ProgressiveBits{}:
          match rel:
        case T.ProgressiveContainer{s0, s1, s2}:
          match rel:
        case T.CompatibleUnion{s0, s1}:
          match rel:
    case T.UnsignedValue{v0}:
      match schema:
        case T.Boolean{}:
          match rel:
        case T.Unsigned{s0}: C.single_complete(IP.uint_root(s0, v0), SP.uint_hash_tree_root(s0, v0), outs, IntegerRoot.uint_hash_tree_root_correct(s0, v0), rel)
        case T.ByteVector{s0}:
          match rel:
        case T.ByteList{s0}:
          match rel:
        case T.BitVector{s0}:
          match rel:
        case T.BitList{s0}:
          match rel:
        case T.Vector{s0, s1}:
          match rel:
        case T.ListOf{s0, s1}:
          match rel:
        case T.Container{s0, s1}:
