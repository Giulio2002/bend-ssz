# ---------------------------------------------------------------------------
# On the serializable domain the two relations relate exactly the same roots.

def present_bytes(r: Maybe<&2, +List<U32>>) -> Bool:
  match r:
    case None{}: False{}
    case Some{x}: True{}

law parts_of:
  for +r: Maybe<&2, +List<T.Part>>
  for +e: {VD.present(SC.bytes(r)) == True{} : Bool}
  {TS.parts_present(r) == True{} : Bool}
def parts_of(r, e):
  match r:
    case None{}: e
    case Some{ps}: {==}

law serial_parts:
  for +schema: T.Schema
  for +value: T.Value
  for +serial: {VD.serializable(schema, value) == True{} : Bool}
  {TS.parts_present(SC.parts(value, schema)) == True{} : Bool}
def serial_parts(schema, value, serial): parts_of(SC.parts(value, schema), serial)

law encoded_of:
  for +r: Maybe<&2, +List<U32>>
  for +e: {VD.present(r) == True{} : Bool}
  Exists(+List<U32>, encoded => {r == Some{encoded} : Maybe<&2, +List<U32>>})
def encoded_of(r, e):
  match r:
    case None{}: Empty.absurd(Exists(+List<U32>, encoded => {None{} == Some{encoded} : Maybe<&2, +List<U32>>}), W.false_true(e))
    case Some{x}: (x, {==})

law serializable_root_valid:
  for +schema: T.Schema
  for +value: T.Value
  for +serial: {VD.serializable(schema, value) == True{} : Bool}
  {VD.root_valid(value, schema) == True{} : Bool}
def serializable_root_valid(schema, value, serial):
  serializable_valid(value, schema, serial_parts(schema, value, serial))

# The previous root domain is contained in the corrected one.
law serializable_domain_included:
  for +schema: T.Schema
  for +value: T.Value
  for +old: {VD.serializable_root_domain(schema, value) == True{} : Bool}
  {VD.root_domain(schema, value) == True{} : Bool}
def serializable_domain_included(schema, value, old):
  V.and_true(VD.root_valid(value, schema), VD.mixing_lengths(value, schema),
    serializable_root_valid(schema, value, V.and_left(VD.serializable(schema, value), VD.mixing_lengths(value, schema), old)),
    V.and_right(VD.serializable(schema, value), VD.mixing_lengths(value, schema), old))

law relation_to_serializable:
  for +schema: T.Schema
  for +value: T.Value
  for +root: +List<U32>
  for +serial: {VD.serializable(schema, value) == True{} : Bool}
  for rel: R.root_for_legal_type(schema, value, root)
  Old.root_for_legal_type(schema, value, root)
def relation_to_serializable(schema, value, root, serial, rel):
  (valid, roots) = rel
  (encoded_of(SC.encoding_for_legal_type(schema, value), serial), to_serializable(value, schema, [root], serial_parts(schema, value, serial), roots))

law relation_from_serializable:
  for +schema: T.Schema
  for +value: T.Value
  for +root: +List<U32>
  for +serial: {VD.serializable(schema, value) == True{} : Bool}
  for rel: Old.root_for_legal_type(schema, value, root)
  R.root_for_legal_type(schema, value, root)
def relation_from_serializable(schema, value, root, serial, rel):
  (encoded, roots) = rel
  (serializable_root_valid(schema, value, serial), from_serializable(value, schema, [root], serial_parts(schema, value, serial), roots))
