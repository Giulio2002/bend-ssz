law repeat_rel:
  for +items: T.Value
  for +s: T.Schema
  for +w: Nat
  for +eq: {R.basic_size(s) == Some{w} : Maybe<&2, Nat>}
  parts_rel(SC.parts(items, T.Repeat{s}), R.basic_bytes(items, s))
def repeat_rel(items, s, w, eq):
  match items:
    case T.BooleanValue{v0}: Unit{}
    case T.UnsignedValue{v0}: Unit{}
    case T.BytesValue{v0}: Unit{}
    case T.BitsValue{v0}: Unit{}
    case T.Sequence{v0}: Unit{}
    case T.Items{h, t}: concat_rel(SC.parts(h, s), SC.parts(t, T.Repeat{s}), R.basic_one(h, s), R.basic_bytes(t, s), one_rel(h, s, w, eq), repeat_rel(t, s, w, eq))
    case T.EmptyItems{}: (Unit{}, {==})
    case T.Selected{v0, v1}: Unit{}
    case T.NullValue{}: Unit{}

law cons_layout:
  for +xs: +List<U32>
  for +t: +List<T.Part>
  for +offset: Nat
  for pair: {E.fixed_parts(t, offset) == flat(t) : +List<U32>} & {E.payloads(t) == [] : +List<U32>}
  {E.fixed_parts(T.Fixed{xs} <> t, offset) == flat(T.Fixed{xs} <> t) : +List<U32>} & {E.payloads(T.Fixed{xs} <> t) == [] : +List<U32>}
def cons_layout(xs, t, offset, pair):
  (fp, pl) = pair
  (Equal.cong(+List<U32>, +List<U32>, z => List.append(&2, U32, xs, z), E.fixed_parts(t, offset), flat(t), fp), pl)

law fixed_layout:
  for +cps: +List<T.Part>
  for +offset: Nat
  for af: all_fixed(cps)
  {E.fixed_parts(cps, offset) == flat(cps) : +List<U32>} & {E.payloads(cps) == [] : +List<U32>}
def fixed_layout(cps, offset, af):
  match cps:
    case Nil{}: ({==}, {==})
    case Con{h, t}:
      match h:
        case T.Fixed{xs}:
          cons_layout(xs, t, offset, fixed_layout(t, offset, af))
        case T.Variable{xs}:
          match af:

law layout_flat:
  for +cps: +List<T.Part>
  for +offset: Nat
  for pair: {E.fixed_parts(cps, offset) == flat(cps) : +List<U32>} & {E.payloads(cps) == [] : +List<U32>}
  {List.append(&2, U32, E.fixed_parts(cps, offset), E.payloads(cps)) == flat(cps) : +List<U32>}
def layout_flat(cps, offset, pair):
  (fp, pl) = pair
  Equal.trans(+List<U32>, List.append(&2, U32, E.fixed_parts(cps, offset), E.payloads(cps)), List.append(&2, U32, flat(cps), []), flat(cps),
    Equal.trans(+List<U32>, List.append(&2, U32, E.fixed_parts(cps, offset), E.payloads(cps)), List.append(&2, U32, flat(cps), E.payloads(cps)), List.append(&2, U32, flat(cps), []),
      Equal.cong(+List<U32>, +List<U32>, z => List.append(&2, U32, z, E.payloads(cps)), E.fixed_parts(cps, offset), flat(cps), fp),
      Equal.cong(+List<U32>, +List<U32>, z => List.append(&2, U32, flat(cps), z), E.payloads(cps), [], pl)),
    L.append_empty(U32, flat(cps)))

law optional_value:
  for +ok: Bool
  for +x: +List<U32>
  for +b: +List<U32>
  for +e: {SP.optional(ok, x) == Some{b} : Maybe<&2, +List<U32>>}
  {b == x : +List<U32>}
def optional_value(ok, x, b, e):
  match ok:
    case False{}: Empty.absurd({b == x : +List<U32>}, W.false_true(Equal.cong(Maybe<&2, +List<U32>>, Bool, Steps.some_bytes, None{}, Some{b}, e)))
    case True{}: Equal.sym(+List<U32>, x, b, Equal.cong(Maybe<&2, +List<U32>>, +List<U32>, maybe_bytes, Some{x}, Some{b}, e))

law basic_encoding:
  for +cps: +List<T.Part>
  for +b: +List<U32>
  for af: all_fixed(cps)
  for +enc: {E.encoding(cps) == Some{b} : Maybe<&2, +List<U32>>}
  {b == flat(cps) : +List<U32>}
def basic_encoding(cps, b, af, enc):
  Equal.trans(+List<U32>, b, List.append(&2, U32, E.fixed_parts(cps, E.fixed_size(cps)), E.payloads(cps)), flat(cps),
    optional_value(Bool.and(E.bytes_valid(cps), SLen.fits(4n, Nat.add(E.fixed_size(cps), List.length(&2, U32, E.payloads(cps))))), List.append(&2, U32, E.fixed_parts(cps, E.fixed_size(cps)), E.payloads(cps)), b, enc),
    layout_flat(cps, E.fixed_size(cps), fixed_layout(cps, E.fixed_size(cps), af)))

law one_encoding:
  for +cps: +List<T.Part>
  for +encm: Maybe<&2, +List<U32>>
  for +width: Maybe<&2, Nat>
  for +bb: Maybe<&2, +List<U32>>
  for +enc_eq: {E.encoding(cps) == encm : Maybe<&2, +List<U32>>}
  for +e: {TS.parts_present(SC.one(encm, width)) == True{} : Bool}
  for af: all_fixed(cps)
  for +same: {bb == Some{flat(cps)} : Maybe<&2, +List<U32>>}
  {SC.bytes(SC.one(encm, width)) == bb : Maybe<&2, +List<U32>>}
def one_encoding(cps, encm, width, bb, enc_eq, e, af, same):
  match encm:
    case None{}: Empty.absurd({SC.bytes(SC.one(None{}, width)) == bb : Maybe<&2, +List<U32>>}, W.false_true(e))
    case Some{b}:
      Equal.trans(Maybe<&2, +List<U32>>, SC.bytes(Some{[SC.fragment(width, b)]}), Some{b}, bb, TS.bytes_fragment(width, b),
        Equal.trans(Maybe<&2, +List<U32>>, Some{b}, Some{flat(cps)}, bb, Equal.cong(+List<U32>, Maybe<&2, +List<U32>>, z => Some{z}, b, flat(cps), basic_encoding(cps, b, af, enc_eq)), Equal.sym(Maybe<&2, +List<U32>>, bb, Some{flat(cps)}, same)))

law agg_encoding:
  for +r: Maybe<&2, +List<T.Part>>
  for +width: Maybe<&2, Nat>
  for +bb: Maybe<&2, +List<U32>>
  for +e: {TS.parts_present(SC.aggregate(r, width)) == True{} : Bool}
  for rel: parts_rel(r, bb)
  {SC.bytes(SC.aggregate(r, width)) == bb : Maybe<&2, +List<U32>>}
def agg_encoding(r, width, bb, e, rel):
  match r:
    case None{}: Empty.absurd({SC.bytes(SC.aggregate(None{}, width)) == bb : Maybe<&2, +List<U32>>}, W.false_true(e))
    case Some{cps}:
      (af, same) = rel
      one_encoding(cps, E.encoding(cps), width, bb, {==}, e, af, same)

law req_encoding:
  for +ok: Bool
  for +r: Maybe<&2, +List<T.Part>>
  for +width: Maybe<&2, Nat>
  for +bb: Maybe<&2, +List<U32>>
  for +e: {TS.parts_present(SC.require(ok, SC.aggregate(r, width))) == True{} : Bool}
  for rel: parts_rel(r, bb)
  {SC.bytes(SC.require(ok, SC.aggregate(r, width))) == bb : Maybe<&2, +List<U32>>}
def req_encoding(ok, r, width, bb, e, rel):
  match ok:
    case False{}: Empty.absurd({SC.bytes(None{}) == bb : Maybe<&2, +List<U32>>}, W.false_true(e))
    case True{}: agg_encoding(r, width, bb, e, rel)

# ---------------------------------------------------------------------------
# Transport between the two relations on the serializable domain.

law gate_swap:
  for +a: Bool
  for +b: Bool
  for +depth: Nat
  for +xs: +List<U32>
  for +outs: +List<+List<U32>>
  for +ea: {a == True{} : Bool}
  for +eb: {b == True{} : Bool}
  for s: R.single(SBV.gate(a, depth, xs), outs)
  R.single(SBV.gate(b, depth, xs), outs)
def gate_swap(a, b, depth, xs, outs, ea, eb, s):
  match a:
    case False{}: Empty.absurd(R.single(SBV.gate(b, depth, xs), outs), W.false_true(ea))
    case True{}:
      match b:
        case False{}: Empty.absurd(R.single(SBV.gate(False{}, depth, xs), outs), W.false_true(eb))
        case True{}: s

law list_gate_swap:
  for +a: Bool
  for +b: Bool
  for +n: Nat
  for +depth: Nat
  for +xs: +List<U32>
  for +outs: +List<+List<U32>>
  for +ea: {a == True{} : Bool}
  for +eb: {b == True{} : Bool}
  for s: R.single(SByteList.root_gate(a, n, depth, xs), outs)
  R.single(SByteList.root_gate(b, n, depth, xs), outs)
def list_gate_swap(a, b, n, depth, xs, outs, ea, eb, s):
  match a:
    case False{}: Empty.absurd(R.single(SByteList.root_gate(b, n, depth, xs), outs), W.false_true(ea))
    case True{}:
      match b:
        case False{}: Empty.absurd(R.single(SByteList.root_gate(False{}, n, depth, xs), outs), W.false_true(eb))
        case True{}: s

law chunks_transport:
  for +size: Maybe<&2, Nat>
  for +enc1: Maybe<&2, +List<U32>>
  for +enc2: Maybe<&2, +List<U32>>
  for comp1: +List<+List<U32>> -> Type
  for comp2: +List<+List<U32>> -> Type
  for +chunks: +List<+List<U32>>
  for sc: R.sequence_chunks(size, enc1, comp1, chunks)
