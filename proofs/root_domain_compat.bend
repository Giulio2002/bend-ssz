        case T.Boolean{}: Empty.absurd({VD.root_valid(T.EmptyItems{}, T.Boolean{}) == True{} : Bool}, W.false_true(e))
        case T.Unsigned{s0}: Empty.absurd({VD.root_valid(T.EmptyItems{}, T.Unsigned{s0}) == True{} : Bool}, W.false_true(e))
        case T.ByteVector{s0}: Empty.absurd({VD.root_valid(T.EmptyItems{}, T.ByteVector{s0}) == True{} : Bool}, W.false_true(e))
        case T.ByteList{s0}: Empty.absurd({VD.root_valid(T.EmptyItems{}, T.ByteList{s0}) == True{} : Bool}, W.false_true(e))
        case T.BitVector{s0}: Empty.absurd({VD.root_valid(T.EmptyItems{}, T.BitVector{s0}) == True{} : Bool}, W.false_true(e))
        case T.BitList{s0}: Empty.absurd({VD.root_valid(T.EmptyItems{}, T.BitList{s0}) == True{} : Bool}, W.false_true(e))
        case T.Vector{s0, s1}: Empty.absurd({VD.root_valid(T.EmptyItems{}, T.Vector{s0, s1}) == True{} : Bool}, W.false_true(e))
        case T.ListOf{s0, s1}: Empty.absurd({VD.root_valid(T.EmptyItems{}, T.ListOf{s0, s1}) == True{} : Bool}, W.false_true(e))
        case T.Container{s0, s1}: Empty.absurd({VD.root_valid(T.EmptyItems{}, T.Container{s0, s1}) == True{} : Bool}, W.false_true(e))
        case T.Union{s0}: Empty.absurd({VD.root_valid(T.EmptyItems{}, T.Union{s0}) == True{} : Bool}, W.false_true(e))
        case T.Null{}: Empty.absurd({VD.root_valid(T.EmptyItems{}, T.Null{}) == True{} : Bool}, W.false_true(e))
        case T.Chain{s0, s1}: Empty.absurd({VD.root_valid(T.EmptyItems{}, T.Chain{s0, s1}) == True{} : Bool}, W.false_true(e))
        case T.End{}: {==}
        case T.Repeat{s0}: {==}
        case T.Named{s0, s1}: Empty.absurd({VD.root_valid(T.EmptyItems{}, T.Named{s0, s1}) == True{} : Bool}, W.false_true(e))
        case T.ProgressiveList{s0}: Empty.absurd({VD.root_valid(T.EmptyItems{}, T.ProgressiveList{s0}) == True{} : Bool}, W.false_true(e))
        case T.ProgressiveBits{}: Empty.absurd({VD.root_valid(T.EmptyItems{}, T.ProgressiveBits{}) == True{} : Bool}, W.false_true(e))
        case T.ProgressiveContainer{s0, s1, s2}: Empty.absurd({VD.root_valid(T.EmptyItems{}, T.ProgressiveContainer{s0, s1, s2}) == True{} : Bool}, W.false_true(e))
        case T.CompatibleUnion{s0, s1}: Empty.absurd({VD.root_valid(T.EmptyItems{}, T.CompatibleUnion{s0, s1}) == True{} : Bool}, W.false_true(e))
    case T.Selected{v0, v1}:
      match schema:
        case T.Boolean{}: Empty.absurd({VD.root_valid(T.Selected{v0, v1}, T.Boolean{}) == True{} : Bool}, W.false_true(e))
        case T.Unsigned{s0}: Empty.absurd({VD.root_valid(T.Selected{v0, v1}, T.Unsigned{s0}) == True{} : Bool}, W.false_true(e))
        case T.ByteVector{s0}: Empty.absurd({VD.root_valid(T.Selected{v0, v1}, T.ByteVector{s0}) == True{} : Bool}, W.false_true(e))
        case T.ByteList{s0}: Empty.absurd({VD.root_valid(T.Selected{v0, v1}, T.ByteList{s0}) == True{} : Bool}, W.false_true(e))
        case T.BitVector{s0}: Empty.absurd({VD.root_valid(T.Selected{v0, v1}, T.BitVector{s0}) == True{} : Bool}, W.false_true(e))
        case T.BitList{s0}: Empty.absurd({VD.root_valid(T.Selected{v0, v1}, T.BitList{s0}) == True{} : Bool}, W.false_true(e))
        case T.Vector{s0, s1}: Empty.absurd({VD.root_valid(T.Selected{v0, v1}, T.Vector{s0, s1}) == True{} : Bool}, W.false_true(e))
        case T.ListOf{s0, s1}: Empty.absurd({VD.root_valid(T.Selected{v0, v1}, T.ListOf{s0, s1}) == True{} : Bool}, W.false_true(e))
        case T.Container{s0, s1}: Empty.absurd({VD.root_valid(T.Selected{v0, v1}, T.Container{s0, s1}) == True{} : Bool}, W.false_true(e))
        case T.Union{s0}: selected_valid(SS.option(s0, U32.to_nat(v0)), v1, v0, e, s => es => serializable_valid(v1, s, es))
        case T.Null{}: Empty.absurd({VD.root_valid(T.Selected{v0, v1}, T.Null{}) == True{} : Bool}, W.false_true(e))
        case T.Chain{s0, s1}: Empty.absurd({VD.root_valid(T.Selected{v0, v1}, T.Chain{s0, s1}) == True{} : Bool}, W.false_true(e))
        case T.End{}: Empty.absurd({VD.root_valid(T.Selected{v0, v1}, T.End{}) == True{} : Bool}, W.false_true(e))
        case T.Repeat{s0}: Empty.absurd({VD.root_valid(T.Selected{v0, v1}, T.Repeat{s0}) == True{} : Bool}, W.false_true(e))
        case T.Named{s0, s1}: Empty.absurd({VD.root_valid(T.Selected{v0, v1}, T.Named{s0, s1}) == True{} : Bool}, W.false_true(e))
        case T.ProgressiveList{s0}: Empty.absurd({VD.root_valid(T.Selected{v0, v1}, T.ProgressiveList{s0}) == True{} : Bool}, W.false_true(e))
        case T.ProgressiveBits{}: Empty.absurd({VD.root_valid(T.Selected{v0, v1}, T.ProgressiveBits{}) == True{} : Bool}, W.false_true(e))
        case T.ProgressiveContainer{s0, s1, s2}: Empty.absurd({VD.root_valid(T.Selected{v0, v1}, T.ProgressiveContainer{s0, s1, s2}) == True{} : Bool}, W.false_true(e))
        case T.CompatibleUnion{s0, s1}: selected_valid(SS.compatible_option(s0, s1, v0), v1, v0, e, s => es => serializable_valid(v1, s, es))
    case T.NullValue{}:
      match schema:
        case T.Boolean{}: Empty.absurd({VD.root_valid(T.NullValue{}, T.Boolean{}) == True{} : Bool}, W.false_true(e))
        case T.Unsigned{s0}: Empty.absurd({VD.root_valid(T.NullValue{}, T.Unsigned{s0}) == True{} : Bool}, W.false_true(e))
        case T.ByteVector{s0}: Empty.absurd({VD.root_valid(T.NullValue{}, T.ByteVector{s0}) == True{} : Bool}, W.false_true(e))
        case T.ByteList{s0}: Empty.absurd({VD.root_valid(T.NullValue{}, T.ByteList{s0}) == True{} : Bool}, W.false_true(e))
        case T.BitVector{s0}: Empty.absurd({VD.root_valid(T.NullValue{}, T.BitVector{s0}) == True{} : Bool}, W.false_true(e))
        case T.BitList{s0}: Empty.absurd({VD.root_valid(T.NullValue{}, T.BitList{s0}) == True{} : Bool}, W.false_true(e))
        case T.Vector{s0, s1}: Empty.absurd({VD.root_valid(T.NullValue{}, T.Vector{s0, s1}) == True{} : Bool}, W.false_true(e))
        case T.ListOf{s0, s1}: Empty.absurd({VD.root_valid(T.NullValue{}, T.ListOf{s0, s1}) == True{} : Bool}, W.false_true(e))
        case T.Container{s0, s1}: Empty.absurd({VD.root_valid(T.NullValue{}, T.Container{s0, s1}) == True{} : Bool}, W.false_true(e))
        case T.Union{s0}: Empty.absurd({VD.root_valid(T.NullValue{}, T.Union{s0}) == True{} : Bool}, W.false_true(e))
        case T.Null{}: {==}
        case T.Chain{s0, s1}: Empty.absurd({VD.root_valid(T.NullValue{}, T.Chain{s0, s1}) == True{} : Bool}, W.false_true(e))
        case T.End{}: Empty.absurd({VD.root_valid(T.NullValue{}, T.End{}) == True{} : Bool}, W.false_true(e))
        case T.Repeat{s0}: Empty.absurd({VD.root_valid(T.NullValue{}, T.Repeat{s0}) == True{} : Bool}, W.false_true(e))
        case T.Named{s0, s1}: Empty.absurd({VD.root_valid(T.NullValue{}, T.Named{s0, s1}) == True{} : Bool}, W.false_true(e))
        case T.ProgressiveList{s0}: Empty.absurd({VD.root_valid(T.NullValue{}, T.ProgressiveList{s0}) == True{} : Bool}, W.false_true(e))
        case T.ProgressiveBits{}: Empty.absurd({VD.root_valid(T.NullValue{}, T.ProgressiveBits{}) == True{} : Bool}, W.false_true(e))
        case T.ProgressiveContainer{s0, s1, s2}: Empty.absurd({VD.root_valid(T.NullValue{}, T.ProgressiveContainer{s0, s1, s2}) == True{} : Bool}, W.false_true(e))
        case T.CompatibleUnion{s0, s1}: Empty.absurd({VD.root_valid(T.NullValue{}, T.CompatibleUnion{s0, s1}) == True{} : Bool}, W.false_true(e))

# ---------------------------------------------------------------------------
# Basic sequences: whenever the whole-parent encoding exists it is exactly the
# element-wise packing R.basic_bytes (all parts are fixed; no offsets).

def flat(ps: +List<T.Part>) -> +List<U32>:
  match ps:
    case Nil{}: []
    case Con{h, t}:
      match h:
        case T.Fixed{xs}: List.append(&2, U32, xs, flat(t))
        case T.Variable{xs}: List.append(&2, U32, xs, flat(t))

def all_fixed(ps: +List<T.Part>) -> Type:
  match ps:
    case Nil{}: Unit
    case Con{h, t}:
      match h:
        case T.Fixed{xs}: all_fixed(t)
        case T.Variable{xs}: Empty

def parts_rel(p: Maybe<&2, +List<T.Part>>, b: Maybe<&2, +List<U32>>) -> Type:
  match p:
    case None{}: Unit
    case Some{cps}: all_fixed(cps) & {b == Some{flat(cps)} : Maybe<&2, +List<U32>>}

def maybe_bytes(m: Maybe<&2, +List<U32>>) -> +List<U32>:
  match m:
    case None{}: []
    case Some{x}: x

law single_flat:
  for +x: +List<U32>
  {Some{x} == Some{flat([T.Fixed{x}])} : Maybe<&2, +List<U32>>}
def single_flat(x):
  Equal.cong(+List<U32>, Maybe<&2, +List<U32>>, y => Some{y}, x, List.append(&2, U32, x, []), Equal.sym(+List<U32>, List.append(&2, U32, x, []), x, L.append_empty(U32, x)))

law one_fixed_rel:
  for +enc: Maybe<&2, +List<U32>>
  for +n: Nat
  parts_rel(SC.one(enc, Some{n}), enc)
def one_fixed_rel(enc, n):
  match enc:
    case None{}: Unit{}
    case Some{x}: (Unit{}, single_flat(x))

law flat_append:
  for +x: +List<T.Part>
  for +y: +List<T.Part>
  {flat(List.append(&2, T.Part, x, y)) == List.append(&2, U32, flat(x), flat(y)) : +List<U32>}
def flat_append(x, y):
  match x:
    case Nil{}: {==}
    case Con{h, t}:
      match h:
        case T.Fixed{xs}:
          %Equal.sym(+List<U32>, List.append(&2, U32, List.append(&2, U32, xs, flat(t)), flat(y)), List.append(&2, U32, xs, List.append(&2, U32, flat(t), flat(y))), L.append_associative(U32, xs, flat(t), flat(y))) : {List.append(&2, U32, xs, flat(List.append(&2, T.Part, t, y))) == _ : +List<U32>}
          Equal.cong(+List<U32>, +List<U32>, z => List.append(&2, U32, xs, z), flat(List.append(&2, T.Part, t, y)), List.append(&2, U32, flat(t), flat(y)), flat_append(t, y))
        case T.Variable{xs}:
          %Equal.sym(+List<U32>, List.append(&2, U32, List.append(&2, U32, xs, flat(t)), flat(y)), List.append(&2, U32, xs, List.append(&2, U32, flat(t), flat(y))), L.append_associative(U32, xs, flat(t), flat(y))) : {List.append(&2, U32, xs, flat(List.append(&2, T.Part, t, y))) == _ : +List<U32>}
          Equal.cong(+List<U32>, +List<U32>, z => List.append(&2, U32, xs, z), flat(List.append(&2, T.Part, t, y)), List.append(&2, U32, flat(t), flat(y)), flat_append(t, y))

law fixed_append:
  for +x: +List<T.Part>
  for +y: +List<T.Part>
  for ax: all_fixed(x)
  for ay: all_fixed(y)
  all_fixed(List.append(&2, T.Part, x, y))
def fixed_append(x, y, ax, ay):
  match x:
    case Nil{}: ay
    case Con{h, t}:
      match h:
        case T.Fixed{xs}: fixed_append(t, y, ax, ay)
        case T.Variable{xs}:
          match ax:

law concat_rel_some:
  for +x: +List<T.Part>
  for +y: +List<T.Part>
  for +bo: Maybe<&2, +List<U32>>
  for +bt: Maybe<&2, +List<U32>>
  for rh: all_fixed(x) & {bo == Some{flat(x)} : Maybe<&2, +List<U32>>}
  for rt: all_fixed(y) & {bt == Some{flat(y)} : Maybe<&2, +List<U32>>}
  all_fixed(List.append(&2, T.Part, x, y)) & {R.join(bo, bt) == Some{flat(List.append(&2, T.Part, x, y))} : Maybe<&2, +List<U32>>}
def concat_rel_some(x, y, bo, bt, rh, rt):
  (ax, ex) = rh
  (ay, ey) = rt
  (fixed_append(x, y, ax, ay),
   %Equal.sym(Maybe<&2, +List<U32>>, bo, Some{flat(x)}, ex) : {R.join(_, bt) == Some{flat(List.append(&2, T.Part, x, y))} : Maybe<&2, +List<U32>>}
   %Equal.sym(Maybe<&2, +List<U32>>, bt, Some{flat(y)}, ey) : {R.join(Some{flat(x)}, _) == Some{flat(List.append(&2, T.Part, x, y))} : Maybe<&2, +List<U32>>}
   Equal.cong(+List<U32>, Maybe<&2, +List<U32>>, z => Some{z}, List.append(&2, U32, flat(x), flat(y)), flat(List.append(&2, T.Part, x, y)), Equal.sym(+List<U32>, flat(List.append(&2, T.Part, x, y)), List.append(&2, U32, flat(x), flat(y)), flat_append(x, y))))

law concat_rel:
  for +ph: Maybe<&2, +List<T.Part>>
  for +pt: Maybe<&2, +List<T.Part>>
  for +bo: Maybe<&2, +List<U32>>
  for +bt: Maybe<&2, +List<U32>>
  for rh: parts_rel(ph, bo)
  for rt: parts_rel(pt, bt)
  parts_rel(SC.concatenate(ph, pt), R.join(bo, bt))
def concat_rel(ph, pt, bo, bt, rh, rt):
  match ph:
    case None{}:
      match pt:
        case None{}: Unit{}
        case Some{y}: Unit{}
    case Some{x}:
      match pt:
        case None{}: Unit{}
        case Some{y}: concat_rel_some(x, y, bo, bt, rh, rt)

law one_rel:
  for +h: T.Value
  for +s: T.Schema
  for +w: Nat
  for +eq: {R.basic_size(s) == Some{w} : Maybe<&2, Nat>}
  parts_rel(SC.parts(h, s), R.basic_one(h, s))
def one_rel(h, s, w, eq):
  match h:
    case T.BooleanValue{v0}:
      match s:
        case T.Boolean{}: (Unit{}, single_flat(SP.boolean_encoding(v0)))
        case T.Unsigned{s0}: Unit{}
        case T.ByteVector{s0}: Empty.absurd(parts_rel(SC.parts(T.BooleanValue{v0}, T.ByteVector{s0}), R.basic_one(T.BooleanValue{v0}, T.ByteVector{s0})), W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, Steps.nat_some, None{}, Some{w}, eq)))
        case T.ByteList{s0}: Empty.absurd(parts_rel(SC.parts(T.BooleanValue{v0}, T.ByteList{s0}), R.basic_one(T.BooleanValue{v0}, T.ByteList{s0})), W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, Steps.nat_some, None{}, Some{w}, eq)))
        case T.BitVector{s0}: Empty.absurd(parts_rel(SC.parts(T.BooleanValue{v0}, T.BitVector{s0}), R.basic_one(T.BooleanValue{v0}, T.BitVector{s0})), W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, Steps.nat_some, None{}, Some{w}, eq)))
        case T.BitList{s0}: Empty.absurd(parts_rel(SC.parts(T.BooleanValue{v0}, T.BitList{s0}), R.basic_one(T.BooleanValue{v0}, T.BitList{s0})), W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, Steps.nat_some, None{}, Some{w}, eq)))
        case T.Vector{s0, s1}: Empty.absurd(parts_rel(SC.parts(T.BooleanValue{v0}, T.Vector{s0, s1}), R.basic_one(T.BooleanValue{v0}, T.Vector{s0, s1})), W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, Steps.nat_some, None{}, Some{w}, eq)))
        case T.ListOf{s0, s1}: Empty.absurd(parts_rel(SC.parts(T.BooleanValue{v0}, T.ListOf{s0, s1}), R.basic_one(T.BooleanValue{v0}, T.ListOf{s0, s1})), W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, Steps.nat_some, None{}, Some{w}, eq)))
        case T.Container{s0, s1}: Empty.absurd(parts_rel(SC.parts(T.BooleanValue{v0}, T.Container{s0, s1}), R.basic_one(T.BooleanValue{v0}, T.Container{s0, s1})), W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, Steps.nat_some, None{}, Some{w}, eq)))
        case T.Union{s0}: Empty.absurd(parts_rel(SC.parts(T.BooleanValue{v0}, T.Union{s0}), R.basic_one(T.BooleanValue{v0}, T.Union{s0})), W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, Steps.nat_some, None{}, Some{w}, eq)))
        case T.Null{}: Empty.absurd(parts_rel(SC.parts(T.BooleanValue{v0}, T.Null{}), R.basic_one(T.BooleanValue{v0}, T.Null{})), W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, Steps.nat_some, None{}, Some{w}, eq)))
        case T.Chain{s0, s1}: Empty.absurd(parts_rel(SC.parts(T.BooleanValue{v0}, T.Chain{s0, s1}), R.basic_one(T.BooleanValue{v0}, T.Chain{s0, s1})), W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, Steps.nat_some, None{}, Some{w}, eq)))
        case T.End{}: Empty.absurd(parts_rel(SC.parts(T.BooleanValue{v0}, T.End{}), R.basic_one(T.BooleanValue{v0}, T.End{})), W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, Steps.nat_some, None{}, Some{w}, eq)))
        case T.Repeat{s0}: Empty.absurd(parts_rel(SC.parts(T.BooleanValue{v0}, T.Repeat{s0}), R.basic_one(T.BooleanValue{v0}, T.Repeat{s0})), W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, Steps.nat_some, None{}, Some{w}, eq)))
        case T.Named{s0, s1}: Empty.absurd(parts_rel(SC.parts(T.BooleanValue{v0}, T.Named{s0, s1}), R.basic_one(T.BooleanValue{v0}, T.Named{s0, s1})), W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, Steps.nat_some, None{}, Some{w}, eq)))
        case T.ProgressiveList{s0}: Empty.absurd(parts_rel(SC.parts(T.BooleanValue{v0}, T.ProgressiveList{s0}), R.basic_one(T.BooleanValue{v0}, T.ProgressiveList{s0})), W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, Steps.nat_some, None{}, Some{w}, eq)))
        case T.ProgressiveBits{}: Empty.absurd(parts_rel(SC.parts(T.BooleanValue{v0}, T.ProgressiveBits{}), R.basic_one(T.BooleanValue{v0}, T.ProgressiveBits{})), W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, Steps.nat_some, None{}, Some{w}, eq)))
        case T.ProgressiveContainer{s0, s1, s2}: Empty.absurd(parts_rel(SC.parts(T.BooleanValue{v0}, T.ProgressiveContainer{s0, s1, s2}), R.basic_one(T.BooleanValue{v0}, T.ProgressiveContainer{s0, s1, s2})), W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, Steps.nat_some, None{}, Some{w}, eq)))
        case T.CompatibleUnion{s0, s1}: Empty.absurd(parts_rel(SC.parts(T.BooleanValue{v0}, T.CompatibleUnion{s0, s1}), R.basic_one(T.BooleanValue{v0}, T.CompatibleUnion{s0, s1})), W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, Steps.nat_some, None{}, Some{w}, eq)))
    case T.UnsignedValue{v0}:
      match s:
        case T.Boolean{}: Unit{}
        case T.Unsigned{s0}: one_fixed_rel(SP.uint_encoding(s0, v0), SP.byte_width(s0))
        case T.ByteVector{s0}: Empty.absurd(parts_rel(SC.parts(T.UnsignedValue{v0}, T.ByteVector{s0}), R.basic_one(T.UnsignedValue{v0}, T.ByteVector{s0})), W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, Steps.nat_some, None{}, Some{w}, eq)))
        case T.ByteList{s0}: Empty.absurd(parts_rel(SC.parts(T.UnsignedValue{v0}, T.ByteList{s0}), R.basic_one(T.UnsignedValue{v0}, T.ByteList{s0})), W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, Steps.nat_some, None{}, Some{w}, eq)))
        case T.BitVector{s0}: Empty.absurd(parts_rel(SC.parts(T.UnsignedValue{v0}, T.BitVector{s0}), R.basic_one(T.UnsignedValue{v0}, T.BitVector{s0})), W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, Steps.nat_some, None{}, Some{w}, eq)))
        case T.BitList{s0}: Empty.absurd(parts_rel(SC.parts(T.UnsignedValue{v0}, T.BitList{s0}), R.basic_one(T.UnsignedValue{v0}, T.BitList{s0})), W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, Steps.nat_some, None{}, Some{w}, eq)))
        case T.Vector{s0, s1}: Empty.absurd(parts_rel(SC.parts(T.UnsignedValue{v0}, T.Vector{s0, s1}), R.basic_one(T.UnsignedValue{v0}, T.Vector{s0, s1})), W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, Steps.nat_some, None{}, Some{w}, eq)))
        case T.ListOf{s0, s1}: Empty.absurd(parts_rel(SC.parts(T.UnsignedValue{v0}, T.ListOf{s0, s1}), R.basic_one(T.UnsignedValue{v0}, T.ListOf{s0, s1})), W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, Steps.nat_some, None{}, Some{w}, eq)))
        case T.Container{s0, s1}: Empty.absurd(parts_rel(SC.parts(T.UnsignedValue{v0}, T.Container{s0, s1}), R.basic_one(T.UnsignedValue{v0}, T.Container{s0, s1})), W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, Steps.nat_some, None{}, Some{w}, eq)))
        case T.Union{s0}: Empty.absurd(parts_rel(SC.parts(T.UnsignedValue{v0}, T.Union{s0}), R.basic_one(T.UnsignedValue{v0}, T.Union{s0})), W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, Steps.nat_some, None{}, Some{w}, eq)))
        case T.Null{}: Empty.absurd(parts_rel(SC.parts(T.UnsignedValue{v0}, T.Null{}), R.basic_one(T.UnsignedValue{v0}, T.Null{})), W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, Steps.nat_some, None{}, Some{w}, eq)))
        case T.Chain{s0, s1}: Empty.absurd(parts_rel(SC.parts(T.UnsignedValue{v0}, T.Chain{s0, s1}), R.basic_one(T.UnsignedValue{v0}, T.Chain{s0, s1})), W.false_true(Equal.cong(Maybe<&2, Nat>, Bool, Steps.nat_some, None{}, Some{w}, eq)))
