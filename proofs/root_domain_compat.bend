def vector_ok_of(items, n, ok):
  %Steps.items_length_correct(items) : {Bool.and(Nat.is_lt(0n, n), Nat.is_eq(_, n)) == True{} : Bool}
  ok

law list_ok_of:
  for +items: T.Value
