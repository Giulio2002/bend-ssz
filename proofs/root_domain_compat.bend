def bytevector_of(n, xs, vd):
  match n:
    case 0n: Empty.absurd({VD.bytevector_domain(0n, xs) == True{} : Bool}, W.false_true(vd))
    case 1n+p: V.and_left(SP.byte_scope(1n+p, xs), SBytes.size_fits(1n+p), vd)

law bytelist_of:
  for +n: Nat
  for +xs: +List<U32>
  for +dd: {SByteList.domain(n, xs) == True{} : Bool}
  {VD.bytelist_domain(n, xs) == True{} : Bool}
def bytelist_of(n, xs, dd):
  V.and_left(Bool.and(SP.bytes_domain(xs), Nat.is_le(List.length(&2, U32, xs), n)), SLen.fits(4n, List.length(&2, U32, xs)), dd)

