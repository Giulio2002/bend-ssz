law pack_go_view:
  for +xs: +List<U32>
  for +ok: {P.packing_domain(P.pack_spec_go(xs, xs)) == True{} : Bool}
  {P.packing_length(P.pack_spec_go(xs, xs)) == List.length(&2, U32, xs) : Nat} & {List.take(&2, U32, P.chunks_bytes(P.packing_chunks(P.pack_spec_go(xs, xs))), List.length(&2, U32, xs)) == xs : +List<U32>}
def pack_go_view(xs, ok):
  pack_go_view_at(List.length(&2, U32, xs), xs, NO.reflexive(List.length(&2, U32, xs)), ok)

law pack_spec_view:
  for +xs: +List<U32>
  for +ok: {P.packing_domain(P.pack_spec(xs)) == True{} : Bool}
  {P.packing_length(P.pack_spec(xs)) == List.length(&2, U32, xs) : Nat} & {List.take(&2, U32, P.chunks_bytes(P.packing_chunks(P.pack_spec(xs))), List.length(&2, U32, xs)) == xs : +List<U32>}
def pack_spec_view(xs, ok): pack_go_view(xs, ok)
