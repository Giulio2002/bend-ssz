# ---------------------------------------------------------------------------
# Padding to the chunk boundary keeps the bytes and the domain.
law pad_length:
  for +m: Nat
  for +xs: +List<U32>
  {List.length(&2, U32, IP.pad(m, xs)) == m : Nat}
def pad_length(m, xs):
  match m:
    case 0n: {==}
    case 1n+p:
      match xs:
        case Nil{}: Equal.cong(Nat, Nat, z => 1n+z, List.length(&2, U32, IP.pad(p, [])), p, pad_length(p, []))
        case Con{hd, tl}: Equal.cong(Nat, Nat, z => 1n+z, List.length(&2, U32, IP.pad(p, tl)), p, pad_length(p, tl))

law pad_domain:
  for +m: Nat
  for +xs: +List<U32>
  for +domain: {SP.bytes_domain(xs) == True{} : Bool}
  {SP.bytes_domain(IP.pad(m, xs)) == True{} : Bool}
def pad_domain(m, xs, domain):
  match m:
    case 0n: {==}
    case 1n+p:
      match xs:
        case Nil{}: V.and_true(U32.is_lt(0, 256), SP.bytes_domain(IP.pad(p, [])), {==}, pad_domain(p, [], {==}))
        case Con{hd, tl}:
          V.and_true(U32.is_lt(hd, 256), SP.bytes_domain(IP.pad(p, tl)),
            V.and_left(U32.is_lt(hd, 256), SP.bytes_domain(tl), domain),
            pad_domain(p, tl, V.and_right(U32.is_lt(hd, 256), SP.bytes_domain(tl), domain)))

law take_pad:
  for +rem: Nat
  for +m: Nat
  for +xs: +List<U32>
  for +fits: {Nat.is_le(rem, m) == True{} : Bool}
  for +room: {Nat.is_le(rem, List.length(&2, U32, xs)) == True{} : Bool}
  {List.take(&2, U32, IP.pad(m, xs), rem) == List.take(&2, U32, xs, rem) : +List<U32>}
def take_pad(rem, m, xs, fits, room):
  match rem:
    case 0n:
      Equal.trans(+List<U32>, List.take(&2, U32, IP.pad(m, xs), 0n), [], List.take(&2, U32, xs, 0n),
        PK.take_zero(IP.pad(m, xs)),
        Equal.sym(+List<U32>, List.take(&2, U32, xs, 0n), [], PK.take_zero(xs)))
    case 1n+q:
      match m:
        case 0n: Empty.absurd({List.take(&2, U32, IP.pad(0n, xs), 1n+q) == List.take(&2, U32, xs, 1n+q) : +List<U32>}, F.false_true(fits))
        case 1n+p:
          match xs:
            case Nil{}: Empty.absurd({List.take(&2, U32, IP.pad(1n+p, []), 1n+q) == List.take(&2, U32, [], 1n+q) : +List<U32>}, F.false_true(room))
            case Con{hd, tl}: Equal.cong(+List<U32>, +List<U32>, zs => hd <> zs, List.take(&2, U32, IP.pad(p, tl), q), List.take(&2, U32, tl, q), take_pad(q, p, tl, fits, room))

# ---------------------------------------------------------------------------
# A region of n bytes fits in the chunks its chunk count provides.
law mul_commute:
  for +a: Nat
  for +b: Nat
  {Nat.mul(a, b) == Nat.mul(b, a) : Nat}
def mul_commute(a, b):
  match a:
    case 0n: Equal.sym(Nat, Nat.mul(b, 0n), 0n, NA.mul_zero(b))
    case 1n+p:
      Equal.trans(Nat, Nat.add(b, Nat.mul(p, b)), Nat.add(b, Nat.mul(b, p)), Nat.mul(b, 1n+p),
        Equal.cong(Nat, Nat, z => Nat.add(b, z), Nat.mul(p, b), Nat.mul(b, p), mul_commute(p, b)),
        Equal.sym(Nat, Nat.mul(b, 1n+p), Nat.add(b, Nat.mul(b, p)), NA.mul_succ_right(b, p)))

law split_next:
  for +p: Nat
  for +w: Nat
  for parts: Div.split_type(p, w)
  Div.split_type(1n+p, w)
def split_next(p, w, parts):
  (+q, (+r, (le, eq))) = parts
  Div.split_step(Nat.is_lt(r, w), q, r, w, p, {==}, le, eq)

law split_all:
  for +n: Nat
  for +w: Nat
  Div.split_type(n, w)
def split_all(n, w):
  match n:
    case 0n: (0n, (0n, (NO.zero_le(w), {==})))
    case 1n+p: split_next(p, w, split_all(p, w))

law split_bound:
  for +n: Nat
  for +q: Nat
  for +r: Nat
  for +le: {Nat.is_le(r, 31n) == True{} : Bool}
  for +eq: {Nat.add(Nat.mul(q, 32n), r) == Nat.add(n, 31n) : Nat}
  {Nat.is_le(n, Nat.mul(32n, q)) == True{} : Bool}
def split_bound(n, q, r, le, eq):
  %mul_commute(q, 32n) : {Nat.is_le(n, _) == True{} : Bool}
  add_le_cancel(r, n, Nat.mul(q, 32n),
    (%NA.add_commute(n, r) : {Nat.is_le(_, Nat.add(r, Nat.mul(q, 32n))) == True{} : Bool}
     %NA.add_commute(Nat.mul(q, 32n), r) : {Nat.is_le(Nat.add(n, r), _) == True{} : Bool}
     %Equal.sym(Nat, Nat.add(Nat.mul(q, 32n), r), Nat.add(n, 31n), eq) : {Nat.is_le(Nat.add(n, r), _) == True{} : Bool}
     NO.add_left(n, r, 31n, le)))

law div_is:
  for +n: Nat
  for +q: Nat
  for +r: Nat
  for +le: {Nat.is_le(r, 31n) == True{} : Bool}
  for +eq: {Nat.add(Nat.mul(q, 32n), r) == Nat.add(n, 31n) : Nat}
  {Nat.div(Nat.add(n, 31n), 32n) == q : Nat}
def div_is(n, q, r, le, eq):
  %eq : {Nat.div(_, 32n) == q : Nat}
  Div.div_exact(q, r, 31n, le)

law region_fits_parts:
  for +n: Nat
  for parts: Div.split_type(Nat.add(n, 31n), 31n)
  {Nat.is_le(n, Nat.mul(32n, P.chunk_count(n))) == True{} : Bool}
def region_fits_parts(n, parts):
  (+q, (+r, (+le, +eq))) = parts
  %Equal.sym(Nat, Nat.div(Nat.add(n, 31n), 32n), q, div_is(n, q, r, le, eq)) : {Nat.is_le(n, Nat.mul(32n, _)) == True{} : Bool}
  split_bound(n, q, r, le, eq)

law region_fits_chunks:
  for +n: Nat
  {Nat.is_le(n, Nat.mul(32n, P.chunk_count(n))) == True{} : Bool}
def region_fits_chunks(n):
  region_fits_parts(n, split_all(Nat.add(n, 31n), 31n))


# ---------------------------------------------------------------------------
# The packed region denotes exactly the bytes that were packed. This is the
# bridge between the list entry point and the slice the cursor decoder reads.
law pack_view:
  for +n: Nat
  for +xs: +List<U32>
  for +domain: {SP.bytes_domain(xs) == True{} : Bool}
  for +room: {Nat.is_le(n, List.length(&2, U32, xs)) == True{} : Bool}
  {P.slice_bytes(P.whole(P.pack(n, xs))) == List.take(&2, U32, xs, n) : +List<U32>}
def pack_view(n, xs, domain, room):
  +padded = IP.pad(Nat.mul(32n, P.chunk_count(n)), xs)
  +fits = region_fits_chunks(n)
  %Equal.sym(+List<U32>, List.drop(&2, U32, P.chunks_bytes(P.pack_chunks(P.chunk_count(n), padded)), 0n), P.chunks_bytes(P.pack_chunks(P.chunk_count(n), padded)), PK.drop_zero(P.chunks_bytes(P.pack_chunks(P.chunk_count(n), padded)))) : {List.take(&2, U32, _, n) == List.take(&2, U32, xs, n) : +List<U32>}
  %Equal.sym(+List<U32>, P.chunks_bytes(P.pack_chunks(P.chunk_count(n), padded)), List.take(&2, U32, padded, Nat.mul(32n, P.chunk_count(n))), pack_chunks_view(P.chunk_count(n), padded, pad_domain(Nat.mul(32n, P.chunk_count(n)), xs, domain),
     (%Equal.sym(Nat, List.length(&2, U32, padded), Nat.mul(32n, P.chunk_count(n)), pad_length(Nat.mul(32n, P.chunk_count(n)), xs)) : {Nat.is_le(Nat.mul(32n, P.chunk_count(n)), _) == True{} : Bool}
      NO.reflexive(Nat.mul(32n, P.chunk_count(n)))))) : {List.take(&2, U32, _, n) == List.take(&2, U32, xs, n) : +List<U32>}
  %Equal.sym(+List<U32>, List.take(&2, U32, List.take(&2, U32, padded, Nat.mul(32n, P.chunk_count(n))), n), List.take(&2, U32, padded, Nat.min(n, Nat.mul(32n, P.chunk_count(n)))), PK.take_take(padded, n, Nat.mul(32n, P.chunk_count(n)))) : {_ == List.take(&2, U32, xs, n) : +List<U32>}
  %Equal.sym(Nat, Nat.min(n, Nat.mul(32n, P.chunk_count(n))), n, PK.min_le(n, Nat.mul(32n, P.chunk_count(n)), fits)) : {List.take(&2, U32, padded, _) == List.take(&2, U32, xs, n) : +List<U32>}
  take_pad(n, Nat.mul(32n, P.chunk_count(n)), xs, fits, room)

# ---------------------------------------------------------------------------
# The single-pass packing denotes exactly its input.
law small_length_correct:
  for +xs: +List<U32>
  {P.small_length(xs) == List.length(&2, U32, xs) : Nat}
def small_length_correct(xs):
  match xs:
    case Nil{}: {==}
    case Con{hd, tl}: Equal.cong(Nat, Nat, z => 1n+z, P.small_length(tl), List.length(&2, U32, tl), small_length_correct(tl))

law small_domain_correct:
  for +xs: +List<U32>
  {P.small_domain(xs) == SP.bytes_domain(xs) : Bool}
def small_domain_correct(xs):
  match xs:
    case Nil{}: {==}
    case Con{hd, tl}: Equal.cong(Bool, Bool, z => Bool.and(U32.is_lt(hd, 256), z), P.small_domain(tl), SP.bytes_domain(tl), small_domain_correct(tl))
