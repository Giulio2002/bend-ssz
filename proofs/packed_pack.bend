# The final partial chunk. `tail_packing` pads the remaining bytes to a full
# chunk; padding, reading and writing back leaves the original bytes.
law tail_view:
  for +ys: +List<U32>
  for +short: {Nat.is_le(List.length(&2, U32, ys), 32n) == True{} : Bool}
  for +ok: {P.packing_domain(P.tail_packing(ys)) == True{} : Bool}
  {P.packing_length(P.tail_packing(ys)) == List.length(&2, U32, ys) : Nat} & {List.take(&2, U32, P.chunks_bytes(P.packing_chunks(P.tail_packing(ys))), List.length(&2, U32, ys)) == ys : +List<U32>}
def tail_view(ys, short, ok):
  match ys:
    case Nil{}: ({==}, {==})
    case Con{h, t}:
      +domys = Equal.trans(Bool, SP.bytes_domain(h <> (t)), P.small_domain(h <> (t)), True{},
        Equal.sym(Bool, P.small_domain(h <> (t)), SP.bytes_domain(h <> (t)), small_domain_correct(h <> (t))),
        ok)
      (small_length_correct(h <> (t)),
       Equal.trans(+List<U32>,
         List.take(&2, U32, P.chunk_bytes(P.chunk_of(P.read_chunk(IP.pad(32n, h <> (t)))), []), List.length(&2, U32, h <> (t))),
         List.take(&2, U32, IP.pad(32n, h <> (t)), List.length(&2, U32, h <> (t))),
         h <> (t),
         Equal.cong(+List<U32>, +List<U32>, us => List.take(&2, U32, us, List.length(&2, U32, h <> (t))),
           P.chunk_bytes(P.chunk_of(P.read_chunk(IP.pad(32n, h <> (t)))), []), IP.pad(32n, h <> (t)),
           chunk_roundtrip(IP.pad(32n, h <> (t)), pad_length(32n, h <> (t)), pad_domain(32n, h <> (t), domys))),
         Equal.trans(+List<U32>, List.take(&2, U32, IP.pad(32n, h <> (t)), List.length(&2, U32, h <> (t))), List.take(&2, U32, h <> (t), List.length(&2, U32, h <> (t))), h <> (t),
           take_pad(List.length(&2, U32, h <> (t)), 32n, h <> (t), short, NO.reflexive(List.length(&2, U32, h <> (t)))),
           PK.take_length_all(h <> (t)))))

# `pack_spec_go` on a final partial chunk is `tail_packing`, with nothing
# expanded. Stating it this way is what keeps `pack_go_view` cheap: its
# thirty-one short cases instantiate one law whose conclusion already has the
# goal's shape, instead of forcing the checker to normalise a padded chunk read
# and eight limb constructions per case.
def is_short(r: P.Read) -> Bool:
  match r:
    case P.Short{}: True{}
    case P.Read{c, rest}: False{}

