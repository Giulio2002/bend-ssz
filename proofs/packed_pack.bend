# The remaining input after a chunk still covers the remaining chunks.

# ---------------------------------------------------------------------------
# One chunk, read and written back.
#
# These three laws replace the thirty-one explicit `pack_short_N` laws this
# module used to export. Their statements are what every consumer of this
# module has to elaborate, and the old ones each named up to thirty-one bytes
# and four copies of the same cons spine, which cost gigabytes of checker
# memory in every module that transitively imported them (the packing proof
# alone reached 6 GB). The case analysis is unchanged, but it now happens
# once, inside a body, behind a small statement.
law chunk_bytes_32_dom:
  for +b0: U32
  for +b1: U32
  for +b2: U32
  for +b3: U32
  for +b4: U32
  for +b5: U32
  for +b6: U32
  for +b7: U32
  for +b8: U32
  for +b9: U32
  for +b10: U32
  for +b11: U32
  for +b12: U32
  for +b13: U32
  for +b14: U32
  for +b15: U32
  for +b16: U32
  for +b17: U32
  for +b18: U32
  for +b19: U32
  for +b20: U32
  for +b21: U32
  for +b22: U32
  for +b23: U32
  for +b24: U32
  for +b25: U32
  for +b26: U32
  for +b27: U32
  for +b28: U32
  for +b29: U32
  for +b30: U32
  for +b31: U32
  for +tail: +List<U32>
