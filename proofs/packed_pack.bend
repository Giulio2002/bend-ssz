law add_le_cancel:
  for +c: Nat
  for +a: Nat
  for +b: Nat
  for +e: {Nat.is_le(Nat.add(c, a), Nat.add(c, b)) == True{} : Bool}
  {Nat.is_le(a, b) == True{} : Bool}
def add_le_cancel(c, a, b, e):
  match c:
    case 0n: e
    case 1n+q: add_le_cancel(q, a, b, e)

law room_tail:
  for +p: Nat
  for +m: Nat
  for +room: {Nat.is_le(Nat.mul(32n, 1n+p), Nat.add(32n, m)) == True{} : Bool}
  {Nat.is_le(Nat.mul(32n, p), m) == True{} : Bool}
def room_tail(p, m, room):
  add_le_cancel(32n, Nat.mul(32n, p), m,
    (%NA.mul_succ_right(32n, p) : {Nat.is_le(_, Nat.add(32n, m)) == True{} : Bool}
     room))

law room_expand:
  for +p: Nat
  for +j: Nat
  for +room: {Nat.is_le(Nat.mul(32n, 1n+p), j) == True{} : Bool}
  {Nat.is_le(Nat.add(32n, Nat.mul(32n, p)), j) == True{} : Bool}
def room_expand(p, j, room):
  %NA.mul_succ_right(32n, p) : {Nat.is_le(_, j) == True{} : Bool}
  room


