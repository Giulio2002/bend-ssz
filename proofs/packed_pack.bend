# Reading thirty-two bytes into a chunk and writing them back is the identity.
# One nested case analysis, with a small statement; the length premise refutes
# every shorter and longer list.
law chunk_roundtrip:
  for +zs: +List<U32>
  for +len: {List.length(&2, U32, zs) == 32n : Nat}
  for +dom: {SP.bytes_domain(zs) == True{} : Bool}
  {P.chunk_bytes(P.chunk_of(P.read_chunk(zs)), []) == zs : +List<U32>}
def chunk_roundtrip(zs, len, dom):
  match zs:
    case Nil{}:
      Empty.absurd({P.chunk_bytes(P.chunk_of(P.read_chunk(Nil{})), []) == Nil{} : +List<U32>},
        F.false_true(Equal.cong(Nat, Bool, k => Nat.is_eq(k, 32n), List.length(&2, U32, Nil{}), 32n, len)))
    case Con{b0, t0}:
      match t0:
        case Nil{}:
          Empty.absurd({P.chunk_bytes(P.chunk_of(P.read_chunk(b0 <> (Nil{}))), []) == b0 <> (Nil{}) : +List<U32>},
            F.false_true(Equal.cong(Nat, Bool, k => Nat.is_eq(k, 32n), List.length(&2, U32, b0 <> (Nil{})), 32n, len)))
        case Con{b1, t1}:
          match t1:
            case Nil{}:
              Empty.absurd({P.chunk_bytes(P.chunk_of(P.read_chunk(b0 <> (b1 <> (Nil{})))), []) == b0 <> (b1 <> (Nil{})) : +List<U32>},
                F.false_true(Equal.cong(Nat, Bool, k => Nat.is_eq(k, 32n), List.length(&2, U32, b0 <> (b1 <> (Nil{}))), 32n, len)))
            case Con{b2, t2}:
              match t2:
                case Nil{}:
                  Empty.absurd({P.chunk_bytes(P.chunk_of(P.read_chunk(b0 <> (b1 <> (b2 <> (Nil{}))))), []) == b0 <> (b1 <> (b2 <> (Nil{}))) : +List<U32>},
                    F.false_true(Equal.cong(Nat, Bool, k => Nat.is_eq(k, 32n), List.length(&2, U32, b0 <> (b1 <> (b2 <> (Nil{})))), 32n, len)))
                case Con{b3, t3}:
                  match t3:
                    case Nil{}:
                      Empty.absurd({P.chunk_bytes(P.chunk_of(P.read_chunk(b0 <> (b1 <> (b2 <> (b3 <> (Nil{})))))), []) == b0 <> (b1 <> (b2 <> (b3 <> (Nil{})))) : +List<U32>},
                        F.false_true(Equal.cong(Nat, Bool, k => Nat.is_eq(k, 32n), List.length(&2, U32, b0 <> (b1 <> (b2 <> (b3 <> (Nil{}))))), 32n, len)))
                    case Con{b4, t4}:
