def le_shrink(a, b, e):
  match a:
    case 0n: NO.zero_le(b)
    case 1n+r:
      match b:
        case 0n: Empty.absurd({Nat.is_le(1n+r, 0n) == True{} : Bool}, F.false_true(e))
        case 1n+q: le_shrink(r, q, e)

law le_drop_left:
  for +m: Nat
  for +n: Nat
  for +p: Nat
  for +e: {Nat.is_le(Nat.add(m, n), p) == True{} : Bool}
