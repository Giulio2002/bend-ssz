# Lifting the bit lemmas to byte values: every value the decoder packs is a
# byte, so extraction returns exactly it.
law byte0_limb:
  for +a: U32
  for +b: U32
  for +c: U32
  for +d: U32
  for +ea: {U32.is_lt(a, 256) == True{} : Bool}
  for +eb: {U32.is_lt(b, 256) == True{} : Bool}
  for +ec: {U32.is_lt(c, 256) == True{} : Bool}
  for +ed: {U32.is_lt(d, 256) == True{} : Bool}
  {P.byte0(P.limb(a, b, c, d)) == a : U32}
def byte0_limb(a, b, c, d, ea, eb, ec, ed):
  %Equal.sym(U32, a, PD.embed8(B.take(8n, 32n, PD.bits(a))), ID.byte_shape(a, ea)) : {P.byte0(P.limb(_, b, c, d)) == _ : U32}
  %Equal.sym(U32, b, PD.embed8(B.take(8n, 32n, PD.bits(b))), ID.byte_shape(b, eb)) : {P.byte0(P.limb(PD.embed8(B.take(8n, 32n, PD.bits(a))), _, c, d)) == PD.embed8(B.take(8n, 32n, PD.bits(a))) : U32}
  %Equal.sym(U32, c, PD.embed8(B.take(8n, 32n, PD.bits(c))), ID.byte_shape(c, ec)) : {P.byte0(P.limb(PD.embed8(B.take(8n, 32n, PD.bits(a))), PD.embed8(B.take(8n, 32n, PD.bits(b))), _, d)) == PD.embed8(B.take(8n, 32n, PD.bits(a))) : U32}
  %Equal.sym(U32, d, PD.embed8(B.take(8n, 32n, PD.bits(d))), ID.byte_shape(d, ed)) : {P.byte0(P.limb(PD.embed8(B.take(8n, 32n, PD.bits(a))), PD.embed8(B.take(8n, 32n, PD.bits(b))), PD.embed8(B.take(8n, 32n, PD.bits(c))), _)) == PD.embed8(B.take(8n, 32n, PD.bits(a))) : U32}
  byte0_of_limb(B.take(8n, 32n, PD.bits(a)), B.take(8n, 32n, PD.bits(b)), B.take(8n, 32n, PD.bits(c)), B.take(8n, 32n, PD.bits(d)))

