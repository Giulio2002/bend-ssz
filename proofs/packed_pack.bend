  %Equal.sym(U32, d, PD.embed8(B.take(8n, 32n, PD.bits(d))), ID.byte_shape(d, ed)) : {P.byte3(P.limb(PD.embed8(B.take(8n, 32n, PD.bits(a))), PD.embed8(B.take(8n, 32n, PD.bits(b))), PD.embed8(B.take(8n, 32n, PD.bits(c))), _)) == _ : U32}
  byte3_of_limb(B.take(8n, 32n, PD.bits(a)), B.take(8n, 32n, PD.bits(b)), B.take(8n, 32n, PD.bits(c)), B.take(8n, 32n, PD.bits(d)))

# A packed word denotes exactly the four bytes it was assembled from.
law word_bytes_limb:
  for +a: U32
  for +b: U32
  for +c: U32
  for +d: U32
  for +tail: +List<U32>
  for +ea: {U32.is_lt(a, 256) == True{} : Bool}
  for +eb: {U32.is_lt(b, 256) == True{} : Bool}
  for +ec: {U32.is_lt(c, 256) == True{} : Bool}
  for +ed: {U32.is_lt(d, 256) == True{} : Bool}
  {P.word_bytes(P.limb(a, b, c, d), tail) == a <> (b <> (c <> (d <> tail))) : +List<U32>}
def word_bytes_limb(a, b, c, d, tail, ea, eb, ec, ed):
  %Equal.sym(U32, P.byte0(P.limb(a, b, c, d)), a, byte0_limb(a, b, c, d, ea, eb, ec, ed)) : {_ <> (P.byte1(P.limb(a, b, c, d)) <> (P.byte2(P.limb(a, b, c, d)) <> (P.byte3(P.limb(a, b, c, d)) <> tail))) == a <> (b <> (c <> (d <> tail))) : +List<U32>}
  %Equal.sym(U32, P.byte1(P.limb(a, b, c, d)), b, byte1_limb(a, b, c, d, ea, eb, ec, ed)) : {a <> (_ <> (P.byte2(P.limb(a, b, c, d)) <> (P.byte3(P.limb(a, b, c, d)) <> tail))) == a <> (b <> (c <> (d <> tail))) : +List<U32>}
  %Equal.sym(U32, P.byte2(P.limb(a, b, c, d)), c, byte2_limb(a, b, c, d, ea, eb, ec, ed)) : {a <> (b <> (_ <> (P.byte3(P.limb(a, b, c, d)) <> tail))) == a <> (b <> (c <> (d <> tail))) : +List<U32>}
  %Equal.sym(U32, P.byte3(P.limb(a, b, c, d)), d, byte3_limb(a, b, c, d, ea, eb, ec, ed)) : {a <> (b <> (c <> (_ <> tail))) == a <> (b <> (c <> (d <> tail))) : +List<U32>}
  {==}

