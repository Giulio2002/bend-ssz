def bitvector_15_lawg(-h: B.Buf, +hl: Nat, +ehl: {hl == 64n : Nat}, +o: bitvector_15_d.Bitvector15, +e: {LV.bitvector_15_last(o) == U32{WSp.join(15n, 17n, WSp.take(15n, 32n, PD.bits(LV.bitvector_15_last(o))), Word.zero(17n))} : U32})
    -> RR.roots(S.BitsValue{LV.bitvector_15_bits(o)}, Spec.bitvector_15(), [D.bytes(Pair.snd(B.Buf, D.Digest, bitvector_15_h.bv15_root(hl, h, o, 0)))]):
  match o:
    case bitvector_15_d.Bitvector15{+w0}:
      %Equal.sym(U32, w0, U32{WSp.join(15n, 17n, WSp.take(15n, 32n, PD.bits(w0)), Word.zero(17n))}, e) :
        RR.roots(S.BitsValue{BLP.btk(15n, BLP.bitsof([_]))}, Spec.bitvector_15(), [D.bytes(Pair.snd(B.Buf, D.Digest, bitvector_15_h.bv15_root(hl, h, bitvector_15_d.Bitvector15{_}, 0)))])
      bitvector_15_h(h, hl, ehl, WSp.take(15n, 32n, PD.bits(w0)))
# bitvector_15: for every object whose bits past 15 are zero, the runtime root is a
# specification root of its bits.
law bitvector_15_root_correct:
  for -h: B.Buf
  for +o: bitvector_15_d.Bitvector15
  for +e: {LV.bitvector_15_last(o) == U32{WSp.join(15n, 17n, WSp.take(15n, 32n, PD.bits(LV.bitvector_15_last(o))), Word.zero(17n))} : U32}
  RR.roots(S.BitsValue{LV.bitvector_15_bits(o)}, Spec.bitvector_15(), [D.bytes(Pair.snd(B.Buf, D.Digest, bitvector_15_h.bitvector_15_hash_tree_root(h, o)))])
def bitvector_15_root_correct(h, o, e):
  %Equal.sym(B.Buf & D.Digest, bitvector_15_h.bitvector_15_hash_tree_root(h, o), bitvector_15_h.bv15_root(64n, h, o, 0), bitvector_15_htr(h, o)) :
    RR.roots(S.BitsValue{LV.bitvector_15_bits(o)}, Spec.bitvector_15(), [D.bytes(Pair.snd(B.Buf, D.Digest, _))])
  bitvector_15_lawg(h, 64n, {==}, o, e)

