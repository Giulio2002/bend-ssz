    -> RR.roots(S.BitsValue{LV.bitvector_7_bits(o)}, Spec.bitvector_7(), [D.bytes(Pair.snd(B.Buf, D.Digest, bitvector_7_h.bv7_root(hl, h, o, 0)))]):
