    -> RR.roots(S.BitsValue{BLP.btk(15n, BLP.bitsof([U32{WSp.join(15n, 17n, t, Word.zero(17n))}]))}, Spec.bitvector_15(), [D.bytes(Pair.snd(B.Buf, D.Digest, bitvector_15_h.bv15_root(hl, h, bitvector_15_d.Bitvector15{U32{WSp.join(15n, 17n, t, Word.zero(17n))}}, 0)))]):
