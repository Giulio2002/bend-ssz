      %Equal.sym(B.Buf & D.Digest, bitvector_15_h.bv15_root(hl, h, bitvector_15_d.Bitvector15{U32{WSp.join(15n, 17n, WCon{a0, WCon{a1, WCon{a2, WCon{a3, WCon{a4, WCon{a5, WCon{a6, WCon{a7, WCon{a8, WCon{a9, WCon{a10, WCon{a11, WCon{a12, WCon{a13, WCon{a14, WNil{}}}}}}}}}}}}}}}}, Word.zero(17n))}}, 0), (h, MD.rtree(0n, True{}, hl, [D.D{B.swap32(U32{WSp.join(15n, 17n, WCon{a0, WCon{a1, WCon{a2, WCon{a3, WCon{a4, WCon{a5, WCon{a6, WCon{a7, WCon{a8, WCon{a9, WCon{a10, WCon{a11, WCon{a12, WCon{a13, WCon{a14, WNil{}}}}}}}}}}}}}}}}, Word.zero(17n))}), 0, 0, 0, 0, 0, 0, 0}], 0n)), bitvector_15_st(hl, h, a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14)) :
        RR.roots(S.BitsValue{BLP.btk(15n, BLP.bitsof([U32{WSp.join(15n, 17n, WCon{a0, WCon{a1, WCon{a2, WCon{a3, WCon{a4, WCon{a5, WCon{a6, WCon{a7, WCon{a8, WCon{a9, WCon{a10, WCon{a11, WCon{a12, WCon{a13, WCon{a14, WNil{}}}}}}}}}}}}}}}}, Word.zero(17n))}]))}, Spec.bitvector_15(), [D.bytes(Pair.snd(B.Buf, D.Digest, _))])
