  for -h: B.Buf
  for +o: T.Bitvector16
  for +e: {GtED805B7C93_last(o) == U32{WSp.join(16n, 16n, WSp.take(16n, 32n, PD.bits(GtED805B7C93_last(o))), Word.zero(16n))} : U32}
