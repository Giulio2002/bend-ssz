# bitvector_33: for every object whose bits past 33 are zero, the runtime root is a
# specification root of its bits.
law bitvector_33_root_correct:
  for -h: B.Buf
  for +o: bitvector_33_d.Bitvector33
  for +e: {LV.bitvector_33_last(o) == U32{WSp.join(1n, 31n, WSp.take(1n, 32n, PD.bits(LV.bitvector_33_last(o))), Word.zero(31n))} : U32}
  RR.roots(S.BitsValue{LV.bitvector_33_bits(o)}, Spec.bitvector_33(), [D.bytes(Pair.snd(B.Buf, D.Digest, bitvector_33_h.bitvector_33_hash_tree_root(h, o)))])
def bitvector_33_root_correct(h, o, e):
  %Equal.sym(B.Buf & D.Digest, bitvector_33_h.bitvector_33_hash_tree_root(h, o), bitvector_33_h.bv33_root(64n, h, o, 0), bitvector_33_htr(h, o)) :
    RR.roots(S.BitsValue{LV.bitvector_33_bits(o)}, Spec.bitvector_33(), [D.bytes(Pair.snd(B.Buf, D.Digest, _))])
  bitvector_33_lawg(h, 64n, {==}, o, e)

