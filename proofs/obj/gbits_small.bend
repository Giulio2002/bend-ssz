def bitvector_3_st(+hl: Nat, -h: B.Buf, +a0: Bool, +a1: Bool, +a2: Bool) -> {bitvector_3_h.bv3_root(hl, h, bitvector_3_d.Bitvector3{U32{WSp.join(3n, 29n, WCon{a0, WCon{a1, WCon{a2, WNil{}}}}, Word.zero(29n))}}, 0) == (h, MD.rtree(0n, True{}, hl, [D.D{B.swap32(U32{WSp.join(3n, 29n, WCon{a0, WCon{a1, WCon{a2, WNil{}}}}, Word.zero(29n))}), 0, 0, 0, 0, 0, 0, 0}], 0n)) : B.Buf & D.Digest}: {==}
