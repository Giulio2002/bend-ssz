# bitvector_4: for every object whose bits past 4 are zero, the runtime root is a
# specification root of its bits.
law bitvector_4_root_correct:
  for -h: B.Buf
  for +o: Fulu_bitvector_4_d.Bitvector4
  for +e: {LV.bitvector_4_last(o) == U32{WSp.join(4n, 28n, WSp.take(4n, 32n, PD.bits(LV.bitvector_4_last(o))), Word.zero(28n))} : U32}
