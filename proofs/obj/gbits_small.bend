        RR.roots(S.BitsValue{BLP.btk(7n, BLP.bitsof([_]))}, Spec.bitvector_7(), [D.bytes(Pair.snd(B.Buf, D.Digest, bitvector_7_h.bv7_root(hl, h, bitvector_7_d.Bitvector7{_}, 0)))])
