    {Lim.at_depth(Bits.chunk_limit(3n), 0n, Pack.scan(_, 31n, [], [])) == Some{D.bytes(MD.rtree(0n, True{}, hl, [D.D{B.swap32(U32{WSp.join(3n, 29n, WCon{a0, WCon{a1, WCon{a2, WNil{}}}}, Word.zero(29n))}), 0, 0, 0, 0, 0, 0, 0}], 0n))} : Maybe<&2, +List<U32>>}
