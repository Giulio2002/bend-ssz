def bitvector_3_h(-h: B.Buf, +hl: Nat, +ehl: {hl == 64n : Nat}, +t: Word(3n))
    -> RR.roots(S.BitsValue{BLP.btk(3n, BLP.bitsof([U32{WSp.join(3n, 29n, t, Word.zero(29n))}]))}, Spec.bitvector_3(), [D.bytes(Pair.snd(B.Buf, D.Digest, bitvector_3_h.bv3_root(hl, h, bitvector_3_d.Bitvector3{U32{WSp.join(3n, 29n, t, Word.zero(29n))}}, 0)))]):
  match t:
    case WCon{+a0, WCon{+a1, WCon{+a2, WNil{}}}}:
      %Equal.sym(B.Buf & D.Digest, bitvector_3_h.bv3_root(hl, h, bitvector_3_d.Bitvector3{U32{WSp.join(3n, 29n, WCon{a0, WCon{a1, WCon{a2, WNil{}}}}, Word.zero(29n))}}, 0), (h, MD.rtree(0n, True{}, hl, [D.D{B.swap32(U32{WSp.join(3n, 29n, WCon{a0, WCon{a1, WCon{a2, WNil{}}}}, Word.zero(29n))}), 0, 0, 0, 0, 0, 0, 0}], 0n)), bitvector_3_st(hl, h, a0, a1, a2)) :
        RR.roots(S.BitsValue{BLP.btk(3n, BLP.bitsof([U32{WSp.join(3n, 29n, WCon{a0, WCon{a1, WCon{a2, WNil{}}}}, Word.zero(29n))}]))}, Spec.bitvector_3(), [D.bytes(Pair.snd(B.Buf, D.Digest, _))])
      bitvector_3_fin(h, MD.rtree(0n, True{}, hl, [D.D{B.swap32(U32{WSp.join(3n, 29n, WCon{a0, WCon{a1, WCon{a2, WNil{}}}}, Word.zero(29n))}), 0, 0, 0, 0, 0, 0, 0}], 0n), a0, a1, a2, bitvector_3_g(hl, ehl, a0, a1, a2))
def bitvector_3_lawg(-h: B.Buf, +hl: Nat, +ehl: {hl == 64n : Nat}, +o: bitvector_3_d.Bitvector3, +e: {LV.bitvector_3_last(o) == U32{WSp.join(3n, 29n, WSp.take(3n, 32n, PD.bits(LV.bitvector_3_last(o))), Word.zero(29n))} : U32})
    -> RR.roots(S.BitsValue{LV.bitvector_3_bits(o)}, Spec.bitvector_3(), [D.bytes(Pair.snd(B.Buf, D.Digest, bitvector_3_h.bv3_root(hl, h, o, 0)))]):
  match o:
    case bitvector_3_d.Bitvector3{+w0}:
      %Equal.sym(U32, w0, U32{WSp.join(3n, 29n, WSp.take(3n, 32n, PD.bits(w0)), Word.zero(29n))}, e) :
        RR.roots(S.BitsValue{BLP.btk(3n, BLP.bitsof([_]))}, Spec.bitvector_3(), [D.bytes(Pair.snd(B.Buf, D.Digest, bitvector_3_h.bv3_root(hl, h, bitvector_3_d.Bitvector3{_}, 0)))])
      bitvector_3_h(h, hl, ehl, WSp.take(3n, 32n, PD.bits(w0)))
