# bitvector_7: for every object whose bits past 7 are zero, the runtime root is a
# specification root of its bits.
law bitvector_7_root_correct:
  for -h: B.Buf
  for +o: bitvector_7_d.Bitvector7
  for +e: {LV.bitvector_7_last(o) == U32{WSp.join(7n, 25n, WSp.take(7n, 32n, PD.bits(LV.bitvector_7_last(o))), Word.zero(25n))} : U32}
  RR.roots(S.BitsValue{LV.bitvector_7_bits(o)}, Spec.bitvector_7(), [D.bytes(Pair.snd(B.Buf, D.Digest, bitvector_7_h.bitvector_7_hash_tree_root(h, o)))])
def bitvector_7_root_correct(h, o, e):
  %Equal.sym(B.Buf & D.Digest, bitvector_7_h.bitvector_7_hash_tree_root(h, o), bitvector_7_h.bv7_root(64n, h, o, 0), bitvector_7_htr(h, o)) :
    RR.roots(S.BitsValue{LV.bitvector_7_bits(o)}, Spec.bitvector_7(), [D.bytes(Pair.snd(B.Buf, D.Digest, _))])
  bitvector_7_lawg(h, 64n, {==}, o, e)

