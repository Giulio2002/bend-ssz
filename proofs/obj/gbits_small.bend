def bitvector_3_g(+hl: Nat, +ehl: {hl == 64n : Nat}, +a0: Bool, +a1: Bool, +a2: Bool) -> {Bits.bitvector_at_depth(3n, 0n, BLP.btk(3n, BLP.bitsof([U32{WSp.join(3n, 29n, WCon{a0, WCon{a1, WCon{a2, WNil{}}}}, Word.zero(29n))}]))) == Some{D.bytes(MD.rtree(0n, True{}, hl, [D.D{B.swap32(U32{WSp.join(3n, 29n, WCon{a0, WCon{a1, WCon{a2, WNil{}}}}, Word.zero(29n))}), 0, 0, 0, 0, 0, 0, 0}], 0n))} : Maybe<&2, +List<U32>>}:
