def bitvector_6_h(-h: B.Buf, +hl: Nat, +ehl: {hl == 64n : Nat}, +t: Word(6n))
    -> RR.roots(S.BitsValue{BLP.btk(6n, BLP.bitsof([U32{WSp.join(6n, 26n, t, Word.zero(26n))}]))}, Spec.bitvector_6(), [D.bytes(Pair.snd(B.Buf, D.Digest, bitvector_6_h.bv6_root(hl, h, bitvector_6_d.Bitvector6{U32{WSp.join(6n, 26n, t, Word.zero(26n))}}, 0)))]):
  match t:
    case WCon{+a0, WCon{+a1, WCon{+a2, WCon{+a3, WCon{+a4, WCon{+a5, WNil{}}}}}}}:
      %Equal.sym(B.Buf & D.Digest, bitvector_6_h.bv6_root(hl, h, bitvector_6_d.Bitvector6{U32{WSp.join(6n, 26n, WCon{a0, WCon{a1, WCon{a2, WCon{a3, WCon{a4, WCon{a5, WNil{}}}}}}}, Word.zero(26n))}}, 0), (h, MD.rtree(0n, True{}, hl, [D.D{B.swap32(U32{WSp.join(6n, 26n, WCon{a0, WCon{a1, WCon{a2, WCon{a3, WCon{a4, WCon{a5, WNil{}}}}}}}, Word.zero(26n))}), 0, 0, 0, 0, 0, 0, 0}], 0n)), bitvector_6_st(hl, h, a0, a1, a2, a3, a4, a5)) :
        RR.roots(S.BitsValue{BLP.btk(6n, BLP.bitsof([U32{WSp.join(6n, 26n, WCon{a0, WCon{a1, WCon{a2, WCon{a3, WCon{a4, WCon{a5, WNil{}}}}}}}, Word.zero(26n))}]))}, Spec.bitvector_6(), [D.bytes(Pair.snd(B.Buf, D.Digest, _))])
      bitvector_6_fin(h, MD.rtree(0n, True{}, hl, [D.D{B.swap32(U32{WSp.join(6n, 26n, WCon{a0, WCon{a1, WCon{a2, WCon{a3, WCon{a4, WCon{a5, WNil{}}}}}}}, Word.zero(26n))}), 0, 0, 0, 0, 0, 0, 0}], 0n), a0, a1, a2, a3, a4, a5, bitvector_6_g(hl, ehl, a0, a1, a2, a3, a4, a5))
def bitvector_6_lawg(-h: B.Buf, +hl: Nat, +ehl: {hl == 64n : Nat}, +o: bitvector_6_d.Bitvector6, +e: {LV.bitvector_6_last(o) == U32{WSp.join(6n, 26n, WSp.take(6n, 32n, PD.bits(LV.bitvector_6_last(o))), Word.zero(26n))} : U32})
    -> RR.roots(S.BitsValue{LV.bitvector_6_bits(o)}, Spec.bitvector_6(), [D.bytes(Pair.snd(B.Buf, D.Digest, bitvector_6_h.bv6_root(hl, h, o, 0)))]):
  match o:
    case bitvector_6_d.Bitvector6{+w0}:
      %Equal.sym(U32, w0, U32{WSp.join(6n, 26n, WSp.take(6n, 32n, PD.bits(w0)), Word.zero(26n))}, e) :
        RR.roots(S.BitsValue{BLP.btk(6n, BLP.bitsof([_]))}, Spec.bitvector_6(), [D.bytes(Pair.snd(B.Buf, D.Digest, bitvector_6_h.bv6_root(hl, h, bitvector_6_d.Bitvector6{_}, 0)))])
      bitvector_6_h(h, hl, ehl, WSp.take(6n, 32n, PD.bits(w0)))
# bitvector_6: for every object whose bits past 6 are zero, the runtime root is a
# specification root of its bits.
law bitvector_6_root_correct:
  for -h: B.Buf
  for +o: bitvector_6_d.Bitvector6
  for +e: {LV.bitvector_6_last(o) == U32{WSp.join(6n, 26n, WSp.take(6n, 32n, PD.bits(LV.bitvector_6_last(o))), Word.zero(26n))} : U32}
  RR.roots(S.BitsValue{LV.bitvector_6_bits(o)}, Spec.bitvector_6(), [D.bytes(Pair.snd(B.Buf, D.Digest, bitvector_6_h.bitvector_6_hash_tree_root(h, o)))])
def bitvector_6_root_correct(h, o, e):
  %Equal.sym(B.Buf & D.Digest, bitvector_6_h.bitvector_6_hash_tree_root(h, o), bitvector_6_h.bv6_root(64n, h, o, 0), bitvector_6_htr(h, o)) :
    RR.roots(S.BitsValue{LV.bitvector_6_bits(o)}, Spec.bitvector_6(), [D.bytes(Pair.snd(B.Buf, D.Digest, _))])
  bitvector_6_lawg(h, 64n, {==}, o, e)

