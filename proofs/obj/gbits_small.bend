    -> RR.roots(S.BitsValue{BLP.btk(6n, BLP.bitsof([U32{WSp.join(6n, 26n, WCon{a0, WCon{a1, WCon{a2, WCon{a3, WCon{a4, WCon{a5, WNil{}}}}}}}, Word.zero(26n))}]))}, Spec.bitvector_6(), [D.bytes(Pair.snd(B.Buf, D.Digest, (h, r)))]):
