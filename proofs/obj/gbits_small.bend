def bitvector_16_lawg(-h: B.Buf, +hl: Nat, +ehl: {hl == 64n : Nat}, +o: bitvector_16_d.Bitvector16, +e: {LV.bitvector_16_last(o) == U32{WSp.join(16n, 16n, WSp.take(16n, 32n, PD.bits(LV.bitvector_16_last(o))), Word.zero(16n))} : U32})
    -> RR.roots(S.BitsValue{LV.bitvector_16_bits(o)}, Spec.bitvector_16(), [D.bytes(Pair.snd(B.Buf, D.Digest, bitvector_16_h.bv16_root(hl, h, o, 0)))]):
  match o:
    case bitvector_16_d.Bitvector16{+w0}:
      %Equal.sym(U32, w0, U32{WSp.join(16n, 16n, WSp.take(16n, 32n, PD.bits(w0)), Word.zero(16n))}, e) :
        RR.roots(S.BitsValue{BLP.btk(16n, BLP.bitsof([_]))}, Spec.bitvector_16(), [D.bytes(Pair.snd(B.Buf, D.Digest, bitvector_16_h.bv16_root(hl, h, bitvector_16_d.Bitvector16{_}, 0)))])
      bitvector_16_h(h, hl, ehl, WSp.take(16n, 32n, PD.bits(w0)))
# bitvector_16: for every object whose bits past 16 are zero, the runtime root is a
# specification root of its bits.
law bitvector_16_root_correct:
  for -h: B.Buf
  for +o: bitvector_16_d.Bitvector16
  for +e: {LV.bitvector_16_last(o) == U32{WSp.join(16n, 16n, WSp.take(16n, 32n, PD.bits(LV.bitvector_16_last(o))), Word.zero(16n))} : U32}
  RR.roots(S.BitsValue{LV.bitvector_16_bits(o)}, Spec.bitvector_16(), [D.bytes(Pair.snd(B.Buf, D.Digest, bitvector_16_h.bitvector_16_hash_tree_root(h, o)))])
def bitvector_16_root_correct(h, o, e):
  %Equal.sym(B.Buf & D.Digest, bitvector_16_h.bitvector_16_hash_tree_root(h, o), bitvector_16_h.bv16_root(64n, h, o, 0), bitvector_16_htr(h, o)) :
    RR.roots(S.BitsValue{LV.bitvector_16_bits(o)}, Spec.bitvector_16(), [D.bytes(Pair.snd(B.Buf, D.Digest, _))])
  bitvector_16_lawg(h, 64n, {==}, o, e)

