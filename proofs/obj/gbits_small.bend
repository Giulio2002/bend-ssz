# bitvector_31: for every object whose bits past 31 are zero, the runtime root is a
# specification root of its bits.
law bitvector_31_root_correct:
  for -h: B.Buf
  for +o: bitvector_31_d.Bitvector31
  for +e: {LV.bitvector_31_last(o) == U32{WSp.join(31n, 1n, WSp.take(31n, 32n, PD.bits(LV.bitvector_31_last(o))), Word.zero(1n))} : U32}
  RR.roots(S.BitsValue{LV.bitvector_31_bits(o)}, Spec.bitvector_31(), [D.bytes(Pair.snd(B.Buf, D.Digest, bitvector_31_h.bitvector_31_hash_tree_root(h, o)))])
def bitvector_31_root_correct(h, o, e):
  %Equal.sym(B.Buf & D.Digest, bitvector_31_h.bitvector_31_hash_tree_root(h, o), bitvector_31_h.bv31_root(64n, h, o, 0), bitvector_31_htr(h, o)) :
    RR.roots(S.BitsValue{LV.bitvector_31_bits(o)}, Spec.bitvector_31(), [D.bytes(Pair.snd(B.Buf, D.Digest, _))])
  bitvector_31_lawg(h, 64n, {==}, o, e)

