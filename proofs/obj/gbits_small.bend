def bitvector_3_fin(-h: B.Buf, +r: D.Digest, +a0: Bool, +a1: Bool, +a2: Bool, +hg: {Bits.bitvector_at_depth(3n, 0n, BLP.btk(3n, BLP.bitsof([U32{WSp.join(3n, 29n, WCon{a0, WCon{a1, WCon{a2, WNil{}}}}, Word.zero(29n))}]))) == Some{D.bytes(r)} : Maybe<&2, +List<U32>>})
    -> RR.roots(S.BitsValue{BLP.btk(3n, BLP.bitsof([U32{WSp.join(3n, 29n, WCon{a0, WCon{a1, WCon{a2, WNil{}}}}, Word.zero(29n))}]))}, Spec.bitvector_3(), [D.bytes(Pair.snd(B.Buf, D.Digest, (h, r)))]):
