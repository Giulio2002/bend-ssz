# bitvector_17: for every object whose bits past 17 are zero, the runtime root is a
# specification root of its bits.
law bitvector_17_root_correct:
  for -h: B.Buf
  for +o: bitvector_17_d.Bitvector17
  for +e: {LV.bitvector_17_last(o) == U32{WSp.join(17n, 15n, WSp.take(17n, 32n, PD.bits(LV.bitvector_17_last(o))), Word.zero(15n))} : U32}
  RR.roots(S.BitsValue{LV.bitvector_17_bits(o)}, Spec.bitvector_17(), [D.bytes(Pair.snd(B.Buf, D.Digest, bitvector_17_h.bitvector_17_hash_tree_root(h, o)))])
def bitvector_17_root_correct(h, o, e):
  %Equal.sym(B.Buf & D.Digest, bitvector_17_h.bitvector_17_hash_tree_root(h, o), bitvector_17_h.bv17_root(64n, h, o, 0), bitvector_17_htr(h, o)) :
    RR.roots(S.BitsValue{LV.bitvector_17_bits(o)}, Spec.bitvector_17(), [D.bytes(Pair.snd(B.Buf, D.Digest, _))])
  bitvector_17_lawg(h, 64n, {==}, o, e)

