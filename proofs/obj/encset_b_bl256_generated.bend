def bl256_written(+dw: Nat, +T: F.array__Tree<U32>, +N: U32, +i: U32, +q: Nat, +v: U32, +hd: {Nat.is_lt(dw, 32n) == True{} : Bool}, +pf: {F.array__perfect(U32, dw, T) == True{} : Bool}, +hq: {U32.to_nat(U32.shrn(i, 2n)) == q : Nat}, +hk: {Nat.is_lt(q, F.spec_common__pow2(dw)) == True{} : Bool})
