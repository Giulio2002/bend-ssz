    {Codec.parts(_, S.ByteList{256n}) == Some{[S.Variable{E.ENC(E.MW{dw, F.array__upd(U32, dw, T, q, O.merge_word(WR.at(F.array__slots(U32, T), q), v, U32.and(i, 3), 1)), N})}]} : Maybe<&2, +List<S.Part>>}
