  Equal.sym(O.Words, O.words_setw(O.Words{F.array__thaw(U32, T), N}, U32.shrn(i, 2n), O.merge_word(WR.at(F.array__slots(U32, T), q), v, U32.and(i, 3), 1)), E.TH(E.MW{dw, F.array__upd(U32, dw, T, q, O.merge_word(WR.at(F.array__slots(U32, T), q), v, U32.and(i, 3), 1)), N}), WR.setw_thaw(dw, T, N, U32.shrn(i, 2n), q, O.merge_word(WR.at(F.array__slots(U32, T), q), v, U32.and(i, 3), 1), hd, hq, hk, pf))

