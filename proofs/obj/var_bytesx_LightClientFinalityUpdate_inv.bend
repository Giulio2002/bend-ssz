    case Con{S.Fixed{+xs}, Con{+h2, +t2}}: Empty.absurd(FACTS2(bs), hf)
    case Con{S.Variable{+xs}, Con{+h2, +t2}}: Empty.absurd(FACTS2(bs), hf)

def fm2(+hv0: S.Value, +ys0: +List<U32>, +em0: {Codec.parts(hv0, Spec.LightClientHeader()) == Some{[S.Variable{ys0}]} : Maybe<&2, +List<S.Part>>}, +hv1: S.Value, +ys1: +List<U32>, +em1: {Codec.parts(hv1, Spec.LightClientHeader()) == Some{[S.Variable{ys1}]} : Maybe<&2, +List<S.Part>>}, +mm: Maybe<&2, +List<S.Part>>, hf: DF.single_result(Some{224n}, mm), +t: S.Value, +bs: +List<U32>, +e: {Codec.bytes(Codec.aggregate(Codec.concatenate(Some{[S.Variable{ys0}]}, Codec.concatenate(Some{[S.Variable{ys1}]}, Codec.concatenate(mm, Codec.parts(t, S.Chain{Spec.Schema15(), S.Chain{Spec.Schema3(), S.End{}}})))), None{})) == Some{bs} : Maybe<&2, +List<U32>>}) -> FACTS2(bs):
  match mm:
    case None{}: Empty.absurd(FACTS2(bs), F.logic__none_some(+List<U32>, bs, e))
    case Some{+ps}: fp2(hv0, ys0, em0, hv1, ys1, em1, ps, hf, t, bs, e)

def fd2(+hv0: S.Value, +ys0: +List<U32>, +em0: {Codec.parts(hv0, Spec.LightClientHeader()) == Some{[S.Variable{ys0}]} : Maybe<&2, +List<S.Part>>}, +hv1: S.Value, +ys1: +List<U32>, +em1: {Codec.parts(hv1, Spec.LightClientHeader()) == Some{[S.Variable{ys1}]} : Maybe<&2, +List<S.Part>>}, +h: S.Value, +t: S.Value, +bs: +List<U32>, +e: {Codec.bytes(Codec.aggregate(Codec.concatenate(Some{[S.Variable{ys0}]}, Codec.concatenate(Some{[S.Variable{ys1}]}, Codec.concatenate(Codec.parts(h, Spec.Schema12()), Codec.parts(t, S.Chain{Spec.Schema15(), S.Chain{Spec.Schema3(), S.End{}}})))), None{})) == Some{bs} : Maybe<&2, +List<U32>>}) -> FACTS2(bs):
  fm2(hv0, ys0, em0, hv1, ys1, em1, Codec.parts(h, Spec.Schema12()), DS.facts(h, Spec.Schema12(), {==}), t, bs, e)

def st2(+hv0: S.Value, +ys0: +List<U32>, +em0: {Codec.parts(hv0, Spec.LightClientHeader()) == Some{[S.Variable{ys0}]} : Maybe<&2, +List<S.Part>>}, +hv1: S.Value, +ys1: +List<U32>, +em1: {Codec.parts(hv1, Spec.LightClientHeader()) == Some{[S.Variable{ys1}]} : Maybe<&2, +List<S.Part>>}, +items: S.Value, +bs: +List<U32>, +e: {Codec.bytes(Codec.aggregate(Codec.concatenate(Some{[S.Variable{ys0}]}, Codec.concatenate(Some{[S.Variable{ys1}]}, Codec.parts(items, S.Chain{Spec.Schema12(), S.Chain{Spec.Schema15(), S.Chain{Spec.Schema3(), S.End{}}}}))), None{})) == Some{bs} : Maybe<&2, +List<U32>>}) -> FACTS2(bs):
  match items:
    case S.BooleanValue{+b0}: Empty.absurd(FACTS2(bs), F.logic__none_some(+List<U32>, bs, e))
    case S.UnsignedValue{+u0}: Empty.absurd(FACTS2(bs), F.logic__none_some(+List<U32>, bs, e))
    case S.BytesValue{+xs0}: Empty.absurd(FACTS2(bs), F.logic__none_some(+List<U32>, bs, e))
    case S.BitsValue{+bs0}: Empty.absurd(FACTS2(bs), F.logic__none_some(+List<U32>, bs, e))
    case S.Sequence{+it0}: Empty.absurd(FACTS2(bs), F.logic__none_some(+List<U32>, bs, e))
    case S.Items{+h, +t}: fd2(hv0, ys0, em0, hv1, ys1, em1, h, t, bs, e)
    case S.EmptyItems{}: Empty.absurd(FACTS2(bs), F.logic__none_some(+List<U32>, bs, e))
    case S.Selected{+sel0, +sv0}: Empty.absurd(FACTS2(bs), F.logic__none_some(+List<U32>, bs, e))
    case S.NullValue{}: Empty.absurd(FACTS2(bs), F.logic__none_some(+List<U32>, bs, e))

def fp1(+hv0: S.Value, +ys0: +List<U32>, +em0: {Codec.parts(hv0, Spec.LightClientHeader()) == Some{[S.Variable{ys0}]} : Maybe<&2, +List<S.Part>>}, +h: S.Value, +ps: +List<S.Part>, hf: DF.single(None{}, ps), +emh: {Codec.parts(h, Spec.Schema91()) == Some{ps} : Maybe<&2, +List<S.Part>>}, +t: S.Value, +bs: +List<U32>, +e: {Codec.bytes(Codec.aggregate(Codec.concatenate(Some{[S.Variable{ys0}]}, Codec.concatenate(Some{ps}, Codec.parts(t, S.Chain{Spec.Schema12(), S.Chain{Spec.Schema15(), S.Chain{Spec.Schema3(), S.End{}}}}))), None{})) == Some{bs} : Maybe<&2, +List<U32>>}) -> FACTS2(bs):
  match ps:
    case Nil{}: Empty.absurd(FACTS2(bs), hf)
    case Con{S.Fixed{+xs}, Nil{}}: Empty.absurd(FACTS2(bs), F.logic__none_some(Nat, List.length(&2, U32, xs), hf))
    case Con{S.Variable{+ys}, Nil{}}: st2(hv0, ys0, em0, h, ys, emh, t, bs, e)
    case Con{S.Fixed{+xs}, Con{+h2, +t2}}: Empty.absurd(FACTS2(bs), hf)
    case Con{S.Variable{+xs}, Con{+h2, +t2}}: Empty.absurd(FACTS2(bs), hf)

def fm1(+hv0: S.Value, +ys0: +List<U32>, +em0: {Codec.parts(hv0, Spec.LightClientHeader()) == Some{[S.Variable{ys0}]} : Maybe<&2, +List<S.Part>>}, +h: S.Value, +mm: Maybe<&2, +List<S.Part>>, hf: DF.single_result(None{}, mm), +emh: {Codec.parts(h, Spec.Schema91()) == mm : Maybe<&2, +List<S.Part>>}, +t: S.Value, +bs: +List<U32>, +e: {Codec.bytes(Codec.aggregate(Codec.concatenate(Some{[S.Variable{ys0}]}, Codec.concatenate(mm, Codec.parts(t, S.Chain{Spec.Schema12(), S.Chain{Spec.Schema15(), S.Chain{Spec.Schema3(), S.End{}}}}))), None{})) == Some{bs} : Maybe<&2, +List<U32>>}) -> FACTS2(bs):
  match mm:
    case None{}: Empty.absurd(FACTS2(bs), F.logic__none_some(+List<U32>, bs, e))
    case Some{+ps}: fp1(hv0, ys0, em0, h, ps, hf, emh, t, bs, e)

def fd1(+hv0: S.Value, +ys0: +List<U32>, +em0: {Codec.parts(hv0, Spec.LightClientHeader()) == Some{[S.Variable{ys0}]} : Maybe<&2, +List<S.Part>>}, +h: S.Value, +t: S.Value, +bs: +List<U32>, +e: {Codec.bytes(Codec.aggregate(Codec.concatenate(Some{[S.Variable{ys0}]}, Codec.concatenate(Codec.parts(h, Spec.Schema91()), Codec.parts(t, S.Chain{Spec.Schema12(), S.Chain{Spec.Schema15(), S.Chain{Spec.Schema3(), S.End{}}}}))), None{})) == Some{bs} : Maybe<&2, +List<U32>>}) -> FACTS2(bs):
  fm1(hv0, ys0, em0, h, Codec.parts(h, Spec.Schema91()), DS.facts(h, Spec.Schema91(), {==}), {==}, t, bs, e)

def st1(+hv0: S.Value, +ys0: +List<U32>, +em0: {Codec.parts(hv0, Spec.LightClientHeader()) == Some{[S.Variable{ys0}]} : Maybe<&2, +List<S.Part>>}, +items: S.Value, +bs: +List<U32>, +e: {Codec.bytes(Codec.aggregate(Codec.concatenate(Some{[S.Variable{ys0}]}, Codec.parts(items, S.Chain{Spec.Schema91(), S.Chain{Spec.Schema12(), S.Chain{Spec.Schema15(), S.Chain{Spec.Schema3(), S.End{}}}}})), None{})) == Some{bs} : Maybe<&2, +List<U32>>}) -> FACTS2(bs):
  match items:
    case S.BooleanValue{+b0}: Empty.absurd(FACTS2(bs), F.logic__none_some(+List<U32>, bs, e))
    case S.UnsignedValue{+u0}: Empty.absurd(FACTS2(bs), F.logic__none_some(+List<U32>, bs, e))
    case S.BytesValue{+xs0}: Empty.absurd(FACTS2(bs), F.logic__none_some(+List<U32>, bs, e))
    case S.BitsValue{+bs0}: Empty.absurd(FACTS2(bs), F.logic__none_some(+List<U32>, bs, e))
    case S.Sequence{+it0}: Empty.absurd(FACTS2(bs), F.logic__none_some(+List<U32>, bs, e))
    case S.Items{+h, +t}: fd1(hv0, ys0, em0, h, t, bs, e)
    case S.EmptyItems{}: Empty.absurd(FACTS2(bs), F.logic__none_some(+List<U32>, bs, e))
    case S.Selected{+sel0, +sv0}: Empty.absurd(FACTS2(bs), F.logic__none_some(+List<U32>, bs, e))
    case S.NullValue{}: Empty.absurd(FACTS2(bs), F.logic__none_some(+List<U32>, bs, e))

def fp0(+h: S.Value, +ps: +List<S.Part>, hf: DF.single(None{}, ps), +emh: {Codec.parts(h, Spec.Schema91()) == Some{ps} : Maybe<&2, +List<S.Part>>}, +t: S.Value, +bs: +List<U32>, +e: {Codec.bytes(Codec.aggregate(Codec.concatenate(Some{ps}, Codec.parts(t, S.Chain{Spec.Schema91(), S.Chain{Spec.Schema12(), S.Chain{Spec.Schema15(), S.Chain{Spec.Schema3(), S.End{}}}}})), None{})) == Some{bs} : Maybe<&2, +List<U32>>}) -> FACTS2(bs):
  match ps:
    case Nil{}: Empty.absurd(FACTS2(bs), hf)
    case Con{S.Fixed{+xs}, Nil{}}: Empty.absurd(FACTS2(bs), F.logic__none_some(Nat, List.length(&2, U32, xs), hf))
    case Con{S.Variable{+ys}, Nil{}}: st1(h, ys, emh, t, bs, e)
    case Con{S.Fixed{+xs}, Con{+h2, +t2}}: Empty.absurd(FACTS2(bs), hf)
    case Con{S.Variable{+xs}, Con{+h2, +t2}}: Empty.absurd(FACTS2(bs), hf)

def fm0(+h: S.Value, +mm: Maybe<&2, +List<S.Part>>, hf: DF.single_result(None{}, mm), +emh: {Codec.parts(h, Spec.Schema91()) == mm : Maybe<&2, +List<S.Part>>}, +t: S.Value, +bs: +List<U32>, +e: {Codec.bytes(Codec.aggregate(Codec.concatenate(mm, Codec.parts(t, S.Chain{Spec.Schema91(), S.Chain{Spec.Schema12(), S.Chain{Spec.Schema15(), S.Chain{Spec.Schema3(), S.End{}}}}})), None{})) == Some{bs} : Maybe<&2, +List<U32>>}) -> FACTS2(bs):
  match mm:
    case None{}: Empty.absurd(FACTS2(bs), F.logic__none_some(+List<U32>, bs, e))
    case Some{+ps}: fp0(h, ps, hf, emh, t, bs, e)

def fd0(+h: S.Value, +t: S.Value, +bs: +List<U32>, +e: {Codec.bytes(Codec.aggregate(Codec.concatenate(Codec.parts(h, Spec.Schema91()), Codec.parts(t, S.Chain{Spec.Schema91(), S.Chain{Spec.Schema12(), S.Chain{Spec.Schema15(), S.Chain{Spec.Schema3(), S.End{}}}}})), None{})) == Some{bs} : Maybe<&2, +List<U32>>}) -> FACTS2(bs):
  fm0(h, Codec.parts(h, Spec.Schema91()), DS.facts(h, Spec.Schema91(), {==}), {==}, t, bs, e)

def st0(+items: S.Value, +bs: +List<U32>, +e: {Codec.bytes(Codec.aggregate(Codec.parts(items, S.Chain{Spec.Schema91(), S.Chain{Spec.Schema91(), S.Chain{Spec.Schema12(), S.Chain{Spec.Schema15(), S.Chain{Spec.Schema3(), S.End{}}}}}}), None{})) == Some{bs} : Maybe<&2, +List<U32>>}) -> FACTS2(bs):
  match items:
    case S.BooleanValue{+b0}: Empty.absurd(FACTS2(bs), F.logic__none_some(+List<U32>, bs, e))
    case S.UnsignedValue{+u0}: Empty.absurd(FACTS2(bs), F.logic__none_some(+List<U32>, bs, e))
    case S.BytesValue{+xs0}: Empty.absurd(FACTS2(bs), F.logic__none_some(+List<U32>, bs, e))
    case S.BitsValue{+bs0}: Empty.absurd(FACTS2(bs), F.logic__none_some(+List<U32>, bs, e))
    case S.Sequence{+it0}: Empty.absurd(FACTS2(bs), F.logic__none_some(+List<U32>, bs, e))
    case S.Items{+h, +t}: fd0(h, t, bs, e)
    case S.EmptyItems{}: Empty.absurd(FACTS2(bs), F.logic__none_some(+List<U32>, bs, e))
    case S.Selected{+sel0, +sv0}: Empty.absurd(FACTS2(bs), F.logic__none_some(+List<U32>, bs, e))
    case S.NullValue{}: Empty.absurd(FACTS2(bs), F.logic__none_some(+List<U32>, bs, e))

# Every byte string the spec relates to a value has the checked shape.
law inv_v:
  for +v: S.Value
  for +bs: +List<U32>
  for +e: {Codec.encoding_for_legal_type(Spec.LightClientFinalityUpdate(), v) == Some{bs} : Maybe<&2, +List<U32>>}
  FACTS2(bs)
def inv_v(v, bs, e):
  match v:
    case S.BooleanValue{+b0}: Empty.absurd(FACTS2(bs), F.logic__none_some(+List<U32>, bs, e))
    case S.UnsignedValue{+u0}: Empty.absurd(FACTS2(bs), F.logic__none_some(+List<U32>, bs, e))
    case S.BytesValue{+xs0}: Empty.absurd(FACTS2(bs), F.logic__none_some(+List<U32>, bs, e))
    case S.BitsValue{+bs0}: Empty.absurd(FACTS2(bs), F.logic__none_some(+List<U32>, bs, e))
    case S.Sequence{+items}: st0(items, bs, e)
    case S.Items{+hd0, +tl0}: Empty.absurd(FACTS2(bs), F.logic__none_some(+List<U32>, bs, e))
    case S.EmptyItems{}: Empty.absurd(FACTS2(bs), F.logic__none_some(+List<U32>, bs, e))
    case S.Selected{+sel0, +sv0}: Empty.absurd(FACTS2(bs), F.logic__none_some(+List<U32>, bs, e))
    case S.NullValue{}: Empty.absurd(FACTS2(bs), F.logic__none_some(+List<U32>, bs, e))

def q0(xs: +List<U32>) -> U32:
  match xs:
    case Con{h, t}: h
    case Nil{}: 0
def q1(xs: +List<U32>) -> U32:
  match xs:
    case Con{h, t}: q0(t)
    case Nil{}: 0
def q2(xs: +List<U32>) -> U32:
  match xs:
    case Con{h, t}: q1(t)
    case Nil{}: 0
def q3(xs: +List<U32>) -> U32:
  match xs:
    case Con{h, t}: q2(t)
    case Nil{}: 0

# A word whose limbs are those of 400 is 400.
def wordFS(+x: U32, +h: {FX.limbs([x]) == [144, 1, 0, 0] : +List<U32>}) -> {x == 400 : U32}:
  Equal.trans(U32, x, BT.asm(B.byte_sel(0, x), B.byte_sel(1, x), B.byte_sel(2, x), B.byte_sel(3, x)), 400, BT.reassemble(x),
    BT.asm_cong(B.byte_sel(0, x), B.byte_sel(1, x), B.byte_sel(2, x), B.byte_sel(3, x), 144, 1, 0, 0,
      Equal.cong(+List<U32>, U32, l => q0(l), FX.limbs([x]), [144, 1, 0, 0], h),
      Equal.cong(+List<U32>, U32, l => q1(l), FX.limbs([x]), [144, 1, 0, 0], h),
      Equal.cong(+List<U32>, U32, l => q2(l), FX.limbs([x]), [144, 1, 0, 0], h),
      Equal.cong(+List<U32>, U32, l => q3(l), FX.limbs([x]), [144, 1, 0, 0], h)))

# Every value whose spec parts are one variable part has its bytes in the checked shape.
def inv_p(+v: S.Value, +bs: +List<U32>, +e: {Codec.parts(v, Spec.LightClientFinalityUpdate()) == Some{[S.Variable{bs}]} : Maybe<&2, +List<S.Part>>}) -> FACTS2(bs):
  inv_v(v, bs, Equal.cong(Maybe<&2, +List<S.Part>>, Maybe<&2, +List<U32>>, z => Codec.bytes(z), Codec.parts(v, Spec.LightClientFinalityUpdate()), Some{[S.Variable{bs}]}, e))
