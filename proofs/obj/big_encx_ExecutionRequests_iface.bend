  match m:
    case MW{+A_deposits, +N_deposits, +A_withdrawals, +N_withdrawals, +A_consolidations, +N_consolidations}: VALC(A_deposits, N_deposits, A_withdrawals, N_withdrawals, A_consolidations, N_consolidations)
