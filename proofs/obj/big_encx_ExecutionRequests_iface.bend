  match m:
    case MW{+A_deposits, +N_deposits, +A_withdrawals, +N_withdrawals, +A_consolidations, +N_consolidations}: K.SZC(A_deposits, N_deposits, A_withdrawals, N_withdrawals, A_consolidations, N_consolidations)
def XQ(+q: Nat, +r: Nat) -> U32: U32.from_nat(Nat.add(A.quad(q), r))
def PUTX(m: MW, +dd: Nat, +D: FD.array__Tree<U32>, +q: Nat, +r: Nat) -> FD.array__Tree<U32>:
