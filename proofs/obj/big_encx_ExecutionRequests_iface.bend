type MW is Data:
  MW{A_deposits: FD.array__Tree<FuluDepositRequest_d.DepositRequest>, N_deposits: U32, A_withdrawals: FD.array__Tree<FuluWithdrawalRequest_d.WithdrawalRequest>, N_withdrawals: U32, A_consolidations: FD.array__Tree<FuluConsolidationRequest_d.ConsolidationRequest>, N_consolidations: U32}

