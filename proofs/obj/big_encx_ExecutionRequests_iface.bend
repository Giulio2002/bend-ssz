def OKW(m: MW) -> Bool:
  match m:
    case MW{+A_deposits, +N_deposits, +A_withdrawals, +N_withdrawals, +A_consolidations, +N_consolidations}: OKTW(A_deposits, N_deposits, A_withdrawals, N_withdrawals, A_consolidations, N_consolidations)
