# ---- the reader ---------------------------------------------------------------------------------

def OBJw(+d: Nat, +t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32) -> T.ExecutionRequests:
  T.ExecutionRequests{C0.OBJw(d, t, X0(t, x), F0(off, t, x), L0(t, x)), C1.OBJw(d, t, X1(t, x), F1(off, t, x), L1(t, x)), C2.OBJw(d, t, X2(t, x), F2(off, t, x), L2(t, x, len))}

def readw(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hchk: {CHKw(t, x, off, len) == True{} : Bool})
    -> {T.ExecutionRequests_read(BF(t, n), off, len) == (BF(t, n), OBJw(d, t, x, off, len)) : B.Buf & T.ExecutionRequests}:
  +h12 = h12of(d, t, n, x, off, len, eo, hd, hw, pf, hA(t, x, off, len, hchk))
  %Equal.sym(B.Buf & U32, B.read32(BF(t, n), U32.add(off, 0)), (BF(t, n), O0(t, x)), rdo(d, t, n, x, off, len, eo, hd, hw, pf, 0n, 0, {==}, {==}, h12)) :
    {T.ExecutionRequests_rd0(off, len, _) == (BF(t, n), OBJw(d, t, x, off, len)) : B.Buf & T.ExecutionRequests}
  %Equal.sym(B.Buf & U32, B.read32(BF(t, n), U32.add(off, 4)), (BF(t, n), O1(t, x)), rdo(d, t, n, x, off, len, eo, hd, hw, pf, 4n, 4, {==}, {==}, h12)) :
    {T.ExecutionRequests_rd1(off, len, O0(t, x), _) == (BF(t, n), OBJw(d, t, x, off, len)) : B.Buf & T.ExecutionRequests}
  %Equal.sym(B.Buf & U32, B.read32(BF(t, n), U32.add(off, 8)), (BF(t, n), O2(t, x)), rdo(d, t, n, x, off, len, eo, hd, hw, pf, 8n, 8, {==}, {==}, h12)) :
    {T.ExecutionRequests_rd2(off, len, O0(t, x), O1(t, x), _) == (BF(t, n), OBJw(d, t, x, off, len)) : B.Buf & T.ExecutionRequests}
  %Equal.sym(B.Buf & T.l8192_DepositRequest_Seq, T.l8192_DepositRequest_read(BF(t, n), F0(off, t, x), L0(t, x)), (BF(t, n), C0.OBJw(d, t, X0(t, x), F0(off, t, x), L0(t, x))),
      C0.readw(d, t, n, X0(t, x), F0(off, t, x), L0(t, x), eo0(d, t, n, x, off, len, eo, hd, hw, pf, hchk), hd, hw0(d, t, n, x, off, len, eo, hd, hw, pf, hchk), pf, hE(t, x, off, len, hchk))) :
    {T.ExecutionRequests_rd3(off, len, O0(t, x), O1(t, x), O2(t, x), _) == (BF(t, n), OBJw(d, t, x, off, len)) : B.Buf & T.ExecutionRequests}
  %Equal.sym(B.Buf & T.l16_WithdrawalRequest_Seq, T.l16_WithdrawalRequest_read(BF(t, n), F1(off, t, x), L1(t, x)), (BF(t, n), C1.OBJw(d, t, X1(t, x), F1(off, t, x), L1(t, x))),
      C1.readw(d, t, n, X1(t, x), F1(off, t, x), L1(t, x), eo1(d, t, n, x, off, len, eo, hd, hw, pf, hchk), hd, hw1(d, t, n, x, off, len, eo, hd, hw, pf, hchk), pf, hF(t, x, off, len, hchk))) :
    {T.ExecutionRequests_rd4(off, len, O0(t, x), O1(t, x), O2(t, x), C0.OBJw(d, t, X0(t, x), F0(off, t, x), L0(t, x)), _) == (BF(t, n), OBJw(d, t, x, off, len)) : B.Buf & T.ExecutionRequests}
  %Equal.sym(B.Buf & T.l2_ConsolidationRequest_Seq, T.l2_ConsolidationRequest_read(BF(t, n), F2(off, t, x), L2(t, x, len)), (BF(t, n), C2.OBJw(d, t, X2(t, x), F2(off, t, x), L2(t, x, len))),
      C2.readw(d, t, n, X2(t, x), F2(off, t, x), L2(t, x, len), eo2(d, t, n, x, off, len, eo, hd, hw, pf, hchk), hd, hw2(d, t, n, x, off, len, eo, hd, hw, pf, hchk), pf, hG(t, x, off, len, hchk))) :
    {T.ExecutionRequests_rd5(off, len, O0(t, x), O1(t, x), O2(t, x), C0.OBJw(d, t, X0(t, x), F0(off, t, x), L0(t, x)), C1.OBJw(d, t, X1(t, x), F1(off, t, x), L1(t, x)), _) == (BF(t, n), OBJw(d, t, x, off, len)) : B.Buf & T.ExecutionRequests}
  {==}

# ---- the spec side ------------------------------------------------------------------------------

def VALw(+t: FD.array__Tree<U32>, +x: Nat, +len: U32) -> S.Value:
  S.Sequence{S.Items{C0.VALw(t, X0(t, x), L0(t, x)), S.Items{C1.VALw(t, X1(t, x), L1(t, x)), S.Items{C2.VALw(t, X2(t, x), L2(t, x, len)), S.EmptyItems{}}}}}

# the offsets' values
def eO0(+t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32, +h: {CHKw(t, x, off, len) == True{} : Bool}) -> {U32.to_nat(O0(t, x)) == 12n : Nat}:
  Equal.cong(U32, Nat, z => U32.to_nat(z), O0(t, x), 12, FD.u32alg__eq_of(O0(t, x), 12, hB(t, x, off, len, h)))
def eO1(+t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32, +h: {CHKw(t, x, off, len) == True{} : Bool}) -> {U32.to_nat(O1(t, x)) == Nat.add(U32.to_nat(O0(t, x)), U32.to_nat(L0(t, x))) : Nat}:
  Equal.sym(Nat, Nat.add(U32.to_nat(O0(t, x)), U32.to_nat(L0(t, x))), U32.to_nat(O1(t, x)), VM.sub_eq(O1(t, x), O0(t, x), l01(t, x, off, len, h)))
def eO2(+t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32, +h: {CHKw(t, x, off, len) == True{} : Bool}) -> {U32.to_nat(O2(t, x)) == Nat.add(U32.to_nat(O1(t, x)), U32.to_nat(L1(t, x))) : Nat}:
  Equal.sym(Nat, Nat.add(U32.to_nat(O1(t, x)), U32.to_nat(L1(t, x))), U32.to_nat(O2(t, x)), VM.sub_eq(O2(t, x), O1(t, x), l12(t, x, off, len, h)))
def eLn(+t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32, +h: {CHKw(t, x, off, len) == True{} : Bool}) -> {U32.to_nat(len) == Nat.add(U32.to_nat(O2(t, x)), U32.to_nat(L2(t, x, len))) : Nat}:
  Equal.sym(Nat, Nat.add(U32.to_nat(O2(t, x)), U32.to_nat(L2(t, x, len))), U32.to_nat(len), VM.sub_eq(len, O2(t, x), l2n(t, x, off, len, h)))

def elen(+t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32, +h: {CHKw(t, x, off, len) == True{} : Bool})
    -> {U32.to_nat(len) == Nat.add(12n, Nat.add(U32.to_nat(L0(t, x)), Nat.add(U32.to_nat(L1(t, x)), U32.to_nat(L2(t, x, len))))) : Nat}:
  +a = U32.to_nat(L0(t, x))
  +b = U32.to_nat(L1(t, x))
  +c = U32.to_nat(L2(t, x, len))
  %Equal.sym(Nat, U32.to_nat(len), Nat.add(U32.to_nat(O2(t, x)), c), eLn(t, x, off, len, h)) : {_ == Nat.add(12n, Nat.add(a, Nat.add(b, c))) : Nat}
  %Equal.sym(Nat, U32.to_nat(O2(t, x)), Nat.add(U32.to_nat(O1(t, x)), b), eO2(t, x, off, len, h)) : {Nat.add(_, c) == Nat.add(12n, Nat.add(a, Nat.add(b, c))) : Nat}
  %Equal.sym(Nat, U32.to_nat(O1(t, x)), Nat.add(U32.to_nat(O0(t, x)), a), eO1(t, x, off, len, h)) : {Nat.add(Nat.add(_, b), c) == Nat.add(12n, Nat.add(a, Nat.add(b, c))) : Nat}
  %Equal.sym(Nat, U32.to_nat(O0(t, x)), 12n, eO0(t, x, off, len, h)) : {Nat.add(Nat.add(Nat.add(_, a), b), c) == Nat.add(12n, Nat.add(a, Nat.add(b, c))) : Nat}
  %Equal.sym(Nat, Nat.add(Nat.add(Nat.add(12n, a), b), c), Nat.add(Nat.add(12n, a), Nat.add(b, c)), FD.nat__add_assoc(Nat.add(12n, a), b, c)) :
    {_ == Nat.add(12n, Nat.add(a, Nat.add(b, c))) : Nat}
  FD.nat__add_assoc(12n, a, Nat.add(b, c))

# The window's bytes: the offset words, then the three lists' windows.
def win3(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +h: {CHKw(t, x, off, len) == True{} : Bool})
    -> {UW.WX(t, x, U32.to_nat(len)) == List.append(&2, U32, F.limbs([O0(t, x), O1(t, x), O2(t, x)]), List.append(&2, U32, UW.WX(t, X0(t, x), U32.to_nat(L0(t, x))), List.append(&2, U32, UW.WX(t, X1(t, x), U32.to_nat(L1(t, x))), UW.WX(t, X2(t, x), U32.to_nat(L2(t, x, len)))))) : +List<U32>}:
  +a = U32.to_nat(L0(t, x))
  +b = U32.to_nat(L1(t, x))
  +c = U32.to_nat(L2(t, x, len))
  +R = Nat.add(a, Nat.add(b, c))
  +hwR = FD.logic__subst(Nat, z => {Nat.is_le(Nat.add(x, z), A.quad(VB.pw(d))) == True{} : Bool}, U32.to_nat(len), Nat.add(12n, R), elen(t, x, off, len, h), hw)
  %Equal.sym(Nat, U32.to_nat(len), Nat.add(12n, R), elen(t, x, off, len, h)) : {UW.WX(t, x, _) == List.append(&2, U32, F.limbs([O0(t, x), O1(t, x), O2(t, x)]), List.append(&2, U32, UW.WX(t, X0(t, x), U32.to_nat(L0(t, x))), List.append(&2, U32, UW.WX(t, X1(t, x), U32.to_nat(L1(t, x))), UW.WX(t, X2(t, x), U32.to_nat(L2(t, x, len)))))) : +List<U32>}
  %Equal.sym(+List<U32>, UW.WX(t, x, Nat.add(A.quad(3n), R)), List.append(&2, U32, F.limbs(UR.RWS(3n, t, x)), UW.WX(t, Nat.add(A.quad(3n), x), R)), UW.headWX(d, t, x, 3n, R, pf, hwR)) :
    {_ == List.append(&2, U32, F.limbs([O0(t, x), O1(t, x), O2(t, x)]), List.append(&2, U32, UW.WX(t, X0(t, x), U32.to_nat(L0(t, x))), List.append(&2, U32, UW.WX(t, X1(t, x), U32.to_nat(L1(t, x))), UW.WX(t, X2(t, x), U32.to_nat(L2(t, x, len)))))) : +List<U32>}
  %Equal.cong(Nat, Nat, z => Nat.add(z, x), U32.to_nat(O0(t, x)), 12n, eO0(t, x, off, len, h)) :
    {List.append(&2, U32, F.limbs(UR.RWS(3n, t, x)), UW.WX(t, _, R)) == List.append(&2, U32, F.limbs([O0(t, x), O1(t, x), O2(t, x)]), List.append(&2, U32, UW.WX(t, X0(t, x), U32.to_nat(L0(t, x))), List.append(&2, U32, UW.WX(t, X1(t, x), U32.to_nat(L1(t, x))), UW.WX(t, X2(t, x), U32.to_nat(L2(t, x, len)))))) : +List<U32>}
  %Equal.sym(+List<U32>, UW.WX(t, X0(t, x), Nat.add(a, Nat.add(b, c))), List.append(&2, U32, UW.WX(t, X0(t, x), a), UW.WX(t, Nat.add(a, X0(t, x)), Nat.add(b, c))), VRC.splitWX(t, X0(t, x), a, Nat.add(b, c))) :
    {List.append(&2, U32, F.limbs(UR.RWS(3n, t, x)), _) == List.append(&2, U32, F.limbs([O0(t, x), O1(t, x), O2(t, x)]), List.append(&2, U32, UW.WX(t, X0(t, x), U32.to_nat(L0(t, x))), List.append(&2, U32, UW.WX(t, X1(t, x), U32.to_nat(L1(t, x))), UW.WX(t, X2(t, x), U32.to_nat(L2(t, x, len)))))) : +List<U32>}
  %VRC.pnext(U32.to_nat(O0(t, x)), U32.to_nat(O1(t, x)), a, x, eO1(t, x, off, len, h)) :
    {List.append(&2, U32, F.limbs(UR.RWS(3n, t, x)), List.append(&2, U32, UW.WX(t, X0(t, x), a), UW.WX(t, _, Nat.add(b, c)))) == List.append(&2, U32, F.limbs([O0(t, x), O1(t, x), O2(t, x)]), List.append(&2, U32, UW.WX(t, X0(t, x), U32.to_nat(L0(t, x))), List.append(&2, U32, UW.WX(t, X1(t, x), U32.to_nat(L1(t, x))), UW.WX(t, X2(t, x), U32.to_nat(L2(t, x, len)))))) : +List<U32>}
  %Equal.sym(+List<U32>, UW.WX(t, X1(t, x), Nat.add(b, c)), List.append(&2, U32, UW.WX(t, X1(t, x), b), UW.WX(t, Nat.add(b, X1(t, x)), c)), VRC.splitWX(t, X1(t, x), b, c)) :
    {List.append(&2, U32, F.limbs(UR.RWS(3n, t, x)), List.append(&2, U32, UW.WX(t, X0(t, x), a), _)) == List.append(&2, U32, F.limbs([O0(t, x), O1(t, x), O2(t, x)]), List.append(&2, U32, UW.WX(t, X0(t, x), U32.to_nat(L0(t, x))), List.append(&2, U32, UW.WX(t, X1(t, x), U32.to_nat(L1(t, x))), UW.WX(t, X2(t, x), U32.to_nat(L2(t, x, len)))))) : +List<U32>}
  %VRC.pnext(U32.to_nat(O1(t, x)), U32.to_nat(O2(t, x)), b, x, eO2(t, x, off, len, h)) :
    {List.append(&2, U32, F.limbs(UR.RWS(3n, t, x)), List.append(&2, U32, UW.WX(t, X0(t, x), a), List.append(&2, U32, UW.WX(t, X1(t, x), b), UW.WX(t, _, c)))) == List.append(&2, U32, F.limbs([O0(t, x), O1(t, x), O2(t, x)]), List.append(&2, U32, UW.WX(t, X0(t, x), U32.to_nat(L0(t, x))), List.append(&2, U32, UW.WX(t, X1(t, x), U32.to_nat(L1(t, x))), UW.WX(t, X2(t, x), U32.to_nat(L2(t, x, len)))))) : +List<U32>}
  {==}

def specw(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hchk: {CHKw(t, x, off, len) == True{} : Bool})
    -> {Codec.parts(VALw(t, x, len), Spec.ExecutionRequests()) == Some{[S.Variable{UW.WX(t, x, U32.to_nat(len))}]} : Maybe<&2, +List<S.Part>>}:
