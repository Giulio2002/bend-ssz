    -> {O.ac_c3(a, b, F.array__thaw(U32, D), (F.array__thaw(U32, S), F.flat__nthc(F.array__slots(U32, S), Nat.add(3n, A)))) == (F.array__thaw(U32, cpt(dd, 5n, Nat.add(3n, A), Nat.add(3n, Bn), D, F.array__slots(U32, S))), F.array__thaw(U32, S)) : Array<U32> & Array<U32>}:
  +kb = Nat.add(3n, Bn)
  +eb1 = ix(b, 3, Bn, dd, eb, hdd, F.nat__lt_le(Nat.add(3n, Bn), F.spec_common__pow2(dd), lt_off(3n, 8n, Bn, F.spec_common__pow2(dd), {==}, hB)))
  +hb1 = lt_off(3n, 8n, Bn, F.spec_common__pow2(dd), {==}, hB)
  +ea1 = ix(a, 4, A, ds, ea, hs, F.nat__lt_le(Nat.add(4n, A), F.spec_common__pow2(ds), lt_off(4n, 8n, A, F.spec_common__pow2(ds), {==}, hA)))
  +ha1 = lt_off(4n, 8n, A, F.spec_common__pow2(ds), {==}, hA)
  %Equal.sym(Array<U32>, Array.set(U32, F.array__thaw(U32, D), U32.add(b, 3), F.flat__nthc(F.array__slots(U32, S), Nat.add(3n, A))), F.array__thaw(U32, F.array__upd(U32, dd, D, kb, F.flat__nthc(F.array__slots(U32, S), Nat.add(3n, A)))), setv(dd, D, U32.add(b, 3), kb, F.flat__nthc(F.array__slots(U32, S), Nat.add(3n, A)), eb1, hdd, hb1, pd)) :
    {O.ac_c4(a, b, _, Array.get(U32, F.array__thaw(U32, S), U32.add(a, 4))) == (F.array__thaw(U32, cpt(dd, 5n, Nat.add(3n, A), Nat.add(3n, Bn), D, F.array__slots(U32, S))), F.array__thaw(U32, S)) : Array<U32> & Array<U32>}
  %Equal.sym(Array<U32> & U32, Array.get(U32, F.array__thaw(U32, S), U32.add(a, 4)), (F.array__thaw(U32, S), F.flat__nthc(F.array__slots(U32, S), Nat.add(4n, A))), getv(ds, S, U32.add(a, 4), Nat.add(4n, A), ea1, hs, ha1, ps)) :
    {O.ac_c4(a, b, F.array__thaw(U32, F.array__upd(U32, dd, D, kb, F.flat__nthc(F.array__slots(U32, S), Nat.add(3n, A)))), _) == (F.array__thaw(U32, cpt(dd, 5n, Nat.add(3n, A), Nat.add(3n, Bn), D, F.array__slots(U32, S))), F.array__thaw(U32, S)) : Array<U32> & Array<U32>}
  c4(a, b, A, Bn, ds, dd, S, F.array__upd(U32, dd, D, kb, F.flat__nthc(F.array__slots(U32, S), Nat.add(3n, A))), ea, eb, hs, hdd, hA, hB, ps,
    F.array__upd_perfect(U32, dd, D, kb, F.flat__nthc(F.array__slots(U32, S), Nat.add(3n, A)), pd))

def c2(+a: U32, +b: U32, +A: Nat, +Bn: Nat, +ds: Nat, +dd: Nat, +S: F.array__Tree<U32>, +D: F.array__Tree<U32>,
    +ea: {U32.to_nat(a) == A : Nat}, +eb: {U32.to_nat(b) == Bn : Nat},
    +hs: {Nat.is_lt(ds, 32n) == True{} : Bool}, +hdd: {Nat.is_lt(dd, 32n) == True{} : Bool},
    +hA: {Nat.is_le(Nat.add(8n, A), F.spec_common__pow2(ds)) == True{} : Bool}, +hB: {Nat.is_le(Nat.add(8n, Bn), F.spec_common__pow2(dd)) == True{} : Bool},
    +ps: {F.array__perfect(U32, ds, S) == True{} : Bool}, +pd: {F.array__perfect(U32, dd, D) == True{} : Bool})
