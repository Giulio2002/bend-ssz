  +h3 = F.logic__subst(Nat, z => {Nat.is_le(Nat.add(U32.to_nat(a), U32.to_nat(c)), z) == True{} : Bool}, F.spec_common__pow2(d), U32.to_nat(F.u32__pow2u(d)), Equal.sym(Nat, U32.to_nat(F.u32__pow2u(d)), F.spec_common__pow2(d), F.u32__pow2u_value(d, hd)), h2)
  %Equal.cong(Nat, Nat, z => Nat.add(U32.to_nat(c), z), U32.to_nat(a), A, ea) :
    {U32.to_nat(U32.add(a, c)) == _ : Nat}
  %F.nat__add_comm(U32.to_nat(a), U32.to_nat(c)) :
    {U32.to_nat(U32.add(a, c)) == _ : Nat}
