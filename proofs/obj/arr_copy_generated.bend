# GENERATED by array_copy_and_emit_laws (codegen: copy_module). Do not edit.

def oct(k: Nat) -> Nat:
  match k:
    case 0n: 0n
    case 1n+p: 8n+oct(p)

# k single-word copies: word a + j of sl into slot b + j of D, j = 0 .. k - 1.
def cpt(+dd: Nat, k: Nat, +a: Nat, +b: Nat, D: F.array__Tree<U32>, +sl: List<&2, U32>) -> F.array__Tree<U32>:
  match k:
    case 0n: D
    case 1n+p: cpt(dd, p, 1n+a, 1n+b, F.array__upd(U32, dd, D, b, F.flat__nthc(sl, a)), sl)

law cpt_perfect:
  for +dd: Nat
  for +k: Nat
  for +a: Nat
  for +b: Nat
  for +D: F.array__Tree<U32>
  for +sl: List<&2, U32>
  for +pd: {F.array__perfect(U32, dd, D) == True{} : Bool}
  {F.array__perfect(U32, dd, cpt(dd, k, a, b, D, sl)) == True{} : Bool}
def cpt_perfect(dd, k, a, b, D, sl, pd):
  match k:
    case 0n: pd
    case 1n+ +p: cpt_perfect(dd, p, 1n+a, 1n+b, F.array__upd(U32, dd, D, b, F.flat__nthc(sl, a)), sl,
      F.array__upd_perfect(U32, dd, D, b, F.flat__nthc(sl, a), pd))

# ---- Nat facts -----------------------------------------------------------------

law le_addl:
  for +c: Nat
  for +x: Nat
  {Nat.is_le(x, Nat.add(c, x)) == True{} : Bool}
def le_addl(c, x):
  match c:
    case 0n: F.nat__le_refl(x)
    case 1n+ +q: F.nat__le_trans(x, Nat.add(q, x), 1n+Nat.add(q, x), le_addl(q, x), F.nat__le_succ(Nat.add(q, x)))

law lt_addr:
  for +j: Nat
  for +c: Nat
  for +x: Nat
  for +h: {Nat.is_lt(j, c) == True{} : Bool}
  {Nat.is_lt(Nat.add(j, x), Nat.add(c, x)) == True{} : Bool}
def lt_addr(j, c, x, h):
  match j c:
    case 0n 0n: Empty.absurd({Nat.is_lt(Nat.add(0n, x), Nat.add(0n, x)) == True{} : Bool}, F.logic__false_true(h))
    case 0n 1n+ +q: F.nat__le_lt_succ(x, Nat.add(q, x), le_addl(q, x))
    case 1n+ +i 0n: Empty.absurd({Nat.is_lt(Nat.add(1n+i, x), Nat.add(0n, x)) == True{} : Bool}, F.logic__false_true(h))
    case 1n+ +i 1n+ +q: lt_addr(i, q, x, h)

# j + x < P from c + x <= P and j < c.
def lt_off(+j: Nat, +c: Nat, +x: Nat, +P: Nat, +hj: {Nat.is_lt(j, c) == True{} : Bool},
    +h: {Nat.is_le(Nat.add(c, x), P) == True{} : Bool}) -> {Nat.is_lt(Nat.add(j, x), P) == True{} : Bool}:
  F.nat__lt_le_trans(Nat.add(j, x), Nat.add(c, x), P, lt_addr(j, c, x, hj), h)

