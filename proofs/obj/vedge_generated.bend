  kvr1(d, t, n, X, hd, pf, hb, VR.RX(X), {==}, UA.rx_lt(X))

# The low 2 byte(s) the runtime reads at X are those of RW(t, X), for X + 2 inside the buffer
# (word q + 1 may lie past it: its bytes are then not kept).
def kvr2(+d: Nat, +t: F.array__Tree<U32>, +n: U32, +X: U32, +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +pf: {F.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(U32.to_nat(X), 2n), A.quad(VB.pw(d))) == True{} : Bool}, +r: Nat, +er: {VR.RX(X) == r : Nat}, +hr: {Nat.is_lt(r, 4n) == True{} : Bool}) -> {O.keep(2, RV(t, n, X)) == O.keep(2, UA.RW(t, X)) : U32}:
  match r:
    case 0n:
      +e3 = F.u32__injective(U32.and(X, 3), 0, er)
      +hq = VR.hiX(d, X, U32.to_nat(X), {==}, VXG.ltx(U32.to_nat(X), 2n, A.quad(VB.pw(d)), {==}, hb))
      %Equal.sym(U32, U32.and(X, 3), 0, e3) : {O.keep(2, Pair.snd(B.Buf, U32, B.read32_choose(X, _, U32.is_eq(_, 0), UA.BF(t, n)))) == O.keep(2, UA.RW(t, X)) : U32}
      %Equal.sym(B.Buf & U32, B.word(UA.BF(t, n), U32.shrn(X, 2n)), (UA.BF(t, n), VB.slot(t, VR.QX(X))), VR.rdw(d, t, n, U32.shrn(X, 2n), VR.QX(X), {==}, VB.lt32(d, hd), hq, pf)) :
        {O.keep(2, Pair.snd(B.Buf, U32, _)) == O.keep(2, UA.RW(t, X)) : U32}
      %Equal.sym(Nat, VR.RX(X), 0n, er) : {O.keep(2, VB.slot(t, VR.QX(X))) == O.keep(2, UA.jn(_, VB.slot(t, VR.QX(X)), VB.slot(t, 1n+VR.QX(X)))) : U32}
      {==}
    case 1n:
      +e3 = F.u32__injective(U32.and(X, 3), 1, er)
      +hq = VR.hiX(d, X, U32.to_nat(X), {==}, VXG.ltx(U32.to_nat(X), 2n, A.quad(VB.pw(d)), {==}, hb))
      %Equal.sym(U32, U32.and(X, 3), 1, e3) : {O.keep(2, Pair.snd(B.Buf, U32, B.read32_choose(X, _, U32.is_eq(_, 0), UA.BF(t, n)))) == O.keep(2, UA.RW(t, X)) : U32}
      %Equal.sym(B.Buf & U32, B.word(UA.BF(t, n), U32.shrn(X, 2n)), (UA.BF(t, n), VB.slot(t, VR.QX(X))), VR.rdw(d, t, n, U32.shrn(X, 2n), VR.QX(X), {==}, VB.lt32(d, hd), hq, pf)) :
        {O.keep(2, Pair.snd(B.Buf, U32, B.read32_split(X, 1, _))) == O.keep(2, UA.RW(t, X)) : U32}
      %Equal.sym(B.Buf & U32, B.word(UA.BF(t, n), U32.add(U32.shrn(X, 2n), 1)), (UA.BF(t, n), GW(t, U32.add(U32.shrn(X, 2n), 1))), wsame(t, n, U32.add(U32.shrn(X, 2n), 1))) :
        {O.keep(2, Pair.snd(B.Buf, U32, B.join_words(1, VB.slot(t, VR.QX(X)), _))) == O.keep(2, UA.RW(t, X)) : U32}
      %Equal.sym(Nat, VR.RX(X), 1n, er) : {O.keep(2, B.join_sel(1, VB.slot(t, VR.QX(X)), GW(t, U32.add(U32.shrn(X, 2n), 1)))) == O.keep(2, UA.jn(_, VB.slot(t, VR.QX(X)), VB.slot(t, 1n+VR.QX(X)))) : U32}
      Equal.trans(U32, O.keep(2, B.join_sel(1, VB.slot(t, VR.QX(X)), GW(t, U32.add(U32.shrn(X, 2n), 1)))), O.keep(2, B.join_sel(1, VB.slot(t, VR.QX(X)), 0)), O.keep(2, B.join_sel(1, VB.slot(t, VR.QX(X)), VB.slot(t, 1n+VR.QX(X)))), kz12(VB.slot(t, VR.QX(X)), GW(t, U32.add(U32.shrn(X, 2n), 1))), Equal.sym(U32, O.keep(2, B.join_sel(1, VB.slot(t, VR.QX(X)), VB.slot(t, 1n+VR.QX(X)))), O.keep(2, B.join_sel(1, VB.slot(t, VR.QX(X)), 0)), kz12(VB.slot(t, VR.QX(X)), VB.slot(t, 1n+VR.QX(X)))))
    case 2n:
      +e3 = F.u32__injective(U32.and(X, 3), 2, er)
      +hq = VR.hiX(d, X, U32.to_nat(X), {==}, VXG.ltx(U32.to_nat(X), 2n, A.quad(VB.pw(d)), {==}, hb))
      %Equal.sym(U32, U32.and(X, 3), 2, e3) : {O.keep(2, Pair.snd(B.Buf, U32, B.read32_choose(X, _, U32.is_eq(_, 0), UA.BF(t, n)))) == O.keep(2, UA.RW(t, X)) : U32}
      %Equal.sym(B.Buf & U32, B.word(UA.BF(t, n), U32.shrn(X, 2n)), (UA.BF(t, n), VB.slot(t, VR.QX(X))), VR.rdw(d, t, n, U32.shrn(X, 2n), VR.QX(X), {==}, VB.lt32(d, hd), hq, pf)) :
        {O.keep(2, Pair.snd(B.Buf, U32, B.read32_split(X, 2, _))) == O.keep(2, UA.RW(t, X)) : U32}
      %Equal.sym(B.Buf & U32, B.word(UA.BF(t, n), U32.add(U32.shrn(X, 2n), 1)), (UA.BF(t, n), GW(t, U32.add(U32.shrn(X, 2n), 1))), wsame(t, n, U32.add(U32.shrn(X, 2n), 1))) :
        {O.keep(2, Pair.snd(B.Buf, U32, B.join_words(2, VB.slot(t, VR.QX(X)), _))) == O.keep(2, UA.RW(t, X)) : U32}
      %Equal.sym(Nat, VR.RX(X), 2n, er) : {O.keep(2, B.join_sel(2, VB.slot(t, VR.QX(X)), GW(t, U32.add(U32.shrn(X, 2n), 1)))) == O.keep(2, UA.jn(_, VB.slot(t, VR.QX(X)), VB.slot(t, 1n+VR.QX(X)))) : U32}
      Equal.trans(U32, O.keep(2, B.join_sel(2, VB.slot(t, VR.QX(X)), GW(t, U32.add(U32.shrn(X, 2n), 1)))), O.keep(2, B.join_sel(2, VB.slot(t, VR.QX(X)), 0)), O.keep(2, B.join_sel(2, VB.slot(t, VR.QX(X)), VB.slot(t, 1n+VR.QX(X)))), kz22(VB.slot(t, VR.QX(X)), GW(t, U32.add(U32.shrn(X, 2n), 1))), Equal.sym(U32, O.keep(2, B.join_sel(2, VB.slot(t, VR.QX(X)), VB.slot(t, 1n+VR.QX(X)))), O.keep(2, B.join_sel(2, VB.slot(t, VR.QX(X)), 0)), kz22(VB.slot(t, VR.QX(X)), VB.slot(t, 1n+VR.QX(X)))))
    case 3n:
      +e3 = F.u32__injective(U32.and(X, 3), 3, er)
      +hq = VR.hiX(d, X, U32.to_nat(X), {==}, VXG.ltx(U32.to_nat(X), 2n, A.quad(VB.pw(d)), {==}, hb))
      %Equal.sym(U32, U32.and(X, 3), 3, e3) : {O.keep(2, Pair.snd(B.Buf, U32, B.read32_choose(X, _, U32.is_eq(_, 0), UA.BF(t, n)))) == O.keep(2, UA.RW(t, X)) : U32}
      %Equal.sym(B.Buf & U32, B.word(UA.BF(t, n), U32.shrn(X, 2n)), (UA.BF(t, n), VB.slot(t, VR.QX(X))), VR.rdw(d, t, n, U32.shrn(X, 2n), VR.QX(X), {==}, VB.lt32(d, hd), hq, pf)) :
        {O.keep(2, Pair.snd(B.Buf, U32, B.read32_split(X, 3, _))) == O.keep(2, UA.RW(t, X)) : U32}
      +e4 = Equal.trans(Nat, U32.to_nat(X), Nat.add(A.quad(VR.QX(X)), VR.RX(X)), Nat.add(A.quad(VR.QX(X)), 3n), VC.split4(X),
        Equal.cong(Nat, Nat, z => Nat.add(A.quad(VR.QX(X)), z), VR.RX(X), 3n, er))
      +hq1 = q1x(VR.QX(X), VB.pw(d), F.logic__subst(Nat, z => {Nat.is_le(Nat.add(z, 2n), A.quad(VB.pw(d))) == True{} : Bool}, U32.to_nat(X), Nat.add(A.quad(VR.QX(X)), 3n), e4, hb))
      %Equal.sym(B.Buf & U32, B.word(UA.BF(t, n), U32.add(U32.shrn(X, 2n), 1)), (UA.BF(t, n), VB.slot(t, 1n+VR.QX(X))),
          VR.rdw(d, t, n, U32.add(U32.shrn(X, 2n), 1), 1n+VR.QX(X), VB.add_le_at(U32.shrn(X, 2n), 1, VR.QX(X), d, {==}, hd, F.nat__lt_le(1n+VR.QX(X), VB.pw(d), hq1)), VB.lt32(d, hd), hq1, pf)) :
        {O.keep(2, Pair.snd(B.Buf, U32, B.join_words(3, VB.slot(t, VR.QX(X)), _))) == O.keep(2, UA.RW(t, X)) : U32}
      %Equal.sym(Nat, VR.RX(X), 3n, er) : {O.keep(2, B.join_sel(3, VB.slot(t, VR.QX(X)), VB.slot(t, 1n+VR.QX(X)))) == O.keep(2, UA.jn(_, VB.slot(t, VR.QX(X)), VB.slot(t, 1n+VR.QX(X)))) : U32}
      {==}
    case 4n+s: Empty.absurd({O.keep(2, RV(t, n, X)) == O.keep(2, UA.RW(t, X)) : U32}, F.nat__lt_zero_absurd(s, hr))

def kv2(+d: Nat, +t: F.array__Tree<U32>, +n: U32, +X: U32, +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +pf: {F.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(U32.to_nat(X), 2n), A.quad(VB.pw(d))) == True{} : Bool}) -> {O.keep(2, RV(t, n, X)) == O.keep(2, UA.RW(t, X)) : U32}:
  kvr2(d, t, n, X, hd, pf, hb, VR.RX(X), {==}, UA.rx_lt(X))

