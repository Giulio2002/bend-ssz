    case 1n+p: FD.nat__zero_le(p)

def nz(+y: Nat, +h: {Nat.is_eq(y, 0n) == False{} : Bool}) -> {Nat.is_le(1n, y) == True{} : Bool}:
  match y:
    case 0n: Empty.absurd({Nat.is_le(1n, 0n) == True{} : Bool}, FD.logic__true_false(h))
    case 1n+p: FD.nat__zero_le(p)

