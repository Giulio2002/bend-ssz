      %Equal.sym(B.Buf & (Bool & U32), T.l1048576_bl1073741824_ee(ok, off, len, a, (UA.BF(t, n), nb)), (UA.BF(t, n), (EE(ok, t, x, off, len, a, nb), nb)), ee_ev(d, t, n, x, off, len, eo, hd, hw, pf, ok, a, nb)) :
