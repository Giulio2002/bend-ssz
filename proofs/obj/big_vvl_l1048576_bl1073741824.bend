def el_b(+t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32, +a: U32, +b: U32, +h: {EE(True{}, t, x, off, len, a, b) == True{} : Bool})
    -> {Nat.is_le(U32.to_nat(b), U32.to_nat(len)) == True{} : Bool}:
