# ---- what CHKw says about each element -------------------------------------------------------------

def ev_ok(k: Nat, +i: U32, +m: U32, +t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32, +ok: Bool, +a: U32,
    +h: {EV(k, i, m, t, x, off, len, ok, a) == True{} : Bool}) -> {ok == True{} : Bool}:
  match k:
    case 0n: h
    case 1n+q:
