# ==== BeaconState in the encoder-window interface ====

type MW is Data:
  MW{wR: K.KW}

def lenE(+wR: K.KW, +h: {OKT(wR) == True{} : Bool}) -> {VCN.LN(K.ENCC(wR)) == ENDCs(wR, U32.to_nat(2737225)) : Nat}:
  FD.logic__subst(+List<U32>, zq => {VCN.LN(zq) == ENDCs(wR, U32.to_nat(2737225)) : Nat}, K.ENCCs(wR, 24624n, U32.to_nat(65536), U32.to_nat(262144), U32.to_nat(2097152)), K.ENCC(wR), encq2(wR), lenE_core(wR, h, 24624n, {==}, U32.to_nat(65536), {==}, U32.to_nat(262144), {==}, U32.to_nat(2097152), {==}, U32.to_nat(2737225), {==}))

def TH(m: MW) -> FuluBeaconState_d.BeaconState:
  match m:
    case MW{+wR}: K.OBJC(wR)
def OK(m: MW) -> Bool:
  match m:
    case MW{+wR}: OKT(wR)
def ENC(m: MW) -> +List<U32>:
  match m:
    case MW{+wR}: K.ENCC(wR)
def VAL(m: MW) -> S.Value:
  match m:
    case MW{+wR}: VALC(wR)
def SZ(m: MW) -> U32:
  match m:
    case MW{+wR}: K.SZC(wR)
def XQ(+q: Nat, +r: Nat) -> U32: U32.from_nat(Nat.add(A.quad(q), r))
def PUTX(m: MW, +dd: Nat, +D: FD.array__Tree<U32>, +q: Nat, +r: Nat) -> FD.array__Tree<U32>:
  match m:
    case MW{+wR}: K.PUTC(wR, dd, D, XQ(q, r), q, r)
def PADB(+r: Nat, m: MW) -> Nat: WD.PADB(r, List.length(&2, U32, ENC(m)))

# the putx laws' hypotheses and goal between ENC(m) (List.length/append, PADB) and VCN.LN/AP, generic in m
def hlm(+q: Nat, +r: Nat, +dd: Nat, m: MW, +hl: {Nat.is_le(Nat.add(q, WD.NWN(Nat.add(r, List.length(&2, U32, ENC(m))))), VB.pw(dd)) == True{} : Bool}) -> {Nat.is_le(Nat.add(q, WD.NWN(Nat.add(r, VCN.LN(ENC(m))))), VB.pw(dd)) == True{} : Bool}: hl
