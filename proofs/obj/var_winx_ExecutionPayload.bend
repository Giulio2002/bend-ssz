    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hc1: {CC1(t, x, len) == True{} : Bool}, +b: Bool, +eb: {CC2(t, x, len) == b : Bool})
    -> {FuluExecutionPayload_r.ExecutionPayload_c2(b, BF(t, n), off, len, O0(t, x), O1(t, x), O2(t, x)) == (BF(t, n), Bool.and(b, KC4(t, x, off, len))) : B.Buf & Bool}:
  match b:
    case True{}:
      %Equal.sym(B.Buf & Bool, Fulu_bytelist_32_r.bl32_ok(BF(t, n), U32.add(off, O0(t, x)), U32.sub(O1(t, x), O0(t, x))), (BF(t, n), CE0(t, x, off, len)),
          C0.ok_evalw(d, t, n, X0(t, x), F0(off, t, x), L0(t, x), eoc0(d, t, n, x, off, len, eo, hd, hw, pf, hc1), hd, hwc0(d, t, n, x, off, len, eo, hd, hw, pf, hc1), pf)) :
        {FuluExecutionPayload_r.ExecutionPayload_v3(off, len, O0(t, x), O1(t, x), O2(t, x), _) == (BF(t, n), KC4(t, x, off, len)) : B.Buf & Bool}
      okc3(d, t, n, x, off, len, eo, hd, hw, pf, hc1, eb, CE0(t, x, off, len))
    case False{}: {==}
def okc1(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hFS: {Nat.is_le(Nat.add(x, 528n), A.quad(VB.pw(d))) == True{} : Bool}, +b: Bool, +eb: {CC1(t, x, len) == b : Bool})
    -> {FuluExecutionPayload_r.ExecutionPayload_c1(b, BF(t, n), off, len, O0(t, x), O1(t, x)) == (BF(t, n), Bool.and(b, KC3(t, x, off, len))) : B.Buf & Bool}:
  match b:
    case True{}:
      %Equal.sym(B.Buf & U32, B.read32(BF(t, n), U32.add(off, 508)), (BF(t, n), O2(t, x)), rdo(d, t, n, x, off, len, eo, hd, hw, pf, 508n, 508, {==}, {==}, hFS)) :
        {FuluExecutionPayload_r.ExecutionPayload_v2(off, len, O0(t, x), O1(t, x), _) == (BF(t, n), KC3(t, x, off, len)) : B.Buf & Bool}
      okc2(d, t, n, x, off, len, eo, hd, hw, pf, eb, CC2(t, x, len), {==})
    case False{}: {==}
def okc0(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hFS: {Nat.is_le(Nat.add(x, 528n), A.quad(VB.pw(d))) == True{} : Bool}, +b: Bool)
    -> {FuluExecutionPayload_r.ExecutionPayload_c0(b, BF(t, n), off, len, O0(t, x)) == (BF(t, n), Bool.and(b, KC2(t, x, off, len))) : B.Buf & Bool}:
  match b:
    case True{}:
      %Equal.sym(B.Buf & U32, B.read32(BF(t, n), U32.add(off, 504)), (BF(t, n), O1(t, x)), rdo(d, t, n, x, off, len, eo, hd, hw, pf, 504n, 504, {==}, {==}, hFS)) :
        {FuluExecutionPayload_r.ExecutionPayload_v1(off, len, O0(t, x), _) == (BF(t, n), KC2(t, x, off, len)) : B.Buf & Bool}
      okc1(d, t, n, x, off, len, eo, hd, hw, pf, hFS, CC1(t, x, len), {==})
    case False{}: {==}
def okA(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +a: Bool, +ea: {CA(len) == a : Bool})
    -> {FuluExecutionPayload_r.ExecutionPayload_ok_len(a, BF(t, n), off, len) == (BF(t, n), Bool.and(a, KC1(t, x, off, len))) : B.Buf & Bool}:
  match a:
    case True{}:
      +hFS = hFSof(d, t, n, x, off, len, eo, hd, hw, pf, ea)
      %Equal.sym(B.Buf & U32, B.read32(BF(t, n), U32.add(off, 436)), (BF(t, n), O0(t, x)), rdo(d, t, n, x, off, len, eo, hd, hw, pf, 436n, 436, {==}, {==}, hFS)) :
        {FuluExecutionPayload_r.ExecutionPayload_v0(off, len, _) == (BF(t, n), KC1(t, x, off, len)) : B.Buf & Bool}
      okc0(d, t, n, x, off, len, eo, hd, hw, pf, hFS, CB(t, x))
    case False{}: {==}

# The validator on the window returns the buffer and CHKw(t, x, off, len).
def ok_evalw(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}) -> {FuluExecutionPayload_r.ExecutionPayload_ok(BF(t, n), off, len) == (BF(t, n), CHKw(t, x, off, len)) : B.Buf & Bool}:
  okA(d, t, n, x, off, len, eo, hd, hw, pf, CA(len), {==})

# ---- what the checks give -----------------------------------------------------------------------

def kk0(+t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32, +h: {CHKw(t, x, off, len) == True{} : Bool}) -> {KC0(t, x, off, len) == True{} : Bool}: h
def kk1(+t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32, +h: {CHKw(t, x, off, len) == True{} : Bool}) -> {KC1(t, x, off, len) == True{} : Bool}: FD.logic__and_right(CA(len), KC1(t, x, off, len), kk0(t, x, off, len, h))
def kk2(+t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32, +h: {CHKw(t, x, off, len) == True{} : Bool}) -> {KC2(t, x, off, len) == True{} : Bool}: FD.logic__and_right(CB(t, x), KC2(t, x, off, len), kk1(t, x, off, len, h))
def kk3(+t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32, +h: {CHKw(t, x, off, len) == True{} : Bool}) -> {KC3(t, x, off, len) == True{} : Bool}: FD.logic__and_right(CC1(t, x, len), KC3(t, x, off, len), kk2(t, x, off, len, h))
def kk4(+t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32, +h: {CHKw(t, x, off, len) == True{} : Bool}) -> {KC4(t, x, off, len) == True{} : Bool}: FD.logic__and_right(CC2(t, x, len), KC4(t, x, off, len), kk3(t, x, off, len, h))
def kk5(+t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32, +h: {CHKw(t, x, off, len) == True{} : Bool}) -> {KC5(t, x, off, len) == True{} : Bool}: FD.logic__and_right(CE0(t, x, off, len), KC5(t, x, off, len), kk4(t, x, off, len, h))
def kk6(+t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32, +h: {CHKw(t, x, off, len) == True{} : Bool}) -> {KC6(t, x, off, len) == True{} : Bool}: FD.logic__and_right(CE1(t, x, off, len), KC6(t, x, off, len), kk5(t, x, off, len, h))
def q0(+t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32, +h: {CHKw(t, x, off, len) == True{} : Bool}) -> {CA(len) == True{} : Bool}: FD.logic__and_left(CA(len), KC1(t, x, off, len), kk0(t, x, off, len, h))
def q1(+t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32, +h: {CHKw(t, x, off, len) == True{} : Bool}) -> {CB(t, x) == True{} : Bool}: FD.logic__and_left(CB(t, x), KC2(t, x, off, len), kk1(t, x, off, len, h))
def q2(+t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32, +h: {CHKw(t, x, off, len) == True{} : Bool}) -> {CC1(t, x, len) == True{} : Bool}: FD.logic__and_left(CC1(t, x, len), KC3(t, x, off, len), kk2(t, x, off, len, h))
def q3(+t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32, +h: {CHKw(t, x, off, len) == True{} : Bool}) -> {CC2(t, x, len) == True{} : Bool}: FD.logic__and_left(CC2(t, x, len), KC4(t, x, off, len), kk3(t, x, off, len, h))
def q4(+t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32, +h: {CHKw(t, x, off, len) == True{} : Bool}) -> {CE0(t, x, off, len) == True{} : Bool}: FD.logic__and_left(CE0(t, x, off, len), KC5(t, x, off, len), kk4(t, x, off, len, h))
def q5(+t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32, +h: {CHKw(t, x, off, len) == True{} : Bool}) -> {CE1(t, x, off, len) == True{} : Bool}: FD.logic__and_left(CE1(t, x, off, len), KC6(t, x, off, len), kk5(t, x, off, len, h))
def q6(+t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32, +h: {CHKw(t, x, off, len) == True{} : Bool}) -> {CE2(t, x, off, len) == True{} : Bool}: kk6(t, x, off, len, h)

# ---- the reader ---------------------------------------------------------------------------------

# c + x <= 4 2^d for c <= 528.
def hcx(+d: Nat, +x: Nat, +len: U32, +c: Nat, +hc: {Nat.is_le(c, 528n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +ha: {U32.is_le(528, len) == True{} : Bool})
    -> {Nat.is_le(Nat.add(c, x), A.quad(VB.pw(d))) == True{} : Bool}:
  FD.nat__le_trans(Nat.add(c, x), Nat.add(U32.to_nat(len), x), A.quad(VB.pw(d)),
    Order.add_right(c, U32.to_nat(len), x, FD.nat__le_trans(c, 528n, U32.to_nat(len), hc, leFS(len, ha))),
    FD.logic__subst(Nat, z => {Nat.is_le(z, A.quad(VB.pw(d))) == True{} : Bool}, Nat.add(x, U32.to_nat(len)), Nat.add(U32.to_nat(len), x), FD.nat__add_comm(x, U32.to_nat(len)), hw))

# The byte offset off + c of header byte c <= 528 is at c + x.
def eocf(+d: Nat, +x: Nat, +off: U32, +len: U32, +c: U32, +hc: {Nat.is_le(U32.to_nat(c), 528n) == True{} : Bool}, +eo: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +ha: {U32.is_le(528, len) == True{} : Bool})
    -> {U32.to_nat(U32.add(off, c)) == Nat.add(U32.to_nat(c), x) : Nat}:
  VB.add_le_at(off, c, x, 2n+d, eo, FD.nat__lt_trans(d, 28n, 29n, hd, {==}), hcx(d, x, len, U32.to_nat(c), hc, hw, ha))

# Room for a field of s bytes at c + x, for c + s <= 528.
def roomc(+d: Nat, +x: Nat, +len: U32, +c: Nat, +s: Nat, +hc: {Nat.is_le(Nat.add(c, s), 528n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +ha: {U32.is_le(528, len) == True{} : Bool})
    -> {Nat.is_le(Nat.add(Nat.add(c, x), s), A.quad(VB.pw(d))) == True{} : Bool}:
  UR.roomf(x, U32.to_nat(len), c, s, A.quad(VB.pw(d)), hw, FD.nat__le_trans(Nat.add(c, s), 528n, U32.to_nat(len), hc, leFS(len, ha)))

def OBJw(+d: Nat, +t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32) -> FuluExecutionPayload_d.ExecutionPayload: FuluExecutionPayload_d.ExecutionPayload{FuluExecutionPayload_d.ExecutionPayload_g0{FuluBytes32_d.Bytes32{UR.RWN(t, x), UR.RWN(t, 4n+x), UR.RWN(t, 8n+x), UR.RWN(t, 12n+x), UR.RWN(t, 16n+x), UR.RWN(t, 20n+x), UR.RWN(t, 24n+x), UR.RWN(t, 28n+x)}, FuluBytes20_d.Bytes20{UR.RWN(t, 32n+x), UR.RWN(t, 36n+x), UR.RWN(t, 40n+x), UR.RWN(t, 44n+x), UR.RWN(t, 48n+x)}, FuluBytes32_d.Bytes32{UR.RWN(t, 52n+x), UR.RWN(t, 56n+x), UR.RWN(t, 60n+x), UR.RWN(t, 64n+x), UR.RWN(t, 68n+x), UR.RWN(t, 72n+x), UR.RWN(t, 76n+x), UR.RWN(t, 80n+x)}, FuluBytes32_d.Bytes32{UR.RWN(t, 84n+x), UR.RWN(t, 88n+x), UR.RWN(t, 92n+x), UR.RWN(t, 96n+x), UR.RWN(t, 100n+x), UR.RWN(t, 104n+x), UR.RWN(t, 108n+x), UR.RWN(t, 112n+x)}, O.Words{FD.array__thaw(U32, UCT.CT(d, t, U32.add(off, 116), 256, 7n)), 256}, FuluBytes32_d.Bytes32{UR.RWN(t, 256n+116n+x), UR.RWN(t, 256n+120n+x), UR.RWN(t, 256n+124n+x), UR.RWN(t, 256n+128n+x), UR.RWN(t, 256n+132n+x), UR.RWN(t, 256n+136n+x), UR.RWN(t, 256n+140n+x), UR.RWN(t, 256n+144n+x)}, O.U64{UR.RWN(t, 256n+148n+x), UR.RWN(t, 256n+152n+x)}, O.U64{UR.RWN(t, 256n+156n+x), UR.RWN(t, 256n+160n+x)}}, FuluExecutionPayload_d.ExecutionPayload_g1{O.U64{UR.RWN(t, 256n+164n+x), UR.RWN(t, 256n+168n+x)}, O.U64{UR.RWN(t, 256n+172n+x), UR.RWN(t, 256n+176n+x)}, C0.OBJw(d, t, X0(t, x), F0(off, t, x), L0(t, x)), uint256_d.Uint256{UR.RWN(t, 256n+184n+x), UR.RWN(t, 256n+188n+x), UR.RWN(t, 256n+192n+x), UR.RWN(t, 256n+196n+x), UR.RWN(t, 256n+200n+x), UR.RWN(t, 256n+204n+x), UR.RWN(t, 256n+208n+x), UR.RWN(t, 256n+212n+x)}, FuluBytes32_d.Bytes32{UR.RWN(t, 256n+216n+x), UR.RWN(t, 256n+220n+x), UR.RWN(t, 256n+224n+x), UR.RWN(t, 256n+228n+x), UR.RWN(t, 256n+232n+x), UR.RWN(t, 256n+236n+x), UR.RWN(t, 256n+240n+x), UR.RWN(t, 256n+244n+x)}, C1.OBJw(d, t, X1(t, x), F1(off, t, x), L1(t, x)), C2.OBJw(d, t, X2(t, x), F2(off, t, x), L2(t, x, len)), O.U64{UR.RWN(t, 256n+256n+x), UR.RWN(t, 256n+256n+4n+x)}}, FuluExecutionPayload_d.ExecutionPayload_g2{O.U64{UR.RWN(t, 256n+256n+8n+x), UR.RWN(t, 256n+256n+12n+x)}}}

# When the window's checks hold, the reader returns OBJw(d, t, x, off, len).
def readw(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hchk: {CHKw(t, x, off, len) == True{} : Bool})
    -> {FuluExecutionPayload_r.ExecutionPayload_read(BF(t, n), off, len) == (BF(t, n), OBJw(d, t, x, off, len)) : B.Buf & FuluExecutionPayload_d.ExecutionPayload}:
  +ha = q0(t, x, off, len, hchk)
  +hFS = hFSof(d, t, n, x, off, len, eo, hd, hw, pf, ha)
  +hd30 = FD.nat__lt_trans(d, 28n, 30n, hd, {==})
  +hd31 = FD.nat__lt_trans(d, 28n, 31n, hd, {==})
  %Equal.sym(B.Buf & U32, B.read32(BF(t, n), U32.add(off, 436)), (BF(t, n), O0(t, x)), rdo(d, t, n, x, off, len, eo, hd, hw, pf, 436n, 436, {==}, {==}, hFS)) :
    {FuluExecutionPayload_r.ExecutionPayload_rd0(off, len, _) == (BF(t, n), OBJw(d, t, x, off, len)) : B.Buf & FuluExecutionPayload_d.ExecutionPayload}
  %Equal.sym(B.Buf & FuluBytes32_d.Bytes32, FuluBytes32_r.b32_read(BF(t, n), U32.add(off, 0), 32), (BF(t, n), FuluBytes32_d.Bytes32{UR.RWN(t, x), UR.RWN(t, 4n+x), UR.RWN(t, 8n+x), UR.RWN(t, 12n+x), UR.RWN(t, 16n+x), UR.RWN(t, 20n+x), UR.RWN(t, 24n+x), UR.RWN(t, 28n+x)}),
      VTX.rdx_b32(d, t, n, U32.add(off, 0), x, eocf(d, x, off, len, 0, {==}, eo, hd, hw, ha), hd30, pf, roomc(d, x, len, 0n, 32n, {==}, hw, ha))) :
    {FuluExecutionPayload_r.ExecutionPayload_rd1(off, len, O0(t, x), FuluExecutionPayload_r.ExecutionPayload_g0_rd0(off, len, O0(t, x), _)) == (BF(t, n), OBJw(d, t, x, off, len)) : B.Buf & FuluExecutionPayload_d.ExecutionPayload}
  %Equal.sym(B.Buf & FuluBytes20_d.Bytes20, FuluBytes20_r.b20_read(BF(t, n), U32.add(off, 32), 20), (BF(t, n), FuluBytes20_d.Bytes20{UR.RWN(t, 32n+x), UR.RWN(t, 36n+x), UR.RWN(t, 40n+x), UR.RWN(t, 44n+x), UR.RWN(t, 48n+x)}),
      VTX.rdx_b20(d, t, n, U32.add(off, 32), 32n+x, eocf(d, x, off, len, 32, {==}, eo, hd, hw, ha), hd30, pf, roomc(d, x, len, 32n, 20n, {==}, hw, ha))) :
    {FuluExecutionPayload_r.ExecutionPayload_rd1(off, len, O0(t, x), FuluExecutionPayload_r.ExecutionPayload_g0_rd1(off, len, O0(t, x), FuluBytes32_d.Bytes32{UR.RWN(t, x), UR.RWN(t, 4n+x), UR.RWN(t, 8n+x), UR.RWN(t, 12n+x), UR.RWN(t, 16n+x), UR.RWN(t, 20n+x), UR.RWN(t, 24n+x), UR.RWN(t, 28n+x)}, _)) == (BF(t, n), OBJw(d, t, x, off, len)) : B.Buf & FuluExecutionPayload_d.ExecutionPayload}
  %Equal.sym(B.Buf & FuluBytes32_d.Bytes32, FuluBytes32_r.b32_read(BF(t, n), U32.add(off, 52), 32), (BF(t, n), FuluBytes32_d.Bytes32{UR.RWN(t, 52n+x), UR.RWN(t, 56n+x), UR.RWN(t, 60n+x), UR.RWN(t, 64n+x), UR.RWN(t, 68n+x), UR.RWN(t, 72n+x), UR.RWN(t, 76n+x), UR.RWN(t, 80n+x)}),
      VTX.rdx_b32(d, t, n, U32.add(off, 52), 52n+x, eocf(d, x, off, len, 52, {==}, eo, hd, hw, ha), hd30, pf, roomc(d, x, len, 52n, 32n, {==}, hw, ha))) :
    {FuluExecutionPayload_r.ExecutionPayload_rd1(off, len, O0(t, x), FuluExecutionPayload_r.ExecutionPayload_g0_rd2(off, len, O0(t, x), FuluBytes32_d.Bytes32{UR.RWN(t, x), UR.RWN(t, 4n+x), UR.RWN(t, 8n+x), UR.RWN(t, 12n+x), UR.RWN(t, 16n+x), UR.RWN(t, 20n+x), UR.RWN(t, 24n+x), UR.RWN(t, 28n+x)}, FuluBytes20_d.Bytes20{UR.RWN(t, 32n+x), UR.RWN(t, 36n+x), UR.RWN(t, 40n+x), UR.RWN(t, 44n+x), UR.RWN(t, 48n+x)}, _)) == (BF(t, n), OBJw(d, t, x, off, len)) : B.Buf & FuluExecutionPayload_d.ExecutionPayload}
