# ---- the list's spec side -------------------------------------------------------------------------

# The records j .. j + c - 1 are valid.
def ALLV(c: Nat, +j: Nat, +t: FD.array__Tree<U32>, +x: Nat) -> Bool:
  match c:
    case 0n: True{}
    case 1n+q: Bool.and(VCK(t, VRL.pos(j, 121n, x)), ALLV(q, 1n+j, t, x))

def cka_acc(k: Nat, +j: Nat, +acc: Bool, +t: FD.array__Tree<U32>, +x: Nat, +h: {CKA(k, j, acc, t, x) == True{} : Bool}) -> {acc == True{} : Bool}:
  match k:
    case 0n: FD.logic__and_left(acc, VCK(t, VRL.pos(j, 121n, x)), h)
    case 1n+ +q: FD.logic__and_left(acc, VCK(t, VRL.pos(j, 121n, x)), cka_acc(q, 1n+j, Bool.and(acc, VCK(t, VRL.pos(j, 121n, x))), t, x, h))

def cka_all(k: Nat, +j: Nat, +acc: Bool, +t: FD.array__Tree<U32>, +x: Nat, +h: {CKA(k, j, acc, t, x) == True{} : Bool}) -> {ALLV(1n+k, j, t, x) == True{} : Bool}:
  match k:
    case 0n: FD.logic__and_intro(VCK(t, VRL.pos(j, 121n, x)), True{}, FD.logic__and_right(acc, VCK(t, VRL.pos(j, 121n, x)), h), {==})
    case 1n+ +q:
      FD.logic__and_intro(VCK(t, VRL.pos(j, 121n, x)), ALLV(1n+q, 1n+j, t, x), FD.logic__and_right(acc, VCK(t, VRL.pos(j, 121n, x)), cka_acc(q, 1n+j, Bool.and(acc, VCK(t, VRL.pos(j, 121n, x))), t, x, h)),
        cka_all(q, 1n+j, Bool.and(acc, VCK(t, VRL.pos(j, 121n, x))), t, x, h))

def zck_all(+t: FD.array__Tree<U32>, +x: Nat, +len: U32, +e: Bool, +ee: {U32.is_eq(NN(len), 0) == e : Bool}, +h: {ZCK(e, t, x, len) == True{} : Bool})
    -> {ALLV(CC(len), 0n, t, x) == True{} : Bool}:
  match e:
    case True{}:
      %Equal.cong(U32, Nat, z => U32.to_nat(z), 0, NN(len), Equal.sym(U32, NN(len), 0, FD.u32alg__eq_of(NN(len), 0, ee))) : {ALLV(_, 0n, t, x) == True{} : Bool}
      {==}
    case False{}:
      +c = CC(len)
      +h1 = cpos(NN(len), ee, c, {==})
      +e1 = Equal.trans(Nat, 1n+KK(len), 1n+Nat.sub(c, 1n), c, Equal.cong(Nat, Nat, z => 1n+z, KK(len), Nat.sub(c, 1n), FD.u32__sub_nat(NN(len), 1, h1)), FD.nat__sub_add(c, 1n, h1))
      FD.logic__subst(Nat, z => {ALLV(z, 0n, t, x) == True{} : Bool}, 1n+KK(len), c, e1, cka_all(KK(len), 0n, True{}, t, x, h))

def allv(+t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32, +hchk: {CHKw(t, x, off, len) == True{} : Bool}) -> {ALLV(CC(len), 0n, t, x) == True{} : Bool}:
  zck_all(t, x, len, U32.is_eq(NN(len), 0), {==}, lck_z(Bool.and(U32.is_eq(len, (U32.div(len, 121) * 121 : U32)), True{}), t, x, len, hchk))

def RITEMS(c: Nat, +j: Nat, +t: FD.array__Tree<U32>, +x: Nat) -> S.Value:
  match c:
    case 0n: S.EmptyItems{}
    case 1n+q: S.Items{RVAL(t, VRL.pos(j, 121n, x)), RITEMS(q, 1n+j, t, x)}

def RPARTS(c: Nat, +j: Nat, +t: FD.array__Tree<U32>, +x: Nat) -> +List<S.Part>:
  match c:
    case 0n: []
    case 1n+q: S.Fixed{UW.WX(t, VRL.pos(j, 121n, x), 121n)} <> RPARTS(q, 1n+j, t, x)

def FLAT(c: Nat, +j: Nat, +t: FD.array__Tree<U32>, +x: Nat) -> +List<U32>:
  match c:
    case 0n: []
    case 1n+q: List.append(&2, U32, UW.WX(t, VRL.pos(j, 121n, x), 121n), FLAT(q, 1n+j, t, x))

law cnt_items:
  for +c: Nat
  for +j: Nat
  for +t: FD.array__Tree<U32>
  for +x: Nat
  {Codec.count(RITEMS(c, j, t, x)) == c : Nat}
