  match c:
    case 0n: {==}
    case 1n+ +q: FD.nat__succ_cong(Codec.count(RITEMS(q, 1n+j, t, x)), q, cnt_items(q, 1n+j, t, x))

# Record j fits when records j .. j + q do.
def fitc(+j: Nat, +q: Nat, +x: Nat, +P: Nat, +h: {Nat.is_le(VRL.pos(Nat.add(1n+q, j), 121n, x), P) == True{} : Bool}) -> {Nat.is_le(Nat.add(VRL.pos(j, 121n, x), 121n), P) == True{} : Bool}:
