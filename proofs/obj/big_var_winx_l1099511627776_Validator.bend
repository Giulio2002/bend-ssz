law prt_items:
  for c: Nat
  for +j: Nat
  for +d: Nat
  for +t: FD.array__Tree<U32>
  for +x: Nat
  for +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}
  for +hb: {Nat.is_le(VRL.pos(Nat.add(c, j), 121n, x), A.quad(VB.pw(d))) == True{} : Bool}
  for +hv: {ALLV(c, j, t, x) == True{} : Bool}
  {Codec.parts(RITEMS(c, j, t, x), S.Repeat{Spec.Schema58()}) == Some{RPARTS(c, j, t, x)} : Maybe<&2, +List<S.Part>>}
def prt_items(c, j, d, t, x, pf, hb, hv):
  match c:
    case 0n: {==}
    case 1n+ +q:
      F.cat_fixed(Codec.parts(RVAL(t, VRL.pos(j, 121n, x)), Spec.Schema58()), UW.WX(t, VRL.pos(j, 121n, x), 121n), Codec.parts(RITEMS(q, 1n+j, t, x), S.Repeat{Spec.Schema58()}), RPARTS(q, 1n+j, t, x),
        rprt(d, t, VRL.pos(j, 121n, x), pf, fitc(j, q, x, A.quad(VB.pw(d)), hb), FD.logic__and_left(VCK(t, VRL.pos(j, 121n, x)), ALLV(q, 1n+j, t, x), hv)),
        prt_items(q, 1n+j, d, t, x, pf, hbs(j, q, x, A.quad(VB.pw(d)), hb), FD.logic__and_right(VCK(t, VRL.pos(j, 121n, x)), ALLV(q, 1n+j, t, x), hv)))

law rp_size:
  for c: Nat
  for +j: Nat
  for +d: Nat
  for +t: FD.array__Tree<U32>
  for +x: Nat
  for +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}
  for +hb: {Nat.is_le(VRL.pos(Nat.add(c, j), 121n, x), A.quad(VB.pw(d))) == True{} : Bool}
  {Layout.fixed_size(RPARTS(c, j, t, x)) == Nat.mul(c, 121n) : Nat}
