      Equal.cong(Nat, Nat, z => Nat.add(121n, z), Layout.fixed_size(RPARTS(q, 1n+j, t, x)), Nat.mul(q, 121n), rp_size(q, 1n+j, d, t, x, pf, hbs(j, q, x, A.quad(VB.pw(d)), hb)))

