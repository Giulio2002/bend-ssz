      +hj2 = FD.logic__subst(Nat, z => {Nat.is_le(A.quad(Nat.mul(z, 104n)), LT) == True{} : Bool}, 1n+Nat.add(p, j), Nat.add(p, 1n+j), Equal.sym(Nat, Nat.add(p, 1n+j), 1n+Nat.add(p, j), FD.nat__add_succ(p, j)), hj)
