def specEm(+m: MB<M_ProposerSlashing>, +h: {EOK(m) == True{} : Bool}) -> {Codec.parts(EVm(m), Spec.Schema31()) == Some{[S.Fixed{YEm(m)}]} : Maybe<&2, +List<S.Part>>}:
