    case Nil{}: Empty.absurd({FD.spec_common__nth(MB<M_ProposerSlashing>, Nil{}, i) == Some{xat_l16_ProposerSlashing(Nil{}, i)} : Maybe<&2, MB<M_ProposerSlashing>>}, MD.false_true(Equal.trans(Bool, False{}, Nat.is_lt(i, 0n), True{}, Equal.sym(Bool, Nat.is_lt(i, 0n), False{}, FD.nat__not_lt_zero(i)), hi)))
    case Con{+x, +t}:
      match i:
        case 0n: {==}
        case 1n+ +j: nth_l16_ProposerSlashing(t, j, hi)

