def PXEm(+m: MB<M_ProposerSlashing>, +dd: Nat, +D: FD.array__Tree<U32>, +q: Nat, +r: Nat) -> FD.array__Tree<U32>:
  match m:
    case MNone{}: D
    case MSome{+v}: PXE(v, dd, D, q, r)
def YEm(+m: MB<M_ProposerSlashing>) -> +List<U32>:
  match m:
    case MNone{}: UW.ZB(416n)
    case MSome{+v}: YE(v)
def pfEm(+m: MB<M_ProposerSlashing>, +dd: Nat, +D: FD.array__Tree<U32>, +q: Nat, +r: Nat, +pf: {FD.array__perfect(U32, dd, D) == True{} : Bool})
    -> {FD.array__perfect(U32, dd, PXEm(m, dd, D, q, r)) == True{} : Bool}:
  match m:
    case MNone{}: pf
    case MSome{+v}: pfE(v, dd, D, q, r, pf)
def lenEz(+m: MB<M_ProposerSlashing>) -> {VRX.LN(YEm(m)) == 416n : Nat}:
  match m:
    case MNone{}: {==}
    case MSome{+v}: lenE0(v)
def lenEm(+m: MB<M_ProposerSlashing>, +h: {EOK(m) == True{} : Bool}) -> {VRX.LN(YEm(m)) == 416n : Nat}: lenEz(m)
def RTEm(+m: MB<M_ProposerSlashing>, +dd: Nat, +D: FD.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat) -> Data:
  {FuluProposerSlashing_e.ProposerSlashing_bx_put(FD.array__thaw(U32, D), X, th_ProposerSlashing_bx(m)) == (FD.array__thaw(U32, PXEm(m, dd, D, q, r)), th_ProposerSlashing_bx(m)) : Array<U32> & O.Boxed<FuluProposerSlashing_d.ProposerSlashing>}
def BYEm(+m: MB<M_ProposerSlashing>, +dd: Nat, +D: FD.array__Tree<U32>, +q: Nat, +r: Nat) -> Data:
  {UA.BYT(PXEm(m, dd, D, q, r)) == UW.SPL(UA.BYT(D), Nat.add(A.quad(q), r), YEm(m)) : +List<U32>}
def mkEm(+m: MB<M_ProposerSlashing>, +dd: Nat, +D: FD.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat, +a: RTEm(m, dd, D, X, q, r), +b: BYEm(m, dd, D, q, r)) -> DK.P2(RTEm(m, dd, D, X, q, r), BYEm(m, dd, D, q, r)):
  (a, b)
def putxEmW(+m: MB<M_ProposerSlashing>, +h: {EOK(m) == True{} : Bool}, +dd: Nat, +D: FD.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat,
    +e: {U32.to_nat(X) == Nat.add(A.quad(q), r) : Nat}, +hr: {Nat.is_lt(r, 4n) == True{} : Bool}, +hd: {Nat.is_lt(dd, 31n) == True{} : Bool},
    +hl: {Nat.is_le(Nat.add(q, WD.NWN(Nat.add(r, 416n))), VB.pw(dd)) == True{} : Bool}, +hl32: {Nat.is_lt(Nat.add(A.quad(q), Nat.add(r, 416n)), FD.spec_common__pow2(32n)) == True{} : Bool}, +pf: {FD.array__perfect(U32, dd, D) == True{} : Bool},
    +hz: {VS.bt(416n, VS.bdr(Nat.add(A.quad(q), r), UA.BYT(D))) == UW.ZB(416n) : +List<U32>})
