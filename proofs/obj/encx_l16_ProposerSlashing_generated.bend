# ==== l16_ProposerSlashing: a list of at most 16 boxed ProposerSlashing (fixed size, 416 bytes), writer side ====================
# The runtime writes element i at byte X + 416 i through a swap loop over its boxed array
# (T.l16_ProposerSlashing_pt: swap the element out for BNone, write it, swap it back). The array is the mirror
# tree t of MB<M_ProposerSlashing> (root_types' am_l16_ProposerSlashing); element j's writer is putxEm above.

def TDM(t: FD.array__Tree<MB<M_ProposerSlashing>>) -> Nat:
  match t:
    case FD.TLeaf{x}: 0n
    case FD.TNode{l, r}: 1n+TDM(l)

def AR(t: FD.array__Tree<MB<M_ProposerSlashing>>) -> Array<O.Boxed<FuluProposerSlashing_d.ProposerSlashing>>: am_l16_ProposerSlashing(t)
def SL(t: FD.array__Tree<MB<M_ProposerSlashing>>) -> List<&2, MB<M_ProposerSlashing>>: FD.array__slots(MB<M_ProposerSlashing>, t)

# Elements i .. i + k - 1 of W: present, with their facts.
def EOKS(k: Nat, +W: List<&2, MB<M_ProposerSlashing>>, +i: Nat) -> Bool:
  match k:
    case 0n: True{}
    case 1n+q: Bool.and(EOK(xat_l16_ProposerSlashing(W, i)), EOKS(q, W, 1n+i))

# Their bytes.
def CATE(k: Nat, +W: List<&2, MB<M_ProposerSlashing>>, +i: Nat) -> +List<U32>:
  match k:
    case 0n: []
    case 1n+q: VCN.AP(YEm(xat_l16_ProposerSlashing(W, i)), CATE(q, W, 1n+i))

# The counter after s: s + 1 < 2^(1 + d) when s < n <= 2^d.
def inc(+i: U32, +s: Nat, +n: Nat, +d: Nat, +ei: {U32.to_nat(i) == s : Nat}, +hs: {Nat.is_lt(s, n) == True{} : Bool},
    +hn: {Nat.is_le(n, VB.pw(d)) == True{} : Bool}, +hd: {Nat.is_lt(d, 31n) == True{} : Bool}) -> {U32.to_nat(U32.add(i, 1)) == 1n+s : Nat}:
  VB.add_at(i, 1, s, 1n+d, ei, hd,
    FD.nat__le_lt_trans(1n+s, VB.pw(d), VB.pw(1n+d), FD.nat__le_trans(1n+s, n, VB.pw(d), FD.nat__lt_succ_le_succ(s, n, hs), hn), FD.nat__pow2_lt_succ(d)))

# Element s of the perfect tree t.
def hx_at(+d: Nat, +t: FD.array__Tree<MB<M_ProposerSlashing>>, +s: Nat, +pf: {FD.array__perfect(MB<M_ProposerSlashing>, d, t) == True{} : Bool}, +hs: {Nat.is_lt(s, VB.pw(d)) == True{} : Bool})
    -> {FD.spec_common__nth(MB<M_ProposerSlashing>, SL(t), s) == Some{xat_l16_ProposerSlashing(SL(t), s)} : Maybe<&2, MB<M_ProposerSlashing>>}:
