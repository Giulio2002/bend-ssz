def THL_l16_ProposerSlashing(+t: FD.array__Tree<MB<M_ProposerSlashing>>, +N: U32) -> Fulu_list_ProposerSlashing_16_d.l16_ProposerSlashing_Seq: Fulu_list_ProposerSlashing_16_d.l16_ProposerSlashing_Seq{AR(t), N}
