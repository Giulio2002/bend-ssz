  and_r(Nat.is_lt(TDM(t), 31n), Bool.and(FD.array__perfect(MB<M_ProposerSlashing>, TDM(t), t), Bool.and(Nat.is_le(U32.to_nat(N), VB.pw(TDM(t))), Bool.and(U32.is_le(N, 16), EOKS(U32.to_nat(N), SL(t), 0n)))), h)
