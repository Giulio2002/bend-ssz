          Fulu_list_ProposerSlashing_16_e.l16_ProposerSlashing_pt(p, U32.add(i, 1), X, Fulu_list_ProposerSlashing_16_e.l16_ProposerSlashing_pt_back(i, AR(t2), (FD.array__thaw(U32, D1), th_ProposerSlashing_bx(x)))),
          (FD.array__thaw(U32, WX(p, 1n+j, dd, D1, q, r, t)), (AR(t), O.BNone{})), e2,
          Equal.trans(Array<U32> & (Array<O.Boxed<FuluProposerSlashing_d.ProposerSlashing>> & O.Boxed<FuluProposerSlashing_d.ProposerSlashing>),
            Fulu_list_ProposerSlashing_16_e.l16_ProposerSlashing_pt(p, U32.add(i, 1), X, Fulu_list_ProposerSlashing_16_e.l16_ProposerSlashing_pt_ret(FD.array__thaw(U32, D1), Array.swap(O.Boxed<FuluProposerSlashing_d.ProposerSlashing>, AR(t2), i, th_ProposerSlashing_bx(x)))),
            Fulu_list_ProposerSlashing_16_e.l16_ProposerSlashing_pt(p, U32.add(i, 1), X, Fulu_list_ProposerSlashing_16_e.l16_ProposerSlashing_pt_ret(FD.array__thaw(U32, D1), (AR(t), O.BNone{}))),
            (FD.array__thaw(U32, WX(p, 1n+j, dd, D1, q, r, t)), (AR(t), O.BNone{})), e3, rt2)))
      +rest = CATE(p, SL(t), 1n+j)
      +eXn = Equal.trans(Nat, VRX.YP(1n+j, 104n, q, r), Nat.add(Yj, A.quad(104n)), Nat.add(Yj, VRX.LN(Y)), ey,
        Equal.cong(Nat, Nat, z => Nat.add(Yj, z), A.quad(104n), VRX.LN(Y), Equal.sym(Nat, VRX.LN(Y), A.quad(104n), lenEm(x, hx))))
      +byf = Equal.trans(+List<U32>, UA.BYT(WX(p, 1n+j, dd, D1, q, r, t)), UW.SPL(UA.BYT(D1), VRX.YP(1n+j, 104n, q, r), rest), UW.SPL(B0, Yj, VRX.AP(Y, rest)), by2,
        VRX.spl_catx(B0, Yj, Y, rest, VRX.YP(1n+j, 104n, q, r), UA.BYT(D1), hX, eXn, by))
      mk2(1n+p, i, j, X, q, r, dd, D, t, rtf, byf)

def ptx(k: Nat, +i: U32, +j: Nat, +n: Nat, +X: U32, +q: Nat, +r: Nat, +dd: Nat, +D: FD.array__Tree<U32>, +d: Nat, +t: FD.array__Tree<MB<M_ProposerSlashing>>, +LT: Nat,
    +ei: {U32.to_nat(i) == j : Nat}, +ek: {Nat.add(j, k) == n : Nat}, +e: {U32.to_nat(X) == Nat.add(A.quad(q), r) : Nat}, +hr: {Nat.is_lt(r, 4n) == True{} : Bool},
    +hd: {Nat.is_lt(dd, 29n) == True{} : Bool}, +pfD: {FD.array__perfect(U32, dd, D) == True{} : Bool},
    +hj: {Nat.is_le(A.quad(Nat.mul(Nat.add(k, j), 104n)), LT) == True{} : Bool},
    +hl: {Nat.is_le(Nat.add(q, WD.NWN(Nat.add(r, LT))), VB.pw(dd)) == True{} : Bool},
    +hz: {VS.bt(A.quad(Nat.mul(k, 104n)), VS.bdr(VRX.YP(j, 104n, q, r), UA.BYT(D))) == UW.ZB(A.quad(Nat.mul(k, 104n))) : +List<U32>},
    +pfA: {FD.array__perfect(MB<M_ProposerSlashing>, d, t) == True{} : Bool}, +hda: {Nat.is_lt(d, 31n) == True{} : Bool}, +hn: {Nat.is_le(n, VB.pw(d)) == True{} : Bool},
    +hok: {EOKS(k, SL(t), j) == True{} : Bool})
    -> DK.P2(RTK(k, i, j, X, q, r, dd, D, t), BYK(k, j, q, r, dd, D, t)):
  ptxW(k, i, j, n, X, q, r, dd, D, d, t, LT, ei, ek, e, hr, FD.nat__lt_trans(dd, 29n, 31n, hd, {==}), pfD, hj, hl, VRX.hl32w(q, r, LT, dd, hd, hl), hz, pfA, hda, hn, hok)

# ---- the list's encoder window ---------------------------------------------------------------------

def LL_l16_ProposerSlashing(+t: FD.array__Tree<MB<M_ProposerSlashing>>, +N: U32) -> Nat: A.quad(Nat.mul(U32.to_nat(N), 104n))
def ENCL_l16_ProposerSlashing(+t: FD.array__Tree<MB<M_ProposerSlashing>>, +N: U32) -> +List<U32>: CATE(U32.to_nat(N), SL(t), 0n)
def PUTLb_l16_ProposerSlashing(b: Bool, +t: FD.array__Tree<MB<M_ProposerSlashing>>, +N: U32, +dd: Nat, +D: FD.array__Tree<U32>, +q: Nat, +r: Nat) -> FD.array__Tree<U32>:
  match b:
    case True{}: D
    case False{}: WX(U32.to_nat(N), 0n, dd, D, q, r, t)
def PUTL_l16_ProposerSlashing(+t: FD.array__Tree<MB<M_ProposerSlashing>>, +N: U32, +dd: Nat, +D: FD.array__Tree<U32>, +q: Nat, +r: Nat) -> FD.array__Tree<U32>: PUTLb_l16_ProposerSlashing(U32.is_eq(N, 0), t, N, dd, D, q, r)
def pfLb_l16_ProposerSlashing(+b: Bool, +t: FD.array__Tree<MB<M_ProposerSlashing>>, +N: U32, +dd: Nat, +D: FD.array__Tree<U32>, +q: Nat, +r: Nat, +pf: {FD.array__perfect(U32, dd, D) == True{} : Bool})
    -> {FD.array__perfect(U32, dd, PUTLb_l16_ProposerSlashing(b, t, N, dd, D, q, r)) == True{} : Bool}:
  match b:
    case True{}: pf
    case False{}: pfWX(U32.to_nat(N), 0n, dd, D, q, r, t, pf)

def RTN(+b: Bool, +t: FD.array__Tree<MB<M_ProposerSlashing>>, +N: U32, +dd: Nat, +D: FD.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat) -> Data:
  {Fulu_list_ProposerSlashing_16_e.l16_ProposerSlashing_pt_nz(b, X, N, FD.array__thaw(U32, D), AR(t)) == (FD.array__thaw(U32, PUTLb_l16_ProposerSlashing(b, t, N, dd, D, q, r)), THL_l16_ProposerSlashing(t, N)) : Array<U32> & Fulu_list_ProposerSlashing_16_d.l16_ProposerSlashing_Seq}
def BYN(+b: Bool, +t: FD.array__Tree<MB<M_ProposerSlashing>>, +N: U32, +dd: Nat, +D: FD.array__Tree<U32>, +q: Nat, +r: Nat) -> Data:
  {UA.BYT(PUTLb_l16_ProposerSlashing(b, t, N, dd, D, q, r)) == UW.SPL(UA.BYT(D), Nat.add(A.quad(q), r), ENCL_l16_ProposerSlashing(t, N)) : +List<U32>}

# The writer's non-empty test, and its loop.
def ptnzW(+t: FD.array__Tree<MB<M_ProposerSlashing>>, +N: U32, +b: Bool, +eb: {U32.is_eq(N, 0) == b : Bool}, +h: {OKL_l16_ProposerSlashing(t, N) == True{} : Bool},
    +dd: Nat, +D: FD.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat,
    +e: {U32.to_nat(X) == Nat.add(A.quad(q), r) : Nat}, +hr: {Nat.is_lt(r, 4n) == True{} : Bool}, +hd: {Nat.is_lt(dd, 31n) == True{} : Bool},
    +hl: {Nat.is_le(Nat.add(q, WD.NWN(Nat.add(r, LL_l16_ProposerSlashing(t, N)))), VB.pw(dd)) == True{} : Bool}, +hl32: {Nat.is_lt(Nat.add(A.quad(q), Nat.add(r, LL_l16_ProposerSlashing(t, N))), FD.spec_common__pow2(32n)) == True{} : Bool}, +pf: {FD.array__perfect(U32, dd, D) == True{} : Bool},
    +hz: {VS.bt(LL_l16_ProposerSlashing(t, N), VS.bdr(Nat.add(A.quad(q), r), UA.BYT(D))) == UW.ZB(LL_l16_ProposerSlashing(t, N)) : +List<U32>})
    -> DK.P2(RTN(b, t, N, dd, D, X, q, r), BYN(b, t, N, dd, D, q, r)):
  match b:
    case True{}:
      +eN = Equal.cong(U32, Nat, z => U32.to_nat(z), N, 0, FD.u32alg__eq_of(N, 0, eb))
      ({==}, FD.logic__subst(Nat, z => {UA.BYT(D) == UW.SPL(UA.BYT(D), Nat.add(A.quad(q), r), CATE(z, SL(t), 0n)) : +List<U32>}, 0n, U32.to_nat(N), Equal.sym(Nat, U32.to_nat(N), 0n, eN),
        Equal.sym(+List<U32>, UW.SPL(UA.BYT(D), Nat.add(A.quad(q), r), []), UA.BYT(D), VRX.spl_nil(UA.BYT(D), Nat.add(A.quad(q), r)))))
    case False{}:
      +c = U32.to_nat(N)
      +g = ptxW(c, 0, 0n, c, X, q, r, dd, D, TDM(t), t, LL_l16_ProposerSlashing(t, N), {==}, {==}, e, hr, hd, pf,
        FD.logic__subst(Nat, z => {Nat.is_le(A.quad(Nat.mul(z, 104n)), LL_l16_ProposerSlashing(t, N)) == True{} : Bool}, c, Nat.add(c, 0n), Equal.sym(Nat, Nat.add(c, 0n), c, FD.nat__add_zero(c)), FD.nat__le_refl(LL_l16_ProposerSlashing(t, N))), hl, hl32, hz,
        okl_pf(t, N, h), okl_d(t, N, h), okl_n(t, N, h), okl_e(t, N, h))
      +rt = PA(RTK(c, 0, 0n, X, q, r, dd, D, t), BYK(c, 0n, q, r, dd, D, t), g)
      +by = PB(RTK(c, 0, 0n, X, q, r, dd, D, t), BYK(c, 0n, q, r, dd, D, t), g)
      (Equal.cong(Array<U32> & (Array<O.Boxed<FuluProposerSlashing_d.ProposerSlashing>> & O.Boxed<FuluProposerSlashing_d.ProposerSlashing>), Array<U32> & Fulu_list_ProposerSlashing_16_d.l16_ProposerSlashing_Seq, z => Fulu_list_ProposerSlashing_16_e.l16_ProposerSlashing_pt_fin(N, z),
         Fulu_list_ProposerSlashing_16_e.l16_ProposerSlashing_pt(c, 0, X, (FD.array__thaw(U32, D), (AR(t), O.BNone{}))), (FD.array__thaw(U32, WX(c, 0n, dd, D, q, r, t)), (AR(t), O.BNone{})), rt), by)

def ptnz(+t: FD.array__Tree<MB<M_ProposerSlashing>>, +N: U32, +b: Bool, +eb: {U32.is_eq(N, 0) == b : Bool}, +h: {OKL_l16_ProposerSlashing(t, N) == True{} : Bool},
    +dd: Nat, +D: FD.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat,
    +e: {U32.to_nat(X) == Nat.add(A.quad(q), r) : Nat}, +hr: {Nat.is_lt(r, 4n) == True{} : Bool}, +hd: {Nat.is_lt(dd, 29n) == True{} : Bool},
    +hl: {Nat.is_le(Nat.add(q, WD.NWN(Nat.add(r, LL_l16_ProposerSlashing(t, N)))), VB.pw(dd)) == True{} : Bool}, +pf: {FD.array__perfect(U32, dd, D) == True{} : Bool},
    +hz: {VS.bt(LL_l16_ProposerSlashing(t, N), VS.bdr(Nat.add(A.quad(q), r), UA.BYT(D))) == UW.ZB(LL_l16_ProposerSlashing(t, N)) : +List<U32>})
    -> DK.P2(RTN(b, t, N, dd, D, X, q, r), BYN(b, t, N, dd, D, q, r)):
  ptnzW(t, N, b, eb, h, dd, D, X, q, r, e, hr, FD.nat__lt_trans(dd, 29n, 31n, hd, {==}), hl, VRX.hl32w(q, r, LL_l16_ProposerSlashing(t, N), dd, hd, hl), pf, hz)

def RTL_l16_ProposerSlashing(+t: FD.array__Tree<MB<M_ProposerSlashing>>, +N: U32, +dd: Nat, +D: FD.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat) -> Data:
  {Fulu_list_ProposerSlashing_16_e.l16_ProposerSlashing_putk(FD.array__thaw(U32, D), X, THL_l16_ProposerSlashing(t, N)) == (FD.array__thaw(U32, PUTL_l16_ProposerSlashing(t, N, dd, D, q, r)), (THL_l16_ProposerSlashing(t, N), O.mulc(N, 416))) : Array<U32> & (Fulu_list_ProposerSlashing_16_d.l16_ProposerSlashing_Seq & U32)}
def BYL_l16_ProposerSlashing(+t: FD.array__Tree<MB<M_ProposerSlashing>>, +N: U32, +dd: Nat, +D: FD.array__Tree<U32>, +q: Nat, +r: Nat) -> Data:
  {UA.BYT(PUTL_l16_ProposerSlashing(t, N, dd, D, q, r)) == UW.SPL(UA.BYT(D), Nat.add(A.quad(q), r), ENCL_l16_ProposerSlashing(t, N)) : +List<U32>}
def PFL_l16_ProposerSlashing(+t: FD.array__Tree<MB<M_ProposerSlashing>>, +N: U32, +dd: Nat, +D: FD.array__Tree<U32>, +q: Nat, +r: Nat) -> Data:
  {FD.array__perfect(U32, dd, PUTL_l16_ProposerSlashing(t, N, dd, D, q, r)) == True{} : Bool}

# The runtime's write, with its validity check.
def putk_rt(+t: FD.array__Tree<MB<M_ProposerSlashing>>, +N: U32, +h: {OKL_l16_ProposerSlashing(t, N) == True{} : Bool}, +dd: Nat, +D: FD.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat,
    +rtb: RTN(U32.is_eq(N, 0), t, N, dd, D, X, q, r)) -> RTL_l16_ProposerSlashing(t, N, dd, D, X, q, r):
  %Equal.sym(Fulu_list_ProposerSlashing_16_d.l16_ProposerSlashing_Seq & Bool, Fulu_list_ProposerSlashing_16_e.l16_ProposerSlashing_valid(THL_l16_ProposerSlashing(t, N)), (THL_l16_ProposerSlashing(t, N), True{}), valid_l16_ProposerSlashing(t, N, h)) :
    {Fulu_list_ProposerSlashing_16_e.l16_ProposerSlashing_pk(FD.array__thaw(U32, D), X, _) == (FD.array__thaw(U32, PUTL_l16_ProposerSlashing(t, N, dd, D, q, r)), (THL_l16_ProposerSlashing(t, N), O.mulc(N, 416))) : Array<U32> & (Fulu_list_ProposerSlashing_16_d.l16_ProposerSlashing_Seq & U32)}
  %Equal.sym(Array<U32> & Fulu_list_ProposerSlashing_16_d.l16_ProposerSlashing_Seq, Fulu_list_ProposerSlashing_16_e.l16_ProposerSlashing_pt_nz(U32.is_eq(N, 0), X, N, FD.array__thaw(U32, D), AR(t)), (FD.array__thaw(U32, PUTL_l16_ProposerSlashing(t, N, dd, D, q, r)), THL_l16_ProposerSlashing(t, N)), rtb) :
    {Fulu_list_ProposerSlashing_16_e.l16_ProposerSlashing_ptn_fin(N, _) == (FD.array__thaw(U32, PUTL_l16_ProposerSlashing(t, N, dd, D, q, r)), (THL_l16_ProposerSlashing(t, N), O.mulc(N, 416))) : Array<U32> & (Fulu_list_ProposerSlashing_16_d.l16_ProposerSlashing_Seq & U32)}
  {==}

def mk3(+t: FD.array__Tree<MB<M_ProposerSlashing>>, +N: U32, +dd: Nat, +D: FD.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat,
    +a: RTL_l16_ProposerSlashing(t, N, dd, D, X, q, r), +b: BYL_l16_ProposerSlashing(t, N, dd, D, q, r), +c: PFL_l16_ProposerSlashing(t, N, dd, D, q, r))
    -> DK.P2(RTL_l16_ProposerSlashing(t, N, dd, D, X, q, r), DK.P2(BYL_l16_ProposerSlashing(t, N, dd, D, q, r), PFL_l16_ProposerSlashing(t, N, dd, D, q, r))):
  (a, (b, c))

# putx: the runtime writer at X = 4 q + r is the model PUTL, whose bytes splice the list's bytes
# into D's (its elements write their data bytes only), and whose tree is perfect.
def putx_l16_ProposerSlashingW(+t: FD.array__Tree<MB<M_ProposerSlashing>>, +N: U32, +h: {OKL_l16_ProposerSlashing(t, N) == True{} : Bool}, +dd: Nat, +D: FD.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat,
    +e: {U32.to_nat(X) == Nat.add(A.quad(q), r) : Nat}, +hr: {Nat.is_lt(r, 4n) == True{} : Bool}, +hd: {Nat.is_lt(dd, 31n) == True{} : Bool},
    +hl: {Nat.is_le(Nat.add(q, WD.NWN(Nat.add(r, LL_l16_ProposerSlashing(t, N)))), VB.pw(dd)) == True{} : Bool}, +hl32: {Nat.is_lt(Nat.add(A.quad(q), Nat.add(r, LL_l16_ProposerSlashing(t, N))), FD.spec_common__pow2(32n)) == True{} : Bool}, +pf: {FD.array__perfect(U32, dd, D) == True{} : Bool},
    +hz: {VS.bt(LL_l16_ProposerSlashing(t, N), VS.bdr(Nat.add(A.quad(q), r), UA.BYT(D))) == UW.ZB(LL_l16_ProposerSlashing(t, N)) : +List<U32>})
    -> DK.P2(RTL_l16_ProposerSlashing(t, N, dd, D, X, q, r), DK.P2(BYL_l16_ProposerSlashing(t, N, dd, D, q, r), PFL_l16_ProposerSlashing(t, N, dd, D, q, r))):
  +b = U32.is_eq(N, 0)
  +g = ptnzW(t, N, b, {==}, h, dd, D, X, q, r, e, hr, hd, hl, hl32, pf, hz)
  +rtb = PA(RTN(b, t, N, dd, D, X, q, r), BYN(b, t, N, dd, D, q, r), g)
  +byb = PB(RTN(b, t, N, dd, D, X, q, r), BYN(b, t, N, dd, D, q, r), g)
  mk3(t, N, dd, D, X, q, r, putk_rt(t, N, h, dd, D, X, q, r, rtb), byb, pfLb_l16_ProposerSlashing(b, t, N, dd, D, q, r, pf))

# ---- sizes ----

def putx_l16_ProposerSlashing(+t: FD.array__Tree<MB<M_ProposerSlashing>>, +N: U32, +h: {OKL_l16_ProposerSlashing(t, N) == True{} : Bool}, +dd: Nat, +D: FD.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat,
    +e: {U32.to_nat(X) == Nat.add(A.quad(q), r) : Nat}, +hr: {Nat.is_lt(r, 4n) == True{} : Bool}, +hd: {Nat.is_lt(dd, 29n) == True{} : Bool},
    +hl: {Nat.is_le(Nat.add(q, WD.NWN(Nat.add(r, LL_l16_ProposerSlashing(t, N)))), VB.pw(dd)) == True{} : Bool}, +pf: {FD.array__perfect(U32, dd, D) == True{} : Bool},
    +hz: {VS.bt(LL_l16_ProposerSlashing(t, N), VS.bdr(Nat.add(A.quad(q), r), UA.BYT(D))) == UW.ZB(LL_l16_ProposerSlashing(t, N)) : +List<U32>})
    -> DK.P2(RTL_l16_ProposerSlashing(t, N, dd, D, X, q, r), DK.P2(BYL_l16_ProposerSlashing(t, N, dd, D, q, r), PFL_l16_ProposerSlashing(t, N, dd, D, q, r))):
  putx_l16_ProposerSlashingW(t, N, h, dd, D, X, q, r, e, hr, FD.nat__lt_trans(dd, 29n, 31n, hd, {==}), hl, VRX.hl32w(q, r, LL_l16_ProposerSlashing(t, N), dd, hd, hl), pf, hz)

# The runtime's size pass.
def sizex_l16_ProposerSlashing(+t: FD.array__Tree<MB<M_ProposerSlashing>>, +N: U32, +h: {OKL_l16_ProposerSlashing(t, N) == True{} : Bool}) -> {Fulu_list_ProposerSlashing_16_e.l16_ProposerSlashing_size(THL_l16_ProposerSlashing(t, N)) == (THL_l16_ProposerSlashing(t, N), O.mulc(N, 416)) : Fulu_list_ProposerSlashing_16_d.l16_ProposerSlashing_Seq & U32}:
  +d = TDM(t)
  %Equal.sym(Array<O.Boxed<FuluProposerSlashing_d.ProposerSlashing>> & U32, Array.size(O.Boxed<FuluProposerSlashing_d.ProposerSlashing>, AR(t)), (AR(t), FD.u32__pow2u(d)), amsize_l16_ProposerSlashing(d, t, okl_pf(t, N, h))) :
    {Fulu_list_ProposerSlashing_16_e.l16_ProposerSlashing_szf(N, _) == (THL_l16_ProposerSlashing(t, N), O.mulc(N, 416)) : Fulu_list_ProposerSlashing_16_d.l16_ProposerSlashing_Seq & U32}
  %Equal.sym(Bool, U32.is_le(N, FD.u32__pow2u(d)), True{}, le_cap(t, N, h)) :
    {(THL_l16_ProposerSlashing(t, N), O.pick(_, O.mulc(N, 416), 4294967295)) == (THL_l16_ProposerSlashing(t, N), O.mulc(N, 416)) : Fulu_list_ProposerSlashing_16_d.l16_ProposerSlashing_Seq & U32}
  {==}

# szxB: the size pass's O.mulc is the list's byte count when the bytes are at most NMAX (no tree).
def szxB_l16_ProposerSlashing(+t: FD.array__Tree<MB<M_ProposerSlashing>>, +N: U32, +hN: {Nat.is_le(LL_l16_ProposerSlashing(t, N), U32.to_nat(VB.NMAX())) == True{} : Bool}) -> {U32.to_nat(O.mulc(N, 416)) == LL_l16_ProposerSlashing(t, N) : Nat}:
  VRX.mulqcW(N, U32.to_nat(N), 416, 104n, {==}, {==}, hN, {==}, {==}, {==})

# szx at any depth dd < 31 (hs31: the bytes within NMAX; hl32 is not used).
def szx_l16_ProposerSlashingW(+t: FD.array__Tree<MB<M_ProposerSlashing>>, +N: U32, +q: Nat, +r: Nat, +dd: Nat, +hd: {Nat.is_lt(dd, 31n) == True{} : Bool},
    +hl: {Nat.is_le(Nat.add(q, WD.NWN(Nat.add(r, LL_l16_ProposerSlashing(t, N)))), VB.pw(dd)) == True{} : Bool}, +hs31: {Nat.is_le(LL_l16_ProposerSlashing(t, N), U32.to_nat(VB.NMAX())) == True{} : Bool},
    +hl32: {Nat.is_lt(Nat.add(A.quad(q), Nat.add(r, LL_l16_ProposerSlashing(t, N))), FD.spec_common__pow2(32n)) == True{} : Bool}) -> {U32.to_nat(O.mulc(N, 416)) == LL_l16_ProposerSlashing(t, N) : Nat}:
  szxB_l16_ProposerSlashing(t, N, hs31)

# szx: the size the writer returns is the list's byte count, when the list lies in the tree.
def szx_l16_ProposerSlashing(+t: FD.array__Tree<MB<M_ProposerSlashing>>, +N: U32, +q: Nat, +r: Nat, +dd: Nat, +hd: {Nat.is_lt(dd, 29n) == True{} : Bool},
    +hl: {Nat.is_le(Nat.add(q, WD.NWN(Nat.add(r, LL_l16_ProposerSlashing(t, N)))), VB.pw(dd)) == True{} : Bool}) -> {U32.to_nat(O.mulc(N, 416)) == LL_l16_ProposerSlashing(t, N) : Nat}:
  szxB_l16_ProposerSlashing(t, N, VRX.hs31w(q, r, LL_l16_ProposerSlashing(t, N), dd, hd, hl))


# ---- the spec side: the list's value, its parts, one variable part of its bytes ---------------------

# The values of elements i .. i + c - 1 of W, and their fixed parts.
def ITE(c: Nat, +W: List<&2, MB<M_ProposerSlashing>>, +i: Nat) -> S.Value:
  match c:
    case 0n: S.EmptyItems{}
    case 1n+q: S.Items{EVm(xat_l16_ProposerSlashing(W, i)), ITE(q, W, 1n+i)}
def FPE(c: Nat, +W: List<&2, MB<M_ProposerSlashing>>, +i: Nat) -> +List<S.Part>:
  match c:
    case 0n: []
    case 1n+q: S.Fixed{YEm(xat_l16_ProposerSlashing(W, i))} <> FPE(q, W, 1n+i)

law cntE:
  for +c: Nat
  for +W: List<&2, MB<M_ProposerSlashing>>
  for +i: Nat
  {Codec.count(ITE(c, W, i)) == c : Nat}
def cntE(c, W, i):
  match c:
    case 0n: {==}
    case 1n+ +q: FD.nat__succ_cong(Codec.count(ITE(q, W, 1n+i)), q, cntE(q, W, 1n+i))

law prtE:
  for +c: Nat
  for +W: List<&2, MB<M_ProposerSlashing>>
  for +i: Nat
  for +hok: {EOKS(c, W, i) == True{} : Bool}
  {Codec.parts(ITE(c, W, i), S.Repeat{Spec.Schema31()}) == Some{FPE(c, W, i)} : Maybe<&2, +List<S.Part>>}
def prtE(c, W, i, hok):
  match c:
    case 0n: {==}
    case 1n+ +q:
      +x = xat_l16_ProposerSlashing(W, i)
      F.cat_fixed(Codec.parts(EVm(x), Spec.Schema31()), YEm(x), Codec.parts(ITE(q, W, 1n+i), S.Repeat{Spec.Schema31()}), FPE(q, W, 1n+i),
        specEm(x, and_l(EOK(x), EOKS(q, W, 1n+i), hok)), prtE(q, W, 1n+i, and_r(EOK(x), EOKS(q, W, 1n+i), hok)))

law vfE:
  for +c: Nat
  for +W: List<&2, MB<M_ProposerSlashing>>
  for +i: Nat
  for +hok: {EOKS(c, W, i) == True{} : Bool}
  {Layout.bytes_valid(FPE(c, W, i)) == True{} : Bool}
def vfE(c, W, i, hok):
  match c:
    case 0n: {==}
    case 1n+ +q:
      +x = xat_l16_ProposerSlashing(W, i)
      FD.logic__and_intro(SP.bytes_domain(YEm(x)), Layout.bytes_valid(FPE(q, W, 1n+i)),
        CS.domf(EVm(x), Spec.Schema31(), YEm(x), {==}, specEm(x, and_l(EOK(x), EOKS(q, W, 1n+i), hok))), vfE(q, W, 1n+i, and_r(EOK(x), EOKS(q, W, 1n+i), hok)))

law fsE:
  for +c: Nat
  for +W: List<&2, MB<M_ProposerSlashing>>
  for +i: Nat
  {Layout.fixed_size(FPE(c, W, i)) == VCN.LN(CATE(c, W, i)) : Nat}
def fsE(c, W, i):
  match c:
    case 0n: {==}
    case 1n+ +q:
      +Y = YEm(xat_l16_ProposerSlashing(W, i))
      Equal.trans(Nat, Nat.add(VCN.LN(Y), Layout.fixed_size(FPE(q, W, 1n+i))), Nat.add(VCN.LN(Y), VCN.LN(CATE(q, W, 1n+i))), VCN.LN(VCN.AP(Y, CATE(q, W, 1n+i))),
        Equal.cong(Nat, Nat, z => Nat.add(VCN.LN(Y), z), Layout.fixed_size(FPE(q, W, 1n+i)), VCN.LN(CATE(q, W, 1n+i)), fsE(q, W, 1n+i)),
        Equal.sym(Nat, VCN.LN(VCN.AP(Y, CATE(q, W, 1n+i))), Nat.add(VCN.LN(Y), VCN.LN(CATE(q, W, 1n+i))), VCN.len_app(Y, CATE(q, W, 1n+i))))

law fpE:
  for +c: Nat
  for +W: List<&2, MB<M_ProposerSlashing>>
  for +i: Nat
  for +off: Nat
  {Layout.fixed_parts(FPE(c, W, i), off) == CATE(c, W, i) : +List<U32>}
def fpE(c, W, i, off):
  match c:
    case 0n: {==}
    case 1n+ +q:
      Equal.cong(+List<U32>, +List<U32>, z => List.append(&2, U32, YEm(xat_l16_ProposerSlashing(W, i)), z), Layout.fixed_parts(FPE(q, W, 1n+i), off), CATE(q, W, 1n+i), fpE(q, W, 1n+i, off))

law pyE:
  for +c: Nat
  for +W: List<&2, MB<M_ProposerSlashing>>
  for +i: Nat
  {Layout.payloads(FPE(c, W, i)) == [] : +List<U32>}
def pyE(c, W, i):
  match c:
    case 0n: {==}
    case 1n+ +q: pyE(q, W, 1n+i)

# The elements' bytes: 416 each (an absent element's bytes are 416 zero bytes).
law lenC:
  for +c: Nat
  for +W: List<&2, MB<M_ProposerSlashing>>
  for +i: Nat
  {VCN.LN(CATE(c, W, i)) == A.quad(Nat.mul(c, 104n)) : Nat}
def lenC(c, W, i):
  match c:
    case 0n: {==}
    case 1n+ +q:
      +x = xat_l16_ProposerSlashing(W, i)
      +Y = YEm(x)
      %Equal.sym(Nat, VCN.LN(VCN.AP(Y, CATE(q, W, 1n+i))), Nat.add(VCN.LN(Y), VCN.LN(CATE(q, W, 1n+i))), VCN.len_app(Y, CATE(q, W, 1n+i))) :
        {_ == A.quad(Nat.mul(1n+q, 104n)) : Nat}
      %Equal.sym(Nat, VCN.LN(Y), 416n, lenEz(x)) : {Nat.add(_, VCN.LN(CATE(q, W, 1n+i))) == A.quad(Nat.mul(1n+q, 104n)) : Nat}
      %Equal.sym(Nat, VCN.LN(CATE(q, W, 1n+i)), A.quad(Nat.mul(q, 104n)), lenC(q, W, 1n+i)) : {Nat.add(416n, _) == A.quad(Nat.mul(1n+q, 104n)) : Nat}
      {==}

# The layout of the elements' fixed parts is their bytes.
def encE(+c: Nat, +W: List<&2, MB<M_ProposerSlashing>>, +hok: {EOKS(c, W, 0n) == True{} : Bool}, +fit: {N.fits(4n, VCN.LN(CATE(c, W, 0n))) == True{} : Bool})
    -> {Layout.encoding(FPE(c, W, 0n)) == Some{CATE(c, W, 0n)} : Maybe<&2, +List<U32>>}:
  +ps = FPE(c, W, 0n)
  +Y = CATE(c, W, 0n)
  %Equal.sym(Bool, Layout.bytes_valid(ps), True{}, vfE(c, W, 0n, hok)) :
    {SP.optional(Bool.and(_, N.fits(4n, Nat.add(Layout.fixed_size(ps), List.length(&2, U32, Layout.payloads(ps))))), List.append(&2, U32, Layout.fixed_parts(ps, Layout.fixed_size(ps)), Layout.payloads(ps))) == Some{Y} : Maybe<&2, +List<U32>>}
  %Equal.sym(+List<U32>, Layout.payloads(ps), [], pyE(c, W, 0n)) :
    {SP.optional(Bool.and(True{}, N.fits(4n, Nat.add(Layout.fixed_size(ps), List.length(&2, U32, _)))), List.append(&2, U32, Layout.fixed_parts(ps, Layout.fixed_size(ps)), _)) == Some{Y} : Maybe<&2, +List<U32>>}
  %Equal.sym(Nat, Layout.fixed_size(ps), VCN.LN(Y), fsE(c, W, 0n)) :
    {SP.optional(Bool.and(True{}, N.fits(4n, Nat.add(_, List.length(&2, U32, [])))), List.append(&2, U32, Layout.fixed_parts(ps, _), [])) == Some{Y} : Maybe<&2, +List<U32>>}
  %Equal.sym(+List<U32>, Layout.fixed_parts(ps, VCN.LN(Y)), Y, fpE(c, W, 0n, VCN.LN(Y))) :
    {SP.optional(Bool.and(True{}, N.fits(4n, Nat.add(VCN.LN(Y), List.length(&2, U32, [])))), List.append(&2, U32, _, [])) == Some{Y} : Maybe<&2, +List<U32>>}
  %Equal.sym(Nat, Nat.add(VCN.LN(Y), List.length(&2, U32, [])), VCN.LN(Y), FD.nat__add_zero(VCN.LN(Y))) :
    {SP.optional(Bool.and(True{}, N.fits(4n, _)), List.append(&2, U32, Y, [])) == Some{Y} : Maybe<&2, +List<U32>>}
  %Equal.sym(Bool, N.fits(4n, VCN.LN(Y)), True{}, fit) :
    {SP.optional(Bool.and(True{}, _), List.append(&2, U32, Y, [])) == Some{Y} : Maybe<&2, +List<U32>>}
  %Equal.sym(+List<U32>, List.append(&2, U32, Y, []), Y, VS.app_nil(Y)) :
    {SP.optional(Bool.and(True{}, True{}), _) == Some{Y} : Maybe<&2, +List<U32>>}
  {==}

# c elements, at most 16: one variable part, their bytes.
def lpartE(+c: Nat, +W: List<&2, MB<M_ProposerSlashing>>, +hok: {EOKS(c, W, 0n) == True{} : Bool}, +hl: {Nat.is_le(c, 16n) == True{} : Bool},
    +fit: {N.fits(4n, VCN.LN(CATE(c, W, 0n))) == True{} : Bool})
    -> {Codec.parts(S.Sequence{ITE(c, W, 0n)}, Spec.Schema97()) == Some{[S.Variable{CATE(c, W, 0n)}]} : Maybe<&2, +List<S.Part>>}:
  %Equal.sym(Nat, Codec.count(ITE(c, W, 0n)), c, cntE(c, W, 0n)) :
    {Codec.require(Nat.is_le(_, 16n), Codec.aggregate(Codec.parts(ITE(c, W, 0n), S.Repeat{Spec.Schema31()}), None{})) == Some{[S.Variable{CATE(c, W, 0n)}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(Bool, Nat.is_le(c, 16n), True{}, hl) :
    {Codec.require(_, Codec.aggregate(Codec.parts(ITE(c, W, 0n), S.Repeat{Spec.Schema31()}), None{})) == Some{[S.Variable{CATE(c, W, 0n)}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(Maybe<&2, +List<S.Part>>, Codec.parts(ITE(c, W, 0n), S.Repeat{Spec.Schema31()}), Some{FPE(c, W, 0n)}, prtE(c, W, 0n, hok)) :
    {Codec.require(True{}, Codec.aggregate(_, None{})) == Some{[S.Variable{CATE(c, W, 0n)}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(Maybe<&2, +List<U32>>, Layout.encoding(FPE(c, W, 0n)), Some{CATE(c, W, 0n)}, encE(c, W, hok, fit)) :
    {Codec.one(_, None{}) == Some{[S.Variable{CATE(c, W, 0n)}]} : Maybe<&2, +List<S.Part>>}
  {==}

# The list's value and its bytes' length.
def VALL_l16_ProposerSlashing(+t: FD.array__Tree<MB<M_ProposerSlashing>>, +N: U32) -> S.Value: S.Sequence{ITE(U32.to_nat(N), SL(t), 0n)}
def len_encl_l16_ProposerSlashing(+t: FD.array__Tree<MB<M_ProposerSlashing>>, +N: U32) -> {List.length(&2, U32, ENCL_l16_ProposerSlashing(t, N)) == LL_l16_ProposerSlashing(t, N) : Nat}:
  lenC(U32.to_nat(N), SL(t), 0n)

# encx_spec: the list's value has its bytes as one variable part, when they fit a tree of depth dx < 30.
def encx_spec_l16_ProposerSlashing(+t: FD.array__Tree<MB<M_ProposerSlashing>>, +N: U32, +h: {OKL_l16_ProposerSlashing(t, N) == True{} : Bool}, +dx: Nat, +hdx: {Nat.is_lt(dx, 30n) == True{} : Bool},
    +hL: {Nat.is_le(LL_l16_ProposerSlashing(t, N), A.quad(VB.pw(dx))) == True{} : Bool})
    -> {Codec.parts(VALL_l16_ProposerSlashing(t, N), Spec.Schema97()) == Some{[S.Variable{ENCL_l16_ProposerSlashing(t, N)}]} : Maybe<&2, +List<S.Part>>}:
  +hlim = FD.logic__subst(Bool, z => {z == True{} : Bool}, U32.is_le(N, 16), Nat.is_le(U32.to_nat(N), U32.to_nat(16)), VU.le_u32(N, 16), okl_lim(t, N, h))
  +fit = FD.logic__subst(Nat, z => {N.fits(4n, z) == True{} : Bool}, LL_l16_ProposerSlashing(t, N), List.length(&2, U32, ENCL_l16_ProposerSlashing(t, N)), Equal.sym(Nat, List.length(&2, U32, ENCL_l16_ProposerSlashing(t, N)), LL_l16_ProposerSlashing(t, N), len_encl_l16_ProposerSlashing(t, N)),
    VBZ.fitq(dx, LL_l16_ProposerSlashing(t, N), hL, hdx))
  lpartE(U32.to_nat(N), SL(t), okl_e(t, N, h), hlim, fit)

def encx_spec_l16_ProposerSlashingB(+t: FD.array__Tree<MB<M_ProposerSlashing>>, +N: U32, +h: {OKL_l16_ProposerSlashing(t, N) == True{} : Bool}, +B: Nat, +hB: {Nat.is_le(B, U32.to_nat(VB.NMAX())) == True{} : Bool},
    +hL: {Nat.is_le(LL_l16_ProposerSlashing(t, N), B) == True{} : Bool})
    -> {Codec.parts(VALL_l16_ProposerSlashing(t, N), Spec.Schema97()) == Some{[S.Variable{ENCL_l16_ProposerSlashing(t, N)}]} : Maybe<&2, +List<S.Part>>}:
  +hlim = FD.logic__subst(Bool, z => {z == True{} : Bool}, U32.is_le(N, 16), Nat.is_le(U32.to_nat(N), U32.to_nat(16)), VU.le_u32(N, 16), okl_lim(t, N, h))
  +fit = FD.logic__subst(Nat, z => {N.fits(4n, z) == True{} : Bool}, LL_l16_ProposerSlashing(t, N), List.length(&2, U32, ENCL_l16_ProposerSlashing(t, N)), Equal.sym(Nat, List.length(&2, U32, ENCL_l16_ProposerSlashing(t, N)), LL_l16_ProposerSlashing(t, N), len_encl_l16_ProposerSlashing(t, N)),
    VBZ.fitsB(LL_l16_ProposerSlashing(t, N), B, hL, hB))
  lpartE(U32.to_nat(N), SL(t), okl_e(t, N, h), hlim, fit)
