# Setting bit i & 31 of a word leaves bit j & 31 as it was, when the two differ: for every word.
def bit_other(+x: U32, +i: U32, +j: U32, +v: Bool, +ne: {U32.is_eq(U32.and(i, 31), U32.and(j, 31)) == False{} : Bool}) -> {U32.is_eq(U32.and(M.shr_by(O.bit_merge(v, x, M.shl_by(1, U32.and(i, 31))), U32.and(j, 31)), 1), 1) == U32.is_eq(U32.and(M.shr_by(x, U32.and(j, 31)), 1), 1) : Bool}:
  %Equal.sym(Bool, U32.is_eq(U32.and(M.shr_by(O.bit_merge(v, x, M.shl_by(1, U32.and(i, 31))), U32.and(j, 31)), 1), 1), UB.low(M.shr_by(O.bit_merge(v, x, M.shl_by(1, U32.and(i, 31))), U32.and(j, 31))), UB.low_test(M.shr_by(O.bit_merge(v, x, M.shl_by(1, U32.and(i, 31))), U32.and(j, 31)))) : {_ == U32.is_eq(U32.and(M.shr_by(x, U32.and(j, 31)), 1), 1) : Bool}
  %Equal.sym(Bool, U32.is_eq(U32.and(M.shr_by(x, U32.and(j, 31)), 1), 1), UB.low(M.shr_by(x, U32.and(j, 31))), UB.low_test(M.shr_by(x, U32.and(j, 31)))) : {UB.low(M.shr_by(O.bit_merge(v, x, M.shl_by(1, U32.and(i, 31))), U32.and(j, 31))) == _ : Bool}
  bit_other_go(x, i, j, v, ne)

