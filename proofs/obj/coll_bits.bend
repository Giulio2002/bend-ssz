    case U32{WCon{True{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, +r}}}}}}:
      %Equal.sym(Word(27n), Word.and(27n, r, Word.zero(27n)), Word.zero(27n), UB.wand_zero(27n, r)) : {UB.low(M.shr_by(O.bit_merge(v, x, M.shl_by(1, U32{WCon{True{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, _}}}}}})), U32{WCon{True{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, _}}}}}})) == v : Bool}
