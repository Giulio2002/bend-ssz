def bit_other_11(+x: U32, +j: U32, +v: Bool, +ne: {U32.is_eq(11, U32.and(j, 31)) == False{} : Bool})
    -> {UB.low(M.shr_by(O.bit_merge(v, x, M.shl_by(1, 11)), U32.and(j, 31))) == UB.low(M.shr_by(x, U32.and(j, 31))) : Bool}:
  match j:
    case U32{WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, +r}}}}}}:
      %Equal.sym(Word(27n), Word.and(27n, r, Word.zero(27n)), Word.zero(27n), UB.wand_zero(27n, r)) : {UB.low(M.shr_by(O.bit_merge(v, x, M.shl_by(1, 11)), U32{WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, _}}}}}})) == UB.low(M.shr_by(x, U32{WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, _}}}}}})) : Bool}
      %Equal.sym(Bool, UB.low(M.shr_by(O.bit_merge(v, x, M.shl_by(1, 11)), 0)), UB.bitN(O.bit_merge(v, x, M.shl_by(1, 11)), 0n), lowbit_0(O.bit_merge(v, x, M.shl_by(1, 11)))) : {_ == UB.low(M.shr_by(x, 0)) : Bool}
      %Equal.sym(Bool, UB.low(M.shr_by(x, 0)), UB.bitN(x, 0n), lowbit_0(x)) : {UB.bitN(O.bit_merge(v, x, M.shl_by(1, 11)), 0n) == _ : Bool}
      UB.bit_merge_other(v, x, M.shl_by(1, 11), 0n, {==}, {==})
    case U32{WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, +r}}}}}}:
      %Equal.sym(Word(27n), Word.and(27n, r, Word.zero(27n)), Word.zero(27n), UB.wand_zero(27n, r)) : {UB.low(M.shr_by(O.bit_merge(v, x, M.shl_by(1, 11)), U32{WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, _}}}}}})) == UB.low(M.shr_by(x, U32{WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, _}}}}}})) : Bool}
      %Equal.sym(Bool, UB.low(M.shr_by(O.bit_merge(v, x, M.shl_by(1, 11)), 1)), UB.bitN(O.bit_merge(v, x, M.shl_by(1, 11)), 1n), lowbit_1(O.bit_merge(v, x, M.shl_by(1, 11)))) : {_ == UB.low(M.shr_by(x, 1)) : Bool}
      %Equal.sym(Bool, UB.low(M.shr_by(x, 1)), UB.bitN(x, 1n), lowbit_1(x)) : {UB.bitN(O.bit_merge(v, x, M.shl_by(1, 11)), 1n) == _ : Bool}
      UB.bit_merge_other(v, x, M.shl_by(1, 11), 1n, {==}, {==})
