# Setting bit i & 31 of a word (O.bit_merge with the mask 1 << (i & 31)) and testing it as the runtime
# does ((w >> (i & 31)) & 1 == 1) gives the bit set: for every word, index and bit.
def bit_rw(+x: U32, +i: U32, +v: Bool) -> {U32.is_eq(U32.and(M.shr_by(O.bit_merge(v, x, M.shl_by(1, U32.and(i, 31))), U32.and(i, 31)), 1), 1) == v : Bool}:
  %Equal.sym(Bool, U32.is_eq(U32.and(M.shr_by(O.bit_merge(v, x, M.shl_by(1, U32.and(i, 31))), U32.and(i, 31)), 1), 1), UB.low(M.shr_by(O.bit_merge(v, x, M.shl_by(1, U32.and(i, 31))), U32.and(i, 31))), UB.low_test(M.shr_by(O.bit_merge(v, x, M.shl_by(1, U32.and(i, 31))), U32.and(i, 31)))) : {_ == v : Bool}
  bit_rw_go(x, i, v)

