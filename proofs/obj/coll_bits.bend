# for every bit position i & 31 (a case per value: the five low bits of i)
def bit_rw_go(+x: U32, +i: U32, +v: Bool) -> {UB.low(M.shr_by(O.bit_merge(v, x, M.shl_by(1, U32.and(i, 31))), U32.and(i, 31))) == v : Bool}:
  match i:
    case U32{WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, +r}}}}}}:
      %Equal.sym(Word(27n), Word.and(27n, r, Word.zero(27n)), Word.zero(27n), UB.wand_zero(27n, r)) : {UB.low(M.shr_by(O.bit_merge(v, x, M.shl_by(1, U32{WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, _}}}}}})), U32{WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, _}}}}}})) == v : Bool}
      lowk_0(x, v)
    case U32{WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, +r}}}}}}:
      %Equal.sym(Word(27n), Word.and(27n, r, Word.zero(27n)), Word.zero(27n), UB.wand_zero(27n, r)) : {UB.low(M.shr_by(O.bit_merge(v, x, M.shl_by(1, U32{WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, _}}}}}})), U32{WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, _}}}}}})) == v : Bool}
      lowk_1(x, v)
    case U32{WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, +r}}}}}}:
      %Equal.sym(Word(27n), Word.and(27n, r, Word.zero(27n)), Word.zero(27n), UB.wand_zero(27n, r)) : {UB.low(M.shr_by(O.bit_merge(v, x, M.shl_by(1, U32{WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, _}}}}}})), U32{WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, _}}}}}})) == v : Bool}
