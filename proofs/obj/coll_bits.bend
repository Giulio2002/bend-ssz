      %Equal.sym(Bool, UB.low(M.shr_by(O.bit_merge(v, x, M.shl_by(1, 0)), 1)), UB.bitN(O.bit_merge(v, x, M.shl_by(1, 0)), 1n), lowbit_1(O.bit_merge(v, x, M.shl_by(1, 0)))) : {_ == UB.low(M.shr_by(x, 1)) : Bool}
