def bit_other_go(+x: U32, +i: U32, +j: U32, +v: Bool, +ne: {U32.is_eq(U32.and(i, 31), U32.and(j, 31)) == False{} : Bool})
    -> {UB.low(M.shr_by(O.bit_merge(v, x, M.shl_by(1, U32.and(i, 31))), U32.and(j, 31))) == UB.low(M.shr_by(x, U32.and(j, 31))) : Bool}:
  match i:
