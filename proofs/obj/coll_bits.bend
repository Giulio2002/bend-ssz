def bit_other_19(+x: U32, +j: U32, +v: Bool, +ne: {U32.is_eq(19, U32.and(j, 31)) == False{} : Bool})
    -> {UB.low(M.shr_by(O.bit_merge(v, x, M.shl_by(1, 19)), U32.and(j, 31))) == UB.low(M.shr_by(x, U32.and(j, 31))) : Bool}:
  match j:
