      Empty.absurd({UB.low(M.shr_by(O.bit_merge(v, x, M.shl_by(1, 3)), 3)) == UB.low(M.shr_by(x, 3)) : Bool}, F.logic__true_false(F.logic__subst(Word(27n), zz => {U32.is_eq(3, U32{WCon{True{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, zz}}}}}}) == False{} : Bool}, Word.and(27n, r, Word.zero(27n)), Word.zero(27n), UB.wand_zero(27n, r), ne)))
