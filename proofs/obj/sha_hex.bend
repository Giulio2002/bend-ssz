def wadd(x: W8, y: W8) -> W8:
  match x y:
    case W8{a0, a1, a2, a3, a4, a5, a6, a7} W8{b0, b1, b2, b3, b4, b5, b6, b7}: wadd1(hkb(False{}, a0, b0), a1, b1, a2, b2, a3, b3, a4, b4, a5, b5, a6, b6, a7, b7)

def hrot7(x: W8) -> W8:
  match x:
    case W8{+a0, +a1, +a2, +a3, +a4, +a5, +a6, +a7}: W8{cmb3(a2, a1), cmb3(a3, a2), cmb3(a4, a3), cmb3(a5, a4), cmb3(a6, a5), cmb3(a7, a6), cmb3(a0, a7), cmb3(a1, a0)}

def hrot18(x: W8) -> W8:
  match x:
    case W8{+a0, +a1, +a2, +a3, +a4, +a5, +a6, +a7}: W8{cmb2(a5, a4), cmb2(a6, a5), cmb2(a7, a6), cmb2(a0, a7), cmb2(a1, a0), cmb2(a2, a1), cmb2(a3, a2), cmb2(a4, a3)}

def hrot17(x: W8) -> W8:
  match x:
    case W8{+a0, +a1, +a2, +a3, +a4, +a5, +a6, +a7}: W8{cmb1(a5, a4), cmb1(a6, a5), cmb1(a7, a6), cmb1(a0, a7), cmb1(a1, a0), cmb1(a2, a1), cmb1(a3, a2), cmb1(a4, a3)}

def hrot19(x: W8) -> W8:
  match x:
    case W8{+a0, +a1, +a2, +a3, +a4, +a5, +a6, +a7}: W8{cmb3(a5, a4), cmb3(a6, a5), cmb3(a7, a6), cmb3(a0, a7), cmb3(a1, a0), cmb3(a2, a1), cmb3(a3, a2), cmb3(a4, a3)}

def hrot2(x: W8) -> W8:
  match x:
    case W8{+a0, +a1, +a2, +a3, +a4, +a5, +a6, +a7}: W8{cmb2(a1, a0), cmb2(a2, a1), cmb2(a3, a2), cmb2(a4, a3), cmb2(a5, a4), cmb2(a6, a5), cmb2(a7, a6), cmb2(a0, a7)}

def hrot13(x: W8) -> W8:
  match x:
    case W8{+a0, +a1, +a2, +a3, +a4, +a5, +a6, +a7}: W8{cmb1(a4, a3), cmb1(a5, a4), cmb1(a6, a5), cmb1(a7, a6), cmb1(a0, a7), cmb1(a1, a0), cmb1(a2, a1), cmb1(a3, a2)}

def hrot22(x: W8) -> W8:
  match x:
    case W8{+a0, +a1, +a2, +a3, +a4, +a5, +a6, +a7}: W8{cmb2(a6, a5), cmb2(a7, a6), cmb2(a0, a7), cmb2(a1, a0), cmb2(a2, a1), cmb2(a3, a2), cmb2(a4, a3), cmb2(a5, a4)}

def hrot6(x: W8) -> W8:
  match x:
    case W8{+a0, +a1, +a2, +a3, +a4, +a5, +a6, +a7}: W8{cmb2(a2, a1), cmb2(a3, a2), cmb2(a4, a3), cmb2(a5, a4), cmb2(a6, a5), cmb2(a7, a6), cmb2(a0, a7), cmb2(a1, a0)}

def hrot11(x: W8) -> W8:
  match x:
    case W8{+a0, +a1, +a2, +a3, +a4, +a5, +a6, +a7}: W8{cmb3(a3, a2), cmb3(a4, a3), cmb3(a5, a4), cmb3(a6, a5), cmb3(a7, a6), cmb3(a0, a7), cmb3(a1, a0), cmb3(a2, a1)}

def hrot25(x: W8) -> W8:
  match x:
    case W8{+a0, +a1, +a2, +a3, +a4, +a5, +a6, +a7}: W8{cmb1(a7, a6), cmb1(a0, a7), cmb1(a1, a0), cmb1(a2, a1), cmb1(a3, a2), cmb1(a4, a3), cmb1(a5, a4), cmb1(a6, a5)}

def hshr3(x: W8) -> W8:
  match x:
    case W8{+a0, +a1, +a2, +a3, +a4, +a5, +a6, +a7}: W8{cmb3(a1, a0), cmb3(a2, a1), cmb3(a3, a2), cmb3(a4, a3), cmb3(a5, a4), cmb3(a6, a5), cmb3(a7, a6), cmb3(X0{}, a7)}

def hshr10(x: W8) -> W8:
  match x:
    case W8{+a0, +a1, +a2, +a3, +a4, +a5, +a6, +a7}: W8{cmb2(a3, a2), cmb2(a4, a3), cmb2(a5, a4), cmb2(a6, a5), cmb2(a7, a6), cmb2(X0{}, a7), cmb2(X0{}, X0{}), cmb2(X0{}, X0{})}

def hsigma0(+x: W8) -> W8: wxor(wxor(hrot7(x), hrot18(x)), hshr3(x))
def hsigma1(+x: W8) -> W8: wxor(wxor(hrot17(x), hrot19(x)), hshr10(x))
def hsum0(+x: W8) -> W8: wxor(wxor(hrot2(x), hrot13(x)), hrot22(x))
def hsum1(+x: W8) -> W8: wxor(wxor(hrot6(x), hrot11(x)), hrot25(x))
def hch(+x: W8, y: W8, z: W8) -> W8: wxor(wand(x, y), wand(wnot(x), z))
def hmaj(+x: W8, +y: W8, +z: W8) -> W8: wxor(wxor(wand(x, y), wand(x, z)), wand(y, z))

def hnth(history: List<&2, W8>, index: Nat) -> W8:
  match history index:
    case Nil{} _:
      W8{X0{}, X0{}, X0{}, X0{}, X0{}, X0{}, X0{}, X0{}}
    case w <> rest 0n:
      w
    case w <> rest 1n+p:
      hnth(rest, p)

def hprev(history: List<&2, W8>, lag: Nat) -> W8:
  hnth(history, Nat.sub(lag, 1n))

def hrec(+history: List<&2, W8>) -> W8:
  wadd(wadd(wadd(hsigma1(hprev(history, 2n)), hprev(history, 7n)), hsigma0(hprev(history, 15n))), hprev(history, 16n))

def hext(rounds: Nat, +history: List<&2, W8>) -> List<&2, W8>:
  match rounds:
    case 0n:
      Nil{}
    case 1n+p:
      +x = hrec(history)
      x <> hext(p, x <> history)

def hsched(extra: Nat, +block: List<&2, W8>) -> List<&2, W8>:
  List.append(&2, W8, block, hext(extra, List.reverse(&2, W8, block)))

def hstep(s: HS, k: W8, x: W8) -> HS:
  HS{+a, +b, +c, d, +e, +f, +g, h} = s
  +t1 = wadd(wadd(wadd(wadd(h, hsum1(e)), hch(e, f, g)), k), x)
  t2 = wadd(hsum0(a), hmaj(a, b, c))
  HS{wadd(t1, t2), a, b, c, wadd(d, t1), e, f, g}

def hrounds(ks: List<&2, W8>, ws: List<&2, W8>) -> HS -> HS:
  match ks ws:
    case Nil{} _:
      s => s
    case k <> kt Nil{}:
      s => s
    case k <> kt x <> wt:
      next = hrounds(kt, wt)
      s => next(hstep(s, k, x))

def hff(x: HS, y: HS) -> HS:
  HS{a, b, c, d, e, f, g, h} = x
  HS{i, j, k, l, m, n, o, p} = y
  HS{wadd(a, i), wadd(b, j), wadd(c, k), wadd(d, l), wadd(e, m), wadd(f, n), wadd(g, o), wadd(h, p)}

def hcomp(ws: List<&2, W8>, ks: List<&2, W8>, +s: HS) -> HS:
  hff(s, hrounds(ks, ws)(s))

def KH() -> List<&2, W8>:
  [W8{X8{}, X9{}, XF{}, X2{}, XA{}, X8{}, X2{}, X4{}}, W8{X1{}, X9{}, X4{}, X4{}, X7{}, X3{}, X1{}, X7{}}, W8{XF{}, XC{}, XB{}, XF{}, X0{}, XC{}, X5{}, XB{}}, W8{X5{}, XA{}, XB{}, XD{}, X5{}, XB{}, X9{}, XE{}}, W8{XB{}, X5{}, X2{}, XC{}, X6{}, X5{}, X9{}, X3{}}, W8{X1{}, XF{}, X1{}, X1{}, X1{}, XF{}, X9{}, X5{}}, W8{X4{}, XA{}, X2{}, X8{}, XF{}, X3{}, X2{}, X9{}}, W8{X5{}, XD{}, XE{}, X5{}, XC{}, X1{}, XB{}, XA{}}, W8{X8{}, X9{}, XA{}, XA{}, X7{}, X0{}, X8{}, XD{}}, W8{X1{}, X0{}, XB{}, X5{}, X3{}, X8{}, X2{}, X1{}}, W8{XE{}, XB{}, X5{}, X8{}, X1{}, X3{}, X4{}, X2{}}, W8{X3{}, XC{}, XD{}, X7{}, XC{}, X0{}, X5{}, X5{}}, W8{X4{}, X7{}, XD{}, X5{}, XE{}, XB{}, X2{}, X7{}}, W8{XE{}, XF{}, X1{}, XB{}, XE{}, XD{}, X0{}, X8{}}, W8{X7{}, XA{}, X6{}, X0{}, XC{}, XD{}, XB{}, X9{}}, W8{X4{}, X7{}, X1{}, XF{}, XB{}, X9{}, X1{}, XC{}}, W8{X1{}, XC{}, X9{}, X6{}, XB{}, X9{}, X4{}, XE{}}, W8{X6{}, X8{}, X7{}, X4{}, XE{}, XB{}, XF{}, XE{}}, W8{X6{}, XC{}, XD{}, X9{}, X1{}, XC{}, XF{}, X0{}}, W8{XC{}, XC{}, X1{}, XA{}, XC{}, X0{}, X4{}, X2{}}, W8{XF{}, X6{}, XC{}, X2{}, X9{}, XE{}, XD{}, X2{}}, W8{XA{}, XA{}, X4{}, X8{}, X4{}, X7{}, XA{}, X4{}}, W8{XC{}, XD{}, X9{}, XA{}, X0{}, XB{}, XC{}, X5{}}, W8{XA{}, XD{}, X8{}, X8{}, X9{}, XF{}, X6{}, X7{}}, W8{X2{}, X5{}, X1{}, X5{}, XE{}, X3{}, X8{}, X9{}}, W8{XD{}, X6{}, X6{}, XC{}, X1{}, X3{}, X8{}, XA{}}, W8{X8{}, XC{}, X7{}, X2{}, X3{}, X0{}, X0{}, XB{}}, W8{X7{}, XC{}, XF{}, X7{}, X9{}, X5{}, XF{}, XB{}}, W8{X3{}, XF{}, XB{}, X0{}, X0{}, XE{}, X6{}, XC{}}, W8{X7{}, X4{}, X1{}, X9{}, X7{}, XA{}, X5{}, XD{}}, W8{X1{}, X5{}, X3{}, X6{}, XA{}, XC{}, X6{}, X0{}}, W8{X7{}, X6{}, X9{}, X2{}, X9{}, X2{}, X4{}, X1{}}, W8{X5{}, X8{}, XA{}, X0{}, X7{}, XB{}, X7{}, X2{}}, W8{X8{}, X3{}, X1{}, X2{}, XB{}, X1{}, XE{}, X2{}}, W8{XC{}, XF{}, XD{}, X6{}, XC{}, X2{}, XD{}, X4{}}, W8{X3{}, X1{}, XD{}, X0{}, X8{}, X3{}, X3{}, X5{}}, W8{X4{}, X5{}, X3{}, X7{}, XA{}, X0{}, X5{}, X6{}}, W8{XB{}, XB{}, XA{}, X0{}, XA{}, X6{}, X6{}, X7{}}, W8{XE{}, X2{}, X9{}, 