def wfin_e(+s0: Hx, +s1: Hx, +s2: Hx, +s3: Hx, +s4: Hx, +s5: Hx, +s6: Hx, +r: HK) -> {wfin(s0, s1, s2, s3, s4, s5, s6, r) == W8{s0, s1, s2, s3, s4, s5, s6, dig(r)} : W8}:
  match r:
    case HK{+d, +c}: {==}

def wst7(+s0: Hx, +s1: Hx, +s2: Hx, +s3: Hx, +s4: Hx, +s5: Hx, +r: HK, +a7: Hx, +b7: Hx) -> {wadd7(s0, s1, s2, s3, s4, s5, r, a7, b7) == W8{s0, s1, s2, s3, s4, s5, dig(r), dig(hkb(car(r), a7, b7))} : W8}:
  match r:
    case HK{+d, +c}: wfin_e(s0, s1, s2, s3, s4, s5, d, hkb(c, a7, b7))

def wst6(+s0: Hx, +s1: Hx, +s2: Hx, +s3: Hx, +s4: Hx, +r: HK, +a6: Hx, +b6: Hx, +a7: Hx, +b7: Hx) -> {wadd6(s0, s1, s2, s3, s4, r, a6, b6, a7, b7) == W8{s0, s1, s2, s3, s4, dig(r), dig(hkb(car(r), a6, b6)), dig(hkb(car(hkb(car(r), a6, b6)), a7, b7))} : W8}:
  match r:
    case HK{+d, +c}: wst7(s0, s1, s2, s3, s4, d, hkb(c, a6, b6), a7, b7)

def wst5(+s0: Hx, +s1: Hx, +s2: Hx, +s3: Hx, +r: HK, +a5: Hx, +b5: Hx, +a6: Hx, +b6: Hx, +a7: Hx, +b7: Hx) -> {wadd5(s0, s1, s2, s3, r, a5, b5, a6, b6, a7, b7) == W8{s0, s1, s2, s3, dig(r), dig(hkb(car(r), a5, b5)), dig(hkb(car(hkb(car(r), a5, b5)), a6, b6)), dig(hkb(car(hkb(car(hkb(car(r), a5, b5)), a6, b6)), a7, b7))} : W8}:
  match r:
    case HK{+d, +c}: wst6(s0, s1, s2, s3, d, hkb(c, a5, b5), a6, b6, a7, b7)

def wst4(+s0: Hx, +s1: Hx, +s2: Hx, +r: HK, +a4: Hx, +b4: Hx, +a5: Hx, +b5: Hx, +a6: Hx, +b6: Hx, +a7: Hx, +b7: Hx) -> {wadd4(s0, s1, s2, r, a4, b4, a5, b5, a6, b6, a7, b7) == W8{s0, s1, s2, dig(r), dig(hkb(car(r), a4, b4)), dig(hkb(car(hkb(car(r), a4, b4)), a5, b5)), dig(hkb(car(hkb(car(hkb(car(r), a4, b4)), a5, b5)), a6, b6)), dig(hkb(car(hkb(car(hkb(car(hkb(car(r), a4, b4)), a5, b5)), a6, b6)), a7, b7))} : W8}:
  match r:
    case HK{+d, +c}: wst5(s0, s1, s2, d, hkb(c, a4, b4), a5, b5, a6, b6, a7, b7)

def wst3(+s0: Hx, +s1: Hx, +r: HK, +a3: Hx, +b3: Hx, +a4: Hx, +b4: Hx, +a5: Hx, +b5: Hx, +a6: Hx, +b6: Hx, +a7: Hx, +b7: Hx) -> {wadd3(s0, s1, r, a3, b3, a4, b4, a5, b5, a6, b6, a7, b7) == W8{s0, s1, dig(r), dig(hkb(car(r), a3, b3)), dig(hkb(car(hkb(car(r), a3, b3)), a4, b4)), dig(hkb(car(hkb(car(hkb(car(r), a3, b3)), a4, b4)), a5, b5)), dig(hkb(car(hkb(car(hkb(car(hkb(car(r), a3, b3)), a4, b4)), a5, b5)), a6, b6)), dig(hkb(car(hkb(car(hkb(car(hkb(car(hkb(car(r), a3, b3)), a4, b4)), a5, b5)), a6, b6)), a7, b7))} : W8}:
