law ff_e:
  for +x: Types.State
  for +y: Types.State
  {encs(VF.feedforward(x, y)) == hff(encs(x), encs(y)) : HS}
def ff_e(x, y):
  match x y:
    case Types.H{+a, +b, +c, +d, +e, +f, +g, +h} Types.H{+i, +j, +k, +l, +m, +n, +o, +p}:
      hs_eq(enc(U32.add(a, i)), enc(U32.add(b, j)), enc(U32.add(c, k)), enc(U32.add(d, l)), enc(U32.add(e, m)), enc(U32.add(f, n)), enc(U32.add(g, o)), enc(U32.add(h, p)), wadd(enc(a), enc(i)), wadd(enc(b), enc(j)), wadd(enc(c), enc(k)), wadd(enc(d), enc(l)), wadd(enc(e), enc(m)), wadd(enc(f), enc(n)), wadd(enc(g), enc(o)), wadd(enc(h), enc(p)), add_e(a, i), add_e(b, j), add_e(c, k), add_e(d, l), add_e(e, m), add_e(f, n), add_e(g, o), add_e(h, p))

