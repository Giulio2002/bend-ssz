  %Equal.sym(Hx, x2, y2, e2) : {W8{y0, y1, _, x3, x4, x5, x6, x7} == W8{y0, y1, y2, y3, y4, y5, y6, y7} : W8}
  %Equal.sym(Hx, x3, y3, e3) : {W8{y0, y1, y2, _, x4, x5, x6, x7} == W8{y0, y1, y2, y3, y4, y5, y6, y7} : W8}
  %Equal.sym(Hx, x4, y4, e4) : {W8{y0, y1, y2, y3, _, x5, x6, x7} == W8{y0, y1, y2, y3, y4, y5, y6, y7} : W8}
  %Equal.sym(Hx, x5, y5, e5) : {W8{y0, y1, y2, y3, y4, _, x6, x7} == W8{y0, y1, y2, y3, y4, y5, y6, y7} : W8}
  %Equal.sym(Hx, x6, y6, e6) : {W8{y0, y1, y2, y3, y4, y5, _, x7} == W8{y0, y1, y2, y3, y4, y5, y6, y7} : W8}
