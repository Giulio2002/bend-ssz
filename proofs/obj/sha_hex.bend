# ---- one digit at a time ------------------------------------------------------
def nxor(+a0: Bool, +a1: Bool, +a2: Bool, +a3: Bool, +b0: Bool, +b1: Bool, +b2: Bool, +b3: Bool) -> {nib(Bool.xor(a0, b0), Bool.xor(a1, b1), Bool.xor(a2, b2), Bool.xor(a3, b3)) == hxor(nib(a0, a1, a2, a3), nib(b0, b1, b2, b3)) : Hx}:
  match a0 a1 a2 a3 b0 b1 b2 b3:
    case False{} False{} False{} False{} False{} False{} False{} False{}: {==}
    case True{} False{} False{} False{} False{} False{} False{} False{}: {==}
    case False{} True{} False{} False{} False{} False{} False{} False{}: {==}
