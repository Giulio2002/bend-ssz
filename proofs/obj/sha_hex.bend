    case Types.H{+a, +b, +c, +d, +e, +f, +g, +h}:
      st_eq(dec(enc(a)), dec(enc(b)), dec(enc(c)), dec(enc(d)), dec(enc(e)), dec(enc(f)), dec(enc(g)), dec(enc(h)), a, b, c, d, e, f, g, h, de(a), de(b), de(c), de(d), de(e), de(f), de(g), de(h))

