def encs(s: Types.State) -> HS:
  match s:
    case Types.H{a, b, c, d, e, f, g, h}: HS{enc(a), enc(b), enc(c), enc(d), enc(e), enc(f), enc(g), enc(h)}

def decs(s: HS) -> Types.State:
