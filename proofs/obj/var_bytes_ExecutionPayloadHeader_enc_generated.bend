    -> {Fulu_bytelist_32_e.bl32_putv(FD.array__thaw(U32, D1), pos, 436, 584, O.Words{FD.array__thaw(U32, TX), N}) == (FD.array__thaw(U32, VB.mone(VC.NW(N), 0n, Nat.add(146n, P), dd, VF.updv([584], dd, D1, Nat.add(109n, P)), TX)), (O.Words{FD.array__thaw(U32, TX), N}, SFS(N))) : Array<U32> & (O.Words & U32)}:
