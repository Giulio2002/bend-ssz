    Order.add_left(584n, U32.to_nat(N), 32n, hN), {==}))

# The header's end H + P lies in the object's room; a header offset 4 (k + P), k <= H, is below 2^32 by hr32.
def hHR(+N: U32, +P: Nat) -> {Nat.is_le(Nat.add(146n, P), Nat.add(VC.NW(N), Nat.add(146n, P))) == True{} : Bool}: Order.left_below_sum(VC.NW(N), Nat.add(146n, P))

def hq32(+k: Nat, +N: U32, +P: Nat, +hk: {Nat.is_le(k, 146n) == True{} : Bool},
    +hr32: {Nat.is_lt(A.quad(ROOM(N, P)), FD.spec_common__pow2(32n)) == True{} : Bool}) -> {Nat.is_lt(A.quad(Nat.add(k, P)), FD.spec_common__pow2(32n)) == True{} : Bool}:
  +h1 = FD.nat__le_trans(Nat.add(k, P), Nat.add(146n, P), ROOM(N, P), Order.add_right(k, 146n, P, hk), hHR(N, P))
  FD.nat__le_lt_trans(A.quad(Nat.add(k, P)), A.quad(ROOM(N, P)), FD.spec_common__pow2(32n),
    Order.double_monotone(Nat.double(Nat.add(k, P)), Nat.double(ROOM(N, P)), Order.double_monotone(Nat.add(k, P), ROOM(N, P), h1)), hr32)

# At dd < 29 (the old names): 4 ROOM <= 4 2^dd = 2^(2+dd) < 2^(3+dd) <= 2^32.
def hr32w(+N: U32, +P: Nat, +dd: Nat, +hdd: {Nat.is_lt(dd, 29n) == True{} : Bool}, +hdst: {Nat.is_le(ROOM(N, P), VB.pw(dd)) == True{} : Bool})
    -> {Nat.is_lt(A.quad(ROOM(N, P)), FD.spec_common__pow2(32n)) == True{} : Bool}:
  +hq = Order.double_monotone(Nat.double(ROOM(N, P)), Nat.double(VB.pw(dd)), Order.double_monotone(ROOM(N, P), VB.pw(dd), hdst))
  +hk = FD.nat__lt_succ_le(dd, 28n, hdd)
  FD.nat__le_lt_trans(A.quad(ROOM(N, P)), VB.pw(2n+dd), FD.spec_common__pow2(32n), hq,
    FD.nat__lt_le_trans(VB.pw(2n+dd), VB.pw(Nat.add(3n, dd)), FD.spec_common__pow2(32n), FD.nat__pow2_lt_succ(2n+dd),
      FD.nat__pow2_mono(Nat.add(3n, dd), 32n, FD.nat__le_trans(Nat.add(3n, dd), 31n, 32n, hk, {==}))))

def eocW(+k: Nat, +c: U32, +P: Nat, +pos: U32, +dd: Nat, +eP: {U32.to_nat(pos) == A.quad(P) : Nat},
    +hdd: {Nat.is_lt(dd, 31n) == True{} : Bool}, +ec: {U32.to_nat(c) == A.quad(k) : Nat},
    +hq: {Nat.is_lt(A.quad(Nat.add(k, P)), FD.spec_common__pow2(32n)) == True{} : Bool})
    -> {U32.to_nat(U32.add(pos, c)) == A.quad(Nat.add(k, P)) : Nat}:
  VF.off_add_lt(pos, c, P, k, eP, ec, hq)

def eoc(+k: Nat, +c: U32, +P: Nat, +pos: U32, +dd: Nat, +eP: {U32.to_nat(pos) == A.quad(P) : Nat},
    +hdd: {Nat.is_lt(dd, 29n) == True{} : Bool}, +ec: {U32.to_nat(c) == A.quad(k) : Nat},
    +hq: {Nat.is_le(A.quad(Nat.add(k, P)), VB.pw(2n+dd)) == True{} : Bool})
    -> {U32.to_nat(U32.add(pos, c)) == A.quad(Nat.add(k, P)) : Nat}:
  VF.off_add(pos, c, P, k, 2n+dd, eP, ec, hdd, hq)

def hHP(+N: U32, +dd: Nat, +P: Nat, +hdst: {Nat.is_le(ROOM(N, P), VB.pw(dd)) == True{} : Bool}) -> {Nat.is_le(Nat.add(146n, P), VB.pw(dd)) == True{} : Bool}:
  FD.nat__le_trans(Nat.add(146n, P), Nat.add(VC.NW(N), Nat.add(146n, P)), VB.pw(dd), Order.left_below_sum(VC.NW(N), Nat.add(146n, P)), hdst)

# A run of W words at word k (W + k <= 146) of the window lies in the tree.
def hb(+W: Nat, +k: Nat, +P: Nat, +dd: Nat, +hWk: {Nat.is_le(Nat.add(W, k), 146n) == True{} : Bool},
    +hH: {Nat.is_le(Nat.add(146n, P), VB.pw(dd)) == True{} : Bool}) -> {Nat.is_le(Nat.add(W, Nat.add(k, P)), VB.pw(dd)) == True{} : Bool}:
  %FD.nat__add_assoc(W, k, P) : {Nat.is_le(_, VB.pw(dd)) == True{} : Bool}
  FD.nat__le_trans(Nat.add(Nat.add(W, k), P), Nat.add(146n, P), VB.pw(dd), Order.add_right(Nat.add(W, k), 146n, P, hWk), hH)

def hbq(+W: Nat, +k: Nat, +P: Nat, +dd: Nat, +h: {Nat.is_le(Nat.add(W, Nat.add(k, P)), VB.pw(dd)) == True{} : Bool})
    -> {Nat.is_le(A.quad(Nat.add(k, P)), VB.pw(2n+dd)) == True{} : Bool}:
  +h1 = FD.nat__le_trans(Nat.add(k, P), Nat.add(W, Nat.add(k, P)), VB.pw(dd), Order.left_below_sum(W, Nat.add(k, P)), h)
  Order.double_monotone(Nat.double(Nat.add(k, P)), Nat.double(VB.pw(dd)), Order.double_monotone(Nat.add(k, P), VB.pw(dd), h1))

# A run of W words at word k (W + k <= 146) lies below the byte list's last word.
def hbz(+W: Nat, +k: Nat, +N: U32, +P: Nat, +hWk: {Nat.is_le(Nat.add(W, k), 146n) == True{} : Bool})
    -> {Nat.is_le(Nat.add(W, Nat.add(k, P)), Nat.add(VY.QL(N), Nat.add(146n, P))) == True{} : Bool}:
  %FD.nat__add_assoc(W, k, P) : {Nat.is_le(_, Nat.add(VY.QL(N), Nat.add(146n, P))) == True{} : Bool}
  FD.nat__le_trans(Nat.add(Nat.add(W, k), P), Nat.add(146n, P), Nat.add(VY.QL(N), Nat.add(146n, P)), Order.add_right(Nat.add(W, k), 146n, P, hWk),
    Order.left_below_sum(VY.QL(N), Nat.add(146n, P)))

