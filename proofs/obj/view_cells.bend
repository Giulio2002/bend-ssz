def el_same_go(+s: Bool, +d: Nat, +t: F.array__Tree<U32>, +X: List<&2, U32>, +hx: {F.spec_common__length(U32, X) == 512n : Nat}, +i: Nat, +J: Nat, +hs: {Nat.is_lt(i, J) == s : Bool},
    +ne: {Nat.is_eq(i, J) == False{} : Bool}, +hb: {Nat.is_le(Nat.add(O.e8(Nat.mul(J, 64n)), 512n), F.spec_common__pow2(d)) == True{} : Bool}, +pf: {F.array__perfect(U32, d, t) == True{} : Bool},
