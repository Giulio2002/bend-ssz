  match k:
    case 0n: {==}
    case 1n+q:
      %Equal.sym(S.Value, S.BytesValue{CL.cbytes(F.array__slots(U32, WW.tk(X, d, t, O.e8(Nat.mul(J, 64n)), 0n)), i0)}, S.BytesValue{CL.cbytes(F.array__slots(U32, t), i0)}, el_same(d, t, X, hx, i0, J, ne_lt(J, i0, hlt), hb, pf, idx_room(i0, C, F.spec_common__pow2(d), lt_k(i0, q, C, hk), hC))) :
        {S.Items{_, CL.citems(q, F.array__slots(U32, WW.tk(X, d, t, O.e8(Nat.mul(J, 64n)), 0n)), 1n+i0)} == S.Items{S.BytesValue{CL.cbytes(F.array__slots(U32, t), i0)}, CL.citems(q, F.array__slots(U32, t), 1n+i0)} : S.Value}
      %Equal.sym(S.Value, CL.citems(q, F.array__slots(U32, WW.tk(X, d, t, O.e8(Nat.mul(J, 64n)), 0n)), 1n+i0), CL.citems(q, F.array__slots(U32, t), 1n+i0), items_same(q, d, t, X, hx, 1n+i0, J, F.nat__lt_trans(J, i0, 1n+i0, hlt, F.nat__lt_succ(i0)), hb, pf, C, hC, F.logic__subst(Nat, z => {Nat.is_le(z, C) == True{} : Bool}, Nat.add(i0, 1n+q), Nat.add(1n+i0, q), F.nat__add_succ(i0, q), hk))) :
        {S.Items{S.BytesValue{CL.cbytes(F.array__slots(U32, t), i0)}, _} == S.Items{S.BytesValue{CL.cbytes(F.array__slots(U32, t), i0)}, CL.citems(q, F.array__slots(U32, t), 1n+i0)} : S.Value}
      {==}

# the run written at block J = i0 + r: the items are the old items with item r replaced
def items_set(+k: Nat, +r: Nat, +d: Nat, +t: F.array__Tree<U32>, +X: List<&2, U32>, +hx: {F.spec_common__length(U32, X) == 512n : Nat}, +i0: Nat, +J: Nat, +hJ: {J == Nat.add(i0, r) : Nat}, +hb: {Nat.is_le(Nat.add(O.e8(Nat.mul(J, 64n)), 512n), F.spec_common__pow2(d)) == True{} : Bool}, +pf: {F.array__perfect(U32, d, t) == True{} : Bool}, +C: Nat, +hC: {Nat.is_le(O.e8(Nat.mul(C, 64n)), F.spec_common__pow2(d)) == True{} : Bool}, +hk: {Nat.is_le(Nat.add(i0, k), C) == True{} : Bool})
    -> {CL.citems(k, F.array__slots(U32, WW.tk(X, d, t, O.e8(Nat.mul(J, 64n)), 0n)), i0) == VS.items_set(CL.citems(k, F.array__slots(U32, t), i0), r, S.BytesValue{FX.limbs(X)}) : S.Value}:
  match k r:
    case 0n _: {==}
    case 1n+q 0n:
      +eJ = Equal.trans(Nat, J, Nat.add(i0, 0n), i0, hJ, F.nat__add_zero(i0))
      %Equal.sym(S.Value, S.BytesValue{CL.cbytes(F.array__slots(U32, WW.tk(X, d, t, O.e8(Nat.mul(J, 64n)), 0n)), i0)}, S.BytesValue{FX.limbs(X)}, F.logic__subst(Nat, z => {S.BytesValue{CL.cbytes(F.array__slots(U32, WW.tk(X, d, t, O.e8(Nat.mul(J, 64n)), 0n)), z)} == S.BytesValue{FX.limbs(X)} : S.Value}, J, i0, eJ, el_hit(d, t, X, hx, J, hb, pf))) :
        {S.Items{_, CL.citems(q, F.array__slots(U32, WW.tk(X, d, t, O.e8(Nat.mul(J, 64n)), 0n)), 1n+i0)} == S.Items{S.BytesValue{FX.limbs(X)}, CL.citems(q, F.array__slots(U32, t), 1n+i0)} : S.Value}
      %Equal.sym(S.Value, CL.citems(q, F.array__slots(U32, WW.tk(X, d, t, O.e8(Nat.mul(J, 64n)), 0n)), 1n+i0), CL.citems(q, F.array__slots(U32, t), 1n+i0), items_same(q, d, t, X, hx, 1n+i0, J, F.logic__subst(Nat, z => {Nat.is_lt(z, 1n+i0) == True{} : Bool}, i0, J, Equal.sym(Nat, J, i0, eJ), F.nat__lt_succ(i0)), hb, pf, C, hC, F.logic__subst(Nat, z => {Nat.is_le(z, C) == True{} : Bool}, Nat.add(i0, 1n+q), Nat.add(1n+i0, q), F.nat__add_succ(i0, q), hk))) :
        {S.Items{S.BytesValue{FX.limbs(X)}, _} == S.Items{S.BytesValue{FX.limbs(X)}, CL.citems(q, F.array__slots(U32, t), 1n+i0)} : S.Value}
      {==}
    case 1n+q 1n+p:
      +hlt = F.logic__subst(Nat, z => {Nat.is_lt(i0, z) == True{} : Bool}, Nat.add(i0, 1n+p), J, Equal.sym(Nat, J, Nat.add(i0, 1n+p), hJ), lt_add_succ(i0, p))
      %Equal.sym(S.Value, S.BytesValue{CL.cbytes(F.array__slots(U32, WW.tk(X, d, t, O.e8(Nat.mul(J, 64n)), 0n)), i0)}, S.BytesValue{CL.cbytes(F.array__slots(U32, t), i0)}, el_same(d, t, X, hx, i0, J, F.nat__is_eq_lt(i0, J, hlt), hb, pf, idx_room(i0, C, F.spec_common__pow2(d), lt_k(i0, q, C, hk), hC))) :
        {S.Items{_, CL.citems(q, F.array__slots(U32, WW.tk(X, d, t, O.e8(Nat.mul(J, 64n)), 0n)), 1n+i0)} == S.Items{S.BytesValue{CL.cbytes(F.array__slots(U32, t), i0)}, VS.items_set(CL.citems(q, F.array__slots(U32, t), 1n+i0), p, S.BytesValue{FX.limbs(X)})} : S.Value}
      %Equal.sym(S.Value, CL.citems(q, F.array__slots(U32, WW.tk(X, d, t, O.e8(Nat.mul(J, 64n)), 0n)), 1n+i0), VS.items_set(CL.citems(q, F.array__slots(U32, t), 1n+i0), p, S.BytesValue{FX.limbs(X)}), items_set(q, p, d, t, X, hx, 1n+i0, J, Equal.trans(Nat, J, Nat.add(i0, 1n+p), Nat.add(1n+i0, p), hJ, F.nat__add_succ(i0, p)), hb, pf, C, hC, F.logic__subst(Nat, z => {Nat.is_le(z, C) == True{} : Bool}, Nat.add(i0, 1n+q), Nat.add(1n+i0, q), F.nat__add_succ(i0, q), hk))) :
        {S.Items{S.BytesValue{CL.cbytes(F.array__slots(U32, t), i0)}, _} == S.Items{S.BytesValue{CL.cbytes(F.array__slots(U32, t), i0)}, VS.items_set(CL.citems(q, F.array__slots(U32, t), 1n+i0), p, S.BytesValue{FX.limbs(X)})} : S.Value}
      {==}

# the view of the storage after the run is written at word q = O.e8(Nat.mul(J, 64n)): the view before, with item J replaced.
# `c` is the element count the view reads.
def view_set(+c: Nat, +d: Nat, +t: F.array__Tree<U32>, +X: List<&2, U32>, +hx: {F.spec_common__length(U32, X) == 512n : Nat}, +J: Nat, +q: Nat, +hq: {q == O.e8(Nat.mul(J, 64n)) : Nat},
    +hb: {Nat.is_le(Nat.add(q, 512n), F.spec_common__pow2(d)) == True{} : Bool}, +pf: {F.array__perfect(U32, d, t) == True{} : Bool}, +hcap: {Nat.is_le(O.e8(Nat.mul(c, 64n)), F.spec_common__pow2(d)) == True{} : Bool})
    -> {S.Sequence{CL.citems(c, F.array__slots(U32, F.array__freeze(U32, F.array__thaw(U32, WW.tk(X, d, t, q, 0n)))), 0n)} == VS.field_set(S.Sequence{CL.citems(c, F.array__slots(U32, F.array__freeze(U32, F.array__thaw(U32, t))), 0n)}, J, S.BytesValue{FX.limbs(X)}) : S.Value}:
  %Equal.sym(F.array__Tree<U32>, F.array__freeze(U32, F.array__thaw(U32, WW.tk(X, d, t, q, 0n))), WW.tk(X, d, t, q, 0n), F.array__freeze_thaw(U32, WW.tk(X, d, t, q, 0n))) :
    {S.Sequence{CL.citems(c, F.array__slots(U32, _), 0n)} == VS.field_set(S.Sequence{CL.citems(c, F.array__slots(U32, F.array__freeze(U32, F.array__thaw(U32, t))), 0n)}, J, S.BytesValue{FX.limbs(X)}) : S.Value}
  %Equal.sym(F.array__Tree<U32>, F.array__freeze(U32, F.array__thaw(U32, t)), t, F.array__freeze_thaw(U32, t)) :
    {S.Sequence{CL.citems(c, F.array__slots(U32, WW.tk(X, d, t, q, 0n)), 0n)} == VS.field_set(S.Sequence{CL.citems(c, F.array__slots(U32, _), 0n)}, J, S.BytesValue{FX.limbs(X)}) : S.Value}
  %Equal.sym(Nat, q, O.e8(Nat.mul(J, 64n)), hq) :
    {S.Sequence{CL.citems(c, F.array__slots(U32, WW.tk(X, d, t, _, 0n)), 0n)} == VS.field_set(S.Sequence{CL.citems(c, F.array__slots(U32, t), 0n)}, J, S.BytesValue{FX.limbs(X)}) : S.Value}
  Equal.cong(S.Value, S.Value, z => S.Sequence{z}, CL.citems(c, F.array__slots(U32, WW.tk(X, d, t, O.e8(Nat.mul(J, 64n)), 0n)), 0n), VS.items_set(CL.citems(c, F.array__slots(U32, t), 0n), J, S.BytesValue{FX.limbs(X)}),
    items_set(c, J, d, t, X, hx, 0n, J, {==}, F.logic__subst(Nat, z => {Nat.is_le(Nat.add(z, 512n), F.spec_common__pow2(d)) == True{} : Bool}, q, O.e8(Nat.mul(J, 64n)), hq, hb), pf, c, hcap, F.nat__le_refl(c)))
