# ---- the items ----
# from block i0 on, all after block J: the same items
def items_same(+k: Nat, +d: Nat, +t: F.array__Tree<U32>, +X: List<&2, U32>, +hx: {F.spec_common__length(U32, X) == 512n : Nat}, +i0: Nat, +J: Nat, +hlt: {Nat.is_lt(J, i0) == True{} : Bool}, +hb: {Nat.is_le(Nat.add(O.e8(Nat.mul(J, 64n)), 512n), F.spec_common__pow2(d)) == True{} : Bool}, +pf: {F.array__perfect(U32, d, t) == True{} : Bool}, +C: Nat, +hC: {Nat.is_le(O.e8(Nat.mul(C, 64n)), F.spec_common__pow2(d)) == True{} : Bool}, +hk: {Nat.is_le(Nat.add(i0, k), C) == True{} : Bool})
