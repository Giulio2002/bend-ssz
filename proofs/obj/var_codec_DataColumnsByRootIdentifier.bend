def VW(+t: FD.array__Tree<U32>, +n: U32) -> +List<U32>: VS.bt(U32.to_nat(n), F.limbs(FD.array__slots(U32, t)))
def VAL(+t: FD.array__Tree<U32>, +n: U32) -> S.Value: XV(t, CQ(n), FD.array__slots(U32, MM(t, n)))

def en_q(+d: Nat, +n: U32, +hd: {Nat.is_lt(d, 29n) == True{} : Bool}, +hn: {Nat.is_le(U32.to_nat(n), A.quad(VB.pw(d))) == True{} : Bool},
    +ha: {U32.is_le(36, n) == True{} : Bool}, +hc: {whole(LL(n)) == True{} : Bool})
    -> {A.quad(9n+VC.NW(LL(n))) == U32.to_nat(n) : Nat}:
  %Equal.sym(Nat, VC.NW(LL(n)), Nat.double(CQ(n)), eNWc(d, n, hd, ha, hn, hc)) : {A.quad(9n+_) == U32.to_nat(n) : Nat}
  %enFS(n, ha) : {A.quad(9n+Nat.double(CQ(n))) == _ : Nat}
  %Equal.sym(Nat, U32.to_nat(LL(n)), VS.x8(CQ(n)), eLc(n, hc)) : {A.quad(9n+Nat.double(CQ(n))) == Nat.add(36n, _) : Nat}
  %Equal.sym(Nat, VS.x8(CQ(n)), VB.d3(CQ(n)), VB.x8_d3(CQ(n))) : {A.quad(9n+Nat.double(CQ(n))) == Nat.add(36n, _) : Nat}
  {==}

def len_z(+n: U32) -> {VB.len(FD.array__slots(U32, VC.ZT(DZ(n)))) == VB.pw(DZ(n)) : Nat}:
  FD.array__slots_length(U32, DZ(n), VC.ZT(DZ(n)), FD.array__trep_perfect(U32, DZ(n), 0))

# The buffer's bytes are the limbs of the header words and the list's words.
def lim_eq(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hd: {Nat.is_lt(d, 29n) == True{} : Bool},
    +hn: {Nat.is_le(U32.to_nat(n), A.quad(VB.pw(d))) == True{} : Bool}, +ha: {U32.is_le(36, n) == True{} : Bool}, +epo: {SPO(t) == 36 : U32},
    +hc: {whole(LL(n)) == True{} : Bool})
    -> {F.limbs(VB.slot(t, 0n) <> VB.slot(t, 1n) <> VB.slot(t, 2n) <> VB.slot(t, 3n) <> VB.slot(t, 4n) <> VB.slot(t, 5n) <> VB.slot(t, 6n) <> VB.slot(t, 7n) <> 36 <> VS.wtake(Nat.double(CQ(n)), FD.array__slots(U32, MM(t, n)))) == VW(t, n) : +List<U32>}:
  +hs0 = hs(d, n, hd, ha, hn, hc)
  +hr0 = hr(d, n, hd, ha, hn, hc)
  +hsl = FD.logic__subst(Nat, z => {Nat.is_le(Nat.add(VC.NW(LL(n)), 9n), z) == True{} : Bool}, VB.pw(d), VB.len(FD.array__slots(U32, t)), Equal.sym(Nat, VB.len(FD.array__slots(U32, t)), VB.pw(d), FD.array__slots_length(U32, d, t, pf)), hs0)
  +hpre = FD.nat__le_trans(9n, Nat.add(VC.NW(LL(n)), 9n), VB.len(FD.array__slots(U32, t)), Order.left_below_sum(VC.NW(LL(n)), 9n), hsl)
  %en_q(d, n, hd, hn, ha, hc) : {F.limbs(VB.slot(t, 0n) <> VB.slot(t, 1n) <> VB.slot(t, 2n) <> VB.slot(t, 3n) <> VB.slot(t, 4n) <> VB.slot(t, 5n) <> VB.slot(t, 6n) <> VB.slot(t, 7n) <> 36 <> VS.wtake(Nat.double(CQ(n)), FD.array__slots(U32, MM(t, n)))) == VS.bt(_, F.limbs(FD.array__slots(U32, t))) : +List<U32>}
  %Equal.sym(+List<U32>, VS.bt(A.quad(9n+VC.NW(LL(n))), F.limbs(FD.array__slots(U32, t))), F.limbs(VS.wtake(9n+VC.NW(LL(n)), FD.array__slots(U32, t))), VS.bt_limbs(9n+VC.NW(LL(n)), FD.array__slots(U32, t))) :
    {F.limbs(VB.slot(t, 0n) <> VB.slot(t, 1n) <> VB.slot(t, 2n) <> VB.slot(t, 3n) <> VB.slot(t, 4n) <> VB.slot(t, 5n) <> VB.slot(t, 6n) <> VB.slot(t, 7n) <> 36 <> VS.wtake(Nat.double(CQ(n)), FD.array__slots(U32, MM(t, n)))) == _ : +List<U32>}
  %Equal.sym(List<&2, U32>, VS.wtake(Nat.add(9n, VC.NW(LL(n))), VB.wdr(0n, FD.array__slots(U32, t))), VF.app(VF.wpre(9n, 0n, FD.array__slots(U32, t)), VS.wtake(VC.NW(LL(n)), VB.wdr(Nat.add(9n, 0n), FD.array__slots(U32, t)))), VF.wt_pre(9n, VC.NW(LL(n)), 0n, FD.array__slots(U32, t), hpre)) :
    {F.limbs(VB.slot(t, 0n) <> VB.slot(t, 1n) <> VB.slot(t, 2n) <> VB.slot(t, 3n) <> VB.slot(t, 4n) <> VB.slot(t, 5n) <> VB.slot(t, 6n) <> VB.slot(t, 7n) <> 36 <> VS.wtake(Nat.double(CQ(n)), FD.array__slots(U32, MM(t, n)))) == F.limbs(_) : +List<U32>}
  %epo : {F.limbs(VB.slot(t, 0n) <> VB.slot(t, 1n) <> VB.slot(t, 2n) <> VB.slot(t, 3n) <> VB.slot(t, 4n) <> VB.slot(t, 5n) <> VB.slot(t, 6n) <> VB.slot(t, 7n) <> _ <> VS.wtake(Nat.double(CQ(n)), FD.array__slots(U32, MM(t, n)))) == F.limbs(VF.app(VF.wpre(9n, 0n, FD.array__slots(U32, t)), VS.wtake(VC.NW(LL(n)), VB.wdr(9n, FD.array__slots(U32, t))))) : +List<U32>}
  %Equal.sym(List<&2, U32>, FD.array__slots(U32, MM(t, n)), VB.lm(VC.NW(LL(n)), 9n, 0n, FD.array__slots(U32, VC.ZT(DZ(n))), FD.array__slots(U32, t)),
      VB.slots_mone(VC.NW(LL(n)), 9n, 0n, DZ(n), VC.ZT(DZ(n)), t, FD.array__trep_perfect(U32, DZ(n), 0), hr0)) :
    {F.limbs(VB.slot(t, 0n) <> VB.slot(t, 1n) <> VB.slot(t, 2n) <> VB.slot(t, 3n) <> VB.slot(t, 4n) <> VB.slot(t, 5n) <> VB.slot(t, 6n) <> VB.slot(t, 7n) <> SPO(t) <> VS.wtake(Nat.double(CQ(n)), _)) == F.limbs(VF.app(VF.wpre(9n, 0n, FD.array__slots(U32, t)), VS.wtake(VC.NW(LL(n)), VB.wdr(9n, FD.array__slots(U32, t))))) : +List<U32>}
  %eNWc(d, n, hd, ha, hn, hc) : {F.limbs(VB.slot(t, 0n) <> VB.slot(t, 1n) <> VB.slot(t, 2n) <> VB.slot(t, 3n) <> VB.slot(t, 4n) <> VB.slot(t, 5n) <> VB.slot(t, 6n) <> VB.slot(t, 7n) <> SPO(t) <> VS.wtake(_, VB.lm(VC.NW(LL(n)), 9n, 0n, FD.array__slots(U32, VC.ZT(DZ(n))), FD.array__slots(U32, t)))) == F.limbs(VF.app(VF.wpre(9n, 0n, FD.array__slots(U32, t)), VS.wtake(VC.NW(LL(n)), VB.wdr(9n, FD.array__slots(U32, t))))) : +List<U32>}
  %Equal.sym(List<&2, U32>, VS.wtake(VC.NW(LL(n)), VB.wdr(0n, VB.lm(VC.NW(LL(n)), 9n, 0n, FD.array__slots(U32, VC.ZT(DZ(n))), FD.array__slots(U32, t)))), VS.wtake(VC.NW(LL(n)), VB.wdr(9n, FD.array__slots(U32, t))),
      VB.lm_win(VC.NW(LL(n)), 9n, 0n, FD.array__slots(U32, VC.ZT(DZ(n))), FD.array__slots(U32, t),
        FD.logic__subst(Nat, z => {Nat.is_le(Nat.add(VC.NW(LL(n)), 0n), z) == True{} : Bool}, VB.pw(DZ(n)), VB.len(FD.array__slots(U32, VC.ZT(DZ(n)))), Equal.sym(Nat, VB.len(FD.array__slots(U32, VC.ZT(DZ(n)))), VB.pw(DZ(n)), len_z(n)), hr0),
        hsl)) :
    {F.limbs(VB.slot(t, 0n) <> VB.slot(t, 1n) <> VB.slot(t, 2n) <> VB.slot(t, 3n) <> VB.slot(t, 4n) <> VB.slot(t, 5n) <> VB.slot(t, 6n) <> VB.slot(t, 7n) <> SPO(t) <> _) == F.limbs(VF.app(VF.wpre(9n, 0n, FD.array__slots(U32, t)), VS.wtake(VC.NW(LL(n)), VB.wdr(9n, FD.array__slots(U32, t))))) : +List<U32>}
  {==}

def hl_mm(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +hd: {Nat.is_lt(d, 29n) == True{} : Bool}, +hn: {Nat.is_le(U32.to_nat(n), A.quad(VB.pw(d))) == True{} : Bool},
    +ha: {U32.is_le(36, n) == True{} : Bool}, +hc: {whole(LL(n)) == True{} : Bool})
    -> {Nat.is_le(Nat.double(CQ(n)), FD.spec_common__length(U32, FD.array__slots(U32, MM(t, n)))) == True{} : Bool}:
  %Equal.sym(Nat, FD.spec_common__length(U32, FD.array__slots(U32, MM(t, n))), VB.pw(DZ(n)),
      FD.array__slots_length(U32, DZ(n), MM(t, n), VB.mone_perfect(VC.NW(LL(n)), 9n, 0n, DZ(n), VC.ZT(DZ(n)), t, FD.array__trep_perfect(U32, DZ(n), 0)))) :
    {Nat.is_le(Nat.double(CQ(n)), _) == True{} : Bool}
  %eNWc(d, n, hd, ha, hn, hc) : {Nat.is_le(_, VB.pw(DZ(n))) == True{} : Bool}
  FD.logic__subst(Nat, z => {Nat.is_le(z, VB.pw(DZ(n))) == True{} : Bool}, Nat.add(VC.NW(LL(n)), 0n), VC.NW(LL(n)), FD.nat__add_zero(VC.NW(LL(n))), hr(d, n, hd, ha, hn, hc))

def spec_go(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hd: {Nat.is_lt(d, 29n) == True{} : Bool},
    +hn: {Nat.is_le(U32.to_nat(n), A.quad(VB.pw(d))) == True{} : Bool}, +ha: {U32.is_le(36, n) == True{} : Bool}, +epo: {SPO(t) == 36 : U32},
    +hc: {whole(LL(n)) == True{} : Bool})
    -> Decoding.decodes(Spec.DataColumnsByRootIdentifier(), VW(t, n), VAL(t, n)):
  Equal.trans(Maybe<&2, +List<U32>>, Codec.encoding_for_legal_type(Spec.DataColumnsByRootIdentifier(), VAL(t, n)), Some{F.limbs(VB.slot(t, 0n) <> VB.slot(t, 1n) <> VB.slot(t, 2n) <> VB.slot(t, 3n) <> VB.slot(t, 4n) <> VB.slot(t, 5n) <> VB.slot(t, 6n) <> VB.slot(t, 7n) <> 36 <> VS.wtake(Nat.double(CQ(n)), FD.array__slots(U32, MM(t, n))))}, Some{VW(t, n)},
    enc_spec(t, CQ(n), FD.array__slots(U32, MM(t, n)), hcL(n, hc), hl_mm(d, t, n, hd, hn, ha, hc)),
    Equal.cong(+List<U32>, Maybe<&2, +List<U32>>, z => Some{z}, F.limbs(VB.slot(t, 0n) <> VB.slot(t, 1n) <> VB.slot(t, 2n) <> VB.slot(t, 3n) <> VB.slot(t, 4n) <> VB.slot(t, 5n) <> VB.slot(t, 6n) <> VB.slot(t, 7n) <> 36 <> VS.wtake(Nat.double(CQ(n)), FD.array__slots(U32, MM(t, n)))), VW(t, n), lim_eq(d, t, n, pf, hd, hn, ha, epo, hc)))

# The bytes of every buffer the validator accepts are the spec encoding of the
# decoded object's value.
law decode_spec:
  for +d: Nat
  for +t: FD.array__Tree<U32>
  for +n: U32
  for +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}
  for +hd: {Nat.is_lt(d, 29n) == True{} : Bool}
  for +hn: {Nat.is_le(U32.to_nat(n), A.quad(VB.pw(d))) == True{} : Bool}
  for +hchk: {CHK(t, n) == True{} : Bool}
  Decoding.decodes(Spec.DataColumnsByRootIdentifier(), VW(t, n), VAL(t, n))
def decode_spec(d, t, n, pf, hd, hn, hchk):
  +a = U32.is_le(36, n)
  +b = U32.is_eq(SPO(t), 36)
  +c = whole(U32.sub(n, SPO(t)))
  +epo = FD.u32alg__eq_of(SPO(t), 36, chk_b(a, b, c, hchk))
  spec_go(d, t, n, pf, hd, hn, chk_a(a, b, c, hchk), epo,
    FD.logic__subst(U32, z => {whole(U32.sub(n, z)) == True{} : Bool}, SPO(t), 36, epo, chk_c(a, b, c, hchk)))

