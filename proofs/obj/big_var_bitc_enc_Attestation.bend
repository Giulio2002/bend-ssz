  +hN = VR.rep_N(T, K, U32.to_nat(131072), rep)
  +hz = VR.rep_hz(dw, T, K, 18n, U32.to_nat(131072), pfT, {==}, hN, hNk0(), CO.qs_sized(dw, K, 18n, U32.to_nat(131072), {==}, hN, hNk0(), hcap), wf)
  CT.enc_at(DO(K), dw, OUT1(K), T, U32.add(0, 236), 59n, K, 18n, 18n, U32.to_nat(131072), pf1(K), pfT, hDO29(K, hN), hdw, {==}, {==},
