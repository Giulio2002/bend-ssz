def hdstW(+K: U32, +hN: {Nat.is_le(U32.to_nat(K), U32.to_nat(131072)) == True{} : Bool}) -> {Nat.is_le(Nat.add(VC.NW(O.bits_nbytes(K)), 59n), VB.pw(DO(K))) == True{} : Bool}:
  +j = VBT.JK(K)
  +b = VBT.BKk(K)
  +hj = FD.nat__le_lt_trans(j, 3n, 4n, RD.and_le(VBT.PDK(K), 3), {==})
  +hb = FD.nat__le_lt_trans(b, 7n, 8n, RD.and_le(K, 7), {==})
  +cf = BW.cfj(j, b, hj, hb)
  +cD = DL.p1(DL.TD(j), DL.CE(j, b), DL.p2(DL.TC(j, b), DL.CD(j, b), DL.p2(DL.TB(b), DL.CC(j, b), DL.p2(DL.TA(j, b), DL.CB(j, b), cf))))
  +cA = DL.p1(DL.TA(j, b), DL.CB(j, b), cf)
  +cB = DL.p1(DL.TB(b), DL.CC(j, b), DL.p2(DL.TA(j, b), DL.CB(j, b), cf))
  +eNW = Equal.trans(Nat, VC.NW(O.bits_nbytes(K)), Nat.add(VBT.QK(K), VD.s_rng(2n, Nat.add(Nat.add(j, VD.s_rng(3n, Nat.add(b, 7n))), 3n))), Nat.add(VBT.QK(K), BW.CWr(DL.RK(K))),
    VBT.FNWnb(K, 18n, {==}, hKk(K, hN), j, b, Nat.add(j, VD.s_rng(3n, Nat.add(b, 7n))), VD.s_rng(2n, Nat.add(Nat.add(j, VD.s_rng(3n, Nat.add(b, 7n))), 3n)), {==}, {==}, {==}, cB, {==}),
    Equal.cong(Nat, Nat, z => Nat.add(VBT.QK(K), z), VD.s_rng(2n, Nat.add(Nat.add(j, VD.s_rng(3n, Nat.add(b, 7n))), 3n)), BW.CWr(DL.RK(K)), cA))
  +h1 = FD.logic__subst(Nat, z => {Nat.is_le(z, Nat.add(VBT.QK(K), 1n)) == True{} : Bool}, Nat.add(VBT.QK(K), BW.CWr(DL.RK(K))), VC.NW(O.bits_nbytes(K)),
