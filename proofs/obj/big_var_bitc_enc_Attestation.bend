# a <= H: a <= 2^DO.
def hbk(+a: Nat, +K: U32, +hN: {Nat.is_le(U32.to_nat(K), U32.to_nat(131072)) == True{} : Bool}, +ha: {Nat.is_le(a, 59n) == True{} : Bool}) -> {Nat.is_le(a, VB.pw(DO(K))) == True{} : Bool}:
  FD.nat__le_trans(a, 59n, VB.pw(DO(K)), ha, FD.nat__le_trans(59n, Nat.add(59n, Nat.add(VBT.QK(K), 1n)), VB.pw(DO(K)), Order.below_sum(59n, Nat.add(VBT.QK(K), 1n)), hDq(K, hN)))

def pf0(+K: U32) -> {FD.array__perfect(U32, DO(K), VC.ZT(DO(K))) == True{} : Bool}: FD.array__trep_perfect(U32, DO(K), 0)
def pf1(+K: U32) -> {FD.array__perfect(U32, DO(K), OUT1(K)) == True{} : Bool}: FD.array__upd_perfect(U32, DO(K), VC.ZT(DO(K)), 0n, 236, pf0(K))

# The words of OUT1 past the header are zero.
def sl1(+K: U32, +hN: {Nat.is_le(U32.to_nat(K), U32.to_nat(131072)) == True{} : Bool}, +k: Nat, +hk: {Nat.is_le(59n, k) == True{} : Bool}) -> {VB.slot(OUT1(K), k) == 0 : U32}:
  %Equal.sym(List<&2, U32>, FD.array__slots(U32, OUT1(K)), FD.spec_common__update(U32, FD.array__slots(U32, VC.ZT(DO(K))), 0n, 236),
      FD.array__upd_slots(U32, DO(K), VC.ZT(DO(K)), 0n, 236, FD.nat__lt_le_trans(0n, 59n, VB.pw(DO(K)), {==}, hbk(59n, K, hN, {==})), pf0(K))) :
    {FD.flat__nthc(_, k) == 0 : U32}
  Equal.trans(U32, FD.flat__nthc(FD.spec_common__update(U32, FD.array__slots(U32, VC.ZT(DO(K))), 0n, 236), k), FD.flat__nthc(FD.array__slots(U32, VC.ZT(DO(K))), k), 0,
    FD.flat__nthc_other(FD.array__slots(U32, VC.ZT(DO(K))), 0n, k, 236, FD.nat__is_eq_lt(0n, k, FD.nat__lt_le_trans(0n, 59n, k, {==}, hk))),
    VBT.zslot(DO(K), k))

def pfD0(+T: FD.array__Tree<U32>, +K: U32) -> {FD.array__perfect(U32, DO(K), OUTA(T, K)) == True{} : Bool}:
