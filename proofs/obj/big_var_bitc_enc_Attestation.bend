def za_zero_le(+n: Nat) -> {Nat.is_le(0n, n) == True{} : Bool}:
  match n:
    case 0n: {==}
    case 1n+p: {==}
law za_le_ne:
  for +a: Nat
  for +b: Nat
  for +h: {Nat.is_le(a, b) == True{} : Bool}
  for +ne: {Nat.is_eq(b, a) == False{} : Bool}
  {Nat.is_lt(a, b) == True{} : Bool}
def za_le_ne(a, b, h, ne):
  match a b:
    case 0n 0n: Empty.absurd({Nat.is_lt(0n, 0n) == True{} : Bool}, FD.logic__true_false(ne))
    case 0n 1n+q: {==}
    case 1n+p 0n: Empty.absurd({Nat.is_lt(1n+p, 0n) == True{} : Bool}, FD.logic__false_true(h))
    case 1n+ +p 1n+ +q: za_le_ne(p, q, h, ne)
