# The step's read: element i + 2 is the last one, or its offset is in the table.
def nx_s(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat}, +hd: {Nat.is_lt(d, 31n) == True{} : Bool},
    +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +hwN: {Nat.is_le(Nat.add(x, U32.to_nat(len)), U32.to_nat(VB.NMAX())) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +i: U32, +m: U32,
    +him: {Nat.is_le(2n+U32.to_nat(i), U32.to_nat(m)) == True{} : Bool}, +hq: {Nat.is_le(A.quad(U32.to_nat(m)), U32.to_nat(len)) == True{} : Bool},
    +l: Bool, +el: {U32.is_eq(U32.add(i, 2), m) == l : Bool})
    -> {proglist_ProgressiveVarTestStruct_r.pl_ProgressiveVarTestStruct_next(l, UA.BF(t, n), off, len, U32.add(i, 1)) == (UA.BF(t, n), NX(l, t, x, len, U32.add(i, 1))) : B.Buf & U32}:
  match l:
    case True{}: {==}
    case False{}:
      +e2 = VVU.addk(i, 2, m, him)
      +ne = FD.logic__subst(Nat, z => {Nat.is_eq(z, U32.to_nat(m)) == False{} : Bool}, U32.to_nat(U32.add(i, 2)), 2n+U32.to_nat(i), e2, VVU.eqf(U32.add(i, 2), m, el))
      +h3 = FD.nat__lt_succ_le_succ(2n+U32.to_nat(i), U32.to_nat(m), FD.nat__lt_or_eq(2n+U32.to_nat(i), U32.to_nat(m), him, ne))
      +e1 = VVU.addk(i, 1, m, FD.nat__le_trans(1n+U32.to_nat(i), 2n+U32.to_nat(i), U32.to_nat(m), A.le_skip(1n, 1n+U32.to_nat(i)), him))
      nx_f(d, t, n, x, off, len, eo, hd, hw, hwN, pf, U32.add(i, 1),
        FD.logic__subst(Nat, z => {Nat.is_le(Nat.add(A.quad(1n+z), 4n), U32.to_nat(len)) == True{} : Bool}, 1n+U32.to_nat(i), U32.to_nat(U32.add(i, 1)),
          Equal.sym(Nat, U32.to_nat(U32.add(i, 1)), 1n+U32.to_nat(i), e1),
          FD.logic__subst(Nat, z => {Nat.is_le(z, U32.to_nat(len)) == True{} : Bool}, Nat.add(4n, A.quad(2n+U32.to_nat(i))), Nat.add(A.quad(2n+U32.to_nat(i)), 4n),
            FD.nat__add_comm(4n, A.quad(2n+U32.to_nat(i))),
            FD.nat__le_trans(A.quad(3n+U32.to_nat(i)), A.quad(U32.to_nat(m)), U32.to_nat(len), dm(3n+U32.to_nat(i), U32.to_nat(m), h3), hq))))

def nx_0(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat}, +hd: {Nat.is_lt(d, 31n) == True{} : Bool},
    +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +hwN: {Nat.is_le(Nat.add(x, U32.to_nat(len)), U32.to_nat(VB.NMAX())) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +m: U32,
    +h1: {Nat.is_le(1n, U32.to_nat(m)) == True{} : Bool}, +hq: {Nat.is_le(A.quad(U32.to_nat(m)), U32.to_nat(len)) == True{} : Bool},
    +l: Bool, +el: {U32.is_eq(1, m) == l : Bool})
    -> {proglist_ProgressiveVarTestStruct_r.pl_ProgressiveVarTestStruct_next(l, UA.BF(t, n), off, len, 0) == (UA.BF(t, n), NX(l, t, x, len, 0)) : B.Buf & U32}:
  match l:
    case True{}: {==}
    case False{}:
      +h2 = FD.nat__lt_succ_le_succ(1n, U32.to_nat(m), FD.nat__lt_or_eq(1n, U32.to_nat(m), h1, VVU.eqf(1, m, el)))
      nx_f(d, t, n, x, off, len, eo, hd, hw, hwN, pf, 0, FD.nat__le_trans(8n, A.quad(U32.to_nat(m)), U32.to_nat(len), dm(2n, U32.to_nat(m), h2), hq))

# ---- the loop --------------------------------------------------------------------------------------

# ev over the offsets table: element i + 1 onwards, with i + 1 + k = m elements in all.
def ev_go(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat}, +hd: {Nat.is_lt(d, 31n) == True{} : Bool},
    +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +hwN: {Nat.is_le(Nat.add(x, U32.to_nat(len)), U32.to_nat(VB.NMAX())) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +m: U32,
    +hq: {Nat.is_le(A.quad(U32.to_nat(m)), U32.to_nat(len)) == True{} : Bool},
    +k: Nat, +i: U32, +ok: Bool, +a: U32, +inv: {Nat.add(U32.to_nat(i), 1n+k) == U32.to_nat(m) : Nat})
    -> {proglist_ProgressiveVarTestStruct_r.pl_ProgressiveVarTestStruct_ev(k, i, m, off, len, (UA.BF(t, n), (ok, a))) == (UA.BF(t, n), EV(k, i, m, t, x, off, len, ok, a)) : B.Buf & Bool}:
  match k:
    case 0n: {==}
    case 1n+q:
      +him = FD.logic__subst(Nat, z => {Nat.is_le(2n+U32.to_nat(i), z) == True{} : Bool}, Nat.add(U32.to_nat(i), 2n+q), U32.to_nat(m), inv,
        FD.logic__subst(Nat, z => {Nat.is_le(2n+U32.to_nat(i), z) == True{} : Bool}, Nat.add(2n+q, U32.to_nat(i)), Nat.add(U32.to_nat(i), 2n+q), FD.nat__add_comm(2n+q, U32.to_nat(i)),
          A.le_skip(q, U32.to_nat(i))))
      +e1 = VVU.addk(i, 1, m, FD.nat__le_trans(1n+U32.to_nat(i), 2n+U32.to_nat(i), U32.to_nat(m), A.le_skip(1n, 1n+U32.to_nat(i)), him))
      +inv2 = Equal.trans(Nat, Nat.add(U32.to_nat(U32.add(i, 1)), 1n+q), Nat.add(1n+U32.to_nat(i), 1n+q), U32.to_nat(m),
        Equal.cong(Nat, Nat, z => Nat.add(z, 1n+q), U32.to_nat(U32.add(i, 1)), 1n+U32.to_nat(i), e1),
        Equal.trans(Nat, Nat.add(1n+U32.to_nat(i), 1n+q), Nat.add(U32.to_nat(i), 2n+q), U32.to_nat(m), Equal.sym(Nat, Nat.add(U32.to_nat(i), 2n+q), 1n+Nat.add(U32.to_nat(i), 1n+q), FD.nat__add_succ(U32.to_nat(i), 1n+q)), inv))
      +nb = NX(U32.is_eq(U32.add(i, 2), m), t, x, len, U32.add(i, 1))
      %Equal.sym(B.Buf & U32, proglist_ProgressiveVarTestStruct_r.pl_ProgressiveVarTestStruct_next(U32.is_eq(U32.add(i, 2), m), UA.BF(t, n), off, len, U32.add(i, 1)), (UA.BF(t, n), nb),
          nx_s(d, t, n, x, off, len, eo, hd, hw, hwN, pf, i, m, him, hq, U32.is_eq(U32.add(i, 2), m), {==})) :
        {proglist_ProgressiveVarTestStruct_r.pl_ProgressiveVarTestStruct_ev(q, U32.add(i, 1), m, off, len, proglist_ProgressiveVarTestStruct_r.pl_ProgressiveVarTestStruct_ee(ok, off, len, a, _)) == (UA.BF(t, n), EV(1n+q, i, m, t, x, off, len, ok, a)) : B.Buf & Bool}
      %Equal.sym(B.Buf & (Bool & U32), proglist_ProgressiveVarTestStruct_r.pl_ProgressiveVarTestStruct_ee(ok, off, len, a, (UA.BF(t, n), nb)), (UA.BF(t, n), (EE(ok, t, x, off, len, a, nb), nb)), ee_ev(d, t, n, x, off, len, eo, hd, hw, hwN, pf, ok, a, nb)) :
        {proglist_ProgressiveVarTestStruct_r.pl_ProgressiveVarTestStruct_ev(q, U32.add(i, 1), m, off, len, _) == (UA.BF(t, n), EV(1n+q, i, m, t, x, off, len, ok, a)) : B.Buf & Bool}
      ev_go(d, t, n, x, off, len, eo, hd, hw, hwN, pf, m, hq, q, U32.add(i, 1), EE(ok, t, x, off, len, a, nb), nb, inv2)

# ---- the validator --------------------------------------------------------------------------------

def quad_pos(+y: Nat, +h: {Nat.is_le(4n, A.quad(y)) == True{} : Bool}) -> {Nat.is_le(1n, y) == True{} : Bool}:
  match y:
    case 0n: Empty.absurd({Nat.is_le(1n, 0n) == True{} : Bool}, FD.logic__false_true(h))
    case 1n+p: FD.nat__zero_le(p)

def nz(+y: Nat, +h: {Nat.is_eq(y, 0n) == False{} : Bool}) -> {Nat.is_le(1n, y) == True{} : Bool}:
  match y:
    case 0n: Empty.absurd({Nat.is_le(1n, 0n) == True{} : Bool}, FD.logic__true_false(h))
    case 1n+p: FD.nat__zero_le(p)

def hcs_b(+f: U32, +len: U32, +hl: {Nat.is_lt(U32.to_nat(len), 4n) == True{} : Bool}, +b: Bool, +eb: {HC(f, len) == b : Bool}) -> {b == False{} : Bool}:
  match b:
    case False{}: {==}
    case True{}:
      +hA = FD.logic__and_left(Bool.and(U32.is_eq(U32.and(f, 3), 0), U32.is_le(f, len)), Bool.and(U32.is_le(4, f), True{}), eb)
      +hB = FD.logic__and_right(Bool.and(U32.is_eq(U32.and(f, 3), 0), U32.is_le(f, len)), Bool.and(U32.is_le(4, f), True{}), eb)
      +hfl = ule(f, len, FD.logic__and_right(U32.is_eq(U32.and(f, 3), 0), U32.is_le(f, len), hA))
      +h4 = ule(4, f, FD.logic__and_left(U32.is_le(4, f), True{}, hB))
      Empty.absurd({True{} == False{} : Bool}, FD.logic__false_true(FD.nat__le_lt_trans(U32.to_nat(4), U32.to_nat(len), 4n, FD.nat__le_trans(U32.to_nat(4), U32.to_nat(f), U32.to_nat(len), h4, hfl), hl)))

def hcs(+f: U32, +len: U32, +hl: {Nat.is_lt(U32.to_nat(len), 4n) == True{} : Bool}) -> {HC(f, len) == False{} : Bool}:
  hcs_b(f, len, hl, HC(f, len), {==})

def okf(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat}, +hd: {Nat.is_lt(d, 31n) == True{} : Bool},
    +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +hwN: {Nat.is_le(Nat.add(x, U32.to_nat(len)), U32.to_nat(VB.NMAX())) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +c: Bool, +ec: {HC(W0(t, x), len) == c : Bool})
    -> {proglist_ProgressiveVarTestStruct_r.pl_ProgressiveVarTestStruct_first(c, UA.BF(t, n), off, len, W0(t, x)) == (UA.BF(t, n), CF(c, t, x, off, len)) : B.Buf & Bool}:
  match c:
    case False{}: {==}
    case True{}:
      +f = W0(t, x)
      +hA = FD.logic__and_left(Bool.and(U32.is_eq(U32.and(f, 3), 0), U32.is_le(f, len)), Bool.and(U32.is_le(4, f), True{}), ec)
      +hB = FD.logic__and_right(Bool.and(U32.is_eq(U32.and(f, 3), 0), U32.is_le(f, len)), Bool.and(U32.is_le(4, f), True{}), ec)
      +e3 = VVU.eqt(U32.and(f, 3), 0, FD.logic__and_left(U32.is_eq(U32.and(f, 3), 0), U32.is_le(f, len), hA))
      +hfl = ule(f, len, FD.logic__and_right(U32.is_eq(U32.and(f, 3), 0), U32.is_le(f, len), hA))
      +h4 = ule(4, f, FD.logic__and_left(U32.is_le(4, f), True{}, hB))
      +ew = Equal.trans(Nat, U32.to_nat(f), Nat.add(A.quad(U32.to_nat(NN(t, x))), U32.to_nat(U32.and(f, 3))), A.quad(U32.to_nat(NN(t, x))), VC.split4(f),
        Equal.trans(Nat, Nat.add(A.quad(U32.to_nat(NN(t, x))), U32.to_nat(U32.and(f, 3))), Nat.add(A.quad(U32.to_nat(NN(t, x))), 0n), A.quad(U32.to_nat(NN(t, x))),
          Equal.cong(Nat, Nat, z => Nat.add(A.quad(U32.to_nat(NN(t, x))), z), U32.to_nat(U32.and(f, 3)), 0n, e3), FD.nat__add_zero(A.quad(U32.to_nat(NN(t, x))))))
      +hq = FD.logic__subst(Nat, z => {Nat.is_le(z, U32.to_nat(len)) == True{} : Bool}, U32.to_nat(f), A.quad(U32.to_nat(NN(t, x))), ew, hfl)
      +h1 = quad_pos(U32.to_nat(NN(t, x)), FD.logic__subst(Nat, z => {Nat.is_le(4n, z) == True{} : Bool}, U32.to_nat(f), A.quad(U32.to_nat(NN(t, x))), ew, h4))
      +es = FD.u32__sub_nat(NN(t, x), 1, h1)
      +inv = Equal.trans(Nat, Nat.add(U32.to_nat(0), 1n+U32.to_nat(U32.sub(NN(t, x), 1))), 1n+Nat.sub(U32.to_nat(NN(t, x)), 1n), U32.to_nat(NN(t, x)),
        Equal.cong(Nat, Nat, z => 1n+z, U32.to_nat(U32.sub(NN(t, x), 1)), Nat.sub(U32.to_nat(NN(t, x)), 1n), es),
        FD.nat__sub_add(U32.to_nat(NN(t, x)), 1n, h1))
      %Equal.sym(B.Buf & U32, proglist_ProgressiveVarTestStruct_r.pl_ProgressiveVarTestStruct_next(U32.is_eq(1, NN(t, x)), UA.BF(t, n), off, len, 0), (UA.BF(t, n), B1(t, x, len)),
          nx_0(d, t, n, x, off, len, eo, hd, hw, hwN, pf, NN(t, x), h1, hq, U32.is_eq(1, NN(t, x)), {==})) :
        {proglist_ProgressiveVarTestStruct_r.pl_ProgressiveVarTestStruct_ev(U32.to_nat(U32.sub(NN(t, x), 1)), 0, NN(t, x), off, len, proglist_ProgressiveVarTestStruct_r.pl_ProgressiveVarTestStruct_ee(True{}, off, len, W0(t, x), _)) == (UA.BF(t, n), CF(True{}, t, x, off, len)) : B.Buf & Bool}
      %Equal.sym(B.Buf & (Bool & U32), proglist_ProgressiveVarTestStruct_r.pl_ProgressiveVarTestStruct_ee(True{}, off, len, W0(t, x), (UA.BF(t, n), B1(t, x, len))), (UA.BF(t, n), (EE(True{}, t, x, off, len, W0(t, x), B1(t, x, len)), B1(t, x, len))),
          ee_ev(d, t, n, x, off, len, eo, hd, hw, hwN, pf, True{}, W0(t, x), B1(t, x, len))) :
        {proglist_ProgressiveVarTestStruct_r.pl_ProgressiveVarTestStruct_ev(U32.to_nat(U32.sub(NN(t, x), 1)), 0, NN(t, x), off, len, _) == (UA.BF(t, n), CF(True{}, t, x, off, len)) : B.Buf & Bool}
      ev_go(d, t, n, x, off, len, eo, hd, hw, hwN, pf, NN(t, x), hq, U32.to_nat(U32.sub(NN(t, x), 1)), 0, EE(True{}, t, x, off, len, W0(t, x), B1(t, x, len)), B1(t, x, len), inv)

def okh(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat}, +hd: {Nat.is_lt(d, 31n) == True{} : Bool},
    +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +hwN: {Nat.is_le(Nat.add(x, U32.to_nat(len)), U32.to_nat(VB.NMAX())) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +h1: {Nat.is_le(1n, U32.to_nat(len)) == True{} : Bool},
    +s: Bool, +es: {U32.is_lt(len, 4) == s : Bool})
    -> {proglist_ProgressiveVarTestStruct_r.pl_ProgressiveVarTestStruct_head(len, off, B.read32(UA.BF(t, n), off)) == (UA.BF(t, n), CF(HC(W0(t, x), len), t, x, off, len)) : B.Buf & Bool}:
  match s:
    case True{}:
      +hl = FD.logic__subst(Bool, z => {z == True{} : Bool}, U32.is_lt(len, 4), Nat.is_lt(U32.to_nat(len), U32.to_nat(4)), FD.u32__is_lt_nat(len, 4), es)
      +hx = FD.logic__subst(Nat, z => {Nat.is_lt(z, A.quad(VB.pw(d))) == True{} : Bool}, x, U32.to_nat(off), Equal.sym(Nat, U32.to_nat(off), x, eo),
        FD.nat__lt_le_trans(x, Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d)), FD.logic__subst(Nat, z => {Nat.is_lt(x, z) == True{} : Bool}, Nat.add(U32.to_nat(len), x), Nat.add(x, U32.to_nat(len)), FD.nat__add_comm(U32.to_nat(len), x),
          FD.nat__lt_le_trans(x, Nat.add(1n, x), Nat.add(U32.to_nat(len), x), FD.nat__lt_succ(x), Order.add_right(1n, U32.to_nat(len), x, h1))), hw))
      %Equal.sym(B.Buf & U32, B.read32(UA.BF(t, n), off), (UA.BF(t, n), VVR.RN(d, t, off)), VVR.rd_near(d, t, n, off, hd, pf, hx)) :
        {proglist_ProgressiveVarTestStruct_r.pl_ProgressiveVarTestStruct_head(len, off, _) == (UA.BF(t, n), CF(HC(W0(t, x), len), t, x, off, len)) : B.Buf & Bool}
      %Equal.sym(Bool, HC(VVR.RN(d, t, off), len), False{}, hcs(VVR.RN(d, t, off), len, hl)) :
        {proglist_ProgressiveVarTestStruct_r.pl_ProgressiveVarTestStruct_first(_, UA.BF(t, n), off, len, VVR.RN(d, t, off)) == (UA.BF(t, n), CF(HC(W0(t, x), len), t, x, off, len)) : B.Buf & Bool}
      %Equal.sym(Bool, HC(W0(t, x), len), False{}, hcs(W0(t, x), len, hl)) :
        {proglist_ProgressiveVarTestStruct_r.pl_ProgressiveVarTestStruct_first(False{}, UA.BF(t, n), off, len, VVR.RN(d, t, off)) == (UA.BF(t, n), CF(_, t, x, off, len)) : B.Buf & Bool}
      {==}
    case False{}:
      +h4 = FD.nat__not_lt_le(U32.to_nat(len), U32.to_nat(4), FD.logic__subst(Bool, z => {z == False{} : Bool}, U32.is_lt(len, 4), Nat.is_lt(U32.to_nat(len), U32.to_nat(4)), FD.u32__is_lt_nat(len, 4), es))
      %Equal.sym(B.Buf & U32, B.read32(UA.BF(t, n), off), (UA.BF(t, n), W0(t, x)), UR.rwx(d, t, n, off, x, eo, hd, pf,
          FD.nat__le_trans(Nat.add(x, 4n), Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d)), Order.add_left(x, 4n, U32.to_nat(len), h4), hw))) :
        {proglist_ProgressiveVarTestStruct_r.pl_ProgressiveVarTestStruct_head(len, off, _) == (UA.BF(t, n), CF(HC(W0(t, x), len), t, x, off, len)) : B.Buf & Bool}
      okf(d, t, n, x, off, len, eo, hd, hw, hwN, pf, HC(W0(t, x), len), {==})

def okz(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat}, +hd: {Nat.is_lt(d, 31n) == True{} : Bool},
    +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +hwN: {Nat.is_le(Nat.add(x, U32.to_nat(len)), U32.to_nat(VB.NMAX())) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +e: Bool, +ee: {U32.is_eq(len, 0) == e : Bool})
    -> {proglist_ProgressiveVarTestStruct_r.pl_ProgressiveVarTestStruct_ok_nz(e, UA.BF(t, n), off, len) == (UA.BF(t, n), CZ(e, t, x, off, len)) : B.Buf & Bool}:
  match e:
    case True{}: {==}
    case False{}: okh(d, t, n, x, off, len, eo, hd, hw, hwN, pf, nz(U32.to_nat(len), VVU.eqf(len, 0, ee)), U32.is_lt(len, 4), {==})

# The validator on the window returns the buffer and CHKw(t, x, off, len).
def ok_evalwD(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat}, +hd: {Nat.is_lt(d, 31n) == True{} : Bool},
    +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +hwN: {Nat.is_le(Nat.add(x, U32.to_nat(len)), U32.to_nat(VB.NMAX())) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool})
    -> {proglist_ProgressiveVarTestStruct_r.pl_ProgressiveVarTestStruct_ok(UA.BF(t, n), off, len) == (UA.BF(t, n), CHKw(t, x, off, len)) : B.Buf & Bool}:
  okz(d, t, n, x, off, len, eo, hd, hw, hwN, pf, U32.is_eq(len, 0), {==})

# ---- the mirror of the reader -----------------------------------------------------------------------

def OBJE(+d: Nat, +t: FD.array__Tree<U32>, +x: Nat, +off: U32, +s: U32, +e: U32) -> O.Boxed<ProgressiveVarTestStruct_d.ProgressiveVarTestStruct>:
  ProgressiveVarTestStruct_d.ProgressiveVarTestStruct_bx_wrap(YW.OBJw(d, t, Nat.add(U32.to_nat(s), x), U32.add(off, s), U32.sub(e, s)))

def RV(k: Nat, +i: U32, +m: U32, +d: Nat, +t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32, arr: Array<O.Boxed<ProgressiveVarTestStruct_d.ProgressiveVarTestStruct>>, v: O.Boxed<ProgressiveVarTestStruct_d.ProgressiveVarTestStruct>) -> Array<O.Boxed<ProgressiveVarTestStruct_d.ProgressiveVarTestStruct>>:
  match k:
    case 0n: Array.set(O.Boxed<ProgressiveVarTestStruct_d.ProgressiveVarTestStruct>, arr, i, v)
    case 1n+q: RV(q, U32.add(i, 1), m, d, t, x, off, len, Array.set(O.Boxed<ProgressiveVarTestStruct_d.ProgressiveVarTestStruct>, arr, i, v), OBJE(d, t, x, off, WJ(t, x, i), NX(U32.is_eq(U32.add(i, 2), m), t, x, len, U32.add(i, 1))))

def RZ(e: Bool, +d: Nat, +t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32) -> proglist_ProgressiveVarTestStruct_d.pl_ProgressiveVarTestStruct_Seq:
  match e:
    case True{}: proglist_ProgressiveVarTestStruct_d.pl_ProgressiveVarTestStruct_Seq{proglist_ProgressiveVarTestStruct_d.pl_ProgressiveVarTestStruct_fill(0n), 0}
    case False{}: proglist_ProgressiveVarTestStruct_d.pl_ProgressiveVarTestStruct_Seq{RV(U32.to_nat(U32.sub(NN(t, x), 1)), 0, NN(t, x), d, t, x, off, len, proglist_ProgressiveVarTestStruct_d.pl_ProgressiveVarTestStruct_fill(proglist_ProgressiveVarTestStruct_d.pl_ProgressiveVarTestStruct_cap(NN(t, x))), OBJE(d, t, x, off, W0(t, x), B1(t, x, len))), NN(t, x)}

def OBJw(+d: Nat, +t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32) -> proglist_ProgressiveVarTestStruct_d.pl_ProgressiveVarTestStruct_Seq: RZ(U32.is_eq(len, 0), d, t, x, off, len)

# ---- what CHKw says about each element -------------------------------------------------------------

def ev_ok(k: Nat, +i: U32, +m: U32, +t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32, +ok: Bool, +a: U32,
    +h: {EV(k, i, m, t, x, off, len, ok, a) == True{} : Bool}) -> {ok == True{} : Bool}:
  match k:
    case 0n: h
    case 1n+q:
      match ok:
        case True{}: {==}
        case False{}: ev_ok(q, U32.add(i, 1), m, t, x, off, len, False{}, NX(U32.is_eq(U32.add(i, 2), m), t, x, len, U32.add(i, 1)), h)

def ew_g(+g: Bool, +t: FD.array__Tree<U32>, +x: Nat, +off: U32, +a: U32, +b: U32, +h: {EW(g, t, x, off, a, b) == True{} : Bool}) -> {g == True{} : Bool}:
  match g:
    case True{}: {==}
    case False{}: h

def cf_ok(+c: Bool, +t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32, +h: {CF(c, t, x, off, len) == True{} : Bool}) -> {c == True{} : Bool}:
  match c:
    case True{}: {==}
    case False{}: h

# An element whose check passed: its window and the element module's check.
def el_ab(+t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32, +a: U32, +b: U32, +h: {EE(True{}, t, x, off, len, a, b) == True{} : Bool})
    -> {Nat.is_le(U32.to_nat(a), U32.to_nat(b)) == True{} : Bool}:
  +g = ew_g(GD(True{}, a, b, len), t, x, off, a, b, h)
  ule(a, b, FD.logic__and_left(U32.is_le(a, b), U32.is_le(b, len), g))

def el_b(+t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32, +a: U32, +b: U32, +h: {EE(True{}, t, x, off, len, a, b) == True{} : Bool})
    -> {Nat.is_le(U32.to_nat(b), U32.to_nat(len)) == True{} : Bool}:
  +g = ew_g(GD(True{}, a, b, len), t, x, off, a, b, h)
  ule(b, len, FD.logic__and_right(U32.is_le(a, b), U32.is_le(b, len), g))

def el_c(+t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32, +a: U32, +b: U32, +h: {EE(True{}, t, x, off, len, a, b) == True{} : Bool})
    -> {YW.CHKw(t, Nat.add(U32.to_nat(a), x), U32.add(off, a), U32.sub(b, a)) == True{} : Bool}:
  FD.logic__subst(Bool, z => {EW(z, t, x, off, a, b) == True{} : Bool}, GD(True{}, a, b, len), True{}, ew_g(GD(True{}, a, b, len), t, x, off, a, b, h), h)

# ---- the reads of the reader ---------------------------------------------------------------------------

def el_ev(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat}, +hd: {Nat.is_lt(d, 31n) == True{} : Bool},
    +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +hwN: {Nat.is_le(Nat.add(x, U32.to_nat(len)), U32.to_nat(VB.NMAX())) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +a: U32, +b: U32,
    +h: {EE(True{}, t, x, off, len, a, b) == True{} : Bool})
    -> {proglist_ProgressiveVarTestStruct_r.pl_ProgressiveVarTestStruct_elem(off, (UA.BF(t, n), (a, b))) == (UA.BF(t, n), OBJE(d, t, x, off, a, b)) : B.Buf & O.Boxed<ProgressiveVarTestStruct_d.ProgressiveVarTestStruct>}:
  +hab = el_ab(t, x, off, len, a, b, h)
  +hb = el_b(t, x, off, len, a, b, h)
  %Equal.sym(B.Buf & ProgressiveVarTestStruct_d.ProgressiveVarTestStruct, ProgressiveVarTestStruct_r.ProgressiveVarTestStruct_read(UA.BF(t, n), U32.add(off, a), U32.sub(b, a)), (UA.BF(t, n), YW.OBJw(d, t, Nat.add(U32.to_nat(a), x), U32.add(off, a), U32.sub(b, a))),
      YW.readwD(d, t, n, Nat.add(U32.to_nat(a), x), U32.add(off, a), U32.sub(b, a), eocD(d, x, off, len, a, FD.nat__le_trans(U32.to_nat(a), U32.to_nat(b), U32.to_nat(len), hab, hb), eo, hd, hw, hwN),
        hd, hwab(d, x, len, a, b, hab, hb, hw), hwab32(x, len, a, b, hab, hb, hwN), pf, el_c(t, x, off, len, a, b, h))) :
    {ProgressiveVarTestStruct_r.ProgressiveVarTestStruct_bx_rd(_) == (UA.BF(t, n), OBJE(d, t, x, off, a, b)) : B.Buf & O.Boxed<ProgressiveVarTestStruct_d.ProgressiveVarTestStruct>}
  {==}

def wd(+x: U32) -> Word(32n):
  match x:
    case U32{+w}: w

def add11(+i: U32) -> {U32.add(U32.add(i, 1), 1) == U32.add(i, 2) : U32}:
  match i:
    case U32{+w}: Equal.cong(Word(32n), U32, v => U32{v}, Word.add(32n, Word.add(32n, w, wd(1)), wd(1)), Word.add(32n, w, Word.add(32n, wd(1), wd(1))),
      FD.u32alg__w_assoc(32n, w, wd(1), wd(1)))

# The next element's window, from the offset just read: to the next offset, or to len.
def ws_ev(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat}, +hd: {Nat.is_lt(d, 31n) == True{} : Bool},
    +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +hwN: {Nat.is_le(Nat.add(x, U32.to_nat(len)), U32.to_nat(VB.NMAX())) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +i: U32, +m: U32,
    +him: {Nat.is_le(2n+U32.to_nat(i), U32.to_nat(m)) == True{} : Bool}, +hq: {Nat.is_le(A.quad(U32.to_nat(m)), U32.to_nat(len)) == True{} : Bool}, +s: U32,
    +l: Bool, +el: {U32.is_eq(U32.add(i, 2), m) == l : Bool})
    -> {proglist_ProgressiveVarTestStruct_r.pl_ProgressiveVarTestStruct_win_last(l, off, len, U32.add(i, 1), s, UA.BF(t, n)) == (UA.BF(t, n), (s, NX(l, t, x, len, U32.add(i, 1)))) : B.Buf & (U32 & U32)}:
  match l:
    case True{}: {==}
    case False{}:
      %Equal.sym(B.Buf & U32, proglist_ProgressiveVarTestStruct_r.pl_ProgressiveVarTestStruct_next(False{}, UA.BF(t, n), off, len, U32.add(i, 1)), (UA.BF(t, n), WJ(t, x, U32.add(i, 1))), nx_s(d, t, n, x, off, len, eo, hd, hw, hwN, pf, i, m, him, hq, False{}, el)) :
        {proglist_ProgressiveVarTestStruct_r.pl_ProgressiveVarTestStruct_win_end(s, _) == (UA.BF(t, n), (s, WJ(t, x, U32.add(i, 1)))) : B.Buf & (U32 & U32)}
      {==}

def win_ev(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat}, +hd: {Nat.is_lt(d, 31n) == True{} : Bool},
    +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +hwN: {Nat.is_le(Nat.add(x, U32.to_nat(len)), U32.to_nat(VB.NMAX())) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +i: U32, +m: U32,
    +him: {Nat.is_le(2n+U32.to_nat(i), U32.to_nat(m)) == True{} : Bool}, +hq: {Nat.is_le(A.quad(U32.to_nat(m)), U32.to_nat(len)) == True{} : Bool}, +s: U32)
