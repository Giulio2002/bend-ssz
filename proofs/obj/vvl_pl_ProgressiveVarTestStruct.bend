  %Equal.sym(U32, U32.add(U32.add(i, 1), 1), U32.add(i, 2), add11(i)) : {proglist_ProgressiveVarTestStruct_r.pl_ProgressiveVarTestStruct_win_last(U32.is_eq(_, m), off, len, U32.add(i, 1), s, UA.BF(t, n)) == (UA.BF(t, n), (s, NX(U32.is_eq(U32.add(i, 2), m), t, x, len, U32.add(i, 1)))) : B.Buf & (U32 & U32)}
