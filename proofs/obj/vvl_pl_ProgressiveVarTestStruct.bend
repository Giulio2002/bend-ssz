        {proglist_ProgressiveVarTestStruct_r.pl_ProgressiveVarTestStruct_rv(0n, U32.add(i, 1), off, len, m, Array.set(O.Boxed<ProgressiveVarTestStruct_d.ProgressiveVarTestStruct>, arr, i, v), _) == (UA.BF(t, n), RV(1n, i, m, d, t, x, off, len, arr, v)) : B.Buf & Array<O.Boxed<ProgressiveVarTestStruct_d.ProgressiveVarTestStruct>>}
