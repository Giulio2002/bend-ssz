        Order.below_sum(P2, List.length(&2, U32, VR.bcat(Con{r1, q}))))
      wval(d, t, x, len, pf, hw, hwN, hd, U32.to_nat(CI(j)), P2, List.append(&2, U32, VVL.OFFS(q, Nat.add(P2, List.length(&2, U32, r1))), Z), hp, eb, hQ)

# The ev loop from element i + 1 (start a, at P), over the elements' bytes rs and values its.
def evl(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat}, +hd: {Nat.is_lt(d, 31n) == True{} : Bool},
    +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +hwN: {Nat.is_le(Nat.add(x, U32.to_nat(len)), U32.to_nat(VB.NMAX())) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +m: U32, +Z: +List<U32>,
    +k: Nat, +its: S.Value, +rs: +List<+List<U32>>, +i: U32, +a: U32, +P: Nat,
    +ek: {VVL.CNT(rs) == k : Nat},
    +inv: {Nat.add(U32.to_nat(i), 1n+k) == U32.to_nat(m) : Nat},
    +ha: {U32.to_nat(a) == P : Nat},
    +hP: {VS.bdr(P, UW.WX(t, x, U32.to_nat(len))) == VR.bcat(rs) : +List<U32>},
    +hH: {Nat.add(P, List.length(&2, U32, VR.bcat(rs))) == U32.to_nat(len) : Nat},
    +hT: {VS.bdr(A.quad(1n+U32.to_nat(i)), UW.WX(t, x, U32.to_nat(len))) == List.append(&2, U32, VVL.OFFS(rs, P), Z) : +List<U32>},
    al: VVL.ALL(Spec.ProgressiveVarTestStruct(), its, rs), +hPV: {PV(k, i, m, t, x, len, a) == True{} : Bool})
    -> {EV(k, i, m, t, x, off, len, True{}, a) == True{} : Bool}:
  match k its rs:
    case 0n _ _: {==}
    case 1n+ +q S.Items{+h, +r} Con{+r0, +rs2}:
      (+eh, al2) = al
      +L0 = List.length(&2, U32, r0)
      +P2 = Nat.add(P, L0)
      +Bn = List.length(&2, U32, VR.bcat(rs2))
      +ek2 = FD.nat__succ_inj(VVL.CNT(rs2), q, ek)
      +ti = U32.to_nat(i)
      +him = FD.logic__subst(Nat, z => {Nat.is_le(2n+ti, z) == True{} : Bool}, Nat.add(ti, 2n+q), U32.to_nat(m), inv,
        FD.logic__subst(Nat, z => {Nat.is_le(2n+ti, z) == True{} : Bool}, Nat.add(2n+q, ti), Nat.add(ti, 2n+q), FD.nat__add_comm(2n+q, ti), A.le_skip(q, ti)))
      +e1 = VVU.addk(i, 1, m, FD.nat__le_trans(1n+ti, 2n+ti, U32.to_nat(m), A.le_skip(1n, 1n+ti), him))
      +e2 = VVU.addk(i, 2, m, him)
      +inv2 = Equal.trans(Nat, Nat.add(U32.to_nat(U32.add(i, 1)), 1n+q), Nat.add(1n+ti, 1n+q), U32.to_nat(m),
        Equal.cong(Nat, Nat, z => Nat.add(z, 1n+q), U32.to_nat(U32.add(i, 1)), 1n+ti, e1),
        Equal.trans(Nat, Nat.add(1n+ti, 1n+q), Nat.add(ti, 2n+q), U32.to_nat(m), Equal.sym(Nat, Nat.add(ti, 2n+q), 1n+Nat.add(ti, 1n+q), FD.nat__add_succ(ti, 1n+q)), inv))
      +hH2 = Equal.trans(Nat, Nat.add(P2, Bn), Nat.add(P, Nat.add(L0, Bn)), U32.to_nat(len), FD.nat__add_assoc(P, L0, Bn),
        Equal.trans(Nat, Nat.add(P, Nat.add(L0, Bn)), Nat.add(P, List.length(&2, U32, VR.bcat(Con{r0, rs2}))), U32.to_nat(len),
          Equal.cong(Nat, Nat, z => Nat.add(P, z), Nat.add(L0, Bn), List.length(&2, U32, VR.bcat(Con{r0, rs2})),
            Equal.sym(Nat, List.length(&2, U32, VR.bcat(Con{r0, rs2})), Nat.add(L0, Bn), VS.len_app(r0, VR.bcat(rs2)))), hH))
      +hr = FD.logic__subst(Nat, z => {Nat.is_le(P2, z) == True{} : Bool}, Nat.add(P2, Bn), U32.to_nat(len), hH2, Order.below_sum(P2, Bn))
      +q1 = A.quad(1n+ti)
      +eqq = Equal.trans(Nat, A.quad(1n+U32.to_nat(U32.add(i, 1))), A.quad(2n+ti), Nat.add(q1, 4n),
        Equal.cong(Nat, Nat, z => A.quad(1n+z), U32.to_nat(U32.add(i, 1)), 1n+ti, e1), FD.nat__add_comm(4n, q1))
      +hT2 = Equal.trans(+List<U32>, VS.bdr(A.quad(1n+U32.to_nat(U32.add(i, 1))), UW.WX(t, x, U32.to_nat(len))), VS.bdr(Nat.add(q1, 4n), UW.WX(t, x, U32.to_nat(len))), List.append(&2, U32, VVL.OFFS(rs2, P2), Z),
        Equal.cong(Nat, +List<U32>, z => VS.bdr(z, UW.WX(t, x, U32.to_nat(len))), A.quad(1n+U32.to_nat(U32.add(i, 1))), Nat.add(q1, 4n), eqq),
        Equal.trans(+List<U32>, VS.bdr(Nat.add(q1, 4n), UW.WX(t, x, U32.to_nat(len))), VS.bdr(4n, VS.bdr(q1, UW.WX(t, x, U32.to_nat(len)))), List.append(&2, U32, VVL.OFFS(rs2, P2), Z), VN.bdr_add(q1, 4n, UW.WX(t, x, U32.to_nat(len))),
          Equal.cong(+List<U32>, +List<U32>, z => VS.bdr(4n, z), VS.bdr(q1, UW.WX(t, x, U32.to_nat(len))), List.append(&2, U32, VVL.OFFS(Con{r0, rs2}, P), Z), hT)))
      +hP2 = Equal.trans(+List<U32>, VS.bdr(P2, UW.WX(t, x, U32.to_nat(len))), VS.bdr(L0, VS.bdr(P, UW.WX(t, x, U32.to_nat(len)))), VR.bcat(rs2), VN.bdr_add(P, L0, UW.WX(t, x, U32.to_nat(len))),
        Equal.trans(+List<U32>, VS.bdr(L0, VS.bdr(P, UW.WX(t, x, U32.to_nat(len)))), VS.bdr(L0, List.append(&2, U32, r0, VR.bcat(rs2))), VR.bcat(rs2),
          Equal.cong(+List<U32>, +List<U32>, z => VS.bdr(L0, z), VS.bdr(P, UW.WX(t, x, U32.to_nat(len))), VR.bcat(Con{r0, rs2}), hP), VS.bdr_app(r0, VR.bcat(rs2))))
      +nb = NX(U32.is_eq(U32.add(i, 2), m), t, x, len, U32.add(i, 1))
      +ej = Equal.trans(Nat, Nat.add(U32.to_nat(U32.add(i, 2)), VVL.CNT(rs2)), Nat.add(2n+ti, q), U32.to_nat(m),
        Equal.trans(Nat, Nat.add(U32.to_nat(U32.add(i, 2)), VVL.CNT(rs2)), Nat.add(2n+ti, VVL.CNT(rs2)), Nat.add(2n+ti, q),
          Equal.cong(Nat, Nat, z => Nat.add(z, VVL.CNT(rs2)), U32.to_nat(U32.add(i, 2)), 2n+ti, e2), Equal.cong(Nat, Nat, z => Nat.add(2n+ti, z), VVL.CNT(rs2), q, ek2)),
        Equal.trans(Nat, Nat.add(2n+ti, q), Nat.add(ti, 2n+q), U32.to_nat(m),
          Equal.sym(Nat, Nat.add(ti, 2n+q), 2n+Nat.add(ti, q), Equal.trans(Nat, Nat.add(ti, 2n+q), 1n+Nat.add(ti, 1n+q), 2n+Nat.add(ti, q), FD.nat__add_succ(ti, 1n+q),
            Equal.cong(Nat, Nat, z => 1n+z, Nat.add(ti, 1n+q), 1n+Nat.add(ti, q), FD.nat__add_succ(ti, q)))), inv))
      +hb = nxv(d, t, x, len, pf, hw, hwN, hd, U32.is_eq(U32.add(i, 2), m), U32.add(i, 1), U32.add(i, 2), m, P2, Z, rs2, {==}, ej, hT2, hH2)
      +hee = elx(d, t, n, x, off, len, eo, hd, hw, hwN, pf, a, nb, P, r0, VR.bcat(rs2), h, ha, hb, hP, hr, eh, FD.logic__and_left(PE(t, x, len, a, NX(U32.is_eq(U32.add(i, 2), m), t, x, len, U32.add(i, 1))), PV(q, U32.add(i, 1), m, t, x, len, NX(U32.is_eq(U32.add(i, 2), m), t, x, len, U32.add(i, 1))), hPV))
      %Equal.sym(Bool, EE(True{}, t, x, off, len, a, nb), True{}, hee) : {EV(q, U32.add(i, 1), m, t, x, off, len, _, nb) == True{} : Bool}
      evl(d, t, n, x, off, len, eo, hd, hw, hwN, pf, m, Z, q, r, rs2, U32.add(i, 1), nb, P2, ek2, inv2, hb, hP2, hH2, hT2, al2, FD.logic__and_right(PE(t, x, len, a, NX(U32.is_eq(U32.add(i, 2), m), t, x, len, U32.add(i, 1))), PV(q, U32.add(i, 1), m, t, x, len, NX(U32.is_eq(U32.add(i, 2), m), t, x, len, U32.add(i, 1))), hPV))
    case 1n+ +q S.Items{+h, +r} Nil{}: Empty.absurd({EV(1n+q, i, m, t, x, off, len, True{}, a) == True{} : Bool}, FD.logic__true_false(Equal.cong(Nat, Bool, z => Nat.is_eq(z, 0n), 0n, 1n+q, ek)))
    case 1n+ +q S.BooleanValue{+b0} Nil{}: Empty.absurd({EV(1n+q, i, m, t, x, off, len, True{}, a) == True{} : Bool}, FD.logic__true_false(Equal.cong(Nat, Bool, z => Nat.is_eq(z, 0n), 0n, 1n+q, ek)))
    case 1n+ +q S.BooleanValue{+b0} Con{+r0, +rs2}: Empty.absurd({EV(1n+q, i, m, t, x, off, len, True{}, a) == True{} : Bool}, al)
    case 1n+ +q S.UnsignedValue{+u0} Nil{}: Empty.absurd({EV(1n+q, i, m, t, x, off, len, True{}, a) == True{} : Bool}, FD.logic__true_false(Equal.cong(Nat, Bool, z => Nat.is_eq(z, 0n), 0n, 1n+q, ek)))
    case 1n+ +q S.UnsignedValue{+u0} Con{+r0, +rs2}: Empty.absurd({EV(1n+q, i, m, t, x, off, len, True{}, a) == True{} : Bool}, al)
    case 1n+ +q S.BytesValue{+xs0} Nil{}: Empty.absurd({EV(1n+q, i, m, t, x, off, len, True{}, a) == True{} : Bool}, FD.logic__true_false(Equal.cong(Nat, Bool, z => Nat.is_eq(z, 0n), 0n, 1n+q, ek)))
    case 1n+ +q S.BytesValue{+xs0} Con{+r0, +rs2}: Empty.absurd({EV(1n+q, i, m, t, x, off, len, True{}, a) == True{} : Bool}, al)
    case 1n+ +q S.BitsValue{+bs0} Nil{}: Empty.absurd({EV(1n+q, i, m, t, x, off, len, True{}, a) == True{} : Bool}, FD.logic__true_false(Equal.cong(Nat, Bool, z => Nat.is_eq(z, 0n), 0n, 1n+q, ek)))
    case 1n+ +q S.BitsValue{+bs0} Con{+r0, +rs2}: Empty.absurd({EV(1n+q, i, m, t, x, off, len, True{}, a) == True{} : Bool}, al)
    case 1n+ +q S.Sequence{+it0} Nil{}: Empty.absurd({EV(1n+q, i, m, t, x, off, len, True{}, a) == True{} : Bool}, FD.logic__true_false(Equal.cong(Nat, Bool, z => Nat.is_eq(z, 0n), 0n, 1n+q, ek)))
    case 1n+ +q S.Sequence{+it0} Con{+r0, +rs2}: Empty.absurd({EV(1n+q, i, m, t, x, off, len, True{}, a) == True{} : Bool}, al)
    case 1n+ +q S.EmptyItems{} Nil{}: Empty.absurd({EV(1n+q, i, m, t, x, off, len, True{}, a) == True{} : Bool}, FD.logic__true_false(Equal.cong(Nat, Bool, z => Nat.is_eq(z, 0n), 0n, 1n+q, ek)))
    case 1n+ +q S.EmptyItems{} Con{+r0, +rs2}: Empty.absurd({EV(1n+q, i, m, t, x, off, len, True{}, a) == True{} : Bool}, al)
    case 1n+ +q S.Selected{+sel0, +sv0} Nil{}: Empty.absurd({EV(1n+q, i, m, t, x, off, len, True{}, a) == True{} : Bool}, FD.logic__true_false(Equal.cong(Nat, Bool, z => Nat.is_eq(z, 0n), 0n, 1n+q, ek)))
    case 1n+ +q S.Selected{+sel0, +sv0} Con{+r0, +rs2}: Empty.absurd({EV(1n+q, i, m, t, x, off, len, True{}, a) == True{} : Bool}, al)
    case 1n+ +q S.NullValue{} Nil{}: Empty.absurd({EV(1n+q, i, m, t, x, off, len, True{}, a) == True{} : Bool}, FD.logic__true_false(Equal.cong(Nat, Bool, z => Nat.is_eq(z, 0n), 0n, 1n+q, ek)))
    case 1n+ +q S.NullValue{} Con{+r0, +rs2}: Empty.absurd({EV(1n+q, i, m, t, x, off, len, True{}, a) == True{} : Bool}, al)

def inv0(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat}, +hd: {Nat.is_lt(d, 31n) == True{} : Bool},
    +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +hwN: {Nat.is_le(Nat.add(x, U32.to_nat(len)), U32.to_nat(VB.NMAX())) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hW: {UW.WX(t, x, U32.to_nat(len)) == List.append(&2, U32, VVL.OFFS([], A.quad(0n)), VR.bcat([])) : +List<U32>})
    -> {CHKw(t, x, off, len) == True{} : Bool}:
  +el = Equal.trans(Nat, U32.to_nat(len), List.length(&2, U32, UW.WX(t, x, U32.to_nat(len))), 0n, Equal.sym(Nat, List.length(&2, U32, UW.WX(t, x, U32.to_nat(len))), U32.to_nat(len), UW.lenWX(d, t, x, U32.to_nat(len), pf, hw)),
    Equal.cong(+List<U32>, Nat, z => List.length(&2, U32, z), UW.WX(t, x, U32.to_nat(len)), [], hW))
  %Equal.sym(Bool, U32.is_eq(len, 0), True{}, FD.u32alg__eq_true(len, 0, FD.u32__injective(len, 0, el))) : {CZ(_, t, x, off, len) == True{} : Bool}
  {==}

# At least one element: y0 (value h0), then rs (values r).
def inv1(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat}, +hd: {Nat.is_lt(d, 31n) == True{} : Bool},
    +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +hwN: {Nat.is_le(Nat.add(x, U32.to_nat(len)), U32.to_nat(VB.NMAX())) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +h0: S.Value, +r: S.Value, +y0: +List<U32>, +rs: +List<+List<U32>>,
    +eh: {Codec.parts(h0, Spec.ProgressiveVarTestStruct()) == Some{[S.Variable{y0}]} : Maybe<&2, +List<S.Part>>}, al: VVL.ALL(Spec.ProgressiveVarTestStruct(), r, rs),
    +hW: {UW.WX(t, x, U32.to_nat(len)) == List.append(&2, U32, VVL.OFFS(Con{y0, rs}, A.quad(1n+VVL.CNT(rs))), VR.bcat(Con{y0, rs})) : +List<U32>}, +hPA: {PALL(t, x, len) == True{} : Bool})
    -> {CHKw(t, x, off, len) == True{} : Bool}:
  +Q = A.quad(1n+VVL.CNT(rs))
  +Z = VR.bcat(Con{y0, rs})
  +OQ = VVL.OFFS(Con{y0, rs}, Q)
  +L0 = List.length(&2, U32, y0)
  +Bn = List.length(&2, U32, VR.bcat(rs))
  +O1 = VVL.OFFS(rs, Nat.add(Q, L0))
  +tl = U32.to_nat(len)
  +hlen1 = Equal.trans(Nat, Nat.add(Q, List.length(&2, U32, Z)), Nat.add(List.length(&2, U32, OQ), List.length(&2, U32, Z)), tl,
    Equal.cong(Nat, Nat, z => Nat.add(z, List.length(&2, U32, Z)), Q, List.length(&2, U32, OQ), Equal.sym(Nat, List.length(&2, U32, OQ), Q, VVL.len_offs(Con{y0, rs}, Q))),
    Equal.trans(Nat, Nat.add(List.length(&2, U32, OQ), List.length(&2, U32, Z)), List.length(&2, U32, List.append(&2, U32, OQ, Z)), tl,
      Equal.sym(Nat, List.length(&2, U32, List.append(&2, U32, OQ, Z)), Nat.add(List.length(&2, U32, OQ), List.length(&2, U32, Z)), VS.len_app(OQ, Z)),
      Equal.trans(Nat, List.length(&2, U32, List.append(&2, U32, OQ, Z)), List.length(&2, U32, UW.WX(t, x, U32.to_nat(len))), tl,
        Equal.cong(+List<U32>, Nat, z => List.length(&2, U32, z), List.append(&2, U32, OQ, Z), UW.WX(t, x, U32.to_nat(len)), Equal.sym(+List<U32>, UW.WX(t, x, U32.to_nat(len)), List.append(&2, U32, OQ, Z), hW)),
        UW.lenWX(d, t, x, tl, pf, hw))))
  +hQl = FD.logic__subst(Nat, z => {Nat.is_le(Q, z) == True{} : Bool}, Nat.add(Q, List.length(&2, U32, Z)), tl, hlen1, Order.below_sum(Q, List.length(&2, U32, Z)))
  +h4Q = q4(VVL.CNT(rs))
  +h4l = FD.nat__le_trans(4n, Q, tl, h4Q, hQl)
  +eW0 = wval(d, t, x, len, pf, hw, hwN, hd, 0n, Q, List.append(&2, U32, O1, Z), h4l, hW, hQl)
  +f = W0(t, x)
  +tN = U32.to_nat(NN(t, x))
  +e3 = VLS.and3_q(f, 1n+VVL.CNT(rs), eW0)
  +eqN = Equal.trans(Nat, A.quad(tN), Nat.add(A.quad(tN), 0n), Q, Equal.sym(Nat, Nat.add(A.quad(tN), 0n), A.quad(tN), FD.nat__add_zero(A.quad(tN))),
    Equal.trans(Nat, Nat.add(A.quad(tN), 0n), Nat.add(A.quad(tN), U32.to_nat(U32.and(f, 3))), Q,
      Equal.cong(Nat, Nat, z => Nat.add(A.quad(tN), z), 0n, U32.to_nat(U32.and(f, 3)), Equal.cong(U32, Nat, z => U32.to_nat(z), 0, U32.and(f, 3), Equal.sym(U32, U32.and(f, 3), 0, e3))),
      Equal.trans(Nat, Nat.add(A.quad(tN), U32.to_nat(U32.and(f, 3))), U32.to_nat(f), Q, Equal.sym(Nat, U32.to_nat(f), Nat.add(A.quad(tN), U32.to_nat(U32.and(f, 3))), VC.split4(f)), eW0)))
  +hNN = FD.nat__double_inj(tN, 1n+VVL.CNT(rs), FD.nat__double_inj(Nat.double(tN), Nat.double(1n+VVL.CNT(rs)), eqN))
  +hfl = FD.logic__subst(Nat, z => {Nat.is_le(z, tl) == True{} : Bool}, Q, U32.to_nat(f), Equal.sym(Nat, U32.to_nat(f), Q, eW0), hQl)
  +h4W = FD.logic__subst(Nat, z => {Nat.is_le(4n, z) == True{} : Bool}, Q, U32.to_nat(f), Equal.sym(Nat, U32.to_nat(f), Q, eW0), h4Q)
  +hhc = hct(f, len, e3, hfl, h4W)
  +hT1 = Equal.cong(+List<U32>, +List<U32>, z => VS.bdr(4n, z), UW.WX(t, x, U32.to_nat(len)), List.append(&2, U32, OQ, Z), hW)
  +hH1 = Equal.trans(Nat, Nat.add(Nat.add(Q, L0), Bn), Nat.add(Q, Nat.add(L0, Bn)), tl, FD.nat__add_assoc(Q, L0, Bn),
    Equal.trans(Nat, Nat.add(Q, Nat.add(L0, Bn)), Nat.add(Q, List.length(&2, U32, Z)), tl,
      Equal.cong(Nat, Nat, z => Nat.add(Q, z), Nat.add(L0, Bn), List.length(&2, U32, Z), Equal.sym(Nat, List.length(&2, U32, Z), Nat.add(L0, Bn), VS.len_app(y0, VR.bcat(rs)))), hlen1))
  +ej1 = Equal.sym(Nat, tN, 1n+VVL.CNT(rs), hNN)
  +hb1 = nxv(d, t, x, len, pf, hw, hwN, hd, U32.is_eq(1, NN(t, x)), 0, 1, NN(t, x), Nat.add(Q, L0), Z, rs, {==}, ej1, hT1, hH1)
  +hP0 = Equal.trans(+List<U32>, VS.bdr(Q, UW.WX(t, x, U32.to_nat(len))), VS.bdr(Q, List.append(&2, U32, OQ, Z)), Z,
    Equal.cong(+List<U32>, +List<U32>, z => VS.bdr(Q, z), UW.WX(t, x, U32.to_nat(len)), List.append(&2, U32, OQ, Z), hW),
    FD.logic__subst(Nat, z => {VS.bdr(z, List.append(&2, U32, OQ, Z)) == Z : +List<U32>}, List.length(&2, U32, OQ), Q, VVL.len_offs(Con{y0, rs}, Q), VS.bdr_app(OQ, Z)))
  +hr0 = FD.logic__subst(Nat, z => {Nat.is_le(Nat.add(Q, L0), z) == True{} : Bool}, Nat.add(Nat.add(Q, L0), Bn), tl, hH1, Order.below_sum(Nat.add(Q, L0), Bn))
  +hee = elx(d, t, n, x, off, len, eo, hd, hw, hwN, pf, f, B1(t, x, len), Q, y0, VR.bcat(rs), h0, eW0, hb1, hP0, hr0, eh, FD.logic__and_left(PE(t, x, len, W0(t, x), B1(t, x, len)), PV(U32.to_nat(U32.sub(NN(t, x), 1)), 0, NN(t, x), t, x, len, B1(t, x, len)), hPA))
  +hP1 = Equal.trans(+List<U32>, VS.bdr(Nat.add(Q, L0), UW.WX(t, x, U32.to_nat(len))), VS.bdr(L0, VS.bdr(Q, UW.WX(t, x, U32.to_nat(len)))), VR.bcat(rs), VN.bdr_add(Q, L0, UW.WX(t, x, U32.to_nat(len))),
    Equal.trans(+List<U32>, VS.bdr(L0, VS.bdr(Q, UW.WX(t, x, U32.to_nat(len)))), VS.bdr(L0, List.append(&2, U32, y0, VR.bcat(rs))), VR.bcat(rs),
      Equal.cong(+List<U32>, +List<U32>, z => VS.bdr(L0, z), VS.bdr(Q, UW.WX(t, x, U32.to_nat(len))), Z, hP0), VS.bdr_app(y0, VR.bcat(rs))))
  +h1N = FD.logic__subst(Nat, z => {Nat.is_le(1n, z) == True{} : Bool}, 1n+VVL.CNT(rs), tN, Equal.sym(Nat, tN, 1n+VVL.CNT(rs), hNN), FD.nat__zero_le(VVL.CNT(rs)))
  +esub = FD.u32__sub_nat(NN(t, x), 1, h1N)
  +k0 = U32.to_nat(U32.sub(NN(t, x), 1))
  +ek0 = Equal.sym(Nat, k0, VVL.CNT(rs), Equal.trans(Nat, k0, Nat.sub(tN, 1n), VVL.CNT(rs), esub,
    Equal.trans(Nat, Nat.sub(tN, 1n), Nat.sub(1n+VVL.CNT(rs), 1n), VVL.CNT(rs), Equal.cong(Nat, Nat, z => Nat.sub(z, 1n), tN, 1n+VVL.CNT(rs), hNN), FD.nat__add_sub_cancel(1n, VVL.CNT(rs)))))
  +iv0 = Equal.trans(Nat, 1n+k0, 1n+VVL.CNT(rs), tN, Equal.cong(Nat, Nat, z => 1n+z, k0, VVL.CNT(rs), Equal.sym(Nat, VVL.CNT(rs), k0, ek0)), Equal.sym(Nat, tN, 1n+VVL.CNT(rs), hNN))
  +hl1 = FD.nat__le_trans(1n, 4n, tl, {==}, h4l)
  %Equal.sym(Bool, U32.is_eq(len, 0), False{}, neq0(len, hl1, U32.is_eq(len, 0), {==})) : {CZ(_, t, x, off, len) == True{} : Bool}
  %Equal.sym(Bool, HC(f, len), True{}, hhc) : {CF(_, t, x, off, len) == True{} : Bool}
  %Equal.sym(Bool, EE(True{}, t, x, off, len, f, B1(t, x, len)), True{}, hee) : {EV(k0, 0, NN(t, x), t, x, off, len, _, B1(t, x, len)) == True{} : Bool}
  evl(d, t, n, x, off, len, eo, hd, hw, hwN, pf, NN(t, x), Z, k0, r, rs, 0, B1(t, x, len), Nat.add(Q, L0), ek0, iv0, hb1, hP1, hH1, hT1, al, FD.logic__and_right(PE(t, x, len, W0(t, x), B1(t, x, len)), PV(U32.to_nat(U32.sub(NN(t, x), 1)), 0, NN(t, x), t, x, len, B1(t, x, len)), hPA))

def invm(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat}, +hd: {Nat.is_lt(d, 31n) == True{} : Bool},
    +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +hwN: {Nat.is_le(Nat.add(x, U32.to_nat(len)), U32.to_nat(VB.NMAX())) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +items: S.Value, +ys: +List<+List<U32>>,
    +hW: {UW.WX(t, x, U32.to_nat(len)) == List.append(&2, U32, VVL.OFFS(ys, A.quad(VVL.CNT(ys))), VR.bcat(ys)) : +List<U32>},
    al: VVL.ALL(Spec.ProgressiveVarTestStruct(), items, ys), +hPA: {PALL(t, x, len) == True{} : Bool})
    -> {CHKw(t, x, off, len) == True{} : Bool}:
  match items ys:
    case S.EmptyItems{} Nil{}: inv0(d, t, n, x, off, len, eo, hd, hw, hwN, pf, hW)
    case S.Items{+h0, +r} Con{+y0, +rs}:
      (+eh, al2) = al
      inv1(d, t, n, x, off, len, eo, hd, hw, hwN, pf, h0, r, y0, rs, eh, al2, hW, hPA)
    case S.BooleanValue{+b0} Nil{}: Empty.absurd({CHKw(t, x, off, len) == True{} : Bool}, al)
    case S.BooleanValue{+b0} Con{+y0, +rs}: Empty.absurd({CHKw(t, x, off, len) == True{} : Bool}, al)
    case S.UnsignedValue{+u0} Nil{}: Empty.absurd({CHKw(t, x, off, len) == True{} : Bool}, al)
    case S.UnsignedValue{+u0} Con{+y0, +rs}: Empty.absurd({CHKw(t, x, off, len) == True{} : Bool}, al)
    case S.BytesValue{+xs0} Nil{}: Empty.absurd({CHKw(t, x, off, len) == True{} : Bool}, al)
    case S.BytesValue{+xs0} Con{+y0, +rs}: Empty.absurd({CHKw(t, x, off, len) == True{} : Bool}, al)
    case S.BitsValue{+bs0} Nil{}: Empty.absurd({CHKw(t, x, off, len) == True{} : Bool}, al)
    case S.BitsValue{+bs0} Con{+y0, +rs}: Empty.absurd({CHKw(t, x, off, len) == True{} : Bool}, al)
    case S.Sequence{+it0} Nil{}: Empty.absurd({CHKw(t, x, off, len) == True{} : Bool}, al)
    case S.Sequence{+it0} Con{+y0, +rs}: Empty.absurd({CHKw(t, x, off, len) == True{} : Bool}, al)
    case S.Items{+hd0, +tl0} Nil{}: Empty.absurd({CHKw(t, x, off, len) == True{} : Bool}, al)
    case S.EmptyItems{} Con{+y0, +rs}: Empty.absurd({CHKw(t, x, off, len) == True{} : Bool}, al)
    case S.Selected{+sel0, +sv0} Nil{}: Empty.absurd({CHKw(t, x, off, len) == True{} : Bool}, al)
    case S.Selected{+sel0, +sv0} Con{+y0, +rs}: Empty.absurd({CHKw(t, x, off, len) == True{} : Bool}, al)
    case S.NullValue{} Nil{}: Empty.absurd({CHKw(t, x, off, len) == True{} : Bool}, al)
    case S.NullValue{} Con{+y0, +rs}: Empty.absurd({CHKw(t, x, off, len) == True{} : Bool}, al)

# ---- a progressive list's encoding (no count bound) -------------------------------------------------

# What the list's encoding W says: the offsets table of its elements' bytes ys, then ys.
def LSTP(+s: S.Schema, +items: S.Value, +W: +List<U32>, +ys: +List<+List<U32>>) -> Type:
  {W == List.append(&2, U32, VVL.OFFS(ys, A.quad(VVL.CNT(ys))), VR.bcat(ys)) : +List<U32>} & VVL.ALL(s, items, ys)

def inv_b2p(+s: S.Schema, +items: S.Value, +W: +List<U32>, +ys: +List<+List<U32>>, al: VVL.ALL(s, items, ys), +b2: Bool,
    +e: {Codec.one(SP.optional(b2, List.append(&2, U32, VVL.OFFS(ys, A.quad(VVL.CNT(ys))), VR.bcat(ys))), None{}) == Some{[S.Variable{W}]} : Maybe<&2, +List<S.Part>>})
    -> LSTP(s, items, W, ys):
  match b2:
    case False{}: Empty.absurd(LSTP(s, items, W, ys), FD.logic__none_some(+List<S.Part>, [S.Variable{W}], e))
    case True{}:
      (Equal.sym(+List<U32>, List.append(&2, U32, VVL.OFFS(ys, A.quad(VVL.CNT(ys))), VR.bcat(ys)), W, VVL.vinj(List.append(&2, U32, VVL.OFFS(ys, A.quad(VVL.CNT(ys))), VR.bcat(ys)), W, e)), al)

# A list value whose parts under Repeat{s} are ps, and whose layout is the one variable part W.
def inv_encp(+s: S.Schema, +items: S.Value, +W: +List<U32>, +ps: +List<S.Part>, r: VVL.REP(s, items, ps),
    +e: {Codec.aggregate(Some{ps}, None{}) == Some{[S.Variable{W}]} : Maybe<&2, +List<S.Part>>})
    -> LSTP(s, items, W, VVL.YP(ps)):
  (+ep, +ec, al) = r
  +ys = VVL.YP(ps)
  +e1 = FD.logic__subst(+List<S.Part>, z => {Codec.one(Layout.encoding(z), None{}) == Some{[S.Variable{W}]} : Maybe<&2, +List<S.Part>>}, ps, VVL.VP(ys), ep, e)
  +G = SP.optional(Bool.and(Layout.bytes_valid(VVL.VP(ys)), N.fits(4n, Nat.add(A.quad(VVL.CNT(ys)), List.length(&2, U32, VR.bcat(ys))))), List.append(&2, U32, VVL.OFFS(ys, A.quad(VVL.CNT(ys))), VR.bcat(ys)))
  inv_b2p(s, items, W, ys, al, Bool.and(Layout.bytes_valid(VVL.VP(ys)), N.fits(4n, Nat.add(A.quad(VVL.CNT(ys)), List.length(&2, U32, VR.bcat(ys))))),
    FD.logic__subst(Maybe<&2, +List<U32>>, z => {Codec.one(z, None{}) == Some{[S.Variable{W}]} : Maybe<&2, +List<S.Part>>}, Layout.encoding(VVL.VP(ys)), G, VVL.vp_encb(ys), e1))

# An element value's spec parts are at most one variable part.
def esingle(+h: S.Value) -> DF.single_result(None{}, Codec.parts(h, Spec.ProgressiveVarTestStruct())):
  match h:
    case S.Sequence{+items}: UW.vs_agg(Codec.parts(items, S.Chain{S.Unsigned{P.U8{}}, S.Chain{S.ListOf{S.Unsigned{P.U16{}}, 123n}, S.Chain{S.ProgressiveBits{}, S.End{}}}}))
    case S.BooleanValue{+b0}: Unit{}
    case S.UnsignedValue{+u0}: Unit{}
    case S.BytesValue{+xs0}: Unit{}
    case S.BitsValue{+bs0}: Unit{}
    case S.Items{+hd0, +tl0}: Unit{}
    case S.EmptyItems{}: Unit{}
    case S.Selected{+sel0, +sv0}: Unit{}
    case S.NullValue{}: Unit{}

def invl(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat}, +hd: {Nat.is_lt(d, 31n) == True{} : Bool},
    +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +hwN: {Nat.is_le(Nat.add(x, U32.to_nat(len)), U32.to_nat(VB.NMAX())) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +items: S.Value, +ys: +List<+List<U32>>,
    lst: LSTP(Spec.ProgressiveVarTestStruct(), items, UW.WX(t, x, U32.to_nat(len)), ys), +hPA: {PALL(t, x, len) == True{} : Bool})
    -> {CHKw(t, x, off, len) == True{} : Bool}:
  (+hW, al) = lst
  invm(d, t, n, x, off, len, eo, hd, hw, hwN, pf, items, ys, hW, al, hPA)

# The parts of items under Repeat{element}: one variable part per item.
def rep_v(+items: S.Value, +ps: +List<S.Part>, +e: {Codec.parts(items, S.Repeat{Spec.ProgressiveVarTestStruct()}) == Some{ps} : Maybe<&2, +List<S.Part>>}) -> VVL.REP(Spec.ProgressiveVarTestStruct(), items, ps):
  match items:
    case S.EmptyItems{}:
      +eps = FD.logic__some_inj(+List<S.Part>, [], ps, e)
      %Equal.sym(+List<S.Part>, ps, [], Equal.sym(+List<S.Part>, [], ps, eps)) : VVL.REP(Spec.ProgressiveVarTestStruct(), S.EmptyItems{}, _)
      ({==}, {==}, Unit{})
    case S.Items{+h, +t}: VVL.rep_h(Spec.ProgressiveVarTestStruct(), h, t, ps, Codec.parts(h, Spec.ProgressiveVarTestStruct()), esingle(h), {==}, e, pt => et => rep_v(t, pt, et))
    case S.BooleanValue{+b0}: Empty.absurd(VVL.REP(Spec.ProgressiveVarTestStruct(), S.BooleanValue{b0}, ps), FD.logic__none_some(+List<S.Part>, ps, e))
    case S.UnsignedValue{+u0}: Empty.absurd(VVL.REP(Spec.ProgressiveVarTestStruct(), S.UnsignedValue{u0}, ps), FD.logic__none_some(+List<S.Part>, ps, e))
    case S.BytesValue{+xs0}: Empty.absurd(VVL.REP(Spec.ProgressiveVarTestStruct(), S.BytesValue{xs0}, ps), FD.logic__none_some(+List<S.Part>, ps, e))
    case S.BitsValue{+bs0}: Empty.absurd(VVL.REP(Spec.ProgressiveVarTestStruct(), S.BitsValue{bs0}, ps), FD.logic__none_some(+List<S.Part>, ps, e))
    case S.Sequence{+it0}: Empty.absurd(VVL.REP(Spec.ProgressiveVarTestStruct(), S.Sequence{it0}, ps), FD.logic__none_some(+List<S.Part>, ps, e))
    case S.Selected{+sel0, +sv0}: Empty.absurd(VVL.REP(Spec.ProgressiveVarTestStruct(), S.Selected{sel0, sv0}, ps), FD.logic__none_some(+List<S.Part>, ps, e))
    case S.NullValue{}: Empty.absurd(VVL.REP(Spec.ProgressiveVarTestStruct(), S.NullValue{}, ps), FD.logic__none_some(+List<S.Part>, ps, e))

def rqn(+W: +List<U32>, +b: Bool, +e: {Codec.require(b, None{}) == Some{[S.Variable{W}]} : Maybe<&2, +List<S.Part>>}) -> Empty:
  match b:
    case True{}: FD.logic__none_some(+List<S.Part>, [S.Variable{W}], e)
    case False{}: FD.logic__none_some(+List<S.Part>, [S.Variable{W}], e)

def iv_m(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat}, +hd: {Nat.is_lt(d, 31n) == True{} : Bool},
    +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +hwN: {Nat.is_le(Nat.add(x, U32.to_nat(len)), U32.to_nat(VB.NMAX())) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +items: S.Value, +m: Maybe<&2, +List<S.Part>>,
    +em: {Codec.parts(items, S.Repeat{Spec.ProgressiveVarTestStruct()}) == m : Maybe<&2, +List<S.Part>>},
    +e: {Codec.aggregate(m, None{}) == Some{[S.Variable{UW.WX(t, x, U32.to_nat(len))}]} : Maybe<&2, +List<S.Part>>}, +hPA: {PALL(t, x, len) == True{} : Bool})
    -> {CHKw(t, x, off, len) == True{} : Bool}:
  match m:
    case None{}: Empty.absurd({CHKw(t, x, off, len) == True{} : Bool}, FD.logic__none_some(+List<S.Part>, [S.Variable{UW.WX(t, x, U32.to_nat(len))}], e))
    case Some{+ps}:
      invl(d, t, n, x, off, len, eo, hd, hw, hwN, pf, items, VVL.YP(ps), inv_encp(Spec.ProgressiveVarTestStruct(), items, UW.WX(t, x, U32.to_nat(len)), ps, rep_v(items, ps, em), e), hPA)

# Every value whose spec parts are the window's bytes passes the check.
def invwD(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat}, +hd: {Nat.is_lt(d, 31n) == True{} : Bool},
    +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +hwN: {Nat.is_le(Nat.add(x, U32.to_nat(len)), U32.to_nat(VB.NMAX())) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +v: S.Value, +e: {Codec.parts(v, S.ProgressiveList{Spec.ProgressiveVarTestStruct()}) == Some{[S.Variable{UW.WX(t, x, U32.to_nat(len))}]} : Maybe<&2, +List<S.Part>>}, +hPA: {PALL(t, x, len) == True{} : Bool})
    -> {CHKw(t, x, off, len) == True{} : Bool}:
  match v:
    case S.Sequence{+items}: iv_m(d, t, n, x, off, len, eo, hd, hw, hwN, pf, items, Codec.parts(items, S.Repeat{Spec.ProgressiveVarTestStruct()}), {==}, e, hPA)
    case S.BooleanValue{+b0}: Empty.absurd({CHKw(t, x, off, len) == True{} : Bool}, FD.logic__none_some(+List<S.Part>, [S.Variable{UW.WX(t, x, U32.to_nat(len))}], e))
    case S.UnsignedValue{+u0}: Empty.absurd({CHKw(t, x, off, len) == True{} : Bool}, FD.logic__none_some(+List<S.Part>, [S.Variable{UW.WX(t, x, U32.to_nat(len))}], e))
    case S.BytesValue{+xs0}: Empty.absurd({CHKw(t, x, off, len) == True{} : Bool}, FD.logic__none_some(+List<S.Part>, [S.Variable{UW.WX(t, x, U32.to_nat(len))}], e))
    case S.BitsValue{+bs0}: Empty.absurd({CHKw(t, x, off, len) == True{} : Bool}, FD.logic__none_some(+List<S.Part>, [S.Variable{UW.WX(t, x, U32.to_nat(len))}], e))
    case S.Items{+hd0, +tl0}: Empty.absurd({CHKw(t, x, off, len) == True{} : Bool}, FD.logic__none_some(+List<S.Part>, [S.Variable{UW.WX(t, x, U32.to_nat(len))}], e))
    case S.EmptyItems{}: Empty.absurd({CHKw(t, x, off, len) == True{} : Bool}, FD.logic__none_some(+List<S.Part>, [S.Variable{UW.WX(t, x, U32.to_nat(len))}], e))
    case S.Selected{+sel0, +sv0}: Empty.absurd({CHKw(t, x, off, len) == True{} : Bool}, FD.logic__none_some(+List<S.Part>, [S.Variable{UW.WX(t, x, U32.to_nat(len))}], e))
    case S.NullValue{}: Empty.absurd({CHKw(t, x, off, len) == True{} : Bool}, FD.logic__none_some(+List<S.Part>, [S.Variable{UW.WX(t, x, U32.to_nat(len))}], e))

# ---- the window interface as it was (d < 28, no hw32), for the callers not yet deep ----

def ok_evalw(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat}, +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool})
    -> {proglist_ProgressiveVarTestStruct_r.pl_ProgressiveVarTestStruct_ok(UA.BF(t, n), off, len) == (UA.BF(t, n), CHKw(t, x, off, len)) : B.Buf & Bool}:
