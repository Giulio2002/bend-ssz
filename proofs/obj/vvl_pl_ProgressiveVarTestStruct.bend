  +k0 = U32.to_nat(U32.sub(NN(t, x), 1))
  +hc1 = ev_ok(k0, 0, NN(t, x), t, x, off, len, EE(True{}, t, x, off, len, f, B1(t, x, len)), B1(t, x, len), hEV)
  +hE1 = FD.logic__subst(Bool, z => {EV(k0, 0, NN(t, x), t, x, off, len, z, B1(t, x, len)) == True{} : Bool}, EE(True{}, t, x, off, len, f, B1(t, x, len)), True{}, hc1, hEV)
  +hE0 = he0(t, x, off, len, U32.is_eq(1, NN(t, x)), {==}, hE1)
  +rd0 = UR.rwx(d, t, n, off, x, eo, hd, pf,
    FD.nat__le_trans(Nat.add(x, 4n), Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d)), Order.add_left(x, 4n, U32.to_nat(len), h4l), hw))
  %Equal.sym(B.Buf & U32, B.read32(UA.BF(t, n), off), (UA.BF(t, n), f), rd0) : {proglist_ProgressiveVarTestStruct_r.pl_ProgressiveVarTestStruct_rv_count(off, len, _) == (UA.BF(t, n), RZ(False{}, d, t, x, off, len)) : B.Buf & proglist_ProgressiveVarTestStruct_d.pl_ProgressiveVarTestStruct_Seq}
  %Equal.sym(B.Buf & U32, B.read32(UA.BF(t, n), off), (UA.BF(t, n), f), rd0) :
    {proglist_ProgressiveVarTestStruct_r.pl_ProgressiveVarTestStruct_rv_fin(NN(t, x), proglist_ProgressiveVarTestStruct_r.pl_ProgressiveVarTestStruct_rv(k0, 0, off, len, NN(t, x), proglist_ProgressiveVarTestStruct_d.pl_ProgressiveVarTestStruct_fill(proglist_ProgressiveVarTestStruct_d.pl_ProgressiveVarTestStruct_cap(NN(t, x))), proglist_ProgressiveVarTestStruct_r.pl_ProgressiveVarTestStruct_elem(off, proglist_ProgressiveVarTestStruct_r.pl_ProgressiveVarTestStruct_win_start(off, len, 0, NN(t, x), _)))) == (UA.BF(t, n), RZ(False{}, d, t, x, off, len)) : B.Buf & proglist_ProgressiveVarTestStruct_d.pl_ProgressiveVarTestStruct_Seq}
  %Equal.sym(B.Buf & (U32 & U32), proglist_ProgressiveVarTestStruct_r.pl_ProgressiveVarTestStruct_win_last(U32.is_eq(1, NN(t, x)), off, len, 0, f, UA.BF(t, n)), (UA.BF(t, n), (f, B1(t, x, len))),
      ws0(d, t, n, x, off, len, eo, hd, hw, hwN, pf, NN(t, x), h1, hq, f, U32.is_eq(1, NN(t, x)), {==})) :
    {proglist_ProgressiveVarTestStruct_r.pl_ProgressiveVarTestStruct_rv_fin(NN(t, x), proglist_ProgressiveVarTestStruct_r.pl_ProgressiveVarTestStruct_rv(k0, 0, off, len, NN(t, x), proglist_ProgressiveVarTestStruct_d.pl_ProgressiveVarTestStruct_fill(proglist_ProgressiveVarTestStruct_d.pl_ProgressiveVarTestStruct_cap(NN(t, x))), proglist_ProgressiveVarTestStruct_r.pl_ProgressiveVarTestStruct_elem(off, _))) == (UA.BF(t, n), RZ(False{}, d, t, x, off, len)) : B.Buf & proglist_ProgressiveVarTestStruct_d.pl_ProgressiveVarTestStruct_Seq}
  %Equal.sym(B.Buf & O.Boxed<ProgressiveVarTestStruct_d.ProgressiveVarTestStruct>, proglist_ProgressiveVarTestStruct_r.pl_ProgressiveVarTestStruct_elem(off, (UA.BF(t, n), (f, B1(t, x, len)))), (UA.BF(t, n), OBJE(d, t, x, off, f, B1(t, x, len))), el_ev(d, t, n, x, off, len, eo, hd, hw, hwN, pf, f, B1(t, x, len), hc1)) :
    {proglist_ProgressiveVarTestStruct_r.pl_ProgressiveVarTestStruct_rv_fin(NN(t, x), proglist_ProgressiveVarTestStruct_r.pl_ProgressiveVarTestStruct_rv(k0, 0, off, len, NN(t, x), proglist_ProgressiveVarTestStruct_d.pl_ProgressiveVarTestStruct_fill(proglist_ProgressiveVarTestStruct_d.pl_ProgressiveVarTestStruct_cap(NN(t, x))), _)) == (UA.BF(t, n), RZ(False{}, d, t, x, off, len)) : B.Buf & proglist_ProgressiveVarTestStruct_d.pl_ProgressiveVarTestStruct_Seq}
  %Equal.sym(B.Buf & Array<O.Boxed<ProgressiveVarTestStruct_d.ProgressiveVarTestStruct>>, proglist_ProgressiveVarTestStruct_r.pl_ProgressiveVarTestStruct_rv(k0, 0, off, len, NN(t, x), proglist_ProgressiveVarTestStruct_d.pl_ProgressiveVarTestStruct_fill(proglist_ProgressiveVarTestStruct_d.pl_ProgressiveVarTestStruct_cap(NN(t, x))), (UA.BF(t, n), OBJE(d, t, x, off, f, B1(t, x, len)))),
      (UA.BF(t, n), RV(k0, 0, NN(t, x), d, t, x, off, len, proglist_ProgressiveVarTestStruct_d.pl_ProgressiveVarTestStruct_fill(proglist_ProgressiveVarTestStruct_d.pl_ProgressiveVarTestStruct_cap(NN(t, x))), OBJE(d, t, x, off, f, B1(t, x, len)))),
      rv_go(d, t, n, x, off, len, eo, hd, hw, hwN, pf, NN(t, x), hq, k0, 0, proglist_ProgressiveVarTestStruct_d.pl_ProgressiveVarTestStruct_fill(proglist_ProgressiveVarTestStruct_d.pl_ProgressiveVarTestStruct_cap(NN(t, x))), OBJE(d, t, x, off, f, B1(t, x, len)), inv, hE0)) :
    {proglist_ProgressiveVarTestStruct_r.pl_ProgressiveVarTestStruct_rv_fin(NN(t, x), _) == (UA.BF(t, n), RZ(False{}, d, t, x, off, len)) : B.Buf & proglist_ProgressiveVarTestStruct_d.pl_ProgressiveVarTestStruct_Seq}
