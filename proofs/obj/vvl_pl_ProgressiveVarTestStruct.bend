        {proglist_ProgressiveVarTestStruct_r.pl_ProgressiveVarTestStruct_rv(1n+q, U32.add(i, 1), off, len, m, Array.set(O.Boxed<ProgressiveVarTestStruct_d.ProgressiveVarTestStruct>, arr, i, v), proglist_ProgressiveVarTestStruct_r.pl_ProgressiveVarTestStruct_elem(off, proglist_ProgressiveVarTestStruct_r.pl_ProgressiveVarTestStruct_win_start(off, len, U32.add(i, 1), m, _))) == (UA.BF(t, n), RV(2n+q, i, m, d, t, x, off, len, arr, v)) : B.Buf & Array<O.Boxed<ProgressiveVarTestStruct_d.ProgressiveVarTestStruct>>}
