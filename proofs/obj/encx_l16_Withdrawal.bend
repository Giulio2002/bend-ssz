    Equal.sym(+List<U32>, F.flat(CHW_l16_Withdrawal(c, A, 0n)), F.limbs(RWA_l16_Withdrawal(c, A, 0n)), flatW_l16_Withdrawal(c, A, 0n)), fit)
  %Equal.sym(Nat, Codec.count(ITW_l16_Withdrawal(c, A, 0n)), c, cntW_l16_Withdrawal(c, A, 0n)) :
    {Codec.require(Nat.is_le(_, U32.to_nat(16)), Codec.aggregate(Codec.parts(ITW_l16_Withdrawal(c, A, 0n), S.Repeat{S.Container{["index", "validator_index", "address", "amount"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{20n}, S.Chain{S.Unsigned{P.U64{}}, S.End{}}}}}}}), None{})) == Some{[S.Variable{F.limbs(RWA_l16_Withdrawal(c, A, 0n))}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(Bool, Nat.is_le(c, U32.to_nat(16)), True{}, hl) :
    {Codec.require(_, Codec.aggregate(Codec.parts(ITW_l16_Withdrawal(c, A, 0n), S.Repeat{S.Container{["index", "validator_index", "address", "amount"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{20n}, S.Chain{S.Unsigned{P.U64{}}, S.End{}}}}}}}), None{})) == Some{[S.Variable{F.limbs(RWA_l16_Withdrawal(c, A, 0n))}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(Maybe<&2, +List<S.Part>>, Codec.parts(ITW_l16_Withdrawal(c, A, 0n), S.Repeat{S.Container{["index", "validator_index", "address", "amount"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{20n}, S.Chain{S.Unsigned{P.U64{}}, S.End{}}}}}}}), Some{F.fparts(CHW_l16_Withdrawal(c, A, 0n))}, prtW_l16_Withdrawal(c, A, 0n)) :
