def VALL_l16_Withdrawal(+A: FD.array__Tree<FuluWithdrawal_d.Withdrawal>, +N: U32) -> S.Value: S.Sequence{ITW_l16_Withdrawal(U32.to_nat(N), A, 0n)}

def len_encl_l16_Withdrawal(+A: FD.array__Tree<FuluWithdrawal_d.Withdrawal>, +N: U32) -> {List.length(&2, U32, ENCL_l16_Withdrawal(A, N)) == LL_l16_Withdrawal(A, N) : Nat}:
  %Equal.sym(Nat, List.length(&2, U32, F.limbs(RWA_l16_Withdrawal(U32.to_nat(N), A, 0n))), F.wlen(RWA_l16_Withdrawal(U32.to_nat(N), A, 0n)), VS.len_limbs(RWA_l16_Withdrawal(U32.to_nat(N), A, 0n))) : {_ == LL_l16_Withdrawal(A, N) : Nat}
  %Equal.sym(Nat, F.wlen(RWA_l16_Withdrawal(U32.to_nat(N), A, 0n)), A.quad(List.length(&2, U32, RWA_l16_Withdrawal(U32.to_nat(N), A, 0n))), VS.wlen_quad(RWA_l16_Withdrawal(U32.to_nat(N), A, 0n))) : {_ == LL_l16_Withdrawal(A, N) : Nat}
  %Equal.sym(Nat, List.length(&2, U32, RWA_l16_Withdrawal(U32.to_nat(N), A, 0n)), FD.spec_common__length(U32, RWA_l16_Withdrawal(U32.to_nat(N), A, 0n)), VMR.len_eq(RWA_l16_Withdrawal(U32.to_nat(N), A, 0n))) : {A.quad(_) == LL_l16_Withdrawal(A, N) : Nat}
  %Equal.sym(Nat, VF.slen(RWA_l16_Withdrawal(U32.to_nat(N), A, 0n)), Nat.mul(U32.to_nat(N), 11n), lenW_l16_Withdrawal(U32.to_nat(N), A, 0n)) : {A.quad(_) == LL_l16_Withdrawal(A, N) : Nat}
  {==}

# encx_spec: the list's value has its bytes as one variable part, when they fit a tree of depth dx < 30.
def encx_spec_l16_Withdrawal(+A: FD.array__Tree<FuluWithdrawal_d.Withdrawal>, +N: U32, +h: {OKL_l16_Withdrawal(A, N) == True{} : Bool}, +dx: Nat, +hdx: {Nat.is_lt(dx, 30n) == True{} : Bool},
    +hL: {Nat.is_le(LL_l16_Withdrawal(A, N), A.quad(VB.pw(dx))) == True{} : Bool})
    -> {Codec.parts(VALL_l16_Withdrawal(A, N), S.ListOf{S.Container{["index", "validator_index", "address", "amount"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{20n}, S.Chain{S.Unsigned{P.U64{}}, S.End{}}}}}}, U32.to_nat(16)}) == Some{[S.Variable{ENCL_l16_Withdrawal(A, N)}]} : Maybe<&2, +List<S.Part>>}:
  +hlim = FD.logic__subst(Bool, z => {z == True{} : Bool}, U32.is_le(N, 16), Nat.is_le(U32.to_nat(N), U32.to_nat(16)), VU.le_u32(N, 16), okl_lim_l16_Withdrawal(A, N, h))
  +fit = FD.logic__subst(Nat, z => {N.fits(4n, z) == True{} : Bool}, LL_l16_Withdrawal(A, N), List.length(&2, U32, ENCL_l16_Withdrawal(A, N)), Equal.sym(Nat, List.length(&2, U32, ENCL_l16_Withdrawal(A, N)), LL_l16_Withdrawal(A, N), len_encl_l16_Withdrawal(A, N)),
    VBZ.fitq(dx, LL_l16_Withdrawal(A, N), hL, hdx))
  lpart_l16_Withdrawal(U32.to_nat(N), A, hlim, fit)

