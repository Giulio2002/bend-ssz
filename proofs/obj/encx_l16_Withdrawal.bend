# ---- l16_Withdrawal: the write loop at X = 4 q + r (record j at byte X + 44 j) ----


def AG_l16_Withdrawal(+A: FD.array__Tree<FuluWithdrawal_d.Withdrawal>, +i: U32) -> Array<FuluWithdrawal_d.Withdrawal> & FuluWithdrawal_d.Withdrawal: Array.get(FuluWithdrawal_d.Withdrawal, FD.array__thaw(FuluWithdrawal_d.Withdrawal, A), i)

# the records j, j + 1, ..., j + k of A written from byte X + 44 j on
def WX_l16_Withdrawal(k: Nat, +j: Nat, +dd: Nat, D: FD.array__Tree<U32>, +q: Nat, +r: Nat, +A: FD.array__Tree<FuluWithdrawal_d.Withdrawal>) -> FD.array__Tree<U32>:
  match k:
    case 0n: PXo_Withdrawal(EL_l16_Withdrawal(A, j), dd, D, Nat.add(Nat.mul(j, 11n), q), r)
    case 1n+p: WX_l16_Withdrawal(p, 1n+j, dd, PXo_Withdrawal(EL_l16_Withdrawal(A, j), dd, D, Nat.add(Nat.mul(j, 11n), q), r), q, r, A)

law pfWX_l16_Withdrawal:
  for +k: Nat
  for +j: Nat
  for +dd: Nat
  for +D: FD.array__Tree<U32>
  for +q: Nat
  for +r: Nat
  for +A: FD.array__Tree<FuluWithdrawal_d.Withdrawal>
  for +pf: {FD.array__perfect(U32, dd, D) == True{} : Bool}
  {FD.array__perfect(U32, dd, WX_l16_Withdrawal(k, j, dd, D, q, r, A)) == True{} : Bool}
def pfWX_l16_Withdrawal(k, j, dd, D, q, r, A, pf):
  match k:
    case 0n: pfo_Withdrawal(EL_l16_Withdrawal(A, j), dd, D, Nat.add(Nat.mul(j, 11n), q), r, pf)
    case 1n+ +p: pfWX_l16_Withdrawal(p, 1n+j, dd, PXo_Withdrawal(EL_l16_Withdrawal(A, j), dd, D, Nat.add(Nat.mul(j, 11n), q), r), q, r, A, pfo_Withdrawal(EL_l16_Withdrawal(A, j), dd, D, Nat.add(Nat.mul(j, 11n), q), r, pf))

def RTK_l16_Withdrawal(k: Nat, +i: U32, +j: Nat, +X: U32, +q: Nat, +r: Nat, +dd: Nat, +D: FD.array__Tree<U32>, +A: FD.array__Tree<FuluWithdrawal_d.Withdrawal>) -> Data:
  {Fulu_list_Withdrawal_16_e.l16_Withdrawal_pt(k, i, X, FD.array__thaw(U32, D), (FD.array__thaw(FuluWithdrawal_d.Withdrawal, A), EL_l16_Withdrawal(A, j))) == (FD.array__thaw(U32, WX_l16_Withdrawal(k, j, dd, D, q, r, A)), FD.array__thaw(FuluWithdrawal_d.Withdrawal, A)) : Array<U32> & Array<FuluWithdrawal_d.Withdrawal>}
def BYK_l16_Withdrawal(k: Nat, +j: Nat, +q: Nat, +r: Nat, +dd: Nat, +D: FD.array__Tree<U32>, +A: FD.array__Tree<FuluWithdrawal_d.Withdrawal>) -> Data:
  {UA.BYT(WX_l16_Withdrawal(k, j, dd, D, q, r, A)) == UW.SPL(UA.BYT(D), VRX.YP(j, 11n, q, r), F.flat(CHW_l16_Withdrawal(1n+k, A, j))) : +List<U32>}

# The loop from record j (index i) on, k + 1 records, into LT bytes at X whose last k + 1 records' bytes are zero.
def ptx_l16_Withdrawal(k: Nat, +i: U32, +j: Nat, +X: U32, +q: Nat, +r: Nat, +dd: Nat, +D: FD.array__Tree<U32>, +da: Nat, +A: FD.array__Tree<FuluWithdrawal_d.Withdrawal>, +LT: Nat,
    +ei: {U32.to_nat(i) == j : Nat}, +e: {U32.to_nat(X) == Nat.add(A.quad(q), r) : Nat}, +hr: {Nat.is_lt(r, 4n) == True{} : Bool}, +hd: {Nat.is_lt(dd, 29n) == True{} : Bool},
    +pfD: {FD.array__perfect(U32, dd, D) == True{} : Bool}, +hj: {Nat.is_le(A.quad(Nat.mul(Nat.add(1n+k, j), 11n)), LT) == True{} : Bool},
    +hl: {Nat.is_le(Nat.add(q, WD.NWN(Nat.add(r, LT))), VB.pw(dd)) == True{} : Bool},
    +hz: {VS.bt(A.quad(Nat.mul(1n+k, 11n)), VS.bdr(VRX.YP(j, 11n, q, r), UA.BYT(D))) == UW.ZB(A.quad(Nat.mul(1n+k, 11n))) : +List<U32>},
    +pfA: {FD.array__perfect(FuluWithdrawal_d.Withdrawal, da, A) == True{} : Bool}, +hda: {Nat.is_lt(da, 31n) == True{} : Bool}, +hk: {Nat.is_lt(Nat.add(k, j), VB.pw(da)) == True{} : Bool})
    -> DK.P2(RTK_l16_Withdrawal(k, i, j, X, q, r, dd, D, A), BYK_l16_Withdrawal(k, j, q, r, dd, D, A)):
  match k:
    case 0n:
      +o = EL_l16_Withdrawal(A, j)
      +qj = Nat.add(Nat.mul(j, 11n), q)
      +Xj = U32.add(X, U32.mul(i, 44))
      +ej = VRX.rpos(X, i, j, 0n, q, r, 11n, 44, LT, dd, e, {==}, ei, hd, hj, hl)
      +hlj = VRX.rroom(j, 0n, q, r, 11n, LT, dd, hj, hl)
      +g = putxo_Withdrawal(o, dd, D, Xj, qj, r, ej, hr, hd, hlj, pfD, hz)
      +rt = PA(RTo_Withdrawal(o, dd, D, Xj, qj, r), BYo_Withdrawal(o, dd, D, qj, r), g)
      +by = PB(RTo_Withdrawal(o, dd, D, Xj, qj, r), BYo_Withdrawal(o, dd, D, qj, r), g)
      +D1 = PXo_Withdrawal(o, dd, D, qj, r)
      +Y = F.limbs(RWD_Withdrawal(o))
      +rt0 = Equal.cong(Array<U32>, Array<U32> & Array<FuluWithdrawal_d.Withdrawal>, z => (z, FD.array__thaw(FuluWithdrawal_d.Withdrawal, A)), FuluWithdrawal_e.Withdrawal_put(FD.array__thaw(U32, D), Xj, o), FD.array__thaw(U32, D1), rt)
      +by0 = FD.logic__subst(+List<U32>, z => {UA.BYT(D1) == UW.SPL(UA.BYT(D), VRX.YP(j, 11n, q, r), z) : +List<U32>}, Y, List.append(&2, U32, Y, []),
        Equal.sym(+List<U32>, List.append(&2, U32, Y, []), Y, VS.app_nil(Y)), by)
      (rt0, by0)
    case 1n+ +p:
      +o = EL_l16_Withdrawal(A, j)
      +qj = Nat.add(Nat.mul(j, 11n), q)
      +Xj = U32.add(X, U32.mul(i, 44))
      +ej = VRX.rpos(X, i, j, 1n+p, q, r, 11n, 44, LT, dd, e, {==}, ei, hd, hj, hl)
      +hlj = VRX.rroom(j, 1n+p, q, r, 11n, LT, dd, hj, hl)
      +bm = A.quad(Nat.mul(1n+p, 11n))
      +B0 = UA.BYT(D)
      +Yj = VRX.YP(j, 11n, q, r)
      +hz0 = VRX.zhead(44n, bm, VS.bdr(Yj, B0), hz)
      +g = putxo_Withdrawal(o, dd, D, Xj, qj, r, ej, hr, hd, hlj, pfD, hz0)
      +rt = PA(RTo_Withdrawal(o, dd, D, Xj, qj, r), BYo_Withdrawal(o, dd, D, qj, r), g)
      +by = PB(RTo_Withdrawal(o, dd, D, Xj, qj, r), BYo_Withdrawal(o, dd, D, qj, r), g)
      +D1 = PXo_Withdrawal(o, dd, D, qj, r)
      +pf1 = pfo_Withdrawal(o, dd, D, qj, r, pfD)
      +Y = F.limbs(RWD_Withdrawal(o))
      +hX = VRX.xstart(qj, r, 44n, dd, D, pfD, hlj)
      +ey = VRX.ynext(j, 11n, q, r)
      +z1 = VRX.znext(B0, Yj, Y, VRX.YP(1n+j, 11n, q, r), 44n, bm, UA.BYT(D1), hX, lenb_Withdrawal(o), ey, by, hz)
      +h1 = FD.nat__le_lt_trans(1n+j, 1n+Nat.add(p, j), VB.pw(da), Order.left_below_sum(p, j), hk)
      +ei1 = VB.add_le_at(i, 1, j, da, ei, hda, FD.nat__lt_le(1n+j, VB.pw(da), h1))
      +hi1 = FD.logic__subst(Nat, z => {Nat.is_lt(z, FD.spec_common__pow2(da)) == True{} : Bool}, 1n+j, U32.to_nat(U32.add(i, 1)), Equal.sym(Nat, U32.to_nat(U32.add(i, 1)), 1n+j, ei1), h1)
      +hx = FD.logic__subst(Nat, z => {FD.spec_common__nth(FuluWithdrawal_d.Withdrawal, FD.array__slots(FuluWithdrawal_d.Withdrawal, A), z) == Some{EL_l16_Withdrawal(A, 1n+j)} : Maybe<&2, FuluWithdrawal_d.Withdrawal>}, 1n+j, U32.to_nat(U32.add(i, 1)), Equal.sym(Nat, U32.to_nat(U32.add(i, 1)), 1n+j, ei1),
        VRL.nth_get(FuluWithdrawal_d.Withdrawal, FD.array__slots(FuluWithdrawal_d.Withdrawal, A), 1n+j, FuluWithdrawal_d.Withdrawal_default(), FD.array__len_lt(FuluWithdrawal_d.Withdrawal, da, A, 1n+j, pfA, h1)))
      +eg = FD.array__get(FuluWithdrawal_d.Withdrawal, da, A, U32.add(i, 1), EL_l16_Withdrawal(A, 1n+j), VB.lt32(da, hda), hi1, hx, pfA)
      +hj2 = FD.logic__subst(Nat, z => {Nat.is_le(A.quad(Nat.mul(1n+z, 11n)), LT) == True{} : Bool}, 1n+Nat.add(p, j), Nat.add(p, 1n+j), Equal.sym(Nat, Nat.add(p, 1n+j), 1n+Nat.add(p, j), FD.nat__add_succ(p, j)), hj)
      +hk2 = FD.logic__subst(Nat, z => {Nat.is_lt(z, VB.pw(da)) == True{} : Bool}, 1n+Nat.add(p, j), Nat.add(p, 1n+j), Equal.sym(Nat, Nat.add(p, 1n+j), 1n+Nat.add(p, j), FD.nat__add_succ(p, j)), hk)
      +ih = ptx_l16_Withdrawal(p, U32.add(i, 1), 1n+j, X, q, r, dd, D1, da, A, LT, ei1, e, hr, hd, pf1, hj2, hl, z1, pfA, hda, hk2)
      +rt2 = PA(RTK_l16_Withdrawal(p, U32.add(i, 1), 1n+j, X, q, r, dd, D1, A), BYK_l16_Withdrawal(p, 1n+j, q, r, dd, D1, A), ih)
      +by2 = PB(RTK_l16_Withdrawal(p, U32.add(i, 1), 1n+j, X, q, r, dd, D1, A), BYK_l16_Withdrawal(p, 1n+j, q, r, dd, D1, A), ih)
      +ea = Equal.cong(Array<U32>, Array<U32> & Array<FuluWithdrawal_d.Withdrawal>, z => Fulu_list_Withdrawal_16_e.l16_Withdrawal_pt(p, U32.add(i, 1), X, z, AG_l16_Withdrawal(A, U32.add(i, 1))), FuluWithdrawal_e.Withdrawal_put(FD.array__thaw(U32, D), Xj, o), FD.array__thaw(U32, D1), rt)
      +eb = Equal.cong(Array<FuluWithdrawal_d.Withdrawal> & FuluWithdrawal_d.Withdrawal, Array<U32> & Array<FuluWithdrawal_d.Withdrawal>, z => Fulu_list_Withdrawal_16_e.l16_Withdrawal_pt(p, U32.add(i, 1), X, FD.array__thaw(U32, D1), z), AG_l16_Withdrawal(A, U32.add(i, 1)), (FD.array__thaw(FuluWithdrawal_d.Withdrawal, A), EL_l16_Withdrawal(A, 1n+j)), eg)
      +rt3 = Equal.trans(Array<U32> & Array<FuluWithdrawal_d.Withdrawal>, Fulu_list_Withdrawal_16_e.l16_Withdrawal_pt(p, U32.add(i, 1), X, FuluWithdrawal_e.Withdrawal_put(FD.array__thaw(U32, D), Xj, o), AG_l16_Withdrawal(A, U32.add(i, 1))), Fulu_list_Withdrawal_16_e.l16_Withdrawal_pt(p, U32.add(i, 1), X, FD.array__thaw(U32, D1), AG_l16_Withdrawal(A, U32.add(i, 1))),
        (FD.array__thaw(U32, WX_l16_Withdrawal(p, 1n+j, dd, D1, q, r, A)), FD.array__thaw(FuluWithdrawal_d.Withdrawal, A)), ea,
        Equal.trans(Array<U32> & Array<FuluWithdrawal_d.Withdrawal>, Fulu_list_Withdrawal_16_e.l16_Withdrawal_pt(p, U32.add(i, 1), X, FD.array__thaw(U32, D1), AG_l16_Withdrawal(A, U32.add(i, 1))), Fulu_list_Withdrawal_16_e.l16_Withdrawal_pt(p, U32.add(i, 1), X, FD.array__thaw(U32, D1), (FD.array__thaw(FuluWithdrawal_d.Withdrawal, A), EL_l16_Withdrawal(A, 1n+j))),
          (FD.array__thaw(U32, WX_l16_Withdrawal(p, 1n+j, dd, D1, q, r, A)), FD.array__thaw(FuluWithdrawal_d.Withdrawal, A)), eb, rt2))
      +rest = F.flat(CHW_l16_Withdrawal(1n+p, A, 1n+j))
      +eXn = Equal.trans(Nat, VRX.YP(1n+j, 11n, q, r), Nat.add(Yj, A.quad(11n)), Nat.add(Yj, VRX.LN(Y)), ey,
        Equal.cong(Nat, Nat, z => Nat.add(Yj, z), A.quad(11n), VRX.LN(Y), Equal.sym(Nat, VRX.LN(Y), A.quad(11n), lenb_Withdrawal(o))))
      +by3 = Equal.trans(+List<U32>, UA.BYT(WX_l16_Withdrawal(p, 1n+j, dd, D1, q, r, A)), UW.SPL(UA.BYT(D1), VRX.YP(1n+j, 11n, q, r), rest), UW.SPL(B0, Yj, VRX.AP(Y, rest)), by2,
        VRX.spl_catx(B0, Yj, Y, rest, VRX.YP(1n+j, 11n, q, r), UA.BYT(D1), hX, eXn, by))
      (rt3, by3)

# ---- l16_Withdrawal: the list's encoder window ----

def TDM_l16_Withdrawal(t: FD.array__Tree<FuluWithdrawal_d.Withdrawal>) -> Nat:
  match t:
    case FD.TLeaf{x}: 0n
    case FD.TNode{l, r}: 1n+TDM_l16_Withdrawal(l)

# The list object Seq{thaw(A), N} and its facts: a perfect tree of depth < 31 holding the N records,
# N within the limit 16.
def THL_l16_Withdrawal(+A: FD.array__Tree<FuluWithdrawal_d.Withdrawal>, +N: U32) -> Fulu_list_Withdrawal_16_d.l16_Withdrawal_Seq: Fulu_list_Withdrawal_16_d.l16_Withdrawal_Seq{FD.array__thaw(FuluWithdrawal_d.Withdrawal, A), N}
def OKL_l16_Withdrawal(+A: FD.array__Tree<FuluWithdrawal_d.Withdrawal>, +N: U32) -> Bool:
  Bool.and(Nat.is_lt(TDM_l16_Withdrawal(A), 31n), Bool.and(FD.array__perfect(FuluWithdrawal_d.Withdrawal, TDM_l16_Withdrawal(A), A), Bool.and(Nat.is_le(U32.to_nat(N), VB.pw(TDM_l16_Withdrawal(A))), U32.is_le(N, 16))))
def okl_d_l16_Withdrawal(+A: FD.array__Tree<FuluWithdrawal_d.Withdrawal>, +N: U32, +h: {OKL_l16_Withdrawal(A, N) == True{} : Bool}) -> {Nat.is_lt(TDM_l16_Withdrawal(A), 31n) == True{} : Bool}:
  and_l(Nat.is_lt(TDM_l16_Withdrawal(A), 31n), Bool.and(FD.array__perfect(FuluWithdrawal_d.Withdrawal, TDM_l16_Withdrawal(A), A), Bool.and(Nat.is_le(U32.to_nat(N), VB.pw(TDM_l16_Withdrawal(A))), U32.is_le(N, 16))), h)
def okl_1_l16_Withdrawal(+A: FD.array__Tree<FuluWithdrawal_d.Withdrawal>, +N: U32, +h: {OKL_l16_Withdrawal(A, N) == True{} : Bool})
    -> {Bool.and(FD.array__perfect(FuluWithdrawal_d.Withdrawal, TDM_l16_Withdrawal(A), A), Bool.and(Nat.is_le(U32.to_nat(N), VB.pw(TDM_l16_Withdrawal(A))), U32.is_le(N, 16))) == True{} : Bool}:
  and_r(Nat.is_lt(TDM_l16_Withdrawal(A), 31n), Bool.and(FD.array__perfect(FuluWithdrawal_d.Withdrawal, TDM_l16_Withdrawal(A), A), Bool.and(Nat.is_le(U32.to_nat(N), VB.pw(TDM_l16_Withdrawal(A))), U32.is_le(N, 16))), h)
def okl_pf_l16_Withdrawal(+A: FD.array__Tree<FuluWithdrawal_d.Withdrawal>, +N: U32, +h: {OKL_l16_Withdrawal(A, N) == True{} : Bool}) -> {FD.array__perfect(FuluWithdrawal_d.Withdrawal, TDM_l16_Withdrawal(A), A) == True{} : Bool}:
  and_l(FD.array__perfect(FuluWithdrawal_d.Withdrawal, TDM_l16_Withdrawal(A), A), Bool.and(Nat.is_le(U32.to_nat(N), VB.pw(TDM_l16_Withdrawal(A))), U32.is_le(N, 16)), okl_1_l16_Withdrawal(A, N, h))
def okl_2_l16_Withdrawal(+A: FD.array__Tree<FuluWithdrawal_d.Withdrawal>, +N: U32, +h: {OKL_l16_Withdrawal(A, N) == True{} : Bool}) -> {Bool.and(Nat.is_le(U32.to_nat(N), VB.pw(TDM_l16_Withdrawal(A))), U32.is_le(N, 16)) == True{} : Bool}:
  and_r(FD.array__perfect(FuluWithdrawal_d.Withdrawal, TDM_l16_Withdrawal(A), A), Bool.and(Nat.is_le(U32.to_nat(N), VB.pw(TDM_l16_Withdrawal(A))), U32.is_le(N, 16)), okl_1_l16_Withdrawal(A, N, h))
def okl_n_l16_Withdrawal(+A: FD.array__Tree<FuluWithdrawal_d.Withdrawal>, +N: U32, +h: {OKL_l16_Withdrawal(A, N) == True{} : Bool}) -> {Nat.is_le(U32.to_nat(N), VB.pw(TDM_l16_Withdrawal(A))) == True{} : Bool}:
  and_l(Nat.is_le(U32.to_nat(N), VB.pw(TDM_l16_Withdrawal(A))), U32.is_le(N, 16), okl_2_l16_Withdrawal(A, N, h))
def okl_lim_l16_Withdrawal(+A: FD.array__Tree<FuluWithdrawal_d.Withdrawal>, +N: U32, +h: {OKL_l16_Withdrawal(A, N) == True{} : Bool}) -> {U32.is_le(N, 16) == True{} : Bool}:
  and_r(Nat.is_le(U32.to_nat(N), VB.pw(TDM_l16_Withdrawal(A))), U32.is_le(N, 16), okl_2_l16_Withdrawal(A, N, h))

# N <= 2^d as the runtime compares it.
