# putx: the runtime writer at X = 4 q + r is the model PUTL, whose bytes splice the list's bytes
# into D's (its records write their data bytes only), and whose tree is perfect.
def putx_l16_Withdrawal(+A: FD.array__Tree<FuluWithdrawal_d.Withdrawal>, +N: U32, +h: {OKL_l16_Withdrawal(A, N) == True{} : Bool}, +dd: Nat, +D: FD.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat,
    +e: {U32.to_nat(X) == Nat.add(A.quad(q), r) : Nat}, +hr: {Nat.is_lt(r, 4n) == True{} : Bool}, +hd: {Nat.is_lt(dd, 29n) == True{} : Bool},
    +hl: {Nat.is_le(Nat.add(q, WD.NWN(Nat.add(r, LL_l16_Withdrawal(A, N)))), VB.pw(dd)) == True{} : Bool}, +pf: {FD.array__perfect(U32, dd, D) == True{} : Bool},
    +hz: {VS.bt(LL_l16_Withdrawal(A, N), VS.bdr(Nat.add(A.quad(q), r), UA.BYT(D))) == UW.ZB(LL_l16_Withdrawal(A, N)) : +List<U32>})
    -> DK.P2(RTL_l16_Withdrawal(A, N, dd, D, X, q, r), DK.P2(BYL_l16_Withdrawal(A, N, dd, D, q, r), PFL_l16_Withdrawal(A, N, dd, D, q, r))):
  +b = U32.is_eq(N, 0)
  +g = ptnz_l16_Withdrawal(A, N, b, {==}, h, dd, D, X, q, r, e, hr, hd, hl, pf, hz)
  +rtb = PA(RTN_l16_Withdrawal(b, A, N, dd, D, X, q, r), BYN_l16_Withdrawal(b, A, N, dd, D, q, r), g)
  +byb = PB(RTN_l16_Withdrawal(b, A, N, dd, D, X, q, r), BYN_l16_Withdrawal(b, A, N, dd, D, q, r), g)
  +by = Equal.trans(+List<U32>, UA.BYT(PUTL_l16_Withdrawal(A, N, dd, D, q, r)), UW.SPL(UA.BYT(D), Nat.add(A.quad(q), r), F.flat(CHW_l16_Withdrawal(U32.to_nat(N), A, 0n))), UW.SPL(UA.BYT(D), Nat.add(A.quad(q), r), ENCL_l16_Withdrawal(A, N)), byb,
    Equal.cong(+List<U32>, +List<U32>, z => UW.SPL(UA.BYT(D), Nat.add(A.quad(q), r), z), F.flat(CHW_l16_Withdrawal(U32.to_nat(N), A, 0n)), ENCL_l16_Withdrawal(A, N), flatW_l16_Withdrawal(U32.to_nat(N), A, 0n)))
  (putk_rt_l16_Withdrawal(A, N, h, dd, D, X, q, r, rtb), (by, pfLb_l16_Withdrawal(b, A, N, dd, D, q, r, pf)))

# ---- sizes ----

# The runtime's size pass.
