# ---- the schema, taken apart without unfolding it ----------------------------------------------

def TL0(+sv: S.Schema) -> S.Schema: SH.ProgressiveContainer_fields(sv)
def TL1(+sv: S.Schema) -> S.Schema: SH.Chain_tail(TL0(sv))
def TL2(+sv: S.Schema) -> S.Schema: SH.Chain_tail(TL1(sv))
def TL3(+sv: S.Schema) -> S.Schema: SH.Chain_tail(TL2(sv))
def HD0(+sv: S.Schema) -> S.Schema: SH.Chain_head(TL0(sv))
def HD1(+sv: S.Schema) -> S.Schema: SH.Chain_head(TL1(sv))
def HD2(+sv: S.Schema) -> S.Schema: SH.Chain_head(TL2(sv))
def isc(+sv: S.Schema, +esv: {sv == GS.ProgressiveVarTestStruct() : S.Schema}) -> {SH.is_ProgressiveContainer(sv) == True{} : Bool}:
  FD.logic__subst(S.Schema, z => {SH.is_ProgressiveContainer(z) == True{} : Bool}, GS.ProgressiveVarTestStruct(), sv, Equal.sym(S.Schema, sv, GS.ProgressiveVarTestStruct(), esv), {==})
def fsn(+sv: S.Schema, +esv: {sv == GS.ProgressiveVarTestStruct() : S.Schema}) -> {SS.fixed_size(SH.ProgressiveContainer_fields(sv)) == None{} : Maybe<&2, Nat>}:
  FD.logic__subst(S.Schema, z => {SS.fixed_size(SH.ProgressiveContainer_fields(z)) == None{} : Maybe<&2, Nat>}, GS.ProgressiveVarTestStruct(), sv, Equal.sym(S.Schema, sv, GS.ProgressiveVarTestStruct(), esv), {==})
def es0(+sv: S.Schema, +esv: {sv == GS.ProgressiveVarTestStruct() : S.Schema}) -> {HD0(sv) == S.Unsigned{P.U8{}} : S.Schema}:
  FD.logic__subst(S.Schema, z => {HD0(z) == S.Unsigned{P.U8{}} : S.Schema}, GS.ProgressiveVarTestStruct(), sv, Equal.sym(S.Schema, sv, GS.ProgressiveVarTestStruct(), esv), {==})
def isch0(+sv: S.Schema, +esv: {sv == GS.ProgressiveVarTestStruct() : S.Schema}) -> {SH.is_Chain(TL0(sv)) == True{} : Bool}:
  FD.logic__subst(S.Schema, z => {SH.is_Chain(TL0(z)) == True{} : Bool}, GS.ProgressiveVarTestStruct(), sv, Equal.sym(S.Schema, sv, GS.ProgressiveVarTestStruct(), esv), {==})
def es1(+sv: S.Schema, +esv: {sv == GS.ProgressiveVarTestStruct() : S.Schema}) -> {HD1(sv) == S.ListOf{S.Unsigned{P.U16{}}, 123n} : S.Schema}:
  FD.logic__subst(S.Schema, z => {HD1(z) == S.ListOf{S.Unsigned{P.U16{}}, 123n} : S.Schema}, GS.ProgressiveVarTestStruct(), sv, Equal.sym(S.Schema, sv, GS.ProgressiveVarTestStruct(), esv), {==})
def isch1(+sv: S.Schema, +esv: {sv == GS.ProgressiveVarTestStruct() : S.Schema}) -> {SH.is_Chain(TL1(sv)) == True{} : Bool}:
  FD.logic__subst(S.Schema, z => {SH.is_Chain(TL1(z)) == True{} : Bool}, GS.ProgressiveVarTestStruct(), sv, Equal.sym(S.Schema, sv, GS.ProgressiveVarTestStruct(), esv), {==})
def es2(+sv: S.Schema, +esv: {sv == GS.ProgressiveVarTestStruct() : S.Schema}) -> {HD2(sv) == S.ProgressiveBits{} : S.Schema}:
  FD.logic__subst(S.Schema, z => {HD2(z) == S.ProgressiveBits{} : S.Schema}, GS.ProgressiveVarTestStruct(), sv, Equal.sym(S.Schema, sv, GS.ProgressiveVarTestStruct(), esv), {==})
def isch2(+sv: S.Schema, +esv: {sv == GS.ProgressiveVarTestStruct() : S.Schema}) -> {SH.is_Chain(TL2(sv)) == True{} : Bool}:
  FD.logic__subst(S.Schema, z => {SH.is_Chain(TL2(z)) == True{} : Bool}, GS.ProgressiveVarTestStruct(), sv, Equal.sym(S.Schema, sv, GS.ProgressiveVarTestStruct(), esv), {==})
def isend(+sv: S.Schema, +esv: {sv == GS.ProgressiveVarTestStruct() : S.Schema}) -> {SH.is_End(TL3(sv)) == True{} : Bool}:
  FD.logic__subst(S.Schema, z => {SH.is_End(TL3(z)) == True{} : Bool}, GS.ProgressiveVarTestStruct(), sv, Equal.sym(S.Schema, sv, GS.ProgressiveVarTestStruct(), esv), {==})
def CHS3(+sv: S.Schema) -> S.Schema: S.End{}
def CHS2(+sv: S.Schema) -> S.Schema: S.Chain{HD2(sv), CHS3(sv)}
def CHS1(+sv: S.Schema) -> S.Schema: S.Chain{HD1(sv), CHS2(sv)}
def CHS0(+sv: S.Schema) -> S.Schema: S.Chain{HD0(sv), CHS1(sv)}
def fe3(+sv: S.Schema, +esv: {sv == GS.ProgressiveVarTestStruct() : S.Schema}) -> {TL3(sv) == S.End{} : S.Schema}: SH.End_shape(TL3(sv), isend(sv, esv))
def fe2(+sv: S.Schema, +esv: {sv == GS.ProgressiveVarTestStruct() : S.Schema}) -> {TL2(sv) == CHS2(sv) : S.Schema}:
  Equal.trans(S.Schema, TL2(sv), S.Chain{HD2(sv), TL3(sv)}, CHS2(sv), SH.Chain_shape(TL2(sv), isch2(sv, esv)),
    Equal.cong(S.Schema, S.Schema, z => S.Chain{HD2(sv), z}, TL3(sv), CHS3(sv), fe3(sv, esv)))
def fe1(+sv: S.Schema, +esv: {sv == GS.ProgressiveVarTestStruct() : S.Schema}) -> {TL1(sv) == CHS1(sv) : S.Schema}:
  Equal.trans(S.Schema, TL1(sv), S.Chain{HD1(sv), TL2(sv)}, CHS1(sv), SH.Chain_shape(TL1(sv), isch1(sv, esv)),
    Equal.cong(S.Schema, S.Schema, z => S.Chain{HD1(sv), z}, TL2(sv), CHS2(sv), fe2(sv, esv)))
def fe0(+sv: S.Schema, +esv: {sv == GS.ProgressiveVarTestStruct() : S.Schema}) -> {TL0(sv) == CHS0(sv) : S.Schema}:
  Equal.trans(S.Schema, TL0(sv), S.Chain{HD0(sv), TL1(sv)}, CHS0(sv), SH.Chain_shape(TL0(sv), isch0(sv, esv)),
    Equal.cong(S.Schema, S.Schema, z => S.Chain{HD0(sv), z}, TL1(sv), CHS1(sv), fe1(sv, esv)))

