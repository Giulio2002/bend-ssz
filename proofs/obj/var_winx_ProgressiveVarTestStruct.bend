def RST0(+t: FD.array__Tree<U32>, +x: Nat, +len: U32) -> +List<S.Part>: Con{S.Variable{UW.WX(t, XJ0(t, x), U32.to_nat(LJ0(t, x)))}, RST1(t, x, len)}
def ITS3(+t: FD.array__Tree<U32>, +x: Nat, +len: U32) -> S.Value: S.EmptyItems{}
def ITS2(+t: FD.array__Tree<U32>, +x: Nat, +len: U32) -> S.Value: S.Items{CH1.VALw(t, XJ1(t, x), LJ1(t, x, len)), ITS3(t, x, len)}
def ITS1(+t: FD.array__Tree<U32>, +x: Nat, +len: U32) -> S.Value: S.Items{CH0.VALw(t, XJ0(t, x), LJ0(t, x)), ITS2(t, x, len)}
