def rdFD(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +hwN: {Nat.is_le(Nat.add(x, U32.to_nat(len)), U32.to_nat(VB.NMAX())) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hF: {Nat.is_le(U32.to_nat(9), U32.to_nat(len)) == True{} : Bool}, +c: U32, +k: Nat, +ec: {U32.to_nat(c) == k : Nat}, +hk: {Nat.is_le(Nat.add(k, 4n), U32.to_nat(9)) == True{} : Bool})
    -> {B.read32(BF(t, n), U32.add(off, c)) == (BF(t, n), UR.RWN(t, Nat.add(k, x))) : B.Buf & U32}:
  UR.rwx(d, t, n, U32.add(off, c), Nat.add(k, x), eocD(d, t, n, x, off, len, eo, hd, hw, hwN, pf, hF, c, k, ec, FD.nat__le_trans(k, Nat.add(k, 4n), U32.to_nat(9), Order.below_sum(k, 4n), hk)),
    hd, pf, roomFD(d, t, n, x, off, len, eo, hd, hw, hwN, pf, hF, k, 4n, hk))

# The four window bytes at k are the limbs of the word at x + k.
def wbk(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +hwN: {Nat.is_le(Nat.add(x, U32.to_nat(len)), U32.to_nat(VB.NMAX())) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +k: Nat, +L2: Nat, +el: {U32.to_nat(len) == Nat.add(k, 4n+L2) : Nat},
    +hk: {Nat.is_le(Nat.add(Nat.add(k, x), 4n), A.quad(VB.pw(d))) == True{} : Bool})
    -> {VS.bt(4n, VS.bdr(k, UW.WX(t, x, U32.to_nat(len)))) == F.limbs([UR.RWN(t, Nat.add(k, x))]) : +List<U32>}:
  %Equal.sym(Nat, U32.to_nat(len), Nat.add(k, 4n+L2), el) : {VS.bt(4n, VS.bdr(k, UW.WX(t, x, _))) == F.limbs([UR.RWN(t, Nat.add(k, x))]) : +List<U32>}
  VRC.wbytes(d, t, x, k, L2, pf, hk)

# The offset word at k: its limbs are the digits the layout puts there.
def offw(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +hwN: {Nat.is_le(Nat.add(x, U32.to_nat(len)), U32.to_nat(VB.NMAX())) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +k: Nat, +L2: Nat, +v: Nat, +el: {U32.to_nat(len) == Nat.add(k, 4n+L2) : Nat}, +hv: {Nat.is_le(v, U32.to_nat(len)) == True{} : Bool},
    +eb: {VS.bt(4n, VS.bdr(k, UW.WX(t, x, U32.to_nat(len)))) == N.digits(4n, v) : +List<U32>})
    -> {U32.to_nat(UR.RWN(t, Nat.add(k, x))) == v : Nat}:
  +hl = FD.logic__subst(Nat, z => {Nat.is_le(Nat.add(x, z), A.quad(VB.pw(d))) == True{} : Bool}, U32.to_nat(len), Nat.add(k, 4n+L2), el, hw)
  +le0 = Order.add_left(k, Nat.add(x, 4n), Nat.add(x, 4n+L2), Order.add_left(x, 4n, 4n+L2, Order.below_sum(4n, L2)))
  +le1 = FD.logic__subst(Nat, z => {Nat.is_le(z, Nat.add(k, Nat.add(x, 4n+L2))) == True{} : Bool}, Nat.add(k, Nat.add(x, 4n)), Nat.add(Nat.add(k, x), 4n),
    Equal.sym(Nat, Nat.add(Nat.add(k, x), 4n), Nat.add(k, Nat.add(x, 4n)), FD.nat__add_assoc(k, x, 4n)), le0)
  +le2 = FD.logic__subst(Nat, z => {Nat.is_le(Nat.add(Nat.add(k, x), 4n), z) == True{} : Bool}, Nat.add(k, Nat.add(x, 4n+L2)), Nat.add(x, Nat.add(k, 4n+L2)),
    Equal.sym(Nat, Nat.add(x, Nat.add(k, 4n+L2)), Nat.add(k, Nat.add(x, 4n+L2)), FD.lru_nat_algebra__add_swap(x, k, 4n+L2)), le1)
  +hk = FD.nat__le_trans(Nat.add(Nat.add(k, x), 4n), Nat.add(x, Nat.add(k, 4n+L2)), A.quad(VB.pw(d)), le2, hl)
  VG.digits_word(UR.RWN(t, Nat.add(k, x)), v, VFT.fits4lt(v, VB.le_n_lt32(v, len, hv)),
    Equal.trans(+List<U32>, F.limbs([UR.RWN(t, Nat.add(k, x))]), VS.bt(4n, VS.bdr(k, UW.WX(t, x, U32.to_nat(len)))), N.digits(4n, v),
      Equal.sym(+List<U32>, VS.bt(4n, VS.bdr(k, UW.WX(t, x, U32.to_nat(len)))), F.limbs([UR.RWN(t, Nat.add(k, x))]), wbk(d, t, n, x, off, len, eo, hd, hw, hwN, pf, k, L2, el, hk)),
      eb))

# ---- positions as x + c (a literal second argument never unfolds) --------------------------------

def eocXD(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +hwN: {Nat.is_le(Nat.add(x, U32.to_nat(len)), U32.to_nat(VB.NMAX())) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hF: {Nat.is_le(U32.to_nat(9), U32.to_nat(len)) == True{} : Bool}, +c: U32, +k: Nat, +ec: {U32.to_nat(c) == k : Nat}, +hk: {Nat.is_le(k, U32.to_nat(9)) == True{} : Bool})
    -> {U32.to_nat(U32.add(off, c)) == Nat.add(x, k) : Nat}:
  Equal.trans(Nat, U32.to_nat(U32.add(off, c)), Nat.add(k, x), Nat.add(x, k), eocD(d, t, n, x, off, len, eo, hd, hw, hwN, pf, hF, c, k, ec, hk), FD.nat__add_comm(k, x))

def roomFXD(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +hwN: {Nat.is_le(Nat.add(x, U32.to_nat(len)), U32.to_nat(VB.NMAX())) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hF: {Nat.is_le(U32.to_nat(9), U32.to_nat(len)) == True{} : Bool}, +c: Nat, +s: Nat, +hc: {Nat.is_le(Nat.add(c, s), U32.to_nat(9)) == True{} : Bool})
    -> {Nat.is_le(Nat.add(Nat.add(x, c), s), A.quad(VB.pw(d))) == True{} : Bool}:
  FD.logic__subst(Nat, z => {Nat.is_le(Nat.add(z, s), A.quad(VB.pw(d))) == True{} : Bool}, Nat.add(c, x), Nat.add(x, c), FD.nat__add_comm(c, x), roomFD(d, t, n, x, off, len, eo, hd, hw, hwN, pf, hF, c, s, hc))

def rdFXD(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +hwN: {Nat.is_le(Nat.add(x, U32.to_nat(len)), U32.to_nat(VB.NMAX())) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hF: {Nat.is_le(U32.to_nat(9), U32.to_nat(len)) == True{} : Bool}, +c: U32, +k: Nat, +ec: {U32.to_nat(c) == k : Nat}, +hk: {Nat.is_le(Nat.add(k, 4n), U32.to_nat(9)) == True{} : Bool})
    -> {B.read32(BF(t, n), U32.add(off, c)) == (BF(t, n), UR.RWN(t, Nat.add(x, k))) : B.Buf & U32}:
  FD.logic__subst(Nat, z => {B.read32(BF(t, n), U32.add(off, c)) == (BF(t, n), UR.RWN(t, z)) : B.Buf & U32}, Nat.add(k, x), Nat.add(x, k), FD.nat__add_comm(k, x), rdFD(d, t, n, x, off, len, eo, hd, hw, hwN, pf, hF, c, k, ec, hk))

def splitX(+t: FD.array__Tree<U32>, +x: Nat, +c: Nat, +s: Nat, +r: Nat)
    -> {UW.WX(t, Nat.add(x, c), Nat.add(s, r)) == List.append(&2, U32, UW.WX(t, Nat.add(x, c), s), UW.WX(t, Nat.add(x, Nat.add(c, s)), r)) : +List<U32>}:
  +e = Equal.trans(Nat, Nat.add(s, Nat.add(x, c)), Nat.add(x, Nat.add(s, c)), Nat.add(x, Nat.add(c, s)), FD.lru_nat_algebra__add_swap(s, x, c),
    Equal.cong(Nat, Nat, z => Nat.add(x, z), Nat.add(s, c), Nat.add(c, s), FD.nat__add_comm(s, c)))
  FD.logic__subst(Nat, z => {UW.WX(t, Nat.add(x, c), Nat.add(s, r)) == List.append(&2, U32, UW.WX(t, Nat.add(x, c), s), UW.WX(t, z, r)) : +List<U32>}, Nat.add(s, Nat.add(x, c)), Nat.add(x, Nat.add(c, s)), e,
    UW.splitWX(t, Nat.add(x, c), s, r))

def splitXe(+t: FD.array__Tree<U32>, +x: Nat, +c: Nat, +s: Nat, +r: Nat, +T: Nat, +c2: Nat, +eT: {Nat.add(s, r) == T : Nat}, +e2: {Nat.add(c, s) == c2 : Nat})
    -> {UW.WX(t, Nat.add(x, c), T) == List.append(&2, U32, UW.WX(t, Nat.add(x, c), s), UW.WX(t, Nat.add(x, c2), r)) : +List<U32>}:
  %eT : {UW.WX(t, Nat.add(x, c), _) == List.append(&2, U32, UW.WX(t, Nat.add(x, c), s), UW.WX(t, Nat.add(x, c2), r)) : +List<U32>}
  %e2 : {UW.WX(t, Nat.add(x, c), Nat.add(s, r)) == List.append(&2, U32, UW.WX(t, Nat.add(x, c), s), UW.WX(t, Nat.add(x, _), r)) : +List<U32>}
  splitX(t, x, c, s, r)

def splitR(+t: FD.array__Tree<U32>, +x: Nat, +s: Nat, +r: Nat)
    -> {UW.WX(t, x, Nat.add(s, r)) == List.append(&2, U32, UW.WX(t, x, s), UW.WX(t, Nat.add(x, s), r)) : +List<U32>}:
  FD.logic__subst(Nat, z => {UW.WX(t, x, Nat.add(s, r)) == List.append(&2, U32, UW.WX(t, x, s), UW.WX(t, z, r)) : +List<U32>}, Nat.add(s, x), Nat.add(x, s), FD.nat__add_comm(s, x), UW.splitWX(t, x, s, r))

def subX(+t: FD.array__Tree<U32>, +x: Nat, +k: Nat, +m: Nat, +L: Nat, +hl: {Nat.is_le(Nat.add(k, m), L) == True{} : Bool})
    -> {VS.bt(m, VS.bdr(k, UW.WX(t, x, L))) == UW.WX(t, Nat.add(x, k), m) : +List<U32>}:
  FD.logic__subst(Nat, z => {VS.bt(m, VS.bdr(k, UW.WX(t, x, L))) == UW.WX(t, z, m) : +List<U32>}, Nat.add(k, x), Nat.add(x, k), FD.nat__add_comm(k, x), UW.subWX(t, x, k, m, L, hl))

# The window's k .. k + s (k + s <= len) at x + k.
def room4(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +hwN: {Nat.is_le(Nat.add(x, U32.to_nat(len)), U32.to_nat(VB.NMAX())) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +k: Nat, +s: Nat, +hk: {Nat.is_le(Nat.add(k, s), U32.to_nat(len)) == True{} : Bool})
    -> {Nat.is_le(Nat.add(Nat.add(x, k), s), A.quad(VB.pw(d))) == True{} : Bool}:
  FD.logic__subst(Nat, z => {Nat.is_le(z, A.quad(VB.pw(d))) == True{} : Bool}, Nat.add(x, Nat.add(k, s)), Nat.add(Nat.add(x, k), s),
    Equal.sym(Nat, Nat.add(Nat.add(x, k), s), Nat.add(x, Nat.add(k, s)), FD.nat__add_assoc(x, k, s)),
    FD.nat__le_trans(Nat.add(x, Nat.add(k, s)), Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d)), Order.add_left(x, Nat.add(k, s), U32.to_nat(len), hk), hw))

# The offset word at k: its limbs are the digits the layout puts there.
def offwX(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +hwN: {Nat.is_le(Nat.add(x, U32.to_nat(len)), U32.to_nat(VB.NMAX())) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +k: Nat, +v: Nat, +hk: {Nat.is_le(Nat.add(k, 4n), U32.to_nat(len)) == True{} : Bool}, +hv: {Nat.is_le(v, U32.to_nat(len)) == True{} : Bool},
    +eb: {VS.bt(4n, VS.bdr(k, UW.WX(t, x, U32.to_nat(len)))) == N.digits(4n, v) : +List<U32>})
    -> {U32.to_nat(UR.RWN(t, Nat.add(x, k))) == v : Nat}:
  +P = Nat.add(x, k)
  VG.digits_word(UR.RWN(t, P), v, VFT.fits4lt(v, VB.le_n_lt32(v, len, hv)),
    Equal.trans(+List<U32>, F.limbs([UR.RWN(t, P)]), UW.WX(t, P, 4n), N.digits(4n, v), UR.rwn_bytes(d, t, P, pf, room4(d, t, n, x, off, len, eo, hd, hw, hwN, pf, k, 4n, hk)),
      Equal.trans(+List<U32>, UW.WX(t, P, 4n), VS.bt(4n, VS.bdr(k, UW.WX(t, x, U32.to_nat(len)))), N.digits(4n, v),
        Equal.sym(+List<U32>, VS.bt(4n, VS.bdr(k, UW.WX(t, x, U32.to_nat(len)))), UW.WX(t, P, 4n), subX(t, x, k, 4n, U32.to_nat(len), hk)), eb)))
# the widths from part k on
def WSS3() -> +List<Maybe<&2, Nat>>: Nil{}
def WSS2() -> +List<Maybe<&2, Nat>>: Con{None{}, WSS3()}
def WSS1() -> +List<Maybe<&2, Nat>>: Con{None{}, WSS2()}
def WSS0() -> +List<Maybe<&2, Nat>>: Con{Some{1n}, WSS1()}
# their sums: the fixed region from part k on
def wf3() -> {LY.WFS(WSS3()) == U32.to_nat(0) : Nat}: {==}
def wf2() -> {LY.WFS(WSS2()) == U32.to_nat(4) : Nat}:
  Equal.trans(Nat, LY.WFS(WSS2()), Nat.add(4n, U32.to_nat(0)), U32.to_nat(4), VA.wfs_c(None{}, WSS3(), 4n, U32.to_nat(0), {==}, wf3()),
    VA.stpL(4, 0, 4, 4n, {==}, {==}, {==}))
def wf1() -> {LY.WFS(WSS1()) == U32.to_nat(8) : Nat}:
  Equal.trans(Nat, LY.WFS(WSS1()), Nat.add(4n, U32.to_nat(4)), U32.to_nat(8), VA.wfs_c(None{}, WSS2(), 4n, U32.to_nat(4), {==}, wf2()),
    VA.stpL(4, 4, 8, 4n, {==}, {==}, {==}))
def wf0() -> {LY.WFS(WSS0()) == U32.to_nat(9) : Nat}:
  Equal.trans(Nat, LY.WFS(WSS0()), Nat.add(1n, U32.to_nat(8)), U32.to_nat(9), VA.wfs_c(Some{1n}, WSS1(), 1n, U32.to_nat(8), {==}, wf1()),
    VA.stpL(1, 8, 9, 1n, {==}, {==}, {==}))
# the positions: part i at c_i (the widths before it summed)
def wp1_1() -> {LY.WPOS(WSS1(), 0n) == U32.to_nat(0) : Nat}: VA.wpos_0(WSS1())
def wp1_0() -> {LY.WPOS(WSS0(), 1n) == U32.to_nat(1) : Nat}:
  Equal.trans(Nat, LY.WPOS(WSS0(), 1n), Nat.add(1n, U32.to_nat(0)), U32.to_nat(1), VA.wpos_c(Some{1n}, WSS1(), 0n, 1n, U32.to_nat(0), {==}, wp1_1()),
    VA.stpL(1, 0, 1, 1n, {==}, {==}, {==}))
def wp2_2() -> {LY.WPOS(WSS2(), 0n) == U32.to_nat(0) : Nat}: VA.wpos_0(WSS2())
def wp2_1() -> {LY.WPOS(WSS1(), 1n) == U32.to_nat(4) : Nat}:
  Equal.trans(Nat, LY.WPOS(WSS1(), 1n), Nat.add(4n, U32.to_nat(0)), U32.to_nat(4), VA.wpos_c(None{}, WSS2(), 0n, 4n, U32.to_nat(0), {==}, wp2_2()),
    VA.stpL(4, 0, 4, 4n, {==}, {==}, {==}))
def wp2_0() -> {LY.WPOS(WSS0(), 2n) == U32.to_nat(5) : Nat}:
  Equal.trans(Nat, LY.WPOS(WSS0(), 2n), Nat.add(1n, U32.to_nat(4)), U32.to_nat(5), VA.wpos_c(Some{1n}, WSS1(), 1n, 1n, U32.to_nat(4), {==}, wp2_1()),
    VA.stpL(1, 4, 5, 1n, {==}, {==}, {==}))
def kk0(+t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32, +h: {CHKw(t, x, off, len) == True{} : Bool}) -> {K0(t, x, off, len) == True{} : Bool}: h
def kk1(+t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32, +h: {CHKw(t, x, off, len) == True{} : Bool}) -> {K1(t, x, off, len) == True{} : Bool}: and_r(IT0(t, x, off, len), K1(t, x, off, len), kk0(t, x, off, len, h))
def kk2(+t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32, +h: {CHKw(t, x, off, len) == True{} : Bool}) -> {K2(t, x, off, len) == True{} : Bool}: and_r(IT1(t, x, off, len), K2(t, x, off, len), kk1(t, x, off, len, h))
def kk3(+t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32, +h: {CHKw(t, x, off, len) == True{} : Bool}) -> {K3(t, x, off, len) == True{} : Bool}: and_r(IT2(t, x, off, len), K3(t, x, off, len), kk2(t, x, off, len, h))
def kk4(+t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32, +h: {CHKw(t, x, off, len) == True{} : Bool}) -> {K4(t, x, off, len) == True{} : Bool}: and_r(IT3(t, x, off, len), K4(t, x, off, len), kk3(t, x, off, len, h))
def it0(+t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32, +h: {CHKw(t, x, off, len) == True{} : Bool}) -> {IT0(t, x, off, len) == True{} : Bool}: and_l(IT0(t, x, off, len), K1(t, x, off, len), kk0(t, x, off, len, h))
def it1(+t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32, +h: {CHKw(t, x, off, len) == True{} : Bool}) -> {IT1(t, x, off, len) == True{} : Bool}: and_l(IT1(t, x, off, len), K2(t, x, off, len), kk1(t, x, off, len, h))
def it2(+t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32, +h: {CHKw(t, x, off, len) == True{} : Bool}) -> {IT2(t, x, off, len) == True{} : Bool}: and_l(IT2(t, x, off, len), K3(t, x, off, len), kk2(t, x, off, len, h))
def it3(+t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32, +h: {CHKw(t, x, off, len) == True{} : Bool}) -> {IT3(t, x, off, len) == True{} : Bool}: and_l(IT3(t, x, off, len), K4(t, x, off, len), kk3(t, x, off, len, h))
def it4(+t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32, +h: {CHKw(t, x, off, len) == True{} : Bool}) -> {IT4(t, x, off, len) == True{} : Bool}: kk4(t, x, off, len, h)
