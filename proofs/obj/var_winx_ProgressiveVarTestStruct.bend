def PFX3(+xs0: +List<U32>, +y0: +List<U32>, +y1: +List<U32>, +m: Maybe<&2, +List<S.Part>>) -> Maybe<&2, +List<S.Part>>: Codec.concatenate(Some{[S.Fixed{xs0}]}, Codec.concatenate(Some{[S.Variable{y0}]}, Codec.concatenate(Some{[S.Variable{y1}]}, m)))

