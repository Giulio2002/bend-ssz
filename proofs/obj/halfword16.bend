  %Equal.sym(U32, U32.and(O.shr_bytes(O.merge_word(old, v, 0, 2), 2), 65535), lo16(O.shr_bytes(O.merge_word(old, v, 0, 2), 2)), and16(O.shr_bytes(O.merge_word(old, v, 0, 2), 2))) : {_ == U32.and(O.shr_bytes(old, 2), 65535) : U32}
