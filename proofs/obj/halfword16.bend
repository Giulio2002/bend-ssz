def hw16_rw_0_0(+old: U32, +v: U32) -> {U32.and(O.shr_bytes(O.merge_word(old, v, 0, 2), 0), 65535) == U32.and(v, 65535) : U32}:
  %Equal.sym(U32, U32.and(O.shr_bytes(O.merge_word(old, v, 0, 2), 0), 65535), lo16(O.shr_bytes(O.merge_word(old, v, 0, 2), 0)), and16(O.shr_bytes(O.merge_word(old, v, 0, 2), 0))) : {_ == U32.and(v, 65535) : U32}
  %Equal.sym(U32, U32.and(v, 65535), lo16(v), and16(v)) : {lo16(O.shr_bytes(O.merge_word(old, v, 0, 2), 0)) == _ : U32}
  hw16_go_0_0(old, v)

def hw16_go_0_2(+old: U32, +v: U32) -> {lo16(O.shr_bytes(U32.or(U32.and(old, U32.not(O.mask_at(0, 2))), U32.and(v, O.mask_at(0, 2))), 2)) == lo16(O.shr_bytes(old, 2)) : U32}:
