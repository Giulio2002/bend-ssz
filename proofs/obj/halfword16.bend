def hw16_rw_2_0(+old: U32, +v: U32) -> {U32.and(O.shr_bytes(O.merge_word(old, v, 2, 2), 0), 65535) == U32.and(O.shr_bytes(old, 0), 65535) : U32}:
  %Equal.sym(U32, U32.and(O.shr_bytes(O.merge_word(old, v, 2, 2), 0), 65535), lo16(O.shr_bytes(O.merge_word(old, v, 2, 2), 0)), and16(O.shr_bytes(O.merge_word(old, v, 2, 2), 0))) : {_ == U32.and(O.shr_bytes(old, 0), 65535) : U32}
  %Equal.sym(U32, U32.and(O.shr_bytes(old, 0), 65535), lo16(O.shr_bytes(old, 0)), and16(O.shr_bytes(old, 0))) : {lo16(O.shr_bytes(O.merge_word(old, v, 2, 2), 0)) == _ : U32}
  %Equal.sym(U32, U32.mul(v, 65536), U32.shln(v, 16n), WM.mul65536(v)) : {lo16(O.shr_bytes(U32.or(U32.and(old, U32.not(O.mask_at(2, 2))), U32.and(_, O.mask_at(2, 2))), 0)) == lo16(O.shr_bytes(old, 0)) : U32}
  hw16_go_2_0(old, v)

