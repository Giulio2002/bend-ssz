          FD.logic__subst(+List<U32>, z => {Codec.parts(S.Sequence{S.Items{S.Sequence{AV.ch8(VS.wtake(264n, UW.SLW(t)))}, S.Items{RVW_DepositData(a1), S.EmptyItems{}}}}, Spec.Schema56()) == Some{[S.Fixed{z}]} : Maybe<&2, +List<S.Part>>}, F.flat([VS.wtake(264n, UW.SLW(t)), RWD_DepositData(a1)]), VCN.CAT([VCN.PC(1056n, VS.bt(1056n, F.limbs(UW.SLW(t)))), VCN.PC(184n, F.limbs(RWD_DepositData(a1)))]), ef,
            F.aggregate_fixed(Codec.parts(S.Items{S.Sequence{AV.ch8(VS.wtake(264n, UW.SLW(t)))}, S.Items{RVW_DepositData(a1), S.EmptyItems{}}}, S.Chain{Spec.Schema55(), S.Chain{Spec.Schema54(), S.End{}}}), [VS.wtake(264n, UW.SLW(t)), RWD_DepositData(a1)], 1240n,
