    case M_Deposit{+a0, +a1}:
      match a0:
        case WMr{+t, +n}:
          FD.logic__subst(U32, z => DK.P2(RTEn(t, z, a1, dd, D, X, q, r), BYE1(t, a1, dd, D, q, r)), 1056, n, Equal.sym(U32, n, 1056, okw_n(t, n, h)),
