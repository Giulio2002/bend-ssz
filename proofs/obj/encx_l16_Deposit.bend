          +eB = Equal.cong(+List<U32>, +List<U32>, z => List.append(&2, U32, VCN.PC(1056n, VS.bt(1056n, F.limbs(UW.SLW(t)))), List.append(&2, U32, z, [])), F.limbs(RWD_DepositData(a1)), VCN.PC(184n, F.limbs(RWD_DepositData(a1))),
            Equal.sym(+List<U32>, VCN.PC(184n, F.limbs(RWD_DepositData(a1))), F.limbs(RWD_DepositData(a1)), VCN.pc_id(184n, F.limbs(RWD_DepositData(a1)), lenb_DepositData(a1))))
          +ef = Equal.trans(+List<U32>, F.flat([VS.wtake(264n, UW.SLW(t)), RWD_DepositData(a1)]), List.append(&2, U32, VCN.PC(1056n, VS.bt(1056n, F.limbs(UW.SLW(t)))), List.append(&2, U32, F.limbs(RWD_DepositData(a1)), [])), VCN.CAT([VCN.PC(1056n, VS.bt(1056n, F.limbs(UW.SLW(t)))), VCN.PC(184n, F.limbs(RWD_DepositData(a1)))]), eA, eB)
