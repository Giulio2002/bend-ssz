def PXEm(+m: MB<M_Deposit>, +dd: Nat, +D: FD.array__Tree<U32>, +q: Nat, +r: Nat) -> FD.array__Tree<U32>:
  match m:
    case MNone{}: D
    case MSome{+v}: PXE(v, dd, D, q, r)
def YEm(+m: MB<M_Deposit>) -> +List<U32>:
  match m:
    case MNone{}: UW.ZB(1240n)
    case MSome{+v}: YE(v)
def pfEm(+m: MB<M_Deposit>, +dd: Nat, +D: FD.array__Tree<U32>, +q: Nat, +r: Nat, +pf: {FD.array__perfect(U32, dd, D) == True{} : Bool})
    -> {FD.array__perfect(U32, dd, PXEm(m, dd, D, q, r)) == True{} : Bool}:
  match m:
    case MNone{}: pf
    case MSome{+v}: pfE(v, dd, D, q, r, pf)
def lenEz(+m: MB<M_Deposit>) -> {VRX.LN(YEm(m)) == 1240n : Nat}:
  match m:
    case MNone{}: {==}
    case MSome{+v}: lenE0(v)
def lenEm(+m: MB<M_Deposit>, +h: {EOK(m) == True{} : Bool}) -> {VRX.LN(YEm(m)) == 1240n : Nat}: lenEz(m)
def RTEm(+m: MB<M_Deposit>, +dd: Nat, +D: FD.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat) -> Data:
  {FuluDeposit_e.Deposit_bx_put(FD.array__thaw(U32, D), X, th_Deposit_bx(m)) == (FD.array__thaw(U32, PXEm(m, dd, D, q, r)), th_Deposit_bx(m)) : Array<U32> & O.Boxed<FuluDeposit_d.Deposit>}
def BYEm(+m: MB<M_Deposit>, +dd: Nat, +D: FD.array__Tree<U32>, +q: Nat, +r: Nat) -> Data:
  {UA.BYT(PXEm(m, dd, D, q, r)) == UW.SPL(UA.BYT(D), Nat.add(A.quad(q), r), YEm(m)) : +List<U32>}
def mkEm(+m: MB<M_Deposit>, +dd: Nat, +D: FD.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat, +a: RTEm(m, dd, D, X, q, r), +b: BYEm(m, dd, D, q, r)) -> DK.P2(RTEm(m, dd, D, X, q, r), BYEm(m, dd, D, q, r)):
  (a, b)
def putxEmW(+m: MB<M_Deposit>, +h: {EOK(m) == True{} : Bool}, +dd: Nat, +D: FD.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat,
    +e: {U32.to_nat(X) == Nat.add(A.quad(q), r) : Nat}, +hr: {Nat.is_lt(r, 4n) == True{} : Bool}, +hd: {Nat.is_lt(dd, 31n) == True{} : Bool},
    +hl: {Nat.is_le(Nat.add(q, WD.NWN(Nat.add(r, 1240n))), VB.pw(dd)) == True{} : Bool}, +hl32: {Nat.is_lt(Nat.add(A.quad(q), Nat.add(r, 1240n)), FD.spec_common__pow2(32n)) == True{} : Bool}, +pf: {FD.array__perfect(U32, dd, D) == True{} : Bool},
    +hz: {VS.bt(1240n, VS.bdr(Nat.add(A.quad(q), r), UA.BYT(D))) == UW.ZB(1240n) : +List<U32>})
    -> DK.P2(RTEm(m, dd, D, X, q, r), BYEm(m, dd, D, q, r)):
  match m:
    case MNone{}: Empty.absurd(DK.P2(RTEm(MNone{}, dd, D, X, q, r), BYEm(MNone{}, dd, D, q, r)), FD.logic__false_true(h))
    case MSome{+v}:
      +g = putxEW(v, h, dd, D, X, q, r, e, hr, hd, hl, hl32, pf, hz)
      +rt = PA(RTE(v, dd, D, X, q, r), BYE(v, dd, D, q, r), g)
      +by = PB(RTE(v, dd, D, X, q, r), BYE(v, dd, D, q, r), g)
      mkEm(MSome{v}, dd, D, X, q, r, Equal.cong(Array<U32> & FuluDeposit_d.Deposit, Array<U32> & O.Boxed<FuluDeposit_d.Deposit>, z => FuluDeposit_e.Deposit_bx_put_back(z), FuluDeposit_e.Deposit_put(FD.array__thaw(U32, D), X, th_Deposit(v)),
        (FD.array__thaw(U32, PXE(v, dd, D, q, r)), th_Deposit(v)), rt), by)

def putxEm(+m: MB<M_Deposit>, +h: {EOK(m) == True{} : Bool}, +dd: Nat, +D: FD.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat,
    +e: {U32.to_nat(X) == Nat.add(A.quad(q), r) : Nat}, +hr: {Nat.is_lt(r, 4n) == True{} : Bool}, +hd: {Nat.is_lt(dd, 29n) == True{} : Bool},
    +hl: {Nat.is_le(Nat.add(q, WD.NWN(Nat.add(r, 1240n))), VB.pw(dd)) == True{} : Bool}, +pf: {FD.array__perfect(U32, dd, D) == True{} : Bool},
    +hz: {VS.bt(1240n, VS.bdr(Nat.add(A.quad(q), r), UA.BYT(D))) == UW.ZB(1240n) : +List<U32>})
    -> DK.P2(RTEm(m, dd, D, X, q, r), BYEm(m, dd, D, q, r)):
  putxEmW(m, h, dd, D, X, q, r, e, hr, FD.nat__lt_trans(dd, 29n, 31n, hd, {==}), hl, VRX.hl32w(q, r, 1240n, dd, hd, hl), pf, hz)
def EVm(+m: MB<M_Deposit>) -> S.Value:
  match m:
    case MNone{}: S.NullValue{}
    case MSome{+v}: EV(v)
def specEm(+m: MB<M_Deposit>, +h: {EOK(m) == True{} : Bool}) -> {Codec.parts(EVm(m), Spec.Schema56()) == Some{[S.Fixed{YEm(m)}]} : Maybe<&2, +List<S.Part>>}:
  match m:
    case MNone{}: Empty.absurd({Codec.parts(EVm(MNone{}), Spec.Schema56()) == Some{[S.Fixed{YEm(MNone{})}]} : Maybe<&2, +List<S.Part>>}, FD.logic__false_true(h))
    case MSome{+v}: specE(v, h)


# ==== l16_Deposit: a list of at most 16 boxed Deposit (fixed size, 1240 bytes), writer side ====================
# The runtime writes element i at byte X + 1240 i through a swap loop over its boxed array
# (T.l16_Deposit_pt: swap the element out for BNone, write it, swap it back). The array is the mirror
# tree t of MB<M_Deposit> (root_types' am_l16_Deposit); element j's writer is putxEm above.

def TDM(t: FD.array__Tree<MB<M_Deposit>>) -> Nat:
  match t:
    case FD.TLeaf{x}: 0n
    case FD.TNode{l, r}: 1n+TDM(l)

def AR(t: FD.array__Tree<MB<M_Deposit>>) -> Array<O.Boxed<FuluDeposit_d.Deposit>>: am_l16_Deposit(t)
def SL(t: FD.array__Tree<MB<M_Deposit>>) -> List<&2, MB<M_Deposit>>: FD.array__slots(MB<M_Deposit>, t)

# Elements i .. i + k - 1 of W: present, with their facts.
def EOKS(k: Nat, +W: List<&2, MB<M_Deposit>>, +i: Nat) -> Bool:
  match k:
    case 0n: True{}
    case 1n+q: Bool.and(EOK(xat_l16_Deposit(W, i)), EOKS(q, W, 1n+i))

# Their bytes.
def CATE(k: Nat, +W: List<&2, MB<M_Deposit>>, +i: Nat) -> +List<U32>:
  match k:
    case 0n: []
    case 1n+q: VCN.AP(YEm(xat_l16_Deposit(W, i)), CATE(q, W, 1n+i))

# The counter after s: s + 1 < 2^(1 + d) when s < n <= 2^d.
def inc(+i: U32, +s: Nat, +n: Nat, +d: Nat, +ei: {U32.to_nat(i) == s : Nat}, +hs: {Nat.is_lt(s, n) == True{} : Bool},
    +hn: {Nat.is_le(n, VB.pw(d)) == True{} : Bool}, +hd: {Nat.is_lt(d, 31n) == True{} : Bool}) -> {U32.to_nat(U32.add(i, 1)) == 1n+s : Nat}:
  VB.add_at(i, 1, s, 1n+d, ei, hd,
    FD.nat__le_lt_trans(1n+s, VB.pw(d), VB.pw(1n+d), FD.nat__le_trans(1n+s, n, VB.pw(d), FD.nat__lt_succ_le_succ(s, n, hs), hn), FD.nat__pow2_lt_succ(d)))

# Element s of the perfect tree t.
def hx_at(+d: Nat, +t: FD.array__Tree<MB<M_Deposit>>, +s: Nat, +pf: {FD.array__perfect(MB<M_Deposit>, d, t) == True{} : Bool}, +hs: {Nat.is_lt(s, VB.pw(d)) == True{} : Bool})
    -> {FD.spec_common__nth(MB<M_Deposit>, SL(t), s) == Some{xat_l16_Deposit(SL(t), s)} : Maybe<&2, MB<M_Deposit>>}:
  nth_l16_Deposit(SL(t), s, FD.logic__subst(Nat, z => {Nat.is_lt(s, z) == True{} : Bool}, VB.pw(d), FD.spec_common__length(MB<M_Deposit>, SL(t)),
    Equal.sym(Nat, FD.spec_common__length(MB<M_Deposit>, SL(t)), VB.pw(d), FD.array__slots_length(MB<M_Deposit>, d, t, pf)), hs))

# Swapping element s out for MNone, then back: the array is unchanged, the spare is MNone.
def swap_out(+d: Nat, +t: FD.array__Tree<MB<M_Deposit>>, +i: U32, +s: Nat, +ei: {U32.to_nat(i) == s : Nat}, +pf: {FD.array__perfect(MB<M_Deposit>, d, t) == True{} : Bool},
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +hs: {Nat.is_lt(s, VB.pw(d)) == True{} : Bool})
    -> {Array.swap(O.Boxed<FuluDeposit_d.Deposit>, AR(t), i, O.BNone{}) == (AR(FD.array__upd(MB<M_Deposit>, d, t, s, MNone{})), th_Deposit_bx(xat_l16_Deposit(SL(t), s))) : Array<O.Boxed<FuluDeposit_d.Deposit>> & O.Boxed<FuluDeposit_d.Deposit>}:
  %ei :
    {Array.swap(O.Boxed<FuluDeposit_d.Deposit>, AR(t), i, O.BNone{}) == (AR(FD.array__upd(MB<M_Deposit>, d, t, _, MNone{})), th_Deposit_bx(xat_l16_Deposit(SL(t), _))) : Array<O.Boxed<FuluDeposit_d.Deposit>> & O.Boxed<FuluDeposit_d.Deposit>}
  amswap_l16_Deposit(d, t, i, MNone{}, xat_l16_Deposit(SL(t), U32.to_nat(i)), FD.nat__lt_trans(d, 31n, 32n, hd, {==}),
    FD.logic__subst(Nat, z => {Nat.is_lt(z, VB.pw(d)) == True{} : Bool}, s, U32.to_nat(i), Equal.sym(Nat, U32.to_nat(i), s, ei), hs),
    hx_at(d, t, U32.to_nat(i), pf, FD.logic__subst(Nat, z => {Nat.is_lt(z, VB.pw(d)) == True{} : Bool}, s, U32.to_nat(i), Equal.sym(Nat, U32.to_nat(i), s, ei), hs)), pf)

def swap_in(+d: Nat, +t: FD.array__Tree<MB<M_Deposit>>, +i: U32, +s: Nat, +ei: {U32.to_nat(i) == s : Nat}, +pf: {FD.array__perfect(MB<M_Deposit>, d, t) == True{} : Bool},
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +hs: {Nat.is_lt(s, VB.pw(d)) == True{} : Bool})
    -> {Array.swap(O.Boxed<FuluDeposit_d.Deposit>, AR(FD.array__upd(MB<M_Deposit>, d, t, s, MNone{})), i, th_Deposit_bx(xat_l16_Deposit(SL(t), s))) == (AR(t), O.BNone{}) : Array<O.Boxed<FuluDeposit_d.Deposit>> & O.Boxed<FuluDeposit_d.Deposit>}:
  +x = xat_l16_Deposit(SL(t), s)
  +t2 = FD.array__upd(MB<M_Deposit>, d, t, s, MNone{})
  +hx = hx_at(d, t, s, pf, hs)
  +hz = FD.logic__subst(List<&2, MB<M_Deposit>>, ys => {FD.spec_common__nth(MB<M_Deposit>, ys, s) == Some{MNone{}} : Maybe<&2, MB<M_Deposit>>}, FD.spec_common__update(MB<M_Deposit>, SL(t), s, MNone{}), SL(t2),
    Equal.sym(List<&2, MB<M_Deposit>>, SL(t2), FD.spec_common__update(MB<M_Deposit>, SL(t), s, MNone{}), FD.array__upd_slots(MB<M_Deposit>, d, t, s, MNone{}, hs, pf)),
    FD.list__nth_update_same(MB<M_Deposit>, SL(t), s, MNone{}, FD.list__nth_lt_length(MB<M_Deposit>, SL(t), s, x, hx)))
  +his = FD.logic__subst(Nat, z => {Nat.is_lt(z, VB.pw(d)) == True{} : Bool}, s, U32.to_nat(i), Equal.sym(Nat, U32.to_nat(i), s, ei), hs)
  +hzi = FD.logic__subst(Nat, z => {FD.spec_common__nth(MB<M_Deposit>, SL(t2), z) == Some{MNone{}} : Maybe<&2, MB<M_Deposit>>}, s, U32.to_nat(i), Equal.sym(Nat, U32.to_nat(i), s, ei), hz)
  %Equal.sym(Array<O.Boxed<FuluDeposit_d.Deposit>> & O.Boxed<FuluDeposit_d.Deposit>, Array.swap(O.Boxed<FuluDeposit_d.Deposit>, AR(t2), i, th_Deposit_bx(x)), (AR(FD.array__upd(MB<M_Deposit>, d, t2, U32.to_nat(i), x)), th_Deposit_bx(MNone{})),
      amswap_l16_Deposit(d, t2, i, x, MNone{}, FD.nat__lt_trans(d, 31n, 32n, hd, {==}), his, hzi, FD.array__upd_perfect(MB<M_Deposit>, d, t, s, MNone{}, pf))) :
    {_ == (AR(t), O.BNone{}) : Array<O.Boxed<FuluDeposit_d.Deposit>> & O.Boxed<FuluDeposit_d.Deposit>}
  %Equal.sym(Nat, U32.to_nat(i), s, ei) : {(AR(FD.array__upd(MB<M_Deposit>, d, t2, _, x)), O.BNone{}) == (AR(t), O.BNone{}) : Array<O.Boxed<FuluDeposit_d.Deposit>> & O.Boxed<FuluDeposit_d.Deposit>}
  %Equal.sym(FD.array__Tree<MB<M_Deposit>>, FD.array__upd(MB<M_Deposit>, d, t2, s, x), t, AM.upd_restore(MB<M_Deposit>, d, t, s, MNone{}, x, hs, hx, pf)) :
    {(AR(_), O.BNone{}) == (AR(t), O.BNone{}) : Array<O.Boxed<FuluDeposit_d.Deposit>> & O.Boxed<FuluDeposit_d.Deposit>}
  {==}

# ---- the runtime's validity pass --------------------------------------------------------------------

def bxvalid(+m: MB<M_Deposit>, +h: {EOK(m) == True{} : Bool}) -> {FuluDeposit_e.Deposit_bx_valid(th_Deposit_bx(m)) == (th_Deposit_bx(m), True{}) : O.Boxed<FuluDeposit_d.Deposit> & Bool}:
  match m:
    case MNone{}: Empty.absurd({FuluDeposit_e.Deposit_bx_valid(th_Deposit_bx(MNone{})) == (th_Deposit_bx(MNone{}), True{}) : O.Boxed<FuluDeposit_d.Deposit> & Bool}, FD.logic__false_true(h))
    case MSome{+v}:
      %Equal.sym(FuluDeposit_d.Deposit & Bool, FuluDeposit_e.Deposit_valid(th_Deposit(v)), (th_Deposit(v), True{}), validE(v, h)) :
        {FuluDeposit_e.Deposit_bx_va_back(_) == (O.BSome{th_Deposit(v), O.BNone{}}, True{}) : O.Boxed<FuluDeposit_d.Deposit> & Bool}
      {==}

law va_go:
  for +k: Nat
  for +d: Nat
  for +t: FD.array__Tree<MB<M_Deposit>>
  for +i: U32
  for +s: Nat
  for +n: Nat
  for +ei: {U32.to_nat(i) == s : Nat}
  for +ek: {Nat.add(s, k) == n : Nat}
  for +pf: {FD.array__perfect(MB<M_Deposit>, d, t) == True{} : Bool}
  for +hd: {Nat.is_lt(d, 31n) == True{} : Bool}
  for +hn: {Nat.is_le(n, VB.pw(d)) == True{} : Bool}
  for +hok: {EOKS(k, SL(t), s) == True{} : Bool}
  {Fulu_list_Deposit_16_e.l16_Deposit_va(k, i, (AR(t), True{})) == (AR(t), True{}) : Array<O.Boxed<FuluDeposit_d.Deposit>> & Bool}
def va_go(k, d, t, i, s, n, ei, ek, pf, hd, hn, hok):
  match k:
    case 0n: {==}
    case 1n+ +q:
      +x = xat_l16_Deposit(SL(t), s)
      +hs = FD.logic__subst(Nat, z => {Nat.is_lt(s, z) == True{} : Bool}, Nat.add(s, 1n+q), n, ek,
        FD.logic__subst(Nat, z => {Nat.is_lt(s, z) == True{} : Bool}, 1n+Nat.add(s, q), Nat.add(s, 1n+q), Equal.sym(Nat, Nat.add(s, 1n+q), 1n+Nat.add(s, q), FD.nat__add_succ(s, q)),
          FD.nat__le_lt_succ(s, Nat.add(s, q), Order.below_sum(s, q))))
      +hsd = FD.nat__lt_le_trans(s, n, VB.pw(d), hs, hn)
      +hx = and_l(EOK(x), EOKS(q, SL(t), 1n+s), hok)
      +his = FD.logic__subst(Nat, z => {Nat.is_lt(z, VB.pw(d)) == True{} : Bool}, s, U32.to_nat(i), Equal.sym(Nat, U32.to_nat(i), s, ei), hsd)
      %Equal.sym(Array<O.Boxed<FuluDeposit_d.Deposit>> & O.Boxed<FuluDeposit_d.Deposit>, Array.swap(O.Boxed<FuluDeposit_d.Deposit>, AR(t), i, O.BNone{}), (AR(FD.array__upd(MB<M_Deposit>, d, t, s, MNone{})), th_Deposit_bx(x)), swap_out(d, t, i, s, ei, pf, hd, hsd)) :
        {Fulu_list_Deposit_16_e.l16_Deposit_va(q, U32.add(i, 1), Fulu_list_Deposit_16_e.l16_Deposit_va_one(i, True{}, _)) == (AR(t), True{}) : Array<O.Boxed<FuluDeposit_d.Deposit>> & Bool}
      %Equal.sym(O.Boxed<FuluDeposit_d.Deposit> & Bool, FuluDeposit_e.Deposit_bx_valid(th_Deposit_bx(x)), (th_Deposit_bx(x), True{}), bxvalid(x, hx)) :
        {Fulu_list_Deposit_16_e.l16_Deposit_va(q, U32.add(i, 1), Fulu_list_Deposit_16_e.l16_Deposit_va_back(i, True{}, AR(FD.array__upd(MB<M_Deposit>, d, t, s, MNone{})), _)) == (AR(t), True{}) : Array<O.Boxed<FuluDeposit_d.Deposit>> & Bool}
      %ei :
        {Fulu_list_Deposit_16_e.l16_Deposit_va(q, U32.add(i, 1), (Array.set(O.Boxed<FuluDeposit_d.Deposit>, AR(FD.array__upd(MB<M_Deposit>, d, t, _, MNone{})), i, th_Deposit_bx(xat_l16_Deposit(SL(t), _))), True{})) == (AR(t), True{}) : Array<O.Boxed<FuluDeposit_d.Deposit>> & Bool}
      %Equal.sym(Array<O.Boxed<FuluDeposit_d.Deposit>>, Array.set(O.Boxed<FuluDeposit_d.Deposit>, AR(FD.array__upd(MB<M_Deposit>, d, t, U32.to_nat(i), MNone{})), i, th_Deposit_bx(xat_l16_Deposit(SL(t), U32.to_nat(i)))), AR(t),
          amswap_back_l16_Deposit(d, t, i, MNone{}, xat_l16_Deposit(SL(t), U32.to_nat(i)), FD.nat__lt_trans(d, 31n, 32n, hd, {==}), his, hx_at(d, t, U32.to_nat(i), pf, his), pf)) :
        {Fulu_list_Deposit_16_e.l16_Deposit_va(q, U32.add(i, 1), (_, True{})) == (AR(t), True{}) : Array<O.Boxed<FuluDeposit_d.Deposit>> & Bool}
      va_go(q, d, t, U32.add(i, 1), 1n+s, n, inc(i, s, n, d, ei, hs, hn, hd),
        Equal.trans(Nat, Nat.add(1n+s, q), 1n+Nat.add(s, q), n, {==}, Equal.trans(Nat, 1n+Nat.add(s, q), Nat.add(s, 1n+q), n, Equal.sym(Nat, Nat.add(s, 1n+q), 1n+Nat.add(s, q), FD.nat__add_succ(s, q)), ek)),
        pf, hd, hn, and_r(EOK(x), EOKS(q, SL(t), 1n+s), hok))

# ---- the list object and its facts -----------------------------------------------------------------

def THL_l16_Deposit(+t: FD.array__Tree<MB<M_Deposit>>, +N: U32) -> Fulu_list_Deposit_16_d.l16_Deposit_Seq: Fulu_list_Deposit_16_d.l16_Deposit_Seq{AR(t), N}
def OKL_l16_Deposit(+t: FD.array__Tree<MB<M_Deposit>>, +N: U32) -> Bool:
  Bool.and(Nat.is_lt(TDM(t), 31n), Bool.and(FD.array__perfect(MB<M_Deposit>, TDM(t), t), Bool.and(Nat.is_le(U32.to_nat(N), VB.pw(TDM(t))),
    Bool.and(U32.is_le(N, 16), EOKS(U32.to_nat(N), SL(t), 0n)))))
def okl_d(+t: FD.array__Tree<MB<M_Deposit>>, +N: U32, +h: {OKL_l16_Deposit(t, N) == True{} : Bool}) -> {Nat.is_lt(TDM(t), 31n) == True{} : Bool}:
  and_l(Nat.is_lt(TDM(t), 31n), Bool.and(FD.array__perfect(MB<M_Deposit>, TDM(t), t), Bool.and(Nat.is_le(U32.to_nat(N), VB.pw(TDM(t))), Bool.and(U32.is_le(N, 16), EOKS(U32.to_nat(N), SL(t), 0n)))), h)
def okl_1(+t: FD.array__Tree<MB<M_Deposit>>, +N: U32, +h: {OKL_l16_Deposit(t, N) == True{} : Bool})
    -> {Bool.and(FD.array__perfect(MB<M_Deposit>, TDM(t), t), Bool.and(Nat.is_le(U32.to_nat(N), VB.pw(TDM(t))), Bool.and(U32.is_le(N, 16), EOKS(U32.to_nat(N), SL(t), 0n)))) == True{} : Bool}:
  and_r(Nat.is_lt(TDM(t), 31n), Bool.and(FD.array__perfect(MB<M_Deposit>, TDM(t), t), Bool.and(Nat.is_le(U32.to_nat(N), VB.pw(TDM(t))), Bool.and(U32.is_le(N, 16), EOKS(U32.to_nat(N), SL(t), 0n)))), h)
def okl_pf(+t: FD.array__Tree<MB<M_Deposit>>, +N: U32, +h: {OKL_l16_Deposit(t, N) == True{} : Bool}) -> {FD.array__perfect(MB<M_Deposit>, TDM(t), t) == True{} : Bool}:
  and_l(FD.array__perfect(MB<M_Deposit>, TDM(t), t), Bool.and(Nat.is_le(U32.to_nat(N), VB.pw(TDM(t))), Bool.and(U32.is_le(N, 16), EOKS(U32.to_nat(N), SL(t), 0n))), okl_1(t, N, h))
def okl_2(+t: FD.array__Tree<MB<M_Deposit>>, +N: U32, +h: {OKL_l16_Deposit(t, N) == True{} : Bool})
    -> {Bool.and(Nat.is_le(U32.to_nat(N), VB.pw(TDM(t))), Bool.and(U32.is_le(N, 16), EOKS(U32.to_nat(N), SL(t), 0n))) == True{} : Bool}:
  and_r(FD.array__perfect(MB<M_Deposit>, TDM(t), t), Bool.and(Nat.is_le(U32.to_nat(N), VB.pw(TDM(t))), Bool.and(U32.is_le(N, 16), EOKS(U32.to_nat(N), SL(t), 0n))), okl_1(t, N, h))
def okl_n(+t: FD.array__Tree<MB<M_Deposit>>, +N: U32, +h: {OKL_l16_Deposit(t, N) == True{} : Bool}) -> {Nat.is_le(U32.to_nat(N), VB.pw(TDM(t))) == True{} : Bool}:
  and_l(Nat.is_le(U32.to_nat(N), VB.pw(TDM(t))), Bool.and(U32.is_le(N, 16), EOKS(U32.to_nat(N), SL(t), 0n)), okl_2(t, N, h))
def okl_3(+t: FD.array__Tree<MB<M_Deposit>>, +N: U32, +h: {OKL_l16_Deposit(t, N) == True{} : Bool}) -> {Bool.and(U32.is_le(N, 16), EOKS(U32.to_nat(N), SL(t), 0n)) == True{} : Bool}:
  and_r(Nat.is_le(U32.to_nat(N), VB.pw(TDM(t))), Bool.and(U32.is_le(N, 16), EOKS(U32.to_nat(N), SL(t), 0n)), okl_2(t, N, h))
def okl_lim(+t: FD.array__Tree<MB<M_Deposit>>, +N: U32, +h: {OKL_l16_Deposit(t, N) == True{} : Bool}) -> {U32.is_le(N, 16) == True{} : Bool}:
  and_l(U32.is_le(N, 16), EOKS(U32.to_nat(N), SL(t), 0n), okl_3(t, N, h))
def okl_e(+t: FD.array__Tree<MB<M_Deposit>>, +N: U32, +h: {OKL_l16_Deposit(t, N) == True{} : Bool}) -> {EOKS(U32.to_nat(N), SL(t), 0n) == True{} : Bool}:
  and_r(U32.is_le(N, 16), EOKS(U32.to_nat(N), SL(t), 0n), okl_3(t, N, h))

# N <= 2^d as the runtime compares it.
def le_cap(+t: FD.array__Tree<MB<M_Deposit>>, +N: U32, +h: {OKL_l16_Deposit(t, N) == True{} : Bool}) -> {U32.is_le(N, FD.u32__pow2u(TDM(t))) == True{} : Bool}:
  %Equal.sym(Bool, U32.is_le(N, FD.u32__pow2u(TDM(t))), Nat.is_le(U32.to_nat(N), U32.to_nat(FD.u32__pow2u(TDM(t)))), VU.le_u32(N, FD.u32__pow2u(TDM(t)))) : {_ == True{} : Bool}
  %Equal.sym(Nat, U32.to_nat(FD.u32__pow2u(TDM(t))), VB.pw(TDM(t)), FD.u32__pow2u_value(TDM(t), FD.nat__lt_trans(TDM(t), 31n, 32n, okl_d(t, N, h), {==}))) : {Nat.is_le(U32.to_nat(N), _) == True{} : Bool}
  okl_n(t, N, h)

# The runtime's validity check of the list.
def valid_l16_Deposit(+t: FD.array__Tree<MB<M_Deposit>>, +N: U32, +h: {OKL_l16_Deposit(t, N) == True{} : Bool}) -> {Fulu_list_Deposit_16_e.l16_Deposit_valid(THL_l16_Deposit(t, N)) == (THL_l16_Deposit(t, N), True{}) : Fulu_list_Deposit_16_d.l16_Deposit_Seq & Bool}:
  +d = TDM(t)
  %Equal.sym(Array<O.Boxed<FuluDeposit_d.Deposit>> & U32, Array.size(O.Boxed<FuluDeposit_d.Deposit>, AR(t)), (AR(t), FD.u32__pow2u(d)), amsize_l16_Deposit(d, t, okl_pf(t, N, h))) :
    {Fulu_list_Deposit_16_e.l16_Deposit_va_cap(Bool.or(False{}, U32.is_le(N, 16)), N, _) == (THL_l16_Deposit(t, N), True{}) : Fulu_list_Deposit_16_d.l16_Deposit_Seq & Bool}
  %Equal.sym(Bool, U32.is_le(N, 16), True{}, okl_lim(t, N, h)) :
    {Fulu_list_Deposit_16_e.l16_Deposit_va_go(Bool.and(Bool.or(False{}, _), U32.is_le(N, FD.u32__pow2u(d))), N, AR(t)) == (THL_l16_Deposit(t, N), True{}) : Fulu_list_Deposit_16_d.l16_Deposit_Seq & Bool}
  %Equal.sym(Bool, U32.is_le(N, FD.u32__pow2u(d)), True{}, le_cap(t, N, h)) :
    {Fulu_list_Deposit_16_e.l16_Deposit_va_go(Bool.and(True{}, _), N, AR(t)) == (THL_l16_Deposit(t, N), True{}) : Fulu_list_Deposit_16_d.l16_Deposit_Seq & Bool}
  %Equal.sym(Array<O.Boxed<FuluDeposit_d.Deposit>> & Bool, Fulu_list_Deposit_16_e.l16_Deposit_va(U32.to_nat(N), 0, (AR(t), True{})), (AR(t), True{}),
      va_go(U32.to_nat(N), d, t, 0, 0n, U32.to_nat(N), {==}, {==}, okl_pf(t, N, h), okl_d(t, N, h), okl_n(t, N, h), okl_e(t, N, h))) :
    {Fulu_list_Deposit_16_e.l16_Deposit_va_fin(N, True{}, _) == (THL_l16_Deposit(t, N), True{}) : Fulu_list_Deposit_16_d.l16_Deposit_Seq & Bool}
  {==}

# ---- the write loop ------------------------------------------------------------------------------

# the elements j, j + 1, ..., j + k - 1 of t written from byte X + 1240 j on
def WX(k: Nat, +j: Nat, +dd: Nat, D: FD.array__Tree<U32>, +q: Nat, +r: Nat, +t: FD.array__Tree<MB<M_Deposit>>) -> FD.array__Tree<U32>:
  match k:
    case 0n: D
    case 1n+p: WX(p, 1n+j, dd, PXEm(xat_l16_Deposit(SL(t), j), dd, D, Nat.add(Nat.mul(j, 310n), q), r), q, r, t)

law pfWX:
  for +k: Nat
  for +j: Nat
  for +dd: Nat
  for +D: FD.array__Tree<U32>
  for +q: Nat
  for +r: Nat
  for +t: FD.array__Tree<MB<M_Deposit>>
  for +pf: {FD.array__perfect(U32, dd, D) == True{} : Bool}
  {FD.array__perfect(U32, dd, WX(k, j, dd, D, q, r, t)) == True{} : Bool}
def pfWX(k, j, dd, D, q, r, t, pf):
  match k:
    case 0n: pf
    case 1n+ +p: pfWX(p, 1n+j, dd, PXEm(xat_l16_Deposit(SL(t), j), dd, D, Nat.add(Nat.mul(j, 310n), q), r), q, r, t, pfEm(xat_l16_Deposit(SL(t), j), dd, D, Nat.add(Nat.mul(j, 310n), q), r, pf))

def RTK(k: Nat, +i: U32, +j: Nat, +X: U32, +q: Nat, +r: Nat, +dd: Nat, +D: FD.array__Tree<U32>, +t: FD.array__Tree<MB<M_Deposit>>) -> Data:
  {Fulu_list_Deposit_16_e.l16_Deposit_pt(k, i, X, (FD.array__thaw(U32, D), (AR(t), O.BNone{}))) == (FD.array__thaw(U32, WX(k, j, dd, D, q, r, t)), (AR(t), O.BNone{})) : Array<U32> & (Array<O.Boxed<FuluDeposit_d.Deposit>> & O.Boxed<FuluDeposit_d.Deposit>)}
def BYK(k: Nat, +j: Nat, +q: Nat, +r: Nat, +dd: Nat, +D: FD.array__Tree<U32>, +t: FD.array__Tree<MB<M_Deposit>>) -> Data:
  {UA.BYT(WX(k, j, dd, D, q, r, t)) == UW.SPL(UA.BYT(D), VRX.YP(j, 310n, q, r), CATE(k, SL(t), j)) : +List<U32>}

def mk2(k: Nat, +i: U32, +j: Nat, +X: U32, +q: Nat, +r: Nat, +dd: Nat, +D: FD.array__Tree<U32>, +t: FD.array__Tree<MB<M_Deposit>>, +a: RTK(k, i, j, X, q, r, dd, D, t), +b: BYK(k, j, q, r, dd, D, t))
    -> DK.P2(RTK(k, i, j, X, q, r, dd, D, t), BYK(k, j, q, r, dd, D, t)):
  (a, b)

# The loop from element j (index i) on, k elements, into LT bytes at X whose last k elements' bytes are zero.
def ptxW(k: Nat, +i: U32, +j: Nat, +n: Nat, +X: U32, +q: Nat, +r: Nat, +dd: Nat, +D: FD.array__Tree<U32>, +d: Nat, +t: FD.array__Tree<MB<M_Deposit>>, +LT: Nat,
    +ei: {U32.to_nat(i) == j : Nat}, +ek: {Nat.add(j, k) == n : Nat}, +e: {U32.to_nat(X) == Nat.add(A.quad(q), r) : Nat}, +hr: {Nat.is_lt(r, 4n) == True{} : Bool},
    +hd: {Nat.is_lt(dd, 31n) == True{} : Bool}, +pfD: {FD.array__perfect(U32, dd, D) == True{} : Bool},
    +hj: {Nat.is_le(A.quad(Nat.mul(Nat.add(k, j), 310n)), LT) == True{} : Bool},
    +hl: {Nat.is_le(Nat.add(q, WD.NWN(Nat.add(r, LT))), VB.pw(dd)) == True{} : Bool}, +hl32: {Nat.is_lt(Nat.add(A.quad(q), Nat.add(r, LT)), FD.spec_common__pow2(32n)) == True{} : Bool},
    +hz: {VS.bt(A.quad(Nat.mul(k, 310n)), VS.bdr(VRX.YP(j, 310n, q, r), UA.BYT(D))) == UW.ZB(A.quad(Nat.mul(k, 310n))) : +List<U32>},
    +pfA: {FD.array__perfect(MB<M_Deposit>, d, t) == True{} : Bool}, +hda: {Nat.is_lt(d, 31n) == True{} : Bool}, +hn: {Nat.is_le(n, VB.pw(d)) == True{} : Bool},
    +hok: {EOKS(k, SL(t), j) == True{} : Bool})
    -> DK.P2(RTK(k, i, j, X, q, r, dd, D, t), BYK(k, j, q, r, dd, D, t)):
  match k:
    case 0n: ({==}, Equal.sym(+List<U32>, UW.SPL(UA.BYT(D), VRX.YP(j, 310n, q, r), []), UA.BYT(D), VRX.spl_nil(UA.BYT(D), VRX.YP(j, 310n, q, r))))
    case 1n+ +p:
      +x = xat_l16_Deposit(SL(t), j)
      +hx = and_l(EOK(x), EOKS(p, SL(t), 1n+j), hok)
      +qj = Nat.add(Nat.mul(j, 310n), q)
      +Xj = U32.add(X, U32.mul(i, 1240))
      +ej = VRX.rposW(X, i, j, p, q, r, 310n, 1240, LT, dd, e, {==}, ei, hd, {==}, hj, hl)
      +hlj = VRX.rroom(j, p, q, r, 310n, LT, dd, hj, hl)
      +bm = A.quad(Nat.mul(p, 310n))
      +B0 = UA.BYT(D)
      +Yj = VRX.YP(j, 310n, q, r)
      +hz0 = VRX.zhead(1240n, bm, VS.bdr(Yj, B0), hz)
      +g = putxEmW(x, hx, dd, D, Xj, qj, r, ej, hr, hd, hlj, VRX.rroom32(j, p, q, r, 310n, LT, dd, hj, hl32), pfD, hz0)
      +rt = PA(RTEm(x, dd, D, Xj, qj, r), BYEm(x, dd, D, qj, r), g)
      +by = PB(RTEm(x, dd, D, Xj, qj, r), BYEm(x, dd, D, qj, r), g)
      +D1 = PXEm(x, dd, D, qj, r)
      +pf1 = pfEm(x, dd, D, qj, r, pfD)
      +Y = YEm(x)
      +hX = VRX.xstart(qj, r, 1240n, dd, D, pfD, hlj)
      +ey = VRX.ynext(j, 310n, q, r)
      +z1 = VRX.znext(B0, Yj, Y, VRX.YP(1n+j, 310n, q, r), 1240n, bm, UA.BYT(D1), hX, lenEm(x, hx), ey, by, hz)
      +hs = FD.logic__subst(Nat, z => {Nat.is_lt(j, z) == True{} : Bool}, Nat.add(j, 1n+p), n, ek,
        FD.logic__subst(Nat, z => {Nat.is_lt(j, z) == True{} : Bool}, 1n+Nat.add(j, p), Nat.add(j, 1n+p), Equal.sym(Nat, Nat.add(j, 1n+p), 1n+Nat.add(j, p), FD.nat__add_succ(j, p)),
          FD.nat__le_lt_succ(j, Nat.add(j, p), Order.below_sum(j, p))))
      +hsd = FD.nat__lt_le_trans(j, n, VB.pw(d), hs, hn)
      +ei1 = inc(i, j, n, d, ei, hs, hn, hda)
      +ek1 = Equal.trans(Nat, Nat.add(1n+j, p), 1n+Nat.add(j, p), n, {==}, Equal.trans(Nat, 1n+Nat.add(j, p), Nat.add(j, 1n+p), n, Equal.sym(Nat, Nat.add(j, 1n+p), 1n+Nat.add(j, p), FD.nat__add_succ(j, p)), ek))
      +hj2 = FD.logic__subst(Nat, z => {Nat.is_le(A.quad(Nat.mul(z, 310n)), LT) == True{} : Bool}, 1n+Nat.add(p, j), Nat.add(p, 1n+j), Equal.sym(Nat, Nat.add(p, 1n+j), 1n+Nat.add(p, j), FD.nat__add_succ(p, j)), hj)
      +ih = ptxW(p, U32.add(i, 1), 1n+j, n, X, q, r, dd, D1, d, t, LT, ei1, ek1, e, hr, hd, pf1, hj2, hl, hl32, z1, pfA, hda, hn, and_r(EOK(x), EOKS(p, SL(t), 1n+j), hok))
      +rt2 = PA(RTK(p, U32.add(i, 1), 1n+j, X, q, r, dd, D1, t), BYK(p, 1n+j, q, r, dd, D1, t), ih)
      +by2 = PB(RTK(p, U32.add(i, 1), 1n+j, X, q, r, dd, D1, t), BYK(p, 1n+j, q, r, dd, D1, t), ih)
      +t2 = FD.array__upd(MB<M_Deposit>, d, t, j, MNone{})
      +e1 = Equal.cong(Array<O.Boxed<FuluDeposit_d.Deposit>> & O.Boxed<FuluDeposit_d.Deposit>, Array<U32> & (Array<O.Boxed<FuluDeposit_d.Deposit>> & O.Boxed<FuluDeposit_d.Deposit>),
        z => Fulu_list_Deposit_16_e.l16_Deposit_pt(p, U32.add(i, 1), X, Fulu_list_Deposit_16_e.l16_Deposit_pt_one(i, X, FD.array__thaw(U32, D), z)),
        Array.swap(O.Boxed<FuluDeposit_d.Deposit>, AR(t), i, O.BNone{}), (AR(t2), th_Deposit_bx(x)), swap_out(d, t, i, j, ei, pfA, hda, hsd))
      +e2 = Equal.cong(Array<U32> & O.Boxed<FuluDeposit_d.Deposit>, Array<U32> & (Array<O.Boxed<FuluDeposit_d.Deposit>> & O.Boxed<FuluDeposit_d.Deposit>),
        z => Fulu_list_Deposit_16_e.l16_Deposit_pt(p, U32.add(i, 1), X, Fulu_list_Deposit_16_e.l16_Deposit_pt_back(i, AR(t2), z)),
        FuluDeposit_e.Deposit_bx_put(FD.array__thaw(U32, D), Xj, th_Deposit_bx(x)), (FD.array__thaw(U32, D1), th_Deposit_bx(x)), rt)
      +e3 = Equal.cong(Array<O.Boxed<FuluDeposit_d.Deposit>> & O.Boxed<FuluDeposit_d.Deposit>, Array<U32> & (Array<O.Boxed<FuluDeposit_d.Deposit>> & O.Boxed<FuluDeposit_d.Deposit>),
        z => Fulu_list_Deposit_16_e.l16_Deposit_pt(p, U32.add(i, 1), X, Fulu_list_Deposit_16_e.l16_Deposit_pt_ret(FD.array__thaw(U32, D1), z)),
        Array.swap(O.Boxed<FuluDeposit_d.Deposit>, AR(t2), i, th_Deposit_bx(x)), (AR(t), O.BNone{}), swap_in(d, t, i, j, ei, pfA, hda, hsd))
      +rtf = Equal.trans(Array<U32> & (Array<O.Boxed<FuluDeposit_d.Deposit>> & O.Boxed<FuluDeposit_d.Deposit>),
        Fulu_list_Deposit_16_e.l16_Deposit_pt(p, U32.add(i, 1), X, Fulu_list_Deposit_16_e.l16_Deposit_pt_one(i, X, FD.array__thaw(U32, D), Array.swap(O.Boxed<FuluDeposit_d.Deposit>, AR(t), i, O.BNone{}))),
        Fulu_list_Deposit_16_e.l16_Deposit_pt(p, U32.add(i, 1), X, Fulu_list_Deposit_16_e.l16_Deposit_pt_one(i, X, FD.array__thaw(U32, D), (AR(t2), th_Deposit_bx(x)))),
        (FD.array__thaw(U32, WX(p, 1n+j, dd, D1, q, r, t)), (AR(t), O.BNone{})), e1,
        Equal.trans(Array<U32> & (Array<O.Boxed<FuluDeposit_d.Deposit>> & O.Boxed<FuluDeposit_d.Deposit>),
          Fulu_list_Deposit_16_e.l16_Deposit_pt(p, U32.add(i, 1), X, Fulu_list_Deposit_16_e.l16_Deposit_pt_back(i, AR(t2), FuluDeposit_e.Deposit_bx_put(FD.array__thaw(U32, D), Xj, th_Deposit_bx(x)))),
          Fulu_list_Deposit_16_e.l16_Deposit_pt(p, U32.add(i, 1), X, Fulu_list_Deposit_16_e.l16_Deposit_pt_back(i, AR(t2), (FD.array__thaw(U32, D1), th_Deposit_bx(x)))),
          (FD.array__thaw(U32, WX(p, 1n+j, dd, D1, q, r, t)), (AR(t), O.BNone{})), e2,
          Equal.trans(Array<U32> & (Array<O.Boxed<FuluDeposit_d.Deposit>> & O.Boxed<FuluDeposit_d.Deposit>),
            Fulu_list_Deposit_16_e.l16_Deposit_pt(p, U32.add(i, 1), X, Fulu_list_Deposit_16_e.l16_Deposit_pt_ret(FD.array__thaw(U32, D1), Array.swap(O.Boxed<FuluDeposit_d.Deposit>, AR(t2), i, th_Deposit_bx(x)))),
            Fulu_list_Deposit_16_e.l16_Deposit_pt(p, U32.add(i, 1), X, Fulu_list_Deposit_16_e.l16_Deposit_pt_ret(FD.array__thaw(U32, D1), (AR(t), O.BNone{}))),
            (FD.array__thaw(U32, WX(p, 1n+j, dd, D1, q, r, t)), (AR(t), O.BNone{})), e3, rt2)))
      +rest = CATE(p, SL(t), 1n+j)
      +eXn = Equal.trans(Nat, VRX.YP(1n+j, 310n, q, r), Nat.add(Yj, A.quad(310n)), Nat.add(Yj, VRX.LN(Y)), ey,
        Equal.cong(Nat, Nat, z => Nat.add(Yj, z), A.quad(310n), VRX.LN(Y), Equal.sym(Nat, VRX.LN(Y), A.quad(310n), lenEm(x, hx))))
      +byf = Equal.trans(+List<U32>, UA.BYT(WX(p, 1n+j, dd, D1, q, r, t)), UW.SPL(UA.BYT(D1), VRX.YP(1n+j, 310n, q, r), rest), UW.SPL(B0, Yj, VRX.AP(Y, rest)), by2,
        VRX.spl_catx(B0, Yj, Y, rest, VRX.YP(1n+j, 310n, q, r), UA.BYT(D1), hX, eXn, by))
      mk2(1n+p, i, j, X, q, r, dd, D, t, rtf, byf)

def ptx(k: Nat, +i: U32, +j: Nat, +n: Nat, +X: U32, +q: Nat, +r: Nat, +dd: Nat, +D: FD.array__Tree<U32>, +d: Nat, +t: FD.array__Tree<MB<M_Deposit>>, +LT: Nat,
    +ei: {U32.to_nat(i) == j : Nat}, +ek: {Nat.add(j, k) == n : Nat}, +e: {U32.to_nat(X) == Nat.add(A.quad(q), r) : Nat}, +hr: {Nat.is_lt(r, 4n) == True{} : Bool},
    +hd: {Nat.is_lt(dd, 29n) == True{} : Bool}, +pfD: {FD.array__perfect(U32, dd, D) == True{} : Bool},
    +hj: {Nat.is_le(A.quad(Nat.mul(Nat.add(k, j), 310n)), LT) == True{} : Bool},
    +hl: {Nat.is_le(Nat.add(q, WD.NWN(Nat.add(r, LT))), VB.pw(dd)) == True{} : Bool},
    +hz: {VS.bt(A.quad(Nat.mul(k, 310n)), VS.bdr(VRX.YP(j, 310n, q, r), UA.BYT(D))) == UW.ZB(A.quad(Nat.mul(k, 310n))) : +List<U32>},
    +pfA: {FD.array__perfect(MB<M_Deposit>, d, t) == True{} : Bool}, +hda: {Nat.is_lt(d, 31n) == True{} : Bool}, +hn: {Nat.is_le(n, VB.pw(d)) == True{} : Bool},
    +hok: {EOKS(k, SL(t), j) == True{} : Bool})
    -> DK.P2(RTK(k, i, j, X, q, r, dd, D, t), BYK(k, j, q, r, dd, D, t)):
  ptxW(k, i, j, n, X, q, r, dd, D, d, t, LT, ei, ek, e, hr, FD.nat__lt_trans(dd, 29n, 31n, hd, {==}), pfD, hj, hl, VRX.hl32w(q, r, LT, dd, hd, hl), hz, pfA, hda, hn, hok)

# ---- the list's encoder window ---------------------------------------------------------------------

def LL_l16_Deposit(+t: FD.array__Tree<MB<M_Deposit>>, +N: U32) -> Nat: A.quad(Nat.mul(U32.to_nat(N), 310n))
def ENCL_l16_Deposit(+t: FD.array__Tree<MB<M_Deposit>>, +N: U32) -> +List<U32>: CATE(U32.to_nat(N), SL(t), 0n)
def PUTLb_l16_Deposit(b: Bool, +t: FD.array__Tree<MB<M_Deposit>>, +N: U32, +dd: Nat, +D: FD.array__Tree<U32>, +q: Nat, +r: Nat) -> FD.array__Tree<U32>:
  match b:
    case True{}: D
    case False{}: WX(U32.to_nat(N), 0n, dd, D, q, r, t)
def PUTL_l16_Deposit(+t: FD.array__Tree<MB<M_Deposit>>, +N: U32, +dd: Nat, +D: FD.array__Tree<U32>, +q: Nat, +r: Nat) -> FD.array__Tree<U32>: PUTLb_l16_Deposit(U32.is_eq(N, 0), t, N, dd, D, q, r)
def pfLb_l16_Deposit(+b: Bool, +t: FD.array__Tree<MB<M_Deposit>>, +N: U32, +dd: Nat, +D: FD.array__Tree<U32>, +q: Nat, +r: Nat, +pf: {FD.array__perfect(U32, dd, D) == True{} : Bool})
    -> {FD.array__perfect(U32, dd, PUTLb_l16_Deposit(b, t, N, dd, D, q, r)) == True{} : Bool}:
  match b:
    case True{}: pf
    case False{}: pfWX(U32.to_nat(N), 0n, dd, D, q, r, t, pf)

def RTN(+b: Bool, +t: FD.array__Tree<MB<M_Deposit>>, +N: U32, +dd: Nat, +D: FD.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat) -> Data:
  {Fulu_list_Deposit_16_e.l16_Deposit_pt_nz(b, X, N, FD.array__thaw(U32, D), AR(t)) == (FD.array__thaw(U32, PUTLb_l16_Deposit(b, t, N, dd, D, q, r)), THL_l16_Deposit(t, N)) : Array<U32> & Fulu_list_Deposit_16_d.l16_Deposit_Seq}
def BYN(+b: Bool, +t: FD.array__Tree<MB<M_Deposit>>, +N: U32, +dd: Nat, +D: FD.array__Tree<U32>, +q: Nat, +r: Nat) -> Data:
  {UA.BYT(PUTLb_l16_Deposit(b, t, N, dd, D, q, r)) == UW.SPL(UA.BYT(D), Nat.add(A.quad(q), r), ENCL_l16_Deposit(t, N)) : +List<U32>}

# The writer's non-empty test, and its loop.
def ptnzW(+t: FD.array__Tree<MB<M_Deposit>>, +N: U32, +b: Bool, +eb: {U32.is_eq(N, 0) == b : Bool}, +h: {OKL_l16_Deposit(t, N) == True{} : Bool},
    +dd: Nat, +D: FD.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat,
    +e: {U32.to_nat(X) == Nat.add(A.quad(q), r) : Nat}, +hr: {Nat.is_lt(r, 4n) == True{} : Bool}, +hd: {Nat.is_lt(dd, 31n) == True{} : Bool},
    +hl: {Nat.is_le(Nat.add(q, WD.NWN(Nat.add(r, LL_l16_Deposit(t, N)))), VB.pw(dd)) == True{} : Bool}, +hl32: {Nat.is_lt(Nat.add(A.quad(q), Nat.add(r, LL_l16_Deposit(t, N))), FD.spec_common__pow2(32n)) == True{} : Bool}, +pf: {FD.array__perfect(U32, dd, D) == True{} : Bool},
    +hz: {VS.bt(LL_l16_Deposit(t, N), VS.bdr(Nat.add(A.quad(q), r), UA.BYT(D))) == UW.ZB(LL_l16_Deposit(t, N)) : +List<U32>})
    -> DK.P2(RTN(b, t, N, dd, D, X, q, r), BYN(b, t, N, dd, D, q, r)):
  match b:
    case True{}:
      +eN = Equal.cong(U32, Nat, z => U32.to_nat(z), N, 0, FD.u32alg__eq_of(N, 0, eb))
      ({==}, FD.logic__subst(Nat, z => {UA.BYT(D) == UW.SPL(UA.BYT(D), Nat.add(A.quad(q), r), CATE(z, SL(t), 0n)) : +List<U32>}, 0n, U32.to_nat(N), Equal.sym(Nat, U32.to_nat(N), 0n, eN),
        Equal.sym(+List<U32>, UW.SPL(UA.BYT(D), Nat.add(A.quad(q), r), []), UA.BYT(D), VRX.spl_nil(UA.BYT(D), Nat.add(A.quad(q), r)))))
    case False{}:
      +c = U32.to_nat(N)
      +g = ptxW(c, 0, 0n, c, X, q, r, dd, D, TDM(t), t, LL_l16_Deposit(t, N), {==}, {==}, e, hr, hd, pf,
        FD.logic__subst(Nat, z => {Nat.is_le(A.quad(Nat.mul(z, 310n)), LL_l16_Deposit(t, N)) == True{} : Bool}, c, Nat.add(c, 0n), Equal.sym(Nat, Nat.add(c, 0n), c, FD.nat__add_zero(c)), FD.nat__le_refl(LL_l16_Deposit(t, N))), hl, hl32, hz,
        okl_pf(t, N, h), okl_d(t, N, h), okl_n(t, N, h), okl_e(t, N, h))
      +rt = PA(RTK(c, 0, 0n, X, q, r, dd, D, t), BYK(c, 0n, q, r, dd, D, t), g)
      +by = PB(RTK(c, 0, 0n, X, q, r, dd, D, t), BYK(c, 0n, q, r, dd, D, t), g)
      (Equal.cong(Array<U32> & (Array<O.Boxed<FuluDeposit_d.Deposit>> & O.Boxed<FuluDeposit_d.Deposit>), Array<U32> & Fulu_list_Deposit_16_d.l16_Deposit_Seq, z => Fulu_list_Deposit_16_e.l16_Deposit_pt_fin(N, z),
         Fulu_list_Deposit_16_e.l16_Deposit_pt(c, 0, X, (FD.array__thaw(U32, D), (AR(t), O.BNone{}))), (FD.array__thaw(U32, WX(c, 0n, dd, D, q, r, t)), (AR(t), O.BNone{})), rt), by)

def ptnz(+t: FD.array__Tree<MB<M_Deposit>>, +N: U32, +b: Bool, +eb: {U32.is_eq(N, 0) == b : Bool}, +h: {OKL_l16_Deposit(t, N) == True{} : Bool},
    +dd: Nat, +D: FD.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat,
    +e: {U32.to_nat(X) == Nat.add(A.quad(q), r) : Nat}, +hr: {Nat.is_lt(r, 4n) == True{} : Bool}, +hd: {Nat.is_lt(dd, 29n) == True{} : Bool},
    +hl: {Nat.is_le(Nat.add(q, WD.NWN(Nat.add(r, LL_l16_Deposit(t, N)))), VB.pw(dd)) == True{} : Bool}, +pf: {FD.array__perfect(U32, dd, D) == True{} : Bool},
    +hz: {VS.bt(LL_l16_Deposit(t, N), VS.bdr(Nat.add(A.quad(q), r), UA.BYT(D))) == UW.ZB(LL_l16_Deposit(t, N)) : +List<U32>})
    -> DK.P2(RTN(b, t, N, dd, D, X, q, r), BYN(b, t, N, dd, D, q, r)):
  ptnzW(t, N, b, eb, h, dd, D, X, q, r, e, hr, FD.nat__lt_trans(dd, 29n, 31n, hd, {==}), hl, VRX.hl32w(q, r, LL_l16_Deposit(t, N), dd, hd, hl), pf, hz)

def RTL_l16_Deposit(+t: FD.array__Tree<MB<M_Deposit>>, +N: U32, +dd: Nat, +D: FD.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat) -> Data:
  {Fulu_list_Deposit_16_e.l16_Deposit_putk(FD.array__thaw(U32, D), X, THL_l16_Deposit(t, N)) == (FD.array__thaw(U32, PUTL_l16_Deposit(t, N, dd, D, q, r)), (THL_l16_Deposit(t, N), U32.mul(N, 1240))) : Array<U32> & (Fulu_list_Deposit_16_d.l16_Deposit_Seq & U32)}
def BYL_l16_Deposit(+t: FD.array__Tree<MB<M_Deposit>>, +N: U32, +dd: Nat, +D: FD.array__Tree<U32>, +q: Nat, +r: Nat) -> Data:
  {UA.BYT(PUTL_l16_Deposit(t, N, dd, D, q, r)) == UW.SPL(UA.BYT(D), Nat.add(A.quad(q), r), ENCL_l16_Deposit(t, N)) : +List<U32>}
def PFL_l16_Deposit(+t: FD.array__Tree<MB<M_Deposit>>, +N: U32, +dd: Nat, +D: FD.array__Tree<U32>, +q: Nat, +r: Nat) -> Data:
  {FD.array__perfect(U32, dd, PUTL_l16_Deposit(t, N, dd, D, q, r)) == True{} : Bool}

# The runtime's write, with its validity check.
def putk_rt(+t: FD.array__Tree<MB<M_Deposit>>, +N: U32, +h: {OKL_l16_Deposit(t, N) == True{} : Bool}, +dd: Nat, +D: FD.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat,
    +rtb: RTN(U32.is_eq(N, 0), t, N, dd, D, X, q, r)) -> RTL_l16_Deposit(t, N, dd, D, X, q, r):
  %Equal.sym(Fulu_list_Deposit_16_d.l16_Deposit_Seq & Bool, Fulu_list_Deposit_16_e.l16_Deposit_valid(THL_l16_Deposit(t, N)), (THL_l16_Deposit(t, N), True{}), valid_l16_Deposit(t, N, h)) :
    {Fulu_list_Deposit_16_e.l16_Deposit_pk(FD.array__thaw(U32, D), X, _) == (FD.array__thaw(U32, PUTL_l16_Deposit(t, N, dd, D, q, r)), (THL_l16_Deposit(t, N), U32.mul(N, 1240))) : Array<U32> & (Fulu_list_Deposit_16_d.l16_Deposit_Seq & U32)}
  %Equal.sym(Array<U32> & Fulu_list_Deposit_16_d.l16_Deposit_Seq, Fulu_list_Deposit_16_e.l16_Deposit_pt_nz(U32.is_eq(N, 0), X, N, FD.array__thaw(U32, D), AR(t)), (FD.array__thaw(U32, PUTL_l16_Deposit(t, N, dd, D, q, r)), THL_l16_Deposit(t, N)), rtb) :
    {Fulu_list_Deposit_16_e.l16_Deposit_ptn_fin(N, _) == (FD.array__thaw(U32, PUTL_l16_Deposit(t, N, dd, D, q, r)), (THL_l16_Deposit(t, N), U32.mul(N, 1240))) : Array<U32> & (Fulu_list_Deposit_16_d.l16_Deposit_Seq & U32)}
  {==}

def mk3(+t: FD.array__Tree<MB<M_Deposit>>, +N: U32, +dd: Nat, +D: FD.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat,
    +a: RTL_l16_Deposit(t, N, dd, D, X, q, r), +b: BYL_l16_Deposit(t, N, dd, D, q, r), +c: PFL_l16_Deposit(t, N, dd, D, q, r))
    -> DK.P2(RTL_l16_Deposit(t, N, dd, D, X, q, r), DK.P2(BYL_l16_Deposit(t, N, dd, D, q, r), PFL_l16_Deposit(t, N, dd, D, q, r))):
  (a, (b, c))

# putx: the runtime writer at X = 4 q + r is the model PUTL, whose bytes splice the list's bytes
# into D's (its elements write their data bytes only), and whose tree is perfect.
def putx_l16_DepositW(+t: FD.array__Tree<MB<M_Deposit>>, +N: U32, +h: {OKL_l16_Deposit(t, N) == True{} : Bool}, +dd: Nat, +D: FD.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat,
    +e: {U32.to_nat(X) == Nat.add(A.quad(q), r) : Nat}, +hr: {Nat.is_lt(r, 4n) == True{} : Bool}, +hd: {Nat.is_lt(dd, 31n) == True{} : Bool},
    +hl: {Nat.is_le(Nat.add(q, WD.NWN(Nat.add(r, LL_l16_Deposit(t, N)))), VB.pw(dd)) == True{} : Bool}, +hl32: {Nat.is_lt(Nat.add(A.quad(q), Nat.add(r, LL_l16_Deposit(t, N))), FD.spec_common__pow2(32n)) == True{} : Bool}, +pf: {FD.array__perfect(U32, dd, D) == True{} : Bool},
    +hz: {VS.bt(LL_l16_Deposit(t, N), VS.bdr(Nat.add(A.quad(q), r), UA.BYT(D))) == UW.ZB(LL_l16_Deposit(t, N)) : +List<U32>})
    -> DK.P2(RTL_l16_Deposit(t, N, dd, D, X, q, r), DK.P2(BYL_l16_Deposit(t, N, dd, D, q, r), PFL_l16_Deposit(t, N, dd, D, q, r))):
  +b = U32.is_eq(N, 0)
  +g = ptnzW(t, N, b, {==}, h, dd, D, X, q, r, e, hr, hd, hl, hl32, pf, hz)
  +rtb = PA(RTN(b, t, N, dd, D, X, q, r), BYN(b, t, N, dd, D, q, r), g)
  +byb = PB(RTN(b, t, N, dd, D, X, q, r), BYN(b, t, N, dd, D, q, r), g)
  mk3(t, N, dd, D, X, q, r, putk_rt(t, N, h, dd, D, X, q, r, rtb), byb, pfLb_l16_Deposit(b, t, N, dd, D, q, r, pf))

# ---- sizes ----

def putx_l16_Deposit(+t: FD.array__Tree<MB<M_Deposit>>, +N: U32, +h: {OKL_l16_Deposit(t, N) == True{} : Bool}, +dd: Nat, +D: FD.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat,
    +e: {U32.to_nat(X) == Nat.add(A.quad(q), r) : Nat}, +hr: {Nat.is_lt(r, 4n) == True{} : Bool}, +hd: {Nat.is_lt(dd, 29n) == True{} : Bool},
    +hl: {Nat.is_le(Nat.add(q, WD.NWN(Nat.add(r, LL_l16_Deposit(t, N)))), VB.pw(dd)) == True{} : Bool}, +pf: {FD.array__perfect(U32, dd, D) == True{} : Bool},
    +hz: {VS.bt(LL_l16_Deposit(t, N), VS.bdr(Nat.add(A.quad(q), r), UA.BYT(D))) == UW.ZB(LL_l16_Deposit(t, N)) : +List<U32>})
    -> DK.P2(RTL_l16_Deposit(t, N, dd, D, X, q, r), DK.P2(BYL_l16_Deposit(t, N, dd, D, q, r), PFL_l16_Deposit(t, N, dd, D, q, r))):
  putx_l16_DepositW(t, N, h, dd, D, X, q, r, e, hr, FD.nat__lt_trans(dd, 29n, 31n, hd, {==}), hl, VRX.hl32w(q, r, LL_l16_Deposit(t, N), dd, hd, hl), pf, hz)

# The runtime's size pass.
def sizex_l16_Deposit(+t: FD.array__Tree<MB<M_Deposit>>, +N: U32, +h: {OKL_l16_Deposit(t, N) == True{} : Bool}) -> {Fulu_list_Deposit_16_e.l16_Deposit_size(THL_l16_Deposit(t, N)) == (THL_l16_Deposit(t, N), U32.mul(N, 1240)) : Fulu_list_Deposit_16_d.l16_Deposit_Seq & U32}:
  +d = TDM(t)
  %Equal.sym(Array<O.Boxed<FuluDeposit_d.Deposit>> & U32, Array.size(O.Boxed<FuluDeposit_d.Deposit>, AR(t)), (AR(t), FD.u32__pow2u(d)), amsize_l16_Deposit(d, t, okl_pf(t, N, h))) :
    {Fulu_list_Deposit_16_e.l16_Deposit_szf(N, _) == (THL_l16_Deposit(t, N), U32.mul(N, 1240)) : Fulu_list_Deposit_16_d.l16_Deposit_Seq & U32}
  %Equal.sym(Bool, U32.is_le(N, FD.u32__pow2u(d)), True{}, le_cap(t, N, h)) :
    {(THL_l16_Deposit(t, N), O.pick(_, U32.mul(N, 1240), 2147483648)) == (THL_l16_Deposit(t, N), U32.mul(N, 1240)) : Fulu_list_Deposit_16_d.l16_Deposit_Seq & U32}
  {==}

# szx: the size the writer returns is the list's byte count, when the list lies in the tree.
def szx_l16_DepositW(+t: FD.array__Tree<MB<M_Deposit>>, +N: U32, +q: Nat, +r: Nat, +dd: Nat, +hd: {Nat.is_lt(dd, 31n) == True{} : Bool},
    +hl: {Nat.is_le(Nat.add(q, WD.NWN(Nat.add(r, LL_l16_Deposit(t, N)))), VB.pw(dd)) == True{} : Bool}, +hl32: {Nat.is_lt(Nat.add(A.quad(q), Nat.add(r, LL_l16_Deposit(t, N))), FD.spec_common__pow2(32n)) == True{} : Bool}) -> {U32.to_nat(U32.mul(N, 1240)) == LL_l16_Deposit(t, N) : Nat}:
  VRX.mulqW(N, U32.to_nat(N), 1240, 310n, {==}, {==}, FD.logic__subst(Nat, z => {Nat.is_lt(z, FD.spec_common__pow2(32n)) == True{} : Bool}, LL_l16_Deposit(t, N), A.quad(Nat.mul(U32.to_nat(N), 310n)), {==}, VRX.yl32(q, r, LL_l16_Deposit(t, N), hl32)))

# ---- the spec side: the list's value, its parts, one variable part of its bytes ---------------------

def szx_l16_Deposit(+t: FD.array__Tree<MB<M_Deposit>>, +N: U32, +q: Nat, +r: Nat, +dd: Nat, +hd: {Nat.is_lt(dd, 29n) == True{} : Bool},
    +hl: {Nat.is_le(Nat.add(q, WD.NWN(Nat.add(r, LL_l16_Deposit(t, N)))), VB.pw(dd)) == True{} : Bool}) -> {U32.to_nat(U32.mul(N, 1240)) == LL_l16_Deposit(t, N) : Nat}:
  szx_l16_DepositW(t, N, q, r, dd, FD.nat__lt_trans(dd, 29n, 31n, hd, {==}), hl, VRX.hl32w(q, r, LL_l16_Deposit(t, N), dd, hd, hl))

# The values of elements i .. i + c - 1 of W, and their fixed parts.
def ITE(c: Nat, +W: List<&2, MB<M_Deposit>>, +i: Nat) -> S.Value:
  match c:
    case 0n: S.EmptyItems{}
    case 1n+q: S.Items{EVm(xat_l16_Deposit(W, i)), ITE(q, W, 1n+i)}
def FPE(c: Nat, +W: List<&2, MB<M_Deposit>>, +i: Nat) -> +List<S.Part>:
  match c:
    case 0n: []
    case 1n+q: S.Fixed{YEm(xat_l16_Deposit(W, i))} <> FPE(q, W, 1n+i)

law cntE:
  for +c: Nat
  for +W: List<&2, MB<M_Deposit>>
  for +i: Nat
  {Codec.count(ITE(c, W, i)) == c : Nat}
def cntE(c, W, i):
  match c:
    case 0n: {==}
    case 1n+ +q: FD.nat__succ_cong(Codec.count(ITE(q, W, 1n+i)), q, cntE(q, W, 1n+i))

law prtE:
  for +c: Nat
  for +W: List<&2, MB<M_Deposit>>
  for +i: Nat
  for +hok: {EOKS(c, W, i) == True{} : Bool}
  {Codec.parts(ITE(c, W, i), S.Repeat{Spec.Schema56()}) == Some{FPE(c, W, i)} : Maybe<&2, +List<S.Part>>}
def prtE(c, W, i, hok):
  match c:
    case 0n: {==}
    case 1n+ +q:
      +x = xat_l16_Deposit(W, i)
      F.cat_fixed(Codec.parts(EVm(x), Spec.Schema56()), YEm(x), Codec.parts(ITE(q, W, 1n+i), S.Repeat{Spec.Schema56()}), FPE(q, W, 1n+i),
        specEm(x, and_l(EOK(x), EOKS(q, W, 1n+i), hok)), prtE(q, W, 1n+i, and_r(EOK(x), EOKS(q, W, 1n+i), hok)))

law vfE:
  for +c: Nat
  for +W: List<&2, MB<M_Deposit>>
  for +i: Nat
  for +hok: {EOKS(c, W, i) == True{} : Bool}
  {Layout.bytes_valid(FPE(c, W, i)) == True{} : Bool}
def vfE(c, W, i, hok):
  match c:
    case 0n: {==}
    case 1n+ +q:
      +x = xat_l16_Deposit(W, i)
      FD.logic__and_intro(SP.bytes_domain(YEm(x)), Layout.bytes_valid(FPE(q, W, 1n+i)),
        CS.domf(EVm(x), Spec.Schema56(), YEm(x), {==}, specEm(x, and_l(EOK(x), EOKS(q, W, 1n+i), hok))), vfE(q, W, 1n+i, and_r(EOK(x), EOKS(q, W, 1n+i), hok)))

law fsE:
  for +c: Nat
  for +W: List<&2, MB<M_Deposit>>
  for +i: Nat
  {Layout.fixed_size(FPE(c, W, i)) == VCN.LN(CATE(c, W, i)) : Nat}
def fsE(c, W, i):
  match c:
    case 0n: {==}
    case 1n+ +q:
      +Y = YEm(xat_l16_Deposit(W, i))
      Equal.trans(Nat, Nat.add(VCN.LN(Y), Layout.fixed_size(FPE(q, W, 1n+i))), Nat.add(VCN.LN(Y), VCN.LN(CATE(q, W, 1n+i))), VCN.LN(VCN.AP(Y, CATE(q, W, 1n+i))),
        Equal.cong(Nat, Nat, z => Nat.add(VCN.LN(Y), z), Layout.fixed_size(FPE(q, W, 1n+i)), VCN.LN(CATE(q, W, 1n+i)), fsE(q, W, 1n+i)),
        Equal.sym(Nat, VCN.LN(VCN.AP(Y, CATE(q, W, 1n+i))), Nat.add(VCN.LN(Y), VCN.LN(CATE(q, W, 1n+i))), VCN.len_app(Y, CATE(q, W, 1n+i))))

law fpE:
  for +c: Nat
  for +W: List<&2, MB<M_Deposit>>
  for +i: Nat
  for +off: Nat
  {Layout.fixed_parts(FPE(c, W, i), off) == CATE(c, W, i) : +List<U32>}
def fpE(c, W, i, off):
  match c:
    case 0n: {==}
    case 1n+ +q:
      Equal.cong(+List<U32>, +List<U32>, z => List.append(&2, U32, YEm(xat_l16_Deposit(W, i)), z), Layout.fixed_parts(FPE(q, W, 1n+i), off), CATE(q, W, 1n+i), fpE(q, W, 1n+i, off))

law pyE:
  for +c: Nat
  for +W: List<&2, MB<M_Deposit>>
  for +i: Nat
  {Layout.payloads(FPE(c, W, i)) == [] : +List<U32>}
def pyE(c, W, i):
  match c:
    case 0n: {==}
    case 1n+ +q: pyE(q, W, 1n+i)

# The elements' bytes: 1240 each (an absent element's bytes are 1240 zero bytes).
law lenC:
  for +c: Nat
  for +W: List<&2, MB<M_Deposit>>
  for +i: Nat
  {VCN.LN(CATE(c, W, i)) == A.quad(Nat.mul(c, 310n)) : Nat}
def lenC(c, W, i):
  match c:
    case 0n: {==}
    case 1n+ +q:
      +x = xat_l16_Deposit(W, i)
      +Y = YEm(x)
      %Equal.sym(Nat, VCN.LN(VCN.AP(Y, CATE(q, W, 1n+i))), Nat.add(VCN.LN(Y), VCN.LN(CATE(q, W, 1n+i))), VCN.len_app(Y, CATE(q, W, 1n+i))) :
        {_ == A.quad(Nat.mul(1n+q, 310n)) : Nat}
      %Equal.sym(Nat, VCN.LN(Y), 1240n, lenEz(x)) : {Nat.add(_, VCN.LN(CATE(q, W, 1n+i))) == A.quad(Nat.mul(1n+q, 310n)) : Nat}
      %Equal.sym(Nat, VCN.LN(CATE(q, W, 1n+i)), A.quad(Nat.mul(q, 310n)), lenC(q, W, 1n+i)) : {Nat.add(1240n, _) == A.quad(Nat.mul(1n+q, 310n)) : Nat}
      {==}

# The layout of the elements' fixed parts is their bytes.
def encE(+c: Nat, +W: List<&2, MB<M_Deposit>>, +hok: {EOKS(c, W, 0n) == True{} : Bool}, +fit: {N.fits(4n, VCN.LN(CATE(c, W, 0n))) == True{} : Bool})
    -> {Layout.encoding(FPE(c, W, 0n)) == Some{CATE(c, W, 0n)} : Maybe<&2, +List<U32>>}:
  +ps = FPE(c, W, 0n)
  +Y = CATE(c, W, 0n)
  %Equal.sym(Bool, Layout.bytes_valid(ps), True{}, vfE(c, W, 0n, hok)) :
    {SP.optional(Bool.and(_, N.fits(4n, Nat.add(Layout.fixed_size(ps), List.length(&2, U32, Layout.payloads(ps))))), List.append(&2, U32, Layout.fixed_parts(ps, Layout.fixed_size(ps)), Layout.payloads(ps))) == Some{Y} : Maybe<&2, +List<U32>>}
  %Equal.sym(+List<U32>, Layout.payloads(ps), [], pyE(c, W, 0n)) :
    {SP.optional(Bool.and(True{}, N.fits(4n, Nat.add(Layout.fixed_size(ps), List.length(&2, U32, _)))), List.append(&2, U32, Layout.fixed_parts(ps, Layout.fixed_size(ps)), _)) == Some{Y} : Maybe<&2, +List<U32>>}
  %Equal.sym(Nat, Layout.fixed_size(ps), VCN.LN(Y), fsE(c, W, 0n)) :
    {SP.optional(Bool.and(True{}, N.fits(4n, Nat.add(_, List.length(&2, U32, [])))), List.append(&2, U32, Layout.fixed_parts(ps, _), [])) == Some{Y} : Maybe<&2, +List<U32>>}
  %Equal.sym(+List<U32>, Layout.fixed_parts(ps, VCN.LN(Y)), Y, fpE(c, W, 0n, VCN.LN(Y))) :
    {SP.optional(Bool.and(True{}, N.fits(4n, Nat.add(VCN.LN(Y), List.length(&2, U32, [])))), List.append(&2, U32, _, [])) == Some{Y} : Maybe<&2, +List<U32>>}
  %Equal.sym(Nat, Nat.add(VCN.LN(Y), List.length(&2, U32, [])), VCN.LN(Y), FD.nat__add_zero(VCN.LN(Y))) :
    {SP.optional(Bool.and(True{}, N.fits(4n, _)), List.append(&2, U32, Y, [])) == Some{Y} : Maybe<&2, +List<U32>>}
  %Equal.sym(Bool, N.fits(4n, VCN.LN(Y)), True{}, fit) :
    {SP.optional(Bool.and(True{}, _), List.append(&2, U32, Y, [])) == Some{Y} : Maybe<&2, +List<U32>>}
  %Equal.sym(+List<U32>, List.append(&2, U32, Y, []), Y, VS.app_nil(Y)) :
    {SP.optional(Bool.and(True{}, True{}), _) == Some{Y} : Maybe<&2, +List<U32>>}
  {==}

# c elements, at most 16: one variable part, their bytes.
def lpartE(+c: Nat, +W: List<&2, MB<M_Deposit>>, +hok: {EOKS(c, W, 0n) == True{} : Bool}, +hl: {Nat.is_le(c, 16n) == True{} : Bool},
    +fit: {N.fits(4n, VCN.LN(CATE(c, W, 0n))) == True{} : Bool})
    -> {Codec.parts(S.Sequence{ITE(c, W, 0n)}, Spec.Schema100()) == Some{[S.Variable{CATE(c, W, 0n)}]} : Maybe<&2, +List<S.Part>>}:
  %Equal.sym(Nat, Codec.count(ITE(c, W, 0n)), c, cntE(c, W, 0n)) :
    {Codec.require(Nat.is_le(_, 16n), Codec.aggregate(Codec.parts(ITE(c, W, 0n), S.Repeat{Spec.Schema56()}), None{})) == Some{[S.Variable{CATE(c, W, 0n)}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(Bool, Nat.is_le(c, 16n), True{}, hl) :
    {Codec.require(_, Codec.aggregate(Codec.parts(ITE(c, W, 0n), S.Repeat{Spec.Schema56()}), None{})) == Some{[S.Variable{CATE(c, W, 0n)}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(Maybe<&2, +List<S.Part>>, Codec.parts(ITE(c, W, 0n), S.Repeat{Spec.Schema56()}), Some{FPE(c, W, 0n)}, prtE(c, W, 0n, hok)) :
    {Codec.require(True{}, Codec.aggregate(_, None{})) == Some{[S.Variable{CATE(c, W, 0n)}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(Maybe<&2, +List<U32>>, Layout.encoding(FPE(c, W, 0n)), Some{CATE(c, W, 0n)}, encE(c, W, hok, fit)) :
    {Codec.one(_, None{}) == Some{[S.Variable{CATE(c, W, 0n)}]} : Maybe<&2, +List<S.Part>>}
  {==}

# The list's value and its bytes' length.
def VALL_l16_Deposit(+t: FD.array__Tree<MB<M_Deposit>>, +N: U32) -> S.Value: S.Sequence{ITE(U32.to_nat(N), SL(t), 0n)}
def len_encl_l16_Deposit(+t: FD.array__Tree<MB<M_Deposit>>, +N: U32) -> {List.length(&2, U32, ENCL_l16_Deposit(t, N)) == LL_l16_Deposit(t, N) : Nat}:
  lenC(U32.to_nat(N), SL(t), 0n)

# encx_spec: the list's value has its bytes as one variable part, when they fit a tree of depth dx < 30.
def encx_spec_l16_Deposit(+t: FD.array__Tree<MB<M_Deposit>>, +N: U32, +h: {OKL_l16_Deposit(t, N) == True{} : Bool}, +dx: Nat, +hdx: {Nat.is_lt(dx, 30n) == True{} : Bool},
    +hL: {Nat.is_le(LL_l16_Deposit(t, N), A.quad(VB.pw(dx))) == True{} : Bool})
    -> {Codec.parts(VALL_l16_Deposit(t, N), Spec.Schema100()) == Some{[S.Variable{ENCL_l16_Deposit(t, N)}]} : Maybe<&2, +List<S.Part>>}:
  +hlim = FD.logic__subst(Bool, z => {z == True{} : Bool}, U32.is_le(N, 16), Nat.is_le(U32.to_nat(N), U32.to_nat(16)), VU.le_u32(N, 16), okl_lim(t, N, h))
  +fit = FD.logic__subst(Nat, z => {N.fits(4n, z) == True{} : Bool}, LL_l16_Deposit(t, N), List.length(&2, U32, ENCL_l16_Deposit(t, N)), Equal.sym(Nat, List.length(&2, U32, ENCL_l16_Deposit(t, N)), LL_l16_Deposit(t, N), len_encl_l16_Deposit(t, N)),
    VBZ.fitq(dx, LL_l16_Deposit(t, N), hL, hdx))
  lpartE(U32.to_nat(N), SL(t), okl_e(t, N, h), hlim, fit)

# szx_l16_Deposit with its bytes below 2^32 (no tree): the OKW twins' size.
def szxB_l16_Deposit(+t: FD.array__Tree<MB<M_Deposit>>, +N: U32, +h32: {Nat.is_lt(LL_l16_Deposit(t, N), FD.spec_common__pow2(32n)) == True{} : Bool}) -> {U32.to_nat(U32.mul(N, 1240)) == LL_l16_Deposit(t, N) : Nat}:
  VRX.mulqW(N, U32.to_nat(N), 1240, 310n, {==}, {==}, FD.logic__subst(Nat, z => {Nat.is_lt(z, FD.spec_common__pow2(32n)) == True{} : Bool}, LL_l16_Deposit(t, N), A.quad(Nat.mul(U32.to_nat(N), 310n)), {==}, h32))

def encx_spec_l16_DepositB(+t: FD.array__Tree<MB<M_Deposit>>, +N: U32, +h: {OKL_l16_Deposit(t, N) == True{} : Bool}, +B: Nat, +hB: {Nat.is_lt(B, VB.pw(31n)) == True{} : Bool},
    +hL: {Nat.is_le(LL_l16_Deposit(t, N), B) == True{} : Bool})
    -> {Codec.parts(VALL_l16_Deposit(t, N), Spec.Schema100()) == Some{[S.Variable{ENCL_l16_Deposit(t, N)}]} : Maybe<&2, +List<S.Part>>}:
  +hlim = FD.logic__subst(Bool, z => {z == True{} : Bool}, U32.is_le(N, 16), Nat.is_le(U32.to_nat(N), U32.to_nat(16)), VU.le_u32(N, 16), okl_lim(t, N, h))
  +fit = FD.logic__subst(Nat, z => {N.fits(4n, z) == True{} : Bool}, LL_l16_Deposit(t, N), List.length(&2, U32, ENCL_l16_Deposit(t, N)), Equal.sym(Nat, List.length(&2, U32, ENCL_l16_Deposit(t, N)), LL_l16_Deposit(t, N), len_encl_l16_Deposit(t, N)),
    VBZ.fitsB(LL_l16_Deposit(t, N), B, hL, hB))
  lpartE(U32.to_nat(N), SL(t), okl_e(t, N, h), hlim, fit)
