  for +hi: {Nat.is_lt(i, FD.spec_common__length(MB<M_Deposit>, W)) == True{} : Bool}
  {FD.spec_common__nth(MB<M_Deposit>, W, i) == Some{xat_l16_Deposit(W, i)} : Maybe<&2, MB<M_Deposit>>}
def nth_l16_Deposit(W, i, hi):
  match W:
    case Nil{}: Empty.absurd({FD.spec_common__nth(MB<M_Deposit>, Nil{}, i) == Some{xat_l16_Deposit(Nil{}, i)} : Maybe<&2, MB<M_Deposit>>}, MD.false_true(Equal.trans(Bool, False{}, Nat.is_lt(i, 0n), True{}, Equal.sym(Bool, Nat.is_lt(i, 0n), False{}, FD.nat__not_lt_zero(i)), hi)))
    case Con{+x, +t}:
      match i:
        case 0n: {==}
        case 1n+ +j: nth_l16_Deposit(t, j, hi)

# ---- DepositData: its 46 words, value, parts and writer ----

