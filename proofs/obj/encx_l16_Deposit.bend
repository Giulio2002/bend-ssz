# ---- Deposit: its writer on the mirror ----

def TDW(t: FD.array__Tree<U32>) -> Nat:
  match t:
    case FD.TLeaf{x}: 0n
    case FD.TNode{l, r}: 1n+TDW(l)
# The proof's storage: a perfect tree of depth < 28 with room for its 264 words, 1056 bytes.
def OKW(+t: FD.array__Tree<U32>, +n: U32) -> Bool: Bool.and(Nat.is_lt(TDW(t), 28n), Bool.and(FD.array__perfect(U32, TDW(t), t), Bool.and(Nat.is_le(264n, VB.pw(TDW(t))), U32.is_eq(n, 1056))))
def okw_d(+t: FD.array__Tree<U32>, +n: U32, +h: {OKW(t, n) == True{} : Bool}) -> {Nat.is_lt(TDW(t), 28n) == True{} : Bool}:
  and_l(Nat.is_lt(TDW(t), 28n), Bool.and(FD.array__perfect(U32, TDW(t), t), Bool.and(Nat.is_le(264n, VB.pw(TDW(t))), U32.is_eq(n, 1056))), h)
def okw_1(+t: FD.array__Tree<U32>, +n: U32, +h: {OKW(t, n) == True{} : Bool}) -> {Bool.and(FD.array__perfect(U32, TDW(t), t), Bool.and(Nat.is_le(264n, VB.pw(TDW(t))), U32.is_eq(n, 1056))) == True{} : Bool}:
  and_r(Nat.is_lt(TDW(t), 28n), Bool.and(FD.array__perfect(U32, TDW(t), t), Bool.and(Nat.is_le(264n, VB.pw(TDW(t))), U32.is_eq(n, 1056))), h)
def okw_pf(+t: FD.array__Tree<U32>, +n: U32, +h: {OKW(t, n) == True{} : Bool}) -> {FD.array__perfect(U32, TDW(t), t) == True{} : Bool}:
  and_l(FD.array__perfect(U32, TDW(t), t), Bool.and(Nat.is_le(264n, VB.pw(TDW(t))), U32.is_eq(n, 1056)), okw_1(t, n, h))
def okw_2(+t: FD.array__Tree<U32>, +n: U32, +h: {OKW(t, n) == True{} : Bool}) -> {Bool.and(Nat.is_le(264n, VB.pw(TDW(t))), U32.is_eq(n, 1056)) == True{} : Bool}:
  and_r(FD.array__perfect(U32, TDW(t), t), Bool.and(Nat.is_le(264n, VB.pw(TDW(t))), U32.is_eq(n, 1056)), okw_1(t, n, h))
def okw_room(+t: FD.array__Tree<U32>, +n: U32, +h: {OKW(t, n) == True{} : Bool}) -> {Nat.is_le(264n, VB.pw(TDW(t))) == True{} : Bool}:
  and_l(Nat.is_le(264n, VB.pw(TDW(t))), U32.is_eq(n, 1056), okw_2(t, n, h))
def okw_n(+t: FD.array__Tree<U32>, +n: U32, +h: {OKW(t, n) == True{} : Bool}) -> {n == 1056 : U32}:
  FD.u32alg__eq_of(n, 1056, and_r(Nat.is_le(264n, VB.pw(TDW(t))), U32.is_eq(n, 1056), okw_2(t, n, h)))
# its bytes fit its tree: 1056 <= 4 2^d
def okw_hn(+t: FD.array__Tree<U32>, +n: U32, +h: {OKW(t, n) == True{} : Bool}) -> {Nat.is_le(1056n, A.quad(VB.pw(TDW(t)))) == True{} : Bool}:
  VCN.VME4(264n, VB.pw(TDW(t)), okw_room(t, n, h))

def OKE(+v: M_Deposit) -> Bool:
  match v:
    case M_Deposit{+a0, +a1}:
      match a0:
        case WMr{+t, +n}: OKW(t, n)
def EOK(+m: MB<M_Deposit>) -> Bool:
  match m:
    case MNone{}: False{}
    case MSome{+v}: OKE(v)
def TW(+v: M_Deposit) -> FD.array__Tree<U32>:
  match v:
    case M_Deposit{+a0, +a1}:
      match a0:
        case WMr{+t, +n}: t
def PXE(+v: M_Deposit, +dd: Nat, +D: FD.array__Tree<U32>, +q: Nat, +r: Nat) -> FD.array__Tree<U32>:
  match v:
    case M_Deposit{+a0, +a1}:
      match a0:
        case WMr{+t, +n}: PXo_DepositData(a1, dd, WD.PWM(r, dd, D, q, t, 1056), Nat.add(264n, q), r)
def YE(+v: M_Deposit) -> +List<U32>:
  match v:
    case M_Deposit{+a0, +a1}:
      match a0:
        case WMr{+t, +n}: VCN.CAT([VCN.PC(1056n, VS.bt(1056n, F.limbs(UW.SLW(t)))), VCN.PC(184n, F.limbs(RWD_DepositData(a1)))])
def lenE0(+v: M_Deposit) -> {VRX.LN(YE(v)) == 1240n : Nat}:
  match v:
    case M_Deposit{+a0, +a1}:
      match a0:
        case WMr{+t, +n}: {==}
def lenE(+v: M_Deposit, +h: {OKE(v) == True{} : Bool}) -> {VRX.LN(YE(v)) == 1240n : Nat}: lenE0(v)
def pfE(+v: M_Deposit, +dd: Nat, +D: FD.array__Tree<U32>, +q: Nat, +r: Nat, +pf: {FD.array__perfect(U32, dd, D) == True{} : Bool})
    -> {FD.array__perfect(U32, dd, PXE(v, dd, D, q, r)) == True{} : Bool}:
  match v:
    case M_Deposit{+a0, +a1}:
      match a0:
        case WMr{+t, +n}: pfo_DepositData(a1, dd, WD.PWM(r, dd, D, q, t, 1056), Nat.add(264n, q), r, WD.pwm_perfect(r, dd, D, q, t, 1056, pf))

# The proof's validity check, for its 1056 bytes.
def wvalid(+t: FD.array__Tree<U32>, +n: U32, +h: {OKW(t, n) == True{} : Bool}) -> {Fulu_vec_bytevec_32_33_e.v33_b32_valid(O.Words{FD.array__thaw(U32, t), 1056}) == (O.Words{FD.array__thaw(U32, t), 1056}, True{}) : O.Words & Bool}:
  +d = TDW(t)
  +hd = okw_d(t, n, h)
  VBE.words_ok_b(d, t, 1056, 1056, 1056, VL.KK(d), okw_pf(t, n, h), FD.nat__lt_trans(d, 28n, 31n, hd, {==}), VL.kk_lt(d, hd), VL.hyn(d, 1056, okw_hn(t, n, h)),
    {==}, {==}, okw_room(t, n, h), {==}, 32, {==})

def validE(+v: M_Deposit, +h: {OKE(v) == True{} : Bool}) -> {FuluDeposit_e.Deposit_valid(th_Deposit(v)) == (th_Deposit(v), True{}) : FuluDeposit_d.Deposit & Bool}:
  match v:
    case M_Deposit{+a0, +a1}:
      match a0:
        case WMr{+t, +n}:
          %Equal.sym(U32, n, 1056, okw_n(t, n, h)) : {FuluDeposit_e.Deposit_valid(FuluDeposit_d.Deposit{O.Words{FD.array__thaw(U32, t), _}, O.BSome{a1, O.BNone{}}}) == (FuluDeposit_d.Deposit{O.Words{FD.array__thaw(U32, t), _}, O.BSome{a1, O.BNone{}}}, True{}) : FuluDeposit_d.Deposit & Bool}
          %Equal.sym(O.Words & Bool, Fulu_vec_bytevec_32_33_e.v33_b32_valid(O.Words{FD.array__thaw(U32, t), 1056}), (O.Words{FD.array__thaw(U32, t), 1056}, True{}), wvalid(t, n, h)) :
            {FuluDeposit_e.Deposit_va0(O.BSome{a1, O.BNone{}}, True{}, _) == (FuluDeposit_d.Deposit{O.Words{FD.array__thaw(U32, t), 1056}, O.BSome{a1, O.BNone{}}}, True{}) : FuluDeposit_d.Deposit & Bool}
          {==}

def RTE(+v: M_Deposit, +dd: Nat, +D: FD.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat) -> Data:
  {FuluDeposit_e.Deposit_put(FD.array__thaw(U32, D), X, th_Deposit(v)) == (FD.array__thaw(U32, PXE(v, dd, D, q, r)), th_Deposit(v)) : Array<U32> & FuluDeposit_d.Deposit}
def BYE(+v: M_Deposit, +dd: Nat, +D: FD.array__Tree<U32>, +q: Nat, +r: Nat) -> Data:
  {UA.BYT(PXE(v, dd, D, q, r)) == UW.SPL(UA.BYT(D), Nat.add(A.quad(q), r), YE(v)) : +List<U32>}
def mkE(+v: M_Deposit, +dd: Nat, +D: FD.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat, +a: RTE(v, dd, D, X, q, r), +b: BYE(v, dd, D, q, r)) -> DK.P2(RTE(v, dd, D, X, q, r), BYE(v, dd, D, q, r)):
  (a, b)

# With the proof's length n, then 1056 (its storage t).
def RTEn(+t: FD.array__Tree<U32>, +n: U32, +a1: FuluDepositData_d.DepositData, +dd: Nat, +D: FD.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat) -> Data:
  {FuluDeposit_e.Deposit_put(FD.array__thaw(U32, D), X, FuluDeposit_d.Deposit{O.Words{FD.array__thaw(U32, t), n}, O.BSome{a1, O.BNone{}}}) == (FD.array__thaw(U32, PXo_DepositData(a1, dd, WD.PWM(r, dd, D, q, t, 1056), Nat.add(264n, q), r)), FuluDeposit_d.Deposit{O.Words{FD.array__thaw(U32, t), n}, O.BSome{a1, O.BNone{}}}) : Array<U32> & FuluDeposit_d.Deposit}
def RTE1(+t: FD.array__Tree<U32>, +a1: FuluDepositData_d.DepositData, +dd: Nat, +D: FD.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat) -> Data:
