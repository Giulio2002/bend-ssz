# ---- Deposit: its writer on the mirror ----

def TDW(t: FD.array__Tree<U32>) -> Nat:
  match t:
    case FD.TLeaf{x}: 0n
    case FD.TNode{l, r}: 1n+TDW(l)
# The proof's storage: a perfect tree of depth < 28 with room for its 264 words, 1056 bytes.
def OKW(+t: FD.array__Tree<U32>, +n: U32) -> Bool: Bool.and(Nat.is_lt(TDW(t), 28n), Bool.and(FD.array__perfect(U32, TDW(t), t), Bool.and(Nat.is_le(264n, VB.pw(TDW(t))), U32.is_eq(n, 1056))))
def okw_d(+t: FD.array__Tree<U32>, +n: U32, +h: {OKW(t, n) == True{} : Bool}) -> {Nat.is_lt(TDW(t), 28n) == True{} : Bool}:
  and_l(Nat.is_lt(TDW(t), 28n), Bool.and(FD.array__perfect(U32, TDW(t), t), Bool.and(Nat.is_le(264n, VB.pw(TDW(t))), U32.is_eq(n, 1056))), h)
def okw_1(+t: FD.array__Tree<U32>, +n: U32, +h: {OKW(t, n) == True{} : Bool}) -> {Bool.and(FD.array__perfect(U32, TDW(t), t), Bool.and(Nat.is_le(264n, VB.pw(TDW(t))), U32.is_eq(n, 1056))) == True{} : Bool}:
  and_r(Nat.is_lt(TDW(t), 28n), Bool.and(FD.array__perfect(U32, TDW(t), t), Bool.and(Nat.is_le(264n, VB.pw(TDW(t))), U32.is_eq(n, 1056))), h)
def okw_pf(+t: FD.array__Tree<U32>, +n: U32, +h: {OKW(t, n) == True{} : Bool}) -> {FD.array__perfect(U32, TDW(t), t) == True{} : Bool}:
  and_l(FD.array__perfect(U32, TDW(t), t), Bool.and(Nat.is_le(264n, VB.pw(TDW(t))), U32.is_eq(n, 1056)), okw_1(t, n, h))
def okw_2(+t: FD.array__Tree<U32>, +n: U32, +h: {OKW(t, n) == True{} : Bool}) -> {Bool.and(Nat.is_le(264n, VB.pw(TDW(t))), U32.is_eq(n, 1056)) == True{} : Bool}:
  and_r(FD.array__perfect(U32, TDW(t), t), Bool.and(Nat.is_le(264n, VB.pw(TDW(t))), U32.is_eq(n, 1056)), okw_1(t, n, h))
def okw_room(+t: FD.array__Tree<U32>, +n: U32, +h: {OKW(t, n) == True{} : Bool}) -> {Nat.is_le(264n, VB.pw(TDW(t))) == True{} : Bool}:
  and_l(Nat.is_le(264n, VB.pw(TDW(t))), U32.is_eq(n, 1056), okw_2(t, n, h))
def okw_n(+t: FD.array__Tree<U32>, +n: U32, +h: {OKW(t, n) == True{} : Bool}) -> {n == 1056 : U32}:
  FD.u32alg__eq_of(n, 1056, and_r(Nat.is_le(264n, VB.pw(TDW(t))), U32.is_eq(n, 1056), okw_2(t, n, h)))
# its bytes fit its tree: 1056 <= 4 2^d
def okw_hn(+t: FD.array__Tree<U32>, +n: U32, +h: {OKW(t, n) == True{} : Bool}) -> {Nat.is_le(1056n, A.quad(VB.pw(TDW(t)))) == True{} : Bool}:
  VCN.VME4(264n, VB.pw(TDW(t)), okw_room(t, n, h))

def OKE(+v: M_Deposit) -> Bool:
  match v:
    case M_Deposit{+a0, +a1}:
      match a0:
        case WMr{+t, +n}: OKW(t, n)
def EOK(+m: MB<M_Deposit>) -> Bool:
  match m:
    case MNone{}: False{}
    case MSome{+v}: OKE(v)
def TW(+v: M_Deposit) -> FD.array__Tree<U32>:
  match v:
    case M_Deposit{+a0, +a1}:
      match a0:
        case WMr{+t, +n}: t
def PXE(+v: M_Deposit, +dd: Nat, +D: FD.array__Tree<U32>, +q: Nat, +r: Nat) -> FD.array__Tree<U32>:
  match v:
    case M_Deposit{+a0, +a1}:
      match a0:
        case WMr{+t, +n}: PXo_DepositData(a1, dd, WD.PWM(r, dd, D, q, t, 1056), Nat.add(264n, q), r)
def YE(+v: M_Deposit) -> +List<U32>:
  match v:
    case M_Deposit{+a0, +a1}:
      match a0:
        case WMr{+t, +n}: VCN.CAT([VCN.PC(1056n, VS.bt(1056n, F.limbs(UW.SLW(t)))), VCN.PC(184n, F.limbs(RWD_DepositData(a1)))])
def lenE(+v: M_Deposit, +h: {OKE(v) == True{} : Bool}) -> {VRX.LN(YE(v)) == 1240n : Nat}:
  match v:
    case M_Deposit{+a0, +a1}:
      match a0:
        case WMr{+t, +n}: {==}
def pfE(+v: M_Deposit, +dd: Nat, +D: FD.array__Tree<U32>, +q: Nat, +r: Nat, +pf: {FD.array__perfect(U32, dd, D) == True{} : Bool})
