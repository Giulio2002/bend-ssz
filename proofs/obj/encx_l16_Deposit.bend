            Equal.sym(+List<U32>, VCN.PC(1056n, VS.bt(1056n, F.limbs(UW.SLW(t)))), VS.bt(1056n, F.limbs(UW.SLW(t))), VCN.pc_id(1056n, VS.bt(1056n, F.limbs(UW.SLW(t))), VS.bt_len(1056n, F.limbs(UW.SLW(t)), h1056))))
