def OBJ(+t: FD.array__Tree<U32>, +n: U32) -> FuluIndexedAttestation_d.IndexedAttestation: FuluIndexedAttestation_d.IndexedAttestation{O.Words{FD.array__thaw(U32, VB.mone(VC.NW(LL(n)), 57n, 0n, DZ(n), VC.ZT(DZ(n)), t)), LL(n)}, FuluAttestationData_d.AttestationData{O.U64{VB.slot(t, 1n), VB.slot(t, 2n)}, O.U64{VB.slot(t, 3n), VB.slot(t, 4n)}, FuluBytes32_d.Bytes32{VB.slot(t, 5n), VB.slot(t, 6n), VB.slot(t, 7n), VB.slot(t, 8n), VB.slot(t, 9n), VB.slot(t, 10n), VB.slot(t, 11n), VB.slot(t, 12n)}, FuluCheckpoint_d.Checkpoint{O.U64{VB.slot(t, 13n), VB.slot(t, 14n)}, FuluBytes32_d.Bytes32{VB.slot(t, 15n), VB.slot(t, 16n), VB.slot(t, 17n), VB.slot(t, 18n), VB.slot(t, 19n), VB.slot(t, 20n), VB.slot(t, 21n), VB.slot(t, 22n)}}, FuluCheckpoint_d.Checkpoint{O.U64{VB.slot(t, 23n), VB.slot(t, 24n)}, FuluBytes32_d.Bytes32{VB.slot(t, 25n), VB.slot(t, 26n), VB.slot(t, 27n), VB.slot(t, 28n), VB.slot(t, 29n), VB.slot(t, 30n), VB.slot(t, 31n), VB.slot(t, 32n)}}}, FuluBytes96_d.Bytes96{VB.slot(t, 33n), VB.slot(t, 34n), VB.slot(t, 35n), VB.slot(t, 36n), VB.slot(t, 37n), VB.slot(t, 38n), VB.slot(t, 39n), VB.slot(t, 40n), VB.slot(t, 41n), VB.slot(t, 42n), VB.slot(t, 43n), VB.slot(t, 44n), VB.slot(t, 45n), VB.slot(t, 46n), VB.slot(t, 47n), VB.slot(t, 48n), VB.slot(t, 49n), VB.slot(t, 50n), VB.slot(t, 51n), VB.slot(t, 52n), VB.slot(t, 53n), VB.slot(t, 54n), VB.slot(t, 55n), VB.slot(t, 56n)}}

def chk_a(+a: Bool, +b: Bool, +c: Bool, +h: {chk3(a, b, c) == True{} : Bool}) -> {a == True{} : Bool}:
  match a:
    case False{}: h
    case True{}: {==}

def chk_b(+a: Bool, +b: Bool, +c: Bool, +h: {chk3(a, b, c) == True{} : Bool}) -> {b == True{} : Bool}:
  match a b:
    case False{} _: Empty.absurd({b == True{} : Bool}, FD.logic__false_true(h))
    case True{} False{}: h
    case True{} True{}: {==}

def chk_c(+a: Bool, +b: Bool, +c: Bool, +h: {chk3(a, b, c) == True{} : Bool}) -> {c == True{} : Bool}:
  match a b:
    case False{} _: Empty.absurd({c == True{} : Bool}, FD.logic__false_true(h))
    case True{} False{}: Empty.absurd({c == True{} : Bool}, FD.logic__false_true(h))
    case True{} True{}: h

def acc_go(+d: Nat, +t: FD.array__Tree<U32>, +n: U32,
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hd: {Nat.is_lt(d, 29n) == True{} : Bool},
    +hn: {Nat.is_le(U32.to_nat(n), A.quad(VB.pw(d))) == True{} : Bool},
    +hchk: {CHK(t, n) == True{} : Bool},
    +ha: {U32.is_le(228, n) == True{} : Bool}, +epo: {SPO(t) == 228 : U32}, +hc: {whole(LL(n)) == True{} : Bool})
    -> {FuluIndexedAttestation_r.IndexedAttestation_decode(BF(t, n), n) == (BF(t, n), Some{OBJ(t, n)}) : B.Buf & Maybe<&1, FuluIndexedAttestation_d.IndexedAttestation>}:
  +hs0 = hs(d, n, hd, ha, hn, hc)
  +hd31 = FD.nat__lt_trans(d, 29n, 31n, hd, {==})
  +hz = hdzK(d, n, hd, ha, hn, hc)
  +ez = zeros_at(B.words_depth_u(VC.WZ(LL(n))), DZ(n), VD.wdu(VC.WZ(LL(n))), FD.nat__le_trans(DZ(n), 19n, 19n, hz, {==}))
  %Equal.sym(B.Buf & Bool, FuluIndexedAttestation_r.IndexedAttestation_ok(BF(t, n), 0, n), (BF(t, n), CHK(t, n)), ok_eval(d, t, n, VB.lt32(d, hd31), hk(0n, d, n, {==}, hs0), pf)) :
    {FuluIndexedAttestation_r.IndexedAttestation_built(n, _) == (BF(t, n), Some{OBJ(t, n)}) : B.Buf & Maybe<&1, FuluIndexedAttestation_d.IndexedAttestation>}
  %Equal.sym(Bool, CHK(t, n), True{}, hchk) :
    {FuluIndexedAttestation_r.IndexedAttestation_built(n, (BF(t, n), _)) == (BF(t, n), Some{OBJ(t, n)}) : B.Buf & Maybe<&1, FuluIndexedAttestation_d.IndexedAttestation>}
  %Equal.sym(B.Buf & FuluIndexedAttestation_d.IndexedAttestation, FuluIndexedAttestation_r.IndexedAttestation_read(BF(t, n), 0, n), (BF(t, n), OBJ(t, n)),
      rd_ok(d, t, n, DZ(n), pf, hd, FD.nat__le_lt_trans(DZ(n), 19n, 31n, hz, {==}), hs0, epo, ez, VC.and3_x8(LL(n), CQ(n), eLc(n, hc)), hr(d, n, hd, ha, hn, hc))) :
    {FuluIndexedAttestation_r.IndexedAttestation_some(_) == (BF(t, n), Some{OBJ(t, n)}) : B.Buf & Maybe<&1, FuluIndexedAttestation_d.IndexedAttestation>}
  {==}

# Every buffer the validator accepts decodes to OBJ(t, n).
law decode_accept:
  for +d: Nat
  for +t: FD.array__Tree<U32>
  for +n: U32
  for +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}
  for +hd: {Nat.is_lt(d, 29n) == True{} : Bool}
  for +hn: {Nat.is_le(U32.to_nat(n), A.quad(VB.pw(d))) == True{} : Bool}
  for +hchk: {CHK(t, n) == True{} : Bool}
  {FuluIndexedAttestation_r.IndexedAttestation_decode(BF(t, n), n) == (BF(t, n), Some{OBJ(t, n)}) : B.Buf & Maybe<&1, FuluIndexedAttestation_d.IndexedAttestation>}
def decode_accept(d, t, n, pf, hd, hn, hchk):
  +a = U32.is_le(228, n)
  +b = U32.is_eq(SPO(t), 228)
  +c = whole(U32.sub(n, SPO(t)))
  +epo = FD.u32alg__eq_of(SPO(t), 228, chk_b(a, b, c, hchk))
  acc_go(d, t, n, pf, hd, hn, hchk, chk_a(a, b, c, hchk), epo,
    FD.logic__subst(U32, z => {whole(U32.sub(n, z)) == True{} : Bool}, SPO(t), 228, epo, chk_c(a, b, c, hchk)))


