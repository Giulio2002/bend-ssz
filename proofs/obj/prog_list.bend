# A progressive list of uint64: its digest is a specification root of its elements.
def pl8_rs(+hl: Nat, +ehl: {hl == 64n : Nat}, -o: O.Words, +s: S.Schema, +rep: LV.rep_pl8(o, s), +ok: {ok_pl8(s) == True{} : Bool})
    -> RR.roots(UL_L.uview(o), s, [D.bytes(pdig(hl, o, 3n))]):
  (+wf, +eN) = rep
  +c0 = DK.and_l(SH.is_ProgressiveList(s), Bool.and(SH.is_Unsigned(SH.ProgressiveList_element(s)), UL_L.is_U64(SH.Unsigned_width(SH.ProgressiveList_element(s)))), ok)
  +k1 = DK.and_r(SH.is_ProgressiveList(s), Bool.and(SH.is_Unsigned(SH.ProgressiveList_element(s)), UL_L.is_U64(SH.Unsigned_width(SH.ProgressiveList_element(s)))), ok)
  %Equal.sym(S.Schema, s, S.ProgressiveList{SH.ProgressiveList_element(s)}, SH.ProgressiveList_shape(s, c0)) :
    RR.roots(UL_L.uview(o), _, [D.bytes(pdig(hl, o, 3n))])
  +c1 = DK.and_l(SH.is_Unsigned(SH.ProgressiveList_element(s)), UL_L.is_U64(SH.Unsigned_width(SH.ProgressiveList_element(s))), k1)
  +c2 = DK.and_r(SH.is_Unsigned(SH.ProgressiveList_element(s)), UL_L.is_U64(SH.Unsigned_width(SH.ProgressiveList_element(s))), k1)
  %Equal.sym(S.Schema, SH.ProgressiveList_element(s), S.Unsigned{SH.Unsigned_width(SH.ProgressiveList_element(s))}, SH.Unsigned_shape(SH.ProgressiveList_element(s), c1)) :
    RR.roots(UL_L.uview(o), S.ProgressiveList{_}, [D.bytes(pdig(hl, o, 3n))])
  %Equal.sym(P.Width, SH.Unsigned_width(SH.ProgressiveList_element(s)), P.U64{}, UL.is_U64_shape(SH.Unsigned_width(SH.ProgressiveList_element(s)), c2)) :
    RR.roots(UL_L.uview(o), S.ProgressiveList{S.Unsigned{_}}, [D.bytes(pdig(hl, o, 3n))])
  pl8_body(hl, ehl, o, wf, eN)

