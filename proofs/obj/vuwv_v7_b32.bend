    case 4n+ +t: Empty.absurd({FuluFinalityBranch_e.v7_b32_putk(FD.array__thaw(U32, D), X, O.Words{FD.array__thaw(U32, TB), 224}) == (FD.array__thaw(U32, PX_v7_b32(4n+t, dd, D, q, TB)), (O.Words{FD.array__thaw(U32, TB), 224}, 0)) : Array<U32> & (O.Words & U32)}, FD.nat__lt_zero_absurd(t, hr))

def v7_b32_any(+dd: Nat, +D: FD.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat, +dB: Nat, +TB: FD.array__Tree<U32>, +e: {U32.to_nat(X) == Nat.add(A.quad(q), r) : Nat}, +hr: {Nat.is_lt(r, 4n) == True{} : Bool},
    +hd: {Nat.is_lt(dd, 29n) == True{} : Bool}, +hl: {Nat.is_le(Nat.add(q, UWD.NWN(Nat.add(r, 224n))), VB.pw(dd)) == True{} : Bool},
    +pf: {FD.array__perfect(U32, dd, D) == True{} : Bool}, +pfB: {FD.array__perfect(U32, dB, TB) == True{} : Bool},
