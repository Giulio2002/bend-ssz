      %Equal.sym(Array<U32> & O.Words, O.put_words(FD.array__thaw(U32, D), X, O.Words{FD.array__thaw(U32, TB), 224}), (FD.array__thaw(U32, UWD.PWM(3n, dd, D, q, TB, 224)), O.Words{FD.array__thaw(U32, TB), 224}),
          UWD.putw_looseW(dd, D, X, q, 3n, dB, TB, 224, 8n, e, {==}, hd, hdB, {==}, {==}, hrB, UWD.le_q(q, 56n, VB.pw(dd), hl), pf, pfB, hz)) :
