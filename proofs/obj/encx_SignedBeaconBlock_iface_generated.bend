# ==== SignedBeaconBlock in the encoder-window interface ====

type MW is Data:
  MW{m_message: EC_BeaconBlock.MW, signature: FuluBytes96_d.Bytes96}

def TH(m: MW) -> FuluSignedBeaconBlock_d.SignedBeaconBlock:
  match m:
    case MW{+m_message, +signature}: K.OBJC(m_message, signature)
def OK(m: MW) -> Bool:
  match m:
    case MW{+m_message, +signature}: OKT(m_message, signature)
def OKW(m: MW) -> Bool:
  match m:
    case MW{+m_message, +signature}: OKTW(m_message, signature)
def ENC(m: MW) -> +List<U32>:
  match m:
    case MW{+m_message, +signature}: K.ENCC(m_message, signature)
def VAL(m: MW) -> S.Value:
  match m:
    case MW{+m_message, +signature}: VALC(m_message, signature)
def SZ(m: MW) -> U32:
  match m:
    case MW{+m_message, +signature}: K.SZC(m_message, signature)
def XQ(+q: Nat, +r: Nat) -> U32: U32.from_nat(Nat.add(A.quad(q), r))
def PUTX(m: MW, +dd: Nat, +D: FD.array__Tree<U32>, +q: Nat, +r: Nat) -> FD.array__Tree<U32>:
  match m:
    case MW{+m_message, +signature}: K.PUTC(m_message, signature, dd, D, XQ(q, r), q, r)
def PADB(+r: Nat, m: MW) -> Nat: WD.PADB(r, List.length(&2, U32, ENC(m)))

def RTX(+m_message: EC_BeaconBlock.MW, +signature: FuluBytes96_d.Bytes96, +dd: Nat, +D: FD.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat) -> Data:
