# pfC: the writer's tree is perfect (no hypothesis).
def pfC(+m_f_C: EX_pbits.MB, +dd: Nat, +D: FD.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat, +pf: {FD.array__perfect(U32, dd, D) == True{} : Bool}) -> PFC(m_f_C, dd, D, X, q, r):
