law bits_part:
  for +ws: +List<U32>
  for +n: Nat
  for fit: {Nat.is_eq(bitlen(ws), n) == True{} : Bool}
  for pos: {Nat.is_lt(0n, n) == True{} : Bool}
  {Codec.parts(S.BitsValue{bitsof(ws)}, S.BitVector{n}) == Some{[S.Fixed{F.limbs(ws)}]} : Maybe<&2, +List<S.Part>>}
def bits_part(ws, n, fit, pos):
  %Equal.sym(Nat, List.length(&2, Bool, bitsof(ws)), bitlen(ws), len_bits(ws)) :
    {Codec.one(SBF.encoding(Bool.and(Nat.is_lt(0n, n), Nat.is_eq(_, n)), bitsof(ws)), Some{Nat.div(Nat.add(n, 7n), 8n)}) == Some{[S.Fixed{F.limbs(ws)}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(Bool, Nat.is_eq(bitlen(ws), n), True{}, fit) :
    {Codec.one(SBF.encoding(Bool.and(Nat.is_lt(0n, n), _), bitsof(ws)), Some{Nat.div(Nat.add(n, 7n), 8n)}) == Some{[S.Fixed{F.limbs(ws)}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(Bool, Nat.is_lt(0n, n), True{}, pos) :
    {Codec.one(SBF.encoding(Bool.and(_, True{}), bitsof(ws)), Some{Nat.div(Nat.add(n, 7n), 8n)}) == Some{[S.Fixed{F.limbs(ws)}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(+List<U32>, SB.pack(bitsof(ws)), F.limbs(ws), pack_limbs(ws)) :
    {Codec.one(Some{_}, Some{Nat.div(Nat.add(n, 7n), 8n)}) == Some{[S.Fixed{F.limbs(ws)}]} : Maybe<&2, +List<S.Part>>}
  {==}
