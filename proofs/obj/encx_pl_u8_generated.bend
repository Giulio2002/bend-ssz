  for +hok: {OK(m) == True{} : Bool}
  {proglist_uint8_e.pl_u8_putk(FD.array__thaw(U32, D), X, TH(m)) == (FD.array__thaw(U32, PUTX(m, dd, D, q, r)), (TH(m), SZ(m))) : Array<U32> & (O.Words & U32)}
