  elem_to(F.array__slots(U32, WR.cpy(d2, t, Kc, 0n, T2)), i, MR.wd(F.array__slots(U32, t), Nat.add(Nat.mul(i, 12n), 0n)), MR.wd(F.array__slots(U32, t), Nat.add(Nat.mul(i, 12n), 1n)), MR.wd(F.array__slots(U32, t), Nat.add(Nat.mul(i, 12n), 2n)), MR.wd(F.array__slots(U32, t), Nat.add(Nat.mul(i, 12n), 3n)), MR.wd(F.array__slots(U32, t), Nat.add(Nat.mul(i, 12n), 4n)), MR.wd(F.array__slots(U32, t), Nat.add(Nat.mul(i, 12n), 5n)), MR.wd(F.array__slots(U32, t), Nat.add(Nat.mul(i, 12n), 6n)), MR.wd(F.array__slots(U32, t), Nat.add(Nat.mul(i, 12n), 7n)), MR.wd(F.array__slots(U32, t), Nat.add(Nat.mul(i, 12n), 8n)), MR.wd(F.array__slots(U32, t), Nat.add(Nat.mul(i, 12n), 9n)), MR.wd(F.array__slots(U32, t), Nat.add(Nat.mul(i, 12n), 10n)), MR.wd(F.array__slots(U32, t), Nat.add(Nat.mul(i, 12n), 11n)), WW.wd_cpy_in(Kc, Nat.add(Nat.mul(i, 12n), 0n), d2, t, 0n, T2, F.nat__lt_succ_le(Nat.add(Nat.mul(i, 12n), 0n), Kc, WR.bound(Nat.mul(i, 12n), 0n, 12n, 1n+Kc, hc, {==})), hb2, pf2), WW.wd_cpy_in(Kc, Nat.add(Nat.mul(i, 12n), 1n), d2, t, 0n, T2, F.nat__lt_succ_le(Nat.add(Nat.mul(i, 12n), 1n), Kc, WR.bound(Nat.mul(i, 12n), 1n, 12n, 1n+Kc, hc, {==})), hb2, pf2), WW.wd_cpy_in(Kc, Nat.add(Nat.mul(i, 12n), 2n), d2, t, 0n, T2, F.nat__lt_succ_le(Nat.add(Nat.mul(i, 12n), 2n), Kc, WR.bound(Nat.mul(i, 12n), 2n, 12n, 1n+Kc, hc, {==})), hb2, pf2), WW.wd_cpy_in(Kc, Nat.add(Nat.mul(i, 12n), 3n), d2, t, 0n, T2, F.nat__lt_succ_le(Nat.add(Nat.mul(i, 12n), 3n), Kc, WR.bound(Nat.mul(i, 12n), 3n, 12n, 1n+Kc, hc, {==})), hb2, pf2), WW.wd_cpy_in(Kc, Nat.add(Nat.mul(i, 12n), 4n), d2, t, 0n, T2, F.nat__lt_succ_le(Nat.add(Nat.mul(i, 12n), 4n), Kc, WR.bound(Nat.mul(i, 12n), 4n, 12n, 1n+Kc, hc, {==})), hb2, pf2), WW.wd_cpy_in(Kc, Nat.add(Nat.mul(i, 12n), 5n), d2, t, 0n, T2, F.nat__lt_succ_le(Nat.add(Nat.mul(i, 12n), 5n), Kc, WR.bound(Nat.mul(i, 12n), 5n, 12n, 1n+Kc, hc, {==})), hb2, pf2), WW.wd_cpy_in(Kc, Nat.add(Nat.mul(i, 12n), 6n), d2, t, 0n, T2, F.nat__lt_succ_le(Nat.add(Nat.mul(i, 12n), 6n), Kc, WR.bound(Nat.mul(