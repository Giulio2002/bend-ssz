      %Equal.sym(S.Value, RN_L.v_b48(EL48.rec48(F.array__slots(U32, WW.tk([x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11], d, t, Nat.mul(J, 12n), 0n)), Nat.mul(i0, 12n))), RN_L.v_b48(FuluBytes48_d.Bytes48{x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11}), F.logic__subst(Nat, z => {RN_L.v_b48(EL48.rec48(F.array__slots(U32, WW.tk([x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11], d, t, Nat.mul(J, 12n), 0n)), Nat.mul(z, 12n))) == RN_L.v_b48(FuluBytes48_d.Bytes48{x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11}) : S.Value}, J, i0, eJ, el_hit(d, t, x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, J, hb, pf))) :
        {S.Items{_, S.EmptyItems{}} == S.Items{RN_L.v_b48(FuluBytes48_d.Bytes48{x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11}), S.EmptyItems{}} : S.Value}
      {==}
