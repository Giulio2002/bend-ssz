      %Equal.sym(S.Value, RN_L.v_b48(EL48.rec48(F.array__slots(U32, WW.tk([x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11], d, t, Nat.mul(J, 12n), 0n)), Nat.mul(i0, 12n))), RN_L.v_b48(EL48.rec48(F.array__slots(U32, t), Nat.mul(i0, 12n))), el_same(d, t, x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, i0, J, F.nat__is_eq_lt(i0, J, hlt), hb, pf)) :
        {S.Items{_, EL48.eitems(1n+p, F.array__slots(U32, WW.tk([x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11], d, t, Nat.mul(J, 12n), 0n)), 1n+i0)} == S.Items{RN_L.v_b48(EL48.rec48(F.array__slots(U32, t), Nat.mul(i0, 12n))), VS.items_snoc(EL48.eitems(p, F.array__slots(U32, t), 1n+i0), RN_L.v_b48(FuluBytes48_d.Bytes48{x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11}))} : S.Value}
      %Equal.sym(S.Value, EL48.eitems(1n+p, F.array__slots(U32, WW.tk([x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11], d, t, Nat.mul(J, 12n), 0n)), 1n+i0), VS.items_snoc(EL48.eitems(p, F.array__slots(U32, t), 1n+i0), RN_L.v_b48(FuluBytes48_d.Bytes48{x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11})), items_app(p, d, t, x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, 1n+i0, J, Equal.trans(Nat, J, Nat.add(i0, 1n+p), Nat.add(1n+i0, p), hJ, F.nat__add_succ(i0, p)), hb, pf)) :
        {S.Items{RN_L.v_b48(EL48.rec48(F.array__slots(U32, t), Nat.mul(i0, 12n))), _} == S.Items{RN_L.v_b48(EL48.rec48(F.array__slots(U32, t), Nat.mul(i0, 12n))), VS.items_snoc(EL48.eitems(p, F.array__slots(U32, t), 1n+i0), RN_L.v_b48(FuluBytes48_d.Bytes48{x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11}))} : S.Value}
