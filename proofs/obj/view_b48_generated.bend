# the run written at block J = i0 + k, one past the k blocks' items: the items are the old items and the new one
def items_app(+k: Nat, +d: Nat, +t: F.array__Tree<U32>, +x0: U32, +x1: U32, +x2: U32, +x3: U32, +x4: U32, +x5: U32, +x6: U32, +x7: U32, +x8: U32, +x9: U32, +x10: U32, +x11: U32, +i0: Nat, +J: Nat, +hJ: {J == Nat.add(i0, k) : Nat}, +hb: {Nat.is_le(Nat.add(Nat.mul(J, 12n), 12n), F.spec_common__pow2(d)) == True{} : Bool}, +pf: {F.array__perfect(U32, d, t) == True{} : Bool})
    -> {EL48.eitems(1n+k, F.array__slots(U32, WW.tk([x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11], d, t, Nat.mul(J, 12n), 0n)), i0) == VS.items_snoc(EL48.eitems(k, F.array__slots(U32, t), i0), RN_L.v_b48(FuluBytes48_d.Bytes48{x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11})) : S.Value}:
