# the copy keeps the words of the blocks below 1 + Kc: an element read from the copy is the element of the source
def el_cpy(+Kc: Nat, +d2: Nat, +t: F.array__Tree<U32>, +T2: F.array__Tree<U32>, +i: Nat, +hc: {Nat.is_le(Nat.add(Nat.mul(i, 12n), 12n), 1n+Kc) == True{} : Bool}, +hb2: {Nat.is_le(Nat.add(0n, 1n+Kc), F.spec_common__pow2(d2)) == True{} : Bool}, +pf2: {F.array__perfect(U32, d2, T2) == True{} : Bool})
