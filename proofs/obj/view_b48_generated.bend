def el_same(+d: Nat, +t: F.array__Tree<U32>, +x0: U32, +x1: U32, +x2: U32, +x3: U32, +x4: U32, +x5: U32, +x6: U32, +x7: U32, +x8: U32, +x9: U32, +x10: U32, +x11: U32, +i: Nat, +J: Nat, +ne: {Nat.is_eq(i, J) == False{} : Bool}, +hb: {Nat.is_le(Nat.add(Nat.mul(J, 12n), 12n), F.spec_common__pow2(d)) == True{} : Bool}, +pf: {F.array__perfect(U32, d, t) == True{} : Bool})
    -> {RN_L.v_b48(EL48.rec48(F.array__slots(U32, WW.tk([x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11], d, t, Nat.mul(J, 12n), 0n)), Nat.mul(i, 12n))) == RN_L.v_b48(EL48.rec48(F.array__slots(U32, t), Nat.mul(i, 12n))) : S.Value}:
  el_same_go(Nat.is_lt(i, J), d, t, x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, i, J, {==}, ne, hb, pf)

# ---- the items ----
# from block i0 on, all after block J: the same items
def items_same(+k: Nat, +d: Nat, +t: F.array__Tree<U32>, +x0: U32, +x1: U32, +x2: U32, +x3: U32, +x4: U32, +x5: U32, +x6: U32, +x7: U32, +x8: U32, +x9: U32, +x10: U32, +x11: U32, +i0: Nat, +J: Nat, +hlt: {Nat.is_lt(J, i0) == True{} : Bool}, +hb: {Nat.is_le(Nat.add(Nat.mul(J, 12n), 12n), F.spec_common__pow2(d)) == True{} : Bool}, +pf: {F.array__perfect(U32, d, t) == True{} : Bool})
    -> {EL48.eitems(k, F.array__slots(U32, WW.tk([x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11], d, t, Nat.mul(J, 12n), 0n)), i0) == EL48.eitems(k, F.array__slots(U32, t), i0) : S.Value}:
  match k:
    case 0n: {==}
    case 1n+q:
      %Equal.sym(S.Value, RN_L.v_b48(EL48.rec48(F.array__slots(U32, WW.tk([x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11], d, t, Nat.mul(J, 12n), 0n)), Nat.mul(i0, 12n))), RN_L.v_b48(EL48.rec48(F.array__slots(U32, t), Nat.mul(i0, 12n))), el_same(d, t, x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, i0, J, ne_lt(J, i0, hlt), hb, pf)) :
        {S.Items{_, EL48.eitems(q, F.array__slots(U32, WW.tk([x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11], d, t, Nat.mul(J, 12n), 0n)), 1n+i0)} == S.Items{RN_L.v_b48(EL48.rec48(F.array__slots(U32, t), Nat.mul(i0, 12n))), EL48.eitems(q, F.array__slots(U32, t), 1n+i0)} : S.Value}
      %Equal.sym(S.Value, EL48.eitems(q, F.array__slots(U32, WW.tk([x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11], d, t, Nat.mul(J, 12n), 0n)), 1n+i0), EL48.eitems(q, F.array__slots(U32, t), 1n+i0), items_same(q, d, t, x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, 1n+i0, J, F.nat__lt_trans(J, i0, 1n+i0, hlt, F.nat__lt_succ(i0)), hb, pf)) :
        {S.Items{RN_L.v_b48(EL48.rec48(F.array__slots(U32, t), Nat.mul(i0, 12n))), _} == S.Items{RN_L.v_b48(EL48.rec48(F.array__slots(U32, t), Nat.mul(i0, 12n))), EL48.eitems(q, F.array__slots(U32, t), 1n+i0)} : S.Value}
      {==}

# the run written at block J = i0 + r: the items are the old items with item r replaced
def items_set(+k: Nat, +r: Nat, +d: Nat, +t: F.array__Tree<U32>, +x0: U32, +x1: U32, +x2: U32, +x3: U32, +x4: U32, +x5: U32, +x6: U32, +x7: U32, +x8: U32, +x9: U32, +x10: U32, +x11: U32, +i0: Nat, +J: Nat, +hJ: {J == Nat.add(i0, r) : Nat}, +hb: {Nat.is_le(Nat.add(Nat.mul(J, 12n), 12n), F.spec_common__pow2(d)) == True{} : Bool}, +pf: {F.array__perfect(U32, d, t) == True{} : Bool})
    -> {EL48.eitems(k, F.array__slots(U32, WW.tk([x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11], d, t, Nat.mul(J, 12n), 0n)), i0) == VS.items_set(EL48.eitems(k, F.array__slots(U32, t), i0), r, RN_L.v_b48(FuluBytes48_d.Bytes48{x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11})) : S.Value}:
  match k r:
    case 0n _: {==}
    case 1n+q 0n:
      +eJ = Equal.trans(Nat, J, Nat.add(i0, 0n), i0, hJ, F.nat__add_zero(i0))
      %Equal.sym(S.Value, RN_L.v_b48(EL48.rec48(F.array__slots(U32, WW.tk([x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11], d, t, Nat.mul(J, 12n), 0n)), Nat.mul(i0, 12n))), RN_L.v_b48(FuluBytes48_d.Bytes48{x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11}), F.logic__subst(Nat, z => {RN_L.v_b48(EL48.rec48(F.array__slots(U32, WW.tk([x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11], d, t, Nat.mul(J, 12n), 0n)), Nat.mul(z, 12n))) == RN_L.v_b48(FuluBytes48_d.Bytes48{x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11}) : S.Value}, J, i0, eJ, el_hit(d, t, x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, J, hb, pf))) :
        {S.Items{_, EL48.eitems(q, F.array__slots(U32, WW.tk([x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11], d, t, Nat.mul(J, 12n), 0n)), 1n+i0)} == S.Items{RN_L.v_b48(FuluBytes48_d.Bytes48{x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11}), EL48.eitems(q, F.array__slots(U32, t), 1n+i0)} : S.Value}
      %Equal.sym(S.Value, EL48.eitems(q, F.array__slots(U32, WW.tk([x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11], d, t, Nat.mul(J, 12n), 0n)), 1n+i0), EL48.eitems(q, F.array__slots(U32, t), 1n+i0), items_same(q, d, t, x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, 1n+i0, J, F.logic__subst(Nat, z => {Nat.is_lt(z, 1n+i0) == True{} : Bool}, i0, J, Equal.sym(Nat, J, i0, eJ), F.nat__lt_succ(i0)), hb, pf)) :
        {S.Items{RN_L.v_b48(FuluBytes48_d.Bytes48{x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11}), _} == S.Items{RN_L.v_b48(FuluBytes48_d.Bytes48{x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11}), EL48.eitems(q, F.array__slots(U32, t), 1n+i0)} : S.Value}
      {==}
    case 1n+q 1n+p:
      +hlt = F.logic__subst(Nat, z => {Nat.is_lt(i0, z) == True{} : Bool}, Nat.add(i0, 1n+p), J, Equal.sym(Nat, J, Nat.add(i0, 1n+p), hJ), lt_add_succ(i0, p))
      %Equal.sym(S.Value, RN_L.v_b48(EL48.rec48(F.array__slots(U32, WW.tk([x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11], d, t, Nat.mul(J, 12n), 0n)), Nat.mul(i0, 12n))), RN_L.v_b48(EL48.rec48(F.array__slots(U32, t), Nat.mul(i0, 12n))), el_same(d, t, x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, i0, J, F.nat__is_eq_lt(i0, J, hlt), hb, pf)) :
        {S.Items{_, EL48.eitems(q, F.array__slots(U32, WW.tk([x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11], d, t, Nat.mul(J, 12n), 0n)), 1n+i0)} == S.Items{RN_L.v_b48(EL48.rec48(F.array__slots(U32, t), Nat.mul(i0, 12n))), VS.items_set(EL48.eitems(q, F.array__slots(U32, t), 1n+i0), p, RN_L.v_b48(FuluBytes48_d.Bytes48{x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11}))} : S.Value}
      %Equal.sym(S.Value, EL48.eitems(q, F.array__slots(U32, WW.tk([x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11], d, t, Nat.mul(J, 12n), 0n)), 1n+i0), VS.items_set(EL48.eitems(q, F.array__slots(U32, t), 1n+i0), p, RN_L.v_b48(FuluBytes48_d.Bytes48{x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11})), items_set(q, p, d, t, x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, 1n+i0, J, Equal.trans(Nat, J, Nat.add(i0, 1n+p), Nat.add(1n+i0, p), hJ, F.nat__add_succ(i0, p)), hb, pf)) :
        {S.Items{RN_L.v_b48(EL48.rec48(F.array__slots(U32, t), Nat.mul(i0, 12n))), _} == S.Items{RN_L.v_b48(EL48.rec48(F.array__slots(U32, t), Nat.mul(i0, 12n))), VS.items_set(EL48.eitems(q, F.array__slots(U32, t), 1n+i0), p, RN_L.v_b48(FuluBytes48_d.Bytes48{x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11}))} : S.Value}
      {==}

# the view of the storage after the run is written at word q = Nat.mul(J, 12n): the view before, with item J replaced.
# `c` is the element count the view reads.
