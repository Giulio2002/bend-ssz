# ---- the union's mirror and its interface ----
type MW is Data:
  MW0{x: U32}
  MW1{x: EA_ProgressiveSingleListContainerTestStruct.MW}
  MW2{x: EA_ProgressiveVarTestStruct.MW}
  MW3{x: U32}
def TH(m: MW) -> CompatibleUnionABCA_d.CompatibleUnionABCA:
  match m:
    case MW0{+x}: TH0(x)
    case MW1{+x}: TH1(x)
    case MW2{+x}: TH2(x)
    case MW3{+x}: TH3(x)
def OK(m: MW) -> Bool:
  match m:
    case MW0{+x}: OK0(x)
    case MW1{+x}: OK1(x)
    case MW2{+x}: OK2(x)
    case MW3{+x}: OK3(x)
def ENC(m: MW) -> +List<U32>:
  match m:
    case MW0{+x}: ENC0(x)
    case MW1{+x}: ENC1(x)
    case MW2{+x}: ENC2(x)
    case MW3{+x}: ENC3(x)
def VAL(m: MW) -> S.Value:
  match m:
    case MW0{+x}: VAL0(x)
    case MW1{+x}: VAL1(x)
    case MW2{+x}: VAL2(x)
    case MW3{+x}: VAL3(x)
def SZ(m: MW) -> U32:
  match m:
    case MW0{+x}: SZ0(x)
    case MW1{+x}: SZ1(x)
    case MW2{+x}: SZ2(x)
    case MW3{+x}: SZ3(x)
def PUTX(m: MW, +dd: Nat, +D: FD.array__Tree<U32>, +q: Nat, +r: Nat) -> FD.array__Tree<U32>:
  match m:
    case MW0{+x}: PUTX0(x, dd, D, q, r)
    case MW1{+x}: PUTX1(x, dd, D, q, r)
    case MW2{+x}: PUTX2(x, dd, D, q, r)
    case MW3{+x}: PUTX3(x, dd, D, q, r)
def PADB(+r: Nat, m: MW) -> Nat: WD.PADB(r, List.length(&2, U32, ENC(m)))

law putxW:
  for +m: MW
  for +dd: Nat
  for +D: FD.array__Tree<U32>
  for +X: U32
  for +q: Nat
  for +r: Nat
  for +e: {U32.to_nat(X) == Nat.add(A.quad(q), r) : Nat}
  for +hr: {Nat.is_lt(r, 4n) == True{} : Bool}
  for +hd: {Nat.is_lt(dd, 31n) == True{} : Bool}
  for +pf: {FD.array__perfect(U32, dd, D) == True{} : Bool}
  for +hl: {Nat.is_le(Nat.add(q, WD.NWN(Nat.add(r, List.length(&2, U32, ENC(m))))), VB.pw(dd)) == True{} : Bool}
  for +hs31: {Nat.is_le(List.length(&2, U32, ENC(m)), U32.to_nat(VB.NMAX())) == True{} : Bool}
  for +hl32: {Nat.is_lt(Nat.add(A.quad(q), Nat.add(r, List.length(&2, U32, ENC(m)))), FD.spec_common__pow2(32n)) == True{} : Bool}
  for +hz: {VS.bt(Nat.add(List.length(&2, U32, ENC(m)), PADB(r, m)), VS.bdr(Nat.add(A.quad(q), r), UA.BYT(D))) == UW.ZB(Nat.add(List.length(&2, U32, ENC(m)), PADB(r, m))) : +List<U32>}
  for +hok: {OK(m) == True{} : Bool}
  {CompatibleUnionABCA_e.CompatibleUnionABCA_putk(FD.array__thaw(U32, D), X, TH(m)) == (FD.array__thaw(U32, PUTX(m, dd, D, q, r)), (TH(m), SZ(m))) : Array<U32> & (CompatibleUnionABCA_d.CompatibleUnionABCA & U32)}
def putxW(m, dd, D, X, q, r, e, hr, hd, pf, hl, hs31, hl32, hz, hok):
  match m:
    case MW0{+x}: PA(RT0(x, dd, D, X, q, r), BY0(x, dd, D, q, r), go0W(x, dd, D, X, q, r, e, hr, hd, pf, hl, hl32, hz, hok))
    case MW1{+x}: PA(RT1(x, dd, D, X, q, r), BY1(x, dd, D, q, r), go1W(x, dd, D, X, q, r, e, hr, hd, pf, hl, hs31, hl32, hz, hok))
    case MW2{+x}: PA(RT2(x, dd, D, X, q, r), BY2(x, dd, D, q, r), go2W(x, dd, D, X, q, r, e, hr, hd, pf, hl, hs31, hl32, hz, hok))
