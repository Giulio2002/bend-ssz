def spec3(+x: U32, +hok: {OK3(x) == True{} : Bool}) -> {Codec.parts(VAL3(x), Spec.CompatibleUnionABCA()) == Some{[S.Variable{ENC3(x)}]} : Maybe<&2, +List<S.Part>>}:
  VU.tag_f(4, RV8(x), Spec.ProgressiveSingleFieldContainerTestStruct(), [U32.and(x, 255)], rprf(x))
