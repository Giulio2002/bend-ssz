def go3(+x: U32, +dd: Nat, +D: FD.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat, +e: {U32.to_nat(X) == Nat.add(A.quad(q), r) : Nat}, +hr: {Nat.is_lt(r, 4n) == True{} : Bool},
    +hd: {Nat.is_lt(dd, 29n) == True{} : Bool}, +pf: {FD.array__perfect(U32, dd, D) == True{} : Bool},
    +hl: {Nat.is_le(Nat.add(q, WD.NWN(Nat.add(r, List.length(&2, U32, ENC3(x))))), VB.pw(dd)) == True{} : Bool},
    +hz: {VS.bt(Nat.add(List.length(&2, U32, ENC3(x)), WD.PADB(r, List.length(&2, U32, ENC3(x)))), VS.bdr(Nat.add(A.quad(q), r), UA.BYT(D))) == UW.ZB(Nat.add(List.length(&2, U32, ENC3(x)), WD.PADB(r, List.length(&2, U32, ENC3(x))))) : +List<U32>},
    +hok: {OK3(x) == True{} : Bool})
    -> DK.P2(RT3(x, dd, D, X, q, r), BY3(x, dd, D, q, r)):
