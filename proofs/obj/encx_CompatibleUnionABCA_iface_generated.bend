    {CompatibleUnionABCA_e.CompatibleUnionABCA_pk(FD.array__thaw(U32, D), X, (TH3(x), _)) == (FD.array__thaw(U32, PUTX3(x, dd, D, q, r)), (TH3(x), SZ3(x))) : Array<U32> & (CompatibleUnionABCA_d.CompatibleUnionABCA & U32)}
  %Equal.sym(Array<U32>, O.w8(FD.array__thaw(U32, D), X, 4), FD.array__thaw(U32, VU.DS(dd, D, q, r, 4)), rts) :
    {CompatibleUnionABCA_e.CompatibleUnionABCA_putn_fin(2, (ProgressiveSingleFieldContainerTestStruct_e.ProgressiveSingleFieldContainerTestStruct_put(_, U32.add(X, 1), ProgressiveSingleFieldContainerTestStruct_d.ProgressiveSingleFieldContainerTestStruct{x}), TH3(x))) == (FD.array__thaw(U32, PUTX3(x, dd, D, q, r)), (TH3(x), SZ3(x))) : Array<U32> & (CompatibleUnionABCA_d.CompatibleUnionABCA & U32)}
