    -> DK.P2(RT3(x, dd, D, X, q, r), BY3(x, dd, D, q, r)):
  +rts = VU.sel_rtW(dd, D, X, q, r, 4, 1n, e, hr, hd, hl, pf)
  +bys = VU.sel_byW(dd, D, X, q, r, 4, 1n, WD.PADB(r, 2n), e, hr, hd, hl, pf, hz)
  +pfs = VU.sel_pf(dd, D, q, r, 4, pf)
  +hX = VRX.xstart(q, r, 2n, dd, D, pf, hl)
  +eY = Equal.trans(Nat, U32.to_nat(U32.add(X, 1)), Nat.add(A.quad(VU.AQ(q, r)), VU.AR(r)), 1n+VU.X0(q, r), VU.arm_eW(dd, X, q, r, 1n, e, hr, hd, hl, hl32), VU.apos(q, r, hr))
  +hb = FD.logic__subst(Nat, z => {Nat.is_le(z, A.quad(VB.pw(dd))) == True{} : Bool}, Nat.add(VU.X0(q, r), 2n), 1n+Nat.add(VU.X0(q, r), 1n), FD.nat__add_succ(VU.X0(q, r), 1n),
    VRX.xend(q, r, 2n, dd, hl))
  +e0 = VRB.fposbW(dd, U32.add(X, 1), 0, 1n+VU.X0(q, r), 1n, eY, hd, hb, {==})
  +rtw = VRB.w8p_rtW(dd, VU.DS(dd, D, q, r, 4), U32.add(U32.add(X, 1), 0), Nat.add(0n, 1n+VU.X0(q, r)), x, e0, hd, hb, pfs)
  +hza = VU.arm_hz(dd, D, q, r, 4, 1n, hr, hX, bys, hz)
  +hz1 = FD.logic__subst(Nat, z => {VS.bt(1n, VS.bdr(z, UA.BYT(VU.DS(dd, D, q, r, 4)))) == UW.ZB(1n) : +List<U32>}, Nat.add(A.quad(VU.AQ(q, r)), VU.AR(r)), Nat.add(0n, 1n+VU.X0(q, r)), VU.apos(q, r, hr),
    VRX.zhead(1n, WD.PADB(VU.AR(r), 1n), VS.bdr(Nat.add(A.quad(VU.AQ(q, r)), VU.AR(r)), UA.BYT(VU.DS(dd, D, q, r, 4))), hza))
  +byw = VRB.w8p_bytesW(dd, VU.DS(dd, D, q, r, 4), U32.add(U32.add(X, 1), 0), Nat.add(0n, 1n+VU.X0(q, r)), x, e0, hd, hb, pfs, hz1)
  +zt = VRX.ztail(1n, WD.PADB(VU.AR(r), 1n), VS.bdr(Nat.add(A.quad(VU.AQ(q, r)), VU.AR(r)), UA.BYT(VU.DS(dd, D, q, r, 4))), hza)
  +zt2 = FD.logic__subst(+List<U32>, zz => {VS.bt(WD.PADB(VU.AR(r), 1n), zz) == UW.ZB(WD.PADB(VU.AR(r), 1n)) : +List<U32>}, VS.bdr(1n, VS.bdr(Nat.add(A.quad(VU.AQ(q, r)), VU.AR(r)), UA.BYT(VU.DS(dd, D, q, r, 4)))), VS.bdr(Nat.add(Nat.add(A.quad(VU.AQ(q, r)), VU.AR(r)), 1n), UA.BYT(VU.DS(dd, D, q, r, 4))),
    Equal.sym(+List<U32>, VS.bdr(Nat.add(Nat.add(A.quad(VU.AQ(q, r)), VU.AR(r)), 1n), UA.BYT(VU.DS(dd, D, q, r, 4))), VS.bdr(1n, VS.bdr(Nat.add(A.quad(VU.AQ(q, r)), VU.AR(r)), UA.BYT(VU.DS(dd, D, q, r, 4)))), UW.bdr_add(Nat.add(A.quad(VU.AQ(q, r)), VU.AR(r)), 1n, UA.BYT(VU.DS(dd, D, q, r, 4)))), zt)
  +hzt = FD.logic__subst(Nat, z => {VS.bt(WD.PADB(VU.AR(r), 1n), VS.bdr(Nat.add(z, 1n), UA.BYT(VU.DS(dd, D, q, r, 4)))) == UW.ZB(WD.PADB(VU.AR(r), 1n)) : +List<U32>}, Nat.add(A.quad(VU.AQ(q, r)), VU.AR(r)), Nat.add(0n, 1n+VU.X0(q, r)), VU.apos(q, r, hr), zt2)
  +ext = WD.spl_ext(UA.BYT(VU.DS(dd, D, q, r, 4)), Nat.add(0n, 1n+VU.X0(q, r)), [U32.and(x, 255)], WD.PADB(VU.AR(r), 1n), hzt)
  +by2p = Equal.trans(+List<U32>, UA.BYT(PUTX3(x, dd, D, q, r)), UW.SPL(UA.BYT(VU.DS(dd, D, q, r, 4)), Nat.add(0n, 1n+VU.X0(q, r)), [U32.and(x, 255)]), UW.SPL(UA.BYT(VU.DS(dd, D, q, r, 4)), Nat.add(0n, 1n+VU.X0(q, r)), List.append(&2, U32, [U32.and(x, 255)], UW.ZB(WD.PADB(VU.AR(r), 1n)))), byw, ext)
  +by2 = FD.logic__subst(Nat, z => {UA.BYT(PUTX3(x, dd, D, q, r)) == UW.SPL(UA.BYT(VU.DS(dd, D, q, r, 4)), z, List.append(&2, U32, [U32.and(x, 255)], UW.ZB(WD.PADB(VU.AR(r), 1n)))) : +List<U32>}, Nat.add(0n, 1n+VU.X0(q, r)), Nat.add(A.quad(VU.AQ(q, r)), VU.AR(r)),
    Equal.sym(Nat, Nat.add(A.quad(VU.AQ(q, r)), VU.AR(r)), Nat.add(0n, 1n+VU.X0(q, r)), VU.apos(q, r, hr)), by2p)
  +by = VU.ubytes(dd, D, PUTX3(x, dd, D, q, r), q, r, 4, [U32.and(x, 255)], hr, hX, bys, by2)
  +rt = rt3(x, dd, D, X, q, r, hok, rts, rtw)
