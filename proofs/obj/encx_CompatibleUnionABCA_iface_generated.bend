def bnd3(+x: U32, +hok: {OK3(x) == True{} : Bool}, +k: Nat, +ek: {k == 28n : Nat}) -> {Nat.is_le(List.length(&2, U32, ENC3(x)), A.quad(VB.pw(k))) == True{} : Bool}:
