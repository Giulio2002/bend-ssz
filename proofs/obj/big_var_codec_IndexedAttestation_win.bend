def hl_mmw(+d: Nat, +t: FD.array__Tree<U32>, +i: Nat, +len: U32, +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +hl: {Nat.is_le(U32.to_nat(len), A.quad(VB.pw(d))) == True{} : Bool}, +ha: {U32.is_le(228, len) == True{} : Bool}, +hc: {DC.whole(DC.LL(len)) == True{} : Bool})
    -> {Nat.is_le(Nat.double(DC.CQ(len)), FD.spec_common__length(U32, FD.array__slots(U32, MMw(t, i, len)))) == True{} : Bool}:
  %Equal.sym(Nat, FD.spec_common__length(U32, FD.array__slots(U32, MMw(t, i, len))), VB.pw(DC.DZ(len)),
      FD.array__slots_length(U32, DC.DZ(len), MMw(t, i, len), VB.mone_perfect(VC.NW(DC.LL(len)), Nat.add(57n, i), 0n, DC.DZ(len), VC.ZT(DC.DZ(len)), t, FD.array__trep_perfect(U32, DC.DZ(len), 0)))) :
    {Nat.is_le(Nat.double(DC.CQ(len)), _) == True{} : Bool}
  %DC.eNWc(d, len, hd, ha, hl, hc) : {Nat.is_le(_, VB.pw(DC.DZ(len))) == True{} : Bool}
  FD.logic__subst(Nat, z => {Nat.is_le(z, VB.pw(DC.DZ(len))) == True{} : Bool}, Nat.add(VC.NW(DC.LL(len)), 0n), VC.NW(DC.LL(len)), FD.nat__add_zero(VC.NW(DC.LL(len))), DC.hr(d, len, hd, ha, hl, hc))

def specw_go(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +i: Nat, +len: U32, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hd: {Nat.is_lt(d, 31n) == True{} : Bool},
    +hw: {Nat.is_le(Nat.add(A.quad(i), U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +ha: {U32.is_le(228, len) == True{} : Bool}, +epo: {SPOw(t, i) == 228 : U32}, +hc: {DC.whole(DC.LL(len)) == True{} : Bool})
    -> {Codec.parts(VALw(t, i, len), Spec.IndexedAttestation()) == Some{[S.Variable{F.limbs(VS.wtake(Nat.add(57n, VC.NW(DC.LL(len))), VB.wdr(i, FD.array__slots(U32, t))))}]} : Maybe<&2, +List<S.Part>>}:
  %lim_eqw(d, t, n, i, len, pf, hd, hw, ha, epo, hc) :
    {Codec.parts(VALw(t, i, len), Spec.IndexedAttestation()) == Some{[S.Variable{_}]} : Maybe<&2, +List<S.Part>>}
  encpw(t, i, DC.CQ(len), FD.array__slots(U32, MMw(t, i, len)), DC.hcL(len, hc), hl_mmw(d, t, i, len, hd, hlen(d, i, len, hw), ha, hc))

# When the window's checks hold, the spec parts of VALw are its words, as one variable part.
def specw(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +i: Nat, +len: U32, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hd: {Nat.is_lt(d, 31n) == True{} : Bool},
    +hw: {Nat.is_le(Nat.add(A.quad(i), U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +hchk: {CHKw(t, i, len) == True{} : Bool})
    -> {Codec.parts(VALw(t, i, len), Spec.IndexedAttestation()) == Some{[S.Variable{F.limbs(VS.wtake(Nat.add(57n, VC.NW(DC.LL(len))), VB.wdr(i, FD.array__slots(U32, t))))}]} : Maybe<&2, +List<S.Part>>}:
  +a = U32.is_le(228, len)
  +b = U32.is_eq(SPOw(t, i), 228)
  +c = DC.whole(U32.sub(len, SPOw(t, i)))
  +epo = FD.u32alg__eq_of(SPOw(t, i), 228, DC.chk_b(a, b, c, hchk))
  specw_go(d, t, n, i, len, pf, hd, hw, DC.chk_a(a, b, c, hchk), epo,
    FD.logic__subst(U32, z => {DC.whole(U32.sub(len, z)) == True{} : Bool}, SPOw(t, i), 228, epo, DC.chk_c(a, b, c, hchk)))

