def blk(+i: Nat) -> {Nat.add(Nat.mul(i, 12n), 12n) == Nat.mul(1n+i, 12n) : Nat}:
  Equal.trans(Nat, Nat.add(Nat.mul(i, 12n), 12n), Nat.add(12n, Nat.mul(i, 12n)), Nat.mul(1n+i, 12n), F.nat__add_comm(Nat.mul(i, 12n), 12n), {==})

def mono(+a: Nat, +b: Nat, +h: {Nat.is_le(a, b) == True{} : Bool}) -> {Nat.is_le(Nat.mul(a, 12n), Nat.mul(b, 12n)) == True{} : Bool}:
  match a b:
    case 0n _: F.nat__zero_le(Nat.mul(b, 12n))
    case 1n+p 0n: Empty.absurd({Nat.is_le(Nat.mul(1n+p, 12n), Nat.mul(0n, 12n)) == True{} : Bool}, F.logic__false_true(h))
    case 1n+p 1n+q: F.nat__le_add_left(Nat.mul(p, 12n), Nat.mul(q, 12n), 12n, mono(p, q, h))

def gap_before(+i: Nat, +J: Nat, +h: {Nat.is_lt(i, J) == True{} : Bool}) -> {Nat.is_le(Nat.add(Nat.mul(i, 12n), 12n), Nat.mul(J, 12n)) == True{} : Bool}:
  F.logic__subst(Nat, z => {Nat.is_le(z, Nat.mul(J, 12n)) == True{} : Bool}, Nat.mul(1n+i, 12n), Nat.add(Nat.mul(i, 12n), 12n), Equal.sym(Nat, Nat.add(Nat.mul(i, 12n), 12n), Nat.mul(1n+i, 12n), blk(i)),
    mono(1n+i, J, F.nat__lt_succ_le_succ(i, J, h)))

# the word m of block i is past the run of block J, when J is before i
def gap_after(+i: Nat, +J: Nat, +m: Nat, +h: {Nat.is_lt(J, i) == True{} : Bool}) -> {Nat.is_le(Nat.add(Nat.mul(J, 12n), 12n), Nat.add(Nat.mul(i, 12n), m)) == True{} : Bool}:
  F.nat__le_trans(Nat.add(Nat.mul(J, 12n), 12n), Nat.mul(i, 12n), Nat.add(Nat.mul(i, 12n), m), gap_before(J, i, h), F.nat__le_add_right(Nat.mul(i, 12n), m))

def ne_lt(+a: Nat, +b: Nat, +h: {Nat.is_lt(a, b) == True{} : Bool}) -> {Nat.is_eq(b, a) == False{} : Bool}:
  WR.neq_sym(a, b, F.nat__is_eq_lt(a, b, h))

def lt_add_succ(+a: Nat, +p: Nat) -> {Nat.is_lt(a, Nat.add(a, 1n+p)) == True{} : Bool}:
  F.logic__subst(Nat, z => {Nat.is_lt(a, z) == True{} : Bool}, 1n+Nat.add(a, p), Nat.add(a, 1n+p), Equal.sym(Nat, Nat.add(a, 1n+p), 1n+Nat.add(a, p), F.nat__add_succ(a, p)),
    F.nat__le_lt_succ(a, Nat.add(a, p), F.nat__le_add_right(a, p)))

