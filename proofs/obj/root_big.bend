def SignedBeaconBlock_rc(-h: B.Buf, -o: T.SignedBeaconBlock, +s: S.Schema, +es: {s == Spec.SignedBeaconBlock() : S.Schema}, +rep: RT.rep_SignedBeaconBlock(o, s), +dv: OS.DV, +edv: {dv == OS.DV0() : OS.DV})
    -> RR.roots(RT.v_SignedBeaconBlock(o), s, [D.bytes(Pair.snd(T.SignedBeaconBlock, D.Digest, Pair.snd(B.Buf, T.SignedBeaconBlock & D.Digest, T.SignedBeaconBlock_hash_tree_root(h, o))))]):
  %Equal.sym(B.Buf & (T.SignedBeaconBlock & D.Digest), T.SignedBeaconBlock_root(64n, h, o, 0), (h, (o, RT.d_SignedBeaconBlock(64n, o))), RT.st_SignedBeaconBlock(64n, h, o, 0, s, rep)) :
    RR.roots(RT.v_SignedBeaconBlock(o), s, [D.bytes(Pair.snd(T.SignedBeaconBlock, D.Digest, Pair.snd(B.Buf, T.SignedBeaconBlock & D.Digest, _)))])
  RT.rs_SignedBeaconBlock(64n, {==}, h, o, s, rep, dv, edv, SignedBeaconBlock_ok(s, es, dv, edv), SignedBeaconBlock_eqs(s, es))
law SignedBeaconBlock_root_correct:
  for -h: B.Buf
  for -o: T.SignedBeaconBlock
  for +s: S.Schema
  for +es: {s == Spec.SignedBeaconBlock() : S.Schema}
  for +rep: RT.rep_SignedBeaconBlock(o, s)
  RR.roots(RT.v_SignedBeaconBlock(o), s, [D.bytes(Pair.snd(T.SignedBeaconBlock, D.Digest, Pair.snd(B.Buf, T.SignedBeaconBlock & D.Digest, T.SignedBeaconBlock_hash_tree_root(h, o))))])
def SignedBeaconBlock_root_correct(h, o, s, es, rep): SignedBeaconBlock_rc(h, o, s, es, rep, OS.DV0(), {==})

