def BeaconBlock_rc(-h: B.Buf, -o: T.BeaconBlock, +s: S.Schema, +es: {s == Spec.BeaconBlock() : S.Schema}, +rep: RT.rep_BeaconBlock(o, s), +dv: OS.DV, +edv: {dv == OS.DV0() : OS.DV})
    -> RR.roots(RT.v_BeaconBlock(o), s, [D.bytes(Pair.snd(T.BeaconBlock, D.Digest, Pair.snd(B.Buf, T.BeaconBlock & D.Digest, T.BeaconBlock_hash_tree_root(h, o))))]):
  %Equal.sym(B.Buf & (T.BeaconBlock & D.Digest), T.BeaconBlock_root(64n, h, o, 0), (h, (o, RT.d_BeaconBlock(64n, o))), RT.st_BeaconBlock(64n, h, o, 0, s, rep)) :
    RR.roots(RT.v_BeaconBlock(o), s, [D.bytes(Pair.snd(T.BeaconBlock, D.Digest, Pair.snd(B.Buf, T.BeaconBlock & D.Digest, _)))])
  RT.rs_BeaconBlock(64n, {==}, h, o, s, rep, dv, edv, BeaconBlock_ok(s, es, dv, edv), BeaconBlock_eqs(s, es))
law BeaconBlock_root_correct:
  for -h: B.Buf
  for -o: T.BeaconBlock
  for +s: S.Schema
  for +es: {s == Spec.BeaconBlock() : S.Schema}
  for +rep: RT.rep_BeaconBlock(o, s)
  RR.roots(RT.v_BeaconBlock(o), s, [D.bytes(Pair.snd(T.BeaconBlock, D.Digest, Pair.snd(B.Buf, T.BeaconBlock & D.Digest, T.BeaconBlock_hash_tree_root(h, o))))])
def BeaconBlock_root_correct(h, o, s, es, rep): BeaconBlock_rc(h, o, s, es, rep, OS.DV0(), {==})

