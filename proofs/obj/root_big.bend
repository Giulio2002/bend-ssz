def BeaconBlockBody_rc(-h: B.Buf, -o: T.BeaconBlockBody, +s: S.Schema, +es: {s == Spec.BeaconBlockBody() : S.Schema}, +rep: RT.rep_BeaconBlockBody(o, s), +dv: OS.DV, +edv: {dv == OS.DV0() : OS.DV})
    -> RR.roots(RT.v_BeaconBlockBody(o), s, [D.bytes(Pair.snd(T.BeaconBlockBody, D.Digest, Pair.snd(B.Buf, T.BeaconBlockBody & D.Digest, T.BeaconBlockBody_hash_tree_root(h, o))))]):
  %Equal.sym(B.Buf & (T.BeaconBlockBody & D.Digest), T.BeaconBlockBody_root(64n, h, o, 0), (h, (o, RT.d_BeaconBlockBody(64n, o))), RT.st_BeaconBlockBody(64n, h, o, 0, s, rep)) :
    RR.roots(RT.v_BeaconBlockBody(o), s, [D.bytes(Pair.snd(T.BeaconBlockBody, D.Digest, Pair.snd(B.Buf, T.BeaconBlockBody & D.Digest, _)))])
  RT.rs_BeaconBlockBody(64n, {==}, h, o, s, rep, dv, edv, BeaconBlockBody_ok(s, es, dv, edv), BeaconBlockBody_eqs(s, es))
law BeaconBlockBody_root_correct:
  for -h: B.Buf
  for -o: T.BeaconBlockBody
  for +s: S.Schema
  for +es: {s == Spec.BeaconBlockBody() : S.Schema}
  for +rep: RT.rep_BeaconBlockBody(o, s)
  RR.roots(RT.v_BeaconBlockBody(o), s, [D.bytes(Pair.snd(T.BeaconBlockBody, D.Digest, Pair.snd(B.Buf, T.BeaconBlockBody & D.Digest, T.BeaconBlockBody_hash_tree_root(h, o))))])
def BeaconBlockBody_root_correct(h, o, s, es, rep): BeaconBlockBody_rc(h, o, s, es, rep, OS.DV0(), {==})

