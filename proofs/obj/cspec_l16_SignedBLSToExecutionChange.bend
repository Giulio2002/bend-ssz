# The buffer the element loop leaves (positions i .. i + k written).
def rbo(k: Nat, +i: U32, +off: U32, pr: B.Buf & FuluSignedBLSToExecutionChange_d.SignedBLSToExecutionChange) -> B.Buf:
  match k:
    case 0n:
      (b, +v) = pr
      b
    case 1n+q:
      (b, +v) = pr
      rbo(q, (i + 1 : U32), off, FuluSignedBLSToExecutionChange_r.SignedBLSToExecutionChange_read(b, (off + (i + 1 : U32) * 172 : U32), 172))

# The element loop over a perfect tree of depth D returns (rbo, thaw u) for a
# perfect tree u (the tree is a witness, so the loop's input is used once).
def rd_eq(k: Nat, +i: U32, +off: U32, +D: Nat, +t: F.array__Tree<FuluSignedBLSToExecutionChange_d.SignedBLSToExecutionChange>, pr: B.Buf & FuluSignedBLSToExecutionChange_d.SignedBLSToExecutionChange,
    +hD: {Nat.is_lt(D, 32n) == True{} : Bool},
    +pf: {F.array__perfect(FuluSignedBLSToExecutionChange_d.SignedBLSToExecutionChange, D, t) == True{} : Bool},
    +hk: {Nat.is_le(Nat.add(U32.to_nat(i), 1n+k), F.spec_common__pow2(D)) == True{} : Bool})
    -> DK.Ex(F.array__Tree<FuluSignedBLSToExecutionChange_d.SignedBLSToExecutionChange>, u => DK.P2({Fulu_list_SignedBLSToExecutionChange_16_r.l16_SignedBLSToExecutionChange_rd(k, i, off, F.array__thaw(FuluSignedBLSToExecutionChange_d.SignedBLSToExecutionChange, t), pr) == (rbo(k, i, off, pr), F.array__thaw(FuluSignedBLSToExecutionChange_d.SignedBLSToExecutionChange, u)) : B.Buf & Array<FuluSignedBLSToExecutionChange_d.SignedBLSToExecutionChange>},
                                             {F.array__perfect(FuluSignedBLSToExecutionChange_d.SignedBLSToExecutionChange, D, u) == True{} : Bool})):
  match k:
    case 0n:
      match pr:
        case (b, +v):
          +hi = CA.step_lt(U32.to_nat(i), 0n, F.spec_common__pow2(D), hk)
          (F.array__upd(FuluSignedBLSToExecutionChange_d.SignedBLSToExecutionChange, D, t, U32.to_nat(i), v),
           (Equal.cong(Array<FuluSignedBLSToExecutionChange_d.SignedBLSToExecutionChange>, B.Buf & Array<FuluSignedBLSToExecutionChange_d.SignedBLSToExecutionChange>, x => (b, x), Array.set(FuluSignedBLSToExecutionChange_d.SignedBLSToExecutionChange, F.array__thaw(FuluSignedBLSToExecutionChange_d.SignedBLSToExecutionChange, t), i, v), F.array__thaw(FuluSignedBLSToExecutionChange_d.SignedBLSToExecutionChange, F.array__upd(FuluSignedBLSToExecutionChange_d.SignedBLSToExecutionChange, D, t, U32.to_nat(i), v)),
              F.array__set(FuluSignedBLSToExecutionChange_d.SignedBLSToExecutionChange, D, t, i, v, CA.xat(F.array__slots(FuluSignedBLSToExecutionChange_d.SignedBLSToExecutionChange, t), U32.to_nat(i)), hD, hi, CA.item_nth(t, D, i, pf, hi), pf)),
            F.array__upd_perfect(FuluSignedBLSToExecutionChange_d.SignedBLSToExecutionChange, D, t, U32.to_nat(i), v, pf)))
    case 1n+ +q:
      match pr:
        case (b, +v):
          +hi = CA.step_lt(U32.to_nat(i), 1n+q, F.spec_common__pow2(D), hk)
          +ei = CA.i_next(i, 1n+q, D, hD, hk)
          %Equal.sym(Array<FuluSignedBLSToExecutionChange_d.SignedBLSToExecutionChange>, Array.set(FuluSignedBLSToExecutionChange_d.SignedBLSToExecutionChange, F.array__thaw(FuluSignedBLSToExecutionChange_d.SignedBLSToExecutionChange, t), i, v), F.array__thaw(FuluSignedBLSToExecutionChange_d.SignedBLSToExecutionChange, F.array__upd(FuluSignedBLSToExecutionChange_d.SignedBLSToExecutionChange, D, t, U32.to_nat(i), v)),
              F.array__set(FuluSignedBLSToExecutionChange_d.SignedBLSToExecutionChange, D, t, i, v, CA.xat(F.array__slots(FuluSignedBLSToExecutionChange_d.SignedBLSToExecutionChange, t), U32.to_nat(i)), hD, hi, CA.item_nth(t, D, i, pf, hi), pf)) :
            DK.Ex(F.array__Tree<FuluSignedBLSToExecutionChange_d.SignedBLSToExecutionChange>, u => DK.P2({Fulu_list_SignedBLSToExecutionChange_16_r.l16_SignedBLSToExecutionChange_rd(q, (i + 1 : U32), off, _, FuluSignedBLSToExecutionChange_r.SignedBLSToExecutionChange_read(b, (off + (i + 1 : U32) * 172 : U32), 172))
                   == (rbo(q, (i + 1 : U32), off, FuluSignedBLSToExecutionChange_r.SignedBLSToExecutionChange_read(b, (off + (i + 1 : U32) * 172 : U32), 172)), F.array__thaw(FuluSignedBLSToExecutionChange_d.SignedBLSToExecutionChange, u)) : B.Buf & Array<FuluSignedBLSToExecutionChange_d.SignedBLSToExecutionChange>},
                  {F.array__perfect(FuluSignedBLSToExecutionChange_d.SignedBLSToExecutionChange, D, u) == True{} : Bool}))
