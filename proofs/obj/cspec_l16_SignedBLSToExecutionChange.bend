  WS2.wd_cover(n, k, F.nat__le_trans(k, 30n, 32n, hk, {==}), hn)

# Positions 0 .. n - 1 fit depth D, for 1 <= n <= 2^D.
def start_bound(+n: U32, +D: Nat, +h1: {Nat.is_le(1n, U32.to_nat(n)) == True{} : Bool},
    +hcov: {Nat.is_le(U32.to_nat(n), F.spec_common__pow2(D)) == True{} : Bool})
    -> {Nat.is_le(Nat.add(U32.to_nat(0), 1n+U32.to_nat((n - 1 : U32))), F.spec_common__pow2(D)) == True{} : Bool}:
  %Equal.sym(Nat, U32.to_nat(U32.sub(n, 1)), Nat.sub(U32.to_nat(n), U32.to_nat(1)), F.u32__sub_nat(n, 1, h1)) :
    {Nat.is_le(Nat.add(U32.to_nat(0), 1n+_), F.spec_common__pow2(D)) == True{} : Bool}
  %Equal.sym(Nat, Nat.add(1n, Nat.sub(U32.to_nat(n), 1n)), U32.to_nat(n), F.nat__sub_add(U32.to_nat(n), 1n, h1)) :
    {Nat.is_le(_, F.spec_common__pow2(D)) == True{} : Bool}
  hcov

def read_fin(+n: U32, +D: Nat, +s: S.Schema, -RD: B.Buf & Array<FuluSignedBLSToExecutionChange_d.SignedBLSToExecutionChange>, -B0: B.Buf,
    +ex: DK.Ex(F.array__Tree<FuluSignedBLSToExecutionChange_d.SignedBLSToExecutionChange>, u => DK.P2({RD == (B0, F.array__thaw(FuluSignedBLSToExecutionChange_d.SignedBLSToExecutionChange, u)) : B.Buf & Array<FuluSignedBLSToExecutionChange_d.SignedBLSToExecutionChange>}, {F.array__perfect(FuluSignedBLSToExecutionChange_d.SignedBLSToExecutionChange, D, u) == True{} : Bool})),
    +hD: {Nat.is_lt(D, 32n) == True{} : Bool},
    +hcov: {Nat.is_le(U32.to_nat(n), F.spec_common__pow2(D)) == True{} : Bool},
    +hlim: {Nat.is_le(U32.to_nat(n), SH.ListOf_limit(s)) == True{} : Bool})
    -> RT.rep_l16_SignedBLSToExecutionChange(sqr(Fulu_list_SignedBLSToExecutionChange_16_r.l16_SignedBLSToExecutionChange_rd_fin(n, RD)), s):
  (+TT, w) = ex
  (+e, +pt) = w
  %Equal.sym(B.Buf & Array<FuluSignedBLSToExecutionChange_d.SignedBLSToExecutionChange>, RD, (B0, F.array__thaw(FuluSignedBLSToExecutionChange_d.SignedBLSToExecutionChange, TT)), e) : RT.rep_l16_SignedBLSToExecutionChange(sqr(Fulu_list_SignedBLSToExecutionChange_16_r.l16_SignedBLSToExecutionChange_rd_fin(n, _)), s)
  ((TT, (D, (n, ({==}, (pt, (hD, hcov)))))), hlim)

# A nonempty list field of n = len / 172 >= 1 elements, n <= 2^k (k <= 30) and
# n <= the schema limit: the decoder's value satisfies the representation invariant.
law read_rep:
  for buf: B.Buf
  for +off: U32
  for +len: U32
  for +s: S.Schema
  for +k: Nat
  for +hk: {Nat.is_le(k, 30n) == True{} : Bool}
  for +hne: {U32.is_eq(len, 0) == False{} : Bool}
