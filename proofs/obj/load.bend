      word_of_bits(a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15, a16, a17, a18, a19, a20, a21, a22, a23, a24, a25, a26, a27, a28, a29, a30, a31)

# The words the loader stores for the bytes of a word list.
def wofs(ws: List<&2, U32>) -> List<&2, U32>:
  match ws:
    case Nil{}: Nil{}
    case Con{+h, t}: Con{B.word_of(B.byte_sel(0, h), B.byte_sel(1, h), B.byte_sel(2, h), B.byte_sel(3, h)), wofs(t)}
law wofs_id:
  for +ws: List<&2, U32>
  {wofs(ws) == ws : List<&2, U32>}
def wofs_id(ws):
  match ws:
    case Nil{}: {==}
    case Con{+h, +t}:
      %Equal.sym(U32, B.word_of(B.byte_sel(0, h), B.byte_sel(1, h), B.byte_sel(2, h), B.byte_sel(3, h)), h, word_of_bytes(h)) :
        {Con{_, wofs(t)} == Con{h, t} : List<&2, U32>}
      FD.list__cons_cong(U32, h, wofs(t), t, wofs_id(t))

def load_4(+x0: U32)
    -> {B.fill_at(B.alloc(4), 0, F.limbs([x0])) == B.Buf{ALeaf{x0}, 4} : B.Buf}:
  Equal.cong(List<&2, U32>, B.Buf, l => B.Buf{FD.array__thaw(U32, R.build(0n, FD.spec_common__append(U32, l, []))), 4},
    wofs([x0]), [x0], wofs_id([x0]))
def load_8(+x0: U32, +x1: U32)
    -> {B.fill_at(B.alloc(8), 0, F.limbs([x0, x1])) == B.Buf{ANode{ALeaf{x0}, ALeaf{x1}}, 8} : B.Buf}:
