def cwB(+t: FD.array__Tree<U32>, +n: U32, +h: {chkw(True{}, t, n) == True{} : Bool}) -> {U32.is_eq(VWB(t, n), 0) == False{} : Bool}:
  bselF(U32.is_eq(VWB(t, n), 0), O.bsel(False{}, True{}, Nat.is_le(BD(t, n), U32.to_nat(2048))), h)

