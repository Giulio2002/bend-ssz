def OBJ(+t: FD.array__Tree<U32>, +n: U32) -> T.PendingAttestation: T.PendingAttestation{O.Bits{O.clear_bit(O.mask_last(LL(n), FD.array__thaw(U32, VB.mone(VC.NW(LL(n)), 37n, 0n, VLS.DZ(LL(n)), VC.ZT(VLS.DZ(LL(n))), t))), NBW(t, n)), NBW(t, n)}, T.AttestationData{O.U64{VB.slot(t, 1n), VB.slot(t, 2n)}, O.U64{VB.slot(t, 3n), VB.slot(t, 4n)}, T.Bytes32{VB.slot(t, 5n), VB.slot(t, 6n), VB.slot(t, 7n), VB.slot(t, 8n), VB.slot(t, 9n), VB.slot(t, 10n), VB.slot(t, 11n), VB.slot(t, 12n)}, T.Checkpoint{O.U64{VB.slot(t, 13n), VB.slot(t, 14n)}, T.Bytes32{VB.slot(t, 15n), VB.slot(t, 16n), VB.slot(t, 17n), VB.slot(t, 18n), VB.slot(t, 19n), VB.slot(t, 20n), VB.slot(t, 21n), VB.slot(t, 22n)}}, T.Checkpoint{O.U64{VB.slot(t, 23n), VB.slot(t, 24n)}, T.Bytes32{VB.slot(t, 25n), VB.slot(t, 26n), VB.slot(t, 27n), VB.slot(t, 28n), VB.slot(t, 29n), VB.slot(t, 30n), VB.slot(t, 31n), VB.slot(t, 32n)}}}, O.U64{VB.slot(t, 33n), VB.slot(t, 34n)}, O.U64{VB.slot(t, 35n), VB.slot(t, 36n)}}

def acc_go(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hd: {Nat.is_lt(d, 28n) == True{} : Bool},
    +hn: {Nat.is_le(U32.to_nat(n), A.quad(VB.pw(d))) == True{} : Bool}, +hchk: {CHK(t, n) == True{} : Bool},
    +ha: {U32.is_le(148, n) == True{} : Bool}, +epo: {SPO(t) == 148 : U32}, +hw: {CHKW(t, n) == True{} : Bool})
    -> {T.PendingAttestation_decode(BF(t, n), n) == (BF(t, n), Some{OBJ(t, n)}) : B.Buf & Maybe<&1, T.PendingAttestation>}:
  +e1 = cwE(t, n, hw)
  +h1 = cw1(t, n, hw)
  +hL = hLd(d, n, ha, hn)
  +hz = hdzK(d, n, hd, hL, hB(t, n, e1, cwC(t, n, h1, cwB(t, n, h1))))
  +ez = zeros_at(B.words_depth_u(VC.WZ(LL(n))), VLS.DZ(LL(n)), VD.wdu(VC.WZ(LL(n))), hz)
  %Equal.sym(B.Buf & Bool, T.PendingAttestation_ok(BF(t, n), 0, n), (BF(t, n), CHK(t, n)), ok_eval(d, t, n, pf, hd, hn)) :
    {T.PendingAttestation_built(n, _) == (BF(t, n), Some{OBJ(t, n)}) : B.Buf & Maybe<&1, T.PendingAttestation>}
  %Equal.sym(Bool, CHK(t, n), True{}, hchk) :
    {T.PendingAttestation_built(n, (BF(t, n), _)) == (BF(t, n), Some{OBJ(t, n)}) : B.Buf & Maybe<&1, T.PendingAttestation>}
  %Equal.sym(B.Buf & T.PendingAttestation, T.PendingAttestation_read(BF(t, n), 0, n), (BF(t, n), OBJ(t, n)),
      rd_ok(d, t, n, VLS.DZ(LL(n)), pf, hd, FD.nat__le_lt_trans(VLS.DZ(LL(n)), 7n, 31n, hz, {==}), ha, hn, epo, e1, ez, VLS.hrg(d, LL(n), hd, hL))) :
    {T.PendingAttestation_some(_) == (BF(t, n), Some{OBJ(t, n)}) : B.Buf & Maybe<&1, T.PendingAttestation>}
  {==}

# Every buffer the validator accepts decodes to OBJ(t, n).
law decode_accept:
  for +d: Nat
  for +t: FD.array__Tree<U32>
  for +n: U32
  for +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}
  for +hd: {Nat.is_lt(d, 28n) == True{} : Bool}
  for +hn: {Nat.is_le(U32.to_nat(n), A.quad(VB.pw(d))) == True{} : Bool}
  for +hchk: {CHK(t, n) == True{} : Bool}
  {T.PendingAttestation_decode(BF(t, n), n) == (BF(t, n), Some{OBJ(t, n)}) : B.Buf & Maybe<&1, T.PendingAttestation>}
def decode_accept(d, t, n, pf, hd, hn, hchk):
  +a = U32.is_le(148, n)
  +b = U32.is_eq(SPO(t), 148)
  +c = CHKW(t, n)
  acc_go(d, t, n, pf, hd, hn, hchk, ch_a(a, b, c, hchk), FD.u32alg__eq_of(SPO(t), 148, ch_b(a, b, c, hchk)), ch_c(a, b, c, hchk))

# When the validator refuses, the decoder returns None and the buffer.
law decode_none:
  for +d: Nat
  for +t: FD.array__Tree<U32>
  for +n: U32
  for +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}
  for +hd: {Nat.is_lt(d, 28n) == True{} : Bool}
  for +hn: {Nat.is_le(U32.to_nat(n), A.quad(VB.pw(d))) == True{} : Bool}
  for +hchk: {CHK(t, n) == False{} : Bool}
  {T.PendingAttestation_decode(BF(t, n), n) == (BF(t, n), None{}) : B.Buf & Maybe<&1, T.PendingAttestation>}
def decode_none(d, t, n, pf, hd, hn, hchk):
  %Equal.sym(B.Buf & Bool, T.PendingAttestation_ok(BF(t, n), 0, n), (BF(t, n), CHK(t, n)), ok_eval(d, t, n, pf, hd, hn)) :
    {T.PendingAttestation_built(n, _) == (BF(t, n), None{}) : B.Buf & Maybe<&1, T.PendingAttestation>}
  %Equal.sym(Bool, CHK(t, n), False{}, hchk) :
    {T.PendingAttestation_built(n, (BF(t, n), _)) == (BF(t, n), None{}) : B.Buf & Maybe<&1, T.PendingAttestation>}
  {==}


