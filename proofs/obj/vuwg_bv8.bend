    case 0n: VF.updv([w0], dd, D, q)
    case 1n: UW.SWo(1, [w0], dd, D, q, 0)
    case 2n: UW.SWo(2, [w0], dd, D, q, 0)
    case 3n: UW.SWo(3, [w0], dd, D, q, 0)
    case 4n+t: D

