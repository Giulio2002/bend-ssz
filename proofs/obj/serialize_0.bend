  %Equal.sym(Bool, T.SignedVoluntaryExit_valid(o), True{}, e) : {T.SignedVoluntaryExit_ser_pick(_, o) == O.encoded(T.SignedVoluntaryExit_encode(o)) : O.Encoded}
  {==}
def SignedVoluntaryExit_serialize_refused(+o: T.SignedVoluntaryExit, e: {T.SignedVoluntaryExit_valid(o) == False{} : Bool})
    -> {T.SignedVoluntaryExit_serialize(o) == O.refused() : O.Encoded}:
  %Equal.sym(Bool, T.SignedVoluntaryExit_valid(o), False{}, e) : {T.SignedVoluntaryExit_ser_pick(_, o) == O.refused() : O.Encoded}
  {==}
