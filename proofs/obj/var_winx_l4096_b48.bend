def OBJw(+d: Nat, +t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32) -> O.Words: O.Words{FD.array__thaw(U32, UCT.CT(d, t, off, len, VLS.DZ(len))), len}

def readw(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hchk: {CHKw(t, x, off, len) == True{} : Bool})
    -> {T.l4096_b48_read(BF(t, n), off, len) == (BF(t, n), OBJw(d, t, x, off, len)) : B.Buf & O.Words}:
  +hL = hlen(d, x, len, hw)
  +hz = hDZ(d, t, n, x, off, len, eo, hd, hw, pf, hchk)
  +ez = zeros_at(B.words_depth_u(VC.WZ(len)), VLS.DZ(len), VD.wdu(VC.WZ(len)), hz)
  UCT.copy_in_at(d, t, n, off, len, VLS.DZ(len), VLS.KK(d), pf, FD.nat__lt_trans(d, 28n, 31n, hd, {==}), FD.nat__le_lt_trans(VLS.DZ(len), 17n, 31n, hz, {==}), ez,
    UW.hsx(d, off, x, len, eo, hd, hw), VLS.hrg(d, len, hd, hL), VLS.kk_lt(d, hd), VLS.hyn(d, len, hL))

# ---- the value ----------------------------------------------------------------------------------

def VALw(+t: FD.array__Tree<U32>, +x: Nat, +len: U32) -> S.Value: S.Sequence{VM.bvit(CC(len), 12n, UR.RWS(MQ(len), t, x))}

def specw(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hchk: {CHKw(t, x, off, len) == True{} : Bool})
    -> {Codec.parts(VALw(t, x, len), S.ListOf{S.ByteVector{48n}, U32.to_nat(4096)}) == Some{[S.Variable{UW.WX(t, x, U32.to_nat(len))}]} : Maybe<&2, +List<S.Part>>}:
  +c = CC(len)
  +M = MQ(len)
  +W = UR.RWS(M, t, x)
  +el = eqw(len, hchk)
  +hq = FD.logic__subst(Nat, z => {Nat.is_le(Nat.add(x, z), A.quad(VB.pw(d))) == True{} : Bool}, U32.to_nat(len), A.quad(M), el, hw)
  +fit = FD.logic__subst(Nat, z => {N.fits(4n, z) == True{} : Bool}, U32.to_nat(len), A.quad(M), el, VLS.hfit(d, len, hd, hlen(d, x, len, hw)))
  +hl = FD.logic__subst(Nat, z => {Nat.is_le(M, z) == True{} : Bool}, M, VB.len(W), Equal.sym(Nat, VB.len(W), M, UR.rws_len(M, t, x)), FD.nat__le_refl(M))
  %Equal.sym(Nat, U32.to_nat(len), A.quad(M), el) : {Codec.parts(VALw(t, x, len), S.ListOf{S.ByteVector{48n}, U32.to_nat(4096)}) == Some{[S.Variable{UW.WX(t, x, _)}]} : Maybe<&2, +List<S.Part>>}
  %UR.rws_bytes(M, d, t, x, pf, hq) : {Codec.parts(VALw(t, x, len), S.ListOf{S.ByteVector{48n}, U32.to_nat(4096)}) == Some{[S.Variable{_}]} : Maybe<&2, +List<S.Part>>}
  %UR.wtake_rws(M, t, x) : {Codec.parts(VALw(t, x, len), S.ListOf{S.ByteVector{48n}, U32.to_nat(4096)}) == Some{[S.Variable{F.limbs(_)}]} : Maybe<&2, +List<S.Part>>}
  VM.list_bv(c, 12n, 48n, W, U32.to_nat(4096), {==}, {==}, {==}, hcw(len, hchk), hl, fit)


# ---- the inversion ------------------------------------------------------------------------------

def rp_t(+xs: +List<U32>, +el: S.Value, +tl: S.Value, +ps: +List<S.Part>, +mB: Maybe<&2, +List<S.Part>>,
    +eB: {Codec.parts(tl, S.Repeat{S.ByteVector{48n}}) == mB : Maybe<&2, +List<S.Part>>},
    +lx: {List.length(&2, U32, xs) == 48n : Nat},
    +e: {Codec.concatenate(Some{[S.Fixed{xs}]}, mB) == Some{ps} : Maybe<&2, +List<S.Part>>},
    ih: @+pb: +List<S.Part> -> {Codec.parts(tl, S.Repeat{S.ByteVector{48n}}) == Some{pb} : Maybe<&2, +List<S.Part>>} -> VMR.REPB(tl, pb, 48n))
    -> VMR.REPB(S.Items{el, tl}, ps, 48n):
  match mB:
    case None{}: Empty.absurd(VMR.REPB(S.Items{el, tl}, ps, 48n), FD.logic__none_some(+List<S.Part>, ps, e))
    case Some{+pb}:
      +eps = FD.logic__some_inj(+List<S.Part>, S.Fixed{xs} <> pb, ps, e)
      %Equal.sym(+List<S.Part>, ps, S.Fixed{xs} <> pb, Equal.sym(+List<S.Part>, S.Fixed{xs} <> pb, ps, eps)) : VMR.REPB(S.Items{el, tl}, _, 48n)
      VMR.rpb_t2(xs, el, tl, pb, 48n, lx, ih(pb, eB))

def rp_p(+el: S.Value, +tl: S.Value, +ps: +List<S.Part>, +ph: +List<S.Part>, hf: DF.single(Some{48n}, ph),
    +e: {Codec.concatenate(Some{ph}, Codec.parts(tl, S.Repeat{S.ByteVector{48n}})) == Some{ps} : Maybe<&2, +List<S.Part>>},
    ih: @+pb: +List<S.Part> -> {Codec.parts(tl, S.Repeat{S.ByteVector{48n}}) == Some{pb} : Maybe<&2, +List<S.Part>>} -> VMR.REPB(tl, pb, 48n))
    -> VMR.REPB(S.Items{el, tl}, ps, 48n):
  match ph:
    case Nil{}: Empty.absurd(VMR.REPB(S.Items{el, tl}, ps, 48n), hf)
    case Con{S.Fixed{+xs}, Nil{}}:
      rp_t(xs, el, tl, ps, Codec.parts(tl, S.Repeat{S.ByteVector{48n}}), {==}, Equal.sym(Nat, 48n, List.length(&2, U32, xs), FD.logic__some_inj(Nat, 48n, List.length(&2, U32, xs), hf)), e, ih)
    case Con{S.Variable{+xs}, Nil{}}: Empty.absurd(VMR.REPB(S.Items{el, tl}, ps, 48n), FD.logic__none_some(Nat, 48n, Equal.sym(Maybe<&2, Nat>, Some{48n}, None{}, hf)))
    case Con{S.Fixed{+xs}, Con{+a, +b}}: Empty.absurd(VMR.REPB(S.Items{el, tl}, ps, 48n), hf)
    case Con{S.Variable{+xs}, Con{+a, +b}}: Empty.absurd(VMR.REPB(S.Items{el, tl}, ps, 48n), hf)

def rp_m(+el: S.Value, +tl: S.Value, +ps: +List<S.Part>, +mh: Maybe<&2, +List<S.Part>>, hf: DF.single_result(Some{48n}, mh),
    +e: {Codec.concatenate(mh, Codec.parts(tl, S.Repeat{S.ByteVector{48n}})) == Some{ps} : Maybe<&2, +List<S.Part>>},
    ih: @+pb: +List<S.Part> -> {Codec.parts(tl, S.Repeat{S.ByteVector{48n}}) == Some{pb} : Maybe<&2, +List<S.Part>>} -> VMR.REPB(tl, pb, 48n))
    -> VMR.REPB(S.Items{el, tl}, ps, 48n):
  match mh:
    case None{}: Empty.absurd(VMR.REPB(S.Items{el, tl}, ps, 48n), FD.logic__none_some(+List<S.Part>, ps, e))
    case Some{+ph}: rp_p(el, tl, ps, ph, hf, e, ih)

# The parts of records are fixed parts of 48 bytes each.
law rep_r:
  for +its: S.Value
  for +ps: +List<S.Part>
  for +e: {Codec.parts(its, S.Repeat{S.ByteVector{48n}}) == Some{ps} : Maybe<&2, +List<S.Part>>}
  VMR.REPB(its, ps, 48n)
def rep_r(its, ps, e):
  match its:
    case S.EmptyItems{}:
      +eps = FD.logic__some_inj(+List<S.Part>, [], ps, e)
      %Equal.sym(+List<S.Part>, ps, [], Equal.sym(+List<S.Part>, [], ps, eps)) : VMR.REPB(S.EmptyItems{}, _, 48n)
      ({==}, {==})
    case S.Items{+h, +tl}: rp_m(h, tl, ps, Codec.parts(h, S.ByteVector{48n}), DS.facts(h, S.ByteVector{48n}, {==}), e, pb => eb => rep_r(tl, pb, eb))
    case S.BooleanValue{+b}: Empty.absurd(VMR.REPB(S.BooleanValue{b}, ps, 48n), FD.logic__none_some(+List<S.Part>, ps, e))
    case S.UnsignedValue{+u}: Empty.absurd(VMR.REPB(S.UnsignedValue{u}, ps, 48n), FD.logic__none_some(+List<S.Part>, ps, e))
    case S.BytesValue{+xs}: Empty.absurd(VMR.REPB(S.BytesValue{xs}, ps, 48n), FD.logic__none_some(+List<S.Part>, ps, e))
    case S.BitsValue{+bs}: Empty.absurd(VMR.REPB(S.BitsValue{bs}, ps, 48n), FD.logic__none_some(+List<S.Part>, ps, e))
    case S.Sequence{+it}: Empty.absurd(VMR.REPB(S.Sequence{it}, ps, 48n), FD.logic__none_some(+List<S.Part>, ps, e))
    case S.Selected{+sel, +sv}: Empty.absurd(VMR.REPB(S.Selected{sel, sv}, ps, 48n), FD.logic__none_some(+List<S.Part>, ps, e))
    case S.NullValue{}: Empty.absurd(VMR.REPB(S.NullValue{}, ps, 48n), FD.logic__none_some(+List<S.Part>, ps, e))

def lm4(+its: S.Value, +ys: +List<U32>, +hk: {Nat.is_le(Codec.count(its), U32.to_nat(4096)) == True{} : Bool}, +ps: +List<S.Part>,
    +em3: {Codec.parts(its, S.Repeat{S.ByteVector{48n}}) == Some{ps} : Maybe<&2, +List<S.Part>>}, +m4: Maybe<&2, +List<U32>>,
    +em4: {Layout.encoding(ps) == m4 : Maybe<&2, +List<U32>>}, +e: {Codec.bytes(Codec.one(m4, None{})) == Some{ys} : Maybe<&2, +List<U32>>})
    -> VMR.LF(ys, 48n, U32.to_nat(4096)):
  match m4:
    case None{}: Empty.absurd(VMR.LF(ys, 48n, U32.to_nat(4096)), FD.logic__none_some(+List<U32>, ys, e))
    case Some{+zs}:
      +ez = FD.logic__some_inj(+List<U32>, zs, ys, e)
      +lz = Equal.trans(Nat, List.length(&2, U32, zs), Layout.fixed_size(ps), Nat.mul(Codec.count(its), 48n),
        VS.enc_len(ps, zs, Pair.fst({VS.allfix(ps) == True{} : Bool}, {Layout.fixed_size(ps) == Nat.mul(Codec.count(its), 48n) : Nat}, rep_r(its, ps, em3)), em4),
        Pair.snd({VS.allfix(ps) == True{} : Bool}, {Layout.fixed_size(ps) == Nat.mul(Codec.count(its), 48n) : Nat}, rep_r(its, ps, em3)))
      (Codec.count(its), (FD.logic__subst(+List<U32>, z => {List.length(&2, U32, z) == Nat.mul(Codec.count(its), 48n) : Nat}, zs, ys, ez, lz), hk))

def lm3(+its: S.Value, +ys: +List<U32>, +hk: {Nat.is_le(Codec.count(its), U32.to_nat(4096)) == True{} : Bool}, +m3: Maybe<&2, +List<S.Part>>,
    +em3: {Codec.parts(its, S.Repeat{S.ByteVector{48n}}) == m3 : Maybe<&2, +List<S.Part>>}, +e: {Codec.bytes(Codec.aggregate(m3, None{})) == Some{ys} : Maybe<&2, +List<U32>>})
    -> VMR.LF(ys, 48n, U32.to_nat(4096)):
  match m3:
    case None{}: Empty.absurd(VMR.LF(ys, 48n, U32.to_nat(4096)), FD.logic__none_some(+List<U32>, ys, e))
    case Some{+ps}: lm4(its, ys, hk, ps, em3, Layout.encoding(ps), {==}, e)

def lb(+its: S.Value, +ys: +List<U32>, +b: Bool, +eb: {Nat.is_le(Codec.count(its), U32.to_nat(4096)) == b : Bool},
    +e: {Codec.bytes(Codec.require(b, Codec.aggregate(Codec.parts(its, S.Repeat{S.ByteVector{48n}}), None{}))) == Some{ys} : Maybe<&2, +List<U32>>})
    -> VMR.LF(ys, 48n, U32.to_nat(4096)):
  match b:
    case False{}: Empty.absurd(VMR.LF(ys, 48n, U32.to_nat(4096)), FD.logic__none_some(+List<U32>, ys, e))
    case True{}: lm3(its, ys, eb, Codec.parts(its, S.Repeat{S.ByteVector{48n}}), {==}, e)

# The spec bytes ys of any value of the list are whole records, at most 4096.
law linvr:
  for +h: S.Value
  for +ys: +List<U32>
  for +e: {Codec.bytes(Codec.parts(h, S.ListOf{S.ByteVector{48n}, U32.to_nat(4096)})) == Some{ys} : Maybe<&2, +List<U32>>}
  VMR.LF(ys, 48n, U32.to_nat(4096))
def linvr(h, ys, e):
  match h:
    case S.Sequence{+its}: lb(its, ys, Nat.is_le(Codec.count(its), U32.to_nat(4096)), {==}, e)
    case S.BooleanValue{+b0}: Empty.absurd(VMR.LF(ys, 48n, U32.to_nat(4096)), FD.logic__none_some(+List<U32>, ys, e))
    case S.UnsignedValue{+u0}: Empty.absurd(VMR.LF(ys, 48n, U32.to_nat(4096)), FD.logic__none_some(+List<U32>, ys, e))
    case S.BytesValue{+xs0}: Empty.absurd(VMR.LF(ys, 48n, U32.to_nat(4096)), FD.logic__none_some(+List<U32>, ys, e))
    case S.BitsValue{+bs0}: Empty.absurd(VMR.LF(ys, 48n, U32.to_nat(4096)), FD.logic__none_some(+List<U32>, ys, e))
    case S.Items{+hd0, +tl0}: Empty.absurd(VMR.LF(ys, 48n, U32.to_nat(4096)), FD.logic__none_some(+List<U32>, ys, e))
    case S.EmptyItems{}: Empty.absurd(VMR.LF(ys, 48n, U32.to_nat(4096)), FD.logic__none_some(+List<U32>, ys, e))
    case S.Selected{+sel0, +sv0}: Empty.absurd(VMR.LF(ys, 48n, U32.to_nat(4096)), FD.logic__none_some(+List<U32>, ys, e))
    case S.NullValue{}: Empty.absurd(VMR.LF(ys, 48n, U32.to_nat(4096)), FD.logic__none_some(+List<U32>, ys, e))

def chk_i(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, f: VMR.LF(UW.WX(t, x, U32.to_nat(len)), 48n, U32.to_nat(4096))) -> {CHKw(t, x, off, len) == True{} : Bool}:
  (+k, +pr) = f
  (+hl, +hk) = pr
  VU.whole_i(len, 48, 4096, vR(), {==}, {==}, {==}, k,
    Equal.trans(Nat, U32.to_nat(len), List.length(&2, U32, UW.WX(t, x, U32.to_nat(len))), Nat.mul(k, 48n),
      Equal.sym(Nat, List.length(&2, U32, UW.WX(t, x, U32.to_nat(len))), U32.to_nat(len), UW.lenWX(d, t, x, U32.to_nat(len), pf, hw)), hl), hk)

# Every value whose parts are the window's bytes passes the check.
def invw(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +v: S.Value,
    +e: {Codec.parts(v, S.ListOf{S.ByteVector{48n}, U32.to_nat(4096)}) == Some{[S.Variable{UW.WX(t, x, U32.to_nat(len))}]} : Maybe<&2, +List<S.Part>>})
    -> {CHKw(t, x, off, len) == True{} : Bool}:
  chk_i(d, t, n, x, off, len, eo, hd, hw, pf, linvr(v, UW.WX(t, x, U32.to_nat(len)),
    Equal.cong(Maybe<&2, +List<S.Part>>, Maybe<&2, +List<U32>>, z => Codec.bytes(z), Codec.parts(v, S.ListOf{S.ByteVector{48n}, U32.to_nat(4096)}), Some{[S.Variable{UW.WX(t, x, U32.to_nat(len))}]}, e)))

