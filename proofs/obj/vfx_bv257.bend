# the window's 33 bytes: the words' limbs, then the last byte
def wx(+d: Nat, +t: FD.array__Tree<U32>, +x: Nat, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hb: {Nat.is_le(Nat.add(x, 33n), A.quad(VB.pw(d))) == True{} : Bool})
    -> {UW.WX(t, x, 33n) == List.append(&2, U32, F.limbs(UR.RWS(8n, t, x)), [BX(t, Nat.add(32n, x))]) : +List<U32>}:
  %wx1(d, t, Nat.add(32n, x), pf, rm(x, 32n, 1n, {==}, A.quad(VB.pw(d)), hb)) :
    {UW.WX(t, x, 33n) == List.append(&2, U32, F.limbs(UR.RWS(8n, t, x)), _) : +List<U32>}
  %VXG.cnt_eq(x, 8n) : {UW.WX(t, x, 33n) == List.append(&2, U32, F.limbs(UR.RWS(_, t, x)), UW.WX(t, Nat.add(32n, x), 1n)) : +List<U32>}
  VXG.splitC0(d, t, x, pf, 8n, 32n, 1n, 33n, {==}, {==}, hb)

def elen(+t: FD.array__Tree<U32>, +x: Nat) -> {List.length(&2, Bool, List.append(&2, Bool, FB.bitsof(UR.RWS(8n, t, x)), [LB(BX(t, Nat.add(32n, x)))])) == 257n : Nat}:
  %Equal.sym(Nat, List.length(&2, Bool, List.append(&2, Bool, FB.bitsof(UR.RWS(8n, t, x)), [LB(BX(t, Nat.add(32n, x)))])), Nat.add(List.length(&2, Bool, FB.bitsof(UR.RWS(8n, t, x))), 1n), VBL.lenB_app(FB.bitsof(UR.RWS(8n, t, x)), [LB(BX(t, Nat.add(32n, x)))])) : {_ == 257n : Nat}
  %Equal.sym(Nat, List.length(&2, Bool, FB.bitsof(UR.RWS(8n, t, x))), FB.bitlen(UR.RWS(8n, t, x)), FB.len_bits(UR.RWS(8n, t, x))) : {Nat.add(_, 1n) == 257n : Nat}
  {==}

def prt(+d: Nat, +t: FD.array__Tree<U32>, +x: Nat, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hb: {Nat.is_le(Nat.add(x, 33n), A.quad(VB.pw(d))) == True{} : Bool},
    +s: S.Schema, +es: {s == S.BitVector{257n} : S.Schema}, +hchk: {CHK(t, x) == True{} : Bool})
    -> {Codec.parts(VAL(t, x), s) == Some{[S.Fixed{UW.WX(t, x, 33n)}]} : Maybe<&2, +List<S.Part>>}:
  %Equal.sym(S.Schema, s, S.BitVector{257n}, es) : {Codec.parts(VAL(t, x), _) == Some{[S.Fixed{UW.WX(t, x, 33n)}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(+List<U32>, UW.WX(t, x, 33n), List.append(&2, U32, F.limbs(UR.RWS(8n, t, x)), [BX(t, Nat.add(32n, x))]), wx(d, t, x, pf, hb)) : {Codec.parts(VAL(t, x), S.BitVector{257n}) == Some{[S.Fixed{_}]} : Maybe<&2, +List<S.Part>>}
  %ob1(BX(t, Nat.add(32n, x)), hchk) : {Codec.parts(VAL(t, x), S.BitVector{257n}) == Some{[S.Fixed{List.append(&2, U32, F.limbs(UR.RWS(8n, t, x)), [_])}]} : Maybe<&2, +List<S.Part>>}
  %pack_app(UR.RWS(8n, t, x), [LB(BX(t, Nat.add(32n, x)))]) : {Codec.parts(VAL(t, x), S.BitVector{257n}) == Some{[S.Fixed{_}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(Nat, List.length(&2, Bool, List.append(&2, Bool, FB.bitsof(UR.RWS(8n, t, x)), [LB(BX(t, Nat.add(32n, x)))])), 257n, elen(t, x)) :
    {Codec.one(SBF.encoding(Bool.and(Nat.is_lt(0n, 257n), Nat.is_eq(_, 257n)), List.append(&2, Bool, FB.bitsof(UR.RWS(8n, t, x)), [LB(BX(t, Nat.add(32n, x)))])), Some{Nat.div(Nat.add(257n, 7n), 8n)}) == Some{[S.Fixed{Bp.pack(List.append(&2, Bool, FB.bitsof(UR.RWS(8n, t, x)), [LB(BX(t, Nat.add(32n, x)))]))}]} : Maybe<&2, +List<S.Part>>}
  {==}

# ---- every value whose parts are the window's bytes passes the check -------------------------

def GE(k: Nat, z: Nat) -> Bool:
  match k z:
    case 0n _: True{}
    case 1n+q 0n: False{}
    case 1n+q 1n+r: GE(q, r)

def LEN(m: Nat) -> Nat:
  match m:
    case 0n: 1n
    case 1n+p: 8n+LEN(p)

def fxs(m: Maybe<&2, +List<S.Part>>) -> +List<U32>:
  match m:
    case Some{Con{S.Fixed{xs}, r}}: xs
    case _: []

def pk0(+bs: +List<Bool>, +h: {List.length(&2, Bool, bs) == 1n : Nat}) -> {CHKv(VBL.nthb(Bp.pack(bs), 0n)) == True{} : Bool}:
  match bs:
    case Nil{}: Empty.absurd({CHKv(VBL.nthb(Bp.pack(Nil{}), 0n)) == True{} : Bool}, FD.logic__false_true(Equal.sym(Bool, True{}, False{}, Equal.cong(Nat, Bool, z => Nat.is_eq(z, 0n), 0n, 1n, h))))
    case Con{True{}, Nil{}}: {==}
    case Con{False{}, Nil{}}: {==}
    case Con{+b0, Con{+b1, +r}}: Empty.absurd({CHKv(VBL.nthb(Bp.pack(b0 <> b1 <> r), 0n)) == True{} : Bool}, FD.logic__false_true(Equal.cong(Nat, Bool, z => Nat.is_eq(z, 1n), 2n+List.length(&2, Bool, r), 1n, h)))

law pkl:
  for +m: Nat
  for +bs: +List<Bool>
  for +h: {List.length(&2, Bool, bs) == LEN(m) : Nat}
  {CHKv(VBL.nthb(Bp.pack(bs), m)) == True{} : Bool}
def pkl(m, bs, h):
  match m bs:
    case 0n _: pk0(bs, h)
    case 1n+ +p Nil{}: Empty.absurd({CHKv(VBL.nthb(Bp.pack(Nil{}), 1n+p)) == True{} : Bool}, FD.logic__false_true(Equal.cong(Nat, Bool, z => GE(8n, z), 0n, 8n+LEN(p), h)))
    case 1n+ +p Con{+b0, +r0}:
      match r0:
        case Nil{}: Empty.absurd({CHKv(VBL.nthb(Bp.pack(b0 <> Nil{}), 1n+p)) == True{} : Bool}, FD.logic__false_true(Equal.cong(Nat, Bool, z => GE(8n, z), 1n, 8n+LEN(p), h)))
        case Con{+b1, +r1}:
          match r1:
            case Nil{}: Empty.absurd({CHKv(VBL.nthb(Bp.pack(b0 <> b1 <> Nil{}), 1n+p)) == True{} : Bool}, FD.logic__false_true(Equal.cong(Nat, Bool, z => GE(8n, z), 2n, 8n+LEN(p), h)))
            case Con{+b2, +r2}:
              match r2:
                case Nil{}: Empty.absurd({CHKv(VBL.nthb(Bp.pack(b0 <> b1 <> b2 <> Nil{}), 1n+p)) == True{} : Bool}, FD.logic__false_true(Equal.cong(Nat, Bool, z => GE(8n, z), 3n, 8n+LEN(p), h)))
                case Con{+b3, +r3}:
                  match r3:
                    case Nil{}: Empty.absurd({CHKv(VBL.nthb(Bp.pack(b0 <> b1 <> b2 <> b3 <> Nil{}), 1n+p)) == True{} : Bool}, FD.logic__false_true(Equal.cong(Nat, Bool, z => GE(8n, z), 4n, 8n+LEN(p), h)))
                    case Con{+b4, +r4}:
                      match r4:
                        case Nil{}: Empty.absurd({CHKv(VBL.nthb(Bp.pack(b0 <> b1 <> b2 <> b3 <> b4 <> Nil{}), 1n+p)) == True{} : Bool}, FD.logic__false_true(Equal.cong(Nat, Bool, z => GE(8n, z), 5n, 8n+LEN(p), h)))
                        case Con{+b5, +r5}:
                          match r5:
                            case Nil{}: Empty.absurd({CHKv(VBL.nthb(Bp.pack(b0 <> b1 <> b2 <> b3 <> b4 <> b5 <> Nil{}), 1n+p)) == True{} : Bool}, FD.logic__false_true(Equal.cong(Nat, Bool, z => GE(8n, z), 6n, 8n+LEN(p), h)))
                            case Con{+b6, +r6}:
                              match r6:
                                case Nil{}: Empty.absurd({CHKv(VBL.nthb(Bp.pack(b0 <> b1 <> b2 <> b3 <> b4 <> b5 <> b6 <> Nil{}), 1n+p)) == True{} : Bool}, FD.logic__false_true(Equal.cong(Nat, Bool, z => GE(8n, z), 7n, 8n+LEN(p), h)))
                                case Con{+b7, +r7}:
                                  pkl(p, r7, Equal.cong(Nat, Nat, z => FD.nat__pred(FD.nat__pred(FD.nat__pred(FD.nat__pred(FD.nat__pred(FD.nat__pred(FD.nat__pred(FD.nat__pred(z)))))))), 8n+List.length(&2, Bool, r7), 8n+LEN(p), h))

def ivb(+t: FD.array__Tree<U32>, +x: Nat, +bs: +List<Bool>, +b: Bool, +eb: {Nat.is_eq(List.length(&2, Bool, bs), 257n) == b : Bool},
    +e: {Codec.one(SBF.encoding(Bool.and(Nat.is_lt(0n, 257n), b), bs), Some{Nat.div(Nat.add(257n, 7n), 8n)}) == Some{[S.Fixed{UW.WX(t, x, 33n)}]} : Maybe<&2, +List<S.Part>>})
    -> {CHK(t, x) == True{} : Bool}:
  match b:
    case False{}: Empty.absurd({CHK(t, x) == True{} : Bool}, FD.logic__none_some(+List<S.Part>, [S.Fixed{UW.WX(t, x, 33n)}], e))
    case True{}:
      +ey = Equal.cong(Maybe<&2, +List<S.Part>>, +List<U32>, z => fxs(z), Some{[S.Fixed{Bp.pack(bs)}]}, Some{[S.Fixed{UW.WX(t, x, 33n)}]}, e)
      +c = pkl(32n, bs, FD.nat__eq_from_is_eq(List.length(&2, Bool, bs), 257n, eb))
      +c2 = FD.logic__subst(+List<U32>, z => {CHKv(VBL.nthb(z, 32n)) == True{} : Bool}, Bp.pack(bs), UW.WX(t, x, 33n), ey, c)
      +c3 = FD.logic__subst(U32, z => {CHKv(z) == True{} : Bool}, VBL.nthb(UW.WX(t, x, 33n), 32n), VBL.nthb(VS.bdr(x, UA.BYT(t)), 32n), VR.nth_bt(33n, VS.bdr(x, UA.BYT(t)), 32n, {==}), c2)
      +c4 = FD.logic__subst(U32, z => {CHKv(z) == True{} : Bool}, VBL.nthb(VS.bdr(x, UA.BYT(t)), 32n), BX(t, Nat.add(x, 32n)), VR.nth_bdr(x, UA.BYT(t), 32n), c3)
      FD.logic__subst(Nat, z => {CHKv(BX(t, z)) == True{} : Bool}, Nat.add(x, 32n), Nat.add(32n, x), FD.nat__add_comm(x, 32n), c4)

# every value whose parts are the window's bytes passes the check
def inv(+t: FD.array__Tree<U32>, +x: Nat, +v: S.Value, +e: {Codec.parts(v, S.BitVector{257n}) == Some{[S.Fixed{UW.WX(t, x, 33n)}]} : Maybe<&2, +List<S.Part>>}) -> {CHK(t, x) == True{} : Bool}:
  match v:
    case S.BitsValue{+bs}: ivb(t, x, bs, Nat.is_eq(List.length(&2, Bool, bs), 257n), {==}, e)
    case S.BooleanValue{+b}: Empty.absurd({CHK(t, x) == True{} : Bool}, FD.logic__none_some(+List<S.Part>, [S.Fixed{UW.WX(t, x, 33n)}], e))
    case S.UnsignedValue{+u}: Empty.absurd({CHK(t, x) == True{} : Bool}, FD.logic__none_some(+List<S.Part>, [S.Fixed{UW.WX(t, x, 33n)}], e))
    case S.BytesValue{+xs}: Empty.absurd({CHK(t, x) == True{} : Bool}, FD.logic__none_some(+List<S.Part>, [S.Fixed{UW.WX(t, x, 33n)}], e))
    case S.Sequence{+it}: Empty.absurd({CHK(t, x) == True{} : Bool}, FD.logic__none_some(+List<S.Part>, [S.Fixed{UW.WX(t, x, 33n)}], e))
    case S.Items{+hh, +tl}: Empty.absurd({CHK(t, x) == True{} : Bool}, FD.logic__none_some(+List<S.Part>, [S.Fixed{UW.WX(t, x, 33n)}], e))
    case S.EmptyItems{}: Empty.absurd({CHK(t, x) == True{} : Bool}, FD.logic__none_some(+List<S.Part>, [S.Fixed{UW.WX(t, x, 33n)}], e))
    case S.Selected{+sel, +sv}: Empty.absurd({CHK(t, x) == True{} : Bool}, FD.logic__none_some(+List<S.Part>, [S.Fixed{UW.WX(t, x, 33n)}], e))
    case S.NullValue{}: Empty.absurd({CHK(t, x) == True{} : Bool}, FD.logic__none_some(+List<S.Part>, [S.Fixed{UW.WX(t, x, 33n)}], e))

