def rs_bv512(+hl: Nat, +ehl: {hl == 64n : Nat}, +o: Fulu_bitvector_512_d.Bitvector512) -> RR.roots(LV.v_bv512(o), S.BitVector{512n}, [D.bytes(d_bv512(hl, o))]):
