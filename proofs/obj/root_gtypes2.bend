def st_BitsStruct(+hl: Nat, -h: B.Buf, -o: BitsStruct_d.BitsStruct, +seg: U32, +s: S.Schema, +rep: LV.rep_BitsStruct(o, s))
    -> {BitsStruct_h.BitsStruct_root(hl, h, o, seg) == (h, (o, d_BitsStruct(hl, o))) : B.Buf & (BitsStruct_d.BitsStruct & D.Digest)}:
  (+x1, +q0) = rep
  (+x2, +q1) = q0
  (+x4, +q2) = q1
  (+eo, +q3) = q2
  (+rp0, +q4) = q3
  (+rp1, +q5) = q4
  (+rp2, +q6) = q5
