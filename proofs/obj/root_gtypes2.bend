def d_ProgressiveBitsStruct(+hl: Nat, o: ProgressiveBitsStruct_d.ProgressiveBitsStruct) -> D.Digest:
  match o:
    case ProgressiveBitsStruct_d.ProgressiveBitsStruct{g0, g1}:
      match g0:
        case ProgressiveBitsStruct_d.ProgressiveBitsStruct_g0{+x0, x1, x2, +x3, x4, x5, x6, x7}:
          match g1:
            case ProgressiveBitsStruct_d.ProgressiveBitsStruct_g1{x8, x9, x10, x11}:
              MD.rtree(4n, True{}, hl, [RN.d_bv256(hl, x0), BO.bdig(hl, x1, 0n), PBO.pbdig(hl, x2), RN.d_bv257(hl, x3), BO.bdig(hl, x4, 1n), PBO.pbdig(hl, x5), WO.wdig(hl, x6, 3n), BO.bdig(hl, x7, 3n), PBO.pbdig(hl, x8), WO.wdig(hl, x9, 3n), BO.bdig(hl, x10, 3n), PBO.pbdig(hl, x11)], 0n)
