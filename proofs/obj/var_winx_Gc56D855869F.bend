  Equal.trans(Nat, LY.WFS(WSS3()), Nat.add(4n, U32.to_nat(60)), U32.to_nat(64), VA.wfs_c(None{}, WSS4(), 4n, U32.to_nat(60), {==}, wf4()),
    VA.stpL(4, 60, 64, 4n, {==}, {==}, {==}))
def wf2() -> {LY.WFS(WSS2()) == U32.to_nat(65) : Nat}:
  Equal.trans(Nat, LY.WFS(WSS2()), Nat.add(1n, U32.to_nat(64)), U32.to_nat(65), VA.wfs_c(Some{1n}, WSS3(), 1n, U32.to_nat(64), {==}, wf3()),
    VA.stpL(1, 64, 65, 1n, {==}, {==}, {==}))
def wf1() -> {LY.WFS(WSS1()) == U32.to_nat(69) : Nat}:
  Equal.trans(Nat, LY.WFS(WSS1()), Nat.add(4n, U32.to_nat(65)), U32.to_nat(69), VA.wfs_c(None{}, WSS2(), 4n, U32.to_nat(65), {==}, wf2()),
    VA.stpL(4, 65, 69, 4n, {==}, {==}, {==}))
def wf0() -> {LY.WFS(WSS0()) == U32.to_nat(71) : Nat}:
  Equal.trans(Nat, LY.WFS(WSS0()), Nat.add(2n, U32.to_nat(69)), U32.to_nat(71), VA.wfs_c(Some{2n}, WSS1(), 2n, U32.to_nat(69), {==}, wf1()),
    VA.stpL(2, 69, 71, 2n, {==}, {==}, {==}))
# the positions: part i at c_i (the widths before it summed)
def wp1_1() -> {LY.WPOS(WSS1(), 0n) == U32.to_nat(0) : Nat}: VA.wpos_0(WSS1())
def wp1_0() -> {LY.WPOS(WSS0(), 1n) == U32.to_nat(2) : Nat}:
