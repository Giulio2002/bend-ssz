  Equal.trans(Nat, LY.WPOS(WSS0(), 6n), Nat.add(2n, U32.to_nat(65)), U32.to_nat(67), VA.wpos_c(Some{2n}, WSS1(), 5n, 2n, U32.to_nat(65), {==}, wp6_1()),
