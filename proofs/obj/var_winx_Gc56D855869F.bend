  Equal.trans(Nat, LY.WPOS(WSS1(), 3n), Nat.add(4n, U32.to_nat(5)), U32.to_nat(9), VA.wpos_c(None{}, WSS2(), 2n, 4n, U32.to_nat(5), {==}, wp4_2()),
    VA.stpL(4, 5, 9, 4n, {==}, {==}, {==}))
def wp4_0() -> {LY.WPOS(WSS0(), 4n) == U32.to_nat(11) : Nat}:
