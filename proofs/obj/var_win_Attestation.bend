# The spec parts of the value: one variable part, the window's bytes.
def specw(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +i: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == A.quad(i) : Nat},
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(A.quad(i), U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +hw32: {Nat.is_lt(Nat.add(A.quad(i), U32.to_nat(len)), FD.spec_common__pow2(32n)) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hchk: {CHKw(t, i, off, len) == True{} : Bool}) -> {Codec.parts(VALw(t, i, len), Spec.Attestation()) == Some{[S.Variable{VR.WB(t, i, U32.to_nat(len))}]} : Maybe<&2, +List<S.Part>>}:
  +a = U32.is_le(236, len)
  +b = U32.is_eq(SPOw(t, i), 236)
  +c = CH.CHKw(t, JW(i), OWc(off), LLw(len))
  specg(d, t, n, i, off, len, eo, hd, hw, hw32, pf, ch_a(a, b, c, hchk), FD.u32alg__eq_of(SPOw(t, i), 236, ch_b(a, b, c, hchk)), ch_c(a, b, c, hchk))

# ---- every value whose spec parts are the window's bytes passes the checks ------------------

def eP(+hv: S.Value, +ys: +List<U32>, +eh: {Codec.parts(hv, Spec.Schema38()) == Some{[S.Variable{ys}]} : Maybe<&2, +List<S.Part>>}, +xs1: +List<U32>, +lx1: {List.length(&2, U32, xs1) == 128n : Nat}, +xs2: +List<U32>, +lx2: {List.length(&2, U32, xs2) == 96n : Nat}, +xs3: +List<U32>, +lx3: {List.length(&2, U32, xs3) == 8n : Nat}) -> {VRJ.lens([]) == 0n : Nat}:
  {==}

def eQ(+hv: S.Value, +ys: +List<U32>, +eh: {Codec.parts(hv, Spec.Schema38()) == Some{[S.Variable{ys}]} : Maybe<&2, +List<S.Part>>}, +xs1: +List<U32>, +lx1: {List.length(&2, U32, xs1) == 128n : Nat}, +xs2: +List<U32>, +lx2: {List.length(&2, U32, xs2) == 96n : Nat}, +xs3: +List<U32>, +lx3: {List.length(&2, U32, xs3) == 8n : Nat}) -> {VRJ.lens([xs1, xs2, xs3]) == 232n : Nat}:
  %Equal.sym(Nat, List.length(&2, U32, xs1), 128n, lx1) : {Nat.add(_, Nat.add(List.length(&2, U32, xs2), Nat.add(List.length(&2, U32, xs3), 0n))) == 232n : Nat}
  %Equal.sym(Nat, List.length(&2, U32, xs2), 96n, lx2) : {Nat.add(128n, Nat.add(_, Nat.add(List.length(&2, U32, xs3), 0n))) == 232n : Nat}
  %Equal.sym(Nat, List.length(&2, U32, xs3), 8n, lx3) : {Nat.add(128n, Nat.add(96n, Nat.add(_, 0n))) == 232n : Nat}
  {==}

def fz_eq(+hv: S.Value, +ys: +List<U32>, +eh: {Codec.parts(hv, Spec.Schema38()) == Some{[S.Variable{ys}]} : Maybe<&2, +List<S.Part>>}, +xs1: +List<U32>, +lx1: {List.length(&2, U32, xs1) == 128n : Nat}, +xs2: +List<U32>, +lx2: {List.length(&2, U32, xs2) == 96n : Nat}, +xs3: +List<U32>, +lx3: {List.length(&2, U32, xs3) == 8n : Nat}) -> {VRJ.FZ([], [xs1, xs2, xs3]) == 236n : Nat}:
  %Equal.sym(Nat, VRJ.lens([]), 0n, eP(hv, ys, eh, xs1, lx1, xs2, lx2, xs3, lx3)) : {Nat.add(_, 4n+VRJ.lens([xs1, xs2, xs3])) == 236n : Nat}
  %Equal.sym(Nat, VRJ.lens([xs1, xs2, xs3]), 232n, eQ(hv, ys, eh, xs1, lx1, xs2, lx2, xs3, lx3)) : {Nat.add(0n, 4n+_) == 236n : Nat}
  {==}

def f_off(+hv: S.Value, +ys: +List<U32>, +eh: {Codec.parts(hv, Spec.Schema38()) == Some{[S.Variable{ys}]} : Maybe<&2, +List<S.Part>>}, +xs1: +List<U32>, +lx1: {List.length(&2, U32, xs1) == 128n : Nat}, +xs2: +List<U32>, +lx2: {List.length(&2, U32, xs2) == 96n : Nat}, +xs3: +List<U32>, +lx3: {List.length(&2, U32, xs3) == 8n : Nat}) -> {VS.bt(4n, VS.bdr(0n, VRJ.OUT([], ys, [xs1, xs2, xs3]))) == N.digits(4n, 236n) : +List<U32>}:
  %eP(hv, ys, eh, xs1, lx1, xs2, lx2, xs3, lx3) : {VS.bt(4n, VS.bdr(_, VRJ.OUT([], ys, [xs1, xs2, xs3]))) == N.digits(4n, Nat.add(_, 4n+232n)) : +List<U32>}
