def byte_rw_3(+old: U32, +v: U32) -> {U32.and(O.shr_bytes(O.merge_word(old, v, 3, 1), 3), 255) == U32.and(v, 255) : U32}:
  %Equal.sym(U32, U32.and(O.shr_bytes(O.merge_word(old, v, 3, 1), 3), 255), UB.lo8(O.shr_bytes(O.merge_word(old, v, 3, 1), 3)), UB.and255(O.shr_bytes(O.merge_word(old, v, 3, 1), 3))) : {_ == U32.and(v, 255) : U32}
  %Equal.sym(U32, U32.and(v, 255), UB.lo8(v), UB.and255(v)) : {UB.lo8(O.shr_bytes(O.merge_word(old, v, 3, 1), 3)) == _ : U32}
  %Equal.sym(U32, U32.mul(v, 16777216), U32.shln(v, 24n), WM.mul16777216(v)) : {UB.lo8(O.shr_bytes(U32.or(U32.and(old, U32.not(O.mask_at(3, 1))), U32.and(_, O.mask_at(3, 1))), 3)) == UB.lo8(v) : U32}
  byte_go_3(old, v)

# Writing a byte into a word at byte p & 3 (O.merge_word) and reading that byte back (shift, mask) gives
# the low byte of the value written: for every word, position and value.
def byte_rw(+old: U32, +p: U32, +v: U32) -> {U32.and(O.shr_bytes(O.merge_word(old, v, U32.and(p, 3), 1), U32.and(p, 3)), 255) == U32.and(v, 255) : U32}:
  match p:
    case U32{WCon{False{}, WCon{False{}, +r}}}:
      %Equal.sym(Word(30n), Word.and(30n, r, Word.zero(30n)), Word.zero(30n), UB.wand_zero(30n, r)) : {U32.and(O.shr_bytes(O.merge_word(old, v, U32{WCon{False{}, WCon{False{}, _}}}, 1), U32{WCon{False{}, WCon{False{}, _}}}), 255) == U32.and(v, 255) : U32}
      byte_rw_0(old, v)
    case U32{WCon{True{}, WCon{False{}, +r}}}:
      %Equal.sym(Word(30n), Word.and(30n, r, Word.zero(30n)), Word.zero(30n), UB.wand_zero(30n, r)) : {U32.and(O.shr_bytes(O.merge_word(old, v, U32{WCon{True{}, WCon{False{}, _}}}, 1), U32{WCon{True{}, WCon{False{}, _}}}), 255) == U32.and(v, 255) : U32}
      byte_rw_1(old, v)
    case U32{WCon{False{}, WCon{True{}, +r}}}:
      %Equal.sym(Word(30n), Word.and(30n, r, Word.zero(30n)), Word.zero(30n), UB.wand_zero(30n, r)) : {U32.and(O.shr_bytes(O.merge_word(old, v, U32{WCon{False{}, WCon{True{}, _}}}, 1), U32{WCon{False{}, WCon{True{}, _}}}), 255) == U32.and(v, 255) : U32}
      byte_rw_2(old, v)
    case U32{WCon{True{}, WCon{True{}, +r}}}:
      %Equal.sym(Word(30n), Word.and(30n, r, Word.zero(30n)), Word.zero(30n), UB.wand_zero(30n, r)) : {U32.and(O.shr_bytes(O.merge_word(old, v, U32{WCon{True{}, WCon{True{}, _}}}, 1), U32{WCon{True{}, WCon{True{}, _}}}), 255) == U32.and(v, 255) : U32}
      byte_rw_3(old, v)

