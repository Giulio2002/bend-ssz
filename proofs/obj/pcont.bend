    case Nil{} Nil{}: {==}
    case Nil{} Con{True{}, +u}: Empty.absurd({Nil{} == Con{True{}, u} : +List<Bool>}, MD.false_true(h))
    case Nil{} Con{False{}, +u}: Empty.absurd({Nil{} == Con{False{}, u} : +List<Bool>}, MD.false_true(h))
    case Con{True{}, +t} Nil{}: Empty.absurd({Con{True{}, t} == Nil{} : +List<Bool>}, MD.false_true(h))
    case Con{False{}, +t} Nil{}: Empty.absurd({Con{False{}, t} == Nil{} : +List<Bool>}, MD.false_true(h))
    case Con{True{}, +t} Con{True{}, +u}: Equal.cong(+List<Bool>, +List<Bool>, z => Con{True{}, z}, t, u, beq_eq(t, u, h))
    case Con{True{}, +t} Con{False{}, +u}: Empty.absurd({Con{True{}, t} == Con{False{}, u} : +List<Bool>}, MD.false_true(h))
    case Con{False{}, +t} Con{True{}, +u}: Empty.absurd({Con{False{}, t} == Con{True{}, u} : +List<Bool>}, MD.false_true(h))
    case Con{False{}, +t} Con{False{}, +u}: Equal.cong(+List<Bool>, +List<Bool>, z => Con{False{}, z}, t, u, beq_eq(t, u, h))

