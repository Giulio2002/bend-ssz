# Equality of active lists as a Bool (a closed schema fact), and its meaning.
def beq(xs: +List<Bool>, ys: +List<Bool>) -> Bool:
  match xs ys:
    case Nil{} Nil{}: True{}
    case Nil{} Con{True{}, u}: False{}
    case Nil{} Con{False{}, u}: False{}
    case Con{True{}, t} Nil{}: False{}
    case Con{False{}, t} Nil{}: False{}
    case Con{True{}, t} Con{True{}, u}: beq(t, u)
    case Con{True{}, t} Con{False{}, u}: False{}
    case Con{False{}, t} Con{True{}, u}: False{}
    case Con{False{}, t} Con{False{}, u}: beq(t, u)

