    {AC.cpt(2n+j, 2n, c0, c2, F.TNode{_, z}, sl) == F.TNode{S, rp(j, F.flat__nthc(sl, C), F.flat__nthc(sl, 1n+C))} : F.array__Tree<U32>}
  %Equal.sym(F.array__Tree<U32>, AC.cpt(2n+j, 2n, c0, c2, F.TNode{S, z}, sl), F.TNode{S, AC.cpt(1n+j, 2n, c0, Nat.sub(c2, P), z, sl)}, AC.right(1n+j, 2n, c0, c2, S, z, sl, F.nat__eq_le(P, c2, Equal.sym(Nat, c2, P, e2)))) :
    {_ == F.TNode{S, rp(j, F.flat__nthc(sl, C), F.flat__nthc(sl, 1n+C))} : F.array__Tree<U32>}
  %Equal.sym(Nat, c2, P, e2) : {F.TNode{S, AC.cpt(1n+j, 2n, c0, Nat.sub(_, P), z, sl)} == F.TNode{S, rp(j, F.flat__nthc(sl, C), F.flat__nthc(sl, 1n+C))} : F.array__Tree<U32>}
  %Equal.sym(Nat, Nat.sub(P, P), 0n, F.nat__sub_self(P)) : {F.TNode{S, AC.cpt(1n+j, 2n, c0, _, z, sl)} == F.TNode{S, rp(j, F.flat__nthc(sl, C), F.flat__nthc(sl, 1n+C))} : F.array__Tree<U32>}
  %Equal.sym(F.array__Tree<U32>, AC.cpt(1n+j, 2n, c0, 0n, z, sl), rp(j, F.flat__nthc(sl, c0), F.flat__nthc(sl, 1n+c0)), l_rp(j, c0, sl)) :
    {F.TNode{S, _} == F.TNode{S, rp(j, F.flat__nthc(sl, C), F.flat__nthc(sl, 1n+C))} : F.array__Tree<U32>}
  Equal.cong(Nat, F.array__Tree<U32>, c => F.TNode{S, rp(j, F.flat__nthc(sl, c), F.flat__nthc(sl, 1n+c))}, c0, C,
    Equal.trans(Nat, c0, cs(j), C, F.nat__add_zero(cs(j)), F.nat__eq_from_is_eq(cs(j), C, hC)))

# The encoder's copy of a whole blob: 2^(1+j) words from word 0 of S to word 2 of
# a new zero array of depth 2 + j.
def enc_copy(+j: Nat, +nw: U32, +a: U32, +b: U32, +ds: Nat, +S: F.array__Tree<U32>, +T: F.array__Tree<U32>, +C: Nat,
    +h7: {U32.and(nw, 7) == 0 : U32},
    +hk: {Nat.is_eq(AC.oct(U32.to_nat(U32.shrn(nw, 3n))), F.spec_common__pow2(1n+j)) == True{} : Bool},
    +ha: {Nat.is_eq(U32.to_nat(a), 0n) == True{} : Bool}, +hb: {Nat.is_eq(U32.to_nat(b), 2n) == True{} : Bool},
    +hs: {Nat.is_lt(ds, 32n) == True{} : Bool}, +hd: {Nat.is_lt(2n+j, 32n) == True{} : Bool},
    +hA: {Nat.is_le(Nat.add(F.spec_common__pow2(1n+j), 0n), F.spec_common__pow2(ds)) == True{} : Bool},
    +hB: {Nat.is_le(Nat.add(F.spec_common__pow2(1n+j), 2n), F.spec_common__pow2(2n+j)) == True{} : Bool},
    +pS: {F.array__perfect(U32, ds, S) == True{} : Bool},
    +hC: {Nat.is_eq(cs(j), C) == True{} : Bool})
    -> {O.acopy(nw, a, b, Array.new(U32, 2n+j, 0), F.array__thaw(U32, S)) == (F.array__thaw(U32, F.TNode{sp(j, 0n, F.array__slots(U32, S), T, 0, 0), rp(j, F.flat__nthc(F.array__slots(U32, S), C), F.flat__nthc(F.array__slots(U32, S), 1n+C))}), F.array__thaw(U32, S)) : Array<U32> & Array<U32>}:
  +sl = F.array__slots(U32, S)
  +D = F.array__trep(U32, 2n+j, 0)
  %Equal.sym(Array<U32>, Array.new(U32, 2n+j, 0), F.array__thaw(U32, D), F.array__new(U32, 2n+j, 0)) :
    {O.acopy(nw, a, b, _, F.array__thaw(U32, S)) == (F.array__thaw(U32, F.TNode{sp(j, 0n, sl, T, 0, 0), rp(j, F.flat__nthc(sl, C), F.flat__nthc(sl, 1n+C))}), F.array__thaw(U32, S)) : Array<U32> & Array<U32>}
  %Equal.sym(Array<U32> & Array<U32>, O.acopy(nw, a, b, F.array__thaw(U32, D), F.array__thaw(U32, S)), (F.array__thaw(U32, AC.cpt(2n+j, F.spec_common__pow2(1n+j), 0n, 2n, D, sl)), F.array__thaw(U32, S)),
      AC.acp(nw, F.spec_common__pow2(1n+j), a, b, 0n, 2n, ds, 2n+j, S, D, h7, hk, AC.u0(a, ha), AC.u0p(b, 2n, hb), hs, hd, hA, hB, pS, F.array__trep_perfect(U32, 2n+j, 0))) :
    {_ == (F.array__thaw(U32, F.TNode{sp(j, 0n, sl, T, 0, 0), rp(j, F.flat__nthc(sl, C), F.flat__nthc(sl, 1n+C))}), F.array__thaw(U32, S)) : Array<U32> & Array<U32>}
  %Equal.sym(F.array__Tree<U32>, AC.cpt(2n+j, F.spec_common__pow2(1n+j), 0n, 2n, D, sl), F.TNode{sp(j, 0n, sl, T, 0, 0), rp(j, F.flat__nthc(sl, C), F.flat__nthc(sl, 1n+C))}, l_top(j, sl, T, C, hC)) :
    {(F.array__thaw(U32, _), F.array__thaw(U32, S)) == (F.array__thaw(U32, F.TNode{sp(j, 0n, sl, T, 0, 0), rp(j, F.flat__nthc(sl, C), F.flat__nthc(sl, 1n+C))}), F.array__thaw(U32, S)) : Array<U32> & Array<U32>}
  {==}

# The words of [a0, a1 | the first C words of xs ++ ys | the next two | R]: [a0, a1] ++ xs ++ R
# when xs has C + 2 words.
def fin(+xs: List<&2, U32>, +ys: List<&2, U32>, +R: List<&2, U32>, +C: Nat, +N: Nat, +T: F.array__Tree<U32>,
    +hl: {F.spec_common__length(U32, xs) == N : Nat}, +hc: {Nat.is_eq(Nat.add(C, 2n), N) == True{} : Bool})
    -> {F.spec_common__append(U32, nsb(0n, C, F.spec_common__append(U32, xs, ys), T), Con{F.flat__nthc(F.spec_common__append(U32, xs, ys), C), Con{F.flat__nthc(F.spec_common__append(U32, xs, ys), 1n+C), R}}) == F.spec_common__append(U32, xs, R) : List<&2, U32>}:
  +sl = F.spec_common__append(U32, xs, ys)
  +G = F.spec_common__append(U32, xs, R)
  %Equal.sym(List<&2, U32>, nsb(0n, C, sl, T), ns(C, 0n, sl), nsb_ns(0n, C, sl, T)) :
    {F.spec_common__append(U32, _, F.spec_common__append(U32, ns(2n, C, sl), R)) == G : List<&2, U32>}
  %F.list__append_assoc(U32, ns(C, 0n, sl), ns(2n, C, sl), R) :
    {_ == G : List<&2, U32>}
  %Equal.trans(List<&2, U32>, ns(Nat.add(C, 2n), 0n, sl), F.spec_common__append(U32, ns(C, 0n, sl), ns(2n, Nat.add(C, 0n), sl)), F.spec_common__append(U32, ns(C, 0n, sl), ns(2n, C, sl)),
      ns_split(C, 0n, 2n, sl), Equal.cong(Nat, List<&2, U32>, c => F.spec_common__append(U32, ns(C, 0n, sl), ns(2n, c, sl)), Nat.add(C, 0n), C, F.nat__add_zero(C))) :
    {F.spec_common__append(U32, _, R) == G : List<&2, U32>}
  %Equal.sym(Nat, Nat.add(C, 2n), N, F.nat__eq_from_is_eq(Nat.add(C, 2n), N, hc)) :
    {F.spec_common__append(U32, ns(_, 0n, sl), R) == G : List<&2, U32>}
  %hl : {F.spec_common__append(U32, ns(_, 0n, sl), R) == G : List<&2, U32>}
  %Equal.sym(List<&2, U32>, ns(F.spec_common__length(U32, xs), 0n, sl), xs, ns_pre(xs, ys)) :
    {F.spec_common__append(U32, _, R) == G : List<&2, U32>}
  {==}

law take_app0:
  for +xs: List<&2, U32>
  for +ys: List<&2, U32>
  for +m: Nat
  {AH.tk(F.spec_common__append(U32, xs, ys), Nat.add(F.spec_common__length(U32, xs), m)) == F.spec_common__append(U32, xs, AH.tk(ys, m)) : List<&2, U32>}
def take_app0(xs, ys, m):
  match xs:
    case Nil{}: {==}
    case Con{+x, +t}: F.list__cons_cong(U32, x, AH.tk(F.spec_common__append(U32, t, ys), Nat.add(F.spec_common__length(U32, t), m)), F.spec_common__append(U32, t, AH.tk(ys, m)), take_app0(t, ys, m))

def take_app(+xs: List<&2, U32>, +ys: List<&2, U32>, +n: Nat, +L: Nat, +m: Nat,
    +hL: {F.spec_common__length(U32, xs) == L : Nat}, +h: {Nat.is_eq(Nat.add(L, m), n) == True{} : Bool})
    -> {AH.tk(F.spec_common__append(U32, xs, ys), n) == F.spec_common__append(U32, xs, AH.tk(ys, m)) : List<&2, U32>}:
  %F.nat__eq_from_is_eq(Nat.add(L, m), n, h) :
    {AH.tk(F.spec_common__append(U32, xs, ys), _) == F.spec_common__append(U32, xs, AH.tk(ys, m)) : List<&2, U32>}
  %hL : {AH.tk(F.spec_common__append(U32, xs, ys), Nat.add(_, m)) == F.spec_common__append(U32, xs, AH.tk(ys, m)) : List<&2, U32>}
  take_app0(xs, ys, m)

def len_nsb(+a: Nat, +n: Nat, +sl: List<&2, U32>, +T: F.array__Tree<U32>) -> {F.spec_common__length(U32, nsb(a, n, sl, T)) == n : Nat}:
  %Equal.sym(List<&2, U32>, nsb(a, n, sl, T), ns(n, a, sl), nsb_ns(a, n, sl, T)) : {F.spec_common__length(U32, _) == n : Nat}
  len_ns(n, a, sl)

# slots_sp with the literal count C = c(j), waiting on T
def slots_spb(+j: Nat, +A: Nat, +sl: List<&2, U32>, +T: F.array__Tree<U32>, +a0: U32, +a1: U32, +C: Nat,
    +hC: {Nat.is_eq(cs(j), C) == True{} : Bool})
    -> {F.array__slots(U32, sp(j, A, sl, T, a0, a1)) == Con{a0, Con{a1, nsb(A, C, sl, T)}} : List<&2, U32>}:
  %Equal.sym(List<&2, U32>, F.array__slots(U32, sp(j, A, sl, T, a0, a1)), Con{a0, Con{a1, ns(cs(j), A, sl)}}, slots_sp(j, A, sl, T, a0, a1)) :
    {_ == Con{a0, Con{a1, nsb(A, C, sl, T)}} : List<&2, U32>}
  %Equal.sym(List<&2, U32>, nsb(A, C, sl, T), ns(C, A, sl), nsb_ns(A, C, sl, T)) :
    {Con{a0, Con{a1, ns(cs(j), A, sl)}} == Con{a0, Con{a1, _}} : List<&2, U32>}
  Equal.cong(Nat, List<&2, U32>, c => Con{a0, Con{a1, ns(c, A, sl)}}, cs(j), C, F.nat__eq_from_is_eq(cs(j), C, hC))
