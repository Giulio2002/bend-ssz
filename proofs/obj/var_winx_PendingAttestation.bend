def fp1(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hv: S.Value, +ys: +List<U32>, +eh: {Codec.parts(hv, Spec.Schema43()) == Some{[S.Variable{ys}]} : Maybe<&2, +List<S.Part>>}, +ps: +List<S.Part>, hf: DF.single(Some{128n}, ps), +r: S.Value, +e: {Codec.aggregate(Codec.concatenate(Some{[S.Variable{ys}]}, Codec.concatenate(Some{ps}, Codec.parts(r, S.Chain{Spec.Schema3(), S.Chain{Spec.Schema3(), S.End{}}}))), None{}) == Some{[S.Variable{UW.WX(t, x, U32.to_nat(len))}]} : Maybe<&2, +List<S.Part>>}) -> {CHKw(t, x, off, len) == True{} : Bool}:
  match ps:
    case Nil{}: Empty.absurd({CHKw(t, x, off, len) == True{} : Bool}, hf)
    case Con{S.Fixed{+xs}, Nil{}}: st2(d, t, n, x, off, len, eo, hd, hw, pf, hv, ys, eh, xs, Equal.sym(Nat, 128n, List.length(&2, U32, xs), FD.logic__some_inj(Nat, 128n, List.length(&2, U32, xs), hf)), r, e)
    case Con{S.Variable{+xs}, Nil{}}: Empty.absurd({CHKw(t, x, off, len) == True{} : Bool}, FD.logic__none_some(Nat, 128n, Equal.sym(Maybe<&2, Nat>, Some{128n}, None{}, hf)))
    case Con{S.Fixed{+xs}, Con{+h2, +t2}}: Empty.absurd({CHKw(t, x, off, len) == True{} : Bool}, hf)
    case Con{S.Variable{+xs}, Con{+h2, +t2}}: Empty.absurd({CHKw(t, x, off, len) == True{} : Bool}, hf)

def fm1(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat},
