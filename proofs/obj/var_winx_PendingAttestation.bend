  %Equal.sym(Nat, List.length(&2, U32, xs1), 128n, lx1) : {Nat.add(_, Nat.add(List.length(&2, U32, xs2), Nat.add(List.length(&2, U32, xs3), 0n))) == 144n : Nat}
  %Equal.sym(Nat, List.length(&2, U32, xs2), 8n, lx2) : {Nat.add(128n, Nat.add(_, Nat.add(List.length(&2, U32, xs3), 0n))) == 144n : Nat}
  %Equal.sym(Nat, List.length(&2, U32, xs3), 8n, lx3) : {Nat.add(128n, Nat.add(8n, Nat.add(_, 0n))) == 144n : Nat}
  {==}

