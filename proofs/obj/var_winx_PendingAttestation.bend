    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hv: S.Value, +ys: +List<U32>, +eh: {Codec.parts(hv, Spec.Schema43()) == Some{[S.Variable{ys}]} : Maybe<&2, +List<S.Part>>}, +xs1: +List<U32>, +lx1: {List.length(&2, U32, xs1) == 128n : Nat}, +items: S.Value, +e: {Codec.aggregate(Codec.concatenate(Some{[S.Variable{ys}]}, Codec.concatenate(Some{[S.Fixed{xs1}]}, Codec.parts(items, S.Chain{Spec.Schema3(), S.Chain{Spec.Schema3(), S.End{}}}))), None{}) == Some{[S.Variable{UW.WX(t, x, U32.to_nat(len))}]} : Maybe<&2, +List<S.Part>>}) -> {CHKw(t, x, off, len) == True{} : Bool}:
