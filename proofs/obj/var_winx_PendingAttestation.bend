def fitw(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +ha: {U32.is_le(148, len) == True{} : Bool}) -> {N.fits(4n, Nat.add(VS.FSZ([], [[UR.RWN(t, 4n+x), UR.RWN(t, 8n+x), UR.RWN(t, 12n+x), UR.RWN(t, 16n+x), UR.RWN(t, 20n+x), UR.RWN(t, 24n+x), UR.RWN(t, 28n+x), UR.RWN(t, 32n+x), UR.RWN(t, 36n+x), UR.RWN(t, 40n+x), UR.RWN(t, 44n+x), UR.RWN(t, 48n+x), UR.RWN(t, 52n+x), UR.RWN(t, 56n+x), UR.RWN(t, 60n+x), UR.RWN(t, 64n+x), UR.RWN(t, 68n+x), UR.RWN(t, 72n+x), UR.RWN(t, 76n+x), UR.RWN(t, 80n+x), UR.RWN(t, 84n+x), UR.RWN(t, 88n+x), UR.RWN(t, 92n+x), UR.RWN(t, 96n+x), UR.RWN(t, 100n+x), UR.RWN(t, 104n+x), UR.RWN(t, 108n+x), UR.RWN(t, 112n+x), UR.RWN(t, 116n+x), UR.RWN(t, 120n+x), UR.RWN(t, 124n+x), UR.RWN(t, 128n+x)], [UR.RWN(t, 132n+x), UR.RWN(t, 136n+x)], [UR.RWN(t, 140n+x), UR.RWN(t, 144n+x)]]), List.length(&2, U32, UW.WX(t, JW(x), U32.to_nat(LLw(len)))))) == True{} : Bool}:
  %Equal.sym(Nat, List.length(&2, U32, UW.WX(t, JW(x), U32.to_nat(LLw(len)))), U32.to_nat(LLw(len)), UW.lenWX(d, t, JW(x), U32.to_nat(LLw(len)), pf, hwc(d, t, n, x, off, len, eo, hd, hw, pf, ha))) : {N.fits(4n, Nat.add(148n, _)) == True{} : Bool}
  %Equal.sym(Nat, Nat.add(148n, U32.to_nat(LLw(len))), U32.to_nat(len), enF(len, ha)) : {N.fits(4n, _) == True{} : Bool}
  VFT.fits4(2n+d, U32.to_nat(len), hlen(d, x, len, hw), FD.nat__lt_trans(d, 28n, 30n, hd, {==}))

