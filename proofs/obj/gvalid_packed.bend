  +r1 = DK.and_r(SH.is_Vector(s), Bool.and(SH.is_Unsigned(SH.Vector_element(s)), Bool.and(PB.is_U8(SH.Unsigned_width(SH.Vector_element(s))), Lim.minimal(Nat.div(Nat.add(Nat.mul(SH.Vector_length(s), 1n), 31n), 32n), depth))), ok)
  +k1 = DK.and_l(SH.is_Unsigned(SH.Vector_element(s)), Bool.and(PB.is_U8(SH.Unsigned_width(SH.Vector_element(s))), Lim.minimal(Nat.div(Nat.add(Nat.mul(SH.Vector_length(s), 1n), 31n), 32n), depth)), r1)
  +r2 = DK.and_r(SH.is_Unsigned(SH.Vector_element(s)), Bool.and(PB.is_U8(SH.Unsigned_width(SH.Vector_element(s))), Lim.minimal(Nat.div(Nat.add(Nat.mul(SH.Vector_length(s), 1n), 31n), 32n), depth)), r1)
  +k2 = DK.and_l(PB.is_U8(SH.Unsigned_width(SH.Vector_element(s))), Lim.minimal(Nat.div(Nat.add(Nat.mul(SH.Vector_length(s), 1n), 31n), 32n), depth), r2)
  +r3 = DK.and_r(PB.is_U8(SH.Unsigned_width(SH.Vector_element(s))), Lim.minimal(Nat.div(Nat.add(Nat.mul(SH.Vector_length(s), 1n), 31n), 32n), depth), r2)
  +hvN = VO.eq_at(o, t, N, SH.Vector_length(s), eo, hv)
