def ez(+len: U32, +hx: {BLW(LL(len)) == True{} : Bool}) -> {B.zeros(B.words_depth_u(VC.WZ(LL(len)))) == Array.new(U32, DZ(len), 0) : Array<U32>}:
  zeros_at(B.words_depth_u(VC.WZ(LL(len))), DZ(len), VD.wdu(VC.WZ(LL(len))), hdz(len, hx))

def hr(+len: U32, +hx: {BLW(LL(len)) == True{} : Bool}) -> {Nat.is_le(Nat.add(VC.NW(LL(len)), 0n), VB.pw(DZ(len))) == True{} : Bool}:
  %Equal.sym(Nat, Nat.add(VC.NW(LL(len)), 0n), VC.NW(LL(len)), FD.nat__add_zero(VC.NW(LL(len)))) : {Nat.is_le(_, VB.pw(DZ(len))) == True{} : Bool}
  %Equal.sym(Nat, VB.pw(DZ(len)), O.pow2n(DZ(len)), VD.s_pow2_eq(DZ(len))) : {Nat.is_le(VC.NW(LL(len)), _) == True{} : Bool}
  FD.nat__le_trans(VC.NW(LL(len)), U32.to_nat(VC.WZ(LL(len))), O.pow2n(DZ(len)),
    VC.nw_le_wz(LL(len), 6n, {==}, hyL(len, hx)),
    VD.wd_cover(VC.WZ(LL(len)), 4n, {==}, hWZ(len, hx)))


# The byte list's words lie in the buffer.
def hsv(+d: Nat, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat}, +hd: {Nat.is_lt(d, 28n) == True{} : Bool},
    +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +ha: {U32.is_le(584, len) == True{} : Bool})
    -> {Nat.is_le(Nat.add(VC.NW(LL(len)), VRT.QX(U32.add(off, 584))), VB.pw(d)) == True{} : Bool}:
  UW.hsx(d, U32.add(off, 584), Nat.add(U32.to_nat(584), x), LL(len), eoc(d, x, off, len, 584, {==}, eo, hd, hw, ha), hd, hwv(d, x, len, hw, ha))

# The offset word, once checked, reads as 584.
def rdo(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat}, +hd: {Nat.is_lt(d, 28n) == True{} : Bool},
    +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +ha: {U32.is_le(584, len) == True{} : Bool}, +epo: {SPOw(t, x) == 584 : U32})
    -> {B.read32(UA.BF(t, n), U32.add(off, 436)) == (UA.BF(t, n), 584) : B.Buf & U32}:
  %Equal.sym(B.Buf & U32, B.read32(UA.BF(t, n), U32.add(off, 436)), (UA.BF(t, n), SPOw(t, x)), rdoff(d, t, n, x, off, len, eo, hd, hw, pf, ha)) :
    {_ == (UA.BF(t, n), 584) : B.Buf & U32}
  %Equal.sym(U32, SPOw(t, x), 584, epo) : {(UA.BF(t, n), _) == (UA.BF(t, n), 584) : B.Buf & U32}
  {==}

