def specw_go(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +len: U32, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +ha: {U32.is_le(584, len) == True{} : Bool}, +epo: {SPOw(t, x) == 584 : U32}, +hx: {BLW(LL(len)) == True{} : Bool})
    -> {Codec.parts(VALw(t, x, len), Spec.ExecutionPayloadHeader()) == Some{[S.Variable{UW.WX(t, x, U32.to_nat(len))}]} : Maybe<&2, +List<S.Part>>}:
  %bytesw(d, t, x, len, pf, hw, ha, epo) :
    {Codec.parts(VALw(t, x, len), Spec.ExecutionPayloadHeader()) == Some{[S.Variable{_}]} : Maybe<&2, +List<S.Part>>}
  encpw(t, x, UW.WX(t, Nat.add(A.quad(146n), x), U32.to_nat(LL(len))), UW.domWX(t, Nat.add(A.quad(146n), x), U32.to_nat(LL(len))), len_y(d, t, x, len, pf, hw, ha, hx))

# When the window's checks hold, the spec parts of VALw are its bytes, as one variable part.
def specw(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat}, +hd: {Nat.is_lt(d, 28n) == True{} : Bool},
    +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hchk: {CHKw(t, x, off, len) == True{} : Bool})
    -> {Codec.parts(VALw(t, x, len), Spec.ExecutionPayloadHeader()) == Some{[S.Variable{UW.WX(t, x, U32.to_nat(len))}]} : Maybe<&2, +List<S.Part>>}:
  +a = U32.is_le(584, len)
  +b = U32.is_eq(SPOw(t, x), 584)
  +c = BLW(U32.sub(len, SPOw(t, x)))
  +epo = FD.u32alg__eq_of(SPOw(t, x), 584, chk_b(a, b, c, hchk))
  specw_go(d, t, n, x, len, pf, hw, chk_a(a, b, c, hchk), epo,
    FD.logic__subst(U32, z => {BLW(U32.sub(len, z)) == True{} : Bool}, SPOw(t, x), 584, epo, chk_c(a, b, c, hchk)))


# ---- every value whose spec parts are the window's bytes passes the checks ----------------------

def ek_sub(+n: U32, +k: Nat, +en: {U32.to_nat(n) == Nat.add(584n, k) : Nat}) -> {U32.to_nat(LL(n)) == k : Nat}:
  +le = FD.logic__subst(Nat, z => {Nat.is_le(584n, z) == True{} : Bool}, Nat.add(584n, k), U32.to_nat(n), Equal.sym(Nat, U32.to_nat(n), Nat.add(584n, k), en), Order.below_sum(584n, k))
  %Equal.sym(Nat, U32.to_nat(LL(n)), Nat.sub(U32.to_nat(n), 584n), FD.u32__sub_nat(n, 584, le)) : {_ == k : Nat}
  %Equal.sym(Nat, U32.to_nat(n), Nat.add(584n, k), en) : {Nat.sub(_, 584n) == k : Nat}
  FD.nat__add_sub_cancel(584n, k)

def chk_truew(+t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32, +k: Nat, +en: {U32.to_nat(len) == Nat.add(584n, k) : Nat},
    +hk: {Nat.is_le(k, 32n) == True{} : Bool}, +epo: {SPOw(t, x) == 584 : U32}) -> {CHKw(t, x, off, len) == True{} : Bool}:
  +le = FD.logic__subst(Nat, z => {Nat.is_le(584n, z) == True{} : Bool}, Nat.add(584n, k), U32.to_nat(len), Equal.sym(Nat, U32.to_nat(len), Nat.add(584n, k), en), Order.below_sum(584n, k))
  +hL = FD.logic__subst(Nat, z => {Nat.is_le(z, 32n) == True{} : Bool}, k, U32.to_nat(LL(len)), Equal.sym(Nat, U32.to_nat(LL(len)), k, ek_sub(len, k, en)), hk)
  %Equal.sym(Bool, U32.is_le(584, len), True{}, FD.logic__subst(Bool, z => {z == True{} : Bool}, Nat.is_le(584n, U32.to_nat(len)), U32.is_le(584, len), Equal.sym(Bool, U32.is_le(584, len), Nat.is_le(584n, U32.to_nat(len)), VU.le_u32(584, len)), le)) :
    {chk3(_, U32.is_eq(SPOw(t, x), 584), BLW(U32.sub(len, SPOw(t, x)))) == True{} : Bool}
  %Equal.sym(U32, SPOw(t, x), 584, epo) : {chk3(True{}, U32.is_eq(_, 584), BLW(U32.sub(len, _))) == True{} : Bool}
  FD.logic__subst(Bool, z => {z == True{} : Bool}, Nat.is_le(U32.to_nat(LL(len)), U32.to_nat(32)), U32.is_le(LL(len), 32), Equal.sym(Bool, U32.is_le(LL(len), 32), Nat.is_le(U32.to_nat(LL(len)), U32.to_nat(32)), VU.le_u32(LL(len), 32)), hL)

# The four bytes at the window's offset field are the limbs of its offset word.
def byteP(+d: Nat, +t: FD.array__Tree<U32>, +x: Nat, +len: U32, +k: Nat, +en: {U32.to_nat(len) == Nat.add(584n, k) : Nat}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool})
    -> {VS.bt(4n, VS.bdr(436n, UW.WX(t, x, U32.to_nat(len)))) == F.limbs([SPOw(t, x)]) : +List<U32>}:
  +hw2 = FD.logic__subst(Nat, z => {Nat.is_le(Nat.add(x, z), A.quad(VB.pw(d))) == True{} : Bool}, U32.to_nat(len), Nat.add(436n, 4n+Nat.add(144n, k)), en, hw)
  %Equal.sym(Nat, U32.to_nat(len), Nat.add(436n, 4n+Nat.add(144n, k)), en) : {VS.bt(4n, VS.bdr(436n, UW.WX(t, x, _))) == F.limbs([SPOw(t, x)]) : +List<U32>}
  UW.byteWX(d, t, x, 436n, Nat.add(144n, k), pf, hw2)

def inv_facts(+d: Nat, +t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, facts: XI.FACTS(UW.WX(t, x, U32.to_nat(len))))
    -> {CHKw(t, x, off, len) == True{} : Bool}:
  (+hb, ex) = facts
  (+k, +pr) = ex
  (+hlen, +hk) = pr
  +en = Equal.trans(Nat, U32.to_nat(len), List.length(&2, U32, UW.WX(t, x, U32.to_nat(len))), Nat.add(584n, k), Equal.sym(Nat, List.length(&2, U32, UW.WX(t, x, U32.to_nat(len))), U32.to_nat(len), UW.lenWX(d, t, x, U32.to_nat(len), pf, hw)), hlen)
  +epo = XI.wordFS(SPOw(t, x), Equal.trans(+List<U32>, F.limbs([SPOw(t, x)]), VS.bt(4n, VS.bdr(436n, UW.WX(t, x, U32.to_nat(len)))), [72, 2, 0, 0],
    Equal.sym(+List<U32>, VS.bt(4n, VS.bdr(436n, UW.WX(t, x, U32.to_nat(len)))), F.limbs([SPOw(t, x)]), byteP(d, t, x, len, k, en, pf, hw)), hb))
  chk_truew(t, x, off, len, k, en, hk, epo)

# Every value whose spec parts are the window's bytes passes the checks.
def invw(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat}, +hd: {Nat.is_lt(d, 28n) == True{} : Bool},
    +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +v: S.Value, +e: {Codec.parts(v, Spec.ExecutionPayloadHeader()) == Some{[S.Variable{UW.WX(t, x, U32.to_nat(len))}]} : Maybe<&2, +List<S.Part>>})
    -> {CHKw(t, x, off, len) == True{} : Bool}:
  inv_facts(d, t, x, off, len, pf, hw, XI.inv_p(v, UW.WX(t, x, U32.to_nat(len)), e))

