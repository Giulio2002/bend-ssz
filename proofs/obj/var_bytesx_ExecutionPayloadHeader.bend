# When the window's checks hold, the reader returns OBJw(d, t, x, off, len).
def readw(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat}, +hd: {Nat.is_lt(d, 28n) == True{} : Bool},
    +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hchk: {CHKw(t, x, off, len) == True{} : Bool})
    -> {FuluExecutionPayloadHeader_r.ExecutionPayloadHeader_read(UA.BF(t, n), off, len) == (UA.BF(t, n), OBJw(d, t, x, off, len)) : B.Buf & FuluExecutionPayloadHeader_d.ExecutionPayloadHeader}:
  +a = U32.is_le(584, len)
  +b = U32.is_eq(SPOw(t, x), 584)
  +c = BLW(U32.sub(len, SPOw(t, x)))
  +epo = FD.u32alg__eq_of(SPOw(t, x), 584, chk_b(a, b, c, hchk))
  rdw_go(d, t, n, x, off, len, eo, hd, hw, pf, chk_a(a, b, c, hchk), epo,
    FD.logic__subst(U32, z => {BLW(U32.sub(len, z)) == True{} : Bool}, SPOw(t, x), 584, epo, chk_c(a, b, c, hchk)))


# ---- the spec side ------------------------------------------------------------------------------

# The value of the window's fixed words and byte list Y, through its named field suffixes.
def XCV17(+t: FD.array__Tree<U32>, +x: Nat, +Y: +List<U32>) -> S.Value: S.EmptyItems{}
def XCS17() -> S.Schema: S.End{}
def XCP17(+t: FD.array__Tree<U32>, +x: Nat, +Y: +List<U32>) -> +List<S.Part>: Nil{}
def XCV16(+t: FD.array__Tree<U32>, +x: Nat, +Y: +List<U32>) -> S.Value: S.Items{S.UnsignedValue{P.UInt{UR.RWN(t, 256n+256n+64n+x), UR.RWN(t, 256n+256n+68n+x), 0, 0, 0, 0, 0, 0}}, XCV17(t, x, Y)}
def XCS16() -> S.Schema: S.Chain{S.Unsigned{P.U64{}}, XCS17()}
def XCP16(+t: FD.array__Tree<U32>, +x: Nat, +Y: +List<U32>) -> +List<S.Part>: Con{S.Fixed{F.limbs([UR.RWN(t, 256n+256n+64n+x), UR.RWN(t, 256n+256n+68n+x)])}, XCP17(t, x, Y)}
def XCV15(+t: FD.array__Tree<U32>, +x: Nat, +Y: +List<U32>) -> S.Value: S.Items{S.UnsignedValue{P.UInt{UR.RWN(t, 256n+256n+56n+x), UR.RWN(t, 256n+256n+60n+x), 0, 0, 0, 0, 0, 0}}, XCV16(t, x, Y)}
def XCS15() -> S.Schema: S.Chain{S.Unsigned{P.U64{}}, XCS16()}
def XCP15(+t: FD.array__Tree<U32>, +x: Nat, +Y: +List<U32>) -> +List<S.Part>: Con{S.Fixed{F.limbs([UR.RWN(t, 256n+256n+56n+x), UR.RWN(t, 256n+256n+60n+x)])}, XCP16(t, x, Y)}
def XCV14(+t: FD.array__Tree<U32>, +x: Nat, +Y: +List<U32>) -> S.Value: S.Items{S.BytesValue{F.limbs([UR.RWN(t, 256n+256n+24n+x), UR.RWN(t, 256n+256n+28n+x), UR.RWN(t, 256n+256n+32n+x), UR.RWN(t, 256n+256n+36n+x), UR.RWN(t, 256n+256n+40n+x), UR.RWN(t, 256n+256n+44n+x), UR.RWN(t, 256n+256n+48n+x), UR.RWN(t, 256n+256n+52n+x)])}, XCV15(t, x, Y)}
def XCS14() -> S.Schema: S.Chain{S.ByteVector{32n}, XCS15()}
def XCP14(+t: FD.array__Tree<U32>, +x: Nat, +Y: +List<U32>) -> +List<S.Part>: Con{S.Fixed{F.limbs([UR.RWN(t, 256n+256n+24n+x), UR.RWN(t, 256n+256n+28n+x), UR.RWN(t, 256n+256n+32n+x), UR.RWN(t, 256n+256n+36n+x), UR.RWN(t, 256n+256n+40n+x), UR.RWN(t, 256n+256n+44n+x), UR.RWN(t, 256n+256n+48n+x), UR.RWN(t, 256n+256n+52n+x)])}, XCP15(t, x, Y)}
