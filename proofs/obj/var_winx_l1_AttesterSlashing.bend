def VQ(q: Nat, +t: FD.array__Tree<U32>, +x: Nat, +len: U32) -> S.Value:
  match q:
    case 1n: VAL1(t, x, len)
    case _: S.Sequence{S.EmptyItems{}}

def V4(s: Bool, +t: FD.array__Tree<U32>, +x: Nat, +len: U32) -> S.Value:
  match s:
    case True{}: S.Sequence{S.EmptyItems{}}
    case False{}: VQ(NQ(t, x), t, x, len)

