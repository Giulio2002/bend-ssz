  for +hN: {U32.is_le(n, VB.NMAX()) == True{} : Bool}
  for +hchk: {CHK(t, n) == False{} : Bool}
  for +hPB: {PBQ(t, n) == True{} : Bool}
  Decoding.outside_image(Spec.ProgressiveVarTestStruct(), VW(t, n))
