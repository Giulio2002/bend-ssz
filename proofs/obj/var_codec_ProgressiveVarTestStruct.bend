    +v: S.Value, +e: {Codec.encoding_for_legal_type(Spec.ProgressiveVarTestStruct(), v) == Some{VW(t, n)} : Maybe<&2, +List<U32>>}, +hPB: {PBQ(t, n) == True{} : Bool}) -> Empty:
