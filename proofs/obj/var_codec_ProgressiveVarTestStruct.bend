    case S.Sequence{+items}:
      FD.logic__true_false(Equal.trans(Bool, True{}, CHK(t, n), False{},
        Equal.sym(Bool, CHK(t, n), True{}, W.invwD(d, t, n, 0n, 0, n, {==}, hd, hn, FD.logic__subst(Bool, z => {z == True{} : Bool}, U32.is_le(n, VB.NMAX()), Nat.is_le(U32.to_nat(n), U32.to_nat(VB.NMAX())), VB.le_u32n(n, VB.NMAX()), hN), pf, S.Sequence{items}, agg_var(Codec.parts(items, S.Chain{S.Unsigned{P.U8{}}, S.Chain{S.ListOf{S.Unsigned{P.U16{}}, 123n}, S.Chain{S.ProgressiveBits{}, S.End{}}}}), VW(t, n), e), pbq1(t, n, hPB))), hchk))
    case S.BooleanValue{+b0}: FD.logic__none_some(+List<U32>, VW(t, n), e)
