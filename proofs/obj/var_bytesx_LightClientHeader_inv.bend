# Every byte string the spec relates to a value has the checked shape.
law inv_v:
  for +v: S.Value
  for +bs: +List<U32>
  for +e: {Codec.encoding_for_legal_type(Spec.LightClientHeader(), v) == Some{bs} : Maybe<&2, +List<U32>>}
  FACTS(bs)
def inv_v(v, bs, e):
  match v:
    case S.BooleanValue{+b0}: Empty.absurd(FACTS(bs), F.logic__none_some(+List<U32>, bs, e))
    case S.UnsignedValue{+u0}: Empty.absurd(FACTS(bs), F.logic__none_some(+List<U32>, bs, e))
    case S.BytesValue{+xs0}: Empty.absurd(FACTS(bs), F.logic__none_some(+List<U32>, bs, e))
    case S.BitsValue{+bs0}: Empty.absurd(FACTS(bs), F.logic__none_some(+List<U32>, bs, e))
    case S.Sequence{+items}: st0(items, bs, e)
    case S.Items{+hd0, +tl0}: Empty.absurd(FACTS(bs), F.logic__none_some(+List<U32>, bs, e))
    case S.EmptyItems{}: Empty.absurd(FACTS(bs), F.logic__none_some(+List<U32>, bs, e))
    case S.Selected{+sel0, +sv0}: Empty.absurd(FACTS(bs), F.logic__none_some(+List<U32>, bs, e))
    case S.NullValue{}: Empty.absurd(FACTS(bs), F.logic__none_some(+List<U32>, bs, e))

def q0(xs: +List<U32>) -> U32:
  match xs:
    case Con{h, t}: h
    case Nil{}: 0
def q1(xs: +List<U32>) -> U32:
  match xs:
    case Con{h, t}: q0(t)
    case Nil{}: 0
def q2(xs: +List<U32>) -> U32:
  match xs:
    case Con{h, t}: q1(t)
    case Nil{}: 0
def q3(xs: +List<U32>) -> U32:
  match xs:
    case Con{h, t}: q2(t)
    case Nil{}: 0

# A word whose limbs are those of 244 is 244.
def wordFS(+x: U32, +h: {FX.limbs([x]) == [244, 0, 0, 0] : +List<U32>}) -> {x == 244 : U32}:
  Equal.trans(U32, x, BT.asm(B.byte_sel(0, x), B.byte_sel(1, x), B.byte_sel(2, x), B.byte_sel(3, x)), 244, BT.reassemble(x),
    BT.asm_cong(B.byte_sel(0, x), B.byte_sel(1, x), B.byte_sel(2, x), B.byte_sel(3, x), 244, 0, 0, 0,
      Equal.cong(+List<U32>, U32, l => q0(l), FX.limbs([x]), [244, 0, 0, 0], h),
      Equal.cong(+List<U32>, U32, l => q1(l), FX.limbs([x]), [244, 0, 0, 0], h),
      Equal.cong(+List<U32>, U32, l => q2(l), FX.limbs([x]), [244, 0, 0, 0], h),
      Equal.cong(+List<U32>, U32, l => q3(l), FX.limbs([x]), [244, 0, 0, 0], h)))

# Every value whose spec parts are one variable part has its bytes in the checked shape.
def inv_p(+v: S.Value, +bs: +List<U32>, +e: {Codec.parts(v, Spec.LightClientHeader()) == Some{[S.Variable{bs}]} : Maybe<&2, +List<S.Part>>}) -> FACTS(bs):
  inv_v(v, bs, Equal.cong(Maybe<&2, +List<S.Part>>, Maybe<&2, +List<U32>>, z => Codec.bytes(z), Codec.parts(v, Spec.LightClientHeader()), Some{[S.Variable{bs}]}, e))
