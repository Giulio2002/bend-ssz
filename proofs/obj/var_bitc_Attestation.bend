def OBJ(+t: FD.array__Tree<U32>, +n: U32) -> FuluAttestation_d.Attestation: FuluAttestation_d.Attestation{O.Bits{O.clear_bit(O.mask_last(LL(n), FD.array__thaw(U32, VB.mone(VC.NW(LL(n)), 59n, 0n, VLS.DZ(LL(n)), VC.ZT(VLS.DZ(LL(n))), t))), NBW(t, n)), NBW(t, n)}, FuluAttestationData_d.AttestationData{O.U64{VB.slot(t, 1n), VB.slot(t, 2n)}, O.U64{VB.slot(t, 3n), VB.slot(t, 4n)}, FuluBytes32_d.Bytes32{VB.slot(t, 5n), VB.slot(t, 6n), VB.slot(t, 7n), VB.slot(t, 8n), VB.slot(t, 9n), VB.slot(t, 10n), VB.slot(t, 11n), VB.slot(t, 12n)}, FuluCheckpoint_d.Checkpoint{O.U64{VB.slot(t, 13n), VB.slot(t, 14n)}, FuluBytes32_d.Bytes32{VB.slot(t, 15n), VB.slot(t, 16n), VB.slot(t, 17n), VB.slot(t, 18n), VB.slot(t, 19n), VB.slot(t, 20n), VB.slot(t, 21n), VB.slot(t, 22n)}}, FuluCheckpoint_d.Checkpoint{O.U64{VB.slot(t, 23n), VB.slot(t, 24n)}, FuluBytes32_d.Bytes32{VB.slot(t, 25n), VB.slot(t, 26n), VB.slot(t, 27n), VB.slot(t, 28n), VB.slot(t, 29n), VB.slot(t, 30n), VB.slot(t, 31n), VB.slot(t, 32n)}}}, FuluBytes96_d.Bytes96{VB.slot(t, 33n), VB.slot(t, 34n), VB.slot(t, 35n), VB.slot(t, 36n), VB.slot(t, 37n), VB.slot(t, 38n), VB.slot(t, 39n), VB.slot(t, 40n), VB.slot(t, 41n), VB.slot(t, 42n), VB.slot(t, 43n), VB.slot(t, 44n), VB.slot(t, 45n), VB.slot(t, 46n), VB.slot(t, 47n), VB.slot(t, 48n), VB.slot(t, 49n), VB.slot(t, 50n), VB.slot(t, 51n), VB.slot(t, 52n), VB.slot(t, 53n), VB.slot(t, 54n), VB.slot(t, 55n), VB.slot(t, 56n)}, Fulu_bitvector_64_d.Bitvector64{VB.slot(t, 57n), VB.slot(t, 58n)}}

def acc_go(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hd: {Nat.is_lt(d, 31n) == True{} : Bool},
    +hn: {Nat.is_le(U32.to_nat(n), A.quad(VB.pw(d))) == True{} : Bool}, +hchk: {CHK(t, n) == True{} : Bool},
    +ha: {U32.is_le(236, n) == True{} : Bool}, +epo: {SPO(t) == 236 : U32}, +hw: {CHKW(t, n) == True{} : Bool})
    -> {FuluAttestation_r.Attestation_decode(BF(t, n), n) == (BF(t, n), Some{OBJ(t, n)}) : B.Buf & Maybe<&1, FuluAttestation_d.Attestation>}:
  +e1 = cwE(t, n, hw)
  +h1 = cw1(t, n, hw)
  +hL = hLd(d, n, ha, hn)
  +hb = hB(t, n, e1, cwC(t, n, h1, cwB(t, n, h1)))
  +hz = hdzK(d, n, hd, hL, hb)
  +ez = zeros_at(B.words_depth_u(VC.WZ(LL(n))), VLS.DZ(LL(n)), VD.wdu(VC.WZ(LL(n))), hz)
  %Equal.sym(B.Buf & Bool, FuluAttestation_r.Attestation_ok(BF(t, n), 0, n), (BF(t, n), CHK(t, n)), ok_eval(d, t, n, pf, hd, hn)) :
    {FuluAttestation_r.Attestation_built(n, _) == (BF(t, n), Some{OBJ(t, n)}) : B.Buf & Maybe<&1, FuluAttestation_d.Attestation>}
  %Equal.sym(Bool, CHK(t, n), True{}, hchk) :
    {FuluAttestation_r.Attestation_built(n, (BF(t, n), _)) == (BF(t, n), Some{OBJ(t, n)}) : B.Buf & Maybe<&1, FuluAttestation_d.Attestation>}
  %Equal.sym(B.Buf & FuluAttestation_d.Attestation, FuluAttestation_r.Attestation_read(BF(t, n), 0, n), (BF(t, n), OBJ(t, n)),
      rd_ok(d, t, n, VLS.DZ(LL(n)), pf, hd, FD.nat__le_lt_trans(VLS.DZ(LL(n)), 13n, 31n, hz, {==}), ha, hn, epo, e1, hb, ez, hrgB(n, hb))) :
    {FuluAttestation_r.Attestation_some(_) == (BF(t, n), Some{OBJ(t, n)}) : B.Buf & Maybe<&1, FuluAttestation_d.Attestation>}
  {==}

# Every buffer the validator accepts decodes to OBJ(t, n).
law decode_accept:
  for +d: Nat
  for +t: FD.array__Tree<U32>
  for +n: U32
  for +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}
  for +hd: {Nat.is_lt(d, 31n) == True{} : Bool}
  for +hn: {Nat.is_le(U32.to_nat(n), A.quad(VB.pw(d))) == True{} : Bool}
  for +hchk: {CHK(t, n) == True{} : Bool}
  {FuluAttestation_r.Attestation_decode(BF(t, n), n) == (BF(t, n), Some{OBJ(t, n)}) : B.Buf & Maybe<&1, FuluAttestation_d.Attestation>}
def decode_accept(d, t, n, pf, hd, hn, hchk):
  +a = U32.is_le(236, n)
  +b = U32.is_eq(SPO(t), 236)
  +c = CHKW(t, n)
  acc_go(d, t, n, pf, hd, hn, hchk, ch_a(a, b, c, hchk), FD.u32alg__eq_of(SPO(t), 236, ch_b(a, b, c, hchk)), ch_c(a, b, c, hchk))

# When the validator refuses, the decoder returns None and the buffer.
law decode_none:
  for +d: Nat
  for +t: FD.array__Tree<U32>
  for +n: U32
  for +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}
  for +hd: {Nat.is_lt(d, 31n) == True{} : Bool}
  for +hn: {Nat.is_le(U32.to_nat(n), A.quad(VB.pw(d))) == True{} : Bool}
  for +hchk: {CHK(t, n) == False{} : Bool}
  {FuluAttestation_r.Attestation_decode(BF(t, n), n) == (BF(t, n), None{}) : B.Buf & Maybe<&1, FuluAttestation_d.Attestation>}
def decode_none(d, t, n, pf, hd, hn, hchk):
  %Equal.sym(B.Buf & Bool, FuluAttestation_r.Attestation_ok(BF(t, n), 0, n), (BF(t, n), CHK(t, n)), ok_eval(d, t, n, pf, hd, hn)) :
    {FuluAttestation_r.Attestation_built(n, _) == (BF(t, n), None{}) : B.Buf & Maybe<&1, FuluAttestation_d.Attestation>}
  %Equal.sym(Bool, CHK(t, n), False{}, hchk) :
    {FuluAttestation_r.Attestation_built(n, (BF(t, n), _)) == (BF(t, n), None{}) : B.Buf & Maybe<&1, FuluAttestation_d.Attestation>}
  {==}


