  match b:
    case True{}: {==}
    case False{}: {==}
def b2048_api_set_flag(-ws: Array<U32>, +n: U32, +i: U32, +v: U32) -> {Pair.snd(O.Words, Bool, b2048_c.b2048_set(O.Words{ws, n}, i, v)) == Bool.and(U32.is_lt(i, n), U32.is_le(v, 255)) : Bool}:
  b2048_flag_set(Bool.and(U32.is_lt(i, n), U32.is_le(v, 255)), ws, n, i, v)
