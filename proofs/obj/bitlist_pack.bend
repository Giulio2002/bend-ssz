def cutw31(+x: U32, +rest: +List<U32>, +z: {zw(31n, x) == True{} : Bool}) -> {Bp.pack(btk(31n, List.append(&2, Bool, BLf.wbits(x), bitsof(rest)))) == WS.btake(Bp.byte_count(31n), List.append(&2, U32, I.limb(x), FX.limbs(rest))) : +List<U32>}:
  match x:
    case U32{WCon{+a0, WCon{+a1, WCon{+a2, WCon{+a3, WCon{+a4, WCon{+a5, WCon{+a6, WCon{+a7, WCon{+a8, WCon{+a9, WCon{+a10, WCon{+a11, WCon{+a12, WCon{+a13, WCon{+a14, WCon{+a15, WCon{+a16, WCon{+a17, WCon{+a18, WCon{+a19, WCon{+a20, WCon{+a21, WCon{+a22, WCon{+a23, WCon{+a24, WCon{+a25, WCon{+a26, WCon{+a27, WCon{+a28, WCon{+a29, WCon{+a30, WCon{+a31, WNil{}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}: cut31(a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15, a16, a17, a18, a19, a20, a21, a22, a23, a24, a25, a26, a27, a28, a29, a30, a31, rest, z)

law bpack:
  for +ws: +List<U32>
  for +k: Nat
  for +z: {zt(ws, k) == True{} : Bool}
  {Bp.pack(btk(k, bitsof(ws))) == WS.btake(Bp.byte_count(k), FX.limbs(ws)) : +List<U32>}
def bpack(ws, k, z):
  match ws:
    case Nil{}:
      %Equal.sym(+List<Bool>, btk(k, []), [], btk_nil(k)) : {Bp.pack(_) == WS.btake(Bp.byte_count(k), []) : +List<U32>}
      %Equal.sym(+List<U32>, WS.btake(Bp.byte_count(k), []), [], btake_nil(Bp.byte_count(k))) : {Bp.pack([]) == _ : +List<U32>}
      {==}
    case Con{+x, +rest}:
      match k:
        case 0n: {==}
        case 1n: cutw1(x, rest, z)
        case 2n: cutw2(x, rest, z)
        case 3n: cutw3(x, rest, z)
        case 4n: cutw4(x, rest, z)
        case 5n: cutw5(x, rest, z)
        case 6n: cutw6(x, rest, z)
        case 7n: cutw7(x, rest, z)
        case 8n: cutw8(x, rest, z)
        case 9n: cutw9(x, rest, z)
        case 10n: cutw10(x, rest, z)
        case 11n: cutw11(x, rest, z)
        case 12n: cutw12(x, rest, z)
        case 13n: cutw13(x, rest, z)
        case 14n: cutw14(x, rest, z)
        case 15n: cutw15(x, rest, z)
        case 16n: cutw16(x, rest, z)
        case 17n: cutw17(x, rest, z)
        case 18n: cutw18(x, rest, z)
        case 19n: cutw19(x, rest, z)
        case 20n: cutw20(x, rest, z)
        case 21n: cutw21(x, rest, z)
        case 22n: cutw22(x, rest, z)
        case 23n: cutw23(x, rest, z)
        case 24n: cutw24(x, rest, z)
        case 25n: cutw25(x, rest, z)
        case 26n: cutw26(x, rest, z)
        case 27n: cutw27(x, rest, z)
        case 28n: cutw28(x, rest, z)
        case 29n: cutw29(x, rest, z)
        case 30n: cutw30(x, rest, z)
        case 31n: cutw31(x, rest, z)
        case 32n+p:
          %Equal.sym(+List<Bool>, btk(32n+p, List.append(&2, Bool, BLf.wbits(x), bitsof(rest))), List.append(&2, Bool, BLf.wbits(x), btk(p, bitsof(rest))), btk_w(p, x, bitsof(rest))) :
            {Bp.pack(_) == WS.btake(Bp.byte_count(32n+p), List.append(&2, U32, I.limb(x), FX.limbs(rest))) : +List<U32>}
          %Equal.sym(+List<U32>, Bp.pack(List.append(&2, Bool, BLf.wbits(x), btk(p, bitsof(rest)))), List.append(&2, U32, I.limb(x), Bp.pack(btk(p, bitsof(rest)))), BLf.pack_word(x, btk(p, bitsof(rest)))) :
            {_ == WS.btake(Bp.byte_count(32n+p), List.append(&2, U32, I.limb(x), FX.limbs(rest))) : +List<U32>}
          %Equal.sym(+List<U32>, Bp.pack(btk(p, bitsof(rest))), WS.btake(Bp.byte_count(p), FX.limbs(rest)), bpack(rest, p, z)) :
            {List.append(&2, U32, I.limb(x), _) == WS.btake(Bp.byte_count(32n+p), List.append(&2, U32, I.limb(x), FX.limbs(rest))) : +List<U32>}
          {==}
