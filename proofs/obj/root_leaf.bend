# The four big-endian bytes the SHA-256 message holds for a chunk word are
# the word's four little-endian bytes, which is what SSZ packs.
law bytes_swap:
  for +x: U32
  for +t: +List<U32>
  {D.be_bytes(B.swap32(x), t) == List.append(&2, U32, I.limb(x), t) : +List<U32>}
def bytes_swap(x, t):
  %Equal.sym(U32, (U32.shrn(B.swap32(x), 24n) .&. 255 : U32), U32.and(x, 255), swap0(x)) :
    {_ <> ((U32.shrn(B.swap32(x), 16n) .&. 255 : U32) <> ((U32.shrn(B.swap32(x), 8n) .&. 255 : U32) <> ((B.swap32(x) .&. 255 : U32) <> t))) == List.append(&2, U32, I.limb(x), t) : +List<U32>}
  %Equal.sym(U32, (U32.shrn(B.swap32(x), 16n) .&. 255 : U32), U32.and(U32.shrn(x, 8n), 255), swap1(x)) :
    {U32.and(x, 255) <> (_ <> ((U32.shrn(B.swap32(x), 8n) .&. 255 : U32) <> ((B.swap32(x) .&. 255 : U32) <> t))) == List.append(&2, U32, I.limb(x), t) : +List<U32>}
  %Equal.sym(U32, (U32.shrn(B.swap32(x), 8n) .&. 255 : U32), U32.and(U32.shrn(x, 16n), 255), swap2(x)) :
    {U32.and(x, 255) <> (U32.and(U32.shrn(x, 8n), 255) <> (_ <> ((B.swap32(x) .&. 255 : U32) <> t))) == List.append(&2, U32, I.limb(x), t) : +List<U32>}
  %Equal.sym(U32, (B.swap32(x) .&. 255 : U32), U32.shrn(x, 24n), swap3(x)) :
    {U32.and(x, 255) <> (U32.and(U32.shrn(x, 8n), 255) <> (U32.and(U32.shrn(x, 16n), 255) <> (_ <> t))) == List.append(&2, U32, I.limb(x), t) : +List<U32>}
  {==}

