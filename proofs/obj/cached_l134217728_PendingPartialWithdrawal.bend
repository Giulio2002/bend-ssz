  (+hdw, w1) = iv
  (+pfa, w2) = w1
  (+hcap, w3) = w2
  (+hd, w4) = w3
  (+hdD, w5) = w4
  (+hnd, w6) = w5
  (+pf, w7) = w6
  (+hhi, w8) = w7
