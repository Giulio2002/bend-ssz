# ==== from the instance cloop2.bend ========================================

# The whole root sweep of the cached Merkle tree of the list l134217728_PendingPartialWithdrawal on
# the heap model of ctree.bend. The leaf loop writes each dirty leaf's model
# value: the element's own root (root_names' d_PendingPartialWithdrawal) inside the length and
# the zero chunk past it. The level loops then write each level's dirty range
# [rng(l, lo), rng(l, hi)], and the runtime's shifted heap indices
# (2^d + lo) >> l are the model's heap positions of that range. Together, the
# runtime sweep is ctree's msweep. `XL` is the element-root list:
# xl(n, W, 0, 64) is the roots of the first n elements of the item slots W.

# ---- the element-root list ------------------------------------------------------------------

def xat(W: List<&2, FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal>, +i: Nat) -> FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal:
  match W:
    case Nil{}: FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal_default()
    case Con{+x, t}:
      match i:
        case 0n: x
        case 1n+j: xat(t, j)

law xnth:
  for +W: List<&2, FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal>
  for +i: Nat
  for +hi: {Nat.is_lt(i, F.spec_common__length(FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal, W)) == True{} : Bool}
  {F.spec_common__nth(FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal, W, i) == Some{xat(W, i)} : Maybe<&2, FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal>}
def xnth(W, i, hi):
  match W:
    case Nil{}: Empty.absurd({F.spec_common__nth(FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal, Nil{}, i) == Some{xat(Nil{}, i)} : Maybe<&2, FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal>}, MD.false_true(Equal.trans(Bool, False{}, Nat.is_lt(i, 0n), True{}, Equal.sym(Bool, Nat.is_lt(i, 0n), False{}, F.nat__not_lt_zero(i)), hi)))
    case Con{+x, +t}:
      match i:
        case 0n: {==}
        case 1n+ +j: xnth(t, j, hi)

