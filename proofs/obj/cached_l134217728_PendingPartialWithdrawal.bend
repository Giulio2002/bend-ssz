# ==== from the instance cset.bend ========================================

# A write into the cached validators list (l134217728_PendingPartialWithdrawal_cset) keeps
# the cache invariant of ctree.bend: the element at i < n is replaced, so the
# element roots change at leaf i only, and the dirty range is widened to
# [min(lo, i), max(hi, i)], which covers i and contains the old range; the new
# element roots are dput(old roots, i, root of v) (xl_set), so by cloc.bend's
# cinv_move every node clean for the new range still holds its value.

# ---- the element roots after a write -------------------------------------------------------

law xat_upd:
  for +W: List<&2, FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal>
  for +I: Nat
  for +v: FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal
  for +m: Nat
  for +ne: {Nat.is_eq(I, m) == False{} : Bool}
  {xat(F.spec_common__update(FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal, W, I, v), m) == xat(W, m) : FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal}
def xat_upd(W, I, v, m, ne):
  match W I m:
    case Nil{} _ _: {==}
    case Con{+x, +t} 0n 0n: Empty.absurd({xat(F.spec_common__update(FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal, Con{x, t}, 0n, v), 0n) == xat(Con{x, t}, 0n) : FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal}, MD.true_false(ne))
    case Con{+x, +t} 0n 1n+ +q: {==}
    case Con{+x, +t} 1n+ +p 0n: {==}
    case Con{+x, +t} 1n+ +p 1n+ +q: xat_upd(t, p, v, q, ne)

