  for +W: List<&2, FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal>
  for +I: Nat
  for +v: FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal
  for +hI: {Nat.is_lt(I, F.spec_common__length(FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal, W)) == True{} : Bool}
  {xat(F.spec_common__update(FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal, W, I, v), I) == v : FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal}
