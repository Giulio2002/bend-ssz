# From a valid cache of length n, an ok history of writes and appends ends in a valid cache.
law hist_inv:
  for ops: List<&2, Op>
  for -c: Fulu_list_PendingPartialWithdrawal_134217728_d.l134217728_PendingPartialWithdrawal_Cached
  for +n: U32
  for +k: Nat
  for +hk: {Nat.is_le(k, 30n) == True{} : Bool}
  for +hkD: {Nat.is_le(k, 27n) == True{} : Bool}
  for +hok: ok(ops, n, k)
  for +vc: valid(c)
  for +en: {len_of(c) == n : U32}
  valid(run(ops, c))
