    case 1n+q: RN.d_PendingPartialWithdrawal(hl, xat(W, i)) <> xl(q, W, 1n+i, hl)

law xlen:
  for +k: Nat
  for +W: List<&2, FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal>
  for +i: Nat
  for +hl: Nat
