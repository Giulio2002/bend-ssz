  match W I:
    case Nil{} _: Empty.absurd({xat(F.spec_common__update(FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal, Nil{}, I, v), I) == v : FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal}, CT.lt_zero_absurd(I, hI))
    case Con{+x, +t} 0n: {==}
    case Con{+x, +t} 1n+ +p: xat_upd_same(t, p, v, hI)

# Past the updated index the element roots are unchanged.
law xl_upd_after:
  for +k: Nat
  for +W: List<&2, FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal>
  for +I: Nat
  for +v: FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal
  for +i0: Nat
  for +hl: Nat
  for +h: {Nat.is_lt(I, i0) == True{} : Bool}
  {xl(k, F.spec_common__update(FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal, W, I, v), i0, hl) == xl(k, W, i0, hl) : List<&2, D.Digest>}
def xl_upd_after(k, W, I, v, i0, hl, h):
  match k:
    case 0n: {==}
    case 1n+ +q:
      +W2 = F.spec_common__update(FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal, W, I, v)
      %Equal.sym(FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal, xat(W2, i0), xat(W, i0), xat_upd(W, I, v, i0, F.nat__is_eq_lt(I, i0, h))) :
        {RN.d_PendingPartialWithdrawal(hl, _) <> xl(q, W2, 1n+i0, hl) == RN.d_PendingPartialWithdrawal(hl, xat(W, i0)) <> xl(q, W, 1n+i0, hl) : List<&2, D.Digest>}
      %Equal.sym(List<&2, D.Digest>, xl(q, W2, 1n+i0, hl), xl(q, W, 1n+i0, hl),
          xl_upd_after(q, W, I, v, 1n+i0, hl, F.nat__lt_le_trans(I, i0, 1n+i0, h, F.nat__le_succ(i0)))) :
        {RN.d_PendingPartialWithdrawal(hl, xat(W, i0)) <> _ == RN.d_PendingPartialWithdrawal(hl, xat(W, i0)) <> xl(q, W, 1n+i0, hl) : List<&2, D.Digest>}
      {==}

law le_add_l:
  for +p: Nat
  for +i0: Nat
  {Nat.is_le(i0, Nat.add(p, i0)) == True{} : Bool}
def le_add_l(p, i0):
  match p:
    case 0n: F.nat__le_refl(i0)
    case 1n+ +q: F.nat__le_trans(i0, Nat.add(q, i0), 1n+Nat.add(q, i0), le_add_l(q, i0), F.nat__le_succ(Nat.add(q, i0)))

def hw_shift(+p: Nat, +i0: Nat, +B: Nat, +hW: {Nat.is_lt(Nat.add(1n+p, i0), B) == True{} : Bool})
    -> {Nat.is_lt(Nat.add(p, 1n+i0), B) == True{} : Bool}:
  %Equal.sym(Nat, Nat.add(p, 1n+i0), 1n+Nat.add(p, i0), MR.add_succ(p, i0)) : {Nat.is_lt(_, B) == True{} : Bool}
  hW

# Writing element P + i0 of the items writes leaf P of the element roots from i0.
law xl_set:
  for +k: Nat
  for +W: List<&2, FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal>
  for +P: Nat
  for +i0: Nat
  for +v: FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal
  for +hl: Nat
  for +hP: {Nat.is_lt(P, k) == True{} : Bool}
  for +hW: {Nat.is_lt(Nat.add(P, i0), F.spec_common__length(FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal, W)) == True{} : Bool}
  {xl(k, F.spec_common__update(FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal, W, Nat.add(P, i0), v), i0, hl) == LC.dput(xl(k, W, i0, hl), P, RN.d_PendingPartialWithdrawal(hl, v)) : List<&2, D.Digest>}
def xl_set(k, W, P, i0, v, hl, hP, hW):
  match k P:
    case 0n _:
      Empty.absurd({xl(0n, F.spec_common__update(FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal, W, Nat.add(P, i0), v), i0, hl) == LC.dput(xl(0n, W, i0, hl), P, RN.d_PendingPartialWithdrawal(hl, v)) : List<&2, D.Digest>},
        CT.lt_zero_absurd(P, hP))
    case 1n+ +q 0n:
      +W2 = F.spec_common__update(FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal, W, i0, v)
      %Equal.sym(FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal, xat(W2, i0), v, xat_upd_same(W, i0, v, hW)) :
        {RN.d_PendingPartialWithdrawal(hl, _) <> xl(q, W2, 1n+i0, hl) == RN.d_PendingPartialWithdrawal(hl, v) <> xl(q, W, 1n+i0, hl) : List<&2, D.Digest>}
      %Equal.sym(List<&2, D.Digest>, xl(q, W2, 1n+i0, hl), xl(q, W, 1n+i0, hl),
          xl_upd_after(q, W, i0, v, 1n+i0, hl, F.nat__le_lt_succ(i0, i0, F.nat__le_refl(i0)))) :
        {RN.d_PendingPartialWithdrawal(hl, v) <> _ == RN.d_PendingPartialWithdrawal(hl, v) <> xl(q, W, 1n+i0, hl) : List<&2, D.Digest>}
      {==}
    case 1n+ +q 1n+ +p:
      +J = Nat.add(1n+p, i0)
      +W2 = F.spec_common__update(FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal, W, J, v)
      +ne = CT.neq_of_lt(J, i0, F.nat__le_lt_succ(i0, Nat.add(p, i0), le_add_l(p, i0)))
      %Equal.sym(FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal, xat(W2, i0), xat(W, i0), xat_upd(W, J, v, i0, ne)) :
        {RN.d_PendingPartialWithdrawal(hl, _) <> xl(q, W2, 1n+i0, hl) == RN.d_PendingPartialWithdrawal(hl, xat(W, i0)) <> LC.dput(xl(q, W, 1n+i0, hl), p, RN.d_PendingPartialWithdrawal(hl, v)) : List<&2, D.Digest>}
      %MR.add_succ(p, i0) :
        {RN.d_PendingPartialWithdrawal(hl, xat(W, i0)) <> xl(q, F.spec_common__update(FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal, W, _, v), 1n+i0, hl)
         == RN.d_PendingPartialWithdrawal(hl, xat(W, i0)) <> LC.dput(xl(q, W, 1n+i0, hl), p, RN.d_PendingPartialWithdrawal(hl, v)) : List<&2, D.Digest>}
      %Equal.sym(List<&2, D.Digest>, xl(q, F.spec_common__update(FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal, W, Nat.add(p, 1n+i0), v), 1n+i0, hl), LC.dput(xl(q, W, 1n+i0, hl), p, RN.d_PendingPartialWithdrawal(hl, v)),
          xl_set(q, W, p, 1n+i0, v, hl, hP, hw_shift(p, i0, F.spec_common__length(FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal, W), hW))) :
        {RN.d_PendingPartialWithdrawal(hl, xat(W, i0)) <> _ == RN.d_PendingPartialWithdrawal(hl, xat(W, i0)) <> LC.dput(xl(q, W, 1n+i0, hl), p, RN.d_PendingPartialWithdrawal(hl, v)) : List<&2, D.Digest>}
      {==}

def hw0(+I: Nat, +B: Nat, +hW: {Nat.is_lt(I, B) == True{} : Bool}) -> {Nat.is_lt(Nat.add(I, 0n), B) == True{} : Bool}:
  %Equal.sym(Nat, Nat.add(I, 0n), I, F.nat__add_zero(I)) : {Nat.is_lt(_, B) == True{} : Bool}
  hW

# The element roots after writing v at I < N.
def xl_set0(+N: Nat, +W: List<&2, FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal>, +I: Nat, +v: FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal,
    +hIN: {Nat.is_lt(I, N) == True{} : Bool},
    +hW: {Nat.is_lt(I, F.spec_common__length(FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal, W)) == True{} : Bool})
    -> {xl(N, F.spec_common__update(FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal, W, I, v), 0n, 64n) == LC.dput(xl(N, W, 0n, 64n), I, RN.d_PendingPartialWithdrawal(64n, v)) : List<&2, D.Digest>}:
  %F.nat__add_zero(I) :
    {xl(N, F.spec_common__update(FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal, W, _, v), 0n, 64n) == LC.dput(xl(N, W, 0n, 64n), I, RN.d_PendingPartialWithdrawal(64n, v)) : List<&2, D.Digest>}
  xl_set(N, W, I, 0n, v, 64n, hIN, hw0(I, F.spec_common__length(FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal, W), hW))

# The new low end min(lo, i): at most lo and at most i.
def lo1(+lo: U32, +i: U32, +c: Bool, +ec: {Nat.is_le(U32.to_nat(lo), U32.to_nat(i)) == c : Bool})
    -> {Nat.is_le(U32.to_nat(O.pick(c, lo, i)), U32.to_nat(lo)) == True{} : Bool}:
  match c:
    case True{}: F.nat__le_refl(U32.to_nat(lo))
    case False{}: F.nat__lt_le(U32.to_nat(i), U32.to_nat(lo), F.nat__not_le_lt(U32.to_nat(lo), U32.to_nat(i), ec))

def lo2(+lo: U32, +i: U32, +c: Bool, +ec: {Nat.is_le(U32.to_nat(lo), U32.to_nat(i)) == c : Bool})
    -> {Nat.is_le(U32.to_nat(O.pick(c, lo, i)), U32.to_nat(i)) == True{} : Bool}:
  match c:
    case True{}: ec
    case False{}: F.nat__le_refl(U32.to_nat(i))

# The new high end max(hi, i): at least hi and i, and below the capacity.
def hi1(+i: U32, +hi: U32, +c: Bool, +ec: {Nat.is_le(U32.to_nat(i), U32.to_nat(hi)) == c : Bool})
    -> {Nat.is_le(U32.to_nat(hi), U32.to_nat(O.pick(c, hi, i))) == True{} : Bool}:
  match c:
    case True{}: F.nat__le_refl(U32.to_nat(hi))
    case False{}: F.nat__lt_le(U32.to_nat(hi), U32.to_nat(i), F.nat__not_le_lt(U32.to_nat(i), U32.to_nat(hi), ec))

def hi2(+i: U32, +hi: U32, +c: Bool, +ec: {Nat.is_le(U32.to_nat(i), U32.to_nat(hi)) == c : Bool})
    -> {Nat.is_le(U32.to_nat(i), U32.to_nat(O.pick(c, hi, i))) == True{} : Bool}:
  match c:
    case True{}: ec
    case False{}: F.nat__le_refl(U32.to_nat(i))

def hi3(+i: U32, +hi: U32, +B: Nat, +c: Bool,
    +hb: {Nat.is_lt(U32.to_nat(hi), B) == True{} : Bool}, +ib: {Nat.is_lt(U32.to_nat(i), B) == True{} : Bool})
    -> {Nat.is_lt(U32.to_nat(O.pick(c, hi, i)), B) == True{} : Bool}:
  match c:
    case True{}: hb
    case False{}: ib

# ---- the write ------------------------------------------------------------------------------

def put_len_n(+XL: List<&2, D.Digest>, +XL2: List<&2, D.Digest>, +N: Nat, +es: {XL2 == XL : List<&2, D.Digest>}, +en: {MD.dlen(XL2) == N : Nat})
    -> {MD.dlen(XL) == N : Nat}:
  %es : {MD.dlen(_) == N : Nat}
  en

# The invariant for the written items and the widened range [min(lo, i), max(hi, i)].
def cset_cinv(+d: Nat, +t: F.array__Tree<D.Digest>, +N: Nat, +W: List<&2, FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal>, +i: U32, +v: FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal,
    +lo: U32, +hi: U32, +c1: Bool, +e1: {Nat.is_le(U32.to_nat(lo), U32.to_nat(i)) == c1 : Bool},
    +c2: Bool, +e2: {Nat.is_le(U32.to_nat(i), U32.to_nat(hi)) == c2 : Bool},
    +hb: {Nat.is_lt(U32.to_nat(hi), O.pow2n(d)) == True{} : Bool}, +ib: {Nat.is_lt(U32.to_nat(i), O.pow2n(d)) == True{} : Bool},
    +hIN: {Nat.is_lt(U32.to_nat(i), N) == True{} : Bool},
    +hW: {Nat.is_lt(U32.to_nat(i), F.spec_common__length(FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal, W)) == True{} : Bool},
    +ci: CT.cinv(F.array__slots(D.Digest, t), d, N, xl(N, W, 0n, 64n), U32.to_nat(lo), U32.to_nat(hi)))
    -> CT.cinv(F.array__slots(D.Digest, t), d, N, xl(N, F.spec_common__update(FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal, W, U32.to_nat(i), v), 0n, 64n),
         U32.to_nat(O.pick(c1, lo, i)), U32.to_nat(O.pick(c2, hi, i))):
  +I = U32.to_nat(i)
  +XL = xl(N, W, 0n, 64n)
  +x = RN.d_PendingPartialWithdrawal(64n, v)
  +XL2 = xl(N, F.spec_common__update(FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal, W, I, v), 0n, 64n)
  +es = xl_set0(N, W, I, v, hIN, hW)
  %Equal.sym(List<&2, D.Digest>, XL2, LC.dput(XL, I, x), es) : CT.cinv(F.array__slots(D.Digest, t), d, N, _, U32.to_nat(O.pick(c1, lo, i)), U32.to_nat(O.pick(c2, hi, i)))
  LC.cinv_move(F.array__slots(D.Digest, t), d, N, N, XL, I, x,
    U32.to_nat(lo), U32.to_nat(hi), U32.to_nat(O.pick(c1, lo, i)), U32.to_nat(O.pick(c2, hi, i)),
    xlen(N, W, 0n, 64n), put_len_n(LC.dput(XL, I, x), XL2, N, es, xlen(N, F.spec_common__update(FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal, W, I, v), 0n, 64n)),
    lo1(lo, i, c1, e1), hi1(i, hi, c2, e2), lo2(lo, i, c1, e1), hi2(i, hi, c2, e2), ci)

def cset_hi(+d: Nat, +i: U32, +hi: U32, +c2: Bool,
    +hb: {Nat.is_lt(U32.to_nat(hi), O.pow2n(d)) == True{} : Bool}, +ib: {Nat.is_lt(U32.to_nat(i), O.pow2n(d)) == True{} : Bool})
    -> {Nat.is_lt(U32.to_nat(O.pick(c2, hi, i)), O.pow2n(d)) == True{} : Bool}:
  hi3(i, hi, O.pow2n(d), c2, hb, ib)

# ==== from the instance cmut.bend ========================================

# The cache invariant of ctree.bend after an append into the cached validators
# list (l134217728_PendingPartialWithdrawal_capp inside the capacity), and for a fresh
# cache (cache_at: every leaf dirty). An append stores v at index n: the
# element roots gain leaf n (xl_app: dput at n, the list's length), and the
# range widens to cover n, so cloc.bend's cinv_move applies with n + 1
# elements. A fresh cache marks [0, 2^d - 1] dirty: no node is clean for it,
# so the invariant holds whatever the node array holds (fresh_cinv).

# ---- an append ------------------------------------------------------------------------------

law xl_app:
  for +k: Nat
  for +W: List<&2, FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal>
  for +i0: Nat
  for +v: FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal
  for +hl: Nat
  for +hW: {Nat.is_lt(Nat.add(k, i0), F.spec_common__length(FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal, W)) == True{} : Bool}
  {xl(1n+k, F.spec_common__update(FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal, W, Nat.add(k, i0), v), i0, hl) == LC.dput(xl(k, W, i0, hl), k, RN.d_PendingPartialWithdrawal(hl, v)) : List<&2, D.Digest>}
def xl_app(k, W, i0, v, hl, hW):
  match k:
    case 0n:
      %Equal.sym(FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal, xat(F.spec_common__update(FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal, W, i0, v), i0), v, xat_upd_same(W, i0, v, hW)) :
        {RN.d_PendingPartialWithdrawal(hl, _) <> xl(0n, F.spec_common__update(FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal, W, i0, v), 1n+i0, hl) == [RN.d_PendingPartialWithdrawal(hl, v)] : List<&2, D.Digest>}
      {==}
    case 1n+ +q:
      +J = Nat.add(1n+q, i0)
      +W2 = F.spec_common__update(FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal, W, J, v)
      +x = RN.d_PendingPartialWithdrawal(hl, v)
      +ne = CT.neq_of_lt(J, i0, F.nat__le_lt_succ(i0, Nat.add(q, i0), le_add_l(q, i0)))
      %Equal.sym(FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal, xat(W2, i0), xat(W, i0), xat_upd(W, J, v, i0, ne)) :
        {RN.d_PendingPartialWithdrawal(hl, _) <> xl(1n+q, W2, 1n+i0, hl) == RN.d_PendingPartialWithdrawal(hl, xat(W, i0)) <> LC.dput(xl(q, W, 1n+i0, hl), q, x) : List<&2, D.Digest>}
      %MR.add_succ(q, i0) :
        {RN.d_PendingPartialWithdrawal(hl, xat(W, i0)) <> xl(1n+q, F.spec_common__update(FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal, W, _, v), 1n+i0, hl)
         == RN.d_PendingPartialWithdrawal(hl, xat(W, i0)) <> LC.dput(xl(q, W, 1n+i0, hl), q, x) : List<&2, D.Digest>}
      %Equal.sym(List<&2, D.Digest>, xl(1n+q, F.spec_common__update(FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal, W, Nat.add(q, 1n+i0), v), 1n+i0, hl), LC.dput(xl(q, W, 1n+i0, hl), q, x),
          xl_app(q, W, 1n+i0, v, hl, hw_shift(q, i0, F.spec_common__length(FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal, W), hW))) :
        {RN.d_PendingPartialWithdrawal(hl, xat(W, i0)) <> _ == RN.d_PendingPartialWithdrawal(hl, xat(W, i0)) <> LC.dput(xl(q, W, 1n+i0, hl), q, x) : List<&2, D.Digest>}
      {==}

# The element roots after appending v to N elements.
def xl_app0(+N: Nat, +W: List<&2, FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal>, +v: FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal,
    +hW: {Nat.is_lt(N, F.spec_common__length(FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal, W)) == True{} : Bool})
    -> {xl(1n+N, F.spec_common__update(FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal, W, N, v), 0n, 64n) == LC.dput(xl(N, W, 0n, 64n), N, RN.d_PendingPartialWithdrawal(64n, v)) : List<&2, D.Digest>}:
  %F.nat__add_zero(N) :
    {xl(1n+N, F.spec_common__update(FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal, W, _, v), 0n, 64n) == LC.dput(xl(N, W, 0n, 64n), N, RN.d_PendingPartialWithdrawal(64n, v)) : List<&2, D.Digest>}
  xl_app(N, W, 0n, v, 64n, hw0(N, F.spec_common__length(FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal, W), hW))

# The invariant for the appended items, n + 1 elements and the range [min(lo, n), max(hi, n)].
def capp_cinv(+d: Nat, +t: F.array__Tree<D.Digest>, +W: List<&2, FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal>, +n: U32, +v: FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal,
    +lo: U32, +hi: U32, +c1: Bool, +e1: {Nat.is_le(U32.to_nat(lo), U32.to_nat(n)) == c1 : Bool},
    +c2: Bool, +e2: {Nat.is_le(U32.to_nat(n), U32.to_nat(hi)) == c2 : Bool},
    +hb: {Nat.is_lt(U32.to_nat(hi), O.pow2n(d)) == True{} : Bool}, +nb: {Nat.is_lt(U32.to_nat(n), O.pow2n(d)) == True{} : Bool},
    +hW: {Nat.is_lt(U32.to_nat(n), F.spec_common__length(FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal, W)) == True{} : Bool},
    +ci: CT.cinv(F.array__slots(D.Digest, t), d, U32.to_nat(n), xl(U32.to_nat(n), W, 0n, 64n), U32.to_nat(lo), U32.to_nat(hi)))
    -> CT.cinv(F.array__slots(D.Digest, t), d, 1n+U32.to_nat(n), xl(1n+U32.to_nat(n), F.spec_common__update(FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal, W, U32.to_nat(n), v), 0n, 64n),
         U32.to_nat(O.pick(c1, lo, n)), U32.to_nat(O.pick(c2, hi, n))):
  +N = U32.to_nat(n)
  +XL = xl(N, W, 0n, 64n)
  +x = RN.d_PendingPartialWithdrawal(64n, v)
  +XL2 = xl(1n+N, F.spec_common__update(FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal, W, N, v), 0n, 64n)
  +es = xl_app0(N, W, v, hW)
  %Equal.sym(List<&2, D.Digest>, XL2, LC.dput(XL, N, x), es) : CT.cinv(F.array__slots(D.Digest, t), d, 1n+N, _, U32.to_nat(O.pick(c1, lo, n)), U32.to_nat(O.pick(c2, hi, n)))
  LC.cinv_move(F.array__slots(D.Digest, t), d, N, 1n+N, XL, N, x,
    U32.to_nat(lo), U32.to_nat(hi), U32.to_nat(O.pick(c1, lo, n)), U32.to_nat(O.pick(c2, hi, n)),
    xlen(N, W, 0n, 64n), put_len_n(LC.dput(XL, N, x), XL2, 1n+N, es, xlen(1n+N, F.spec_common__update(FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal, W, N, v), 0n, 64n)),
    lo1(lo, n, c1, e1), hi1(n, hi, c2, e2), lo2(lo, n, c1, e1), hi2(n, hi, c2, e2), ci)

# ---- a fresh cache ----------------------------------------------------------------------------

law rng_zero:
  for +l: Nat
  {CT.rng(l, 0n) == 0n : Nat}
def rng_zero(l):
  match l:
    case 0n: {==}
    case 1n+ +k:
      %Equal.sym(Nat, CT.rng(k, 0n), 0n, rng_zero(k)) : {CT.h2(_) == 0n : Nat}
      {==}

# (2P - 1) / 2 = P - 1 for P >= 1.
def h2_pd(+P: Nat, +hP: {Nat.is_le(1n, P) == True{} : Bool}) -> {CT.h2(Nat.sub(Nat.double(P), 1n)) == Nat.sub(P, 1n) : Nat}:
  match P:
    case 0n: Empty.absurd({CT.h2(Nat.sub(Nat.double(0n), 1n)) == Nat.sub(0n, 1n) : Nat}, MD.false_true(hP))
    case 1n+ +q:
      %Equal.sym(Nat, Nat.sub(q, 0n), q, F.nat__sub_zero(q)) : {CT.h2(1n+Nat.double(q)) == _ : Nat}
      CX.h2_bit(True{}, q)

# The range of level l for the last leaf 2^d - 1: the last node 2^(d - l) - 1.
law rng_top:
  for +l: Nat
  for +d: Nat
  for +hl: {Nat.is_le(l, d) == True{} : Bool}
  {CT.rng(l, Nat.sub(O.pow2n(d), 1n)) == Nat.sub(O.pow2n(Nat.sub(d, l)), 1n) : Nat}
def rng_top(l, d, hl):
  match l:
    case 0n:
      %Equal.sym(Nat, Nat.sub(d, 0n), d, F.nat__sub_zero(d)) : {Nat.sub(O.pow2n(d), 1n) == Nat.sub(O.pow2n(_), 1n) : Nat}
      {==}
    case 1n+ +k:
      +hk = F.nat__le_trans(k, 1n+k, d, F.nat__le_succ(k), hl)
      %Equal.sym(Nat, CT.rng(k, Nat.sub(O.pow2n(d), 1n)), Nat.sub(O.pow2n(Nat.sub(d, k)), 1n), rng_top(k, d, hk)) :
        {CT.h2(_) == Nat.sub(O.pow2n(Nat.sub(d, 1n+k)), 1n) : Nat}
      %Equal.sym(Nat, Nat.sub(d, k), 1n+Nat.sub(d, 1n+k), CT.sub_succ(d, k, hl)) :
        {CT.h2(Nat.sub(O.pow2n(_), 1n)) == Nat.sub(O.pow2n(Nat.sub(d, 1n+k)), 1n) : Nat}
      h2_pd(O.pow2n(Nat.sub(d, 1n+k)), CT.pow2_pos(Nat.sub(d, 1n+k)))

def lt_pred_f(+j: Nat, +P: Nat, +hj: {Nat.is_lt(j, P) == True{} : Bool}) -> {Nat.is_lt(Nat.sub(P, 1n), j) == False{} : Bool}:
  match P:
    case 0n: Empty.absurd({Nat.is_lt(Nat.sub(0n, 1n), j) == False{} : Bool}, CT.lt_zero_absurd(j, hj))
    case 1n+ +q:
      %Equal.sym(Nat, Nat.sub(q, 0n), q, F.nat__sub_zero(q)) : {Nat.is_lt(_, j) == False{} : Bool}
      F.nat__le_not_lt(q, j, F.nat__lt_succ_le(j, q, hj))

# No node is clean for the full range [0, 2^d - 1].
def full_dirty(+l: Nat, +j: Nat, +d: Nat, +hl: {Nat.is_le(l, d) == True{} : Bool},
    +hj: {Nat.is_lt(j, O.pow2n(Nat.sub(d, l))) == True{} : Bool})
    -> {CT.clean(l, j, 0n, Nat.sub(O.pow2n(d), 1n)) == False{} : Bool}:
  +H = Nat.sub(O.pow2n(d), 1n)
  %Equal.sym(Bool, Nat.is_lt(H, 0n), False{}, F.nat__not_lt_zero(H)) :
    {Bool.or(_, Bool.or(Nat.is_lt(j, CT.rng(l, 0n)), Nat.is_lt(CT.rng(l, H), j))) == False{} : Bool}
  %Equal.sym(Nat, CT.rng(l, 0n), 0n, rng_zero(l)) :
    {Bool.or(Nat.is_lt(j, _), Nat.is_lt(CT.rng(l, H), j)) == False{} : Bool}
  %Equal.sym(Bool, Nat.is_lt(j, 0n), False{}, F.nat__not_lt_zero(j)) :
    {Bool.or(_, Nat.is_lt(CT.rng(l, H), j)) == False{} : Bool}
  %Equal.sym(Nat, CT.rng(l, H), Nat.sub(O.pow2n(Nat.sub(d, l)), 1n), rng_top(l, d, hl)) :
    {Nat.is_lt(_, j) == False{} : Bool}
  lt_pred_f(j, O.pow2n(Nat.sub(d, l)), hj)

def okif_f(c: Bool, +ec: {c == False{} : Bool}, +NS: List<&2, D.Digest>, +d: Nat, +l: Nat, +j: Nat, +n: Nat, +XL: List<&2, D.Digest>)
    -> CT.okif(c, NS, d, l, j, n, XL):
  match c:
    case True{}: Empty.absurd(CT.okif(True{}, NS, d, l, j, n, XL), MD.true_false(ec))
    case False{}: Unit{}

law cl_fresh:
  for +q: Nat
  for +NS: List<&2, D.Digest>
  for +d: Nat
  for +n: Nat
  for +XL: List<&2, D.Digest>
  for +l: Nat
  for +hl: {Nat.is_le(l, d) == True{} : Bool}
  for +hq: {Nat.is_le(q, O.pow2n(Nat.sub(d, l))) == True{} : Bool}
  CT.CL(NS, d, n, XL, 0n, Nat.sub(O.pow2n(d), 1n), l, 0n, q)
def cl_fresh(q, NS, d, n, XL, l, hl, hq):
  match q:
    case 0n: Unit{}
    case 1n+ +r:
      +hr = F.nat__lt_le_trans(r, 1n+r, O.pow2n(Nat.sub(d, l)), F.nat__le_lt_succ(r, r, F.nat__le_refl(r)), hq)
      (cl_fresh(r, NS, d, n, XL, l, hl, F.nat__lt_le(r, O.pow2n(Nat.sub(d, l)), hr)),
       okif_f(CT.clean(l, r, 0n, Nat.sub(O.pow2n(d), 1n)), full_dirty(l, r, d, hl, hr), NS, d, l, r, n, XL))

law ci_fresh:
  for +k: Nat
  for +NS: List<&2, D.Digest>
  for +d: Nat
  for +n: Nat
  for +XL: List<&2, D.Digest>
  for +hk: {Nat.is_le(k, 1n+d) == True{} : Bool}
  CT.CI(NS, d, n, XL, 0n, Nat.sub(O.pow2n(d), 1n), k)
def ci_fresh(k, NS, d, n, XL, hk):
  match k:
    case 0n: Unit{}
    case 1n+ +r:
      (ci_fresh(r, NS, d, n, XL, F.nat__le_trans(r, d, 1n+d, hk, F.nat__le_succ(d))),
       cl_fresh(O.pow2n(Nat.sub(d, r)), NS, d, n, XL, r, hk, F.nat__le_refl(O.pow2n(Nat.sub(d, r)))))

# With every leaf dirty the invariant holds, whatever the node slots hold.
def fresh_cinv(+NS: List<&2, D.Digest>, +d: Nat, +n: Nat, +XL: List<&2, D.Digest>)
    -> CT.cinv(NS, d, n, XL, 0n, Nat.sub(O.pow2n(d), 1n)):
  ci_fresh(1n+d, NS, d, n, XL, F.nat__le_refl(1n+d))

# ==== from the instance capi.bend ========================================

# The public cache API of the list l134217728_PendingPartialWithdrawal (l134217728_PendingPartialWithdrawal:
# cache, cset, capp, cached_root) on the cache invariant. A cache
# Cached{thaw ta, n, d, thaw t, lo, hi} is valid when inv(ta, dw, t, n, d, lo,
# hi) holds: the items are a perfect tree of depth dw >= d, n <= 2^d, the node
# array is a perfect tree of depth 1 + d, and every node clean for [lo, hi]
# holds its value over the element roots (ctree's cinv). Then:
#
#   cache_inv     cache(Seq{thaw ta, n}) is valid, for n <= 2^dw with dw <= 30 and
#                 dw <= the limit depth 27;
#   root_eq       cached_root returns mix_len(64, rtree(40, 0 < n, 64, XL, 0), n),
#                 XL the element roots (cloop3), and root_inv: its cache is valid;
#   cset_eq/_inv  a write at i < n is the tree update and keeps validity;
#   capp_eq/_inv  an append that fits the capacity (n < 2^d) likewise.
#
# So after any history of writes and fitting appends from a fresh cache, every
# root is the reference root of the current elements. Not covered here: the
# append that grows the capacity (the `room` copy loop).

def xroots(+n: U32, +ta: F.array__Tree<FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal>) -> List<&2, D.Digest>: XLof(n, ta)

def inv(+ta: F.array__Tree<FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal>, +dw: Nat, +t: F.array__Tree<D.Digest>, +n: U32, +d: Nat, +lo: U32, +hi: U32) -> Data:
  DK.P2({Nat.is_lt(dw, 32n) == True{} : Bool},
  DK.P2({F.array__perfect(FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal, dw, ta) == True{} : Bool},
  DK.P2({Nat.is_le(O.pow2n(d), F.spec_common__pow2(dw)) == True{} : Bool},
  DK.P2({Nat.is_lt(d, 31n) == True{} : Bool},
  DK.P2({Nat.is_le(d, 27n) == True{} : Bool},
  DK.P2({Nat.is_le(U32.to_nat(n), O.pow2n(d)) == True{} : Bool},
  DK.P2({F.array__perfect(D.Digest, 1n+d, t) == True{} : Bool},
  DK.P2({Nat.is_lt(U32.to_nat(hi), O.pow2n(d)) == True{} : Bool},
  DK.P2({F.spec_common__length(D.Digest, F.array__slots(D.Digest, t)) == O.pow2n(1n+d) : Nat},
        CT.cinv(F.array__slots(D.Digest, t), d, U32.to_nat(n), xroots(n, ta), U32.to_nat(lo), U32.to_nat(hi)))))))))))

def cached(+ta: F.array__Tree<FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal>, +t: F.array__Tree<D.Digest>, +n: U32, +d: Nat, +lo: U32, +hi: U32) -> Fulu_list_PendingPartialWithdrawal_134217728_d.l134217728_PendingPartialWithdrawal_Cached:
  Fulu_list_PendingPartialWithdrawal_134217728_d.l134217728_PendingPartialWithdrawal_Cached{F.array__thaw(FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal, ta), n, d, F.array__thaw(D.Digest, t), lo, hi}

# ---- the root ------------------------------------------------------------------------------

def dig(+n: U32, +ta: F.array__Tree<FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal>) -> D.Digest:
  O.mix_len(64n, MD.rtree(27n, Nat.is_lt(0n, U32.to_nat(n)), 64n, xroots(n, ta), 0n), n)

def tafter(+ta: F.array__Tree<FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal>, +t: F.array__Tree<D.Digest>, +n: U32, +d: Nat, +lo: U32, +hi: U32) -> F.array__Tree<D.Digest>:
  after(Nat.is_le(U32.to_nat(lo), U32.to_nat(hi)), d, U32.to_nat(n), xroots(n, ta), U32.to_nat(lo), U32.to_nat(hi), t)

law root_eq:
  for -h: B.Buf
  for +ta: F.array__Tree<FuluPendingPartialWithdrawal_d.PendingPartialWithdrawal>
  for +dw: Nat
  for +t: F.array__Tree<D.Digest>
