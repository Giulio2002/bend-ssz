# quad q < quad P gives q < P
def qlt_rev(+q: Nat, +P: Nat, +h: {Nat.is_lt(A.quad(q), A.quad(P)) == True{} : Bool}) -> {Nat.is_lt(q, P) == True{} : Bool}:
  match q P:
    case 0n 0n: Empty.absurd({Nat.is_lt(0n, 0n) == True{} : Bool}, F.logic__false_true(h))
    case 0n 1n+ +s: {==}
    case 1n+ +p 0n: Empty.absurd({Nat.is_lt(1n+p, 0n) == True{} : Bool}, F.logic__false_true(h))
    case 1n+ +p 1n+ +s: qlt_rev(p, s, h)

# X + s < X + r gives s < r
def lt_cancel(+X: Nat, +s: Nat, +r: Nat, +h: {Nat.is_lt(Nat.add(X, s), Nat.add(X, r)) == True{} : Bool}) -> {Nat.is_lt(s, r) == True{} : Bool}:
  match X:
    case 0n: h
    case 1n+ +p: lt_cancel(p, s, r, h)

