    R.build(3n, R.lits(FD.spec_common__pow2(3n), FD.array__slots(U32, t))), t, R.tree_words(3n, t, pf),
    C.Bytes20_spec_decode(R.w(t, 0n), R.w(t, 1n), R.w(t, 2n), R.w(t, 3n), R.w(t, 4n), R.w(t, 5n), R.w(t, 6n), R.w(t, 7n)))
