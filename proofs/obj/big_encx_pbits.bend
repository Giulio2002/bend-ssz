# The bits' count is K (vbitcore.enc_core's CR3, at the storage's own depth).
def lbits(+dw: Nat, +T: FD.array__Tree<U32>, +K: U32, +B: Nat, +kb: Nat, +KY: Nat, +h: {OKT(dw, T, K, B, kb, KY) == True{} : Bool}) -> {List.length(&2, Bool, CO.BITS(T, K)) == U32.to_nat(K) : Nat}:
