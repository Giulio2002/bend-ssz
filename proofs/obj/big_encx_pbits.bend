# ---- the bits' byte count ------------------------------------------------------------------

law pack_len:
  for +xs: +List<Bool>
  {List.length(&2, U32, Bp.pack(xs)) == Bp.byte_count(List.length(&2, Bool, xs)) : Nat}
def pack_len(xs):
  match xs:
    case Nil{}: {==}
    case Con{+b0, +t0}:
      match t0:
        case Nil{}: {==}
        case Con{+b1, +t1}:
          match t1:
            case Nil{}: {==}
            case Con{+b2, +t2}:
              match t2:
                case Nil{}: {==}
                case Con{+b3, +t3}:
                  match t3:
                    case Nil{}: {==}
                    case Con{+b4, +t4}:
                      match t4:
                        case Nil{}: {==}
                        case Con{+b5, +t5}:
                          match t5:
                            case Nil{}: {==}
                            case Con{+b6, +t6}:
                              match t6:
                                case Nil{}: {==}
                                case Con{+b7, +t8}: Equal.cong(Nat, Nat, z => 1n+z, List.length(&2, U32, Bp.pack(t8)), Bp.byte_count(List.length(&2, Bool, t8)), pack_len(t8))

law bcx:
  for +a: Nat
  for +b: Nat
  for +hb: {Nat.is_le(b, 7n) == True{} : Bool}
  {Bp.byte_count(Nat.add(Nat.add(VS.x8(a), b), 1n)) == 1n+a : Nat}
def bcx(a, b, hb):
  match a:
    case 0n:
      match b:
        case 0n: {==}
        case 1n: {==}
        case 2n: {==}
        case 3n: {==}
        case 4n: {==}
        case 5n: {==}
        case 6n: {==}
        case 7n: {==}
        case 8n+ +p: Empty.absurd({Bp.byte_count(Nat.add(8n+p, 1n)) == 1n : Nat}, FD.logic__false_true(hb))
    case 1n+ +p: Equal.cong(Nat, Nat, z => 1n+z, Bp.byte_count(Nat.add(Nat.add(VS.x8(p), b), 1n)), 1n+p, bcx(p, b, hb))

law len_app_b:
  for +xs: +List<Bool>
  for +ys: +List<Bool>
  {List.length(&2, Bool, List.append(&2, Bool, xs, ys)) == Nat.add(List.length(&2, Bool, xs), List.length(&2, Bool, ys)) : Nat}
def len_app_b(xs, ys):
  match xs:
    case Nil{}: {==}
    case Con{+b, +t}: FD.nat__succ_cong(List.length(&2, Bool, List.append(&2, Bool, t, ys)), Nat.add(List.length(&2, Bool, t), List.length(&2, Bool, ys)), len_app_b(t, ys))

def hK(+dw: Nat, +T: FD.array__Tree<U32>, +K: U32, +B: Nat, +kb: Nat, +KY: Nat, +h: {OKT(dw, T, K, B, kb, KY) == True{} : Bool}) -> VBT.HK(K, kb):
  FD.nat__le_trans(Nat.add(U32.to_nat(K), 8n), Nat.add(B, 8n), O.pow2n(kb), Order.add_right(U32.to_nat(K), B, 8n, ok_hN(dw, T, K, B, kb, KY, h)), ok_hNk(dw, T, K, B, kb, KY, h))

def hWq(+dw: Nat, +T: FD.array__Tree<U32>, +K: U32, +B: Nat, +kb: Nat, +KY: Nat, +h: {OKT(dw, T, K, B, kb, KY) == True{} : Bool}) -> {Nat.is_le(Nat.add(VBT.QK(K), 1n), VB.pw(dw)) == True{} : Bool}:
