    ok_hN(dw, T, K, B, kb, KY, h), ok_hNk(dw, T, K, B, kb, KY, h), ok_hNY(dw, T, K, B, kb, KY, h), hWq(dw, T, K, B, kb, KY, h), hWq(dw, T, K, B, kb, KY, h), ok_hbz(dw, T, K, B, kb, KY, h)))

# |ENC| = K / 8 + 1.
def eL(+dw: Nat, +T: FD.array__Tree<U32>, +K: U32, +B: Nat, +kb: Nat, +KY: Nat, +h: {OKT(dw, T, K, B, kb, KY) == True{} : Bool}) -> {List.length(&2, U32, ENC(MB{dw, T, K, B, kb, KY})) == U32.to_nat(CO.NK(K)) : Nat}:
  +bs = List.append(&2, Bool, CO.BITS(T, K), [True{}])
  +e1 = Equal.trans(Nat, List.length(&2, Bool, bs), Nat.add(List.length(&2, Bool, CO.BITS(T, K)), 1n), Nat.add(U32.to_nat(K), 1n), len_app_b(CO.BITS(T, K), [True{}]),
    Equal.cong(Nat, Nat, z => Nat.add(z, 1n), List.length(&2, Bool, CO.BITS(T, K)), U32.to_nat(K), lbits(dw, T, K, B, kb, KY, h)))
  +M = Nat.add(Nat.add(VS.x8(VBT.AK(K)), VBT.BKk(K)), 1n)
  +e2 = Equal.trans(Nat, List.length(&2, Bool, bs), Nat.add(U32.to_nat(K), 1n), M, e1, Equal.cong(Nat, Nat, z => Nat.add(z, 1n), U32.to_nat(K), Nat.add(VS.x8(VBT.AK(K)), VBT.BKk(K)), VBT.E1(K)))
  +e3 = Equal.trans(Nat, Bp.byte_count(List.length(&2, Bool, bs)), Bp.byte_count(M), 1n+VBT.AK(K), Equal.cong(Nat, Nat, z => Bp.byte_count(z), List.length(&2, Bool, bs), M, e2),
    bcx(VBT.AK(K), VBT.BKk(K), RD.and_le(K, 7)))
  Equal.trans(Nat, List.length(&2, U32, Bp.pack(bs)), Bp.byte_count(List.length(&2, Bool, bs)), U32.to_nat(CO.NK(K)), pack_len(bs),
    Equal.trans(Nat, Bp.byte_count(List.length(&2, Bool, bs)), 1n+VBT.AK(K), U32.to_nat(CO.NK(K)), e3,
      Equal.trans(Nat, 1n+VBT.AK(K), Nat.add(VBT.AK(K), 1n), U32.to_nat(CO.NK(K)), Equal.sym(Nat, Nat.add(VBT.AK(K), 1n), 1n+VBT.AK(K), FD.nat__add_comm(VBT.AK(K), 1n)),
        Equal.sym(Nat, U32.to_nat(CO.NK(K)), Nat.add(VBT.AK(K), 1n), VBT.E4(K, kb, ok_hkb(dw, T, K, B, kb, KY, h), hK(dw, T, K, B, kb, KY, h))))))

# ---- the runtime's check and size ---------------------------------------------------------------

def valid(+dw: Nat, +T: FD.array__Tree<U32>, +K: U32, +B: Nat, +kb: Nat, +KY: Nat, +h: {OKT(dw, T, K, B, kb, KY) == True{} : Bool})
    -> {T.pbits_valid(O.Bits{FD.array__thaw(U32, T), K}) == (O.Bits{FD.array__thaw(U32, T), K}, True{}) : O.Bits & Bool}:
  +hd31 = hdw31(dw, T, K, B, kb, KY, h)
  %Equal.sym(Array<U32> & U32, Array.size(U32, FD.array__thaw(U32, T)), (FD.array__thaw(U32, T), FD.u32__pow2u(dw)), FD.array__size_thaw(U32, dw, T, ok_pf(dw, T, K, B, kb, KY, h))) :
    {O.bk_cap(Bool.or(True{}, U32.is_le(K, 0)), K, _) == (O.Bits{FD.array__thaw(U32, T), K}, True{}) : O.Bits & Bool}
  %Equal.sym(Bool, U32.is_le(U32.add(U32.shrn(K, 5n), 1), FD.u32__pow2u(dw)), True{}, CO.capT(K, dw, hd31, ok_hcap(dw, T, K, B, kb, KY, h))) :
    {O.bk_last(Bool.and(Bool.or(True{}, U32.is_le(K, 0)), _), K, Array.get(U32, FD.array__thaw(U32, T), U32.shrn(K, 5n))) == (O.Bits{FD.array__thaw(U32, T), K}, True{}) : O.Bits & Bool}
  %Equal.sym(Array<U32> & U32, Array.get(U32, FD.array__thaw(U32, T), U32.shrn(K, 5n)), (FD.array__thaw(U32, T), RD.wd(T, dw, U32.shrn(K, 5n))),
      VE.get_any(dw, T, U32.shrn(K, 5n), FD.nat__lt_trans(dw, 28n, 32n, ok_hdw(dw, T, K, B, kb, KY, h), {==}), ok_pf(dw, T, K, B, kb, KY, h))) :
    {O.bk_last(Bool.and(Bool.or(True{}, U32.is_le(K, 0)), True{}), K, _) == (O.Bits{FD.array__thaw(U32, T), K}, True{}) : O.Bits & Bool}
  %Equal.sym(Bool, O.bits_above_zero(U32.and(K, 31), RD.wd(T, dw, U32.shrn(K, 5n))), True{}, ok_hbz2(dw, T, K, B, kb, KY, h)) :
    {(O.Bits{FD.array__thaw(U32, T), K}, Bool.and(Bool.and(Bool.or(True{}, U32.is_le(K, 0)), True{}), _)) == (O.Bits{FD.array__thaw(U32, T), K}, True{}) : O.Bits & Bool}
  {==}

def size_go(+dw: Nat, +T: FD.array__Tree<U32>, +K: U32, +B: Nat, +kb: Nat, +KY: Nat, +h: {OKT(dw, T, K, B, kb, KY) == True{} : Bool})
