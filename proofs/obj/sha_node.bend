# The specification's node over the bytes of two digests is the runtime
# node's bytes.
law spec_node:
  for +l: D.Digest
  for +r: D.Digest
  {M.hash_pair(D.bytes(l), D.bytes(r)) == Some{D.bytes(D.hash_pair(l, r))} : Maybe<&2, List<&2, U32>>}
def spec_node(l, r):
  %Equal.sym(Bool, P.byte_scope(32n, D.bytes(l)), True{}, digest_scope(l)) :
    {M.pair_checked(Bool.and(_, P.byte_scope(32n, D.bytes(r))), D.bytes(l), D.bytes(r)) == Some{D.bytes(D.hash_pair(l, r))} : Maybe<&2, List<&2, U32>>}
  %Equal.sym(Bool, P.byte_scope(32n, D.bytes(r)), True{}, digest_scope(r)) :
    {M.pair_checked(Bool.and(True{}, _), D.bytes(l), D.bytes(r)) == Some{D.bytes(D.hash_pair(l, r))} : Maybe<&2, List<&2, U32>>}
  %Equal.sym(List<&2, U32>, D.bytes(D.hash_pair(l, r)), VF.sha256_bytes(List.append(&2, U32, D.bytes(l), D.bytes(r))), node(l, r)) :
    {Some{VF.sha256_bytes(List.append(&2, U32, D.bytes(l), D.bytes(r)))} == Some{_} : Maybe<&2, List<&2, U32>>}
  {==}

