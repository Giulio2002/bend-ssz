# The message array of a node holds sixteen words.
law pair_size:
  for +l: D.Digest
  for +r: D.Digest
  {Array.size(U32, D.pair_words(l, r)) == (D.pair_words(l, r), 16) : Array<U32> & U32}
def pair_size(l, r):
  match l:
    case D.D{+a0, +a1, +a2, +a3, +a4, +a5, +a6, +a7}:
      match r:
        case D.D{+b0, +b1, +b2, +b3, +b4, +b5, +b6, +b7}: {==}

# The runtime node is the package's packed specification of its message
# (package law `sha256_array_correct`, instantiated at the stuck message).
law hash_pair_packed:
  for +l: D.Digest
  for +r: D.Digest
  {D.hash_pair(l, r) == D.of_result(Buf.result(PSP.hash(D.pair_words(l, r), 64n))) : D.Digest}
def hash_pair_packed(l, r):
  Equal.cong(Maybe<&1, Array<U32>>, D.Digest, x => D.of_result(x), PKG.sha256(D.pair_words(l, r), 64n),
    Buf.result(PSP.hash(D.pair_words(l, r), 64n)), PL.sha256_array_correct(D.pair_words(l, r), 64n))

# The bytes of the eight result words are the FIPS digest octets.
law digest_bytes:
  for +s: PS.State
  {D.bytes(D.of_array(Buf.digest(s))) == VF.digest_octets(VF.digest(SB.conv(s))) : List<&2, U32>}
def digest_bytes(s):
  match s:
    case PS.H{+s0, +s1, +s2, +s3, +s4, +s5, +s6, +s7}: {==}

# ONE MERKLE NODE: the runtime node hashes exactly the specification's
# 64-byte message, through the pinned package, with no SHA normalization.
law node:
  for +l: D.Digest
  for +r: D.Digest
  {D.bytes(D.hash_pair(l, r)) == VF.sha256_bytes(List.append(&2, U32, D.bytes(l), D.bytes(r))) : List<&2, U32>}
def node(l, r):
  %Equal.sym(D.Digest, D.hash_pair(l, r), D.of_result(Buf.result(PSP.hash(D.pair_words(l, r), 64n))), hash_pair_packed(l, r)) :
    {D.bytes(_) == VF.sha256_bytes(List.append(&2, U32, D.bytes(l), D.bytes(r))) : List<&2, U32>}
  %Equal.sym(Array<U32> & U32, Array.size(U32, D.pair_words(l, r)), (D.pair_words(l, r), 16), pair_size(l, r)) :
    {D.bytes(D.of_result(Buf.result(PSP.sized(64n, _)))) == VF.sha256_bytes(List.append(&2, U32, D.bytes(l), D.bytes(r))) : List<&2, U32>}
  %Equal.sym(List<&2, U32>, D.bytes(D.of_array(Buf.digest(PSP.take_state(PSP.blocks(48n, 1n, 0, 0n, 64n, (D.pair_words(l, r), PF.initial())))))), VF.digest_octets(VF.digest(SB.conv(PSP.take_state(PSP.blocks(48n, 1n, 0, 0n, 64n, (D.pair_words(l, r), PF.initial())))))), digest_bytes(PSP.take_state(PSP.blocks(48n, 1n, 0, 0n, 64n, (D.pair_words(l, r), PF.initial()))))) :
    {_ == VF.sha256_bytes(List.append(&2, U32, D.bytes(l), D.bytes(r))) : List<&2, U32>}
  %Equal.sym(VS.State, SB.conv(PSP.take_state(PSP.blocks(48n, 1n, 0, 0n, 64n, (D.pair_words(l, r), PF.initial())))), VF.blocks(VF.prepare(List.append(&2, U32, D.bytes(l), D.bytes(r)), 48n), VF.constants())(SB.conv(PF.initial())), node_blocks(48n, PF.initial(), l, r)) :
    {VF.digest_octets(VF.digest(_)) == VF.sha256_bytes(List.append(&2, U32, D.bytes(l), D.bytes(r))) : List<&2, U32>}
  {==}

# The node at a message length known only through an equation: the root
# laws hold `hl` abstract (so nodes over constructor digests stay stuck) and
# carry `hl == 64n`; this is the only place that equation is used.
law node_at:
  for +hl: Nat
  for +ehl: {hl == 64n : Nat}
  for +l: D.Digest
  for +r: D.Digest
  {D.bytes(D.node(hl, l, r)) == VF.sha256_bytes(List.append(&2, U32, D.bytes(l), D.bytes(r))) : List<&2, U32>}
def node_at(hl, ehl, l, r):
  %Equal.sym(Nat, hl, 64n, ehl) : {D.bytes(D.node(_, l, r)) == VF.sha256_bytes(List.append(&2, U32, D.bytes(l), D.bytes(r))) : List<&2, U32>}
  node(l, r)

# A masked byte is below 256.
law lt_byte:
  for +y: U32
  {U32.is_lt((y .&. 255 : U32), 256) == True{} : Bool}
