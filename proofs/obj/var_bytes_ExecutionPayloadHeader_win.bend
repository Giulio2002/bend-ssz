# When the window's checks hold, the reader returns OBJw(t, i, len).
def readw(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +i: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == A.quad(i) : Nat}, +hd: {Nat.is_lt(d, 29n) == True{} : Bool},
    +hw: {Nat.is_le(Nat.add(A.quad(i), U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hchk: {CHKw(t, i, len) == True{} : Bool})
    -> {T.ExecutionPayloadHeader_read(VF.BF(t, n), off, len) == (VF.BF(t, n), OBJw(t, i, len)) : B.Buf & T.ExecutionPayloadHeader}:
  +a = U32.is_le(584, len)
  +b = U32.is_eq(SPOw(t, i), 584)
  +c = BLW(U32.sub(len, SPOw(t, i)))
  +epo = FD.u32alg__eq_of(SPOw(t, i), 584, chk_b(a, b, c, hchk))
  rdw_go(d, t, n, i, off, len, eo, hd, hw, pf, chk_a(a, b, c, hchk), epo,
    FD.logic__subst(U32, z => {BLW(U32.sub(len, z)) == True{} : Bool}, SPOw(t, i), 584, epo, chk_c(a, b, c, hchk)))


