    -> {Codec.parts(VALw(t, i, len), Spec.ExecutionPayloadHeader()) == Some{[S.Variable{VS.bt(U32.to_nat(len), F.limbs(VB.wdr(i, FD.array__slots(U32, t))))}]} : Maybe<&2, +List<S.Part>>}:
  %bytesw(d, t, n, i, len, pf, hd, hw, ha, epo, hx) :
    {Codec.parts(VALw(t, i, len), Spec.ExecutionPayloadHeader()) == Some{[S.Variable{_}]} : Maybe<&2, +List<S.Part>>}
  encpw(t, i, YB(t, i, len), VZ.bd_btl(U32.to_nat(LL(len)), FD.array__slots(U32, MKw(t, i, len))), len_yb(t, i, len, hx))

# When the window's checks hold, the spec parts of VALw are its bytes, as one variable part.
def specw(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +i: Nat, +len: U32, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hd: {Nat.is_lt(d, 29n) == True{} : Bool},
    +hw: {Nat.is_le(Nat.add(A.quad(i), U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +hchk: {CHKw(t, i, len) == True{} : Bool})
    -> {Codec.parts(VALw(t, i, len), Spec.ExecutionPayloadHeader()) == Some{[S.Variable{VS.bt(U32.to_nat(len), F.limbs(VB.wdr(i, FD.array__slots(U32, t))))}]} : Maybe<&2, +List<S.Part>>}:
  +a = U32.is_le(584, len)
  +b = U32.is_eq(SPOw(t, i), 584)
  +c = BLW(U32.sub(len, SPOw(t, i)))
  +epo = FD.u32alg__eq_of(SPOw(t, i), 584, chk_b(a, b, c, hchk))
  specw_go(d, t, n, i, len, pf, hd, hw, chk_a(a, b, c, hchk), epo,
    FD.logic__subst(U32, z => {BLW(U32.sub(len, z)) == True{} : Bool}, SPOw(t, i), 584, epo, chk_c(a, b, c, hchk)))

