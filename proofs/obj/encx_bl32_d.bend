law pfx:
  for +m: B0.MW
  for +dd: Nat
  for +D: FD.array__Tree<U32>
  for +q: Nat
  for +r: Nat
  for +pf: {FD.array__perfect(U32, dd, D) == True{} : Bool}
  {FD.array__perfect(U32, dd, B0.PUTX(m, dd, D, q, r)) == True{} : Bool}
def pfx(m, dd, D, q, r, pf):
  match m:
    case B0.MW{+dw, +T, +N}: VWD.pwm_perfect(r, dd, D, q, T, N, pf)

law szx:
  for +m: B0.MW
  for +hok: {OK(m) == True{} : Bool}
  {U32.to_nat(B0.SZ(m)) == List.length(&2, U32, B0.ENC(m)) : Nat}
def szx(m, hok):
  match m:
    case B0.MW{+dw, +T, +N}: Equal.sym(Nat, List.length(&2, U32, B0.ENC(B0.MW{dw, T, N})), U32.to_nat(N), eL(dw, T, N, hok))

law sizex:
  for +m: B0.MW
  for +hok: {OK(m) == True{} : Bool}
  {Fulu_bytelist_32_e.bl32_size(B0.TH(m)) == (B0.TH(m), B0.SZ(m)) : O.Words & U32}
def sizex(m, hok):
  match m:
    case B0.MW{+dw, +T, +N}:
      +hdw = ok_hd(dw, T, N, hok)
      +hy = hyD(dw, T, N, hok)
      %Equal.sym(Array<U32> & U32, Array.size(U32, FD.array__thaw(U32, T)), (FD.array__thaw(U32, T), FD.u32__pow2u(dw)), FD.array__size_thaw(U32, dw, T, ok_pf(dw, T, N, hok))) :
        {O.wsz_pick(N, _) == (O.Words{FD.array__thaw(U32, T), N}, N) : O.Words & U32}
      %Equal.sym(Bool, U32.is_le(VC.nwu(N), FD.u32__pow2u(dw)), True{}, VE.le_room(N, dw, hdw, hsrc(dw, N, hy, ok_hN(dw, T, N, hok)))) :
        {(O.Words{FD.array__thaw(U32, T), N}, O.pick(_, N, 2147483648)) == (O.Words{FD.array__thaw(U32, T), N}, N) : O.Words & U32}
      {==}

law encx_spec:
  for +m: B0.MW
  for +hok: {OK(m) == True{} : Bool}
  {Codec.parts(B0.VAL(m), Spec.Schema70()) == Some{[S.Variable{B0.ENC(m)}]} : Maybe<&2, +List<S.Part>>}
def encx_spec(m, hok):
  match m:
    case B0.MW{+dw, +T, +N}: W.specwD(dw, T, N, 0n, 0, N, {==}, ok_hd(dw, T, N, hok), ok_hN(dw, T, N, hok), VB.u32_lt(N), ok_pf(dw, T, N, hok), ok_ex(dw, T, N, hok))

law validx:
  for +m: B0.MW
  for +hok: {OK(m) == True{} : Bool}
  {Fulu_bytelist_32_e.bl32_valid(B0.TH(m)) == (B0.TH(m), True{}) : O.Words & Bool}
def validx(m, hok):
  match m:
    case B0.MW{+dw, +T, +N}: valid(dw, T, N, hok)

law maxx:
  for +m: B0.MW
  for +hok: {OK(m) == True{} : Bool}
  {Nat.is_le(List.length(&2, U32, B0.ENC(m)), 32n) == True{} : Bool}
def maxx(m, hok):
  match m:
    case B0.MW{+dw, +T, +N}:
      FD.logic__subst(Nat, z => {Nat.is_le(z, 32n) == True{} : Bool}, U32.to_nat(N), List.length(&2, U32, B0.ENC(B0.MW{dw, T, N})),
        Equal.sym(Nat, List.length(&2, U32, B0.ENC(B0.MW{dw, T, N})), U32.to_nat(N), eL(dw, T, N, hok)),
        FD.logic__subst(Bool, z => {z == True{} : Bool}, U32.is_le(N, 32), Nat.is_le(U32.to_nat(N), U32.to_nat(32)), VU.le_u32(N, 32), ok_ex(dw, T, N, hok)))

# The base validity (depth below 28) gives this one (below 31): a limited list has no NMAX conjunct.
def okDb(+m: B0.MW, +hok: {B0.OK(m) == True{} : Bool}) -> {OK(m) == True{} : Bool}:
  match m:
    case B0.MW{+dw, +T, +N}:
      +s0 = hok
      +p0 = FD.logic__and_left(FD.array__perfect(U32, dw, T), Bool.and(Nat.is_lt(dw, 28n), Bool.and(Nat.is_le(U32.to_nat(N), A.quad(VB.pw(dw))), Bool.and(O.tail_zero(U32.and(N, 3), VB.slot(T, VYS.QL(N))), U32.is_le(N, 32)))), s0)
      +s1 = FD.logic__and_right(FD.array__perfect(U32, dw, T), Bool.and(Nat.is_lt(dw, 28n), Bool.and(Nat.is_le(U32.to_nat(N), A.quad(VB.pw(dw))), Bool.and(O.tail_zero(U32.and(N, 3), VB.slot(T, VYS.QL(N))), U32.is_le(N, 32)))), s0)
      +p1 = FD.logic__and_left(Nat.is_lt(dw, 28n), Bool.and(Nat.is_le(U32.to_nat(N), A.quad(VB.pw(dw))), Bool.and(O.tail_zero(U32.and(N, 3), VB.slot(T, VYS.QL(N))), U32.is_le(N, 32))), s1)
      +s2 = FD.logic__and_right(Nat.is_lt(dw, 28n), Bool.and(Nat.is_le(U32.to_nat(N), A.quad(VB.pw(dw))), Bool.and(O.tail_zero(U32.and(N, 3), VB.slot(T, VYS.QL(N))), U32.is_le(N, 32))), s1)
      +p2 = FD.logic__and_left(Nat.is_le(U32.to_nat(N), A.quad(VB.pw(dw))), Bool.and(O.tail_zero(U32.and(N, 3), VB.slot(T, VYS.QL(N))), U32.is_le(N, 32)), s2)
      +s3 = FD.logic__and_right(Nat.is_le(U32.to_nat(N), A.quad(VB.pw(dw))), Bool.and(O.tail_zero(U32.and(N, 3), VB.slot(T, VYS.QL(N))), U32.is_le(N, 32)), s2)
      +p3 = FD.logic__and_left(O.tail_zero(U32.and(N, 3), VB.slot(T, VYS.QL(N))), U32.is_le(N, 32), s3)
      +s4 = FD.logic__and_right(O.tail_zero(U32.and(N, 3), VB.slot(T, VYS.QL(N))), U32.is_le(N, 32), s3)
      FD.logic__and_intro(FD.array__perfect(U32, dw, T), Bool.and(Nat.is_lt(dw, 31n), Bool.and(Nat.is_le(U32.to_nat(N), A.quad(VB.pw(dw))), Bool.and(O.tail_zero(U32.and(N, 3), VB.slot(T, VYS.QL(N))), U32.is_le(N, 32)))), p0, FD.logic__and_intro(Nat.is_lt(dw, 31n), Bool.and(Nat.is_le(U32.to_nat(N), A.quad(VB.pw(dw))), Bool.and(O.tail_zero(U32.and(N, 3), VB.slot(T, VYS.QL(N))), U32.is_le(N, 32))), FD.nat__lt_trans(dw, 28n, 31n, p1, {==}), FD.logic__and_intro(Nat.is_le(U32.to_nat(N), A.quad(VB.pw(dw))), Bool.and(O.tail_zero(U32.and(N, 3), VB.slot(T, VYS.QL(N))), U32.is_le(N, 32)), p2, FD.logic__and_intro(O.tail_zero(U32.and(N, 3), VB.slot(T, VYS.QL(N))), U32.is_le(N, 32), p3, s4))))
