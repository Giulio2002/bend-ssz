  for +a: +List<S.Part>
  for +b: +List<S.Part>
  for +ha: {Layout.bytes_valid(a) == True{} : Bool}
  for +hb: {Layout.bytes_valid(b) == True{} : Bool}
  {Layout.bytes_valid(List.append(&2, S.Part, a, b)) == True{} : Bool}
def valid_app(a, b, ha, hb):
  match a:
    case Nil{}: hb
    case Con{+h, +t}:
      match h:
        case S.Fixed{+xs}: F.logic__and_intro(SP.bytes_domain(xs), Layout.bytes_valid(List.append(&2, S.Part, t, b)), F.logic__and_left(SP.bytes_domain(xs), Layout.bytes_valid(t), ha), valid_app(t, b, F.logic__and_right(SP.bytes_domain(xs), Layout.bytes_valid(t), ha), hb))
        case S.Variable{+xs}: F.logic__and_intro(SP.bytes_domain(xs), Layout.bytes_valid(List.append(&2, S.Part, t, b)), F.logic__and_left(SP.bytes_domain(xs), Layout.bytes_valid(t), ha), valid_app(t, b, F.logic__and_right(SP.bytes_domain(xs), Layout.bytes_valid(t), ha), hb))

