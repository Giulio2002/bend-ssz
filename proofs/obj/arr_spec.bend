# ---- an aggregate of word parts with one byte-list part in the middle (a boolean) -----

def mparts(wa: +List<+List<U32>>, +bs: +List<U32>, wb: +List<+List<U32>>) -> +List<S.Part>:
  List.append(&2, S.Part, SF.fparts(wa), Con{S.Fixed{bs}, SF.fparts(wb)})

