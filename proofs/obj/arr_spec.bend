    {Codec.one(SP.optional(Bool.and(True{}, NB.fits(4n, Nat.add(Layout.fixed_size(fp), 0n))), List.append(&2, U32, _, [])), Some{x}) == Some{[S.Fixed{R}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(Nat, Layout.fixed_size(fp), N, hN) :
    {Codec.one(SP.optional(Bool.and(True{}, NB.fits(4n, Nat.add(_, 0n))), List.append(&2, U32, R, [])), Some{x}) == Some{[S.Fixed{R}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(Bool, NB.fits(4n, Nat.add(N, 0n)), True{}, hf) :
    {Codec.one(SP.optional(Bool.and(True{}, _), List.append(&2, U32, R, [])), Some{x}) == Some{[S.Fixed{R}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(+List<U32>, List.append(&2, U32, R, []), R, app_nil(R)) :
    {Codec.one(SP.optional(True{}, _), Some{x}) == Some{[S.Fixed{R}]} : Maybe<&2, +List<S.Part>>}
  {==}

def unsome(m: Maybe<&2, Nat>) -> Nat:
  match m:
    case Some{v}: v
    case None{}: 0n
