  %Equal.sym(Maybe<&2, +List<S.Part>>, Codec.parts(CI.VALC(wR), Spec.BeaconState()), Some{[S.Variable{K.ENCC(wR)}]}, CIo.encx_specO(CI.MW{wR}, h)) :
    {Codec.bytes(_) == Some{VS.bt(U32.to_nat(Z.SZS(wR)), FX.limbs(FD.array__slots(U32, K.PUTC(wR, VL.DO(Z.SZS(wR)), VC.ZT(VL.DO(Z.SZS(wR))), 0, 0n, 0n))))} : Maybe<&2, +List<U32>>}
  %Equal.sym(+List<U32>, VS.bt(U32.to_nat(Z.SZS(wR)), FX.limbs(FD.array__slots(U32, K.PUTC(wR, VL.DO(Z.SZS(wR)), VC.ZT(VL.DO(Z.SZS(wR))), 0, 0n, 0n)))), K.ENCC(wR), obytesO(wR, h, 29n, {==})) :
    {Some{K.ENCC(wR)} == Some{_} : Maybe<&2, +List<U32>>}
  {==}

law encode_evalO:
  for +m: CI.MW
  for +hok: {CIo.OKW(m) == True{} : Bool}
  {FuluBeaconState_e.BeaconState_encode(CI.TH(m)) == (CI.TH(m), B.Buf{FD.array__thaw(U32, OB.OUTE(m)), OB.SZSM(m)}) : FuluBeaconState_d.BeaconState & B.Buf}
def encode_evalO(m, hok):
  match m:
    case CI.MW{+wR}: eval_goO(wR, hok)

law encode_specO:
  for +m: CI.MW
  for +hok: {CIo.OKW(m) == True{} : Bool}
  Decoding.decodes(Spec.BeaconState(), VS.bt(U32.to_nat(OB.SZSM(m)), FX.limbs(FD.array__slots(U32, OB.OUTE(m)))), CI.VAL(m))
def encode_specO(m, hok):
  match m:
    case CI.MW{+wR}: spec_goO(wR, hok)
