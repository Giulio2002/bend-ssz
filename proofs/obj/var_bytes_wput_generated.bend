    +pfB: {F.array__perfect(U32, dB, TB) == True{} : Bool}, +hdB: {Nat.is_lt(dB, 31n) == True{} : Bool},
    +hrB: {Nat.is_le(48n, VB.pw(dB)) == True{} : Bool})
