  +hB32 = VB.lt32(dB, hdB)
  %Equal.sym(O.Words & Bool, FuluCurrentSyncCommitteeBranch_e.v6_b32_valid(O.Words{F.array__thaw(U32, TB), 192}), (O.Words{F.array__thaw(U32, TB), 192}, True{}),
      VBE.words_ok_b(dB, TB, 192, 192, 192, 8n, pfB, hdB, {==}, {==}, {==}, {==}, hrB, {==}, 32, {==})) :
    {FuluCurrentSyncCommitteeBranch_e.v6_b32_pk(F.array__thaw(U32, D), pos, _) == (F.array__thaw(U32, VF.updv(WL_v6_b32(TB), dd, D, P)), (O.Words{F.array__thaw(U32, TB), 192}, 0)) : Array<U32> & (O.Words & U32)}
