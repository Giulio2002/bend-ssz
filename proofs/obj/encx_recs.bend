# T.SyncAggregate_put at X = 4 q + r writes the value's words' limbs into the 160 zero bytes there.
def putx_SyncAggregate(+w0: U32, +w1: U32, +w2: U32, +w3: U32, +w4: U32, +w5: U32, +w6: U32, +w7: U32, +w8: U32, +w9: U32, +w10: U32, +w11: U32, +w12: U32, +w13: U32, +w14: U32, +w15: U32, +w16: U32, +w17: U32, +w18: U32, +w19: U32, +w20: U32, +w21: U32, +w22: U32, +w23: U32, +w24: U32, +w25: U32, +w26: U32, +w27: U32, +w28: U32, +w29: U32, +w30: U32, +w31: U32, +w32: U32, +w33: U32, +w34: U32, +w35: U32, +w36: U32, +w37: U32, +w38: U32, +w39: U32, +dd: Nat, +D: FD.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat,
    +e: {U32.to_nat(X) == Nat.add(A.quad(q), r) : Nat}, +hr: {Nat.is_lt(r, 4n) == True{} : Bool}, +hd: {Nat.is_lt(dd, 29n) == True{} : Bool},
    +hl: {Nat.is_le(Nat.add(q, WD.NWN(Nat.add(r, 160n))), VB.pw(dd)) == True{} : Bool}, +pf: {FD.array__perfect(U32, dd, D) == True{} : Bool},
    +hz: {VS.bt(160n, VS.bdr(Nat.add(A.quad(q), r), UA.BYT(D))) == UW.ZB(160n) : +List<U32>})
    -> DK.P2(RT_SyncAggregate(w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11, w12, w13, w14, w15, w16, w17, w18, w19, w20, w21, w22, w23, w24, w25, w26, w27, w28, w29, w30, w31, w32, w33, w34, w35, w36, w37, w38, w39, dd, D, X, q, r), BY_SyncAggregate(w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11, w12, w13, w14, w15, w16, w17, w18, w19, w20, w21, w22, w23, w24, w25, w26, w27, w28, w29, w30, w31, w32, w33, w34, w35, w36, w37, w38, w39, dd, D, q, r)):
  +hX = VRX.xstart(q, r, 160n, dd, D, pf, hl)
  +I0 = UW.inv_init(UA.BYT(D), Nat.add(A.quad(q), r), 160n, UW.ZB(160n), hz, {==})
  +ep0 = VRX.fpos(X, q, r, 0n, 0, 160n, dd, e, {==}, hd, {==}, hl)
  +hl0 = VRX.froom(q, r, dd, 0n, 64n, 160n, {==}, hl)
  +z0 = UW.inv_zero(UA.BYT(D), Nat.add(A.quad(q), r), 160n, UW.ZB(160n), 0n, 64n, UA.BYT(D), hX, I0, {==}, {==}, {==})
