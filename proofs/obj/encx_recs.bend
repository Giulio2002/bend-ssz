# ---- Checkpoint: 2 fields, 40 bytes ----
def PX_Checkpoint(+w0: U32, +w1: U32, +w2: U32, +w3: U32, +w4: U32, +w5: U32, +w6: U32, +w7: U32, +w8: U32, +w9: U32, +dd: Nat, +D: FD.array__Tree<U32>, +q: Nat, +r: Nat) -> FD.array__Tree<U32>: V_b32.PX_b32(r, dd, WD.W64X(r, dd, D, Nat.add(0n, q), w0, w1), Nat.add(2n, q), w2, w3, w4, w5, w6, w7, w8, w9)
def pf_Checkpoint(+w0: U32, +w1: U32, +w2: U32, +w3: U32, +w4: U32, +w5: U32, +w6: U32, +w7: U32, +w8: U32, +w9: U32, +dd: Nat, +D: FD.array__Tree<U32>, +q: Nat, +r: Nat, +pf: {FD.array__perfect(U32, dd, D) == True{} : Bool})
    -> {FD.array__perfect(U32, dd, PX_Checkpoint(w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, dd, D, q, r)) == True{} : Bool}:
  V_b32.b32x_perfect(r, dd, WD.W64X(r, dd, D, Nat.add(0n, q), w0, w1), Nat.add(2n, q), w2, w3, w4, w5, w6, w7, w8, w9, WD.w64x_perfect(r, dd, D, Nat.add(0n, q), w0, w1, pf))
def RT_Checkpoint(+w0: U32, +w1: U32, +w2: U32, +w3: U32, +w4: U32, +w5: U32, +w6: U32, +w7: U32, +w8: U32, +w9: U32, +dd: Nat, +D: FD.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat) -> Data: {T.Checkpoint_put(FD.array__thaw(U32, D), X, T.Checkpoint{O.U64{w0, w1}, T.Bytes32{w2, w3, w4, w5, w6, w7, w8, w9}}) == FD.array__thaw(U32, PX_Checkpoint(w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, dd, D, q, r)) : Array<U32>}
def BY_Checkpoint(+w0: U32, +w1: U32, +w2: U32, +w3: U32, +w4: U32, +w5: U32, +w6: U32, +w7: U32, +w8: U32, +w9: U32, +dd: Nat, +D: FD.array__Tree<U32>, +q: Nat, +r: Nat) -> Data: {UA.BYT(PX_Checkpoint(w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, dd, D, q, r)) == UW.SPL(UA.BYT(D), Nat.add(A.quad(q), r), FX.limbs([w0, w1, w2, w3, w4, w5, w6, w7, w8, w9])) : +List<U32>}


def rt_Checkpoint(+w0: U32, +w1: U32, +w2: U32, +w3: U32, +w4: U32, +w5: U32, +w6: U32, +w7: U32, +w8: U32, +w9: U32, +dd: Nat, +D: FD.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat,
    +rt0: {T.u64_put(FD.array__thaw(U32, D), U32.add(X, 0), O.U64{w0, w1}) == FD.array__thaw(U32, WD.W64X(r, dd, D, Nat.add(0n, q), w0, w1)) : Array<U32>},
    +rt1: {T.b32_put(FD.array__thaw(U32, WD.W64X(r, dd, D, Nat.add(0n, q), w0, w1)), U32.add(X, 8), T.Bytes32{w2, w3, w4, w5, w6, w7, w8, w9}) == FD.array__thaw(U32, V_b32.PX_b32(r, dd, WD.W64X(r, dd, D, Nat.add(0n, q), w0, w1), Nat.add(2n, q), w2, w3, w4, w5, w6, w7, w8, w9)) : Array<U32>})
    -> {T.Checkpoint_put(FD.array__thaw(U32, D), X, T.Checkpoint{O.U64{w0, w1}, T.Bytes32{w2, w3, w4, w5, w6, w7, w8, w9}}) == FD.array__thaw(U32, PX_Checkpoint(w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, dd, D, q, r)) : Array<U32>}:
  %Equal.sym(Array<U32>, T.u64_put(FD.array__thaw(U32, D), U32.add(X, 0), O.U64{w0, w1}), FD.array__thaw(U32, WD.W64X(r, dd, D, Nat.add(0n, q), w0, w1)), rt0) :
    {T.b32_put(_, U32.add(X, 8), T.Bytes32{w2, w3, w4, w5, w6, w7, w8, w9}) == FD.array__thaw(U32, PX_Checkpoint(w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, dd, D, q, r)) : Array<U32>}
