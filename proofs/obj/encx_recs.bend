# T.SignedVoluntaryExit_put at X = 4 q + r writes the value's words' limbs into the 112 zero bytes there.
def putx_SignedVoluntaryExit(+w0: U32, +w1: U32, +w2: U32, +w3: U32, +w4: U32, +w5: U32, +w6: U32, +w7: U32, +w8: U32, +w9: U32, +w10: U32, +w11: U32, +w12: U32, +w13: U32, +w14: U32, +w15: U32, +w16: U32, +w17: U32, +w18: U32, +w19: U32, +w20: U32, +w21: U32, +w22: U32, +w23: U32, +w24: U32, +w25: U32, +w26: U32, +w27: U32, +dd: Nat, +D: FD.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat,
    +e: {U32.to_nat(X) == Nat.add(A.quad(q), r) : Nat}, +hr: {Nat.is_lt(r, 4n) == True{} : Bool}, +hd: {Nat.is_lt(dd, 29n) == True{} : Bool},
    +hl: {Nat.is_le(Nat.add(q, WD.NWN(Nat.add(r, 112n))), VB.pw(dd)) == True{} : Bool}, +pf: {FD.array__perfect(U32, dd, D) == True{} : Bool},
    +hz: {VS.bt(112n, VS.bdr(Nat.add(A.quad(q), r), UA.BYT(D))) == UW.ZB(112n) : +List<U32>})
    -> DK.P2(RT_SignedVoluntaryExit(w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11, w12, w13, w14, w15, w16, w17, w18, w19, w20, w21, w22, w23, w24, w25, w26, w27, dd, D, X, q, r), BY_SignedVoluntaryExit(w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11, w12, w13, w14, w15, w16, w17, w18, w19, w20, w21, w22, w23, w24, w25, w26, w27, dd, D, q, r)):
  +hX = VRX.xstart(q, r, 112n, dd, D, pf, hl)
  +I0 = UW.inv_init(UA.BYT(D), Nat.add(A.quad(q), r), 112n, UW.ZB(112n), hz, {==})
  +ep0 = VRX.fpos(X, q, r, 0n, 0, 112n, dd, e, {==}, hd, {==}, hl)
  +hl0 = VRX.froom(q, r, dd, 0n, 16n, 112n, {==}, hl)
  +z0 = UW.inv_zero(UA.BYT(D), Nat.add(A.quad(q), r), 112n, UW.ZB(112n), 0n, 16n, UA.BYT(D), hX, I0, {==}, {==}, {==})
  +hz0 = FD.logic__subst(Nat, zz => {VS.bt(16n, VS.bdr(zz, UA.BYT(D))) == UW.ZB(16n) : +List<U32>}, Nat.add(Nat.add(A.quad(q), r), 0n), Nat.add(A.quad(Nat.add(0n, q)), r), VRX.fpx(q, r, 0n), z0)
  +g0 = putx_VoluntaryExit(w0, w1, w2, w3, dd, D, U32.add(X, 0), Nat.add(0n, q), r, ep0, hr, hd, hl0, pf, hz0)
  +rt0 = PA(RT_VoluntaryExit(w0, w1, w2, w3, dd, D, U32.add(X, 0), Nat.add(0n, q), r), BY_VoluntaryExit(w0, w1, w2, w3, dd, D, Nat.add(0n, q), r), g0)
  +by0 = PB(RT_VoluntaryExit(w0, w1, w2, w3, dd, D, U32.add(X, 0), Nat.add(0n, q), r), BY_VoluntaryExit(w0, w1, w2, w3, dd, D, Nat.add(0n, q), r), g0)
  +hop0 = FD.logic__subst(Nat, zz => {UA.BYT(PX_VoluntaryExit(w0, w1, w2, w3, dd, D, Nat.add(0n, q), r)) == UW.SPL(UA.BYT(D), zz, FX.limbs([w0, w1, w2, w3])) : +List<U32>}, Nat.add(A.quad(Nat.add(0n, q)), r), Nat.add(Nat.add(A.quad(q), r), 0n), Equal.sym(Nat, Nat.add(Nat.add(A.quad(q), r), 0n), Nat.add(A.quad(Nat.add(0n, q)), r), VRX.fpx(q, r, 0n)), by0)
  +I1 = UW.inv_step(UA.BYT(D), Nat.add(A.quad(q), r), 112n, UW.ZB(112n), 0n, FX.limbs([w0, w1, w2, w3]), 96n, UA.BYT(D), UA.BYT(PX_VoluntaryExit(w0, w1, w2, w3, dd, D, Nat.add(0n, q), r)), hX, I0, hop0, {==}, {==})
  +ep1 = VRX.fpos(X, q, r, 4n, 16, 112n, dd, e, {==}, hd, {==}, hl)
  +hl1 = VRX.froom(q, r, dd, 4n, 96n, 112n, {==}, hl)
  +z1 = UW.inv_zero(UA.BYT(D), Nat.add(A.quad(q), r), 112n, UW.SPL(UW.ZB(112n), 0n, FX.limbs([w0, w1, w2, w3])), 16n, 96n, UA.BYT(PX_VoluntaryExit(w0, w1, w2, w3, dd, D, Nat.add(0n, q), r)), hX, I1, {==}, {==}, {==})
