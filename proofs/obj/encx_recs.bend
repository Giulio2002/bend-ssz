    {_ == FD.array__thaw(U32, PX_Checkpoint(w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, dd, D, q, r)) : Array<U32>}
  {==}

# T.Checkpoint_put at X = 4 q + r writes the value's words' limbs into the 40 zero bytes there.
def putx_Checkpoint(+w0: U32, +w1: U32, +w2: U32, +w3: U32, +w4: U32, +w5: U32, +w6: U32, +w7: U32, +w8: U32, +w9: U32, +dd: Nat, +D: FD.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat,
    +e: {U32.to_nat(X) == Nat.add(A.quad(q), r) : Nat}, +hr: {Nat.is_lt(r, 4n) == True{} : Bool}, +hd: {Nat.is_lt(dd, 29n) == True{} : Bool},
    +hl: {Nat.is_le(Nat.add(q, WD.NWN(Nat.add(r, 40n))), VB.pw(dd)) == True{} : Bool}, +pf: {FD.array__perfect(U32, dd, D) == True{} : Bool},
    +hz: {VS.bt(40n, VS.bdr(Nat.add(A.quad(q), r), UA.BYT(D))) == UW.ZB(40n) : +List<U32>})
    -> DK.P2(RT_Checkpoint(w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, dd, D, X, q, r), BY_Checkpoint(w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, dd, D, q, r)):
  +hX = VRX.xstart(q, r, 40n, dd, D, pf, hl)
  +I0 = UW.inv_init(UA.BYT(D), Nat.add(A.quad(q), r), 40n, UW.ZB(40n), hz, {==})
  +ep0 = VRX.fpos(X, q, r, 0n, 0, 40n, dd, e, {==}, hd, {==}, hl)
  +hl0 = VRX.froom(q, r, dd, 0n, 8n, 40n, {==}, hl)
  +z0 = UW.inv_zero(UA.BYT(D), Nat.add(A.quad(q), r), 40n, UW.ZB(40n), 0n, 8n, UA.BYT(D), hX, I0, {==}, {==}, {==})
  +hz0 = FD.logic__subst(Nat, zz => {VS.bt(8n, VS.bdr(zz, UA.BYT(D))) == UW.ZB(8n) : +List<U32>}, Nat.add(Nat.add(A.quad(q), r), 0n), Nat.add(A.quad(Nat.add(0n, q)), r), VRX.fpx(q, r, 0n), z0)
  +rt0 = WD.w64_any(dd, D, U32.add(X, 0), Nat.add(0n, q), r, w0, w1, ep0, hr, hd, hl0, pf)
  +by0 = WD.w64_any_bytes(dd, D, U32.add(X, 0), Nat.add(0n, q), r, w0, w1, ep0, hr, hd, hl0, pf, hz0)
  +hop0 = FD.logic__subst(Nat, zz => {UA.BYT(WD.W64X(r, dd, D, Nat.add(0n, q), w0, w1)) == UW.SPL(UA.BYT(D), zz, FX.limbs([w0, w1])) : +List<U32>}, Nat.add(A.quad(Nat.add(0n, q)), r), Nat.add(Nat.add(A.quad(q), r), 0n), Equal.sym(Nat, Nat.add(Nat.add(A.quad(q), r), 0n), Nat.add(A.quad(Nat.add(0n, q)), r), VRX.fpx(q, r, 0n)), by0)
  +I1 = UW.inv_step(UA.BYT(D), Nat.add(A.quad(q), r), 40n, UW.ZB(40n), 0n, FX.limbs([w0, w1]), 32n, UA.BYT(D), UA.BYT(WD.W64X(r, dd, D, Nat.add(0n, q), w0, w1)), hX, I0, hop0, {==}, {==})
  +ep1 = VRX.fpos(X, q, r, 2n, 8, 40n, dd, e, {==}, hd, {==}, hl)
  +hl1 = VRX.froom(q, r, dd, 2n, 32n, 40n, {==}, hl)
  +z1 = UW.inv_zero(UA.BYT(D), Nat.add(A.quad(q), r), 40n, UW.SPL(UW.ZB(40n), 0n, FX.limbs([w0, w1])), 8n, 32n, UA.BYT(WD.W64X(r, dd, D, Nat.add(0n, q), w0, w1)), hX, I1, {==}, {==}, {==})
  +hz1 = FD.logic__subst(Nat, zz => {VS.bt(32n, VS.bdr(zz, UA.BYT(WD.W64X(r, dd, D, Nat.add(0n, q), w0, w1)))) == UW.ZB(32n) : +List<U32>}, Nat.add(Nat.add(A.quad(q), r), 8n), Nat.add(A.quad(Nat.add(2n, q)), r), VRX.fpx(q, r, 2n), z1)
  +rt1 = V_b32.b32_any(dd, WD.W64X(r, dd, D, Nat.add(0n, q), w0, w1), U32.add(X, 8), Nat.add(2n, q), r, w2, w3, w4, w5, w6, w7, w8, w9, ep1, hr, hd, hl1, WD.w64x_perfect(r, dd, D, Nat.add(0n, q), w0, w1, pf), hz1)
  +by1 = V_b32.b32_any_bytes(dd, WD.W64X(r, dd, D, Nat.add(0n, q), w0, w1), U32.add(X, 8), Nat.add(2n, q), r, w2, w3, w4, w5, w6, w7, w8, w9, ep1, hr, hd, hl1, WD.w64x_perfect(r, dd, D, Nat.add(0n, q), w0, w1, pf), hz1)
  +hop1 = FD.logic__subst(Nat, zz => {UA.BYT(V_b32.PX_b32(r, dd, WD.W64X(r, dd, D, Nat.add(0n, q), w0, w1), Nat.add(2n, q), w2, w3, w4, w5, w6, w7, w8, w9)) == UW.SPL(UA.BYT(WD.W64X(r, dd, D, Nat.add(0n, q), w0, w1)), zz, FX.limbs([w2, w3, w4, w5, w6, w7, w8, w9])) : +List<U32>}, Nat.add(A.quad(Nat.add(2n, q)), r), Nat.add(Nat.add(A.quad(q), r), 8n), Equal.sym(Nat, Nat.add(Nat.add(A.quad(q), r), 8n), Nat.add(A.quad(Nat.add(2n, q)), r), VRX.fpx(q, r, 2n)), by1)
  +I2 = UW.inv_step(UA.BYT(D), Nat.add(A.quad(q), r), 40n, UW.SPL(UW.ZB(40n), 0n, FX.limbs([w0, w1])), 8n, FX.limbs([w2, w3, w4, w5, w6, w7, w8, w9]), 0n, UA.BYT(WD.W64X(r, dd, D, Nat.add(0n, q), w0, w1)), UA.BYT(V_b32.PX_b32(r, dd, WD.W64X(r, dd, D, Nat.add(0n, q), w0, w1), Nat.add(2n, q), w2, w3, w4, w5, w6, w7, w8, w9)), hX, I1, hop1, {==}, {==})
  +byf = FD.logic__subst(+List<U32>, zz => {UA.BYT(PX_Checkpoint(w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, dd, D, q, r)) == UW.SPL(UA.BYT(D), Nat.add(A.quad(q), r), zz) : +List<U32>}, VS.bt(40n, UW.SPL(UW.SPL(UW.ZB(40n), 0n, FX.limbs([w0, w1])), 8n, FX.limbs([w2, w3, w4, w5, w6, w7, w8, w9]))), FX.limbs([w0, w1, w2, w3, w4, w5, w6, w7, w8, w9]), {==}, I2)
  (rt_Checkpoint(w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, dd, D, X, q, r, rt0, rt1), byf)


# ---- Eth1Data: 3 fields, 72 bytes ----
def PX_Eth1Data(+w0: U32, +w1: U32, +w2: U32, +w3: U32, +w4: U32, +w5: U32, +w6: U32, +w7: U32, +w8: U32, +w9: U32, +w10: U32, +w11: U32, +w12: U32, +w13: U32, +w14: U32, +w15: U32, +w16: U32, +w17: U32, +dd: Nat, +D: FD.array__Tree<U32>, +q: Nat, +r: Nat) -> FD.array__Tree<U32>: V_b32.PX_b32(r, dd, WD.W64X(r, dd, V_b32.PX_b32(r, dd, D, Nat.add(0n, q), w0, w1, w2, w3, w4, w5, w6, w7), Nat.add(8n, q), w8, w9), Nat.add(10n, q), w10, w11, w12, w13, w14, w15, w16, w17)
def pf_Eth1Data(+w0: U32, +w1: U32, +w2: U32, +w3: U32, +w4: U32, +w5: U32, +w6: U32, +w7: U32, +w8: U32, +w9: U32, +w10: U32, +w11: U32, +w12: U32, +w13: U32, +w14: U32, +w15: U32, +w16: U32, +w17: U32, +dd: Nat, +D: FD.array__Tree<U32>, +q: Nat, +r: Nat, +pf: {FD.array__perfect(U32, dd, D) == True{} : Bool})
