  +ep0 = VRX.fposW(X, q, r, 0n, 0, 16n, dd, e, {==}, hd, {==}, hl)
  +hl0 = VRX.froom(q, r, dd, 0n, 4n, 16n, {==}, hl)
  +z0 = UW.inv_zero(UA.BYT(D), Nat.add(A.quad(q), r), 16n, UW.ZB(16n), 0n, 4n, UA.BYT(D), hX, I0, {==}, {==}, {==})
