    {T.u64_put(_, U32.add(X, 68), O.U64{w17, w18}) == FD.array__thaw(U32, PX_WithdrawalRequest(w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11, w12, w13, w14, w15, w16, w17, w18, dd, D, q, r)) : Array<U32>}
