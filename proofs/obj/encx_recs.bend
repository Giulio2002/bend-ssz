    +hl: {Nat.is_le(Nat.add(q, WD.NWN(Nat.add(r, 112n))), VB.pw(dd)) == True{} : Bool}, +hl32: {Nat.is_lt(Nat.add(A.quad(q), Nat.add(r, 112n)), FD.spec_common__pow2(32n)) == True{} : Bool}, +pf: {FD.array__perfect(U32, dd, D) == True{} : Bool},
    +hz: {VS.bt(112n, VS.bdr(Nat.add(A.quad(q), r), UA.BYT(D))) == UW.ZB(112n) : +List<U32>})
    -> DK.P2(RT_BeaconBlockHeader(w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11, w12, w13, w14, w15, w16, w17, w18, w19, w20, w21, w22, w23, w24, w25, w26, w27, dd, D, X, q, r), BY_BeaconBlockHeader(w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11, w12, w13, w14, w15, w16, w17, w18, w19, w20, w21, w22, w23, w24, w25, w26, w27, dd, D, q, r)):
