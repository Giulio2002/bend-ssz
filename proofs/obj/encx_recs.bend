  +hz1 = FD.logic__subst(Nat, zz => {VS.bt(4n, VS.bdr(zz, UA.BYT(V_b4.PX_b4(r, dd, D, Nat.add(0n, q), w0)))) == UW.ZB(4n) : +List<U32>}, Nat.add(Nat.add(A.quad(q), r), 4n), Nat.add(A.quad(Nat.add(1n, q)), r), VRX.fpx(q, r, 1n), z1)
  +rt1 = V_b4.b4_anyW(dd, V_b4.PX_b4(r, dd, D, Nat.add(0n, q), w0), U32.add(X, 4), Nat.add(1n, q), r, w1, ep1, hr, hd, hl1, V_b4.b4x_perfect(r, dd, D, Nat.add(0n, q), w0, pf), hz1)
  +by1 = V_b4.b4_any_bytesW(dd, V_b4.PX_b4(r, dd, D, Nat.add(0n, q), w0), U32.add(X, 4), Nat.add(1n, q), r, w1, ep1, hr, hd, hl1, V_b4.b4x_perfect(r, dd, D, Nat.add(0n, q), w0, pf), hz1)
  +hop1 = FD.logic__subst(Nat, zz => {UA.BYT(V_b4.PX_b4(r, dd, V_b4.PX_b4(r, dd, D, Nat.add(0n, q), w0), Nat.add(1n, q), w1)) == UW.SPL(UA.BYT(V_b4.PX_b4(r, dd, D, Nat.add(0n, q), w0)), zz, FX.limbs([w1])) : +List<U32>}, Nat.add(A.quad(Nat.add(1n, q)), r), Nat.add(Nat.add(A.quad(q), r), 4n), Equal.sym(Nat, Nat.add(Nat.add(A.quad(q), r), 4n), Nat.add(A.quad(Nat.add(1n, q)), r), VRX.fpx(q, r, 1n)), by1)
  +I2 = UW.inv_step(UA.BYT(D), Nat.add(A.quad(q), r), 16n, UW.SPL(UW.ZB(16n), 0n, FX.limbs([w0])), 4n, FX.limbs([w1]), 8n, UA.BYT(V_b4.PX_b4(r, dd, D, Nat.add(0n, q), w0)), UA.BYT(V_b4.PX_b4(r, dd, V_b4.PX_b4(r, dd, D, Nat.add(0n, q), w0), Nat.add(1n, q), w1)), hX, I1, hop1, {==}, {==})
  +ep2 = VRX.fposW(X, q, r, 2n, 8, 16n, dd, e, {==}, hd, {==}, hl)
