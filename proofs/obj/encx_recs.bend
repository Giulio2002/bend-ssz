# T.Fork_put at X = 4 q + r writes the value's words' limbs into the 16 zero bytes there.
def putx_ForkW(+w0: U32, +w1: U32, +w2: U32, +w3: U32, +dd: Nat, +D: FD.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat,
