# ---- WithdrawalRequest: 3 fields, 76 bytes ----
def PX_WithdrawalRequest(+w0: U32, +w1: U32, +w2: U32, +w3: U32, +w4: U32, +w5: U32, +w6: U32, +w7: U32, +w8: U32, +w9: U32, +w10: U32, +w11: U32, +w12: U32, +w13: U32, +w14: U32, +w15: U32, +w16: U32, +w17: U32, +w18: U32, +dd: Nat, +D: FD.array__Tree<U32>, +q: Nat, +r: Nat) -> FD.array__Tree<U32>: WD.W64X(r, dd, V_b48.PX_b48(r, dd, WD.B20X(r, dd, D, Nat.add(0n, q), w0, w1, w2, w3, w4), Nat.add(5n, q), w5, w6, w7, w8, w9, w10, w11, w12, w13, w14, w15, w16), Nat.add(17n, q), w17, w18)
