# T.AttestationData_put at X = 4 q + r writes the value's words' limbs into the 128 zero bytes there.
def putx_AttestationData(+w0: U32, +w1: U32, +w2: U32, +w3: U32, +w4: U32, +w5: U32, +w6: U32, +w7: U32, +w8: U32, +w9: U32, +w10: U32, +w11: U32, +w12: U32, +w13: U32, +w14: U32, +w15: U32, +w16: U32, +w17: U32, +w18: U32, +w19: U32, +w20: U32, +w21: U32, +w22: U32, +w23: U32, +w24: U32, +w25: U32, +w26: U32, +w27: U32, +w28: U32, +w29: U32, +w30: U32, +w31: U32, +dd: Nat, +D: FD.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat,
