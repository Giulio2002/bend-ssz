# T.WithdrawalRequest_put at X = 4 q + r writes the value's words' limbs into the 76 zero bytes there.
def putx_WithdrawalRequest(+w0: U32, +w1: U32, +w2: U32, +w3: U32, +w4: U32, +w5: U32, +w6: U32, +w7: U32, +w8: U32, +w9: U32, +w10: U32, +w11: U32, +w12: U32, +w13: U32, +w14: U32, +w15: U32, +w16: U32, +w17: U32, +w18: U32, +dd: Nat, +D: FD.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat,
    +e: {U32.to_nat(X) == Nat.add(A.quad(q), r) : Nat}, +hr: {Nat.is_lt(r, 4n) == True{} : Bool}, +hd: {Nat.is_lt(dd, 29n) == True{} : Bool},
    +hl: {Nat.is_le(Nat.add(q, WD.NWN(Nat.add(r, 76n))), VB.pw(dd)) == True{} : Bool}, +pf: {FD.array__perfect(U32, dd, D) == True{} : Bool},
    +hz: {VS.bt(76n, VS.bdr(Nat.add(A.quad(q), r), UA.BYT(D))) == UW.ZB(76n) : +List<U32>})
    -> DK.P2(RT_WithdrawalRequest(w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11, w12, w13, w14, w15, w16, w17, w18, dd, D, X, q, r), BY_WithdrawalRequest(w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11, w12, w13, w14, w15, w16, w17, w18, dd, D, q, r)):
  +hX = VRX.xstart(q, r, 76n, dd, D, pf, hl)
  +I0 = UW.inv_init(UA.BYT(D), Nat.add(A.quad(q), r), 76n, UW.ZB(76n), hz, {==})
