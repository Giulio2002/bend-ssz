  +rt0 = WD.w64_anyW(dd, D, U32.add(X, 0), Nat.add(0n, q), r, w0, w1, ep0, hr, hd, hl0, pf)
  +by0 = WD.w64_any_bytesW(dd, D, U32.add(X, 0), Nat.add(0n, q), r, w0, w1, ep0, hr, hd, hl0, pf, hz0)
  +hop0 = FD.logic__subst(Nat, zz => {UA.BYT(WD.W64X(r, dd, D, Nat.add(0n, q), w0, w1)) == UW.SPL(UA.BYT(D), zz, FX.limbs([w0, w1])) : +List<U32>}, Nat.add(A.quad(Nat.add(0n, q)), r), Nat.add(Nat.add(A.quad(q), r), 0n), Equal.sym(Nat, Nat.add(Nat.add(A.quad(q), r), 0n), Nat.add(A.quad(Nat.add(0n, q)), r), VRX.fpx(q, r, 0n)), by0)
  +I1 = UW.inv_step(UA.BYT(D), Nat.add(A.quad(q), r), 16n, UW.ZB(16n), 0n, FX.limbs([w0, w1]), 8n, UA.BYT(D), UA.BYT(WD.W64X(r, dd, D, Nat.add(0n, q), w0, w1)), hX, I0, hop0, {==}, {==})
  +ep1 = VRX.fposW(X, q, r, 2n, 8, 16n, dd, e, {==}, hd, {==}, hl)
  +hl1 = VRX.froom(q, r, dd, 2n, 8n, 16n, {==}, hl)
  +z1 = UW.inv_zero(UA.BYT(D), Nat.add(A.quad(q), r), 16n, UW.SPL(UW.ZB(16n), 0n, FX.limbs([w0, w1])), 8n, 8n, UA.BYT(WD.W64X(r, dd, D, Nat.add(0n, q), w0, w1)), hX, I1, {==}, {==}, {==})
  +hz1 = FD.logic__subst(Nat, zz => {VS.bt(8n, VS.bdr(zz, UA.BYT(WD.W64X(r, dd, D, Nat.add(0n, q), w0, w1)))) == UW.ZB(8n) : +List<U32>}, Nat.add(Nat.add(A.quad(q), r), 8n), Nat.add(A.quad(Nat.add(2n, q)), r), VRX.fpx(q, r, 2n), z1)
  +rt1 = WD.w64_anyW(dd, WD.W64X(r, dd, D, Nat.add(0n, q), w0, w1), U32.add(X, 8), Nat.add(2n, q), r, w2, w3, ep1, hr, hd, hl1, WD.w64x_perfect(r, dd, D, Nat.add(0n, q), w0, w1, pf))
  +by1 = WD.w64_any_bytesW(dd, WD.W64X(r, dd, D, Nat.add(0n, q), w0, w1), U32.add(X, 8), Nat.add(2n, q), r, w2, w3, ep1, hr, hd, hl1, WD.w64x_perfect(r, dd, D, Nat.add(0n, q), w0, w1, pf), hz1)
  +hop1 = FD.logic__subst(Nat, zz => {UA.BYT(WD.W64X(r, dd, WD.W64X(r, dd, D, Nat.add(0n, q), w0, w1), Nat.add(2n, q), w2, w3)) == UW.SPL(UA.BYT(WD.W64X(r, dd, D, Nat.add(0n, q), w0, w1)), zz, FX.limbs([w2, w3])) : +List<U32>}, Nat.add(A.quad(Nat.add(2n, q)), r), Nat.add(Nat.add(A.quad(q), r), 8n), Equal.sym(Nat, Nat.add(Nat.add(A.quad(q), r), 8n), Nat.add(A.quad(Nat.add(2n, q)), r), VRX.fpx(q, r, 2n)), by1)
  +I2 = UW.inv_step(UA.BYT(D), Nat.add(A.quad(q), r), 16n, UW.SPL(UW.ZB(16n), 0n, FX.limbs([w0, w1])), 8n, FX.limbs([w2, w3]), 0n, UA.BYT(WD.W64X(r, dd, D, Nat.add(0n, q), w0, w1)), UA.BYT(WD.W64X(r, dd, WD.W64X(r, dd, D, Nat.add(0n, q), w0, w1), Nat.add(2n, q), w2, w3)), hX, I1, hop1, {==}, {==})
  +byf = FD.logic__subst(+List<U32>, zz => {UA.BYT(PX_VoluntaryExit(w0, w1, w2, w3, dd, D, q, r)) == UW.SPL(UA.BYT(D), Nat.add(A.quad(q), r), zz) : +List<U32>}, VS.bt(16n, UW.SPL(UW.SPL(UW.ZB(16n), 0n, FX.limbs([w0, w1])), 8n, FX.limbs([w2, w3]))), FX.limbs([w0, w1, w2, w3]), {==}, I2)
  (rt_VoluntaryExit(w0, w1, w2, w3, dd, D, X, q, r, rt0, rt1), byf)

def putx_VoluntaryExit(+w0: U32, +w1: U32, +w2: U32, +w3: U32, +dd: Nat, +D: FD.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat,
