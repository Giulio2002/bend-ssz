    -> {T.WithdrawalRequest_put(FD.array__thaw(U32, D), X, T.WithdrawalRequest{T.Bytes20{w0, w1, w2, w3, w4}, T.Bytes48{w5, w6, w7, w8, w9, w10, w11, w12, w13, w14, w15, w16}, O.U64{w17, w18}}) == FD.array__thaw(U32, PX_WithdrawalRequest(w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11, w12, w13, w14, w15, w16, w17, w18, dd, D, q, r)) : Array<U32>}:
  %Equal.sym(Array<U32>, T.b20_put(FD.array__thaw(U32, D), U32.add(X, 0), T.Bytes20{w0, w1, w2, w3, w4}), FD.array__thaw(U32, WD.B20X(r, dd, D, Nat.add(0n, q), w0, w1, w2, w3, w4)), rt0) :
