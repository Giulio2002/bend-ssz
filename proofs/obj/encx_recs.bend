# ---- VoluntaryExit: 2 fields, 16 bytes ----
def PX_VoluntaryExit(+w0: U32, +w1: U32, +w2: U32, +w3: U32, +dd: Nat, +D: FD.array__Tree<U32>, +q: Nat, +r: Nat) -> FD.array__Tree<U32>: WD.W64X(r, dd, WD.W64X(r, dd, D, Nat.add(0n, q), w0, w1), Nat.add(2n, q), w2, w3)
def pf_VoluntaryExit(+w0: U32, +w1: U32, +w2: U32, +w3: U32, +dd: Nat, +D: FD.array__Tree<U32>, +q: Nat, +r: Nat, +pf: {FD.array__perfect(U32, dd, D) == True{} : Bool})
    -> {FD.array__perfect(U32, dd, PX_VoluntaryExit(w0, w1, w2, w3, dd, D, q, r)) == True{} : Bool}:
  WD.w64x_perfect(r, dd, WD.W64X(r, dd, D, Nat.add(0n, q), w0, w1), Nat.add(2n, q), w2, w3, WD.w64x_perfect(r, dd, D, Nat.add(0n, q), w0, w1, pf))
def RT_VoluntaryExit(+w0: U32, +w1: U32, +w2: U32, +w3: U32, +dd: Nat, +D: FD.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat) -> Data: {T.VoluntaryExit_put(FD.array__thaw(U32, D), X, T.VoluntaryExit{O.U64{w0, w1}, O.U64{w2, w3}}) == FD.array__thaw(U32, PX_VoluntaryExit(w0, w1, w2, w3, dd, D, q, r)) : Array<U32>}
def BY_VoluntaryExit(+w0: U32, +w1: U32, +w2: U32, +w3: U32, +dd: Nat, +D: FD.array__Tree<U32>, +q: Nat, +r: Nat) -> Data: {UA.BYT(PX_VoluntaryExit(w0, w1, w2, w3, dd, D, q, r)) == UW.SPL(UA.BYT(D), Nat.add(A.quad(q), r), FX.limbs([w0, w1, w2, w3])) : +List<U32>}


def rt_VoluntaryExit(+w0: U32, +w1: U32, +w2: U32, +w3: U32, +dd: Nat, +D: FD.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat,
    +rt0: {T.u64_put(FD.array__thaw(U32, D), U32.add(X, 0), O.U64{w0, w1}) == FD.array__thaw(U32, WD.W64X(r, dd, D, Nat.add(0n, q), w0, w1)) : Array<U32>},
    +rt1: {T.u64_put(FD.array__thaw(U32, WD.W64X(r, dd, D, Nat.add(0n, q), w0, w1)), U32.add(X, 8), O.U64{w2, w3}) == FD.array__thaw(U32, WD.W64X(r, dd, WD.W64X(r, dd, D, Nat.add(0n, q), w0, w1), Nat.add(2n, q), w2, w3)) : Array<U32>})
    -> {T.VoluntaryExit_put(FD.array__thaw(U32, D), X, T.VoluntaryExit{O.U64{w0, w1}, O.U64{w2, w3}}) == FD.array__thaw(U32, PX_VoluntaryExit(w0, w1, w2, w3, dd, D, q, r)) : Array<U32>}:
  %Equal.sym(Array<U32>, T.u64_put(FD.array__thaw(U32, D), U32.add(X, 0), O.U64{w0, w1}), FD.array__thaw(U32, WD.W64X(r, dd, D, Nat.add(0n, q), w0, w1)), rt0) :
    {T.u64_put(_, U32.add(X, 8), O.U64{w2, w3}) == FD.array__thaw(U32, PX_VoluntaryExit(w0, w1, w2, w3, dd, D, q, r)) : Array<U32>}
  %Equal.sym(Array<U32>, T.u64_put(FD.array__thaw(U32, WD.W64X(r, dd, D, Nat.add(0n, q), w0, w1)), U32.add(X, 8), O.U64{w2, w3}), FD.array__thaw(U32, WD.W64X(r, dd, WD.W64X(r, dd, D, Nat.add(0n, q), w0, w1), Nat.add(2n, q), w2, w3)), rt1) :
    {_ == FD.array__thaw(U32, PX_VoluntaryExit(w0, w1, w2, w3, dd, D, q, r)) : Array<U32>}
  {==}

# T.VoluntaryExit_put at X = 4 q + r writes the value's words' limbs into the 16 zero bytes there.
def putx_VoluntaryExit(+w0: U32, +w1: U32, +w2: U32, +w3: U32, +dd: Nat, +D: FD.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat,
    +e: {U32.to_nat(X) == Nat.add(A.quad(q), r) : Nat}, +hr: {Nat.is_lt(r, 4n) == True{} : Bool}, +hd: {Nat.is_lt(dd, 29n) == True{} : Bool},
    +hl: {Nat.is_le(Nat.add(q, WD.NWN(Nat.add(r, 16n))), VB.pw(dd)) == True{} : Bool}, +pf: {FD.array__perfect(U32, dd, D) == True{} : Bool},
    +hz: {VS.bt(16n, VS.bdr(Nat.add(A.quad(q), r), UA.BYT(D))) == UW.ZB(16n) : +List<U32>})
    -> DK.P2(RT_VoluntaryExit(w0, w1, w2, w3, dd, D, X, q, r), BY_VoluntaryExit(w0, w1, w2, w3, dd, D, q, r)):
  +hX = VRX.xstart(q, r, 16n, dd, D, pf, hl)
  +I0 = UW.inv_init(UA.BYT(D), Nat.add(A.quad(q), r), 16n, UW.ZB(16n), hz, {==})
  +ep0 = VRX.fpos(X, q, r, 0n, 0, 16n, dd, e, {==}, hd, {==}, hl)
  +hl0 = VRX.froom(q, r, dd, 0n, 8n, 16n, {==}, hl)
  +z0 = UW.inv_zero(UA.BYT(D), Nat.add(A.quad(q), r), 16n, UW.ZB(16n), 0n, 8n, UA.BYT(D), hX, I0, {==}, {==}, {==})
  +hz0 = FD.logic__subst(Nat, zz => {VS.bt(8n, VS.bdr(zz, UA.BYT(D))) == UW.ZB(8n) : +List<U32>}, Nat.add(Nat.add(A.quad(q), r), 0n), Nat.add(A.quad(Nat.add(0n, q)), r), VRX.fpx(q, r, 0n), z0)
  +rt0 = WD.w64_any(dd, D, U32.add(X, 0), Nat.add(0n, q), r, w0, w1, ep0, hr, hd, hl0, pf)
  +by0 = WD.w64_any_bytes(dd, D, U32.add(X, 0), Nat.add(0n, q), r, w0, w1, ep0, hr, hd, hl0, pf, hz0)
  +hop0 = FD.logic__subst(Nat, zz => {UA.BYT(WD.W64X(r, dd, D, Nat.add(0n, q), w0, w1)) == UW.SPL(UA.BYT(D), zz, FX.limbs([w0, w1])) : +List<U32>}, Nat.add(A.quad(Nat.add(0n, q)), r), Nat.add(Nat.add(A.quad(q), r), 0n), Equal.sym(Nat, Nat.add(Nat.add(A.quad(q), r), 0n), Nat.add(A.quad(Nat.add(0n, q)), r), VRX.fpx(q, r, 0n)), by0)
  +I1 = UW.inv_step(UA.BYT(D), Nat.add(A.quad(q), r), 16n, UW.ZB(16n), 0n, FX.limbs([w0, w1]), 8n, UA.BYT(D), UA.BYT(WD.W64X(r, dd, D, Nat.add(0n, q), w0, w1)), hX, I0, hop0, {==}, {==})
  +ep1 = VRX.fpos(X, q, r, 2n, 8, 16n, dd, e, {==}, hd, {==}, hl)
  +hl1 = VRX.froom(q, r, dd, 2n, 8n, 16n, {==}, hl)
  +z1 = UW.inv_zero(UA.BYT(D), Nat.add(A.quad(q), r), 16n, UW.SPL(UW.ZB(16n), 0n, FX.limbs([w0, w1])), 8n, 8n, UA.BYT(WD.W64X(r, dd, D, Nat.add(0n, q), w0, w1)), hX, I1, {==}, {==}, {==})
  +hz1 = FD.logic__subst(Nat, zz => {VS.bt(8n, VS.bdr(zz, UA.BYT(WD.W64X(r, dd, D, Nat.add(0n, q), w0, w1)))) == UW.ZB(8n) : +List<U32>}, Nat.add(Nat.add(A.quad(q), r), 8n), Nat.add(A.quad(Nat.add(2n, q)), r), VRX.fpx(q, r, 2n), z1)
  +rt1 = WD.w64_any(dd, WD.W64X(r, dd, D, Nat.add(0n, q), w0, w1), U32.add(X, 8), Nat.add(2n, q), r, w2, w3, ep1, hr, hd, hl1, WD.w64x_perfect(r, dd, D, Nat.add(0n, q), w0, w1, pf))
  +by1 = WD.w64_any_bytes(dd, WD.W64X(r, dd, D, Nat.add(0n, q), w0, w1), U32.add(X, 8), Nat.add(2n, q), r, w2, w3, ep1, hr, hd, hl1, WD.w64x_perfect(r, dd, D, Nat.add(0n, q), w0, w1, pf), hz1)
  +hop1 = FD.logic__subst(Nat, zz => {UA.BYT(WD.W64X(r, dd, WD.W64X(r, dd, D, Nat.add(0n, q), w0, w1), Nat.add(2n, q), w2, w3)) == UW.SPL(UA.BYT(WD.W64X(r, dd, D, Nat.add(0n, q), w0, w1)), zz, FX.limbs([w2, w3])) : +List<U32>}, Nat.add(A.quad(Nat.add(2n, q)), r), Nat.add(Nat.add(A.quad(q), r), 8n), Equal.sym(Nat, Nat.add(Nat.add(A.quad(q), r), 8n), Nat.add(A.quad(Nat.add(2n, q)), r), VRX.fpx(q, r, 2n)), by1)
  +I2 = UW.inv_step(UA.BYT(D), Nat.add(A.quad(q), r), 16n, UW.SPL(UW.ZB(16n), 0n, FX.limbs([w0, w1])), 8n, FX.limbs([w2, w3]), 0n, UA.BYT(WD.W64X(r, dd, D, Nat.add(0n, q), w0, w1)), UA.BYT(WD.W64X(r, dd, WD.W64X(r, dd, D, Nat.add(0n, q), w0, w1), Nat.add(2n, q), w2, w3)), hX, I1, hop1, {==}, {==})
  +byf = FD.logic__subst(+List<U32>, zz => {UA.BYT(PX_VoluntaryExit(w0, w1, w2, w3, dd, D, q, r)) == UW.SPL(UA.BYT(D), Nat.add(A.quad(q), r), zz) : +List<U32>}, VS.bt(16n, UW.SPL(UW.SPL(UW.ZB(16n), 0n, FX.limbs([w0, w1])), 8n, FX.limbs([w2, w3]))), FX.limbs([w0, w1, w2, w3]), {==}, I2)
  (rt_VoluntaryExit(w0, w1, w2, w3, dd, D, X, q, r, rt0, rt1), byf)


