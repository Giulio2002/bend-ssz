  +rt0 = V_b4.b4_anyW(dd, D, U32.add(X, 0), Nat.add(0n, q), r, w0, ep0, hr, hd, hl0, pf, hz0)
  +by0 = V_b4.b4_any_bytesW(dd, D, U32.add(X, 0), Nat.add(0n, q), r, w0, ep0, hr, hd, hl0, pf, hz0)
  +hop0 = FD.logic__subst(Nat, zz => {UA.BYT(V_b4.PX_b4(r, dd, D, Nat.add(0n, q), w0)) == UW.SPL(UA.BYT(D), zz, FX.limbs([w0])) : +List<U32>}, Nat.add(A.quad(Nat.add(0n, q)), r), Nat.add(Nat.add(A.quad(q), r), 0n), Equal.sym(Nat, Nat.add(Nat.add(A.quad(q), r), 0n), Nat.add(A.quad(Nat.add(0n, q)), r), VRX.fpx(q, r, 0n)), by0)
