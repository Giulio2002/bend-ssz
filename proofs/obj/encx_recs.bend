# ---- PendingConsolidation: 2 fields, 16 bytes ----
def PX_PendingConsolidation(+w0: U32, +w1: U32, +w2: U32, +w3: U32, +dd: Nat, +D: FD.array__Tree<U32>, +q: Nat, +r: Nat) -> FD.array__Tree<U32>: WD.W64X(r, dd, WD.W64X(r, dd, D, Nat.add(0n, q), w0, w1), Nat.add(2n, q), w2, w3)
def pf_PendingConsolidation(+w0: U32, +w1: U32, +w2: U32, +w3: U32, +dd: Nat, +D: FD.array__Tree<U32>, +q: Nat, +r: Nat, +pf: {FD.array__perfect(U32, dd, D) == True{} : Bool})
    -> {FD.array__perfect(U32, dd, PX_PendingConsolidation(w0, w1, w2, w3, dd, D, q, r)) == True{} : Bool}:
  WD.w64x_perfect(r, dd, WD.W64X(r, dd, D, Nat.add(0n, q), w0, w1), Nat.add(2n, q), w2, w3, WD.w64x_perfect(r, dd, D, Nat.add(0n, q), w0, w1, pf))
def RT_PendingConsolidation(+w0: U32, +w1: U32, +w2: U32, +w3: U32, +dd: Nat, +D: FD.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat) -> Data: {T.PendingConsolidation_put(FD.array__thaw(U32, D), X, T.PendingConsolidation{O.U64{w0, w1}, O.U64{w2, w3}}) == FD.array__thaw(U32, PX_PendingConsolidation(w0, w1, w2, w3, dd, D, q, r)) : Array<U32>}
def BY_PendingConsolidation(+w0: U32, +w1: U32, +w2: U32, +w3: U32, +dd: Nat, +D: FD.array__Tree<U32>, +q: Nat, +r: Nat) -> Data: {UA.BYT(PX_PendingConsolidation(w0, w1, w2, w3, dd, D, q, r)) == UW.SPL(UA.BYT(D), Nat.add(A.quad(q), r), FX.limbs([w0, w1, w2, w3])) : +List<U32>}


def rt_PendingConsolidation(+w0: U32, +w1: U32, +w2: U32, +w3: U32, +dd: Nat, +D: FD.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat,
    +rt0: {T.u64_put(FD.array__thaw(U32, D), U32.add(X, 0), O.U64{w0, w1}) == FD.array__thaw(U32, WD.W64X(r, dd, D, Nat.add(0n, q), w0, w1)) : Array<U32>},
    +rt1: {T.u64_put(FD.array__thaw(U32, WD.W64X(r, dd, D, Nat.add(0n, q), w0, w1)), U32.add(X, 8), O.U64{w2, w3}) == FD.array__thaw(U32, WD.W64X(r, dd, WD.W64X(r, dd, D, Nat.add(0n, q), w0, w1), Nat.add(2n, q), w2, w3)) : Array<U32>})
    -> {T.PendingConsolidation_put(FD.array__thaw(U32, D), X, T.PendingConsolidation{O.U64{w0, w1}, O.U64{w2, w3}}) == FD.array__thaw(U32, PX_PendingConsolidation(w0, w1, w2, w3, dd, D, q, r)) : Array<U32>}:
  %Equal.sym(Array<U32>, T.u64_put(FD.array__thaw(U32, D), U32.add(X, 0), O.U64{w0, w1}), FD.array__thaw(U32, WD.W64X(r, dd, D, Nat.add(0n, q), w0, w1)), rt0) :
    {T.u64_put(_, U32.add(X, 8), O.U64{w2, w3}) == FD.array__thaw(U32, PX_PendingConsolidation(w0, w1, w2, w3, dd, D, q, r)) : Array<U32>}
  %Equal.sym(Array<U32>, T.u64_put(FD.array__thaw(U32, WD.W64X(r, dd, D, Nat.add(0n, q), w0, w1)), U32.add(X, 8), O.U64{w2, w3}), FD.array__thaw(U32, WD.W64X(r, dd, WD.W64X(r, dd, D, Nat.add(0n, q), w0, w1), Nat.add(2n, q), w2, w3)), rt1) :
