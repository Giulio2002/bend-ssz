# ---- VoluntaryExit: 2 fields, 16 bytes ----
def PX_VoluntaryExit(+w0: U32, +w1: U32, +w2: U32, +w3: U32, +dd: Nat, +D: FD.array__Tree<U32>, +q: Nat, +r: Nat) -> FD.array__Tree<U32>: WD.W64X(r, dd, WD.W64X(r, dd, D, Nat.add(0n, q), w0, w1), Nat.add(2n, q), w2, w3)
