  +rt1 = V_b32.b32_any(dd, V_b48.PX_b48(r, dd, D, Nat.add(0n, q), w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11), U32.add(X, 48), Nat.add(12n, q), r, w12, w13, w14, w15, w16, w17, w18, w19, ep1, hr, hd, hl1, V_b48.b48x_perfect(r, dd, D, Nat.add(0n, q), w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11, pf), hz1)
  +by1 = V_b32.b32_any_bytes(dd, V_b48.PX_b48(r, dd, D, Nat.add(0n, q), w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11), U32.add(X, 48), Nat.add(12n, q), r, w12, w13, w14, w15, w16, w17, w18, w19, ep1, hr, hd, hl1, V_b48.b48x_perfect(r, dd, D, Nat.add(0n, q), w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11, pf), hz1)
  +hop1 = FD.logic__subst(Nat, zz => {UA.BYT(V_b32.PX_b32(r, dd, V_b48.PX_b48(r, dd, D, Nat.add(0n, q), w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11), Nat.add(12n, q), w12, w13, w14, w15, w16, w17, w18, w19)) == UW.SPL(UA.BYT(V_b48.PX_b48(r, dd, D, Nat.add(0n, q), w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11)), zz, FX.limbs([w12, w13, w14, w15, w16, w17, w18, w19])) : +List<U32>}, Nat.add(A.quad(Nat.add(12n, q)), r), Nat.add(Nat.add(A.quad(q), r), 48n), Equal.sym(Nat, Nat.add(Nat.add(A.quad(q), r), 48n), Nat.add(A.quad(Nat.add(12n, q)), r), VRX.fpx(q, r, 12n)), by1)
  +I2 = UW.inv_step(UA.BYT(D), Nat.add(A.quad(q), r), 192n, UW.SPL(UW.ZB(192n), 0n, FX.limbs([w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11])), 48n, FX.limbs([w12, w13, w14, w15, w16, w17, w18, w19]), 112n, UA.BYT(V_b48.PX_b48(r, dd, D, Nat.add(0n, q), w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11)), UA.BYT(V_b32.PX_b32(r, dd, V_b48.PX_b48(r, dd, D, Nat.add(0n, q), w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11), Nat.add(12n, q), w12, w13, w14, w15, w16, w17, w18, w19)), hX, I1, hop1, {==}, {==})
