  WD.w64x_perfect(r, dd, V_b48.PX_b48(r, dd, WD.B20X(r, dd, D, Nat.add(0n, q), w0, w1, w2, w3, w4), Nat.add(5n, q), w5, w6, w7, w8, w9, w10, w11, w12, w13, w14, w15, w16), Nat.add(17n, q), w17, w18, V_b48.b48x_perfect(r, dd, WD.B20X(r, dd, D, Nat.add(0n, q), w0, w1, w2, w3, w4), Nat.add(5n, q), w5, w6, w7, w8, w9, w10, w11, w12, w13, w14, w15, w16, WD.b20x_perfect(r, dd, D, Nat.add(0n, q), w0, w1, w2, w3, w4, pf)))
