# ---- HistoricalSummary: 2 fields, 64 bytes ----
def PX_HistoricalSummary(+w0: U32, +w1: U32, +w2: U32, +w3: U32, +w4: U32, +w5: U32, +w6: U32, +w7: U32, +w8: U32, +w9: U32, +w10: U32, +w11: U32, +w12: U32, +w13: U32, +w14: U32, +w15: U32, +dd: Nat, +D: FD.array__Tree<U32>, +q: Nat, +r: Nat) -> FD.array__Tree<U32>: V_b32.PX_b32(r, dd, V_b32.PX_b32(r, dd, D, Nat.add(0n, q), w0, w1, w2, w3, w4, w5, w6, w7), Nat.add(8n, q), w8, w9, w10, w11, w12, w13, w14, w15)
def pf_HistoricalSummary(+w0: U32, +w1: U32, +w2: U32, +w3: U32, +w4: U32, +w5: U32, +w6: U32, +w7: U32, +w8: U32, +w9: U32, +w10: U32, +w11: U32, +w12: U32, +w13: U32, +w14: U32, +w15: U32, +dd: Nat, +D: FD.array__Tree<U32>, +q: Nat, +r: Nat, +pf: {FD.array__perfect(U32, dd, D) == True{} : Bool})
    -> {FD.array__perfect(U32, dd, PX_HistoricalSummary(w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11, w12, w13, w14, w15, dd, D, q, r)) == True{} : Bool}:
  V_b32.b32x_perfect(r, dd, V_b32.PX_b32(r, dd, D, Nat.add(0n, q), w0, w1, w2, w3, w4, w5, w6, w7), Nat.add(8n, q), w8, w9, w10, w11, w12, w13, w14, w15, V_b32.b32x_perfect(r, dd, D, Nat.add(0n, q), w0, w1, w2, w3, w4, w5, w6, w7, pf))
def RT_HistoricalSummary(+w0: U32, +w1: U32, +w2: U32, +w3: U32, +w4: U32, +w5: U32, +w6: U32, +w7: U32, +w8: U32, +w9: U32, +w10: U32, +w11: U32, +w12: U32, +w13: U32, +w14: U32, +w15: U32, +dd: Nat, +D: FD.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat) -> Data: {T.HistoricalSummary_put(FD.array__thaw(U32, D), X, T.HistoricalSummary{T.Bytes32{w0, w1, w2, w3, w4, w5, w6, w7}, T.Bytes32{w8, w9, w10, w11, w12, w13, w14, w15}}) == FD.array__thaw(U32, PX_HistoricalSummary(w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11, w12, w13, w14, w15, dd, D, q, r)) : Array<U32>}
def BY_HistoricalSummary(+w0: U32, +w1: U32, +w2: U32, +w3: U32, +w4: U32, +w5: U32, +w6: U32, +w7: U32, +w8: U32, +w9: U32, +w10: U32, +w11: U32, +w12: U32, +w13: U32, +w14: U32, +w15: U32, +dd: Nat, +D: FD.array__Tree<U32>, +q: Nat, +r: Nat) -> Data: {UA.BYT(PX_HistoricalSummary(w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11, w12, w13, w14, w15, dd, D, q, r)) == UW.SPL(UA.BYT(D), Nat.add(A.quad(q), r), FX.limbs([w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11, w12, w13, w14, w15])) : +List<U32>}


def rt_HistoricalSummary(+w0: U32, +w1: U32, +w2: U32, +w3: U32, +w4: U32, +w5: U32, +w6: U32, +w7: U32, +w8: U32, +w9: U32, +w10: U32, +w11: U32, +w12: U32, +w13: U32, +w14: U32, +w15: U32, +dd: Nat, +D: FD.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat,
    +rt0: {T.b32_put(FD.array__thaw(U32, D), U32.add(X, 0), T.Bytes32{w0, w1, w2, w3, w4, w5, w6, w7}) == FD.array__thaw(U32, V_b32.PX_b32(r, dd, D, Nat.add(0n, q), w0, w1, w2, w3, w4, w5, w6, w7)) : Array<U32>},
    +rt1: {T.b32_put(FD.array__thaw(U32, V_b32.PX_b32(r, dd, D, Nat.add(0n, q), w0, w1, w2, w3, w4, w5, w6, w7)), U32.add(X, 32), T.Bytes32{w8, w9, w10, w11, w12, w13, w14, w15}) == FD.array__thaw(U32, V_b32.PX_b32(r, dd, V_b32.PX_b32(r, dd, D, Nat.add(0n, q), w0, w1, w2, w3, w4, w5, w6, w7), Nat.add(8n, q), w8, w9, w10, w11, w12, w13, w14, w15)) : Array<U32>})
    -> {T.HistoricalSummary_put(FD.array__thaw(U32, D), X, T.HistoricalSummary{T.Bytes32{w0, w1, w2, w3, w4, w5, w6, w7}, T.Bytes32{w8, w9, w10, w11, w12, w13, w14, w15}}) == FD.array__thaw(U32, PX_HistoricalSummary(w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11, w12, w13, w14, w15, dd, D, q, r)) : Array<U32>}:
  %Equal.sym(Array<U32>, T.b32_put(FD.array__thaw(U32, D), U32.add(X, 0), T.Bytes32{w0, w1, w2, w3, w4, w5, w6, w7}), FD.array__thaw(U32, V_b32.PX_b32(r, dd, D, Nat.add(0n, q), w0, w1, w2, w3, w4, w5, w6, w7)), rt0) :
    {T.b32_put(_, U32.add(X, 32), T.Bytes32{w8, w9, w10, w11, w12, w13, w14, w15}) == FD.array__thaw(U32, PX_HistoricalSummary(w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11, w12, w13, w14, w15, dd, D, q, r)) : Array<U32>}
  %Equal.sym(Array<U32>, T.b32_put(FD.array__thaw(U32, V_b32.PX_b32(r, dd, D, Nat.add(0n, q), w0, w1, w2, w3, w4, w5, w6, w7)), U32.add(X, 32), T.Bytes32{w8, w9, w10, w11, w12, w13, w14, w15}), FD.array__thaw(U32, V_b32.PX_b32(r, dd, V_b32.PX_b32(r, dd, D, Nat.add(0n, q), w0, w1, w2, w3, w4, w5, w6, w7), Nat.add(8n, q), w8, w9, w10, w11, w12, w13, w14, w15)), rt1) :
    {_ == FD.array__thaw(U32, PX_HistoricalSummary(w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11, w12, w13, w14, w15, dd, D, q, r)) : Array<U32>}
  {==}

# T.HistoricalSummary_put at X = 4 q + r writes the value's words' limbs into the 64 zero bytes there.
def putx_HistoricalSummary(+w0: U32, +w1: U32, +w2: U32, +w3: U32, +w4: U32, +w5: U32, +w6: U32, +w7: U32, +w8: U32, +w9: U32, +w10: U32, +w11: U32, +w12: U32, +w13: U32, +w14: U32, +w15: U32, +dd: Nat, +D: FD.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat,
    +e: {U32.to_nat(X) == Nat.add(A.quad(q), r) : Nat}, +hr: {Nat.is_lt(r, 4n) == True{} : Bool}, +hd: {Nat.is_lt(dd, 29n) == True{} : Bool},
    +hl: {Nat.is_le(Nat.add(q, WD.NWN(Nat.add(r, 64n))), VB.pw(dd)) == True{} : Bool}, +pf: {FD.array__perfect(U32, dd, D) == True{} : Bool},
    +hz: {VS.bt(64n, VS.bdr(Nat.add(A.quad(q), r), UA.BYT(D))) == UW.ZB(64n) : +List<U32>})
    -> DK.P2(RT_HistoricalSummary(w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11, w12, w13, w14, w15, dd, D, X, q, r), BY_HistoricalSummary(w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11, w12, w13, w14, w15, dd, D, q, r)):
  +hX = VRX.xstart(q, r, 64n, dd, D, pf, hl)
  +I0 = UW.inv_init(UA.BYT(D), Nat.add(A.quad(q), r), 64n, UW.ZB(64n), hz, {==})
  +ep0 = VRX.fpos(X, q, r, 0n, 0, 64n, dd, e, {==}, hd, {==}, hl)
  +hl0 = VRX.froom(q, r, dd, 0n, 32n, 64n, {==}, hl)
  +z0 = UW.inv_zero(UA.BYT(D), Nat.add(A.quad(q), r), 64n, UW.ZB(64n), 0n, 32n, UA.BYT(D), hX, I0, {==}, {==}, {==})
  +hz0 = FD.logic__subst(Nat, zz => {VS.bt(32n, VS.bdr(zz, UA.BYT(D))) == UW.ZB(32n) : +List<U32>}, Nat.add(Nat.add(A.quad(q), r), 0n), Nat.add(A.quad(Nat.add(0n, q)), r), VRX.fpx(q, r, 0n), z0)
  +rt0 = V_b32.b32_any(dd, D, U32.add(X, 0), Nat.add(0n, q), r, w0, w1, w2, w3, w4, w5, w6, w7, ep0, hr, hd, hl0, pf, hz0)
  +by0 = V_b32.b32_any_bytes(dd, D, U32.add(X, 0), Nat.add(0n, q), r, w0, w1, w2, w3, w4, w5, w6, w7, ep0, hr, hd, hl0, pf, hz0)
  +hop0 = FD.logic__subst(Nat, zz => {UA.BYT(V_b32.PX_b32(r, dd, D, Nat.add(0n, q), w0, w1, w2, w3, w4, w5, w6, w7)) == UW.SPL(UA.BYT(D), zz, FX.limbs([w0, w1, w2, w3, w4, w5, w6, w7])) : +List<U32>}, Nat.add(A.quad(Nat.add(0n, q)), r), Nat.add(Nat.add(A.quad(q), r), 0n), Equal.sym(Nat, Nat.add(Nat.add(A.quad(q), r), 0n), Nat.add(A.quad(Nat.add(0n, q)), r), VRX.fpx(q, r, 0n)), by0)
  +I1 = UW.inv_step(UA.BYT(D), Nat.add(A.quad(q), r), 64n, UW.ZB(64n), 0n, FX.limbs([w0, w1, w2, w3, w4, w5, w6, w7]), 32n, UA.BYT(D), UA.BYT(V_b32.PX_b32(r, dd, D, Nat.add(0n, q), w0, w1, w2, w3, w4, w5, w6, w7)), hX, I0, hop0, {==}, {==})
  +ep1 = VRX.fpos(X, q, r, 8n, 32, 64n, dd, e, {==}, hd, {==}, hl)
  +hl1 = VRX.froom(q, r, dd, 8n, 32n, 64n, {==}, hl)
  +z1 = UW.inv_zero(UA.BYT(D), Nat.add(A.quad(q), r), 64n, UW.SPL(UW.ZB(64n), 0n, FX.limbs([w0, w1, w2, w3, w4, w5, w6, w7])), 32n, 32n, UA.BYT(V_b32.PX_b32(r, dd, D, Nat.add(0n, q), w0, w1, w2, w3, w4, w5, w6, w7)), hX, I1, {==}, {==}, {==})
  +hz1 = FD.logic__subst(Nat, zz => {VS.bt(32n, VS.bdr(zz, UA.BYT(V_b32.PX_b32(r, dd, D, Nat.add(0n, q), w0, w1, w2, w3, w4, w5, w6, w7)))) == UW.ZB(32n) : +List<U32>}, Nat.add(Nat.add(A.quad(q), r), 32n), Nat.add(A.quad(Nat.add(8n, q)), r), VRX.fpx(q, r, 8n), z1)
  +rt1 = V_b32.b32_any(dd, V_b32.PX_b32(r, dd, D, Nat.add(0n, q), w0, w1, w2, w3, w4, w5, w6, w7), U32.add(X, 32), Nat.add(8n, q), r, w8, w9, w10, w11, w12, w13, w14, w15, ep1, hr, hd, hl1, V_b32.b32x_perfect(r, dd, D, Nat.add(0n, q), w0, w1, w2, w3, w4, w5, w6, w7, pf), hz1)
  +by1 = V_b32.b32_any_bytes(dd, V_b32.PX_b32(r, dd, D, Nat.add(0n, q), w0, w1, w2, w3, w4, w5, w6, w7), U32.add(X, 32), Nat.add(8n, q), r, w8, w9, w10, w11, w12, w13, w14, w15, ep1, hr, hd, hl1, V_b32.b32x_perfect(r, dd, D, Nat.add(0n, q), w0, w1, w2, w3, w4, w5, w6, w7, pf), hz1)
  +hop1 = FD.logic__subst(Nat, zz => {UA.BYT(V_b32.PX_b32(r, dd, V_b32.PX_b32(r, dd, D, Nat.add(0n, q), w0, w1, w2, w3, w4, w5, w6, w7), Nat.add(8n, q), w8, w9, w10, w11, w12, w13, w14, w15)) == UW.SPL(UA.BYT(V_b32.PX_b32(r, dd, D, Nat.add(0n, q), w0, w1, w2, w3, w4, w5, w6, w7)), zz, FX.limbs([w8, w9, w10, w11, w12, w13, w14, w15])) : +List<U32>}, Nat.add(A.quad(Nat.add(8n, q)), r), Nat.add(Nat.add(A.quad(q), r), 32n), Equal.sym(Nat, Nat.add(Nat.add(A.quad(q), r), 32n), Nat.add(A.quad(Nat.add(8n, q)), r), VRX.fpx(q, r, 8n)), by1)
  +I2 = UW.inv_step(UA.BYT(D), Nat.add(A.quad(q), r), 64n, UW.SPL(UW.ZB(64n), 0n, FX.limbs([w0, w1, w2, w3, w4, w5, w6, w7])), 32n, FX.limbs([w8, w9, w10, w11, w12, w13, w14, w15]), 0n, UA.BYT(V_b32.PX_b32(r, dd, D, Nat.add(0n, q), w0, w1, w2, w3, w4, w5, w6, w7)), UA.BYT(V_b32.PX_b32(r, dd, V_b32.PX_b32(r, dd, D, Nat.add(0n, q), w0, w1, w2, w3, w4, w5, w6, w7), Nat.add(8n, q), w8, w9, w10, w11, w12, w13, w14, w15)), hX, I1, hop1, {==}, {==})
  +byf = FD.logic__subst(+List<U32>, zz => {UA.BYT(PX_HistoricalSummary(w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11, w12, w13, w14, w15, dd, D, q, r)) == UW.SPL(UA.BYT(D), Nat.add(A.quad(q), r), zz) : +List<U32>}, VS.bt(64n, UW.SPL(UW.SPL(UW.ZB(64n), 0n, FX.limbs([w0, w1, w2, w3, w4, w5, w6, w7])), 32n, FX.limbs([w8, w9, w10, w11, w12, w13, w14, w15]))), FX.limbs([w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11, w12, w13, w14, w15]), {==}, I2)
  (rt_HistoricalSummary(w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11, w12, w13, w14, w15, dd, D, X, q, r, rt0, rt1), byf)


