# ---- Fork: 3 fields, 16 bytes ----
def PX_Fork(+w0: U32, +w1: U32, +w2: U32, +w3: U32, +dd: Nat, +D: FD.array__Tree<U32>, +q: Nat, +r: Nat) -> FD.array__Tree<U32>: WD.W64X(r, dd, V_b4.PX_b4(r, dd, V_b4.PX_b4(r, dd, D, Nat.add(0n, q), w0), Nat.add(1n, q), w1), Nat.add(2n, q), w2, w3)
def pf_Fork(+w0: U32, +w1: U32, +w2: U32, +w3: U32, +dd: Nat, +D: FD.array__Tree<U32>, +q: Nat, +r: Nat, +pf: {FD.array__perfect(U32, dd, D) == True{} : Bool})
    -> {FD.array__perfect(U32, dd, PX_Fork(w0, w1, w2, w3, dd, D, q, r)) == True{} : Bool}:
  WD.w64x_perfect(r, dd, V_b4.PX_b4(r, dd, V_b4.PX_b4(r, dd, D, Nat.add(0n, q), w0), Nat.add(1n, q), w1), Nat.add(2n, q), w2, w3, V_b4.b4x_perfect(r, dd, V_b4.PX_b4(r, dd, D, Nat.add(0n, q), w0), Nat.add(1n, q), w1, V_b4.b4x_perfect(r, dd, D, Nat.add(0n, q), w0, pf)))
def RT_Fork(+w0: U32, +w1: U32, +w2: U32, +w3: U32, +dd: Nat, +D: FD.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat) -> Data: {T.Fork_put(FD.array__thaw(U32, D), X, T.Fork{T.Bytes4{w0}, T.Bytes4{w1}, O.U64{w2, w3}}) == FD.array__thaw(U32, PX_Fork(w0, w1, w2, w3, dd, D, q, r)) : Array<U32>}
def BY_Fork(+w0: U32, +w1: U32, +w2: U32, +w3: U32, +dd: Nat, +D: FD.array__Tree<U32>, +q: Nat, +r: Nat) -> Data: {UA.BYT(PX_Fork(w0, w1, w2, w3, dd, D, q, r)) == UW.SPL(UA.BYT(D), Nat.add(A.quad(q), r), FX.limbs([w0, w1, w2, w3])) : +List<U32>}


def rt_Fork(+w0: U32, +w1: U32, +w2: U32, +w3: U32, +dd: Nat, +D: FD.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat,
    +rt0: {T.b4_put(FD.array__thaw(U32, D), U32.add(X, 0), T.Bytes4{w0}) == FD.array__thaw(U32, V_b4.PX_b4(r, dd, D, Nat.add(0n, q), w0)) : Array<U32>},
    +rt1: {T.b4_put(FD.array__thaw(U32, V_b4.PX_b4(r, dd, D, Nat.add(0n, q), w0)), U32.add(X, 4), T.Bytes4{w1}) == FD.array__thaw(U32, V_b4.PX_b4(r, dd, V_b4.PX_b4(r, dd, D, Nat.add(0n, q), w0), Nat.add(1n, q), w1)) : Array<U32>},
    +rt2: {T.u64_put(FD.array__thaw(U32, V_b4.PX_b4(r, dd, V_b4.PX_b4(r, dd, D, Nat.add(0n, q), w0), Nat.add(1n, q), w1)), U32.add(X, 8), O.U64{w2, w3}) == FD.array__thaw(U32, WD.W64X(r, dd, V_b4.PX_b4(r, dd, V_b4.PX_b4(r, dd, D, Nat.add(0n, q), w0), Nat.add(1n, q), w1), Nat.add(2n, q), w2, w3)) : Array<U32>})
    -> {T.Fork_put(FD.array__thaw(U32, D), X, T.Fork{T.Bytes4{w0}, T.Bytes4{w1}, O.U64{w2, w3}}) == FD.array__thaw(U32, PX_Fork(w0, w1, w2, w3, dd, D, q, r)) : Array<U32>}:
  %Equal.sym(Array<U32>, T.b4_put(FD.array__thaw(U32, D), U32.add(X, 0), T.Bytes4{w0}), FD.array__thaw(U32, V_b4.PX_b4(r, dd, D, Nat.add(0n, q), w0)), rt0) :
    {T.u64_put(T.b4_put(_, U32.add(X, 4), T.Bytes4{w1}), U32.add(X, 8), O.U64{w2, w3}) == FD.array__thaw(U32, PX_Fork(w0, w1, w2, w3, dd, D, q, r)) : Array<U32>}
  %Equal.sym(Array<U32>, T.b4_put(FD.array__thaw(U32, V_b4.PX_b4(r, dd, D, Nat.add(0n, q), w0)), U32.add(X, 4), T.Bytes4{w1}), FD.array__thaw(U32, V_b4.PX_b4(r, dd, V_b4.PX_b4(r, dd, D, Nat.add(0n, q), w0), Nat.add(1n, q), w1)), rt1) :
    {T.u64_put(_, U32.add(X, 8), O.U64{w2, w3}) == FD.array__thaw(U32, PX_Fork(w0, w1, w2, w3, dd, D, q, r)) : Array<U32>}
  %Equal.sym(Array<U32>, T.u64_put(FD.array__thaw(U32, V_b4.PX_b4(r, dd, V_b4.PX_b4(r, dd, D, Nat.add(0n, q), w0), Nat.add(1n, q), w1)), U32.add(X, 8), O.U64{w2, w3}), FD.array__thaw(U32, WD.W64X(r, dd, V_b4.PX_b4(r, dd, V_b4.PX_b4(r, dd, D, Nat.add(0n, q), w0), Nat.add(1n, q), w1), Nat.add(2n, q), w2, w3)), rt2) :
    {_ == FD.array__thaw(U32, PX_Fork(w0, w1, w2, w3, dd, D, q, r)) : Array<U32>}
  {==}

# T.Fork_put at X = 4 q + r writes the value's words' limbs into the 16 zero bytes there.
def putx_Fork(+w0: U32, +w1: U32, +w2: U32, +w3: U32, +dd: Nat, +D: FD.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat,
    +e: {U32.to_nat(X) == Nat.add(A.quad(q), r) : Nat}, +hr: {Nat.is_lt(r, 4n) == True{} : Bool}, +hd: {Nat.is_lt(dd, 29n) == True{} : Bool},
    +hl: {Nat.is_le(Nat.add(q, WD.NWN(Nat.add(r, 16n))), VB.pw(dd)) == True{} : Bool}, +pf: {FD.array__perfect(U32, dd, D) == True{} : Bool},
    +hz: {VS.bt(16n, VS.bdr(Nat.add(A.quad(q), r), UA.BYT(D))) == UW.ZB(16n) : +List<U32>})
    -> DK.P2(RT_Fork(w0, w1, w2, w3, dd, D, X, q, r), BY_Fork(w0, w1, w2, w3, dd, D, q, r)):
  +hX = VRX.xstart(q, r, 16n, dd, D, pf, hl)
  +I0 = UW.inv_init(UA.BYT(D), Nat.add(A.quad(q), r), 16n, UW.ZB(16n), hz, {==})
  +ep0 = VRX.fpos(X, q, r, 0n, 0, 16n, dd, e, {==}, hd, {==}, hl)
  +hl0 = VRX.froom(q, r, dd, 0n, 4n, 16n, {==}, hl)
  +z0 = UW.inv_zero(UA.BYT(D), Nat.add(A.quad(q), r), 16n, UW.ZB(16n), 0n, 4n, UA.BYT(D), hX, I0, {==}, {==}, {==})
  +hz0 = FD.logic__subst(Nat, zz => {VS.bt(4n, VS.bdr(zz, UA.BYT(D))) == UW.ZB(4n) : +List<U32>}, Nat.add(Nat.add(A.quad(q), r), 0n), Nat.add(A.quad(Nat.add(0n, q)), r), VRX.fpx(q, r, 0n), z0)
  +rt0 = V_b4.b4_any(dd, D, U32.add(X, 0), Nat.add(0n, q), r, w0, ep0, hr, hd, hl0, pf, hz0)
  +by0 = V_b4.b4_any_bytes(dd, D, U32.add(X, 0), Nat.add(0n, q), r, w0, ep0, hr, hd, hl0, pf, hz0)
  +hop0 = FD.logic__subst(Nat, zz => {UA.BYT(V_b4.PX_b4(r, dd, D, Nat.add(0n, q), w0)) == UW.SPL(UA.BYT(D), zz, FX.limbs([w0])) : +List<U32>}, Nat.add(A.quad(Nat.add(0n, q)), r), Nat.add(Nat.add(A.quad(q), r), 0n), Equal.sym(Nat, Nat.add(Nat.add(A.quad(q), r), 0n), Nat.add(A.quad(Nat.add(0n, q)), r), VRX.fpx(q, r, 0n)), by0)
  +I1 = UW.inv_step(UA.BYT(D), Nat.add(A.quad(q), r), 16n, UW.ZB(16n), 0n, FX.limbs([w0]), 12n, UA.BYT(D), UA.BYT(V_b4.PX_b4(r, dd, D, Nat.add(0n, q), w0)), hX, I0, hop0, {==}, {==})
  +ep1 = VRX.fpos(X, q, r, 1n, 4, 16n, dd, e, {==}, hd, {==}, hl)
  +hl1 = VRX.froom(q, r, dd, 1n, 4n, 16n, {==}, hl)
  +z1 = UW.inv_zero(UA.BYT(D), Nat.add(A.quad(q), r), 16n, UW.SPL(UW.ZB(16n), 0n, FX.limbs([w0])), 4n, 4n, UA.BYT(V_b4.PX_b4(r, dd, D, Nat.add(0n, q), w0)), hX, I1, {==}, {==}, {==})
