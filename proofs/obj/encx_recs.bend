  +z2 = UW.inv_zero(UA.BYT(D), Nat.add(A.quad(q), r), 16n, UW.SPL(UW.SPL(UW.ZB(16n), 0n, FX.limbs([w0])), 4n, FX.limbs([w1])), 8n, 8n, UA.BYT(V_b4.PX_b4(r, dd, V_b4.PX_b4(r, dd, D, Nat.add(0n, q), w0), Nat.add(1n, q), w1)), hX, I2, {==}, {==}, {==})
  +hz2 = FD.logic__subst(Nat, zz => {VS.bt(8n, VS.bdr(zz, UA.BYT(V_b4.PX_b4(r, dd, V_b4.PX_b4(r, dd, D, Nat.add(0n, q), w0), Nat.add(1n, q), w1)))) == UW.ZB(8n) : +List<U32>}, Nat.add(Nat.add(A.quad(q), r), 8n), Nat.add(A.quad(Nat.add(2n, q)), r), VRX.fpx(q, r, 2n), z2)
  +rt2 = WD.w64_anyW(dd, V_b4.PX_b4(r, dd, V_b4.PX_b4(r, dd, D, Nat.add(0n, q), w0), Nat.add(1n, q), w1), U32.add(X, 8), Nat.add(2n, q), r, w2, w3, ep2, hr, hd, hl2, V_b4.b4x_perfect(r, dd, V_b4.PX_b4(r, dd, D, Nat.add(0n, q), w0), Nat.add(1n, q), w1, V_b4.b4x_perfect(r, dd, D, Nat.add(0n, q), w0, pf)))
  +by2 = WD.w64_any_bytesW(dd, V_b4.PX_b4(r, dd, V_b4.PX_b4(r, dd, D, Nat.add(0n, q), w0), Nat.add(1n, q), w1), U32.add(X, 8), Nat.add(2n, q), r, w2, w3, ep2, hr, hd, hl2, V_b4.b4x_perfect(r, dd, V_b4.PX_b4(r, dd, D, Nat.add(0n, q), w0), Nat.add(1n, q), w1, V_b4.b4x_perfect(r, dd, D, Nat.add(0n, q), w0, pf)), hz2)
  +hop2 = FD.logic__subst(Nat, zz => {UA.BYT(WD.W64X(r, dd, V_b4.PX_b4(r, dd, V_b4.PX_b4(r, dd, D, Nat.add(0n, q), w0), Nat.add(1n, q), w1), Nat.add(2n, q), w2, w3)) == UW.SPL(UA.BYT(V_b4.PX_b4(r, dd, V_b4.PX_b4(r, dd, D, Nat.add(0n, q), w0), Nat.add(1n, q), w1)), zz, FX.limbs([w2, w3])) : +List<U32>}, Nat.add(A.quad(Nat.add(2n, q)), r), Nat.add(Nat.add(A.quad(q), r), 8n), Equal.sym(Nat, Nat.add(Nat.add(A.quad(q), r), 8n), Nat.add(A.quad(Nat.add(2n, q)), r), VRX.fpx(q, r, 2n)), by2)
  +I3 = UW.inv_step(UA.BYT(D), Nat.add(A.quad(q), r), 16n, UW.SPL(UW.SPL(UW.ZB(16n), 0n, FX.limbs([w0])), 4n, FX.limbs([w1])), 8n, FX.limbs([w2, w3]), 0n, UA.BYT(V_b4.PX_b4(r, dd, V_b4.PX_b4(r, dd, D, Nat.add(0n, q), w0), Nat.add(1n, q), w1)), UA.BYT(WD.W64X(r, dd, V_b4.PX_b4(r, dd, V_b4.PX_b4(r, dd, D, Nat.add(0n, q), w0), Nat.add(1n, q), w1), Nat.add(2n, q), w2, w3)), hX, I2, hop2, {==}, {==})
