              %Equal.sym(Nat, Codec.count(PB.it2(c, rest)), c, pc2(c, rest, V.and_right(U32.is_lt(x1, 256), SP.byte_scope(Nat.double(c), rest), k1))) : {1n+_ == 1n+c : Nat}
              {==}

law hcount:
  for +k: Nat
  for +W: List<&2, U32>
  for +i: Nat
  {Codec.count(WR.items(k, W, i)) == k : Nat}
def hcount(k, W, i):
  match k:
    case 0n: {==}
    case 1n+ +q:
      %Equal.sym(Nat, Codec.count(WR.items(q, W, 1n+i)), q, hcount(q, W, 1n+i)) : {1n+_ == 1n+q : Nat}
      {==}

def cnth(o: O.Words) -> Nat: U32.to_nat(U32.shrn(WO.len(o), 5n))

def len1(-o: O.Words, +t: F.array__Tree<U32>, +N: U32, +L: Nat, +eo: {o == O.Words{F.array__thaw(U32, t), N} : O.Words},
    +hv: {Nat.is_le(U32.to_nat(WO.len(o)), L) == True{} : Bool}) -> {Nat.is_le(U32.to_nat(N), L) == True{} : Bool}:
  %Equal.cong(O.Words, U32, WO.len, o, O.Words{F.array__thaw(U32, t), N}, eo) : {Nat.is_le(U32.to_nat(_), L) == True{} : Bool}
  hv

def LO_len2(-o: O.Words, +t: F.array__Tree<U32>, +N: U32, +L: Nat, +eo: {o == O.Words{F.array__thaw(U32, t), N} : O.Words},
    +hv: {Nat.is_le(PB.cnt2(o), L) == True{} : Bool}) -> {Nat.is_le(U32.to_nat(U32.shrn(N, 1n)), L) == True{} : Bool}:
  %Equal.cong(O.Words, U32, WO.len, o, O.Words{F.array__thaw(U32, t), N}, eo) : {Nat.is_le(U32.to_nat(U32.shrn(_, 1n)), L) == True{} : Bool}
  hv

def lenh(-o: O.Words, +t: F.array__Tree<U32>, +N: U32, +L: Nat, +eo: {o == O.Words{F.array__thaw(U32, t), N} : O.Words},
    +hv: {Nat.is_le(cnth(o), L) == True{} : Bool}) -> {Nat.is_le(U32.to_nat(U32.shrn(N, 5n)), L) == True{} : Bool}:
  %Equal.cong(O.Words, U32, WO.len, o, O.Words{F.array__thaw(U32, t), N}, eo) : {Nat.is_le(U32.to_nat(U32.shrn(_, 5n)), L) == True{} : Bool}
  hv

# ---- List[Bytes32] --------------------------------------------------

def hview(o: O.Words) -> S.Value:
  match o:
    case O.Words{ws, +n}: S.Sequence{WR.items(U32.to_nat(U32.shrn(n, 5n)), F.array__slots(U32, F.array__freeze(U32, ws)), 0n)}

# The object represents a value of the list schema s: byte storage of whole
# 32-byte elements, at most the limit of them.
def rep_lh(o: O.Words, +s: S.Schema) -> Data:
  DK.P2(LO.wfl(o), DK.P2({U32.to_nat(WO.len(o)) == WS.e32(cnth(o)) : Nat}, {Nat.is_le(cnth(o), SH.ListOf_limit(s)) == True{} : Bool}))
def rep_wfh(-o: O.Words, +s: S.Schema, +rep: rep_lh(o, s)) -> LO.wfl(o):
  (+wf, +r1) = rep
  wf

# The schema is a list of Bytes32 whose limit has minimal depth `depth`.
def ok_lh(+s: S.Schema, +depth: Nat) -> Bool: Bool.and(SH.is_ListOf(s), Bool.and(SH.is_ByteVector(SH.ListOf_element(s)), Bool.and(Nat.is_eq(SH.ByteVector_length(SH.ListOf_element(s)), 32n), Lim.minimal(SH.ListOf_limit(s), depth))))

def eq_nh(-o: O.Words, +t: F.array__Tree<U32>, +N: U32, +eo: {o == O.Words{F.array__thaw(U32, t), N} : O.Words},
    +eN: {U32.to_nat(WO.len(o)) == WS.e32(cnth(o)) : Nat}) -> {U32.to_nat(N) == WS.e32(U32.to_nat(U32.shrn(N, 5n))) : Nat}:
  %Equal.cong(O.Words, U32, WO.len, o, O.Words{F.array__thaw(U32, t), N}, eo) : {U32.to_nat(_) == WS.e32(U32.to_nat(U32.shrn(_, 5n))) : Nat}
  eN

def chq(+N: U32, +eNN: {U32.to_nat(N) == WS.e32(U32.to_nat(U32.shrn(N, 5n))) : Nat}) -> {O.chunks_of(N) == U32.to_nat(U32.shrn(N, 5n)) : Nat}:
  %Equal.sym(Nat, U32.to_nat(N), WS.e32(U32.to_nat(U32.shrn(N, 5n))), eNN) : {Nat.div(Nat.add(_, 31n), 32n) == U32.to_nat(U32.shrn(N, 5n)) : Nat}
  hdiv(U32.to_nat(U32.shrn(N, 5n)))

def lh_core(+hl: Nat, +ehl: {hl == 64n : Nat}, +t: F.array__Tree<U32>, +N: U32, +L: Nat, +depth: Nat,
