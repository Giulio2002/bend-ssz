    -> {vec_uint32_16_e.v16_u32_put(F.array__thaw(U32, D), pos, O.Words{F.array__thaw(U32, S), 64}) == vec_uint32_16_e.v16_u32_pw(False{}, F.array__thaw(U32, D), pos, F.array__thaw(U32, S), 64) : Array<U32> & O.Words}:
  +ec = vec_uint32_16_acg(U32.shrn(pos, 2n), Q, ds, dd, S, D, eq, hs, hdd, hA, hB, ps, pd)
