  %Equal.sym(Array<U32> & O.Words, O.put_words(F.array__thaw(U32, D), pos, O.Words{F.array__thaw(U32, S), 64}), O.put_fin(64, (F.array__thaw(U32, AC.cpt(dd, 16n, 0n, Q, D, F.array__slots(U32, S))), F.array__thaw(U32, S))), pa) :
    {vec_uint32_16_e.v16_u32_put(F.array__thaw(U32, D), pos, O.Words{F.array__thaw(U32, S), 64}) == _ : Array<U32> & O.Words}
  %Equal.sym(U32, U32.and(pos, 3), 0, e3) :
    {vec_uint32_16_e.v16_u32_pw(U32.is_eq(_, 0), F.array__thaw(U32, D), pos, F.array__thaw(U32, S), 64) == O.put_fin(64, (F.array__thaw(U32, AC.cpt(dd, 16n, 0n, Q, D, F.array__slots(U32, S))), F.array__thaw(U32, S))) : Array<U32> & O.Words}
