# ---- the interface's laws ----------------------------------------------------------------------

law putx:
  for +m: MW
  for +dd: Nat
  for +D: FD.array__Tree<U32>
  for +X: U32
  for +q: Nat
  for +r: Nat
  for +e: {U32.to_nat(X) == Nat.add(A.quad(q), r) : Nat}
  for +hr: {Nat.is_lt(r, 4n) == True{} : Bool}
  for +hd: {Nat.is_lt(dd, 29n) == True{} : Bool}
  for +pf: {FD.array__perfect(U32, dd, D) == True{} : Bool}
  for +hl: {Nat.is_le(Nat.add(q, WD.NWN(Nat.add(r, List.length(&2, U32, ENC(m))))), VB.pw(dd)) == True{} : Bool}
  for +hz: {VS.bt(Nat.add(List.length(&2, U32, ENC(m)), PADB(r, m)), VS.bdr(Nat.add(A.quad(q), r), UA.BYT(D))) == UW.ZB(Nat.add(List.length(&2, U32, ENC(m)), PADB(r, m))) : +List<U32>}
  for +hok: {OK(m) == True{} : Bool}
  {T.Gp4B0CA2906A_putk(FD.array__thaw(U32, D), X, TH(m)) == (FD.array__thaw(U32, PUTX(m, dd, D, q, r)), (TH(m), SZ(m))) : Array<U32> & (T.Gp4B0CA2906A & U32)}
def putx(m, dd, D, X, q, r, e, hr, hd, pf, hl, hz, hok):
  match m:
    case MW{+m_f_C}: PA(RTX(m_f_C, dd, D, X, q, r), BYX(m_f_C, dd, D, q, r), go(m_f_C, hok, dd, D, X, q, r, e, hr, hd, pf, hl, hz))

law putx_bytes:
  for +m: MW
  for +dd: Nat
  for +D: FD.array__Tree<U32>
  for +X: U32
  for +q: Nat
  for +r: Nat
  for +e: {U32.to_nat(X) == Nat.add(A.quad(q), r) : Nat}
  for +hr: {Nat.is_lt(r, 4n) == True{} : Bool}
  for +hd: {Nat.is_lt(dd, 29n) == True{} : Bool}
  for +pf: {FD.array__perfect(U32, dd, D) == True{} : Bool}
  for +hl: {Nat.is_le(Nat.add(q, WD.NWN(Nat.add(r, List.length(&2, U32, ENC(m))))), VB.pw(dd)) == True{} : Bool}
  for +hz: {VS.bt(Nat.add(List.length(&2, U32, ENC(m)), PADB(r, m)), VS.bdr(Nat.add(A.quad(q), r), UA.BYT(D))) == UW.ZB(Nat.add(List.length(&2, U32, ENC(m)), PADB(r, m))) : +List<U32>}
  for +hok: {OK(m) == True{} : Bool}
  {UA.BYT(PUTX(m, dd, D, q, r)) == UW.SPL(UA.BYT(D), Nat.add(A.quad(q), r), List.append(&2, U32, ENC(m), UW.ZB(PADB(r, m)))) : +List<U32>}
def putx_bytes(m, dd, D, X, q, r, e, hr, hd, pf, hl, hz, hok):
  match m:
    case MW{+m_f_C}: PB(RTX(m_f_C, dd, D, X, q, r), BYX(m_f_C, dd, D, q, r), go(m_f_C, hok, dd, D, X, q, r, e, hr, hd, pf, hl, hz))

law szx:
  for +m: MW
  for +hok: {OK(m) == True{} : Bool}
  {U32.to_nat(SZ(m)) == List.length(&2, U32, ENC(m)) : Nat}
def szx(m, hok):
  match m:
    case MW{+m_f_C}: Equal.trans(Nat, U32.to_nat(K.SZC(m_f_C)), ENDC(m_f_C), List.length(&2, U32, K.ENCC(m_f_C)), szC(m_f_C, hok, 28n, {==}), Equal.sym(Nat, List.length(&2, U32, K.ENCC(m_f_C)), ENDC(m_f_C), lenE(m_f_C, hok)))

law encx_spec:
  for +m: MW
  for +hok: {OK(m) == True{} : Bool}
  {Codec.parts(VAL(m), Spec.Gp4B0CA2906A()) == Some{[S.Variable{ENC(m)}]} : Maybe<&2, +List<S.Part>>}
def encx_spec(m, hok):
  match m:
    case MW{+m_f_C}: specC(m_f_C, hok, 28n, {==})

law domx:
  for +m: MW
  for +hok: {OK(m) == True{} : Bool}
  {SP.bytes_domain(ENC(m)) == True{} : Bool}
def domx(m, hok):
  match m:
    case MW{+m_f_C}: CS.domv(VALC(m_f_C), Spec.Gp4B0CA2906A(), K.ENCC(m_f_C), {==}, specC(m_f_C, hok, 28n, {==}))

law pfx:
  for +m: MW
  for +dd: Nat
  for +D: FD.array__Tree<U32>
  for +q: Nat
  for +r: Nat
  for +pf: {FD.array__perfect(U32, dd, D) == True{} : Bool}
  {FD.array__perfect(U32, dd, PUTX(m, dd, D, q, r)) == True{} : Bool}
def pfx(m, dd, D, q, r, pf):
  match m:
    case MW{+m_f_C}: K.pfC(m_f_C, dd, D, XQ(q, r), q, r, pf)

def sizeC(+m_f_C: EX_pbits.MB, +h: {OKT(m_f_C) == True{} : Bool}) -> {T.Gp4B0CA2906A_size(K.OBJC(m_f_C)) == (K.OBJC(m_f_C), K.SZC(m_f_C)) : T.Gp4B0CA2906A & U32}:
  %Equal.sym(O.Bits & U32, T.pbits_size(EX_pbits.TH(m_f_C)), (EX_pbits.TH(m_f_C), EX_pbits.SZ(m_f_C)), EX_pbits.sizex(m_f_C, ok_hok_f_C(m_f_C, h))) :
    {T.Gp4B0CA2906A_sz0(4, _) == (K.OBJC(m_f_C), K.SZC(m_f_C)) : T.Gp4B0CA2906A & U32}
  {==}

law sizex:
  for +m: MW
  for +hok: {OK(m) == True{} : Bool}
  {T.Gp4B0CA2906A_size(TH(m)) == (TH(m), SZ(m)) : T.Gp4B0CA2906A & U32}
def sizex(m, hok):
  match m:
    case MW{+m_f_C}: sizeC(m_f_C, hok)

def rvalidC(+m_f_C: EX_pbits.MB, +h: {OKT(m_f_C) == True{} : Bool}) -> {T.Gp4B0CA2906A_valid(K.OBJC(m_f_C)) == (K.OBJC(m_f_C), True{}) : T.Gp4B0CA2906A & Bool}:
  %Equal.sym(O.Bits & Bool, T.pbits_valid(EX_pbits.TH(m_f_C)), (EX_pbits.TH(m_f_C), True{}), EX_pbits.validx(m_f_C, ok_hok_f_C(m_f_C, h))) :
    {T.Gp4B0CA2906A_va0(True{}, _) == (K.OBJC(m_f_C), True{}) : T.Gp4B0CA2906A & Bool}
  {==}

law validx:
  for +m: MW
  for +hok: {OK(m) == True{} : Bool}
  {T.Gp4B0CA2906A_valid(TH(m)) == (TH(m), True{}) : T.Gp4B0CA2906A & Bool}
def validx(m, hok):
  match m:
    case MW{+m_f_C}: rvalidC(m_f_C, hok)
