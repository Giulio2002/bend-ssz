    {ComplexTestStruct_e.ComplexTestStruct_va0(f_A, f_C, EX_bl256.TH(m_f_D), EX_VarTestStruct.TH(m_f_E), RV_v4_FixedTestStruct.TH(m_f_F), EX_v2_VarTestStruct.TH(m_f_G), _, list_uint16_128_e.l128_u16_valid(EX_l128_u16.TH(m_f_B))) == (K.OBJC(f_A, m_f_B, f_C, m_f_D, m_f_E, m_f_F, m_f_G), True{}) : ComplexTestStruct_d.ComplexTestStruct & Bool}
