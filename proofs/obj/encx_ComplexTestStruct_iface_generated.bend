# ==== ComplexTestStruct in the encoder-window interface ====

type MW is Data:
  MW{f_A: U32, m_f_B: EX_l128_u16.MW, f_C: U32, m_f_D: EX_bl256.MW, m_f_E: EX_VarTestStruct.MW, m_f_F: RV_v4_FixedTestStruct.MW, m_f_G: EX_v2_VarTestStruct.MW}

def TH(m: MW) -> ComplexTestStruct_d.ComplexTestStruct:
  match m:
    case MW{+f_A, +m_f_B, +f_C, +m_f_D, +m_f_E, +m_f_F, +m_f_G}: K.OBJC(f_A, m_f_B, f_C, m_f_D, m_f_E, m_f_F, m_f_G)
def OK(m: MW) -> Bool:
  match m:
    case MW{+f_A, +m_f_B, +f_C, +m_f_D, +m_f_E, +m_f_F, +m_f_G}: OKT(f_A, m_f_B, f_C, m_f_D, m_f_E, m_f_F, m_f_G)
def OKW(m: MW) -> Bool:
  match m:
    case MW{+f_A, +m_f_B, +f_C, +m_f_D, +m_f_E, +m_f_F, +m_f_G}: OKTW(f_A, m_f_B, f_C, m_f_D, m_f_E, m_f_F, m_f_G)
def ENC(m: MW) -> +List<U32>:
  match m:
    case MW{+f_A, +m_f_B, +f_C, +m_f_D, +m_f_E, +m_f_F, +m_f_G}: K.ENCC(f_A, m_f_B, f_C, m_f_D, m_f_E, m_f_F, m_f_G)
def VAL(m: MW) -> S.Value:
  match m:
    case MW{+f_A, +m_f_B, +f_C, +m_f_D, +m_f_E, +m_f_F, +m_f_G}: VALC(f_A, m_f_B, f_C, m_f_D, m_f_E, m_f_F, m_f_G)
def SZ(m: MW) -> U32:
  match m:
    case MW{+f_A, +m_f_B, +f_C, +m_f_D, +m_f_E, +m_f_F, +m_f_G}: K.SZC(f_A, m_f_B, f_C, m_f_D, m_f_E, m_f_F, m_f_G)
def XQ(+q: Nat, +r: Nat) -> U32: U32.from_nat(Nat.add(A.quad(q), r))
def PUTX(m: MW, +dd: Nat, +D: FD.array__Tree<U32>, +q: Nat, +r: Nat) -> FD.array__Tree<U32>:
  match m:
    case MW{+f_A, +m_f_B, +f_C, +m_f_D, +m_f_E, +m_f_F, +m_f_G}: K.PUTC(f_A, m_f_B, f_C, m_f_D, m_f_E, m_f_F, m_f_G, dd, D, XQ(q, r), q, r)
def PADB(+r: Nat, m: MW) -> Nat: WD.PADB(r, List.length(&2, U32, ENC(m)))

