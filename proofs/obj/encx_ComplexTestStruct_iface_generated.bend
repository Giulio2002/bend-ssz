  %Equal.sym(vec_FixedTestStruct_4_d.v4_FixedTestStruct_Seq & Bool, vec_FixedTestStruct_4_e.v4_FixedTestStruct_valid(RV_v4_FixedTestStruct.TH(m_f_F)), (RV_v4_FixedTestStruct.TH(m_f_F), True{}), RV_v4_FixedTestStruct.validx(m_f_F, ok_hok_f_F(f_A, m_f_B, f_C, m_f_D, m_f_E, m_f_F, m_f_G, h))) :
