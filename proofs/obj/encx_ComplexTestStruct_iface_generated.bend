  %Equal.sym(VarTestStruct_d.VarTestStruct & Bool, VarTestStruct_e.VarTestStruct_valid(EX_VarTestStruct.TH(m_f_E)), (EX_VarTestStruct.TH(m_f_E), True{}), EX_VarTestStruct.validx(m_f_E, ok_hok_f_E(f_A, m_f_B, f_C, m_f_D, m_f_E, m_f_F, m_f_G, h))) :
