  +FP = LY.HDRW(PSC(f_A, m_f_B, f_C, m_f_D, m_f_E, m_f_F, m_f_G), OSC(f_A, m_f_B, f_C, m_f_D, m_f_E, m_f_F, m_f_G))
  +PAY = Layout.payloads(PSC(f_A, m_f_B, f_C, m_f_D, m_f_E, m_f_F, m_f_G))
  +hf = LY.hdr_fp(PSC(f_A, m_f_B, f_C, m_f_D, m_f_E, m_f_F, m_f_G), 71n, OSC(f_A, m_f_B, f_C, m_f_D, m_f_E, m_f_F, m_f_G), okoC(f_A, m_f_B, f_C, m_f_D, m_f_E, m_f_F, m_f_G, h, k, ek))
  +fit = CS.fitc(71n, PAY, ENDC(f_A, m_f_B, f_C, m_f_D, m_f_E, m_f_F, m_f_G), k, ek, LY.lay_end(PSC(f_A, m_f_B, f_C, m_f_D, m_f_E, m_f_F, m_f_G), 71n), okbk(f_A, m_f_B, f_C, m_f_D, m_f_E, m_f_F, m_f_G, h, k, ek))
  +e1 = LY.enc_genL(PSC(f_A, m_f_B, f_C, m_f_D, m_f_E, m_f_F, m_f_G), 71n, FP, PAY, {==}, hf, {==}, validC(f_A, m_f_B, f_C, m_f_D, m_f_E, m_f_F, m_f_G, h, k, ek), fit)
