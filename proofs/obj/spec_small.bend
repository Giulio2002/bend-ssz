    case U32{WCon{a0, WCon{a1, WCon{a2, WCon{a3, WCon{a4, WCon{a5, WCon{a6, WCon{a7, WCon{a8, WCon{a9, WCon{a10, WCon{a11, WCon{a12, WCon{a13, WCon{a14, WCon{a15, WCon{a16, WCon{a17, WCon{a18, WCon{a19, WCon{a20, WCon{a21, WCon{a22, WCon{a23, WCon{a24, WCon{a25, WCon{a26, WCon{a27, WCon{a28, WCon{a29, WCon{a30, WCon{a31, WNil{}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}:
      FD.logic__subst(U32, x => Decoding.decodes(Spec.Bytes1(), [x], S.BytesValue{[x]}), U32{WCon{a0, WCon{a1, WCon{a2, WCon{a3, WCon{a4, WCon{a5, WCon{a6, WCon{a7, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WNil{}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}, B.byte_sel(0, U32{WCon{a0, WCon{a1, WCon{a2, WCon{a3, WCon{a4, WCon{a5, WCon{a6, WCon{a7, WCon{a8, WCon{a9, WCon{a10, WCon{a11, WCon{a12, WCon{a13, WCon{a14, WCon{a15, WCon{a16, WCon{a17, WCon{a18, WCon{a19, WCon{a20, WCon{a21, WCon{a22, WCon{a23, WCon{a24, WCon{a25, WCon{a26, WCon{a27, WCon{a28, WCon{a29, WCon{a30, WCon{a31, WNil{}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}),
        Equal.sym(U32, B.byte_sel(0, U32{WCon{a0, WCon{a1, WCon{a2, WCon{a3, WCon{a4, WCon{a5, WCon{a6, WCon{a7, WCon{a8, WCon{a9, WCon{a10, WCon{a11, WCon{a12, WCon{a13, WCon{a14, WCon{a15, WCon{a16, WCon{a17, WCon{a18, WCon{a19, WCon{a20, WCon{a21, WCon{a22, WCon{a23, WCon{a24, WCon{a25, WCon{a26, WCon{a27, WCon{a28, WCon{a29, WCon{a30, WCon{a31, WNil{}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}), U32{WCon{a0, WCon{a1, WCon{a2, WCon{a3, WCon{a4, WCon{a5, WCon{a6, WCon{a7, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WNil{}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}, BT.sel0(a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15, a16, a17, a18, a19, a20, a21, a22, a23, a24, a25, a26, a27, a28, a29, a30, a31)),
        Bytes1_spec_encode(a0, a1, a2, a3, a4, a5, a6, a7))

# ---- boolean (1 byte) ----
def boolean_true_spec_bytes()
    -> {B.emit(boolean_e.boolean_encode(True{}), 0, 1) == (boolean_e.boolean_encode(True{}), [1]) : B.Buf & +List<U32>}:
  {==}
def boolean_true_spec_encode()
    -> Decoding.decodes(Spec.boolean(), [1], S.BooleanValue{True{}}):
  {==}
def boolean_false_spec_bytes()
    -> {B.emit(boolean_e.boolean_encode(False{}), 0, 1) == (boolean_e.boolean_encode(False{}), [0]) : B.Buf & +List<U32>}:
  {==}
def boolean_false_spec_encode()
    -> Decoding.decodes(Spec.boolean(), [0], S.BooleanValue{False{}}):
  {==}

def boolean_spec_view(+w: U32)
    -> {B.emit(B.Buf{ALeaf{w}, 1}, 0, 1) == (B.Buf{ALeaf{w}, 1}, [B.byte_sel(0, w)]) : B.Buf & +List<U32>}:
  {==}
def boolean_spec_decode_0(+w: U32, +h: {B.byte_sel(0, w) == 0 : U32})
    -> {boolean_r.boolean_decode(B.Buf{ALeaf{w}, 1}, 1) == (B.Buf{ALeaf{w}, 1}, Some{False{}}) : B.Buf & Maybe<&1, Bool>}:
  %Equal.sym(U32, B.byte_sel(0, w), 0, h) : {boolean_r.boolean_built(1, (B.Buf{ALeaf{w}, 1}, U32.is_le(_, 1))) == (B.Buf{ALeaf{w}, 1}, Some{False{}}) : B.Buf & Maybe<&1, Bool>}
  %Equal.sym(U32, B.byte_sel(0, w), 0, h) : {(B.Buf{ALeaf{w}, 1}, Some{U32.is_eq(_, 1)}) == (B.Buf{ALeaf{w}, 1}, Some{False{}}) : B.Buf & Maybe<&1, Bool>}
  {==}
def boolean_spec_decode_1(+w: U32, +h: {B.byte_sel(0, w) == 1 : U32})
    -> {boolean_r.boolean_decode(B.Buf{ALeaf{w}, 1}, 1) == (B.Buf{ALeaf{w}, 1}, Some{True{}}) : B.Buf & Maybe<&1, Bool>}:
  %Equal.sym(U32, B.byte_sel(0, w), 1, h) : {boolean_r.boolean_built(1, (B.Buf{ALeaf{w}, 1}, U32.is_le(_, 1))) == (B.Buf{ALeaf{w}, 1}, Some{True{}}) : B.Buf & Maybe<&1, Bool>}
  %Equal.sym(U32, B.byte_sel(0, w), 1, h) : {(B.Buf{ALeaf{w}, 1}, Some{U32.is_eq(_, 1)}) == (B.Buf{ALeaf{w}, 1}, Some{True{}}) : B.Buf & Maybe<&1, Bool>}
  {==}
def boolean_spec_decode_reject(+w: U32, +h: {U32.is_le(B.byte_sel(0, w), 1) == False{} : Bool})
    -> {boolean_r.boolean_decode(B.Buf{ALeaf{w}, 1}, 1) == (B.Buf{ALeaf{w}, 1}, None{}) : B.Buf & Maybe<&1, Bool>}:
  %Equal.sym(Bool, U32.is_le(B.byte_sel(0, w), 1), False{}, h) : {boolean_r.boolean_built(1, (B.Buf{ALeaf{w}, 1}, _)) == (B.Buf{ALeaf{w}, 1}, None{}) : B.Buf & Maybe<&1, Bool>}
  {==}

# Rejection is exactly the complement of the spec image: a byte above 1 is
# the encoding of no value (spec/codec.bend encodes booleans as [0] or [1]).
def head_or(m: Maybe<&2, +List<U32>>, +d: U32) -> U32:
  match m:
    case Some{Con{x, t}}: x
    case _: d
def is_some2(m: Maybe<&2, +List<U32>>) -> Bool:
  match m:
    case None{}: False{}
    case Some{x}: True{}
def not_image(+c: U32, +h: {U32.is_le(c, 1) == False{} : Bool}, +k: U32, +hk: {U32.is_le(k, 1) == True{} : Bool},
    e: {Some{[k]} == Some{[c]} : Maybe<&2, +List<U32>>}) -> Empty:
  WF.false_true(Equal.trans(Bool, False{}, U32.is_le(c, 1), True{}, Equal.sym(Bool, U32.is_le(c, 1), False{}, h),
    %Equal.cong(Maybe<&2, +List<U32>>, U32, m => head_or(m, k), Some{[k]}, Some{[c]}, e) : {U32.is_le(_, 1) == True{} : Bool}
    hk))
def none_image(+c: U32, e: {None{} == Some{[c]} : Maybe<&2, +List<U32>>}) -> Empty:
  WF.false_true(Equal.cong(Maybe<&2, +List<U32>>, Bool, m => is_some2(m), None{}, Some{[c]}, e))
def boolean_outside_v(+c: U32, +h: {U32.is_le(c, 1) == False{} : Bool}, +v: S.Value, e: Decoding.decodes(Spec.boolean(), [c], v)) -> Empty:
  match v:
    case S.BooleanValue{+bv}:
      match bv:
        case True{}: not_image(c, h, 1, {==}, e)
        case False{}: not_image(c, h, 0, {==}, e)
    case S.UnsignedValue{u}: none_image(c, e)
    case S.BytesValue{xs}: none_image(c, e)
    case S.BitsValue{bs}: none_image(c, e)
    case S.Sequence{it}: none_image(c, e)
    case S.Items{hd, tl}: none_image(c, e)
    case S.EmptyItems{}: none_image(c, e)
    case S.Selected{sel, sv}: none_image(c, e)
    case S.NullValue{}: none_image(c, e)
def boolean_outside(+c: U32, +h: {U32.is_le(c, 1) == False{} : Bool}) -> Decoding.outside_image(Spec.boolean(), [c]):
  v => e => boolean_outside_v(c, h, v, e)
def boolean_spec_reject_outside(+w: U32, +h: {U32.is_le(B.byte_sel(0, w), 1) == False{} : Bool})
    -> Decoding.outside_image(Spec.boolean(), [B.byte_sel(0, w)]):
  boolean_outside(B.byte_sel(0, w), h)

# ---- every other size is refused ----
def uint8_spec_reject(buf: B.Buf, +m: U32, e: {U32.is_eq(m, 1) == False{} : Bool})
    -> {uint8_r.uint8_decode(buf, m) == (buf, None{}) : B.Buf & Maybe<&1, U32>}:
  %Equal.sym(Bool, U32.is_eq(m, 1), False{}, e) : {uint8_r.uint8_built(m, uint8_r.u8_ok_len(_, buf, 0)) == (buf, None{}) : B.Buf & Maybe<&1, U32>}
  {==}
def ParticipationFlags_spec_reject(buf: B.Buf, +m: U32, e: {U32.is_eq(m, 1) == False{} : Bool})
    -> {FuluParticipationFlags_r.ParticipationFlags_decode(buf, m) == (buf, None{}) : B.Buf & Maybe<&1, U32>}:
  %Equal.sym(Bool, U32.is_eq(m, 1), False{}, e) : {FuluParticipationFlags_r.ParticipationFlags_built(m, uint8_r.u8_ok_len(_, buf, 0)) == (buf, None{}) : B.Buf & Maybe<&1, U32>}
  {==}
def Bytes1_spec_reject(buf: B.Buf, +m: U32, e: {U32.is_eq(m, 1) == False{} : Bool})
    -> {FuluBytes1_r.Bytes1_decode(buf, m) == (buf, None{}) : B.Buf & Maybe<&1, FuluBytes1_d.Bytes1>}:
  %Equal.sym(Bool, U32.is_eq(m, 1), False{}, e) : {FuluBytes1_r.Bytes1_built(m, FuluBytes1_r.b1_ok_len(_, buf, 0)) == (buf, None{}) : B.Buf & Maybe<&1, FuluBytes1_d.Bytes1>}
  {==}
def boolean_spec_reject(buf: B.Buf, +m: U32, e: {U32.is_eq(m, 1) == False{} : Bool})
    -> {boolean_r.boolean_decode(buf, m) == (buf, None{}) : B.Buf & Maybe<&1, Bool>}:
  %Equal.sym(Bool, U32.is_eq(m, 1), False{}, e) : {boolean_r.boolean_built(m, boolean_r.bool_ok_len(_, buf, 0)) == (buf, None{}) : B.Buf & Maybe<&1, Bool>}
  {==}
