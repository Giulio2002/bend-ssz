# ---- box of AttesterSlashing ----
def pjb_AttesterSlashing_bx(o: O.Boxed<FuluAttesterSlashing_d.AttesterSlashing>) -> FuluAttesterSlashing_d.AttesterSlashing:
  match o:
    case O.BSome{v, rest}: v
    case O.BNone{}: FuluAttesterSlashing_d.AttesterSlashing_default()
def v_AttesterSlashing_bx(o: O.Boxed<FuluAttesterSlashing_d.AttesterSlashing>) -> S.Value:
  match o:
    case O.BSome{v, rest}: v_AttesterSlashing(v)
    case O.BNone{}: S.NullValue{}
def d_AttesterSlashing_bx(+hl: Nat, o: O.Boxed<FuluAttesterSlashing_d.AttesterSlashing>) -> D.Digest:
  match o:
    case O.BSome{v, rest}: d_AttesterSlashing(hl, v)
    case O.BNone{}: D.zero()
def rep_AttesterSlashing_bx(o: O.Boxed<FuluAttesterSlashing_d.AttesterSlashing>, +s: S.Schema) -> Data:
  DK.P2({o == O.BSome{pjb_AttesterSlashing_bx(o), O.BNone{}} : O.Boxed<FuluAttesterSlashing_d.AttesterSlashing>}, rep_AttesterSlashing(pjb_AttesterSlashing_bx(o), s))
def st_AttesterSlashing_bx(+hl: Nat, -h: B.Buf, -o: O.Boxed<FuluAttesterSlashing_d.AttesterSlashing>, +seg: U32, +s: S.Schema, +rep: rep_AttesterSlashing_bx(o, s))
    -> {FuluAttesterSlashing_h.AttesterSlashing_bx_root(hl, h, o, seg) == (h, (o, d_AttesterSlashing_bx(hl, o))) : B.Buf & (O.Boxed<FuluAttesterSlashing_d.AttesterSlashing> & D.Digest)}:
  (+eo, +ri) = rep
  %Equal.sym(O.Boxed<FuluAttesterSlashing_d.AttesterSlashing>, o, O.BSome{pjb_AttesterSlashing_bx(o), O.BNone{}}, eo) :
    {FuluAttesterSlashing_h.AttesterSlashing_bx_root(hl, h, _, seg) == (h, (_, d_AttesterSlashing_bx(hl, _))) : B.Buf & (O.Boxed<FuluAttesterSlashing_d.AttesterSlashing> & D.Digest)}
  %Equal.sym(B.Buf & (FuluAttesterSlashing_d.AttesterSlashing & D.Digest), FuluAttesterSlashing_h.AttesterSlashing_root(hl, h, pjb_AttesterSlashing_bx(o), seg), (h, (pjb_AttesterSlashing_bx(o), d_AttesterSlashing(hl, pjb_AttesterSlashing_bx(o)))), st_AttesterSlashing(hl, h, pjb_AttesterSlashing_bx(o), seg, s, ri)) :
    {FuluAttesterSlashing_h.AttesterSlashing_bx_rt(_) == (h, (O.BSome{pjb_AttesterSlashing_bx(o), O.BNone{}}, d_AttesterSlashing_bx(hl, O.BSome{pjb_AttesterSlashing_bx(o), O.BNone{}}))) : B.Buf & (O.Boxed<FuluAttesterSlashing_d.AttesterSlashing> & D.Digest)}
  {==}
def rs_AttesterSlashing_bx(+hl: Nat, +ehl: {hl == 64n : Nat}, -h: B.Buf, -o: O.Boxed<FuluAttesterSlashing_d.AttesterSlashing>, +s: S.Schema, +rep: rep_AttesterSlashing_bx(o, s), +dv: OS.DV, +edv: {dv == OS.DV0() : OS.DV}, +ok: {ok_AttesterSlashing(s, dv) == True{} : Bool}, +eq: eqs_AttesterSlashing(s))
    -> RR.roots(v_AttesterSlashing_bx(o), s, [D.bytes(d_AttesterSlashing_bx(hl, o))]):
  (+eo, +ri) = rep
  %Equal.sym(O.Boxed<FuluAttesterSlashing_d.AttesterSlashing>, o, O.BSome{pjb_AttesterSlashing_bx(o), O.BNone{}}, eo) : RR.roots(v_AttesterSlashing_bx(_), s, [D.bytes(d_AttesterSlashing_bx(hl, _))])
  rs_AttesterSlashing(hl, ehl, h, pjb_AttesterSlashing_bx(o), s, ri, dv, edv, ok, eq)
def wd_AttesterSlashing_bx(+hl: Nat, -o: O.Boxed<FuluAttesterSlashing_d.AttesterSlashing>, +s: S.Schema, +rep: rep_AttesterSlashing_bx(o, s)) -> OS.DW(d_AttesterSlashing_bx(hl, o)):
  (+eo, +ri) = rep
  %Equal.sym(O.Boxed<FuluAttesterSlashing_d.AttesterSlashing>, o, O.BSome{pjb_AttesterSlashing_bx(o), O.BNone{}}, eo) : OS.DW(d_AttesterSlashing_bx(hl, _))
  wd_AttesterSlashing(hl, pjb_AttesterSlashing_bx(o), s, ri)
def ok_AttesterSlashing_bx(+s: S.Schema, +dv: OS.DV) -> Bool: ok_AttesterSlashing(s, dv)
def eqs_AttesterSlashing_bx(+s: S.Schema) -> Data: eqs_AttesterSlashing(s)

# ---- Data mirror of IndexedAttestation ----
type M_IndexedAttestation is Data:
  M_IndexedAttestation{a0: WMr, a1: FuluAttestationData_d.AttestationData, a2: FuluBytes96_d.Bytes96}
def th_IndexedAttestation(m: M_IndexedAttestation) -> FuluIndexedAttestation_d.IndexedAttestation:
  match m:
    case M_IndexedAttestation{+a0, +a1, +a2}: FuluIndexedAttestation_d.IndexedAttestation{th_w(a0), a1, a2}
def fz_IndexedAttestation(x: FuluIndexedAttestation_d.IndexedAttestation) -> M_IndexedAttestation:
  match x:
    case FuluIndexedAttestation_d.IndexedAttestation{x0, +x1, +x2}: M_IndexedAttestation{fz_w(x0), x1, x2}
def fzth_IndexedAttestation(+m: M_IndexedAttestation) -> {fz_IndexedAttestation(th_IndexedAttestation(m)) == m : M_IndexedAttestation}:
  match m:
    case M_IndexedAttestation{+a0, +a1, +a2}:
      %Equal.sym(WMr, fz_w(th_w(a0)), a0, fzth_w(a0)) :
        {M_IndexedAttestation{_, a1, a2} == M_IndexedAttestation{a0, a1, a2} : M_IndexedAttestation}
      {==}

def mfz_IndexedAttestation_bx(x: O.Boxed<FuluIndexedAttestation_d.IndexedAttestation>) -> M_IndexedAttestation:
  match x:
    case O.BSome{v, rest}: fz_IndexedAttestation(v)
