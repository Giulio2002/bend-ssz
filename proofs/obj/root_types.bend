    (D.bytes(MD.rtree(4n, Nat.is_lt(0n, MD.dlen(xl_l16_ProposerSlashing(U32.to_nat(N), F.array__slots(MB<M_ProposerSlashing>, t), 0n, hl))), hl, xl_l16_ProposerSlashing(U32.to_nat(N), F.array__slots(MB<M_ProposerSlashing>, t), 0n, hl), 0n)), ((4n, (kmin, RS.at_depth_tree(SH.ListOf_limit(s), 4n, hl, xl_l16_ProposerSlashing(U32.to_nat(N), F.array__slots(MB<M_ProposerSlashing>, t), 0n, hl), {==}, xhl_l16_ProposerSlashing(N, SH.ListOf_limit(s), F.array__slots(MB<M_ProposerSlashing>, t), hl, hvN), ehl))),
