def v_SyncAggregate_bx(o: O.Boxed<FuluSyncAggregate_d.SyncAggregate>) -> S.Value:
  match o:
    case O.BSome{+v, rest}: RN_L.v_SyncAggregate(v)
    case O.BNone{}: S.NullValue{}
def d_SyncAggregate_bx(+hl: Nat, o: O.Boxed<FuluSyncAggregate_d.SyncAggregate>) -> D.Digest:
  match o:
    case O.BSome{+v, rest}: RN.d_SyncAggregate(hl, v)
    case O.BNone{}: D.zero()
