# ---- box of Attestation ----
def pjb_Attestation_bx(o: O.Boxed<FuluAttestation_d.Attestation>) -> FuluAttestation_d.Attestation:
  match o:
    case O.BSome{v, rest}: v
    case O.BNone{}: FuluAttestation_d.Attestation_default()
def v_Attestation_bx(o: O.Boxed<FuluAttestation_d.Attestation>) -> S.Value:
  match o:
    case O.BSome{v, rest}: v_Attestation(v)
    case O.BNone{}: S.NullValue{}
def d_Attestation_bx(+hl: Nat, o: O.Boxed<FuluAttestation_d.Attestation>) -> D.Digest:
  match o:
    case O.BSome{v, rest}: d_Attestation(hl, v)
    case O.BNone{}: D.zero()
def rep_Attestation_bx(o: O.Boxed<FuluAttestation_d.Attestation>, +s: S.Schema) -> Data:
  DK.P2({o == O.BSome{pjb_Attestation_bx(o), O.BNone{}} : O.Boxed<FuluAttestation_d.Attestation>}, rep_Attestation(pjb_Attestation_bx(o), s))
def st_Attestation_bx(+hl: Nat, -h: B.Buf, -o: O.Boxed<FuluAttestation_d.Attestation>, +seg: U32, +s: S.Schema, +rep: rep_Attestation_bx(o, s))
    -> {FuluAttestation_h.Attestation_bx_root(hl, h, o, seg) == (h, (o, d_Attestation_bx(hl, o))) : B.Buf & (O.Boxed<FuluAttestation_d.Attestation> & D.Digest)}:
  (+eo, +ri) = rep
  %Equal.sym(O.Boxed<FuluAttestation_d.Attestation>, o, O.BSome{pjb_Attestation_bx(o), O.BNone{}}, eo) :
    {FuluAttestation_h.Attestation_bx_root(hl, h, _, seg) == (h, (_, d_Attestation_bx(hl, _))) : B.Buf & (O.Boxed<FuluAttestation_d.Attestation> & D.Digest)}
  %Equal.sym(B.Buf & (FuluAttestation_d.Attestation & D.Digest), FuluAttestation_h.Attestation_root(hl, h, pjb_Attestation_bx(o), seg), (h, (pjb_Attestation_bx(o), d_Attestation(hl, pjb_Attestation_bx(o)))), st_Attestation(hl, h, pjb_Attestation_bx(o), seg, s, ri)) :
    {FuluAttestation_h.Attestation_bx_rt(_) == (h, (O.BSome{pjb_Attestation_bx(o), O.BNone{}}, d_Attestation_bx(hl, O.BSome{pjb_Attestation_bx(o), O.BNone{}}))) : B.Buf & (O.Boxed<FuluAttestation_d.Attestation> & D.Digest)}
  {==}
def rs_Attestation_bx(+hl: Nat, +ehl: {hl == 64n : Nat}, -h: B.Buf, -o: O.Boxed<FuluAttestation_d.Attestation>, +s: S.Schema, +rep: rep_Attestation_bx(o, s), +dv: OS.DV, +edv: {dv == OS.DV0() : OS.DV}, +ok: {ok_Attestation(s, dv) == True{} : Bool}, +eq: eqs_Attestation(s))
    -> RR.roots(v_Attestation_bx(o), s, [D.bytes(d_Attestation_bx(hl, o))]):
  (+eo, +ri) = rep
  %Equal.sym(O.Boxed<FuluAttestation_d.Attestation>, o, O.BSome{pjb_Attestation_bx(o), O.BNone{}}, eo) : RR.roots(v_Attestation_bx(_), s, [D.bytes(d_Attestation_bx(hl, _))])
  rs_Attestation(hl, ehl, h, pjb_Attestation_bx(o), s, ri, dv, edv, ok, eq)
