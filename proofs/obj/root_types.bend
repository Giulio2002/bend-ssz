    RR.roots(v_SyncCommittee(FuluSyncCommittee_d.SyncCommittee{pj_SyncCommittee_0(o), x1}), S.Container{SH.Container_names(s), S.Chain{SH.Chain_head(SH.Container_fields(s)), S.Chain{SH.Chain_head(SH.Chain_tail(SH.Container_fields(s))), S.End{}}}}, [D.bytes(MD.rtree(1n, True{}, hl, [_, RN.d_b48(hl, x1)], 0n))])
  (MD.bytes_list([dd0, RN.d_b48(hl, x1)]), (([D.bytes(dd0)], (MD.bytes_list([RN.d_b48(hl, x1)]), (OS.dtrans(E48.eview(pj_SyncCommittee_0(o)), SH.Chain_head(SH.Container_fields(s)), dd0, E48.edig(hl, pj_SyncCommittee_0(o), 9n), de0, E48.ev_rs(hl, ehl, h, pj_SyncCommittee_0(o), SH.Chain_head(SH.Container_fields(s)), 9n, 9, 0, q1, r4, {==}, {==})), (([D.bytes(RN.d_b48(hl, x1))], (MD.bytes_list([]), (OS.transport(RN_L.v_b48(x1), SH.Chain_head(SH.Chain_tail(SH.Container_fields(s))), S.ByteVector{48n}, [D.bytes(RN.d_b48(hl, x1))], ev, RN.rs_b48(hl, ehl, x1)), ({==}, {==})))), {==})))),
