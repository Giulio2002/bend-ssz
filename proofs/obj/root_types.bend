    +pf: {F.array__perfect(LV.MB<LV.M_Attestation>, dw, t) == True{} : Bool}, +hn: {Nat.is_le(n, F.spec_common__pow2(dw)) == True{} : Bool},
    +sE: S.Schema, +er: LV.ereps_l8_Attestation(n, F.array__slots(LV.MB<LV.M_Attestation>, t), 0n, sE))
