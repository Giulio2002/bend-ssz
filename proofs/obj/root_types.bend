    {(h, (Fulu_list_Deposit_16_d.l16_Deposit_Seq{am_l16_Deposit(t), N}, O.mix_len(hl, MD.rtree(4n, Nat.is_lt(0n, U32.to_nat(N)), hl, xl_l16_Deposit(U32.to_nat(N), F.array__slots(MB<M_Deposit>, t), 0n, hl), 0n), N))) == (h, (Fulu_list_Deposit_16_d.l16_Deposit_Seq{am_l16_Deposit(t), N}, O.mix_len(hl, MD.rtree(4n, Nat.is_lt(0n, U32.to_nat(N)), hl, xl_l16_Deposit(U32.to_nat(N), F.array__slots(MB<M_Deposit>, _), 0n, hl), 0n), N))) : B.Buf & (Fulu_list_Deposit_16_d.l16_Deposit_Seq & D.Digest)}
