    RR.roots(S.Sequence{xi_l16_ProposerSlashing(U32.to_nat(N), F.array__slots(MB<M_ProposerSlashing>, t), 0n)}, S.ListOf{SH.ListOf_element(s), SH.ListOf_limit(s)}, [D.bytes(O.mix_len(hl, MD.rtree(4n, Nat.is_lt(0n, _), hl, xl_l16_ProposerSlashing(U32.to_nat(N), F.array__slots(MB<M_ProposerSlashing>, t), 0n, hl), 0n), N))])
