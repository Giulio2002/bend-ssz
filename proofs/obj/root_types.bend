def xat_l16_ProposerSlashing(W: List<&2, MB<M_ProposerSlashing>>, +i: Nat) -> MB<M_ProposerSlashing>:
  match W:
    case Nil{}: MNone{}
    case Con{+x, t}:
      match i:
        case 0n: x
        case 1n+j: xat_l16_ProposerSlashing(t, j)
law nth_l16_ProposerSlashing:
  for +W: List<&2, MB<M_ProposerSlashing>>
  for +i: Nat
  for +hi: {Nat.is_lt(i, F.spec_common__length(MB<M_ProposerSlashing>, W)) == True{} : Bool}
  {F.spec_common__nth(MB<M_ProposerSlashing>, W, i) == Some{xat_l16_ProposerSlashing(W, i)} : Maybe<&2, MB<M_ProposerSlashing>>}
def nth_l16_ProposerSlashing(W, i, hi):
  match W:
    case Nil{}: Empty.absurd({F.spec_common__nth(MB<M_ProposerSlashing>, Nil{}, i) == Some{xat_l16_ProposerSlashing(Nil{}, i)} : Maybe<&2, MB<M_ProposerSlashing>>}, MD.false_true(Equal.trans(Bool, False{}, Nat.is_lt(i, 0n), True{}, Equal.sym(Bool, Nat.is_lt(i, 0n), False{}, F.nat__not_lt_zero(i)), hi)))
    case Con{+x, +t}:
      match i:
        case 0n: {==}
        case 1n+ +j: nth_l16_ProposerSlashing(t, j, hi)
def xl_l16_ProposerSlashing(k: Nat, +W: List<&2, MB<M_ProposerSlashing>>, +i: Nat, +hl: Nat) -> List<&2, D.Digest>:
  match k:
    case 0n: []
    case 1n+q: d_ProposerSlashing_bx(hl, th_ProposerSlashing_bx(xat_l16_ProposerSlashing(W, i))) <> xl_l16_ProposerSlashing(q, W, 1n+i, hl)
law xlen_l16_ProposerSlashing:
  for +k: Nat
  for +W: List<&2, MB<M_ProposerSlashing>>
  for +i: Nat
  for +hl: Nat
  {MD.dlen(xl_l16_ProposerSlashing(k, W, i, hl)) == k : Nat}
def xlen_l16_ProposerSlashing(k, W, i, hl):
  match k:
    case 0n: {==}
    case 1n+ +q:
      %xlen_l16_ProposerSlashing(q, W, 1n+i, hl) : {1n+MD.dlen(xl_l16_ProposerSlashing(q, W, 1n+i, hl)) == 1n+_ : Nat}
      {==}
law xat_at_l16_ProposerSlashing:
  for +s: Nat
  for +k: Nat
  for +W: List<&2, MB<M_ProposerSlashing>>
  for +i: Nat
  for +hl: Nat
  for +e: {Nat.is_lt(s, k) == True{} : Bool}
  {MD.dhead(MD.ddrop(s, xl_l16_ProposerSlashing(k, W, i, hl))) == d_ProposerSlashing_bx(hl, th_ProposerSlashing_bx(xat_l16_ProposerSlashing(W, Nat.add(s, i)))) : D.Digest}
def xat_at_l16_ProposerSlashing(s, k, W, i, hl, e):
  match s:
    case 0n:
      match k:
        case 0n: Empty.absurd({MD.dhead(MD.ddrop(0n, xl_l16_ProposerSlashing(0n, W, i, hl))) == d_ProposerSlashing_bx(hl, th_ProposerSlashing_bx(xat_l16_ProposerSlashing(W, Nat.add(0n, i)))) : D.Digest}, MD.false_true(e))
        case 1n+q: {==}
    case 1n+ +p1:
      match k:
        case 0n: Empty.absurd({MD.dhead(MD.ddrop(1n+p1, xl_l16_ProposerSlashing(0n, W, i, hl))) == d_ProposerSlashing_bx(hl, th_ProposerSlashing_bx(xat_l16_ProposerSlashing(W, Nat.add(1n+p1, i)))) : D.Digest}, MD.false_true(e))
        case 1n+ +q:
