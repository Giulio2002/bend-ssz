def st_PendingAttestation(+hl: Nat, -h: B.Buf, -o: FuluPendingAttestation_d.PendingAttestation, +seg: U32, +s: S.Schema, +rep: LV.rep_PendingAttestation(o, s))
    -> {FuluPendingAttestation_h.PendingAttestation_root(hl, h, o, seg) == (h, (o, d_PendingAttestation(hl, o))) : B.Buf & (FuluPendingAttestation_d.PendingAttestation & D.Digest)}:
  (+x1, +q0) = rep
  (+x2, +q1) = q0
  (+x3, +q2) = q1
  (+eo, +q3) = q2
