    -> RR.roots(LV.v_ContributionAndProof(o), s, [D.bytes(Pair.snd(FuluContributionAndProof_d.ContributionAndProof, D.Digest, Pair.snd(B.Buf, FuluContributionAndProof_d.ContributionAndProof & D.Digest, FuluContributionAndProof_h.ContributionAndProof_hash_tree_root(h, o))))]):
