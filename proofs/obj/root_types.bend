def xmt0_l16_Deposit(+d: Nat, +b: Bool, +hl: Nat, +seg: U32, +dw: Nat, +t: F.array__Tree<MB<M_Deposit>>, +n: Nat, -h: B.Buf, +junk: D.Digest,
    +e: {Nat.is_lt(0n, n) == b : Bool}, +hd: {Nat.is_lt(dw, 32n) == True{} : Bool},
    +pf: {F.array__perfect(MB<M_Deposit>, dw, t) == True{} : Bool}, +hn: {Nat.is_le(n, F.spec_common__pow2(dw)) == True{} : Bool},
    +sE: S.Schema, +er: ereps_l16_Deposit(n, F.array__slots(MB<M_Deposit>, t), 0n, sE))
    -> {Fulu_list_Deposit_16_h.l16_Deposit_mt0(d, b, hl, seg, n, (h, (am_l16_Deposit(t), junk))) == (h, (am_l16_Deposit(t), MD.rtree(d, b, hl, xl_l16_Deposit(n, F.array__slots(MB<M_Deposit>, t), 0n, hl), 0n))) : B.Buf & (Array<O.Boxed<FuluDeposit_d.Deposit>> & D.Digest)}:
  match d:
    case 0n: xmt_l16_Deposit(0n, b, hl, seg, dw, t, 0n, n, h, junk, e, hd, pf, hn, sE, er)
    case 1n+ +q:
      match b:
        case False{}: {==}
        case True{}:
          %MR.div_double(O.pow2n(q)) :
            {Fulu_list_Deposit_16_h.l16_Deposit_mt(q, 1n, Nat.is_lt(Nat.add(0n, _), n), hl, seg, _, Nat.add(0n, _), n, Fulu_list_Deposit_16_h.l16_Deposit_mt(q, 0n, True{}, hl, seg, _, 0n, n, (h, (am_l16_Deposit(t), junk)))) == (h, (am_l16_Deposit(t), MD.rtree(1n+q, True{}, hl, xl_l16_Deposit(n, F.array__slots(MB<M_Deposit>, t), 0n, hl), 0n))) : B.Buf & (Array<O.Boxed<FuluDeposit_d.Deposit>> & D.Digest)}
