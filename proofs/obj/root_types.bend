# ---- l4096_b2048: list of cells (2048 bytes) ----
def st_l4096_b2048(+hl: Nat, -h: B.Buf, -o: O.Words, +seg: U32, +s: S.Schema, +rep: CE.rep_el(o, s))
    -> {Fulu_list_bytevec_2048_4096_h.l4096_b2048_root(hl, h, o, seg) == (h, (o, CE.ldig(hl, o, 12n))) : B.Buf & (O.Words & D.Digest)}:
  (+wf, +hv) = rep
  (+t, w1) = wf
  (+dw, w2) = w1
  (+N, w3) = w2
  (+eo, w4) = w3
  (+pf, w5) = w4
  (+hd, +room) = w5
  %Equal.sym(O.Words, o, O.Words{F.array__thaw(U32, t), N}, eo) :
    {Fulu_list_bytevec_2048_4096_h.l4096_b2048_root(hl, h, _, seg) == (h, (_, CE.ldig(hl, _, 12n))) : B.Buf & (O.Words & D.Digest)}
  %Equal.sym(B.Buf & (O.Words & D.Digest), O.elems_root(hl, h, O.Words{F.array__thaw(U32, t), N}, 512, 6, 12, seg), (h, (O.Words{F.array__thaw(U32, t), N}, CE.edig(hl, O.Words{F.array__thaw(U32, t), N}, 12n))),
      CE.ev_st(hl, h, O.Words{F.array__thaw(U32, t), N}, 12, seg, 12n, (t, (dw, (N, ({==}, (pf, (hd, room)))))), {==})) :
    {Fulu_list_bytevec_2048_4096_h.l4096_b2048_mix(hl, _) == (h, (O.Words{F.array__thaw(U32, t), N}, CE.ldig(hl, O.Words{F.array__thaw(U32, t), N}, 12n))) : B.Buf & (O.Words & D.Digest)}
  {==}

