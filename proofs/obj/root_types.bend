def xat_l8_Attestation(W: List<&2, MB<M_Attestation>>, +i: Nat) -> MB<M_Attestation>:
  match W:
    case Nil{}: MNone{}
    case Con{+x, t}:
      match i:
        case 0n: x
        case 1n+j: xat_l8_Attestation(t, j)
law nth_l8_Attestation:
  for +W: List<&2, MB<M_Attestation>>
  for +i: Nat
  for +hi: {Nat.is_lt(i, F.spec_common__length(MB<M_Attestation>, W)) == True{} : Bool}
  {F.spec_common__nth(MB<M_Attestation>, W, i) == Some{xat_l8_Attestation(W, i)} : Maybe<&2, MB<M_Attestation>>}
def nth_l8_Attestation(W, i, hi):
  match W:
    case Nil{}: Empty.absurd({F.spec_common__nth(MB<M_Attestation>, Nil{}, i) == Some{xat_l8_Attestation(Nil{}, i)} : Maybe<&2, MB<M_Attestation>>}, MD.false_true(Equal.trans(Bool, False{}, Nat.is_lt(i, 0n), True{}, Equal.sym(Bool, Nat.is_lt(i, 0n), False{}, F.nat__not_lt_zero(i)), hi)))
    case Con{+x, +t}:
      match i:
        case 0n: {==}
        case 1n+ +j: nth_l8_Attestation(t, j, hi)
def xl_l8_Attestation(k: Nat, +W: List<&2, MB<M_Attestation>>, +i: Nat, +hl: Nat) -> List<&2, D.Digest>:
  match k:
    case 0n: []
    case 1n+q: d_Attestation_bx(hl, th_Attestation_bx(xat_l8_Attestation(W, i))) <> xl_l8_Attestation(q, W, 1n+i, hl)
law xlen_l8_Attestation:
  for +k: Nat
  for +W: List<&2, MB<M_Attestation>>
  for +i: Nat
  for +hl: Nat
  {MD.dlen(xl_l8_Attestation(k, W, i, hl)) == k : Nat}
def xlen_l8_Attestation(k, W, i, hl):
  match k:
    case 0n: {==}
    case 1n+ +q:
      %xlen_l8_Attestation(q, W, 1n+i, hl) : {1n+MD.dlen(xl_l8_Attestation(q, W, 1n+i, hl)) == 1n+_ : Nat}
      {==}
law xat_at_l8_Attestation:
  for +s: Nat
  for +k: Nat
  for +W: List<&2, MB<M_Attestation>>
  for +i: Nat
  for +hl: Nat
  for +e: {Nat.is_lt(s, k) == True{} : Bool}
  {MD.dhead(MD.ddrop(s, xl_l8_Attestation(k, W, i, hl))) == d_Attestation_bx(hl, th_Attestation_bx(xat_l8_Attestation(W, Nat.add(s, i)))) : D.Digest}
def xat_at_l8_Attestation(s, k, W, i, hl, e):
  match s:
    case 0n:
      match k:
        case 0n: Empty.absurd({MD.dhead(MD.ddrop(0n, xl_l8_Attestation(0n, W, i, hl))) == d_Attestation_bx(hl, th_Attestation_bx(xat_l8_Attestation(W, Nat.add(0n, i)))) : D.Digest}, MD.false_true(e))
        case 1n+q: {==}
    case 1n+ +p1:
      match k:
        case 0n: Empty.absurd({MD.dhead(MD.ddrop(1n+p1, xl_l8_Attestation(0n, W, i, hl))) == d_Attestation_bx(hl, th_Attestation_bx(xat_l8_Attestation(W, Nat.add(1n+p1, i)))) : D.Digest}, MD.false_true(e))
        case 1n+ +q:
          %MR.add_succ(p1, i) : {MD.dhead(MD.ddrop(p1, xl_l8_Attestation(q, W, 1n+i, hl))) == d_Attestation_bx(hl, th_Attestation_bx(xat_l8_Attestation(W, _))) : D.Digest}
          xat_at_l8_Attestation(p1, q, W, 1n+i, hl, e)
def ereps_l8_Attestation(k: Nat, +W: List<&2, MB<M_Attestation>>, +i: Nat, +sE: S.Schema) -> Data:
  match k:
    case 0n: {True{} == True{} : Bool}
    case 1n+q: DK.P2(rep_Attestation_bx(th_Attestation_bx(xat_l8_Attestation(W, i)), sE), ereps_l8_Attestation(q, W, 1n+i, sE))
def erep_at_l8_Attestation(+s: Nat, +k: Nat, +W: List<&2, MB<M_Attestation>>, +i: Nat, +sE: S.Schema, +er: ereps_l8_Attestation(k, W, i, sE), +e: {Nat.is_lt(s, k) == True{} : Bool})
    -> rep_Attestation_bx(th_Attestation_bx(xat_l8_Attestation(W, Nat.add(s, i))), sE):
  match s:
    case 0n:
      match k:
        case 0n: Empty.absurd(rep_Attestation_bx(th_Attestation_bx(xat_l8_Attestation(W, Nat.add(0n, i))), sE), MD.false_true(e))
        case 1n+q:
          (+r0, +rs) = er
          r0
    case 1n+ +p1:
      match k:
        case 0n: Empty.absurd(rep_Attestation_bx(th_Attestation_bx(xat_l8_Attestation(W, Nat.add(1n+p1, i))), sE), MD.false_true(e))
        case 1n+ +q:
          (+r0, +rs) = er
          %MR.add_succ(p1, i) : rep_Attestation_bx(th_Attestation_bx(xat_l8_Attestation(W, _)), sE)
          erep_at_l8_Attestation(p1, q, W, 1n+i, sE, rs, e)
def xi_l8_Attestation(k: Nat, +W: List<&2, MB<M_Attestation>>, +i: Nat) -> S.Value:
  match k:
    case 0n: S.EmptyItems{}
    case 1n+q: S.Items{v_Attestation_bx(th_Attestation_bx(xat_l8_Attestation(W, i))), xi_l8_Attestation(q, W, 1n+i)}
law xroots_l8_Attestation:
  for +k: Nat
  for +W: List<&2, MB<M_Attestation>>
  for +i: Nat
  for +hl: Nat
  for +ehl: {hl == 64n : Nat}
  for -h: B.Buf
  for +sE: S.Schema
  for +er: ereps_l8_Attestation(k, W, i, sE)
  for +dv: OS.DV
  for +edv: {dv == OS.DV0() : OS.DV}
  for +ok: {ok_Attestation_bx(sE, dv) == True{} : Bool}
  for +eq: eqs_Attestation_bx(sE)
  RR.roots(xi_l8_Attestation(k, W, i), S.Repeat{sE}, MD.bytes_list(xl_l8_Attestation(k, W, i, hl)))
def xroots_l8_Attestation(k, W, i, hl, ehl, h, sE, er, dv, edv, ok, eq):
  match k:
    case 0n: {==}
    case 1n+ +q:
      (+r0, +rs) = er
      ([D.bytes(d_Attestation_bx(hl, th_Attestation_bx(xat_l8_Attestation(W, i))))], (MD.bytes_list(xl_l8_Attestation(q, W, 1n+i, hl)), (rs_Attestation_bx(hl, ehl, h, th_Attestation_bx(xat_l8_Attestation(W, i)), sE, r0, dv, edv, ok, eq), (xroots_l8_Attestation(q, W, 1n+i, hl, ehl, h, sE, rs, dv, edv, ok, eq), {==}))))
law xcount_l8_Attestation:
