# ---- Attestation (Type-kind container, 4 fields) ----
def pj_Attestation_0(o: FuluAttestation_d.Attestation) -> O.Bits:
  match o:
    case FuluAttestation_d.Attestation{x0, +x1, +x2, +x3}: x0
def v_Attestation(o: FuluAttestation_d.Attestation) -> S.Value:
  match o:
    case FuluAttestation_d.Attestation{x0, +x1, +x2, +x3}: S.Sequence{S.Items{S.BitsValue{BO.bview(x0)}, S.Items{RN_L.v_AttestationData(x1), S.Items{RN_L.v_b96(x2), S.Items{RN_L.v_bv64(x3), S.EmptyItems{}}}}}}
def d_Attestation(+hl: Nat, o: FuluAttestation_d.Attestation) -> D.Digest:
  match o:
    case FuluAttestation_d.Attestation{x0, +x1, +x2, +x3}: MD.rtree(2n, True{}, hl, [BO.bdig(hl, x0, 9n), RN.d_AttestationData(hl, x1), RN.d_b96(hl, x2), RN.d_bv64(hl, x3)], 0n)
def rep_Attestation(o: FuluAttestation_d.Attestation, +s: S.Schema) -> Data:
  DK.Ex(FuluAttestationData_d.AttestationData, x1 => DK.Ex(FuluBytes96_d.Bytes96, x2 => DK.Ex(Fulu_bitvector_64_d.Bitvector64, x3 => DK.P2({o == FuluAttestation_d.Attestation{pj_Attestation_0(o), x1, x2, x3} : FuluAttestation_d.Attestation}, BO.rep_bits(pj_Attestation_0(o), SH.Chain_head(SH.Container_fields(s)))))))
def ok_Attestation(+s: S.Schema, +dv: OS.DV) -> Bool: Bool.and(SH.is_Container(s), Bool.and(SH.is_Chain(SH.Container_fields(s)), Bool.and(SH.is_Chain(SH.Chain_tail(SH.Container_fields(s))), Bool.and(SH.is_Chain(SH.Chain_tail(SH.Chain_tail(SH.Container_fields(s)))), Bool.and(SH.is_Chain(SH.Chain_tail(SH.Chain_tail(SH.Chain_tail(SH.Container_fields(s))))), Bool.and(SH.is_End(SH.Chain_tail(SH.Chain_tail(SH.Chain_tail(SH.Chain_tail(SH.Container_fields(s)))))), BO.ok_bits(SH.Chain_head(SH.Container_fields(s)), 9n)))))))
def okc_Attestation(+s: S.Schema, +dv: OS.DV, +ok: {ok_Attestation(s, dv) == True{} : Bool}) -> {SH.is_Container(s) == True{} : Bool}: DK.and_l(SH.is_Container(s), Bool.and(SH.is_Chain(SH.Container_fields(s)), Bool.and(SH.is_Chain(SH.Chain_tail(SH.Container_fields(s))), Bool.and(SH.is_Chain(SH.Chain_tail(SH.Chain_tail(SH.Container_fields(s)))), Bool.and(SH.is_Chain(SH.Chain_tail(SH.Chain_tail(SH.Chain_tail(SH.Container_fields(s))))), Bool.and(SH.is_End(SH.Chain_tail(SH.Chain_tail(SH.Chain_tail(SH.Chain_tail(SH.Container_fields(s)))))), BO.ok_bits(SH.Chain_head(SH.Container_fields(s)), 9n)))))), ok)
def eqs_Attestation(+s: S.Schema) -> Data: DK.P2({SH.Chain_head(SH.Chain_tail(SH.Container_fields(s))) == S.Container{["slot", "index", "beacon_block_root", "source", "target"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{32n}, S.Chain{S.Container{["epoch", "root"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{32n}, S.End{}}}}, S.Chain{S.Container{["epoch", "root"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{32n}, S.End{}}}}, S.End{}}}}}}} : S.Schema}, DK.P2({SH.Chain_head(SH.Chain_tail(SH.Chain_tail(SH.Container_fields(s)))) == S.ByteVector{96n} : S.Schema}, {SH.Chain_head(SH.Chain_tail(SH.Chain_tail(SH.Chain_tail(SH.Container_fields(s))))) == S.BitVector{64n} : S.Schema}))
