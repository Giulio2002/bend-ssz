def wd_BlobSidecar(+hl: Nat, -o: FuluBlobSidecar_d.BlobSidecar, +s: S.Schema, +rep: rep_BlobSidecar(o, s)) -> OS.DW(d_BlobSidecar(hl, o)):
  (+x0, +q0) = rep
  (+x2, +q1) = q0
  (+x3, +q2) = q1
  (+eo, +q3) = q2
  (+rp1, +q4) = q3
  (+rp4, +q5) = q4
  +dd1 = OS.dwv(WO_L.wdig(hl, pj_BlobSidecar_1(o), 12n), wd_bv(hl, pj_BlobSidecar_1(o), SH.Chain_head(SH.Chain_tail(SH.Container_fields(s))), 12n, rp1))
  +de1 = OS.dwe(WO_L.wdig(hl, pj_BlobSidecar_1(o), 12n), wd_bv(hl, pj_BlobSidecar_1(o), SH.Chain_head(SH.Chain_tail(SH.Container_fields(s))), 12n, rp1))
  +dd4 = OS.dwv(d_SignedBeaconBlockHeader_bx(hl, pj_BlobSidecar_4(o)), wd_SignedBeaconBlockHeader_bx(hl, pj_BlobSidecar_4(o), SH.Chain_head(SH.Chain_tail(SH.Chain_tail(SH.Chain_tail(SH.Chain_tail(SH.Container_fields(s)))))), rp4))
  +de4 = OS.dwe(d_SignedBeaconBlockHeader_bx(hl, pj_BlobSidecar_4(o)), wd_SignedBeaconBlockHeader_bx(hl, pj_BlobSidecar_4(o), SH.Chain_head(SH.Chain_tail(SH.Chain_tail(SH.Chain_tail(SH.Chain_tail(SH.Container_fields(s)))))), rp4))
  +dd5 = OS.dwv(WO_L.wdig(hl, pj_BlobSidecar_5(o), 5n), wd_pv(hl, pj_BlobSidecar_5(o), SH.Chain_head(SH.Chain_tail(SH.Chain_tail(SH.Chain_tail(SH.Chain_tail(SH.Chain_tail(SH.Container_fields(s))))))), 5n, q5))
  +de5 = OS.dwe(WO_L.wdig(hl, pj_BlobSidecar_5(o), 5n), wd_pv(hl, pj_BlobSidecar_5(o), SH.Chain_head(SH.Chain_tail(SH.Chain_tail(SH.Chain_tail(SH.Chain_tail(SH.Chain_tail(SH.Container_fields(s))))))), 5n, q5))
  %Equal.sym(FuluBlobSidecar_d.BlobSidecar, o, FuluBlobSidecar_d.BlobSidecar{x0, pj_BlobSidecar_1(o), x2, x3, pj_BlobSidecar_4(o), pj_BlobSidecar_5(o)}, eo) : OS.DW(d_BlobSidecar(hl, _))
  %Equal.sym(D.Digest, WO_L.wdig(hl, pj_BlobSidecar_1(o), 12n), dd1, de1) :
