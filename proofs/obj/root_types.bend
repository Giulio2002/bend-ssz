  %Equal.sym(O.Boxed<FuluSyncAggregate_d.SyncAggregate>, o, O.BSome{v, O.BNone{}}, eo) :
    {FuluSyncAggregate_h.SyncAggregate_bx_root(hl, h, _, seg) == (h, (_, d_SyncAggregate_bx(hl, _))) : B.Buf & (O.Boxed<FuluSyncAggregate_d.SyncAggregate> & D.Digest)}
  %Equal.sym(B.Buf & D.Digest, FuluSyncAggregate_h.SyncAggregate_root(hl, h, v, seg), (h, RN.d_SyncAggregate(hl, v)), RN.st_SyncAggregate(hl, h, v, seg)) :
    {FuluSyncAggregate_h.SyncAggregate_bx_rt(v, _) == (h, (O.BSome{v, O.BNone{}}, d_SyncAggregate_bx(hl, O.BSome{v, O.BNone{}}))) : B.Buf & (O.Boxed<FuluSyncAggregate_d.SyncAggregate> & D.Digest)}
