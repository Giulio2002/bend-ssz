def xmt0_l8_Attestation(+d: Nat, +b: Bool, +hl: Nat, +seg: U32, +dw: Nat, +t: F.array__Tree<MB<M_Attestation>>, +n: Nat, -h: B.Buf, +junk: D.Digest,
    +e: {Nat.is_lt(0n, n) == b : Bool}, +hd: {Nat.is_lt(dw, 32n) == True{} : Bool},
    +pf: {F.array__perfect(MB<M_Attestation>, dw, t) == True{} : Bool}, +hn: {Nat.is_le(n, F.spec_common__pow2(dw)) == True{} : Bool},
    +sE: S.Schema, +er: ereps_l8_Attestation(n, F.array__slots(MB<M_Attestation>, t), 0n, sE))
    -> {Fulu_list_Attestation_8_h.l8_Attestation_mt0(d, b, hl, seg, n, (h, (am_l8_Attestation(t), junk))) == (h, (am_l8_Attestation(t), MD.rtree(d, b, hl, xl_l8_Attestation(n, F.array__slots(MB<M_Attestation>, t), 0n, hl), 0n))) : B.Buf & (Array<O.Boxed<FuluAttestation_d.Attestation>> & D.Digest)}:
  match d:
    case 0n: xmt_l8_Attestation(0n, b, hl, seg, dw, t, 0n, n, h, junk, e, hd, pf, hn, sE, er)
    case 1n+ +q:
      match b:
        case False{}: {==}
        case True{}:
          %MR.div_double(O.pow2n(q)) :
            {Fulu_list_Attestation_8_h.l8_Attestation_mt(q, 1n, Nat.is_lt(Nat.add(0n, _), n), hl, seg, _, Nat.add(0n, _), n, Fulu_list_Attestation_8_h.l8_Attestation_mt(q, 0n, True{}, hl, seg, _, 0n, n, (h, (am_l8_Attestation(t), junk)))) == (h, (am_l8_Attestation(t), MD.rtree(1n+q, True{}, hl, xl_l8_Attestation(n, F.array__slots(MB<M_Attestation>, t), 0n, hl), 0n))) : B.Buf & (Array<O.Boxed<FuluAttestation_d.Attestation>> & D.Digest)}
          xmt_l8_Attestation(1n+q, True{}, hl, seg, dw, t, 0n, n, h, junk, e, hd, pf, hn, sE, er)
def tfz_l8_Attestation(a: Array<O.Boxed<FuluAttestation_d.Attestation>>) -> F.array__Tree<MB<M_Attestation>>:
  match a:
    case ALeaf{x}: F.TLeaf{fz_Attestation_bx(x)}
    case ANode{l, r}: F.TNode{tfz_l8_Attestation(l), tfz_l8_Attestation(r)}
law tfzam_l8_Attestation:
  for +t: F.array__Tree<MB<M_Attestation>>
  {tfz_l8_Attestation(am_l8_Attestation(t)) == t : F.array__Tree<MB<M_Attestation>>}
def tfzam_l8_Attestation(t):
  match t:
    case F.TLeaf{+x}:
      %Equal.sym(MB<M_Attestation>, fz_Attestation_bx(th_Attestation_bx(x)), x, fzth_Attestation_bx(x)) : {F.TLeaf{_} == F.TLeaf{x} : F.array__Tree<MB<M_Attestation>>}
      {==}
    case F.TNode{+l, +r}:
      %Equal.sym(F.array__Tree<MB<M_Attestation>>, tfz_l8_Attestation(am_l8_Attestation(l)), l, tfzam_l8_Attestation(l)) : {F.TNode{_, tfz_l8_Attestation(am_l8_Attestation(r))} == F.TNode{l, r} : F.array__Tree<MB<M_Attestation>>}
      %Equal.sym(F.array__Tree<MB<M_Attestation>>, tfz_l8_Attestation(am_l8_Attestation(r)), r, tfzam_l8_Attestation(r)) : {F.TNode{l, _} == F.TNode{l, r} : F.array__Tree<MB<M_Attestation>>}
      {==}
