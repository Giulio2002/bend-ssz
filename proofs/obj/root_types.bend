def rs_l16_Deposit(+hl: Nat, +ehl: {hl == 64n : Nat}, -h: B.Buf, -o: Fulu_list_Deposit_16_d.l16_Deposit_Seq, +s: S.Schema, +rep: LV.rep_l16_Deposit(o, s), +dv: OS.DV, +edv: {dv == OS.DV0() : OS.DV}, +ok: {ok_l16_Deposit(s, dv) == True{} : Bool}, +eq: eqs_l16_Deposit(s))
    -> RR.roots(LV.xv_l16_Deposit(o), s, [D.bytes(xd_l16_Deposit(hl, o))]):
  (+wf, +hv) = rep
  (+t, w1) = wf
  (+dw, w2) = w1
  (+N, w3) = w2
  (+eo, w4) = w3
  (+pf, w5) = w4
  (+hd, w6) = w5
  (+hn, +er) = w6
  +k0 = DK.and_l(SH.is_ListOf(s), Bool.and(Lim.minimal(SH.ListOf_limit(s), 4n), ok_Deposit_bx(SH.ListOf_element(s), dv)), ok)
  +k1 = DK.and_r(SH.is_ListOf(s), Bool.and(Lim.minimal(SH.ListOf_limit(s), 4n), ok_Deposit_bx(SH.ListOf_element(s), dv)), ok)
  +kmin = DK.and_l(Lim.minimal(SH.ListOf_limit(s), 4n), ok_Deposit_bx(SH.ListOf_element(s), dv), k1)
  +kel = DK.and_r(Lim.minimal(SH.ListOf_limit(s), 4n), ok_Deposit_bx(SH.ListOf_element(s), dv), k1)
  +hvN = xhv_l16_Deposit(o, t, N, SH.ListOf_limit(s), eo, hv)
