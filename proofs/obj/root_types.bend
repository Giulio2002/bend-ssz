def rs_l8_Attestation(+hl: Nat, +ehl: {hl == 64n : Nat}, -h: B.Buf, -o: Fulu_list_Attestation_8_d.l8_Attestation_Seq, +s: S.Schema, +rep: rep_l8_Attestation(o, s), +dv: OS.DV, +edv: {dv == OS.DV0() : OS.DV}, +ok: {ok_l8_Attestation(s, dv) == True{} : Bool}, +eq: eqs_l8_Attestation(s))
    -> RR.roots(xv_l8_Attestation(o), s, [D.bytes(xd_l8_Attestation(hl, o))]):
  (+wf, +hv) = rep
  (+t, w1) = wf
  (+dw, w2) = w1
  (+N, w3) = w2
  (+eo, w4) = w3
  (+pf, w5) = w4
  (+hd, w6) = w5
  (+hn, +er) = w6
  +k0 = DK.and_l(SH.is_ListOf(s), Bool.and(Lim.minimal(SH.ListOf_limit(s), 3n), ok_Attestation_bx(SH.ListOf_element(s), dv)), ok)
  +k1 = DK.and_r(SH.is_ListOf(s), Bool.and(Lim.minimal(SH.ListOf_limit(s), 3n), ok_Attestation_bx(SH.ListOf_element(s), dv)), ok)
  +kmin = DK.and_l(Lim.minimal(SH.ListOf_limit(s), 3n), ok_Attestation_bx(SH.ListOf_element(s), dv), k1)
  +kel = DK.and_r(Lim.minimal(SH.ListOf_limit(s), 3n), ok_Attestation_bx(SH.ListOf_element(s), dv), k1)
  +hvN = xhv_l8_Attestation(o, t, N, SH.ListOf_limit(s), eo, hv)
  +ebs = bs_cont(SH.ListOf_element(s), okc_Attestation(SH.ListOf_element(s), dv, kel))
