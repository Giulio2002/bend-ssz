  rs_Attestation(64n, {==}, h, o, s, rep, dv, edv, Attestation_ok(s, es, dv, edv), Attestation_eqs(s, es))
law Attestation_root_correct:
  for -h: B.Buf
  for -o: FuluAttestation_d.Attestation
  for +s: S.Schema
  for +es: {s == Spec.Attestation() : S.Schema}
  for +rep: LV.rep_Attestation(o, s)
  RR.roots(LV.v_Attestation(o), s, [D.bytes(Pair.snd(FuluAttestation_d.Attestation, D.Digest, Pair.snd(B.Buf, FuluAttestation_d.Attestation & D.Digest, FuluAttestation_h.Attestation_hash_tree_root(h, o))))])
def Attestation_root_correct(h, o, s, es, rep): Attestation_rc(h, o, s, es, rep, OS.DV0(), {==})

