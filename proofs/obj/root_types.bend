  %Equal.sym(B.Buf & (FuluDataColumnSidecar_d.DataColumnSidecar & D.Digest), FuluDataColumnSidecar_h.DataColumnSidecar_root(64n, h, o, 0), (h, (o, d_DataColumnSidecar(64n, o))), st_DataColumnSidecar(64n, h, o, 0, s, rep)) :
    RR.roots(LV.v_DataColumnSidecar(o), s, [D.bytes(Pair.snd(FuluDataColumnSidecar_d.DataColumnSidecar, D.Digest, Pair.snd(B.Buf, FuluDataColumnSidecar_d.DataColumnSidecar & D.Digest, _)))])
  rs_DataColumnSidecar(64n, {==}, h, o, s, rep, dv, edv, DataColumnSidecar_ok(s, es, dv, edv), DataColumnSidecar_eqs(s, es))
law DataColumnSidecar_root_correct:
  for -h: B.Buf
  for -o: FuluDataColumnSidecar_d.DataColumnSidecar
  for +s: S.Schema
  for +es: {s == Spec.DataColumnSidecar() : S.Schema}
  for +rep: LV.rep_DataColumnSidecar(o, s)
  RR.roots(LV.v_DataColumnSidecar(o), s, [D.bytes(Pair.snd(FuluDataColumnSidecar_d.DataColumnSidecar, D.Digest, Pair.snd(B.Buf, FuluDataColumnSidecar_d.DataColumnSidecar & D.Digest, FuluDataColumnSidecar_h.DataColumnSidecar_hash_tree_root(h, o))))])
def DataColumnSidecar_root_correct(h, o, s, es, rep): DataColumnSidecar_rc(h, o, s, es, rep, OS.DV0(), {==})

