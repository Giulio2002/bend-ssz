# ---- l8192_DepositRequest: list of DepositRequest (Data elements) ----
def xat_l8192_DepositRequest(W: List<&2, FuluDepositRequest_d.DepositRequest>, +i: Nat) -> FuluDepositRequest_d.DepositRequest:
  match W:
