    {FuluMatrixEntry_h.MatrixEntry_rt0(hl, seg, x1, x2, x3, _) == (h, (FuluMatrixEntry_d.MatrixEntry{LV.pj_MatrixEntry_0(o), x1, x2, x3}, d_MatrixEntry(hl, FuluMatrixEntry_d.MatrixEntry{LV.pj_MatrixEntry_0(o), x1, x2, x3}))) : B.Buf & (FuluMatrixEntry_d.MatrixEntry & D.Digest)}
