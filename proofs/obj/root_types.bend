  (+wf, +hv) = rep
  (+t, w1) = wf
  (+dw, w2) = w1
  (+N, w3) = w2
  (+eo, w4) = w3
  (+pf, w5) = w4
  (+hd, +room) = w5
  %Equal.sym(O.Words, o, O.Words{F.array__thaw(U32, t), N}, eo) :
    {Fulu_list_bytevec_2048_4096_h.l4096_b2048_root(hl, h, _, seg) == (h, (_, CE.ldig(hl, _, 12n))) : B.Buf & (O.Words & D.Digest)}
