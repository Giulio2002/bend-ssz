    {Fulu_list_Attestation_8_h.l8_Attestation_rt_fin(hl, N, _) == (h, (Fulu_list_Attestation_8_d.l8_Attestation_Seq{am_l8_Attestation(t), N}, xd_l8_Attestation(hl, Fulu_list_Attestation_8_d.l8_Attestation_Seq{am_l8_Attestation(t), N}))) : B.Buf & (Fulu_list_Attestation_8_d.l8_Attestation_Seq & D.Digest)}
