# ---- box of ProposerSlashing ----
def pjb_ProposerSlashing_bx(o: O.Boxed<FuluProposerSlashing_d.ProposerSlashing>) -> FuluProposerSlashing_d.ProposerSlashing:
  match o:
    case O.BSome{v, rest}: v
    case O.BNone{}: FuluProposerSlashing_d.ProposerSlashing_default()
def v_ProposerSlashing_bx(o: O.Boxed<FuluProposerSlashing_d.ProposerSlashing>) -> S.Value:
  match o:
    case O.BSome{v, rest}: v_ProposerSlashing(v)
    case O.BNone{}: S.NullValue{}
def d_ProposerSlashing_bx(+hl: Nat, o: O.Boxed<FuluProposerSlashing_d.ProposerSlashing>) -> D.Digest:
  match o:
    case O.BSome{v, rest}: d_ProposerSlashing(hl, v)
    case O.BNone{}: D.zero()
def rep_ProposerSlashing_bx(o: O.Boxed<FuluProposerSlashing_d.ProposerSlashing>, +s: S.Schema) -> Data:
  DK.P2({o == O.BSome{pjb_ProposerSlashing_bx(o), O.BNone{}} : O.Boxed<FuluProposerSlashing_d.ProposerSlashing>}, rep_ProposerSlashing(pjb_ProposerSlashing_bx(o), s))
def st_ProposerSlashing_bx(+hl: Nat, -h: B.Buf, -o: O.Boxed<FuluProposerSlashing_d.ProposerSlashing>, +seg: U32, +s: S.Schema, +rep: rep_ProposerSlashing_bx(o, s))
    -> {FuluProposerSlashing_h.ProposerSlashing_bx_root(hl, h, o, seg) == (h, (o, d_ProposerSlashing_bx(hl, o))) : B.Buf & (O.Boxed<FuluProposerSlashing_d.ProposerSlashing> & D.Digest)}:
  (+eo, +ri) = rep
  %Equal.sym(O.Boxed<FuluProposerSlashing_d.ProposerSlashing>, o, O.BSome{pjb_ProposerSlashing_bx(o), O.BNone{}}, eo) :
    {FuluProposerSlashing_h.ProposerSlashing_bx_root(hl, h, _, seg) == (h, (_, d_ProposerSlashing_bx(hl, _))) : B.Buf & (O.Boxed<FuluProposerSlashing_d.ProposerSlashing> & D.Digest)}
  %Equal.sym(B.Buf & (FuluProposerSlashing_d.ProposerSlashing & D.Digest), FuluProposerSlashing_h.ProposerSlashing_root(hl, h, pjb_ProposerSlashing_bx(o), seg), (h, (pjb_ProposerSlashing_bx(o), d_ProposerSlashing(hl, pjb_ProposerSlashing_bx(o)))), st_ProposerSlashing(hl, h, pjb_ProposerSlashing_bx(o), seg, s, ri)) :
    {FuluProposerSlashing_h.ProposerSlashing_bx_rt(_) == (h, (O.BSome{pjb_ProposerSlashing_bx(o), O.BNone{}}, d_ProposerSlashing_bx(hl, O.BSome{pjb_ProposerSlashing_bx(o), O.BNone{}}))) : B.Buf & (O.Boxed<FuluProposerSlashing_d.ProposerSlashing> & D.Digest)}
  {==}
def rs_ProposerSlashing_bx(+hl: Nat, +ehl: {hl == 64n : Nat}, -h: B.Buf, -o: O.Boxed<FuluProposerSlashing_d.ProposerSlashing>, +s: S.Schema, +rep: rep_ProposerSlashing_bx(o, s), +dv: OS.DV, +edv: {dv == OS.DV0() : OS.DV}, +ok: {ok_ProposerSlashing(s, dv) == True{} : Bool}, +eq: eqs_ProposerSlashing(s))
    -> RR.roots(v_ProposerSlashing_bx(o), s, [D.bytes(d_ProposerSlashing_bx(hl, o))]):
  (+eo, +ri) = rep
  %Equal.sym(O.Boxed<FuluProposerSlashing_d.ProposerSlashing>, o, O.BSome{pjb_ProposerSlashing_bx(o), O.BNone{}}, eo) : RR.roots(v_ProposerSlashing_bx(_), s, [D.bytes(d_ProposerSlashing_bx(hl, _))])
  rs_ProposerSlashing(hl, ehl, h, pjb_ProposerSlashing_bx(o), s, ri, dv, edv, ok, eq)
def wd_ProposerSlashing_bx(+hl: Nat, -o: O.Boxed<FuluProposerSlashing_d.ProposerSlashing>, +s: S.Schema, +rep: rep_ProposerSlashing_bx(o, s)) -> OS.DW(d_ProposerSlashing_bx(hl, o)):
  (+eo, +ri) = rep
  %Equal.sym(O.Boxed<FuluProposerSlashing_d.ProposerSlashing>, o, O.BSome{pjb_ProposerSlashing_bx(o), O.BNone{}}, eo) : OS.DW(d_ProposerSlashing_bx(hl, _))
  wd_ProposerSlashing(hl, pjb_ProposerSlashing_bx(o), s, ri)
def ok_ProposerSlashing_bx(+s: S.Schema, +dv: OS.DV) -> Bool: ok_ProposerSlashing(s, dv)
def eqs_ProposerSlashing_bx(+s: S.Schema) -> Data: eqs_ProposerSlashing(s)

def mfz_SignedBeaconBlockHeader_bx(x: O.Boxed<FuluSignedBeaconBlockHeader_d.SignedBeaconBlockHeader>) -> FuluSignedBeaconBlockHeader_d.SignedBeaconBlockHeader:
  match x:
    case O.BSome{+v, rest}: v
    case O.BNone{}: FuluSignedBeaconBlockHeader_d.SignedBeaconBlockHeader_default()

# ---- Data mirror of ProposerSlashing ----
type M_ProposerSlashing is Data:
  M_ProposerSlashing{a0: FuluSignedBeaconBlockHeader_d.SignedBeaconBlockHeader, a1: FuluSignedBeaconBlockHeader_d.SignedBeaconBlockHeader}
def th_ProposerSlashing(m: M_ProposerSlashing) -> FuluProposerSlashing_d.ProposerSlashing:
  match m:
    case M_ProposerSlashing{+a0, +a1}: FuluProposerSlashing_d.ProposerSlashing{O.BSome{a0, O.BNone{}}, O.BSome{a1, O.BNone{}}}
def fz_ProposerSlashing(x: FuluProposerSlashing_d.ProposerSlashing) -> M_ProposerSlashing:
  match x:
    case FuluProposerSlashing_d.ProposerSlashing{x0, x1}: M_ProposerSlashing{mfz_SignedBeaconBlockHeader_bx(x0), mfz_SignedBeaconBlockHeader_bx(x1)}
def fzth_ProposerSlashing(+m: M_ProposerSlashing) -> {fz_ProposerSlashing(th_ProposerSlashing(m)) == m : M_ProposerSlashing}:
  match m:
    case M_ProposerSlashing{+a0, +a1}:
      {==}

def mfz_ProposerSlashing_bx(x: O.Boxed<FuluProposerSlashing_d.ProposerSlashing>) -> M_ProposerSlashing:
  match x:
    case O.BSome{v, rest}: fz_ProposerSlashing(v)
    case O.BNone{}: fz_ProposerSlashing(FuluProposerSlashing_d.ProposerSlashing_default())
def th_ProposerSlashing_bx(m: MB<M_ProposerSlashing>) -> O.Boxed<FuluProposerSlashing_d.ProposerSlashing>:
  match m:
    case MSome{+v}: O.BSome{th_ProposerSlashing(v), O.BNone{}}
    case MNone{}: O.BNone{}
def fz_ProposerSlashing_bx(x: O.Boxed<FuluProposerSlashing_d.ProposerSlashing>) -> MB<M_ProposerSlashing>:
  match x:
    case O.BSome{v, rest}: MSome{fz_ProposerSlashing(v)}
    case O.BNone{}: MNone{}
def fzth_ProposerSlashing_bx(+m: MB<M_ProposerSlashing>) -> {fz_ProposerSlashing_bx(th_ProposerSlashing_bx(m)) == m : MB<M_ProposerSlashing>}:
  match m:
    case MSome{+v}:
      %Equal.sym(M_ProposerSlashing, fz_ProposerSlashing(th_ProposerSlashing(v)), v, fzth_ProposerSlashing(v)) : {MSome{_} == MSome{v} : MB<M_ProposerSlashing>}
      {==}
    case MNone{}: {==}

