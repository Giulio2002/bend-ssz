# ---- box of IndexedAttestation ----
def pjb_IndexedAttestation_bx(o: O.Boxed<FuluIndexedAttestation_d.IndexedAttestation>) -> FuluIndexedAttestation_d.IndexedAttestation:
  match o:
    case O.BSome{v, rest}: v
    case O.BNone{}: FuluIndexedAttestation_d.IndexedAttestation_default()
def v_IndexedAttestation_bx(o: O.Boxed<FuluIndexedAttestation_d.IndexedAttestation>) -> S.Value:
  match o:
    case O.BSome{v, rest}: v_IndexedAttestation(v)
    case O.BNone{}: S.NullValue{}
def d_IndexedAttestation_bx(+hl: Nat, o: O.Boxed<FuluIndexedAttestation_d.IndexedAttestation>) -> D.Digest:
  match o:
    case O.BSome{v, rest}: d_IndexedAttestation(hl, v)
    case O.BNone{}: D.zero()
def rep_IndexedAttestation_bx(o: O.Boxed<FuluIndexedAttestation_d.IndexedAttestation>, +s: S.Schema) -> Data:
  DK.P2({o == O.BSome{pjb_IndexedAttestation_bx(o), O.BNone{}} : O.Boxed<FuluIndexedAttestation_d.IndexedAttestation>}, rep_IndexedAttestation(pjb_IndexedAttestation_bx(o), s))
def st_IndexedAttestation_bx(+hl: Nat, -h: B.Buf, -o: O.Boxed<FuluIndexedAttestation_d.IndexedAttestation>, +seg: U32, +s: S.Schema, +rep: rep_IndexedAttestation_bx(o, s))
    -> {FuluIndexedAttestation_h.IndexedAttestation_bx_root(hl, h, o, seg) == (h, (o, d_IndexedAttestation_bx(hl, o))) : B.Buf & (O.Boxed<FuluIndexedAttestation_d.IndexedAttestation> & D.Digest)}:
  (+eo, +ri) = rep
  %Equal.sym(O.Boxed<FuluIndexedAttestation_d.IndexedAttestation>, o, O.BSome{pjb_IndexedAttestation_bx(o), O.BNone{}}, eo) :
    {FuluIndexedAttestation_h.IndexedAttestation_bx_root(hl, h, _, seg) == (h, (_, d_IndexedAttestation_bx(hl, _))) : B.Buf & (O.Boxed<FuluIndexedAttestation_d.IndexedAttestation> & D.Digest)}
  %Equal.sym(B.Buf & (FuluIndexedAttestation_d.IndexedAttestation & D.Digest), FuluIndexedAttestation_h.IndexedAttestation_root(hl, h, pjb_IndexedAttestation_bx(o), seg), (h, (pjb_IndexedAttestation_bx(o), d_IndexedAttestation(hl, pjb_IndexedAttestation_bx(o)))), st_IndexedAttestation(hl, h, pjb_IndexedAttestation_bx(o), seg, s, ri)) :
    {FuluIndexedAttestation_h.IndexedAttestation_bx_rt(_) == (h, (O.BSome{pjb_IndexedAttestation_bx(o), O.BNone{}}, d_IndexedAttestation_bx(hl, O.BSome{pjb_IndexedAttestation_bx(o), O.BNone{}}))) : B.Buf & (O.Boxed<FuluIndexedAttestation_d.IndexedAttestation> & D.Digest)}
  {==}
def rs_IndexedAttestation_bx(+hl: Nat, +ehl: {hl == 64n : Nat}, -h: B.Buf, -o: O.Boxed<FuluIndexedAttestation_d.IndexedAttestation>, +s: S.Schema, +rep: rep_IndexedAttestation_bx(o, s), +dv: OS.DV, +edv: {dv == OS.DV0() : OS.DV}, +ok: {ok_IndexedAttestation(s, dv) == True{} : Bool}, +eq: eqs_IndexedAttestation(s))
    -> RR.roots(v_IndexedAttestation_bx(o), s, [D.bytes(d_IndexedAttestation_bx(hl, o))]):
  (+eo, +ri) = rep
  %Equal.sym(O.Boxed<FuluIndexedAttestation_d.IndexedAttestation>, o, O.BSome{pjb_IndexedAttestation_bx(o), O.BNone{}}, eo) : RR.roots(v_IndexedAttestation_bx(_), s, [D.bytes(d_IndexedAttestation_bx(hl, _))])
  rs_IndexedAttestation(hl, ehl, h, pjb_IndexedAttestation_bx(o), s, ri, dv, edv, ok, eq)
def wd_IndexedAttestation_bx(+hl: Nat, -o: O.Boxed<FuluIndexedAttestation_d.IndexedAttestation>, +s: S.Schema, +rep: rep_IndexedAttestation_bx(o, s)) -> OS.DW(d_IndexedAttestation_bx(hl, o)):
  (+eo, +ri) = rep
  %Equal.sym(O.Boxed<FuluIndexedAttestation_d.IndexedAttestation>, o, O.BSome{pjb_IndexedAttestation_bx(o), O.BNone{}}, eo) : OS.DW(d_IndexedAttestation_bx(hl, _))
  wd_IndexedAttestation(hl, pjb_IndexedAttestation_bx(o), s, ri)
def ok_IndexedAttestation_bx(+s: S.Schema, +dv: OS.DV) -> Bool: ok_IndexedAttestation(s, dv)
def eqs_IndexedAttestation_bx(+s: S.Schema) -> Data: eqs_IndexedAttestation(s)

# ---- AttesterSlashing (Type-kind container, 2 fields) ----
def pj_AttesterSlashing_0(o: FuluAttesterSlashing_d.AttesterSlashing) -> O.Boxed<FuluIndexedAttestation_d.IndexedAttestation>:
  match o:
    case FuluAttesterSlashing_d.AttesterSlashing{x0, x1}: x0
def pj_AttesterSlashing_1(o: FuluAttesterSlashing_d.AttesterSlashing) -> O.Boxed<FuluIndexedAttestation_d.IndexedAttestation>:
  match o:
    case FuluAttesterSlashing_d.AttesterSlashing{x0, x1}: x1
def v_AttesterSlashing(o: FuluAttesterSlashing_d.AttesterSlashing) -> S.Value:
  match o:
    case FuluAttesterSlashing_d.AttesterSlashing{x0, x1}: S.Sequence{S.Items{v_IndexedAttestation_bx(x0), S.Items{v_IndexedAttestation_bx(x1), S.EmptyItems{}}}}
def d_AttesterSlashing(+hl: Nat, o: FuluAttesterSlashing_d.AttesterSlashing) -> D.Digest:
  match o:
    case FuluAttesterSlashing_d.AttesterSlashing{x0, x1}: MD.rtree(1n, True{}, hl, [d_IndexedAttestation_bx(hl, x0), d_IndexedAttestation_bx(hl, x1)], 0n)
def rep_AttesterSlashing(o: FuluAttesterSlashing_d.AttesterSlashing, +s: S.Schema) -> Data:
  DK.P2({o == FuluAttesterSlashing_d.AttesterSlashing{pj_AttesterSlashing_0(o), pj_AttesterSlashing_1(o)} : FuluAttesterSlashing_d.AttesterSlashing}, DK.P2(rep_IndexedAttestation_bx(pj_AttesterSlashing_0(o), SH.Chain_head(SH.Container_fields(s))), rep_IndexedAttestation_bx(pj_AttesterSlashing_1(o), SH.Chain_head(SH.Chain_tail(SH.Container_fields(s))))))
def ok_AttesterSlashing(+s: S.Schema, +dv: OS.DV) -> Bool: Bool.and(SH.is_Container(s), Bool.and(SH.is_Chain(SH.Container_fields(s)), Bool.and(SH.is_Chain(SH.Chain_tail(SH.Container_fields(s))), Bool.and(SH.is_End(SH.Chain_tail(SH.Chain_tail(SH.Container_fields(s)))), Bool.and(ok_IndexedAttestation_bx(SH.Chain_head(SH.Container_fields(s)), dv), ok_IndexedAttestation_bx(SH.Chain_head(SH.Chain_tail(SH.Container_fields(s))), dv))))))
def okc_AttesterSlashing(+s: S.Schema, +dv: OS.DV, +ok: {ok_AttesterSlashing(s, dv) == True{} : Bool}) -> {SH.is_Container(s) == True{} : Bool}: DK.and_l(SH.is_Container(s), Bool.and(SH.is_Chain(SH.Container_fields(s)), Bool.and(SH.is_Chain(SH.Chain_tail(SH.Container_fields(s))), Bool.and(SH.is_End(SH.Chain_tail(SH.Chain_tail(SH.Container_fields(s)))), Bool.and(ok_IndexedAttestation_bx(SH.Chain_head(SH.Container_fields(s)), dv), ok_IndexedAttestation_bx(SH.Chain_head(SH.Chain_tail(SH.Container_fields(s))), dv))))), ok)
def eqs_AttesterSlashing(+s: S.Schema) -> Data: DK.P2(eqs_IndexedAttestation(SH.Chain_head(SH.Container_fields(s))), eqs_IndexedAttestation(SH.Chain_head(SH.Chain_tail(SH.Container_fields(s)))))
