    {Fulu_list_Deposit_16_h.l16_Deposit_rt_fin(hl, N, _) == (h, (Fulu_list_Deposit_16_d.l16_Deposit_Seq{am_l16_Deposit(t), N}, xd_l16_Deposit(hl, Fulu_list_Deposit_16_d.l16_Deposit_Seq{am_l16_Deposit(t), N}))) : B.Buf & (Fulu_list_Deposit_16_d.l16_Deposit_Seq & D.Digest)}
