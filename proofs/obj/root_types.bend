# ---- box of ExecutionPayloadHeader ----
def pjb_ExecutionPayloadHeader_bx(o: O.Boxed<FuluExecutionPayloadHeader_d.ExecutionPayloadHeader>) -> FuluExecutionPayloadHeader_d.ExecutionPayloadHeader:
  match o:
    case O.BSome{v, rest}: v
    case O.BNone{}: FuluExecutionPayloadHeader_d.ExecutionPayloadHeader_default()
def v_ExecutionPayloadHeader_bx(o: O.Boxed<FuluExecutionPayloadHeader_d.ExecutionPayloadHeader>) -> S.Value:
  match o:
    case O.BSome{v, rest}: v_ExecutionPayloadHeader(v)
    case O.BNone{}: S.NullValue{}
def d_ExecutionPayloadHeader_bx(+hl: Nat, o: O.Boxed<FuluExecutionPayloadHeader_d.ExecutionPayloadHeader>) -> D.Digest:
  match o:
    case O.BSome{v, rest}: d_ExecutionPayloadHeader(hl, v)
    case O.BNone{}: D.zero()
def rep_ExecutionPayloadHeader_bx(o: O.Boxed<FuluExecutionPayloadHeader_d.ExecutionPayloadHeader>, +s: S.Schema) -> Data:
  DK.P2({o == O.BSome{pjb_ExecutionPayloadHeader_bx(o), O.BNone{}} : O.Boxed<FuluExecutionPayloadHeader_d.ExecutionPayloadHeader>}, rep_ExecutionPayloadHeader(pjb_ExecutionPayloadHeader_bx(o), s))
def st_ExecutionPayloadHeader_bx(+hl: Nat, -h: B.Buf, -o: O.Boxed<FuluExecutionPayloadHeader_d.ExecutionPayloadHeader>, +seg: U32, +s: S.Schema, +rep: rep_ExecutionPayloadHeader_bx(o, s))
    -> {FuluExecutionPayloadHeader_h.ExecutionPayloadHeader_bx_root(hl, h, o, seg) == (h, (o, d_ExecutionPayloadHeader_bx(hl, o))) : B.Buf & (O.Boxed<FuluExecutionPayloadHeader_d.ExecutionPayloadHeader> & D.Digest)}:
  (+eo, +ri) = rep
  %Equal.sym(O.Boxed<FuluExecutionPayloadHeader_d.ExecutionPayloadHeader>, o, O.BSome{pjb_ExecutionPayloadHeader_bx(o), O.BNone{}}, eo) :
    {FuluExecutionPayloadHeader_h.ExecutionPayloadHeader_bx_root(hl, h, _, seg) == (h, (_, d_ExecutionPayloadHeader_bx(hl, _))) : B.Buf & (O.Boxed<FuluExecutionPayloadHeader_d.ExecutionPayloadHeader> & D.Digest)}
  %Equal.sym(B.Buf & (FuluExecutionPayloadHeader_d.ExecutionPayloadHeader & D.Digest), FuluExecutionPayloadHeader_h.ExecutionPayloadHeader_root(hl, h, pjb_ExecutionPayloadHeader_bx(o), seg), (h, (pjb_ExecutionPayloadHeader_bx(o), d_ExecutionPayloadHeader(hl, pjb_ExecutionPayloadHeader_bx(o)))), st_ExecutionPayloadHeader(hl, h, pjb_ExecutionPayloadHeader_bx(o), seg, s, ri)) :
    {FuluExecutionPayloadHeader_h.ExecutionPayloadHeader_bx_rt(_) == (h, (O.BSome{pjb_ExecutionPayloadHeader_bx(o), O.BNone{}}, d_ExecutionPayloadHeader_bx(hl, O.BSome{pjb_ExecutionPayloadHeader_bx(o), O.BNone{}}))) : B.Buf & (O.Boxed<FuluExecutionPayloadHeader_d.ExecutionPayloadHeader> & D.Digest)}
  {==}
def rs_ExecutionPayloadHeader_bx(+hl: Nat, +ehl: {hl == 64n : Nat}, -h: B.Buf, -o: O.Boxed<FuluExecutionPayloadHeader_d.ExecutionPayloadHeader>, +s: S.Schema, +rep: rep_ExecutionPayloadHeader_bx(o, s), +dv: OS.DV, +edv: {dv == OS.DV0() : OS.DV}, +ok: {ok_ExecutionPayloadHeader(s, dv) == True{} : Bool}, +eq: eqs_ExecutionPayloadHeader(s))
    -> RR.roots(v_ExecutionPayloadHeader_bx(o), s, [D.bytes(d_ExecutionPayloadHeader_bx(hl, o))]):
  (+eo, +ri) = rep
  %Equal.sym(O.Boxed<FuluExecutionPayloadHeader_d.ExecutionPayloadHeader>, o, O.BSome{pjb_ExecutionPayloadHeader_bx(o), O.BNone{}}, eo) : RR.roots(v_ExecutionPayloadHeader_bx(_), s, [D.bytes(d_ExecutionPayloadHeader_bx(hl, _))])
  rs_ExecutionPayloadHeader(hl, ehl, h, pjb_ExecutionPayloadHeader_bx(o), s, ri, dv, edv, ok, eq)
def wd_ExecutionPayloadHeader_bx(+hl: Nat, -o: O.Boxed<FuluExecutionPayloadHeader_d.ExecutionPayloadHeader>, +s: S.Schema, +rep: rep_ExecutionPayloadHeader_bx(o, s)) -> OS.DW(d_ExecutionPayloadHeader_bx(hl, o)):
  (+eo, +ri) = rep
  %Equal.sym(O.Boxed<FuluExecutionPayloadHeader_d.ExecutionPayloadHeader>, o, O.BSome{pjb_ExecutionPayloadHeader_bx(o), O.BNone{}}, eo) : OS.DW(d_ExecutionPayloadHeader_bx(hl, _))
  wd_ExecutionPayloadHeader(hl, pjb_ExecutionPayloadHeader_bx(o), s, ri)
def ok_ExecutionPayloadHeader_bx(+s: S.Schema, +dv: OS.DV) -> Bool: ok_ExecutionPayloadHeader(s, dv)
def eqs_ExecutionPayloadHeader_bx(+s: S.Schema) -> Data: eqs_ExecutionPayloadHeader(s)

