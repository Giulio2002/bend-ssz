  OS.list_none(LV.xi_l8_Attestation(U32.to_nat(N), F.array__slots(LV.MB<LV.M_Attestation>, t), 0n), SH.ListOf_element(s), SH.ListOf_limit(s), [D.bytes(O.mix_len(hl, MD.rtree(3n, Nat.is_lt(0n, MD.dlen(xl_l8_Attestation(U32.to_nat(N), F.array__slots(LV.MB<LV.M_Attestation>, t), 0n, hl))), hl, xl_l8_Attestation(U32.to_nat(N), F.array__slots(LV.MB<LV.M_Attestation>, t), 0n, hl), 0n), N))], ebs,
