# Blob: for every byte storage object representing a value of Spec.Blob(),
# the runtime root is a specification root of its bytes.
def Blob_ok(+s: S.Schema, +es: {s == Spec.Blob() : S.Schema}) -> {WO_L.ok_bv(s, 12n) == True{} : Bool}:
  %Equal.sym(S.Schema, s, Spec.Blob(), es) : {WO_L.ok_bv(_, 12n) == True{} : Bool}
  LLF.bv_ok_at(Spec.Blob(), {==})
law Blob_root_correct:
  for -h: B.Buf
  for -o: O.Words
  for +s: S.Schema
  for +es: {s == Spec.Blob() : S.Schema}
  for +rep: WO_L.rep_bv(o, s)
  RR.roots(S.BytesValue{WO_L.wview(o)}, s, [D.bytes(Pair.snd(O.Words, D.Digest, Pair.snd(B.Buf, O.Words & D.Digest, FuluBlob_h.Blob_hash_tree_root(h, o))))])
def Blob_root_correct(h, o, s, es, rep):
  %Equal.sym(B.Buf & (O.Words & D.Digest), O.words_root(64n, h, o, 12, 0), (h, (o, WO_L.wdig(64n, o, 12n))), WO.bv_st(64n, h, o, 12, 0, 12n, WO.rep_wf(o, s, rep), {==})) :
    RR.roots(S.BytesValue{WO_L.wview(o)}, s, [D.bytes(Pair.snd(O.Words, D.Digest, Pair.snd(B.Buf, O.Words & D.Digest, _)))])
  WO.bv_rs(64n, {==}, h, o, s, 12n, 12, 0, rep, Blob_ok(s, es), {==}, {==})

