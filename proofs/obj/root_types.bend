          %Equal.sym(B.Buf & (O.Boxed<FuluAttestation_d.Attestation> & D.Digest), FuluAttestation_h.Attestation_bx_root(hl, h, th_Attestation_bx(xat_l8_Attestation(F.array__slots(MB<M_Attestation>, t), s)), (seg + 64 : U32)), (h, (th_Attestation_bx(xat_l8_Attestation(F.array__slots(MB<M_Attestation>, t), s)), d_Attestation_bx(hl, th_Attestation_bx(xat_l8_Attestation(F.array__slots(MB<M_Attestation>, t), s))))), st_Attestation_bx(hl, h, th_Attestation_bx(xat_l8_Attestation(F.array__slots(MB<M_Attestation>, t), s)), (seg + 64 : U32), sE, rx)) :
            {Fulu_list_Attestation_8_h.l8_Attestation_rl_n(U32.from_nat(s), am_l8_Attestation(F.array__upd(MB<M_Attestation>, dw, t, U32.to_nat(U32.from_nat(s)), MNone{})), _) == (h, (am_l8_Attestation(t), MD.rtree(0n, True{}, hl, xl_l8_Attestation(n, F.array__slots(MB<M_Attestation>, t), 0n, hl), s))) : B.Buf & (Array<O.Boxed<FuluAttestation_d.Attestation>> & D.Digest)}
