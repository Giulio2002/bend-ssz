            {(h, (am_l8_Attestation(t), d_Attestation_bx(hl, th_Attestation_bx(xat_l8_Attestation(F.array__slots(MB<M_Attestation>, t), s))))) == (h, (am_l8_Attestation(t), _)) : B.Buf & (Array<O.Boxed<FuluAttestation_d.Attestation>> & D.Digest)}
          %Equal.sym(Nat, Nat.add(s, 0n), s, MR.add_zero(s)) :
            {(h, (am_l8_Attestation(t), d_Attestation_bx(hl, th_Attestation_bx(xat_l8_Attestation(F.array__slots(MB<M_Attestation>, t), s))))) == (h, (am_l8_Attestation(t), d_Attestation_bx(hl, th_Attestation_bx(xat_l8_Attestation(F.array__slots(MB<M_Attestation>, t), _))))) : B.Buf & (Array<O.Boxed<FuluAttestation_d.Attestation>> & D.Digest)}
