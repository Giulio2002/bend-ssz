# Cell: for every byte storage object representing a value of Spec.Cell(),
# the runtime root is a specification root of its bytes.
def Cell_ok(+s: S.Schema, +es: {s == Spec.Cell() : S.Schema}) -> {WO_L.ok_bv(s, 6n) == True{} : Bool}:
  %Equal.sym(S.Schema, s, Spec.Cell(), es) : {WO_L.ok_bv(_, 6n) == True{} : Bool}
  {==}
law Cell_root_correct:
  for -h: B.Buf
  for -o: O.Words
  for +s: S.Schema
  for +es: {s == Spec.Cell() : S.Schema}
  for +rep: WO_L.rep_bv(o, s)
  RR.roots(S.BytesValue{WO_L.wview(o)}, s, [D.bytes(Pair.snd(O.Words, D.Digest, Pair.snd(B.Buf, O.Words & D.Digest, FuluCell_h.Cell_hash_tree_root(h, o))))])
def Cell_root_correct(h, o, s, es, rep):
  %Equal.sym(B.Buf & (O.Words & D.Digest), O.words_root(64n, h, o, 6, 0), (h, (o, WO_L.wdig(64n, o, 6n))), WO.bv_st(64n, h, o, 6, 0, 6n, WO.rep_wf(o, s, rep), {==})) :
    RR.roots(S.BytesValue{WO_L.wview(o)}, s, [D.bytes(Pair.snd(O.Words, D.Digest, Pair.snd(B.Buf, O.Words & D.Digest, _)))])
  WO.bv_rs(64n, {==}, h, o, s, 6n, 6, 0, rep, Cell_ok(s, es), {==}, {==})

