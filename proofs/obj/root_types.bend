def st_DataColumnSidecar(+hl: Nat, -h: B.Buf, -o: FuluDataColumnSidecar_d.DataColumnSidecar, +seg: U32, +s: S.Schema, +rep: rep_DataColumnSidecar(o, s))
    -> {FuluDataColumnSidecar_h.DataColumnSidecar_root(hl, h, o, seg) == (h, (o, d_DataColumnSidecar(hl, o))) : B.Buf & (FuluDataColumnSidecar_d.DataColumnSidecar & D.Digest)}:
  (+x0, +q0) = rep
  (+eo, +q1) = q0
  (+rp1, +q2) = q1
  (+rp2, +q3) = q2
  (+rp3, +q4) = q3
  (+rp4, +q5) = q4
