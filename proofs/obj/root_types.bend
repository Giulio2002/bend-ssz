      CE.ev_st(hl, h, O.Words{F.array__thaw(U32, t), N}, 12, seg, 12n, (t, (dw, (N, ({==}, (pf, (hd, room)))))), {==})) :
    {Fulu_list_bytevec_2048_4096_h.l4096_b2048_mix(hl, _) == (h, (O.Words{F.array__thaw(U32, t), N}, CE.ldig(hl, O.Words{F.array__thaw(U32, t), N}, 12n))) : B.Buf & (O.Words & D.Digest)}
  {==}

