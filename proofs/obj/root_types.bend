  match o:
    case FuluLightClientBootstrap_d.LightClientBootstrap{x0, x1, x2}: MD.rtree(2n, True{}, hl, [d_LightClientHeader(hl, x0), d_SyncCommittee(hl, x1), WO_L.wdig(hl, x2, 3n)], 0n)
def ok_LightClientBootstrap(+s: S.Schema, +dv: OS.DV) -> Bool: Bool.and(SH.is_Container(s), Bool.and(SH.is_Chain(SH.Container_fields(s)), Bool.and(SH.is_Chain(SH.Chain_tail(SH.Container_fields(s))), Bool.and(SH.is_Chain(SH.Chain_tail(SH.Chain_tail(SH.Container_fields(s)))), Bool.and(SH.is_End(SH.Chain_tail(SH.Chain_tail(SH.Chain_tail(SH.Container_fields(s))))), Bool.and(ok_LightClientHeader(SH.Chain_head(SH.Container_fields(s)), dv), Bool.and(ok_SyncCommittee(SH.Chain_head(SH.Chain_tail(SH.Container_fields(s))), dv), PV_L.ok_pv(SH.Chain_head(SH.Chain_tail(SH.Chain_tail(SH.Container_fields(s)))), 3n))))))))
def okc_LightClientBootstrap(+s: S.Schema, +dv: OS.DV, +ok: {ok_LightClientBootstrap(s, dv) == True{} : Bool}) -> {SH.is_Container(s) == True{} : Bool}: DK.and_l(SH.is_Container(s), Bool.and(SH.is_Chain(SH.Container_fields(s)), Bool.and(SH.is_Chain(SH.Chain_tail(SH.Container_fields(s))), Bool.and(SH.is_Chain(SH.Chain_tail(SH.Chain_tail(SH.Container_fields(s)))), Bool.and(SH.is_End(SH.Chain_tail(SH.Chain_tail(SH.Chain_tail(SH.Container_fields(s))))), Bool.and(ok_LightClientHeader(SH.Chain_head(SH.Container_fields(s)), dv), Bool.and(ok_SyncCommittee(SH.Chain_head(SH.Chain_tail(SH.Container_fields(s))), dv), PV_L.ok_pv(SH.Chain_head(SH.Chain_tail(SH.Chain_tail(SH.Container_fields(s)))), 3n))))))), ok)
