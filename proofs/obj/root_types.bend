def pj_BlobSidecar_5(o: FuluBlobSidecar_d.BlobSidecar) -> O.Words:
  match o:
    case FuluBlobSidecar_d.BlobSidecar{+x0, x1, +x2, +x3, x4, x5}: x5
def v_BlobSidecar(o: FuluBlobSidecar_d.BlobSidecar) -> S.Value:
  match o:
    case FuluBlobSidecar_d.BlobSidecar{+x0, x1, +x2, +x3, x4, x5}: S.Sequence{S.Items{RN_L.v_u64(x0), S.Items{S.BytesValue{WO_L.wview(x1)}, S.Items{RN_L.v_b48(x2), S.Items{RN_L.v_b48(x3), S.Items{v_SignedBeaconBlockHeader_bx(x4), S.Items{PV.pview(x5), S.EmptyItems{}}}}}}}}
