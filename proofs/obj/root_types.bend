def okI_Attestation(+s: S.Schema, +dv: OS.DV, +h0: {SH.is_Container(s) == True{} : Bool}, +h1: {SH.is_Chain(SH.Container_fields(s)) == True{} : Bool}, +h2: {SH.is_Chain(SH.Chain_tail(SH.Container_fields(s))) == True{} : Bool}, +h3: {SH.is_Chain(SH.Chain_tail(SH.Chain_tail(SH.Container_fields(s)))) == True{} : Bool}, +h4: {SH.is_Chain(SH.Chain_tail(SH.Chain_tail(SH.Chain_tail(SH.Container_fields(s))))) == True{} : Bool}, +h5: {SH.is_End(SH.Chain_tail(SH.Chain_tail(SH.Chain_tail(SH.Chain_tail(SH.Container_fields(s)))))) == True{} : Bool}, +h6: {BO_L.ok_bits(SH.Chain_head(SH.Container_fields(s)), 9n) == True{} : Bool}) -> {ok_Attestation(s, dv) == True{} : Bool}:
