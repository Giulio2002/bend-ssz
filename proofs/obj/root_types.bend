    case FuluBlobSidecar_d.BlobSidecar{+x0, x1, +x2, +x3, x4, x5}: MD.rtree(3n, True{}, hl, [RN.d_u64(hl, x0), WO_L.wdig(hl, x1, 12n), RN.d_b48(hl, x2), RN.d_b48(hl, x3), d_SignedBeaconBlockHeader_bx(hl, x4), WO_L.wdig(hl, x5, 5n)], 0n)
def rep_BlobSidecar(o: FuluBlobSidecar_d.BlobSidecar, +s: S.Schema) -> Data:
