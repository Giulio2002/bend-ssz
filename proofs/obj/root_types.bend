    RR.roots(S.Sequence{xi_l8_Attestation(U32.to_nat(N), F.array__slots(MB<M_Attestation>, _), 0n)}, S.ListOf{SH.ListOf_element(s), SH.ListOf_limit(s)}, [D.bytes(O.mix_len(hl, MD.rtree(3n, Nat.is_lt(0n, U32.to_nat(N)), hl, xl_l8_Attestation(U32.to_nat(N), F.array__slots(MB<M_Attestation>, _), 0n, hl), 0n), N))])
