    {FuluPendingAttestation_h.PendingAttestation_rt0(hl, seg, x1, x2, x3, _) == (h, (FuluPendingAttestation_d.PendingAttestation{pj_PendingAttestation_0(o), x1, x2, x3}, d_PendingAttestation(hl, FuluPendingAttestation_d.PendingAttestation{pj_PendingAttestation_0(o), x1, x2, x3}))) : B.Buf & (FuluPendingAttestation_d.PendingAttestation & D.Digest)}
  %Equal.sym(B.Buf & D.Digest, FuluAttestationData_h.AttestationData_root(hl, h, x1, seg), (h, RN.d_AttestationData(hl, x1)), RN.st_AttestationData(hl, h, x1, seg)) :
