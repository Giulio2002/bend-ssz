  OS.list_none(xi_l8_Attestation(U32.to_nat(N), F.array__slots(MB<M_Attestation>, t), 0n), SH.ListOf_element(s), SH.ListOf_limit(s), [D.bytes(O.mix_len(hl, MD.rtree(3n, Nat.is_lt(0n, MD.dlen(xl_l8_Attestation(U32.to_nat(N), F.array__slots(MB<M_Attestation>, t), 0n, hl))), hl, xl_l8_Attestation(U32.to_nat(N), F.array__slots(MB<M_Attestation>, t), 0n, hl), 0n), N))], ebs,
  (MD.bytes_list(xl_l8_Attestation(U32.to_nat(N), F.array__slots(MB<M_Attestation>, t), 0n, hl)), (xroots_l8_Attestation(U32.to_nat(N), F.array__slots(MB<M_Attestation>, t), 0n, hl, ehl, h, SH.ListOf_element(s), er, dv, edv, kel, eq),
    (D.bytes(MD.rtree(3n, Nat.is_lt(0n, MD.dlen(xl_l8_Attestation(U32.to_nat(N), F.array__slots(MB<M_Attestation>, t), 0n, hl))), hl, xl_l8_Attestation(U32.to_nat(N), F.array__slots(MB<M_Attestation>, t), 0n, hl), 0n)), ((3n, (kmin, RS.at_depth_tree(SH.ListOf_limit(s), 3n, hl, xl_l8_Attestation(U32.to_nat(N), F.array__slots(MB<M_Attestation>, t), 0n, hl), {==}, xhl_l8_Attestation(N, SH.ListOf_limit(s), F.array__slots(MB<M_Attestation>, t), hl, hvN), ehl))),
