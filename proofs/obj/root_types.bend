def wd_IndexedAttestation_bx(+hl: Nat, -o: O.Boxed<FuluIndexedAttestation_d.IndexedAttestation>, +s: S.Schema, +rep: LV.rep_IndexedAttestation_bx(o, s)) -> OS.DW(d_IndexedAttestation_bx(hl, o)):
