    {FuluIndexedAttestation_h.IndexedAttestation_root(hl, h, _, seg) == (h, (_, d_IndexedAttestation(hl, _))) : B.Buf & (FuluIndexedAttestation_d.IndexedAttestation & D.Digest)}
