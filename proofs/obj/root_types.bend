def st_Attestation(+hl: Nat, -h: B.Buf, -o: FuluAttestation_d.Attestation, +seg: U32, +s: S.Schema, +rep: LV.rep_Attestation(o, s))
    -> {FuluAttestation_h.Attestation_root(hl, h, o, seg) == (h, (o, d_Attestation(hl, o))) : B.Buf & (FuluAttestation_d.Attestation & D.Digest)}:
  (+x1, +q0) = rep
  (+x2, +q1) = q0
  (+x3, +q2) = q1
  (+eo, +q3) = q2
  %Equal.sym(FuluAttestation_d.Attestation, o, FuluAttestation_d.Attestation{LV.pj_Attestation_0(o), x1, x2, x3}, eo) :
    {FuluAttestation_h.Attestation_root(hl, h, _, seg) == (h, (_, d_Attestation(hl, _))) : B.Buf & (FuluAttestation_d.Attestation & D.Digest)}
  %Equal.sym(B.Buf & (O.Bits & D.Digest), Fulu_bitlist_131072_h.bits131072_root(hl, h, LV.pj_Attestation_0(o), seg), (h, (LV.pj_Attestation_0(o), BO.bdig(hl, LV.pj_Attestation_0(o), 9n))), BO.bst(hl, h, LV.pj_Attestation_0(o), 9, seg, 9n, BO_L.rep_wf(LV.pj_Attestation_0(o), SH.Chain_head(SH.Container_fields(s)), q3), {==})) :
    {FuluAttestation_h.Attestation_rt0(hl, seg, x1, x2, x3, _) == (h, (FuluAttestation_d.Attestation{LV.pj_Attestation_0(o), x1, x2, x3}, d_Attestation(hl, FuluAttestation_d.Attestation{LV.pj_Attestation_0(o), x1, x2, x3}))) : B.Buf & (FuluAttestation_d.Attestation & D.Digest)}
  %Equal.sym(B.Buf & D.Digest, FuluAttestationData_h.AttestationData_root(hl, h, x1, seg), (h, RN.d_AttestationData(hl, x1)), RN.st_AttestationData(hl, h, x1, seg)) :
    {FuluAttestation_h.Attestation_rt1(hl, seg, LV.pj_Attestation_0(o), x1, x2, x3, BO.bdig(hl, LV.pj_Attestation_0(o), 9n), _) == (h, (FuluAttestation_d.Attestation{LV.pj_Attestation_0(o), x1, x2, x3}, d_Attestation(hl, FuluAttestation_d.Attestation{LV.pj_Attestation_0(o), x1, x2, x3}))) : B.Buf & (FuluAttestation_d.Attestation & D.Digest)}
  %Equal.sym(B.Buf & D.Digest, FuluBytes96_h.b96_root(hl, h, x2, seg), (h, RN.d_b96(hl, x2)), RN.st_b96(hl, h, x2, seg)) :
    {FuluAttestation_h.Attestation_rt2(hl, seg, LV.pj_Attestation_0(o), x1, x2, x3, BO.bdig(hl, LV.pj_Attestation_0(o), 9n), RN.d_AttestationData(hl, x1), _) == (h, (FuluAttestation_d.Attestation{LV.pj_Attestation_0(o), x1, x2, x3}, d_Attestation(hl, FuluAttestation_d.Attestation{LV.pj_Attestation_0(o), x1, x2, x3}))) : B.Buf & (FuluAttestation_d.Attestation & D.Digest)}
