    RR.roots(S.Sequence{LV.xi_l16_Deposit(U32.to_nat(N), F.array__slots(LV.MB<LV.M_Deposit>, _), 0n)}, S.ListOf{SH.ListOf_element(s), SH.ListOf_limit(s)}, [D.bytes(O.mix_len(hl, MD.rtree(4n, Nat.is_lt(0n, U32.to_nat(N)), hl, xl_l16_Deposit(U32.to_nat(N), F.array__slots(LV.MB<LV.M_Deposit>, _), 0n, hl), 0n), N))])
  %xlen_l16_Deposit(U32.to_nat(N), F.array__slots(LV.MB<LV.M_Deposit>, t), 0n, hl) :
    RR.roots(S.Sequence{LV.xi_l16_Deposit(U32.to_nat(N), F.array__slots(LV.MB<LV.M_Deposit>, t), 0n)}, S.ListOf{SH.ListOf_element(s), SH.ListOf_limit(s)}, [D.bytes(O.mix_len(hl, MD.rtree(4n, Nat.is_lt(0n, _), hl, xl_l16_Deposit(U32.to_nat(N), F.array__slots(LV.MB<LV.M_Deposit>, t), 0n, hl), 0n), N))])
  OS.list_none(LV.xi_l16_Deposit(U32.to_nat(N), F.array__slots(LV.MB<LV.M_Deposit>, t), 0n), SH.ListOf_element(s), SH.ListOf_limit(s), [D.bytes(O.mix_len(hl, MD.rtree(4n, Nat.is_lt(0n, MD.dlen(xl_l16_Deposit(U32.to_nat(N), F.array__slots(LV.MB<LV.M_Deposit>, t), 0n, hl))), hl, xl_l16_Deposit(U32.to_nat(N), F.array__slots(LV.MB<LV.M_Deposit>, t), 0n, hl), 0n), N))], ebs,
  (MD.bytes_list(xl_l16_Deposit(U32.to_nat(N), F.array__slots(LV.MB<LV.M_Deposit>, t), 0n, hl)), (xroots_l16_Deposit(U32.to_nat(N), F.array__slots(LV.MB<LV.M_Deposit>, t), 0n, hl, ehl, h, SH.ListOf_element(s), er, dv, edv, kel, eq),
    (D.bytes(MD.rtree(4n, Nat.is_lt(0n, MD.dlen(xl_l16_Deposit(U32.to_nat(N), F.array__slots(LV.MB<LV.M_Deposit>, t), 0n, hl))), hl, xl_l16_Deposit(U32.to_nat(N), F.array__slots(LV.MB<LV.M_Deposit>, t), 0n, hl), 0n)), ((4n, (kmin, RS.at_depth_tree(SH.ListOf_limit(s), 4n, hl, xl_l16_Deposit(U32.to_nat(N), F.array__slots(LV.MB<LV.M_Deposit>, t), 0n, hl), {==}, xhl_l16_Deposit(N, SH.ListOf_limit(s), F.array__slots(LV.MB<LV.M_Deposit>, t), hl, hvN), ehl))),
     xlm_l16_Deposit(hl, ehl, N, MD.rtree(4n, Nat.is_lt(0n, MD.dlen(xl_l16_Deposit(U32.to_nat(N), F.array__slots(LV.MB<LV.M_Deposit>, t), 0n, hl))), hl, xl_l16_Deposit(U32.to_nat(N), F.array__slots(LV.MB<LV.M_Deposit>, t), 0n, hl), 0n), F.array__slots(LV.MB<LV.M_Deposit>, t)))))))

def xl_l16_SignedVoluntaryExit(k: Nat, +W: List<&2, FuluSignedVoluntaryExit_d.SignedVoluntaryExit>, +i: Nat, +hl: Nat) -> List<&2, D.Digest>:
  match k:
    case 0n: []
    case 1n+q: RN.d_SignedVoluntaryExit(hl, LV.xat_l16_SignedVoluntaryExit(W, i)) <> xl_l16_SignedVoluntaryExit(q, W, 1n+i, hl)
law xlen_l16_SignedVoluntaryExit:
  for +k: Nat
  for +W: List<&2, FuluSignedVoluntaryExit_d.SignedVoluntaryExit>
  for +i: Nat
  for +hl: Nat
  {MD.dlen(xl_l16_SignedVoluntaryExit(k, W, i, hl)) == k : Nat}
def xlen_l16_SignedVoluntaryExit(k, W, i, hl):
  match k:
    case 0n: {==}
    case 1n+ +q:
      %xlen_l16_SignedVoluntaryExit(q, W, 1n+i, hl) : {1n+MD.dlen(xl_l16_SignedVoluntaryExit(q, W, 1n+i, hl)) == 1n+_ : Nat}
      {==}
law xat_at_l16_SignedVoluntaryExit:
  for +s: Nat
  for +k: Nat
  for +W: List<&2, FuluSignedVoluntaryExit_d.SignedVoluntaryExit>
  for +i: Nat
  for +hl: Nat
  for +e: {Nat.is_lt(s, k) == True{} : Bool}
  {MD.dhead(MD.ddrop(s, xl_l16_SignedVoluntaryExit(k, W, i, hl))) == RN.d_SignedVoluntaryExit(hl, LV.xat_l16_SignedVoluntaryExit(W, Nat.add(s, i))) : D.Digest}
def xat_at_l16_SignedVoluntaryExit(s, k, W, i, hl, e):
  match s:
    case 0n:
      match k:
        case 0n: Empty.absurd({MD.dhead(MD.ddrop(0n, xl_l16_SignedVoluntaryExit(0n, W, i, hl))) == RN.d_SignedVoluntaryExit(hl, LV.xat_l16_SignedVoluntaryExit(W, Nat.add(0n, i))) : D.Digest}, MD.false_true(e))
        case 1n+q: {==}
    case 1n+ +p1:
      match k:
