    {FuluAttestation_h.Attestation_rt1(hl, seg, pj_Attestation_0(o), x1, x2, x3, BO.bdig(hl, pj_Attestation_0(o), 9n), _) == (h, (FuluAttestation_d.Attestation{pj_Attestation_0(o), x1, x2, x3}, d_Attestation(hl, FuluAttestation_d.Attestation{pj_Attestation_0(o), x1, x2, x3}))) : B.Buf & (FuluAttestation_d.Attestation & D.Digest)}
