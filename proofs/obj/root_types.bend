ields(s)))))), BO_L.ok_bits(SH.Chain_head(SH.Container_fields(s)), 9n), h5, h6))))))
def Attestation_ok(+s: S.Schema, +es: {s == Spec.Attestation() : S.Schema}, +dv: OS.DV, +edv: {dv == OS.DV0() : OS.DV}) -> {ok_Attestation(s, dv) == True{} : Bool}:
  OS.ok_at(y => d => ok_Attestation(y, d), s, Spec.Attestation(), dv, es, edv, okI_Attestation(Spec.Attestation(), OS.DV0(), {==}, {==}, {==}, {==}, {==}, {==}, LLF.bits_ok_at(SH.Chain_head(SH.Container_fields(Spec.Attestation())), {==})))
def Attestation_eqs(+s: S.Schema, +es: {s == Spec.Attestation() : S.Schema}) -> eqs_Attestation(s): (OS.eq_at(y => SH.Chain_head(SH.Chain_tail(SH.Container_fields(y))), s, Spec.Attestation(), S.Container{["slot", "index", "beacon_block_root", "source", "target"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{32n}, S.Chain{S.Container{["epoch", "root"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{32n}, S.End{}}}}, S.Chain{S.Container{["epoch", "root"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{32n}, S.End{}}}}, S.End{}}}}}}}, es, {==}), (OS.eq_at(y => SH.Chain_head(SH.Chain_tail(SH.Chain_tail(SH.Container_fields(y)))), s, Spec.Attestation(), S.ByteVector{96n}, es, {==}), OS.eq_at(y => SH.Chain_head(SH.Chain_tail(SH.Chain_tail(SH.Chain_tail(SH.Container_fields(y))))), s, Spec.Attestation(), S.BitVector{64n}, es, {==})))
