    case FuluIndexedAttestation_d.IndexedAttestation{x0, +x1, +x2}: MD.rtree(2n, True{}, hl, [UL.udig(hl, x0, 15n), RN.d_AttestationData(hl, x1), RN.d_b96(hl, x2)], 0n)
