# Public Base entry points. Premises: the tree is perfect of depth d < 32 and
# the index is below 2^d; x is the value currently stored at that index.
def amswap_l16_Deposit(+d: Nat, +t: F.array__Tree<MB<M_Deposit>>, +i: U32, +v: MB<M_Deposit>, +x: MB<M_Deposit>, +hd: {Nat.is_lt(d, 32n) == True{} : Bool}, +hi: {Nat.is_lt(U32.to_nat(i), F.spec_common__pow2(d)) == True{} : Bool}, +hx: {F.spec_common__nth(MB<M_Deposit>, F.array__slots(MB<M_Deposit>, t), U32.to_nat(i)) == Some{x} : Maybe<&2, MB<M_Deposit>>}, +pf: {F.array__perfect(MB<M_Deposit>, d, t) == True{} : Bool}) -> {Array.swap(O.Boxed<FuluDeposit_d.Deposit>, am_l16_Deposit(t), i, th_Deposit_bx(v)) == (am_l16_Deposit(F.array__upd(MB<M_Deposit>, d, t, U32.to_nat(i), v)), th_Deposit_bx(x)) : Array<O.Boxed<FuluDeposit_d.Deposit>> & O.Boxed<FuluDeposit_d.Deposit>}:
  %Equal.sym(Array<O.Boxed<FuluDeposit_d.Deposit>> & U32, Array.size(O.Boxed<FuluDeposit_d.Deposit>, am_l16_Deposit(t)), (am_l16_Deposit(t), F.u32__pow2u(d)), amsize_l16_Deposit(d, t, pf)) : {Array.swap.at(O.Boxed<FuluDeposit_d.Deposit>, i, th_Deposit_bx(v), _) == (am_l16_Deposit(F.array__upd(MB<M_Deposit>, d, t, U32.to_nat(i), v)), th_Deposit_bx(x)) : Array<O.Boxed<FuluDeposit_d.Deposit>> & O.Boxed<FuluDeposit_d.Deposit>}
  %Equal.sym(U32, U32.and(i, U32.sub(F.u32__pow2u(d), 1)), i, F.u32__mask_pow2u(i, d, hd, hi)) : {Array.swap.go(O.Boxed<FuluDeposit_d.Deposit>, am_l16_Deposit(t), F.u32__pow2u(d), _, th_Deposit_bx(v)) == (am_l16_Deposit(F.array__upd(MB<M_Deposit>, d, t, U32.to_nat(i), v)), th_Deposit_bx(x)) : Array<O.Boxed<FuluDeposit_d.Deposit>> & O.Boxed<FuluDeposit_d.Deposit>}
  amswap_go_l16_Deposit(d, t, i, v, x, hd, hi, hx, U32.is_lt(i, F.u32__pow2u(F.nat__pred(d))), {==}, pf)

def amset_l16_Deposit(+d: Nat, +t: F.array__Tree<MB<M_Deposit>>, +i: U32, +v: MB<M_Deposit>, +x: MB<M_Deposit>, +hd: {Nat.is_lt(d, 32n) == True{} : Bool}, +hi: {Nat.is_lt(U32.to_nat(i), F.spec_common__pow2(d)) == True{} : Bool}, +hx: {F.spec_common__nth(MB<M_Deposit>, F.array__slots(MB<M_Deposit>, t), U32.to_nat(i)) == Some{x} : Maybe<&2, MB<M_Deposit>>}, +pf: {F.array__perfect(MB<M_Deposit>, d, t) == True{} : Bool}) -> {Array.set(O.Boxed<FuluDeposit_d.Deposit>, am_l16_Deposit(t), i, th_Deposit_bx(v)) == am_l16_Deposit(F.array__upd(MB<M_Deposit>, d, t, U32.to_nat(i), v)) : Array<O.Boxed<FuluDeposit_d.Deposit>>}:
  %Equal.sym(Array<O.Boxed<FuluDeposit_d.Deposit>> & O.Boxed<FuluDeposit_d.Deposit>, Array.swap(O.Boxed<FuluDeposit_d.Deposit>, am_l16_Deposit(t), i, th_Deposit_bx(v)), (am_l16_Deposit(F.array__upd(MB<M_Deposit>, d, t, U32.to_nat(i), v)), th_Deposit_bx(x)), amswap_l16_Deposit(d, t, i, v, x, hd, hi, hx, pf)) : {Array.set.fin(O.Boxed<FuluDeposit_d.Deposit>, _) == am_l16_Deposit(F.array__upd(MB<M_Deposit>, d, t, U32.to_nat(i), v)) : Array<O.Boxed<FuluDeposit_d.Deposit>>}
  {==}

# Swap an element out (replaced by th_Deposit_bx(z)), then set th_Deposit_bx(x) back: the array is
# unchanged. This is the leaf step of every tree over such a list.
def amswap_back_l16_Deposit(+d: Nat, +t: F.array__Tree<MB<M_Deposit>>, +i: U32, +z: MB<M_Deposit>, +x: MB<M_Deposit>,
    +hd: {Nat.is_lt(d, 32n) == True{} : Bool},
    +hi: {Nat.is_lt(U32.to_nat(i), F.spec_common__pow2(d)) == True{} : Bool},
    +hx: {F.spec_common__nth(MB<M_Deposit>, F.array__slots(MB<M_Deposit>, t), U32.to_nat(i)) == Some{x} : Maybe<&2, MB<M_Deposit>>},
    +pf: {F.array__perfect(MB<M_Deposit>, d, t) == True{} : Bool})
    -> {Array.set(O.Boxed<FuluDeposit_d.Deposit>, am_l16_Deposit(F.array__upd(MB<M_Deposit>, d, t, U32.to_nat(i), z)), i, th_Deposit_bx(x)) == am_l16_Deposit(t) : Array<O.Boxed<FuluDeposit_d.Deposit>>}:
  +t2 = F.array__upd(MB<M_Deposit>, d, t, U32.to_nat(i), z)
  +hz = F.logic__subst(List<&2, MB<M_Deposit>>, ys => {F.spec_common__nth(MB<M_Deposit>, ys, U32.to_nat(i)) == Some{z} : Maybe<&2, MB<M_Deposit>>}, F.spec_common__update(MB<M_Deposit>, F.array__slots(MB<M_Deposit>, t), U32.to_nat(i), z), F.array__slots(MB<M_Deposit>, t2),
    Equal.sym(List<&2, MB<M_Deposit>>, F.array__slots(MB<M_Deposit>, t2), F.spec_common__update(MB<M_Deposit>, F.array__slots(MB<M_Deposit>, t), U32.to_nat(i), z), F.array__upd_slots(MB<M_Deposit>, d, t, U32.to_nat(i), z, hi, pf)),
    F.list__nth_update_same(MB<M_Deposit>, F.array__slots(MB<M_Deposit>, t), U32.to_nat(i), z, F.list__nth_lt_length(MB<M_Deposit>, F.array__slots(MB<M_Deposit>, t), U32.to_nat(i), x, hx)))
  %Equal.sym(Array<O.Boxed<FuluDeposit_d.Deposit>>, Array.set(O.Boxed<FuluDeposit_d.Deposit>, am_l16_Deposit(t2), i, th_Deposit_bx(x)), am_l16_Deposit(F.array__upd(MB<M_Deposit>, d, t2, U32.to_nat(i), x)),
      amset_l16_Deposit(d, t2, i, x, z, hd, hi, hz, F.array__upd_perfect(MB<M_Deposit>, d, t, U32.to_nat(i), z, pf))) :
    {_ == am_l16_Deposit(t) : Array<O.Boxed<FuluDeposit_d.Deposit>>}
  %Equal.sym(F.array__Tree<MB<M_Deposit>>, F.array__upd(MB<M_Deposit>, d, t2, U32.to_nat(i), x), t, AM.upd_restore(MB<M_Deposit>, d, t, U32.to_nat(i), z, x, hi, hx, pf)) :
    {am_l16_Deposit(_) == am_l16_Deposit(t) : Array<O.Boxed<FuluDeposit_d.Deposit>>}
  {==}
def xat_l16_Deposit(W: List<&2, MB<M_Deposit>>, +i: Nat) -> MB<M_Deposit>:
  match W:
    case Nil{}: MNone{}
    case Con{+x, t}:
      match i:
        case 0n: x
        case 1n+j: xat_l16_Deposit(t, j)
law nth_l16_Deposit:
  for +W: List<&2, MB<M_Deposit>>
  for +i: Nat
  for +hi: {Nat.is_lt(i, F.spec_common__length(MB<M_Deposit>, W)) == True{} : Bool}
  {F.spec_common__nth(MB<M_Deposit>, W, i) == Some{xat_l16_Deposit(W, i)} : Maybe<&2, MB<M_Deposit>>}
def nth_l16_Deposit(W, i, hi):
  match W:
    case Nil{}: Empty.absurd({F.spec_common__nth(MB<M_Deposit>, Nil{}, i) == Some{xat_l16_Deposit(Nil{}, i)} : Maybe<&2, MB<M_Deposit>>}, MD.false_true(Equal.trans(Bool, False{}, Nat.is_lt(i, 0n), True{}, Equal.sym(Bool, Nat.is_lt(i, 0n), False{}, F.nat__not_lt_zero(i)), hi)))
    case Con{+x, +t}:
      match i:
        case 0n: {==}
        case 1n+ +j: nth_l16_Deposit(t, j, hi)
def xl_l16_Deposit(k: Nat, +W: List<&2, MB<M_Deposit>>, +i: Nat, +hl: Nat) -> List<&2, D.Digest>:
  match k:
    case 0n: []
    case 1n+q: d_Deposit_bx(hl, th_Deposit_bx(xat_l16_Deposit(W, i))) <> xl_l16_Deposit(q, W, 1n+i, hl)
law xlen_l16_Deposit:
  for +k: Nat
  for +W: List<&2, MB<M_Deposit>>
  for +i: Nat
  for +hl: Nat
  {MD.dlen(xl_l16_Deposit(k, W, i, hl)) == k : Nat}
def xlen_l16_Deposit(k, W, i, hl):
  match k:
    case 0n: {==}
    case 1n+ +q:
      %xlen_l16_Deposit(q, W, 1n+i, hl) : {1n+MD.dlen(xl_l16_Deposit(q, W, 1n+i, hl)) == 1n+_ : Nat}
      {==}
law xat_at_l16_Deposit:
  for +s: Nat
  for +k: Nat
  for +W: List<&2, MB<M_Deposit>>
  for +i: Nat
  for +hl: Nat
  for +e: {Nat.is_lt(s, k) == True{} : Bool}
  {MD.dhead(MD.ddrop(s, xl_l16_Deposit(k, W, i, hl))) == d_Deposit_bx(hl, th_Deposit_bx(xat_l16_Deposit(W, Nat.add(s, i)))) : D.Digest}
def xat_at_l16_Deposit(s, k, W, i, hl, e):
  match s:
    case 0n:
      match k:
        case 0n: Empty.absurd({MD.dhead(MD.ddrop(0n, xl_l16_Deposit(0n, W, i, hl))) == d_Deposit_bx(hl, th_Deposit_bx(xat_l16_Deposit(W, Nat.add(0n, i)))) : D.Digest}, MD.false_true(e))
        case 1n+q: {==}
    case 1n+ +p1:
      match k:
        case 0n: Empty.absurd({MD.dhead(MD.ddrop(1n+p1, xl_l16_Deposit(0n, W, i, hl))) == d_Deposit_bx(hl, th_Deposit_bx(xat_l16_Deposit(W, Nat.add(1n+p1, i)))) : D.Digest}, MD.false_true(e))
        case 1n+ +q:
          %MR.add_succ(p1, i) : {MD.dhead(MD.ddrop(p1, xl_l16_Deposit(q, W, 1n+i, hl))) == d_Deposit_bx(hl, th_Deposit_bx(xat_l16_Deposit(W, _))) : D.Digest}
          xat_at_l16_Deposit(p1, q, W, 1n+i, hl, e)
def ereps_l16_Deposit(k: Nat, +W: List<&2, MB<M_Deposit>>, +i: Nat, +sE: S.Schema) -> Data:
  match k:
    case 0n: {True{} == True{} : Bool}
    case 1n+q: DK.P2(rep_Deposit_bx(th_Deposit_bx(xat_l16_Deposit(W, i)), sE), ereps_l16_Deposit(q, W, 1n+i, sE))
def erep_at_l16_Deposit(+s: Nat, +k: Nat, +W: List<&2, MB<M_Deposit>>, +i: Nat, +sE: S.Schema, +er: ereps_l16_Deposit(k, W, i, sE), +e: {Nat.is_lt(s, k) == True{} : Bool})
    -> rep_Deposit_bx(th_Deposit_bx(xat_l16_Deposit(W, Nat.add(s, i))), sE):
  match s:
    case 0n:
      match k:
        case 0n: Empty.absurd(rep_Deposit_bx(th_Deposit_bx(xat_l16_Deposit(W, Nat.add(0n, i))), sE), MD.false_true(e))
        case 1n+q:
          (+r0, +rs) = er
          r0
    case 1n+ +p1:
      match k:
        case 0n: Empty.absurd(rep_Deposit_bx(th_Deposit_bx(xat_l16_Deposit(W, Nat.add(1n+p1, i))), sE), MD.false_true(e))
        case 1n+ +q:
          (+r0, +rs) = er
          %MR.add_succ(p1, i) : rep_Deposit_bx(th_Deposit_bx(xat_l16_Deposit(W, _)), sE)
          erep_at_l16_Deposit(p1, q, W, 1n+i, sE, rs, e)
def xi_l16_Deposit(k: Nat, +W: List<&2, MB<M_Deposit>>, +i: Nat) -> S.Value:
  match k:
    case 0n: S.EmptyItems{}
    case 1n+q: S.Items{v_Deposit_bx(th_Deposit_bx(xat_l16_Deposit(W, i))), xi_l16_Deposit(q, W, 1n+i)}
law xroots_l16_Deposit:
  for +k: Nat
  for +W: List<&2, MB<M_Deposit>>
  for +i: Nat
  for +hl: Nat
  for +ehl: {hl == 64n : Nat}
  for -h: B.Buf
  for +sE: S.Schema
  for +er: ereps_l16_Deposit(k, W, i, sE)
  for +dv: OS.DV
  for +edv: {dv == OS.DV0() : OS.DV}
  for +ok: {ok_Deposit_bx(sE, dv) == True{} : Bool}
  for +eq: eqs_Deposit_bx(sE)
  RR.roots(xi_l16_Deposit(k, W, i), S.Repeat{sE}, MD.bytes_list(xl_l16_Deposit(k, W, i, hl)))
def xroots_l16_Deposit(k, W, i, hl, ehl, h, sE, er, dv, edv, ok, eq):
  match k:
    case 0n: {==}
    case 1n+ +q:
      (+r0, +rs) = er
      ([D.bytes(d_Deposit_bx(hl, th_Deposit_bx(xat_l16_Deposit(W, i))))], (MD.bytes_list(xl_l16_Deposit(q, W, 1n+i, hl)), (rs_Deposit_bx(hl, ehl, h, th_Deposit_bx(xat_l16_Deposit(W, i)), sE, r0, dv, edv, ok, eq), (xroots_l16_Deposit(q, W, 1n+i, hl, ehl, h, sE, rs, dv, edv, ok, eq), {==}))))
law xcount_l16_Deposit:
  for +k: Nat
  for +W: List<&2, MB<M_Deposit>>
  for +i: Nat
  {Codec.count(xi_l16_Deposit(k, W, i)) == k : Nat}
def xcount_l16_Deposit(k, W, i):
  match k:
    case 0n: {==}
    case 1n+ +q:
      %Equal.sym(Nat, Codec.count(xi_l16_Deposit(q, W, 1n+i)), q, xcount_l16_Deposit(q, W, 1n+i)) : {1n+_ == 1n+q : Nat}
      {==}
law xph1_l16_Deposit:
  for +d: Nat
  for +b: Bool
  for +hl: Nat
  for +seg: U32
  for +v: Nat
  for +s: Nat
  for +n: Nat
  for -h: B.Buf
  for -ws: Array<O.Boxed<FuluDeposit_d.Deposit>>
  for +dl: D.Digest
  {Fulu_list_Deposit_16_h.l16_Deposit_mt(d, 1n, b, hl, seg, v, s, n, (h, (ws, dl))) == Fulu_list_Deposit_16_h.l16_Deposit_mj(hl, dl, Fulu_list_Deposit_16_h.l16_Deposit_mt(d, 0n, b, hl, seg, v, s, n, (h, (ws, D.zero())))) : B.Buf & (Array<O.Boxed<FuluDeposit_d.Deposit>> & D.Digest)}
def xph1_l16_Deposit(d, b, hl, seg, v, s, n, h, ws, dl):
  match d:
    case 0n: {==}
    case 1n+q: {==}
law xmt_l16_Deposit:
  for +d: Nat
  for +b: Bool
  for +hl: Nat
  for +seg: U32
  for +dw: Nat
  for +t: F.array__Tree<MB<M_Deposit>>
  for +s: Nat
  for +n: Nat
  for -h: B.Buf
  for +junk: D.Digest
  for +e: {Nat.is_lt(s, n) == b : Bool}
  for +hd: {Nat.is_lt(dw, 32n) == True{} : Bool}
  for +pf: {F.array__perfect(MB<M_Deposit>, dw, t) == True{} : Bool}
  for +hn: {Nat.is_le(n, F.spec_common__pow2(dw)) == True{} : Bool}
  for +sE: S.Schema
  for +er: ereps_l16_Deposit(n, F.array__slots(MB<M_Deposit>, t), 0n, sE)
  {Fulu_list_Deposit_16_h.l16_Deposit_mt(d, 0n, b, hl, seg, O.pow2n(d), s, n, (h, (am_l16_Deposit(t), junk))) == (h, (am_l16_Deposit(t), MD.rtree(d, b, hl, xl_l16_Deposit(n, F.array__slots(MB<M_Deposit>, t), 0n, hl), s))) : B.Buf & (Array<O.Boxed<FuluDeposit_d.Deposit>> & D.Digest)}
def xmt_l16_Deposit(d, b, hl, seg, dw, t, s, n, h, junk, e, hd, pf, hn, sE, er):
  match d:
    case 0n:
      match b:
        case False{}: {==}
        case True{}:
          +hs = F.nat__lt_le_trans(s, n, F.spec_common__pow2(dw), e, hn)
          +e1 = F.u32__to_nat_from_nat(s, dw, F.nat__lt_le(dw, 32n, hd), hs)
          +hx = XS.at_nth(MB<M_Deposit>, F.array__slots(MB<M_Deposit>, t), s, U32.to_nat(U32.from_nat(s)), xat_l16_Deposit(F.array__slots(MB<M_Deposit>, t), s), e1, nth_l16_Deposit(F.array__slots(MB<M_Deposit>, t), s, XS.lt_len(MB<M_Deposit>, dw, t, s, pf, hs)))
          +rx = F.logic__subst(Nat, j => rep_Deposit_bx(th_Deposit_bx(xat_l16_Deposit(F.array__slots(MB<M_Deposit>, t), j)), sE), Nat.add(s, 0n), s, MR.add_zero(s), erep_at_l16_Deposit(s, n, F.array__slots(MB<M_Deposit>, t), 0n, sE, er, e))
          %Equal.sym(Array<O.Boxed<FuluDeposit_d.Deposit>> & O.Boxed<FuluDeposit_d.Deposit>, Array.swap(O.Boxed<FuluDeposit_d.Deposit>, am_l16_Deposit(t), U32.from_nat(s), O.BNone{}), (am_l16_Deposit(F.array__upd(MB<M_Deposit>, dw, t, U32.to_nat(U32.from_nat(s)), MNone{})), th_Deposit_bx(xat_l16_Deposit(F.array__slots(MB<M_Deposit>, t), s))),
              amswap_l16_Deposit(dw, t, U32.from_nat(s), MNone{}, xat_l16_Deposit(F.array__slots(MB<M_Deposit>, t), s), hd, MR.hi_at(dw, s, hd, hs), hx, pf)) :
            {Fulu_list_Deposit_16_h.l16_Deposit_rl(hl, U32.from_nat(s), seg, h, _) == (h, (am_l16_Deposit(t), MD.rtree(0n, True{}, hl, xl_l16_Deposit(n, F.array__slots(MB<M_Deposit>, t), 0n, hl), s))) : B.Buf & (Array<O.Boxed<FuluDeposit_d.Deposit>> & D.Digest)}
          %Equal.sym(B.Buf & (O.Boxed<FuluDeposit_d.Deposit> & D.Digest), FuluDeposit_h.Deposit_bx_root(hl, h, th_Deposit_bx(xat_l16_Deposit(F.array__slots(MB<M_Deposit>, t), s)), (seg + 64 : U32)), (h, (th_Deposit_bx(xat_l16_Deposit(F.array__slots(MB<M_Deposit>, t), s)), d_Deposit_bx(hl, th_Deposit_bx(xat_l16_Deposit(F.array__slots(MB<M_Deposit>, t), s))))), st_Deposit_bx(hl, h, th_Deposit_bx(xat_l16_Deposit(F.array__slots(MB<M_Deposit>, t), s)), (seg + 64 : U32), sE, rx)) :
            {Fulu_list_Deposit_16_h.l16_Deposit_rl_n(U32.from_nat(s), am_l16_Deposit(F.array__upd(MB<M_Deposit>, dw, t, U32.to_nat(U32.from_nat(s)), MNone{})), _) == (h, (am_l16_Deposit(t), MD.rtree(0n, True{}, hl, xl_l16_Deposit(n, F.array__slots(MB<M_Deposit>, t), 0n, hl), s))) : B.Buf & (Array<O.Boxed<FuluDeposit_d.Deposit>> & D.Digest)}
          %Equal.sym(Array<O.Boxed<FuluDeposit_d.Deposit>>, Array.set(O.Boxed<FuluDeposit_d.Deposit>, am_l16_Deposit(F.array__upd(MB<M_Deposit>, dw, t, U32.to_nat(U32.from_nat(s)), MNone{})), U32.from_nat(s), th_Deposit_bx(xat_l16_Deposit(F.array__slots(MB<M_Deposit>, t), s))), am_l16_Deposit(t), amswap_back_l16_Deposit(dw, t, U32.from_nat(s), MNone{}, xat_l16_Deposit(F.array__slots(MB<M_Deposit>, t), s), hd, MR.hi_at(dw, s, hd, hs), hx, pf)) :
            {(h, (_, d_Deposit_bx(hl, th_Deposit_bx(xat_l16_Deposit(F.array__slots(MB<M_Deposit>, t), s))))) == (h, (am_l16_Deposit(t), MD.rtree(0n, True{}, hl, xl_l16_Deposit(n, F.array__slots(MB<M_Deposit>, t), 0n, hl), s))) : B.Buf & (Array<O.Boxed<FuluDeposit_d.Deposit>> & D.Digest)}
          %Equal.sym(D.Digest, MD.dhead(MD.ddrop(s, xl_l16_Deposit(n, F.array__slots(MB<M_Deposit>, t), 0n, hl))), d_Deposit_bx(hl, th_Deposit_bx(xat_l16_Deposit(F.array__slots(MB<M_Deposit>, t), Nat.add(s, 0n)))), xat_at_l16_Deposit(s, n, F.array__slots(MB<M_Deposit>, t), 0n, hl, e)) :
            {(h, (am_l16_Deposit(t), d_Deposit_bx(hl, th_Deposit_bx(xat_l16_Deposit(F.array__slots(MB<M_Deposit>, t), s))))) == (h, (am_l16_Deposit(t), _)) : B.Buf & (Array<O.Boxed<FuluDeposit_d.Deposit>> & D.Digest)}
          %Equal.sym(Nat, Nat.add(s, 0n), s, MR.add_zero(s)) :
            {(h, (am_l16_Deposit(t), d_Deposit_bx(hl, th_Deposit_bx(xat_l16_Deposit(F.array__slots(MB<M_Deposit>, t), s))))) == (h, (am_l16_Deposit(t), d_Deposit_bx(hl, th_Deposit_bx(xat_l16_Deposit(F.array__slots(MB<M_Deposit>, t), _))))) : B.Buf & (Array<O.Boxed<FuluDeposit_d.Deposit>> & D.Digest)}
          {==}
    case 1n+ +q:
      match b:
        case False{}: {==}
