    {(h, (Fulu_list_Attestation_8_d.l8_Attestation_Seq{am_l8_Attestation(t), N}, O.mix_len(hl, MD.rtree(3n, Nat.is_lt(0n, U32.to_nat(N)), hl, xl_l8_Attestation(U32.to_nat(N), F.array__slots(MB<M_Attestation>, t), 0n, hl), 0n), N))) == (h, (Fulu_list_Attestation_8_d.l8_Attestation_Seq{am_l8_Attestation(t), N}, O.mix_len(hl, MD.rtree(3n, Nat.is_lt(0n, U32.to_nat(N)), hl, xl_l8_Attestation(U32.to_nat(N), F.array__slots(MB<M_Attestation>, _), 0n, hl), 0n), N))) : B.Buf & (Fulu_list_Attestation_8_d.l8_Attestation_Seq & D.Digest)}
