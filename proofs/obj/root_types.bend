# ---- box of DepositData ----
def v_DepositData_bx(o: O.Boxed<FuluDepositData_d.DepositData>) -> S.Value:
  match o:
    case O.BSome{+v, rest}: RN_L.v_DepositData(v)
    case O.BNone{}: S.NullValue{}
def d_DepositData_bx(+hl: Nat, o: O.Boxed<FuluDepositData_d.DepositData>) -> D.Digest:
  match o:
    case O.BSome{+v, rest}: RN.d_DepositData(hl, v)
    case O.BNone{}: D.zero()
def rep_DepositData_bx(o: O.Boxed<FuluDepositData_d.DepositData>, +s: S.Schema) -> Data:
  DK.Ex(FuluDepositData_d.DepositData, v => {o == O.BSome{v, O.BNone{}} : O.Boxed<FuluDepositData_d.DepositData>})
def st_DepositData_bx(+hl: Nat, -h: B.Buf, -o: O.Boxed<FuluDepositData_d.DepositData>, +seg: U32, +s: S.Schema, +rep: rep_DepositData_bx(o, s))
    -> {FuluDepositData_h.DepositData_bx_root(hl, h, o, seg) == (h, (o, d_DepositData_bx(hl, o))) : B.Buf & (O.Boxed<FuluDepositData_d.DepositData> & D.Digest)}:
  (+v, +eo) = rep
  %Equal.sym(O.Boxed<FuluDepositData_d.DepositData>, o, O.BSome{v, O.BNone{}}, eo) :
    {FuluDepositData_h.DepositData_bx_root(hl, h, _, seg) == (h, (_, d_DepositData_bx(hl, _))) : B.Buf & (O.Boxed<FuluDepositData_d.DepositData> & D.Digest)}
  %Equal.sym(B.Buf & D.Digest, FuluDepositData_h.DepositData_root(hl, h, v, seg), (h, RN.d_DepositData(hl, v)), RN.st_DepositData(hl, h, v, seg)) :
    {FuluDepositData_h.DepositData_bx_rt(v, _) == (h, (O.BSome{v, O.BNone{}}, d_DepositData_bx(hl, O.BSome{v, O.BNone{}}))) : B.Buf & (O.Boxed<FuluDepositData_d.DepositData> & D.Digest)}
  {==}
def rs_DepositData_bx(+hl: Nat, +ehl: {hl == 64n : Nat}, -h: B.Buf, -o: O.Boxed<FuluDepositData_d.DepositData>, +s: S.Schema, +rep: rep_DepositData_bx(o, s), +eq: {s == S.Container{["pubkey", "withdrawal_credentials", "amount", "signature"], S.Chain{S.ByteVector{48n}, S.Chain{S.ByteVector{32n}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{96n}, S.End{}}}}}} : S.Schema})
    -> RR.roots(v_DepositData_bx(o), s, [D.bytes(d_DepositData_bx(hl, o))]):
  (+v, +eo) = rep
  %Equal.sym(O.Boxed<FuluDepositData_d.DepositData>, o, O.BSome{v, O.BNone{}}, eo) : RR.roots(v_DepositData_bx(_), s, [D.bytes(d_DepositData_bx(hl, _))])
  OS.transport(RN_L.v_DepositData(v), s, S.Container{["pubkey", "withdrawal_credentials", "amount", "signature"], S.Chain{S.ByteVector{48n}, S.Chain{S.ByteVector{32n}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{96n}, S.End{}}}}}}, [D.bytes(RN.d_DepositData(hl, v))], eq, RN.rs_DepositData(hl, ehl, v))
def wd_DepositData_bx(+hl: Nat, -o: O.Boxed<FuluDepositData_d.DepositData>, +s: S.Schema, +rep: rep_DepositData_bx(o, s)) -> OS.DW(d_DepositData_bx(hl, o)):
  (+v, +eo) = rep
  %Equal.sym(O.Boxed<FuluDepositData_d.DepositData>, o, O.BSome{v, O.BNone{}}, eo) : OS.DW(d_DepositData_bx(hl, _))
  (RN.d_DepositData(hl, v), {==})

# ---- Deposit (Type-kind container, 2 fields) ----
def pj_Deposit_0(o: FuluDeposit_d.Deposit) -> O.Words:
  match o:
    case FuluDeposit_d.Deposit{x0, x1}: x0
def pj_Deposit_1(o: FuluDeposit_d.Deposit) -> O.Boxed<FuluDepositData_d.DepositData>:
  match o:
    case FuluDeposit_d.Deposit{x0, x1}: x1
def v_Deposit(o: FuluDeposit_d.Deposit) -> S.Value:
  match o:
    case FuluDeposit_d.Deposit{x0, x1}: S.Sequence{S.Items{PV.pview(x0), S.Items{v_DepositData_bx(x1), S.EmptyItems{}}}}
def d_Deposit(+hl: Nat, o: FuluDeposit_d.Deposit) -> D.Digest:
  match o:
    case FuluDeposit_d.Deposit{x0, x1}: MD.rtree(1n, True{}, hl, [WO_L.wdig(hl, x0, 6n), d_DepositData_bx(hl, x1)], 0n)
def rep_Deposit(o: FuluDeposit_d.Deposit, +s: S.Schema) -> Data:
  DK.P2({o == FuluDeposit_d.Deposit{pj_Deposit_0(o), pj_Deposit_1(o)} : FuluDeposit_d.Deposit}, DK.P2(PV.rep_pv(pj_Deposit_0(o), SH.Chain_head(SH.Container_fields(s))), rep_DepositData_bx(pj_Deposit_1(o), SH.Chain_head(SH.Chain_tail(SH.Container_fields(s))))))
def ok_Deposit(+s: S.Schema, +dv: OS.DV) -> Bool: Bool.and(SH.is_Container(s), Bool.and(SH.is_Chain(SH.Container_fields(s)), Bool.and(SH.is_Chain(SH.Chain_tail(SH.Container_fields(s))), Bool.and(SH.is_End(SH.Chain_tail(SH.Chain_tail(SH.Container_fields(s)))), PV.ok_pv(SH.Chain_head(SH.Container_fields(s)), 6n)))))
def okc_Deposit(+s: S.Schema, +dv: OS.DV, +ok: {ok_Deposit(s, dv) == True{} : Bool}) -> {SH.is_Container(s) == True{} : Bool}: DK.and_l(SH.is_Container(s), Bool.and(SH.is_Chain(SH.Container_fields(s)), Bool.and(SH.is_Chain(SH.Chain_tail(SH.Container_fields(s))), Bool.and(SH.is_End(SH.Chain_tail(SH.Chain_tail(SH.Container_fields(s)))), PV.ok_pv(SH.Chain_head(SH.Container_fields(s)), 6n)))), ok)
def eqs_Deposit(+s: S.Schema) -> Data: {SH.Chain_head(SH.Chain_tail(SH.Container_fields(s))) == S.Container{["pubkey", "withdrawal_credentials", "amount", "signature"], S.Chain{S.ByteVector{48n}, S.Chain{S.ByteVector{32n}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{96n}, S.End{}}}}}} : S.Schema}
def fsh_Deposit(+s: S.Schema, +dv: OS.DV, +ok: {ok_Deposit(s, dv) == True{} : Bool}) -> {SH.Container_fields(s) == S.Chain{SH.Chain_head(SH.Container_fields(s)), S.Chain{SH.Chain_head(SH.Chain_tail(SH.Container_fields(s))), S.End{}}} : S.Schema}:
  +k0 = DK.and_l(SH.is_Container(s), Bool.and(SH.is_Chain(SH.Container_fields(s)), Bool.and(SH.is_Chain(SH.Chain_tail(SH.Container_fields(s))), Bool.and(SH.is_End(SH.Chain_tail(SH.Chain_tail(SH.Container_fields(s)))), PV.ok_pv(SH.Chain_head(SH.Container_fields(s)), 6n)))), ok)
  +r1 = DK.and_r(SH.is_Container(s), Bool.and(SH.is_Chain(SH.Container_fields(s)), Bool.and(SH.is_Chain(SH.Chain_tail(SH.Container_fields(s))), Bool.and(SH.is_End(SH.Chain_tail(SH.Chain_tail(SH.Container_fields(s)))), PV.ok_pv(SH.Chain_head(SH.Container_fields(s)), 6n)))), ok)
  +k1 = DK.and_l(SH.is_Chain(SH.Container_fields(s)), Bool.and(SH.is_Chain(SH.Chain_tail(SH.Container_fields(s))), Bool.and(SH.is_End(SH.Chain_tail(SH.Chain_tail(SH.Container_fields(s)))), PV.ok_pv(SH.Chain_head(SH.Container_fields(s)), 6n))), r1)
  +r2 = DK.and_r(SH.is_Chain(SH.Container_fields(s)), Bool.and(SH.is_Chain(SH.Chain_tail(SH.Container_fields(s))), Bool.and(SH.is_End(SH.Chain_tail(SH.Chain_tail(SH.Container_fields(s)))), PV.ok_pv(SH.Chain_head(SH.Container_fields(s)), 6n))), r1)
  +k2 = DK.and_l(SH.is_Chain(SH.Chain_tail(SH.Container_fields(s))), Bool.and(SH.is_End(SH.Chain_tail(SH.Chain_tail(SH.Container_fields(s)))), PV.ok_pv(SH.Chain_head(SH.Container_fields(s)), 6n)), r2)
  +r3 = DK.and_r(SH.is_Chain(SH.Chain_tail(SH.Container_fields(s))), Bool.and(SH.is_End(SH.Chain_tail(SH.Chain_tail(SH.Container_fields(s)))), PV.ok_pv(SH.Chain_head(SH.Container_fields(s)), 6n)), r2)
  +k3 = DK.and_l(SH.is_End(SH.Chain_tail(SH.Chain_tail(SH.Container_fields(s)))), PV.ok_pv(SH.Chain_head(SH.Container_fields(s)), 6n), r3)
  +r4 = DK.and_r(SH.is_End(SH.Chain_tail(SH.Chain_tail(SH.Container_fields(s)))), PV.ok_pv(SH.Chain_head(SH.Container_fields(s)), 6n), r3)
