def xcount_l8_Attestation(k, W, i):
  match k:
    case 0n: {==}
    case 1n+ +q:
      %Equal.sym(Nat, Codec.count(xi_l8_Attestation(q, W, 1n+i)), q, xcount_l8_Attestation(q, W, 1n+i)) : {1n+_ == 1n+q : Nat}
