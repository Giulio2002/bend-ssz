def d_DepositData_bx(+hl: Nat, o: O.Boxed<FuluDepositData_d.DepositData>) -> D.Digest:
  match o:
    case O.BSome{+v, rest}: RN.d_DepositData(hl, v)
    case O.BNone{}: D.zero()
