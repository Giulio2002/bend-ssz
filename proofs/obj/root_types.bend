def pj_AggregateAndProof_1(o: FuluAggregateAndProof_d.AggregateAndProof) -> O.Boxed<FuluAttestation_d.Attestation>:
  match o:
    case FuluAggregateAndProof_d.AggregateAndProof{+x0, x1, +x2}: x1
