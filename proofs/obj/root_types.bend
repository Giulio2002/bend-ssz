def d_Attestation_bx(+hl: Nat, o: O.Boxed<FuluAttestation_d.Attestation>) -> D.Digest:
  match o:
    case O.BSome{v, rest}: d_Attestation(hl, v)
    case O.BNone{}: D.zero()
def st_Attestation_bx(+hl: Nat, -h: B.Buf, -o: O.Boxed<FuluAttestation_d.Attestation>, +seg: U32, +s: S.Schema, +rep: LV.rep_Attestation_bx(o, s))
    -> {FuluAttestation_h.Attestation_bx_root(hl, h, o, seg) == (h, (o, d_Attestation_bx(hl, o))) : B.Buf & (O.Boxed<FuluAttestation_d.Attestation> & D.Digest)}:
  (+eo, +ri) = rep
  %Equal.sym(O.Boxed<FuluAttestation_d.Attestation>, o, O.BSome{LV.pjb_Attestation_bx(o), O.BNone{}}, eo) :
    {FuluAttestation_h.Attestation_bx_root(hl, h, _, seg) == (h, (_, d_Attestation_bx(hl, _))) : B.Buf & (O.Boxed<FuluAttestation_d.Attestation> & D.Digest)}
  %Equal.sym(B.Buf & (FuluAttestation_d.Attestation & D.Digest), FuluAttestation_h.Attestation_root(hl, h, LV.pjb_Attestation_bx(o), seg), (h, (LV.pjb_Attestation_bx(o), d_Attestation(hl, LV.pjb_Attestation_bx(o)))), st_Attestation(hl, h, LV.pjb_Attestation_bx(o), seg, s, ri)) :
    {FuluAttestation_h.Attestation_bx_rt(_) == (h, (O.BSome{LV.pjb_Attestation_bx(o), O.BNone{}}, d_Attestation_bx(hl, O.BSome{LV.pjb_Attestation_bx(o), O.BNone{}}))) : B.Buf & (O.Boxed<FuluAttestation_d.Attestation> & D.Digest)}
  {==}
def rs_Attestation_bx(+hl: Nat, +ehl: {hl == 64n : Nat}, -h: B.Buf, -o: O.Boxed<FuluAttestation_d.Attestation>, +s: S.Schema, +rep: LV.rep_Attestation_bx(o, s), +dv: OS.DV, +edv: {dv == OS.DV0() : OS.DV}, +ok: {ok_Attestation(s, dv) == True{} : Bool}, +eq: eqs_Attestation(s))
    -> RR.roots(LV.v_Attestation_bx(o), s, [D.bytes(d_Attestation_bx(hl, o))]):
  (+eo, +ri) = rep
  %Equal.sym(O.Boxed<FuluAttestation_d.Attestation>, o, O.BSome{LV.pjb_Attestation_bx(o), O.BNone{}}, eo) : RR.roots(LV.v_Attestation_bx(_), s, [D.bytes(d_Attestation_bx(hl, _))])
  rs_Attestation(hl, ehl, h, LV.pjb_Attestation_bx(o), s, ri, dv, edv, ok, eq)
def wd_Attestation_bx(+hl: Nat, -o: O.Boxed<FuluAttestation_d.Attestation>, +s: S.Schema, +rep: LV.rep_Attestation_bx(o, s)) -> OS.DW(d_Attestation_bx(hl, o)):
  (+eo, +ri) = rep
  %Equal.sym(O.Boxed<FuluAttestation_d.Attestation>, o, O.BSome{LV.pjb_Attestation_bx(o), O.BNone{}}, eo) : OS.DW(d_Attestation_bx(hl, _))
  wd_Attestation(hl, LV.pjb_Attestation_bx(o), s, ri)
def ok_Attestation_bx(+s: S.Schema, +dv: OS.DV) -> Bool: ok_Attestation(s, dv)
def eqs_Attestation_bx(+s: S.Schema) -> Data: eqs_Attestation(s)

def d_AggregateAndProof(+hl: Nat, o: FuluAggregateAndProof_d.AggregateAndProof) -> D.Digest:
  match o:
    case FuluAggregateAndProof_d.AggregateAndProof{+x0, x1, +x2}: MD.rtree(2n, True{}, hl, [RN.d_u64(hl, x0), d_Attestation_bx(hl, x1), RN.d_b96(hl, x2)], 0n)
def ok_AggregateAndProof(+s: S.Schema, +dv: OS.DV) -> Bool: Bool.and(SH.is_Container(s), Bool.and(SH.is_Chain(SH.Container_fields(s)), Bool.and(SH.is_Chain(SH.Chain_tail(SH.Container_fields(s))), Bool.and(SH.is_Chain(SH.Chain_tail(SH.Chain_tail(SH.Container_fields(s)))), Bool.and(SH.is_End(SH.Chain_tail(SH.Chain_tail(SH.Chain_tail(SH.Container_fields(s))))), ok_Attestation_bx(SH.Chain_head(SH.Chain_tail(SH.Container_fields(s))), dv))))))
def okc_AggregateAndProof(+s: S.Schema, +dv: OS.DV, +ok: {ok_AggregateAndProof(s, dv) == True{} : Bool}) -> {SH.is_Container(s) == True{} : Bool}: DK.and_l(SH.is_Container(s), Bool.and(SH.is_Chain(SH.Container_fields(s)), Bool.and(SH.is_Chain(SH.Chain_tail(SH.Container_fields(s))), Bool.and(SH.is_Chain(SH.Chain_tail(SH.Chain_tail(SH.Container_fields(s)))), Bool.and(SH.is_End(SH.Chain_tail(SH.Chain_tail(SH.Chain_tail(SH.Container_fields(s))))), ok_Attestation_bx(SH.Chain_head(SH.Chain_tail(SH.Container_fields(s))), dv))))), ok)
def eqs_AggregateAndProof(+s: S.Schema) -> Data: DK.P2({SH.Chain_head(SH.Container_fields(s)) == S.Unsigned{P.U64{}} : S.Schema}, DK.P2(eqs_Attestation(SH.Chain_head(SH.Chain_tail(SH.Container_fields(s)))), {SH.Chain_head(SH.Chain_tail(SH.Chain_tail(SH.Container_fields(s)))) == S.ByteVector{96n} : S.Schema}))
