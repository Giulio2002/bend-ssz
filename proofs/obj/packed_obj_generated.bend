    +pf: {F.array__perfect(U32, dw, t) == True{} : Bool},
    +room: {Nat.is_le(O.e8(1n+q), F.spec_common__pow2(dw)) == True{} : Bool})
    -> {Nat.is_le(LV.m4(c), F.spec_common__length(U32, F.array__slots(U32, t))) == True{} : Bool}:
  +a1 = Order.add_left(WS.e32(q), r, 32n, h32)
  +a2 = UL.rw_le_l(Nat.add(WS.e32(q), r), LV.e4(c), Nat.add(WS.e32(q), 32n), ec, a1)
  +a3 = UL.rw_le_r(LV.e4(c), Nat.add(WS.e32(q), 32n), WS.e32(1n+q), UL.add32(q), a2)
  +a4 = UL.dbl_cancel(LV.m4(c), O.e8(1n+q), UL.dbl_cancel(Nat.double(LV.m4(c)), Nat.double(O.e8(1n+q)), a3))
