# A vector of uint32: its digest is a specification root of its elements.
def v4_rs(+hl: Nat, +ehl: {hl == 64n : Nat}, -o: O.Words, +s: S.Schema, +depth: Nat,
    +rep: LV.rep_v4(o, s),
    +ok: {ok_v4(s, depth) == True{} : Bool},
    +hdep: {Nat.is_lt(depth, 64n) == True{} : Bool})
    -> RR.roots(LV.vview4(o), s, [D.bytes(WO.wdig(hl, o, depth))]):
  (+wf, +r1) = rep
  (+eN, +hq) = r1
  +c0 = DK.and_l(SH.is_Vector(s), Bool.and(SH.is_Unsigned(SH.Vector_element(s)), Bool.and(is_U32Width(SH.Unsigned_width(SH.Vector_element(s))), Lim.minimal(Nat.div(Nat.add(Nat.mul(SH.Vector_length(s), 4n), 31n), 32n), depth))), ok)
  +k1 = DK.and_r(SH.is_Vector(s), Bool.and(SH.is_Unsigned(SH.Vector_element(s)), Bool.and(is_U32Width(SH.Unsigned_width(SH.Vector_element(s))), Lim.minimal(Nat.div(Nat.add(Nat.mul(SH.Vector_length(s), 4n), 31n), 32n), depth))), ok)
  +c1 = DK.and_l(SH.is_Unsigned(SH.Vector_element(s)), Bool.and(is_U32Width(SH.Unsigned_width(SH.Vector_element(s))), Lim.minimal(Nat.div(Nat.add(Nat.mul(SH.Vector_length(s), 4n), 31n), 32n), depth)), k1)
  +k2 = DK.and_r(SH.is_Unsigned(SH.Vector_element(s)), Bool.and(is_U32Width(SH.Unsigned_width(SH.Vector_element(s))), Lim.minimal(Nat.div(Nat.add(Nat.mul(SH.Vector_length(s), 4n), 31n), 32n), depth)), k1)
  +c2 = DK.and_l(is_U32Width(SH.Unsigned_width(SH.Vector_element(s))), Lim.minimal(Nat.div(Nat.add(Nat.mul(SH.Vector_length(s), 4n), 31n), 32n), depth), k2)
  +c3 = DK.and_r(is_U32Width(SH.Unsigned_width(SH.Vector_element(s))), Lim.minimal(Nat.div(Nat.add(Nat.mul(SH.Vector_length(s), 4n), 31n), 32n), depth), k2)
  %Equal.sym(S.Schema, s, S.Vector{SH.Vector_element(s), SH.Vector_length(s)}, SH.Vector_shape(s, c0)) :
    RR.roots(LV.vview4(o), _, [D.bytes(WO.wdig(hl, o, depth))])
  %Equal.sym(S.Schema, SH.Vector_element(s), S.Unsigned{SH.Unsigned_width(SH.Vector_element(s))}, SH.Unsigned_shape(SH.Vector_element(s), c1)) :
    RR.roots(LV.vview4(o), S.Vector{_, SH.Vector_length(s)}, [D.bytes(WO.wdig(hl, o, depth))])
  %Equal.sym(P.Width, SH.Unsigned_width(SH.Vector_element(s)), P.U32Width{}, is_U32Width_shape(SH.Unsigned_width(SH.Vector_element(s)), c2)) :
    RR.roots(LV.vview4(o), S.Vector{S.Unsigned{_}, SH.Vector_length(s)}, [D.bytes(WO.wdig(hl, o, depth))])
  v4_body(hl, ehl, o, SH.Vector_length(s), depth, wf, eN, hq, c3, hdep)

# ---- uint64: 2 words per element ----------------------------------------

law pb8:
  for +k: Nat
  for +W: List<&2, U32>
  for +hl: {Nat.is_le(LV.m8(k), F.spec_common__length(U32, W)) == True{} : Bool}
  {RR.basic_bytes(LV.it8(k, W), S.Unsigned{P.U64{}}) == Some{WS.btake(LV.e8(k), FX.limbs(W))} : Maybe<&2, +List<U32>>}
def pb8(k, W, hl):
  match k:
    case 0n: {==}
    case 1n+ +c:
      match W:
        case Nil{}: Empty.absurd({RR.basic_bytes(LV.it8(1n+c, Nil{}), S.Unsigned{P.U64{}}) == Some{WS.btake(LV.e8(1n+c), FX.limbs(Nil{}))} : Maybe<&2, +List<U32>>}, MD.false_true(hl))
        case Con{+a0, +t0}:
          match t0:
            case Nil{}: Empty.absurd({RR.basic_bytes(LV.it8(1n+c, Con{a0, Nil{}}), S.Unsigned{P.U64{}}) == Some{WS.btake(LV.e8(1n+c), FX.limbs(Con{a0, Nil{}}))} : Maybe<&2, +List<U32>>}, MD.false_true(hl))
            case Con{+a1, +rest}:
              %Equal.sym(Maybe<&2, +List<U32>>, RR.basic_bytes(LV.it8(c, rest), S.Unsigned{P.U64{}}), Some{WS.btake(LV.e8(c), FX.limbs(rest))}, pb8(c, rest, hl)) :
                {RR.join(Some{List.append(&2, U32, SP.limb_digits(a0), SP.limb_digits(a1))}, _) == Some{WS.btake(LV.e8(1n+c), FX.limbs(Con{a0, Con{a1, rest}}))} : Maybe<&2, +List<U32>>}
              %IE.limb_correct(a0) :
                {RR.join(Some{List.append(&2, U32, _, SP.limb_digits(a1))}, Some{WS.btake(LV.e8(c), FX.limbs(rest))}) == Some{WS.btake(LV.e8(1n+c), FX.limbs(Con{a0, Con{a1, rest}}))} : Maybe<&2, +List<U32>>}
              %IE.limb_correct(a1) :
                {RR.join(Some{List.append(&2, U32, I.limb(a0), _)}, Some{WS.btake(LV.e8(c), FX.limbs(rest))}) == Some{WS.btake(LV.e8(1n+c), FX.limbs(Con{a0, Con{a1, rest}}))} : Maybe<&2, +List<U32>>}
              {==}

law e8_mul:
  for +L: Nat
  {LV.e8(L) == Nat.mul(L, 8n) : Nat}
def e8_mul(L):
  match L:
    case 0n: {==}
    case 1n+ +p:
      %Equal.sym(Nat, LV.e8(p), Nat.mul(p, 8n), e8_mul(p)) : {8n+_ == Nat.add(8n, Nat.mul(p, 8n)) : Nat}
      {==}

law e8_mono:
  for +a: Nat
  for +b: Nat
  for +e: {Nat.is_le(a, b) == True{} : Bool}
  {Nat.is_le(LV.e8(a), LV.e8(b)) == True{} : Bool}
def e8_mono(a, b, e):
  match a b:
    case 0n _: Order.zero_le(LV.e8(b))
    case 1n+p 0n: Empty.absurd({Nat.is_le(LV.e8(1n+p), LV.e8(0n)) == True{} : Bool}, MD.false_true(e))
    case 1n+ +p 1n+ +q: e8_mono(p, q, e)

def is_U64(w: P.Width) -> Bool:
  match w:
    case P.U64{}: True{}
    case _: False{}

law is_U64_shape:
  for +w: P.Width
  for +e: {is_U64(w) == True{} : Bool}
  {w == P.U64{} : P.Width}
def is_U64_shape(w, e):
  match w:
    case P.U8{}: Empty.absurd({P.U8{} == P.U64{} : P.Width}, MD.false_true(e))
    case P.U16{}: Empty.absurd({P.U16{} == P.U64{} : P.Width}, MD.false_true(e))
    case P.U32Width{}: Empty.absurd({P.U32Width{} == P.U64{} : P.Width}, MD.false_true(e))
    case P.U64{}: {==}
    case P.U128{}: Empty.absurd({P.U128{} == P.U64{} : P.Width}, MD.false_true(e))
    case P.U256{}: Empty.absurd({P.U256{} == P.U64{} : P.Width}, MD.false_true(e))

# The schema is a vector of uint64 whose chunk limit has minimal depth `depth`.
def ok_v8(+s: S.Schema, +depth: Nat) -> Bool:
  Bool.and(SH.is_Vector(s), Bool.and(SH.is_Unsigned(SH.Vector_element(s)), Bool.and(is_U64(SH.Unsigned_width(SH.Vector_element(s))), Lim.minimal(Nat.div(Nat.add(Nat.mul(SH.Vector_length(s), 8n), 31n), 32n), depth))))

def rep_wf8(-o: O.Words, +s: S.Schema, +rep: LV.rep_v8(o, s)) -> WO.wf1(o):
  (+wf, +r) = rep
  wf

def eq_n8(-o: O.Words, +t: F.array__Tree<U32>, +N: U32, +eo: {o == O.Words{F.array__thaw(U32, t), N} : O.Words},
    +eN: {U32.to_nat(WO.len(o)) == LV.e8(LV.cnt8(o)) : Nat}) -> {U32.to_nat(N) == LV.e8(U32.to_nat(U32.shrn(N, 3n))) : Nat}:
  %Equal.cong(O.Words, U32, WO.len, o, O.Words{F.array__thaw(U32, t), N}, eo) : {U32.to_nat(_) == LV.e8(U32.to_nat(U32.shrn(_, 3n))) : Nat}
  eN

def eqn_n8(-o: O.Words, +t: F.array__Tree<U32>, +N: U32, +L: Nat, +eo: {o == O.Words{F.array__thaw(U32, t), N} : O.Words},
    +hv: {Nat.is_eq(LV.cnt8(o), L) == True{} : Bool}) -> {Nat.is_eq(U32.to_nat(U32.shrn(N, 3n)), L) == True{} : Bool}:
  %Equal.cong(O.Words, U32, WO.len, o, O.Words{F.array__thaw(U32, t), N}, eo) : {Nat.is_eq(U32.to_nat(U32.shrn(_, 3n)), L) == True{} : Bool}
  hv

def le_n8(-o: O.Words, +t: F.array__Tree<U32>, +N: U32, +L: Nat, +eo: {o == O.Words{F.array__thaw(U32, t), N} : O.Words},
    +hv: {Nat.is_eq(LV.cnt8(o), L) == True{} : Bool}) -> {Nat.is_le(U32.to_nat(U32.shrn(N, 3n)), L) == True{} : Bool}:
  eq_le(U32.to_nat(U32.shrn(N, 3n)), L, eqn_n8(o, t, N, L, eo, hv))

# m8(c) words fit the array: 8c = 32q + r <= 32(q + 1) bytes, so m8(c) <= 8(q + 1) words.
def words_fit8(+c: Nat, +q: Nat, +r: Nat, +dw: Nat, +t: F.array__Tree<U32>,
    +ec: {Nat.add(WS.e32(q), r) == LV.e8(c) : Nat},
    +h32: {Nat.is_le(r, 32n) == True{} : Bool},
    +pf: {F.array__perfect(U32, dw, t) == True{} : Bool},
    +room: {Nat.is_le(O.e8(1n+q), F.spec_common__pow2(dw)) == True{} : Bool})
    -> {Nat.is_le(LV.m8(c), F.spec_common__length(U32, F.array__slots(U32, t))) == True{} : Bool}:
  +a1 = Order.add_left(WS.e32(q), r, 32n, h32)
  +a2 = UL.rw_le_l(Nat.add(WS.e32(q), r), LV.e8(c), Nat.add(WS.e32(q), 32n), ec, a1)
  +a3 = UL.rw_le_r(LV.e8(c), Nat.add(WS.e32(q), 32n), WS.e32(1n+q), UL.add32(q), a2)
  +a4 = UL.dbl_cancel(LV.m8(c), O.e8(1n+q), UL.dbl_cancel(Nat.double(LV.m8(c)), Nat.double(O.e8(1n+q)), a3))
  Order.transitive(LV.m8(c), O.e8(1n+q), F.spec_common__length(U32, F.array__slots(U32, t)), a4, UL.cap_q(q, dw, t, pf, room))

def v8_enc(+N: U32, +q: Nat, +r: Nat, +dw: Nat, +t: F.array__Tree<U32>,
    +eNN: {U32.to_nat(N) == LV.e8(U32.to_nat(U32.shrn(N, 3n))) : Nat},
    +enq: {U32.to_nat(N) == Nat.add(WS.e32(q), r) : Nat},
    +h32: {Nat.is_le(r, 32n) == True{} : Bool},
    +pf: {F.array__perfect(U32, dw, t) == True{} : Bool},
    +room: {Nat.is_le(O.e8(1n+q), F.spec_common__pow2(dw)) == True{} : Bool})
    -> {RR.basic_bytes(LV.it8(U32.to_nat(U32.shrn(N, 3n)), F.array__slots(U32, t)), S.Unsigned{P.U64{}}) == Some{WS.btake(U32.to_nat(N), FX.limbs(F.array__slots(U32, t)))} : Maybe<&2, +List<U32>>}:
  +ec = Equal.trans(Nat, Nat.add(WS.e32(q), r), U32.to_nat(N), LV.e8(U32.to_nat(U32.shrn(N, 3n))), Equal.sym(Nat, U32.to_nat(N), Nat.add(WS.e32(q), r), enq), eNN)
  %Equal.sym(Nat, U32.to_nat(N), LV.e8(U32.to_nat(U32.shrn(N, 3n))), eNN) :
    {RR.basic_bytes(LV.it8(U32.to_nat(U32.shrn(N, 3n)), F.array__slots(U32, t)), S.Unsigned{P.U64{}}) == Some{WS.btake(_, FX.limbs(F.array__slots(U32, t)))} : Maybe<&2, +List<U32>>}
  pb8(U32.to_nat(U32.shrn(N, 3n)), F.array__slots(U32, t), words_fit8(U32.to_nat(U32.shrn(N, 3n)), q, r, dw, t, ec, h32, pf, room))

def v8_lim(+N: U32, +q: Nat, +r: Nat, +L: Nat, +t: F.array__Tree<U32>,
    +eNN: {U32.to_nat(N) == LV.e8(U32.to_nat(U32.shrn(N, 3n))) : Nat},
    +enq: {U32.to_nat(N) == Nat.add(WS.e32(q), r) : Nat},
    +h1: {Nat.is_lt(0n, r) == True{} : Bool}, +h32: {Nat.is_le(r, 32n) == True{} : Bool},
    +hvN: {Nat.is_le(U32.to_nat(U32.shrn(N, 3n)), L) == True{} : Bool})
    -> {Nat.is_le(MD.dlen(MR.clist(1n+q, F.array__slots(U32, t), 0n)), Nat.div(Nat.add(Nat.mul(L, 8n), 31n), 32n)) == True{} : Bool}:
  +ec = Equal.trans(Nat, Nat.add(WS.e32(q), r), U32.to_nat(N), LV.e8(U32.to_nat(U32.shrn(N, 3n))), Equal.sym(Nat, U32.to_nat(N), Nat.add(WS.e32(q), r), enq), eNN)
  +hm = UL.rw_le_r(LV.e8(U32.to_nat(U32.shrn(N, 3n))), LV.e8(L), Nat.mul(L, 8n), e8_mul(L), e8_mono(U32.to_nat(U32.shrn(N, 3n)), L, hvN))
  +hn = UL.rw_le_l(LV.e8(U32.to_nat(U32.shrn(N, 3n))), Nat.add(WS.e32(q), r), Nat.mul(L, 8n), Equal.sym(Nat, Nat.add(WS.e32(q), r), LV.e8(U32.to_nat(U32.shrn(N, 3n))), ec), hm)
  LR.bl_hlen(q, t, Nat.mul(L, 8n), NF.chunk_le(q, r, Nat.mul(L, 8n), h1, h32, hn))

def v8_body(+hl: Nat, +ehl: {hl == 64n : Nat}, -o: O.Words, +L: Nat, +depth: Nat,
    +wf: WO.wf1(o),
    +eN: {U32.to_nat(WO.len(o)) == LV.e8(LV.cnt8(o)) : Nat},
    +hv: {Nat.is_eq(LV.cnt8(o), L) == True{} : Bool},
    +hmin: {Lim.minimal(Nat.div(Nat.add(Nat.mul(L, 8n), 31n), 32n), depth) == True{} : Bool},
    +hdep: {Nat.is_lt(depth, 64n) == True{} : Bool})
    -> RR.roots(LV.vview8(o), S.Vector{S.Unsigned{P.U64{}}, L}, [D.bytes(WO.wdig(hl, o, depth))]):
  (+t, w1) = wf
  (+dw, w2) = w1
  (+N, w3) = w2
  (+q, w4) = w3
  (+r, w5) = w4
  (+eo, w6) = w5
  (+pf, w7) = w6
  (+hd, w8) = w7
  (+enq, w9) = w8
  (+h1, w10) = w9
  (+h32, w11) = w10
  (+room, +slack) = w11
  +eNN = eq_n8(o, t, N, eo, eN)
  +hvN = le_n8(o, t, N, L, eo, hv)
  %Equal.sym(O.Words, o, O.Words{F.array__thaw(U32, t), N}, eo) :
    RR.roots(LV.vview8(_), S.Vector{S.Unsigned{P.U64{}}, L}, [D.bytes(WO.wdig(hl, _, depth))])
  %Equal.sym(F.array__Tree<U32>, F.array__freeze(U32, F.array__thaw(U32, t)), t, F.array__freeze_thaw(U32, t)) :
    RR.roots(S.Sequence{LV.it8(U32.to_nat(U32.shrn(N, 3n)), F.array__slots(U32, _))}, S.Vector{S.Unsigned{P.U64{}}, L}, [D.bytes(MD.rtree(depth, Nat.is_lt(0n, O.chunks_of(N)), hl, MR.clist(O.chunks_of(N), F.array__slots(U32, _), 0n), 0n))])
  %Equal.sym(Nat, O.chunks_of(N), 1n+q, WO.chunks_q(N, q, r, enq, h1, h32)) :
    RR.roots(S.Sequence{LV.it8(U32.to_nat(U32.shrn(N, 3n)), F.array__slots(U32, t))}, S.Vector{S.Unsigned{P.U64{}}, L}, [D.bytes(MD.rtree(depth, Nat.is_lt(0n, _), hl, MR.clist(_, F.array__slots(U32, t), 0n), 0n))])
  (MD.bytes_list(MR.clist(1n+q, F.array__slots(U32, t), 0n)),
    ((WS.btake(U32.to_nat(N), FX.limbs(F.array__slots(U32, t))), (v8_enc(N, q, r, dw, t, eNN, enq, h32, pf, room), UL.ul_pack(N, q, r, dw, t, enq, h1, h32, pf, room, slack))),
     (D.bytes(MD.rtree(depth, True{}, hl, MR.clist(1n+q, F.array__slots(U32, t), 0n), 0n)),
      ((depth, (hmin, RS.at_depth_tree(Nat.div(Nat.add(Nat.mul(L, 8n), 31n), 32n), depth, hl, MR.clist(1n+q, F.array__slots(U32, t), 0n), hdep, v8_lim(N, q, r, L, t, eNN, enq, h1, h32, hvN), ehl))),
       {==}))))

# A vector of uint64: its digest is a specification root of its elements.
def v8_rs(+hl: Nat, +ehl: {hl == 64n : Nat}, -o: O.Words, +s: S.Schema, +depth: Nat,
    +rep: LV.rep_v8(o, s),
    +ok: {ok_v8(s, depth) == True{} : Bool},
    +hdep: {Nat.is_lt(depth, 64n) == True{} : Bool})
    -> RR.roots(LV.vview8(o), s, [D.bytes(WO.wdig(hl, o, depth))]):
  (+wf, +r1) = rep
  (+eN, +hq) = r1
  +c0 = DK.and_l(SH.is_Vector(s), Bool.and(SH.is_Unsigned(SH.Vector_element(s)), Bool.and(is_U64(SH.Unsigned_width(SH.Vector_element(s))), Lim.minimal(Nat.div(Nat.add(Nat.mul(SH.Vector_length(s), 8n), 31n), 32n), depth))), ok)
  +k1 = DK.and_r(SH.is_Vector(s), Bool.and(SH.is_Unsigned(SH.Vector_element(s)), Bool.and(is_U64(SH.Unsigned_width(SH.Vector_element(s))), Lim.minimal(Nat.div(Nat.add(Nat.mul(SH.Vector_length(s), 8n), 31n), 32n), depth))), ok)
  +c1 = DK.and_l(SH.is_Unsigned(SH.Vector_element(s)), Bool.and(is_U64(SH.Unsigned_width(SH.Vector_element(s))), Lim.minimal(Nat.div(Nat.add(Nat.mul(SH.Vector_length(s), 8n), 31n), 32n), depth)), k1)
  +k2 = DK.and_r(SH.is_Unsigned(SH.Vector_element(s)), Bool.and(is_U64(SH.Unsigned_width(SH.Vector_element(s))), Lim.minimal(Nat.div(Nat.add(Nat.mul(SH.Vector_length(s), 8n), 31n), 32n), depth)), k1)
  +c2 = DK.and_l(is_U64(SH.Unsigned_width(SH.Vector_element(s))), Lim.minimal(Nat.div(Nat.add(Nat.mul(SH.Vector_length(s), 8n), 31n), 32n), depth), k2)
  +c3 = DK.and_r(is_U64(SH.Unsigned_width(SH.Vector_element(s))), Lim.minimal(Nat.div(Nat.add(Nat.mul(SH.Vector_length(s), 8n), 31n), 32n), depth), k2)
  %Equal.sym(S.Schema, s, S.Vector{SH.Vector_element(s), SH.Vector_length(s)}, SH.Vector_shape(s, c0)) :
    RR.roots(LV.vview8(o), _, [D.bytes(WO.wdig(hl, o, depth))])
  %Equal.sym(S.Schema, SH.Vector_element(s), S.Unsigned{SH.Unsigned_width(SH.Vector_element(s))}, SH.Unsigned_shape(SH.Vector_element(s), c1)) :
    RR.roots(LV.vview8(o), S.Vector{_, SH.Vector_length(s)}, [D.bytes(WO.wdig(hl, o, depth))])
  %Equal.sym(P.Width, SH.Unsigned_width(SH.Vector_element(s)), P.U64{}, is_U64_shape(SH.Unsigned_width(SH.Vector_element(s)), c2)) :
    RR.roots(LV.vview8(o), S.Vector{S.Unsigned{_}, SH.Vector_length(s)}, [D.bytes(WO.wdig(hl, o, depth))])
  v8_body(hl, ehl, o, SH.Vector_length(s), depth, wf, eN, hq, c3, hdep)

# ---- uint128: 4 words per element ----------------------------------------

law pb16:
  for +k: Nat
  for +W: List<&2, U32>
  for +hl: {Nat.is_le(LV.m16(k), F.spec_common__length(U32, W)) == True{} : Bool}
  {RR.basic_bytes(LV.it16(k, W), S.Unsigned{P.U128{}}) == Some{WS.btake(LV.e16(k), FX.limbs(W))} : Maybe<&2, +List<U32>>}
def pb16(k, W, hl):
  match k:
    case 0n: {==}
    case 1n+ +c:
      match W:
        case Nil{}: Empty.absurd({RR.basic_bytes(LV.it16(1n+c, Nil{}), S.Unsigned{P.U128{}}) == Some{WS.btake(LV.e16(1n+c), FX.limbs(Nil{}))} : Maybe<&2, +List<U32>>}, MD.false_true(hl))
        case Con{+a0, +t0}:
          match t0:
            case Nil{}: Empty.absurd({RR.basic_bytes(LV.it16(1n+c, Con{a0, Nil{}}), S.Unsigned{P.U128{}}) == Some{WS.btake(LV.e16(1n+c), FX.limbs(Con{a0, Nil{}}))} : Maybe<&2, +List<U32>>}, MD.false_true(hl))
            case Con{+a1, +t1}:
              match t1:
                case Nil{}: Empty.absurd({RR.basic_bytes(LV.it16(1n+c, Con{a0, Con{a1, Nil{}}}), S.Unsigned{P.U128{}}) == Some{WS.btake(LV.e16(1n+c), FX.limbs(Con{a0, Con{a1, Nil{}}}))} : Maybe<&2, +List<U32>>}, MD.false_true(hl))
                case Con{+a2, +t2}:
                  match t2:
                    case Nil{}: Empty.absurd({RR.basic_bytes(LV.it16(1n+c, Con{a0, Con{a1, Con{a2, Nil{}}}}), S.Unsigned{P.U128{}}) == Some{WS.btake(LV.e16(1n+c), FX.limbs(Con{a0, Con{a1, Con{a2, Nil{}}}}))} : Maybe<&2, +List<U32>>}, MD.false_true(hl))
                    case Con{+a3, +rest}:
                      %Equal.sym(Maybe<&2, +List<U32>>, RR.basic_bytes(LV.it16(c, rest), S.Unsigned{P.U128{}}), Some{WS.btake(LV.e16(c), FX.limbs(rest))}, pb16(c, rest, hl)) :
                        {RR.join(Some{List.append(&2, U32, SP.limb_digits(a0), List.append(&2, U32, SP.limb_digits(a1), List.append(&2, U32, SP.limb_digits(a2), SP.limb_digits(a3))))}, _) == Some{WS.btake(LV.e16(1n+c), FX.limbs(Con{a0, Con{a1, Con{a2, Con{a3, rest}}}}))} : Maybe<&2, +List<U32>>}
                      %IE.limb_correct(a0) :
                        {RR.join(Some{List.append(&2, U32, _, List.append(&2, U32, SP.limb_digits(a1), List.append(&2, U32, SP.limb_digits(a2), SP.limb_digits(a3))))}, Some{WS.btake(LV.e16(c), FX.limbs(rest))}) == Some{WS.btake(LV.e16(1n+c), FX.limbs(Con{a0, Con{a1, Con{a2, Con{a3, rest}}}}))} : Maybe<&2, +List<U32>>}
                      %IE.limb_correct(a1) :
                        {RR.join(Some{List.append(&2, U32, I.limb(a0), List.append(&2, U32, _, List.append(&2, U32, SP.limb_digits(a2), SP.limb_digits(a3))))}, Some{WS.btake(LV.e16(c), FX.limbs(rest))}) == Some{WS.btake(LV.e16(1n+c), FX.limbs(Con{a0, Con{a1, Con{a2, Con{a3, rest}}}}))} : Maybe<&2, +List<U32>>}
                      %IE.limb_correct(a2) :
                        {RR.join(Some{List.append(&2, U32, I.limb(a0), List.append(&2, U32, I.limb(a1), List.append(&2, U32, _, SP.limb_digits(a3))))}, Some{WS.btake(LV.e16(c), FX.limbs(rest))}) == Some{WS.btake(LV.e16(1n+c), FX.limbs(Con{a0, Con{a1, Con{a2, Con{a3, rest}}}}))} : Maybe<&2, +List<U32>>}
                      %IE.limb_correct(a3) :
                        {RR.join(Some{List.append(&2, U32, I.limb(a0), List.append(&2, U32, I.limb(a1), List.append(&2, U32, I.limb(a2), _)))}, Some{WS.btake(LV.e16(c), FX.limbs(rest))}) == Some{WS.btake(LV.e16(1n+c), FX.limbs(Con{a0, Con{a1, Con{a2, Con{a3, rest}}}}))} : Maybe<&2, +List<U32>>}
                      {==}

law e16_mul:
  for +L: Nat
  {LV.e16(L) == Nat.mul(L, 16n) : Nat}
def e16_mul(L):
  match L:
    case 0n: {==}
    case 1n+ +p:
      %Equal.sym(Nat, LV.e16(p), Nat.mul(p, 16n), e16_mul(p)) : {16n+_ == Nat.add(16n, Nat.mul(p, 16n)) : Nat}
      {==}

law e16_mono:
  for +a: Nat
  for +b: Nat
  for +e: {Nat.is_le(a, b) == True{} : Bool}
  {Nat.is_le(LV.e16(a), LV.e16(b)) == True{} : Bool}
def e16_mono(a, b, e):
  match a b:
    case 0n _: Order.zero_le(LV.e16(b))
    case 1n+p 0n: Empty.absurd({Nat.is_le(LV.e16(1n+p), LV.e16(0n)) == True{} : Bool}, MD.false_true(e))
    case 1n+ +p 1n+ +q: e16_mono(p, q, e)

def is_U128(w: P.Width) -> Bool:
  match w:
    case P.U128{}: True{}
    case _: False{}

law is_U128_shape:
  for +w: P.Width
  for +e: {is_U128(w) == True{} : Bool}
  {w == P.U128{} : P.Width}
def is_U128_shape(w, e):
  match w:
    case P.U8{}: Empty.absurd({P.U8{} == P.U128{} : P.Width}, MD.false_true(e))
    case P.U16{}: Empty.absurd({P.U16{} == P.U128{} : P.Width}, MD.false_true(e))
    case P.U32Width{}: Empty.absurd({P.U32Width{} == P.U128{} : P.Width}, MD.false_true(e))
    case P.U64{}: Empty.absurd({P.U64{} == P.U128{} : P.Width}, MD.false_true(e))
    case P.U128{}: {==}
    case P.U256{}: Empty.absurd({P.U256{} == P.U128{} : P.Width}, MD.false_true(e))

# The schema is a vector of uint128 whose chunk limit has minimal depth `depth`.
def ok_v16(+s: S.Schema, +depth: Nat) -> Bool:
  Bool.and(SH.is_Vector(s), Bool.and(SH.is_Unsigned(SH.Vector_element(s)), Bool.and(is_U128(SH.Unsigned_width(SH.Vector_element(s))), Lim.minimal(Nat.div(Nat.add(Nat.mul(SH.Vector_length(s), 16n), 31n), 32n), depth))))

def rep_wf16(-o: O.Words, +s: S.Schema, +rep: LV.rep_v16(o, s)) -> WO.wf1(o):
  (+wf, +r) = rep
  wf

def eq_n16(-o: O.Words, +t: F.array__Tree<U32>, +N: U32, +eo: {o == O.Words{F.array__thaw(U32, t), N} : O.Words},
    +eN: {U32.to_nat(WO.len(o)) == LV.e16(LV.cnt16(o)) : Nat}) -> {U32.to_nat(N) == LV.e16(U32.to_nat(U32.shrn(N, 4n))) : Nat}:
  %Equal.cong(O.Words, U32, WO.len, o, O.Words{F.array__thaw(U32, t), N}, eo) : {U32.to_nat(_) == LV.e16(U32.to_nat(U32.shrn(_, 4n))) : Nat}
  eN

def eqn_n16(-o: O.Words, +t: F.array__Tree<U32>, +N: U32, +L: Nat, +eo: {o == O.Words{F.array__thaw(U32, t), N} : O.Words},
    +hv: {Nat.is_eq(LV.cnt16(o), L) == True{} : Bool}) -> {Nat.is_eq(U32.to_nat(U32.shrn(N, 4n)), L) == True{} : Bool}:
  %Equal.cong(O.Words, U32, WO.len, o, O.Words{F.array__thaw(U32, t), N}, eo) : {Nat.is_eq(U32.to_nat(U32.shrn(_, 4n)), L) == True{} : Bool}
  hv

def le_n16(-o: O.Words, +t: F.array__Tree<U32>, +N: U32, +L: Nat, +eo: {o == O.Words{F.array__thaw(U32, t), N} : O.Words},
    +hv: {Nat.is_eq(LV.cnt16(o), L) == True{} : Bool}) -> {Nat.is_le(U32.to_nat(U32.shrn(N, 4n)), L) == True{} : Bool}:
  eq_le(U32.to_nat(U32.shrn(N, 4n)), L, eqn_n16(o, t, N, L, eo, hv))

# m16(c) words fit the array: 16c = 32q + r <= 32(q + 1) bytes, so m16(c) <= 8(q + 1) words.
def words_fit16(+c: Nat, +q: Nat, +r: Nat, +dw: Nat, +t: F.array__Tree<U32>,
    +ec: {Nat.add(WS.e32(q), r) == LV.e16(c) : Nat},
    +h32: {Nat.is_le(r, 32n) == True{} : Bool},
    +pf: {F.array__perfect(U32, dw, t) == True{} : Bool},
    +room: {Nat.is_le(O.e8(1n+q), F.spec_common__pow2(dw)) == True{} : Bool})
    -> {Nat.is_le(LV.m16(c), F.spec_common__length(U32, F.array__slots(U32, t))) == True{} : Bool}:
  +a1 = Order.add_left(WS.e32(q), r, 32n, h32)
  +a2 = UL.rw_le_l(Nat.add(WS.e32(q), r), LV.e16(c), Nat.add(WS.e32(q), 32n), ec, a1)
  +a3 = UL.rw_le_r(LV.e16(c), Nat.add(WS.e32(q), 32n), WS.e32(1n+q), UL.add32(q), a2)
  +a4 = UL.dbl_cancel(LV.m16(c), O.e8(1n+q), UL.dbl_cancel(Nat.double(LV.m16(c)), Nat.double(O.e8(1n+q)), a3))
  Order.transitive(LV.m16(c), O.e8(1n+q), F.spec_common__length(U32, F.array__slots(U32, t)), a4, UL.cap_q(q, dw, t, pf, room))

def v16_enc(+N: U32, +q: Nat, +r: Nat, +dw: Nat, +t: F.array__Tree<U32>,
    +eNN: {U32.to_nat(N) == LV.e16(U32.to_nat(U32.shrn(N, 4n))) : Nat},
    +enq: {U32.to_nat(N) == Nat.add(WS.e32(q), r) : Nat},
    +h32: {Nat.is_le(r, 32n) == True{} : Bool},
    +pf: {F.array__perfect(U32, dw, t) == True{} : Bool},
    +room: {Nat.is_le(O.e8(1n+q), F.spec_common__pow2(dw)) == True{} : Bool})
    -> {RR.basic_bytes(LV.it16(U32.to_nat(U32.shrn(N, 4n)), F.array__slots(U32, t)), S.Unsigned{P.U128{}}) == Some{WS.btake(U32.to_nat(N), FX.limbs(F.array__slots(U32, t)))} : Maybe<&2, +List<U32>>}:
  +ec = Equal.trans(Nat, Nat.add(WS.e32(q), r), U32.to_nat(N), LV.e16(U32.to_nat(U32.shrn(N, 4n))), Equal.sym(Nat, U32.to_nat(N), Nat.add(WS.e32(q), r), enq), eNN)
  %Equal.sym(Nat, U32.to_nat(N), LV.e16(U32.to_nat(U32.shrn(N, 4n))), eNN) :
    {RR.basic_bytes(LV.it16(U32.to_nat(U32.shrn(N, 4n)), F.array__slots(U32, t)), S.Unsigned{P.U128{}}) == Some{WS.btake(_, FX.limbs(F.array__slots(U32, t)))} : Maybe<&2, +List<U32>>}
  pb16(U32.to_nat(U32.shrn(N, 4n)), F.array__slots(U32, t), words_fit16(U32.to_nat(U32.shrn(N, 4n)), q, r, dw, t, ec, h32, pf, room))

def v16_lim(+N: U32, +q: Nat, +r: Nat, +L: Nat, +t: F.array__Tree<U32>,
    +eNN: {U32.to_nat(N) == LV.e16(U32.to_nat(U32.shrn(N, 4n))) : Nat},
    +enq: {U32.to_nat(N) == Nat.add(WS.e32(q), r) : Nat},
    +h1: {Nat.is_lt(0n, r) == True{} : Bool}, +h32: {Nat.is_le(r, 32n) == True{} : Bool},
    +hvN: {Nat.is_le(U32.to_nat(U32.shrn(N, 4n)), L) == True{} : Bool})
    -> {Nat.is_le(MD.dlen(MR.clist(1n+q, F.array__slots(U32, t), 0n)), Nat.div(Nat.add(Nat.mul(L, 16n), 31n), 32n)) == True{} : Bool}:
  +ec = Equal.trans(Nat, Nat.add(WS.e32(q), r), U32.to_nat(N), LV.e16(U32.to_nat(U32.shrn(N, 4n))), Equal.sym(Nat, U32.to_nat(N), Nat.add(WS.e32(q), r), enq), eNN)
  +hm = UL.rw_le_r(LV.e16(U32.to_nat(U32.shrn(N, 4n))), LV.e16(L), Nat.mul(L, 16n), e16_mul(L), e16_mono(U32.to_nat(U32.shrn(N, 4n)), L, hvN))
  +hn = UL.rw_le_l(LV.e16(U32.to_nat(U32.shrn(N, 4n))), Nat.add(WS.e32(q), r), Nat.mul(L, 16n), Equal.sym(Nat, Nat.add(WS.e32(q), r), LV.e16(U32.to_nat(U32.shrn(N, 4n))), ec), hm)
  LR.bl_hlen(q, t, Nat.mul(L, 16n), NF.chunk_le(q, r, Nat.mul(L, 16n), h1, h32, hn))

def v16_body(+hl: Nat, +ehl: {hl == 64n : Nat}, -o: O.Words, +L: Nat, +depth: Nat,
    +wf: WO.wf1(o),
    +eN: {U32.to_nat(WO.len(o)) == LV.e16(LV.cnt16(o)) : Nat},
    +hv: {Nat.is_eq(LV.cnt16(o), L) == True{} : Bool},
    +hmin: {Lim.minimal(Nat.div(Nat.add(Nat.mul(L, 16n), 31n), 32n), depth) == True{} : Bool},
    +hdep: {Nat.is_lt(depth, 64n) == True{} : Bool})
    -> RR.roots(LV.vview16(o), S.Vector{S.Unsigned{P.U128{}}, L}, [D.bytes(WO.wdig(hl, o, depth))]):
  (+t, w1) = wf
  (+dw, w2) = w1
  (+N, w3) = w2
  (+q, w4) = w3
  (+r, w5) = w4
  (+eo, w6) = w5
  (+pf, w7) = w6
  (+hd, w8) = w7
  (+enq, w9) = w8
  (+h1, w10) = w9
  (+h32, w11) = w10
  (+room, +slack) = w11
  +eNN = eq_n16(o, t, N, eo, eN)
  +hvN = le_n16(o, t, N, L, eo, hv)
  %Equal.sym(O.Words, o, O.Words{F.array__thaw(U32, t), N}, eo) :
    RR.roots(LV.vview16(_), S.Vector{S.Unsigned{P.U128{}}, L}, [D.bytes(WO.wdig(hl, _, depth))])
  %Equal.sym(F.array__Tree<U32>, F.array__freeze(U32, F.array__thaw(U32, t)), t, F.array__freeze_thaw(U32, t)) :
    RR.roots(S.Sequence{LV.it16(U32.to_nat(U32.shrn(N, 4n)), F.array__slots(U32, _))}, S.Vector{S.Unsigned{P.U128{}}, L}, [D.bytes(MD.rtree(depth, Nat.is_lt(0n, O.chunks_of(N)), hl, MR.clist(O.chunks_of(N), F.array__slots(U32, _), 0n), 0n))])
  %Equal.sym(Nat, O.chunks_of(N), 1n+q, WO.chunks_q(N, q, r, enq, h1, h32)) :
    RR.roots(S.Sequence{LV.it16(U32.to_nat(U32.shrn(N, 4n)), F.array__slots(U32, t))}, S.Vector{S.Unsigned{P.U128{}}, L}, [D.bytes(MD.rtree(depth, Nat.is_lt(0n, _), hl, MR.clist(_, F.array__slots(U32, t), 0n), 0n))])
  (MD.bytes_list(MR.clist(1n+q, F.array__slots(U32, t), 0n)),
    ((WS.btake(U32.to_nat(N), FX.limbs(F.array__slots(U32, t))), (v16_enc(N, q, r, dw, t, eNN, enq, h32, pf, room), UL.ul_pack(N, q, r, dw, t, enq, h1, h32, pf, room, slack))),
     (D.bytes(MD.rtree(depth, True{}, hl, MR.clist(1n+q, F.array__slots(U32, t), 0n), 0n)),
      ((depth, (hmin, RS.at_depth_tree(Nat.div(Nat.add(Nat.mul(L, 16n), 31n), 32n), depth, hl, MR.clist(1n+q, F.array__slots(U32, t), 0n), hdep, v16_lim(N, q, r, L, t, eNN, enq, h1, h32, hvN), ehl))),
       {==}))))

# A vector of uint128: its digest is a specification root of its elements.
def v16_rs(+hl: Nat, +ehl: {hl == 64n : Nat}, -o: O.Words, +s: S.Schema, +depth: Nat,
    +rep: LV.rep_v16(o, s),
    +ok: {ok_v16(s, depth) == True{} : Bool},
    +hdep: {Nat.is_lt(depth, 64n) == True{} : Bool})
    -> RR.roots(LV.vview16(o), s, [D.bytes(WO.wdig(hl, o, depth))]):
  (+wf, +r1) = rep
  (+eN, +hq) = r1
  +c0 = DK.and_l(SH.is_Vector(s), Bool.and(SH.is_Unsigned(SH.Vector_element(s)), Bool.and(is_U128(SH.Unsigned_width(SH.Vector_element(s))), Lim.minimal(Nat.div(Nat.add(Nat.mul(SH.Vector_length(s), 16n), 31n), 32n), depth))), ok)
  +k1 = DK.and_r(SH.is_Vector(s), Bool.and(SH.is_Unsigned(SH.Vector_element(s)), Bool.and(is_U128(SH.Unsigned_width(SH.Vector_element(s))), Lim.minimal(Nat.div(Nat.add(Nat.mul(SH.Vector_length(s), 16n), 31n), 32n), depth))), ok)
  +c1 = DK.and_l(SH.is_Unsigned(SH.Vector_element(s)), Bool.and(is_U128(SH.Unsigned_width(SH.Vector_element(s))), Lim.minimal(Nat.div(Nat.add(Nat.mul(SH.Vector_length(s), 16n), 31n), 32n), depth)), k1)
  +k2 = DK.and_r(SH.is_Unsigned(SH.Vector_element(s)), Bool.and(is_U128(SH.Unsigned_width(SH.Vector_element(s))), Lim.minimal(Nat.div(Nat.add(Nat.mul(SH.Vector_length(s), 16n), 31n), 32n), depth)), k1)
  +c2 = DK.and_l(is_U128(SH.Unsigned_width(SH.Vector_element(s))), Lim.minimal(Nat.div(Nat.add(Nat.mul(SH.Vector_length(s), 16n), 31n), 32n), depth), k2)
  +c3 = DK.and_r(is_U128(SH.Unsigned_width(SH.Vector_element(s))), Lim.minimal(Nat.div(Nat.add(Nat.mul(SH.Vector_length(s), 16n), 31n), 32n), depth), k2)
  %Equal.sym(S.Schema, s, S.Vector{SH.Vector_element(s), SH.Vector_length(s)}, SH.Vector_shape(s, c0)) :
    RR.roots(LV.vview16(o), _, [D.bytes(WO.wdig(hl, o, depth))])
  %Equal.sym(S.Schema, SH.Vector_element(s), S.Unsigned{SH.Unsigned_width(SH.Vector_element(s))}, SH.Unsigned_shape(SH.Vector_element(s), c1)) :
    RR.roots(LV.vview16(o), S.Vector{_, SH.Vector_length(s)}, [D.bytes(WO.wdig(hl, o, depth))])
  %Equal.sym(P.Width, SH.Unsigned_width(SH.Vector_element(s)), P.U128{}, is_U128_shape(SH.Unsigned_width(SH.Vector_element(s)), c2)) :
    RR.roots(LV.vview16(o), S.Vector{S.Unsigned{_}, SH.Vector_length(s)}, [D.bytes(WO.wdig(hl, o, depth))])
  v16_body(hl, ehl, o, SH.Vector_length(s), depth, wf, eN, hq, c3, hdep)

# ---- uint256: 8 words per element ----------------------------------------

law pb32:
  for +k: Nat
  for +W: List<&2, U32>
  for +hl: {Nat.is_le(LV.m32(k), F.spec_common__length(U32, W)) == True{} : Bool}
  {RR.basic_bytes(LV.it32(k, W), S.Unsigned{P.U256{}}) == Some{WS.btake(LV.e32(k), FX.limbs(W))} : Maybe<&2, +List<U32>>}
def pb32(k, W, hl):
  match k:
    case 0n: {==}
    case 1n+ +c:
      match W:
        case Nil{}: Empty.absurd({RR.basic_bytes(LV.it32(1n+c, Nil{}), S.Unsigned{P.U256{}}) == Some{WS.btake(LV.e32(1n+c), FX.limbs(Nil{}))} : Maybe<&2, +List<U32>>}, MD.false_true(hl))
        case Con{+a0, +t0}:
          match t0:
            case Nil{}: Empty.absurd({RR.basic_bytes(LV.it32(1n+c, Con{a0, Nil{}}), S.Unsigned{P.U256{}}) == Some{WS.btake(LV.e32(1n+c), FX.limbs(Con{a0, Nil{}}))} : Maybe<&2, +List<U32>>}, MD.false_true(hl))
            case Con{+a1, +t1}:
              match t1:
                case Nil{}: Empty.absurd({RR.basic_bytes(LV.it32(1n+c, Con{a0, Con{a1, Nil{}}}), S.Unsigned{P.U256{}}) == Some{WS.btake(LV.e32(1n+c), FX.limbs(Con{a0, Con{a1, Nil{}}}))} : Maybe<&2, +List<U32>>}, MD.false_true(hl))
                case Con{+a2, +t2}:
                  match t2:
                    case Nil{}: Empty.absurd({RR.basic_bytes(LV.it32(1n+c, Con{a0, Con{a1, Con{a2, Nil{}}}}), S.Unsigned{P.U256{}}) == Some{WS.btake(LV.e32(1n+c), FX.limbs(Con{a0, Con{a1, Con{a2, Nil{}}}}))} : Maybe<&2, +List<U32>>}, MD.false_true(hl))
                    case Con{+a3, +t3}:
                      match t3:
                        case Nil{}: Empty.absurd({RR.basic_bytes(LV.it32(1n+c, Con{a0, Con{a1, Con{a2, Con{a3, Nil{}}}}}), S.Unsigned{P.U256{}}) == Some{WS.btake(LV.e32(1n+c), FX.limbs(Con{a0, Con{a1, Con{a2, Con{a3, Nil{}}}}}))} : Maybe<&2, +List<U32>>}, MD.false_true(hl))
                        case Con{+a4, +t4}:
                          match t4:
                            case Nil{}: Empty.absurd({RR.basic_bytes(LV.it32(1n+c, Con{a0, Con{a1, Con{a2, Con{a3, Con{a4, Nil{}}}}}}), S.Unsigned{P.U256{}}) == Some{WS.btake(LV.e32(1n+c), FX.limbs(Con{a0, Con{a1, Con{a2, Con{a3, Con{a4, Nil{}}}}}}))} : Maybe<&2, +List<U32>>}, MD.false_true(hl))
                            case Con{+a5, +t5}:
                              match t5:
                                case Nil{}: Empty.absurd({RR.basic_bytes(LV.it32(1n+c, Con{a0, Con{a1, Con{a2, Con{a3, Con{a4, Con{a5, Nil{}}}}}}}), S.Unsigned{P.U256{}}) == Some{WS.btake(LV.e32(1n+c), FX.limbs(Con{a0, Con{a1, Con{a2, Con{a3, Con{a4, Con{a5, Nil{}}}}}}}))} : Maybe<&2, +List<U32>>}, MD.false_true(hl))
                                case Con{+a6, +t6}:
                                  match t6:
                                    case Nil{}: Empty.absurd({RR.basic_bytes(LV.it32(1n+c, Con{a0, Con{a1, Con{a2, Con{a3, Con{a4, Con{a5, Con{a6, Nil{}}}}}}}}), S.Unsigned{P.U256{}}) == Some{WS.btake(LV.e32(1n+c), FX.limbs(Con{a0, Con{a1, Con{a2, Con{a3, Con{a4, Con{a5, Con{a6, Nil{}}}}}}}}))} : Maybe<&2, +List<U32>>}, MD.false_true(hl))
                                    case Con{+a7, +rest}:
                                      %Equal.sym(Maybe<&2, +List<U32>>, RR.basic_bytes(LV.it32(c, rest), S.Unsigned{P.U256{}}), Some{WS.btake(LV.e32(c), FX.limbs(rest))}, pb32(c, rest, hl)) :
                                        {RR.join(Some{List.append(&2, U32, SP.limb_digits(a0), List.append(&2, U32, SP.limb_digits(a1), List.append(&2, U32, SP.limb_digits(a2), List.append(&2, U32, SP.limb_digits(a3), List.append(&2, U32, SP.limb_digits(a4), List.append(&2, U32, SP.limb_digits(a5), List.append(&2, U32, SP.limb_digits(a6), SP.limb_digits(a7))))))))}, _) == Some{WS.btake(LV.e32(1n+c), FX.limbs(Con{a0, Con{a1, Con{a2, Con{a3, Con{a4, Con{a5, Con{a6, Con{a7, rest}}}}}}}}))} : Maybe<&2, +List<U32>>}
                                      %IE.limb_correct(a0) :
                                        {RR.join(Some{List.append(&2, U32, _, List.append(&2, U32, SP.limb_digits(a1), List.append(&2, U32, SP.limb_digits(a2), List.append(&2, U32, SP.limb_digits(a3), List.append(&2, U32, SP.limb_digits(a4), List.append(&2, U32, SP.limb_digits(a5), List.append(&2, U32, SP.limb_digits(a6), SP.limb_digits(a7))))))))}, Some{WS.btake(LV.e32(c), FX.limbs(rest))}) == Some{WS.btake(LV.e32(1n+c), FX.limbs(Con{a0, Con{a1, Con{a2, Con{a3, Con{a4, Con{a5, Con{a6, Con{a7, rest}}}}}}}}))} : Maybe<&2, +List<U32>>}
                                      %IE.limb_correct(a1) :
                                        {RR.join(Some{List.append(&2, U32, I.limb(a0), List.append(&2, U32, _, List.append(&2, U32, SP.limb_digits(a2), List.append(&2, U32, SP.limb_digits(a3), List.append(&2, U32, SP.limb_digits(a4), List.append(&2, U32, SP.limb_digits(a5), List.append(&2, U32, SP.limb_digits(a6), SP.limb_digits(a7))))))))}, Some{WS.btake(LV.e32(c), FX.limbs(rest))}) == Some{WS.btake(LV.e32(1n+c), FX.limbs(Con{a0, Con{a1, Con{a2, Con{a3, Con{a4, Con{a5, Con{a6, Con{a7, rest}}}}}}}}))} : Maybe<&2, +List<U32>>}
                                      %IE.limb_correct(a2) :
                                        {RR.join(Some{List.append(&2, U32, I.limb(a0), List.append(&2, U32, I.limb(a1), List.append(&2, U32, _, List.append(&2, U32, SP.limb_digits(a3), List.append(&2, U32, SP.limb_digits(a4), List.append(&2, U32, SP.limb_digits(a5), List.append(&2, U32, SP.limb_digits(a6), SP.limb_digits(a7))))))))}, Some{WS.btake(LV.e32(c), FX.limbs(rest))}) == Some{WS.btake(LV.e32(1n+c), FX.limbs(Con{a0, Con{a1, Con{a2, Con{a3, Con{a4, Con{a5, Con{a6, Con{a7, rest}}}}}}}}))} : Maybe<&2, +List<U32>>}
                                      %IE.limb_correct(a3) :
                                        {RR.join(Some{List.append(&2, U32, I.limb(a0), List.append(&2, U32, I.limb(a1), List.append(&2, U32, I.limb(a2), List.append(&2, U32, _, List.append(&2, U32, SP.limb_digits(a4), List.append(&2, U32, SP.limb_digits(a5), List.append(&2, U32, SP.limb_digits(a6), SP.limb_digits(a7))))))))}, Some{WS.btake(LV.e32(c), FX.limbs(rest))}) == Some{WS.btake(LV.e32(1n+c), FX.limbs(Con{a0, Con{a1, Con{a2, Con{a3, Con{a4, Con{a5, Con{a6, Con{a7, rest}}}}}}}}))} : Maybe<&2, +List<U32>>}
                                      %IE.limb_correct(a4) :
                                        {RR.join(Some{List.append(&2, U32, I.limb(a0), List.append(&2, U32, I.limb(a1), List.append(&2, U32, I.limb(a2), List.append(&2, U32, I.limb(a3), List.append(&2, U32, _, List.append(&2, U32, SP.limb_digits(a5), List.append(&2, U32, SP.limb_digits(a6), SP.limb_digits(a7))))))))}, Some{WS.btake(LV.e32(c), FX.limbs(rest))}) == Some{WS.btake(LV.e32(1n+c), FX.limbs(Con{a0, Con{a1, Con{a2, Con{a3, Con{a4, Con{a5, Con{a6, Con{a7, rest}}}}}}}}))} : Maybe<&2, +List<U32>>}
                                      %IE.limb_correct(a5) :
                                        {RR.join(Some{List.append(&2, U32, I.limb(a0), List.append(&2, U32, I.limb(a1), List.append(&2, U32, I.limb(a2), List.append(&2, U32, I.limb(a3), List.append(&2, U32, I.limb(a4), List.append(&2, U32, _, List.append(&2, U32, SP.limb_digits(a6), SP.limb_digits(a7))))))))}, Some{WS.btake(LV.e32(c), FX.limbs(rest))}) == Some{WS.btake(LV.e32(1n+c), FX.limbs(Con{a0, Con{a1, Con{a2, Con{a3, Con{a4, Con{a5, Con{a6, Con{a7, rest}}}}}}}}))} : Maybe<&2, +List<U32>>}
                                      %IE.limb_correct(a6) :
                                        {RR.join(Some{List.append(&2, U32, I.limb(a0), List.append(&2, U32, I.limb(a1), List.append(&2, U32, I.limb(a2), List.append(&2, U32, I.limb(a3), List.append(&2, U32, I.limb(a4), List.append(&2, U32, I.limb(a5), List.append(&2, U32, _, SP.limb_digits(a7))))))))}, Some{WS.btake(LV.e32(c), FX.limbs(rest))}) == Some{WS.btake(LV.e32(1n+c), FX.limbs(Con{a0, Con{a1, Con{a2, Con{a3, Con{a4, Con{a5, Con{a6, Con{a7, rest}}}}}}}}))} : Maybe<&2, +List<U32>>}
                                      %IE.limb_correct(a7) :
                                        {RR.join(Some{List.append(&2, U32, I.limb(a0), List.append(&2, U32, I.limb(a1), List.append(&2, U32, I.limb(a2), List.append(&2, U32, I.limb(a3), List.append(&2, U32, I.limb(a4), List.append(&2, U32, I.limb(a5), List.append(&2, U32, I.limb(a6), _)))))))}, Some{WS.btake(LV.e32(c), FX.limbs(rest))}) == Some{WS.btake(LV.e32(1n+c), FX.limbs(Con{a0, Con{a1, Con{a2, Con{a3, Con{a4, Con{a5, Con{a6, Con{a7, rest}}}}}}}}))} : Maybe<&2, +List<U32>>}
                                      {==}

law e32_mul:
  for +L: Nat
  {LV.e32(L) == Nat.mul(L, 32n) : Nat}
def e32_mul(L):
  match L:
    case 0n: {==}
    case 1n+ +p:
      %Equal.sym(Nat, LV.e32(p), Nat.mul(p, 32n), e32_mul(p)) : {32n+_ == Nat.add(32n, Nat.mul(p, 32n)) : Nat}
      {==}

law e32_mono:
  for +a: Nat
  for +b: Nat
  for +e: {Nat.is_le(a, b) == True{} : Bool}
  {Nat.is_le(LV.e32(a), LV.e32(b)) == True{} : Bool}
def e32_mono(a, b, e):
  match a b:
    case 0n _: Order.zero_le(LV.e32(b))
    case 1n+p 0n: Empty.absurd({Nat.is_le(LV.e32(1n+p), LV.e32(0n)) == True{} : Bool}, MD.false_true(e))
    case 1n+ +p 1n+ +q: e32_mono(p, q, e)

def is_U256(w: P.Width) -> Bool:
  match w:
    case P.U256{}: True{}
    case _: False{}

law is_U256_shape:
  for +w: P.Width
  for +e: {is_U256(w) == True{} : Bool}
  {w == P.U256{} : P.Width}
def is_U256_shape(w, e):
  match w:
    case P.U8{}: Empty.absurd({P.U8{} == P.U256{} : P.Width}, MD.false_true(e))
    case P.U16{}: Empty.absurd({P.U16{} == P.U256{} : P.Width}, MD.false_true(e))
    case P.U32Width{}: Empty.absurd({P.U32Width{} == P.U256{} : P.Width}, MD.false_true(e))
    case P.U64{}: Empty.absurd({P.U64{} == P.U256{} : P.Width}, MD.false_true(e))
    case P.U128{}: Empty.absurd({P.U128{} == P.U256{} : P.Width}, MD.false_true(e))
    case P.U256{}: {==}

# The schema is a vector of uint256 whose chunk limit has minimal depth `depth`.
def ok_v32(+s: S.Schema, +depth: Nat) -> Bool:
  Bool.and(SH.is_Vector(s), Bool.and(SH.is_Unsigned(SH.Vector_element(s)), Bool.and(is_U256(SH.Unsigned_width(SH.Vector_element(s))), Lim.minimal(Nat.div(Nat.add(Nat.mul(SH.Vector_length(s), 32n), 31n), 32n), depth))))

def rep_wf32(-o: O.Words, +s: S.Schema, +rep: LV.rep_v32(o, s)) -> WO.wf1(o):
  (+wf, +r) = rep
  wf

def eq_n32(-o: O.Words, +t: F.array__Tree<U32>, +N: U32, +eo: {o == O.Words{F.array__thaw(U32, t), N} : O.Words},
    +eN: {U32.to_nat(WO.len(o)) == LV.e32(LV.cnt32(o)) : Nat}) -> {U32.to_nat(N) == LV.e32(U32.to_nat(U32.shrn(N, 5n))) : Nat}:
  %Equal.cong(O.Words, U32, WO.len, o, O.Words{F.array__thaw(U32, t), N}, eo) : {U32.to_nat(_) == LV.e32(U32.to_nat(U32.shrn(_, 5n))) : Nat}
  eN

def eqn_n32(-o: O.Words, +t: F.array__Tree<U32>, +N: U32, +L: Nat, +eo: {o == O.Words{F.array__thaw(U32, t), N} : O.Words},
    +hv: {Nat.is_eq(LV.cnt32(o), L) == True{} : Bool}) -> {Nat.is_eq(U32.to_nat(U32.shrn(N, 5n)), L) == True{} : Bool}:
  %Equal.cong(O.Words, U32, WO.len, o, O.Words{F.array__thaw(U32, t), N}, eo) : {Nat.is_eq(U32.to_nat(U32.shrn(_, 5n)), L) == True{} : Bool}
  hv

def le_n32(-o: O.Words, +t: F.array__Tree<U32>, +N: U32, +L: Nat, +eo: {o == O.Words{F.array__thaw(U32, t), N} : O.Words},
    +hv: {Nat.is_eq(LV.cnt32(o), L) == True{} : Bool}) -> {Nat.is_le(U32.to_nat(U32.shrn(N, 5n)), L) == True{} : Bool}:
  eq_le(U32.to_nat(U32.shrn(N, 5n)), L, eqn_n32(o, t, N, L, eo, hv))

# m32(c) words fit the array: 32c = 32q + r <= 32(q + 1) bytes, so m32(c) <= 8(q + 1) words.
def words_fit32(+c: Nat, +q: Nat, +r: Nat, +dw: Nat, +t: F.array__Tree<U32>,
    +ec: {Nat.add(WS.e32(q), r) == LV.e32(c) : Nat},
    +h32: {Nat.is_le(r, 32n) == True{} : Bool},
    +pf: {F.array__perfect(U32, dw, t) == True{} : Bool},
    +room: {Nat.is_le(O.e8(1n+q), F.spec_common__pow2(dw)) == True{} : Bool})
    -> {Nat.is_le(LV.m32(c), F.spec_common__length(U32, F.array__slots(U32, t))) == True{} : Bool}:
  +a1 = Order.add_left(WS.e32(q), r, 32n, h32)
  +a2 = UL.rw_le_l(Nat.add(WS.e32(q), r), LV.e32(c), Nat.add(WS.e32(q), 32n), ec, a1)
  +a3 = UL.rw_le_r(LV.e32(c), Nat.add(WS.e32(q), 32n), WS.e32(1n+q), UL.add32(q), a2)
  +a4 = UL.dbl_cancel(LV.m32(c), O.e8(1n+q), UL.dbl_cancel(Nat.double(LV.m32(c)), Nat.double(O.e8(1n+q)), a3))
  Order.transitive(LV.m32(c), O.e8(1n+q), F.spec_common__length(U32, F.array__slots(U32, t)), a4, UL.cap_q(q, dw, t, pf, room))

def v32_enc(+N: U32, +q: Nat, +r: Nat, +dw: Nat, +t: F.array__Tree<U32>,
    +eNN: {U32.to_nat(N) == LV.e32(U32.to_nat(U32.shrn(N, 5n))) : Nat},
    +enq: {U32.to_nat(N) == Nat.add(WS.e32(q), r) : Nat},
    +h32: {Nat.is_le(r, 32n) == True{} : Bool},
    +pf: {F.array__perfect(U32, dw, t) == True{} : Bool},
    +room: {Nat.is_le(O.e8(1n+q), F.spec_common__pow2(dw)) == True{} : Bool})
    -> {RR.basic_bytes(LV.it32(U32.to_nat(U32.shrn(N, 5n)), F.array__slots(U32, t)), S.Unsigned{P.U256{}}) == Some{WS.btake(U32.to_nat(N), FX.limbs(F.array__slots(U32, t)))} : Maybe<&2, +List<U32>>}:
  +ec = Equal.trans(Nat, Nat.add(WS.e32(q), r), U32.to_nat(N), LV.e32(U32.to_nat(U32.shrn(N, 5n))), Equal.sym(Nat, U32.to_nat(N), Nat.add(WS.e32(q), r), enq), eNN)
  %Equal.sym(Nat, U32.to_nat(N), LV.e32(U32.to_nat(U32.shrn(N, 5n))), eNN) :
    {RR.basic_bytes(LV.it32(U32.to_nat(U32.shrn(N, 5n)), F.array__slots(U32, t)), S.Unsigned{P.U256{}}) == Some{WS.btake(_, FX.limbs(F.array__slots(U32, t)))} : Maybe<&2, +List<U32>>}
  pb32(U32.to_nat(U32.shrn(N, 5n)), F.array__slots(U32, t), words_fit32(U32.to_nat(U32.shrn(N, 5n)), q, r, dw, t, ec, h32, pf, room))

def v32_lim(+N: U32, +q: Nat, +r: Nat, +L: Nat, +t: F.array__Tree<U32>,
    +eNN: {U32.to_nat(N) == LV.e32(U32.to_nat(U32.shrn(N, 5n))) : Nat},
    +enq: {U32.to_nat(N) == Nat.add(WS.e32(q), r) : Nat},
    +h1: {Nat.is_lt(0n, r) == True{} : Bool}, +h32: {Nat.is_le(r, 32n) == True{} : Bool},
    +hvN: {Nat.is_le(U32.to_nat(U32.shrn(N, 5n)), L) == True{} : Bool})
    -> {Nat.is_le(MD.dlen(MR.clist(1n+q, F.array__slots(U32, t), 0n)), Nat.div(Nat.add(Nat.mul(L, 32n), 31n), 32n)) == True{} : Bool}:
  +ec = Equal.trans(Nat, Nat.add(WS.e32(q), r), U32.to_nat(N), LV.e32(U32.to_nat(U32.shrn(N, 5n))), Equal.sym(Nat, U32.to_nat(N), Nat.add(WS.e32(q), r), enq), eNN)
  +hm = UL.rw_le_r(LV.e32(U32.to_nat(U32.shrn(N, 5n))), LV.e32(L), Nat.mul(L, 32n), e32_mul(L), e32_mono(U32.to_nat(U32.shrn(N, 5n)), L, hvN))
  +hn = UL.rw_le_l(LV.e32(U32.to_nat(U32.shrn(N, 5n))), Nat.add(WS.e32(q), r), Nat.mul(L, 32n), Equal.sym(Nat, Nat.add(WS.e32(q), r), LV.e32(U32.to_nat(U32.shrn(N, 5n))), ec), hm)
  LR.bl_hlen(q, t, Nat.mul(L, 32n), NF.chunk_le(q, r, Nat.mul(L, 32n), h1, h32, hn))

def v32_body(+hl: Nat, +ehl: {hl == 64n : Nat}, -o: O.Words, +L: Nat, +depth: Nat,
    +wf: WO.wf1(o),
    +eN: {U32.to_nat(WO.len(o)) == LV.e32(LV.cnt32(o)) : Nat},
    +hv: {Nat.is_eq(LV.cnt32(o), L) == True{} : Bool},
    +hmin: {Lim.minimal(Nat.div(Nat.add(Nat.mul(L, 32n), 31n), 32n), depth) == True{} : Bool},
    +hdep: {Nat.is_lt(depth, 64n) == True{} : Bool})
    -> RR.roots(LV.vview32(o), S.Vector{S.Unsigned{P.U256{}}, L}, [D.bytes(WO.wdig(hl, o, depth))]):
  (+t, w1) = wf
  (+dw, w2) = w1
  (+N, w3) = w2
  (+q, w4) = w3
  (+r, w5) = w4
  (+eo, w6) = w5
  (+pf, w7) = w6
  (+hd, w8) = w7
  (+enq, w9) = w8
  (+h1, w10) = w9
  (+h32, w11) = w10
  (+room, +slack) = w11
  +eNN = eq_n32(o, t, N, eo, eN)
  +hvN = le_n32(o, t, N, L, eo, hv)
  %Equal.sym(O.Words, o, O.Words{F.array__thaw(U32, t), N}, eo) :
    RR.roots(LV.vview32(_), S.Vector{S.Unsigned{P.U256{}}, L}, [D.bytes(WO.wdig(hl, _, depth))])
  %Equal.sym(F.array__Tree<U32>, F.array__freeze(U32, F.array__thaw(U32, t)), t, F.array__freeze_thaw(U32, t)) :
    RR.roots(S.Sequence{LV.it32(U32.to_nat(U32.shrn(N, 5n)), F.array__slots(U32, _))}, S.Vector{S.Unsigned{P.U256{}}, L}, [D.bytes(MD.rtree(depth, Nat.is_lt(0n, O.chunks_of(N)), hl, MR.clist(O.chunks_of(N), F.array__slots(U32, _), 0n), 0n))])
  %Equal.sym(Nat, O.chunks_of(N), 1n+q, WO.chunks_q(N, q, r, enq, h1, h32)) :
    RR.roots(S.Sequence{LV.it32(U32.to_nat(U32.shrn(N, 5n)), F.array__slots(U32, t))}, S.Vector{S.Unsigned{P.U256{}}, L}, [D.bytes(MD.rtree(depth, Nat.is_lt(0n, _), hl, MR.clist(_, F.array__slots(U32, t), 0n), 0n))])
  (MD.bytes_list(MR.clist(1n+q, F.array__slots(U32, t), 0n)),
    ((WS.btake(U32.to_nat(N), FX.limbs(F.array__slots(U32, t))), (v32_enc(N, q, r, dw, t, eNN, enq, h32, pf, room), UL.ul_pack(N, q, r, dw, t, enq, h1, h32, pf, room, slack))),
     (D.bytes(MD.rtree(depth, True{}, hl, MR.clist(1n+q, F.array__slots(U32, t), 0n), 0n)),
      ((depth, (hmin, RS.at_depth_tree(Nat.div(Nat.add(Nat.mul(L, 32n), 31n), 32n), depth, hl, MR.clist(1n+q, F.array__slots(U32, t), 0n), hdep, v32_lim(N, q, r, L, t, eNN, enq, h1, h32, hvN), ehl))),
       {==}))))

# A vector of uint256: its digest is a specification root of its elements.
def v32_rs(+hl: Nat, +ehl: {hl == 64n : Nat}, -o: O.Words, +s: S.Schema, +depth: Nat,
    +rep: LV.rep_v32(o, s),
    +ok: {ok_v32(s, depth) == True{} : Bool},
    +hdep: {Nat.is_lt(depth, 64n) == True{} : Bool})
    -> RR.roots(LV.vview32(o), s, [D.bytes(WO.wdig(hl, o, depth))]):
  (+wf, +r1) = rep
  (+eN, +hq) = r1
  +c0 = DK.and_l(SH.is_Vector(s), Bool.and(SH.is_Unsigned(SH.Vector_element(s)), Bool.and(is_U256(SH.Unsigned_width(SH.Vector_element(s))), Lim.minimal(Nat.div(Nat.add(Nat.mul(SH.Vector_length(s), 32n), 31n), 32n), depth))), ok)
  +k1 = DK.and_r(SH.is_Vector(s), Bool.and(SH.is_Unsigned(SH.Vector_element(s)), Bool.and(is_U256(SH.Unsigned_width(SH.Vector_element(s))), Lim.minimal(Nat.div(Nat.add(Nat.mul(SH.Vector_length(s), 32n), 31n), 32n), depth))), ok)
  +c1 = DK.and_l(SH.is_Unsigned(SH.Vector_element(s)), Bool.and(is_U256(SH.Unsigned_width(SH.Vector_element(s))), Lim.minimal(Nat.div(Nat.add(Nat.mul(SH.Vector_length(s), 32n), 31n), 32n), depth)), k1)
  +k2 = DK.and_r(SH.is_Unsigned(SH.Vector_element(s)), Bool.and(is_U256(SH.Unsigned_width(SH.Vector_element(s))), Lim.minimal(Nat.div(Nat.add(Nat.mul(SH.Vector_length(s), 32n), 31n), 32n), depth)), k1)
  +c2 = DK.and_l(is_U256(SH.Unsigned_width(SH.Vector_element(s))), Lim.minimal(Nat.div(Nat.add(Nat.mul(SH.Vector_length(s), 32n), 31n), 32n), depth), k2)
  +c3 = DK.and_r(is_U256(SH.Unsigned_width(SH.Vector_element(s))), Lim.minimal(Nat.div(Nat.add(Nat.mul(SH.Vector_length(s), 32n), 31n), 32n), depth), k2)
  %Equal.sym(S.Schema, s, S.Vector{SH.Vector_element(s), SH.Vector_length(s)}, SH.Vector_shape(s, c0)) :
    RR.roots(LV.vview32(o), _, [D.bytes(WO.wdig(hl, o, depth))])
  %Equal.sym(S.Schema, SH.Vector_element(s), S.Unsigned{SH.Unsigned_width(SH.Vector_element(s))}, SH.Unsigned_shape(SH.Vector_element(s), c1)) :
    RR.roots(LV.vview32(o), S.Vector{_, SH.Vector_length(s)}, [D.bytes(WO.wdig(hl, o, depth))])
  %Equal.sym(P.Width, SH.Unsigned_width(SH.Vector_element(s)), P.U256{}, is_U256_shape(SH.Unsigned_width(SH.Vector_element(s)), c2)) :
    RR.roots(LV.vview32(o), S.Vector{S.Unsigned{_}, SH.Vector_length(s)}, [D.bytes(WO.wdig(hl, o, depth))])
  v32_body(hl, ehl, o, SH.Vector_length(s), depth, wf, eN, hq, c3, hdep)
