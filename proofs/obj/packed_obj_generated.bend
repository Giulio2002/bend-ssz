# m4(c) words fit the array: 4c = 32q + r <= 32(q + 1) bytes, so m4(c) <= 8(q + 1) words.
def words_fit4(+c: Nat, +q: Nat, +r: Nat, +dw: Nat, +t: F.array__Tree<U32>,
    +ec: {Nat.add(WS.e32(q), r) == LV.e4(c) : Nat},
