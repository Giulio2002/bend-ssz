def tz_conv(+rn: Nat, +r: U32, +x: U32, +er: {U32.to_nat(r) == rn : Nat}, +hr: {Nat.is_le(rn, 3n) == True{} : Bool}, +hp: {Nat.is_lt(0n, rn) == True{} : Bool}) -> {O.tail_zero(r, x) == BW.zlist(BW.bdrB(Nat.double(Nat.double(Nat.double(rn))), BLf.wbits(x))) : Bool}:
  match rn:
    case 0n: Empty.absurd({O.tail_zero(r, x) == BW.zlist(BW.bdrB(0n, BLf.wbits(x))) : Bool}, F.logic__false_true(hp))
    case 1n:
      +e = F.u32__injective(r, 1, er)
      F.logic__subst(U32, z => {O.tail_zero(z, x) == BW.zlist(BW.bdrB(8n, BLf.wbits(x))) : Bool}, 1, r, Equal.sym(U32, r, 1, e), tz_1(x))
    case 2n:
      +e = F.u32__injective(r, 2, er)
      F.logic__subst(U32, z => {O.tail_zero(z, x) == BW.zlist(BW.bdrB(16n, BLf.wbits(x))) : Bool}, 2, r, Equal.sym(U32, r, 2, e), tz_2(x))
    case 3n:
      +e = F.u32__injective(r, 3, er)
      F.logic__subst(U32, z => {O.tail_zero(z, x) == BW.zlist(BW.bdrB(24n, BLf.wbits(x))) : Bool}, 3, r, Equal.sym(U32, r, 3, e), tz_3(x))
    case 4n+ +p: Empty.absurd({O.tail_zero(r, x) == BW.zlist(BW.bdrB(Nat.double(Nat.double(Nat.double(4n+p))), BLf.wbits(x))) : Bool}, F.logic__false_true(hr))

# the zero tail of a list after one entry below it is replaced
def hz_lset(+r: Nat, +L: +List<Bool>, +k: Nat, +v: Bool, +hk: {Nat.is_lt(k, r) == True{} : Bool}) -> {BW.zlist(BW.bdrB(r, BV.lset(L, k, v))) == BW.zlist(BW.bdrB(r, L)) : Bool}:
  match r L k:
    case 0n _ _: Empty.absurd({BW.zlist(BW.bdrB(0n, BV.lset(L, k, v))) == BW.zlist(BW.bdrB(0n, L)) : Bool}, F.nat__lt_zero_absurd(k, hk))
    case 1n+ +p Nil{} _: {==}
    case 1n+ +p Con{+h, +t} 0n: {==}
    case 1n+ +p Con{+h, +t} 1n+ +a: hz_lset(p, t, a, v, hk)

# after the merge of the bit i & 31 below r the bits r .. 31 of the word are still zero
def hz_pres(+r: Nat, +x: U32, +i: U32, +v: Bool, +hk: {Nat.is_lt(U32.to_nat(U32.and(i, 31)), r) == True{} : Bool}, +h: {BW.zlist(BW.bdrB(r, BLf.wbits(x))) == True{} : Bool})
    -> {BW.zlist(BW.bdrB(r, BLf.wbits(O.bit_merge(v, x, M.shl_by(1, U32.and(i, 31)))))) == True{} : Bool}:
  %Equal.sym(+List<Bool>, BLf.wbits(O.bit_merge(v, x, M.shl_by(1, U32.and(i, 31)))), BV.lset(BLf.wbits(x), U32.to_nat(U32.and(i, 31)), v), BV.wset_i(x, i, v)) : {BW.zlist(BW.bdrB(r, _)) == True{} : Bool}
  Equal.trans(Bool, BW.zlist(BW.bdrB(r, BV.lset(BLf.wbits(x), U32.to_nat(U32.and(i, 31)), v))), BW.zlist(BW.bdrB(r, BLf.wbits(x))), True{}, hz_lset(r, BLf.wbits(x), U32.to_nat(U32.and(i, 31)), v, hk), h)

def bz_pres(+rn: Nat, +r: U32, +x: U32, +i: U32, +v: Bool, +er: {U32.to_nat(r) == rn : Nat}, +hr: {Nat.is_le(rn, 31n) == True{} : Bool}, +hk: {Nat.is_lt(U32.to_nat(U32.and(i, 31)), rn) == True{} : Bool},
    +h: {O.bits_above_zero(r, x) == True{} : Bool}) -> {O.bits_above_zero(r, O.bit_merge(v, x, M.shl_by(1, U32.and(i, 31)))) == True{} : Bool}:
