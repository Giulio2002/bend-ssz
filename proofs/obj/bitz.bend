    hz_pres(rn, x, i, v, hk, Equal.trans(Bool, BW.zlist(BW.bdrB(rn, BLf.wbits(x))), O.bits_above_zero(r, x), True{}, Equal.sym(Bool, O.bits_above_zero(r, x), BW.zlist(BW.bdrB(rn, BLf.wbits(x))), bz_conv(rn, r, x, er, hr)), h)))

