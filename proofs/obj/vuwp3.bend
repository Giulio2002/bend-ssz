      %e0 : {(FD.array__thaw(U32, D2), (FD.array__thaw(U32, TS), c)) == (FD.array__thaw(U32, UW.SWo(3, VS.wtake(_, VB.wdr(J, UW.SLW(TS))), dd, D2, Nat.add(J, i), c)), (FD.array__thaw(U32, TS), UW.CRY(3, VS.wtake(KN, VB.wdr(J, UW.SLW(TS))), c))) : Array<U32> & (Array<U32> & U32)}
