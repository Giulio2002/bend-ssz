def BF(t: FD.array__Tree<U32>, +n: U32) -> B.Buf: B.Buf{FD.array__thaw(U32, t), n}
def CHK(+n: U32) -> Bool: Bool.and(U32.is_eq(n, U32.mul(U32.div(n, 32), 32)), True{})
def vB() -> Word(31n): FD.spec_numeric__from_nat(31n, 32n)
def CQ(+n: U32) -> Nat: U32.to_nat(U32.div(n, 32))
def M(+n: U32) -> Nat: EL.w8(CQ(n))
def OBJ(+t: FD.array__Tree<U32>, +n: U32) -> O.Words: O.Words{FD.array__thaw(U32, VL.MMg(t, n)), n}
def VW(+t: FD.array__Tree<U32>, +n: U32) -> +List<U32>: VS.bt(U32.to_nat(n), FX.limbs(FD.array__slots(U32, t)))
def VAL(+t: FD.array__Tree<U32>, +n: U32) -> S.Value: S.Sequence{EL.it8(CQ(n), FD.array__slots(U32, VL.MMg(t, n)))}

