  match m:
    case MW{+f_A, +m_f_B, +f_C}: PA(RTX(f_A, m_f_B, f_C, dd, D, X, q, r), BYX(f_A, m_f_B, f_C, dd, D, q, r), go(f_A, m_f_B, f_C, hok, dd, D, X, q, r, e, hr, hd, pf, hl, hz))

law putx_bytes:
  for +m: MW
  for +dd: Nat
  for +D: FD.array__Tree<U32>
  for +X: U32
  for +q: Nat
  for +r: Nat
  for +e: {U32.to_nat(X) == Nat.add(A.quad(q), r) : Nat}
