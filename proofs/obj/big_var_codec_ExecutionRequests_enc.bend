# each list's runs end within the output
def hbd0(+n0: U32, +n1: U32, +n2: U32, +hl0: {Nat.is_le(U32.to_nat(n0), U32.to_nat(8192)) == True{} : Bool}, +hl1: {Nat.is_le(U32.to_nat(n1), U32.to_nat(16)) == True{} : Bool}, +hl2: {Nat.is_le(U32.to_nat(n2), U32.to_nat(2)) == True{} : Bool}) -> {Nat.is_le(VRL.pos(U32.to_nat(n0), 48n, 3n), VB.pw(DO(n0, n1, n2))) == True{} : Bool}:
  %FD.nat__add_comm(3n, M0(n0)) : {Nat.is_le(_, VB.pw(DO(n0, n1, n2))) == True{} : Bool}
  lQ1P(n0, n1, n2, hl0, hl1, hl2)
def hbd1(+n0: U32, +n1: U32, +n2: U32, +hl0: {Nat.is_le(U32.to_nat(n0), U32.to_nat(8192)) == True{} : Bool}, +hl1: {Nat.is_le(U32.to_nat(n1), U32.to_nat(16)) == True{} : Bool}, +hl2: {Nat.is_le(U32.to_nat(n2), U32.to_nat(2)) == True{} : Bool}) -> {Nat.is_le(VRL.pos(U32.to_nat(n1), 19n, Q1(n0)), VB.pw(DO(n0, n1, n2))) == True{} : Bool}:
  %FD.nat__add_comm(Q1(n0), M1(n1)) : {Nat.is_le(_, VB.pw(DO(n0, n1, n2))) == True{} : Bool}
  lQ2P(n0, n1, n2, hl0, hl1, hl2)
