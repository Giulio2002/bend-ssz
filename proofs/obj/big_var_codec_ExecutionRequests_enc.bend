def pd2(+n0: U32, +n1: U32, +n2: U32, +hl0: {Nat.is_le(U32.to_nat(n0), U32.to_nat(8192)) == True{} : Bool}, +hl1: {Nat.is_le(U32.to_nat(n1), U32.to_nat(16)) == True{} : Bool}, +hl2: {Nat.is_le(U32.to_nat(n2), U32.to_nat(2)) == True{} : Bool}) -> {O.padd(S1(n0), N1(n1)) == S2(n0, n1) : U32}:
