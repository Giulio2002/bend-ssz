def roomS(+n0: U32, +n1: U32, +n2: U32, +hl0: {Nat.is_le(U32.to_nat(n0), U32.to_nat(8192)) == True{} : Bool}, +hl1: {Nat.is_le(U32.to_nat(n1), U32.to_nat(16)) == True{} : Bool}, +hl2: {Nat.is_le(U32.to_nat(n2), U32.to_nat(2)) == True{} : Bool}) -> {Nat.is_le(QN(n0, n1, n2), VB.pw(DO(n0, n1, n2))) == True{} : Bool}:
