    +da0: Nat, +da1: Nat, +da2: Nat,
    +pfa0: {FD.array__perfect(T.DepositRequest, da0, A0) == True{} : Bool}, +pfa1: {FD.array__perfect(T.WithdrawalRequest, da1, A1) == True{} : Bool}, +pfa2: {FD.array__perfect(T.ConsolidationRequest, da2, A2) == True{} : Bool},
    +hda0: {Nat.is_lt(da0, 31n) == True{} : Bool}, +hda1: {Nat.is_lt(da1, 31n) == True{} : Bool}, +hda2: {Nat.is_lt(da2, 31n) == True{} : Bool},
    +hca0: {Nat.is_le(U32.to_nat(n0), VB.pw(da0)) == True{} : Bool}, +hca1: {Nat.is_le(U32.to_nat(n1), VB.pw(da1)) == True{} : Bool}, +hca2: {Nat.is_le(U32.to_nat(n2), VB.pw(da2)) == True{} : Bool})
