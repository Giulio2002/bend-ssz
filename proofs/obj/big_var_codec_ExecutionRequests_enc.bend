# no top bit
def ltN(+n0: U32, +n1: U32, +n2: U32, +hl0: {Nat.is_le(U32.to_nat(n0), U32.to_nat(8192)) == True{} : Bool}, +hl1: {Nat.is_le(U32.to_nat(n1), U32.to_nat(16)) == True{} : Bool}, +hl2: {Nat.is_le(U32.to_nat(n2), U32.to_nat(2)) == True{} : Bool}, +L: U32, +m: Nat, +em: {U32.to_nat(L) == A.quad(m) : Nat}, +hm: {Nat.is_le(m, QN(n0, n1, n2)) == True{} : Bool})
    -> {L == U32{Word.shr.pad(31n, VE.winit(31n, VE.bits32(L)))} : U32}:
  VE.small_pad(L, 24n, {==}, FD.logic__subst(Nat, z => {Nat.is_lt(z, VB.pw(24n)) == True{} : Bool}, A.quad(m), U32.to_nat(L), Equal.sym(Nat, U32.to_nat(L), A.quad(m), em), qlt(n0, n1, n2, hl0, hl1, hl2, m, hm)))
