def fp0(+ps: +List<S.Part>, hf: DF.single(Some{32n}, ps), +t: S.Value, +bs: +List<U32>, +e: {Codec.bytes(Codec.aggregate(Codec.concatenate(Some{ps}, Codec.parts(t, S.Chain{Spec.Schema11(), S.Chain{Spec.Schema7(), S.Chain{Spec.Schema7(), S.Chain{Spec.Schema69(), S.Chain{Spec.Schema7(), S.Chain{Spec.Schema3(), S.Chain{Spec.Schema3(), S.Chain{Spec.Schema3(), S.Chain{Spec.Schema3(), S.Chain{Spec.Schema70(), S.Chain{Spec.Schema4(), S.Chain{Spec.Schema7(), S.Chain{Spec.Schema7(), S.Chain{Spec.Schema7(), S.Chain{Spec.Schema3(), S.Chain{Spec.Schema3(), S.End{}}}}}}}}}}}}}}}}})), None{})) == Some{bs} : Maybe<&2, +List<U32>>}) -> FACTS(bs):
  match ps:
    case Nil{}: Empty.absurd(FACTS(bs), hf)
    case Con{S.Fixed{+xs}, Nil{}}: st1(xs, Equal.sym(Nat, 32n, List.length(&2, U32, xs), F.logic__some_inj(Nat, 32n, List.length(&2, U32, xs), hf)), t, bs, e)
    case Con{S.Variable{+xs}, Nil{}}: Empty.absurd(FACTS(bs), F.logic__none_some(Nat, 32n, Equal.sym(Maybe<&2, Nat>, Some{32n}, None{}, hf)))
    case Con{S.Fixed{+xs}, Con{+h2, +t2}}: Empty.absurd(FACTS(bs), hf)
    case Con{S.Variable{+xs}, Con{+h2, +t2}}: Empty.absurd(FACTS(bs), hf)

def fm0(+mm: Maybe<&2, +List<S.Part>>, hf: DF.single_result(Some{32n}, mm), +t: S.Value, +bs: +List<U32>, +e: {Codec.bytes(Codec.aggregate(Codec.concatenate(mm, Codec.parts(t, S.Chain{Spec.Schema11(), S.Chain{Spec.Schema7(), S.Chain{Spec.Schema7(), S.Chain{Spec.Schema69(), S.Chain{Spec.Schema7(), S.Chain{Spec.Schema3(), S.Chain{Spec.Schema3(), S.Chain{Spec.Schema3(), S.Chain{Spec.Schema3(), S.Chain{Spec.Schema70(), S.Chain{Spec.Schema4(), S.Chain{Spec.Schema7(), S.Chain{Spec.Schema7(), S.Chain{Spec.Schema7(), S.Chain{Spec.Schema3(), S.Chain{Spec.Schema3(), S.End{}}}}}}}}}}}}}}}}})), None{})) == Some{bs} : Maybe<&2, +List<U32>>}) -> FACTS(bs):
  match mm:
    case None{}: Empty.absurd(FACTS(bs), F.logic__none_some(+List<U32>, bs, e))
    case Some{+ps}: fp0(ps, hf, t, bs, e)

def fd0(+h: S.Value, +t: S.Value, +bs: +List<U32>, +e: {Codec.bytes(Codec.aggregate(Codec.concatenate(Codec.parts(h, Spec.Schema7()), Codec.parts(t, S.Chain{Spec.Schema11(), S.Chain{Spec.Schema7(), S.Chain{Spec.Schema7(), S.Chain{Spec.Schema69(), S.Chain{Spec.Schema7(), S.Chain{Spec.Schema3(), S.Chain{Spec.Schema3(), S.Chain{Spec.Schema3(), S.Chain{Spec.Schema3(), S.Chain{Spec.Schema70(), S.Chain{Spec.Schema4(), S.Chain{Spec.Schema7(), S.Chain{Spec.Schema7(), S.Chain{Spec.Schema7(), S.Chain{Spec.Schema3(), S.Chain{Spec.Schema3(), S.End{}}}}}}}}}}}}}}}}})), None{})) == Some{bs} : Maybe<&2, +List<U32>>}) -> FACTS(bs):
  fm0(Codec.parts(h, Spec.Schema7()), DS.facts(h, Spec.Schema7(), {==}), t, bs, e)

def st0(+items: S.Value, +bs: +List<U32>, +e: {Codec.bytes(Codec.aggregate(Codec.parts(items, S.Chain{Spec.Schema7(), S.Chain{Spec.Schema11(), S.Chain{Spec.Schema7(), S.Chain{Spec.Schema7(), S.Chain{Spec.Schema69(), S.Chain{Spec.Schema7(), S.Chain{Spec.Schema3(), S.Chain{Spec.Schema3(), S.Chain{Spec.Schema3(), S.Chain{Spec.Schema3(), S.Chain{Spec.Schema70(), S.Chain{Spec.Schema4(), S.Chain{Spec.Schema7(), S.Chain{Spec.Schema7(), S.Chain{Spec.Schema7(), S.Chain{Spec.Schema3(), S.Chain{Spec.Schema3(), S.End{}}}}}}}}}}}}}}}}}}), None{})) == Some{bs} : Maybe<&2, +List<U32>>}) -> FACTS(bs):
  match items:
    case S.BooleanValue{+b0}: Empty.absurd(FACTS(bs), F.logic__none_some(+List<U32>, bs, e))
    case S.UnsignedValue{+u0}: Empty.absurd(FACTS(bs), F.logic__none_some(+List<U32>, bs, e))
    case S.BytesValue{+xs0}: Empty.absurd(FACTS(bs), F.logic__none_some(+List<U32>, bs, e))
    case S.BitsValue{+bs0}: Empty.absurd(FACTS(bs), F.logic__none_some(+List<U32>, bs, e))
    case S.Sequence{+it0}: Empty.absurd(FACTS(bs), F.logic__none_some(+List<U32>, bs, e))
    case S.Items{+h, +t}: fd0(h, t, bs, e)
    case S.EmptyItems{}: Empty.absurd(FACTS(bs), F.logic__none_some(+List<U32>, bs, e))
    case S.Selected{+sel0, +sv0}: Empty.absurd(FACTS(bs), F.logic__none_some(+List<U32>, bs, e))
    case S.NullValue{}: Empty.absurd(FACTS(bs), F.logic__none_some(+List<U32>, bs, e))

# Every byte string the spec relates to a value has the checked shape.
law inv_v:
  for +v: S.Value
  for +bs: +List<U32>
  for +e: {Codec.encoding_for_legal_type(Spec.ExecutionPayloadHeader(), v) == Some{bs} : Maybe<&2, +List<U32>>}
  FACTS(bs)
def inv_v(v, bs, e):
  match v:
    case S.BooleanValue{+b0}: Empty.absurd(FACTS(bs), F.logic__none_some(+List<U32>, bs, e))
    case S.UnsignedValue{+u0}: Empty.absurd(FACTS(bs), F.logic__none_some(+List<U32>, bs, e))
    case S.BytesValue{+xs0}: Empty.absurd(FACTS(bs), F.logic__none_some(+List<U32>, bs, e))
    case S.BitsValue{+bs0}: Empty.absurd(FACTS(bs), F.logic__none_some(+List<U32>, bs, e))
    case S.Sequence{+items}: st0(items, bs, e)
    case S.Items{+hd0, +tl0}: Empty.absurd(FACTS(bs), F.logic__none_some(+List<U32>, bs, e))
    case S.EmptyItems{}: Empty.absurd(FACTS(bs), F.logic__none_some(+List<U32>, bs, e))
    case S.Selected{+sel0, +sv0}: Empty.absurd(FACTS(bs), F.logic__none_some(+List<U32>, bs, e))
    case S.NullValue{}: Empty.absurd(FACTS(bs), F.logic__none_some(+List<U32>, bs, e))

# ---- the buffer's bytes ------------------------------------------------------------------

law wdr0_eq:
  for +n: Nat
  for +W: List<&2, U32>
  {VS.wdr0(n, W) == VB.wdr(n, W) : List<&2, U32>}
def wdr0_eq(n, W):
  match n W:
    case 0n _: {==}
    case 1n+ +p Nil{}: {==}
    case 1n+ +p Con{+h, +t}: wdr0_eq(p, t)

law len_eq:
  for +W: List<&2, U32>
  {List.length(&2, U32, W) == F.spec_common__length(U32, W) : Nat}
def len_eq(W):
  match W:
    case Nil{}: {==}
    case Con{+h, +t}:
      %Equal.sym(Nat, List.length(&2, U32, t), F.spec_common__length(U32, t), len_eq(t)) : {1n+_ == 1n+F.spec_common__length(U32, t) : Nat}
      {==}

def SL(t: F.array__Tree<U32>) -> List<&2, U32>: F.array__slots(U32, t)

def lenS(+d: Nat, +t: F.array__Tree<U32>, +pf: {F.array__perfect(U32, d, t) == True{} : Bool})
    -> {List.length(&2, U32, FX.limbs(SL(t))) == A.quad(VB.pw(d)) : Nat}:
  %Equal.sym(Nat, List.length(&2, U32, FX.limbs(SL(t))), FX.wlen(SL(t)), VS.len_limbs(SL(t))) : {_ == A.quad(VB.pw(d)) : Nat}
  %Equal.sym(Nat, FX.wlen(SL(t)), A.quad(List.length(&2, U32, SL(t))), VS.wlen_quad(SL(t))) : {_ == A.quad(VB.pw(d)) : Nat}
  %Equal.sym(Nat, List.length(&2, U32, SL(t)), VB.pw(d), Equal.trans(Nat, List.length(&2, U32, SL(t)), F.spec_common__length(U32, SL(t)), VB.pw(d), len_eq(SL(t)), F.array__slots_length(U32, d, t, pf))) : {A.quad(_) == A.quad(VB.pw(d)) : Nat}
  {==}

def lenVW(+d: Nat, +t: F.array__Tree<U32>, +n: U32, +pf: {F.array__perfect(U32, d, t) == True{} : Bool},
    +hn: {Nat.is_le(U32.to_nat(n), A.quad(VB.pw(d))) == True{} : Bool})
    -> {List.length(&2, U32, DC.VW(t, n)) == U32.to_nat(n) : Nat}:
  VS.bt_len(U32.to_nat(n), FX.limbs(SL(t)),
    F.logic__subst(Nat, z => {Nat.is_le(U32.to_nat(n), z) == True{} : Bool}, A.quad(VB.pw(d)), List.length(&2, U32, FX.limbs(SL(t))), Equal.sym(Nat, List.length(&2, U32, FX.limbs(SL(t))), A.quad(VB.pw(d)), lenS(d, t, pf)), hn))

# The offset word's index is below 2^d.
def hpoS(+d: Nat, +t: F.array__Tree<U32>, +n: U32, +pf: {F.array__perfect(U32, d, t) == True{} : Bool},
    +hn: {Nat.is_le(U32.to_nat(n), A.quad(VB.pw(d))) == True{} : Bool}, +hF: {Nat.is_le(584n, U32.to_nat(n)) == True{} : Bool})
    -> {Nat.is_lt(109n, VB.len(SL(t))) == True{} : Bool}:
  %Equal.sym(Nat, VB.len(SL(t)), VB.pw(d), F.array__slots_length(U32, d, t, pf)) : {Nat.is_lt(109n, _) == True{} : Bool}
  F.nat__lt_le_trans(109n, 146n, VB.pw(d), {==}, VC.quad_inv(146n, VB.pw(d), F.nat__le_trans(584n, U32.to_nat(n), A.quad(VB.pw(d)), hF, hn)))
# The four bytes at the offset field are the limbs of the offset word.
def byteP(+t: F.array__Tree<U32>, +n: U32, +X: Nat, +en: {U32.to_nat(n) == 584n+X : Nat}, +hp: {Nat.is_lt(109n, VB.len(SL(t))) == True{} : Bool})
    -> {VS.bt(4n, VS.bdr(436n, DC.VW(t, n))) == FX.limbs([VB.slot(t, 109n)]) : +List<U32>}:
  %Equal.sym(Nat, U32.to_nat(n), 584n+X, en) : {VS.bt(4n, VS.bdr(436n, VS.bt(_, FX.limbs(SL(t))))) == FX.limbs([VB.slot(t, 109n)]) : +List<U32>}
  %Equal.sym(+List<U32>, VS.bdr(436n, VS.bt(584n+X, FX.limbs(SL(t)))), VS.bt(148n+X, VS.bdr(436n, FX.limbs(SL(t)))), VS.bdr_bt(436n, 148n+X, FX.limbs(SL(t)))) :
    {VS.bt(4n, _) == FX.limbs([VB.slot(t, 109n)]) : +List<U32>}
  %Equal.sym(+List<U32>, VS.bt(4n, VS.bt(148n+X, VS.bdr(436n, FX.limbs(SL(t))))), VS.bt(4n, VS.bdr(436n, FX.limbs(SL(t)))), VS.bt_bt(4n, 144n+X, VS.bdr(436n, FX.limbs(SL(t))))) :
    {_ == FX.limbs([VB.slot(t, 109n)]) : +List<U32>}
  %Equal.sym(+List<U32>, VS.bdr(436n, FX.limbs(SL(t))), FX.limbs(VS.wdr0(109n, SL(t))), VS.bdr_limbs(109n, SL(t))) :
    {VS.bt(4n, _) == FX.limbs([VB.slot(t, 109n)]) : +List<U32>}
  %Equal.sym(+List<U32>, VS.bt(4n, FX.limbs(VS.wdr0(109n, SL(t)))), FX.limbs(VS.wtake(1n, VS.wdr0(109n, SL(t)))), VS.bt_limbs(1n, VS.wdr0(109n, SL(t)))) :
    {_ == FX.limbs([VB.slot(t, 109n)]) : +List<U32>}
  %Equal.sym(List<&2, U32>, VS.wdr0(109n, SL(t)), VB.wdr(109n, SL(t)), wdr0_eq(109n, SL(t))) :
    {FX.limbs(VS.wtake(1n, _)) == FX.limbs([VB.slot(t, 109n)]) : +List<U32>}
  %Equal.sym(List<&2, U32>, VS.wtake(1n, VB.wdr(109n, SL(t))), Con{F.flat__nthc(SL(t), 109n), VS.wtake(0n, VB.wdr(1n+109n, SL(t)))}, VB.wt_eta(0n, 109n, SL(t), hp)) :
    {FX.limbs(_) == FX.limbs([VB.slot(t, 109n)]) : +List<U32>}
  {==}

def q0(xs: +List<U32>) -> U32:
  match xs:
    case Con{h, t}: h
    case Nil{}: 0
def q1(xs: +List<U32>) -> U32:
  match xs:
    case Con{h, t}: q0(t)
    case Nil{}: 0
def q2(xs: +List<U32>) -> U32:
  match xs:
    case Con{h, t}: q1(t)
    case Nil{}: 0
def q3(xs: +List<U32>) -> U32:
  match xs:
    case Con{h, t}: q2(t)
    case Nil{}: 0

# A word whose limbs are those of 584 is 584.
def wordFS(+x: U32, +h: {FX.limbs([x]) == [72, 2, 0, 0] : +List<U32>}) -> {x == 584 : U32}:
  Equal.trans(U32, x, BT.asm(B.byte_sel(0, x), B.byte_sel(1, x), B.byte_sel(2, x), B.byte_sel(3, x)), 584, BT.reassemble(x),
    BT.asm_cong(B.byte_sel(0, x), B.byte_sel(1, x), B.byte_sel(2, x), B.byte_sel(3, x), 72, 2, 0, 0,
      Equal.cong(+List<U32>, U32, l => q0(l), FX.limbs([x]), [72, 2, 0, 0], h),
      Equal.cong(+List<U32>, U32, l => q1(l), FX.limbs([x]), [72, 2, 0, 0], h),
      Equal.cong(+List<U32>, U32, l => q2(l), FX.limbs([x]), [72, 2, 0, 0], h),
      Equal.cong(+List<U32>, U32, l => q3(l), FX.limbs([x]), [72, 2, 0, 0], h)))

def ek_sub(+n: U32, +k: Nat, +en: {U32.to_nat(n) == Nat.add(584n, k) : Nat})
    -> {U32.to_nat(W.LL(n)) == k : Nat}:
  +le = F.logic__subst(Nat, z => {Nat.is_le(584n, z) == True{} : Bool}, Nat.add(584n, k), U32.to_nat(n), Equal.sym(Nat, U32.to_nat(n), Nat.add(584n, k), en), Order.below_sum(584n, k))
  %Equal.sym(Nat, U32.to_nat(W.LL(n)), Nat.sub(U32.to_nat(n), 584n), F.u32__sub_nat(n, 584, le)) : {_ == k : Nat}
  %Equal.sym(Nat, U32.to_nat(n), Nat.add(584n, k), en) : {Nat.sub(_, 584n) == k : Nat}
  F.nat__add_sub_cancel(584n, k)

# The validator accepts every buffer whose bytes have the shape.
def chk_true(+t: F.array__Tree<U32>, +n: U32, +k: Nat, +en: {U32.to_nat(n) == Nat.add(584n, k) : Nat}, +hk: {Nat.is_le(k, 32n) == True{} : Bool},
    +epo: {W.SPOw(t, 0n) == 584 : U32}) -> {DC.CHK(t, n) == True{} : Bool}:
  +le = F.logic__subst(Nat, z => {Nat.is_le(584n, z) == True{} : Bool}, Nat.add(584n, k), U32.to_nat(n), Equal.sym(Nat, U32.to_nat(n), Nat.add(584n, k), en), Order.below_sum(584n, k))
  +hL = F.logic__subst(Nat, z => {Nat.is_le(z, 32n) == True{} : Bool}, k, U32.to_nat(W.LL(n)), Equal.sym(Nat, U32.to_nat(W.LL(n)), k, ek_sub(n, k, en)), hk)
  %Equal.sym(Bool, U32.is_le(584, n), True{}, F.logic__subst(Bool, z => {z == True{} : Bool}, Nat.is_le(584n, U32.to_nat(n)), U32.is_le(584, n), Equal.sym(Bool, U32.is_le(584, n), Nat.is_le(584n, U32.to_nat(n)), VU.le_u32(584, n)), le)) :
    {W.chk3(_, U32.is_eq(W.SPOw(t, 0n), 584), W.BLW(U32.sub(n, W.SPOw(t, 0n)))) == True{} : Bool}
  %Equal.sym(U32, W.SPOw(t, 0n), 584, epo) :
    {W.chk3(True{}, U32.is_eq(_, 584), W.BLW(U32.sub(n, _))) == True{} : Bool}
  F.logic__subst(Bool, z => {z == True{} : Bool}, Nat.is_le(U32.to_nat(W.LL(n)), U32.to_nat(32)), U32.is_le(W.LL(n), 32), Equal.sym(Bool, U32.is_le(W.LL(n), 32), Nat.is_le(U32.to_nat(W.LL(n)), U32.to_nat(32)), VU.le_u32(W.LL(n), 32)), hL)

def rej_k(+d: Nat, +t: F.array__Tree<U32>, +n: U32, +pf: {F.array__perfect(U32, d, t) == True{} : Bool},
    +hn: {Nat.is_le(U32.to_nat(n), A.quad(VB.pw(d))) == True{} : Bool}, +hchk: {DC.CHK(t, n) == False{} : Bool},
    +hb: {VS.bt(4n, VS.bdr(436n, DC.VW(t, n))) == [72, 2, 0, 0] : +List<U32>},
    ex: DK.Ex(Nat, k => DK.P2({List.length(&2, U32, DC.VW(t, n)) == Nat.add(584n, k) : Nat}, {Nat.is_le(k, 32n) == True{} : Bool}))) -> Empty:
  (+k, +pr) = ex
  (+hlen, +hk) = pr
  +en = Equal.trans(Nat, U32.to_nat(n), List.length(&2, U32, DC.VW(t, n)), Nat.add(584n, k), Equal.sym(Nat, List.length(&2, U32, DC.VW(t, n)), U32.to_nat(n), lenVW(d, t, n, pf, hn)), hlen)
  +hF = F.logic__subst(Nat, z => {Nat.is_le(584n, z) == True{} : Bool}, Nat.add(584n, k), U32.to_nat(n), Equal.sym(Nat, U32.to_nat(n), Nat.add(584n, k), en), Order.below_sum(584n, k))
  +hp = hpoS(d, t, n, pf, hn, hF)
  +epo = wordFS(W.SPOw(t, 0n), Equal.trans(+List<U32>, FX.limbs([W.SPOw(t, 0n)]), VS.bt(4n, VS.bdr(436n, DC.VW(t, n))), [72, 2, 0, 0],
    Equal.sym(+List<U32>, VS.bt(4n, VS.bdr(436n, DC.VW(t, n))), FX.limbs([W.SPOw(t, 0n)]), byteP(t, n, k, en, hp)), hb))
  F.logic__true_false(Equal.trans(Bool, True{}, DC.CHK(t, n), False{}, Equal.sym(Bool, DC.CHK(t, n), True{}, chk_true(t, n, k, en, hk, epo)), hchk))

def rej_f(+d: Nat, +t: F.array__Tree<U32>, +n: U32, +pf: {F.array__perfect(U32, d, t) == True{} : Bool},
    +hn: {Nat.is_le(U32.to_nat(n), A.quad(VB.pw(d))) == True{} : Bool}, +hchk: {DC.CHK(t, n) == False{} : Bool},
    facts: FACTS(DC.VW(t, n))) -> Empty:
  (+hb, ex) = facts
  rej_k(d, t, n, pf, hn, hchk, hb, ex)

# When the validator refuses, no value is related to the buffer's bytes.
law decode_reject:
  for +d: Nat
  for +t: F.array__Tree<U32>
  for +n: U32
  for +pf: {F.array__perfect(U32, d, t) == True{} : Bool}
  for +hn: {Nat.is_le(U32.to_nat(n), A.quad(VB.pw(d))) == True{} : Bool}
  for +hchk: {DC.CHK(t, n) == False{} : Bool}
  Decoding.outside_image(Spec.ExecutionPayloadHeader(), DC.VW(t, n))
def decode_reject(d, t, n, pf, hn, hchk):
  v => e => rej_f(d, t, n, pf, hn, hchk, inv_v(v, DC.VW(t, n), e))

# When the validator refuses, the decoder returns None and the buffer.
law decode_none:
  for +d: Nat
  for +t: F.array__Tree<U32>
  for +n: U32
  for +pf: {F.array__perfect(U32, d, t) == True{} : Bool}
  for +hd: {Nat.is_lt(d, 29n) == True{} : Bool}
  for +hn: {Nat.is_le(U32.to_nat(n), A.quad(VB.pw(d))) == True{} : Bool}
  for +hchk: {DC.CHK(t, n) == False{} : Bool}
  {FuluExecutionPayloadHeader_r.ExecutionPayloadHeader_decode(DC.BF(t, n), n) == (DC.BF(t, n), None{}) : B.Buf & Maybe<&1, FuluExecutionPayloadHeader_d.ExecutionPayloadHeader>}
def decode_none(d, t, n, pf, hd, hn, hchk):
  %Equal.sym(B.Buf & Bool, FuluExecutionPayloadHeader_r.ExecutionPayloadHeader_ok(DC.BF(t, n), 0, n), (DC.BF(t, n), DC.CHK(t, n)), DC.ok_eval(d, t, n, pf, hd, hn)) :
    {FuluExecutionPayloadHeader_r.ExecutionPayloadHeader_built(n, _) == (DC.BF(t, n), None{}) : B.Buf & Maybe<&1, FuluExecutionPayloadHeader_d.ExecutionPayloadHeader>}
  %Equal.sym(Bool, DC.CHK(t, n), False{}, hchk) :
    {FuluExecutionPayloadHeader_r.ExecutionPayloadHeader_built(n, (DC.BF(t, n), _)) == (DC.BF(t, n), None{}) : B.Buf & Maybe<&1, FuluExecutionPayloadHeader_d.ExecutionPayloadHeader>}
  {==}

# ---- the window's bytes (for nesting) ------------------------------------------------------

def WV(t: F.array__Tree<U32>, +i: Nat, +len: U32) -> +List<U32>: VS.bt(U32.to_nat(len), FX.limbs(VB.wdr(i, SL(t))))

# Every value whose spec parts are one variable part has its bytes in the checked shape.
def inv_p(+v: S.Value, +bs: +List<U32>, +e: {Codec.parts(v, Spec.ExecutionPayloadHeader()) == Some{[S.Variable{bs}]} : Maybe<&2, +List<S.Part>>}) -> FACTS(bs):
  inv_v(v, bs, Equal.cong(Maybe<&2, +List<S.Part>>, Maybe<&2, +List<U32>>, z => Codec.bytes(z), Codec.parts(v, Spec.ExecutionPayloadHeader()), Some{[S.Variable{bs}]}, e))

def lenWV(+d: Nat, +t: F.array__Tree<U32>, +i: Nat, +len: U32, +pf: {F.array__perfect(U32, d, t) == True{} : Bool},
    +hw: {Nat.is_le(Nat.add(A.quad(i), U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool})
    -> {List.length(&2, U32, WV(t, i, len)) == U32.to_nat(len) : Nat}:
  VS.bt_len(U32.to_nat(len), FX.limbs(VB.wdr(i, SL(t))), VZ.win_room(d, t, i, len, pf, hw))

def haw(+len: U32, +X: Nat, +en: {U32.to_nat(len) == 584n+X : Nat}) -> {U32.is_le(584, len) == True{} : Bool}:
  F.logic__subst(Bool, z => {z == True{} : Bool}, Nat.is_le(584n, U32.to_nat(len)), U32.is_le(584, len), Equal.sym(Bool, U32.is_le(584, len), Nat.is_le(584n, U32.to_nat(len)), VU.le_u32(584, len)),
    F.logic__subst(Nat, z => {Nat.is_le(584n, z) == True{} : Bool}, 584n+X, U32.to_nat(len), Equal.sym(Nat, U32.to_nat(len), 584n+X, en), Order.below_sum(584n, X)))

# The four bytes at the window's offset field are the limbs of its offset word.
def bytePw(+d: Nat, +t: F.array__Tree<U32>, +i: Nat, +len: U32, +X: Nat, +en: {U32.to_nat(len) == 584n+X : Nat},
    +pf: {F.array__perfect(U32, d, t) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(A.quad(i), U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool})
    -> {VS.bt(4n, VS.bdr(436n, WV(t, i, len))) == FX.limbs([W.SPOw(t, i)]) : +List<U32>}:
  +hp = F.logic__subst(Nat, z => {Nat.is_lt(Nat.add(109n, i), z) == True{} : Bool}, VB.pw(d), VB.len(SL(t)), Equal.sym(Nat, VB.len(SL(t)), VB.pw(d), F.array__slots_length(U32, d, t, pf)),
    W.hiw(d, i, len, 109n, {==}, hw, haw(len, X, en)))
  %Equal.sym(Nat, U32.to_nat(len), 584n+X, en) : {VS.bt(4n, VS.bdr(436n, VS.bt(_, FX.limbs(VB.wdr(i, SL(t)))))) == FX.limbs([W.SPOw(t, i)]) : +List<U32>}
  %Equal.sym(+List<U32>, VS.bdr(436n, VS.bt(584n+X, FX.limbs(VB.wdr(i, SL(t))))), VS.bt(148n+X, VS.bdr(436n, FX.limbs(VB.wdr(i, SL(t))))), VS.bdr_bt(436n, 148n+X, FX.limbs(VB.wdr(i, SL(t))))) :
    {VS.bt(4n, _) == FX.limbs([W.SPOw(t, i)]) : +List<U32>}
  %Equal.sym(+List<U32>, VS.bt(4n, VS.bt(148n+X, VS.bdr(436n, FX.limbs(VB.wdr(i, SL(t)))))), VS.bt(4n, VS.bdr(436n, FX.limbs(VB.wdr(i, SL(t))))), VS.bt_bt(4n, 144n+X, VS.bdr(436n, FX.limbs(VB.wdr(i, SL(t)))))) :
    {_ == FX.limbs([W.SPOw(t, i)]) : +List<U32>}
  %Equal.sym(+List<U32>, VS.bdr(436n, FX.limbs(VB.wdr(i, SL(t)))), FX.limbs(VS.wdr0(109n, VB.wdr(i, SL(t)))), VS.bdr_limbs(109n, VB.wdr(i, SL(t)))) :
    {VS.bt(4n, _) == FX.limbs([W.SPOw(t, i)]) : +List<U32>}
  %Equal.sym(+List<U32>, VS.bt(4n, FX.limbs(VS.wdr0(109n, VB.wdr(i, SL(t))))), FX.limbs(VS.wtake(1n, VS.wdr0(109n, VB.wdr(i, SL(t))))), VS.bt_limbs(1n, VS.wdr0(109n, VB.wdr(i, SL(t))))) :
    {_ == FX.limbs([W.SPOw(t, i)]) : +List<U32>}
  %Equal.sym(List<&2, U32>, VS.wdr0(109n, VB.wdr(i, SL(t))), VB.wdr(109n, VB.wdr(i, SL(t))), wdr0_eq(109n, VB.wdr(i, SL(t)))) :
    {FX.limbs(VS.wtake(1n, _)) == FX.limbs([W.SPOw(t, i)]) : +List<U32>}
  %Equal.sym(List<&2, U32>, VB.wdr(109n, VB.wdr(i, SL(t))), VB.wdr(Nat.add(i, 109n), SL(t)), VF.wdr_add(109n, i, SL(t))) :
    {FX.limbs(VS.wtake(1n, _)) == FX.limbs([W.SPOw(t, i)]) : +List<U32>}
  %Equal.sym(Nat, Nat.add(i, 109n), Nat.add(109n, i), F.nat__add_comm(i, 109n)) :
    {FX.limbs(VS.wtake(1n, VB.wdr(_, SL(t)))) == FX.limbs([W.SPOw(t, i)]) : +List<U32>}
  %Equal.sym(List<&2, U32>, VS.wtake(1n, VB.wdr(Nat.add(109n, i), SL(t))), Con{F.flat__nthc(SL(t), Nat.add(109n, i)), VS.wtake(0n, VB.wdr(1n+Nat.add(109n, i), SL(t)))}, VB.wt_eta(0n, Nat.add(109n, i), SL(t), hp)) :
    {FX.limbs(_) == FX.limbs([W.SPOw(t, i)]) : +List<U32>}
  {==}

# The window's checks hold for every window whose bytes have the shape.
def chk_truew(+t: F.array__Tree<U32>, +i: Nat, +len: U32, +k: Nat, +en: {U32.to_nat(len) == Nat.add(584n, k) : Nat}, +hk: {Nat.is_le(k, 32n) == True{} : Bool},
    +epo: {W.SPOw(t, i) == 584 : U32}) -> {W.CHKw(t, i, len) == True{} : Bool}:
  +hL = F.logic__subst(Nat, z => {Nat.is_le(z, 32n) == True{} : Bool}, k, U32.to_nat(W.LL(len)), Equal.sym(Nat, U32.to_nat(W.LL(len)), k, ek_sub(len, k, en)), hk)
  %Equal.sym(Bool, U32.is_le(584, len), True{}, haw(len, k, en)) :
    {W.chk3(_, U32.is_eq(W.SPOw(t, i), 584), W.BLW(U32.sub(len, W.SPOw(t, i)))) == True{} : Bool}
  %Equal.sym(U32, W.SPOw(t, i), 584, epo) :
    {W.chk3(True{}, U32.is_eq(_, 584), W.BLW(U32.sub(len, _))) == True{} : Bool}
  F.logic__subst(Bool, z => {z == True{} : Bool}, Nat.is_le(U32.to_nat(W.LL(len)), U32.to_nat(32)), U32.is_le(W.LL(len), 32), Equal.sym(Bool, U32.is_le(W.LL(len), 32), Nat.is_le(U32.to_nat(W.LL(len)), U32.to_nat(32)), VU.le_u32(W.LL(len), 32)), hL)

# A window whose bytes have the checked shape passes the window's checks.
def rej_facts(+d: Nat, +t: F.array__Tree<U32>, +i: Nat, +len: U32, +pf: {F.array__perfect(U32, d, t) == True{} : Bool},
    +hw: {Nat.is_le(Nat.add(A.quad(i), U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, facts: FACTS(WV(t, i, len)))
    -> {W.CHKw(t, i, len) == True{} : Bool}:
  (+hb, ex) = facts
  (+k, +pr) = ex
  (+hlen, +hk) = pr
  +en = Equal.trans(Nat, U32.to_nat(len), List.length(&2, U32, WV(t, i, len)), Nat.add(584n, k), Equal.sym(Nat, List.length(&2, U32, WV(t, i, len)), U32.to_nat(len), lenWV(d, t, i, len, pf, hw)), hlen)
  +epo = wordFS(W.SPOw(t, i), Equal.trans(+List<U32>, FX.limbs([W.SPOw(t, i)]), VS.bt(4n, VS.bdr(436n, WV(t, i, len))), [72, 2, 0, 0],
    Equal.sym(+List<U32>, VS.bt(4n, VS.bdr(436n, WV(t, i, len))), FX.limbs([W.SPOw(t, i)]), bytePw(d, t, i, len, k, en, pf, hw)), hb))
  chk_truew(t, i, len, k, en, hk, epo)

