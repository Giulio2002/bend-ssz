# ---- the reader ---------------------------------------------------------------------------------

def LOBJ(e: Bool, +t: FD.array__Tree<U32>, +x: Nat, +len: U32) -> T.l16_SignedBLSToExecutionChange_Seq:
  match e:
    case True{}: T.l16_SignedBLSToExecutionChange_Seq{T.l16_SignedBLSToExecutionChange_fill(0n), 0}
    case False{}: T.l16_SignedBLSToExecutionChange_Seq{FD.array__thaw(T.SignedBLSToExecutionChange, RT(U32.to_nat(U32.sub(NN(len), 1)), 0n, B.words_depth(NN(len)), FD.array__trep(T.SignedBLSToExecutionChange, B.words_depth(NN(len)), T.SignedBLSToExecutionChange_default()), t, x)), NN(len)}
def OBJw(+d: Nat, +t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32) -> T.l16_SignedBLSToExecutionChange_Seq: LOBJ(U32.is_eq(len, 0), t, x, len)

# The read loop from record j (index i) on.
def lp(k: Nat, +d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +i: U32, +j: Nat, +dd: Nat, +D: FD.array__Tree<T.SignedBLSToExecutionChange>,
    +eo: {U32.to_nat(off) == x : Nat}, +ej: {U32.to_nat(i) == j : Nat}, +hd: {Nat.is_lt(d, 28n) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hb: {Nat.is_le(VRL.pos(Nat.add(1n+k, j), 172n, x), A.quad(VB.pw(d))) == True{} : Bool},
    +hdd: {Nat.is_lt(dd, 32n) == True{} : Bool}, +hk: {Nat.is_lt(Nat.add(k, j), VB.pw(dd)) == True{} : Bool},
    +pfD: {FD.array__perfect(T.SignedBLSToExecutionChange, dd, D) == True{} : Bool})
    -> {T.l16_SignedBLSToExecutionChange_rd(k, i, off, FD.array__thaw(T.SignedBLSToExecutionChange, D), (BF(t, n), RX(t, VRL.pos(j, 172n, x)))) == (BF(t, n), FD.array__thaw(T.SignedBLSToExecutionChange, RT(k, j, dd, D, t, x))) : B.Buf & Array<T.SignedBLSToExecutionChange>}:
  match k:
    case 0n:
      %Equal.sym(Array<T.SignedBLSToExecutionChange>, Array.set(T.SignedBLSToExecutionChange, FD.array__thaw(T.SignedBLSToExecutionChange, D), i, RX(t, VRL.pos(j, 172n, x))), FD.array__thaw(T.SignedBLSToExecutionChange, FD.array__upd(T.SignedBLSToExecutionChange, dd, D, j, RX(t, VRL.pos(j, 172n, x)))),
          VRL.set_g(T.SignedBLSToExecutionChange, dd, D, i, j, RX(t, VRL.pos(j, 172n, x)), T.SignedBLSToExecutionChange_default(), ej, hdd, hk, pfD)) :
        {(BF(t, n), _) == (BF(t, n), FD.array__thaw(T.SignedBLSToExecutionChange, RT(0n, j, dd, D, t, x))) : B.Buf & Array<T.SignedBLSToExecutionChange>}
      {==}
    case 1n+ +q:
      +v = RX(t, VRL.pos(j, 172n, x))
      +D1 = FD.array__upd(T.SignedBLSToExecutionChange, dd, D, j, v)
      +hkj = FD.nat__le_lt_trans(j, Nat.add(q, j), VB.pw(dd), Order.left_below_sum(q, j), FD.nat__lt_trans(Nat.add(q, j), 1n+Nat.add(q, j), VB.pw(dd), FD.nat__lt_succ(Nat.add(q, j)), hk))
      +hk2 = FD.logic__subst(Nat, z => {Nat.is_lt(z, VB.pw(dd)) == True{} : Bool}, 1n+Nat.add(q, j), Nat.add(q, 1n+j), Equal.sym(Nat, Nat.add(q, 1n+j), 1n+Nat.add(q, j), FD.nat__add_succ(q, j)), hk)
      +hb2 = FD.logic__subst(Nat, z => {Nat.is_le(VRL.pos(1n+z, 172n, x), A.quad(VB.pw(d))) == True{} : Bool}, 1n+Nat.add(q, j), Nat.add(q, 1n+j), Equal.sym(Nat, Nat.add(q, 1n+j), 1n+Nat.add(q, j), FD.nat__add_succ(q, j)), hb)
      +hx = VRL.nextfit(j, q, 172n, x, A.quad(VB.pw(d)), hb)
      +ex = VRL.posU(d, off, x, i, j, 172, 171n, {==}, eo, ej, hd, hx)
      %Equal.sym(Array<T.SignedBLSToExecutionChange>, Array.set(T.SignedBLSToExecutionChange, FD.array__thaw(T.SignedBLSToExecutionChange, D), i, v), FD.array__thaw(T.SignedBLSToExecutionChange, D1), VRL.set_g(T.SignedBLSToExecutionChange, dd, D, i, j, v, T.SignedBLSToExecutionChange_default(), ej, hdd, hkj, pfD)) :
        {T.l16_SignedBLSToExecutionChange_rd(q, U32.add(i, 1), off, _, T.SignedBLSToExecutionChange_read(BF(t, n), U32.add(off, U32.mul(U32.add(i, 1), 172)), 172)) == (BF(t, n), FD.array__thaw(T.SignedBLSToExecutionChange, RT(1n+q, j, dd, D, t, x))) : B.Buf & Array<T.SignedBLSToExecutionChange>}
      %Equal.sym(B.Buf & T.SignedBLSToExecutionChange, T.SignedBLSToExecutionChange_read(BF(t, n), U32.add(off, U32.mul(U32.add(i, 1), 172)), 172), (BF(t, n), RX(t, VRL.pos(1n+j, 172n, x))),
          VTX.rdx_SignedBLSToExecutionChange(d, t, n, U32.add(off, U32.mul(U32.add(i, 1), 172)), VRL.pos(1n+j, 172n, x), ex, FD.nat__lt_trans(d, 28n, 30n, hd, {==}), pf, hx)) :
        {T.l16_SignedBLSToExecutionChange_rd(q, U32.add(i, 1), off, FD.array__thaw(T.SignedBLSToExecutionChange, D1), _) == (BF(t, n), FD.array__thaw(T.SignedBLSToExecutionChange, RT(1n+q, j, dd, D, t, x))) : B.Buf & Array<T.SignedBLSToExecutionChange>}
      lp(q, d, t, n, x, off, U32.add(i, 1), 1n+j, dd, D1, eo, VRL.succU(d, i, j, 171n, x, ej, hd, hx), hd, pf, hb2, hdd, hk2, FD.array__upd_perfect(T.SignedBLSToExecutionChange, dd, D, j, v, pfD))

# A non-empty window holds c >= 1 records.
def cpos(+len: U32, +c: Nat, +ec: {U32.to_nat(len) == Nat.mul(c, 172n) : Nat}, +eb: {U32.is_eq(len, 0) == False{} : Bool})
    -> {Nat.is_le(1n, c) == True{} : Bool}:
  match c:
    case 0n: Empty.absurd({Nat.is_le(1n, 0n) == True{} : Bool}, FD.logic__true_false(Equal.trans(Bool, True{}, U32.is_eq(len, 0), False{},
      Equal.sym(Bool, U32.is_eq(len, 0), True{}, FD.u32alg__eq_true(len, 0, FD.u32__injective(len, 0, ec))), eb)))
    case 1n+ +p: FD.nat__zero_le(p)

def rd_go(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hchk: {CHKw(t, x, off, len) == True{} : Bool}, +b: Bool, +eb: {U32.is_eq(len, 0) == b : Bool})
    -> {T.l16_SignedBLSToExecutionChange_rd_start(b, off, NN(len), BF(t, n)) == (BF(t, n), LOBJ(b, t, x, len)) : B.Buf & T.l16_SignedBLSToExecutionChange_Seq}:
  match b:
    case True{}: {==}
    case False{}:
      +c = CC(len)
      +ec = ecw(len, hchk)
      +h1 = cpos(len, c, ec, eb)
      +k = U32.to_nat(U32.sub(NN(len), 1))
      +e1 = Equal.trans(Nat, 1n+k, 1n+Nat.sub(c, 1n), c, Equal.cong(Nat, Nat, z => 1n+z, k, Nat.sub(c, 1n), FD.u32__sub_nat(NN(len), 1, h1)), FD.nat__sub_add(c, 1n, h1))
      +P = A.quad(VB.pw(d))
      +hL = FD.logic__subst(Nat, z => {Nat.is_le(z, P) == True{} : Bool}, Nat.add(x, U32.to_nat(len)), Nat.add(U32.to_nat(len), x), FD.nat__add_comm(x, U32.to_nat(len)), hw)
      +hLc = FD.logic__subst(Nat, z => {Nat.is_le(Nat.add(z, x), P) == True{} : Bool}, U32.to_nat(len), Nat.mul(c, 172n), ec, hL)
      +hb = FD.logic__subst(Nat, z => {Nat.is_le(VRL.pos(z, 172n, x), P) == True{} : Bool}, c, Nat.add(1n+k, 0n),
        Equal.trans(Nat, c, 1n+k, Nat.add(1n+k, 0n), Equal.sym(Nat, 1n+k, c, e1), Equal.sym(Nat, Nat.add(1n+k, 0n), 1n+k, FD.nat__add_zero(1n+k))), hLc)
      +hcl = hcw(len, hchk)
      +hcp = VD.wd_cover(NN(len), 4n, {==}, FD.nat__le_trans(c, U32.to_nat(16), O.pow2n(4n), hcl, {==}))
      +hcP = FD.logic__subst(Nat, z => {Nat.is_le(c, z) == True{} : Bool}, O.pow2n(B.words_depth(NN(len))), VB.pw(B.words_depth(NN(len))), Equal.sym(Nat, VB.pw(B.words_depth(NN(len))), O.pow2n(B.words_depth(NN(len))), VD.s_pow2_eq(B.words_depth(NN(len)))), hcp)
      +hk = FD.logic__subst(Nat, z => {Nat.is_lt(z, VB.pw(B.words_depth(NN(len)))) == True{} : Bool}, k, Nat.add(k, 0n), Equal.sym(Nat, Nat.add(k, 0n), k, FD.nat__add_zero(k)),
        FD.nat__lt_le_trans(k, c, VB.pw(B.words_depth(NN(len))), FD.logic__subst(Nat, z => {Nat.is_lt(k, z) == True{} : Bool}, 1n+k, c, e1, FD.nat__lt_succ(k)), hcP))
      +hdd = FD.nat__le_lt_trans(B.words_depth(NN(len)), 4n, 32n, VD.wd_min(NN(len), 4n, FD.nat__le_trans(c, U32.to_nat(16), O.pow2n(4n), hcl, {==})), {==})
      +hb0 = FD.nat__le_trans(Nat.add(x, 172n), Nat.add(x, U32.to_nat(len)), P,
        Order.add_left(x, 172n, U32.to_nat(len), FD.logic__subst(Nat, z => {Nat.is_le(172n, z) == True{} : Bool}, Nat.mul(c, 172n), U32.to_nat(len), Equal.sym(Nat, U32.to_nat(len), Nat.mul(c, 172n), ec),
          FD.logic__subst(Nat, z => {Nat.is_le(172n, Nat.mul(z, 172n)) == True{} : Bool}, 1n+k, c, e1, Order.below_sum(172n, Nat.mul(k, 172n))))), hw)
      +cap = B.words_depth(NN(len))
      %Equal.sym(B.Buf & T.SignedBLSToExecutionChange, T.SignedBLSToExecutionChange_read(BF(t, n), off, 172), (BF(t, n), RX(t, x)), VTX.rdx_SignedBLSToExecutionChange(d, t, n, off, x, eo, FD.nat__lt_trans(d, 28n, 30n, hd, {==}), pf, hb0)) :
        {T.l16_SignedBLSToExecutionChange_rd_fin(NN(len), T.l16_SignedBLSToExecutionChange_rd(k, 0, off, T.l16_SignedBLSToExecutionChange_fill(T.l16_SignedBLSToExecutionChange_cap(NN(len))), _)) == (BF(t, n), LOBJ(False{}, t, x, len)) : B.Buf & T.l16_SignedBLSToExecutionChange_Seq}
      %Equal.sym(Array<T.SignedBLSToExecutionChange>, Array.new(T.SignedBLSToExecutionChange, cap, T.SignedBLSToExecutionChange_default()), FD.array__thaw(T.SignedBLSToExecutionChange, FD.array__trep(T.SignedBLSToExecutionChange, cap, T.SignedBLSToExecutionChange_default())), FD.array__new(T.SignedBLSToExecutionChange, cap, T.SignedBLSToExecutionChange_default())) :
        {T.l16_SignedBLSToExecutionChange_rd_fin(NN(len), T.l16_SignedBLSToExecutionChange_rd(k, 0, off, _, (BF(t, n), RX(t, x)))) == (BF(t, n), LOBJ(False{}, t, x, len)) : B.Buf & T.l16_SignedBLSToExecutionChange_Seq}
      %Equal.sym(B.Buf & Array<T.SignedBLSToExecutionChange>, T.l16_SignedBLSToExecutionChange_rd(k, 0, off, FD.array__thaw(T.SignedBLSToExecutionChange, FD.array__trep(T.SignedBLSToExecutionChange, cap, T.SignedBLSToExecutionChange_default())), (BF(t, n), RX(t, x))),
          (BF(t, n), FD.array__thaw(T.SignedBLSToExecutionChange, RT(k, 0n, cap, FD.array__trep(T.SignedBLSToExecutionChange, cap, T.SignedBLSToExecutionChange_default()), t, x))),
          lp(k, d, t, n, x, off, 0, 0n, cap, FD.array__trep(T.SignedBLSToExecutionChange, cap, T.SignedBLSToExecutionChange_default()), eo, {==}, hd, pf, hb, hdd, hk, FD.array__trep_perfect(T.SignedBLSToExecutionChange, cap, T.SignedBLSToExecutionChange_default()))) :
        {T.l16_SignedBLSToExecutionChange_rd_fin(NN(len), _) == (BF(t, n), LOBJ(False{}, t, x, len)) : B.Buf & T.l16_SignedBLSToExecutionChange_Seq}
      {==}

def readw(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hchk: {CHKw(t, x, off, len) == True{} : Bool})
    -> {T.l16_SignedBLSToExecutionChange_read(BF(t, n), off, len) == (BF(t, n), OBJw(d, t, x, off, len)) : B.Buf & T.l16_SignedBLSToExecutionChange_Seq}:
  rd_go(d, t, n, x, off, len, eo, hd, hw, pf, hchk, U32.is_eq(len, 0), {==})

# ---- the spec side ------------------------------------------------------------------------------

def RITEMS(c: Nat, +t: FD.array__Tree<U32>, +y: Nat) -> S.Value:
  match c:
    case 0n: S.EmptyItems{}
    case 1n+q: S.Items{RVAL(t, y), RITEMS(q, t, Nat.add(172n, y))}

def CHUNKS(c: Nat, +t: FD.array__Tree<U32>, +y: Nat) -> +List<+List<U32>>:
  match c:
    case 0n: []
    case 1n+q: Con{UR.RWS(43n, t, y), CHUNKS(q, t, Nat.add(172n, y))}

law cnt_items:
  for +c: Nat
  for +t: FD.array__Tree<U32>
  for +y: Nat
  {Codec.count(RITEMS(c, t, y)) == c : Nat}
def cnt_items(c, t, y):
  match c:
    case 0n: {==}
    case 1n+ +q: FD.nat__succ_cong(Codec.count(RITEMS(q, t, Nat.add(172n, y))), q, cnt_items(q, t, Nat.add(172n, y)))

law prt_items:
  for +c: Nat
  for +t: FD.array__Tree<U32>
  for +y: Nat
  {Codec.parts(RITEMS(c, t, y), S.Repeat{S.Container{["message", "signature"], S.Chain{S.Container{["validator_index", "from_bls_pubkey", "to_execution_address"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{48n}, S.Chain{S.ByteVector{20n}, S.End{}}}}}, S.Chain{S.ByteVector{96n}, S.End{}}}}}) == Some{F.fparts(CHUNKS(c, t, y))} : Maybe<&2, +List<S.Part>>}
def prt_items(c, t, y):
  match c:
    case 0n: {==}
    case 1n+ +q:
      F.cat_fixed(Codec.parts(RVAL(t, y), S.Container{["message", "signature"], S.Chain{S.Container{["validator_index", "from_bls_pubkey", "to_execution_address"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{48n}, S.Chain{S.ByteVector{20n}, S.End{}}}}}, S.Chain{S.ByteVector{96n}, S.End{}}}}), F.limbs(UR.RWS(43n, t, y)), Codec.parts(RITEMS(q, t, Nat.add(172n, y)), S.Repeat{S.Container{["message", "signature"], S.Chain{S.Container{["validator_index", "from_bls_pubkey", "to_execution_address"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{48n}, S.Chain{S.ByteVector{20n}, S.End{}}}}}, S.Chain{S.ByteVector{96n}, S.End{}}}}}),
        F.fparts(CHUNKS(q, t, Nat.add(172n, y))), RPRF(t, y), prt_items(q, t, Nat.add(172n, y)))

law flat_chunks:
  for +c: Nat
  for +d: Nat
  for +t: FD.array__Tree<U32>
  for +y: Nat
  for +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}
  for +h: {Nat.is_le(Nat.add(y, Nat.mul(c, 172n)), A.quad(VB.pw(d))) == True{} : Bool}
  {F.flat(CHUNKS(c, t, y)) == UW.WX(t, y, Nat.mul(c, 172n)) : +List<U32>}
def flat_chunks(c, d, t, y, pf, h):
  match c:
    case 0n: {==}
    case 1n+ +q:
      +M = Nat.mul(q, 172n)
      +e = Equal.trans(Nat, Nat.add(Nat.add(172n, y), M), Nat.add(172n, Nat.add(y, M)), Nat.add(y, Nat.add(172n, M)),
        FD.nat__add_assoc(172n, y, M), FD.lru_nat_algebra__add_swap(172n, y, M))
      +h2 = FD.logic__subst(Nat, z => {Nat.is_le(z, A.quad(VB.pw(d))) == True{} : Bool}, Nat.add(y, Nat.add(172n, M)), Nat.add(Nat.add(172n, y), M), Equal.sym(Nat, Nat.add(Nat.add(172n, y), M), Nat.add(y, Nat.add(172n, M)), e), h)
      %Equal.sym(+List<U32>, F.flat(CHUNKS(q, t, Nat.add(172n, y))), UW.WX(t, Nat.add(172n, y), M), flat_chunks(q, d, t, Nat.add(172n, y), pf, h2)) :
        {List.append(&2, U32, F.limbs(UR.RWS(43n, t, y)), _) == UW.WX(t, y, Nat.mul(1n+q, 172n)) : +List<U32>}
      Equal.sym(+List<U32>, UW.WX(t, y, Nat.add(A.quad(43n), M)), List.append(&2, U32, F.limbs(UR.RWS(43n, t, y)), UW.WX(t, Nat.add(A.quad(43n), y), M)), UW.headWX(d, t, y, 43n, M, pf, h))

def VALw(+t: FD.array__Tree<U32>, +x: Nat, +len: U32) -> S.Value: S.Sequence{RITEMS(CC(len), t, x)}

def specw(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hchk: {CHKw(t, x, off, len) == True{} : Bool})
    -> {Codec.parts(VALw(t, x, len), S.ListOf{S.Container{["message", "signature"], S.Chain{S.Container{["validator_index", "from_bls_pubkey", "to_execution_address"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{48n}, S.Chain{S.ByteVector{20n}, S.End{}}}}}, S.Chain{S.ByteVector{96n}, S.End{}}}}, U32.to_nat(16)}) == Some{[S.Variable{UW.WX(t, x, U32.to_nat(len))}]} : Maybe<&2, +List<S.Part>>}:
  +c = CC(len)
  +ec = ecw(len, hchk)
  +hf = FD.logic__subst(Nat, z => {Nat.is_le(Nat.add(x, z), A.quad(VB.pw(d))) == True{} : Bool}, U32.to_nat(len), Nat.mul(c, 172n), ec, hw)
  +fl = flat_chunks(c, d, t, x, pf, hf)
  +fit = FD.logic__subst(+List<U32>, z => {N.fits(4n, List.length(&2, U32, z)) == True{} : Bool}, UW.WX(t, x, Nat.mul(c, 172n)), F.flat(CHUNKS(c, t, x)), Equal.sym(+List<U32>, F.flat(CHUNKS(c, t, x)), UW.WX(t, x, Nat.mul(c, 172n)), fl),
    FD.logic__subst(Nat, z => {N.fits(4n, z) == True{} : Bool}, Nat.mul(c, 172n), List.length(&2, U32, UW.WX(t, x, Nat.mul(c, 172n))), Equal.sym(Nat, List.length(&2, U32, UW.WX(t, x, Nat.mul(c, 172n))), Nat.mul(c, 172n), UW.lenWX(d, t, x, Nat.mul(c, 172n), pf, hf)),
      VFT.fits4(2n+d, Nat.mul(c, 172n), FD.nat__le_trans(Nat.mul(c, 172n), Nat.add(x, Nat.mul(c, 172n)), A.quad(VB.pw(d)), Order.left_below_sum(x, Nat.mul(c, 172n)), hf), FD.nat__lt_trans(d, 28n, 30n, hd, {==}))))
  %Equal.sym(Nat, Codec.count(RITEMS(c, t, x)), c, cnt_items(c, t, x)) :
    {Codec.require(Nat.is_le(_, U32.to_nat(16)), Codec.aggregate(Codec.parts(RITEMS(c, t, x), S.Repeat{S.Container{["message", "signature"], S.Chain{S.Container{["validator_index", "from_bls_pubkey", "to_execution_address"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{48n}, S.Chain{S.ByteVector{20n}, S.End{}}}}}, S.Chain{S.ByteVector{96n}, S.End{}}}}}), None{})) == Some{[S.Variable{UW.WX(t, x, U32.to_nat(len))}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(Bool, Nat.is_le(c, U32.to_nat(16)), True{}, hcw(len, hchk)) :
    {Codec.require(_, Codec.aggregate(Codec.parts(RITEMS(c, t, x), S.Repeat{S.Container{["message", "signature"], S.Chain{S.Container{["validator_index", "from_bls_pubkey", "to_execution_address"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{48n}, S.Chain{S.ByteVector{20n}, S.End{}}}}}, S.Chain{S.ByteVector{96n}, S.End{}}}}}), None{})) == Some{[S.Variable{UW.WX(t, x, U32.to_nat(len))}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(Maybe<&2, +List<S.Part>>, Codec.parts(RITEMS(c, t, x), S.Repeat{S.Container{["message", "signature"], S.Chain{S.Container{["validator_index", "from_bls_pubkey", "to_execution_address"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{48n}, S.Chain{S.ByteVector{20n}, S.End{}}}}}, S.Chain{S.ByteVector{96n}, S.End{}}}}}), Some{F.fparts(CHUNKS(c, t, x))}, prt_items(c, t, x)) :
    {Codec.require(True{}, Codec.aggregate(_, None{})) == Some{[S.Variable{UW.WX(t, x, U32.to_nat(len))}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(Maybe<&2, +List<U32>>, Layout.encoding(F.fparts(CHUNKS(c, t, x))), Some{F.flat(CHUNKS(c, t, x))}, VS.encoding_fparts(CHUNKS(c, t, x), fit)) :
    {Codec.one(_, None{}) == Some{[S.Variable{UW.WX(t, x, U32.to_nat(len))}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(+List<U32>, F.flat(CHUNKS(c, t, x)), UW.WX(t, x, Nat.mul(c, 172n)), fl) :
    {Codec.one(Some{_}, None{}) == Some{[S.Variable{UW.WX(t, x, U32.to_nat(len))}]} : Maybe<&2, +List<S.Part>>}
  %ec : {Codec.one(Some{UW.WX(t, x, _)}, None{}) == Some{[S.Variable{UW.WX(t, x, U32.to_nat(len))}]} : Maybe<&2, +List<S.Part>>}
  {==}

# ---- the inversion ------------------------------------------------------------------------------

def rp_t(+xs: +List<U32>, +el: S.Value, +tl: S.Value, +ps: +List<S.Part>, +mB: Maybe<&2, +List<S.Part>>,
    +eB: {Codec.parts(tl, S.Repeat{S.Container{["message", "signature"], S.Chain{S.Container{["validator_index", "from_bls_pubkey", "to_execution_address"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{48n}, S.Chain{S.ByteVector{20n}, S.End{}}}}}, S.Chain{S.ByteVector{96n}, S.End{}}}}}) == mB : Maybe<&2, +List<S.Part>>},
    +lx: {List.length(&2, U32, xs) == 172n : Nat},
    +e: {Codec.concatenate(Some{[S.Fixed{xs}]}, mB) == Some{ps} : Maybe<&2, +List<S.Part>>},
    ih: @+pb: +List<S.Part> -> {Codec.parts(tl, S.Repeat{S.Container{["message", "signature"], S.Chain{S.Container{["validator_index", "from_bls_pubkey", "to_execution_address"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{48n}, S.Chain{S.ByteVector{20n}, S.End{}}}}}, S.Chain{S.ByteVector{96n}, S.End{}}}}}) == Some{pb} : Maybe<&2, +List<S.Part>>} -> VMR.REPB(tl, pb, 172n))
    -> VMR.REPB(S.Items{el, tl}, ps, 172n):
  match mB:
    case None{}: Empty.absurd(VMR.REPB(S.Items{el, tl}, ps, 172n), FD.logic__none_some(+List<S.Part>, ps, e))
    case Some{+pb}:
      +eps = FD.logic__some_inj(+List<S.Part>, S.Fixed{xs} <> pb, ps, e)
      %Equal.sym(+List<S.Part>, ps, S.Fixed{xs} <> pb, Equal.sym(+List<S.Part>, S.Fixed{xs} <> pb, ps, eps)) : VMR.REPB(S.Items{el, tl}, _, 172n)
      VMR.rpb_t2(xs, el, tl, pb, 172n, lx, ih(pb, eB))

def rp_p(+el: S.Value, +tl: S.Value, +ps: +List<S.Part>, +ph: +List<S.Part>, hf: DF.single(Some{172n}, ph),
    +e: {Codec.concatenate(Some{ph}, Codec.parts(tl, S.Repeat{S.Container{["message", "signature"], S.Chain{S.Container{["validator_index", "from_bls_pubkey", "to_execution_address"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{48n}, S.Chain{S.ByteVector{20n}, S.End{}}}}}, S.Chain{S.ByteVector{96n}, S.End{}}}}})) == Some{ps} : Maybe<&2, +List<S.Part>>},
    ih: @+pb: +List<S.Part> -> {Codec.parts(tl, S.Repeat{S.Container{["message", "signature"], S.Chain{S.Container{["validator_index", "from_bls_pubkey", "to_execution_address"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{48n}, S.Chain{S.ByteVector{20n}, S.End{}}}}}, S.Chain{S.ByteVector{96n}, S.End{}}}}}) == Some{pb} : Maybe<&2, +List<S.Part>>} -> VMR.REPB(tl, pb, 172n))
    -> VMR.REPB(S.Items{el, tl}, ps, 172n):
  match ph:
    case Nil{}: Empty.absurd(VMR.REPB(S.Items{el, tl}, ps, 172n), hf)
    case Con{S.Fixed{+xs}, Nil{}}:
      rp_t(xs, el, tl, ps, Codec.parts(tl, S.Repeat{S.Container{["message", "signature"], S.Chain{S.Container{["validator_index", "from_bls_pubkey", "to_execution_address"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{48n}, S.Chain{S.ByteVector{20n}, S.End{}}}}}, S.Chain{S.ByteVector{96n}, S.End{}}}}}), {==}, Equal.sym(Nat, 172n, List.length(&2, U32, xs), FD.logic__some_inj(Nat, 172n, List.length(&2, U32, xs), hf)), e, ih)
    case Con{S.Variable{+xs}, Nil{}}: Empty.absurd(VMR.REPB(S.Items{el, tl}, ps, 172n), FD.logic__none_some(Nat, 172n, Equal.sym(Maybe<&2, Nat>, Some{172n}, None{}, hf)))
    case Con{S.Fixed{+xs}, Con{+a, +b}}: Empty.absurd(VMR.REPB(S.Items{el, tl}, ps, 172n), hf)
    case Con{S.Variable{+xs}, Con{+a, +b}}: Empty.absurd(VMR.REPB(S.Items{el, tl}, ps, 172n), hf)

def rp_m(+el: S.Value, +tl: S.Value, +ps: +List<S.Part>, +mh: Maybe<&2, +List<S.Part>>, hf: DF.single_result(Some{172n}, mh),
    +e: {Codec.concatenate(mh, Codec.parts(tl, S.Repeat{S.Container{["message", "signature"], S.Chain{S.Container{["validator_index", "from_bls_pubkey", "to_execution_address"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{48n}, S.Chain{S.ByteVector{20n}, S.End{}}}}}, S.Chain{S.ByteVector{96n}, S.End{}}}}})) == Some{ps} : Maybe<&2, +List<S.Part>>},
    ih: @+pb: +List<S.Part> -> {Codec.parts(tl, S.Repeat{S.Container{["message", "signature"], S.Chain{S.Container{["validator_index", "from_bls_pubkey", "to_execution_address"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{48n}, S.Chain{S.ByteVector{20n}, S.End{}}}}}, S.Chain{S.ByteVector{96n}, S.End{}}}}}) == Some{pb} : Maybe<&2, +List<S.Part>>} -> VMR.REPB(tl, pb, 172n))
    -> VMR.REPB(S.Items{el, tl}, ps, 172n):
  match mh:
    case None{}: Empty.absurd(VMR.REPB(S.Items{el, tl}, ps, 172n), FD.logic__none_some(+List<S.Part>, ps, e))
    case Some{+ph}: rp_p(el, tl, ps, ph, hf, e, ih)

# The parts of records are fixed parts of 172 bytes each.
law rep_r:
  for +its: S.Value
  for +ps: +List<S.Part>
  for +e: {Codec.parts(its, S.Repeat{S.Container{["message", "signature"], S.Chain{S.Container{["validator_index", "from_bls_pubkey", "to_execution_address"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{48n}, S.Chain{S.ByteVector{20n}, S.End{}}}}}, S.Chain{S.ByteVector{96n}, S.End{}}}}}) == Some{ps} : Maybe<&2, +List<S.Part>>}
  VMR.REPB(its, ps, 172n)
def rep_r(its, ps, e):
  match its:
    case S.EmptyItems{}:
      +eps = FD.logic__some_inj(+List<S.Part>, [], ps, e)
      %Equal.sym(+List<S.Part>, ps, [], Equal.sym(+List<S.Part>, [], ps, eps)) : VMR.REPB(S.EmptyItems{}, _, 172n)
      ({==}, {==})
    case S.Items{+h, +tl}: rp_m(h, tl, ps, Codec.parts(h, S.Container{["message", "signature"], S.Chain{S.Container{["validator_index", "from_bls_pubkey", "to_execution_address"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{48n}, S.Chain{S.ByteVector{20n}, S.End{}}}}}, S.Chain{S.ByteVector{96n}, S.End{}}}}), DS.facts(h, S.Container{["message", "signature"], S.Chain{S.Container{["validator_index", "from_bls_pubkey", "to_execution_address"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{48n}, S.Chain{S.ByteVector{20n}, S.End{}}}}}, S.Chain{S.ByteVector{96n}, S.End{}}}}, {==}), e, pb => eb => rep_r(tl, pb, eb))
    case S.BooleanValue{+b}: Empty.absurd(VMR.REPB(S.BooleanValue{b}, ps, 172n), FD.logic__none_some(+List<S.Part>, ps, e))
    case S.UnsignedValue{+u}: Empty.absurd(VMR.REPB(S.UnsignedValue{u}, ps, 172n), FD.logic__none_some(+List<S.Part>, ps, e))
    case S.BytesValue{+xs}: Empty.absurd(VMR.REPB(S.BytesValue{xs}, ps, 172n), FD.logic__none_some(+List<S.Part>, ps, e))
    case S.BitsValue{+bs}: Empty.absurd(VMR.REPB(S.BitsValue{bs}, ps, 172n), FD.logic__none_some(+List<S.Part>, ps, e))
    case S.Sequence{+it}: Empty.absurd(VMR.REPB(S.Sequence{it}, ps, 172n), FD.logic__none_some(+List<S.Part>, ps, e))
    case S.Selected{+sel, +sv}: Empty.absurd(VMR.REPB(S.Selected{sel, sv}, ps, 172n), FD.logic__none_some(+List<S.Part>, ps, e))
    case S.NullValue{}: Empty.absurd(VMR.REPB(S.NullValue{}, ps, 172n), FD.logic__none_some(+List<S.Part>, ps, e))

def lm4(+its: S.Value, +ys: +List<U32>, +hk: {Nat.is_le(Codec.count(its), U32.to_nat(16)) == True{} : Bool}, +ps: +List<S.Part>,
    +em3: {Codec.parts(its, S.Repeat{S.Container{["message", "signature"], S.Chain{S.Container{["validator_index", "from_bls_pubkey", "to_execution_address"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{48n}, S.Chain{S.ByteVector{20n}, S.End{}}}}}, S.Chain{S.ByteVector{96n}, S.End{}}}}}) == Some{ps} : Maybe<&2, +List<S.Part>>}, +m4: Maybe<&2, +List<U32>>,
    +em4: {Layout.encoding(ps) == m4 : Maybe<&2, +List<U32>>}, +e: {Codec.bytes(Codec.one(m4, None{})) == Some{ys} : Maybe<&2, +List<U32>>})
    -> VMR.LF(ys, 172n, U32.to_nat(16)):
  match m4:
    case None{}: Empty.absurd(VMR.LF(ys, 172n, U32.to_nat(16)), FD.logic__none_some(+List<U32>, ys, e))
    case Some{+zs}:
      +ez = FD.logic__some_inj(+List<U32>, zs, ys, e)
      +lz = Equal.trans(Nat, List.length(&2, U32, zs), Layout.fixed_size(ps), Nat.mul(Codec.count(its), 172n),
        VS.enc_len(ps, zs, Pair.fst({VS.allfix(ps) == True{} : Bool}, {Layout.fixed_size(ps) == Nat.mul(Codec.count(its), 172n) : Nat}, rep_r(its, ps, em3)), em4),
        Pair.snd({VS.allfix(ps) == True{} : Bool}, {Layout.fixed_size(ps) == Nat.mul(Codec.count(its), 172n) : Nat}, rep_r(its, ps, em3)))
      (Codec.count(its), (FD.logic__subst(+List<U32>, z => {List.length(&2, U32, z) == Nat.mul(Codec.count(its), 172n) : Nat}, zs, ys, ez, lz), hk))

def lm3(+its: S.Value, +ys: +List<U32>, +hk: {Nat.is_le(Codec.count(its), U32.to_nat(16)) == True{} : Bool}, +m3: Maybe<&2, +List<S.Part>>,
    +em3: {Codec.parts(its, S.Repeat{S.Container{["message", "signature"], S.Chain{S.Container{["validator_index", "from_bls_pubkey", "to_execution_address"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{48n}, S.Chain{S.ByteVector{20n}, S.End{}}}}}, S.Chain{S.ByteVector{96n}, S.End{}}}}}) == m3 : Maybe<&2, +List<S.Part>>}, +e: {Codec.bytes(Codec.aggregate(m3, None{})) == Some{ys} : Maybe<&2, +List<U32>>})
    -> VMR.LF(ys, 172n, U32.to_nat(16)):
  match m3:
    case None{}: Empty.absurd(VMR.LF(ys, 172n, U32.to_nat(16)), FD.logic__none_some(+List<U32>, ys, e))
    case Some{+ps}: lm4(its, ys, hk, ps, em3, Layout.encoding(ps), {==}, e)

def lb(+its: S.Value, +ys: +List<U32>, +b: Bool, +eb: {Nat.is_le(Codec.count(its), U32.to_nat(16)) == b : Bool},
    +e: {Codec.bytes(Codec.require(b, Codec.aggregate(Codec.parts(its, S.Repeat{S.Container{["message", "signature"], S.Chain{S.Container{["validator_index", "from_bls_pubkey", "to_execution_address"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{48n}, S.Chain{S.ByteVector{20n}, S.End{}}}}}, S.Chain{S.ByteVector{96n}, S.End{}}}}}), None{}))) == Some{ys} : Maybe<&2, +List<U32>>})
    -> VMR.LF(ys, 172n, U32.to_nat(16)):
  match b:
    case False{}: Empty.absurd(VMR.LF(ys, 172n, U32.to_nat(16)), FD.logic__none_some(+List<U32>, ys, e))
    case True{}: lm3(its, ys, eb, Codec.parts(its, S.Repeat{S.Container{["message", "signature"], S.Chain{S.Container{["validator_index", "from_bls_pubkey", "to_execution_address"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{48n}, S.Chain{S.ByteVector{20n}, S.End{}}}}}, S.Chain{S.ByteVector{96n}, S.End{}}}}}), {==}, e)

# The spec bytes ys of any value of the list are whole records, at most 16.
law linvr:
  for +h: S.Value
  for +ys: +List<U32>
  for +e: {Codec.bytes(Codec.parts(h, S.ListOf{S.Container{["message", "signature"], S.Chain{S.Container{["validator_index", "from_bls_pubkey", "to_execution_address"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{48n}, S.Chain{S.ByteVector{20n}, S.End{}}}}}, S.Chain{S.ByteVector{96n}, S.End{}}}}, U32.to_nat(16)})) == Some{ys} : Maybe<&2, +List<U32>>}
  VMR.LF(ys, 172n, U32.to_nat(16))
def linvr(h, ys, e):
  match h:
    case S.Sequence{+its}: lb(its, ys, Nat.is_le(Codec.count(its), U32.to_nat(16)), {==}, e)
    case S.BooleanValue{+b0}: Empty.absurd(VMR.LF(ys, 172n, U32.to_nat(16)), FD.logic__none_some(+List<U32>, ys, e))
    case S.UnsignedValue{+u0}: Empty.absurd(VMR.LF(ys, 172n, U32.to_nat(16)), FD.logic__none_some(+List<U32>, ys, e))
    case S.BytesValue{+xs0}: Empty.absurd(VMR.LF(ys, 172n, U32.to_nat(16)), FD.logic__none_some(+List<U32>, ys, e))
    case S.BitsValue{+bs0}: Empty.absurd(VMR.LF(ys, 172n, U32.to_nat(16)), FD.logic__none_some(+List<U32>, ys, e))
    case S.Items{+hd0, +tl0}: Empty.absurd(VMR.LF(ys, 172n, U32.to_nat(16)), FD.logic__none_some(+List<U32>, ys, e))
    case S.EmptyItems{}: Empty.absurd(VMR.LF(ys, 172n, U32.to_nat(16)), FD.logic__none_some(+List<U32>, ys, e))
    case S.Selected{+sel0, +sv0}: Empty.absurd(VMR.LF(ys, 172n, U32.to_nat(16)), FD.logic__none_some(+List<U32>, ys, e))
    case S.NullValue{}: Empty.absurd(VMR.LF(ys, 172n, U32.to_nat(16)), FD.logic__none_some(+List<U32>, ys, e))

def chk_i(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, f: VMR.LF(UW.WX(t, x, U32.to_nat(len)), 172n, U32.to_nat(16))) -> {CHKw(t, x, off, len) == True{} : Bool}:
  (+k, +pr) = f
  (+hl, +hk) = pr
  VU.whole_i(len, 172, 16, vR(), {==}, {==}, {==}, k,
    Equal.trans(Nat, U32.to_nat(len), List.length(&2, U32, UW.WX(t, x, U32.to_nat(len))), Nat.mul(k, 172n),
      Equal.sym(Nat, List.length(&2, U32, UW.WX(t, x, U32.to_nat(len))), U32.to_nat(len), UW.lenWX(d, t, x, U32.to_nat(len), pf, hw)), hl), hk)

# Every value whose parts are the window's bytes passes the check.
def invw(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +v: S.Value,
    +e: {Codec.parts(v, S.ListOf{S.Container{["message", "signature"], S.Chain{S.Container{["validator_index", "from_bls_pubkey", "to_execution_address"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{48n}, S.Chain{S.ByteVector{20n}, S.End{}}}}}, S.Chain{S.ByteVector{96n}, S.End{}}}}, U32.to_nat(16)}) == Some{[S.Variable{UW.WX(t, x, U32.to_nat(len))}]} : Maybe<&2, +List<S.Part>>})
    -> {CHKw(t, x, off, len) == True{} : Bool}:
  chk_i(d, t, n, x, off, len, eo, hd, hw, pf, linvr(v, UW.WX(t, x, U32.to_nat(len)),
    Equal.cong(Maybe<&2, +List<S.Part>>, Maybe<&2, +List<U32>>, z => Codec.bytes(z), Codec.parts(v, S.ListOf{S.Container{["message", "signature"], S.Chain{S.Container{["validator_index", "from_bls_pubkey", "to_execution_address"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{48n}, S.Chain{S.ByteVector{20n}, S.End{}}}}}, S.Chain{S.ByteVector{96n}, S.End{}}}}, U32.to_nat(16)}), Some{[S.Variable{UW.WX(t, x, U32.to_nat(len))}]}, e)))

