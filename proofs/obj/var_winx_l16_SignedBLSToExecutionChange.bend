# the records j, j + 1, ..., j + k written into a record tree D
def RT(k: Nat, +j: Nat, +dd: Nat, D: FD.array__Tree<T.SignedBLSToExecutionChange>, +t: FD.array__Tree<U32>, +x: Nat) -> FD.array__Tree<T.SignedBLSToExecutionChange>:
  match k:
    case 0n: FD.array__upd(T.SignedBLSToExecutionChange, dd, D, j, RX(t, VRL.pos(j, 172n, x)))
    case 1n+q: RT(q, 1n+j, dd, FD.array__upd(T.SignedBLSToExecutionChange, dd, D, j, RX(t, VRL.pos(j, 172n, x))), t, x)

# ---- the validator ------------------------------------------------------------------------------

def CHKw(+t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32) -> Bool:
  Bool.and(U32.is_eq(len, (U32.div(len, 172) * 172 : U32)), U32.is_le(U32.div(len, 172), 16))

def ok_evalw(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}) -> {T.l16_SignedBLSToExecutionChange_ok(BF(t, n), off, len) == (BF(t, n), CHKw(t, x, off, len)) : B.Buf & Bool}:
  {==}

def vR() -> Word(31n): FD.spec_numeric__from_nat(31n, 172n)

# The window is c whole records, c <= 16.
def NN(+len: U32) -> U32: U32.div(len, 172)
def CC(+len: U32) -> Nat: U32.to_nat(NN(len))
def ecw(+len: U32, +h: {Bool.and(U32.is_eq(len, (U32.div(len, 172) * 172 : U32)), U32.is_le(U32.div(len, 172), 16)) == True{} : Bool})
    -> {U32.to_nat(len) == Nat.mul(CC(len), 172n) : Nat}:
  Pair.fst({U32.to_nat(len) == Nat.mul(CC(len), U32.to_nat(172)) : Nat}, {Nat.is_le(CC(len), U32.to_nat(16)) == True{} : Bool}, VU.whole_t(len, 172, 16, vR(), {==}, {==}, {==}, h))
def hcw(+len: U32, +h: {Bool.and(U32.is_eq(len, (U32.div(len, 172) * 172 : U32)), U32.is_le(U32.div(len, 172), 16)) == True{} : Bool})
    -> {Nat.is_le(CC(len), U32.to_nat(16)) == True{} : Bool}:
