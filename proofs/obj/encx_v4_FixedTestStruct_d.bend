def putk_rt(+da: Nat, +A: FD.array__Tree<FixedTestStruct_d.FixedTestStruct>, +N: U32, +h: {OKT(da, A, N) == True{} : Bool}, +dd: Nat, +D: FD.array__Tree<U32>, +X: U32, +P0: Nat,
    +rtb: B0.RTN(U32.is_eq(N, 0), A, N, dd, D, X, P0)) -> B0.RTX(da, A, N, dd, D, X, P0):
  %Equal.sym(vec_FixedTestStruct_4_d.v4_FixedTestStruct_Seq & Bool, vec_FixedTestStruct_4_e.v4_FixedTestStruct_valid(vec_FixedTestStruct_4_d.v4_FixedTestStruct_Seq{FD.array__thaw(FixedTestStruct_d.FixedTestStruct, A), N}), (vec_FixedTestStruct_4_d.v4_FixedTestStruct_Seq{FD.array__thaw(FixedTestStruct_d.FixedTestStruct, A), N}, True{}), valid(da, A, N, h)) :
    {vec_FixedTestStruct_4_e.v4_FixedTestStruct_pk(FD.array__thaw(U32, D), X, _) == (FD.array__thaw(U32, B0.PUTLb(U32.is_eq(N, 0), A, N, dd, D, P0)), (vec_FixedTestStruct_4_d.v4_FixedTestStruct_Seq{FD.array__thaw(FixedTestStruct_d.FixedTestStruct, A), N}, 0)) : Array<U32> & (vec_FixedTestStruct_4_d.v4_FixedTestStruct_Seq & U32)}
  %Equal.sym(Array<U32> & vec_FixedTestStruct_4_d.v4_FixedTestStruct_Seq, vec_FixedTestStruct_4_e.v4_FixedTestStruct_pt_nz(U32.is_eq(N, 0), X, N, FD.array__thaw(U32, D), FD.array__thaw(FixedTestStruct_d.FixedTestStruct, A)), (FD.array__thaw(U32, B0.PUTLb(U32.is_eq(N, 0), A, N, dd, D, P0)), vec_FixedTestStruct_4_d.v4_FixedTestStruct_Seq{FD.array__thaw(FixedTestStruct_d.FixedTestStruct, A), N}), rtb) :
    {vec_FixedTestStruct_4_e.v4_FixedTestStruct_pk_ok(_) == (FD.array__thaw(U32, B0.PUTLb(U32.is_eq(N, 0), A, N, dd, D, P0)), (vec_FixedTestStruct_4_d.v4_FixedTestStruct_Seq{FD.array__thaw(FixedTestStruct_d.FixedTestStruct, A), N}, 0)) : Array<U32> & (vec_FixedTestStruct_4_d.v4_FixedTestStruct_Seq & U32)}
  {==}

# N = 4, and the bytes' count
def en(+da: Nat, +A: FD.array__Tree<FixedTestStruct_d.FixedTestStruct>, +N: U32, +h: {OKT(da, A, N) == True{} : Bool}) -> {U32.to_nat(N) == 4n : Nat}:
  Equal.cong(U32, Nat, z => U32.to_nat(z), N, 4, FD.u32alg__eq_of(N, 4, ok_3(da, A, N, h)))
def enb(+da: Nat, +A: FD.array__Tree<FixedTestStruct_d.FixedTestStruct>, +N: U32, +h: {OKT(da, A, N) == True{} : Bool}) -> {Nat.mul(U32.to_nat(N), 13n) == 52n : Nat}:
  Equal.cong(Nat, Nat, z => Nat.mul(z, 13n), U32.to_nat(N), 4n, en(da, A, N, h))

# The loop over exactly the 52 bytes at X = 4 q + r (zero there), data-only.
def fwgoW(+da: Nat, +A: FD.array__Tree<FixedTestStruct_d.FixedTestStruct>, +N: U32, +dd: Nat, +D: FD.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat,
    +e: {U32.to_nat(X) == Nat.add(A.quad(q), r) : Nat}, +hd: {Nat.is_lt(dd, 31n) == True{} : Bool}, +pf: {FD.array__perfect(U32, dd, D) == True{} : Bool},
    +hl: {Nat.is_le(Nat.add(q, WD.NWN(Nat.add(r, 52n))), VB.pw(dd)) == True{} : Bool}, +hl32: {Nat.is_lt(Nat.add(A.quad(q), Nat.add(r, 52n)), FD.spec_common__pow2(32n)) == True{} : Bool},
    +hz: {VS.bt(52n, VS.bdr(Nat.add(A.quad(q), r), UA.BYT(D))) == UW.ZB(52n) : +List<U32>},
    +h: {OKT(da, A, N) == True{} : Bool})
    -> DK.P2(B0.RTN(U32.is_eq(N, 0), A, N, dd, D, X, Nat.add(A.quad(q), r)), B0.BYN(U32.is_eq(N, 0), A, N, dd, D, Nat.add(A.quad(q), r))):
  +P0 = Nat.add(A.quad(q), r)
  +eb = enb(da, A, N, h)
  +hb = FD.logic__subst(Nat, z => {Nat.is_le(Nat.add(P0, z), A.quad(VB.pw(dd))) == True{} : Bool}, 52n, Nat.mul(U32.to_nat(N), 13n), Equal.sym(Nat, Nat.mul(U32.to_nat(N), 13n), 52n, eb),
    VRX.xend(q, r, 52n, dd, hl))
  +hz2 = FD.logic__subst(Nat, z => {VS.bt(z, VS.bdr(P0, UA.BYT(D))) == UW.ZB(z) : +List<U32>}, 52n, Nat.mul(U32.to_nat(N), 13n), Equal.sym(Nat, Nat.mul(U32.to_nat(N), 13n), 52n, eb), hz)
  ptnzW(da, A, N, U32.is_eq(N, 0), {==}, h, dd, D, X, P0, e, hd, hb, pf, hz2)

def fwgo(+da: Nat, +A: FD.array__Tree<FixedTestStruct_d.FixedTestStruct>, +N: U32, +dd: Nat, +D: FD.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat,
    +e: {U32.to_nat(X) == Nat.add(A.quad(q), r) : Nat}, +hd: {Nat.is_lt(dd, 29n) == True{} : Bool}, +pf: {FD.array__perfect(U32, dd, D) == True{} : Bool},
    +hl: {Nat.is_le(Nat.add(q, WD.NWN(Nat.add(r, 52n))), VB.pw(dd)) == True{} : Bool},
    +hz: {VS.bt(52n, VS.bdr(Nat.add(A.quad(q), r), UA.BYT(D))) == UW.ZB(52n) : +List<U32>},
    +h: {OKT(da, A, N) == True{} : Bool})
    -> DK.P2(B0.RTN(U32.is_eq(N, 0), A, N, dd, D, X, Nat.add(A.quad(q), r)), B0.BYN(U32.is_eq(N, 0), A, N, dd, D, Nat.add(A.quad(q), r))):
  fwgoW(da, A, N, dd, D, X, q, r, e, FD.nat__lt_trans(dd, 29n, 31n, hd, {==}), pf, hl, VRX.hl32w(q, r, 52n, dd, hd, hl), hz, h)

# ---- the vector as a fixed field (codegen/proofs/var/var_cont_enc.py's FixW) ---------------------------------

law lenv:
  for +m: B0.MW
  for +hok: {OK(m) == True{} : Bool}
  {List.length(&2, U32, B0.ENC(m)) == 52n : Nat}
def lenv(m, hok):
  match m:
    case B0.MW{+da, +A, +N}: Equal.trans(Nat, List.length(&2, U32, B0.RBS(U32.to_nat(N), A, 0n)), Nat.mul(U32.to_nat(N), 13n), 52n, B0.len_rbs(U32.to_nat(N), A, 0n), enb(da, A, N, hok))

law fwrtW:
  for +m: B0.MW
  for +dd: Nat
  for +D: FD.array__Tree<U32>
  for +X: U32
  for +q: Nat
  for +r: Nat
  for +e: {U32.to_nat(X) == Nat.add(A.quad(q), r) : Nat}
  for +hr: {Nat.is_lt(r, 4n) == True{} : Bool}
  for +hd: {Nat.is_lt(dd, 31n) == True{} : Bool}
  for +hl: {Nat.is_le(Nat.add(q, WD.NWN(Nat.add(r, 52n))), VB.pw(dd)) == True{} : Bool}
  for +hl32: {Nat.is_lt(Nat.add(A.quad(q), Nat.add(r, 52n)), FD.spec_common__pow2(32n)) == True{} : Bool}
  for +pf: {FD.array__perfect(U32, dd, D) == True{} : Bool}
  for +hz: {VS.bt(52n, VS.bdr(Nat.add(A.quad(q), r), UA.BYT(D))) == UW.ZB(52n) : +List<U32>}
  for +hok: {OK(m) == True{} : Bool}
  {vec_FixedTestStruct_4_e.v4_FixedTestStruct_putk(FD.array__thaw(U32, D), X, B0.TH(m)) == (FD.array__thaw(U32, B0.PUTX(m, dd, D, q, r)), (B0.TH(m), 0)) : Array<U32> & (vec_FixedTestStruct_4_d.v4_FixedTestStruct_Seq & U32)}
def fwrtW(m, dd, D, X, q, r, e, hr, hd, hl, hl32, pf, hz, hok):
  match m:
    case B0.MW{+da, +A, +N}:
      +P0 = Nat.add(A.quad(q), r)
      +g = fwgoW(da, A, N, dd, D, X, q, r, e, hd, pf, hl, hl32, hz, hok)
      putk_rt(da, A, N, hok, dd, D, X, P0, B0.PA(B0.RTN(U32.is_eq(N, 0), A, N, dd, D, X, P0), B0.BYN(U32.is_eq(N, 0), A, N, dd, D, P0), g))

law fwrt:
  for +m: B0.MW
  for +dd: Nat
  for +D: FD.array__Tree<U32>
  for +X: U32
  for +q: Nat
  for +r: Nat
  for +e: {U32.to_nat(X) == Nat.add(A.quad(q), r) : Nat}
  for +hr: {Nat.is_lt(r, 4n) == True{} : Bool}
  for +hd: {Nat.is_lt(dd, 29n) == True{} : Bool}
  for +hl: {Nat.is_le(Nat.add(q, WD.NWN(Nat.add(r, 52n))), VB.pw(dd)) == True{} : Bool}
  for +pf: {FD.array__perfect(U32, dd, D) == True{} : Bool}
  for +hz: {VS.bt(52n, VS.bdr(Nat.add(A.quad(q), r), UA.BYT(D))) == UW.ZB(52n) : +List<U32>}
  for +hok: {OK(m) == True{} : Bool}
  {vec_FixedTestStruct_4_e.v4_FixedTestStruct_putk(FD.array__thaw(U32, D), X, B0.TH(m)) == (FD.array__thaw(U32, B0.PUTX(m, dd, D, q, r)), (B0.TH(m), 0)) : Array<U32> & (vec_FixedTestStruct_4_d.v4_FixedTestStruct_Seq & U32)}
def fwrt(m, dd, D, X, q, r, e, hr, hd, hl, pf, hz, hok):
  fwrtW(m, dd, D, X, q, r, e, hr, FD.nat__lt_trans(dd, 29n, 31n, hd, {==}), hl, VRX.hl32w(q, r, 52n, dd, hd, hl), pf, hz, hok)

law fwbyW:
  for +m: B0.MW
  for +dd: Nat
  for +D: FD.array__Tree<U32>
  for +X: U32
  for +q: Nat
  for +r: Nat
  for +e: {U32.to_nat(X) == Nat.add(A.quad(q), r) : Nat}
  for +hr: {Nat.is_lt(r, 4n) == True{} : Bool}
  for +hd: {Nat.is_lt(dd, 31n) == True{} : Bool}
  for +hl: {Nat.is_le(Nat.add(q, WD.NWN(Nat.add(r, 52n))), VB.pw(dd)) == True{} : Bool}
  for +hl32: {Nat.is_lt(Nat.add(A.quad(q), Nat.add(r, 52n)), FD.spec_common__pow2(32n)) == True{} : Bool}
  for +pf: {FD.array__perfect(U32, dd, D) == True{} : Bool}
  for +hz: {VS.bt(52n, VS.bdr(Nat.add(A.quad(q), r), UA.BYT(D))) == UW.ZB(52n) : +List<U32>}
  for +hok: {OK(m) == True{} : Bool}
  {UA.BYT(B0.PUTX(m, dd, D, q, r)) == UW.SPL(UA.BYT(D), Nat.add(A.quad(q), r), B0.ENC(m)) : +List<U32>}
def fwbyW(m, dd, D, X, q, r, e, hr, hd, hl, hl32, pf, hz, hok):
  match m:
    case B0.MW{+da, +A, +N}:
      +P0 = Nat.add(A.quad(q), r)
      +g = fwgoW(da, A, N, dd, D, X, q, r, e, hd, pf, hl, hl32, hz, hok)
      B0.PB(B0.RTN(U32.is_eq(N, 0), A, N, dd, D, X, P0), B0.BYN(U32.is_eq(N, 0), A, N, dd, D, P0), g)

law fwby:
  for +m: B0.MW
  for +dd: Nat
  for +D: FD.array__Tree<U32>
  for +X: U32
  for +q: Nat
  for +r: Nat
  for +e: {U32.to_nat(X) == Nat.add(A.quad(q), r) : Nat}
  for +hr: {Nat.is_lt(r, 4n) == True{} : Bool}
  for +hd: {Nat.is_lt(dd, 29n) == True{} : Bool}
  for +hl: {Nat.is_le(Nat.add(q, WD.NWN(Nat.add(r, 52n))), VB.pw(dd)) == True{} : Bool}
  for +pf: {FD.array__perfect(U32, dd, D) == True{} : Bool}
  for +hz: {VS.bt(52n, VS.bdr(Nat.add(A.quad(q), r), UA.BYT(D))) == UW.ZB(52n) : +List<U32>}
  for +hok: {OK(m) == True{} : Bool}
  {UA.BYT(B0.PUTX(m, dd, D, q, r)) == UW.SPL(UA.BYT(D), Nat.add(A.quad(q), r), B0.ENC(m)) : +List<U32>}
def fwby(m, dd, D, X, q, r, e, hr, hd, hl, pf, hz, hok):
  fwbyW(m, dd, D, X, q, r, e, hr, FD.nat__lt_trans(dd, 29n, 31n, hd, {==}), hl, VRX.hl32w(q, r, 52n, dd, hd, hl), pf, hz, hok)

law validx:
  for +m: B0.MW
  for +hok: {OK(m) == True{} : Bool}
  {vec_FixedTestStruct_4_e.v4_FixedTestStruct_valid(B0.TH(m)) == (B0.TH(m), True{}) : vec_FixedTestStruct_4_d.v4_FixedTestStruct_Seq & Bool}
def validx(m, hok):
  match m:
    case B0.MW{+da, +A, +N}: valid(da, A, N, hok)

# The spec: the vector's parts are one fixed part, its bytes.
law vspec:
  for +m: B0.MW
  for +hok: {OK(m) == True{} : Bool}
  {Codec.parts(B0.VAL(m), S.Vector{S.Container{["f_A", "f_B", "f_C"], S.Chain{S.Unsigned{P.U8{}}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.Unsigned{P.U32Width{}}, S.End{}}}}}, 4n}) == Some{[S.Fixed{B0.ENC(m)}]} : Maybe<&2, +List<S.Part>>}
def vspec(m, hok):
  match m:
    case B0.MW{+da, +A, +N}:
      +c = U32.to_nat(N)
      +FS = Nat.mul(c, 13n)
      +Y = B0.RBS(c, A, 0n)
      +ha = B0.bps_all(c, A, 0n)
      +cat = B0.bps_cat(c, A, 0n)
      +fit = FD.logic__subst(Nat, z => {N.fits(4n, z) == True{} : Bool}, 52n, Nat.add(FS, 0n),
        Equal.trans(Nat, 52n, FS, Nat.add(FS, 0n), Equal.sym(Nat, FS, 52n, enb(da, A, N, hok)), Equal.sym(Nat, Nat.add(FS, 0n), FS, FD.nat__add_zero(FS))), {==})
      +hs = Equal.trans(Nat, Layout.fixed_size(B0.BPS(c, A, 0n)), List.length(&2, U32, SP2.fcat(B0.BPS(c, A, 0n))), FS, SP2.fsz(B0.BPS(c, A, 0n), ha),
        Equal.trans(Nat, List.length(&2, U32, SP2.fcat(B0.BPS(c, A, 0n))), List.length(&2, U32, Y), FS, Equal.cong(+List<U32>, Nat, z => List.length(&2, U32, z), SP2.fcat(B0.BPS(c, A, 0n)), Y, cat), B0.len_rbs(c, A, 0n)))
      +hfp = Equal.trans(+List<U32>, Layout.fixed_parts(B0.BPS(c, A, 0n), FS), SP2.fcat(B0.BPS(c, A, 0n)), Y, SP2.fxp(B0.BPS(c, A, 0n), FS, ha), cat)
      +hv = SP2.bvl(B0.BPS(c, A, 0n), ha, FD.logic__subst(+List<U32>, z => {SP.bytes_domain(z) == True{} : Bool}, Y, SP2.fcat(B0.BPS(c, A, 0n)), Equal.sym(+List<U32>, SP2.fcat(B0.BPS(c, A, 0n)), Y, cat), B0.dom_rbs(c, A, 0n)))
      +hc = FD.logic__subst(Nat, z => {Nat.is_eq(z, 4n) == True{} : Bool}, 4n, c, Equal.sym(Nat, c, 4n, en(da, A, N, hok)), {==})
      %Equal.sym(Nat, Codec.count(B0.ITS(c, A, 0n)), c, B0.cnt_its(c, A, 0n)) :
        {Codec.require(Bool.and(Nat.is_lt(0n, 4n), Nat.is_eq(_, 4n)), Codec.aggregate(Codec.parts(B0.ITS(c, A, 0n), S.Repeat{S.Container{["f_A", "f_B", "f_C"], S.Chain{S.Unsigned{P.U8{}}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.Unsigned{P.U32Width{}}, S.End{}}}}}}), SS.times(4n, SS.fixed_size(S.Container{["f_A", "f_B", "f_C"], S.Chain{S.Unsigned{P.U8{}}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.Unsigned{P.U32Width{}}, S.End{}}}}})))) == Some{[S.Fixed{Y}]} : Maybe<&2, +List<S.Part>>}
      %Equal.sym(Bool, Nat.is_eq(c, 4n), True{}, hc) :
        {Codec.require(Bool.and(Nat.is_lt(0n, 4n), _), Codec.aggregate(Codec.parts(B0.ITS(c, A, 0n), S.Repeat{S.Container{["f_A", "f_B", "f_C"], S.Chain{S.Unsigned{P.U8{}}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.Unsigned{P.U32Width{}}, S.End{}}}}}}), SS.times(4n, SS.fixed_size(S.Container{["f_A", "f_B", "f_C"], S.Chain{S.Unsigned{P.U8{}}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.Unsigned{P.U32Width{}}, S.End{}}}}})))) == Some{[S.Fixed{Y}]} : Maybe<&2, +List<S.Part>>}
      %Equal.sym(Maybe<&2, +List<S.Part>>, Codec.parts(B0.ITS(c, A, 0n), S.Repeat{S.Container{["f_A", "f_B", "f_C"], S.Chain{S.Unsigned{P.U8{}}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.Unsigned{P.U32Width{}}, S.End{}}}}}}), Some{B0.BPS(c, A, 0n)}, B0.prt_its(c, A, 0n)) :
        {Codec.aggregate(_, SS.times(4n, SS.fixed_size(S.Container{["f_A", "f_B", "f_C"], S.Chain{S.Unsigned{P.U8{}}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.Unsigned{P.U32Width{}}, S.End{}}}}}))) == Some{[S.Fixed{Y}]} : Maybe<&2, +List<S.Part>>}
      %Equal.sym(Maybe<&2, +List<U32>>, Layout.encoding(B0.BPS(c, A, 0n)), Some{List.append(&2, U32, Y, [])},
          VMV.enc_gen(B0.BPS(c, A, 0n), FS, Y, [], hs, hfp, SP2.pay0(B0.BPS(c, A, 0n), ha), hv, fit)) :
        {Codec.one(_, SS.times(4n, SS.fixed_size(S.Container{["f_A", "f_B", "f_C"], S.Chain{S.Unsigned{P.U8{}}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.Unsigned{P.U32Width{}}, S.End{}}}}}))) == Some{[S.Fixed{Y}]} : Maybe<&2, +List<S.Part>>}
      %Equal.sym(+List<U32>, List.append(&2, U32, Y, []), Y, VS.app_nil(Y)) : {Codec.one(Some{_}, SS.times(4n, SS.fixed_size(S.Container{["f_A", "f_B", "f_C"], S.Chain{S.Unsigned{P.U8{}}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.Unsigned{P.U32Width{}}, S.End{}}}}}))) == Some{[S.Fixed{Y}]} : Maybe<&2, +List<S.Part>>}
      {==}
