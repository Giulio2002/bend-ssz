  %Equal.sym(Maybe<&2, +List<S.Part>>, Codec.parts(VAL(t, n), Spec.Transaction()), Some{[S.Variable{UW.WX(t, 0n, U32.to_nat(n))}]}, EW.specwD(d, t, n, 0n, 0, n, {==}, hd, hn, FD.logic__subst(Bool, z => {z == True{} : Bool}, U32.is_le(n, VB.NMAX()), Nat.is_le(U32.to_nat(n), U32.to_nat(VB.NMAX())), VB.le_u32n(n, VB.NMAX()), hN), pf, hchk)) :
    {Codec.bytes(_) == Some{VW(t, n)} : Maybe<&2, +List<U32>>}
  {==}

# Every spec value of an accepted buffer's bytes is VAL(t, n).
law decode_unique:
  for +d: Nat
  for +t: FD.array__Tree<U32>
  for +n: U32
  for +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}
  for +hd: {Nat.is_lt(d, 31n) == True{} : Bool}
  for +hn: {Nat.is_le(U32.to_nat(n), A.quad(VB.pw(d))) == True{} : Bool}
  for +hN: {U32.is_le(n, VB.NMAX()) == True{} : Bool}
  for +hchk: {CHK(t, n) == True{} : Bool}
  for +v: S.Value
  for spec: Decoding.decodes(Spec.Transaction(), VW(t, n), v)
  {v == VAL(t, n) : S.Value}
def decode_unique(d, t, n, pf, hd, hn, hN, hchk, v, spec):
  DCO.valid_unique(Spec.Transaction(), VW(t, n), v, VAL(t, n), {==}, spec, decode_spec(d, t, n, pf, hd, hn, hN, hchk))

# A value encoding to the buffer's bytes has them as its one variable part (the limit
# test ByteList.domain(limit, xs) stays a variable b).
def rjb(+xs: +List<U32>, +b: Bool, +ys: +List<U32>, +e: {Codec.bytes(Codec.one(SP.optional(b, xs), None{})) == Some{ys} : Maybe<&2, +List<U32>>})
    -> {Codec.one(SP.optional(b, xs), None{}) == Some{[S.Variable{ys}]} : Maybe<&2, +List<S.Part>>}:
  match b:
    case False{}: Empty.absurd({Codec.one(SP.optional(False{}, xs), None{}) == Some{[S.Variable{ys}]} : Maybe<&2, +List<S.Part>>}, FD.logic__none_some(+List<U32>, ys, e))
    case True{}:
      %FD.logic__some_inj(+List<U32>, xs, ys, e) : {Codec.one(SP.optional(True{}, xs), None{}) == Some{[S.Variable{_}]} : Maybe<&2, +List<S.Part>>}
      {==}

def rjt(+v: S.Value, +ys: +List<U32>, +e: {Codec.encoding_for_legal_type(Spec.Transaction(), v) == Some{ys} : Maybe<&2, +List<U32>>})
    -> {Codec.parts(v, Spec.Transaction()) == Some{[S.Variable{ys}]} : Maybe<&2, +List<S.Part>>}:
  match v:
    case S.BooleanValue{+b0}: Empty.absurd({Codec.parts(S.BooleanValue{b0}, Spec.Transaction()) == Some{[S.Variable{ys}]} : Maybe<&2, +List<S.Part>>}, FD.logic__none_some(+List<U32>, ys, e))
    case S.UnsignedValue{+u0}: Empty.absurd({Codec.parts(S.UnsignedValue{u0}, Spec.Transaction()) == Some{[S.Variable{ys}]} : Maybe<&2, +List<S.Part>>}, FD.logic__none_some(+List<U32>, ys, e))
    case S.BytesValue{+xs}: rjb(xs, ByteList.domain(U32.to_nat(1073741824), xs), ys, e)
    case S.BitsValue{+bs0}: Empty.absurd({Codec.parts(S.BitsValue{bs0}, Spec.Transaction()) == Some{[S.Variable{ys}]} : Maybe<&2, +List<S.Part>>}, FD.logic__none_some(+List<U32>, ys, e))
    case S.Sequence{+it0}: Empty.absurd({Codec.parts(S.Sequence{it0}, Spec.Transaction()) == Some{[S.Variable{ys}]} : Maybe<&2, +List<S.Part>>}, FD.logic__none_some(+List<U32>, ys, e))
    case S.Items{+hd0, +tl0}: Empty.absurd({Codec.parts(S.Items{hd0, tl0}, Spec.Transaction()) == Some{[S.Variable{ys}]} : Maybe<&2, +List<S.Part>>}, FD.logic__none_some(+List<U32>, ys, e))
    case S.EmptyItems{}: Empty.absurd({Codec.parts(S.EmptyItems{}, Spec.Transaction()) == Some{[S.Variable{ys}]} : Maybe<&2, +List<S.Part>>}, FD.logic__none_some(+List<U32>, ys, e))
    case S.Selected{+sel0, +sv0}: Empty.absurd({Codec.parts(S.Selected{sel0, sv0}, Spec.Transaction()) == Some{[S.Variable{ys}]} : Maybe<&2, +List<S.Part>>}, FD.logic__none_some(+List<U32>, ys, e))
    case S.NullValue{}: Empty.absurd({Codec.parts(S.NullValue{}, Spec.Transaction()) == Some{[S.Variable{ys}]} : Maybe<&2, +List<S.Part>>}, FD.logic__none_some(+List<U32>, ys, e))

def rej_f(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hd: {Nat.is_lt(d, 31n) == True{} : Bool},
    +hn: {Nat.is_le(U32.to_nat(n), A.quad(VB.pw(d))) == True{} : Bool}, +hN: {U32.is_le(n, VB.NMAX()) == True{} : Bool}, +hchk: {CHK(t, n) == False{} : Bool}, +v: S.Value,
    +e: {Codec.encoding_for_legal_type(Spec.Transaction(), v) == Some{VW(t, n)} : Maybe<&2, +List<U32>>}) -> Empty:
  FD.logic__true_false(Equal.trans(Bool, True{}, CHK(t, n), False{},
    Equal.sym(Bool, CHK(t, n), True{}, EW.invwD(d, t, n, 0n, 0, n, {==}, hd, hn, FD.logic__subst(Bool, z => {z == True{} : Bool}, U32.is_le(n, VB.NMAX()), Nat.is_le(U32.to_nat(n), U32.to_nat(VB.NMAX())), VB.le_u32n(n, VB.NMAX()), hN), pf, v, rjt(v, VW(t, n), e))), hchk))

# When the validator refuses, no value is related to the buffer's bytes.
law decode_reject:
  for +d: Nat
  for +t: FD.array__Tree<U32>
  for +n: U32
  for +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}
  for +hd: {Nat.is_lt(d, 31n) == True{} : Bool}
  for +hn: {Nat.is_le(U32.to_nat(n), A.quad(VB.pw(d))) == True{} : Bool}
  for +hN: {U32.is_le(n, VB.NMAX()) == True{} : Bool}
  for +hchk: {CHK(t, n) == False{} : Bool}
  Decoding.outside_image(Spec.Transaction(), VW(t, n))
def decode_reject(d, t, n, pf, hd, hn, hN, hchk):
  v => e => rej_f(d, t, n, pf, hd, hn, hN, hchk, v, e)

# decode window: the proof is on the decoder of a window inside the buffer
def none_go_in(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hd: {Nat.is_lt(d, 31n) == True{} : Bool},
    +hn: {Nat.is_le(U32.to_nat(n), A.quad(VB.pw(d))) == True{} : Bool}, +hN: {U32.is_le(n, VB.NMAX()) == True{} : Bool}, +hchk: {CHK(t, n) == False{} : Bool})
    -> {FuluTransaction_r.Transaction_decode_in(BF(t, n), n) == (BF(t, n), None{}) : B.Buf & Maybe<&1, O.Words>}:
  %Equal.sym(B.Buf & Bool, FuluTransaction_r.bl1073741824_ok(BF(t, n), 0, n), (BF(t, n), CHK(t, n)), ok_eval(d, t, n, pf, hd, hn, hN)) :
    {FuluTransaction_r.Transaction_built(n, _) == (BF(t, n), None{}) : B.Buf & Maybe<&1, O.Words>}
  %Equal.sym(Bool, CHK(t, n), False{}, hchk) :
    {FuluTransaction_r.Transaction_built(n, (BF(t, n), _)) == (BF(t, n), None{}) : B.Buf & Maybe<&1, O.Words>}
  {==}

def none_go(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hd: {Nat.is_lt(d, 31n) == True{} : Bool},
    +hn: {Nat.is_le(U32.to_nat(n), A.quad(VB.pw(d))) == True{} : Bool}, +hN: {U32.is_le(n, VB.NMAX()) == True{} : Bool}, +hchk: {CHK(t, n) == False{} : Bool})
    -> {FuluTransaction_r.Transaction_decode(BF(t, n), n) == (BF(t, n), None{}) : B.Buf & Maybe<&1, O.Words>}:
  DW_FuluTransaction.Transaction_win_none(BF(t, n), n, none_go_in(d, t, n, pf, hd, hn, hN, hchk))

# When the validator refuses, the decoder returns None and the buffer.
# decode window: the proof is on the decoder of a window inside the buffer
law decode_none_in:
  for +d: Nat
  for +t: FD.array__Tree<U32>
  for +n: U32
  for +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}
  for +hd: {Nat.is_lt(d, 31n) == True{} : Bool}
  for +hn: {Nat.is_le(U32.to_nat(n), A.quad(VB.pw(d))) == True{} : Bool}
  for +hN: {U32.is_le(n, VB.NMAX()) == True{} : Bool}
  for +hchk: {CHK(t, n) == False{} : Bool}
  {FuluTransaction_r.Transaction_decode_in(BF(t, n), n) == (BF(t, n), None{}) : B.Buf & Maybe<&1, O.Words>}
def decode_none_in(d, t, n, pf, hd, hn, hN, hchk): none_go_in(d, t, n, pf, hd, hn, hN, hchk)

law decode_none:
  for +d: Nat
  for +t: FD.array__Tree<U32>
  for +n: U32
  for +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}
