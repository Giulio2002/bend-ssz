  {UA.BYT(PUTL_l2048_Eth1Data(A, N, dd, D, q, r)) == UW.SPL(UA.BYT(D), Nat.add(A.quad(q), r), ENCL_l2048_Eth1Data(A, N)) : +List<U32>}
