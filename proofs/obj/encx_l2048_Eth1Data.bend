    {(THL_l2048_Eth1Data(A, N), Bool.and(Bool.or(False{}, True{}), _)) == (THL_l2048_Eth1Data(A, N), True{}) : T.l2048_Eth1Data_Seq & Bool}
  {==}

def RTL_l2048_Eth1Data(+A: FD.array__Tree<T.Eth1Data>, +N: U32, +dd: Nat, +D: FD.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat) -> Data:
