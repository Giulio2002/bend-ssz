  for +dd: Nat
  for +D: FD.array__Tree<U32>
  for +q: Nat
  for +r: Nat
  for +A: FD.array__Tree<T.Eth1Data>
  for +pf: {FD.array__perfect(U32, dd, D) == True{} : Bool}
  {FD.array__perfect(U32, dd, WX_l2048_Eth1Data(k, j, dd, D, q, r, A)) == True{} : Bool}
def pfWX_l2048_Eth1Data(k, j, dd, D, q, r, A, pf):
  match k:
    case 0n: pfo_Eth1Data(EL_l2048_Eth1Data(A, j), dd, D, Nat.add(Nat.mul(j, 18n), q), r, pf)
    case 1n+ +p: pfWX_l2048_Eth1Data(p, 1n+j, dd, PXo_Eth1Data(EL_l2048_Eth1Data(A, j), dd, D, Nat.add(Nat.mul(j, 18n), q), r), q, r, A, pfo_Eth1Data(EL_l2048_Eth1Data(A, j), dd, D, Nat.add(Nat.mul(j, 18n), q), r, pf))

def RTK_l2048_Eth1Data(k: Nat, +i: U32, +j: Nat, +X: U32, +q: Nat, +r: Nat, +dd: Nat, +D: FD.array__Tree<U32>, +A: FD.array__Tree<T.Eth1Data>) -> Data:
  {T.l2048_Eth1Data_pt(k, i, X, FD.array__thaw(U32, D), (FD.array__thaw(T.Eth1Data, A), EL_l2048_Eth1Data(A, j))) == (FD.array__thaw(U32, WX_l2048_Eth1Data(k, j, dd, D, q, r, A)), FD.array__thaw(T.Eth1Data, A)) : Array<U32> & Array<T.Eth1Data>}
def BYK_l2048_Eth1Data(k: Nat, +j: Nat, +q: Nat, +r: Nat, +dd: Nat, +D: FD.array__Tree<U32>, +A: FD.array__Tree<T.Eth1Data>) -> Data:
  {UA.BYT(WX_l2048_Eth1Data(k, j, dd, D, q, r, A)) == UW.SPL(UA.BYT(D), VRX.YP(j, 18n, q, r), F.flat(CHW_l2048_Eth1Data(1n+k, A, j))) : +List<U32>}

# The loop from record j (index i) on, k + 1 records, into LT bytes at X whose last k + 1 records' bytes are zero.
def ptx_l2048_Eth1Data(k: Nat, +i: U32, +j: Nat, +X: U32, +q: Nat, +r: Nat, +dd: Nat, +D: FD.array__Tree<U32>, +da: Nat, +A: FD.array__Tree<T.Eth1Data>, +LT: Nat,
    +ei: {U32.to_nat(i) == j : Nat}, +e: {U32.to_nat(X) == Nat.add(A.quad(q), r) : Nat}, +hr: {Nat.is_lt(r, 4n) == True{} : Bool}, +hd: {Nat.is_lt(dd, 29n) == True{} : Bool},
    +pfD: {FD.array__perfect(U32, dd, D) == True{} : Bool}, +hj: {Nat.is_le(A.quad(Nat.mul(Nat.add(1n+k, j), 18n)), LT) == True{} : Bool},
    +hl: {Nat.is_le(Nat.add(q, WD.NWN(Nat.add(r, LT))), VB.pw(dd)) == True{} : Bool},
    +hz: {VS.bt(A.quad(Nat.mul(1n+k, 18n)), VS.bdr(VRX.YP(j, 18n, q, r), UA.BYT(D))) == UW.ZB(A.quad(Nat.mul(1n+k, 18n))) : +List<U32>},
    +pfA: {FD.array__perfect(T.Eth1Data, da, A) == True{} : Bool}, +hda: {Nat.is_lt(da, 31n) == True{} : Bool}, +hk: {Nat.is_lt(Nat.add(k, j), VB.pw(da)) == True{} : Bool})
    -> DK.P2(RTK_l2048_Eth1Data(k, i, j, X, q, r, dd, D, A), BYK_l2048_Eth1Data(k, j, q, r, dd, D, A)):
  match k:
    case 0n:
      +o = EL_l2048_Eth1Data(A, j)
      +qj = Nat.add(Nat.mul(j, 18n), q)
      +Xj = U32.add(X, U32.mul(i, 72))
      +ej = VRX.rpos(X, i, j, 0n, q, r, 18n, 72, LT, dd, e, {==}, ei, hd, hj, hl)
      +hlj = VRX.rroom(j, 0n, q, r, 18n, LT, dd, hj, hl)
      +g = putxo_Eth1Data(o, dd, D, Xj, qj, r, ej, hr, hd, hlj, pfD, hz)
      +rt = PA(RTo_Eth1Data(o, dd, D, Xj, qj, r), BYo_Eth1Data(o, dd, D, qj, r), g)
      +by = PB(RTo_Eth1Data(o, dd, D, Xj, qj, r), BYo_Eth1Data(o, dd, D, qj, r), g)
      +D1 = PXo_Eth1Data(o, dd, D, qj, r)
      +Y = F.limbs(RWD_Eth1Data(o))
      +rt0 = Equal.cong(Array<U32>, Array<U32> & Array<T.Eth1Data>, z => (z, FD.array__thaw(T.Eth1Data, A)), T.Eth1Data_put(FD.array__thaw(U32, D), Xj, o), FD.array__thaw(U32, D1), rt)
      +by0 = FD.logic__subst(+List<U32>, z => {UA.BYT(D1) == UW.SPL(UA.BYT(D), VRX.YP(j, 18n, q, r), z) : +List<U32>}, Y, List.append(&2, U32, Y, []),
        Equal.sym(+List<U32>, List.append(&2, U32, Y, []), Y, VS.app_nil(Y)), by)
      (rt0, by0)
    case 1n+ +p:
      +o = EL_l2048_Eth1Data(A, j)
      +qj = Nat.add(Nat.mul(j, 18n), q)
      +Xj = U32.add(X, U32.mul(i, 72))
      +ej = VRX.rpos(X, i, j, 1n+p, q, r, 18n, 72, LT, dd, e, {==}, ei, hd, hj, hl)
      +hlj = VRX.rroom(j, 1n+p, q, r, 18n, LT, dd, hj, hl)
      +bm = A.quad(Nat.mul(1n+p, 18n))
      +B0 = UA.BYT(D)
      +Yj = VRX.YP(j, 18n, q, r)
      +hz0 = VRX.zhead(72n, bm, VS.bdr(Yj, B0), hz)
      +g = putxo_Eth1Data(o, dd, D, Xj, qj, r, ej, hr, hd, hlj, pfD, hz0)
      +rt = PA(RTo_Eth1Data(o, dd, D, Xj, qj, r), BYo_Eth1Data(o, dd, D, qj, r), g)
      +by = PB(RTo_Eth1Data(o, dd, D, Xj, qj, r), BYo_Eth1Data(o, dd, D, qj, r), g)
      +D1 = PXo_Eth1Data(o, dd, D, qj, r)
      +pf1 = pfo_Eth1Data(o, dd, D, qj, r, pfD)
      +Y = F.limbs(RWD_Eth1Data(o))
      +hX = VRX.xstart(qj, r, 72n, dd, D, pfD, hlj)
      +ey = VRX.ynext(j, 18n, q, r)
      +z1 = VRX.znext(B0, Yj, Y, VRX.YP(1n+j, 18n, q, r), 72n, bm, UA.BYT(D1), hX, lenb_Eth1Data(o), ey, by, hz)
      +h1 = FD.nat__le_lt_trans(1n+j, 1n+Nat.add(p, j), VB.pw(da), Order.left_below_sum(p, j), hk)
      +ei1 = VB.add_le_at(i, 1, j, da, ei, hda, FD.nat__lt_le(1n+j, VB.pw(da), h1))
      +hi1 = FD.logic__subst(Nat, z => {Nat.is_lt(z, FD.spec_common__pow2(da)) == True{} : Bool}, 1n+j, U32.to_nat(U32.add(i, 1)), Equal.sym(Nat, U32.to_nat(U32.add(i, 1)), 1n+j, ei1), h1)
      +hx = FD.logic__subst(Nat, z => {FD.spec_common__nth(T.Eth1Data, FD.array__slots(T.Eth1Data, A), z) == Some{EL_l2048_Eth1Data(A, 1n+j)} : Maybe<&2, T.Eth1Data>}, 1n+j, U32.to_nat(U32.add(i, 1)), Equal.sym(Nat, U32.to_nat(U32.add(i, 1)), 1n+j, ei1),
        VRL.nth_get(T.Eth1Data, FD.array__slots(T.Eth1Data, A), 1n+j, T.Eth1Data_default(), FD.array__len_lt(T.Eth1Data, da, A, 1n+j, pfA, h1)))
      +eg = FD.array__get(T.Eth1Data, da, A, U32.add(i, 1), EL_l2048_Eth1Data(A, 1n+j), VB.lt32(da, hda), hi1, hx, pfA)
      +hj2 = FD.logic__subst(Nat, z => {Nat.is_le(A.quad(Nat.mul(1n+z, 18n)), LT) == True{} : Bool}, 1n+Nat.add(p, j), Nat.add(p, 1n+j), Equal.sym(Nat, Nat.add(p, 1n+j), 1n+Nat.add(p, j), FD.nat__add_succ(p, j)), hj)
      +hk2 = FD.logic__subst(Nat, z => {Nat.is_lt(z, VB.pw(da)) == True{} : Bool}, 1n+Nat.add(p, j), Nat.add(p, 1n+j), Equal.sym(Nat, Nat.add(p, 1n+j), 1n+Nat.add(p, j), FD.nat__add_succ(p, j)), hk)
      +ih = ptx_l2048_Eth1Data(p, U32.add(i, 1), 1n+j, X, q, r, dd, D1, da, A, LT, ei1, e, hr, hd, pf1, hj2, hl, z1, pfA, hda, hk2)
      +rt2 = PA(RTK_l2048_Eth1Data(p, U32.add(i, 1), 1n+j, X, q, r, dd, D1, A), BYK_l2048_Eth1Data(p, 1n+j, q, r, dd, D1, A), ih)
      +by2 = PB(RTK_l2048_Eth1Data(p, U32.add(i, 1), 1n+j, X, q, r, dd, D1, A), BYK_l2048_Eth1Data(p, 1n+j, q, r, dd, D1, A), ih)
      +ea = Equal.cong(Array<U32>, Array<U32> & Array<T.Eth1Data>, z => T.l2048_Eth1Data_pt(p, U32.add(i, 1), X, z, AG_l2048_Eth1Data(A, U32.add(i, 1))), T.Eth1Data_put(FD.array__thaw(U32, D), Xj, o), FD.array__thaw(U32, D1), rt)
      +eb = Equal.cong(Array<T.Eth1Data> & T.Eth1Data, Array<U32> & Array<T.Eth1Data>, z => T.l2048_Eth1Data_pt(p, U32.add(i, 1), X, FD.array__thaw(U32, D1), z), AG_l2048_Eth1Data(A, U32.add(i, 1)), (FD.array__thaw(T.Eth1Data, A), EL_l2048_Eth1Data(A, 1n+j)), eg)
      +rt3 = Equal.trans(Array<U32> & Array<T.Eth1Data>, T.l2048_Eth1Data_pt(p, U32.add(i, 1), X, T.Eth1Data_put(FD.array__thaw(U32, D), Xj, o), AG_l2048_Eth1Data(A, U32.add(i, 1))), T.l2048_Eth1Data_pt(p, U32.add(i, 1), X, FD.array__thaw(U32, D1), AG_l2048_Eth1Data(A, U32.add(i, 1))),
        (FD.array__thaw(U32, WX_l2048_Eth1Data(p, 1n+j, dd, D1, q, r, A)), FD.array__thaw(T.Eth1Data, A)), ea,
        Equal.trans(Array<U32> & Array<T.Eth1Data>, T.l2048_Eth1Data_pt(p, U32.add(i, 1), X, FD.array__thaw(U32, D1), AG_l2048_Eth1Data(A, U32.add(i, 1))), T.l2048_Eth1Data_pt(p, U32.add(i, 1), X, FD.array__thaw(U32, D1), (FD.array__thaw(T.Eth1Data, A), EL_l2048_Eth1Data(A, 1n+j))),
          (FD.array__thaw(U32, WX_l2048_Eth1Data(p, 1n+j, dd, D1, q, r, A)), FD.array__thaw(T.Eth1Data, A)), eb, rt2))
      +rest = F.flat(CHW_l2048_Eth1Data(1n+p, A, 1n+j))
      +eXn = Equal.trans(Nat, VRX.YP(1n+j, 18n, q, r), Nat.add(Yj, A.quad(18n)), Nat.add(Yj, VRX.LN(Y)), ey,
        Equal.cong(Nat, Nat, z => Nat.add(Yj, z), A.quad(18n), VRX.LN(Y), Equal.sym(Nat, VRX.LN(Y), A.quad(18n), lenb_Eth1Data(o))))
      +by3 = Equal.trans(+List<U32>, UA.BYT(WX_l2048_Eth1Data(p, 1n+j, dd, D1, q, r, A)), UW.SPL(UA.BYT(D1), VRX.YP(1n+j, 18n, q, r), rest), UW.SPL(B0, Yj, VRX.AP(Y, rest)), by2,
        VRX.spl_catx(B0, Yj, Y, rest, VRX.YP(1n+j, 18n, q, r), UA.BYT(D1), hX, eXn, by))
      (rt3, by3)

# ---- l2048_Eth1Data: the list's encoder window ----

def TDM_l2048_Eth1Data(t: FD.array__Tree<T.Eth1Data>) -> Nat:
  match t:
    case FD.TLeaf{x}: 0n
    case FD.TNode{l, r}: 1n+TDM_l2048_Eth1Data(l)

# The list object Seq{thaw(A), N} and its facts: a perfect tree of depth < 31 holding the N records,
# N within the limit 2048.
def THL_l2048_Eth1Data(+A: FD.array__Tree<T.Eth1Data>, +N: U32) -> T.l2048_Eth1Data_Seq: T.l2048_Eth1Data_Seq{FD.array__thaw(T.Eth1Data, A), N}
def OKL_l2048_Eth1Data(+A: FD.array__Tree<T.Eth1Data>, +N: U32) -> Bool:
  Bool.and(Nat.is_lt(TDM_l2048_Eth1Data(A), 31n), Bool.and(FD.array__perfect(T.Eth1Data, TDM_l2048_Eth1Data(A), A), Bool.and(Nat.is_le(U32.to_nat(N), VB.pw(TDM_l2048_Eth1Data(A))), U32.is_le(N, 2048))))
def okl_d_l2048_Eth1Data(+A: FD.array__Tree<T.Eth1Data>, +N: U32, +h: {OKL_l2048_Eth1Data(A, N) == True{} : Bool}) -> {Nat.is_lt(TDM_l2048_Eth1Data(A), 31n) == True{} : Bool}:
  and_l(Nat.is_lt(TDM_l2048_Eth1Data(A), 31n), Bool.and(FD.array__perfect(T.Eth1Data, TDM_l2048_Eth1Data(A), A), Bool.and(Nat.is_le(U32.to_nat(N), VB.pw(TDM_l2048_Eth1Data(A))), U32.is_le(N, 2048))), h)
def okl_1_l2048_Eth1Data(+A: FD.array__Tree<T.Eth1Data>, +N: U32, +h: {OKL_l2048_Eth1Data(A, N) == True{} : Bool})
    -> {Bool.and(FD.array__perfect(T.Eth1Data, TDM_l2048_Eth1Data(A), A), Bool.and(Nat.is_le(U32.to_nat(N), VB.pw(TDM_l2048_Eth1Data(A))), U32.is_le(N, 2048))) == True{} : Bool}:
  and_r(Nat.is_lt(TDM_l2048_Eth1Data(A), 31n), Bool.and(FD.array__perfect(T.Eth1Data, TDM_l2048_Eth1Data(A), A), Bool.and(Nat.is_le(U32.to_nat(N), VB.pw(TDM_l2048_Eth1Data(A))), U32.is_le(N, 2048))), h)
def okl_pf_l2048_Eth1Data(+A: FD.array__Tree<T.Eth1Data>, +N: U32, +h: {OKL_l2048_Eth1Data(A, N) == True{} : Bool}) -> {FD.array__perfect(T.Eth1Data, TDM_l2048_Eth1Data(A), A) == True{} : Bool}:
  and_l(FD.array__perfect(T.Eth1Data, TDM_l2048_Eth1Data(A), A), Bool.and(Nat.is_le(U32.to_nat(N), VB.pw(TDM_l2048_Eth1Data(A))), U32.is_le(N, 2048)), okl_1_l2048_Eth1Data(A, N, h))
def okl_2_l2048_Eth1Data(+A: FD.array__Tree<T.Eth1Data>, +N: U32, +h: {OKL_l2048_Eth1Data(A, N) == True{} : Bool}) -> {Bool.and(Nat.is_le(U32.to_nat(N), VB.pw(TDM_l2048_Eth1Data(A))), U32.is_le(N, 2048)) == True{} : Bool}:
  and_r(FD.array__perfect(T.Eth1Data, TDM_l2048_Eth1Data(A), A), Bool.and(Nat.is_le(U32.to_nat(N), VB.pw(TDM_l2048_Eth1Data(A))), U32.is_le(N, 2048)), okl_1_l2048_Eth1Data(A, N, h))
def okl_n_l2048_Eth1Data(+A: FD.array__Tree<T.Eth1Data>, +N: U32, +h: {OKL_l2048_Eth1Data(A, N) == True{} : Bool}) -> {Nat.is_le(U32.to_nat(N), VB.pw(TDM_l2048_Eth1Data(A))) == True{} : Bool}:
  and_l(Nat.is_le(U32.to_nat(N), VB.pw(TDM_l2048_Eth1Data(A))), U32.is_le(N, 2048), okl_2_l2048_Eth1Data(A, N, h))
def okl_lim_l2048_Eth1Data(+A: FD.array__Tree<T.Eth1Data>, +N: U32, +h: {OKL_l2048_Eth1Data(A, N) == True{} : Bool}) -> {U32.is_le(N, 2048) == True{} : Bool}:
  and_r(Nat.is_le(U32.to_nat(N), VB.pw(TDM_l2048_Eth1Data(A))), U32.is_le(N, 2048), okl_2_l2048_Eth1Data(A, N, h))

# N <= 2^d as the runtime compares it.
def le_cap_l2048_Eth1Data(+A: FD.array__Tree<T.Eth1Data>, +N: U32, +h: {OKL_l2048_Eth1Data(A, N) == True{} : Bool}) -> {U32.is_le(N, FD.u32__pow2u(TDM_l2048_Eth1Data(A))) == True{} : Bool}:
  %Equal.sym(Bool, U32.is_le(N, FD.u32__pow2u(TDM_l2048_Eth1Data(A))), Nat.is_le(U32.to_nat(N), U32.to_nat(FD.u32__pow2u(TDM_l2048_Eth1Data(A)))), VU.le_u32(N, FD.u32__pow2u(TDM_l2048_Eth1Data(A)))) : {_ == True{} : Bool}
  %Equal.sym(Nat, U32.to_nat(FD.u32__pow2u(TDM_l2048_Eth1Data(A))), VB.pw(TDM_l2048_Eth1Data(A)), FD.u32__pow2u_value(TDM_l2048_Eth1Data(A), FD.nat__lt_trans(TDM_l2048_Eth1Data(A), 31n, 32n, okl_d_l2048_Eth1Data(A, N, h), {==}))) : {Nat.is_le(U32.to_nat(N), _) == True{} : Bool}
  okl_n_l2048_Eth1Data(A, N, h)

# The list's bytes, their count, and the writer's model.
def LL_l2048_Eth1Data(+A: FD.array__Tree<T.Eth1Data>, +N: U32) -> Nat: A.quad(Nat.mul(U32.to_nat(N), 18n))
def ENCL_l2048_Eth1Data(+A: FD.array__Tree<T.Eth1Data>, +N: U32) -> +List<U32>: F.limbs(RWA_l2048_Eth1Data(U32.to_nat(N), A, 0n))
def PUTLb_l2048_Eth1Data(b: Bool, +A: FD.array__Tree<T.Eth1Data>, +N: U32, +dd: Nat, +D: FD.array__Tree<U32>, +q: Nat, +r: Nat) -> FD.array__Tree<U32>:
  match b:
    case True{}: D
    case False{}: WX_l2048_Eth1Data(U32.to_nat(U32.sub(N, 1)), 0n, dd, D, q, r, A)
def PUTL_l2048_Eth1Data(+A: FD.array__Tree<T.Eth1Data>, +N: U32, +dd: Nat, +D: FD.array__Tree<U32>, +q: Nat, +r: Nat) -> FD.array__Tree<U32>: PUTLb_l2048_Eth1Data(U32.is_eq(N, 0), A, N, dd, D, q, r)
def pfLb_l2048_Eth1Data(+b: Bool, +A: FD.array__Tree<T.Eth1Data>, +N: U32, +dd: Nat, +D: FD.array__Tree<U32>, +q: Nat, +r: Nat, +pf: {FD.array__perfect(U32, dd, D) == True{} : Bool})
    -> {FD.array__perfect(U32, dd, PUTLb_l2048_Eth1Data(b, A, N, dd, D, q, r)) == True{} : Bool}:
  match b:
    case True{}: pf
    case False{}: pfWX_l2048_Eth1Data(U32.to_nat(U32.sub(N, 1)), 0n, dd, D, q, r, A, pf)

def RTN_l2048_Eth1Data(+b: Bool, +A: FD.array__Tree<T.Eth1Data>, +N: U32, +dd: Nat, +D: FD.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat) -> Data:
  {T.l2048_Eth1Data_pt_nz(b, X, N, FD.array__thaw(U32, D), FD.array__thaw(T.Eth1Data, A)) == (FD.array__thaw(U32, PUTLb_l2048_Eth1Data(b, A, N, dd, D, q, r)), THL_l2048_Eth1Data(A, N)) : Array<U32> & T.l2048_Eth1Data_Seq}
def BYN_l2048_Eth1Data(+b: Bool, +A: FD.array__Tree<T.Eth1Data>, +N: U32, +dd: Nat, +D: FD.array__Tree<U32>, +q: Nat, +r: Nat) -> Data:
  {UA.BYT(PUTLb_l2048_Eth1Data(b, A, N, dd, D, q, r)) == UW.SPL(UA.BYT(D), Nat.add(A.quad(q), r), F.flat(CHW_l2048_Eth1Data(U32.to_nat(N), A, 0n))) : +List<U32>}

# The writer's non-empty test, and its loop.
def ptnz_l2048_Eth1Data(+A: FD.array__Tree<T.Eth1Data>, +N: U32, +b: Bool, +eb: {U32.is_eq(N, 0) == b : Bool}, +h: {OKL_l2048_Eth1Data(A, N) == True{} : Bool}, +dd: Nat, +D: FD.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat,
    +e: {U32.to_nat(X) == Nat.add(A.quad(q), r) : Nat}, +hr: {Nat.is_lt(r, 4n) == True{} : Bool}, +hd: {Nat.is_lt(dd, 29n) == True{} : Bool},
    +hl: {Nat.is_le(Nat.add(q, WD.NWN(Nat.add(r, LL_l2048_Eth1Data(A, N)))), VB.pw(dd)) == True{} : Bool}, +pf: {FD.array__perfect(U32, dd, D) == True{} : Bool},
    +hz: {VS.bt(LL_l2048_Eth1Data(A, N), VS.bdr(Nat.add(A.quad(q), r), UA.BYT(D))) == UW.ZB(LL_l2048_Eth1Data(A, N)) : +List<U32>})
    -> DK.P2(RTN_l2048_Eth1Data(b, A, N, dd, D, X, q, r), BYN_l2048_Eth1Data(b, A, N, dd, D, q, r)):
  match b:
    case True{}:
      +eN = Equal.cong(U32, Nat, z => U32.to_nat(z), N, 0, FD.u32alg__eq_of(N, 0, eb))
      ({==}, FD.logic__subst(Nat, z => {UA.BYT(D) == UW.SPL(UA.BYT(D), Nat.add(A.quad(q), r), F.flat(CHW_l2048_Eth1Data(z, A, 0n))) : +List<U32>}, 0n, U32.to_nat(N), Equal.sym(Nat, U32.to_nat(N), 0n, eN),
        Equal.sym(+List<U32>, UW.SPL(UA.BYT(D), Nat.add(A.quad(q), r), []), UA.BYT(D), VRX.spl_nil(UA.BYT(D), Nat.add(A.quad(q), r)))))
    case False{}:
      +c = U32.to_nat(N)
      +da = TDM_l2048_Eth1Data(A)
      +pfA = okl_pf_l2048_Eth1Data(A, N, h)
      +hda = okl_d_l2048_Eth1Data(A, N, h)
      +hca = okl_n_l2048_Eth1Data(A, N, h)
