# szx: the size the writer returns is the list's byte count, when the list lies in the tree.
def szx_l2048_Eth1Data(+A: FD.array__Tree<T.Eth1Data>, +N: U32, +q: Nat, +r: Nat, +dd: Nat, +hd: {Nat.is_lt(dd, 29n) == True{} : Bool},
