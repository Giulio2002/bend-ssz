    FD.nat__le_trans(LL_l2048_Eth1Data(A, N), Nat.add(Nat.add(A.quad(q), r), LL_l2048_Eth1Data(A, N)), VB.pw(2n+dd), Order.left_below_sum(Nat.add(A.quad(q), r), LL_l2048_Eth1Data(A, N)), VRX.xend(q, r, LL_l2048_Eth1Data(A, N), dd, hl)))


