# The runtime's validity check of the list.
def valid_l2048_Eth1Data(+A: FD.array__Tree<T.Eth1Data>, +N: U32, +h: {OKL_l2048_Eth1Data(A, N) == True{} : Bool}) -> {T.l2048_Eth1Data_valid(THL_l2048_Eth1Data(A, N)) == (THL_l2048_Eth1Data(A, N), True{}) : T.l2048_Eth1Data_Seq & Bool}:
  +d = TDM_l2048_Eth1Data(A)
  %Equal.sym(Array<T.Eth1Data> & U32, Array.size(T.Eth1Data, FD.array__thaw(T.Eth1Data, A)), (FD.array__thaw(T.Eth1Data, A), FD.u32__pow2u(d)), FD.array__size_thaw(T.Eth1Data, d, A, okl_pf_l2048_Eth1Data(A, N, h))) :
    {T.l2048_Eth1Data_va_cap(Bool.or(False{}, U32.is_le(N, 2048)), N, _) == (THL_l2048_Eth1Data(A, N), True{}) : T.l2048_Eth1Data_Seq & Bool}
  %Equal.sym(Bool, U32.is_le(N, 2048), True{}, okl_lim_l2048_Eth1Data(A, N, h)) :
    {(THL_l2048_Eth1Data(A, N), Bool.and(Bool.or(False{}, _), U32.is_le(N, FD.u32__pow2u(d)))) == (THL_l2048_Eth1Data(A, N), True{}) : T.l2048_Eth1Data_Seq & Bool}
