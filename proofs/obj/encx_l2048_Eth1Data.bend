  +b = U32.is_eq(N, 0)
  +g = ptnz_l2048_Eth1Data(A, N, b, {==}, h, dd, D, X, q, r, e, hr, hd, hl, pf, hz)
  +rtb = PA(RTN_l2048_Eth1Data(b, A, N, dd, D, X, q, r), BYN_l2048_Eth1Data(b, A, N, dd, D, q, r), g)
  +byb = PB(RTN_l2048_Eth1Data(b, A, N, dd, D, X, q, r), BYN_l2048_Eth1Data(b, A, N, dd, D, q, r), g)
  +by = Equal.trans(+List<U32>, UA.BYT(PUTL_l2048_Eth1Data(A, N, dd, D, q, r)), UW.SPL(UA.BYT(D), Nat.add(A.quad(q), r), F.flat(CHW_l2048_Eth1Data(U32.to_nat(N), A, 0n))), UW.SPL(UA.BYT(D), Nat.add(A.quad(q), r), ENCL_l2048_Eth1Data(A, N)), byb,
    Equal.cong(+List<U32>, +List<U32>, z => UW.SPL(UA.BYT(D), Nat.add(A.quad(q), r), z), F.flat(CHW_l2048_Eth1Data(U32.to_nat(N), A, 0n)), ENCL_l2048_Eth1Data(A, N), flatW_l2048_Eth1Data(U32.to_nat(N), A, 0n)))
  (putk_rt_l2048_Eth1Data(A, N, h, dd, D, X, q, r, rtb), (by, pfLb_l2048_Eth1Data(b, A, N, dd, D, q, r, pf)))

