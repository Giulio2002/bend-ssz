    {(THL_l2048_Eth1Data(A, N), O.pick(_, U32.mul(N, 72), 2147483648)) == (THL_l2048_Eth1Data(A, N), U32.mul(N, 72)) : T.l2048_Eth1Data_Seq & U32}
