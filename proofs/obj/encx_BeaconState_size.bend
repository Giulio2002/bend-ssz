# ---- the size pass on the container's mirror ----
def SZSM(m: CI.MW) -> U32:
  match m:
    case CI.MW{+wR}: SZS(wR)

law sizex:
  for +m: CI.MW
  for +hok: {CI.OK(m) == True{} : Bool}
  {FuluBeaconState_e.BeaconState_size(CI.TH(m)) == (CI.TH(m), SZSM(m)) : FuluBeaconState_d.BeaconState & U32}
