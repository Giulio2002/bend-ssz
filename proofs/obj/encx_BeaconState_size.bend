      Equal.sym(Nat, U32.to_nat(K.SZC(wR)), CI.ENDCs(wR, U32.to_nat(2737225)), CI.szC(wR, hok, 28n, {==})))

law szs:
  for +m: CI.MW
  for +hok: {CI.OK(m) == True{} : Bool}
