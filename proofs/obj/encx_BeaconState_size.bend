  for +m: CI.MW
  for +hok: {CI.OK(m) == True{} : Bool}
  {FuluBeaconState_e.BeaconState_size(CI.TH(m)) == (CI.TH(m), CI.SZ(m)) : FuluBeaconState_d.BeaconState & U32}
