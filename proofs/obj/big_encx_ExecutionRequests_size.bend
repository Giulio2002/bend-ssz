# ---- the size pass on the container's mirror ----
def SZSM(m: CI.MW) -> U32:
  match m:
    case CI.MW{+A_deposits, +N_deposits, +A_withdrawals, +N_withdrawals, +A_consolidations, +N_consolidations}: SZS(A_deposits, N_deposits, A_withdrawals, N_withdrawals, A_consolidations, N_consolidations)

law sizex:
  for +m: CI.MW
  for +hok: {CI.OK(m) == True{} : Bool}
  {T.ExecutionRequests_size(CI.TH(m)) == (CI.TH(m), SZSM(m)) : T.ExecutionRequests & U32}
def sizex(m, hok):
  match m:
    case CI.MW{+A_deposits, +N_deposits, +A_withdrawals, +N_withdrawals, +A_consolidations, +N_consolidations}: sizeC(A_deposits, N_deposits, A_withdrawals, N_withdrawals, A_consolidations, N_consolidations, hok)

law szs:
  for +m: CI.MW
  for +hok: {CI.OK(m) == True{} : Bool}
  {U32.to_nat(SZSM(m)) == List.length(&2, U32, CI.ENC(m)) : Nat}
def szs(m, hok):
  match m:
    case CI.MW{+A_deposits, +N_deposits, +A_withdrawals, +N_withdrawals, +A_consolidations, +N_consolidations}: Equal.trans(Nat, U32.to_nat(SZS(A_deposits, N_deposits, A_withdrawals, N_withdrawals, A_consolidations, N_consolidations)), CI.ENDC(A_deposits, N_deposits, A_withdrawals, N_withdrawals, A_consolidations, N_consolidations), List.length(&2, U32, K.ENCC(A_deposits, N_deposits, A_withdrawals, N_withdrawals, A_consolidations, N_consolidations)), szS(A_deposits, N_deposits, A_withdrawals, N_withdrawals, A_consolidations, N_consolidations, hok, 28n, {==}),
      Equal.sym(Nat, List.length(&2, U32, K.ENCC(A_deposits, N_deposits, A_withdrawals, N_withdrawals, A_consolidations, N_consolidations)), CI.ENDC(A_deposits, N_deposits, A_withdrawals, N_withdrawals, A_consolidations, N_consolidations), CI.lenE(A_deposits, N_deposits, A_withdrawals, N_withdrawals, A_consolidations, N_consolidations, hok)))

