    case Some{Nil{}}: Empty.absurd({Codec.tagged(sel, Some{Nil{}}) == Some{[S.Variable{bs}]} : Maybe<&2, +List<S.Part>>}, FD.logic__none_some(+List<U32>, bs, e))
