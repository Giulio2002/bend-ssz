    +e: {Codec.bytes(Codec.one(r, None{})) == Some{bs} : Maybe<&2, +List<U32>>})
    -> {Codec.aggregate(Some{ps}, None{}) == Some{[S.Variable{bs}]} : Maybe<&2, +List<S.Part>>}:
