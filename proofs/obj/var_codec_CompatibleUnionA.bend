def wo(+o: Maybe<&2, S.Schema>, +sel: U32, +w: S.Value, +bs: +List<U32>,
    +e: {Codec.bytes(Codec.with_option(o, s => Codec.tagged(sel, Codec.parts(w, s)))) == Some{bs} : Maybe<&2, +List<U32>>})
    -> {Codec.with_option(o, s => Codec.tagged(sel, Codec.parts(w, s))) == Some{[S.Variable{bs}]} : Maybe<&2, +List<S.Part>>}:
  match o:
    case None{}: Empty.absurd({Codec.with_option(None{}, s => Codec.tagged(sel, Codec.parts(w, s))) == Some{[S.Variable{bs}]} : Maybe<&2, +List<S.Part>>}, FD.logic__none_some(+List<U32>, bs, e))
    case Some{+s}: tg(sel, Codec.parts(w, s), bs, e)

def rej_v(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hd: {Nat.is_lt(d, 31n) == True{} : Bool},
    +hn: {Nat.is_le(U32.to_nat(n), A.quad(VB.pw(d))) == True{} : Bool}, +hchk: {CHK(t, n) == False{} : Bool},
    +v: S.Value, +e: {Codec.encoding_for_legal_type(Spec.CompatibleUnionA(), v) == Some{VW(t, n)} : Maybe<&2, +List<U32>>}) -> Empty:
  match v:
    case S.Selected{+sel, +w}:
      FD.logic__true_false(Equal.trans(Bool, True{}, CHK(t, n), False{},
        Equal.sym(Bool, CHK(t, n), True{}, W.invwD(d, t, n, 0n, 0, n, {==}, hd, hn, VB.u32_lt(n), pf, S.Selected{sel, w},
          wo(SS.compatible_option([1], S.Chain{S.ProgressiveContainer{["f_A"], S.Chain{S.Unsigned{P.U8{}}, S.End{}}, [True{}]}, S.End{}}, sel), sel, w, VW(t, n), e))), hchk))
    case S.BooleanValue{+b0}: FD.logic__none_some(+List<U32>, VW(t, n), e)
    case S.UnsignedValue{+u0}: FD.logic__none_some(+List<U32>, VW(t, n), e)
    case S.BytesValue{+xs0}: FD.logic__none_some(+List<U32>, VW(t, n), e)
    case S.BitsValue{+bs0}: FD.logic__none_some(+List<U32>, VW(t, n), e)
    case S.Sequence{+it0}: FD.logic__none_some(+List<U32>, VW(t, n), e)
    case S.Items{+hd0, +tl0}: FD.logic__none_some(+List<U32>, VW(t, n), e)
    case S.EmptyItems{}: FD.logic__none_some(+List<U32>, VW(t, n), e)
    case S.NullValue{}: FD.logic__none_some(+List<U32>, VW(t, n), e)

# When the validator refuses, no value is related to the buffer's bytes.
law decode_reject:
  for +d: Nat
  for +t: FD.array__Tree<U32>
  for +n: U32
  for +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}
  for +hd: {Nat.is_lt(d, 31n) == True{} : Bool}
  for +hn: {Nat.is_le(U32.to_nat(n), A.quad(VB.pw(d))) == True{} : Bool}
  for +hchk: {CHK(t, n) == False{} : Bool}
  Decoding.outside_image(Spec.CompatibleUnionA(), VW(t, n))
def decode_reject(d, t, n, pf, hd, hn, hchk):
  v => e => rej_v(d, t, n, pf, hd, hn, hchk, v, e)
