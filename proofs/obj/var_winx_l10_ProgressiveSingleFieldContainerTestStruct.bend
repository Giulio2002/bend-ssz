# ---- the spec side ------------------------------------------------------------------------------

def RITEMS(c: Nat, +t: FD.array__Tree<U32>, +y: Nat) -> S.Value:
  match c:
    case 0n: S.EmptyItems{}
    case 1n+q: S.Items{RVAL(t, y), RITEMS(q, t, Nat.add(1n, y))}

# the records' parts: a fixed part of each record's bytes
def BP(c: Nat, +t: FD.array__Tree<U32>, +y: Nat) -> +List<S.Part>:
  match c:
    case 0n: []
    case 1n+q: Con{S.Fixed{UW.WX(t, y, 1n)}, BP(q, t, Nat.add(1n, y))}

law cnt_items:
  for +c: Nat
  for +t: FD.array__Tree<U32>
  for +y: Nat
  {Codec.count(RITEMS(c, t, y)) == c : Nat}
def cnt_items(c, t, y):
  match c:
    case 0n: {==}
    case 1n+ +q: FD.nat__succ_cong(Codec.count(RITEMS(q, t, Nat.add(1n, y))), q, cnt_items(q, t, Nat.add(1n, y)))

law bp_all:
  for +c: Nat
  for +t: FD.array__Tree<U32>
  for +y: Nat
  {SP2.allfx(BP(c, t, y)) == True{} : Bool}
def bp_all(c, t, y):
  match c:
    case 0n: {==}
    case 1n+ +q: bp_all(q, t, Nat.add(1n, y))

law bp_cat:
  for +c: Nat
  for +t: FD.array__Tree<U32>
  for +y: Nat
  {SP2.fcat(BP(c, t, y)) == UW.WX(t, y, Nat.mul(c, 1n)) : +List<U32>}
def bp_cat(c, t, y):
  match c:
    case 0n: {==}
    case 1n+ +q:
      +M = Nat.mul(q, 1n)
      %Equal.sym(+List<U32>, SP2.fcat(BP(q, t, Nat.add(1n, y))), UW.WX(t, Nat.add(1n, y), M), bp_cat(q, t, Nat.add(1n, y))) :
        {List.append(&2, U32, UW.WX(t, y, 1n), _) == UW.WX(t, y, Nat.mul(1n+q, 1n)) : +List<U32>}
      Equal.sym(+List<U32>, UW.WX(t, y, Nat.add(1n, M)), List.append(&2, U32, UW.WX(t, y, 1n), UW.WX(t, Nat.add(1n, y), M)), UW.splitWX(t, y, 1n, M))

# The records' parts are their bytes.
law prt_items:
  for +c: Nat
  for +d: Nat
  for +t: FD.array__Tree<U32>
  for +y: Nat
  for +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}
  for +h: {Nat.is_le(Nat.add(y, Nat.mul(c, 1n)), A.quad(VB.pw(d))) == True{} : Bool}
  {Codec.parts(RITEMS(c, t, y), S.Repeat{S.ProgressiveContainer{["f_A"], S.Chain{S.Unsigned{P.U8{}}, S.End{}}, [True{}]}}) == Some{BP(c, t, y)} : Maybe<&2, +List<S.Part>>}
def prt_items(c, d, t, y, pf, h):
  match c:
    case 0n: {==}
    case 1n+ +q:
      +M = Nat.mul(q, 1n)
      +e = Equal.trans(Nat, Nat.add(Nat.add(1n, y), M), Nat.add(1n, Nat.add(y, M)), Nat.add(y, Nat.add(1n, M)),
        FD.nat__add_assoc(1n, y, M), FD.lru_nat_algebra__add_swap(1n, y, M))
      +h2 = FD.logic__subst(Nat, z => {Nat.is_le(z, A.quad(VB.pw(d))) == True{} : Bool}, Nat.add(y, Nat.add(1n, M)), Nat.add(Nat.add(1n, y), M), Equal.sym(Nat, Nat.add(Nat.add(1n, y), M), Nat.add(y, Nat.add(1n, M)), e), h)
      +h1 = FD.nat__le_trans(Nat.add(y, 1n), Nat.add(y, Nat.add(1n, M)), A.quad(VB.pw(d)), Order.add_left(y, 1n, Nat.add(1n, M), Order.below_sum(1n, M)), h)
      F.cat_fixed(Codec.parts(RVAL(t, y), S.ProgressiveContainer{["f_A"], S.Chain{S.Unsigned{P.U8{}}, S.End{}}, [True{}]}), UW.WX(t, y, 1n), Codec.parts(RITEMS(q, t, Nat.add(1n, y)), S.Repeat{S.ProgressiveContainer{["f_A"], S.Chain{S.Unsigned{P.U8{}}, S.End{}}, [True{}]}}), BP(q, t, Nat.add(1n, y)),
        RPRF(d, t, y, pf, h1), prt_items(q, d, t, Nat.add(1n, y), pf, h2))

def VALw(+t: FD.array__Tree<U32>, +x: Nat, +len: U32) -> S.Value: S.Sequence{RITEMS(CC(len), t, x)}

def specwD(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +hw32: {Nat.is_lt(Nat.add(x, U32.to_nat(len)), FD.spec_common__pow2(32n)) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hchk: {CHKw(t, x, off, len) == True{} : Bool})
    -> {Codec.parts(VALw(t, x, len), S.ListOf{S.ProgressiveContainer{["f_A"], S.Chain{S.Unsigned{P.U8{}}, S.End{}}, [True{}]}, 10n}) == Some{[S.Variable{UW.WX(t, x, U32.to_nat(len))}]} : Maybe<&2, +List<S.Part>>}:
  +c = CC(len)
  +ec = ecw(len, hchk)
  +Y = UW.WX(t, x, Nat.mul(c, 1n))
  +hf = FD.logic__subst(Nat, z => {Nat.is_le(Nat.add(x, z), A.quad(VB.pw(d))) == True{} : Bool}, U32.to_nat(len), Nat.mul(c, 1n), ec, hw)
  +hf32 = FD.logic__subst(Nat, z => {Nat.is_lt(Nat.add(x, z), FD.spec_common__pow2(32n)) == True{} : Bool}, U32.to_nat(len), Nat.mul(c, 1n), ec, hw32)
  +lY = UW.lenWX(d, t, x, Nat.mul(c, 1n), pf, hf)
  +fit = FD.logic__subst(Nat, z => {N.fits(4n, z) == True{} : Bool}, Nat.mul(c, 1n), Nat.add(Nat.mul(c, 1n), 0n), Equal.sym(Nat, Nat.add(Nat.mul(c, 1n), 0n), Nat.mul(c, 1n), FD.nat__add_zero(Nat.mul(c, 1n))),
    VFT.fits4lt(Nat.mul(c, 1n), FD.nat__le_lt_trans(Nat.mul(c, 1n), Nat.add(x, Nat.mul(c, 1n)), FD.spec_common__pow2(32n), Order.left_below_sum(x, Nat.mul(c, 1n)), hf32)))
  +ha = bp_all(c, t, x)
  +cat = bp_cat(c, t, x)
  +hs = Equal.trans(Nat, Layout.fixed_size(BP(c, t, x)), List.length(&2, U32, SP2.fcat(BP(c, t, x))), Nat.mul(c, 1n), SP2.fsz(BP(c, t, x), ha),
    Equal.trans(Nat, List.length(&2, U32, SP2.fcat(BP(c, t, x))), List.length(&2, U32, Y), Nat.mul(c, 1n), Equal.cong(+List<U32>, Nat, z => List.length(&2, U32, z), SP2.fcat(BP(c, t, x)), Y, cat), lY))
  +hfp = Equal.trans(+List<U32>, Layout.fixed_parts(BP(c, t, x), Nat.mul(c, 1n)), SP2.fcat(BP(c, t, x)), Y, SP2.fxp(BP(c, t, x), Nat.mul(c, 1n), ha), cat)
  +hv = SP2.bvl(BP(c, t, x), ha, FD.logic__subst(+List<U32>, z => {SP.bytes_domain(z) == True{} : Bool}, Y, SP2.fcat(BP(c, t, x)), Equal.sym(+List<U32>, SP2.fcat(BP(c, t, x)), Y, cat), UW.domWX(t, x, Nat.mul(c, 1n))))
  %Equal.sym(Nat, U32.to_nat(len), Nat.mul(c, 1n), ec) : {Codec.parts(VALw(t, x, len), S.ListOf{S.ProgressiveContainer{["f_A"], S.Chain{S.Unsigned{P.U8{}}, S.End{}}, [True{}]}, 10n}) == Some{[S.Variable{UW.WX(t, x, _)}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(Nat, Codec.count(RITEMS(c, t, x)), c, cnt_items(c, t, x)) :
    {Codec.require(Nat.is_le(_, 10n), Codec.aggregate(Codec.parts(RITEMS(c, t, x), S.Repeat{S.ProgressiveContainer{["f_A"], S.Chain{S.Unsigned{P.U8{}}, S.End{}}, [True{}]}}), None{})) == Some{[S.Variable{Y}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(Bool, Nat.is_le(c, 10n), True{}, hcw(len, hchk)) :
    {Codec.require(_, Codec.aggregate(Codec.parts(RITEMS(c, t, x), S.Repeat{S.ProgressiveContainer{["f_A"], S.Chain{S.Unsigned{P.U8{}}, S.End{}}, [True{}]}}), None{})) == Some{[S.Variable{Y}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(Maybe<&2, +List<S.Part>>, Codec.parts(RITEMS(c, t, x), S.Repeat{S.ProgressiveContainer{["f_A"], S.Chain{S.Unsigned{P.U8{}}, S.End{}}, [True{}]}}), Some{BP(c, t, x)}, prt_items(c, d, t, x, pf, hf)) :
    {Codec.require(True{}, Codec.aggregate(_, None{})) == Some{[S.Variable{Y}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(Maybe<&2, +List<U32>>, Layout.encoding(BP(c, t, x)), Some{List.append(&2, U32, Y, [])},
      VMV.enc_gen(BP(c, t, x), Nat.mul(c, 1n), Y, [], hs, hfp, SP2.pay0(BP(c, t, x), ha), hv, fit)) :
    {Codec.one(_, None{}) == Some{[S.Variable{Y}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(+List<U32>, List.append(&2, U32, Y, []), Y, VS.app_nil(Y)) : {Codec.one(Some{_}, None{}) == Some{[S.Variable{Y}]} : Maybe<&2, +List<S.Part>>}
  {==}

# ---- the inversion ------------------------------------------------------------------------------

def rp_t(+xs: +List<U32>, +el: S.Value, +tl: S.Value, +ps: +List<S.Part>, +mB: Maybe<&2, +List<S.Part>>,
    +eB: {Codec.parts(tl, S.Repeat{S.ProgressiveContainer{["f_A"], S.Chain{S.Unsigned{P.U8{}}, S.End{}}, [True{}]}}) == mB : Maybe<&2, +List<S.Part>>},
    +lx: {List.length(&2, U32, xs) == 1n : Nat},
    +e: {Codec.concatenate(Some{[S.Fixed{xs}]}, mB) == Some{ps} : Maybe<&2, +List<S.Part>>},
    ih: @+pb: +List<S.Part> -> {Codec.parts(tl, S.Repeat{S.ProgressiveContainer{["f_A"], S.Chain{S.Unsigned{P.U8{}}, S.End{}}, [True{}]}}) == Some{pb} : Maybe<&2, +List<S.Part>>} -> VMR.REPB(tl, pb, 1n))
    -> VMR.REPB(S.Items{el, tl}, ps, 1n):
  match mB:
    case None{}: Empty.absurd(VMR.REPB(S.Items{el, tl}, ps, 1n), FD.logic__none_some(+List<S.Part>, ps, e))
    case Some{+pb}:
      +eps = FD.logic__some_inj(+List<S.Part>, S.Fixed{xs} <> pb, ps, e)
      %Equal.sym(+List<S.Part>, ps, S.Fixed{xs} <> pb, Equal.sym(+List<S.Part>, S.Fixed{xs} <> pb, ps, eps)) : VMR.REPB(S.Items{el, tl}, _, 1n)
      VMR.rpb_t2(xs, el, tl, pb, 1n, lx, ih(pb, eB))

def rp_p(+el: S.Value, +tl: S.Value, +ps: +List<S.Part>, +ph: +List<S.Part>, hf: DF.single(Some{1n}, ph),
    +e: {Codec.concatenate(Some{ph}, Codec.parts(tl, S.Repeat{S.ProgressiveContainer{["f_A"], S.Chain{S.Unsigned{P.U8{}}, S.End{}}, [True{}]}})) == Some{ps} : Maybe<&2, +List<S.Part>>},
    ih: @+pb: +List<S.Part> -> {Codec.parts(tl, S.Repeat{S.ProgressiveContainer{["f_A"], S.Chain{S.Unsigned{P.U8{}}, S.End{}}, [True{}]}}) == Some{pb} : Maybe<&2, +List<S.Part>>} -> VMR.REPB(tl, pb, 1n))
    -> VMR.REPB(S.Items{el, tl}, ps, 1n):
  match ph:
    case Nil{}: Empty.absurd(VMR.REPB(S.Items{el, tl}, ps, 1n), hf)
    case Con{S.Fixed{+xs}, Nil{}}:
      rp_t(xs, el, tl, ps, Codec.parts(tl, S.Repeat{S.ProgressiveContainer{["f_A"], S.Chain{S.Unsigned{P.U8{}}, S.End{}}, [True{}]}}), {==}, Equal.sym(Nat, 1n, List.length(&2, U32, xs), FD.logic__some_inj(Nat, 1n, List.length(&2, U32, xs), hf)), e, ih)
    case Con{S.Variable{+xs}, Nil{}}: Empty.absurd(VMR.REPB(S.Items{el, tl}, ps, 1n), FD.logic__none_some(Nat, 1n, Equal.sym(Maybe<&2, Nat>, Some{1n}, None{}, hf)))
    case Con{S.Fixed{+xs}, Con{+a, +b}}: Empty.absurd(VMR.REPB(S.Items{el, tl}, ps, 1n), hf)
    case Con{S.Variable{+xs}, Con{+a, +b}}: Empty.absurd(VMR.REPB(S.Items{el, tl}, ps, 1n), hf)

def rp_m(+el: S.Value, +tl: S.Value, +ps: +List<S.Part>, +mh: Maybe<&2, +List<S.Part>>, hf: DF.single_result(Some{1n}, mh),
    +e: {Codec.concatenate(mh, Codec.parts(tl, S.Repeat{S.ProgressiveContainer{["f_A"], S.Chain{S.Unsigned{P.U8{}}, S.End{}}, [True{}]}})) == Some{ps} : Maybe<&2, +List<S.Part>>},
    ih: @+pb: +List<S.Part> -> {Codec.parts(tl, S.Repeat{S.ProgressiveContainer{["f_A"], S.Chain{S.Unsigned{P.U8{}}, S.End{}}, [True{}]}}) == Some{pb} : Maybe<&2, +List<S.Part>>} -> VMR.REPB(tl, pb, 1n))
    -> VMR.REPB(S.Items{el, tl}, ps, 1n):
  match mh:
    case None{}: Empty.absurd(VMR.REPB(S.Items{el, tl}, ps, 1n), FD.logic__none_some(+List<S.Part>, ps, e))
    case Some{+ph}: rp_p(el, tl, ps, ph, hf, e, ih)

# The parts of records are fixed parts of 1 bytes each.
law rep_r:
  for +its: S.Value
  for +ps: +List<S.Part>
  for +e: {Codec.parts(its, S.Repeat{S.ProgressiveContainer{["f_A"], S.Chain{S.Unsigned{P.U8{}}, S.End{}}, [True{}]}}) == Some{ps} : Maybe<&2, +List<S.Part>>}
  VMR.REPB(its, ps, 1n)
def rep_r(its, ps, e):
  match its:
    case S.EmptyItems{}:
      +eps = FD.logic__some_inj(+List<S.Part>, [], ps, e)
      %Equal.sym(+List<S.Part>, ps, [], Equal.sym(+List<S.Part>, [], ps, eps)) : VMR.REPB(S.EmptyItems{}, _, 1n)
      ({==}, {==})
    case S.Items{+h, +tl}: rp_m(h, tl, ps, Codec.parts(h, S.ProgressiveContainer{["f_A"], S.Chain{S.Unsigned{P.U8{}}, S.End{}}, [True{}]}), DS.facts(h, S.ProgressiveContainer{["f_A"], S.Chain{S.Unsigned{P.U8{}}, S.End{}}, [True{}]}, {==}), e, pb => eb => rep_r(tl, pb, eb))
    case S.BooleanValue{+b}: Empty.absurd(VMR.REPB(S.BooleanValue{b}, ps, 1n), FD.logic__none_some(+List<S.Part>, ps, e))
    case S.UnsignedValue{+u}: Empty.absurd(VMR.REPB(S.UnsignedValue{u}, ps, 1n), FD.logic__none_some(+List<S.Part>, ps, e))
    case S.BytesValue{+xs}: Empty.absurd(VMR.REPB(S.BytesValue{xs}, ps, 1n), FD.logic__none_some(+List<S.Part>, ps, e))
    case S.BitsValue{+bs}: Empty.absurd(VMR.REPB(S.BitsValue{bs}, ps, 1n), FD.logic__none_some(+List<S.Part>, ps, e))
    case S.Sequence{+it}: Empty.absurd(VMR.REPB(S.Sequence{it}, ps, 1n), FD.logic__none_some(+List<S.Part>, ps, e))
    case S.Selected{+sel, +sv}: Empty.absurd(VMR.REPB(S.Selected{sel, sv}, ps, 1n), FD.logic__none_some(+List<S.Part>, ps, e))
    case S.NullValue{}: Empty.absurd(VMR.REPB(S.NullValue{}, ps, 1n), FD.logic__none_some(+List<S.Part>, ps, e))

def lm4(+its: S.Value, +ys: +List<U32>, +hk: {Nat.is_le(Codec.count(its), U32.to_nat(10)) == True{} : Bool}, +ps: +List<S.Part>,
    +em3: {Codec.parts(its, S.Repeat{S.ProgressiveContainer{["f_A"], S.Chain{S.Unsigned{P.U8{}}, S.End{}}, [True{}]}}) == Some{ps} : Maybe<&2, +List<S.Part>>}, +m4: Maybe<&2, +List<U32>>,
    +em4: {Layout.encoding(ps) == m4 : Maybe<&2, +List<U32>>}, +e: {Codec.bytes(Codec.one(m4, None{})) == Some{ys} : Maybe<&2, +List<U32>>})
    -> VMR.LF(ys, 1n, U32.to_nat(10)):
  match m4:
    case None{}: Empty.absurd(VMR.LF(ys, 1n, U32.to_nat(10)), FD.logic__none_some(+List<U32>, ys, e))
    case Some{+zs}:
      +ez = FD.logic__some_inj(+List<U32>, zs, ys, e)
      +lz = Equal.trans(Nat, List.length(&2, U32, zs), Layout.fixed_size(ps), Nat.mul(Codec.count(its), 1n),
        VS.enc_len(ps, zs, Pair.fst({VS.allfix(ps) == True{} : Bool}, {Layout.fixed_size(ps) == Nat.mul(Codec.count(its), 1n) : Nat}, rep_r(its, ps, em3)), em4),
        Pair.snd({VS.allfix(ps) == True{} : Bool}, {Layout.fixed_size(ps) == Nat.mul(Codec.count(its), 1n) : Nat}, rep_r(its, ps, em3)))
      (Codec.count(its), (FD.logic__subst(+List<U32>, z => {List.length(&2, U32, z) == Nat.mul(Codec.count(its), 1n) : Nat}, zs, ys, ez, lz), hk))

def lm3(+its: S.Value, +ys: +List<U32>, +hk: {Nat.is_le(Codec.count(its), U32.to_nat(10)) == True{} : Bool}, +m3: Maybe<&2, +List<S.Part>>,
    +em3: {Codec.parts(its, S.Repeat{S.ProgressiveContainer{["f_A"], S.Chain{S.Unsigned{P.U8{}}, S.End{}}, [True{}]}}) == m3 : Maybe<&2, +List<S.Part>>}, +e: {Codec.bytes(Codec.aggregate(m3, None{})) == Some{ys} : Maybe<&2, +List<U32>>})
    -> VMR.LF(ys, 1n, U32.to_nat(10)):
  match m3:
    case None{}: Empty.absurd(VMR.LF(ys, 1n, U32.to_nat(10)), FD.logic__none_some(+List<U32>, ys, e))
    case Some{+ps}: lm4(its, ys, hk, ps, em3, Layout.encoding(ps), {==}, e)

def lb(+its: S.Value, +ys: +List<U32>, +b: Bool, +eb: {Nat.is_le(Codec.count(its), U32.to_nat(10)) == b : Bool},
    +e: {Codec.bytes(Codec.require(b, Codec.aggregate(Codec.parts(its, S.Repeat{S.ProgressiveContainer{["f_A"], S.Chain{S.Unsigned{P.U8{}}, S.End{}}, [True{}]}}), None{}))) == Some{ys} : Maybe<&2, +List<U32>>})
    -> VMR.LF(ys, 1n, U32.to_nat(10)):
  match b:
    case False{}: Empty.absurd(VMR.LF(ys, 1n, U32.to_nat(10)), FD.logic__none_some(+List<U32>, ys, e))
    case True{}: lm3(its, ys, eb, Codec.parts(its, S.Repeat{S.ProgressiveContainer{["f_A"], S.Chain{S.Unsigned{P.U8{}}, S.End{}}, [True{}]}}), {==}, e)

# The spec bytes ys of any value of the list are whole records, at most 10.
law linvr:
  for +h: S.Value
  for +ys: +List<U32>
  for +e: {Codec.bytes(Codec.parts(h, S.ListOf{S.ProgressiveContainer{["f_A"], S.Chain{S.Unsigned{P.U8{}}, S.End{}}, [True{}]}, 10n})) == Some{ys} : Maybe<&2, +List<U32>>}
  VMR.LF(ys, 1n, U32.to_nat(10))
def linvr(h, ys, e):
  match h:
    case S.Sequence{+its}: lb(its, ys, Nat.is_le(Codec.count(its), U32.to_nat(10)), {==}, e)
    case S.BooleanValue{+b0}: Empty.absurd(VMR.LF(ys, 1n, U32.to_nat(10)), FD.logic__none_some(+List<U32>, ys, e))
    case S.UnsignedValue{+u0}: Empty.absurd(VMR.LF(ys, 1n, U32.to_nat(10)), FD.logic__none_some(+List<U32>, ys, e))
    case S.BytesValue{+xs0}: Empty.absurd(VMR.LF(ys, 1n, U32.to_nat(10)), FD.logic__none_some(+List<U32>, ys, e))
    case S.BitsValue{+bs0}: Empty.absurd(VMR.LF(ys, 1n, U32.to_nat(10)), FD.logic__none_some(+List<U32>, ys, e))
    case S.Items{+hd0, +tl0}: Empty.absurd(VMR.LF(ys, 1n, U32.to_nat(10)), FD.logic__none_some(+List<U32>, ys, e))
    case S.EmptyItems{}: Empty.absurd(VMR.LF(ys, 1n, U32.to_nat(10)), FD.logic__none_some(+List<U32>, ys, e))
    case S.Selected{+sel0, +sv0}: Empty.absurd(VMR.LF(ys, 1n, U32.to_nat(10)), FD.logic__none_some(+List<U32>, ys, e))
    case S.NullValue{}: Empty.absurd(VMR.LF(ys, 1n, U32.to_nat(10)), FD.logic__none_some(+List<U32>, ys, e))

def chk_i(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +hw32: {Nat.is_lt(Nat.add(x, U32.to_nat(len)), FD.spec_common__pow2(32n)) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, f: VMR.LF(UW.WX(t, x, U32.to_nat(len)), 1n, U32.to_nat(10))) -> {CHKw(t, x, off, len) == True{} : Bool}:
  (+k, +pr) = f
  (+hl, +hk) = pr
  VU.whole_i(len, 1, 10, vR(), {==}, {==}, {==}, k,
    Equal.trans(Nat, U32.to_nat(len), List.length(&2, U32, UW.WX(t, x, U32.to_nat(len))), Nat.mul(k, 1n),
      Equal.sym(Nat, List.length(&2, U32, UW.WX(t, x, U32.to_nat(len))), U32.to_nat(len), UW.lenWX(d, t, x, U32.to_nat(len), pf, hw)), hl), hk)

# Every value whose parts are the window's bytes passes the check.
def invwD(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +hw32: {Nat.is_lt(Nat.add(x, U32.to_nat(len)), FD.spec_common__pow2(32n)) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +v: S.Value,
    +e: {Codec.parts(v, S.ListOf{S.ProgressiveContainer{["f_A"], S.Chain{S.Unsigned{P.U8{}}, S.End{}}, [True{}]}, 10n}) == Some{[S.Variable{UW.WX(t, x, U32.to_nat(len))}]} : Maybe<&2, +List<S.Part>>})
    -> {CHKw(t, x, off, len) == True{} : Bool}:
  chk_i(d, t, n, x, off, len, eo, hd, hw, hw32, pf, linvr(v, UW.WX(t, x, U32.to_nat(len)),
    Equal.cong(Maybe<&2, +List<S.Part>>, Maybe<&2, +List<U32>>, z => Codec.bytes(z), Codec.parts(v, S.ListOf{S.ProgressiveContainer{["f_A"], S.Chain{S.Unsigned{P.U8{}}, S.End{}}, [True{}]}, 10n}), Some{[S.Variable{UW.WX(t, x, U32.to_nat(len))}]}, e)))

