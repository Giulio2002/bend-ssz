def XCT1(+t: FD.array__Tree<U32>, +x: Nat, +V0: S.Value, +V1: S.Value, +Y0: +List<U32>, +Y1: +List<U32>, +hv0: {Codec.parts(V0, Spec.LightClientHeader()) == Some{[S.Variable{Y0}]} : Maybe<&2, +List<S.Part>>}, +hv1: {Codec.parts(V1, Spec.LightClientHeader()) == Some{[S.Variable{Y1}]} : Maybe<&2, +List<S.Part>>}) -> {Codec.parts(XCV1(t, x, V0, V1), XCS1()) == Some{XCP1(t, x, Y0, Y1)} : Maybe<&2, +List<S.Part>>}:
  %Equal.sym(S.Value, XCV1(t, x, V0, V1), S.Items{V1, XCV2(t, x, V0, V1)}, {==}) : {Codec.parts(_, XCS1()) == Some{XCP1(t, x, Y0, Y1)} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(S.Schema, XCS1(), S.Chain{Spec.LightClientHeader(), XCS2()}, {==}) : {Codec.parts(S.Items{V1, XCV2(t, x, V0, V1)}, _) == Some{XCP1(t, x, Y0, Y1)} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(+List<S.Part>, XCP1(t, x, Y0, Y1), Con{S.Variable{Y1}, XCP2(t, x, Y0, Y1)}, {==}) : {Codec.parts(S.Items{V1, XCV2(t, x, V0, V1)}, S.Chain{Spec.LightClientHeader(), XCS2()}) == Some{_} : Maybe<&2, +List<S.Part>>}
  VS.chain_var(V1, XCV2(t, x, V0, V1), Spec.LightClientHeader(), XCS2(), Y1, XCP2(t, x, Y0, Y1), hv1, XCT2(t, x, V0, V1, Y0, Y1, hv0, hv1))
def XCT0(+t: FD.array__Tree<U32>, +x: Nat, +V0: S.Value, +V1: S.Value, +Y0: +List<U32>, +Y1: +List<U32>, +hv0: {Codec.parts(V0, Spec.LightClientHeader()) == Some{[S.Variable{Y0}]} : Maybe<&2, +List<S.Part>>}, +hv1: {Codec.parts(V1, Spec.LightClientHeader()) == Some{[S.Variable{Y1}]} : Maybe<&2, +List<S.Part>>}) -> {Codec.parts(XCV0(t, x, V0, V1), XCS0()) == Some{XCP0(t, x, Y0, Y1)} : Maybe<&2, +List<S.Part>>}:
  %Equal.sym(S.Value, XCV0(t, x, V0, V1), S.Items{V0, XCV1(t, x, V0, V1)}, {==}) : {Codec.parts(_, XCS0()) == Some{XCP0(t, x, Y0, Y1)} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(S.Schema, XCS0(), S.Chain{Spec.LightClientHeader(), XCS1()}, {==}) : {Codec.parts(S.Items{V0, XCV1(t, x, V0, V1)}, _) == Some{XCP0(t, x, Y0, Y1)} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(+List<S.Part>, XCP0(t, x, Y0, Y1), Con{S.Variable{Y0}, XCP1(t, x, Y0, Y1)}, {==}) : {Codec.parts(S.Items{V0, XCV1(t, x, V0, V1)}, S.Chain{Spec.LightClientHeader(), XCS1()}) == Some{_} : Maybe<&2, +List<S.Part>>}
  VS.chain_var(V0, XCV1(t, x, V0, V1), Spec.LightClientHeader(), XCS1(), Y0, XCP1(t, x, Y0, Y1), hv0, XCT1(t, x, V0, V1, Y0, Y1, hv0, hv1))
def XVw(+t: FD.array__Tree<U32>, +x: Nat, +V0: S.Value, +V1: S.Value) -> S.Value: S.Sequence{XCV0(t, x, V0, V1)}

