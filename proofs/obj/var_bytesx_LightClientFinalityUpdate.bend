  +ey0 = Equal.trans(+List<U32>, ys0, UW.WX(t, Nat.add(400n, x), List.length(&2, U32, ys0)), UW.WX(t, 256n+144n+x, U32.to_nat(L1(t, x))), VX2.wx_fst(t, Nat.add(400n, x), ys0, ys1, ew),
