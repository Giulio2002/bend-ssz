def inv_b(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat}, +hd: {Nat.is_lt(d, 28n) == True{} : Bool},
    +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hb0: {VS.bt(4n, VS.bdr(0n, UW.WX(t, x, U32.to_nat(len)))) == [144, 1, 0, 0] : +List<U32>},
    +hv0: S.Value, +ys0: +List<U32>, +hv1: S.Value, +ys1: +List<U32>, r: DK.P2({VS.bt(4n, VS.bdr(4n, UW.WX(t, x, U32.to_nat(len)))) == N.digits(4n, Nat.add(400n, List.length(&2, U32, ys0))) : +List<U32>}, DK.P2({List.length(&2, U32, UW.WX(t, x, U32.to_nat(len))) == Nat.add(400n, Nat.add(List.length(&2, U32, ys0), List.length(&2, U32, ys1))) : Nat}, DK.P2({VS.bdr(400n, UW.WX(t, x, U32.to_nat(len))) == List.append(&2, U32, ys0, ys1) : +List<U32>}, DK.P2({Codec.parts(hv0, Spec.LightClientHeader()) == Some{[S.Variable{ys0}]} : Maybe<&2, +List<S.Part>>}, {Codec.parts(hv1, Spec.LightClientHeader()) == Some{[S.Variable{ys1}]} : Maybe<&2, +List<S.Part>>})))))
    -> {CHKw(t, x, off, len) == True{} : Bool}:
  (+f1, r2) = r
  inv_c(d, t, n, x, off, len, eo, hd, hw, pf, hb0, hv0, ys0, hv1, ys1, f1, r2)

def inv_facts(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat}, +hd: {Nat.is_lt(d, 28n) == True{} : Bool},
    +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, facts: XI.FACTS2(UW.WX(t, x, U32.to_nat(len)))) -> {CHKw(t, x, off, len) == True{} : Bool}:
  (+hb0, ex) = facts
  (+hv0, r1) = ex
  (+ys0, r2) = r1
  (+hv1, r3) = r2
  (+ys1, r4) = r3
  inv_b(d, t, n, x, off, len, eo, hd, hw, pf, hb0, hv0, ys0, hv1, ys1, r4)

# Every value whose spec parts are the window's bytes passes the checks.
def invw(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat}, +hd: {Nat.is_lt(d, 28n) == True{} : Bool},
    +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +v: S.Value, +e: {Codec.parts(v, Spec.LightClientFinalityUpdate()) == Some{[S.Variable{UW.WX(t, x, U32.to_nat(len))}]} : Maybe<&2, +List<S.Part>>})
    -> {CHKw(t, x, off, len) == True{} : Bool}:
  inv_facts(d, t, n, x, off, len, eo, hd, hw, pf, XI.inv_p(v, UW.WX(t, x, U32.to_nat(len)), e))

