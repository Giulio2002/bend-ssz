  +en = Equal.trans(Nat, U32.to_nat(len), List.length(&2, U32, UW.WX(t, x, U32.to_nat(len))), Nat.add(400n, K), Equal.sym(Nat, List.length(&2, U32, UW.WX(t, x, U32.to_nat(len))), U32.to_nat(len), UW.lenWX(d, t, x, U32.to_nat(len), pf, hw)), f2)
  +hl = FD.nat__le_trans(U32.to_nat(len), Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d)), Order.left_below_sum(x, U32.to_nat(len)), hw)
  +ha = u32le(400, len, FD.logic__subst(Nat, z => {Nat.is_le(400n, z) == True{} : Bool}, Nat.add(400n, K), U32.to_nat(len), Equal.sym(Nat, U32.to_nat(len), Nat.add(400n, K), en), Order.below_sum(400n, K)))
  +epo = XI.wordFS(SPO0(t, x), Equal.trans(+List<U32>, F.limbs([SPO0(t, x)]), VS.bt(4n, VS.bdr(0n, UW.WX(t, x, U32.to_nat(len)))), [144, 1, 0, 0],
    Equal.sym(+List<U32>, VS.bt(4n, VS.bdr(0n, UW.WX(t, x, U32.to_nat(len)))), F.limbs([SPO0(t, x)]), byteAt(d, t, x, len, 0n, Nat.add(396n, K), en, pf, hw)), hb0))
  +le1 = FD.nat__le_trans(Nat.add(400n, List.length(&2, U32, ys0)), Nat.add(400n, K), A.quad(VB.pw(d)), Order.add_left(400n, List.length(&2, U32, ys0), K, Order.below_sum(List.length(&2, U32, ys0), List.length(&2, U32, ys1))),
    FD.logic__subst(Nat, z => {Nat.is_le(z, A.quad(VB.pw(d))) == True{} : Bool}, U32.to_nat(len), Nat.add(400n, K), en, hl))
  +e1 = VG.digits_word(SPO1(t, x), Nat.add(400n, List.length(&2, U32, ys0)), VBZ.fitq(d, Nat.add(400n, List.length(&2, U32, ys0)), le1, FD.nat__lt_trans(d, 28n, 30n, hd, {==})),
