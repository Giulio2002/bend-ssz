    -> {CHKw(t, x, off, len) == True{} : Bool}:
  (+em0, em1) = r
  inv_tail(d, t, n, x, off, len, eo, hd, hw, pf, hb0, hv0, ys0, hv1, ys1, f1, f2, f3, em0, em1)

