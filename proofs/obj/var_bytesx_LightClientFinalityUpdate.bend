    +hv0: S.Value, +ys0: +List<U32>, +hv1: S.Value, +ys1: +List<U32>, +f1: {VS.bt(4n, VS.bdr(4n, UW.WX(t, x, U32.to_nat(len)))) == N.digits(4n, Nat.add(400n, List.length(&2, U32, ys0))) : +List<U32>}, +f2: {List.length(&2, U32, UW.WX(t, x, U32.to_nat(len))) == Nat.add(400n, Nat.add(List.length(&2, U32, ys0), List.length(&2, U32, ys1))) : Nat}, +f3: {VS.bdr(400n, UW.WX(t, x, U32.to_nat(len))) == List.append(&2, U32, ys0, ys1) : +List<U32>}, +em0: {Codec.parts(hv0, Spec.LightClientHeader()) == Some{[S.Variable{ys0}]} : Maybe<&2, +List<S.Part>>}, +em1: {Codec.parts(hv1, Spec.LightClientHeader()) == Some{[S.Variable{ys1}]} : Maybe<&2, +List<S.Part>>})
    -> {CHKw(t, x, off, len) == True{} : Bool}:
