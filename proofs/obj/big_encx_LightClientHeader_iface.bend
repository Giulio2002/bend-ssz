# ==== LightClientHeader in the encoder-window interface ====

type MW is Data:
  MW{beacon: FuluBeaconBlockHeader_d.BeaconBlockHeader, m_execution: EC_ExecutionPayloadHeader.MW, dB_execution_branch: Nat, TB_execution_branch: FD.array__Tree<U32>}

def TH(m: MW) -> FuluLightClientHeader_d.LightClientHeader:
  match m:
    case MW{+beacon, +m_execution, +dB_execution_branch, +TB_execution_branch}: K.OBJC(beacon, m_execution, dB_execution_branch, TB_execution_branch)
def OK(m: MW) -> Bool:
  match m:
    case MW{+beacon, +m_execution, +dB_execution_branch, +TB_execution_branch}: OKT(beacon, m_execution, dB_execution_branch, TB_execution_branch)
def ENC(m: MW) -> +List<U32>:
  match m:
    case MW{+beacon, +m_execution, +dB_execution_branch, +TB_execution_branch}: K.ENCC(beacon, m_execution, dB_execution_branch, TB_execution_branch)
def VAL(m: MW) -> S.Value:
  match m:
    case MW{+beacon, +m_execution, +dB_execution_branch, +TB_execution_branch}: VALC(beacon, m_execution, dB_execution_branch, TB_execution_branch)
def SZ(m: MW) -> U32:
  match m:
    case MW{+beacon, +m_execution, +dB_execution_branch, +TB_execution_branch}: K.SZC(beacon, m_execution, dB_execution_branch, TB_execution_branch)
def XQ(+q: Nat, +r: Nat) -> U32: U32.from_nat(Nat.add(A.quad(q), r))
def PUTX(m: MW, +dd: Nat, +D: FD.array__Tree<U32>, +q: Nat, +r: Nat) -> FD.array__Tree<U32>:
  match m:
    case MW{+beacon, +m_execution, +dB_execution_branch, +TB_execution_branch}: K.PUTC(beacon, m_execution, dB_execution_branch, TB_execution_branch, dd, D, XQ(q, r), q, r)
def PADB(+r: Nat, m: MW) -> Nat: WD.PADB(r, List.length(&2, U32, ENC(m)))

def RTX(+beacon: FuluBeaconBlockHeader_d.BeaconBlockHeader, +m_execution: EC_ExecutionPayloadHeader.MW, +dB_execution_branch: Nat, +TB_execution_branch: FD.array__Tree<U32>, +dd: Nat, +D: FD.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat) -> Data:
  {FuluLightClientHeader_e.LightClientHeader_putk(FD.array__thaw(U32, D), X, K.OBJC(beacon, m_execution, dB_execution_branch, TB_execution_branch)) == (FD.array__thaw(U32, K.PUTC(beacon, m_execution, dB_execution_branch, TB_execution_branch, dd, D, XQ(q, r), q, r)), (K.OBJC(beacon, m_execution, dB_execution_branch, TB_execution_branch), K.SZC(beacon, m_execution, dB_execution_branch, TB_execution_branch))) : Array<U32> & (FuluLightClientHeader_d.LightClientHeader & U32)}
def BYX(+beacon: FuluBeaconBlockHeader_d.BeaconBlockHeader, +m_execution: EC_ExecutionPayloadHeader.MW, +dB_execution_branch: Nat, +TB_execution_branch: FD.array__Tree<U32>, +dd: Nat, +D: FD.array__Tree<U32>, +q: Nat, +r: Nat) -> Data:
  {UA.BYT(K.PUTC(beacon, m_execution, dB_execution_branch, TB_execution_branch, dd, D, XQ(q, r), q, r)) == UW.SPL(UA.BYT(D), Nat.add(A.quad(q), r), VCN.AP(K.ENCC(beacon, m_execution, dB_execution_branch, TB_execution_branch), UW.ZB(WD.PADB(r, List.length(&2, U32, K.ENCC(beacon, m_execution, dB_execution_branch, TB_execution_branch)))))) : +List<U32>}

