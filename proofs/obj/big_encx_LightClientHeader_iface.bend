  for +hok: {OK(m) == True{} : Bool}
  {FuluLightClientHeader_e.LightClientHeader_putk(FD.array__thaw(U32, D), X, TH(m)) == (FD.array__thaw(U32, PUTX(m, dd, D, q, r)), (TH(m), SZ(m))) : Array<U32> & (FuluLightClientHeader_d.LightClientHeader & U32)}
