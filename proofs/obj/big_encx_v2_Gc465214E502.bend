    case Con{+y, +r}: app_dom(N.digits(4n, off), VVL.OFFS(r, Nat.add(off, VE2.LEN(y))), Digits.digits_domain(4n, off), offs_dom(r, Nat.add(off, VE2.LEN(y))))


