    +hsd: {Nat.is_lt(s, VB.pw(d)) == True{} : Bool}, +hr: {Nat.is_lt(r, 4n) == True{} : Bool}, +hd: {Nat.is_lt(dd, 29n) == True{} : Bool},
    +pfD: {F.array__perfect(U32, dd, D) == True{} : Bool}, +hx: {EOK(xat_v2_Gc465214E502(SL(t), s)) == True{} : Bool},
