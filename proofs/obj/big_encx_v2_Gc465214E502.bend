def LLN(+n: Nat, +W: List<&2, MB<EM.MW>>) -> Nat: Nat.add(A.quad(n), BL(n, W, 0n))

def RTQ(+k: Nat, +i: U32, +t: F.array__Tree<MB<EM.MW>>, +s: Nat, +cur: U32, +dd: Nat, +D: F.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat) -> Data:
  {vec_VarTestStruct_2_e.v2_Gc465214E502_pv(k, i, X, ST(D, t, cur)) == RSX(k, t, s, cur, dd, D, X, q, r) : Array<U32> & (Array<O.Boxed<VarTestStruct_d.Gc465214E502>> & (U32 & O.Boxed<VarTestStruct_d.Gc465214E502>))}
def BYQ(+k: Nat, +t: F.array__Tree<MB<EM.MW>>, +s: Nat, +n: Nat, +cur: U32, +dd: Nat, +D: F.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat, +pad: Nat, +B0: +List<U32>, +LR: Nat) -> Data:
  {UA.BYT(WLM(k, SL(t), s, cur, dd, D, X, q, r)) == UW.SPL(B0, Nat.add(A.quad(q), r), VS.bt(LR, EIS(n, 0n, SL(t), n, pad))) : +List<U32>}
def PFQ(+k: Nat, +t: F.array__Tree<MB<EM.MW>>, +s: Nat, +cur: U32, +dd: Nat, +D: F.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat) -> Data:
  {F.array__perfect(U32, dd, WLM(k, SL(t), s, cur, dd, D, X, q, r)) == True{} : Bool}

# The writer loop from element s with k to go: the runtime equals the model WLM, whose bytes
# are the region with all n elements written.

# The symbolic exponent k = 30 (a literal 2^30 in a context makes error printing evaluate it).
def e31(+k: Nat, +ek: {k == 30n : Nat}) -> {1n+k == 31n : Nat}: Equal.cong(Nat, Nat, z => 1n+z, k, 30n, ek)
def qk(+dd: Nat, +k: Nat, +ek: {k == 30n : Nat}, +hd: {Nat.is_lt(dd, 29n) == True{} : Bool}) -> {Nat.is_le(A.quad(VB.pw(dd)), VB.pw(k)) == True{} : Bool}:
  F.logic__subst(Nat, z => {Nat.is_le(A.quad(VB.pw(dd)), VB.pw(z)) == True{} : Bool}, 30n, k, Equal.sym(Nat, k, 30n, ek), q30(dd, hd))
def t31(+x: Nat, +k: Nat, +ek: {k == 30n : Nat}, +h: {Nat.is_le(x, VB.pw(1n+k)) == True{} : Bool}) -> {Nat.is_le(x, VB.pw(31n)) == True{} : Bool}:
  F.logic__subst(Nat, z => {Nat.is_le(x, VB.pw(z)) == True{} : Bool}, 1n+k, 31n, e31(k, ek), h)
def t31s(+x: Nat, +k: Nat, +ek: {k == 30n : Nat}, +h: {Nat.is_lt(x, VB.pw(1n+k)) == True{} : Bool}) -> {Nat.is_lt(x, VB.pw(31n)) == True{} : Bool}:
  F.logic__subst(Nat, z => {Nat.is_lt(x, VB.pw(z)) == True{} : Bool}, 1n+k, 31n, e31(k, ek), h)

# ---- the step's arithmetic ---------------------------------------------------------------------------

def TEP(+X: U32, +i: U32, +s: Nat, +q: Nat, +r: Nat) -> Data: {U32.to_nat(AO(X, i)) == Nat.add(A.quad(Nat.add(s, q)), r) : Nat}
def THLO(+s: Nat, +q: Nat, +r: Nat, +dd: Nat) -> Data: {Nat.is_le(Nat.add(Nat.add(s, q), WD.NWN(Nat.add(r, 4n))), VB.pw(dd)) == True{} : Bool}
def TH4(+s: Nat, +LR: Nat) -> Data: {Nat.is_le(Nat.add(A.quad(s), 4n), LR) == True{} : Bool}

def hs_of(+s: Nat, +j: Nat, +n: Nat, +ek: {Nat.add(s, 1n+j) == n : Nat}) -> {Nat.is_lt(s, n) == True{} : Bool}:
  +hs = F.logic__subst(Nat, z => {Nat.is_lt(s, z) == True{} : Bool}, Nat.add(s, 1n+j), n, ek,
    F.logic__subst(Nat, z => {Nat.is_lt(s, z) == True{} : Bool}, 1n+Nat.add(s, j), Nat.add(s, 1n+j), Equal.sym(Nat, Nat.add(s, 1n+j), 1n+Nat.add(s, j), F.nat__add_succ(s, j)),
      F.nat__le_lt_succ(s, Nat.add(s, j), Order.below_sum(s, j))))
  hs

# The offset's position, room and slot.
def f_off(+i: U32, +s: Nat, +j: Nat, +n: Nat, +W: List<&2, MB<EM.MW>>, +q: Nat, +r: Nat, +X: U32, +dd: Nat, +pad: Nat, +LR: Nat,
    +ek: {Nat.add(s, 1n+j) == n : Nat}, +e: {U32.to_nat(X) == Nat.add(A.quad(q), r) : Nat}, +hd: {Nat.is_lt(dd, 29n) == True{} : Bool},
