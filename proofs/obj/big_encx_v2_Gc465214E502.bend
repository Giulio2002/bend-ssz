    -> {vec_VarTestStruct_2_e.v2_Gc465214E502_pv(1n+j, i, X, ST(D, t, cur)) == (F.array__thaw(U32, WLM(1n+j, SL(t), s, cur, dd, D, X, q, r)), (AR(t), (SZA(1n+j, SL(t), s, cur), O.BNone{}))) : Array<U32> & (Array<O.Boxed<VarTestStruct_d.Gc465214E502>> & (U32 & O.Boxed<VarTestStruct_d.Gc465214E502>))}:
  +x = xat_v2_Gc465214E502(SL(t), s)
  +D1 = WD.W32X(r, dd, D, Nat.add(s, q), cur)
  +Xe = U32.add(X, cur)
  %Equal.sym(Array<O.Boxed<VarTestStruct_d.Gc465214E502>> & O.Boxed<VarTestStruct_d.Gc465214E502>, Array.swap(O.Boxed<VarTestStruct_d.Gc465214E502>, AR(t), i, O.BNone{}), (AR(F.array__upd(MB<EM.MW>, d, t, s, MNone{})), th_Gc465214E502_bx(x)), swap_out(d, t, i, s, ei, pf, hdl, hsd)) :
    {vec_VarTestStruct_2_e.v2_Gc465214E502_pv(j, U32.add(i, 1), X, vec_VarTestStruct_2_e.v2_Gc465214E502_pv_one(i, X, cur, F.array__thaw(U32, D), _)) == RSX(1n+j, t, s, cur, dd, D, X, q, r) : Array<U32> & (Array<O.Boxed<VarTestStruct_d.Gc465214E502>> & (U32 & O.Boxed<VarTestStruct_d.Gc465214E502>))}
