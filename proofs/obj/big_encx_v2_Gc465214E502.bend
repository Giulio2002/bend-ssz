# The element s's own region (for an element writer that takes them): its end below 2^32, its length below 2^31.
def f_elx(+s: Nat, +j: Nat, +n: Nat, +W: List<&2, MB<EM.MW>>, +q: Nat, +r: Nat, +X: U32, +dd: Nat, +pad: Nat, +LR: Nat,
    +ek: {Nat.add(s, 1n+j) == n : Nat}, +e: {U32.to_nat(X) == Nat.add(A.quad(q), r) : Nat}, +hd: {Nat.is_lt(dd, 31n) == True{} : Bool},
    +hLR: {Nat.add(LLN(n, W), pad) == LR : Nat}, +hroom: {Nat.is_le(Nat.add(Nat.add(A.quad(q), r), LR), A.quad(VB.pw(dd))) == True{} : Bool}, +h32: {Nat.is_lt(Nat.add(Nat.add(A.quad(q), r), LLN(n, W)), F.spec_common__pow2(32n)) == True{} : Bool}, +h31: {Nat.is_lt(LLN(n, W), VB.pw(31n)) == True{} : Bool},
    +hend: {Nat.add(Nat.add(A.quad(q), r), LR) == A.quad(WD.NWN(Nat.add(Nat.add(A.quad(q), r), LLN(n, W)))) : Nat}, +cur: U32, +ec: {U32.to_nat(cur) == Nat.add(A.quad(n), BL(s, W, 0n)) : Nat}, +hx: {EOK(xat_v2_Gc465214E502(W, s)) == True{} : Bool})
    -> DK.P2(TLE32(X, cur, s, W), TLE31(s, W)):
  +x = xat_v2_Gc465214E502(W, s)
  +y = YE(x)
  +X0 = Nat.add(A.quad(q), r)
  +L = LLN(n, W)
  +Nx = U32.to_nat(NE(x))
  +ely = len_ye(x, hx)
  +es1 = Equal.trans(Nat, Nat.add(Nat.add(s, 1n), j), Nat.add(s, Nat.add(1n, j)), n, F.nat__add_assoc(s, 1n, j), ek)
  +ebl = Equal.trans(Nat, BL(n, W, 0n), Nat.add(BL(s, W, 0n), BL(1n+j, W, s)), Nat.add(BL(s, W, 0n), Nat.add(VE2.LEN(y), BL(j, W, 1n+s))),
    F.logic__subst(Nat, z => {BL(z, W, 0n) == Nat.add(BL(s, W, 0n), BL(1n+j, W, s)) : Nat}, Nat.add(s, 1n+j), n, ek, bl_split(s, 1n+j, W)),
    Equal.cong(Nat, Nat, z => Nat.add(BL(s, W, 0n), z), BL(1n+j, W, s), Nat.add(VE2.LEN(y), BL(j, W, 1n+s)), bl_cons(j, W, s)))
  +hLL = F.logic__subst(Nat, z => {Nat.is_le(L, z) == True{} : Bool}, Nat.add(L, pad), LR, hLR, Order.below_sum(L, pad))
  +hXL = F.nat__le_trans(Nat.add(X0, L), Nat.add(X0, LR), A.quad(VB.pw(dd)), Order.add_left(X0, L, LR, hLL), hroom)
  +v = Nat.add(A.quad(n), BL(s, W, 0n))
  +hvL = Order.add_left(A.quad(n), BL(s, W, 0n), BL(n, W, 0n),
    F.logic__subst(Nat, z => {Nat.is_le(BL(s, W, 0n), z) == True{} : Bool}, Nat.add(BL(s, W, 0n), Nat.add(VE2.LEN(y), BL(j, W, 1n+s))), BL(n, W, 0n), Equal.sym(Nat, BL(n, W, 0n), Nat.add(BL(s, W, 0n), Nat.add(VE2.LEN(y), BL(j, W, 1n+s))), ebl),
      Order.below_sum(BL(s, W, 0n), Nat.add(VE2.LEN(y), BL(j, W, 1n+s)))))
  +hbv = F.nat__le_lt_trans(Nat.add(X0, v), Nat.add(X0, L), F.spec_common__pow2(32n), Order.add_left(X0, v, L, hvL), h32)
  +Xe = U32.add(X, cur)
  +eXe = ep_el32(X, cur, X0, v, e, ec, hbv)
  +P = YS(s, W, 0n)
  +R = YS(j, W, 1n+s)
  +Z = Nat.add(BL(1n+j, W, s), pad)
  +elpj = Equal.trans(Nat, VE2.LEN(VE2.PJ(P, y, R, A.quad(n))), Nat.add(A.quad(Nat.add(Nat.add(VVL.CNT(P), 1n), VVL.CNT(R))), BL(s, W, 0n)), v,
    VE2.len_pj(P, y, R, A.quad(n)),
    Equal.cong(Nat, Nat, z => Nat.add(A.quad(z), BL(s, W, 0n)), Nat.add(Nat.add(VVL.CNT(P), 1n), VVL.CNT(R)), n,
      Equal.trans(Nat, Nat.add(Nat.add(VVL.CNT(P), 1n), VVL.CNT(R)), Nat.add(Nat.add(s, 1n), j), n,
        Equal.trans(Nat, Nat.add(Nat.add(VVL.CNT(P), 1n), VVL.CNT(R)), Nat.add(Nat.add(s, 1n), VVL.CNT(R)), Nat.add(Nat.add(s, 1n), j),
          Equal.cong(Nat, Nat, z => Nat.add(Nat.add(z, 1n), VVL.CNT(R)), VVL.CNT(P), s, cnt_ys(s, W, 0n)),
