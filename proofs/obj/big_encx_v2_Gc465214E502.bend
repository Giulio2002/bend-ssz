# ---- arithmetic ---------------------------------------------------------------------------------

def cnt_ys(+k: Nat, +W: List<&2, MB<EM.MW>>, +i: Nat) -> {VVL.CNT(YS(k, W, i)) == k : Nat}:
  match k:
    case 0n: {==}
    case 1n+ +q: Equal.cong(Nat, Nat, z => 1n+z, VVL.CNT(YS(q, W, 1n+i)), q, cnt_ys(q, W, 1n+i))

law ys_split:
  for +s: Nat
  for +k: Nat
  for +W: List<&2, MB<EM.MW>>
  for +i: Nat
  {YS(Nat.add(s, k), W, i) == VE2.LAPP(YS(s, W, i), YS(k, W, Nat.add(s, i))) : +List<+List<U32>>}
def ys_split(s, k, W, i):
  match s:
    case 0n: {==}
    case 1n+ +p:
      %F.nat__add_succ(p, i) :
        {Con{YE(xat_v2_Gc465214E502(W, i)), YS(Nat.add(p, k), W, 1n+i)} == Con{YE(xat_v2_Gc465214E502(W, i)), VE2.LAPP(YS(p, W, 1n+i), YS(k, W, _))} : +List<+List<U32>>}
      Equal.cong(+List<+List<U32>>, +List<+List<U32>>, z => Con{YE(xat_v2_Gc465214E502(W, i)), z}, YS(Nat.add(p, k), W, 1n+i), VE2.LAPP(YS(p, W, 1n+i), YS(k, W, Nat.add(p, 1n+i))), ys_split(p, k, W, 1n+i))

def ys_snoc(+s: Nat, +W: List<&2, MB<EM.MW>>) -> {YS(1n+s, W, 0n) == VE2.LAPP(YS(s, W, 0n), [YE(xat_v2_Gc465214E502(W, s))]) : +List<+List<U32>>}:
  +e1 = ys_split(s, 1n, W, 0n)
  +es = Equal.trans(Nat, Nat.add(s, 1n), 1n+Nat.add(s, 0n), 1n+s, F.nat__add_succ(s, 0n), Equal.cong(Nat, Nat, z => 1n+z, Nat.add(s, 0n), s, F.nat__add_zero(s)))
  %es : {YS(_, W, 0n) == VE2.LAPP(YS(s, W, 0n), [YE(xat_v2_Gc465214E502(W, s))]) : +List<+List<U32>>}
  %F.nat__add_zero(s) : {YS(Nat.add(s, 1n), W, 0n) == VE2.LAPP(YS(s, W, 0n), [YE(xat_v2_Gc465214E502(W, _))]) : +List<+List<U32>>}
  e1

def len_ye(+m: MB<EM.MW>, +h: {EOK(m) == True{} : Bool}) -> {VE2.LEN(YE(m)) == U32.to_nat(NE(m)) : Nat}:
  match m:
    case MNone{}: Empty.absurd({VE2.LEN(YE(MNone{})) == U32.to_nat(NE(MNone{})) : Nat}, F.logic__false_true(h))
    case MSome{+w}: Equal.sym(Nat, U32.to_nat(EM.SZ(w)), VE2.LEN(EM.ENC(w)), EM.szx(w, h))

# padd of two small words is their sum.
def padd_nat(+a: U32, +b: U32, +h: {Nat.is_lt(Nat.add(U32.to_nat(a), U32.to_nat(b)), VB.pw(31n)) == True{} : Bool})
    -> {U32.to_nat(O.padd(a, b)) == Nat.add(U32.to_nat(a), U32.to_nat(b)) : Nat}:
  +ha = F.nat__le_lt_trans(U32.to_nat(a), Nat.add(U32.to_nat(a), U32.to_nat(b)), VB.pw(31n), Order.below_sum(U32.to_nat(a), U32.to_nat(b)), h)
  +hb = F.nat__le_lt_trans(U32.to_nat(b), Nat.add(U32.to_nat(a), U32.to_nat(b)), VB.pw(31n), Order.left_below_sum(U32.to_nat(a), U32.to_nat(b)), h)
  %Equal.sym(U32, O.padd(a, b), U32.add(a, b), VE.padd_ok(a, b, VE.winit(31n, VE.bits32(a)), VE.winit(31n, VE.bits32(b)), VE.small_pad(a, 31n, {==}, ha), VE.small_pad(b, 31n, {==}, hb))) :
    {U32.to_nat(_) == Nat.add(U32.to_nat(a), U32.to_nat(b)) : Nat}
  A.add_le(a, b, F.u32__pow2u(31n), F.logic__subst(Nat, z => {Nat.is_le(Nat.add(U32.to_nat(a), U32.to_nat(b)), z) == True{} : Bool}, VB.pw(31n), U32.to_nat(F.u32__pow2u(31n)),
    Equal.sym(Nat, U32.to_nat(F.u32__pow2u(31n)), VB.pw(31n), F.u32__pow2u_value(31n, {==})), F.nat__lt_le(Nat.add(U32.to_nat(a), U32.to_nat(b)), VB.pw(31n), h)))

# ceil(x / 4) words.
law nwn_quad:
  for +a: Nat
  for +b: Nat
  {WD.NWN(Nat.add(A.quad(a), b)) == Nat.add(a, WD.NWN(b)) : Nat}
def nwn_quad(a, b):
  match a:
    case 0n: {==}
    case 1n+ +p: Equal.cong(Nat, Nat, z => 1n+z, WD.NWN(Nat.add(A.quad(p), b)), Nat.add(p, WD.NWN(b)), nwn_quad(p, b))

def nwn_le(+y: Nat, +P: Nat, +h: {Nat.is_le(y, A.quad(P)) == True{} : Bool}) -> {Nat.is_le(WD.NWN(y), P) == True{} : Bool}:
  %VL.rng2_q(P) : {Nat.is_le(WD.NWN(y), _) == True{} : Bool}
  VC.rng_mono(2n, 3n+y, 3n+A.quad(P), h)

law nwn_ge:
  for +y: Nat
  {Nat.is_le(y, A.quad(WD.NWN(y))) == True{} : Bool}
def nwn_ge(y):
  match y:
    case 0n: {==}
    case 1n: {==}
    case 2n: {==}
    case 3n: {==}
    case 4n+ +z: nwn_ge(z)

# The padding to the end of the last word: r + m + PADB(r, m) = 4 ceil((r + m) / 4).
def padb_id(+r: Nat, +m: Nat) -> {Nat.add(Nat.add(r, m), WD.PADB(r, m)) == A.quad(WD.NWN(Nat.add(r, m))) : Nat}:
  +Q = A.quad(WD.NWN(Nat.add(r, m)))
  +hq = nwn_ge(Nat.add(r, m))
  +hr = F.nat__le_trans(r, Nat.add(r, m), Q, Order.below_sum(r, m), hq)
  +er = F.nat__sub_add(Q, r, hr)
  +hm = VZ.le_cancel(r, m, Nat.sub(Q, r), F.logic__subst(Nat, z => {Nat.is_le(Nat.add(r, m), z) == True{} : Bool}, Q, Nat.add(r, Nat.sub(Q, r)), Equal.sym(Nat, Nat.add(r, Nat.sub(Q, r)), Q, er), hq))
  +em = F.nat__sub_add(Nat.sub(Q, r), m, hm)
  Equal.trans(Nat, Nat.add(Nat.add(r, m), WD.PADB(r, m)), Nat.add(r, Nat.add(m, WD.PADB(r, m))), Q, F.nat__add_assoc(r, m, WD.PADB(r, m)),
    Equal.trans(Nat, Nat.add(r, Nat.add(m, WD.PADB(r, m))), Nat.add(r, Nat.sub(Q, r)), Q, Equal.cong(Nat, Nat, z => Nat.add(r, z), Nat.add(m, WD.PADB(r, m)), Nat.sub(Q, r), em), er))

def BL(k: Nat, +W: List<&2, MB<EM.MW>>, +s: Nat) -> Nat: VE2.LEN(VR.bcat(YS(k, W, s)))

# The bytes of elements split at s.
def bl_split(+s: Nat, +k: Nat, +W: List<&2, MB<EM.MW>>) -> {BL(Nat.add(s, k), W, 0n) == Nat.add(BL(s, W, 0n), BL(k, W, s)) : Nat}:
  %Equal.sym(+List<+List<U32>>, YS(Nat.add(s, k), W, 0n), VE2.LAPP(YS(s, W, 0n), YS(k, W, Nat.add(s, 0n))), ys_split(s, k, W, 0n)) :
    {VE2.LEN(VR.bcat(_)) == Nat.add(BL(s, W, 0n), BL(k, W, s)) : Nat}
  %Equal.sym(+List<U32>, VR.bcat(VE2.LAPP(YS(s, W, 0n), YS(k, W, Nat.add(s, 0n)))), VE2.APP(VR.bcat(YS(s, W, 0n)), VR.bcat(YS(k, W, Nat.add(s, 0n)))), VE2.bcat_app(YS(s, W, 0n), YS(k, W, Nat.add(s, 0n)))) :
    {VE2.LEN(_) == Nat.add(BL(s, W, 0n), BL(k, W, s)) : Nat}
  %Equal.sym(Nat, Nat.add(s, 0n), s, F.nat__add_zero(s)) :
    {VE2.LEN(VE2.APP(VR.bcat(YS(s, W, 0n)), VR.bcat(YS(k, W, _)))) == Nat.add(BL(s, W, 0n), BL(k, W, s)) : Nat}
  VS.len_app(VR.bcat(YS(s, W, 0n)), VR.bcat(YS(k, W, s)))

def bl_cons(+k: Nat, +W: List<&2, MB<EM.MW>>, +s: Nat) -> {BL(1n+k, W, s) == Nat.add(VE2.LEN(YE(xat_v2_Gc465214E502(W, s))), BL(k, W, 1n+s)) : Nat}:
  VS.len_app(YE(xat_v2_Gc465214E502(W, s)), VR.bcat(YS(k, W, 1n+s)))

def bl_snoc(+s: Nat, +W: List<&2, MB<EM.MW>>) -> {BL(1n+s, W, 0n) == Nat.add(BL(s, W, 0n), VE2.LEN(YE(xat_v2_Gc465214E502(W, s)))) : Nat}:
  %Equal.sym(+List<+List<U32>>, YS(1n+s, W, 0n), VE2.LAPP(YS(s, W, 0n), [YE(xat_v2_Gc465214E502(W, s))]), ys_snoc(s, W)) : {VE2.LEN(VR.bcat(_)) == Nat.add(BL(s, W, 0n), VE2.LEN(YE(xat_v2_Gc465214E502(W, s)))) : Nat}
  %Equal.sym(+List<U32>, VR.bcat(VE2.LAPP(YS(s, W, 0n), [YE(xat_v2_Gc465214E502(W, s))])), VE2.APP(VR.bcat(YS(s, W, 0n)), YE(xat_v2_Gc465214E502(W, s))), VE2.bcat_snoc(YS(s, W, 0n), YE(xat_v2_Gc465214E502(W, s)))) :
    {VE2.LEN(_) == Nat.add(BL(s, W, 0n), VE2.LEN(YE(xat_v2_Gc465214E502(W, s)))) : Nat}
  VS.len_app(VR.bcat(YS(s, W, 0n)), YE(xat_v2_Gc465214E502(W, s)))

# The region's bytes when s elements are written and k remain.
def EIS(+s: Nat, +k: Nat, +W: List<&2, MB<EM.MW>>, +n: Nat, +pad: Nat) -> +List<U32>:
  VE2.EI(YS(s, W, 0n), YS(k, W, s), A.quad(n), Nat.add(BL(k, W, s), pad))

def len_eis(+s: Nat, +k: Nat, +W: List<&2, MB<EM.MW>>, +n: Nat, +pad: Nat, +ek: {Nat.add(s, k) == n : Nat})
    -> {VE2.LEN(EIS(s, k, W, n, pad)) == Nat.add(Nat.add(A.quad(n), BL(n, W, 0n)), pad) : Nat}:
  +P = YS(s, W, 0n)
  +R = YS(k, W, s)
  %Equal.sym(Nat, VE2.LEN(EIS(s, k, W, n, pad)), Nat.add(A.quad(VVL.CNT(P)), Nat.add(A.quad(VVL.CNT(R)), Nat.add(BL(s, W, 0n), Nat.add(BL(k, W, s), pad)))), VE2.len_ei(P, R, A.quad(n), Nat.add(BL(k, W, s), pad))) :
    {_ == Nat.add(Nat.add(A.quad(n), BL(n, W, 0n)), pad) : Nat}
  %Equal.sym(Nat, VVL.CNT(P), s, cnt_ys(s, W, 0n)) :
    {Nat.add(A.quad(_), Nat.add(A.quad(VVL.CNT(R)), Nat.add(BL(s, W, 0n), Nat.add(BL(k, W, s), pad)))) == Nat.add(Nat.add(A.quad(n), BL(n, W, 0n)), pad) : Nat}
  %Equal.sym(Nat, VVL.CNT(R), k, cnt_ys(k, W, s)) :
    {Nat.add(A.quad(s), Nat.add(A.quad(_), Nat.add(BL(s, W, 0n), Nat.add(BL(k, W, s), pad)))) == Nat.add(Nat.add(A.quad(n), BL(n, W, 0n)), pad) : Nat}
  %ek : {Nat.add(A.quad(s), Nat.add(A.quad(k), Nat.add(BL(s, W, 0n), Nat.add(BL(k, W, s), pad)))) == Nat.add(Nat.add(A.quad(_), BL(_, W, 0n)), pad) : Nat}
  %Equal.sym(Nat, BL(Nat.add(s, k), W, 0n), Nat.add(BL(s, W, 0n), BL(k, W, s)), bl_split(s, k, W)) :
    {Nat.add(A.quad(s), Nat.add(A.quad(k), Nat.add(BL(s, W, 0n), Nat.add(BL(k, W, s), pad)))) == Nat.add(Nat.add(A.quad(Nat.add(s, k)), _), pad) : Nat}
  %Equal.sym(Nat, A.quad(Nat.add(s, k)), Nat.add(A.quad(s), A.quad(k)), Equal.sym(Nat, Nat.add(A.quad(s), A.quad(k)), A.quad(Nat.add(s, k)), VF.quad_add(s, k))) :
    {Nat.add(A.quad(s), Nat.add(A.quad(k), Nat.add(BL(s, W, 0n), Nat.add(BL(k, W, s), pad)))) == Nat.add(Nat.add(_, Nat.add(BL(s, W, 0n), BL(k, W, s))), pad) : Nat}
  +a = A.quad(s)
  +b = A.quad(k)
  +c = BL(s, W, 0n)
  +d = BL(k, W, s)
  Equal.sym(Nat, Nat.add(Nat.add(Nat.add(a, b), Nat.add(c, d)), pad), Nat.add(a, Nat.add(b, Nat.add(c, Nat.add(d, pad)))),
    Equal.trans(Nat, Nat.add(Nat.add(Nat.add(a, b), Nat.add(c, d)), pad), Nat.add(Nat.add(a, b), Nat.add(Nat.add(c, d), pad)), Nat.add(a, Nat.add(b, Nat.add(c, Nat.add(d, pad)))),
      F.nat__add_assoc(Nat.add(a, b), Nat.add(c, d), pad),
      Equal.trans(Nat, Nat.add(Nat.add(a, b), Nat.add(Nat.add(c, d), pad)), Nat.add(a, Nat.add(b, Nat.add(Nat.add(c, d), pad))), Nat.add(a, Nat.add(b, Nat.add(c, Nat.add(d, pad)))),
        F.nat__add_assoc(a, b, Nat.add(Nat.add(c, d), pad)),
        Equal.cong(Nat, Nat, z => Nat.add(a, Nat.add(b, z)), Nat.add(Nat.add(c, d), pad), Nat.add(c, Nat.add(d, pad)), F.nat__add_assoc(c, d, pad)))))

# ---- one step of the writer: offset s, then element s ----------------------------------------------

def AO(+X: U32, +i: U32) -> U32: U32.add(X, U32.mul(4, i))

# The offset's bytes: the region goes from EI (s written) to EJ (offset s written).
def off_bytesW(+dd: Nat, +D: F.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat, +hr: {Nat.is_lt(r, 4n) == True{} : Bool}, +hd: {Nat.is_lt(dd, 31n) == True{} : Bool},
    +pfD: {F.array__perfect(U32, dd, D) == True{} : Bool}, +i: U32, +s: Nat, +cur: U32, +W: List<&2, MB<EM.MW>>, +j: Nat, +n: Nat, +pad: Nat,
    +B0: +List<U32>, +LR: Nat, +hX: {Nat.is_le(Nat.add(A.quad(q), r), VE2.LEN(B0)) == True{} : Bool},
    +hLR: {VE2.LEN(EIS(s, 1n+j, W, n, pad)) == LR : Nat},
    +hI: {UA.BYT(D) == UW.SPL(B0, Nat.add(A.quad(q), r), VS.bt(LR, EIS(s, 1n+j, W, n, pad))) : +List<U32>},
    +ec: {U32.to_nat(cur) == Nat.add(A.quad(n), BL(s, W, 0n)) : Nat},
    +ep: {U32.to_nat(AO(X, i)) == Nat.add(A.quad(Nat.add(s, q)), r) : Nat},
    +hlo: {Nat.is_le(Nat.add(Nat.add(s, q), WD.NWN(Nat.add(r, 4n))), VB.pw(dd)) == True{} : Bool},
    +h4: {Nat.is_le(Nat.add(A.quad(s), 4n), LR) == True{} : Bool})
    -> {UA.BYT(WD.W32X(r, dd, D, Nat.add(s, q), cur)) == UW.SPL(B0, Nat.add(A.quad(q), r), VS.bt(LR, VE2.EJ(YS(s, W, 0n), YE(xat_v2_Gc465214E502(W, s)), YS(j, W, 1n+s), A.quad(n), Nat.add(BL(1n+j, W, s), pad)))) : +List<U32>}:
  +P = YS(s, W, 0n)
  +y = YE(xat_v2_Gc465214E502(W, s))
  +R = YS(j, W, 1n+s)
  +Z = Nat.add(BL(1n+j, W, s), pad)
  +E = EIS(s, 1n+j, W, n, pad)
  +X0 = Nat.add(A.quad(q), r)
  +ecs = cnt_ys(s, W, 0n)
  +hE = F.nat__eq_le(LR, VE2.LEN(E), Equal.sym(Nat, VE2.LEN(E), LR, hLR))
  +h4c = F.logic__subst(Nat, z => {Nat.is_le(Nat.add(A.quad(z), 4n), LR) == True{} : Bool}, s, VVL.CNT(P), Equal.sym(Nat, VVL.CNT(P), s, ecs), h4)
  +epos = Equal.trans(Nat, Nat.add(X0, A.quad(VVL.CNT(P))), Nat.add(X0, A.quad(s)), Nat.add(A.quad(Nat.add(s, q)), r),
    Equal.cong(Nat, Nat, z => Nat.add(X0, A.quad(z)), VVL.CNT(P), s, ecs), Equal.sym(Nat, Nat.add(A.quad(Nat.add(s, q)), r), Nat.add(X0, A.quad(s)), UW.pos_eq(s, q, r)))
  +z0 = UW.inv_zero(B0, X0, LR, E, A.quad(VVL.CNT(P)), 4n, UA.BYT(D), hX, hI, h4c, hE, VE2.win_off(P, y, R, A.quad(n), Z))
  +hz4 = F.logic__subst(Nat, z => {VS.bt(4n, VS.bdr(z, UA.BYT(D))) == UW.ZB(4n) : +List<U32>}, Nat.add(X0, A.quad(VVL.CNT(P))), Nat.add(A.quad(Nat.add(s, q)), r), epos, z0)
  +wb = WD.w32_any_bytesW(dd, D, AO(X, i), Nat.add(s, q), r, cur, ep, hr, hd, hlo, pfD, hz4)
  +hop = F.logic__subst(Nat, z => {UA.BYT(WD.W32X(r, dd, D, Nat.add(s, q), cur)) == UW.SPL(UA.BYT(D), z, I.limb(cur)) : +List<U32>}, Nat.add(A.quad(Nat.add(s, q)), r), Nat.add(X0, A.quad(VVL.CNT(P))),
    Equal.sym(Nat, Nat.add(X0, A.quad(VVL.CNT(P))), Nat.add(A.quad(Nat.add(s, q)), r), epos), wb)
  +st = UW.inv_step(B0, X0, LR, E, A.quad(VVL.CNT(P)), I.limb(cur), Nat.sub(LR, Nat.add(A.quad(VVL.CNT(P)), 4n)), UA.BYT(D), UA.BYT(WD.W32X(r, dd, D, Nat.add(s, q), cur)), hX, hI, hop,
    F.nat__sub_add(LR, Nat.add(A.quad(VVL.CNT(P)), 4n), h4c), hE)
  +edl = Equal.trans(+List<U32>, I.limb(cur), N.digits(4n, U32.to_nat(cur)), N.digits(4n, Nat.add(A.quad(n), BL(s, W, 0n))),
    Equal.sym(+List<U32>, N.digits(4n, U32.to_nat(cur)), I.limb(cur), VG.digits_limb(cur)), Equal.cong(Nat, +List<U32>, z => N.digits(4n, z), U32.to_nat(cur), Nat.add(A.quad(n), BL(s, W, 0n)), ec))
  %VE2.off_step(P, y, R, A.quad(n), Z) :
    {UA.BYT(WD.W32X(r, dd, D, Nat.add(s, q), cur)) == UW.SPL(B0, X0, VS.bt(LR, _)) : +List<U32>}
  F.logic__subst(+List<U32>, z => {UA.BYT(WD.W32X(r, dd, D, Nat.add(s, q), cur)) == UW.SPL(B0, X0, VS.bt(LR, UW.SPL(E, A.quad(VVL.CNT(P)), z))) : +List<U32>}, I.limb(cur), N.digits(4n, Nat.add(A.quad(n), BL(s, W, 0n))), edl, st)

def off_bytes(+dd: Nat, +D: F.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat, +hr: {Nat.is_lt(r, 4n) == True{} : Bool}, +hd: {Nat.is_lt(dd, 29n) == True{} : Bool},
    +pfD: {F.array__perfect(U32, dd, D) == True{} : Bool}, +i: U32, +s: Nat, +cur: U32, +W: List<&2, MB<EM.MW>>, +j: Nat, +n: Nat, +pad: Nat,
    +B0: +List<U32>, +LR: Nat, +hX: {Nat.is_le(Nat.add(A.quad(q), r), VE2.LEN(B0)) == True{} : Bool},
    +hLR: {VE2.LEN(EIS(s, 1n+j, W, n, pad)) == LR : Nat},
    +hI: {UA.BYT(D) == UW.SPL(B0, Nat.add(A.quad(q), r), VS.bt(LR, EIS(s, 1n+j, W, n, pad))) : +List<U32>},
    +ec: {U32.to_nat(cur) == Nat.add(A.quad(n), BL(s, W, 0n)) : Nat},
    +ep: {U32.to_nat(AO(X, i)) == Nat.add(A.quad(Nat.add(s, q)), r) : Nat},
    +hlo: {Nat.is_le(Nat.add(Nat.add(s, q), WD.NWN(Nat.add(r, 4n))), VB.pw(dd)) == True{} : Bool},
    +h4: {Nat.is_le(Nat.add(A.quad(s), 4n), LR) == True{} : Bool})
    -> {UA.BYT(WD.W32X(r, dd, D, Nat.add(s, q), cur)) == UW.SPL(B0, Nat.add(A.quad(q), r), VS.bt(LR, VE2.EJ(YS(s, W, 0n), YE(xat_v2_Gc465214E502(W, s)), YS(j, W, 1n+s), A.quad(n), Nat.add(BL(1n+j, W, s), pad)))) : +List<U32>}:
  off_bytesW(dd, D, X, q, r, hr, F.nat__lt_trans(dd, 29n, 31n, hd, {==}), pfD, i, s, cur, W, j, n, pad, B0, LR, hX, hLR, hI, ec, ep, hlo, h4)

def QX(+y: U32) -> Nat: U32.to_nat(U32.shrn(y, 2n))
def RX(+y: U32) -> Nat: U32.to_nat(U32.and(y, 3))
def rx_lt(+y: U32) -> {Nat.is_lt(RX(y), 4n) == True{} : Bool}: F.nat__le_lt_trans(RX(y), 3n, 4n, RD.and_le(y, 3), {==})

# The element's bytes: the region goes from EJ (offset s written) to EI with s + 1 written.
def el_bytes(+dd: Nat, +D: F.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat, +hd: {Nat.is_lt(dd, 29n) == True{} : Bool},
    +pfD: {F.array__perfect(U32, dd, D) == True{} : Bool}, +cur: U32, +s: Nat, +W: List<&2, MB<EM.MW>>, +j: Nat, +n: Nat, +pad: Nat,
    +B0: +List<U32>, +LR: Nat, +hX: {Nat.is_le(Nat.add(A.quad(q), r), VE2.LEN(B0)) == True{} : Bool},
    +hx: {EOK(xat_v2_Gc465214E502(W, s)) == True{} : Bool},
    +hLR: {VE2.LEN(VE2.EJ(YS(s, W, 0n), YE(xat_v2_Gc465214E502(W, s)), YS(j, W, 1n+s), A.quad(n), Nat.add(BL(1n+j, W, s), pad))) == LR : Nat},
    +hI: {UA.BYT(D) == UW.SPL(B0, Nat.add(A.quad(q), r), VS.bt(LR, VE2.EJ(YS(s, W, 0n), YE(xat_v2_Gc465214E502(W, s)), YS(j, W, 1n+s), A.quad(n), Nat.add(BL(1n+j, W, s), pad)))) : +List<U32>},
    +epe: {U32.to_nat(U32.add(X, cur)) == Nat.add(Nat.add(A.quad(q), r), VE2.LEN(VE2.PJ(YS(s, W, 0n), YE(xat_v2_Gc465214E502(W, s)), YS(j, W, 1n+s), A.quad(n)))) : Nat},
    +hle: {Nat.is_le(Nat.add(QX(U32.add(X, cur)), WD.NWN(Nat.add(RX(U32.add(X, cur)), U32.to_nat(NE(xat_v2_Gc465214E502(W, s)))))), VB.pw(dd)) == True{} : Bool},
    +hfp: {Nat.is_le(Nat.add(VE2.LEN(VE2.PJ(YS(s, W, 0n), YE(xat_v2_Gc465214E502(W, s)), YS(j, W, 1n+s), A.quad(n))), FPE(RX(U32.add(X, cur)), xat_v2_Gc465214E502(W, s))), LR) == True{} : Bool},
    +hpz: {Nat.is_le(FPE(RX(U32.add(X, cur)), xat_v2_Gc465214E502(W, s)), Nat.add(BL(1n+j, W, s), pad)) == True{} : Bool})
    -> {UA.BYT(PWE(xat_v2_Gc465214E502(W, s), dd, D, QX(U32.add(X, cur)), RX(U32.add(X, cur)))) == UW.SPL(B0, Nat.add(A.quad(q), r), VS.bt(LR, EIS(1n+s, j, W, n, pad))) : +List<U32>}:
  +x = xat_v2_Gc465214E502(W, s)
  +P = YS(s, W, 0n)
  +y = YE(x)
  +R = YS(j, W, 1n+s)
  +Z = Nat.add(BL(1n+j, W, s), pad)
  +zr = Nat.add(BL(j, W, 1n+s), pad)
  +Xe = U32.add(X, cur)
  +X0 = Nat.add(A.quad(q), r)
  +a = VE2.LEN(VE2.PJ(P, y, R, A.quad(n)))
  +pe = WD.PADB(RX(Xe), U32.to_nat(NE(x)))
  +Y = VE2.APP(y, UW.ZB(pe))
  +E = VE2.EJ(P, y, R, A.quad(n), Z)
  +hE = F.nat__eq_le(LR, VE2.LEN(E), Equal.sym(Nat, VE2.LEN(E), LR, hLR))
  +epos = Equal.trans(Nat, Nat.add(X0, a), U32.to_nat(Xe), Nat.add(A.quad(QX(Xe)), RX(Xe)), Equal.sym(Nat, U32.to_nat(Xe), Nat.add(X0, a), epe), VC.split4(Xe))
  +ely = len_ye(x, hx)
  +eY = Equal.trans(Nat, VE2.LEN(Y), Nat.add(VE2.LEN(y), VE2.LEN(UW.ZB(pe))), FPE(RX(Xe), x), VS.len_app(y, UW.ZB(pe)),
    Equal.trans(Nat, Nat.add(VE2.LEN(y), VE2.LEN(UW.ZB(pe))), Nat.add(U32.to_nat(NE(x)), VE2.LEN(UW.ZB(pe))), FPE(RX(Xe), x),
      Equal.cong(Nat, Nat, z => Nat.add(z, VE2.LEN(UW.ZB(pe))), VE2.LEN(y), U32.to_nat(NE(x)), ely),
      Equal.cong(Nat, Nat, z => Nat.add(U32.to_nat(NE(x)), z), VE2.LEN(UW.ZB(pe)), pe, VE2.len_zb(pe))))
  +z0 = UW.inv_zero(B0, X0, LR, E, a, FPE(RX(Xe), x), UA.BYT(D), hX, hI, hfp, hE, VE2.win_el(P, y, R, A.quad(n), Z, FPE(RX(Xe), x), hpz))
  +hz = F.logic__subst(Nat, z => {VS.bt(FPE(RX(Xe), x), VS.bdr(z, UA.BYT(D))) == UW.ZB(FPE(RX(Xe), x)) : +List<U32>}, Nat.add(X0, a), Nat.add(A.quad(QX(Xe)), RX(Xe)), epos, z0)
  +wb = bxput_bytes(x, hx, dd, D, Xe, QX(Xe), RX(Xe), VC.split4(Xe), rx_lt(Xe), hd, hle, pfD, hz)
  +hop = F.logic__subst(Nat, z => {UA.BYT(PWE(x, dd, D, QX(Xe), RX(Xe))) == UW.SPL(UA.BYT(D), z, Y) : +List<U32>}, Nat.add(A.quad(QX(Xe)), RX(Xe)), Nat.add(X0, a),
    Equal.sym(Nat, Nat.add(X0, a), Nat.add(A.quad(QX(Xe)), RX(Xe)), epos), wb)
  +hfy = F.logic__subst(Nat, z => {Nat.is_le(Nat.add(a, z), LR) == True{} : Bool}, FPE(RX(Xe), x), VE2.LEN(Y), Equal.sym(Nat, VE2.LEN(Y), FPE(RX(Xe), x), eY), hfp)
  +st = UW.inv_step(B0, X0, LR, E, a, Y, Nat.sub(LR, Nat.add(a, VE2.LEN(Y))), UA.BYT(D), UA.BYT(PWE(x, dd, D, QX(Xe), RX(Xe))), hX, hI, hop,
    F.nat__sub_add(LR, Nat.add(a, VE2.LEN(Y)), hfy), hE)
  +eZ = Equal.trans(Nat, Z, Nat.add(Nat.add(VE2.LEN(y), BL(j, W, 1n+s)), pad), Nat.add(VE2.LEN(y), zr),
    Equal.cong(Nat, Nat, z => Nat.add(z, pad), BL(1n+j, W, s), Nat.add(VE2.LEN(y), BL(j, W, 1n+s)), bl_cons(j, W, s)),
    F.nat__add_assoc(VE2.LEN(y), BL(j, W, 1n+s), pad))
  +hpz2 = F.logic__subst(Nat, z => {Nat.is_le(FPE(RX(Xe), x), z) == True{} : Bool}, Z, Nat.add(VE2.LEN(y), zr), eZ, hpz)
  +hp = VZ.le_cancel(VE2.LEN(y), pe, zr, F.logic__subst(Nat, z => {Nat.is_le(Nat.add(z, pe), Nat.add(VE2.LEN(y), zr)) == True{} : Bool}, U32.to_nat(NE(x)), VE2.LEN(y), Equal.sym(Nat, VE2.LEN(y), U32.to_nat(NE(x)), ely), hpz2))
  +es = F.logic__subst(Nat, z => {UW.SPL(VE2.EJ(P, y, R, A.quad(n), z), a, Y) == VE2.EI(VE2.LAPP(P, [y]), R, A.quad(n), zr) : +List<U32>}, Nat.add(VE2.LEN(y), zr), Z,
    Equal.sym(Nat, Z, Nat.add(VE2.LEN(y), zr), eZ), VE2.el_step(P, y, R, A.quad(n), zr, pe, hp))
  %Equal.sym(+List<+List<U32>>, YS(1n+s, W, 0n), VE2.LAPP(P, [y]), ys_snoc(s, W)) :
    {UA.BYT(PWE(x, dd, D, QX(Xe), RX(Xe))) == UW.SPL(B0, X0, VS.bt(LR, VE2.EI(_, R, A.quad(n), zr))) : +List<U32>}
  %es : {UA.BYT(PWE(x, dd, D, QX(Xe), RX(Xe))) == UW.SPL(B0, X0, VS.bt(LR, _)) : +List<U32>}
  st

# ---- the writer loop ---------------------------------------------------------------------------------

# The output tree after the loop's k steps from element s (offset s at word q + s, byte r;
# element s at X + cur).
def WLM(k: Nat, +W: List<&2, MB<EM.MW>>, +s: Nat, +cur: U32, +dd: Nat, +D: F.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat) -> F.array__Tree<U32>:
  match k:
    case 0n: D
    case 1n+j:
      WLM(j, W, 1n+s, O.padd(cur, NE(xat_v2_Gc465214E502(W, s))), dd,
        PWE(xat_v2_Gc465214E502(W, s), dd, WD.W32X(r, dd, D, Nat.add(s, q), cur), QX(U32.add(X, cur)), RX(U32.add(X, cur))), X, q, r)

def pwe_perfect(+m: MB<EM.MW>, +dd: Nat, +D: F.array__Tree<U32>, +q: Nat, +r: Nat, +pf: {F.array__perfect(U32, dd, D) == True{} : Bool})
    -> {F.array__perfect(U32, dd, PWE(m, dd, D, q, r)) == True{} : Bool}:
  match m:
    case MNone{}: pf
    case MSome{+w}: EM.pfx(w, dd, D, q, r, pf)

def q30(+dd: Nat, +hd: {Nat.is_lt(dd, 29n) == True{} : Bool}) -> {Nat.is_le(A.quad(VB.pw(dd)), VB.pw(30n)) == True{} : Bool}:
  F.nat__pow2_mono(2n+dd, 30n, F.nat__lt_succ_le(dd, 28n, hd))
def bsuc(+x: Nat, +k: Nat, +h: {Nat.is_le(x, VB.pw(k)) == True{} : Bool}) -> {Nat.is_lt(x, VB.pw(1n+k)) == True{} : Bool}:
  F.nat__le_lt_trans(x, VB.pw(k), VB.pw(1n+k), h, F.nat__pow2_lt_succ(k))
def b31n(+x: Nat, +h: {Nat.is_le(x, VB.pw(30n)) == True{} : Bool}) -> {Nat.is_lt(x, VB.pw(31n)) == True{} : Bool}: bsuc(x, 30n, h)
def lsuc(+x: Nat, +k: Nat, +h: {Nat.is_le(x, VB.pw(k)) == True{} : Bool}) -> {Nat.is_le(x, VB.pw(1n+k)) == True{} : Bool}:
  F.nat__lt_le(x, VB.pw(1n+k), bsuc(x, k, h))
def PA(-A: Data, -B: Data, +p: DK.P2(A, B)) -> A:
  (+a, +b) = p
  a
def PB(-A: Data, -B: Data, +p: DK.P2(A, B)) -> B:
  (+a, +b) = p
  b

def u31(+a: Nat, +h: {Nat.is_le(a, VB.pw(31n)) == True{} : Bool}) -> {Nat.is_le(a, U32.to_nat(F.u32__pow2u(31n))) == True{} : Bool}:
  F.logic__subst(Nat, z => {Nat.is_le(a, z) == True{} : Bool}, VB.pw(31n), U32.to_nat(F.u32__pow2u(31n)), Equal.sym(Nat, U32.to_nat(F.u32__pow2u(31n)), VB.pw(31n), F.u32__pow2u_value(31n, {==})), h)

# X + 4 i at byte 4 (s + q) + r.
def ep_off(+X: U32, +i: U32, +q: Nat, +r: Nat, +s: Nat, +e: {U32.to_nat(X) == Nat.add(A.quad(q), r) : Nat}, +ei: {U32.to_nat(i) == s : Nat},
    +hb: {Nat.is_le(Nat.add(Nat.add(A.quad(q), r), A.quad(s)), VB.pw(31n)) == True{} : Bool}) -> {U32.to_nat(AO(X, i)) == Nat.add(A.quad(Nat.add(s, q)), r) : Nat}:
  +X0 = Nat.add(A.quad(q), r)
  +hs = F.nat__le_trans(A.quad(s), Nat.add(X0, A.quad(s)), VB.pw(31n), Order.left_below_sum(X0, A.quad(s)), hb)
  +em = VVU.mul4(i, F.u32__pow2u(31n), u31(A.quad(U32.to_nat(i)), F.logic__subst(Nat, z => {Nat.is_le(A.quad(z), VB.pw(31n)) == True{} : Bool}, s, U32.to_nat(i), Equal.sym(Nat, U32.to_nat(i), s, ei), hs)))
  +em2 = Equal.trans(Nat, U32.to_nat(U32.mul(4, i)), A.quad(U32.to_nat(i)), A.quad(s), em, Equal.cong(Nat, Nat, z => A.quad(z), U32.to_nat(i), s, ei))
  +hsum = F.logic__subst(Nat, z => {Nat.is_le(z, VB.pw(31n)) == True{} : Bool}, Nat.add(X0, A.quad(s)), Nat.add(U32.to_nat(X), U32.to_nat(U32.mul(4, i))),
    Equal.trans(Nat, Nat.add(X0, A.quad(s)), Nat.add(U32.to_nat(X), A.quad(s)), Nat.add(U32.to_nat(X), U32.to_nat(U32.mul(4, i))),
      Equal.cong(Nat, Nat, z => Nat.add(z, A.quad(s)), X0, U32.to_nat(X), Equal.sym(Nat, U32.to_nat(X), X0, e)),
      Equal.cong(Nat, Nat, z => Nat.add(U32.to_nat(X), z), A.quad(s), U32.to_nat(U32.mul(4, i)), Equal.sym(Nat, U32.to_nat(U32.mul(4, i)), A.quad(s), em2))), hb)
  Equal.trans(Nat, U32.to_nat(AO(X, i)), Nat.add(U32.to_nat(X), U32.to_nat(U32.mul(4, i))), Nat.add(A.quad(Nat.add(s, q)), r),
    A.add_le(X, U32.mul(4, i), F.u32__pow2u(31n), u31(Nat.add(U32.to_nat(X), U32.to_nat(U32.mul(4, i))), hsum)),
    Equal.trans(Nat, Nat.add(U32.to_nat(X), U32.to_nat(U32.mul(4, i))), Nat.add(X0, A.quad(s)), Nat.add(A.quad(Nat.add(s, q)), r),
      Equal.trans(Nat, Nat.add(U32.to_nat(X), U32.to_nat(U32.mul(4, i))), Nat.add(X0, U32.to_nat(U32.mul(4, i))), Nat.add(X0, A.quad(s)),
        Equal.cong(Nat, Nat, z => Nat.add(z, U32.to_nat(U32.mul(4, i))), U32.to_nat(X), X0, e), Equal.cong(Nat, Nat, z => Nat.add(X0, z), U32.to_nat(U32.mul(4, i)), A.quad(s), em2)),
      Equal.sym(Nat, Nat.add(A.quad(Nat.add(s, q)), r), Nat.add(X0, A.quad(s)), UW.pos_eq(s, q, r))))

# X + cur at byte X0 + v.
def ep_el(+X: U32, +cur: U32, +X0: Nat, +v: Nat, +e: {U32.to_nat(X) == X0 : Nat}, +ev: {U32.to_nat(cur) == v : Nat},
    +hb: {Nat.is_le(Nat.add(X0, v), VB.pw(31n)) == True{} : Bool}) -> {U32.to_nat(U32.add(X, cur)) == Nat.add(X0, v) : Nat}:
  +e2 = Equal.trans(Nat, Nat.add(U32.to_nat(X), U32.to_nat(cur)), Nat.add(X0, U32.to_nat(cur)), Nat.add(X0, v),
    Equal.cong(Nat, Nat, z => Nat.add(z, U32.to_nat(cur)), U32.to_nat(X), X0, e), Equal.cong(Nat, Nat, z => Nat.add(X0, z), U32.to_nat(cur), v, ev))
  Equal.trans(Nat, U32.to_nat(U32.add(X, cur)), Nat.add(U32.to_nat(X), U32.to_nat(cur)), Nat.add(X0, v),
    A.add_le(X, cur, F.u32__pow2u(31n), u31(Nat.add(U32.to_nat(X), U32.to_nat(cur)), F.logic__subst(Nat, z => {Nat.is_le(z, VB.pw(31n)) == True{} : Bool}, Nat.add(X0, v), Nat.add(U32.to_nat(X), U32.to_nat(cur)), Equal.sym(Nat, Nat.add(U32.to_nat(X), U32.to_nat(cur)), Nat.add(X0, v), e2), hb))),
    e2)

# The zeros under element s's footprint, from the region after offset s.
def el_zero(+dd: Nat, +D: F.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat, +cur: U32, +s: Nat, +W: List<&2, MB<EM.MW>>, +j: Nat, +n: Nat, +pad: Nat,
    +B0: +List<U32>, +LR: Nat, +hX: {Nat.is_le(Nat.add(A.quad(q), r), VE2.LEN(B0)) == True{} : Bool},
    +hLR: {VE2.LEN(VE2.EJ(YS(s, W, 0n), YE(xat_v2_Gc465214E502(W, s)), YS(j, W, 1n+s), A.quad(n), Nat.add(BL(1n+j, W, s), pad))) == LR : Nat},
    +hI: {UA.BYT(D) == UW.SPL(B0, Nat.add(A.quad(q), r), VS.bt(LR, VE2.EJ(YS(s, W, 0n), YE(xat_v2_Gc465214E502(W, s)), YS(j, W, 1n+s), A.quad(n), Nat.add(BL(1n+j, W, s), pad)))) : +List<U32>},
    +epe: {U32.to_nat(U32.add(X, cur)) == Nat.add(Nat.add(A.quad(q), r), VE2.LEN(VE2.PJ(YS(s, W, 0n), YE(xat_v2_Gc465214E502(W, s)), YS(j, W, 1n+s), A.quad(n)))) : Nat},
    +hfp: {Nat.is_le(Nat.add(VE2.LEN(VE2.PJ(YS(s, W, 0n), YE(xat_v2_Gc465214E502(W, s)), YS(j, W, 1n+s), A.quad(n))), FPE(RX(U32.add(X, cur)), xat_v2_Gc465214E502(W, s))), LR) == True{} : Bool},
    +hpz: {Nat.is_le(FPE(RX(U32.add(X, cur)), xat_v2_Gc465214E502(W, s)), Nat.add(BL(1n+j, W, s), pad)) == True{} : Bool})
    -> {VS.bt(FPE(RX(U32.add(X, cur)), xat_v2_Gc465214E502(W, s)), VS.bdr(Nat.add(A.quad(QX(U32.add(X, cur))), RX(U32.add(X, cur))), UA.BYT(D))) == UW.ZB(FPE(RX(U32.add(X, cur)), xat_v2_Gc465214E502(W, s))) : +List<U32>}:
  +x = xat_v2_Gc465214E502(W, s)
  +P = YS(s, W, 0n)
  +y = YE(x)
  +R = YS(j, W, 1n+s)
  +Z = Nat.add(BL(1n+j, W, s), pad)
  +Xe = U32.add(X, cur)
  +X0 = Nat.add(A.quad(q), r)
  +a = VE2.LEN(VE2.PJ(P, y, R, A.quad(n)))
  +E = VE2.EJ(P, y, R, A.quad(n), Z)
  +hE = F.nat__eq_le(LR, VE2.LEN(E), Equal.sym(Nat, VE2.LEN(E), LR, hLR))
  +epos = Equal.trans(Nat, Nat.add(X0, a), U32.to_nat(Xe), Nat.add(A.quad(QX(Xe)), RX(Xe)), Equal.sym(Nat, U32.to_nat(Xe), Nat.add(X0, a), epe), VC.split4(Xe))
  +z0 = UW.inv_zero(B0, X0, LR, E, a, FPE(RX(Xe), x), UA.BYT(D), hX, hI, hfp, hE, VE2.win_el(P, y, R, A.quad(n), Z, FPE(RX(Xe), x), hpz))
  F.logic__subst(Nat, z => {VS.bt(FPE(RX(Xe), x), VS.bdr(z, UA.BYT(D))) == UW.ZB(FPE(RX(Xe), x)) : +List<U32>}, Nat.add(X0, a), Nat.add(A.quad(QX(Xe)), RX(Xe)), epos, z0)

def ST(+D: F.array__Tree<U32>, +t: F.array__Tree<MB<EM.MW>>, +cur: U32) -> Array<U32> & (Array<O.Boxed<VarTestStruct_d.Gc465214E502>> & (U32 & O.Boxed<VarTestStruct_d.Gc465214E502>)):
