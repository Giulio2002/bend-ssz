      +hb2 = F.logic__subst(Nat, z => {Nat.is_le(z, VB.pw(kx)) == True{} : Bool}, Nat.add(U32.to_nat(cur), BL(1n+j, W, s)), Nat.add(Nat.add(U32.to_nat(cur), Nx), BL(j, W, 1n+s)), ea, hb)
