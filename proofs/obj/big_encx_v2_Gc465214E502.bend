      Equal.trans(Nat, U32.to_nat(SZA(j, W, 1n+s, O.padd(cur, NE(x)))), Nat.add(U32.to_nat(O.padd(cur, NE(x))), BL(j, W, 1n+s)), Nat.add(U32.to_nat(cur), BL(1n+j, W, s)), ih,
