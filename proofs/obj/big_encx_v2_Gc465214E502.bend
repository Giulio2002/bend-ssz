# One runtime step: offset s, then element s, then the element swapped back.
def step_rt(+j: Nat, +d: Nat, +t: F.array__Tree<MB<EM.MW>>, +i: U32, +s: Nat, +cur: U32, +dd: Nat, +D: F.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat,
