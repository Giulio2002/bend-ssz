def szwb_val(+b: Bool, +t: F.array__Tree<MB<EM.MW>>, +N: U32, +eb: {U32.is_eq(N, 0) == b : Bool}, +h: {OKL(t, N) == True{} : Bool}, +kx: Nat, +ek: {kx == 30n : Nat},
