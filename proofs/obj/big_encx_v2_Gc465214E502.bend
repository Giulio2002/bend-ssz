    case 0n: True{}
    case 1n+q: Bool.and(EOK(xat_v2_Gc465214E502(W, i)), EOKS(q, W, 1n+i))

# An element's byte count, bytes and value.
def NE(+m: MB<EM.MW>) -> U32:
  match m:
    case MNone{}: 0
    case MSome{+w}: EM.SZ(w)
def YE(+m: MB<EM.MW>) -> +List<U32>:
  match m:
