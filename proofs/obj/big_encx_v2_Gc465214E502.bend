  +L = LLN(n, W)
  +hs = hs_of(s, j, n, ek)
  +hq30 = qk(dd, k, ek30, hd)
  +hLRr = F.nat__le_trans(Nat.add(X0, LR), A.quad(VB.pw(dd)), VB.pw(k), hroom, hq30)
  +hLL = F.logic__subst(Nat, z => {Nat.is_le(L, z) == True{} : Bool}, Nat.add(L, pad), LR, hLR, Order.below_sum(L, pad))
  +hqn = F.nat__le_trans(A.quad(n), L, LR, Order.below_sum(A.quad(n), BL(n, W, 0n)), hLL)
  +h4 = F.logic__subst(Nat, z => {Nat.is_le(z, LR) == True{} : Bool}, A.quad(1n+s), Nat.add(A.quad(s), 4n), F.nat__add_comm(4n, A.quad(s)),
    F.nat__le_trans(A.quad(1n+s), A.quad(n), LR, UW.quad_le(1n+s, n, F.nat__lt_succ_le_succ(s, n, hs)), hqn))
  +hbo = F.nat__le_trans(Nat.add(X0, A.quad(s)), Nat.add(X0, LR), VB.pw(1n+k),
    Order.add_left(X0, A.quad(s), LR, F.nat__le_trans(A.quad(s), Nat.add(A.quad(s), 4n), LR, Order.below_sum(A.quad(s), 4n), h4)), lsuc(Nat.add(X0, LR), k, hLRr))
