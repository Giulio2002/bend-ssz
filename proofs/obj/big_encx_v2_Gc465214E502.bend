# ---- the spec side ---------------------------------------------------------------------------------

def XI(k: Nat, +W: List<&2, MB<EM.MW>>, +i: Nat) -> S.Value:
  match k:
    case 0n: S.EmptyItems{}
    case 1n+q: S.Items{EV(xat_v2_Gc465214E502(W, i)), XI(q, W, 1n+i)}

# The value of the list: its elements' bytes.
def VALL(+t: F.array__Tree<MB<EM.MW>>, +N: U32) -> S.Value: S.Sequence{XI(U32.to_nat(N), SL(t), 0n)}

def dom_ye(+m: MB<EM.MW>, +h: {EOK(m) == True{} : Bool}) -> {SP.bytes_domain(YE(m)) == True{} : Bool}:
  match m:
    case MNone{}: {==}
    case MSome{+w}: EM.domx(w, h)

# One element's spec parts: its bytes, one variable part.
def el_parts(+m: MB<EM.MW>, +h: {EOK(m) == True{} : Bool}) -> {Codec.parts(EV(m), Spec.Gc465214E502()) == Some{[S.Variable{YE(m)}]} : Maybe<&2, +List<S.Part>>}:
  match m:
    case MNone{}: Empty.absurd({Codec.parts(EV(MNone{}), Spec.Gc465214E502()) == Some{[S.Variable{YE(MNone{})}]} : Maybe<&2, +List<S.Part>>}, F.logic__false_true(h))
    case MSome{+w}: EM.encx_spec(w, h)

def parts_go(+k: Nat, +W: List<&2, MB<EM.MW>>, +i: Nat, +hok: {EOKS(k, W, i) == True{} : Bool})
    -> {Codec.parts(XI(k, W, i), S.Repeat{Spec.Gc465214E502()}) == Some{VVL.VP(YS(k, W, i))} : Maybe<&2, +List<S.Part>>}:
  match k:
    case 0n: {==}
    case 1n+ +q:
      +x = xat_v2_Gc465214E502(W, i)
      VS.cat_var(Codec.parts(EV(x), Spec.Gc465214E502()), YE(x), Codec.parts(XI(q, W, 1n+i), S.Repeat{Spec.Gc465214E502()}), VVL.VP(YS(q, W, 1n+i)),
        el_parts(x, and_l(EOK(x), EOKS(q, W, 1n+i), hok)), parts_go(q, W, 1n+i, and_r(EOK(x), EOKS(q, W, 1n+i), hok)))

def count_go(+k: Nat, +W: List<&2, MB<EM.MW>>, +i: Nat) -> {Codec.count(XI(k, W, i)) == k : Nat}:
  match k:
    case 0n: {==}
    case 1n+ +q: Equal.cong(Nat, Nat, z => 1n+z, Codec.count(XI(q, W, 1n+i)), q, count_go(q, W, 1n+i))

def valid_go(+k: Nat, +W: List<&2, MB<EM.MW>>, +i: Nat, +hok: {EOKS(k, W, i) == True{} : Bool}) -> {Layout.bytes_valid(VVL.VP(YS(k, W, i))) == True{} : Bool}:
  match k:
    case 0n: {==}
    case 1n+ +q:
      +x = xat_v2_Gc465214E502(W, i)
      VVL.vp_valid(YE(x), YS(q, W, 1n+i), dom_ye(x, and_l(EOK(x), EOKS(q, W, 1n+i), hok)), valid_go(q, W, 1n+i, and_r(EOK(x), EOKS(q, W, 1n+i), hok)))

# encx_spec: the list's value has its bytes as one variable part, when they fit a tree of depth dx < 30.
def specl(+t: F.array__Tree<MB<EM.MW>>, +N: U32, +h: {OKL(t, N) == True{} : Bool}, +dx: Nat, +hdx: {Nat.is_lt(dx, 30n) == True{} : Bool},
    +hL: {Nat.is_le(LL(t, N), A.quad(VB.pw(dx))) == True{} : Bool})
    -> {Codec.parts(VALL(t, N), S.Vector{Spec.Gc465214E502(), 2n}) == Some{[S.Variable{ENCL(t, N)}]} : Maybe<&2, +List<S.Part>>}:
  +n = U32.to_nat(N)
  +W = SL(t)
