# ==== the list's encoder window ===================================================================

def TDM(t: F.array__Tree<MB<EM.MW>>) -> Nat:
  match t:
    case F.TLeaf{x}: 0n
    case F.TNode{l, r}: 1n+TDM(l)

# The list object Seq{am(t), N} and its facts: a perfect mirror tree of depth < 31 holding the N
# elements, N within the limit, every element's facts.
def THL(+t: F.array__Tree<MB<EM.MW>>, +N: U32) -> vec_VarTestStruct_2_d.v2_Gc465214E502_Seq: vec_VarTestStruct_2_d.v2_Gc465214E502_Seq{AR(t), N}
def OKL(+t: F.array__Tree<MB<EM.MW>>, +N: U32) -> Bool:
  Bool.and(Nat.is_lt(TDM(t), 31n), Bool.and(F.array__perfect(MB<EM.MW>, TDM(t), t), Bool.and(Nat.is_le(U32.to_nat(N), VB.pw(TDM(t))),
    Bool.and(U32.is_eq(N, 2), EOKS(U32.to_nat(N), SL(t), 0n)))))
def okl_d(+t: F.array__Tree<MB<EM.MW>>, +N: U32, +h: {OKL(t, N) == True{} : Bool}) -> {Nat.is_lt(TDM(t), 31n) == True{} : Bool}:
  and_l(Nat.is_lt(TDM(t), 31n), Bool.and(F.array__perfect(MB<EM.MW>, TDM(t), t), Bool.and(Nat.is_le(U32.to_nat(N), VB.pw(TDM(t))), Bool.and(U32.is_eq(N, 2), EOKS(U32.to_nat(N), SL(t), 0n)))), h)
def okl_1(+t: F.array__Tree<MB<EM.MW>>, +N: U32, +h: {OKL(t, N) == True{} : Bool})
    -> {Bool.and(F.array__perfect(MB<EM.MW>, TDM(t), t), Bool.and(Nat.is_le(U32.to_nat(N), VB.pw(TDM(t))), Bool.and(U32.is_eq(N, 2), EOKS(U32.to_nat(N), SL(t), 0n)))) == True{} : Bool}:
  and_r(Nat.is_lt(TDM(t), 31n), Bool.and(F.array__perfect(MB<EM.MW>, TDM(t), t), Bool.and(Nat.is_le(U32.to_nat(N), VB.pw(TDM(t))), Bool.and(U32.is_eq(N, 2), EOKS(U32.to_nat(N), SL(t), 0n)))), h)
def okl_pf(+t: F.array__Tree<MB<EM.MW>>, +N: U32, +h: {OKL(t, N) == True{} : Bool}) -> {F.array__perfect(MB<EM.MW>, TDM(t), t) == True{} : Bool}:
  and_l(F.array__perfect(MB<EM.MW>, TDM(t), t), Bool.and(Nat.is_le(U32.to_nat(N), VB.pw(TDM(t))), Bool.and(U32.is_eq(N, 2), EOKS(U32.to_nat(N), SL(t), 0n))), okl_1(t, N, h))
def okl_2(+t: F.array__Tree<MB<EM.MW>>, +N: U32, +h: {OKL(t, N) == True{} : Bool})
    -> {Bool.and(Nat.is_le(U32.to_nat(N), VB.pw(TDM(t))), Bool.and(U32.is_eq(N, 2), EOKS(U32.to_nat(N), SL(t), 0n))) == True{} : Bool}:
  and_r(F.array__perfect(MB<EM.MW>, TDM(t), t), Bool.and(Nat.is_le(U32.to_nat(N), VB.pw(TDM(t))), Bool.and(U32.is_eq(N, 2), EOKS(U32.to_nat(N), SL(t), 0n))), okl_1(t, N, h))
