def app_dom(+xs: +List<U32>, +ys: +List<U32>, +hx: {SP.bytes_domain(xs) == True{} : Bool}, +hy: {SP.bytes_domain(ys) == True{} : Bool})
    -> {SP.bytes_domain(VE2.APP(xs, ys)) == True{} : Bool}:
  match xs:
    case Nil{}: hy
    case Con{+x, +r}:
      +hx1 = and_l(U32.is_lt(x, 256), SP.bytes_domain(r), hx)
      +hr1 = and_r(U32.is_lt(x, 256), SP.bytes_domain(r), hx)
      %Equal.sym(Bool, U32.is_lt(x, 256), True{}, hx1) : {Bool.and(_, SP.bytes_domain(VE2.APP(r, ys))) == True{} : Bool}
      app_dom(r, ys, hr1, hy)

