    case MSome{+w}: EM.ENC(w)
def EV(+m: MB<EM.MW>) -> S.Value:
  match m:
    case MNone{}: S.EmptyItems{}
    case MSome{+w}: EM.VAL(w)

# The bytes of elements i .. i + k - 1.
def YS(k: Nat, +W: List<&2, MB<EM.MW>>, +i: Nat) -> +List<+List<U32>>:
