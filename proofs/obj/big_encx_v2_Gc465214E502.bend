# The output tree after the element's boxed write at X = 4 q + r.
def PWE(+m: MB<EM.MW>, +dd: Nat, +D: F.array__Tree<U32>, +q: Nat, +r: Nat) -> F.array__Tree<U32>:
  match m:
    case MNone{}: D
    case MSome{+w}: EM.PUTX(w, dd, D, q, r)

# Its footprint: the element's bytes and the zeros to the end of the last word.
def FPE(+r: Nat, +m: MB<EM.MW>) -> Nat: Nat.add(U32.to_nat(NE(m)), WD.PADB(r, U32.to_nat(NE(m))))

