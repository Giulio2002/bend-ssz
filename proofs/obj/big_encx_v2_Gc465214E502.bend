# The region's length after the offset write.
def f_lr1W(+s: Nat, +j: Nat, +n: Nat, +W: List<&2, MB<EM.MW>>, +q: Nat, +r: Nat, +X: U32, +dd: Nat, +pad: Nat, +LR: Nat,
