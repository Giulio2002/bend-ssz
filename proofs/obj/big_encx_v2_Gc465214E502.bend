    +hLR: {Nat.add(LLN(n, W), pad) == LR : Nat}, +hroom: {Nat.is_le(Nat.add(Nat.add(A.quad(q), r), LR), A.quad(VB.pw(dd))) == True{} : Bool}, +k: Nat, +ek30: {k == 30n : Nat}, +h4: {Nat.is_le(Nat.add(A.quad(s), 4n), LR) == True{} : Bool})
    -> {VE2.LEN(VE2.EJ(YS(s, W, 0n), YE(xat_v2_Gc465214E502(W, s)), YS(j, W, 1n+s), A.quad(n), Nat.add(BL(1n+j, W, s), pad))) == LR : Nat}:
  +y = YE(xat_v2_Gc465214E502(W, s))
  +L = LLN(n, W)
  +hLR0 = Equal.trans(Nat, VE2.LEN(EIS(s, 1n+j, W, n, pad)), Nat.add(L, pad), LR, len_eis(s, 1n+j, W, n, pad, ek), hLR)
  +P = YS(s, W, 0n)
  +R = YS(j, W, 1n+s)
  +Z = Nat.add(BL(1n+j, W, s), pad)
  +E0 = EIS(s, 1n+j, W, n, pad)
  +a0 = A.quad(VVL.CNT(P))
  +dg = N.digits(4n, Nat.add(A.quad(n), BL(s, W, 0n)))
  +h4c = F.logic__subst(Nat, z => {Nat.is_le(Nat.add(A.quad(z), 4n), VE2.LEN(E0)) == True{} : Bool}, s, VVL.CNT(P), Equal.sym(Nat, VVL.CNT(P), s, cnt_ys(s, W, 0n)),
    F.logic__subst(Nat, z => {Nat.is_le(Nat.add(A.quad(s), 4n), z) == True{} : Bool}, LR, VE2.LEN(E0), Equal.sym(Nat, VE2.LEN(E0), LR, hLR0), h4))
  +hLR1 = Equal.trans(Nat, VE2.LEN(VE2.EJ(P, y, R, A.quad(n), Z)), VE2.LEN(UW.SPL(E0, a0, dg)), LR,
    Equal.cong(+List<U32>, Nat, z => VE2.LEN(z), VE2.EJ(P, y, R, A.quad(n), Z), UW.SPL(E0, a0, dg), Equal.sym(+List<U32>, UW.SPL(E0, a0, dg), VE2.EJ(P, y, R, A.quad(n), Z), VE2.off_step(P, y, R, A.quad(n), Z))),
    Equal.trans(Nat, VE2.LEN(UW.SPL(E0, a0, dg)), VE2.LEN(E0), LR, UW.len_spl(E0, a0, dg, h4c), hLR0))
  hLR1

def f_lr1(+s: Nat, +j: Nat, +n: Nat, +W: List<&2, MB<EM.MW>>, +q: Nat, +r: Nat, +X: U32, +dd: Nat, +pad: Nat, +LR: Nat,
