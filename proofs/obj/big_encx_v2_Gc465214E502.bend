    case F.TNode{l, r}: 1n+TD(l)

# An element's facts: the element's encoder window's OK.
def EOK(+m: MB<EM.MW>) -> Bool:
  match m:
    case MNone{}: False{}
    case MSome{+w}: EM.OK(w)

# Elements i .. i + k - 1 of W.
def EOKS(k: Nat, +W: List<&2, MB<EM.MW>>, +i: Nat) -> Bool:
