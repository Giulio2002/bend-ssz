def view_app_uitems(+c: Nat, +c2: Nat, +d: Nat, +t: F.array__Tree<U32>, +x0: U32, +x1: U32, +q: Nat, +hq: {q == Nat.double(c) : Nat}, +hc2: {c2 == 1n+c : Nat},
