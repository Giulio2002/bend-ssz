  Equal.trans(S.Value, S.Sequence{items2(c2, F.array__slots(U32, F.array__freeze(U32, F.array__thaw(U32, WW.tk([x0, x1], d2, WR.cpy(d2, t, Kc, 0n, T2), q, 0n)))), 0n)}, VS.seq_append(S.Sequence{items2(c, F.array__slots(U32, F.array__freeze(U32, F.array__thaw(U32, WR.cpy(d2, t, Kc, 0n, T2)))), 0n)}, S.UnsignedValue{P.UInt{x0, x1, 0, 0, 0, 0, 0, 0}}), VS.seq_append(S.Sequence{items2(c, F.array__slots(U32, F.array__freeze(U32, F.array__thaw(U32, t))), 0n)}, S.UnsignedValue{P.UInt{x0, x1, 0, 0, 0, 0, 0, 0}}),
    view_app(c, c2, d2, WR.cpy(d2, t, Kc, 0n, T2), x0, x1, q, hq, hc2, hb, WR.cpy_perfect(d2, t, Kc, 0n, T2, pf2)),
    Equal.cong(S.Value, S.Value, z => VS.seq_append(S.Sequence{z}, S.UnsignedValue{P.UInt{x0, x1, 0, 0, 0, 0, 0, 0}}), items2(c, F.array__slots(U32, F.array__freeze(U32, F.array__thaw(U32, WR.cpy(d2, t, Kc, 0n, T2)))), 0n), items2(c, F.array__slots(U32, F.array__freeze(U32, F.array__thaw(U32, t))), 0n),
      Equal.trans(S.Value, items2(c, F.array__slots(U32, F.array__freeze(U32, F.array__thaw(U32, WR.cpy(d2, t, Kc, 0n, T2)))), 0n), items2(c, F.array__slots(U32, WR.cpy(d2, t, Kc, 0n, T2)), 0n), items2(c, F.array__slots(U32, F.array__freeze(U32, F.array__thaw(U32, t))), 0n),
        Equal.cong(F.array__Tree<U32>, S.Value, z => items2(c, F.array__slots(U32, z), 0n), F.array__freeze(U32, F.array__thaw(U32, WR.cpy(d2, t, Kc, 0n, T2))), WR.cpy(d2, t, Kc, 0n, T2), F.array__freeze_thaw(U32, WR.cpy(d2, t, Kc, 0n, T2))),
        Equal.trans(S.Value, items2(c, F.array__slots(U32, WR.cpy(d2, t, Kc, 0n, T2)), 0n), items2(c, F.array__slots(U32, t), 0n), items2(c, F.array__slots(U32, F.array__freeze(U32, F.array__thaw(U32, t))), 0n),
          items_cong(c, Kc, d2, t, T2, 0n, hcov, hb2, pf2),
          Equal.cong(F.array__Tree<U32>, S.Value, z => items2(c, F.array__slots(U32, z), 0n), t, F.array__freeze(U32, F.array__thaw(U32, t)), Equal.sym(F.array__Tree<U32>, F.array__freeze(U32, F.array__thaw(U32, t)), t, F.array__freeze_thaw(U32, t)))))))

