    {S.Sequence{UL_L.uitems(1n+c, F.array__slots(U32, _))} == VS.seq_append(S.Sequence{UL_L.uitems(c, F.array__slots(U32, F.array__freeze(U32, F.array__thaw(U32, t))))}, S.UnsignedValue{P.UInt{x0, x1, 0, 0, 0, 0, 0, 0}}) : S.Value}
