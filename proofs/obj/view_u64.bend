# the view of the storage after the run is written at word q = Nat.double(c), for one block past the c items: the view before with the new item at the end.
# c' is the element count the view reads after (1 + c).
def view_app(+c: Nat, +c2: Nat, +d: Nat, +t: F.array__Tree<U32>, +x0: U32, +x1: U32, +q: Nat, +hq: {q == Nat.double(c) : Nat}, +hc2: {c2 == 1n+c : Nat},
    +hb: {Nat.is_le(Nat.add(q, 2n), F.spec_common__pow2(d)) == True{} : Bool}, +pf: {F.array__perfect(U32, d, t) == True{} : Bool})
    -> {S.Sequence{items2(c2, F.array__slots(U32, F.array__freeze(U32, F.array__thaw(U32, WW.tk([x0, x1], d, t, q, 0n)))), 0n)} == VS.seq_append(S.Sequence{items2(c, F.array__slots(U32, F.array__freeze(U32, F.array__thaw(U32, t))), 0n)}, S.UnsignedValue{P.UInt{x0, x1, 0, 0, 0, 0, 0, 0}}) : S.Value}:
  %Equal.sym(Nat, c2, 1n+c, hc2) :
    {S.Sequence{items2(_, F.array__slots(U32, F.array__freeze(U32, F.array__thaw(U32, WW.tk([x0, x1], d, t, q, 0n)))), 0n)} == VS.seq_append(S.Sequence{items2(c, F.array__slots(U32, F.array__freeze(U32, F.array__thaw(U32, t))), 0n)}, S.UnsignedValue{P.UInt{x0, x1, 0, 0, 0, 0, 0, 0}}) : S.Value}
  %Equal.sym(F.array__Tree<U32>, F.array__freeze(U32, F.array__thaw(U32, WW.tk([x0, x1], d, t, q, 0n))), WW.tk([x0, x1], d, t, q, 0n), F.array__freeze_thaw(U32, WW.tk([x0, x1], d, t, q, 0n))) :
    {S.Sequence{items2(1n+c, F.array__slots(U32, _), 0n)} == VS.seq_append(S.Sequence{items2(c, F.array__slots(U32, F.array__freeze(U32, F.array__thaw(U32, t))), 0n)}, S.UnsignedValue{P.UInt{x0, x1, 0, 0, 0, 0, 0, 0}}) : S.Value}
  %Equal.sym(F.array__Tree<U32>, F.array__freeze(U32, F.array__thaw(U32, t)), t, F.array__freeze_thaw(U32, t)) :
    {S.Sequence{items2(1n+c, F.array__slots(U32, WW.tk([x0, x1], d, t, q, 0n)), 0n)} == VS.seq_append(S.Sequence{items2(c, F.array__slots(U32, _), 0n)}, S.UnsignedValue{P.UInt{x0, x1, 0, 0, 0, 0, 0, 0}}) : S.Value}
  %Equal.sym(Nat, q, Nat.double(c), hq) :
    {S.Sequence{items2(1n+c, F.array__slots(U32, WW.tk([x0, x1], d, t, _, 0n)), 0n)} == VS.seq_append(S.Sequence{items2(c, F.array__slots(U32, t), 0n)}, S.UnsignedValue{P.UInt{x0, x1, 0, 0, 0, 0, 0, 0}}) : S.Value}
  Equal.cong(S.Value, S.Value, z => S.Sequence{z}, items2(1n+c, F.array__slots(U32, WW.tk([x0, x1], d, t, Nat.double(c), 0n)), 0n), VS.items_snoc(items2(c, F.array__slots(U32, t), 0n), S.UnsignedValue{P.UInt{x0, x1, 0, 0, 0, 0, 0, 0}}),
    items_app(c, d, t, x0, x1, 0n, c, {==}, F.logic__subst(Nat, z => {Nat.is_le(Nat.add(z, 2n), F.spec_common__pow2(d)) == True{} : Bool}, q, Nat.double(c), hq, hb), pf))

# the copy keeps the words of the blocks below 1 + Kc: an element read from the copy is the element of the source
def el_cpy(+Kc: Nat, +d2: Nat, +t: F.array__Tree<U32>, +T2: F.array__Tree<U32>, +i: Nat, +hc: {Nat.is_le(Nat.add(Nat.double(i), 2n), 1n+Kc) == True{} : Bool}, +hb2: {Nat.is_le(Nat.add(0n, 1n+Kc), F.spec_common__pow2(d2)) == True{} : Bool}, +pf2: {F.array__perfect(U32, d2, T2) == True{} : Bool})
    -> {el2(F.array__slots(U32, WR.cpy(d2, t, Kc, 0n, T2)), i) == el2(F.array__slots(U32, t), i) : S.Value}:
  elem_to(F.array__slots(U32, WR.cpy(d2, t, Kc, 0n, T2)), i, MR.wd(F.array__slots(U32, t), Nat.add(Nat.double(i), 0n)), MR.wd(F.array__slots(U32, t), Nat.add(Nat.double(i), 1n)), WW.wd_cpy_in(Kc, Nat.add(Nat.double(i), 0n), d2, t, 0n, T2, F.nat__lt_succ_le(Nat.add(Nat.double(i), 0n), Kc, WR.bound(Nat.double(i), 0n, 2n, 1n+Kc, hc, {==})), hb2, pf2), WW.wd_cpy_in(Kc, Nat.add(Nat.double(i), 1n), d2, t, 0n, T2, F.nat__lt_succ_le(Nat.add(Nat.double(i), 1n), Kc, WR.bound(Nat.double(i), 1n, 2n, 1n+Kc, hc, {==})), hb2, pf2))

def items_cong(+k: Nat, +Kc: Nat, +d2: Nat, +t: F.array__Tree<U32>, +T2: F.array__Tree<U32>, +i0: Nat, +hcov: {Nat.is_le(Nat.double(Nat.add(i0, k)), 1n+Kc) == True{} : Bool}, +hb2: {Nat.is_le(Nat.add(0n, 1n+Kc), F.spec_common__pow2(d2)) == True{} : Bool}, +pf2: {F.array__perfect(U32, d2, T2) == True{} : Bool})
    -> {items2(k, F.array__slots(U32, WR.cpy(d2, t, Kc, 0n, T2)), i0) == items2(k, F.array__slots(U32, t), i0) : S.Value}:
  match k:
    case 0n: {==}
    case 1n+p:
      +hc = F.nat__le_trans(Nat.add(Nat.double(i0), 2n), Nat.double(Nat.add(i0, 1n+p)), 1n+Kc,
        F.logic__subst(Nat, z => {Nat.is_le(z, Nat.double(Nat.add(i0, 1n+p))) == True{} : Bool}, Nat.double(1n+i0), Nat.add(Nat.double(i0), 2n), Equal.sym(Nat, Nat.add(Nat.double(i0), 2n), Nat.double(1n+i0), blk(i0)),
          mono(1n+i0, Nat.add(i0, 1n+p), F.logic__subst(Nat, z => {Nat.is_le(1n+i0, z) == True{} : Bool}, 1n+Nat.add(i0, p), Nat.add(i0, 1n+p), Equal.sym(Nat, Nat.add(i0, 1n+p), 1n+Nat.add(i0, p), F.nat__add_succ(i0, p)), F.nat__le_add_right(i0, p)))),
        hcov)
      %Equal.sym(S.Value, el2(F.array__slots(U32, WR.cpy(d2, t, Kc, 0n, T2)), i0), el2(F.array__slots(U32, t), i0), el_cpy(Kc, d2, t, T2, i0, hc, hb2, pf2)) :
        {S.Items{_, items2(p, F.array__slots(U32, WR.cpy(d2, t, Kc, 0n, T2)), 1n+i0)} == S.Items{el2(F.array__slots(U32, t), i0), items2(p, F.array__slots(U32, t), 1n+i0)} : S.Value}
      %Equal.sym(S.Value, items2(p, F.array__slots(U32, WR.cpy(d2, t, Kc, 0n, T2)), 1n+i0), items2(p, F.array__slots(U32, t), 1n+i0), items_cong(p, Kc, d2, t, T2, 1n+i0, F.logic__subst(Nat, z => {Nat.is_le(Nat.double(z), 1n+Kc) == True{} : Bool}, Nat.add(i0, 1n+p), Nat.add(1n+i0, p), WW.add_shift_plain(i0, p), hcov), hb2, pf2)) :
        {S.Items{el2(F.array__slots(U32, t), i0), _} == S.Items{el2(F.array__slots(U32, t), i0), items2(p, F.array__slots(U32, t), 1n+i0)} : S.Value}
      {==}

# the view after the new item is written into the copy of the storage (Kc + 1 words copied into the tree T2 of depth d2): the view before with the new item at the end
def view_app_grow(+c: Nat, +c2: Nat, +Kc: Nat, +d1: Nat, +d2: Nat, +t: F.array__Tree<U32>, +T2: F.array__Tree<U32>, +x0: U32, +x1: U32, +q: Nat, +hq: {q == Nat.double(c) : Nat}, +hc2: {c2 == 1n+c : Nat}, +hcov: {Nat.is_le(Nat.double(c), 1n+Kc) == True{} : Bool}, +hb: {Nat.is_le(Nat.add(q, 2n), F.spec_common__pow2(d2)) == True{} : Bool}, +hb2: {Nat.is_le(Nat.add(0n, 1n+Kc), F.spec_common__pow2(d2)) == True{} : Bool}, +pf2: {F.array__perfect(U32, d2, T2) == True{} : Bool})
