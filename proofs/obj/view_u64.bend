  %Equal.sym(S.Value, UL_L.uitems(c, F.array__slots(U32, t)), items2(c, F.array__slots(U32, t), 0n), conv_uitems(c, F.array__slots(U32, t), F.logic__subst(Nat, z => {Nat.is_le(Nat.double(c), z) == True{} : Bool}, F.spec_common__pow2(d), F.spec_common__length(U32, F.array__slots(U32, t)), Equal.sym(Nat, F.spec_common__length(U32, F.array__slots(U32, t)), F.spec_common__pow2(d), F.array__slots_length(U32, d, t, pf)), hcap))) :
