def bvp(+v: U32, +h: {CHKv(v) == True{} : Bool}) -> {Codec.parts(VB4(v), S.BitVector{4n}) == Some{[S.Fixed{[v]}]} : Maybe<&2, +List<S.Part>>}:
  match v:
    case U32{WCon{+a0, WCon{+a1, WCon{+a2, WCon{+a3, WCon{+a4, WCon{+a5, WCon{+a6, WCon{+a7, WCon{+a8, WCon{+a9, WCon{+a10, WCon{+a11, WCon{+a12, WCon{+a13, WCon{+a14, WCon{+a15, WCon{+a16, WCon{+a17, WCon{+a18, WCon{+a19, WCon{+a20, WCon{+a21, WCon{+a22, WCon{+a23, WCon{+a24, WCon{+a25, WCon{+a26, WCon{+a27, WCon{+a28, WCon{+a29, WCon{+a30, WCon{+a31, WNil{}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}: z31(a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15, a16, a17, a18, a19, a20, a21, a22, a23, a24, a25, a26, a27, a28, a29, a30, a31, h)

def prt(+d: Nat, +t: FD.array__Tree<U32>, +x: Nat, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hb: {Nat.is_le(Nat.add(x, 4n), A.quad(VB.pw(d))) == True{} : Bool},
    +s: S.Schema, +es: {s == Spec.Schema83() : S.Schema}, +hchk: {CHK(t, x) == True{} : Bool})
    -> {Codec.parts(VAL(t, x), s) == Some{[S.Fixed{UW.WX(t, x, 1n)}]} : Maybe<&2, +List<S.Part>>}:
  %Equal.sym(S.Schema, s, Spec.Schema83(), es) : {Codec.parts(VAL(t, x), _) == Some{[S.Fixed{UW.WX(t, x, 1n)}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(+List<U32>, UW.WX(t, x, 1n), [BX(t, x)], wx1(d, t, x, pf, FD.nat__le_trans(Nat.add(x, 1n), Nat.add(x, 4n), A.quad(VB.pw(d)), Order.add_left(x, 1n, 4n, {==}), hb))) :
    {Codec.parts(VAL(t, x), Spec.Schema83()) == Some{[S.Fixed{_}]} : Maybe<&2, +List<S.Part>>}
  bvp(BX(t, x), hchk)

# CHK of the first byte of a list (False when empty)
def CHKL(ys: +List<U32>) -> Bool:
  match ys:
    case Nil{}: False{}
    case Con{+u, r}: CHKv(u)

def chkl(+L: +List<U32>, +x: Nat, +h: {CHKL(VS.bt(1n, VS.bdr(x, L))) == True{} : Bool}) -> {CHKv(VBL.nthb(L, x)) == True{} : Bool}:
  match L x:
    case Nil{} 0n: Empty.absurd({CHKv(VBL.nthb(Nil{}, 0n)) == True{} : Bool}, FD.logic__false_true(h))
    case Nil{} 1n+ +q: Empty.absurd({CHKv(VBL.nthb(Nil{}, 1n+q)) == True{} : Bool}, FD.logic__false_true(h))
    case Con{+h0, +t0} 0n: h
    case Con{+h0, +t0} 1n+ +q: chkl(t0, q, h)

def fxs(m: Maybe<&2, +List<S.Part>>) -> +List<U32>:
  match m:
    case Some{Con{S.Fixed{xs}, r}}: xs
    case _: []

def chko(+b0: Bool, +b1: Bool, +b2: Bool, +b3: Bool) -> {CHKL([Bp.octet(b0, b1, b2, b3, False{}, False{}, False{}, False{})]) == True{} : Bool}:
  match b0 b1 b2 b3:
    case False{} False{} False{} False{}: {==}
    case False{} False{} False{} True{}: {==}
    case False{} False{} True{} False{}: {==}
    case False{} False{} True{} True{}: {==}
    case False{} True{} False{} False{}: {==}
    case False{} True{} False{} True{}: {==}
    case False{} True{} True{} False{}: {==}
    case False{} True{} True{} True{}: {==}
    case True{} False{} False{} False{}: {==}
    case True{} False{} False{} True{}: {==}
    case True{} False{} True{} False{}: {==}
    case True{} False{} True{} True{}: {==}
    case True{} True{} False{} False{}: {==}
    case True{} True{} False{} True{}: {==}
    case True{} True{} True{} False{}: {==}
    case True{} True{} True{} True{}: {==}

# any bits value whose parts are one fixed part ys: the first byte of ys has bits 4..7 clear
def bvinv(+v: S.Value, +ys: +List<U32>, +e: {Codec.parts(v, S.BitVector{4n}) == Some{[S.Fixed{ys}]} : Maybe<&2, +List<S.Part>>}) -> {CHKL(ys) == True{} : Bool}:
  match v:
    case S.BitsValue{+bs}:
      match bs:
        case Nil{}: Empty.absurd({CHKL(ys) == True{} : Bool}, FD.logic__none_some(+List<S.Part>, [S.Fixed{ys}], e))
        case Con{+b0, +r0}:
          match r0:
            case Nil{}: Empty.absurd({CHKL(ys) == True{} : Bool}, FD.logic__none_some(+List<S.Part>, [S.Fixed{ys}], e))
            case Con{+b1, +r1}:
              match r1:
                case Nil{}: Empty.absurd({CHKL(ys) == True{} : Bool}, FD.logic__none_some(+List<S.Part>, [S.Fixed{ys}], e))
                case Con{+b2, +r2}:
                  match r2:
                    case Nil{}: Empty.absurd({CHKL(ys) == True{} : Bool}, FD.logic__none_some(+List<S.Part>, [S.Fixed{ys}], e))
                    case Con{+b3, +r3}:
                      match r3:
                        case Con{+b4, +r4}: Empty.absurd({CHKL(ys) == True{} : Bool}, FD.logic__none_some(+List<S.Part>, [S.Fixed{ys}], e))
                        case Nil{}:
                          +ey = Equal.cong(Maybe<&2, +List<S.Part>>, +List<U32>, z => fxs(z), Some{[S.Fixed{[Bp.octet(b0, b1, b2, b3, False{}, False{}, False{}, False{})]}]}, Some{[S.Fixed{ys}]}, e)
                          %Equal.sym(+List<U32>, ys, [Bp.octet(b0, b1, b2, b3, False{}, False{}, False{}, False{})], Equal.sym(+List<U32>, [Bp.octet(b0, b1, b2, b3, False{}, False{}, False{}, False{})], ys, ey)) : {CHKL(_) == True{} : Bool}
                          chko(b0, b1, b2, b3)
    case S.BooleanValue{+b}: Empty.absurd({CHKL(ys) == True{} : Bool}, FD.logic__none_some(+List<S.Part>, [S.Fixed{ys}], e))
    case S.UnsignedValue{+u}: Empty.absurd({CHKL(ys) == True{} : Bool}, FD.logic__none_some(+List<S.Part>, [S.Fixed{ys}], e))
    case S.BytesValue{+xs}: Empty.absurd({CHKL(ys) == True{} : Bool}, FD.logic__none_some(+List<S.Part>, [S.Fixed{ys}], e))
    case S.Sequence{+it}: Empty.absurd({CHKL(ys) == True{} : Bool}, FD.logic__none_some(+List<S.Part>, [S.Fixed{ys}], e))
    case S.Items{+hh, +tl}: Empty.absurd({CHKL(ys) == True{} : Bool}, FD.logic__none_some(+List<S.Part>, [S.Fixed{ys}], e))
    case S.EmptyItems{}: Empty.absurd({CHKL(ys) == True{} : Bool}, FD.logic__none_some(+List<S.Part>, [S.Fixed{ys}], e))
    case S.Selected{+sel, +sv}: Empty.absurd({CHKL(ys) == True{} : Bool}, FD.logic__none_some(+List<S.Part>, [S.Fixed{ys}], e))
    case S.NullValue{}: Empty.absurd({CHKL(ys) == True{} : Bool}, FD.logic__none_some(+List<S.Part>, [S.Fixed{ys}], e))

# every value whose parts are the window's byte passes the check
def inv(+t: FD.array__Tree<U32>, +x: Nat, +v: S.Value, +e: {Codec.parts(v, Spec.Schema83()) == Some{[S.Fixed{UW.WX(t, x, 1n)}]} : Maybe<&2, +List<S.Part>>}) -> {CHK(t, x) == True{} : Bool}:
  chkl(UA.BYT(t), x, bvinv(v, UW.WX(t, x, 1n), e))

