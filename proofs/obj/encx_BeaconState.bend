def LNCC(+p: +List<U32>, +t: +List<+List<U32>>) -> {List.length(&2, U32, VCN.CAT(Con{p, t})) == Nat.add(List.length(&2, U32, p), List.length(&2, U32, VCN.CAT(t))) : Nat}: VCN.len_app(p, VCN.CAT(t))
def LNPC(+k: Nat, +xs: +List<U32>) -> {List.length(&2, U32, VCN.PC(k, xs)) == k : Nat}: VCN.len_pc(k, xs)
def LNW(+x: +List<U32>, +n: Nat, +e: {List.length(&2, U32, x) == n : Nat}) -> {VCN.LN(x) == n : Nat}: e

def PA(-A: Data, -B: Data, +p: DK.P2(A, B)) -> A:
  (+a, +b) = p
  a
def PB(-A: Data, -B: Data, +p: DK.P2(A, B)) -> B:
  (+a, +b) = p
  b

# ---- u64: its writer on the object ----
def RW_u64(o: O.U64) -> List<&2, U32>:
  match o:
    case O.U64{+w0, +w1}: [w0, w1]
def PXo_u64(o: O.U64, +dd: Nat, +D: FD.array__Tree<U32>, +q: Nat, +r: Nat) -> FD.array__Tree<U32>:
  match o:
    case O.U64{+w0, +w1}: WD.W64X(r, dd, D, q, w0, w1)
def pfo_u64(+o: O.U64, +dd: Nat, +D: FD.array__Tree<U32>, +q: Nat, +r: Nat, +pf: {FD.array__perfect(U32, dd, D) == True{} : Bool})
    -> {FD.array__perfect(U32, dd, PXo_u64(o, dd, D, q, r)) == True{} : Bool}:
  match o:
    case O.U64{+w0, +w1}: WD.w64x_perfect(r, dd, D, q, w0, w1, pf)
def RTo_u64(+o: O.U64, +dd: Nat, +D: FD.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat) -> Data:
  {uint64_e.u64_put(FD.array__thaw(U32, D), X, o) == FD.array__thaw(U32, PXo_u64(o, dd, D, q, r)) : Array<U32>}
def BYo_u64(+o: O.U64, +dd: Nat, +D: FD.array__Tree<U32>, +q: Nat, +r: Nat) -> Data:
  {UA.BYT(PXo_u64(o, dd, D, q, r)) == UW.SPL(UA.BYT(D), Nat.add(A.quad(q), r), FX.limbs(RW_u64(o))) : +List<U32>}
def putxo_u64W(+o: O.U64, +dd: Nat, +D: FD.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat,
    +e: {U32.to_nat(X) == Nat.add(A.quad(q), r) : Nat}, +hr: {Nat.is_lt(r, 4n) == True{} : Bool}, +hd: {Nat.is_lt(dd, 31n) == True{} : Bool},
    +hl: {Nat.is_le(Nat.add(q, WD.NWN(Nat.add(r, 8n))), VB.pw(dd)) == True{} : Bool}, +pf: {FD.array__perfect(U32, dd, D) == True{} : Bool},
    +hz: {VS.bt(8n, VS.bdr(Nat.add(A.quad(q), r), UA.BYT(D))) == UW.ZB(8n) : +List<U32>})
    -> DK.P2(RTo_u64(o, dd, D, X, q, r), BYo_u64(o, dd, D, q, r)):
  match o:
    case O.U64{+w0, +w1}: (WD.w64_anyW(dd, D, X, q, r, w0, w1, e, hr, hd, hl, pf), WD.w64_any_bytesW(dd, D, X, q, r, w0, w1, e, hr, hd, hl, pf, hz))

def putxo_u64(+o: O.U64, +dd: Nat, +D: FD.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat,
    +e: {U32.to_nat(X) == Nat.add(A.quad(q), r) : Nat}, +hr: {Nat.is_lt(r, 4n) == True{} : Bool}, +hd: {Nat.is_lt(dd, 29n) == True{} : Bool},
    +hl: {Nat.is_le(Nat.add(q, WD.NWN(Nat.add(r, 8n))), VB.pw(dd)) == True{} : Bool}, +pf: {FD.array__perfect(U32, dd, D) == True{} : Bool},
    +hz: {VS.bt(8n, VS.bdr(Nat.add(A.quad(q), r), UA.BYT(D))) == UW.ZB(8n) : +List<U32>})
    -> DK.P2(RTo_u64(o, dd, D, X, q, r), BYo_u64(o, dd, D, q, r)):
  putxo_u64W(o, dd, D, X, q, r, e, hr, FD.nat__lt_trans(dd, 29n, 31n, hd, {==}), hl, pf, hz)
def lenb_u64(+o: O.U64) -> {VCN.LN(FX.limbs(RW_u64(o))) == 8n : Nat}:
