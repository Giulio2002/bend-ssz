def byte_rw_2(+old: U32, +v: U32) -> {U32.and(O.shr_bytes(O.merge_word(old, v, 2, 1), 2), 255) == U32.and(v, 255) : U32}:
  %Equal.sym(U32, U32.and(O.shr_bytes(O.merge_word(old, v, 2, 1), 2), 255), UB.lo8(O.shr_bytes(O.merge_word(old, v, 2, 1), 2)), UB.and255(O.shr_bytes(O.merge_word(old, v, 2, 1), 2))) : {_ == U32.and(v, 255) : U32}
  %Equal.sym(U32, U32.and(v, 255), UB.lo8(v), UB.and255(v)) : {UB.lo8(O.shr_bytes(O.merge_word(old, v, 2, 1), 2)) == _ : U32}
  %Equal.sym(U32, U32.mul(v, 65536), U32.shln(v, 16n), WM.mul65536(v)) : {UB.lo8(O.shr_bytes(U32.or(U32.and(old, U32.not(O.mask_at(2, 1))), U32.and(_, O.mask_at(2, 1))), 2)) == UB.lo8(v) : U32}
  byte_go_2(old, v)

