          %Equal.sym(Bool, Bool.or(Bool.and(x23, True{}), Bool.and(False{}, False{})), x23, UB.sel2(x23, False{})) : {U32{WCon{x16, WCon{x17, WCon{x18, WCon{x19, WCon{x20, WCon{x21, WCon{x22, WCon{_, Word.zero(24n)}}}}}}}}} == U32{WCon{x16, WCon{x17, WCon{x18, WCon{x19, WCon{x20, WCon{x21, WCon{x22, WCon{x23, Word.zero(24n)}}}}}}}}} : U32}
          {==}

def byte_other_3_2(+old: U32, +v: U32) -> {U32.and(O.shr_bytes(O.merge_word(old, v, 3, 1), 2), 255) == U32.and(O.shr_bytes(old, 2), 255) : U32}:
  %Equal.sym(U32, U32.and(O.shr_bytes(O.merge_word(old, v, 3, 1), 2), 255), UB.lo8(O.shr_bytes(O.merge_word(old, v, 3, 1), 2)), UB.and255(O.shr_bytes(O.merge_word(old, v, 3, 1), 2))) : {_ == U32.and(O.shr_bytes(old, 2), 255) : U32}
  %Equal.sym(U32, U32.and(O.shr_bytes(old, 2), 255), UB.lo8(O.shr_bytes(old, 2)), UB.and255(O.shr_bytes(old, 2))) : {UB.lo8(O.shr_bytes(O.merge_word(old, v, 3, 1), 2)) == _ : U32}
  %Equal.sym(U32, U32.mul(v, 16777216), U32.shln(v, 24n), WM.mul16777216(v)) : {UB.lo8(O.shr_bytes(U32.or(U32.and(old, U32.not(O.mask_at(3, 1))), U32.and(_, O.mask_at(3, 1))), 2)) == UB.lo8(O.shr_bytes(old, 2)) : U32}
  byte_ogo_3_2(old, v)

def byte_other_0(+old: U32, +pj: U32, +v: U32, +ne: {U32.is_eq(0, U32.and(pj, 3)) == False{} : Bool}) -> {U32.and(O.shr_bytes(O.merge_word(old, v, 0, 1), U32.and(pj, 3)), 255) == U32.and(O.shr_bytes(old, U32.and(pj, 3)), 255) : U32}:
  match pj:
    case U32{WCon{False{}, WCon{False{}, +r}}}:
      %Equal.sym(Word(30n), Word.and(30n, r, Word.zero(30n)), Word.zero(30n), UB.wand_zero(30n, r)) : {U32.and(O.shr_bytes(O.merge_word(old, v, 0, 1), U32{WCon{False{}, WCon{False{}, _}}}), 255) == U32.and(O.shr_bytes(old, U32{WCon{False{}, WCon{False{}, _}}}), 255) : U32}
      Empty.absurd({U32.and(O.shr_bytes(O.merge_word(old, v, 0, 1), 0), 255) == U32.and(O.shr_bytes(old, 0), 255) : U32}, F.logic__true_false(F.logic__subst(Word(30n), zz => {U32.is_eq(0, U32{WCon{False{}, WCon{False{}, zz}}}) == False{} : Bool}, Word.and(30n, r, Word.zero(30n)), Word.zero(30n), UB.wand_zero(30n, r), ne)))
    case U32{WCon{True{}, WCon{False{}, +r}}}:
      %Equal.sym(Word(30n), Word.and(30n, r, Word.zero(30n)), Word.zero(30n), UB.wand_zero(30n, r)) : {U32.and(O.shr_bytes(O.merge_word(old, v, 0, 1), U32{WCon{True{}, WCon{False{}, _}}}), 255) == U32.and(O.shr_bytes(old, U32{WCon{True{}, WCon{False{}, _}}}), 255) : U32}
      byte_other_0_1(old, v)
    case U32{WCon{False{}, WCon{True{}, +r}}}:
      %Equal.sym(Word(30n), Word.and(30n, r, Word.zero(30n)), Word.zero(30n), UB.wand_zero(30n, r)) : {U32.and(O.shr_bytes(O.merge_word(old, v, 0, 1), U32{WCon{False{}, WCon{True{}, _}}}), 255) == U32.and(O.shr_bytes(old, U32{WCon{False{}, WCon{True{}, _}}}), 255) : U32}
      byte_other_0_2(old, v)
    case U32{WCon{True{}, WCon{True{}, +r}}}:
      %Equal.sym(Word(30n), Word.and(30n, r, Word.zero(30n)), Word.zero(30n), UB.wand_zero(30n, r)) : {U32.and(O.shr_bytes(O.merge_word(old, v, 0, 1), U32{WCon{True{}, WCon{True{}, _}}}), 255) == U32.and(O.shr_bytes(old, U32{WCon{True{}, WCon{True{}, _}}}), 255) : U32}
      byte_other_0_3(old, v)

