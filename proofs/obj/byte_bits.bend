def byte_other_0_1(+old: U32, +v: U32) -> {U32.and(O.shr_bytes(O.merge_word(old, v, 0, 1), 1), 255) == U32.and(O.shr_bytes(old, 1), 255) : U32}:
  %Equal.sym(U32, U32.and(O.shr_bytes(O.merge_word(old, v, 0, 1), 1), 255), UB.lo8(O.shr_bytes(O.merge_word(old, v, 0, 1), 1)), UB.and255(O.shr_bytes(O.merge_word(old, v, 0, 1), 1))) : {_ == U32.and(O.shr_bytes(old, 1), 255) : U32}
