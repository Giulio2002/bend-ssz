      Empty.absurd({U32.and(O.shr_bytes(O.merge_word(old, v, 1, 1), 1), 255) == U32.and(O.shr_bytes(old, 1), 255) : U32}, F.logic__true_false(F.logic__subst(Word(30n), zz => {U32.is_eq(1, U32{WCon{True{}, WCon{False{}, zz}}}) == False{} : Bool}, Word.and(30n, r, Word.zero(30n)), Word.zero(30n), UB.wand_zero(30n, r), ne)))
    case U32{WCon{False{}, WCon{True{}, +r}}}:
      %Equal.sym(Word(30n), Word.and(30n, r, Word.zero(30n)), Word.zero(30n), UB.wand_zero(30n, r)) : {U32.and(O.shr_bytes(O.merge_word(old, v, 1, 1), U32{WCon{False{}, WCon{True{}, _}}}), 255) == U32.and(O.shr_bytes(old, U32{WCon{False{}, WCon{True{}, _}}}), 255) : U32}
