          %Equal.sym(Bool, Bool.or(Bool.and(x26, False{}), Bool.and(y2, True{})), y2, UB.sel(x26, y2)) : {U32{WCon{y0, WCon{y1, WCon{_, WCon{Bool.or(Bool.and(x27, False{}), Bool.and(y3, True{})), WCon{Bool.or(Bool.and(x28, False{}), Bool.and(y4, True{})), WCon{Bool.or(Bool.and(x29, False{}), Bool.and(y5, True{})), WCon{Bool.or(Bool.and(x30, False{}), Bool.and(y6, True{})), WCon{Bool.or(Bool.and(x31, False{}), Bool.and(y7, True{})), Word.zero(24n)}}}}}}}}} == U32{WCon{y0, WCon{y1, WCon{y2, WCon{y3, WCon{y4, WCon{y5, WCon{y6, WCon{y7, Word.zero(24n)}}}}}}}}} : U32}
