# Writing byte p & 3 of a word leaves byte q & 3 != p & 3 as it was: for every word, positions and value.
def byte_other(+old: U32, +p: U32, +pj: U32, +v: U32, +ne: {U32.is_eq(U32.and(p, 3), U32.and(pj, 3)) == False{} : Bool}) -> {U32.and(O.shr_bytes(O.merge_word(old, v, U32.and(p, 3), 1), U32.and(pj, 3)), 255) == U32.and(O.shr_bytes(old, U32.and(pj, 3)), 255) : U32}:
  match p:
    case U32{WCon{False{}, WCon{False{}, +r}}}:
      %Equal.sym(Word(30n), Word.and(30n, r, Word.zero(30n)), Word.zero(30n), UB.wand_zero(30n, r)) : {U32.and(O.shr_bytes(O.merge_word(old, v, U32{WCon{False{}, WCon{False{}, _}}}, 1), U32.and(pj, 3)), 255) == U32.and(O.shr_bytes(old, U32.and(pj, 3)), 255) : U32}
      byte_other_0(old, pj, v, F.logic__subst(Word(30n), zz => {U32.is_eq(U32{WCon{False{}, WCon{False{}, zz}}}, U32.and(pj, 3)) == False{} : Bool}, Word.and(30n, r, Word.zero(30n)), Word.zero(30n), UB.wand_zero(30n, r), ne))
    case U32{WCon{True{}, WCon{False{}, +r}}}:
      %Equal.sym(Word(30n), Word.and(30n, r, Word.zero(30n)), Word.zero(30n), UB.wand_zero(30n, r)) : {U32.and(O.shr_bytes(O.merge_word(old, v, U32{WCon{True{}, WCon{False{}, _}}}, 1), U32.and(pj, 3)), 255) == U32.and(O.shr_bytes(old, U32.and(pj, 3)), 255) : U32}
      byte_other_1(old, pj, v, F.logic__subst(Word(30n), zz => {U32.is_eq(U32{WCon{True{}, WCon{False{}, zz}}}, U32.and(pj, 3)) == False{} : Bool}, Word.and(30n, r, Word.zero(30n)), Word.zero(30n), UB.wand_zero(30n, r), ne))
    case U32{WCon{False{}, WCon{True{}, +r}}}:
      %Equal.sym(Word(30n), Word.and(30n, r, Word.zero(30n)), Word.zero(30n), UB.wand_zero(30n, r)) : {U32.and(O.shr_bytes(O.merge_word(old, v, U32{WCon{False{}, WCon{True{}, _}}}, 1), U32.and(pj, 3)), 255) == U32.and(O.shr_bytes(old, U32.and(pj, 3)), 255) : U32}
      byte_other_2(old, pj, v, F.logic__subst(Word(30n), zz => {U32.is_eq(U32{WCon{False{}, WCon{True{}, zz}}}, U32.and(pj, 3)) == False{} : Bool}, Word.and(30n, r, Word.zero(30n)), Word.zero(30n), UB.wand_zero(30n, r), ne))
    case U32{WCon{True{}, WCon{True{}, +r}}}:
      %Equal.sym(Word(30n), Word.and(30n, r, Word.zero(30n)), Word.zero(30n), UB.wand_zero(30n, r)) : {U32.and(O.shr_bytes(O.merge_word(old, v, U32{WCon{True{}, WCon{True{}, _}}}, 1), U32.and(pj, 3)), 255) == U32.and(O.shr_bytes(old, U32.and(pj, 3)), 255) : U32}
      byte_other_3(old, pj, v, F.logic__subst(Word(30n), zz => {U32.is_eq(U32{WCon{True{}, WCon{True{}, zz}}}, U32.and(pj, 3)) == False{} : Bool}, Word.and(30n, r, Word.zero(30n)), Word.zero(30n), UB.wand_zero(30n, r), ne))
