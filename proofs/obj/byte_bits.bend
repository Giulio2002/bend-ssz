          %Equal.sym(Bool, Bool.or(Bool.and(x17, True{}), Bool.and(False{}, False{})), x17, UB.sel2(x17, False{})) : {U32{WCon{x16, WCon{_, WCon{Bool.or(Bool.and(x18, True{}), Bool.and(False{}, False{})), WCon{Bool.or(Bool.and(x19, True{}), Bool.and(False{}, False{})), WCon{Bool.or(Bool.and(x20, True{}), Bool.and(False{}, False{})), WCon{Bool.or(Bool.and(x21, True{}), Bool.and(False{}, False{})), WCon{Bool.or(Bool.and(x22, True{}), Bool.and(False{}, False{})), WCon{Bool.or(Bool.and(x23, True{}), Bool.and(False{}, False{})), Word.zero(24n)}}}}}}}}} == U32{WCon{x16, WCon{x17, WCon{x18, WCon{x19, WCon{x20, WCon{x21, WCon{x22, WCon{x23, Word.zero(24n)}}}}}}}}} : U32}
          %Equal.sym(Bool, Bool.or(Bool.and(x18, True{}), Bool.and(False{}, False{})), x18, UB.sel2(x18, False{})) : {U32{WCon{x16, WCon{x17, WCon{_, WCon{Bool.or(Bool.and(x19, True{}), Bool.and(False{}, False{})), WCon{Bool.or(Bool.and(x20, True{}), Bool.and(False{}, False{})), WCon{Bool.or(Bool.and(x21, True{}), Bool.and(False{}, False{})), WCon{Bool.or(Bool.and(x22, True{}), Bool.and(False{}, False{})), WCon{Bool.or(Bool.and(x23, True{}), Bool.and(False{}, False{})), Word.zero(24n)}}}}}}}}} == U32{WCon{x16, WCon{x17, WCon{x18, WCon{x19, WCon{x20, WCon{x21, WCon{x22, WCon{x23, Word.zero(24n)}}}}}}}}} : U32}
          %Equal.sym(Bool, Bool.or(Bool.and(x19, True{}), Bool.and(False{}, False{})), x19, UB.sel2(x19, False{})) : {U32{WCon{x16, WCon{x17, WCon{x18, WCon{_, WCon{Bool.or(Bool.and(x20, True{}), Bool.and(False{}, False{})), WCon{Bool.or(Bool.and(x21, True{}), Bool.and(False{}, False{})), WCon{Bool.or(Bool.and(x22, True{}), Bool.and(False{}, False{})), WCon{Bool.or(Bool.and(x23, True{}), Bool.and(False{}, False{})), Word.zero(24n)}}}}}}}}} == U32{WCon{x16, WCon{x17, WCon{x18, WCon{x19, WCon{x20, WCon{x21, WCon{x22, WCon{x23, Word.zero(24n)}}}}}}}}} : U32}
