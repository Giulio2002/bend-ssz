      VB.set_at(dd, D, b, 0, j, U32.or(U32.shrn(UC.RS(ds, S, i), 8n), U32.shln(UC.RS(ds, S, 1n+i), 24n)), eb, VB.lt32(dd, hdd), F.nat__le_lt_trans(Nat.add(0n, j), 7n+j, VB.pw(dd), Order.left_below_sum(7n, j), hj), pfD)) :
    {O.sc1_c1(a, b, UC.RS(ds, S, 1n+i), _, Array.get(U32, F.array__thaw(U32, S), U32.add(a, 2))) == (F.array__thaw(U32, UC.smone(1n, 8n, i, j, dd, ds, D, S)), (F.array__thaw(U32, S), UC.RS(ds, S, 8n+i))) : Array<U32> & (Array<U32> & U32)}
