  for +hds: {Nat.is_lt(ds, 31n) == True{} : Bool}
  for +hi: {Nat.is_le(Nat.add(k, i), VB.pw(ds)) == True{} : Bool}
  for +hj: {Nat.is_le(Nat.add(k, j), VB.pw(dd)) == True{} : Bool}
  for +pfD: {F.array__perfect(U32, dd, D) == True{} : Bool}
  for +pfS: {F.array__perfect(U32, ds, S) == True{} : Bool}
  {O.sc2_tail(k, a, b, (F.array__thaw(U32, D), (F.array__thaw(U32, S), UC.RS(ds, S, i)))) == (F.array__thaw(U32, UC.smone(2n, k, i, j, dd, ds, D, S)), (F.array__thaw(U32, S), UC.RS(ds, S, Nat.add(k, i)))) : Array<U32> & (Array<U32> & U32)}
def sc2tail(k, a, b, i, j, dd, ds, D, S, ea, eb, hdd, hds, hi, hj, pfD, pfS):
  match k:
    case 0n: {==}
    case 1n+ +t:
      +h1 = VB.le1_next(t, i, VB.pw(ds), hi)
      %Equal.sym(Array<U32> & U32, Array.get(U32, F.array__thaw(U32, S), U32.add(a, 1)), (F.array__thaw(U32, S), UC.RS(ds, S, 1n+i)), UC.get_rs(ds, S, U32.add(a, 1), 1n+i, VB.add_le_at(a, 1, i, ds, ea, hds, h1), VB.lt32(ds, hds), h1, pfS)) :
        {O.sc2_tail(t, U32.add(a, 1), U32.add(b, 1), O.sc2_w(b, UC.RS(ds, S, i), F.array__thaw(U32, D), _)) == (F.array__thaw(U32, UC.smone(2n, 1n+t, i, j, dd, ds, D, S)), (F.array__thaw(U32, S), UC.RS(ds, S, Nat.add(1n+t, i)))) : Array<U32> & (Array<U32> & U32)}
      %Equal.sym(U32, U32.mul(UC.RS(ds, S, 1n+i), 65536), U32.shln(UC.RS(ds, S, 1n+i), 16n), WM.mul65536(UC.RS(ds, S, 1n+i))) :
        {O.sc2_tail(t, U32.add(a, 1), U32.add(b, 1), (Array.set(U32, F.array__thaw(U32, D), b, U32.or(U32.shrn(UC.RS(ds, S, i), 16n), _)), (F.array__thaw(U32, S), UC.RS(ds, S, 1n+i)))) == (F.array__thaw(U32, UC.smone(2n, 1n+t, i, j, dd, ds, D, S)), (F.array__thaw(U32, S), UC.RS(ds, S, Nat.add(1n+t, i)))) : Array<U32> & (Array<U32> & U32)}
      %Equal.sym(Array<U32>, Array.set(U32, F.array__thaw(U32, D), b, U32.or(U32.shrn(UC.RS(ds, S, i), 16n), U32.shln(UC.RS(ds, S, 1n+i), 16n))), F.array__thaw(U32, F.array__upd(U32, dd, D, j, U32.or(U32.shrn(UC.RS(ds, S, i), 16n), U32.shln(UC.RS(ds, S, 1n+i), 16n)))),
          VB.set_n(dd, D, b, j, U32.or(U32.shrn(UC.RS(ds, S, i), 16n), U32.shln(UC.RS(ds, S, 1n+i), 16n)), eb, VB.lt32(dd, hdd), VB.le1_head(t, j, VB.pw(dd), hj), pfD)) :
        {O.sc2_tail(t, U32.add(a, 1), U32.add(b, 1), (_, (F.array__thaw(U32, S), UC.RS(ds, S, 1n+i)))) == (F.array__thaw(U32, UC.smone(2n, 1n+t, i, j, dd, ds, D, S)), (F.array__thaw(U32, S), UC.RS(ds, S, Nat.add(1n+t, i)))) : Array<U32> & (Array<U32> & U32)}
      %F.nat__add_succ(t, i) :
        {O.sc2_tail(t, U32.add(a, 1), U32.add(b, 1), (F.array__thaw(U32, F.array__upd(U32, dd, D, j, U32.or(U32.shrn(UC.RS(ds, S, i), 16n), U32.shln(UC.RS(ds, S, 1n+i), 16n)))), (F.array__thaw(U32, S), UC.RS(ds, S, 1n+i)))) == (F.array__thaw(U32, UC.smone(2n, 1n+t, i, j, dd, ds, D, S)), (F.array__thaw(U32, S), UC.RS(ds, S, _))) : Array<U32> & (Array<U32> & U32)}
      sc2tail(t, U32.add(a, 1), U32.add(b, 1), 1n+i, 1n+j, dd, ds, F.array__upd(U32, dd, D, j, U32.or(U32.shrn(UC.RS(ds, S, i), 16n), U32.shln(UC.RS(ds, S, 1n+i), 16n))), S,
        VB.add_le_at(a, 1, i, ds, ea, hds, h1),
        VB.add_le_at(b, 1, j, dd, eb, hdd, VB.le1_next(t, j, VB.pw(dd), hj)),
        hdd, hds, VB.le1_shift(t, i, VB.pw(ds), hi), VB.le1_shift(t, j, VB.pw(dd), hj),
        F.array__upd_perfect(U32, dd, D, j, U32.or(U32.shrn(UC.RS(ds, S, i), 16n), U32.shln(UC.RS(ds, S, 1n+i), 16n)), pfD), pfS)

# The shifted copy at byte 2 writes nw words.
law scopy2_ok:
  for +nw: U32
  for +a: U32
  for +b: U32
  for +i: Nat
  for +j: Nat
  for +dd: Nat
  for +ds: Nat
  for +D: F.array__Tree<U32>
  for +S: F.array__Tree<U32>
  for +ea: {U32.to_nat(a) == i : Nat}
  for +eb: {U32.to_nat(b) == j : Nat}
  for +hdd: {Nat.is_lt(dd, 31n) == True{} : Bool}
  for +hds: {Nat.is_lt(ds, 31n) == True{} : Bool}
  for +hi: {Nat.is_le(Nat.add(U32.to_nat(nw), i), VB.pw(ds)) == True{} : Bool}
  for +hj: {Nat.is_le(Nat.add(U32.to_nat(nw), j), VB.pw(dd)) == True{} : Bool}
  for +pfD: {F.array__perfect(U32, dd, D) == True{} : Bool}
  for +pfS: {F.array__perfect(U32, ds, S) == True{} : Bool}
  {O.scopy2(nw, a, b, F.array__thaw(U32, D), F.array__thaw(U32, S)) == (F.array__thaw(U32, UC.smone(2n, U32.to_nat(nw), i, j, dd, ds, D, S)), F.array__thaw(U32, S)) : Array<U32> & Array<U32>}
def scopy2_ok(nw, a, b, i, j, dd, ds, D, S, ea, eb, hdd, hds, hi, hj, pfD, pfS):
  +q = U32.to_nat(U32.shrn(nw, 3n))
  +A = VS.x8(q)
  +r = U32.to_nat(U32.and(nw, 7))
  +sp = VB.split8(nw)
  +hi2 = F.logic__subst(Nat, z => {Nat.is_le(Nat.add(z, i), VB.pw(ds)) == True{} : Bool}, U32.to_nat(nw), Nat.add(A, r), sp, hi)
  +hj2 = F.logic__subst(Nat, z => {Nat.is_le(Nat.add(z, j), VB.pw(dd)) == True{} : Bool}, U32.to_nat(nw), Nat.add(A, r), sp, hj)
  +hi0 = F.nat__le_trans(i, Nat.add(U32.to_nat(nw), i), VB.pw(ds), Order.left_below_sum(U32.to_nat(nw), i), hi)
  +M = UC.smone(2n, A, i, j, dd, ds, D, S)
  %Equal.sym(Array<U32> & U32, Array.get(U32, F.array__thaw(U32, S), a), (F.array__thaw(U32, S), UC.RS(ds, S, i)), UC.get_rs(ds, S, a, i, ea, VB.lt32(ds, hds), hi0, pfS)) :
    {O.sc_drop(O.sc2_tail(r, U32.sub(U32.add(a, nw), U32.and(nw, 7)), U32.sub(U32.add(b, nw), U32.and(nw, 7)), O.sc2_blk(q, a, b, O.sc_first(F.array__thaw(U32, D), _)))) == (F.array__thaw(U32, UC.smone(2n, U32.to_nat(nw), i, j, dd, ds, D, S)), F.array__thaw(U32, S)) : Array<U32> & Array<U32>}
  %Equal.sym(Array<U32> & (Array<U32> & U32), O.sc2_blk(q, a, b, (F.array__thaw(U32, D), (F.array__thaw(U32, S), UC.RS(ds, S, i)))), (F.array__thaw(U32, M), (F.array__thaw(U32, S), UC.RS(ds, S, Nat.add(A, i)))),
      sc2blk(q, a, b, i, j, dd, ds, D, S, ea, eb, hdd, hds, VB.le_add_r(A, r, i, VB.pw(ds), hi2), VB.le_add_r(A, r, j, VB.pw(dd), hj2), pfD, pfS)) :
    {O.sc_drop(O.sc2_tail(r, U32.sub(U32.add(a, nw), U32.and(nw, 7)), U32.sub(U32.add(b, nw), U32.and(nw, 7)), _)) == (F.array__thaw(U32, UC.smone(2n, U32.to_nat(nw), i, j, dd, ds, D, S)), F.array__thaw(U32, S)) : Array<U32> & Array<U32>}
  %Equal.sym(Array<U32> & (Array<U32> & U32), O.sc2_tail(r, U32.sub(U32.add(a, nw), U32.and(nw, 7)), U32.sub(U32.add(b, nw), U32.and(nw, 7)), (F.array__thaw(U32, M), (F.array__thaw(U32, S), UC.RS(ds, S, Nat.add(A, i))))), (F.array__thaw(U32, UC.smone(2n, r, Nat.add(A, i), Nat.add(A, j), dd, ds, M, S)), (F.array__thaw(U32, S), UC.RS(ds, S, Nat.add(r, Nat.add(A, i))))),
      sc2tail(r, U32.sub(U32.add(a, nw), U32.and(nw, 7)), U32.sub(U32.add(b, nw), U32.and(nw, 7)), Nat.add(A, i), Nat.add(A, j), dd, ds, M, S,
        VB.rest_at(a, nw, i, ds, ea, hds, hi), VB.rest_at(b, nw, j, dd, eb, hdd, hj), hdd, hds,
        VB.le_add_rot(A, r, i, VB.pw(ds), hi2), VB.le_add_rot(A, r, j, VB.pw(dd), hj2), UC.smone_perfect(2n, A, i, j, dd, ds, D, S, pfD), pfS)) :
    {O.sc_drop(_) == (F.array__thaw(U32, UC.smone(2n, U32.to_nat(nw), i, j, dd, ds, D, S)), F.array__thaw(U32, S)) : Array<U32> & Array<U32>}
  %Equal.sym(Nat, U32.to_nat(nw), Nat.add(A, r), sp) :
    {(F.array__thaw(U32, UC.smone(2n, r, Nat.add(A, i), Nat.add(A, j), dd, ds, M, S)), F.array__thaw(U32, S)) == (F.array__thaw(U32, UC.smone(2n, _, i, j, dd, ds, D, S)), F.array__thaw(U32, S)) : Array<U32> & Array<U32>}
  %UC.smone_add(2n, A, r, i, j, dd, ds, D, S) :
    {(F.array__thaw(U32, UC.smone(2n, r, Nat.add(A, i), Nat.add(A, j), dd, ds, M, S)), F.array__thaw(U32, S)) == (F.array__thaw(U32, _), F.array__thaw(U32, S)) : Array<U32> & Array<U32>}
  {==}

def ci_any2(+d: Nat, +t: F.array__Tree<U32>, +n: U32, +off: U32, +i: Nat, +L: U32, +dz: Nat, +k: Nat,
    +pf: {F.array__perfect(U32, d, t) == True{} : Bool}, +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +hdz: {Nat.is_lt(dz, 31n) == True{} : Bool}, +h3: {U32.and(off, 3) == 2 : U32}, +ei: {U32.to_nat(U32.shrn(off, 2n)) == i : Nat}, +hs: {Nat.is_le(Nat.add(VC.NW(L), i), VB.pw(d)) == True{} : Bool}, +hr: {Nat.is_le(Nat.add(VC.NW(L), 0n), VB.pw(dz)) == True{} : Bool}, +hk: {Nat.is_lt(k, 31n) == True{} : Bool}, +hy: {Nat.is_le(VC.YL(L), VB.pw(k)) == True{} : Bool},
    +z: Bool, +ez: {U32.is_eq(L, 0) == z : Bool})
    -> {O.ci_fin(n, L, O.ci_go(z, U32.and(off, 3), U32.shrn(off, 2n), VC.nwu(L), F.array__thaw(U32, VC.ZT(dz)), F.array__thaw(U32, t))) == (B.Buf{F.array__thaw(U32, t), n}, O.Words{F.array__thaw(U32, VBY.MK(L, dz, UC.smone(2n, VC.NW(L), i, 0n, dz, d, VC.ZT(dz), t))), L}) : B.Buf & O.Words}:
  match z:
    case True{}:
      +eL = F.u32alg__eq_of(L, 0, ez)
      %Equal.sym(U32, L, 0, eL) :
        {(B.Buf{F.array__thaw(U32, t), n}, O.Words{O.mask_last(_, F.array__thaw(U32, VC.ZT(dz))), _}) == (B.Buf{F.array__thaw(U32, t), n}, O.Words{F.array__thaw(U32, VBY.MK(_, dz, UC.smone(2n, VC.NW(_), i, 0n, dz, d, VC.ZT(dz), t))), _}) : B.Buf & O.Words}
      {==}
    case False{}:
      +Mo = UC.smone(2n, VC.NW(L), i, 0n, dz, d, VC.ZT(dz), t)
      %Equal.sym(U32, U32.and(off, 3), 2, h3) :
        {O.ci_fin(n, L, O.ci_pick(_, U32.shrn(off, 2n), VC.nwu(L), F.array__thaw(U32, VC.ZT(dz)), F.array__thaw(U32, t))) == (B.Buf{F.array__thaw(U32, t), n}, O.Words{F.array__thaw(U32, VBY.MK(L, dz, Mo)), L}) : B.Buf & O.Words}
      %Equal.sym(Array<U32> & Array<U32>, O.scopy2(VC.nwu(L), U32.shrn(off, 2n), 0, F.array__thaw(U32, VC.ZT(dz)), F.array__thaw(U32, t)),
          (F.array__thaw(U32, Mo), F.array__thaw(U32, t)),
          scopy2_ok(VC.nwu(L), U32.shrn(off, 2n), 0, i, 0n, dz, d, VC.ZT(dz), t, ei, {==}, hdz, hd, hs, hr, F.array__trep_perfect(U32, dz, 0), pf)) :
        {O.ci_fin(n, L, _) == (B.Buf{F.array__thaw(U32, t), n}, O.Words{F.array__thaw(U32, VBY.MK(L, dz, Mo)), L}) : B.Buf & O.Words}
      %Equal.sym(Array<U32>, O.mask_last(L, F.array__thaw(U32, Mo)), F.array__thaw(U32, VBY.MK(L, dz, Mo)),
          VBY.mask_ok(L, dz, Mo, k, hk, hy, VB.lt32(dz, hdz),
            F.logic__subst(Nat, z => {Nat.is_le(z, VB.pw(dz)) == True{} : Bool}, Nat.add(VC.NW(L), 0n), VC.NW(L), F.nat__add_zero(VC.NW(L)), hr),
            UC.smone_perfect(2n, VC.NW(L), i, 0n, dz, d, VC.ZT(dz), t, F.array__trep_perfect(U32, dz, 0)))) :
        {(B.Buf{F.array__thaw(U32, t), n}, O.Words{_, L}) == (B.Buf{F.array__thaw(U32, t), n}, O.Words{F.array__thaw(U32, VBY.MK(L, dz, Mo)), L}) : B.Buf & O.Words}
      {==}

# U2: copy_in of any length L at a byte offset off with off & 3 = 2: the
# words are the joins at byte 2 of the source words from off >> 2, and the
# last one keeps only its L & 3 low bytes (MK); see UC.ci_bytes for its bytes.
law copy_in_ua2:
  for +d: Nat
  for +t: F.array__Tree<U32>
  for +n: U32
  for +off: U32
  for +i: Nat
  for +L: U32
  for +dz: Nat
  for +k: Nat
  for +pf: {F.array__perfect(U32, d, t) == True{} : Bool}
  for +hd: {Nat.is_lt(d, 31n) == True{} : Bool}
  for +hdz: {Nat.is_lt(dz, 31n) == True{} : Bool}
  for +ez: {B.zeros(B.words_depth_u(VC.WZ(L))) == Array.new(U32, dz, 0) : Array<U32>}
  for +h3: {U32.and(off, 3) == 2 : U32}
  for +ei: {U32.to_nat(U32.shrn(off, 2n)) == i : Nat}
  for +hs: {Nat.is_le(Nat.add(VC.NW(L), i), VB.pw(d)) == True{} : Bool}
  for +hr: {Nat.is_le(Nat.add(VC.NW(L), 0n), VB.pw(dz)) == True{} : Bool}
  for +hk: {Nat.is_lt(k, 31n) == True{} : Bool}
  for +hy: {Nat.is_le(VC.YL(L), VB.pw(k)) == True{} : Bool}
  {O.copy_in(B.Buf{F.array__thaw(U32, t), n}, off, L) == (B.Buf{F.array__thaw(U32, t), n}, O.Words{F.array__thaw(U32, VBY.MK(L, dz, UC.smone(2n, VC.NW(L), i, 0n, dz, d, VC.ZT(dz), t))), L}) : B.Buf & O.Words}
def copy_in_ua2(d, t, n, off, i, L, dz, k, pf, hd, hdz, ez, h3, ei, hs, hr, hk, hy):
  %Equal.sym(Array<U32>, B.zeros(B.words_depth_u(VC.WZ(L))), Array.new(U32, dz, 0), ez) :
    {O.copy_into(B.Buf{F.array__thaw(U32, t), n}, off, L, _) == (B.Buf{F.array__thaw(U32, t), n}, O.Words{F.array__thaw(U32, VBY.MK(L, dz, UC.smone(2n, VC.NW(L), i, 0n, dz, d, VC.ZT(dz), t))), L}) : B.Buf & O.Words}
  %Equal.sym(Array<U32>, Array.new(U32, dz, 0), F.array__thaw(U32, VC.ZT(dz)), F.array__new(U32, dz, 0)) :
    {O.copy_into(B.Buf{F.array__thaw(U32, t), n}, off, L, _) == (B.Buf{F.array__thaw(U32, t), n}, O.Words{F.array__thaw(U32, VBY.MK(L, dz, UC.smone(2n, VC.NW(L), i, 0n, dz, d, VC.ZT(dz), t))), L}) : B.Buf & O.Words}
  ci_any2(d, t, n, off, i, L, dz, k, pf, hd, hdz, h3, ei, hs, hr, hk, hy, U32.is_eq(L, 0), {==})

# The same copy into a given zero array (byte 2).
law copy_into_ua2:
  for +d: Nat
  for +t: F.array__Tree<U32>
  for +n: U32
  for +off: U32
  for +i: Nat
  for +L: U32
  for +dz: Nat
  for +k: Nat
  for +pf: {F.array__perfect(U32, d, t) == True{} : Bool}
  for +hd: {Nat.is_lt(d, 31n) == True{} : Bool}
  for +hdz: {Nat.is_lt(dz, 31n) == True{} : Bool}
  for +h3: {U32.and(off, 3) == 2 : U32}
  for +ei: {U32.to_nat(U32.shrn(off, 2n)) == i : Nat}
  for +hs: {Nat.is_le(Nat.add(VC.NW(L), i), VB.pw(d)) == True{} : Bool}
  for +hr: {Nat.is_le(Nat.add(VC.NW(L), 0n), VB.pw(dz)) == True{} : Bool}
  for +hk: {Nat.is_lt(k, 31n) == True{} : Bool}
  for +hy: {Nat.is_le(VC.YL(L), VB.pw(k)) == True{} : Bool}
  {O.copy_into(B.Buf{F.array__thaw(U32, t), n}, off, L, Array.new(U32, dz, 0)) == (B.Buf{F.array__thaw(U32, t), n}, O.Words{F.array__thaw(U32, VBY.MK(L, dz, UC.smone(2n, VC.NW(L), i, 0n, dz, d, VC.ZT(dz), t))), L}) : B.Buf & O.Words}
def copy_into_ua2(d, t, n, off, i, L, dz, k, pf, hd, hdz, h3, ei, hs, hr, hk, hy):
  %Equal.sym(Array<U32>, Array.new(U32, dz, 0), F.array__thaw(U32, VC.ZT(dz)), F.array__new(U32, dz, 0)) :
    {O.copy_into(B.Buf{F.array__thaw(U32, t), n}, off, L, _) == (B.Buf{F.array__thaw(U32, t), n}, O.Words{F.array__thaw(U32, VBY.MK(L, dz, UC.smone(2n, VC.NW(L), i, 0n, dz, d, VC.ZT(dz), t))), L}) : B.Buf & O.Words}
  ci_any2(d, t, n, off, i, L, dz, k, pf, hd, hdz, h3, ei, hs, hr, hk, hy, U32.is_eq(L, 0), {==})

# ---- byte 3 --------------------------------------------------------------------------------

def sc3c7(+a: U32, +b: U32, +i: Nat, +j: Nat, +dd: Nat, +ds: Nat, +D: F.array__Tree<U32>, +S: F.array__Tree<U32>,
    +ea: {U32.to_nat(a) == i : Nat}, +eb: {U32.to_nat(b) == j : Nat},
    +hdd: {Nat.is_lt(dd, 31n) == True{} : Bool}, +hds: {Nat.is_lt(ds, 31n) == True{} : Bool},
    +hi: {Nat.is_le(8n+i, VB.pw(ds)) == True{} : Bool}, +hj: {Nat.is_lt(7n+j, VB.pw(dd)) == True{} : Bool},
    +pfD: {F.array__perfect(U32, dd, D) == True{} : Bool}, +pfS: {F.array__perfect(U32, ds, S) == True{} : Bool})
    -> {O.sc3_c7(a, b, UC.RS(ds, S, 7n+i), F.array__thaw(U32, D), (F.array__thaw(U32, S), UC.RS(ds, S, 8n+i))) == (F.array__thaw(U32, UC.smone(3n, 1n, 7n+i, 7n+j, dd, ds, D, S)), (F.array__thaw(U32, S), UC.RS(ds, S, 8n+i))) : Array<U32> & (Array<U32> & U32)}:
  %Equal.sym(U32, U32.mul(UC.RS(ds, S, 8n+i), 256), U32.shln(UC.RS(ds, S, 8n+i), 8n), WM.mul256(UC.RS(ds, S, 8n+i))) :
    {(Array.set(U32, F.array__thaw(U32, D), U32.add(b, 7), U32.or(U32.shrn(UC.RS(ds, S, 7n+i), 24n), _)), (F.array__thaw(U32, S), UC.RS(ds, S, 8n+i))) == (F.array__thaw(U32, UC.smone(3n, 1n, 7n+i, 7n+j, dd, ds, D, S)), (F.array__thaw(U32, S), UC.RS(ds, S, 8n+i))) : Array<U32> & (Array<U32> & U32)}
  %Equal.sym(Array<U32>, Array.set(U32, F.array__thaw(U32, D), U32.add(b, 7), U32.or(U32.shrn(UC.RS(ds, S, 7n+i), 24n), U32.shln(UC.RS(ds, S, 8n+i), 8n))), F.array__thaw(U32, F.array__upd(U32, dd, D, 7n+j, U32.or(U32.shrn(UC.RS(ds, S, 7n+i), 24n), U32.shln(UC.RS(ds, S, 8n+i), 8n)))),
      VB.set_at(dd, D, b, 7, j, U32.or(U32.shrn(UC.RS(ds, S, 7n+i), 24n), U32.shln(UC.RS(ds, S, 8n+i), 8n)), eb, VB.lt32(dd, hdd), F.nat__le_lt_trans(Nat.add(7n, j), 7n+j, VB.pw(dd), Order.left_below_sum(0n, j), hj), pfD)) :
    {(_, (F.array__thaw(U32, S), UC.RS(ds, S, 8n+i))) == (F.array__thaw(U32, UC.smone(3n, 1n, 7n+i, 7n+j, dd, ds, D, S)), (F.array__thaw(U32, S), UC.RS(ds, S, 8n+i))) : Array<U32> & (Array<U32> & U32)}
  {==}

def sc3c6(+a: U32, +b: U32, +i: Nat, +j: Nat, +dd: Nat, +ds: Nat, +D: F.array__Tree<U32>, +S: F.array__Tree<U32>,
    +ea: {U32.to_nat(a) == i : Nat}, +eb: {U32.to_nat(b) == j : Nat},
    +hdd: {Nat.is_lt(dd, 31n) == True{} : Bool}, +hds: {Nat.is_lt(ds, 31n) == True{} : Bool},
    +hi: {Nat.is_le(8n+i, VB.pw(ds)) == True{} : Bool}, +hj: {Nat.is_lt(7n+j, VB.pw(dd)) == True{} : Bool},
    +pfD: {F.array__perfect(U32, dd, D) == True{} : Bool}, +pfS: {F.array__perfect(U32, ds, S) == True{} : Bool})
    -> {O.sc3_c6(a, b, UC.RS(ds, S, 6n+i), F.array__thaw(U32, D), (F.array__thaw(U32, S), UC.RS(ds, S, 7n+i))) == (F.array__thaw(U32, UC.smone(3n, 2n, 6n+i, 6n+j, dd, ds, D, S)), (F.array__thaw(U32, S), UC.RS(ds, S, 8n+i))) : Array<U32> & (Array<U32> & U32)}:
  %Equal.sym(U32, U32.mul(UC.RS(ds, S, 7n+i), 256), U32.shln(UC.RS(ds, S, 7n+i), 8n), WM.mul256(UC.RS(ds, S, 7n+i))) :
    {O.sc3_c7(a, b, UC.RS(ds, S, 7n+i), Array.set(U32, F.array__thaw(U32, D), U32.add(b, 6), U32.or(U32.shrn(UC.RS(ds, S, 6n+i), 24n), _)), Array.get(U32, F.array__thaw(U32, S), U32.add(a, 8))) == (F.array__thaw(U32, UC.smone(3n, 2n, 6n+i, 6n+j, dd, ds, D, S)), (F.array__thaw(U32, S), UC.RS(ds, S, 8n+i))) : Array<U32> & (Array<U32> & U32)}
  %Equal.sym(Array<U32>, Array.set(U32, F.array__thaw(U32, D), U32.add(b, 6), U32.or(U32.shrn(UC.RS(ds, S, 6n+i), 24n), U32.shln(UC.RS(ds, S, 7n+i), 8n))), F.array__thaw(U32, F.array__upd(U32, dd, D, 6n+j, U32.or(U32.shrn(UC.RS(ds, S, 6n+i), 24n), U32.shln(UC.RS(ds, S, 7n+i), 8n)))),
      VB.set_at(dd, D, b, 6, j, U32.or(U32.shrn(UC.RS(ds, S, 6n+i), 24n), U32.shln(UC.RS(ds, S, 7n+i), 8n)), eb, VB.lt32(dd, hdd), F.nat__le_lt_trans(Nat.add(6n, j), 7n+j, VB.pw(dd), Order.left_below_sum(1n, j), hj), pfD)) :
    {O.sc3_c7(a, b, UC.RS(ds, S, 7n+i), _, Array.get(U32, F.array__thaw(U32, S), U32.add(a, 8))) == (F.array__thaw(U32, UC.smone(3n, 2n, 6n+i, 6n+j, dd, ds, D, S)), (F.array__thaw(U32, S), UC.RS(ds, S, 8n+i))) : Array<U32> & (Array<U32> & U32)}
  %Equal.sym(Array<U32> & U32, Array.get(U32, F.array__thaw(U32, S), U32.add(a, 8)), (F.array__thaw(U32, S), UC.RS(ds, S, 8n+i)),
      UC.get_rs(ds, S, U32.add(a, 8), 8n+i, VB.add_le_at(a, 8, i, ds, ea, hds, hi), VB.lt32(ds, hds), hi, pfS)) :
    {O.sc3_c7(a, b, UC.RS(ds, S, 7n+i), F.array__thaw(U32, F.array__upd(U32, dd, D, 6n+j, U32.or(U32.shrn(UC.RS(ds, S, 6n+i), 24n), U32.shln(UC.RS(ds, S, 7n+i), 8n)))), _) == (F.array__thaw(U32, UC.smone(3n, 2n, 6n+i, 6n+j, dd, ds, D, S)), (F.array__thaw(U32, S), UC.RS(ds, S, 8n+i))) : Array<U32> & (Array<U32> & U32)}
  sc3c7(a, b, i, j, dd, ds, F.array__upd(U32, dd, D, 6n+j, U32.or(U32.shrn(UC.RS(ds, S, 6n+i), 24n), U32.shln(UC.RS(ds, S, 7n+i), 8n))), S, ea, eb, hdd, hds, hi, hj, F.array__upd_perfect(U32, dd, D, 6n+j, U32.or(U32.shrn(UC.RS(ds, S, 6n+i), 24n), U32.shln(UC.RS(ds, S, 7n+i), 8n)), pfD), pfS)

def sc3c5(+a: U32, +b: U32, +i: Nat, +j: Nat, +dd: Nat, +ds: Nat, +D: F.array__Tree<U32>, +S: F.array__Tree<U32>,
    +ea: {U32.to_nat(a) == i : Nat}, +eb: {U32.to_nat(b) == j : Nat},
    +hdd: {Nat.is_lt(dd, 31n) == True{} : Bool}, +hds: {Nat.is_lt(ds, 31n) == True{} : Bool},
