# The eight-word loop at byte 3 writes 8k words.
law sc3blk:
  for +k: Nat
  for +a: U32
  for +b: U32
  for +i: Nat
  for +j: Nat
  for +dd: Nat
  for +ds: Nat
  for +D: F.array__Tree<U32>
  for +S: F.array__Tree<U32>
  for +ea: {U32.to_nat(a) == i : Nat}
  for +eb: {U32.to_nat(b) == j : Nat}
  for +hdd: {Nat.is_lt(dd, 31n) == True{} : Bool}
  for +hds: {Nat.is_lt(ds, 31n) == True{} : Bool}
  for +hi: {Nat.is_le(Nat.add(VS.x8(k), i), VB.pw(ds)) == True{} : Bool}
  for +hj: {Nat.is_le(Nat.add(VS.x8(k), j), VB.pw(dd)) == True{} : Bool}
  for +pfD: {F.array__perfect(U32, dd, D) == True{} : Bool}
  for +pfS: {F.array__perfect(U32, ds, S) == True{} : Bool}
  {O.sc3_blk(k, a, b, (F.array__thaw(U32, D), (F.array__thaw(U32, S), UC.RS(ds, S, i)))) == (F.array__thaw(U32, UC.smone(3n, VS.x8(k), i, j, dd, ds, D, S)), (F.array__thaw(U32, S), UC.RS(ds, S, Nat.add(VS.x8(k), i)))) : Array<U32> & (Array<U32> & U32)}
def sc3blk(k, a, b, i, j, dd, ds, D, S, ea, eb, hdd, hds, hi, hj, pfD, pfS):
  match k:
    case 0n: {==}
    case 1n+ +t:
      +h8 = VB.le8_head(VS.x8(t), i, VB.pw(ds), hi)
      +h1 = F.nat__le_trans(1n+i, 8n+i, VB.pw(ds), Order.left_below_sum(7n, i), h8)
      %Equal.sym(Array<U32> & U32, Array.get(U32, F.array__thaw(U32, S), U32.add(a, 1)), (F.array__thaw(U32, S), UC.RS(ds, S, 1n+i)), UC.get_rs(ds, S, U32.add(a, 1), 1n+i, VB.add_le_at(a, 1, i, ds, ea, hds, h1), VB.lt32(ds, hds), h1, pfS)) :
        {O.sc3_blk(t, U32.add(a, 8), U32.add(b, 8), O.sc3_c0(a, b, UC.RS(ds, S, i), F.array__thaw(U32, D), _)) == (F.array__thaw(U32, UC.smone(3n, VS.x8(1n+t), i, j, dd, ds, D, S)), (F.array__thaw(U32, S), UC.RS(ds, S, Nat.add(VS.x8(1n+t), i)))) : Array<U32> & (Array<U32> & U32)}
      %Equal.sym(Array<U32> & (Array<U32> & U32), O.sc3_c0(a, b, UC.RS(ds, S, i), F.array__thaw(U32, D), (F.array__thaw(U32, S), UC.RS(ds, S, 1n+i))), (F.array__thaw(U32, UC.smone(3n, 8n, i, j, dd, ds, D, S)), (F.array__thaw(U32, S), UC.RS(ds, S, 8n+i))),
          sc3c0(a, b, i, j, dd, ds, D, S, ea, eb, hdd, hds, h8, VB.lt8(7n, VS.x8(t), j, VB.pw(dd), {==}, hj), pfD, pfS)) :
        {O.sc3_blk(t, U32.add(a, 8), U32.add(b, 8), _) == (F.array__thaw(U32, UC.smone(3n, VS.x8(1n+t), i, j, dd, ds, D, S)), (F.array__thaw(U32, S), UC.RS(ds, S, Nat.add(VS.x8(1n+t), i)))) : Array<U32> & (Array<U32> & U32)}
      %F.lru_nat_algebra__add_swap(VS.x8(t), 8n, i) :
        {O.sc3_blk(t, U32.add(a, 8), U32.add(b, 8), (F.array__thaw(U32, UC.smone(3n, 8n, i, j, dd, ds, D, S)), (F.array__thaw(U32, S), UC.RS(ds, S, 8n+i)))) == (F.array__thaw(U32, UC.smone(3n, VS.x8(1n+t), i, j, dd, ds, D, S)), (F.array__thaw(U32, S), UC.RS(ds, S, _))) : Array<U32> & (Array<U32> & U32)}
      sc3blk(t, U32.add(a, 8), U32.add(b, 8), 8n+i, 8n+j, dd, ds, UC.smone(3n, 8n, i, j, dd, ds, D, S), S,
        VB.add_le_at(a, 8, i, ds, ea, hds, h8),
        VB.add_le_at(b, 8, j, dd, eb, hdd, VB.le8_head(VS.x8(t), j, VB.pw(dd), hj)),
        hdd, hds, VB.le8_shift(VS.x8(t), i, VB.pw(ds), hi), VB.le8_shift(VS.x8(t), j, VB.pw(dd), hj),
        UC.smone_perfect(3n, 8n, i, j, dd, ds, D, S, pfD), pfS)

