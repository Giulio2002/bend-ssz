    {O.sc3_c2(a, b, UC.RS(ds, S, 2n+i), F.array__thaw(U32, F.array__upd(U32, dd, D, 1n+j, U32.or(U32.shrn(UC.RS(ds, S, 1n+i), 24n), U32.shln(UC.RS(ds, S, 2n+i), 8n)))), _) == (F.array__thaw(U32, UC.smone(3n, 7n, 1n+i, 1n+j, dd, ds, D, S)), (F.array__thaw(U32, S), UC.RS(ds, S, 8n+i))) : Array<U32> & (Array<U32> & U32)}
  sc3c2(a, b, i, j, dd, ds, F.array__upd(U32, dd, D, 1n+j, U32.or(U32.shrn(UC.RS(ds, S, 1n+i), 24n), U32.shln(UC.RS(ds, S, 2n+i), 8n))), S, ea, eb, hdd, hds, hi, hj, F.array__upd_perfect(U32, dd, D, 1n+j, U32.or(U32.shrn(UC.RS(ds, S, 1n+i), 24n), U32.shln(UC.RS(ds, S, 2n+i), 8n)), pfD), pfS)

def sc3c0(+a: U32, +b: U32, +i: Nat, +j: Nat, +dd: Nat, +ds: Nat, +D: F.array__Tree<U32>, +S: F.array__Tree<U32>,
