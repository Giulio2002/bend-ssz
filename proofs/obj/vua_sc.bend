      VB.set_at(dd, D, b, 1, j, U32.or(U32.shrn(UC.RS(ds, S, 1n+i), 8n), U32.shln(UC.RS(ds, S, 2n+i), 24n)), eb, VB.lt32(dd, hdd), F.nat__le_lt_trans(Nat.add(1n, j), 7n+j, VB.pw(dd), Order.left_below_sum(6n, j), hj), pfD)) :
    {O.sc1_c2(a, b, UC.RS(ds, S, 2n+i), _, Array.get(U32, F.array__thaw(U32, S), U32.add(a, 3))) == (F.array__thaw(U32, UC.smone(1n, 7n, 1n+i, 1n+j, dd, ds, D, S)), (F.array__thaw(U32, S), UC.RS(ds, S, 8n+i))) : Array<U32> & (Array<U32> & U32)}
