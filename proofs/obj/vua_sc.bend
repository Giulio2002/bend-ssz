def scopy3_ok(nw, a, b, i, j, dd, ds, D, S, ea, eb, hdd, hds, hi, hj, pfD, pfS):
  +q = U32.to_nat(U32.shrn(nw, 3n))
  +A = VS.x8(q)
  +r = U32.to_nat(U32.and(nw, 7))
  +sp = VB.split8(nw)
  +hi2 = F.logic__subst(Nat, z => {Nat.is_le(Nat.add(z, i), VB.pw(ds)) == True{} : Bool}, U32.to_nat(nw), Nat.add(A, r), sp, hi)
  +hj2 = F.logic__subst(Nat, z => {Nat.is_le(Nat.add(z, j), VB.pw(dd)) == True{} : Bool}, U32.to_nat(nw), Nat.add(A, r), sp, hj)
  +hi0 = F.nat__le_trans(i, Nat.add(U32.to_nat(nw), i), VB.pw(ds), Order.left_below_sum(U32.to_nat(nw), i), hi)
  +M = UC.smone(3n, A, i, j, dd, ds, D, S)
  %Equal.sym(Array<U32> & U32, Array.get(U32, F.array__thaw(U32, S), a), (F.array__thaw(U32, S), UC.RS(ds, S, i)), UC.get_rs(ds, S, a, i, ea, VB.lt32(ds, hds), hi0, pfS)) :
    {O.sc_drop(O.sc3_tail(r, U32.sub(U32.add(a, nw), U32.and(nw, 7)), U32.sub(U32.add(b, nw), U32.and(nw, 7)), O.sc3_blk(q, a, b, O.sc_first(F.array__thaw(U32, D), _)))) == (F.array__thaw(U32, UC.smone(3n, U32.to_nat(nw), i, j, dd, ds, D, S)), F.array__thaw(U32, S)) : Array<U32> & Array<U32>}
  %Equal.sym(Array<U32> & (Array<U32> & U32), O.sc3_blk(q, a, b, (F.array__thaw(U32, D), (F.array__thaw(U32, S), UC.RS(ds, S, i)))), (F.array__thaw(U32, M), (F.array__thaw(U32, S), UC.RS(ds, S, Nat.add(A, i)))),
      sc3blk(q, a, b, i, j, dd, ds, D, S, ea, eb, hdd, hds, VB.le_add_r(A, r, i, VB.pw(ds), hi2), VB.le_add_r(A, r, j, VB.pw(dd), hj2), pfD, pfS)) :
    {O.sc_drop(O.sc3_tail(r, U32.sub(U32.add(a, nw), U32.and(nw, 7)), U32.sub(U32.add(b, nw), U32.and(nw, 7)), _)) == (F.array__thaw(U32, UC.smone(3n, U32.to_nat(nw), i, j, dd, ds, D, S)), F.array__thaw(U32, S)) : Array<U32> & Array<U32>}
  %Equal.sym(Array<U32> & (Array<U32> & U32), O.sc3_tail(r, U32.sub(U32.add(a, nw), U32.and(nw, 7)), U32.sub(U32.add(b, nw), U32.and(nw, 7)), (F.array__thaw(U32, M), (F.array__thaw(U32, S), UC.RS(ds, S, Nat.add(A, i))))), (F.array__thaw(U32, UC.smone(3n, r, Nat.add(A, i), Nat.add(A, j), dd, ds, M, S)), (F.array__thaw(U32, S), UC.RS(ds, S, Nat.add(r, Nat.add(A, i))))),
      sc3tail(r, U32.sub(U32.add(a, nw), U32.and(nw, 7)), U32.sub(U32.add(b, nw), U32.and(nw, 7)), Nat.add(A, i), Nat.add(A, j), dd, ds, M, S,
        VB.rest_at(a, nw, i, ds, ea, hds, hi), VB.rest_at(b, nw, j, dd, eb, hdd, hj), hdd, hds,
        VB.le_add_rot(A, r, i, VB.pw(ds), hi2), VB.le_add_rot(A, r, j, VB.pw(dd), hj2), UC.smone_perfect(3n, A, i, j, dd, ds, D, S, pfD), pfS)) :
    {O.sc_drop(_) == (F.array__thaw(U32, UC.smone(3n, U32.to_nat(nw), i, j, dd, ds, D, S)), F.array__thaw(U32, S)) : Array<U32> & Array<U32>}
  %Equal.sym(Nat, U32.to_nat(nw), Nat.add(A, r), sp) :
    {(F.array__thaw(U32, UC.smone(3n, r, Nat.add(A, i), Nat.add(A, j), dd, ds, M, S)), F.array__thaw(U32, S)) == (F.array__thaw(U32, UC.smone(3n, _, i, j, dd, ds, D, S)), F.array__thaw(U32, S)) : Array<U32> & Array<U32>}
  %UC.smone_add(3n, A, r, i, j, dd, ds, D, S) :
    {(F.array__thaw(U32, UC.smone(3n, r, Nat.add(A, i), Nat.add(A, j), dd, ds, M, S)), F.array__thaw(U32, S)) == (F.array__thaw(U32, _), F.array__thaw(U32, S)) : Array<U32> & Array<U32>}
  {==}

def ci_any3(+d: Nat, +t: F.array__Tree<U32>, +n: U32, +off: U32, +i: Nat, +L: U32, +dz: Nat, +k: Nat,
    +pf: {F.array__perfect(U32, d, t) == True{} : Bool}, +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +hdz: {Nat.is_lt(dz, 31n) == True{} : Bool}, +h3: {U32.and(off, 3) == 3 : U32}, +ei: {U32.to_nat(U32.shrn(off, 2n)) == i : Nat}, +hs: {Nat.is_le(Nat.add(VC.NW(L), i), VB.pw(d)) == True{} : Bool}, +hr: {Nat.is_le(Nat.add(VC.NW(L), 0n), VB.pw(dz)) == True{} : Bool}, +hk: {Nat.is_lt(k, 31n) == True{} : Bool}, +hy: {Nat.is_le(VC.YL(L), VB.pw(k)) == True{} : Bool},
    +z: Bool, +ez: {U32.is_eq(L, 0) == z : Bool})
    -> {O.ci_fin(n, L, O.ci_go(z, U32.and(off, 3), U32.shrn(off, 2n), VC.nwu(L), F.array__thaw(U32, VC.ZT(dz)), F.array__thaw(U32, t))) == (B.Buf{F.array__thaw(U32, t), n}, O.Words{F.array__thaw(U32, VBY.MK(L, dz, UC.smone(3n, VC.NW(L), i, 0n, dz, d, VC.ZT(dz), t))), L}) : B.Buf & O.Words}:
  match z:
    case True{}:
      +eL = F.u32alg__eq_of(L, 0, ez)
      %Equal.sym(U32, L, 0, eL) :
        {(B.Buf{F.array__thaw(U32, t), n}, O.Words{O.mask_last(_, F.array__thaw(U32, VC.ZT(dz))), _}) == (B.Buf{F.array__thaw(U32, t), n}, O.Words{F.array__thaw(U32, VBY.MK(_, dz, UC.smone(3n, VC.NW(_), i, 0n, dz, d, VC.ZT(dz), t))), _}) : B.Buf & O.Words}
      {==}
    case False{}:
      +Mo = UC.smone(3n, VC.NW(L), i, 0n, dz, d, VC.ZT(dz), t)
      %Equal.sym(U32, U32.and(off, 3), 3, h3) :
        {O.ci_fin(n, L, O.ci_pick(_, U32.shrn(off, 2n), VC.nwu(L), F.array__thaw(U32, VC.ZT(dz)), F.array__thaw(U32, t))) == (B.Buf{F.array__thaw(U32, t), n}, O.Words{F.array__thaw(U32, VBY.MK(L, dz, Mo)), L}) : B.Buf & O.Words}
      %Equal.sym(Array<U32> & Array<U32>, O.scopy3(VC.nwu(L), U32.shrn(off, 2n), 0, F.array__thaw(U32, VC.ZT(dz)), F.array__thaw(U32, t)),
          (F.array__thaw(U32, Mo), F.array__thaw(U32, t)),
          scopy3_ok(VC.nwu(L), U32.shrn(off, 2n), 0, i, 0n, dz, d, VC.ZT(dz), t, ei, {==}, hdz, hd, hs, hr, F.array__trep_perfect(U32, dz, 0), pf)) :
        {O.ci_fin(n, L, _) == (B.Buf{F.array__thaw(U32, t), n}, O.Words{F.array__thaw(U32, VBY.MK(L, dz, Mo)), L}) : B.Buf & O.Words}
      %Equal.sym(Array<U32>, O.mask_last(L, F.array__thaw(U32, Mo)), F.array__thaw(U32, VBY.MK(L, dz, Mo)),
          VBY.mask_ok(L, dz, Mo, k, hk, hy, VB.lt32(dz, hdz),
            F.logic__subst(Nat, z => {Nat.is_le(z, VB.pw(dz)) == True{} : Bool}, Nat.add(VC.NW(L), 0n), VC.NW(L), F.nat__add_zero(VC.NW(L)), hr),
            UC.smone_perfect(3n, VC.NW(L), i, 0n, dz, d, VC.ZT(dz), t, F.array__trep_perfect(U32, dz, 0)))) :
        {(B.Buf{F.array__thaw(U32, t), n}, O.Words{_, L}) == (B.Buf{F.array__thaw(U32, t), n}, O.Words{F.array__thaw(U32, VBY.MK(L, dz, Mo)), L}) : B.Buf & O.Words}
      {==}

# U2: copy_in of any length L at a byte offset off with off & 3 = 3: the
# words are the joins at byte 3 of the source words from off >> 2, and the
# last one keeps only its L & 3 low bytes (MK); see UC.ci_bytes for its bytes.
law copy_in_ua3:
  for +d: Nat
  for +t: F.array__Tree<U32>
  for +n: U32
  for +off: U32
  for +i: Nat
  for +L: U32
  for +dz: Nat
  for +k: Nat
  for +pf: {F.array__perfect(U32, d, t) == True{} : Bool}
  for +hd: {Nat.is_lt(d, 31n) == True{} : Bool}
  for +hdz: {Nat.is_lt(dz, 31n) == True{} : Bool}
  for +ez: {B.zeros(B.words_depth_u(VC.WZ(L))) == Array.new(U32, dz, 0) : Array<U32>}
  for +h3: {U32.and(off, 3) == 3 : U32}
  for +ei: {U32.to_nat(U32.shrn(off, 2n)) == i : Nat}
  for +hs: {Nat.is_le(Nat.add(VC.NW(L), i), VB.pw(d)) == True{} : Bool}
  for +hr: {Nat.is_le(Nat.add(VC.NW(L), 0n), VB.pw(dz)) == True{} : Bool}
  for +hk: {Nat.is_lt(k, 31n) == True{} : Bool}
  for +hy: {Nat.is_le(VC.YL(L), VB.pw(k)) == True{} : Bool}
  {O.copy_in(B.Buf{F.array__thaw(U32, t), n}, off, L) == (B.Buf{F.array__thaw(U32, t), n}, O.Words{F.array__thaw(U32, VBY.MK(L, dz, UC.smone(3n, VC.NW(L), i, 0n, dz, d, VC.ZT(dz), t))), L}) : B.Buf & O.Words}
def copy_in_ua3(d, t, n, off, i, L, dz, k, pf, hd, hdz, ez, h3, ei, hs, hr, hk, hy):
  %Equal.sym(Array<U32>, B.zeros(B.words_depth_u(VC.WZ(L))), Array.new(U32, dz, 0), ez) :
    {O.copy_into(B.Buf{F.array__thaw(U32, t), n}, off, L, _) == (B.Buf{F.array__thaw(U32, t), n}, O.Words{F.array__thaw(U32, VBY.MK(L, dz, UC.smone(3n, VC.NW(L), i, 0n, dz, d, VC.ZT(dz), t))), L}) : B.Buf & O.Words}
  %Equal.sym(Array<U32>, Array.new(U32, dz, 0), F.array__thaw(U32, VC.ZT(dz)), F.array__new(U32, dz, 0)) :
    {O.copy_into(B.Buf{F.array__thaw(U32, t), n}, off, L, _) == (B.Buf{F.array__thaw(U32, t), n}, O.Words{F.array__thaw(U32, VBY.MK(L, dz, UC.smone(3n, VC.NW(L), i, 0n, dz, d, VC.ZT(dz), t))), L}) : B.Buf & O.Words}
  ci_any3(d, t, n, off, i, L, dz, k, pf, hd, hdz, h3, ei, hs, hr, hk, hy, U32.is_eq(L, 0), {==})

# The same copy into a given zero array (byte 3).
law copy_into_ua3:
  for +d: Nat
  for +t: F.array__Tree<U32>
  for +n: U32
  for +off: U32
  for +i: Nat
  for +L: U32
  for +dz: Nat
  for +k: Nat
  for +pf: {F.array__perfect(U32, d, t) == True{} : Bool}
  for +hd: {Nat.is_lt(d, 31n) == True{} : Bool}
  for +hdz: {Nat.is_lt(dz, 31n) == True{} : Bool}
  for +h3: {U32.and(off, 3) == 3 : U32}
  for +ei: {U32.to_nat(U32.shrn(off, 2n)) == i : Nat}
  for +hs: {Nat.is_le(Nat.add(VC.NW(L), i), VB.pw(d)) == True{} : Bool}
  for +hr: {Nat.is_le(Nat.add(VC.NW(L), 0n), VB.pw(dz)) == True{} : Bool}
  for +hk: {Nat.is_lt(k, 31n) == True{} : Bool}
  for +hy: {Nat.is_le(VC.YL(L), VB.pw(k)) == True{} : Bool}
  {O.copy_into(B.Buf{F.array__thaw(U32, t), n}, off, L, Array.new(U32, dz, 0)) == (B.Buf{F.array__thaw(U32, t), n}, O.Words{F.array__thaw(U32, VBY.MK(L, dz, UC.smone(3n, VC.NW(L), i, 0n, dz, d, VC.ZT(dz), t))), L}) : B.Buf & O.Words}
def copy_into_ua3(d, t, n, off, i, L, dz, k, pf, hd, hdz, h3, ei, hs, hr, hk, hy):
  %Equal.sym(Array<U32>, Array.new(U32, dz, 0), F.array__thaw(U32, VC.ZT(dz)), F.array__new(U32, dz, 0)) :
    {O.copy_into(B.Buf{F.array__thaw(U32, t), n}, off, L, _) == (B.Buf{F.array__thaw(U32, t), n}, O.Words{F.array__thaw(U32, VBY.MK(L, dz, UC.smone(3n, VC.NW(L), i, 0n, dz, d, VC.ZT(dz), t))), L}) : B.Buf & O.Words}
  ci_any3(d, t, n, off, i, L, dz, k, pf, hd, hdz, h3, ei, hs, hr, hk, hy, U32.is_eq(L, 0), {==})

