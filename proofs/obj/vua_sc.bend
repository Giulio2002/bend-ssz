    {O.sc1_c2(a, b, UC.RS(ds, S, 2n+i), F.array__thaw(U32, F.array__upd(U32, dd, D, 1n+j, U32.or(U32.shrn(UC.RS(ds, S, 1n+i), 8n), U32.shln(UC.RS(ds, S, 2n+i), 24n)))), _) == (F.array__thaw(U32, UC.smone(1n, 7n, 1n+i, 1n+j, dd, ds, D, S)), (F.array__thaw(U32, S), UC.RS(ds, S, 8n+i))) : Array<U32> & (Array<U32> & U32)}
