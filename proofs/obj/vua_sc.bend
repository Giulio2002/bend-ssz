        {O.sc3_tail(t, U32.add(a, 1), U32.add(b, 1), (Array.set(U32, F.array__thaw(U32, D), b, U32.or(U32.shrn(UC.RS(ds, S, i), 24n), _)), (F.array__thaw(U32, S), UC.RS(ds, S, 1n+i)))) == (F.array__thaw(U32, UC.smone(3n, 1n+t, i, j, dd, ds, D, S)), (F.array__thaw(U32, S), UC.RS(ds, S, Nat.add(1n+t, i)))) : Array<U32> & (Array<U32> & U32)}
      %Equal.sym(Array<U32>, Array.set(U32, F.array__thaw(U32, D), b, U32.or(U32.shrn(UC.RS(ds, S, i), 24n), U32.shln(UC.RS(ds, S, 1n+i), 8n))), F.array__thaw(U32, F.array__upd(U32, dd, D, j, U32.or(U32.shrn(UC.RS(ds, S, i), 24n), U32.shln(UC.RS(ds, S, 1n+i), 8n)))),
          VB.set_n(dd, D, b, j, U32.or(U32.shrn(UC.RS(ds, S, i), 24n), U32.shln(UC.RS(ds, S, 1n+i), 8n)), eb, VB.lt32(dd, hdd), VB.le1_head(t, j, VB.pw(dd), hj), pfD)) :
        {O.sc3_tail(t, U32.add(a, 1), U32.add(b, 1), (_, (F.array__thaw(U32, S), UC.RS(ds, S, 1n+i)))) == (F.array__thaw(U32, UC.smone(3n, 1n+t, i, j, dd, ds, D, S)), (F.array__thaw(U32, S), UC.RS(ds, S, Nat.add(1n+t, i)))) : Array<U32> & (Array<U32> & U32)}
      %F.nat__add_succ(t, i) :
        {O.sc3_tail(t, U32.add(a, 1), U32.add(b, 1), (F.array__thaw(U32, F.array__upd(U32, dd, D, j, U32.or(U32.shrn(UC.RS(ds, S, i), 24n), U32.shln(UC.RS(ds, S, 1n+i), 8n)))), (F.array__thaw(U32, S), UC.RS(ds, S, 1n+i)))) == (F.array__thaw(U32, UC.smone(3n, 1n+t, i, j, dd, ds, D, S)), (F.array__thaw(U32, S), UC.RS(ds, S, _))) : Array<U32> & (Array<U32> & U32)}
      sc3tail(t, U32.add(a, 1), U32.add(b, 1), 1n+i, 1n+j, dd, ds, F.array__upd(U32, dd, D, j, U32.or(U32.shrn(UC.RS(ds, S, i), 24n), U32.shln(UC.RS(ds, S, 1n+i), 8n))), S,
        VB.add_le_at(a, 1, i, ds, ea, hds, h1),
        VB.add_le_at(b, 1, j, dd, eb, hdd, VB.le1_next(t, j, VB.pw(dd), hj)),
