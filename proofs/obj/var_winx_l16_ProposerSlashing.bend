      +hL32 = FD.logic__subst(Nat, z => {Nat.is_lt(z, FD.spec_common__pow2(32n)) == True{} : Bool}, Nat.add(x, U32.to_nat(len)), Nat.add(U32.to_nat(len), x), FD.nat__add_comm(x, U32.to_nat(len)), hw32)
      +hLc32 = FD.logic__subst(Nat, z => {Nat.is_lt(Nat.add(z, x), FD.spec_common__pow2(32n)) == True{} : Bool}, U32.to_nat(len), Nat.mul(c, 416n), ec, hL32)
      +hb32 = FD.logic__subst(Nat, z => {Nat.is_lt(VRL.pos(z, 416n, x), FD.spec_common__pow2(32n)) == True{} : Bool}, c, Nat.add(1n+k, 0n),
        Equal.trans(Nat, c, 1n+k, Nat.add(1n+k, 0n), Equal.sym(Nat, 1n+k, c, e1), Equal.sym(Nat, Nat.add(1n+k, 0n), 1n+k, FD.nat__add_zero(1n+k))), hLc32)
      +hb0 = FD.nat__le_trans(Nat.add(x, 416n), Nat.add(x, U32.to_nat(len)), P,
        Order.add_left(x, 416n, U32.to_nat(len), FD.logic__subst(Nat, z => {Nat.is_le(416n, z) == True{} : Bool}, Nat.mul(c, 416n), U32.to_nat(len), Equal.sym(Nat, U32.to_nat(len), Nat.mul(c, 416n), ec),
          FD.logic__subst(Nat, z => {Nat.is_le(416n, Nat.mul(z, 416n)) == True{} : Bool}, 1n+k, c, e1, Order.below_sum(416n, Nat.mul(k, 416n))))), hw)
      %Equal.sym(B.Buf & O.Boxed<FuluProposerSlashing_d.ProposerSlashing>, FuluProposerSlashing_r.ProposerSlashing_bx_read(BF(t, n), off, 416), (BF(t, n), RX(t, x)), VXB.rdbxd_ProposerSlashing(d, t, n, off, x, eo, hd, pf, hb0)) :
        {Fulu_list_ProposerSlashing_16_r.l16_ProposerSlashing_rd_fin(NN(len), Fulu_list_ProposerSlashing_16_r.l16_ProposerSlashing_rd(k, 0, off, Fulu_list_ProposerSlashing_16_d.l16_ProposerSlashing_fill(Fulu_list_ProposerSlashing_16_d.l16_ProposerSlashing_cap(NN(len))), _)) == (BF(t, n), LOBJ(False{}, t, x, len)) : B.Buf & Fulu_list_ProposerSlashing_16_d.l16_ProposerSlashing_Seq}
      %Equal.sym(B.Buf & Array<O.Boxed<FuluProposerSlashing_d.ProposerSlashing>>, Fulu_list_ProposerSlashing_16_r.l16_ProposerSlashing_rd(k, 0, off, Fulu_list_ProposerSlashing_16_d.l16_ProposerSlashing_fill(Fulu_list_ProposerSlashing_16_d.l16_ProposerSlashing_cap(NN(len))), (BF(t, n), RX(t, x))), (BF(t, n), RT(k, 0, 0n, Fulu_list_ProposerSlashing_16_d.l16_ProposerSlashing_fill(Fulu_list_ProposerSlashing_16_d.l16_ProposerSlashing_cap(NN(len))), t, x)),
