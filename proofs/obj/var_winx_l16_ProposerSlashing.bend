# the records j, j + 1, ..., j + k set into the runtime storage A from index i on
def RT(k: Nat, +i: U32, +j: Nat, A: Array<O.Boxed<FuluProposerSlashing_d.ProposerSlashing>>, +t: FD.array__Tree<U32>, +x: Nat) -> Array<O.Boxed<FuluProposerSlashing_d.ProposerSlashing>>:
  match k:
    case 0n: Array.set(O.Boxed<FuluProposerSlashing_d.ProposerSlashing>, A, i, RX(t, VRL.pos(j, 416n, x)))
    case 1n+q: RT(q, U32.add(i, 1), 1n+j, Array.set(O.Boxed<FuluProposerSlashing_d.ProposerSlashing>, A, i, RX(t, VRL.pos(j, 416n, x))), t, x)

# ---- the validator ------------------------------------------------------------------------------

def CHKw(+t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32) -> Bool:
  Bool.and(U32.is_eq(len, (U32.div(len, 416) * 416 : U32)), U32.is_le(U32.div(len, 416), 16))

def ok_evalwD(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +hw32: {Nat.is_lt(Nat.add(x, U32.to_nat(len)), FD.spec_common__pow2(32n)) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}) -> {Fulu_list_ProposerSlashing_16_r.l16_ProposerSlashing_ok(BF(t, n), off, len) == (BF(t, n), CHKw(t, x, off, len)) : B.Buf & Bool}:
  {==}

def vR() -> Word(31n): FD.spec_numeric__from_nat(31n, 416n)

# The window is c whole records, c <= 16.
def NN(+len: U32) -> U32: U32.div(len, 416)
def CC(+len: U32) -> Nat: U32.to_nat(NN(len))
def ecw(+len: U32, +h: {Bool.and(U32.is_eq(len, (U32.div(len, 416) * 416 : U32)), U32.is_le(U32.div(len, 416), 16)) == True{} : Bool})
    -> {U32.to_nat(len) == Nat.mul(CC(len), 416n) : Nat}:
  Pair.fst({U32.to_nat(len) == Nat.mul(CC(len), U32.to_nat(416)) : Nat}, {Nat.is_le(CC(len), U32.to_nat(16)) == True{} : Bool}, VU.whole_t(len, 416, 16, vR(), {==}, {==}, {==}, h))
def hcw(+len: U32, +h: {Bool.and(U32.is_eq(len, (U32.div(len, 416) * 416 : U32)), U32.is_le(U32.div(len, 416), 16)) == True{} : Bool})
    -> {Nat.is_le(CC(len), U32.to_nat(16)) == True{} : Bool}:
  Pair.snd({U32.to_nat(len) == Nat.mul(CC(len), U32.to_nat(416)) : Nat}, {Nat.is_le(CC(len), U32.to_nat(16)) == True{} : Bool}, VU.whole_t(len, 416, 16, vR(), {==}, {==}, {==}, h))

# ---- the reader ---------------------------------------------------------------------------------

def LOBJ(e: Bool, +t: FD.array__Tree<U32>, +x: Nat, +len: U32) -> Fulu_list_ProposerSlashing_16_d.l16_ProposerSlashing_Seq:
  match e:
    case True{}: Fulu_list_ProposerSlashing_16_d.l16_ProposerSlashing_Seq{Fulu_list_ProposerSlashing_16_d.l16_ProposerSlashing_fill(0n), 0}
    case False{}: Fulu_list_ProposerSlashing_16_d.l16_ProposerSlashing_Seq{RT(U32.to_nat(U32.sub(NN(len), 1)), 0, 0n, Fulu_list_ProposerSlashing_16_d.l16_ProposerSlashing_fill(Fulu_list_ProposerSlashing_16_d.l16_ProposerSlashing_cap(NN(len))), t, x), NN(len)}
def OBJw(+d: Nat, +t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32) -> Fulu_list_ProposerSlashing_16_d.l16_ProposerSlashing_Seq: LOBJ(U32.is_eq(len, 0), t, x, len)

# The read loop from record j (index i) on.
def lp(k: Nat, +d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +i: U32, +j: Nat, A: Array<O.Boxed<FuluProposerSlashing_d.ProposerSlashing>>,
    +eo: {U32.to_nat(off) == x : Nat}, +ej: {U32.to_nat(i) == j : Nat}, +hd: {Nat.is_lt(d, 31n) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hb: {Nat.is_le(VRL.pos(Nat.add(1n+k, j), 416n, x), A.quad(VB.pw(d))) == True{} : Bool}, +hb32: {Nat.is_lt(VRL.pos(Nat.add(1n+k, j), 416n, x), FD.spec_common__pow2(32n)) == True{} : Bool})
    -> {Fulu_list_ProposerSlashing_16_r.l16_ProposerSlashing_rd(k, i, off, A, (BF(t, n), RX(t, VRL.pos(j, 416n, x)))) == (BF(t, n), RT(k, i, j, A, t, x)) : B.Buf & Array<O.Boxed<FuluProposerSlashing_d.ProposerSlashing>>}:
  match k:
    case 0n: {==}
    case 1n+ +q:
      +hb2 = FD.logic__subst(Nat, z => {Nat.is_le(VRL.pos(1n+z, 416n, x), A.quad(VB.pw(d))) == True{} : Bool}, 1n+Nat.add(q, j), Nat.add(q, 1n+j), Equal.sym(Nat, Nat.add(q, 1n+j), 1n+Nat.add(q, j), FD.nat__add_succ(q, j)), hb)
      +hx = VRL.nextfit(j, q, 416n, x, A.quad(VB.pw(d)), hb)
      +hx32 = FD.nat__le_lt_trans(Nat.add(VRL.pos(1n+j, 416n, x), 416n), VRL.pos(Nat.add(2n+q, j), 416n, x), FD.spec_common__pow2(32n),
        VRL.nextfit(j, q, 416n, x, VRL.pos(Nat.add(2n+q, j), 416n, x), FD.nat__le_refl(VRL.pos(Nat.add(2n+q, j), 416n, x))), hb32)
      +hb232 = FD.logic__subst(Nat, z => {Nat.is_lt(VRL.pos(1n+z, 416n, x), FD.spec_common__pow2(32n)) == True{} : Bool}, 1n+Nat.add(q, j), Nat.add(q, 1n+j), Equal.sym(Nat, Nat.add(q, 1n+j), 1n+Nat.add(q, j), FD.nat__add_succ(q, j)), hb32)
      +ex = VRL.posU32(off, x, i, j, 416, 415n, {==}, eo, ej, hx32)
      %Equal.sym(B.Buf & O.Boxed<FuluProposerSlashing_d.ProposerSlashing>, FuluProposerSlashing_r.ProposerSlashing_bx_read(BF(t, n), U32.add(off, U32.mul(U32.add(i, 1), 416)), 416), (BF(t, n), RX(t, VRL.pos(1n+j, 416n, x))),
          VXB.rdbxd_ProposerSlashing(d, t, n, U32.add(off, U32.mul(U32.add(i, 1), 416)), VRL.pos(1n+j, 416n, x), ex, hd, pf, hx)) :
        {Fulu_list_ProposerSlashing_16_r.l16_ProposerSlashing_rd(q, U32.add(i, 1), off, Array.set(O.Boxed<FuluProposerSlashing_d.ProposerSlashing>, A, i, RX(t, VRL.pos(j, 416n, x))), _) == (BF(t, n), RT(1n+q, i, j, A, t, x)) : B.Buf & Array<O.Boxed<FuluProposerSlashing_d.ProposerSlashing>>}
      lp(q, d, t, n, x, off, U32.add(i, 1), 1n+j, Array.set(O.Boxed<FuluProposerSlashing_d.ProposerSlashing>, A, i, RX(t, VRL.pos(j, 416n, x))), eo, VRL.succU32(i, j, 415n, x, ej, hx32), hd, pf, hb2, hb232)

# A non-empty window holds c >= 1 records.
def cpos(+len: U32, +c: Nat, +ec: {U32.to_nat(len) == Nat.mul(c, 416n) : Nat}, +eb: {U32.is_eq(len, 0) == False{} : Bool})
    -> {Nat.is_le(1n, c) == True{} : Bool}:
  match c:
    case 0n: Empty.absurd({Nat.is_le(1n, 0n) == True{} : Bool}, FD.logic__true_false(Equal.trans(Bool, True{}, U32.is_eq(len, 0), False{},
      Equal.sym(Bool, U32.is_eq(len, 0), True{}, FD.u32alg__eq_true(len, 0, FD.u32__injective(len, 0, ec))), eb)))
    case 1n+ +p: FD.nat__zero_le(p)

def rd_go(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat},
