# ---- the spec side ------------------------------------------------------------------------------

def RITEMS(c: Nat, +t: FD.array__Tree<U32>, +y: Nat) -> S.Value:
  match c:
    case 0n: S.EmptyItems{}
    case 1n+q: S.Items{RVAL(t, y), RITEMS(q, t, Nat.add(416n, y))}

def RIT1(+q: Nat, +t: FD.array__Tree<U32>, +y: Nat) -> {S.Items{RVAL(t, y), RITEMS(q, t, Nat.add(416n, y))} == RITEMS(1n+q, t, y) : S.Value}:
  {==}

def CHUNKS(c: Nat, +t: FD.array__Tree<U32>, +y: Nat) -> +List<+List<U32>>:
  match c:
    case 0n: []
    case 1n+q: Con{UR.RWS(104n, t, y), CHUNKS(q, t, Nat.add(416n, y))}

law cnt_items:
  for +c: Nat
  for +t: FD.array__Tree<U32>
  for +y: Nat
  {Codec.count(RITEMS(c, t, y)) == c : Nat}
def cnt_items(c, t, y):
  match c:
    case 0n: {==}
    case 1n+ +q: FD.nat__succ_cong(Codec.count(RITEMS(q, t, Nat.add(416n, y))), q, cnt_items(q, t, Nat.add(416n, y)))

law prt_items:
  for +c: Nat
  for +t: FD.array__Tree<U32>
  for +y: Nat
  {Codec.parts(RITEMS(c, t, y), S.Repeat{S.Container{["signed_header_1", "signed_header_2"], S.Chain{S.Container{["message", "signature"], S.Chain{S.Container{["slot", "proposer_index", "parent_root", "state_root", "body_root"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.End{}}}}}}}, S.Chain{S.ByteVector{96n}, S.End{}}}}, S.Chain{S.Container{["message", "signature"], S.Chain{S.Container{["slot", "proposer_index", "parent_root", "state_root", "body_root"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.End{}}}}}}}, S.Chain{S.ByteVector{96n}, S.End{}}}}, S.End{}}}}}) == Some{F.fparts(CHUNKS(c, t, y))} : Maybe<&2, +List<S.Part>>}
def prt_items(c, t, y):
  match c:
    case 0n: {==}
    case 1n+ +q:
      %RIT1(q, t, y) : {Codec.parts(_, S.Repeat{S.Container{["signed_header_1", "signed_header_2"], S.Chain{S.Container{["message", "signature"], S.Chain{S.Container{["slot", "proposer_index", "parent_root", "state_root", "body_root"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.End{}}}}}}}, S.Chain{S.ByteVector{96n}, S.End{}}}}, S.Chain{S.Container{["message", "signature"], S.Chain{S.Container{["slot", "proposer_index", "parent_root", "state_root", "body_root"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.End{}}}}}}}, S.Chain{S.ByteVector{96n}, S.End{}}}}, S.End{}}}}}) == Some{F.fparts(CHUNKS(1n+q, t, y))} : Maybe<&2, +List<S.Part>>}
      F.items_rep(RVAL(t, y), RITEMS(q, t, Nat.add(416n, y)), S.Container{["signed_header_1", "signed_header_2"], S.Chain{S.Container{["message", "signature"], S.Chain{S.Container{["slot", "proposer_index", "parent_root", "state_root", "body_root"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.End{}}}}}}}, S.Chain{S.ByteVector{96n}, S.End{}}}}, S.Chain{S.Container{["message", "signature"], S.Chain{S.Container{["slot", "proposer_index", "parent_root", "state_root", "body_root"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.End{}}}}}}}, S.Chain{S.ByteVector{96n}, S.End{}}}}, S.End{}}}}, F.limbs(UR.RWS(104n, t, y)),
        F.fparts(CHUNKS(q, t, Nat.add(416n, y))), RPRF(t, y), prt_items(q, t, Nat.add(416n, y)))

law flat_chunks:
  for +c: Nat
  for +d: Nat
  for +t: FD.array__Tree<U32>
  for +y: Nat
  for +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}
  for +h: {Nat.is_le(Nat.add(y, Nat.mul(c, 416n)), A.quad(VB.pw(d))) == True{} : Bool}
  {F.flat(CHUNKS(c, t, y)) == UW.WX(t, y, Nat.mul(c, 416n)) : +List<U32>}
def flat_chunks(c, d, t, y, pf, h):
  match c:
    case 0n: {==}
    case 1n+ +q:
      +M = Nat.mul(q, 416n)
      +e = Equal.trans(Nat, Nat.add(Nat.add(416n, y), M), Nat.add(416n, Nat.add(y, M)), Nat.add(y, Nat.add(416n, M)),
        FD.nat__add_assoc(416n, y, M), FD.lru_nat_algebra__add_swap(416n, y, M))
      +h2 = FD.logic__subst(Nat, z => {Nat.is_le(z, A.quad(VB.pw(d))) == True{} : Bool}, Nat.add(y, Nat.add(416n, M)), Nat.add(Nat.add(416n, y), M), Equal.sym(Nat, Nat.add(Nat.add(416n, y), M), Nat.add(y, Nat.add(416n, M)), e), h)
      %Equal.sym(+List<U32>, F.flat(CHUNKS(q, t, Nat.add(416n, y))), UW.WX(t, Nat.add(416n, y), M), flat_chunks(q, d, t, Nat.add(416n, y), pf, h2)) :
        {List.append(&2, U32, F.limbs(UR.RWS(104n, t, y)), _) == UW.WX(t, y, Nat.mul(1n+q, 416n)) : +List<U32>}
      Equal.sym(+List<U32>, UW.WX(t, y, Nat.add(A.quad(104n), M)), List.append(&2, U32, F.limbs(UR.RWS(104n, t, y)), UW.WX(t, Nat.add(A.quad(104n), y), M)), UW.headWX(d, t, y, 104n, M, pf, h))

def VALw(+t: FD.array__Tree<U32>, +x: Nat, +len: U32) -> S.Value: S.Sequence{RITEMS(CC(len), t, x)}

def specwD(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +hw32: {Nat.is_lt(Nat.add(x, U32.to_nat(len)), FD.spec_common__pow2(32n)) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hchk: {CHKw(t, x, off, len) == True{} : Bool})
    -> {Codec.parts(VALw(t, x, len), S.ListOf{S.Container{["signed_header_1", "signed_header_2"], S.Chain{S.Container{["message", "signature"], S.Chain{S.Container{["slot", "proposer_index", "parent_root", "state_root", "body_root"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.End{}}}}}}}, S.Chain{S.ByteVector{96n}, S.End{}}}}, S.Chain{S.Container{["message", "signature"], S.Chain{S.Container{["slot", "proposer_index", "parent_root", "state_root", "body_root"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.End{}}}}}}}, S.Chain{S.ByteVector{96n}, S.End{}}}}, S.End{}}}}, U32.to_nat(16)}) == Some{[S.Variable{UW.WX(t, x, U32.to_nat(len))}]} : Maybe<&2, +List<S.Part>>}:
  +c = CC(len)
  +ec = ecw(len, hchk)
  +hf = FD.logic__subst(Nat, z => {Nat.is_le(Nat.add(x, z), A.quad(VB.pw(d))) == True{} : Bool}, U32.to_nat(len), Nat.mul(c, 416n), ec, hw)
  +hf32 = FD.logic__subst(Nat, z => {Nat.is_lt(Nat.add(x, z), FD.spec_common__pow2(32n)) == True{} : Bool}, U32.to_nat(len), Nat.mul(c, 416n), ec, hw32)
  +fl = flat_chunks(c, d, t, x, pf, hf)
  +fit = FD.logic__subst(+List<U32>, z => {N.fits(4n, List.length(&2, U32, z)) == True{} : Bool}, UW.WX(t, x, Nat.mul(c, 416n)), F.flat(CHUNKS(c, t, x)), Equal.sym(+List<U32>, F.flat(CHUNKS(c, t, x)), UW.WX(t, x, Nat.mul(c, 416n)), fl),
    FD.logic__subst(Nat, z => {N.fits(4n, z) == True{} : Bool}, Nat.mul(c, 416n), List.length(&2, U32, UW.WX(t, x, Nat.mul(c, 416n))), Equal.sym(Nat, List.length(&2, U32, UW.WX(t, x, Nat.mul(c, 416n))), Nat.mul(c, 416n), UW.lenWX(d, t, x, Nat.mul(c, 416n), pf, hf)),
      VFT.fits4lt(Nat.mul(c, 416n), FD.nat__le_lt_trans(Nat.mul(c, 416n), Nat.add(x, Nat.mul(c, 416n)), FD.spec_common__pow2(32n), Order.left_below_sum(x, Nat.mul(c, 416n)), hf32))))
  %Equal.sym(Nat, Codec.count(RITEMS(c, t, x)), c, cnt_items(c, t, x)) :
    {Codec.require(Nat.is_le(_, U32.to_nat(16)), Codec.aggregate(Codec.parts(RITEMS(c, t, x), S.Repeat{S.Container{["signed_header_1", "signed_header_2"], S.Chain{S.Container{["message", "signature"], S.Chain{S.Container{["slot", "proposer_index", "parent_root", "state_root", "body_root"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.End{}}}}}}}, S.Chain{S.ByteVector{96n}, S.End{}}}}, S.Chain{S.Container{["message", "signature"], S.Chain{S.Container{["slot", "proposer_index", "parent_root", "state_root", "body_root"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.End{}}}}}}}, S.Chain{S.ByteVector{96n}, S.End{}}}}, S.End{}}}}}), None{})) == Some{[S.Variable{UW.WX(t, x, U32.to_nat(len))}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(Bool, Nat.is_le(c, U32.to_nat(16)), True{}, hcw(len, hchk)) :
    {Codec.require(_, Codec.aggregate(Codec.parts(RITEMS(c, t, x), S.Repeat{S.Container{["signed_header_1", "signed_header_2"], S.Chain{S.Container{["message", "signature"], S.Chain{S.Container{["slot", "proposer_index", "parent_root", "state_root", "body_root"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.End{}}}}}}}, S.Chain{S.ByteVector{96n}, S.End{}}}}, S.Chain{S.Container{["message", "signature"], S.Chain{S.Container{["slot", "proposer_index", "parent_root", "state_root", "body_root"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.End{}}}}}}}, S.Chain{S.ByteVector{96n}, S.End{}}}}, S.End{}}}}}), None{})) == Some{[S.Variable{UW.WX(t, x, U32.to_nat(len))}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(Maybe<&2, +List<S.Part>>, Codec.parts(RITEMS(c, t, x), S.Repeat{S.Container{["signed_header_1", "signed_header_2"], S.Chain{S.Container{["message", "signature"], S.Chain{S.Container{["slot", "proposer_index", "parent_root", "state_root", "body_root"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.End{}}}}}}}, S.Chain{S.ByteVector{96n}, S.End{}}}}, S.Chain{S.Container{["message", "signature"], S.Chain{S.Container{["slot", "proposer_index", "parent_root", "state_root", "body_root"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.End{}}}}}}}, S.Chain{S.ByteVector{96n}, S.End{}}}}, S.End{}}}}}), Some{F.fparts(CHUNKS(c, t, x))}, prt_items(c, t, x)) :
    {Codec.require(True{}, Codec.aggregate(_, None{})) == Some{[S.Variable{UW.WX(t, x, U32.to_nat(len))}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(Maybe<&2, +List<U32>>, Layout.encoding(F.fparts(CHUNKS(c, t, x))), Some{F.flat(CHUNKS(c, t, x))}, VS.encoding_fparts(CHUNKS(c, t, x), fit)) :
    {Codec.one(_, None{}) == Some{[S.Variable{UW.WX(t, x, U32.to_nat(len))}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(+List<U32>, F.flat(CHUNKS(c, t, x)), UW.WX(t, x, Nat.mul(c, 416n)), fl) :
    {Codec.one(Some{_}, None{}) == Some{[S.Variable{UW.WX(t, x, U32.to_nat(len))}]} : Maybe<&2, +List<S.Part>>}
  %ec : {Codec.one(Some{UW.WX(t, x, _)}, None{}) == Some{[S.Variable{UW.WX(t, x, U32.to_nat(len))}]} : Maybe<&2, +List<S.Part>>}
  {==}

# ---- the inversion ------------------------------------------------------------------------------

def rp_t(+xs: +List<U32>, +el: S.Value, +tl: S.Value, +ps: +List<S.Part>, +mB: Maybe<&2, +List<S.Part>>,
    +eB: {Codec.parts(tl, S.Repeat{S.Container{["signed_header_1", "signed_header_2"], S.Chain{S.Container{["message", "signature"], S.Chain{S.Container{["slot", "proposer_index", "parent_root", "state_root", "body_root"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.End{}}}}}}}, S.Chain{S.ByteVector{96n}, S.End{}}}}, S.Chain{S.Container{["message", "signature"], S.Chain{S.Container{["slot", "proposer_index", "parent_root", "state_root", "body_root"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.End{}}}}}}}, S.Chain{S.ByteVector{96n}, S.End{}}}}, S.End{}}}}}) == mB : Maybe<&2, +List<S.Part>>},
    +lx: {List.length(&2, U32, xs) == 416n : Nat},
    +e: {Codec.concatenate(Some{[S.Fixed{xs}]}, mB) == Some{ps} : Maybe<&2, +List<S.Part>>},
    ih: @+pb: +List<S.Part> -> {Codec.parts(tl, S.Repeat{S.Container{["signed_header_1", "signed_header_2"], S.Chain{S.Container{["message", "signature"], S.Chain{S.Container{["slot", "proposer_index", "parent_root", "state_root", "body_root"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.End{}}}}}}}, S.Chain{S.ByteVector{96n}, S.End{}}}}, S.Chain{S.Container{["message", "signature"], S.Chain{S.Container{["slot", "proposer_index", "parent_root", "state_root", "body_root"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.End{}}}}}}}, S.Chain{S.ByteVector{96n}, S.End{}}}}, S.End{}}}}}) == Some{pb} : Maybe<&2, +List<S.Part>>} -> VMR.REPB(tl, pb, 416n))
    -> VMR.REPB(S.Items{el, tl}, ps, 416n):
  match mB:
    case None{}: Empty.absurd(VMR.REPB(S.Items{el, tl}, ps, 416n), FD.logic__none_some(+List<S.Part>, ps, e))
    case Some{+pb}:
      +eps = FD.logic__some_inj(+List<S.Part>, S.Fixed{xs} <> pb, ps, e)
      %Equal.sym(+List<S.Part>, ps, S.Fixed{xs} <> pb, Equal.sym(+List<S.Part>, S.Fixed{xs} <> pb, ps, eps)) : VMR.REPB(S.Items{el, tl}, _, 416n)
      VMR.rpb_t2(xs, el, tl, pb, 416n, lx, ih(pb, eB))

def rp_p(+el: S.Value, +tl: S.Value, +ps: +List<S.Part>, +ph: +List<S.Part>, hf: DF.single(Some{416n}, ph),
    +e: {Codec.concatenate(Some{ph}, Codec.parts(tl, S.Repeat{S.Container{["signed_header_1", "signed_header_2"], S.Chain{S.Container{["message", "signature"], S.Chain{S.Container{["slot", "proposer_index", "parent_root", "state_root", "body_root"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.End{}}}}}}}, S.Chain{S.ByteVector{96n}, S.End{}}}}, S.Chain{S.Container{["message", "signature"], S.Chain{S.Container{["slot", "proposer_index", "parent_root", "state_root", "body_root"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.End{}}}}}}}, S.Chain{S.ByteVector{96n}, S.End{}}}}, S.End{}}}}})) == Some{ps} : Maybe<&2, +List<S.Part>>},
    ih: @+pb: +List<S.Part> -> {Codec.parts(tl, S.Repeat{S.Container{["signed_header_1", "signed_header_2"], S.Chain{S.Container{["message", "signature"], S.Chain{S.Container{["slot", "proposer_index", "parent_root", "state_root", "body_root"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.End{}}}}}}}, S.Chain{S.ByteVector{96n}, S.End{}}}}, S.Chain{S.Container{["message", "signature"], S.Chain{S.Container{["slot", "proposer_index", "parent_root", "state_root", "body_root"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.End{}}}}}}}, S.Chain{S.ByteVector{96n}, S.End{}}}}, S.End{}}}}}) == Some{pb} : Maybe<&2, +List<S.Part>>} -> VMR.REPB(tl, pb, 416n))
    -> VMR.REPB(S.Items{el, tl}, ps, 416n):
  match ph:
    case Nil{}: Empty.absurd(VMR.REPB(S.Items{el, tl}, ps, 416n), hf)
    case Con{S.Fixed{+xs}, Nil{}}:
      rp_t(xs, el, tl, ps, Codec.parts(tl, S.Repeat{S.Container{["signed_header_1", "signed_header_2"], S.Chain{S.Container{["message", "signature"], S.Chain{S.Container{["slot", "proposer_index", "parent_root", "state_root", "body_root"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.End{}}}}}}}, S.Chain{S.ByteVector{96n}, S.End{}}}}, S.Chain{S.Container{["message", "signature"], S.Chain{S.Container{["slot", "proposer_index", "parent_root", "state_root", "body_root"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.End{}}}}}}}, S.Chain{S.ByteVector{96n}, S.End{}}}}, S.End{}}}}}), {==}, Equal.sym(Nat, 416n, List.length(&2, U32, xs), FD.logic__some_inj(Nat, 416n, List.length(&2, U32, xs), hf)), e, ih)
    case Con{S.Variable{+xs}, Nil{}}: Empty.absurd(VMR.REPB(S.Items{el, tl}, ps, 416n), FD.logic__none_some(Nat, 416n, Equal.sym(Maybe<&2, Nat>, Some{416n}, None{}, hf)))
    case Con{S.Fixed{+xs}, Con{+a, +b}}: Empty.absurd(VMR.REPB(S.Items{el, tl}, ps, 416n), hf)
    case Con{S.Variable{+xs}, Con{+a, +b}}: Empty.absurd(VMR.REPB(S.Items{el, tl}, ps, 416n), hf)

def rp_m(+el: S.Value, +tl: S.Value, +ps: +List<S.Part>, +mh: Maybe<&2, +List<S.Part>>, hf: DF.single_result(Some{416n}, mh),
    +e: {Codec.concatenate(mh, Codec.parts(tl, S.Repeat{S.Container{["signed_header_1", "signed_header_2"], S.Chain{S.Container{["message", "signature"], S.Chain{S.Container{["slot", "proposer_index", "parent_root", "state_root", "body_root"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.End{}}}}}}}, S.Chain{S.ByteVector{96n}, S.End{}}}}, S.Chain{S.Container{["message", "signature"], S.Chain{S.Container{["slot", "proposer_index", "parent_root", "state_root", "body_root"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.End{}}}}}}}, S.Chain{S.ByteVector{96n}, S.End{}}}}, S.End{}}}}})) == Some{ps} : Maybe<&2, +List<S.Part>>},
    ih: @+pb: +List<S.Part> -> {Codec.parts(tl, S.Repeat{S.Container{["signed_header_1", "signed_header_2"], S.Chain{S.Container{["message", "signature"], S.Chain{S.Container{["slot", "proposer_index", "parent_root", "state_root", "body_root"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.End{}}}}}}}, S.Chain{S.ByteVector{96n}, S.End{}}}}, S.Chain{S.Container{["message", "signature"], S.Chain{S.Container{["slot", "proposer_index", "parent_root", "state_root", "body_root"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.End{}}}}}}}, S.Chain{S.ByteVector{96n}, S.End{}}}}, S.End{}}}}}) == Some{pb} : Maybe<&2, +List<S.Part>>} -> VMR.REPB(tl, pb, 416n))
    -> VMR.REPB(S.Items{el, tl}, ps, 416n):
  match mh:
    case None{}: Empty.absurd(VMR.REPB(S.Items{el, tl}, ps, 416n), FD.logic__none_some(+List<S.Part>, ps, e))
    case Some{+ph}: rp_p(el, tl, ps, ph, hf, e, ih)

# The parts of records are fixed parts of 416 bytes each.
law rep_r:
  for +its: S.Value
  for +ps: +List<S.Part>
  for +e: {Codec.parts(its, S.Repeat{S.Container{["signed_header_1", "signed_header_2"], S.Chain{S.Container{["message", "signature"], S.Chain{S.Container{["slot", "proposer_index", "parent_root", "state_root", "body_root"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.End{}}}}}}}, S.Chain{S.ByteVector{96n}, S.End{}}}}, S.Chain{S.Container{["message", "signature"], S.Chain{S.Container{["slot", "proposer_index", "parent_root", "state_root", "body_root"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.End{}}}}}}}, S.Chain{S.ByteVector{96n}, S.End{}}}}, S.End{}}}}}) == Some{ps} : Maybe<&2, +List<S.Part>>}
  VMR.REPB(its, ps, 416n)
def rep_r(its, ps, e):
  match its:
    case S.EmptyItems{}:
      +eps = FD.logic__some_inj(+List<S.Part>, [], ps, e)
      %Equal.sym(+List<S.Part>, ps, [], Equal.sym(+List<S.Part>, [], ps, eps)) : VMR.REPB(S.EmptyItems{}, _, 416n)
      ({==}, {==})
    case S.Items{+h, +tl}: rp_m(h, tl, ps, Codec.parts(h, S.Container{["signed_header_1", "signed_header_2"], S.Chain{S.Container{["message", "signature"], S.Chain{S.Container{["slot", "proposer_index", "parent_root", "state_root", "body_root"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.End{}}}}}}}, S.Chain{S.ByteVector{96n}, S.End{}}}}, S.Chain{S.Container{["message", "signature"], S.Chain{S.Container{["slot", "proposer_index", "parent_root", "state_root", "body_root"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.End{}}}}}}}, S.Chain{S.ByteVector{96n}, S.End{}}}}, S.End{}}}}), DS.facts(h, S.Container{["signed_header_1", "signed_header_2"], S.Chain{S.Container{["message", "signature"], S.Chain{S.Container{["slot", "proposer_index", "parent_root", "state_root", "body_root"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.End{}}}}}}}, S.Chain{S.ByteVector{96n}, S.End{}}}}, S.Chain{S.Container{["message", "signature"], S.Chain{S.Container{["slot", "proposer_index", "parent_root", "state_root", "body_root"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.End{}}}}}}}, S.Chain{S.ByteVector{96n}, S.End{}}}}, S.End{}}}}, {==}), e, pb => eb => rep_r(tl, pb, eb))
    case S.BooleanValue{+b}: Empty.absurd(VMR.REPB(S.BooleanValue{b}, ps, 416n), FD.logic__none_some(+List<S.Part>, ps, e))
    case S.UnsignedValue{+u}: Empty.absurd(VMR.REPB(S.UnsignedValue{u}, ps, 416n), FD.logic__none_some(+List<S.Part>, ps, e))
    case S.BytesValue{+xs}: Empty.absurd(VMR.REPB(S.BytesValue{xs}, ps, 416n), FD.logic__none_some(+List<S.Part>, ps, e))
    case S.BitsValue{+bs}: Empty.absurd(VMR.REPB(S.BitsValue{bs}, ps, 416n), FD.logic__none_some(+List<S.Part>, ps, e))
    case S.Sequence{+it}: Empty.absurd(VMR.REPB(S.Sequence{it}, ps, 416n), FD.logic__none_some(+List<S.Part>, ps, e))
    case S.Selected{+sel, +sv}: Empty.absurd(VMR.REPB(S.Selected{sel, sv}, ps, 416n), FD.logic__none_some(+List<S.Part>, ps, e))
    case S.NullValue{}: Empty.absurd(VMR.REPB(S.NullValue{}, ps, 416n), FD.logic__none_some(+List<S.Part>, ps, e))

def lm4(+its: S.Value, +ys: +List<U32>, +hk: {Nat.is_le(Codec.count(its), U32.to_nat(16)) == True{} : Bool}, +ps: +List<S.Part>,
    +em3: {Codec.parts(its, S.Repeat{S.Container{["signed_header_1", "signed_header_2"], S.Chain{S.Container{["message", "signature"], S.Chain{S.Container{["slot", "proposer_index", "parent_root", "state_root", "body_root"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.End{}}}}}}}, S.Chain{S.ByteVector{96n}, S.End{}}}}, S.Chain{S.Container{["message", "signature"], S.Chain{S.Container{["slot", "proposer_index", "parent_root", "state_root", "body_root"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.End{}}}}}}}, S.Chain{S.ByteVector{96n}, S.End{}}}}, S.End{}}}}}) == Some{ps} : Maybe<&2, +List<S.Part>>}, +m4: Maybe<&2, +List<U32>>,
    +em4: {Layout.encoding(ps) == m4 : Maybe<&2, +List<U32>>}, +e: {Codec.bytes(Codec.one(m4, None{})) == Some{ys} : Maybe<&2, +List<U32>>})
    -> VMR.LF(ys, 416n, U32.to_nat(16)):
  match m4:
    case None{}: Empty.absurd(VMR.LF(ys, 416n, U32.to_nat(16)), FD.logic__none_some(+List<U32>, ys, e))
    case Some{+zs}:
      +ez = FD.logic__some_inj(+List<U32>, zs, ys, e)
      +lz = Equal.trans(Nat, List.length(&2, U32, zs), Layout.fixed_size(ps), Nat.mul(Codec.count(its), 416n),
        VS.enc_len(ps, zs, Pair.fst({VS.allfix(ps) == True{} : Bool}, {Layout.fixed_size(ps) == Nat.mul(Codec.count(its), 416n) : Nat}, rep_r(its, ps, em3)), em4),
        Pair.snd({VS.allfix(ps) == True{} : Bool}, {Layout.fixed_size(ps) == Nat.mul(Codec.count(its), 416n) : Nat}, rep_r(its, ps, em3)))
      (Codec.count(its), (FD.logic__subst(+List<U32>, z => {List.length(&2, U32, z) == Nat.mul(Codec.count(its), 416n) : Nat}, zs, ys, ez, lz), hk))

def lm3(+its: S.Value, +ys: +List<U32>, +hk: {Nat.is_le(Codec.count(its), U32.to_nat(16)) == True{} : Bool}, +m3: Maybe<&2, +List<S.Part>>,
    +em3: {Codec.parts(its, S.Repeat{S.Container{["signed_header_1", "signed_header_2"], S.Chain{S.Container{["message", "signature"], S.Chain{S.Container{["slot", "proposer_index", "parent_root", "state_root", "body_root"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.End{}}}}}}}, S.Chain{S.ByteVector{96n}, S.End{}}}}, S.Chain{S.Container{["message", "signature"], S.Chain{S.Container{["slot", "proposer_index", "parent_root", "state_root", "body_root"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.End{}}}}}}}, S.Chain{S.ByteVector{96n}, S.End{}}}}, S.End{}}}}}) == m3 : Maybe<&2, +List<S.Part>>}, +e: {Codec.bytes(Codec.aggregate(m3, None{})) == Some{ys} : Maybe<&2, +List<U32>>})
    -> VMR.LF(ys, 416n, U32.to_nat(16)):
  match m3:
    case None{}: Empty.absurd(VMR.LF(ys, 416n, U32.to_nat(16)), FD.logic__none_some(+List<U32>, ys, e))
    case Some{+ps}: lm4(its, ys, hk, ps, em3, Layout.encoding(ps), {==}, e)

def lb(+its: S.Value, +ys: +List<U32>, +b: Bool, +eb: {Nat.is_le(Codec.count(its), U32.to_nat(16)) == b : Bool},
    +e: {Codec.bytes(Codec.require(b, Codec.aggregate(Codec.parts(its, S.Repeat{S.Container{["signed_header_1", "signed_header_2"], S.Chain{S.Container{["message", "signature"], S.Chain{S.Container{["slot", "proposer_index", "parent_root", "state_root", "body_root"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.End{}}}}}}}, S.Chain{S.ByteVector{96n}, S.End{}}}}, S.Chain{S.Container{["message", "signature"], S.Chain{S.Container{["slot", "proposer_index", "parent_root", "state_root", "body_root"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.End{}}}}}}}, S.Chain{S.ByteVector{96n}, S.End{}}}}, S.End{}}}}}), None{}))) == Some{ys} : Maybe<&2, +List<U32>>})
    -> VMR.LF(ys, 416n, U32.to_nat(16)):
  match b:
    case False{}: Empty.absurd(VMR.LF(ys, 416n, U32.to_nat(16)), FD.logic__none_some(+List<U32>, ys, e))
    case True{}: lm3(its, ys, eb, Codec.parts(its, S.Repeat{S.Container{["signed_header_1", "signed_header_2"], S.Chain{S.Container{["message", "signature"], S.Chain{S.Container{["slot", "proposer_index", "parent_root", "state_root", "body_root"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.End{}}}}}}}, S.Chain{S.ByteVector{96n}, S.End{}}}}, S.Chain{S.Container{["message", "signature"], S.Chain{S.Container{["slot", "proposer_index", "parent_root", "state_root", "body_root"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.End{}}}}}}}, S.Chain{S.ByteVector{96n}, S.End{}}}}, S.End{}}}}}), {==}, e)

# The spec bytes ys of any value of the list are whole records, at most 16.
law linvr:
  for +h: S.Value
  for +ys: +List<U32>
  for +e: {Codec.bytes(Codec.parts(h, S.ListOf{S.Container{["signed_header_1", "signed_header_2"], S.Chain{S.Container{["message", "signature"], S.Chain{S.Container{["slot", "proposer_index", "parent_root", "state_root", "body_root"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.End{}}}}}}}, S.Chain{S.ByteVector{96n}, S.End{}}}}, S.Chain{S.Container{["message", "signature"], S.Chain{S.Container{["slot", "proposer_index", "parent_root", "state_root", "body_root"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.End{}}}}}}}, S.Chain{S.ByteVector{96n}, S.End{}}}}, S.End{}}}}, U32.to_nat(16)})) == Some{ys} : Maybe<&2, +List<U32>>}
  VMR.LF(ys, 416n, U32.to_nat(16))
def linvr(h, ys, e):
  match h:
    case S.Sequence{+its}: lb(its, ys, Nat.is_le(Codec.count(its), U32.to_nat(16)), {==}, e)
    case S.BooleanValue{+b0}: Empty.absurd(VMR.LF(ys, 416n, U32.to_nat(16)), FD.logic__none_some(+List<U32>, ys, e))
    case S.UnsignedValue{+u0}: Empty.absurd(VMR.LF(ys, 416n, U32.to_nat(16)), FD.logic__none_some(+List<U32>, ys, e))
    case S.BytesValue{+xs0}: Empty.absurd(VMR.LF(ys, 416n, U32.to_nat(16)), FD.logic__none_some(+List<U32>, ys, e))
    case S.BitsValue{+bs0}: Empty.absurd(VMR.LF(ys, 416n, U32.to_nat(16)), FD.logic__none_some(+List<U32>, ys, e))
    case S.Items{+hd0, +tl0}: Empty.absurd(VMR.LF(ys, 416n, U32.to_nat(16)), FD.logic__none_some(+List<U32>, ys, e))
    case S.EmptyItems{}: Empty.absurd(VMR.LF(ys, 416n, U32.to_nat(16)), FD.logic__none_some(+List<U32>, ys, e))
    case S.Selected{+sel0, +sv0}: Empty.absurd(VMR.LF(ys, 416n, U32.to_nat(16)), FD.logic__none_some(+List<U32>, ys, e))
    case S.NullValue{}: Empty.absurd(VMR.LF(ys, 416n, U32.to_nat(16)), FD.logic__none_some(+List<U32>, ys, e))

def chk_i(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +hw32: {Nat.is_lt(Nat.add(x, U32.to_nat(len)), FD.spec_common__pow2(32n)) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, f: VMR.LF(UW.WX(t, x, U32.to_nat(len)), 416n, U32.to_nat(16))) -> {CHKw(t, x, off, len) == True{} : Bool}:
  (+k, +pr) = f
  (+hl, +hk) = pr
  VU.whole_i(len, 416, 16, vR(), {==}, {==}, {==}, k,
    Equal.trans(Nat, U32.to_nat(len), List.length(&2, U32, UW.WX(t, x, U32.to_nat(len))), Nat.mul(k, 416n),
      Equal.sym(Nat, List.length(&2, U32, UW.WX(t, x, U32.to_nat(len))), U32.to_nat(len), UW.lenWX(d, t, x, U32.to_nat(len), pf, hw)), hl), hk)

# Every value whose parts are the window's bytes passes the check.
def invwD(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +hw32: {Nat.is_lt(Nat.add(x, U32.to_nat(len)), FD.spec_common__pow2(32n)) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +v: S.Value,
    +e: {Codec.parts(v, S.ListOf{S.Container{["signed_header_1", "signed_header_2"], S.Chain{S.Container{["message", "signature"], S.Chain{S.Container{["slot", "proposer_index", "parent_root", "state_root", "body_root"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.End{}}}}}}}, S.Chain{S.ByteVector{96n}, S.End{}}}}, S.Chain{S.Container{["message", "signature"], S.Chain{S.Container{["slot", "proposer_index", "parent_root", "state_root", "body_root"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.End{}}}}}}}, S.Chain{S.ByteVector{96n}, S.End{}}}}, S.End{}}}}, U32.to_nat(16)}) == Some{[S.Variable{UW.WX(t, x, U32.to_nat(len))}]} : Maybe<&2, +List<S.Part>>})
    -> {CHKw(t, x, off, len) == True{} : Bool}:
  chk_i(d, t, n, x, off, len, eo, hd, hw, hw32, pf, linvr(v, UW.WX(t, x, U32.to_nat(len)),
    Equal.cong(Maybe<&2, +List<S.Part>>, Maybe<&2, +List<U32>>, z => Codec.bytes(z), Codec.parts(v, S.ListOf{S.Container{["signed_header_1", "signed_header_2"], S.Chain{S.Container{["message", "signature"], S.Chain{S.Container{["slot", "proposer_index", "parent_root", "state_root", "body_root"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.End{}}}}}}}, S.Chain{S.ByteVector{96n}, S.End{}}}}, S.Chain{S.Container{["message", "signature"], S.Chain{S.Container{["slot", "proposer_index", "parent_root", "state_root", "body_root"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.Chain{S.ByteVector{32n}, S.End{}}}}}}}, S.Chain{S.ByteVector{96n}, S.End{}}}}, S.End{}}}}, U32.to_nat(16)}), Some{[S.Variable{UW.WX(t, x, U32.to_nat(len))}]}, e)))

# ---- the window interface as it was (d < 28, no hw32), for the callers not yet deep ----

def ok_evalw(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat}, +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}) -> {Fulu_list_ProposerSlashing_16_r.l16_ProposerSlashing_ok(BF(t, n), off, len) == (BF(t, n), CHKw(t, x, off, len)) : B.Buf & Bool}:
