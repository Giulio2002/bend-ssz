# ==== Attestation in the encoder-window interface ====

type MW is Data:
  MW{m_aggregation_bits: EX_bits131072.MB, data: FuluAttestationData_d.AttestationData, signature: FuluBytes96_d.Bytes96, committee_bits: Fulu_bitvector_64_d.Bitvector64}

def TH(m: MW) -> FuluAttestation_d.Attestation:
  match m:
    case MW{+m_aggregation_bits, +data, +signature, +committee_bits}: K.OBJC(m_aggregation_bits, data, signature, committee_bits)
def OK(m: MW) -> Bool:
  match m:
    case MW{+m_aggregation_bits, +data, +signature, +committee_bits}: OKT(m_aggregation_bits, data, signature, committee_bits)
def ENC(m: MW) -> +List<U32>:
  match m:
    case MW{+m_aggregation_bits, +data, +signature, +committee_bits}: K.ENCC(m_aggregation_bits, data, signature, committee_bits)
def VAL(m: MW) -> S.Value:
  match m:
    case MW{+m_aggregation_bits, +data, +signature, +committee_bits}: VALC(m_aggregation_bits, data, signature, committee_bits)
def SZ(m: MW) -> U32:
  match m:
    case MW{+m_aggregation_bits, +data, +signature, +committee_bits}: K.SZC(m_aggregation_bits, data, signature, committee_bits)
def XQ(+q: Nat, +r: Nat) -> U32: U32.from_nat(Nat.add(A.quad(q), r))
def PUTX(m: MW, +dd: Nat, +D: FD.array__Tree<U32>, +q: Nat, +r: Nat) -> FD.array__Tree<U32>:
  match m:
    case MW{+m_aggregation_bits, +data, +signature, +committee_bits}: K.PUTC(m_aggregation_bits, data, signature, committee_bits, dd, D, XQ(q, r), q, r)
def PADB(+r: Nat, m: MW) -> Nat: WD.PADB(r, List.length(&2, U32, ENC(m)))

def RTX(+m_aggregation_bits: EX_bits131072.MB, +data: FuluAttestationData_d.AttestationData, +signature: FuluBytes96_d.Bytes96, +committee_bits: Fulu_bitvector_64_d.Bitvector64, +dd: Nat, +D: FD.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat) -> Data:
