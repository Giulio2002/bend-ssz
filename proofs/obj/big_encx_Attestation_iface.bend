# ---- the interface's laws ----------------------------------------------------------------------

law putx:
  for +m: MW
  for +dd: Nat
  for +D: FD.array__Tree<U32>
  for +X: U32
  for +q: Nat
  for +r: Nat
  for +e: {U32.to_nat(X) == Nat.add(A.quad(q), r) : Nat}
  for +hr: {Nat.is_lt(r, 4n) == True{} : Bool}
  for +hd: {Nat.is_lt(dd, 29n) == True{} : Bool}
  for +pf: {FD.array__perfect(U32, dd, D) == True{} : Bool}
  for +hl: {Nat.is_le(Nat.add(q, WD.NWN(Nat.add(r, List.length(&2, U32, ENC(m))))), VB.pw(dd)) == True{} : Bool}
  for +hz: {VS.bt(Nat.add(List.length(&2, U32, ENC(m)), PADB(r, m)), VS.bdr(Nat.add(A.quad(q), r), UA.BYT(D))) == UW.ZB(Nat.add(List.length(&2, U32, ENC(m)), PADB(r, m))) : +List<U32>}
  for +hok: {OK(m) == True{} : Bool}
  {FuluAttestation_e.Attestation_putk(FD.array__thaw(U32, D), X, TH(m)) == (FD.array__thaw(U32, PUTX(m, dd, D, q, r)), (TH(m), SZ(m))) : Array<U32> & (FuluAttestation_d.Attestation & U32)}
def putx(m, dd, D, X, q, r, e, hr, hd, pf, hl, hz, hok):
  match m:
    case MW{+m_aggregation_bits, +data, +signature, +committee_bits}: PA(RTX(m_aggregation_bits, data, signature, committee_bits, dd, D, X, q, r), BYX(m_aggregation_bits, data, signature, committee_bits, dd, D, q, r), go(m_aggregation_bits, data, signature, committee_bits, hok, dd, D, X, q, r, e, hr, hd, pf, hl, hz))

law putx_bytes:
  for +m: MW
  for +dd: Nat
  for +D: FD.array__Tree<U32>
  for +X: U32
  for +q: Nat
  for +r: Nat
  for +e: {U32.to_nat(X) == Nat.add(A.quad(q), r) : Nat}
  for +hr: {Nat.is_lt(r, 4n) == True{} : Bool}
  for +hd: {Nat.is_lt(dd, 29n) == True{} : Bool}
  for +pf: {FD.array__perfect(U32, dd, D) == True{} : Bool}
  for +hl: {Nat.is_le(Nat.add(q, WD.NWN(Nat.add(r, List.length(&2, U32, ENC(m))))), VB.pw(dd)) == True{} : Bool}
  for +hz: {VS.bt(Nat.add(List.length(&2, U32, ENC(m)), PADB(r, m)), VS.bdr(Nat.add(A.quad(q), r), UA.BYT(D))) == UW.ZB(Nat.add(List.length(&2, U32, ENC(m)), PADB(r, m))) : +List<U32>}
  for +hok: {OK(m) == True{} : Bool}
  {UA.BYT(PUTX(m, dd, D, q, r)) == UW.SPL(UA.BYT(D), Nat.add(A.quad(q), r), List.append(&2, U32, ENC(m), UW.ZB(PADB(r, m)))) : +List<U32>}
def putx_bytes(m, dd, D, X, q, r, e, hr, hd, pf, hl, hz, hok):
  match m:
    case MW{+m_aggregation_bits, +data, +signature, +committee_bits}: PB(RTX(m_aggregation_bits, data, signature, committee_bits, dd, D, X, q, r), BYX(m_aggregation_bits, data, signature, committee_bits, dd, D, q, r), go(m_aggregation_bits, data, signature, committee_bits, hok, dd, D, X, q, r, e, hr, hd, pf, hl, hz))

law szx:
  for +m: MW
  for +hok: {OK(m) == True{} : Bool}
  {U32.to_nat(SZ(m)) == List.length(&2, U32, ENC(m)) : Nat}
def szx(m, hok):
  match m:
    case MW{+m_aggregation_bits, +data, +signature, +committee_bits}: Equal.trans(Nat, U32.to_nat(K.SZC(m_aggregation_bits, data, signature, committee_bits)), ENDC(m_aggregation_bits, data, signature, committee_bits), List.length(&2, U32, K.ENCC(m_aggregation_bits, data, signature, committee_bits)), szC(m_aggregation_bits, data, signature, committee_bits, hok, 28n, {==}), Equal.sym(Nat, List.length(&2, U32, K.ENCC(m_aggregation_bits, data, signature, committee_bits)), ENDC(m_aggregation_bits, data, signature, committee_bits), lenE(m_aggregation_bits, data, signature, committee_bits, hok)))

# The bytes within 4 2^k (k = 28, kept symbolic).
law bndx:
  for +m: MW
  for +hok: {OK(m) == True{} : Bool}
  for +k: Nat
  for +ek: {k == 28n : Nat}
  {Nat.is_le(List.length(&2, U32, ENC(m)), A.quad(VB.pw(k))) == True{} : Bool}
def bndx(m, hok, k, ek):
  match m:
    case MW{+m_aggregation_bits, +data, +signature, +committee_bits}: FD.logic__subst(Nat, z => {Nat.is_le(z, A.quad(VB.pw(k))) == True{} : Bool}, ENDC(m_aggregation_bits, data, signature, committee_bits), List.length(&2, U32, K.ENCC(m_aggregation_bits, data, signature, committee_bits)), Equal.sym(Nat, List.length(&2, U32, K.ENCC(m_aggregation_bits, data, signature, committee_bits)), ENDC(m_aggregation_bits, data, signature, committee_bits), lenE(m_aggregation_bits, data, signature, committee_bits, hok)), okbk(m_aggregation_bits, data, signature, committee_bits, hok, k, ek))

law encx_spec:
  for +m: MW
  for +hok: {OK(m) == True{} : Bool}
  {Codec.parts(VAL(m), Spec.Attestation()) == Some{[S.Variable{ENC(m)}]} : Maybe<&2, +List<S.Part>>}
def encx_spec(m, hok):
  match m:
    case MW{+m_aggregation_bits, +data, +signature, +committee_bits}: specC(m_aggregation_bits, data, signature, committee_bits, hok, 28n, {==})

law domx:
  for +m: MW
  for +hok: {OK(m) == True{} : Bool}
  {SP.bytes_domain(ENC(m)) == True{} : Bool}
def domx(m, hok):
  match m:
    case MW{+m_aggregation_bits, +data, +signature, +committee_bits}: CS.domv(VALC(m_aggregation_bits, data, signature, committee_bits), Spec.Attestation(), K.ENCC(m_aggregation_bits, data, signature, committee_bits), {==}, specC(m_aggregation_bits, data, signature, committee_bits, hok, 28n, {==}))

law pfx:
  for +m: MW
  for +dd: Nat
  for +D: FD.array__Tree<U32>
  for +q: Nat
  for +r: Nat
  for +pf: {FD.array__perfect(U32, dd, D) == True{} : Bool}
  {FD.array__perfect(U32, dd, PUTX(m, dd, D, q, r)) == True{} : Bool}
def pfx(m, dd, D, q, r, pf):
  match m:
    case MW{+m_aggregation_bits, +data, +signature, +committee_bits}: K.pfC(m_aggregation_bits, data, signature, committee_bits, dd, D, XQ(q, r), q, r, pf)

def sizeC(+m_aggregation_bits: EX_bits131072.MB, +data: FuluAttestationData_d.AttestationData, +signature: FuluBytes96_d.Bytes96, +committee_bits: Fulu_bitvector_64_d.Bitvector64, +h: {OKT(m_aggregation_bits, data, signature, committee_bits) == True{} : Bool}) -> {FuluAttestation_e.Attestation_size(K.OBJC(m_aggregation_bits, data, signature, committee_bits)) == (K.OBJC(m_aggregation_bits, data, signature, committee_bits), K.SZC(m_aggregation_bits, data, signature, committee_bits)) : FuluAttestation_d.Attestation & U32}:
  %Equal.sym(O.Bits & U32, Fulu_bitlist_131072_e.bits131072_size(EX_bits131072.TH(m_aggregation_bits)), (EX_bits131072.TH(m_aggregation_bits), EX_bits131072.SZ(m_aggregation_bits)), EX_bits131072.sizex(m_aggregation_bits, ok_hok_aggregation_bits(m_aggregation_bits, data, signature, committee_bits, h))) :
    {FuluAttestation_e.Attestation_sz0(data, signature, committee_bits, 236, _) == (K.OBJC(m_aggregation_bits, data, signature, committee_bits), K.SZC(m_aggregation_bits, data, signature, committee_bits)) : FuluAttestation_d.Attestation & U32}
  {==}

law sizex:
  for +m: MW
  for +hok: {OK(m) == True{} : Bool}
  {FuluAttestation_e.Attestation_size(TH(m)) == (TH(m), SZ(m)) : FuluAttestation_d.Attestation & U32}
def sizex(m, hok):
  match m:
    case MW{+m_aggregation_bits, +data, +signature, +committee_bits}: sizeC(m_aggregation_bits, data, signature, committee_bits, hok)

def rvalidC(+m_aggregation_bits: EX_bits131072.MB, +data: FuluAttestationData_d.AttestationData, +signature: FuluBytes96_d.Bytes96, +committee_bits: Fulu_bitvector_64_d.Bitvector64, +h: {OKT(m_aggregation_bits, data, signature, committee_bits) == True{} : Bool}) -> {FuluAttestation_e.Attestation_valid(K.OBJC(m_aggregation_bits, data, signature, committee_bits)) == (K.OBJC(m_aggregation_bits, data, signature, committee_bits), True{}) : FuluAttestation_d.Attestation & Bool}:
  %Equal.sym(O.Bits & Bool, Fulu_bitlist_131072_e.bits131072_valid(EX_bits131072.TH(m_aggregation_bits)), (EX_bits131072.TH(m_aggregation_bits), True{}), EX_bits131072.validx(m_aggregation_bits, ok_hok_aggregation_bits(m_aggregation_bits, data, signature, committee_bits, h))) :
    {FuluAttestation_e.Attestation_va0(data, signature, committee_bits, True{}, _) == (K.OBJC(m_aggregation_bits, data, signature, committee_bits), True{}) : FuluAttestation_d.Attestation & Bool}
  {==}

law validx:
  for +m: MW
  for +hok: {OK(m) == True{} : Bool}
  {FuluAttestation_e.Attestation_valid(TH(m)) == (TH(m), True{}) : FuluAttestation_d.Attestation & Bool}
def validx(m, hok):
  match m:
    case MW{+m_aggregation_bits, +data, +signature, +committee_bits}: rvalidC(m_aggregation_bits, data, signature, committee_bits, hok)
