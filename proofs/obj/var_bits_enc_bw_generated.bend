        {O.shl_bytes(U32.and(MF.shl_by(1, _), 255), U32.and(U32.add(0, U32.shrn(K, 3n)), 3)) == DL(3n, 7n) : U32}
      %Equal.sym(U32, U32.and(U32.add(0, U32.shrn(K, 3n)), 3), 3, F.u32__injective(U32.and(U32.add(0, U32.shrn(K, 3n)), 3), 3, ej)) :
        {O.shl_bytes(U32.and(MF.shl_by(1, 7), 255), _) == DL(3n, 7n) : U32}
      {==}
    case 3n 8n+ +e: Empty.absurd({O.shl_bytes(U32.and(MF.shl_by(1, U32.and(K, 7)), 255), U32.and(U32.add(0, U32.shrn(K, 3n)), 3)) == DL(3n, 8n+e) : U32}, F.nat__lt_zero_absurd(e, hb))
    case 4n+ +e _: Empty.absurd({O.shl_bytes(U32.and(MF.shl_by(1, U32.and(K, 7)), 255), U32.and(U32.add(0, U32.shrn(K, 3n)), 3)) == DL(4n+e, b) : U32}, F.nat__lt_zero_absurd(e, hj))

# Whether the last word is partial: 0 at a word boundary, else 1.
def CWr(r: Nat) -> Nat:
  match r:
    case 0n: 0n
    case 1n+p: 1n

# The closed facts of byte j < 4, bit b < 8.
law cfj:
  for +j: Nat
  for +b: Nat
  for +hj: {Nat.is_lt(j, 4n) == True{} : Bool}
  for +hb: {Nat.is_lt(b, 8n) == True{} : Bool}
  DK.P2({VD.s_rng(2n, Nat.add(Nat.add(j, VD.s_rng(3n, Nat.add(b, 7n))), 3n)) == CWr(Nat.add(VS.x8(j), b)) : Nat}, DK.P2({Nat.is_le(VD.s_rng(3n, Nat.add(b, 7n)), 1n) == True{} : Bool}, DK.P2({VD.s_rng(2n, Nat.add(j, VD.s_rng(3n, b))) == 0n : Nat}, DK.P2({VD.s_rng(2n, Nat.add(Nat.add(j, 1n), 3n)) == 1n : Nat}, DK.P2({Nat.is_le(Nat.add(VS.x8(j), b), 31n) == True{} : Bool}, {Bp.byte_count(1n+Nat.add(VS.x8(j), b)) == Nat.add(j, 1n) : Nat})))))
def cfj(j, b, hj, hb):
  match j b:
    case 0n 0n: ({==}, ({==}, ({==}, ({==}, ({==}, {==})))))
    case 0n 1n: ({==}, ({==}, ({==}, ({==}, ({==}, {==})))))
    case 0n 2n: ({==}, ({==}, ({==}, ({==}, ({==}, {==})))))
    case 0n 3n: ({==}, ({==}, ({==}, ({==}, ({==}, {==})))))
    case 0n 4n: ({==}, ({==}, ({==}, ({==}, ({==}, {==})))))
    case 0n 5n: ({==}, ({==}, ({==}, ({==}, ({==}, {==})))))
    case 0n 6n: ({==}, ({==}, ({==}, ({==}, ({==}, {==})))))
    case 0n 7n: ({==}, ({==}, ({==}, ({==}, ({==}, {==})))))
    case 0n 8n+ +e: Empty.absurd(DK.P2({VD.s_rng(2n, Nat.add(Nat.add(0n, VD.s_rng(3n, Nat.add(8n+e, 7n))), 3n)) == CWr(Nat.add(VS.x8(0n), 8n+e)) : Nat}, DK.P2({Nat.is_le(VD.s_rng(3n, Nat.add(8n+e, 7n)), 1n) == True{} : Bool}, DK.P2({VD.s_rng(2n, Nat.add(0n, VD.s_rng(3n, 8n+e))) == 0n : Nat}, DK.P2({VD.s_rng(2n, Nat.add(Nat.add(0n, 1n), 3n)) == 1n : Nat}, DK.P2({Nat.is_le(Nat.add(VS.x8(0n), 8n+e), 31n) == True{} : Bool}, {Bp.byte_count(1n+Nat.add(VS.x8(0n), 8n+e)) == Nat.add(0n, 1n) : Nat}))))), F.nat__lt_zero_absurd(e, hb))
    case 1n 0n: ({==}, ({==}, ({==}, ({==}, ({==}, {==})))))
    case 1n 1n: ({==}, ({==}, ({==}, ({==}, ({==}, {==})))))
    case 1n 2n: ({==}, ({==}, ({==}, ({==}, ({==}, {==})))))
    case 1n 3n: ({==}, ({==}, ({==}, ({==}, ({==}, {==})))))
    case 1n 4n: ({==}, ({==}, ({==}, ({==}, ({==}, {==})))))
    case 1n 5n: ({==}, ({==}, ({==}, ({==}, ({==}, {==})))))
    case 1n 6n: ({==}, ({==}, ({==}, ({==}, ({==}, {==})))))
    case 1n 7n: ({==}, ({==}, ({==}, ({==}, ({==}, {==})))))
    case 1n 8n+ +e: Empty.absurd(DK.P2({VD.s_rng(2n, Nat.add(Nat.add(1n, VD.s_rng(3n, Nat.add(8n+e, 7n))), 3n)) == CWr(Nat.add(VS.x8(1n), 8n+e)) : Nat}, DK.P2({Nat.is_le(VD.s_rng(3n, Nat.add(8n+e, 7n)), 1n) == True{} : Bool}, DK.P2({VD.s_rng(2n, Nat.add(1n, VD.s_rng(3n, 8n+e))) == 0n : Nat}, DK.P2({VD.s_rng(2n, Nat.add(Nat.add(1n, 1n), 3n)) == 1n : Nat}, DK.P2({Nat.is_le(Nat.add(VS.x8(1n), 8n+e), 31n) == True{} : Bool}, {Bp.byte_count(1n+Nat.add(VS.x8(1n), 8n+e)) == Nat.add(1n, 1n) : Nat}))))), F.nat__lt_zero_absurd(e, hb))
    case 2n 0n: ({==}, ({==}, ({==}, ({==}, ({==}, {==})))))
    case 2n 1n: ({==}, ({==}, ({==}, ({==}, ({==}, {==})))))
    case 2n 2n: ({==}, ({==}, ({==}, ({==}, ({==}, {==})))))
    case 2n 3n: ({==}, ({==}, ({==}, ({==}, ({==}, {==})))))
    case 2n 4n: ({==}, ({==}, ({==}, ({==}, ({==}, {==})))))
    case 2n 5n: ({==}, ({==}, ({==}, ({==}, ({==}, {==})))))
    case 2n 6n: ({==}, ({==}, ({==}, ({==}, ({==}, {==})))))
    case 2n 7n: ({==}, ({==}, ({==}, ({==}, ({==}, {==})))))
    case 2n 8n+ +e: Empty.absurd(DK.P2({VD.s_rng(2n, Nat.add(Nat.add(2n, VD.s_rng(3n, Nat.add(8n+e, 7n))), 3n)) == CWr(Nat.add(VS.x8(2n), 8n+e)) : Nat}, DK.P2({Nat.is_le(VD.s_rng(3n, Nat.add(8n+e, 7n)), 1n) == True{} : Bool}, DK.P2({VD.s_rng(2n, Nat.add(2n, VD.s_rng(3n, 8n+e))) == 0n : Nat}, DK.P2({VD.s_rng(2n, Nat.add(Nat.add(2n, 1n), 3n)) == 1n : Nat}, DK.P2({Nat.is_le(Nat.add(VS.x8(2n), 8n+e), 31n) == True{} : Bool}, {Bp.byte_count(1n+Nat.add(VS.x8(2n), 8n+e)) == Nat.add(2n, 1n) : Nat}))))), F.nat__lt_zero_absurd(e, hb))
    case 3n 0n: ({==}, ({==}, ({==}, ({==}, ({==}, {==})))))
    case 3n 1n: ({==}, ({==}, ({==}, ({==}, ({==}, {==})))))
    case 3n 2n: ({==}, ({==}, ({==}, ({==}, ({==}, {==})))))
    case 3n 3n: ({==}, ({==}, ({==}, ({==}, ({==}, {==})))))
    case 3n 4n: ({==}, ({==}, ({==}, ({==}, ({==}, {==})))))
    case 3n 5n: ({==}, ({==}, ({==}, ({==}, ({==}, {==})))))
    case 3n 6n: ({==}, ({==}, ({==}, ({==}, ({==}, {==})))))
    case 3n 7n: ({==}, ({==}, ({==}, ({==}, ({==}, {==})))))
    case 3n 8n+ +e: Empty.absurd(DK.P2({VD.s_rng(2n, Nat.add(Nat.add(3n, VD.s_rng(3n, Nat.add(8n+e, 7n))), 3n)) == CWr(Nat.add(VS.x8(3n), 8n+e)) : Nat}, DK.P2({Nat.is_le(VD.s_rng(3n, Nat.add(8n+e, 7n)), 1n) == True{} : Bool}, DK.P2({VD.s_rng(2n, Nat.add(3n, VD.s_rng(3n, 8n+e))) == 0n : Nat}, DK.P2({VD.s_rng(2n, Nat.add(Nat.add(3n, 1n), 3n)) == 1n : Nat}, DK.P2({Nat.is_le(Nat.add(VS.x8(3n), 8n+e), 31n) == True{} : Bool}, {Bp.byte_count(1n+Nat.add(VS.x8(3n), 8n+e)) == Nat.add(3n, 1n) : Nat}))))), F.nat__lt_zero_absurd(e, hb))
    case 4n+ +e _: Empty.absurd(DK.P2({VD.s_rng(2n, Nat.add(Nat.add(4n+e, VD.s_rng(3n, Nat.add(b, 7n))), 3n)) == CWr(Nat.add(VS.x8(4n+e), b)) : Nat}, DK.P2({Nat.is_le(VD.s_rng(3n, Nat.add(b, 7n)), 1n) == True{} : Bool}, DK.P2({VD.s_rng(2n, Nat.add(4n+e, VD.s_rng(3n, b))) == 0n : Nat}, DK.P2({VD.s_rng(2n, Nat.add(Nat.add(4n+e, 1n), 3n)) == 1n : Nat}, DK.P2({Nat.is_le(Nat.add(VS.x8(4n+e), b), 31n) == True{} : Bool}, {Bp.byte_count(1n+Nat.add(VS.x8(4n+e), b)) == Nat.add(4n+e, 1n) : Nat}))))), F.nat__lt_zero_absurd(e, hj))
