# The delimiter mask of byte j < 4, bit b < 8: bit 8 j + b.
def DL(j: Nat, b: Nat) -> U32:
  match j:
    case 0n:
      match b:
        case 0n: 1
        case 1n: 2
        case 2n: 4
        case 3n: 8
        case 4n: 16
        case 5n: 32
        case 6n: 64
        case 7n: 128
        case 8n+e: 0
    case 1n:
      match b:
        case 0n: 256
        case 1n: 512
        case 2n: 1024
        case 3n: 2048
        case 4n: 4096
        case 5n: 8192
        case 6n: 16384
        case 7n: 32768
        case 8n+e: 0
    case 2n:
      match b:
        case 0n: 65536
        case 1n: 131072
        case 2n: 262144
        case 3n: 524288
        case 4n: 1048576
        case 5n: 2097152
        case 6n: 4194304
        case 7n: 8388608
        case 8n+e: 0
    case 3n:
      match b:
        case 0n: 16777216
        case 1n: 33554432
        case 2n: 67108864
        case 3n: 134217728
        case 4n: 268435456
        case 5n: 536870912
        case 6n: 1073741824
        case 7n: 2147483648
        case 8n+e: 0
    case 4n+e: 0

# OR-ing the delimiter into word x: bit r = 8 j + b is set, the bits below kept,
# the bits above zero.
law dlc:
  for +j: Nat
  for +b: Nat
  for +x: U32
  for +hj: {Nat.is_lt(j, 4n) == True{} : Bool}
  for +hb: {Nat.is_lt(b, 8n) == True{} : Bool}
  for +hz: {hzw(Nat.add(VS.x8(j), b), x) == True{} : Bool}
  DK.P2({BK.btk(1n+Nat.add(VS.x8(j), b), BLf.wbits(U32.or(x, DL(j, b)))) == List.append(&2, Bool, BK.btk(Nat.add(VS.x8(j), b), BLf.wbits(x)), [True{}]) : +List<Bool>}, {BK.zw(1n+Nat.add(VS.x8(j), b), U32.or(x, DL(j, b))) == True{} : Bool})
def dlc(j, b, x, hj, hb, hz):
  match j b:
    case 0n 0n:
      bw0(x, hz)
    case 0n 1n:
      bw1(x, hz)
    case 0n 2n:
      bw2(x, hz)
    case 0n 3n:
      bw3(x, hz)
    case 0n 4n:
      bw4(x, hz)
    case 0n 5n:
      bw5(x, hz)
    case 0n 6n:
      bw6(x, hz)
    case 0n 7n:
      bw7(x, hz)
    case 0n 8n+ +e: Empty.absurd(DK.P2({BK.btk(1n+Nat.add(VS.x8(0n), 8n+e), BLf.wbits(U32.or(x, DL(0n, 8n+e)))) == List.append(&2, Bool, BK.btk(Nat.add(VS.x8(0n), 8n+e), BLf.wbits(x)), [True{}]) : +List<Bool>}, {BK.zw(1n+Nat.add(VS.x8(0n), 8n+e), U32.or(x, DL(0n, 8n+e))) == True{} : Bool}), F.nat__lt_zero_absurd(e, hb))
    case 1n 0n:
      bw8(x, hz)
    case 1n 1n:
      bw9(x, hz)
    case 1n 2n:
      bw10(x, hz)
    case 1n 3n:
      bw11(x, hz)
    case 1n 4n:
      bw12(x, hz)
    case 1n 5n:
      bw13(x, hz)
    case 1n 6n:
      bw14(x, hz)
    case 1n 7n:
      bw15(x, hz)
    case 1n 8n+ +e: Empty.absurd(DK.P2({BK.btk(1n+Nat.add(VS.x8(1n), 8n+e), BLf.wbits(U32.or(x, DL(1n, 8n+e)))) == List.append(&2, Bool, BK.btk(Nat.add(VS.x8(1n), 8n+e), BLf.wbits(x)), [True{}]) : +List<Bool>}, {BK.zw(1n+Nat.add(VS.x8(1n), 8n+e), U32.or(x, DL(1n, 8n+e))) == True{} : Bool}), F.nat__lt_zero_absurd(e, hb))
    case 2n 0n:
      bw16(x, hz)
    case 2n 1n:
      bw17(x, hz)
    case 2n 2n:
      bw18(x, hz)
    case 2n 3n:
      bw19(x, hz)
    case 2n 4n:
      bw20(x, hz)
    case 2n 5n:
      bw21(x, hz)
    case 2n 6n:
      bw22(x, hz)
    case 2n 7n:
      bw23(x, hz)
    case 2n 8n+ +e: Empty.absurd(DK.P2({BK.btk(1n+Nat.add(VS.x8(2n), 8n+e), BLf.wbits(U32.or(x, DL(2n, 8n+e)))) == List.append(&2, Bool, BK.btk(Nat.add(VS.x8(2n), 8n+e), BLf.wbits(x)), [True{}]) : +List<Bool>}, {BK.zw(1n+Nat.add(VS.x8(2n), 8n+e), U32.or(x, DL(2n, 8n+e))) == True{} : Bool}), F.nat__lt_zero_absurd(e, hb))
    case 3n 0n:
      bw24(x, hz)
    case 3n 1n:
      bw25(x, hz)
    case 3n 2n:
      bw26(x, hz)
    case 3n 3n:
      bw27(x, hz)
    case 3n 4n:
      bw28(x, hz)
    case 3n 5n:
      bw29(x, hz)
    case 3n 6n:
      bw30(x, hz)
    case 3n 7n:
      bw31(x, hz)
    case 3n 8n+ +e: Empty.absurd(DK.P2({BK.btk(1n+Nat.add(VS.x8(3n), 8n+e), BLf.wbits(U32.or(x, DL(3n, 8n+e)))) == List.append(&2, Bool, BK.btk(Nat.add(VS.x8(3n), 8n+e), BLf.wbits(x)), [True{}]) : +List<Bool>}, {BK.zw(1n+Nat.add(VS.x8(3n), 8n+e), U32.or(x, DL(3n, 8n+e))) == True{} : Bool}), F.nat__lt_zero_absurd(e, hb))
    case 4n+ +e _: Empty.absurd(DK.P2({BK.btk(1n+Nat.add(VS.x8(4n+e), b), BLf.wbits(U32.or(x, DL(4n+e, b)))) == List.append(&2, Bool, BK.btk(Nat.add(VS.x8(4n+e), b), BLf.wbits(x)), [True{}]) : +List<Bool>}, {BK.zw(1n+Nat.add(VS.x8(4n+e), b), U32.or(x, DL(4n+e, b))) == True{} : Bool}), F.nat__lt_zero_absurd(e, hj))

# The runtime delimiter mask (O.w8_delim at p = 0) is DL of the bit count's byte and bit.
law dmk_dl:
  for +K: U32
  for +j: Nat
  for +b: Nat
  for +ej: {U32.to_nat(U32.and(U32.add(0, U32.shrn(K, 3n)), 3)) == j : Nat}
  for +eb: {U32.to_nat(U32.and(K, 7)) == b : Nat}
  for +hj: {Nat.is_lt(j, 4n) == True{} : Bool}
  for +hb: {Nat.is_lt(b, 8n) == True{} : Bool}
