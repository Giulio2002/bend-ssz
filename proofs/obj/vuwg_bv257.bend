  match r:
    case 0n:
      %Equal.sym(Nat, Nat.add(A.quad(q), 0n), A.quad(q), FD.nat__add_zero(A.quad(q))) : {UA.BYT(PX_bv257(0n, dd, D, q, w0, w1, w2, w3, w4, w5, w6, w7, w8)) == UW.SPL(UA.BYT(D), _, List.append(&2, U32, VS.bt(33n, FX.limbs([w0, w1, w2, w3, w4, w5, w6, w7, w8])), UW.ZB(UWD.PADB(0n, 33n)))) : +List<U32>}
      %Equal.trans(+List<U32>, VS.bt(36n, FX.limbs([w0, w1, w2, w3, w4, w5, w6, w7, w8])), VS.bt(36n, List.append(&2, U32, FX.limbs([w0, w1, w2, w3, w4, w5, w6, w7]), List.append(&2, U32, List.append(&2, U32, VS.bt(1n, I.limb(w8)), [0, 0, 0]), []))), List.append(&2, U32, VS.bt(33n, FX.limbs([w0, w1, w2, w3, w4, w5, w6, w7, w8])), UW.ZB(UWD.PADB(0n, 33n))),
          Equal.cong(+List<U32>, +List<U32>, z => VS.bt(36n, List.append(&2, U32, FX.limbs([w0, w1, w2, w3, w4, w5, w6, w7]), List.append(&2, U32, z, []))), I.limb(w8), List.append(&2, U32, VS.bt(1n, I.limb(w8)), [0, 0, 0]), UWB.tzl1(w8, vt)), {==}) :
        {UA.BYT(PX_bv257(0n, dd, D, q, w0, w1, w2, w3, w4, w5, w6, w7, w8)) == UW.SPL(UA.BYT(D), A.quad(q), _) : +List<U32>}
      %Equal.sym(+List<U32>, VS.bt(36n, FX.limbs([w0, w1, w2, w3, w4, w5, w6, w7, w8])), FX.limbs([w0, w1, w2, w3, w4, w5, w6, w7, w8]), {==}) :
        {UA.BYT(PX_bv257(0n, dd, D, q, w0, w1, w2, w3, w4, w5, w6, w7, w8)) == UW.SPL(UA.BYT(D), A.quad(q), _) : +List<U32>}
      UW.updv_bytes([w0, w1, w2, w3, w4, w5, w6, w7, w8], dd, D, q, pf, hl)
    case 1n:
      %Equal.trans(+List<U32>, VS.bt(35n, FX.limbs([w0, w1, w2, w3, w4, w5, w6, w7, w8])), VS.bt(35n, List.append(&2, U32, FX.limbs([w0, w1, w2, w3, w4, w5, w6, w7]), List.append(&2, U32, List.append(&2, U32, VS.bt(1n, I.limb(w8)), [0, 0, 0]), []))), List.append(&2, U32, VS.bt(33n, FX.limbs([w0, w1, w2, w3, w4, w5, w6, w7, w8])), UW.ZB(UWD.PADB(1n, 33n))),
          Equal.cong(+List<U32>, +List<U32>, z => VS.bt(35n, List.append(&2, U32, FX.limbs([w0, w1, w2, w3, w4, w5, w6, w7]), List.append(&2, U32, z, []))), I.limb(w8), List.append(&2, U32, VS.bt(1n, I.limb(w8)), [0, 0, 0]), UWB.tzl1(w8, vt)), {==}) :
        {UA.BYT(PX_bv257(1n, dd, D, q, w0, w1, w2, w3, w4, w5, w6, w7, w8)) == UW.SPL(UA.BYT(D), Nat.add(A.quad(q), 1n), _) : +List<U32>}
