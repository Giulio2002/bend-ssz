# The writer's non-empty test, and its loop.
def ptnzW(+da: Nat, +A: FD.array__Tree<SmallTestStruct_d.SmallTestStruct>, +N: U32, +b: Bool, +eb: {U32.is_eq(N, 0) == b : Bool}, +h: {OKT(da, A, N) == True{} : Bool}, +dd: Nat, +D: FD.array__Tree<U32>, +X: U32, +P0: Nat,
    +e: {U32.to_nat(X) == P0 : Nat}, +hd: {Nat.is_lt(dd, 31n) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(P0, Nat.mul(U32.to_nat(N), 4n)), A.quad(VB.pw(dd))) == True{} : Bool}, +pf: {FD.array__perfect(U32, dd, D) == True{} : Bool},
    +hz: {VS.bt(Nat.mul(U32.to_nat(N), 4n), VS.bdr(P0, UA.BYT(D))) == UW.ZB(Nat.mul(U32.to_nat(N), 4n)) : +List<U32>})
    -> DK.P2(RTN(b, A, N, dd, D, X, P0), BYN(b, A, N, dd, D, P0)):
  match b:
    case True{}:
      +eN = Equal.cong(U32, Nat, z => U32.to_nat(z), N, 0, FD.u32alg__eq_of(N, 0, eb))
      ({==}, FD.logic__subst(Nat, z => {UA.BYT(D) == UW.SPL(UA.BYT(D), P0, RBS(z, A, 0n)) : +List<U32>}, 0n, U32.to_nat(N), Equal.sym(Nat, U32.to_nat(N), 0n, eN),
        Equal.sym(+List<U32>, UW.SPL(UA.BYT(D), P0, []), UA.BYT(D), VRX.spl_nil(UA.BYT(D), P0))))
    case False{}:
      +c = U32.to_nat(N)
      +LL = Nat.mul(c, 4n)
      +pfA = ok_1(da, A, N, h)
      +hda = hda31(da, A, N, h)
      +hca = ok_2(da, A, N, h)
      +h1 = VRL.cposu(N, c, {==}, eb)
      +k = U32.to_nat(U32.sub(N, 1))
      +e1 = Equal.trans(Nat, 1n+k, 1n+Nat.sub(c, 1n), c, Equal.cong(Nat, Nat, z => 1n+z, k, Nat.sub(c, 1n), FD.u32__sub_nat(N, 1, h1)), FD.nat__sub_add(c, 1n, h1))
      +hj = FD.logic__subst(Nat, z => {Nat.is_le(Nat.mul(z, 4n), LL) == True{} : Bool}, c, Nat.add(1n+k, 0n),
        Equal.trans(Nat, c, 1n+k, Nat.add(1n+k, 0n), Equal.sym(Nat, 1n+k, c, e1), Equal.sym(Nat, Nat.add(1n+k, 0n), 1n+k, FD.nat__add_zero(1n+k))), FD.nat__le_refl(LL))
      +hz2 = FD.logic__subst(Nat, z => {VS.bt(Nat.mul(z, 4n), VS.bdr(P0, UA.BYT(D))) == UW.ZB(Nat.mul(z, 4n)) : +List<U32>}, c, 1n+k, Equal.sym(Nat, 1n+k, c, e1), hz)
      +hk = FD.logic__subst(Nat, z => {Nat.is_lt(z, VB.pw(da)) == True{} : Bool}, k, Nat.add(k, 0n), Equal.sym(Nat, Nat.add(k, 0n), k, FD.nat__add_zero(k)),
        FD.nat__lt_le_trans(k, c, VB.pw(da), FD.logic__subst(Nat, z => {Nat.is_lt(k, z) == True{} : Bool}, 1n+k, c, e1, FD.nat__lt_succ(k)), hca))
      +h0 = FD.nat__lt_le_trans(0n, c, VB.pw(da), FD.nat__succ_le_lt(0n, c, h1), hca)
      +eg0 = get0(da, A, pfA, hda, h0)
      +g = ptxW(k, 0, 0n, X, P0, dd, D, da, A, LL, {==}, e, hd, pf, hj, hb, hz2, pfA, hda, hk)
      +rt = PA(RTK(k, 0, 0n, X, P0, dd, D, A), BYK(k, 0n, P0, dd, D, A), g)
      +by = PB(RTK(k, 0, 0n, X, P0, dd, D, A), BYK(k, 0n, P0, dd, D, A), g)
      +ea = Equal.cong(Array<SmallTestStruct_d.SmallTestStruct> & SmallTestStruct_d.SmallTestStruct, Array<U32> & proglist_SmallTestStruct_d.pl_SmallTestStruct_Seq, z => proglist_SmallTestStruct_e.pl_SmallTestStruct_pt_fin(N, proglist_SmallTestStruct_e.pl_SmallTestStruct_pt(k, 0, X, FD.array__thaw(U32, D), z)), AG(A, 0), (FD.array__thaw(SmallTestStruct_d.SmallTestStruct, A), EL(A, 0n)), eg0)
      +eb2 = Equal.cong(Array<U32> & Array<SmallTestStruct_d.SmallTestStruct>, Array<U32> & proglist_SmallTestStruct_d.pl_SmallTestStruct_Seq, z => proglist_SmallTestStruct_e.pl_SmallTestStruct_pt_fin(N, z), proglist_SmallTestStruct_e.pl_SmallTestStruct_pt(k, 0, X, FD.array__thaw(U32, D), (FD.array__thaw(SmallTestStruct_d.SmallTestStruct, A), EL(A, 0n))), (FD.array__thaw(U32, WX(k, 0n, dd, D, P0, A)), FD.array__thaw(SmallTestStruct_d.SmallTestStruct, A)), rt)
      (Equal.trans(Array<U32> & proglist_SmallTestStruct_d.pl_SmallTestStruct_Seq, proglist_SmallTestStruct_e.pl_SmallTestStruct_pt_fin(N, proglist_SmallTestStruct_e.pl_SmallTestStruct_pt(k, 0, X, FD.array__thaw(U32, D), AG(A, 0))), proglist_SmallTestStruct_e.pl_SmallTestStruct_pt_fin(N, proglist_SmallTestStruct_e.pl_SmallTestStruct_pt(k, 0, X, FD.array__thaw(U32, D), (FD.array__thaw(SmallTestStruct_d.SmallTestStruct, A), EL(A, 0n)))),
         proglist_SmallTestStruct_e.pl_SmallTestStruct_pt_fin(N, (FD.array__thaw(U32, WX(k, 0n, dd, D, P0, A)), FD.array__thaw(SmallTestStruct_d.SmallTestStruct, A))), ea, eb2),
       FD.logic__subst(Nat, z => {UA.BYT(WX(k, 0n, dd, D, P0, A)) == UW.SPL(UA.BYT(D), P0, RBS(z, A, 0n)) : +List<U32>}, 1n+k, c, e1, by))

