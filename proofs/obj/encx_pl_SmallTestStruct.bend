def szx(m, hok):
  match m:
    case MW{+da, +A, +N}:
      +Q = A.quad(VB.pw(da))
      +hp = FD.u32__pow2u_value(2n+da, FD.nat__lt_trans(2n+da, 30n, 32n, ok_0(da, A, N, hok), {==}))
