    +pfA: {FD.array__perfect(SmallTestStruct_d.SmallTestStruct, da, A) == True{} : Bool}, +hda: {Nat.is_lt(da, 31n) == True{} : Bool}, +hk: {Nat.is_lt(Nat.add(k, j), VB.pw(da)) == True{} : Bool})
    -> {proglist_SmallTestStruct_e.pl_SmallTestStruct_va(k, i, True{}, (FD.array__thaw(SmallTestStruct_d.SmallTestStruct, A), EL(A, j))) == (FD.array__thaw(SmallTestStruct_d.SmallTestStruct, A), True{}) : Array<SmallTestStruct_d.SmallTestStruct> & Bool}:
  match k:
    case 0n:
      %Equal.sym(Bool, SmallTestStruct_e.SmallTestStruct_valid(EL(A, j)), True{}, and_l(SmallTestStruct_e.SmallTestStruct_valid(EL(A, j)), VOK(0n, A, 1n+j), h)) : {(FD.array__thaw(SmallTestStruct_d.SmallTestStruct, A), _) == (FD.array__thaw(SmallTestStruct_d.SmallTestStruct, A), True{}) : Array<SmallTestStruct_d.SmallTestStruct> & Bool}
      {==}
    case 1n+ +p:
      +hv = and_l(SmallTestStruct_e.SmallTestStruct_valid(EL(A, j)), VOK(1n+p, A, 1n+j), h)
      +hr = and_r(SmallTestStruct_e.SmallTestStruct_valid(EL(A, j)), VOK(1n+p, A, 1n+j), h)
      +h1 = FD.nat__le_lt_trans(1n+j, 1n+Nat.add(p, j), VB.pw(da), Order.left_below_sum(p, j), hk)
      +ei1 = VB.add_le_at(i, 1, j, da, ei, hda, FD.nat__lt_le(1n+j, VB.pw(da), h1))
      +hk2 = FD.logic__subst(Nat, z => {Nat.is_lt(z, VB.pw(da)) == True{} : Bool}, 1n+Nat.add(p, j), Nat.add(p, 1n+j), Equal.sym(Nat, Nat.add(p, 1n+j), 1n+Nat.add(p, j), FD.nat__add_succ(p, j)), hk)
      %Equal.sym(Bool, SmallTestStruct_e.SmallTestStruct_valid(EL(A, j)), True{}, hv) : {proglist_SmallTestStruct_e.pl_SmallTestStruct_va(p, U32.add(i, 1), _, AG(A, U32.add(i, 1))) == (FD.array__thaw(SmallTestStruct_d.SmallTestStruct, A), True{}) : Array<SmallTestStruct_d.SmallTestStruct> & Bool}
      %Equal.sym(Array<SmallTestStruct_d.SmallTestStruct> & SmallTestStruct_d.SmallTestStruct, AG(A, U32.add(i, 1)), (FD.array__thaw(SmallTestStruct_d.SmallTestStruct, A), EL(A, 1n+j)), geti(i, j, da, A, ei, pfA, hda, h1)) : {proglist_SmallTestStruct_e.pl_SmallTestStruct_va(p, U32.add(i, 1), True{}, _) == (FD.array__thaw(SmallTestStruct_d.SmallTestStruct, A), True{}) : Array<SmallTestStruct_d.SmallTestStruct> & Bool}
      vax(p, U32.add(i, 1), 1n+j, da, A, ei1, hr, pfA, hda, hk2)

# ---- pl_SmallTestStruct: the write loop (record j at byte P0 + 4 j) ----

def WX(k: Nat, +j: Nat, +dd: Nat, D: FD.array__Tree<U32>, +P0: Nat, +A: FD.array__Tree<SmallTestStruct_d.SmallTestStruct>) -> FD.array__Tree<U32>:
  match k:
    case 0n: PR_SmallTestStruct(EL(A, j), dd, D, VRL.pos(j, 4n, P0))
    case 1n+p: WX(p, 1n+j, dd, PR_SmallTestStruct(EL(A, j), dd, D, VRL.pos(j, 4n, P0)), P0, A)

law pfWX:
  for +k: Nat
  for +j: Nat
  for +dd: Nat
  for +D: FD.array__Tree<U32>
  for +P0: Nat
  for +A: FD.array__Tree<SmallTestStruct_d.SmallTestStruct>
  for +pf: {FD.array__perfect(U32, dd, D) == True{} : Bool}
  {FD.array__perfect(U32, dd, WX(k, j, dd, D, P0, A)) == True{} : Bool}
def pfWX(k, j, dd, D, P0, A, pf):
  match k:
    case 0n: pfr_SmallTestStruct(EL(A, j), dd, D, VRL.pos(j, 4n, P0), pf)
    case 1n+ +p: pfWX(p, 1n+j, dd, PR_SmallTestStruct(EL(A, j), dd, D, VRL.pos(j, 4n, P0)), P0, A, pfr_SmallTestStruct(EL(A, j), dd, D, VRL.pos(j, 4n, P0), pf))

def RTK(k: Nat, +i: U32, +j: Nat, +X: U32, +P0: Nat, +dd: Nat, +D: FD.array__Tree<U32>, +A: FD.array__Tree<SmallTestStruct_d.SmallTestStruct>) -> Data:
  {proglist_SmallTestStruct_e.pl_SmallTestStruct_pt(k, i, X, FD.array__thaw(U32, D), (FD.array__thaw(SmallTestStruct_d.SmallTestStruct, A), EL(A, j))) == (FD.array__thaw(U32, WX(k, j, dd, D, P0, A)), FD.array__thaw(SmallTestStruct_d.SmallTestStruct, A)) : Array<U32> & Array<SmallTestStruct_d.SmallTestStruct>}
def BYK(k: Nat, +j: Nat, +P0: Nat, +dd: Nat, +D: FD.array__Tree<U32>, +A: FD.array__Tree<SmallTestStruct_d.SmallTestStruct>) -> Data:
  {UA.BYT(WX(k, j, dd, D, P0, A)) == UW.SPL(UA.BYT(D), VRL.pos(j, 4n, P0), RBS(1n+k, A, j)) : +List<U32>}

# The loop from record j (index i) on, k + 1 records, into LT bytes at X (byte P0) whose last k + 1 records' bytes are zero.
def ptxW(k: Nat, +i: U32, +j: Nat, +X: U32, +P0: Nat, +dd: Nat, +D: FD.array__Tree<U32>, +da: Nat, +A: FD.array__Tree<SmallTestStruct_d.SmallTestStruct>, +LT: Nat,
    +ei: {U32.to_nat(i) == j : Nat}, +e: {U32.to_nat(X) == P0 : Nat}, +hd: {Nat.is_lt(dd, 31n) == True{} : Bool},
    +pfD: {FD.array__perfect(U32, dd, D) == True{} : Bool}, +hj: {Nat.is_le(Nat.mul(Nat.add(1n+k, j), 4n), LT) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(P0, LT), A.quad(VB.pw(dd))) == True{} : Bool},
    +hz: {VS.bt(Nat.mul(1n+k, 4n), VS.bdr(VRL.pos(j, 4n, P0), UA.BYT(D))) == UW.ZB(Nat.mul(1n+k, 4n)) : +List<U32>},
    +pfA: {FD.array__perfect(SmallTestStruct_d.SmallTestStruct, da, A) == True{} : Bool}, +hda: {Nat.is_lt(da, 31n) == True{} : Bool}, +hk: {Nat.is_lt(Nat.add(k, j), VB.pw(da)) == True{} : Bool})
    -> DK.P2(RTK(k, i, j, X, P0, dd, D, A), BYK(k, j, P0, dd, D, A)):
  match k:
    case 0n:
      +o = EL(A, j)
      +Pj = VRL.pos(j, 4n, P0)
      +Xj = U32.add(X, U32.mul(i, 4))
      +hbj = VRB.rroomb(j, 0n, 4n, P0, LT, A.quad(VB.pw(dd)), hj, hb)
      +ej = VRB.posbW(dd, X, i, j, 4, 4n, P0, {==}, e, ei, hd, {==}, hbj)
      +g = putr_SmallTestStructW(o, dd, D, Xj, Pj, ej, hd, hbj, pfD, hz)
      +rt = PA(RTR_SmallTestStruct(o, dd, D, Xj, Pj), BYR_SmallTestStruct(o, dd, D, Pj), g)
      +by = PB(RTR_SmallTestStruct(o, dd, D, Xj, Pj), BYR_SmallTestStruct(o, dd, D, Pj), g)
      +D1 = PR_SmallTestStruct(o, dd, D, Pj)
      +Y = RB_SmallTestStruct(o)
      +rt0 = Equal.cong(Array<U32>, Array<U32> & Array<SmallTestStruct_d.SmallTestStruct>, z => (z, FD.array__thaw(SmallTestStruct_d.SmallTestStruct, A)), SmallTestStruct_e.SmallTestStruct_put(FD.array__thaw(U32, D), Xj, o), FD.array__thaw(U32, D1), rt)
      +by0 = FD.logic__subst(+List<U32>, z => {UA.BYT(D1) == UW.SPL(UA.BYT(D), Pj, z) : +List<U32>}, Y, List.append(&2, U32, Y, []),
        Equal.sym(+List<U32>, List.append(&2, U32, Y, []), Y, VS.app_nil(Y)), by)
      (rt0, by0)
    case 1n+ +p:
      +o = EL(A, j)
      +Pj = VRL.pos(j, 4n, P0)
      +Xj = U32.add(X, U32.mul(i, 4))
      +hbj = VRB.rroomb(j, 1n+p, 4n, P0, LT, A.quad(VB.pw(dd)), hj, hb)
      +ej = VRB.posbW(dd, X, i, j, 4, 4n, P0, {==}, e, ei, hd, {==}, hbj)
      +bm = Nat.mul(1n+p, 4n)
      +B0 = UA.BYT(D)
      +hz0 = VRX.zhead(4n, bm, VS.bdr(Pj, B0), hz)
      +g = putr_SmallTestStructW(o, dd, D, Xj, Pj, ej, hd, hbj, pfD, hz0)
      +rt = PA(RTR_SmallTestStruct(o, dd, D, Xj, Pj), BYR_SmallTestStruct(o, dd, D, Pj), g)
      +by = PB(RTR_SmallTestStruct(o, dd, D, Xj, Pj), BYR_SmallTestStruct(o, dd, D, Pj), g)
      +D1 = PR_SmallTestStruct(o, dd, D, Pj)
      +pf1 = pfr_SmallTestStruct(o, dd, D, Pj, pfD)
      +Y = RB_SmallTestStruct(o)
      +hX = VRB.hxb(Pj, 4n, dd, D, pfD, hbj)
      +ey = VRB.pnext(j, 4n, P0)
      +z1 = VRX.znext(B0, Pj, Y, VRL.pos(1n+j, 4n, P0), 4n, bm, UA.BYT(D1), hX, lenr_SmallTestStruct(o), ey, by, hz)
      +h1 = FD.nat__le_lt_trans(1n+j, 1n+Nat.add(p, j), VB.pw(da), Order.left_below_sum(p, j), hk)
      +ei1 = VB.add_le_at(i, 1, j, da, ei, hda, FD.nat__lt_le(1n+j, VB.pw(da), h1))
      +eg = geti(i, j, da, A, ei, pfA, hda, h1)
      +hj2 = FD.logic__subst(Nat, z => {Nat.is_le(Nat.mul(1n+z, 4n), LT) == True{} : Bool}, 1n+Nat.add(p, j), Nat.add(p, 1n+j), Equal.sym(Nat, Nat.add(p, 1n+j), 1n+Nat.add(p, j), FD.nat__add_succ(p, j)), hj)
      +hk2 = FD.logic__subst(Nat, z => {Nat.is_lt(z, VB.pw(da)) == True{} : Bool}, 1n+Nat.add(p, j), Nat.add(p, 1n+j), Equal.sym(Nat, Nat.add(p, 1n+j), 1n+Nat.add(p, j), FD.nat__add_succ(p, j)), hk)
      +ih = ptxW(p, U32.add(i, 1), 1n+j, X, P0, dd, D1, da, A, LT, ei1, e, hd, pf1, hj2, hb, z1, pfA, hda, hk2)
      +rt2 = PA(RTK(p, U32.add(i, 1), 1n+j, X, P0, dd, D1, A), BYK(p, 1n+j, P0, dd, D1, A), ih)
      +by2 = PB(RTK(p, U32.add(i, 1), 1n+j, X, P0, dd, D1, A), BYK(p, 1n+j, P0, dd, D1, A), ih)
      +ea = Equal.cong(Array<U32>, Array<U32> & Array<SmallTestStruct_d.SmallTestStruct>, z => proglist_SmallTestStruct_e.pl_SmallTestStruct_pt(p, U32.add(i, 1), X, z, AG(A, U32.add(i, 1))), SmallTestStruct_e.SmallTestStruct_put(FD.array__thaw(U32, D), Xj, o), FD.array__thaw(U32, D1), rt)
      +eb = Equal.cong(Array<SmallTestStruct_d.SmallTestStruct> & SmallTestStruct_d.SmallTestStruct, Array<U32> & Array<SmallTestStruct_d.SmallTestStruct>, z => proglist_SmallTestStruct_e.pl_SmallTestStruct_pt(p, U32.add(i, 1), X, FD.array__thaw(U32, D1), z), AG(A, U32.add(i, 1)), (FD.array__thaw(SmallTestStruct_d.SmallTestStruct, A), EL(A, 1n+j)), eg)
      +rt3 = Equal.trans(Array<U32> & Array<SmallTestStruct_d.SmallTestStruct>, proglist_SmallTestStruct_e.pl_SmallTestStruct_pt(p, U32.add(i, 1), X, SmallTestStruct_e.SmallTestStruct_put(FD.array__thaw(U32, D), Xj, o), AG(A, U32.add(i, 1))), proglist_SmallTestStruct_e.pl_SmallTestStruct_pt(p, U32.add(i, 1), X, FD.array__thaw(U32, D1), AG(A, U32.add(i, 1))),
        (FD.array__thaw(U32, WX(p, 1n+j, dd, D1, P0, A)), FD.array__thaw(SmallTestStruct_d.SmallTestStruct, A)), ea,
        Equal.trans(Array<U32> & Array<SmallTestStruct_d.SmallTestStruct>, proglist_SmallTestStruct_e.pl_SmallTestStruct_pt(p, U32.add(i, 1), X, FD.array__thaw(U32, D1), AG(A, U32.add(i, 1))), proglist_SmallTestStruct_e.pl_SmallTestStruct_pt(p, U32.add(i, 1), X, FD.array__thaw(U32, D1), (FD.array__thaw(SmallTestStruct_d.SmallTestStruct, A), EL(A, 1n+j))),
          (FD.array__thaw(U32, WX(p, 1n+j, dd, D1, P0, A)), FD.array__thaw(SmallTestStruct_d.SmallTestStruct, A)), eb, rt2))
      +rest = RBS(1n+p, A, 1n+j)
      +eXn = Equal.trans(Nat, VRL.pos(1n+j, 4n, P0), Nat.add(Pj, 4n), Nat.add(Pj, VRX.LN(Y)), ey,
        Equal.cong(Nat, Nat, z => Nat.add(Pj, z), 4n, VRX.LN(Y), Equal.sym(Nat, VRX.LN(Y), 4n, lenr_SmallTestStruct(o))))
      +by3 = Equal.trans(+List<U32>, UA.BYT(WX(p, 1n+j, dd, D1, P0, A)), UW.SPL(UA.BYT(D1), VRL.pos(1n+j, 4n, P0), rest), UW.SPL(B0, Pj, VRX.AP(Y, rest)), by2,
        VRX.spl_catx(B0, Pj, Y, rest, VRL.pos(1n+j, 4n, P0), UA.BYT(D1), hX, eXn, by))
      (rt3, by3)

# ---- pl_SmallTestStruct: the encoder-window interface ----

# The object's Data mirror: the tree A of depth da holding the N records.
type MW is Data:
  MW{da: Nat, A: FD.array__Tree<SmallTestStruct_d.SmallTestStruct>, N: U32}

def ptx(k: Nat, +i: U32, +j: Nat, +X: U32, +P0: Nat, +dd: Nat, +D: FD.array__Tree<U32>, +da: Nat, +A: FD.array__Tree<SmallTestStruct_d.SmallTestStruct>, +LT: Nat,
    +ei: {U32.to_nat(i) == j : Nat}, +e: {U32.to_nat(X) == P0 : Nat}, +hd: {Nat.is_lt(dd, 29n) == True{} : Bool},
    +pfD: {FD.array__perfect(U32, dd, D) == True{} : Bool}, +hj: {Nat.is_le(Nat.mul(Nat.add(1n+k, j), 4n), LT) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(P0, LT), A.quad(VB.pw(dd))) == True{} : Bool},
    +hz: {VS.bt(Nat.mul(1n+k, 4n), VS.bdr(VRL.pos(j, 4n, P0), UA.BYT(D))) == UW.ZB(Nat.mul(1n+k, 4n)) : +List<U32>},
    +pfA: {FD.array__perfect(SmallTestStruct_d.SmallTestStruct, da, A) == True{} : Bool}, +hda: {Nat.is_lt(da, 31n) == True{} : Bool}, +hk: {Nat.is_lt(Nat.add(k, j), VB.pw(da)) == True{} : Bool})
    -> DK.P2(RTK(k, i, j, X, P0, dd, D, A), BYK(k, j, P0, dd, D, A)):
  ptxW(k, i, j, X, P0, dd, D, da, A, LT, ei, e, FD.nat__lt_trans(dd, 29n, 31n, hd, {==}), pfD, hj, hb, hz, pfA, hda, hk)

def TH(m: MW) -> proglist_SmallTestStruct_d.pl_SmallTestStruct_Seq:
  match m:
    case MW{+da, +A, +N}: proglist_SmallTestStruct_d.pl_SmallTestStruct_Seq{FD.array__thaw(SmallTestStruct_d.SmallTestStruct, A), N}

# A valid object: a perfect tree of depth < 28 with room for the N records, whose 4 N bytes fit
# 4 2^da, and whose records pass the runtime's check.
def OKT(+da: Nat, +A: FD.array__Tree<SmallTestStruct_d.SmallTestStruct>, +N: U32) -> Bool:
  Bool.and(Nat.is_lt(da, 28n), Bool.and(FD.array__perfect(SmallTestStruct_d.SmallTestStruct, da, A), Bool.and(Nat.is_le(U32.to_nat(N), VB.pw(da)), Bool.and(Nat.is_le(Nat.mul(U32.to_nat(N), 4n), A.quad(VB.pw(da))), VOK(U32.to_nat(N), A, 0n)))))
def ok_r1(+da: Nat, +A: FD.array__Tree<SmallTestStruct_d.SmallTestStruct>, +N: U32, +h: {Bool.and(Nat.is_lt(da, 28n), Bool.and(FD.array__perfect(SmallTestStruct_d.SmallTestStruct, da, A), Bool.and(Nat.is_le(U32.to_nat(N), VB.pw(da)), Bool.and(Nat.is_le(Nat.mul(U32.to_nat(N), 4n), A.quad(VB.pw(da))), VOK(U32.to_nat(N), A, 0n))))) == True{} : Bool}) -> {Bool.and(FD.array__perfect(SmallTestStruct_d.SmallTestStruct, da, A), Bool.and(Nat.is_le(U32.to_nat(N), VB.pw(da)), Bool.and(Nat.is_le(Nat.mul(U32.to_nat(N), 4n), A.quad(VB.pw(da))), VOK(U32.to_nat(N), A, 0n)))) == True{} : Bool}:
  and_r(Nat.is_lt(da, 28n), Bool.and(FD.array__perfect(SmallTestStruct_d.SmallTestStruct, da, A), Bool.and(Nat.is_le(U32.to_nat(N), VB.pw(da)), Bool.and(Nat.is_le(Nat.mul(U32.to_nat(N), 4n), A.quad(VB.pw(da))), VOK(U32.to_nat(N), A, 0n)))), h)
def ok_r2(+da: Nat, +A: FD.array__Tree<SmallTestStruct_d.SmallTestStruct>, +N: U32, +h: {Bool.and(Nat.is_lt(da, 28n), Bool.and(FD.array__perfect(SmallTestStruct_d.SmallTestStruct, da, A), Bool.and(Nat.is_le(U32.to_nat(N), VB.pw(da)), Bool.and(Nat.is_le(Nat.mul(U32.to_nat(N), 4n), A.quad(VB.pw(da))), VOK(U32.to_nat(N), A, 0n))))) == True{} : Bool}) -> {Bool.and(Nat.is_le(U32.to_nat(N), VB.pw(da)), Bool.and(Nat.is_le(Nat.mul(U32.to_nat(N), 4n), A.quad(VB.pw(da))), VOK(U32.to_nat(N), A, 0n))) == True{} : Bool}:
  and_r(FD.array__perfect(SmallTestStruct_d.SmallTestStruct, da, A), Bool.and(Nat.is_le(U32.to_nat(N), VB.pw(da)), Bool.and(Nat.is_le(Nat.mul(U32.to_nat(N), 4n), A.quad(VB.pw(da))), VOK(U32.to_nat(N), A, 0n))), ok_r1(da, A, N, h))
def ok_r3(+da: Nat, +A: FD.array__Tree<SmallTestStruct_d.SmallTestStruct>, +N: U32, +h: {Bool.and(Nat.is_lt(da, 28n), Bool.and(FD.array__perfect(SmallTestStruct_d.SmallTestStruct, da, A), Bool.and(Nat.is_le(U32.to_nat(N), VB.pw(da)), Bool.and(Nat.is_le(Nat.mul(U32.to_nat(N), 4n), A.quad(VB.pw(da))), VOK(U32.to_nat(N), A, 0n))))) == True{} : Bool}) -> {Bool.and(Nat.is_le(Nat.mul(U32.to_nat(N), 4n), A.quad(VB.pw(da))), VOK(U32.to_nat(N), A, 0n)) == True{} : Bool}:
  and_r(Nat.is_le(U32.to_nat(N), VB.pw(da)), Bool.and(Nat.is_le(Nat.mul(U32.to_nat(N), 4n), A.quad(VB.pw(da))), VOK(U32.to_nat(N), A, 0n)), ok_r2(da, A, N, h))
def ok_r4(+da: Nat, +A: FD.array__Tree<SmallTestStruct_d.SmallTestStruct>, +N: U32, +h: {Bool.and(Nat.is_lt(da, 28n), Bool.and(FD.array__perfect(SmallTestStruct_d.SmallTestStruct, da, A), Bool.and(Nat.is_le(U32.to_nat(N), VB.pw(da)), Bool.and(Nat.is_le(Nat.mul(U32.to_nat(N), 4n), A.quad(VB.pw(da))), VOK(U32.to_nat(N), A, 0n))))) == True{} : Bool}) -> {VOK(U32.to_nat(N), A, 0n) == True{} : Bool}:
  and_r(Nat.is_le(Nat.mul(U32.to_nat(N), 4n), A.quad(VB.pw(da))), VOK(U32.to_nat(N), A, 0n), ok_r3(da, A, N, h))
def ok_0(+da: Nat, +A: FD.array__Tree<SmallTestStruct_d.SmallTestStruct>, +N: U32, +h: {Bool.and(Nat.is_lt(da, 28n), Bool.and(FD.array__perfect(SmallTestStruct_d.SmallTestStruct, da, A), Bool.and(Nat.is_le(U32.to_nat(N), VB.pw(da)), Bool.and(Nat.is_le(Nat.mul(U32.to_nat(N), 4n), A.quad(VB.pw(da))), VOK(U32.to_nat(N), A, 0n))))) == True{} : Bool}) -> {Nat.is_lt(da, 28n) == True{} : Bool}:
  and_l(Nat.is_lt(da, 28n), Bool.and(FD.array__perfect(SmallTestStruct_d.SmallTestStruct, da, A), Bool.and(Nat.is_le(U32.to_nat(N), VB.pw(da)), Bool.and(Nat.is_le(Nat.mul(U32.to_nat(N), 4n), A.quad(VB.pw(da))), VOK(U32.to_nat(N), A, 0n)))), h)
def ok_1(+da: Nat, +A: FD.array__Tree<SmallTestStruct_d.SmallTestStruct>, +N: U32, +h: {Bool.and(Nat.is_lt(da, 28n), Bool.and(FD.array__perfect(SmallTestStruct_d.SmallTestStruct, da, A), Bool.and(Nat.is_le(U32.to_nat(N), VB.pw(da)), Bool.and(Nat.is_le(Nat.mul(U32.to_nat(N), 4n), A.quad(VB.pw(da))), VOK(U32.to_nat(N), A, 0n))))) == True{} : Bool}) -> {FD.array__perfect(SmallTestStruct_d.SmallTestStruct, da, A) == True{} : Bool}:
  and_l(FD.array__perfect(SmallTestStruct_d.SmallTestStruct, da, A), Bool.and(Nat.is_le(U32.to_nat(N), VB.pw(da)), Bool.and(Nat.is_le(Nat.mul(U32.to_nat(N), 4n), A.quad(VB.pw(da))), VOK(U32.to_nat(N), A, 0n))), ok_r1(da, A, N, h))
def ok_2(+da: Nat, +A: FD.array__Tree<SmallTestStruct_d.SmallTestStruct>, +N: U32, +h: {Bool.and(Nat.is_lt(da, 28n), Bool.and(FD.array__perfect(SmallTestStruct_d.SmallTestStruct, da, A), Bool.and(Nat.is_le(U32.to_nat(N), VB.pw(da)), Bool.and(Nat.is_le(Nat.mul(U32.to_nat(N), 4n), A.quad(VB.pw(da))), VOK(U32.to_nat(N), A, 0n))))) == True{} : Bool}) -> {Nat.is_le(U32.to_nat(N), VB.pw(da)) == True{} : Bool}:
  and_l(Nat.is_le(U32.to_nat(N), VB.pw(da)), Bool.and(Nat.is_le(Nat.mul(U32.to_nat(N), 4n), A.quad(VB.pw(da))), VOK(U32.to_nat(N), A, 0n)), ok_r2(da, A, N, h))
