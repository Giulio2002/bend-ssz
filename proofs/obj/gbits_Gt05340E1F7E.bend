law Gt05340E1F7E_root_correct:
  for -h: B.Buf
  for +o: T.Bitvector511
  for +e: {Gt05340E1F7E_last(o) == U32{WSp.join(31n, 1n, WSp.take(31n, 32n, PD.bits(Gt05340E1F7E_last(o))), Word.zero(1n))} : U32}
