# extra_data: its offset word, then its bytes (T.bl32_putv).
def putv_extra_data(+m_extra_data: EB.MW, +D: FD.array__Tree<U32>, +D1: FD.array__Tree<U32>, +D2: FD.array__Tree<U32>, +X: U32, +hoff: U32, +cur: U32,
    +e1: {O.w32(FD.array__thaw(U32, D), U32.add(X, hoff), cur) == FD.array__thaw(U32, D1) : Array<U32>},
    +e2: {T.bl32_putk(FD.array__thaw(U32, D1), U32.add(X, cur), EB.TH(m_extra_data)) == (FD.array__thaw(U32, D2), (EB.TH(m_extra_data), EB.SZ(m_extra_data))) : Array<U32> & (O.Words & U32)})
    -> {T.bl32_putv(FD.array__thaw(U32, D), X, hoff, cur, EB.TH(m_extra_data)) == (FD.array__thaw(U32, D2), (EB.TH(m_extra_data), O.padd(cur, EB.SZ(m_extra_data)))) : Array<U32> & (O.Words & U32)}:
  Equal.trans(Array<U32> & (O.Words & U32), T.bl32_pvb(cur, T.bl32_putk(O.w32(FD.array__thaw(U32, D), U32.add(X, hoff), cur), U32.add(X, cur), EB.TH(m_extra_data))),
    T.bl32_pvb(cur, T.bl32_putk(FD.array__thaw(U32, D1), U32.add(X, cur), EB.TH(m_extra_data))), (FD.array__thaw(U32, D2), (EB.TH(m_extra_data), O.padd(cur, EB.SZ(m_extra_data)))),
    Equal.cong(Array<U32>, Array<U32> & (O.Words & U32), z => T.bl32_pvb(cur, T.bl32_putk(z, U32.add(X, cur), EB.TH(m_extra_data))), O.w32(FD.array__thaw(U32, D), U32.add(X, hoff), cur), FD.array__thaw(U32, D1), e1),
    Equal.cong(Array<U32> & (O.Words & U32), Array<U32> & (O.Words & U32), z => T.bl32_pvb(cur, z), T.bl32_putk(FD.array__thaw(U32, D1), U32.add(X, cur), EB.TH(m_extra_data)), (FD.array__thaw(U32, D2), (EB.TH(m_extra_data), EB.SZ(m_extra_data))), e2))


