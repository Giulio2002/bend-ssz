      +hLc = FD.logic__subst(Nat, z => {Nat.is_le(Nat.add(z, x), P) == True{} : Bool}, U32.to_nat(len), Nat.mul(c, 44n), ec, hL)
      +hb = FD.logic__subst(Nat, z => {Nat.is_le(VRL.pos(z, 44n, x), P) == True{} : Bool}, c, Nat.add(1n+k, 0n),
