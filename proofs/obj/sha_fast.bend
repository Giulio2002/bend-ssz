def recurrencef(+history: List<&2, U32>) -> U32:
  (sigma1f(VF.previous(history, 2n)) + VF.previous(history, 7n) + sigma0f(VF.previous(history, 15n)) + VF.previous(history, 16n) : U32)
law recurrence_eq:
  for +history: List<&2, U32>
  {recurrencef(history) == VF.recurrence(history) : U32}
def recurrence_eq(history):
  %Equal.sym(U32, sigma1f(VF.previous(history, 2n)), VF.sigma1(VF.previous(history, 2n)), sigma1_eq(VF.previous(history, 2n))) :
    {(_ + VF.previous(history, 7n) + sigma0f(VF.previous(history, 15n)) + VF.previous(history, 16n) : U32) == VF.recurrence(history) : U32}
  %Equal.sym(U32, sigma0f(VF.previous(history, 15n)), VF.sigma0(VF.previous(history, 15n)), sigma0_eq(VF.previous(history, 15n))) :
    {(VF.sigma1(VF.previous(history, 2n)) + VF.previous(history, 7n) + _ + VF.previous(history, 16n) : U32) == VF.recurrence(history) : U32}
  {==}

def extensionf(rounds: Nat, +history: List<&2, U32>) -> List<&2, U32>:
  match rounds:
    case 0n:
      Nil{}
    case 1n+p:
      +w = recurrencef(history)
      w <> extensionf(p, w <> history)

law extension_eq:
  for +rounds: Nat
  for +history: List<&2, U32>
  {extensionf(rounds, history) == VF.extension(rounds, history) : List<&2, U32>}
def extension_eq(rounds, history):
  match rounds:
    case 0n: {==}
    case 1n+ +p:
      %Equal.sym(U32, recurrencef(history), VF.recurrence(history), recurrence_eq(history)) :
        {Con{_, extensionf(p, Con{_, history})} == VF.extension(1n+p, history) : List<&2, U32>}
      Equal.cong(List<&2, U32>, List<&2, U32>, zl_ => Con{VF.recurrence(history), zl_},
        extensionf(p, Con{VF.recurrence(history), history}), VF.extension(p, Con{VF.recurrence(history), history}),
        extension_eq(p, Con{VF.recurrence(history), history}))

def schedulef(extra: Nat, +block: List<&2, U32>) -> List<&2, U32>:
  List.append(&2, U32, block, extensionf(extra, List.reverse(&2, U32, block)))
law schedule_eq:
  for +extra: Nat
  for +block: List<&2, U32>
  {schedulef(extra, block) == VF.schedule(extra, block) : List<&2, U32>}
def schedule_eq(extra, block):
  Equal.cong(List<&2, U32>, List<&2, U32>, zl_ => List.append(&2, U32, block, zl_),
    extensionf(extra, List.reverse(&2, U32, block)), VF.extension(extra, List.reverse(&2, U32, block)),
    extension_eq(extra, List.reverse(&2, U32, block)))

def schedulesf(ws: List<&2, U32>, +extra: Nat) -> List<&2, List<&2, U32>>:
  match ws:
    case a <> b <> c <> d <> e <> f <> g <> h <> i <> j <> k <> l <> m <> n <> o <> p <> rest:
      schedulef(extra, [a, b, c, d, e, f, g, h, i, j, k, l, m, n, o, p]) <> schedulesf(rest, extra)
    case _:
      Nil{}

law schedules_eq:
  for +ws: List<&2, U32>
  for +extra: Nat
  {schedulesf(ws, extra) == VF.schedules(ws, extra) : List<&2, List<&2, U32>>}
def schedules_eq(ws, extra):
  match ws:
    case Nil{}: {==}
    case Con{+a, Nil{}}: {==}
    case Con{+a, Con{+b, Nil{}}}: {==}
    case Con{+a, Con{+b, Con{+c, Nil{}}}}: {==}
    case Con{+a, Con{+b, Con{+c, Con{+d, Nil{}}}}}: {==}
    case Con{+a, Con{+b, Con{+c, Con{+d, Con{+e, Nil{}}}}}}: {==}
    case Con{+a, Con{+b, Con{+c, Con{+d, Con{+e, Con{+f, Nil{}}}}}}}: {==}
    case Con{+a, Con{+b, Con{+c, Con{+d, Con{+e, Con{+f, Con{+g, Nil{}}}}}}}}: {==}
    case Con{+a, Con{+b, Con{+c, Con{+d, Con{+e, Con{+f, Con{+g, Con{+h, Nil{}}}}}}}}}: {==}
    case Con{+a, Con{+b, Con{+c, Con{+d, Con{+e, Con{+f, Con{+g, Con{+h, Con{+i, Nil{}}}}}}}}}}: {==}
    case Con{+a, Con{+b, Con{+c, Con{+d, Con{+e, Con{+f, Con{+g, Con{+h, Con{+i, Con{+j, Nil{}}}}}}}}}}}: {==}
    case Con{+a, Con{+b, Con{+c, Con{+d, Con{+e, Con{+f, Con{+g, Con{+h, Con{+i, Con{+j, Con{+k, Nil{}}}}}}}}}}}}: {==}
    case Con{+a, Con{+b, Con{+c, Con{+d, Con{+e, Con{+f, Con{+g, Con{+h, Con{+i, Con{+j, Con{+k, Con{+l, Nil{}}}}}}}}}}}}}: {==}
    case Con{+a, Con{+b, Con{+c, Con{+d, Con{+e, Con{+f, Con{+g, Con{+h, Con{+i, Con{+j, Con{+k, Con{+l, Con{+m, Nil{}}}}}}}}}}}}}}: {==}
    case Con{+a, Con{+b, Con{+c, Con{+d, Con{+e, Con{+f, Con{+g, Con{+h, Con{+i, Con{+j, Con{+k, Con{+l, Con{+m, Con{+n, Nil{}}}}}}}}}}}}}}}: {==}
    case Con{+a, Con{+b, Con{+c, Con{+d, Con{+e, Con{+f, Con{+g, Con{+h, Con{+i, Con{+j, Con{+k, Con{+l, Con{+m, Con{+n, Con{+o, Nil{}}}}}}}}}}}}}}}}: {==}
    case Con{+a, Con{+b, Con{+c, Con{+d, Con{+e, Con{+f, Con{+g, Con{+h, Con{+i, Con{+j, Con{+k, Con{+l, Con{+m, Con{+n, Con{+o, Con{+p, +rest}}}}}}}}}}}}}}}}:
      %Equal.sym(List<&2, U32>, schedulef(extra, [a, b, c, d, e, f, g, h, i, j, k, l, m, n, o, p]), VF.schedule(extra, [a, b, c, d, e, f, g, h, i, j, k, l, m, n, o, p]), schedule_eq(extra, [a, b, c, d, e, f, g, h, i, j, k, l, m, n, o, p])) :
        {Con{_, schedulesf(rest, extra)} == VF.schedules(Con{a, Con{b, Con{c, Con{d, Con{e, Con{f, Con{g, Con{h, Con{i, Con{j, Con{k, Con{l, Con{m, Con{n, Con{o, Con{p, rest}}}}}}}}}}}}}}}}, extra) : List<&2, List<&2, U32>>}
      Equal.cong(List<&2, List<&2, U32>>, List<&2, List<&2, U32>>, zl_ => Con{VF.schedule(extra, [a, b, c, d, e, f, g, h, i, j, k, l, m, n, o, p]), zl_},
        schedulesf(rest, extra), VF.schedules(rest, extra), schedules_eq(rest, extra))

def decodef(a: U32, b: U32, c: U32, d: U32) -> U32:
  U32.or(U32.or(U32.or(shl24(U32.and(a, 255)), shl16(U32.and(b, 255))), shl8(U32.and(c, 255))), U32.and(d, 255))
law decode_eq:
  for +a: U32
  for +b: U32
  for +c: U32
  for +d: U32
  {decodef(a, b, c, d) == VF.decode(a, b, c, d) : U32}
def decode_eq(a, b, c, d):
  %Equal.sym(U32, shl24(U32.and(a, 255)), U32.shln(U32.and(a, 255), 24n), shl24_eq(U32.and(a, 255))) :
    {U32.or(U32.or(U32.or(_, shl16(U32.and(b, 255))), shl8(U32.and(c, 255))), U32.and(d, 255)) == VF.decode(a, b, c, d) : U32}
  %Equal.sym(U32, shl16(U32.and(b, 255)), U32.shln(U32.and(b, 255), 16n), shl16_eq(U32.and(b, 255))) :
    {U32.or(U32.or(U32.or(U32.shln(U32.and(a, 255), 24n), _), shl8(U32.and(c, 255))), U32.and(d, 255)) == VF.decode(a, b, c, d) : U32}
  %Equal.sym(U32, shl8(U32.and(c, 255)), U32.shln(U32.and(c, 255), 8n), shl8_eq(U32.and(c, 255))) :
    {U32.or(U32.or(U32.or(U32.shln(U32.and(a, 255), 24n), U32.shln(U32.and(b, 255), 16n)), _), U32.and(d, 255)) == VF.decode(a, b, c, d) : U32}
  {==}

def wordsf(bytes: List<&2, U32>) -> List<&2, U32>:
  match bytes:
    case a <> b <> c <> d <> rest:
      decodef(a, b, c, d) <> wordsf(rest)
    case _:
      Nil{}

law words_eq:
  for +bytes: List<&2, U32>
  {wordsf(bytes) == VF.words(bytes) : List<&2, U32>}
def words_eq(bytes):
  match bytes:
    case Nil{}: {==}
    case Con{+a, Nil{}}: {==}
    case Con{+a, Con{+b, Nil{}}}: {==}
    case Con{+a, Con{+b, Con{+c, Nil{}}}}: {==}
    case Con{+a, Con{+b, Con{+c, Con{+d, +rest}}}}:
      %Equal.sym(U32, decodef(a, b, c, d), VF.decode(a, b, c, d), decode_eq(a, b, c, d)) :
        {Con{_, wordsf(rest)} == VF.words(Con{a, Con{b, Con{c, Con{d, rest}}}}) : List<&2, U32>}
      Equal.cong(List<&2, U32>, List<&2, U32>, zl_ => Con{VF.decode(a, b, c, d), zl_}, wordsf(rest), VF.words(rest), words_eq(rest))

def preparef(bytes: List<&2, U32>, extra: Nat) -> List<&2, List<&2, U32>>:
  schedulesf(wordsf(VF.pad(bytes)), extra)

law prepare_eq:
  for +bytes: List<&2, U32>
  for +extra: Nat
  {preparef(bytes, extra) == VF.prepare(bytes, extra) : List<&2, List<&2, U32>>}
def prepare_eq(bytes, extra):
  %Equal.sym(List<&2, U32>, wordsf(VF.pad(bytes)), VF.words(VF.pad(bytes)), words_eq(VF.pad(bytes))) :
    {schedulesf(_, extra) == VF.prepare(bytes, extra) : List<&2, List<&2, U32>>}
  schedules_eq(VF.words(VF.pad(bytes)), extra)

def stepf(s: Types.State, k: U32, w: U32) -> Types.State:
  Types.H{+a, +b, +c, d, +e, +f, +g, h} = s
  +t1 = (h + sum1f(e) + VF.ch(e, f, g) + k + w : U32)
  t2 = (sum0f(a) + VF.maj(a, b, c) : U32)
  Types.H{(t1 + t2 : U32), a, b, c, (d + t1 : U32), e, f, g}

law step_eq:
  for +s: Types.State
  for +k: U32
  for +w: U32
  {stepf(s, k, w) == VF.step(s, k, w) : Types.State}
def step_eq(s, k, w):
  match s:
    case Types.H{+a, +b, +c, +d, +e, +f, +g, +h}:
      %Equal.sym(U32, sum1f(e), VF.sum1(e), sum1_eq(e)) :
        {Types.H{((h + _ + VF.ch(e, f, g) + k + w : U32) + (sum0f(a) + VF.maj(a, b, c) : U32) : U32), a, b, c, (d + (h + _ + VF.ch(e, f, g) + k + w : U32) : U32), e, f, g} == VF.step(Types.H{a, b, c, d, e, f, g, h}, k, w) : Types.State}
      %Equal.sym(U32, sum0f(a), VF.sum0(a), sum0_eq(a)) :
        {Types.H{((h + VF.sum1(e) + VF.ch(e, f, g) + k + w : U32) + (_ + VF.maj(a, b, c) : U32) : U32), a, b, c, (d + (h + VF.sum1(e) + VF.ch(e, f, g) + k + w : U32) : U32), e, f, g} == VF.step(Types.H{a, b, c, d, e, f, g, h}, k, w) : Types.State}
      {==}

def roundsf(ks: List<&2, U32>, ws: List<&2, U32>) -> Types.State -> Types.State:
  match ks ws:
    case Nil{} _:
      s => s
    case k <> kt Nil{}:
      s => s
    case k <> kt w <> wt:
      next = roundsf(kt, wt)
      s => next(stepf(s, k, w))

law rounds_eq:
  for +ks: List<&2, U32>
  for +ws: List<&2, U32>
  for +s: Types.State
  {roundsf(ks, ws)(s) == VF.rounds(ks, ws)(s) : Types.State}
def rounds_eq(ks, ws, s):
  match ks ws:
    case Nil{} Nil{}: {==}
    case Nil{} Con{+w, +wt}: {==}
    case Con{+k, +kt} Nil{}: {==}
    case Con{+k, +kt} Con{+w, +wt}:
      %Equal.sym(Types.State, stepf(s, k, w), VF.step(s, k, w), step_eq(s, k, w)) :
        {roundsf(kt, wt)(_) == VF.rounds(Con{k, kt}, Con{w, wt})(s) : Types.State}
      rounds_eq(kt, wt, VF.step(s, k, w))

def compressf(ws: List<&2, U32>, ks: List<&2, U32>, +s: Types.State) -> Types.State:
  VF.feedforward(s, roundsf(ks, ws)(s))

def blocksf(prepared: List<&2, List<&2, U32>>, +ks: List<&2, U32>) -> Types.State -> Types.State:
  match prepared:
    case Nil{}:
      s => s
    case block <> rest:
      next = blocksf(rest, ks)
      s => next(compressf(block, ks, s))

law blocks_eq:
  for +prepared: List<&2, List<&2, U32>>
  for +ks: List<&2, U32>
  for +s: Types.State
  {blocksf(prepared, ks)(s) == VF.blocks(prepared, ks)(s) : Types.State}
def blocks_eq(prepared, ks, s):
  match prepared:
    case Nil{}: {==}
    case Con{+block, +rest}:
      %Equal.sym(Types.State, roundsf(ks, block)(s), VF.rounds(ks, block)(s), rounds_eq(ks, block, s)) :
        {blocksf(rest, ks)(VF.feedforward(s, _)) == VF.blocks(Con{block, rest}, ks)(s) : Types.State}
      blocks_eq(rest, ks, VF.compress(block, ks, s))

def word_octetsf(+w: U32) -> List<&2, U32>:
  [U32.and(shr24(w), 255), U32.and(shr16(w), 255), U32.and(shr8(w), 255), U32.and(w, 255)]

def digest_octetsf(ws: List<&2, U32>) -> List<&2, U32>:
  match ws:
    case Nil{}:
      Nil{}
    case w <> tail:
      List.append(&2, U32, word_octetsf(w), digest_octetsf(tail))

law digest_octets_eq:
  for +ws: List<&2, U32>
  {digest_octetsf(ws) == VF.digest_octets(ws) : List<&2, U32>}
def digest_octets_eq(ws):
  match ws:
    case Nil{}: {==}
    case Con{+w, +tail}:
      %Equal.sym(U32, shr24(w), U32.shrn(w, 24n), shr24_eq(w)) : {List.append(&2, U32, [U32.and(_, 255), U32.and(shr16(w), 255), U32.and(shr8(w), 255), U32.and(w, 255)], digest_octetsf(tail)) == VF.digest_octets(Con{w, tail}) : List<&2, U32>}
      %Equal.sym(U32, shr16(w), U32.shrn(w, 16n), shr16_eq(w)) : {List.append(&2, U32, [U32.and(U32.shrn(w, 24n), 255), U32.and(_, 255), U32.and(shr8(w), 255), U32.and(w, 255)], digest_octetsf(tail)) == VF.digest_octets(Con{w, tail}) : List<&2, U32>}
      %Equal.sym(U32, shr8(w), U32.shrn(w, 8n), shr8_eq(w)) : {List.append(&2, U32, [U32.and(U32.shrn(w, 24n), 255), U32.and(U32.shrn(w, 16n), 255), U32.and(_, 255), U32.and(w, 255)], digest_octetsf(tail)) == VF.digest_octets(Con{w, tail}) : List<&2, U32>}
      Equal.cong(List<&2, U32>, List<&2, U32>, zl_ => List.append(&2, U32, VF.word_octets(w), zl_), digest_octetsf(tail), VF.digest_octets(tail), digest_octets_eq(tail))

def sha256_bytesf(bytes: List<&2, U32>) -> List<&2, U32>:
  digest_octetsf(VF.digest(blocksf(preparef(bytes, 48n), VF.constants())(VF.initial())))

law sha256_bytes_eq:
  for +bytes: List<&2, U32>
  {sha256_bytesf(bytes) == VF.sha256_bytes(bytes) : List<&2, U32>}
def sha256_bytes_eq(bytes):
  %Equal.sym(List<&2, List<&2, U32>>, preparef(bytes, 48n), VF.prepare(bytes, 48n), prepare_eq(bytes, 48n)) :
    {digest_octetsf(VF.digest(blocksf(_, VF.constants())(VF.initial()))) == VF.sha256_bytes(bytes) : List<&2, U32>}
  %Equal.sym(Types.State, blocksf(VF.prepare(bytes, 48n), VF.constants())(VF.initial()), VF.blocks(VF.prepare(bytes, 48n), VF.constants())(VF.initial()),
      blocks_eq(VF.prepare(bytes, 48n), VF.constants(), VF.initial())) :
    {digest_octetsf(VF.digest(_)) == VF.sha256_bytes(bytes) : List<&2, U32>}
  digest_octets_eq(VF.digest(VF.blocks(VF.prepare(bytes, 48n), VF.constants())(VF.initial())))
