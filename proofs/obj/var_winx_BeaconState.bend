    case S.Items{+h, +r}: fm2(d, t, n, x, off, len, eo, hd, hw, hwN, pf, xs0, lx0, xs1, lx1, h, Codec.parts(h, Spec.Schema3()), FD.logic__subst(Maybe<&2, Nat>, z => DF.single_result(z, Codec.parts(h, Spec.Schema3())), SS.fixed_size(Spec.Schema3()), Some{8n}, fzSchema3(), DS.facts(h, Spec.Schema3(), {==})), {==}, r, e)
