# eight times is the quadruple of the double
def x8_quad2(+c: Nat) -> {VS.x8(c) == A.quad(Nat.double(c)) : Nat}:
  match c:
    case 0n: {==}
    case 1n+ +p: Equal.cong(Nat, Nat, z => 8n+z, VS.x8(p), A.quad(Nat.double(p)), x8_quad2(p))

# quad a <= quad b + 3 gives a <= b
def qle(+a: Nat, +b: Nat, +h: {Nat.is_le(A.quad(a), Nat.add(A.quad(b), 3n)) == True{} : Bool}) -> {Nat.is_le(a, b) == True{} : Bool}:
  match a b:
    case 0n _: F.nat__zero_le(b)
    case 1n+ +p 0n: Empty.absurd({Nat.is_le(1n+p, 0n) == True{} : Bool}, F.logic__false_true(h))
    case 1n+ +p 1n+ +s: qle(p, s, h)

# 2 c <= P from 8 c <= 4 P
def dbl_le(+c: Nat, +P: Nat, +h: {Nat.is_le(VS.x8(c), A.quad(P)) == True{} : Bool}) -> {Nat.is_le(Nat.double(c), P) == True{} : Bool}:
  qle(Nat.double(c), P, F.nat__le_trans(A.quad(Nat.double(c)), A.quad(P), Nat.add(A.quad(P), 3n),
    F.logic__subst(Nat, z => {Nat.is_le(z, A.quad(P)) == True{} : Bool}, VS.x8(c), A.quad(Nat.double(c)), x8_quad2(c), h), Order.below_sum(A.quad(P), 3n)))

# r + 4 Q <= 4 Q + 3 for r <= 3
def qle_add(+r: Nat, +Q: Nat, +hr: {Nat.is_le(r, 3n) == True{} : Bool}) -> {Nat.is_le(Nat.add(r, A.quad(Q)), Nat.add(A.quad(Q), 3n)) == True{} : Bool}:
  F.logic__subst(Nat, z => {Nat.is_le(Nat.add(r, A.quad(Q)), z) == True{} : Bool}, Nat.add(3n, A.quad(Q)), Nat.add(A.quad(Q), 3n), F.nat__add_comm(3n, A.quad(Q)), Order.add_right(r, 3n, A.quad(Q), hr))

# 2 c <= N >> 2 for N = 8 c
def ql_ge(+c: Nat, +N: U32, +e: {U32.to_nat(N) == VS.x8(c) : Nat}) -> {Nat.is_le(Nat.double(c), U32.to_nat(U32.shrn(N, 2n))) == True{} : Bool}:
  +r = U32.to_nat(U32.and(N, 3))
  +Q = U32.to_nat(U32.shrn(N, 2n))
  +ex = Equal.trans(Nat, VS.x8(c), U32.to_nat(N), Nat.add(r, A.quad(Q)), Equal.sym(Nat, U32.to_nat(N), VS.x8(c), e), USP.split2(N))
  +h1 = F.logic__subst(Nat, z => {Nat.is_le(VS.x8(c), z) == True{} : Bool}, VS.x8(c), Nat.add(r, A.quad(Q)), ex, F.nat__le_refl(VS.x8(c)))
  qle(Nat.double(c), Q, F.nat__le_trans(A.quad(Nat.double(c)), Nat.add(r, A.quad(Q)), Nat.add(A.quad(Q), 3n),
    F.logic__subst(Nat, z => {Nat.is_le(z, Nat.add(r, A.quad(Q))) == True{} : Bool}, VS.x8(c), A.quad(Nat.double(c)), x8_quad2(c), h1), qle_add(r, Q, RD.and_le(N, 3))))
