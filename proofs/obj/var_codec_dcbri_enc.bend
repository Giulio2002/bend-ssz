def hl_t(+w0: U32, +w1: U32, +w2: U32, +w3: U32, +w4: U32, +w5: U32, +w6: U32, +w7: U32, +dw: Nat, +T: F.array__Tree<U32>, +N: U32, +c: Nat,
    +pfT: {F.array__perfect(U32, dw, T) == True{} : Bool}, +hdw: {Nat.is_lt(dw, 31n) == True{} : Bool},
    +ec: {U32.to_nat(N) == VS.x8(c) : Nat}, +hc: {Nat.is_le(c, 128n) == True{} : Bool},
    +hroom: {Nat.is_le(Nat.add(VC.NW(N), 0n), VB.pw(dw)) == True{} : Bool}) -> {Nat.is_le(Nat.double(c), F.spec_common__length(U32, F.array__slots(U32, T))) == True{} : Bool}:
  %Equal.sym(Nat, F.spec_common__length(U32, F.array__slots(U32, T)), VB.pw(dw), F.array__slots_length(U32, dw, T, pfT)) : {Nat.is_le(Nat.double(c), _) == True{} : Bool}
  %nwN(N, c, ec, hc) : {Nat.is_le(_, VB.pw(dw)) == True{} : Bool}
  F.logic__subst(Nat, z => {Nat.is_le(z, VB.pw(dw)) == True{} : Bool}, Nat.add(VC.NW(N), 0n), VC.NW(N), F.nat__add_zero(VC.NW(N)), hroom)

# The bytes the encoder writes are the spec/codec.bend encoding of the object's value.
law encode_spec:

  for +w0: U32
  for +w1: U32
  for +w2: U32
  for +w3: U32
  for +w4: U32
  for +w5: U32
  for +w6: U32
  for +w7: U32
  for +dw: Nat
  for +T: F.array__Tree<U32>
  for +N: U32
  for +c: Nat
  for +pfT: {F.array__perfect(U32, dw, T) == True{} : Bool}
  for +hdw: {Nat.is_lt(dw, 31n) == True{} : Bool}
  for +ec: {U32.to_nat(N) == VS.x8(c) : Nat}
  for +hc: {Nat.is_le(c, 128n) == True{} : Bool}
  for +hroom: {Nat.is_le(Nat.add(VC.NW(N), 0n), VB.pw(dw)) == True{} : Bool}
  Decoding.decodes(Spec.DataColumnsByRootIdentifier(), VS.bt(U32.to_nat(S36(N)), FX.limbs(F.array__slots(U32, OUT3(w0, w1, w2, w3, w4, w5, w6, w7, N, T)))), DC.dc_val(w0, w1, w2, w3, w4, w5, w6, w7, c, F.array__slots(U32, T)))
def encode_spec(w0, w1, w2, w3, w4, w5, w6, w7, dw, T, N, c, pfT, hdw, ec, hc, hroom):
  Equal.trans(Maybe<&2, +List<U32>>, Codec.encoding_for_legal_type(Spec.DataColumnsByRootIdentifier(), DC.dc_val(w0, w1, w2, w3, w4, w5, w6, w7, c, F.array__slots(U32, T))), Some{FX.limbs(w0 <> w1 <> w2 <> w3 <> w4 <> w5 <> w6 <> w7 <> 36 <> VS.wtake(Nat.double(c), F.array__slots(U32, T)))}, Some{VS.bt(U32.to_nat(S36(N)), FX.limbs(F.array__slots(U32, OUT3(w0, w1, w2, w3, w4, w5, w6, w7, N, T))))},
    DC.dc_enc(w0, w1, w2, w3, w4, w5, w6, w7, c, F.array__slots(U32, T), hc, hl_t(w0, w1, w2, w3, w4, w5, w6, w7, dw, T, N, c, pfT, hdw, ec, hc, hroom)),
    Equal.cong(+List<U32>, Maybe<&2, +List<U32>>, x => Some{x}, FX.limbs(w0 <> w1 <> w2 <> w3 <> w4 <> w5 <> w6 <> w7 <> 36 <> VS.wtake(Nat.double(c), F.array__slots(U32, T))), VS.bt(U32.to_nat(S36(N)), FX.limbs(F.array__slots(U32, OUT3(w0, w1, w2, w3, w4, w5, w6, w7, N, T)))), out_eq(w0, w1, w2, w3, w4, w5, w6, w7, dw, T, N, c, pfT, hdw, ec, hc, hroom)))
