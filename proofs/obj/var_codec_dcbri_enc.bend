def U3(+w0: U32, +w1: U32, +w2: U32, +w3: U32, +w4: U32, +w5: U32, +w6: U32, +w7: U32, +N: U32, +T: F.array__Tree<U32>) -> List<&2, U32>: F.spec_common__update(U32, F.spec_common__update(U32, F.spec_common__update(U32, F.spec_common__update(U32, F.spec_common__update(U32, F.spec_common__update(U32, F.spec_common__update(U32, F.spec_common__update(U32, F.array__slots(U32, OUT2(N, T)), 0n, w0), 1n, w1), 2n, w2), 3n, w3), 4n, w4), 5n, w5), 6n, w6), 7n, w7)

def pf2(+N: U32, +T: F.array__Tree<U32>) -> {F.array__perfect(U32, DO(N), OUT2(N, T)) == True{} : Bool}:
  VB.mone_perfect(VC.NW(N), 0n, 9n, DO(N), OUT1(N), T, F.array__upd_perfect(U32, DO(N), VC.ZT(DO(N)), 8n, 36, F.array__trep_perfect(U32, DO(N), 0)))

