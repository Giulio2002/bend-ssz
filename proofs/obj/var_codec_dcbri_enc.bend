  %Equal.sym(T.DataColumnsByRootIdentifier & U32, T.DataColumnsByRootIdentifier_size(T.DataColumnsByRootIdentifier{T.Bytes32{w0, w1, w2, w3, w4, w5, w6, w7}, O.Words{F.array__thaw(U32, T), N}}), (T.DataColumnsByRootIdentifier{T.Bytes32{w0, w1, w2, w3, w4, w5, w6, w7}, O.Words{F.array__thaw(U32, T), N}}, S36(N)), size_eval(w0, w1, w2, w3, w4, w5, w6, w7, dw, T, N, c, pfT, hdw, ec, hc, hroom)) :
    {T.DataColumnsByRootIdentifier_enc_sized(_) == (T.DataColumnsByRootIdentifier{T.Bytes32{w0, w1, w2, w3, w4, w5, w6, w7}, O.Words{F.array__thaw(U32, T), N}}, B.Buf{F.array__thaw(U32, OUT3(w0, w1, w2, w3, w4, w5, w6, w7, N, T)), S36(N)}) : T.DataColumnsByRootIdentifier & B.Buf}
  %Equal.sym(Array<U32>, B.zeros(B.words_depth_u(VC.nwu(S36(N)))), Array.new(U32, DO(N), 0),
      DC.zeros_at(B.words_depth_u(VC.nwu(S36(N))), DO(N), VD.wdu(VC.nwu(S36(N))), hDO9(N, c, ec, hc))) :
    {T.DataColumnsByRootIdentifier_enc_put(S36(N), T.DataColumnsByRootIdentifier_putn(_, 0, T.DataColumnsByRootIdentifier{T.Bytes32{w0, w1, w2, w3, w4, w5, w6, w7}, O.Words{F.array__thaw(U32, T), N}})) == (T.DataColumnsByRootIdentifier{T.Bytes32{w0, w1, w2, w3, w4, w5, w6, w7}, O.Words{F.array__thaw(U32, T), N}}, B.Buf{F.array__thaw(U32, OUT3(w0, w1, w2, w3, w4, w5, w6, w7, N, T)), S36(N)}) : T.DataColumnsByRootIdentifier & B.Buf}
  %Equal.sym(Array<U32>, Array.new(U32, DO(N), 0), F.array__thaw(U32, VC.ZT(DO(N))), F.array__new(U32, DO(N), 0)) :
    {T.DataColumnsByRootIdentifier_enc_put(S36(N), T.DataColumnsByRootIdentifier_putn(_, 0, T.DataColumnsByRootIdentifier{T.Bytes32{w0, w1, w2, w3, w4, w5, w6, w7}, O.Words{F.array__thaw(U32, T), N}})) == (T.DataColumnsByRootIdentifier{T.Bytes32{w0, w1, w2, w3, w4, w5, w6, w7}, O.Words{F.array__thaw(U32, T), N}}, B.Buf{F.array__thaw(U32, OUT3(w0, w1, w2, w3, w4, w5, w6, w7, N, T)), S36(N)}) : T.DataColumnsByRootIdentifier & B.Buf}
