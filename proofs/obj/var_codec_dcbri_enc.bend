# The encoder of DataColumnsByRootIdentifier: for every object whose list
# storage is a perfect tree T holding N = 8c bytes (c <= 128) with room for
# them, T.DataColumnsByRootIdentifier_encode returns the object and the buffer
# B.Buf{thaw(OUT3), 36 + N} (encode_eval), and the bytes of that buffer are the
# spec/codec.bend encoding of the object's value (encode_spec).

def S36(+N: U32) -> U32: U32.add(36, N)
def DO(+N: U32) -> Nat: B.words_depth(VC.nwu(S36(N)))
def OUT1(+N: U32) -> F.array__Tree<U32>: F.array__upd(U32, DO(N), VC.ZT(DO(N)), 8n, 36)
def OUT2(+N: U32, +T: F.array__Tree<U32>) -> F.array__Tree<U32>: VB.mone(VC.NW(N), 0n, 9n, DO(N), OUT1(N), T)
def OUT3(+w0: U32, +w1: U32, +w2: U32, +w3: U32, +w4: U32, +w5: U32, +w6: U32, +w7: U32, +N: U32, +T: F.array__Tree<U32>) -> F.array__Tree<U32>: F.array__upd(U32, DO(N), F.array__upd(U32, DO(N), F.array__upd(U32, DO(N), F.array__upd(U32, DO(N), F.array__upd(U32, DO(N), F.array__upd(U32, DO(N), F.array__upd(U32, DO(N), F.array__upd(U32, DO(N), OUT2(N, T), 0n, w0), 1n, w1), 2n, w2), 3n, w3), 4n, w4), 5n, w5), 6n, w6), 7n, w7)

def v36() -> Word(31n): VE.winit(31n, VE.bits32(36))

def le1024(+N: U32, +c: Nat, +ec: {U32.to_nat(N) == VS.x8(c) : Nat}, +hc: {Nat.is_le(c, 128n) == True{} : Bool})
    -> {Nat.is_le(U32.to_nat(N), 1024n) == True{} : Bool}:
  %Equal.sym(Nat, U32.to_nat(N), VS.x8(c), ec) : {Nat.is_le(_, 1024n) == True{} : Bool}
  VS.x8_mono(c, 128n, hc)

def padd36(+N: U32, +c: Nat, +ec: {U32.to_nat(N) == VS.x8(c) : Nat}, +hc: {Nat.is_le(c, 128n) == True{} : Bool})
    -> {O.padd(36, N) == S36(N) : U32}:
  VE.padd_ok(36, N, v36(), VE.winit(31n, VE.bits32(N)), {==},
    VE.small_pad(N, 11n, {==}, F.nat__le_lt_trans(U32.to_nat(N), 1024n, VB.pw(11n), le1024(N, c, ec, hc), {==})))

def eS(+N: U32, +c: Nat, +ec: {U32.to_nat(N) == VS.x8(c) : Nat}, +hc: {Nat.is_le(c, 128n) == True{} : Bool})
    -> {U32.to_nat(S36(N)) == Nat.add(36n, U32.to_nat(N)) : Nat}:
  A.add_le(36, N, 2048, Order.add_left(36n, U32.to_nat(N), 2012n, F.nat__le_trans(U32.to_nat(N), 1024n, 2012n, le1024(N, c, ec, hc), {==})))

def hyS(+N: U32, +c: Nat, +ec: {U32.to_nat(N) == VS.x8(c) : Nat}, +hc: {Nat.is_le(c, 128n) == True{} : Bool})
    -> {Nat.is_le(VC.YL(S36(N)), VB.pw(11n)) == True{} : Bool}:
  %Equal.sym(Nat, U32.to_nat(S36(N)), Nat.add(36n, U32.to_nat(N)), eS(N, c, ec, hc)) : {Nat.is_le(Nat.add(31n, _), VB.pw(11n)) == True{} : Bool}
  Order.add_left(67n, U32.to_nat(N), 1981n, F.nat__le_trans(U32.to_nat(N), 1024n, 1981n, le1024(N, c, ec, hc), {==}))

def hyN(+N: U32, +c: Nat, +ec: {U32.to_nat(N) == VS.x8(c) : Nat}, +hc: {Nat.is_le(c, 128n) == True{} : Bool})
    -> {Nat.is_le(VC.YL(N), VB.pw(11n)) == True{} : Bool}:
  Order.add_left(31n, U32.to_nat(N), 2017n, F.nat__le_trans(U32.to_nat(N), 1024n, 2017n, le1024(N, c, ec, hc), {==}))

def nwN(+N: U32, +c: Nat, +ec: {U32.to_nat(N) == VS.x8(c) : Nat}, +hc: {Nat.is_le(c, 128n) == True{} : Bool})
    -> {VC.NW(N) == Nat.double(c) : Nat}:
  %Equal.sym(Nat, VC.NW(N), VD.s_rng(2n, 3n+U32.to_nat(N)), VC.eNW(N, 11n, {==}, hyN(N, c, ec, hc))) : {_ == Nat.double(c) : Nat}
  %Equal.sym(Nat, U32.to_nat(N), VS.x8(c), ec) : {VD.s_rng(2n, 3n+_) == Nat.double(c) : Nat}
  VC.rng2_x8(c)

def nwS(+N: U32, +c: Nat, +ec: {U32.to_nat(N) == VS.x8(c) : Nat}, +hc: {Nat.is_le(c, 128n) == True{} : Bool})
    -> {VC.NW(S36(N)) == 9n+Nat.double(c) : Nat}:
  %Equal.sym(Nat, VC.NW(S36(N)), VD.s_rng(2n, 3n+U32.to_nat(S36(N))), VC.eNW(S36(N), 11n, {==}, hyS(N, c, ec, hc))) : {_ == 9n+Nat.double(c) : Nat}
  %Equal.sym(Nat, U32.to_nat(S36(N)), Nat.add(36n, U32.to_nat(N)), eS(N, c, ec, hc)) : {VD.s_rng(2n, 3n+_) == 9n+Nat.double(c) : Nat}
  %Equal.sym(Nat, U32.to_nat(N), VS.x8(c), ec) : {VD.s_rng(2n, 39n+_) == 9n+Nat.double(c) : Nat}
  Equal.cong(Nat, Nat, z => 9n+z, VD.s_rng(2n, 3n+VS.x8(c)), Nat.double(c), VC.rng2_x8(c))

def hDO9(+N: U32, +c: Nat, +ec: {U32.to_nat(N) == VS.x8(c) : Nat}, +hc: {Nat.is_le(c, 128n) == True{} : Bool})
    -> {Nat.is_le(DO(N), 9n) == True{} : Bool}:
  VD.wd_min(VC.nwu(S36(N)), 9n,
    F.logic__subst(Nat, z => {Nat.is_le(z, 512n) == True{} : Bool}, 9n+Nat.double(c), VC.NW(S36(N)), Equal.sym(Nat, VC.NW(S36(N)), 9n+Nat.double(c), nwS(N, c, ec, hc)),
      Order.add_left(9n, Nat.double(c), 503n, F.nat__le_trans(Nat.double(c), 256n, 503n, F.nat__double_le(c, 128n, hc), {==}))))

def roomS(+N: U32, +c: Nat, +ec: {U32.to_nat(N) == VS.x8(c) : Nat}, +hc: {Nat.is_le(c, 128n) == True{} : Bool})
    -> {Nat.is_le(9n+Nat.double(c), VB.pw(DO(N))) == True{} : Bool}:
  %Equal.sym(Nat, VB.pw(DO(N)), O.pow2n(DO(N)), VD.s_pow2_eq(DO(N))) : {Nat.is_le(9n+Nat.double(c), _) == True{} : Bool}
  %nwS(N, c, ec, hc) : {Nat.is_le(_, O.pow2n(DO(N))) == True{} : Bool}
  VD.wd_cover(VC.nwu(S36(N)), 9n, {==},
    F.logic__subst(Nat, z => {Nat.is_le(z, 512n) == True{} : Bool}, 9n+Nat.double(c), VC.NW(S36(N)), Equal.sym(Nat, VC.NW(S36(N)), 9n+Nat.double(c), nwS(N, c, ec, hc)),
      Order.add_left(9n, Nat.double(c), 503n, F.nat__le_trans(Nat.double(c), 256n, 503n, F.nat__double_le(c, 128n, hc), {==}))))


def size_eval(+w0: U32, +w1: U32, +w2: U32, +w3: U32, +w4: U32, +w5: U32, +w6: U32, +w7: U32, +dw: Nat, +T: F.array__Tree<U32>, +N: U32, +c: Nat,
    +pfT: {F.array__perfect(U32, dw, T) == True{} : Bool}, +hdw: {Nat.is_lt(dw, 31n) == True{} : Bool},
    +ec: {U32.to_nat(N) == VS.x8(c) : Nat}, +hc: {Nat.is_le(c, 128n) == True{} : Bool},
    +hroom: {Nat.is_le(Nat.add(VC.NW(N), 0n), VB.pw(dw)) == True{} : Bool})
    -> {T.DataColumnsByRootIdentifier_size(T.DataColumnsByRootIdentifier{T.Bytes32{w0, w1, w2, w3, w4, w5, w6, w7}, O.Words{F.array__thaw(U32, T), N}}) == (T.DataColumnsByRootIdentifier{T.Bytes32{w0, w1, w2, w3, w4, w5, w6, w7}, O.Words{F.array__thaw(U32, T), N}}, S36(N)) : T.DataColumnsByRootIdentifier & U32}:
  %Equal.sym(Array<U32> & U32, Array.size(U32, F.array__thaw(U32, T)), (F.array__thaw(U32, T), F.u32__pow2u(dw)), F.array__size_thaw(U32, dw, T, pfT)) :
    {T.DataColumnsByRootIdentifier_sz0(T.Bytes32{w0, w1, w2, w3, w4, w5, w6, w7}, 36, O.wsz_pick(N, _)) == (T.DataColumnsByRootIdentifier{T.Bytes32{w0, w1, w2, w3, w4, w5, w6, w7}, O.Words{F.array__thaw(U32, T), N}}, S36(N)) : T.DataColumnsByRootIdentifier & U32}
  %Equal.sym(Bool, U32.is_le(VC.nwu(N), F.u32__pow2u(dw)), True{}, VE.le_room(N, dw, hdw, hroom)) :
    {(T.DataColumnsByRootIdentifier{T.Bytes32{w0, w1, w2, w3, w4, w5, w6, w7}, O.Words{F.array__thaw(U32, T), N}}, O.padd(36, O.pick(_, N, 2147483648))) == (T.DataColumnsByRootIdentifier{T.Bytes32{w0, w1, w2, w3, w4, w5, w6, w7}, O.Words{F.array__thaw(U32, T), N}}, S36(N)) : T.DataColumnsByRootIdentifier & U32}
  %Equal.sym(U32, O.padd(36, N), S36(N), padd36(N, c, ec, hc)) :
    {(T.DataColumnsByRootIdentifier{T.Bytes32{w0, w1, w2, w3, w4, w5, w6, w7}, O.Words{F.array__thaw(U32, T), N}}, _) == (T.DataColumnsByRootIdentifier{T.Bytes32{w0, w1, w2, w3, w4, w5, w6, w7}, O.Words{F.array__thaw(U32, T), N}}, S36(N)) : T.DataColumnsByRootIdentifier & U32}
  {==}


def lt_do(+k: Nat, +N: U32, +c: Nat, +ec: {U32.to_nat(N) == VS.x8(c) : Nat}, +hc: {Nat.is_le(c, 128n) == True{} : Bool}, +hk: {Nat.is_le(k, 8n) == True{} : Bool})
    -> {Nat.is_lt(k, VB.pw(DO(N))) == True{} : Bool}:
  F.nat__le_lt_trans(k, 8n, VB.pw(DO(N)), hk, F.nat__lt_le_trans(8n, 9n+Nat.double(c), VB.pw(DO(N)), {==}, roomS(N, c, ec, hc)))

def hDO(+N: U32, +c: Nat, +ec: {U32.to_nat(N) == VS.x8(c) : Nat}, +hc: {Nat.is_le(c, 128n) == True{} : Bool}) -> {Nat.is_lt(DO(N), 31n) == True{} : Bool}:
  F.nat__le_lt_trans(DO(N), 9n, 31n, hDO9(N, c, ec, hc), {==})

def put_eval(+w0: U32, +w1: U32, +w2: U32, +w3: U32, +w4: U32, +w5: U32, +w6: U32, +w7: U32, +dw: Nat, +T: F.array__Tree<U32>, +N: U32, +c: Nat,
    +pfT: {F.array__perfect(U32, dw, T) == True{} : Bool}, +hdw: {Nat.is_lt(dw, 31n) == True{} : Bool},
    +ec: {U32.to_nat(N) == VS.x8(c) : Nat}, +hc: {Nat.is_le(c, 128n) == True{} : Bool},
    +hroom: {Nat.is_le(Nat.add(VC.NW(N), 0n), VB.pw(dw)) == True{} : Bool})
    -> {T.DataColumnsByRootIdentifier_putn(F.array__thaw(U32, VC.ZT(DO(N))), 0, T.DataColumnsByRootIdentifier{T.Bytes32{w0, w1, w2, w3, w4, w5, w6, w7}, O.Words{F.array__thaw(U32, T), N}}) == (F.array__thaw(U32, OUT3(w0, w1, w2, w3, w4, w5, w6, w7, N, T)), (T.DataColumnsByRootIdentifier{T.Bytes32{w0, w1, w2, w3, w4, w5, w6, w7}, O.Words{F.array__thaw(U32, T), N}}, S36(N))) : Array<U32> & (T.DataColumnsByRootIdentifier & U32)}:
  +hd31 = hDO(N, c, ec, hc)
  +hd32 = VB.lt32(DO(N), hd31)
  +pf0 = F.array__trep_perfect(U32, DO(N), 0)
  +pf1 = F.array__upd_perfect(U32, DO(N), VC.ZT(DO(N)), 8n, 36, pf0)
  +pf2 = VB.mone_perfect(VC.NW(N), 0n, 9n, DO(N), OUT1(N), T, pf1)
  +hdst = F.logic__subst(Nat, z => {Nat.is_le(Nat.add(z, 9n), VB.pw(DO(N))) == True{} : Bool}, Nat.double(c), VC.NW(N), Equal.sym(Nat, VC.NW(N), Nat.double(c), nwN(N, c, ec, hc)),
    F.logic__subst(Nat, z => {Nat.is_le(z, VB.pw(DO(N))) == True{} : Bool}, 9n+Nat.double(c), Nat.add(Nat.double(c), 9n), F.nat__add_comm(9n, Nat.double(c)), roomS(N, c, ec, hc)))
  %Equal.sym(Array<U32>, Array.set(U32, F.array__thaw(U32, VC.ZT(DO(N))), 8, 36), F.array__thaw(U32, OUT1(N)),
      VB.set_n(DO(N), VC.ZT(DO(N)), 8, 8n, 36, {==}, hd32, lt_do(8n, N, c, ec, hc, {==}), pf0)) :
    {T.DataColumnsByRootIdentifier_pw0(0, T.Bytes32{w0, w1, w2, w3, w4, w5, w6, w7}, T.l128_u64_pvb(36, T.l128_u64_pk(_, U32.add(0, 36), T.l128_u64_valid(O.Words{F.array__thaw(U32, T), N})))) == (F.array__thaw(U32, OUT3(w0, w1, w2, w3, w4, w5, w6, w7, N, T)), (T.DataColumnsByRootIdentifier{T.Bytes32{w0, w1, w2, w3, w4, w5, w6, w7}, O.Words{F.array__thaw(U32, T), N}}, S36(N))) : Array<U32> & (T.DataColumnsByRootIdentifier & U32)}
  %Equal.sym(O.Words & Bool, O.words_ok(O.Words{F.array__thaw(U32, T), N}, 0, 1024, False{}, 8), (O.Words{F.array__thaw(U32, T), N}, True{}), VE.words_ok_u64(dw, T, N, 1024, c, pfT, hdw, ec, le1024(N, c, ec, hc), hroom)) :
    {T.DataColumnsByRootIdentifier_pw0(0, T.Bytes32{w0, w1, w2, w3, w4, w5, w6, w7}, T.l128_u64_pvb(36, T.l128_u64_pk(F.array__thaw(U32, OUT1(N)), U32.add(0, 36), _))) == (F.array__thaw(U32, OUT3(w0, w1, w2, w3, w4, w5, w6, w7, N, T)), (T.DataColumnsByRootIdentifier{T.Bytes32{w0, w1, w2, w3, w4, w5, w6, w7}, O.Words{F.array__thaw(U32, T), N}}, S36(N))) : Array<U32> & (T.DataColumnsByRootIdentifier & U32)}
  %Equal.sym(Array<U32> & O.Words, O.put_words(F.array__thaw(U32, OUT1(N)), U32.add(0, 36), O.Words{F.array__thaw(U32, T), N}), (F.array__thaw(U32, OUT2(N, T)), O.Words{F.array__thaw(U32, T), N}),
      VE.put_words_ok(DO(N), dw, OUT1(N), T, U32.add(0, 36), 9n, N, pf1, pfT, hd31, hdw, {==}, {==}, VC.and3_x8(N, c, ec), hroom, hdst)) :
    {T.DataColumnsByRootIdentifier_pw0(0, T.Bytes32{w0, w1, w2, w3, w4, w5, w6, w7}, T.l128_u64_pvb(36, O.pwn(_))) == (F.array__thaw(U32, OUT3(w0, w1, w2, w3, w4, w5, w6, w7, N, T)), (T.DataColumnsByRootIdentifier{T.Bytes32{w0, w1, w2, w3, w4, w5, w6, w7}, O.Words{F.array__thaw(U32, T), N}}, S36(N))) : Array<U32> & (T.DataColumnsByRootIdentifier & U32)}
  %Equal.sym(U32, O.padd(36, N), S36(N), padd36(N, c, ec, hc)) :
    {(T.b32_put(F.array__thaw(U32, OUT2(N, T)), U32.add(0, 0), T.Bytes32{w0, w1, w2, w3, w4, w5, w6, w7}), (T.DataColumnsByRootIdentifier{T.Bytes32{w0, w1, w2, w3, w4, w5, w6, w7}, O.Words{F.array__thaw(U32, T), N}}, _)) == (F.array__thaw(U32, OUT3(w0, w1, w2, w3, w4, w5, w6, w7, N, T)), (T.DataColumnsByRootIdentifier{T.Bytes32{w0, w1, w2, w3, w4, w5, w6, w7}, O.Words{F.array__thaw(U32, T), N}}, S36(N))) : Array<U32> & (T.DataColumnsByRootIdentifier & U32)}
  %Equal.sym(Array<U32>, Array.set(U32, F.array__thaw(U32, OUT2(N, T)), U32.add(0, 0), w0), F.array__thaw(U32, F.array__upd(U32, DO(N), OUT2(N, T), 0n, w0)), VB.set_n(DO(N), OUT2(N, T), U32.add(0, 0), 0n, w0, {==}, hd32, lt_do(0n, N, c, ec, hc, {==}), pf2)) :
    {(Array.set(U32, Array.set(U32, Array.set(U32, Array.set(U32, Array.set(U32, Array.set(U32, Array.set(U32, _, U32.add(0, 1), w1), U32.add(0, 2), w2), U32.add(0, 3), w3), U32.add(0, 4), w4), U32.add(0, 5), w5), U32.add(0, 6), w6), U32.add(0, 7), w7), (T.DataColumnsByRootIdentifier{T.Bytes32{w0, w1, w2, w3, w4, w5, w6, w7}, O.Words{F.array__thaw(U32, T), N}}, S36(N))) == (F.array__thaw(U32, OUT3(w0, w1, w2, w3, w4, w5, w6, w7, N, T)), (T.DataColumnsByRootIdentifier{T.Bytes32{w0, w1, w2, w3, w4, w5, w6, w7}, O.Words{F.array__thaw(U32, T), N}}, S36(N))) : Array<U32> & (T.DataColumnsByRootIdentifier & U32)}
  %Equal.sym(Array<U32>, Array.set(U32, F.array__thaw(U32, F.array__upd(U32, DO(N), OUT2(N, T), 0n, w0)), U32.add(0, 1), w1), F.array__thaw(U32, F.array__upd(U32, DO(N), F.array__upd(U32, DO(N), OUT2(N, T), 0n, w0), 1n, w1)), VB.set_n(DO(N), F.array__upd(U32, DO(N), OUT2(N, T), 0n, w0), U32.add(0, 1), 1n, w1, {==}, hd32, lt_do(1n, N, c, ec, hc, {==}), F.array__upd_perfect(U32, DO(N), OUT2(N, T), 0n, w0, pf2))) :
    {(Array.set(U32, Array.set(U32, Array.set(U32, Array.set(U32, Array.set(U32, Array.set(U32, _, U32.add(0, 2), w2), U32.add(0, 3), w3), U32.add(0, 4), w4), U32.add(0, 5), w5), U32.add(0, 6), w6), U32.add(0, 7), w7), (T.DataColumnsByRootIdentifier{T.Bytes32{w0, w1, w2, w3, w4, w5, w6, w7}, O.Words{F.array__thaw(U32, T), N}}, S36(N))) == (F.array__thaw(U32, OUT3(w0, w1, w2, w3, w4, w5, w6, w7, N, T)), (T.DataColumnsByRootIdentifier{T.Bytes32{w0, w1, w2, w3, w4, w5, w6, w7}, O.Words{F.array__thaw(U32, T), N}}, S36(N))) : Array<U32> & (T.DataColumnsByRootIdentifier & U32)}
