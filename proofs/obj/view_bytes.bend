# the list of uint8 (packed_bytes_light.bend's vview1): item k is UInt{byte k}
def it1_set(+m: Nat, +xs: +List<U32>, +k: Nat, +v: U32)
    -> {PB.it1(m, VS.list_set(xs, k, v)) == VS.items_set(PB.it1(m, xs), k, S.UnsignedValue{P.UInt{v, 0, 0, 0, 0, 0, 0, 0}}) : S.Value}:
