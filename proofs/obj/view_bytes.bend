  %Equal.sym(+List<U32>, WS.btake(U32.to_nat(n), VS.list_set(FX.limbs(F.array__slots(U32, t)), Nat.add(Nat.double(Nat.double(q)), U32.to_nat(U32.and(p, 3))), v)), VS.list_set(WS.btake(U32.to_nat(n), FX.limbs(F.array__slots(U32, t))), Nat.add(Nat.double(Nat.double(q)), U32.to_nat(U32.and(p, 3))), v), btake_set(U32.to_nat(n), FX.limbs(F.array__slots(U32, t)), Nat.add(Nat.double(Nat.double(q)), U32.to_nat(U32.and(p, 3))), v)) :
