def limb_set_3(+old: U32, +v: U32, +hv: {U32.is_le(v, 255) == True{} : Bool}) -> {I.limb(O.merge_word(old, v, 3, 1)) == VS.list_set(I.limb(old), 3n, v) : +List<U32>}:
  %Equal.sym(U32, U32.and(O.merge_word(old, v, 3, 1), 255), U32.and(old, 255), el_3_0(old, v, hv)) : {[_, U32.and(U32.shrn(O.merge_word(old, v, 3, 1), 8n), 255), U32.and(U32.shrn(O.merge_word(old, v, 3, 1), 16n), 255), U32.shrn(O.merge_word(old, v, 3, 1), 24n)] == [U32.and(old, 255), U32.and(U32.shrn(old, 8n), 255), U32.and(U32.shrn(old, 16n), 255), v] : +List<U32>}
  %Equal.sym(U32, U32.and(U32.shrn(O.merge_word(old, v, 3, 1), 8n), 255), U32.and(U32.shrn(old, 8n), 255), el_3_1(old, v, hv)) : {[U32.and(old, 255), _, U32.and(U32.shrn(O.merge_word(old, v, 3, 1), 16n), 255), U32.shrn(O.merge_word(old, v, 3, 1), 24n)] == [U32.and(old, 255), U32.and(U32.shrn(old, 8n), 255), U32.and(U32.shrn(old, 16n), 255), v] : +List<U32>}
  %Equal.sym(U32, U32.and(U32.shrn(O.merge_word(old, v, 3, 1), 16n), 255), U32.and(U32.shrn(old, 16n), 255), el_3_2(old, v, hv)) : {[U32.and(old, 255), U32.and(U32.shrn(old, 8n), 255), _, U32.shrn(O.merge_word(old, v, 3, 1), 24n)] == [U32.and(old, 255), U32.and(U32.shrn(old, 8n), 255), U32.and(U32.shrn(old, 16n), 255), v] : +List<U32>}
  %Equal.sym(U32, U32.shrn(O.merge_word(old, v, 3, 1), 24n), v, el_3_3(old, v, hv)) : {[U32.and(old, 255), U32.and(U32.shrn(old, 8n), 255), U32.and(U32.shrn(old, 16n), 255), _] == [U32.and(old, 255), U32.and(U32.shrn(old, 8n), 255), U32.and(U32.shrn(old, 16n), 255), v] : +List<U32>}
  {==}

def limbs_upd_3(+W: List<&2, U32>, +q: Nat, +v: U32, +hv: {U32.is_le(v, 255) == True{} : Bool})
    -> {FX.limbs(F.spec_common__update(U32, W, q, O.merge_word(WR.at(W, q), v, 3, 1))) == VS.list_set(FX.limbs(W), Nat.add(Nat.double(Nat.double(q)), 3n), v) : +List<U32>}:
  match W q:
    case Nil{} _: {==}
    case Con{h, t} 0n:
      %Equal.sym(+List<U32>, I.limb(O.merge_word(h, v, 3, 1)), VS.list_set(I.limb(h), 3n, v), limb_set_3(h, v, hv)) :
        {List.append(&2, U32, _, FX.limbs(t)) == VS.list_set(List.append(&2, U32, I.limb(h), FX.limbs(t)), 3n, v) : +List<U32>}
      {==}
    case Con{h, t} 1n+p:
      %Equal.sym(+List<U32>, FX.limbs(F.spec_common__update(U32, t, p, O.merge_word(WR.at(t, p), v, 3, 1))), VS.list_set(FX.limbs(t), Nat.add(Nat.double(Nat.double(p)), 3n), v), limbs_upd_3(t, p, v, hv)) :
        {List.append(&2, U32, I.limb(h), _) == VS.list_set(List.append(&2, U32, I.limb(h), FX.limbs(t)), Nat.add(Nat.double(Nat.double(1n+p)), 3n), v) : +List<U32>}
      {==}

def limbs_upd_p(+W: List<&2, U32>, +q: Nat, +p: U32, +v: U32, +hv: {U32.is_le(v, 255) == True{} : Bool})
    -> {FX.limbs(F.spec_common__update(U32, W, q, O.merge_word(WR.at(W, q), v, U32.and(p, 3), 1))) == VS.list_set(FX.limbs(W), Nat.add(Nat.double(Nat.double(q)), U32.to_nat(U32.and(p, 3))), v) : +List<U32>}:
  match p:
    case U32{WCon{False{}, WCon{False{}, +r}}}:
      %Equal.sym(Word(30n), Word.and(30n, r, Word.zero(30n)), Word.zero(30n), UB.wand_zero(30n, r)) :
        {FX.limbs(F.spec_common__update(U32, W, q, O.merge_word(WR.at(W, q), v, U32{WCon{False{}, WCon{False{}, _}}}, 1))) == VS.list_set(FX.limbs(W), Nat.add(Nat.double(Nat.double(q)), U32.to_nat(U32{WCon{False{}, WCon{False{}, _}}})), v) : +List<U32>}
      limbs_upd_0(W, q, v, hv)
    case U32{WCon{True{}, WCon{False{}, +r}}}:
      %Equal.sym(Word(30n), Word.and(30n, r, Word.zero(30n)), Word.zero(30n), UB.wand_zero(30n, r)) :
        {FX.limbs(F.spec_common__update(U32, W, q, O.merge_word(WR.at(W, q), v, U32{WCon{True{}, WCon{False{}, _}}}, 1))) == VS.list_set(FX.limbs(W), Nat.add(Nat.double(Nat.double(q)), U32.to_nat(U32{WCon{True{}, WCon{False{}, _}}})), v) : +List<U32>}
      limbs_upd_1(W, q, v, hv)
    case U32{WCon{False{}, WCon{True{}, +r}}}:
      %Equal.sym(Word(30n), Word.and(30n, r, Word.zero(30n)), Word.zero(30n), UB.wand_zero(30n, r)) :
        {FX.limbs(F.spec_common__update(U32, W, q, O.merge_word(WR.at(W, q), v, U32{WCon{False{}, WCon{True{}, _}}}, 1))) == VS.list_set(FX.limbs(W), Nat.add(Nat.double(Nat.double(q)), U32.to_nat(U32{WCon{False{}, WCon{True{}, _}}})), v) : +List<U32>}
      limbs_upd_2(W, q, v, hv)
    case U32{WCon{True{}, WCon{True{}, +r}}}:
      %Equal.sym(Word(30n), Word.and(30n, r, Word.zero(30n)), Word.zero(30n), UB.wand_zero(30n, r)) :
        {FX.limbs(F.spec_common__update(U32, W, q, O.merge_word(WR.at(W, q), v, U32{WCon{True{}, WCon{True{}, _}}}, 1))) == VS.list_set(FX.limbs(W), Nat.add(Nat.double(Nat.double(q)), U32.to_nat(U32{WCon{True{}, WCon{True{}, _}}})), v) : +List<U32>}
      limbs_upd_3(W, q, v, hv)

# cutting to the length commutes with replacing a byte
def btake_set(+m: Nat, +xs: +List<U32>, +k: Nat, +v: U32) -> {WS.btake(m, VS.list_set(xs, k, v)) == VS.list_set(WS.btake(m, xs), k, v) : +List<U32>}:
  match m xs k:
    case 0n _ _: {==}
    case 1n+p Nil{} _: {==}
    case 1n+p Con{h, t} 0n: {==}
    case 1n+p Con{h, t} 1n+a:
      %Equal.sym(+List<U32>, WS.btake(p, VS.list_set(t, a, v)), VS.list_set(WS.btake(p, t), a, v), btake_set(p, t, a, v)) :
        {Con{h, _} == VS.list_set(Con{h, WS.btake(p, t)}, 1n+a, v) : +List<U32>}
      {==}

# the byte index is the word index and the offset: p = 4 q + (p & 3)
def idx(+p: U32, +q: Nat, +hq: {U32.to_nat(U32.shrn(p, 2n)) == q : Nat})
    -> {U32.to_nat(p) == Nat.add(Nat.double(Nat.double(q)), U32.to_nat(U32.and(p, 3))) : Nat}:
  %hq :
    {U32.to_nat(p) == Nat.add(Nat.double(Nat.double(_)), U32.to_nat(U32.and(p, 3))) : Nat}
  Equal.trans(Nat, U32.to_nat(p), Nat.add(U32.to_nat(U32.and(p, 3)), Nat.double(Nat.double(U32.to_nat(U32.shrn(p, 2n))))), Nat.add(Nat.double(Nat.double(U32.to_nat(U32.shrn(p, 2n)))), U32.to_nat(U32.and(p, 3))),
    USP.split2(p), F.nat__add_comm(U32.to_nat(U32.and(p, 3)), Nat.double(Nat.double(U32.to_nat(U32.shrn(p, 2n))))))

