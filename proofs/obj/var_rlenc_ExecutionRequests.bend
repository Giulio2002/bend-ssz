# The list writer at header word h (byte 4 h) and word position Q (byte S = 4 Q).
def pvl_l2_ConsolidationRequest(+dd: Nat, +D: FD.array__Tree<U32>, +h: Nat, +hB: U32, +S: U32, +Q: Nat, +eS: {U32.to_nat(S) == A.quad(Q) : Nat},
