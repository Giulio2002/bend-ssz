    +hlim: {Nat.is_le(c, U32.to_nat(2)) == True{} : Bool}, +w32: {O.w32(FD.array__thaw(U32, D), U32.add(0, hB), S) == Array.set(U32, FD.array__thaw(U32, D), U32.from_nat(h), S) : Array<U32>},
