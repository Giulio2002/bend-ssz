# A window of h + c bytes, h = 4 H: its first H words, then c bytes (sizes symbolic).
def bsplit_g(+H: Nat, +h: Nat, +eH: {A.quad(H) == h : Nat}, +s: U32, +cc: U32, +X: List<&2, U32>,
    +es: {U32.to_nat(s) == Nat.add(h, U32.to_nat(cc)) : Nat}, +hX: {Nat.is_le(H, VB.len(X)) == True{} : Bool})
    -> {VS.bt(U32.to_nat(s), F.limbs(X)) == List.append(&2, U32, F.limbs(VS.wtake(H, X)), VS.bt(U32.to_nat(cc), F.limbs(VB.wdr(H, X)))) : +List<U32>}:
  %Equal.sym(Nat, U32.to_nat(s), Nat.add(h, U32.to_nat(cc)), es) : {VS.bt(_, F.limbs(X)) == List.append(&2, U32, F.limbs(VS.wtake(H, X)), VS.bt(U32.to_nat(cc), F.limbs(VB.wdr(H, X)))) : +List<U32>}
  %eH : {VS.bt(Nat.add(_, U32.to_nat(cc)), F.limbs(X)) == List.append(&2, U32, F.limbs(VS.wtake(H, X)), VS.bt(U32.to_nat(cc), F.limbs(VB.wdr(H, X)))) : +List<U32>}
  VY.bt_split(H, U32.to_nat(cc), X, hX)

