  +fit = VS.fits_mono(4n, Nat.add(VS.FSZ([[w0, w1, w2, w3, w4, w5, w6, w7]], []), List.length(&2, U32, F.limbs(VS.wtake(Nat.double(k), W)))), Nat.add(36n, VS.x8(128n)),
    Order.add_left(36n, List.length(&2, U32, F.limbs(VS.wtake(Nat.double(k), W))), VS.x8(128n), le2), {==})
  %Equal.sym(Maybe<&2, +List<S.Part>>, Codec.parts(S.Items{S.BytesValue{F.limbs([w0, w1, w2, w3, w4, w5, w6, w7])}, S.Items{S.Sequence{VS.uitems(k, W)}, S.EmptyItems{}}}, S.Chain{S.ByteVector{32n}, S.Chain{S.ListOf{S.Unsigned{P.U64{}}, 128n}, S.End{}}}), Some{[S.Fixed{F.limbs([w0, w1, w2, w3, w4, w5, w6, w7])}, S.Variable{F.limbs(VS.wtake(Nat.double(k), W))}]},
      VS.chain_fixed(S.BytesValue{F.limbs([w0, w1, w2, w3, w4, w5, w6, w7])}, S.Items{S.Sequence{VS.uitems(k, W)}, S.EmptyItems{}}, S.ByteVector{32n}, S.Chain{S.ListOf{S.Unsigned{P.U64{}}, 128n}, S.End{}}, F.limbs([w0, w1, w2, w3, w4, w5, w6, w7]), [S.Variable{F.limbs(VS.wtake(Nat.double(k), W))}], F.bytes_part(w0, [w1, w2, w3, w4, w5, w6, w7], {==}), VS.chain_var(S.Sequence{VS.uitems(k, W)}, S.EmptyItems{}, S.ListOf{S.Unsigned{P.U64{}}, 128n}, S.End{}, F.limbs(VS.wtake(Nat.double(k), W)), [], VS.list_u64_parts(k, W, 128n, hk, {==}, hl), {==}))) :
    {Codec.bytes(Codec.aggregate(_, None{})) == Some{F.limbs(w0 <> w1 <> w2 <> w3 <> w4 <> w5 <> w6 <> w7 <> 36 <> VS.wtake(Nat.double(k), W))} : Maybe<&2, +List<U32>>}
  %Equal.sym(Maybe<&2, +List<U32>>, Layout.encoding(VS.fpv([[w0, w1, w2, w3, w4, w5, w6, w7]], F.limbs(VS.wtake(Nat.double(k), W)), [])), Some{List.append(&2, U32, List.append(&2, U32, F.flat([[w0, w1, w2, w3, w4, w5, w6, w7]]), List.append(&2, U32, N.digits(4n, VS.FSZ([[w0, w1, w2, w3, w4, w5, w6, w7]], [])), F.flat([]))), F.limbs(VS.wtake(Nat.double(k), W)))}, VS.enc_fpv([[w0, w1, w2, w3, w4, w5, w6, w7]], VS.wtake(Nat.double(k), W), [], fit)) :
