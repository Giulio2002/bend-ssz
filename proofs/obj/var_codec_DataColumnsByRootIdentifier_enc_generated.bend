  %Equal.sym(Nat, U32.to_nat(N), VS.x8(c), ec) : {A.quad(Nat.add(9n, Nat.double(c))) == Nat.add(36n, _) : Nat}
  %Equal.sym(Nat, VS.x8(c), VB.d3(c), VB.x8_d3(c)) : {A.quad(Nat.add(9n, Nat.double(c))) == Nat.add(36n, _) : Nat}
  {==}

# The output's bytes are the limbs of the header words and the list's words.
def out_eq(+w0: U32, +w1: U32, +w2: U32, +w3: U32, +w4: U32, +w5: U32, +w6: U32, +w7: U32, +dw: Nat, +T: FD.array__Tree<U32>, +N: U32, +c: Nat,
    +pfT: {FD.array__perfect(U32, dw, T) == True{} : Bool}, +hdw: {Nat.is_lt(dw, 31n) == True{} : Bool},
    +ec: {U32.to_nat(N) == VS.x8(c) : Nat}, +hc: {Nat.is_le(c, 128n) == True{} : Bool},
    +hroom: {Nat.is_le(Nat.add(VC.NW(N), 0n), VB.pw(dw)) == True{} : Bool})
    -> {VS.bt(U32.to_nat(SFS(N)), F.limbs(FD.array__slots(U32, TD1(w0, w1, w2, w3, w4, w5, w6, w7, N, T)))) == F.limbs(w0 <> w1 <> w2 <> w3 <> w4 <> w5 <> w6 <> w7 <> 36 <> VS.wtake(Nat.double(c), FD.array__slots(U32, T))) : +List<U32>}:
  %eSq(N, c, ec, hc) : {VS.bt(_, F.limbs(FD.array__slots(U32, TD1(w0, w1, w2, w3, w4, w5, w6, w7, N, T)))) == F.limbs(w0 <> w1 <> w2 <> w3 <> w4 <> w5 <> w6 <> w7 <> 36 <> VS.wtake(Nat.double(c), FD.array__slots(U32, T))) : +List<U32>}
  %Equal.sym(+List<U32>, VS.bt(A.quad(Nat.add(9n, VC.NW(N))), F.limbs(FD.array__slots(U32, TD1(w0, w1, w2, w3, w4, w5, w6, w7, N, T)))), F.limbs(VS.wtake(Nat.add(9n, VC.NW(N)), FD.array__slots(U32, TD1(w0, w1, w2, w3, w4, w5, w6, w7, N, T)))), VS.bt_limbs(Nat.add(9n, VC.NW(N)), FD.array__slots(U32, TD1(w0, w1, w2, w3, w4, w5, w6, w7, N, T)))) :
    {_ == F.limbs(w0 <> w1 <> w2 <> w3 <> w4 <> w5 <> w6 <> w7 <> 36 <> VS.wtake(Nat.double(c), FD.array__slots(U32, T))) : +List<U32>}
  %Equal.sym(List<&2, U32>, VF.WIN(Nat.add(9n, VC.NW(N)), 0n, FD.array__slots(U32, TD1(w0, w1, w2, w3, w4, w5, w6, w7, N, T))), VF.app(VF.WIN(9n, 0n, FD.array__slots(U32, TD1(w0, w1, w2, w3, w4, w5, w6, w7, N, T))), VF.WIN(VC.NW(N), Nat.add(0n, 9n), FD.array__slots(U32, TD1(w0, w1, w2, w3, w4, w5, w6, w7, N, T)))), VF.win_split(9n, VC.NW(N), 0n, FD.array__slots(U32, TD1(w0, w1, w2, w3, w4, w5, w6, w7, N, T)))) :
    {F.limbs(_) == F.limbs(w0 <> w1 <> w2 <> w3 <> w4 <> w5 <> w6 <> w7 <> 36 <> VS.wtake(Nat.double(c), FD.array__slots(U32, T))) : +List<U32>}
  %Equal.sym(List<&2, U32>, VF.WIN(9n, 0n, FD.array__slots(U32, TD1(w0, w1, w2, w3, w4, w5, w6, w7, N, T))), [w0, w1, w2, w3, w4, w5, w6, w7, 36], hdr_eq(w0, w1, w2, w3, w4, w5, w6, w7, N, c, ec, hc, T)) :
    {F.limbs(VF.app(_, VF.WIN(VC.NW(N), 9n, FD.array__slots(U32, TD1(w0, w1, w2, w3, w4, w5, w6, w7, N, T))))) == F.limbs(w0 <> w1 <> w2 <> w3 <> w4 <> w5 <> w6 <> w7 <> 36 <> VS.wtake(Nat.double(c), FD.array__slots(U32, T))) : +List<U32>}
  %Equal.sym(List<&2, U32>, VF.WIN(VC.NW(N), 9n, FD.array__slots(U32, TD1(w0, w1, w2, w3, w4, w5, w6, w7, N, T))), VS.wtake(VC.NW(N), FD.array__slots(U32, T)), pay_eq(w0, w1, w2, w3, w4, w5, w6, w7, N, c, ec, hc, T, dw, pfT, hroom)) :
    {F.limbs(VF.app([w0, w1, w2, w3, w4, w5, w6, w7, 36], _)) == F.limbs(w0 <> w1 <> w2 <> w3 <> w4 <> w5 <> w6 <> w7 <> 36 <> VS.wtake(Nat.double(c), FD.array__slots(U32, T))) : +List<U32>}
  %Equal.sym(Nat, VC.NW(N), Nat.double(c), nwN(N, c, ec, hc)) :
    {F.limbs(VF.app([w0, w1, w2, w3, w4, w5, w6, w7, 36], VS.wtake(_, FD.array__slots(U32, T)))) == F.limbs(w0 <> w1 <> w2 <> w3 <> w4 <> w5 <> w6 <> w7 <> 36 <> VS.wtake(Nat.double(c), FD.array__slots(U32, T))) : +List<U32>}
  {==}

def hl_t(+w0: U32, +w1: U32, +w2: U32, +w3: U32, +w4: U32, +w5: U32, +w6: U32, +w7: U32, +dw: Nat, +T: FD.array__Tree<U32>, +N: U32, +c: Nat,
    +pfT: {FD.array__perfect(U32, dw, T) == True{} : Bool}, +hdw: {Nat.is_lt(dw, 31n) == True{} : Bool},
    +ec: {U32.to_nat(N) == VS.x8(c) : Nat}, +hc: {Nat.is_le(c, 128n) == True{} : Bool},
    +hroom: {Nat.is_le(Nat.add(VC.NW(N), 0n), VB.pw(dw)) == True{} : Bool})
    -> {Nat.is_le(Nat.double(c), FD.spec_common__length(U32, FD.array__slots(U32, T))) == True{} : Bool}:
  %Equal.sym(Nat, FD.spec_common__length(U32, FD.array__slots(U32, T)), VB.pw(dw), FD.array__slots_length(U32, dw, T, pfT)) : {Nat.is_le(Nat.double(c), _) == True{} : Bool}
  %nwN(N, c, ec, hc) : {Nat.is_le(_, VB.pw(dw)) == True{} : Bool}
  FD.logic__subst(Nat, z => {Nat.is_le(z, VB.pw(dw)) == True{} : Bool}, Nat.add(VC.NW(N), 0n), VC.NW(N), FD.nat__add_zero(VC.NW(N)), hroom)

# The bytes the encoder writes are the spec/codec.bend encoding of the object's value.
def encode_spec(+w0: U32, +w1: U32, +w2: U32, +w3: U32, +w4: U32, +w5: U32, +w6: U32, +w7: U32, +dw: Nat, +T: FD.array__Tree<U32>, +N: U32, +c: Nat,
    +pfT: {FD.array__perfect(U32, dw, T) == True{} : Bool}, +hdw: {Nat.is_lt(dw, 31n) == True{} : Bool},
    +ec: {U32.to_nat(N) == VS.x8(c) : Nat}, +hc: {Nat.is_le(c, 128n) == True{} : Bool},
    +hroom: {Nat.is_le(Nat.add(VC.NW(N), 0n), VB.pw(dw)) == True{} : Bool})
    -> Decoding.decodes(Spec.DataColumnsByRootIdentifier(), VS.bt(U32.to_nat(SFS(N)), F.limbs(FD.array__slots(U32, TD1(w0, w1, w2, w3, w4, w5, w6, w7, N, T)))), XE(w0, w1, w2, w3, w4, w5, w6, w7, c, FD.array__slots(U32, T))):
  Equal.trans(Maybe<&2, +List<U32>>, Codec.encoding_for_legal_type(Spec.DataColumnsByRootIdentifier(), XE(w0, w1, w2, w3, w4, w5, w6, w7, c, FD.array__slots(U32, T))), Some{F.limbs(w0 <> w1 <> w2 <> w3 <> w4 <> w5 <> w6 <> w7 <> 36 <> VS.wtake(Nat.double(c), FD.array__slots(U32, T)))}, Some{VS.bt(U32.to_nat(SFS(N)), F.limbs(FD.array__slots(U32, TD1(w0, w1, w2, w3, w4, w5, w6, w7, N, T))))},
    encE(w0, w1, w2, w3, w4, w5, w6, w7, c, FD.array__slots(U32, T), hc, hl_t(w0, w1, w2, w3, w4, w5, w6, w7, dw, T, N, c, pfT, hdw, ec, hc, hroom)),
    Equal.cong(+List<U32>, Maybe<&2, +List<U32>>, z => Some{z}, F.limbs(w0 <> w1 <> w2 <> w3 <> w4 <> w5 <> w6 <> w7 <> 36 <> VS.wtake(Nat.double(c), FD.array__slots(U32, T))), VS.bt(U32.to_nat(SFS(N)), F.limbs(FD.array__slots(U32, TD1(w0, w1, w2, w3, w4, w5, w6, w7, N, T)))), Equal.sym(+List<U32>, VS.bt(U32.to_nat(SFS(N)), F.limbs(FD.array__slots(U32, TD1(w0, w1, w2, w3, w4, w5, w6, w7, N, T)))), F.limbs(w0 <> w1 <> w2 <> w3 <> w4 <> w5 <> w6 <> w7 <> 36 <> VS.wtake(Nat.double(c), FD.array__slots(U32, T))), out_eq(w0, w1, w2, w3, w4, w5, w6, w7, dw, T, N, c, pfT, hdw, ec, hc, hroom))))

