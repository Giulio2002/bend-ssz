def okwOfOkM(+m: OB.MW, +hok: {OB.OK(m) == True{} : Bool}) -> {OB.OKW(m) == True{} : Bool}:
  match m:
    case OB.MW{+f_A, +m_f_B, +m_f_C, +f_D, +m_f_E, +m_f_F, +dB_f_G, +TB_f_G, +m_f_H, +m_f_I, +dB_f_J, +TB_f_J, +m_f_K, +m_f_L}: okwOfOk(f_A, m_f_B, m_f_C, f_D, m_f_E, m_f_F, dB_f_G, TB_f_G, m_f_H, m_f_I, dB_f_J, TB_f_J, m_f_K, m_f_L, hok)

law bndxO:
  for +m: OB.MW
  for +hok: {OB.OKW(m) == True{} : Bool}
  {Nat.is_lt(List.length(&2, U32, OB.ENC(m)), VB.pw(31n)) == True{} : Bool}
