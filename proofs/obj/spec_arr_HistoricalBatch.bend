# encoder soundness against spec/codec.bend
def HistoricalBatch_spec_encode(+l1: F.array__Tree<U32>, +l2: F.array__Tree<U32>, +pl1: {F.array__perfect(U32, 16n, l1) == True{} : Bool}, +pl2: {F.array__perfect(U32, 16n, l2) == True{} : Bool}, +s: S.Schema, +es: {s == Spec.HistoricalBatch() : S.Schema})
    -> Decoding.decodes(s, SF.limbs(F.array__slots(U32, F.TNode{l1, l2})), S.Sequence{S.Items{S.Sequence{AV.ch8(F.array__slots(U32, l1))}, S.Items{S.Sequence{AV.ch8(F.array__slots(U32, l2))}, S.EmptyItems{}}}}):
  SF.encoding_of_parts(s, S.Sequence{S.Items{S.Sequence{AV.ch8(F.array__slots(U32, l1))}, S.Items{S.Sequence{AV.ch8(F.array__slots(U32, l2))}, S.EmptyItems{}}}}, SF.limbs(F.array__slots(U32, F.TNode{l1, l2})), HistoricalBatch_spec_parts(l1, l2, pl1, pl2, s, es))

# every size other than 524288 is refused
def HistoricalBatch_spec_reject(buf: B.Buf, +m: U32, e: {U32.is_eq(m, 524288) == False{} : Bool})
    -> {T.HistoricalBatch_decode(buf, m) == (buf, None{}) : B.Buf & Maybe<&1, T.HistoricalBatch>}:
  %Equal.sym(Bool, U32.is_eq(m, 524288), False{}, e) : {T.HistoricalBatch_built(m, T.HistoricalBatch_ok_len(_, buf, 0)) == (buf, None{}) : B.Buf & Maybe<&1, T.HistoricalBatch>}
  {==}

