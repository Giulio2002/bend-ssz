            {B.byte_sel(0, U32{WCon{a0, WCon{a1, WCon{a2, WCon{a3, WCon{a4, WCon{a5, WCon{a6, WCon{a7, WCon{a8, WCon{a9, WCon{a10, WCon{a11, WCon{a12, WCon{a13, WCon{a14, WCon{a15, WCon{a16, WCon{a17, WCon{a18, WCon{a19, WCon{a20, WCon{a21, WCon{a22, WCon{a23, WCon{a24, WCon{a25, WCon{a26, WCon{a27, WCon{a28, WCon{a29, WCon{a30, WCon{a31, WNil{}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}) <> B.byte_sel(1, U32{WCon{a0, WCon{a1, WCon{a2, WCon{a3, WCon{a4, WCon{a5, WCon{a6, WCon{a7, WCon{a8, WCon{a9, WCon{a10, WCon{a11, WCon{a12, WCon{a13, WCon{a14, WCon{a15, WCon{a16, WCon{a17, WCon{a18, WCon{a19, WCon{a20, WCon{a21, WCon{a22, WCon{a23, WCon{a24, WCon{a25, WCon{a26, WCon{a27, WCon{a28, WCon{a29, WCon{a30, WCon{a31, WNil{}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}) <> B.byte_sel(2, U32{WCon{a0, WCon{a1, WCon{a2, WCon{a3, WCon{a4, WCon{a5, WCon{a6, WCon{a7, WCon{a8, WCon{a9, WCon{a10, WCon{a11, WCon{a12, WCon{a13, WCon{a14, WCon{a15, WCon{a16, WCon{a17, WCon{a18, WCon{a19, WCon{a20, WCon{a21, WCon{a22, WCon{a23, WCon{a24, WCon{a25, WCon{a26, WCon{a27, WCon{a28, WCon{a29, WCon{a30, WCon{a31, WNil{}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}) <> B.byte_sel(3, U32{WCon{a0, WCon{a1, WCon{a2, WCon{a3, WCon{a4, WCon{a5, WCon{a6, WCon{a7, WCon{a8, WCon{a9, WCon{a10, WCon{a11, WCon{a12, WCon{a13, WCon{a14, WCon{a15, WCon{a16, WCon{a17, WCon{a18, WCon{a19, WCon{a20, WCon{a21, WCon{a22, WCon{a23, WCon{a24, WCon{a25, WCon{a26, WCon{a27, WCon{a28, WCon{a29, WCon{a30, WCon{a31, WNil{}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}) <> _ == List.append(&2, U32, SF.limbs(Con{U32{WCon{a0, WCon{a1, WCon{a2, WCon{a3, WCon{a4, WCon{a5, WCon{a6, WCon{a7, WCon{a8, WCon{a9, WCon{a10, WCon{a11, WCon{a12, WCon{a13, WCon{a14, WCon{a15, WCon{a16, WCon{a17, WCon{a18, WCon{a19, WCon{a20, WCon{a21, WCon{a22, WCon{a23, WCon{a24, WCon{a25, WCon{a26, WCon{a27, WCon{a28, WCon{a29, WCon{a30, WCon{a31, WNil{}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}, t}), SB.pack(ys)) : +List<U32>}
          {==}

law lenb_app:
  for +xs: +List<Bool>
  for +ys: +List<Bool>
  {List.length(&2, Bool, List.append(&2, Bool, xs, ys)) == Nat.add(List.length(&2, Bool, xs), List.length(&2, Bool, ys)) : Nat}
def lenb_app(xs, ys):
  match xs:
    case Nil{}: {==}
    case Con{h, +t}: F.nat__succ_cong(List.length(&2, Bool, List.append(&2, Bool, t, ys)), Nat.add(List.length(&2, Bool, t), List.length(&2, Bool, ys)), lenb_app(t, ys))


def le1_lt(+x: U32, +h: {U32.is_le(x, 1) == True{} : Bool}) -> {U32.is_lt(x, 256) == True{} : Bool}:
  +hn = F.logic__subst(Cmp, c => {Cmp.is_le(c) == True{} : Bool}, U32.cmp(x, 1), Nat.cmp(U32.to_nat(x), 1n), F.u32__u32_cmp(x, 1), h)
  %Equal.sym(Cmp, U32.cmp(x, 256), Nat.cmp(U32.to_nat(x), 256n), F.u32__u32_cmp(x, 256)) : {Cmp.is_lt(_) == True{} : Bool}
  F.nat__le_lt_trans(U32.to_nat(x), 1n, 256n, hn, {==})

# ---- the spec encoding of one element ------------------------------------------------

def u8_part(+x: U32, +h: {U32.is_lt(x, 256) == True{} : Bool})
    -> {Codec.parts(S.UnsignedValue{P.UInt{x, 0, 0, 0, 0, 0, 0, 0}}, S.Unsigned{P.U8{}}) == Some{[S.Fixed{[x]}]} : Maybe<&2, +List<S.Part>>}:
  %IE.uint_serialize_correct(P.U8{}, P.UInt{x, 0, 0, 0, 0, 0, 0, 0}) :
    {Codec.one(_, Some{SP.byte_width(P.U8{})}) == Some{[S.Fixed{[x]}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(+List<U32>, I.limb(x), [x, 0, 0, 0], byte_limb(x, h)) :
    {Codec.one(I.narrow(1n, List.append(&2, U32, _, I.limb(0))), Some{1n}) == Some{[S.Fixed{[x]}]} : Maybe<&2, +List<S.Part>>}
  {==}

def bool_bb(+x: U32, +n: Nat, +en: {U32.to_nat(x) == n : Nat}, +h: {Cmp.is_le(Nat.cmp(n, 1n)) == True{} : Bool})
    -> {SP.boolean_encoding(U32.is_eq(x, 1)) == [x] : +List<U32>}:
  match n:
    case 0n: F.logic__subst(U32, z => {SP.boolean_encoding(U32.is_eq(z, 1)) == [z] : +List<U32>}, 0, x, Equal.sym(U32, x, 0, F.u32__injective(x, 0, en)), {==})
    case 1n: F.logic__subst(U32, z => {SP.boolean_encoding(U32.is_eq(z, 1)) == [z] : +List<U32>}, 1, x, Equal.sym(U32, x, 1, F.u32__injective(x, 1, en)), {==})
    case 2n+m: Empty.absurd({SP.boolean_encoding(U32.is_eq(x, 1)) == [x] : +List<U32>}, F.logic__false_true(h))

def bool_part(+x: U32, +h: {U32.is_le(x, 1) == True{} : Bool})
    -> {Codec.parts(S.BooleanValue{U32.is_eq(x, 1)}, S.Boolean{}) == Some{[S.Fixed{[x]}]} : Maybe<&2, +List<S.Part>>}:
  %Equal.sym(+List<U32>, SP.boolean_encoding(U32.is_eq(x, 1)), [x], bool_bb(x, U32.to_nat(x), {==}, F.logic__subst(Cmp, c => {Cmp.is_le(c) == True{} : Bool}, U32.cmp(x, 1), Nat.cmp(U32.to_nat(x), 1n), F.u32__u32_cmp(x, 1), h))) :
    {Some{[S.Fixed{_}]} == Some{[S.Fixed{[x]}]} : Maybe<&2, +List<S.Part>>}
  {==}

# ---- lists of fixed parts ---------------------------------------------------------------

def fcat(pl: +List<S.Part>) -> +List<U32>:
  match pl:
    case Nil{}: []
    case Con{h, t}:
      match h:
        case S.Fixed{xs}: List.append(&2, U32, xs, fcat(t))
        case S.Variable{xs}: fcat(t)

def allfx(pl: +List<S.Part>) -> Bool:
  match pl:
    case Nil{}: True{}
    case Con{h, t}:
      match h:
        case S.Fixed{xs}: allfx(t)
        case S.Variable{xs}: False{}

law pay0:
  for +pl: +List<S.Part>
  for +h: {allfx(pl) == True{} : Bool}
  {Layout.payloads(pl) == [] : +List<U32>}
def pay0(pl, h):
  match pl:
    case Nil{}: {==}
    case Con{+p, +t}:
      match p:
        case S.Fixed{xs}: pay0(t, h)
        case S.Variable{xs}: Empty.absurd({Layout.payloads(Con{S.Variable{xs}, t}) == [] : +List<U32>}, F.logic__false_true(h))

law fxp:
  for +pl: +List<S.Part>
  for +o: Nat
  for +h: {allfx(pl) == True{} : Bool}
  {Layout.fixed_parts(pl, o) == fcat(pl) : +List<U32>}
def fxp(pl, o, h):
  match pl:
    case Nil{}: {==}
    case Con{+p, +t}:
      match p:
        case S.Fixed{+xs}: Equal.cong(+List<U32>, +List<U32>, z => List.append(&2, U32, xs, z), Layout.fixed_parts(t, o), fcat(t), fxp(t, o, h))
        case S.Variable{xs}: Empty.absurd({Layout.fixed_parts(Con{S.Variable{xs}, t}, o) == fcat(Con{S.Variable{xs}, t}) : +List<U32>}, F.logic__false_true(h))

law len_app:
  for +xs: +List<U32>
  for +ys: +List<U32>
  {List.length(&2, U32, List.append(&2, U32, xs, ys)) == Nat.add(List.length(&2, U32, xs), List.length(&2, U32, ys)) : Nat}
def len_app(xs, ys):
  match xs:
    case Nil{}: {==}
    case Con{h, +t}: F.nat__succ_cong(List.length(&2, U32, List.append(&2, U32, t, ys)), Nat.add(List.length(&2, U32, t), List.length(&2, U32, ys)), len_app(t, ys))

law fsz:
  for +pl: +List<S.Part>
  for +h: {allfx(pl) == True{} : Bool}
  {Layout.fixed_size(pl) == List.length(&2, U32, fcat(pl)) : Nat}
def fsz(pl, h):
  match pl:
    case Nil{}: {==}
    case Con{+p, +t}:
      match p:
        case S.Fixed{+xs}:
          %Equal.sym(Nat, Layout.fixed_size(t), List.length(&2, U32, fcat(t)), fsz(t, h)) : {Nat.add(List.length(&2, U32, xs), _) == List.length(&2, U32, List.append(&2, U32, xs, fcat(t))) : Nat}
          Equal.sym(Nat, List.length(&2, U32, List.append(&2, U32, xs, fcat(t))), Nat.add(List.length(&2, U32, xs), List.length(&2, U32, fcat(t))), len_app(xs, fcat(t)))
        case S.Variable{xs}: Empty.absurd({Layout.fixed_size(Con{S.Variable{xs}, t}) == List.length(&2, U32, fcat(Con{S.Variable{xs}, t})) : Nat}, F.logic__false_true(h))

law bd_l:
  for +xs: +List<U32>
  for +ys: +List<U32>
  for +h: {SP.bytes_domain(List.append(&2, U32, xs, ys)) == True{} : Bool}
  {SP.bytes_domain(xs) == True{} : Bool}
def bd_l(xs, ys, h):
  match xs:
    case Nil{}: {==}
    case Con{+x, +t}:
      V.and_true(U32.is_lt(x, 256), SP.bytes_domain(t), V.and_left(U32.is_lt(x, 256), SP.bytes_domain(List.append(&2, U32, t, ys)), h),
        bd_l(t, ys, V.and_right(U32.is_lt(x, 256), SP.bytes_domain(List.append(&2, U32, t, ys)), h)))

law bd_r:
  for +xs: +List<U32>
  for +ys: +List<U32>
  for +h: {SP.bytes_domain(List.append(&2, U32, xs, ys)) == True{} : Bool}
  {SP.bytes_domain(ys) == True{} : Bool}
def bd_r(xs, ys, h):
  match xs:
    case Nil{}: h
    case Con{+x, +t}: bd_r(t, ys, V.and_right(U32.is_lt(x, 256), SP.bytes_domain(List.append(&2, U32, t, ys)), h))

law bd_app:
  for +xs: +List<U32>
  for +ys: +List<U32>
  for +hx: {SP.bytes_domain(xs) == True{} : Bool}
  for +hy: {SP.bytes_domain(ys) == True{} : Bool}
  {SP.bytes_domain(List.append(&2, U32, xs, ys)) == True{} : Bool}
def bd_app(xs, ys, hx, hy):
  match xs:
    case Nil{}: hy
    case Con{+x, +t}:
      V.and_true(U32.is_lt(x, 256), SP.bytes_domain(List.append(&2, U32, t, ys)), V.and_left(U32.is_lt(x, 256), SP.bytes_domain(t), hx),
        bd_app(t, ys, V.and_right(U32.is_lt(x, 256), SP.bytes_domain(t), hx), hy))

law bvl:
  for +pl: +List<S.Part>
  for +h: {allfx(pl) == True{} : Bool}
  for +hv: {SP.bytes_domain(fcat(pl)) == True{} : Bool}
  {Layout.bytes_valid(pl) == True{} : Bool}
def bvl(pl, h, hv):
  match pl:
    case Nil{}: {==}
    case Con{+p, +t}:
      match p:
        case S.Fixed{+xs}: V.and_true(SP.bytes_domain(xs), Layout.bytes_valid(t), bd_l(xs, fcat(t), hv), bvl(t, h, bd_r(xs, fcat(t), hv)))
        case S.Variable{xs}: Empty.absurd({Layout.bytes_valid(Con{S.Variable{xs}, t}) == True{} : Bool}, F.logic__false_true(h))

law app_nil:
  for +xs: +List<U32>
  {List.append(&2, U32, xs, []) == xs : +List<U32>}
def app_nil(xs):
  match xs:
    case Nil{}: {==}
    case Con{+h, +t}: F.list__cons_cong(U32, h, List.append(&2, U32, t, []), t, app_nil(t))

# The aggregate of fixed parts whose bytes are bytes: one fixed part, their bytes.
law agg:
  for +pl: +List<S.Part>
  for +x: Nat
  for +N: Nat
  for +h: {allfx(pl) == True{} : Bool}
  for +hv: {SP.bytes_domain(fcat(pl)) == True{} : Bool}
  for +hN: {List.length(&2, U32, fcat(pl)) == N : Nat}
  for +hf: {NB.fits(4n, Nat.add(N, 0n)) == True{} : Bool}
  {Codec.aggregate(Some{pl}, Some{x}) == Some{[S.Fixed{fcat(pl)}]} : Maybe<&2, +List<S.Part>>}
def agg(pl, x, N, h, hv, hN, hf):
  %Equal.sym(+List<U32>, Layout.payloads(pl), [], pay0(pl, h)) :
    {Codec.one(SP.optional(Bool.and(Layout.bytes_valid(pl), NB.fits(4n, Nat.add(Layout.fixed_size(pl), List.length(&2, U32, _)))), List.append(&2, U32, Layout.fixed_parts(pl, Layout.fixed_size(pl)), _)), Some{x}) == Some{[S.Fixed{fcat(pl)}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(Bool, Layout.bytes_valid(pl), True{}, bvl(pl, h, hv)) :
    {Codec.one(SP.optional(Bool.and(_, NB.fits(4n, Nat.add(Layout.fixed_size(pl), 0n))), List.append(&2, U32, Layout.fixed_parts(pl, Layout.fixed_size(pl)), [])), Some{x}) == Some{[S.Fixed{fcat(pl)}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(+List<U32>, Layout.fixed_parts(pl, Layout.fixed_size(pl)), fcat(pl), fxp(pl, Layout.fixed_size(pl), h)) :
    {Codec.one(SP.optional(Bool.and(True{}, NB.fits(4n, Nat.add(Layout.fixed_size(pl), 0n))), List.append(&2, U32, _, [])), Some{x}) == Some{[S.Fixed{fcat(pl)}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(Nat, Layout.fixed_size(pl), N, Equal.trans(Nat, Layout.fixed_size(pl), List.length(&2, U32, fcat(pl)), N, fsz(pl, h), hN)) :
    {Codec.one(SP.optional(Bool.and(True{}, NB.fits(4n, Nat.add(_, 0n))), List.append(&2, U32, fcat(pl), [])), Some{x}) == Some{[S.Fixed{fcat(pl)}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(Bool, NB.fits(4n, Nat.add(N, 0n)), True{}, hf) :
    {Codec.one(SP.optional(Bool.and(True{}, _), List.append(&2, U32, fcat(pl), [])), Some{x}) == Some{[S.Fixed{fcat(pl)}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(+List<U32>, List.append(&2, U32, fcat(pl), []), fcat(pl), app_nil(fcat(pl))) :
    {Codec.one(SP.optional(True{}, _), Some{x}) == Some{[S.Fixed{fcat(pl)}]} : Maybe<&2, +List<S.Part>>}
  {==}

def unsome(m: Maybe<&2, Nat>) -> Nat:
  match m:
    case None{}: 0n
    case Some{v}: v

# A vector of any element whose items' parts are fixed byte parts.
def vparts(+s: S.Schema, +items: S.Value, +e: S.Schema, +k: Nat, +pl: +List<S.Part>, +N: Nat,
    +hs: {SH.is_Vector(s) == True{} : Bool}, +he: {SH.Vector_element(s) == e : S.Schema},
    +hk: {Nat.is_eq(SH.Vector_length(s), k) == True{} : Bool}, +hk0: {Nat.is_lt(0n, k) == True{} : Bool},
    +hc: {Codec.count(items) == k : Nat}, +hp: {Codec.parts(items, S.Repeat{e}) == Some{pl} : Maybe<&2, +List<S.Part>>},
    +h: {allfx(pl) == True{} : Bool}, +hv: {SP.bytes_domain(fcat(pl)) == True{} : Bool},
    +hN: {List.length(&2, U32, fcat(pl)) == N : Nat}, +hf: {NB.fits(4n, Nat.add(N, 0n)) == True{} : Bool},
    +x: Nat, +hx: {SSC.times(k, SSC.fixed_size(e)) == Some{x} : Maybe<&2, Nat>})
    -> {Codec.parts(S.Sequence{items}, s) == Some{[S.Fixed{fcat(pl)}]} : Maybe<&2, +List<S.Part>>}:
  +ek = F.nat__eq_from_is_eq(SH.Vector_length(s), k, hk)
  %Equal.sym(S.Schema, s, S.Vector{SH.Vector_element(s), SH.Vector_length(s)}, SH.Vector_shape(s, hs)) :
    {Codec.parts(S.Sequence{items}, _) == Some{[S.Fixed{fcat(pl)}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(S.Schema, SH.Vector_element(s), e, he) : {Codec.parts(S.Sequence{items}, S.Vector{_, SH.Vector_length(s)}) == Some{[S.Fixed{fcat(pl)}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(Nat, SH.Vector_length(s), k, ek) :
    {Codec.require(Bool.and(Nat.is_lt(0n, _), Nat.is_eq(Codec.count(items), _)), Codec.aggregate(Codec.parts(items, S.Repeat{e}), SSC.times(_, SSC.fixed_size(e)))) == Some{[S.Fixed{fcat(pl)}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(Nat, Codec.count(items), k, hc) :
    {Codec.require(Bool.and(Nat.is_lt(0n, k), Nat.is_eq(_, k)), Codec.aggregate(Codec.parts(items, S.Repeat{e}), SSC.times(k, SSC.fixed_size(e)))) == Some{[S.Fixed{fcat(pl)}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(Bool, Nat.is_lt(0n, k), True{}, hk0) :
    {Codec.require(Bool.and(_, Nat.is_eq(k, k)), Codec.aggregate(Codec.parts(items, S.Repeat{e}), SSC.times(k, SSC.fixed_size(e)))) == Some{[S.Fixed{fcat(pl)}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(Bool, Nat.is_eq(k, k), True{}, F.nat__is_eq_refl(k)) :
    {Codec.require(Bool.and(True{}, _), Codec.aggregate(Codec.parts(items, S.Repeat{e}), SSC.times(k, SSC.fixed_size(e)))) == Some{[S.Fixed{fcat(pl)}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(Maybe<&2, +List<S.Part>>, Codec.parts(items, S.Repeat{e}), Some{pl}, hp) :
    {Codec.aggregate(_, SSC.times(k, SSC.fixed_size(e))) == Some{[S.Fixed{fcat(pl)}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(Maybe<&2, Nat>, SSC.times(k, SSC.fixed_size(e)), Some{x}, hx) : {Codec.aggregate(Some{pl}, _) == Some{[S.Fixed{fcat(pl)}]} : Maybe<&2, +List<S.Part>>}
  agg(pl, x, N, h, hv, hN, hf)


# ---- the bytes of words -------------------------------------------------------------------

law bd_limbs:
  for +ws: +List<U32>
  {SP.bytes_domain(SF.limbs(ws)) == True{} : Bool}
def bd_limbs(ws):
  match ws:
    case Nil{}: {==}
    case Con{+w, +t}:
      %Equal.sym(Bool, U32.is_lt(B.byte_sel(0, w), 256), True{}, bsel_lt0(w)) : {Bool.and(_, Bool.and(U32.is_lt(B.byte_sel(1, w), 256), Bool.and(U32.is_lt(B.byte_sel(2, w), 256), Bool.and(U32.is_lt(B.byte_sel(3, w), 256), SP.bytes_domain(SF.limbs(t)))))) == True{} : Bool}
      %Equal.sym(Bool, U32.is_lt(B.byte_sel(1, w), 256), True{}, bsel_lt1(w)) : {Bool.and(_, Bool.and(U32.is_lt(B.byte_sel(2, w), 256), Bool.and(U32.is_lt(B.byte_sel(3, w), 256), SP.bytes_domain(SF.limbs(t))))) == True{} : Bool}
      %Equal.sym(Bool, U32.is_lt(B.byte_sel(2, w), 256), True{}, bsel_lt2(w)) : {Bool.and(_, Bool.and(U32.is_lt(B.byte_sel(3, w), 256), SP.bytes_domain(SF.limbs(t)))) == True{} : Bool}
      %Equal.sym(Bool, U32.is_lt(B.byte_sel(3, w), 256), True{}, bsel_lt3(w)) : {Bool.and(_, SP.bytes_domain(SF.limbs(t))) == True{} : Bool}
      bd_limbs(t)

# ---- Vector[uint8, n]: one element per byte ----------------------------------------------

def vu8(xs: +List<U32>) -> S.Value:
  match xs:
    case Nil{}: S.EmptyItems{}
    case Con{x, t}: S.Items{S.UnsignedValue{P.UInt{x, 0, 0, 0, 0, 0, 0, 0}}, vu8(t)}

def fx1(xs: +List<U32>) -> +List<S.Part>:
  match xs:
    case Nil{}: []
    case Con{x, t}: Con{S.Fixed{[x]}, fx1(t)}

law fx1_all:
  for +xs: +List<U32>
  {allfx(fx1(xs)) == True{} : Bool}
def fx1_all(xs):
  match xs:
    case Nil{}: {==}
    case Con{x, +t}: fx1_all(t)

law fx1_cat:
  for +xs: +List<U32>
  {fcat(fx1(xs)) == xs : +List<U32>}
def fx1_cat(xs):
  match xs:
    case Nil{}: {==}
    case Con{+x, +t}: F.list__cons_cong(U32, x, fcat(fx1(t)), t, fx1_cat(t))

law prt_u8:
  for +xs: +List<U32>
  for +h: {SP.bytes_domain(xs) == True{} : Bool}
  {Codec.parts(vu8(xs), S.Repeat{S.Unsigned{P.U8{}}}) == Some{fx1(xs)} : Maybe<&2, +List<S.Part>>}
def prt_u8(xs, h):
  match xs:
    case Nil{}: {==}
    case Con{+x, +t}:
      SF.cat_fixed(Codec.parts(S.UnsignedValue{P.UInt{x, 0, 0, 0, 0, 0, 0, 0}}, S.Unsigned{P.U8{}}), [x], Codec.parts(vu8(t), S.Repeat{S.Unsigned{P.U8{}}}), fx1(t),
        u8_part(x, V.and_left(U32.is_lt(x, 256), SP.bytes_domain(t), h)), prt_u8(t, V.and_right(U32.is_lt(x, 256), SP.bytes_domain(t), h)))

# ---- Vector[bool, n]: one element per byte, each at most 1 ----------------------------------

def vbool(xs: +List<U32>) -> S.Value:
  match xs:
    case Nil{}: S.EmptyItems{}
    case Con{x, t}: S.Items{S.BooleanValue{U32.is_eq(x, 1)}, vbool(t)}

def ble(xs: +List<U32>) -> Bool:
  match xs:
    case Nil{}: True{}
    case Con{x, t}: Bool.and(U32.is_le(x, 1), ble(t))

# the decoder's check, a left fold over the bytes
def lf(xs: +List<U32>, acc: Bool) -> Bool:
  match xs:
    case Nil{}: acc
    case Con{+x, t}: lf(t, Bool.and(acc, U32.is_le(x, 1)))

law lf_ble:
  for +xs: +List<U32>
  for +acc: Bool
  for +h: {lf(xs, acc) == True{} : Bool}
  {Bool.and(acc, ble(xs)) == True{} : Bool}
def lf_ble(xs, acc, h):
  match xs acc:
    case Nil{} _: V.and_true(acc, True{}, h, {==})
    case Con{+x, +t} False{}: Empty.absurd({Bool.and(False{}, ble(Con{x, t})) == True{} : Bool}, F.logic__false_true(lf_ble(t, False{}, h)))
    case Con{+x, +t} True{}: lf_ble(t, U32.is_le(x, 1), h)

law ble_bd:
  for +xs: +List<U32>
  for +h: {ble(xs) == True{} : Bool}
  {SP.bytes_domain(xs) == True{} : Bool}
def ble_bd(xs, h):
  match xs:
    case Nil{}: {==}
    case Con{+x, +t}:
      V.and_true(U32.is_lt(x, 256), SP.bytes_domain(t), le1_lt(x, V.and_left(U32.is_le(x, 1), ble(t), h)), ble_bd(t, V.and_right(U32.is_le(x, 1), ble(t), h)))

law prt_bool:
  for +xs: +List<U32>
  for +h: {ble(xs) == True{} : Bool}
  {Codec.parts(vbool(xs), S.Repeat{S.Boolean{}}) == Some{fx1(xs)} : Maybe<&2, +List<S.Part>>}
def prt_bool(xs, h):
  match xs:
    case Nil{}: {==}
    case Con{+x, +t}:
      SF.cat_fixed(Codec.parts(S.BooleanValue{U32.is_eq(x, 1)}, S.Boolean{}), [x], Codec.parts(vbool(t), S.Repeat{S.Boolean{}}), fx1(t),
        bool_part(x, V.and_left(U32.is_le(x, 1), ble(t), h)), prt_bool(t, V.and_right(U32.is_le(x, 1), ble(t), h)))

# ---- Vector[uint16, n]: two elements per word, then a tail ---------------------------------

def vu16(ws: +List<U32>, tl: S.Value) -> S.Value:
  match ws:
    case Nil{}: tl
    case Con{+w, t}: S.Items{S.UnsignedValue{P.UInt{lo16(w), 0, 0, 0, 0, 0, 0, 0}}, S.Items{S.UnsignedValue{P.UInt{hi16(w), 0, 0, 0, 0, 0, 0, 0}}, vu16(t, tl)}}

def fx16(ws: +List<U32>, tp: +List<S.Part>) -> +List<S.Part>:
  match ws:
    case Nil{}: tp
    case Con{+w, t}: Con{S.Fixed{[B.byte_sel(0, w), B.byte_sel(1, w)]}, Con{S.Fixed{[B.byte_sel(2, w), B.byte_sel(3, w)]}, fx16(t, tp)}}

law fx16_all:
  for +ws: +List<U32>
  for +tp: +List<S.Part>
  for +h: {allfx(tp) == True{} : Bool}
  {allfx(fx16(ws, tp)) == True{} : Bool}
def fx16_all(ws, tp, h):
  match ws:
    case Nil{}: h
    case Con{w, +t}: fx16_all(t, tp, h)

law fx16_cat:
  for +ws: +List<U32>
  for +tp: +List<S.Part>
  {fcat(fx16(ws, tp)) == List.append(&2, U32, SF.limbs(ws), fcat(tp)) : +List<U32>}
def fx16_cat(ws, tp):
  match ws:
    case Nil{}: {==}
    case Con{+w, +t}:
      %Equal.sym(+List<U32>, fcat(fx16(t, tp)), List.append(&2, U32, SF.limbs(t), fcat(tp)), fx16_cat(t, tp)) : {B.byte_sel(0, w) <> B.byte_sel(1, w) <> B.byte_sel(2, w) <> B.byte_sel(3, w) <> _ == List.append(&2, U32, SF.limbs(Con{w, t}), fcat(tp)) : +List<U32>}
      {==}

law prt_u16:
  for +ws: +List<U32>
  for +tl: S.Value
  for +tp: +List<S.Part>
  for +h: {Codec.parts(tl, S.Repeat{S.Unsigned{P.U16{}}}) == Some{tp} : Maybe<&2, +List<S.Part>>}
  {Codec.parts(vu16(ws, tl), S.Repeat{S.Unsigned{P.U16{}}}) == Some{fx16(ws, tp)} : Maybe<&2, +List<S.Part>>}
def prt_u16(ws, tl, tp, h):
  match ws:
    case Nil{}: h
    case Con{+w, +t}:
      SF.cat_fixed(Codec.parts(S.UnsignedValue{P.UInt{lo16(w), 0, 0, 0, 0, 0, 0, 0}}, S.Unsigned{P.U16{}}), [B.byte_sel(0, w), B.byte_sel(1, w)],
        Codec.parts(S.Items{S.UnsignedValue{P.UInt{hi16(w), 0, 0, 0, 0, 0, 0, 0}}, vu16(t, tl)}, S.Repeat{S.Unsigned{P.U16{}}}), Con{S.Fixed{[B.byte_sel(2, w), B.byte_sel(3, w)]}, fx16(t, tp)},
        u16lo_part(w),
        SF.cat_fixed(Codec.parts(S.UnsignedValue{P.UInt{hi16(w), 0, 0, 0, 0, 0, 0, 0}}, S.Unsigned{P.U16{}}), [B.byte_sel(2, w), B.byte_sel(3, w)],
          Codec.parts(vu16(t, tl), S.Repeat{S.Unsigned{P.U16{}}}), fx16(t, tp), u16hi_part(w), prt_u16(t, tl, tp, h)))

# ---- counts and lengths, for the laws stated over any list -------------------------------

law cnt_vu8:
  for +xs: +List<U32>
  {Codec.count(vu8(xs)) == List.length(&2, U32, xs) : Nat}
def cnt_vu8(xs):
  match xs:
    case Nil{}: {==}
    case Con{x, +t}: F.nat__succ_cong(Codec.count(vu8(t)), List.length(&2, U32, t), cnt_vu8(t))

law cnt_vbool:
  for +xs: +List<U32>
  {Codec.count(vbool(xs)) == List.length(&2, U32, xs) : Nat}
def cnt_vbool(xs):
  match xs:
    case Nil{}: {==}
    case Con{x, +t}: F.nat__succ_cong(Codec.count(vbool(t)), List.length(&2, U32, t), cnt_vbool(t))

def c16(+n: Nat, +c: Nat) -> Nat:
  match n:
    case 0n: c
    case 1n+ +k: 2n+c16(k, c)

def l16(+n: Nat, +c: Nat) -> Nat:
  match n:
    case 0n: c
    case 1n+ +k: 4n+l16(k, c)

law cnt_vu16:
  for +ws: +List<U32>
  for +tl: S.Value
  {Codec.count(vu16(ws, tl)) == c16(List.length(&2, U32, ws), Codec.count(tl)) : Nat}
def cnt_vu16(ws, tl):
  match ws:
    case Nil{}: {==}
    case Con{w, +t}: F.nat__succ_cong(1n+Codec.count(vu16(t, tl)), 1n+c16(List.length(&2, U32, t), Codec.count(tl)), F.nat__succ_cong(Codec.count(vu16(t, tl)), c16(List.length(&2, U32, t), Codec.count(tl)), cnt_vu16(t, tl)))

law len_fx16:
  for +ws: +List<U32>
  for +tp: +List<S.Part>
  {List.length(&2, U32, fcat(fx16(ws, tp))) == l16(List.length(&2, U32, ws), List.length(&2, U32, fcat(tp))) : Nat}
def len_fx16(ws, tp):
  match ws:
    case Nil{}: {==}
    case Con{w, +t}:
      F.nat__succ_cong(3n+List.length(&2, U32, fcat(fx16(t, tp))), 3n+l16(List.length(&2, U32, t), List.length(&2, U32, fcat(tp))),
        F.nat__succ_cong(2n+List.length(&2, U32, fcat(fx16(t, tp))), 2n+l16(List.length(&2, U32, t), List.length(&2, U32, fcat(tp))),
          F.nat__succ_cong(1n+List.length(&2, U32, fcat(fx16(t, tp))), 1n+l16(List.length(&2, U32, t), List.length(&2, U32, fcat(tp))),
            F.nat__succ_cong(List.length(&2, U32, fcat(fx16(t, tp))), l16(List.length(&2, U32, t), List.length(&2, U32, fcat(tp))), len_fx16(t, tp)))))

