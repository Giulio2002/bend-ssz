# The encoding is the buffer's first n bytes.
def lim3(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +eN: {U32.to_nat(n) == A.quad(QN(t, n)) : Nat}, +h89: {Nat.is_le(89n, VB.pw(d)) == True{} : Bool},
    +w0: {Y0(t) == X0(t) : List<&2, U32>}, +w1: {Y1(t) == X1(t) : List<&2, U32>}, +w2: {Y2(t, n) == X2(t, n) : List<&2, U32>})
    -> {ENC(t, n) == VW(t, n) : +List<U32>}:
  +S = SW(t)
  +h89L = FD.logic__subst(Nat, z => {Nat.is_le(89n, z) == True{} : Bool}, VB.pw(d), VB.len(S), Equal.sym(Nat, VB.len(S), VB.pw(d), FD.array__slots_length(U32, d, t, pf)), h89)
  +LH = F.limbs(VF.app(VF.wpre(89n, 0n, S), VS.wtake(0n, VB.wdr(Nat.add(89n, 0n), S))))
  %Equal.sym(Nat, U32.to_nat(n), A.quad(QN(t, n)), eN) : {ENC(t, n) == VS.bt(_, F.limbs(S)) : +List<U32>}
  %Equal.sym(+List<U32>, VS.bt(A.quad(QN(t, n)), F.limbs(S)), F.limbs(VS.wtake(QN(t, n), S)), VS.bt_limbs(QN(t, n), S)) : {ENC(t, n) == _ : +List<U32>}
  %Equal.sym(List<&2, U32>, VS.wtake(QN(t, n), S), VF.app(VS.wtake(Q2(t), S), X2(t, n)), VF.take_split(Q2(t), M2(t, n), S)) : {ENC(t, n) == F.limbs(_) : +List<U32>}
  %Equal.sym(+List<U32>, F.limbs(VF.app(VS.wtake(Q2(t), S), X2(t, n))), List.append(&2, U32, F.limbs(VS.wtake(Q2(t), S)), F.limbs(X2(t, n))), VF.limbs_app(VS.wtake(Q2(t), S), X2(t, n))) :
    {ENC(t, n) == _ : +List<U32>}
  %Equal.sym(List<&2, U32>, VS.wtake(Q2(t), S), VF.app(VS.wtake(Q1(t), S), X1(t)), VF.take_split(Q1(t), M1(t), S)) :
    {ENC(t, n) == List.append(&2, U32, F.limbs(_), F.limbs(X2(t, n))) : +List<U32>}
  %Equal.sym(+List<U32>, F.limbs(VF.app(VS.wtake(Q1(t), S), X1(t))), List.append(&2, U32, F.limbs(VS.wtake(Q1(t), S)), F.limbs(X1(t))), VF.limbs_app(VS.wtake(Q1(t), S), X1(t))) :
    {ENC(t, n) == List.append(&2, U32, _, F.limbs(X2(t, n))) : +List<U32>}
  %Equal.sym(List<&2, U32>, VS.wtake(Q1(t), S), VF.app(VS.wtake(89n, S), X0(t)), VF.take_split(89n, M0(t), S)) :
    {ENC(t, n) == List.append(&2, U32, List.append(&2, U32, F.limbs(_), F.limbs(X1(t))), F.limbs(X2(t, n))) : +List<U32>}
  %Equal.sym(+List<U32>, F.limbs(VF.app(VS.wtake(89n, S), X0(t))), List.append(&2, U32, F.limbs(VS.wtake(89n, S)), F.limbs(X0(t))), VF.limbs_app(VS.wtake(89n, S), X0(t))) :
    {ENC(t, n) == List.append(&2, U32, List.append(&2, U32, _, F.limbs(X1(t))), F.limbs(X2(t, n))) : +List<U32>}
  %Equal.sym(List<&2, U32>, VS.wtake(Nat.add(89n, 0n), VB.wdr(0n, S)), VF.app(VF.wpre(89n, 0n, S), VS.wtake(0n, VB.wdr(Nat.add(89n, 0n), S))), VF.wt_pre(89n, 0n, 0n, S, h89L)) :
    {ENC(t, n) == List.append(&2, U32, List.append(&2, U32, List.append(&2, U32, F.limbs(_), F.limbs(X0(t))), F.limbs(X1(t))), F.limbs(X2(t, n))) : +List<U32>}
  %Equal.sym(+List<U32>, List.append(&2, U32, List.append(&2, U32, List.append(&2, U32, LH, F.limbs(X0(t))), F.limbs(X1(t))), F.limbs(X2(t, n))),
      List.append(&2, U32, List.append(&2, U32, LH, F.limbs(X0(t))), List.append(&2, U32, F.limbs(X1(t)), F.limbs(X2(t, n)))),
      VS.app_assoc(List.append(&2, U32, LH, F.limbs(X0(t))), F.limbs(X1(t)), F.limbs(X2(t, n)))) :
    {ENC(t, n) == _ : +List<U32>}
  %Equal.sym(+List<U32>, List.append(&2, U32, List.append(&2, U32, LH, F.limbs(X0(t))), List.append(&2, U32, F.limbs(X1(t)), F.limbs(X2(t, n)))),
      List.append(&2, U32, LH, List.append(&2, U32, F.limbs(X0(t)), List.append(&2, U32, F.limbs(X1(t)), F.limbs(X2(t, n))))),
      VS.app_assoc(LH, F.limbs(X0(t)), List.append(&2, U32, F.limbs(X1(t)), F.limbs(X2(t, n))))) :
    {ENC(t, n) == _ : +List<U32>}
  %Equal.sym(List<&2, U32>, Y0(t), X0(t), w0) :
    {List.append(&2, U32, HDB(t), List.append(&2, U32, F.limbs(_), List.append(&2, U32, F.limbs(Y1(t)), F.limbs(Y2(t, n))))) == List.append(&2, U32, LH, List.append(&2, U32, F.limbs(X0(t)), List.append(&2, U32, F.limbs(X1(t)), F.limbs(X2(t, n))))) : +List<U32>}
  %Equal.sym(List<&2, U32>, Y1(t), X1(t), w1) :
    {List.append(&2, U32, HDB(t), List.append(&2, U32, F.limbs(X0(t)), List.append(&2, U32, F.limbs(_), F.limbs(Y2(t, n))))) == List.append(&2, U32, LH, List.append(&2, U32, F.limbs(X0(t)), List.append(&2, U32, F.limbs(X1(t)), F.limbs(X2(t, n))))) : +List<U32>}
  %Equal.sym(List<&2, U32>, Y2(t, n), X2(t, n), w2) :
    {List.append(&2, U32, HDB(t), List.append(&2, U32, F.limbs(X0(t)), List.append(&2, U32, F.limbs(X1(t)), F.limbs(_)))) == List.append(&2, U32, LH, List.append(&2, U32, F.limbs(X0(t)), List.append(&2, U32, F.limbs(X1(t)), F.limbs(X2(t, n))))) : +List<U32>}
  {==}

