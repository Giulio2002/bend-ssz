  and_l(Nat.is_lt(TDM_l2_ConsolidationRequest(A), 31n), Bool.and(FD.array__perfect(FuluConsolidationRequest_d.ConsolidationRequest, TDM_l2_ConsolidationRequest(A), A), Bool.and(Nat.is_le(U32.to_nat(N), VB.pw(TDM_l2_ConsolidationRequest(A))), U32.is_le(N, 2))), h)
def okl_1_l2_ConsolidationRequest(+A: FD.array__Tree<FuluConsolidationRequest_d.ConsolidationRequest>, +N: U32, +h: {OKL_l2_ConsolidationRequest(A, N) == True{} : Bool})
    -> {Bool.and(FD.array__perfect(FuluConsolidationRequest_d.ConsolidationRequest, TDM_l2_ConsolidationRequest(A), A), Bool.and(Nat.is_le(U32.to_nat(N), VB.pw(TDM_l2_ConsolidationRequest(A))), U32.is_le(N, 2))) == True{} : Bool}:
  and_r(Nat.is_lt(TDM_l2_ConsolidationRequest(A), 31n), Bool.and(FD.array__perfect(FuluConsolidationRequest_d.ConsolidationRequest, TDM_l2_ConsolidationRequest(A), A), Bool.and(Nat.is_le(U32.to_nat(N), VB.pw(TDM_l2_ConsolidationRequest(A))), U32.is_le(N, 2))), h)
def okl_pf_l2_ConsolidationRequest(+A: FD.array__Tree<FuluConsolidationRequest_d.ConsolidationRequest>, +N: U32, +h: {OKL_l2_ConsolidationRequest(A, N) == True{} : Bool}) -> {FD.array__perfect(FuluConsolidationRequest_d.ConsolidationRequest, TDM_l2_ConsolidationRequest(A), A) == True{} : Bool}:
  and_l(FD.array__perfect(FuluConsolidationRequest_d.ConsolidationRequest, TDM_l2_ConsolidationRequest(A), A), Bool.and(Nat.is_le(U32.to_nat(N), VB.pw(TDM_l2_ConsolidationRequest(A))), U32.is_le(N, 2)), okl_1_l2_ConsolidationRequest(A, N, h))
def okl_2_l2_ConsolidationRequest(+A: FD.array__Tree<FuluConsolidationRequest_d.ConsolidationRequest>, +N: U32, +h: {OKL_l2_ConsolidationRequest(A, N) == True{} : Bool}) -> {Bool.and(Nat.is_le(U32.to_nat(N), VB.pw(TDM_l2_ConsolidationRequest(A))), U32.is_le(N, 2)) == True{} : Bool}:
  and_r(FD.array__perfect(FuluConsolidationRequest_d.ConsolidationRequest, TDM_l2_ConsolidationRequest(A), A), Bool.and(Nat.is_le(U32.to_nat(N), VB.pw(TDM_l2_ConsolidationRequest(A))), U32.is_le(N, 2)), okl_1_l2_ConsolidationRequest(A, N, h))
def okl_n_l2_ConsolidationRequest(+A: FD.array__Tree<FuluConsolidationRequest_d.ConsolidationRequest>, +N: U32, +h: {OKL_l2_ConsolidationRequest(A, N) == True{} : Bool}) -> {Nat.is_le(U32.to_nat(N), VB.pw(TDM_l2_ConsolidationRequest(A))) == True{} : Bool}:
  and_l(Nat.is_le(U32.to_nat(N), VB.pw(TDM_l2_ConsolidationRequest(A))), U32.is_le(N, 2), okl_2_l2_ConsolidationRequest(A, N, h))
def okl_lim_l2_ConsolidationRequest(+A: FD.array__Tree<FuluConsolidationRequest_d.ConsolidationRequest>, +N: U32, +h: {OKL_l2_ConsolidationRequest(A, N) == True{} : Bool}) -> {U32.is_le(N, 2) == True{} : Bool}:
  and_r(Nat.is_le(U32.to_nat(N), VB.pw(TDM_l2_ConsolidationRequest(A))), U32.is_le(N, 2), okl_2_l2_ConsolidationRequest(A, N, h))

# N <= 2^d as the runtime compares it.
def le_cap_l2_ConsolidationRequest(+A: FD.array__Tree<FuluConsolidationRequest_d.ConsolidationRequest>, +N: U32, +h: {OKL_l2_ConsolidationRequest(A, N) == True{} : Bool}) -> {U32.is_le(N, FD.u32__pow2u(TDM_l2_ConsolidationRequest(A))) == True{} : Bool}:
