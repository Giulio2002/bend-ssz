  %Equal.sym(Nat, U32.to_nat(FD.u32__pow2u(TDM_l2_ConsolidationRequest(A))), VB.pw(TDM_l2_ConsolidationRequest(A)), FD.u32__pow2u_value(TDM_l2_ConsolidationRequest(A), FD.nat__lt_trans(TDM_l2_ConsolidationRequest(A), 31n, 32n, okl_d_l2_ConsolidationRequest(A, N, h), {==}))) : {Nat.is_le(U32.to_nat(N), _) == True{} : Bool}
