# ---- l2_ConsolidationRequest: the list's encoder window ----

def TDM_l2_ConsolidationRequest(t: FD.array__Tree<FuluConsolidationRequest_d.ConsolidationRequest>) -> Nat:
  match t:
    case FD.TLeaf{x}: 0n
    case FD.TNode{l, r}: 1n+TDM_l2_ConsolidationRequest(l)

# The list object Seq{thaw(A), N} and its facts: a perfect tree of depth < 31 holding the N records,
# N within the limit 2.
def THL_l2_ConsolidationRequest(+A: FD.array__Tree<FuluConsolidationRequest_d.ConsolidationRequest>, +N: U32) -> Fulu_list_ConsolidationRequest_2_d.l2_ConsolidationRequest_Seq: Fulu_list_ConsolidationRequest_2_d.l2_ConsolidationRequest_Seq{FD.array__thaw(FuluConsolidationRequest_d.ConsolidationRequest, A), N}
def OKL_l2_ConsolidationRequest(+A: FD.array__Tree<FuluConsolidationRequest_d.ConsolidationRequest>, +N: U32) -> Bool:
  Bool.and(Nat.is_lt(TDM_l2_ConsolidationRequest(A), 31n), Bool.and(FD.array__perfect(FuluConsolidationRequest_d.ConsolidationRequest, TDM_l2_ConsolidationRequest(A), A), Bool.and(Nat.is_le(U32.to_nat(N), VB.pw(TDM_l2_ConsolidationRequest(A))), U32.is_le(N, 2))))
