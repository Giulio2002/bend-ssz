# ---- l2_ConsolidationRequest: the write loop at X = 4 q + r (record j at byte X + 116 j) ----


def AG_l2_ConsolidationRequest(+A: FD.array__Tree<FuluConsolidationRequest_d.ConsolidationRequest>, +i: U32) -> Array<FuluConsolidationRequest_d.ConsolidationRequest> & FuluConsolidationRequest_d.ConsolidationRequest: Array.get(FuluConsolidationRequest_d.ConsolidationRequest, FD.array__thaw(FuluConsolidationRequest_d.ConsolidationRequest, A), i)

# the records j, j + 1, ..., j + k of A written from byte X + 116 j on
def WX_l2_ConsolidationRequest(k: Nat, +j: Nat, +dd: Nat, D: FD.array__Tree<U32>, +q: Nat, +r: Nat, +A: FD.array__Tree<FuluConsolidationRequest_d.ConsolidationRequest>) -> FD.array__Tree<U32>:
  match k:
    case 0n: PXo_ConsolidationRequest(EL_l2_ConsolidationRequest(A, j), dd, D, Nat.add(Nat.mul(j, 29n), q), r)
    case 1n+p: WX_l2_ConsolidationRequest(p, 1n+j, dd, PXo_ConsolidationRequest(EL_l2_ConsolidationRequest(A, j), dd, D, Nat.add(Nat.mul(j, 29n), q), r), q, r, A)

