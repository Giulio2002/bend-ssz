    case False{}: zat3(du, k, e, hk, lesucc(2n, k, hge, eb), Nat.is_eq(k, 3n), {==})

def zat1(+du: U32, +k: Nat, +e: {U32.to_nat(du) == k : Nat}, +hk: {Nat.is_le(k, 23n) == True{} : Bool}, +hge: {Nat.is_le(1n, k) == True{} : Bool}, +b: Bool, +eb: {Nat.is_eq(k, 1n) == b : Bool}) -> {B.zeros(du) == Array.new(U32, k, 0) : Array<U32>}:
  match b:
    case True{}:
      +ek = FD.nat__eq_from_is_eq(k, 1n, eb)
      %Equal.sym(Nat, k, 1n, ek) : {B.zeros(du) == Array.new(U32, _, 0) : Array<U32>}
      %Equal.sym(U32, du, 1, FD.u32__injective(du, 1, Equal.trans(Nat, U32.to_nat(du), k, 1n, e, ek))) :
        {B.zeros(_) == Array.new(U32, 1n, 0) : Array<U32>}
      {==}
    case False{}: zat2(du, k, e, hk, lesucc(1n, k, hge, eb), Nat.is_eq(k, 2n), {==})

def zat0(+du: U32, +k: Nat, +e: {U32.to_nat(du) == k : Nat}, +hk: {Nat.is_le(k, 23n) == True{} : Bool}, +hge: {Nat.is_le(0n, k) == True{} : Bool}, +b: Bool, +eb: {Nat.is_eq(k, 0n) == b : Bool}) -> {B.zeros(du) == Array.new(U32, k, 0) : Array<U32>}:
  match b:
    case True{}:
      +ek = FD.nat__eq_from_is_eq(k, 0n, eb)
      %Equal.sym(Nat, k, 0n, ek) : {B.zeros(du) == Array.new(U32, _, 0) : Array<U32>}
      %Equal.sym(U32, du, 0, FD.u32__injective(du, 0, Equal.trans(Nat, U32.to_nat(du), k, 0n, e, ek))) :
        {B.zeros(_) == Array.new(U32, 0n, 0) : Array<U32>}
      {==}
    case False{}: zat1(du, k, e, hk, lesucc(0n, k, hge, eb), Nat.is_eq(k, 1n), {==})

def zat(+du: U32, +k: Nat, +e: {U32.to_nat(du) == k : Nat}, +hk: {Nat.is_le(k, 23n) == True{} : Bool})
    -> {B.zeros(du) == Array.new(U32, k, 0) : Array<U32>}:
  zat0(du, k, e, hk, FD.nat__zero_le(k), Nat.is_eq(k, 0n), {==})
