  FD.logic__subst(S.Schema, z => {SH.is_ProgressiveContainer(z) == True{} : Bool}, GS.ProgressiveComplexTestStruct(), sv, Equal.sym(S.Schema, sv, GS.ProgressiveComplexTestStruct(), esv), {==})
