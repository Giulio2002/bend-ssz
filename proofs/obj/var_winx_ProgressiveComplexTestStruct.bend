    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hchk: {CHKw(t, x, off, len) == True{} : Bool}) -> {ProgressiveComplexTestStruct_r.ProgressiveComplexTestStruct_read(BF(t, n), off, len) == (BF(t, n), OBJw(d, t, x, off, len)) : B.Buf & ProgressiveComplexTestStruct_d.ProgressiveComplexTestStruct}:
  rd_all(d, t, n, x, off, len, eo, hd, hw, hwN, pf, hchk)
