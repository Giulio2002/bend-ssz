    +e: {Codec.aggregate(PFX0(Codec.concatenate(mm, Codec.parts(r, LCH1()))), None{}) == Some{[S.Variable{UW.WX(t, x, U32.to_nat(len))}]} : Maybe<&2, +List<S.Part>>}, +hP1: {Bool.or(Nat.is_lt(U32.to_nat(len), U32.to_nat(O2(t, x))), Nat.is_le(Nat.sub(U32.to_nat(O2(t, x)), U32.to_nat(O1(t, x))), U32.to_nat(VP.PMAX()))) == True{} : Bool}, +hP6: {Bool.or(Bool.or(Nat.is_lt(U32.to_nat(len), U32.to_nat(O6(t, x))), Nat.is_lt(U32.to_nat(len), U32.to_nat(len))), CH6.PALL(t, Nat.add(U32.to_nat(O6(t, x)), x), U32.sub(len, O6(t, x)))) == True{} : Bool}) -> {CHKw(t, x, off, len) == True{} : Bool}:
  match mm:
    case None{}: Empty.absurd({CHKw(t, x, off, len) == True{} : Bool}, FD.logic__none_some(+List<S.Part>, [S.Variable{UW.WX(t, x, U32.to_nat(len))}], e))
    case Some{+ps}: fp0(d, t, n, x, off, len, eo, hd, hw, hwN, pf, h, ps, hf, em, r, e, hP1, hP6)

