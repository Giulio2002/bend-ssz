# The spec parts of the value: one variable part, the window's bytes.
def specwD(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +hwN: {Nat.is_le(Nat.add(x, U32.to_nat(len)), U32.to_nat(VB.NMAX())) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hchk: {CHKw(t, x, off, len) == True{} : Bool}) -> {Codec.parts(VALw(t, x, len), GS.ProgressiveComplexTestStruct()) == Some{[S.Variable{UW.WX(t, x, U32.to_nat(len))}]} : Maybe<&2, +List<S.Part>>}:
  specg(d, t, n, x, off, len, eo, hd, hw, hwN, pf, hchk, GS.ProgressiveComplexTestStruct(), {==})
def PSX(+xs0: +List<U32>, +y0: +List<U32>, +y1: +List<U32>, +y2: +List<U32>, +y3: +List<U32>, +y4: +List<U32>, +y5: +List<U32>, +y6: +List<U32>) -> +List<S.Part>: [S.Fixed{xs0}, S.Variable{y0}, S.Variable{y1}, S.Variable{y2}, S.Variable{y3}, S.Variable{y4}, S.Variable{y5}, S.Variable{y6}]
def BYX(+xs0: +List<U32>, +y0: +List<U32>, +y1: +List<U32>, +y2: +List<U32>, +y3: +List<U32>, +y4: +List<U32>, +y5: +List<U32>, +y6: +List<U32>) -> +List<U32>: List.append(&2, U32, Layout.fixed_parts(PSX(xs0, y0, y1, y2, y3, y4, y5, y6), Layout.fixed_size(PSX(xs0, y0, y1, y2, y3, y4, y5, y6))), Layout.payloads(PSX(xs0, y0, y1, y2, y3, y4, y5, y6)))
def EVF(+h: S.Value, +s: S.Schema, +y: +List<U32>) -> Data: {Codec.parts(h, s) == Some{[S.Variable{y}]} : Maybe<&2, +List<S.Part>>}
def EXF(+h: S.Value, +s: S.Schema, +y: +List<U32>) -> Data: {Codec.parts(h, s) == Some{[S.Fixed{y}]} : Maybe<&2, +List<S.Part>>}
def LXF(+s: Nat, +xs: +List<U32>) -> Data: {Some{s} == Some{List.length(&2, U32, xs)} : Maybe<&2, Nat>}
def mis(a: Maybe<&2, Nat>, +n: Nat) -> Bool:
  match a:
    case None{}: False{}
    case Some{v}: Nat.is_eq(v, n)
def eqM(+a: Maybe<&2, Nat>, +n: Nat, +e: {mis(a, n) == True{} : Bool}) -> {a == Some{n} : Maybe<&2, Nat>}:
  match a:
    case None{}: Empty.absurd({None{} == Some{n} : Maybe<&2, Nat>}, FD.logic__false_true(e))
    case Some{+v}: Equal.cong(Nat, Maybe<&2, Nat>, z => Some{z}, v, n, FD.nat__eq_from_is_eq(v, n, e))
def fzF0() -> {SS.fixed_size(S.Unsigned{P.U8{}}) == Some{1n} : Maybe<&2, Nat>}: eqM(SS.fixed_size(S.Unsigned{P.U8{}}), 1n, {==})
def LCH8() -> S.Schema: S.End{}
def LCH7() -> S.Schema: S.Chain{S.ProgressiveList{S.ProgressiveContainer{["f_A", "f_B", "f_C"], S.Chain{S.Unsigned{P.U8{}}, S.Chain{S.ListOf{S.Unsigned{P.U16{}}, 123n}, S.Chain{S.ProgressiveBits{}, S.End{}}}}, [True{}, False{}, True{}, False{}, True{}]}}, LCH8()}
def LCH6() -> S.Schema: S.Chain{S.ListOf{S.ProgressiveContainer{["f_A"], S.Chain{S.Unsigned{P.U8{}}, S.End{}}, [True{}]}, 10n}, LCH7()}
def LCH5() -> S.Schema: S.Chain{S.ProgressiveList{S.ProgressiveList{S.Container{["f_A", "f_B", "f_C"], S.Chain{S.Unsigned{P.U16{}}, S.Chain{S.ListOf{S.Unsigned{P.U16{}}, 1024n}, S.Chain{S.Unsigned{P.U8{}}, S.End{}}}}}}}, LCH6()}
def LCH4() -> S.Schema: S.Chain{S.ProgressiveList{S.Container{["f_A", "f_B"], S.Chain{S.Unsigned{P.U16{}}, S.Chain{S.Unsigned{P.U16{}}, S.End{}}}}}, LCH5()}
def LCH3() -> S.Schema: S.Chain{S.ProgressiveList{S.Unsigned{P.U64{}}}, LCH4()}
def LCH2() -> S.Schema: S.Chain{S.ProgressiveBits{}, LCH3()}
def LCH1() -> S.Schema: S.Chain{S.ListOf{S.Unsigned{P.U16{}}, 123n}, LCH2()}
def LCH0() -> S.Schema: S.Chain{S.Unsigned{P.U8{}}, LCH1()}
def PFX0(+m: Maybe<&2, +List<S.Part>>) -> Maybe<&2, +List<S.Part>>: m
def PFX1(+xs0: +List<U32>, +m: Maybe<&2, +List<S.Part>>) -> Maybe<&2, +List<S.Part>>: Codec.concatenate(Some{[S.Fixed{xs0}]}, m)
def PFX2(+xs0: +List<U32>, +y0: +List<U32>, +m: Maybe<&2, +List<S.Part>>) -> Maybe<&2, +List<S.Part>>: Codec.concatenate(Some{[S.Fixed{xs0}]}, Codec.concatenate(Some{[S.Variable{y0}]}, m))
