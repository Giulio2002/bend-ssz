    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +items: S.Value, +e: {Codec.aggregate(PFX0(Codec.parts(items, LCH0())), None{}) == Some{[S.Variable{UW.WX(t, x, U32.to_nat(len))}]} : Maybe<&2, +List<S.Part>>}, +hP1: {Bool.or(Nat.is_lt(U32.to_nat(len), U32.to_nat(O2(t, x))), Nat.is_le(Nat.sub(U32.to_nat(O2(t, x)), U32.to_nat(O1(t, x))), U32.to_nat(VP.PMAX()))) == True{} : Bool}, +hP3: {Bool.or(Nat.is_lt(U32.to_nat(len), U32.to_nat(O4(t, x))), Nat.is_le(Nat.sub(U32.to_nat(O4(t, x)), U32.to_nat(O3(t, x))), U32.to_nat(VP.PMAX()))) == True{} : Bool}, +hP5: {Bool.or(Nat.is_lt(U32.to_nat(len), U32.to_nat(O6(t, x))), Nat.is_le(Nat.sub(U32.to_nat(O6(t, x)), U32.to_nat(O5(t, x))), U32.to_nat(VP.PMAX()))) == True{} : Bool}, +hP7: {Bool.or(Nat.is_lt(U32.to_nat(len), U32.to_nat(len)), Nat.is_le(Nat.sub(U32.to_nat(len), U32.to_nat(O7(t, x))), U32.to_nat(VP.PMAX()))) == True{} : Bool}) -> {CHKw(t, x, off, len) == True{} : Bool}:
  match items:
    case S.BooleanValue{+b0}: Empty.absurd({CHKw(t, x, off, len) == True{} : Bool}, FD.logic__none_some(+List<S.Part>, [S.Variable{UW.WX(t, x, U32.to_nat(len))}], e))
    case S.UnsignedValue{+u0}: Empty.absurd({CHKw(t, x, off, len) == True{} : Bool}, FD.logic__none_some(+List<S.Part>, [S.Variable{UW.WX(t, x, U32.to_nat(len))}], e))
    case S.BytesValue{+xs0}: Empty.absurd({CHKw(t, x, off, len) == True{} : Bool}, FD.logic__none_some(+List<S.Part>, [S.Variable{UW.WX(t, x, U32.to_nat(len))}], e))
    case S.BitsValue{+bs0}: Empty.absurd({CHKw(t, x, off, len) == True{} : Bool}, FD.logic__none_some(+List<S.Part>, [S.Variable{UW.WX(t, x, U32.to_nat(len))}], e))
    case S.Sequence{+it0}: Empty.absurd({CHKw(t, x, off, len) == True{} : Bool}, FD.logic__none_some(+List<S.Part>, [S.Variable{UW.WX(t, x, U32.to_nat(len))}], e))
    case S.Items{+h, +r}: fm0(d, t, n, x, off, len, eo, hd, hw, hwN, pf, h, Codec.parts(h, S.BitVector{256n}), FD.logic__subst(Maybe<&2, Nat>, z => DF.single_result(z, Codec.parts(h, S.BitVector{256n})), SS.fixed_size(S.BitVector{256n}), Some{32n}, fzF0(), DS.facts(h, S.BitVector{256n}, {==})), {==}, r, e, hP1, hP3, hP5, hP7)
    case S.EmptyItems{}: Empty.absurd({CHKw(t, x, off, len) == True{} : Bool}, FD.logic__none_some(+List<S.Part>, [S.Variable{UW.WX(t, x, U32.to_nat(len))}], e))
    case S.Selected{+sel0, +sv0}: Empty.absurd({CHKw(t, x, off, len) == True{} : Bool}, FD.logic__none_some(+List<S.Part>, [S.Variable{UW.WX(t, x, U32.to_nat(len))}], e))
    case S.NullValue{}: Empty.absurd({CHKw(t, x, off, len) == True{} : Bool}, FD.logic__none_some(+List<S.Part>, [S.Variable{UW.WX(t, x, U32.to_nat(len))}], e))

# Every value whose parts are the window's bytes passes the checks.
def invwD(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +hwN: {Nat.is_le(Nat.add(x, U32.to_nat(len)), U32.to_nat(VB.NMAX())) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +v: S.Value, +e: {Codec.parts(v, GS.ProgressiveBitsStruct()) == Some{[S.Variable{UW.WX(t, x, U32.to_nat(len))}]} : Maybe<&2, +List<S.Part>>}, +hP1: {Bool.or(Nat.is_lt(U32.to_nat(len), U32.to_nat(O2(t, x))), Nat.is_le(Nat.sub(U32.to_nat(O2(t, x)), U32.to_nat(O1(t, x))), U32.to_nat(VP.PMAX()))) == True{} : Bool}, +hP3: {Bool.or(Nat.is_lt(U32.to_nat(len), U32.to_nat(O4(t, x))), Nat.is_le(Nat.sub(U32.to_nat(O4(t, x)), U32.to_nat(O3(t, x))), U32.to_nat(VP.PMAX()))) == True{} : Bool}, +hP5: {Bool.or(Nat.is_lt(U32.to_nat(len), U32.to_nat(O6(t, x))), Nat.is_le(Nat.sub(U32.to_nat(O6(t, x)), U32.to_nat(O5(t, x))), U32.to_nat(VP.PMAX()))) == True{} : Bool}, +hP7: {Bool.or(Nat.is_lt(U32.to_nat(len), U32.to_nat(len)), Nat.is_le(Nat.sub(U32.to_nat(len), U32.to_nat(O7(t, x))), U32.to_nat(VP.PMAX()))) == True{} : Bool}) -> {CHKw(t, x, off, len) == True{} : Bool}:
  match v:
    case S.BooleanValue{+b0}: Empty.absurd({CHKw(t, x, off, len) == True{} : Bool}, FD.logic__none_some(+List<S.Part>, [S.Variable{UW.WX(t, x, U32.to_nat(len))}], e))
    case S.UnsignedValue{+u0}: Empty.absurd({CHKw(t, x, off, len) == True{} : Bool}, FD.logic__none_some(+List<S.Part>, [S.Variable{UW.WX(t, x, U32.to_nat(len))}], e))
    case S.BytesValue{+xs0}: Empty.absurd({CHKw(t, x, off, len) == True{} : Bool}, FD.logic__none_some(+List<S.Part>, [S.Variable{UW.WX(t, x, U32.to_nat(len))}], e))
    case S.BitsValue{+bs0}: Empty.absurd({CHKw(t, x, off, len) == True{} : Bool}, FD.logic__none_some(+List<S.Part>, [S.Variable{UW.WX(t, x, U32.to_nat(len))}], e))
    case S.Sequence{+items}: st0(d, t, n, x, off, len, eo, hd, hw, hwN, pf, items, e, hP1, hP3, hP5, hP7)
    case S.Items{+hd0, +tl0}: Empty.absurd({CHKw(t, x, off, len) == True{} : Bool}, FD.logic__none_some(+List<S.Part>, [S.Variable{UW.WX(t, x, U32.to_nat(len))}], e))
    case S.EmptyItems{}: Empty.absurd({CHKw(t, x, off, len) == True{} : Bool}, FD.logic__none_some(+List<S.Part>, [S.Variable{UW.WX(t, x, U32.to_nat(len))}], e))
    case S.Selected{+sel0, +sv0}: Empty.absurd({CHKw(t, x, off, len) == True{} : Bool}, FD.logic__none_some(+List<S.Part>, [S.Variable{UW.WX(t, x, U32.to_nat(len))}], e))
    case S.NullValue{}: Empty.absurd({CHKw(t, x, off, len) == True{} : Bool}, FD.logic__none_some(+List<S.Part>, [S.Variable{UW.WX(t, x, U32.to_nat(len))}], e))

