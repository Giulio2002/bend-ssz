def LCH2() -> S.Schema: S.Chain{S.ProgressiveBits{}, LCH3()}
def LCH1() -> S.Schema: S.Chain{S.BitList{256n}, LCH2()}
def LCH0() -> S.Schema: S.Chain{S.BitVector{256n}, LCH1()}
