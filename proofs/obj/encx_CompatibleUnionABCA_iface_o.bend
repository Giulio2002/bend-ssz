    +hz: {VS.bt(Nat.add(List.length(&2, U32, OB.ENC2(x)), WD.PADB(r, List.length(&2, U32, OB.ENC2(x)))), VS.bdr(Nat.add(A.quad(q), r), UA.BYT(D))) == UW.ZB(Nat.add(List.length(&2, U32, OB.ENC2(x)), WD.PADB(r, List.length(&2, U32, OB.ENC2(x))))) : +List<U32>},
    +hok: {OKW2(x) == True{} : Bool})
    -> DK.P2(OB.RT2(x, dd, D, X, q, r), OB.BY2(x, dd, D, q, r)):
  +E = List.length(&2, U32, EA_ProgressiveVarTestStruct.ENC(x))
  +hok0 = OB.and_l(EA_ProgressiveVarTestStruct.OKW(x), Nat.is_lt(1n+List.length(&2, U32, EA_ProgressiveVarTestStruct.ENC(x)), VB.pw(31n)), hok)
  +rts = VU.sel_rtW(dd, D, X, q, r, 3, E, e, hr, hd, hl, pf)
  +bys = VU.sel_byW(dd, D, X, q, r, 3, E, WD.PADB(r, 1n+E), e, hr, hd, hl, pf, hz)
  +pfs = VU.sel_pf(dd, D, q, r, 3, pf)
  +hX = VRX.xstart(q, r, 1n+E, dd, D, pf, hl)
  +ea = VU.arm_eW(dd, X, q, r, E, e, hr, hd, hl, hl32)
