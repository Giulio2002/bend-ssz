def szkO3(+x: U32, +hok: {OKW3(x) == True{} : Bool}) -> {U32.to_nat(OB.SZ3(x)) == List.length(&2, U32, OB.ENC3(x)) : Nat}: {==}
def specO3(+x: U32, +hok: {OKW3(x) == True{} : Bool}) -> {Codec.parts(OB.VAL3(x), Spec.CompatibleUnionABCA()) == Some{[S.Variable{OB.ENC3(x)}]} : Maybe<&2, +List<S.Part>>}:
  OB.spec3(x, hok)
def sizeO3(+x: U32, +hok: {OKW3(x) == True{} : Bool}) -> {CompatibleUnionABCA_e.CompatibleUnionABCA_size(OB.TH3(x)) == (OB.TH3(x), OB.SZ3(x)) : CompatibleUnionABCA_d.CompatibleUnionABCA & U32}: {==}
def validO3(+x: U32, +hok: {OKW3(x) == True{} : Bool}) -> {CompatibleUnionABCA_e.CompatibleUnionABCA_valid(OB.TH3(x)) == (OB.TH3(x), True{}) : CompatibleUnionABCA_d.CompatibleUnionABCA & Bool}:
  OB.valid3(x, hok)

# ---- the union's OKW and its laws on it ----
def OKW(m: OB.MW) -> Bool:
  match m:
    case OB.MW0{+x}: OKW0(x)
    case OB.MW1{+x}: OKW1(x)
    case OB.MW2{+x}: OKW2(x)
    case OB.MW3{+x}: OKW3(x)

law putxO:
  for +m: OB.MW
  for +dd: Nat
  for +D: FD.array__Tree<U32>
  for +X: U32
  for +q: Nat
  for +r: Nat
  for +e: {U32.to_nat(X) == Nat.add(A.quad(q), r) : Nat}
  for +hr: {Nat.is_lt(r, 4n) == True{} : Bool}
  for +hd: {Nat.is_lt(dd, 31n) == True{} : Bool}
  for +pf: {FD.array__perfect(U32, dd, D) == True{} : Bool}
  for +hl: {Nat.is_le(Nat.add(q, WD.NWN(Nat.add(r, List.length(&2, U32, OB.ENC(m))))), VB.pw(dd)) == True{} : Bool}
  for +hl32: {Nat.is_lt(Nat.add(A.quad(q), Nat.add(r, List.length(&2, U32, OB.ENC(m)))), FD.spec_common__pow2(32n)) == True{} : Bool}
  for +hz: {VS.bt(Nat.add(List.length(&2, U32, OB.ENC(m)), OB.PADB(r, m)), VS.bdr(Nat.add(A.quad(q), r), UA.BYT(D))) == UW.ZB(Nat.add(List.length(&2, U32, OB.ENC(m)), OB.PADB(r, m))) : +List<U32>}
  for +hok: {OKW(m) == True{} : Bool}
  {CompatibleUnionABCA_e.CompatibleUnionABCA_putk(FD.array__thaw(U32, D), X, OB.TH(m)) == (FD.array__thaw(U32, OB.PUTX(m, dd, D, q, r)), (OB.TH(m), OB.SZ(m))) : Array<U32> & (CompatibleUnionABCA_d.CompatibleUnionABCA & U32)}
def putxO(m, dd, D, X, q, r, e, hr, hd, pf, hl, hl32, hz, hok):
  match m:
    case OB.MW0{+x}: OB.PA(OB.RT0(x, dd, D, X, q, r), OB.BY0(x, dd, D, q, r), goO0(x, dd, D, X, q, r, e, hr, hd, pf, hl, hl32, hz, hok))
    case OB.MW1{+x}: OB.PA(OB.RT1(x, dd, D, X, q, r), OB.BY1(x, dd, D, q, r), goO1(x, dd, D, X, q, r, e, hr, hd, pf, hl, hl32, hz, hok))
    case OB.MW2{+x}: OB.PA(OB.RT2(x, dd, D, X, q, r), OB.BY2(x, dd, D, q, r), goO2(x, dd, D, X, q, r, e, hr, hd, pf, hl, hl32, hz, hok))
    case OB.MW3{+x}: OB.PA(OB.RT3(x, dd, D, X, q, r), OB.BY3(x, dd, D, q, r), goO3(x, dd, D, X, q, r, e, hr, hd, pf, hl, hl32, hz, hok))

law putx_bytesO:
  for +m: OB.MW
  for +dd: Nat
  for +D: FD.array__Tree<U32>
  for +X: U32
  for +q: Nat
  for +r: Nat
  for +e: {U32.to_nat(X) == Nat.add(A.quad(q), r) : Nat}
  for +hr: {Nat.is_lt(r, 4n) == True{} : Bool}
  for +hd: {Nat.is_lt(dd, 31n) == True{} : Bool}
  for +pf: {FD.array__perfect(U32, dd, D) == True{} : Bool}
  for +hl: {Nat.is_le(Nat.add(q, WD.NWN(Nat.add(r, List.length(&2, U32, OB.ENC(m))))), VB.pw(dd)) == True{} : Bool}
  for +hl32: {Nat.is_lt(Nat.add(A.quad(q), Nat.add(r, List.length(&2, U32, OB.ENC(m)))), FD.spec_common__pow2(32n)) == True{} : Bool}
  for +hz: {VS.bt(Nat.add(List.length(&2, U32, OB.ENC(m)), OB.PADB(r, m)), VS.bdr(Nat.add(A.quad(q), r), UA.BYT(D))) == UW.ZB(Nat.add(List.length(&2, U32, OB.ENC(m)), OB.PADB(r, m))) : +List<U32>}
  for +hok: {OKW(m) == True{} : Bool}
  {UA.BYT(OB.PUTX(m, dd, D, q, r)) == UW.SPL(UA.BYT(D), Nat.add(A.quad(q), r), List.append(&2, U32, OB.ENC(m), UW.ZB(OB.PADB(r, m)))) : +List<U32>}
def putx_bytesO(m, dd, D, X, q, r, e, hr, hd, pf, hl, hl32, hz, hok):
  match m:
    case OB.MW0{+x}: OB.PB(OB.RT0(x, dd, D, X, q, r), OB.BY0(x, dd, D, q, r), goO0(x, dd, D, X, q, r, e, hr, hd, pf, hl, hl32, hz, hok))
    case OB.MW1{+x}: OB.PB(OB.RT1(x, dd, D, X, q, r), OB.BY1(x, dd, D, q, r), goO1(x, dd, D, X, q, r, e, hr, hd, pf, hl, hl32, hz, hok))
    case OB.MW2{+x}: OB.PB(OB.RT2(x, dd, D, X, q, r), OB.BY2(x, dd, D, q, r), goO2(x, dd, D, X, q, r, e, hr, hd, pf, hl, hl32, hz, hok))
    case OB.MW3{+x}: OB.PB(OB.RT3(x, dd, D, X, q, r), OB.BY3(x, dd, D, q, r), goO3(x, dd, D, X, q, r, e, hr, hd, pf, hl, hl32, hz, hok))

law szxO:
  for +m: OB.MW
  for +hok: {OKW(m) == True{} : Bool}
  {U32.to_nat(OB.SZ(m)) == List.length(&2, U32, OB.ENC(m)) : Nat}
def szxO(m, hok):
