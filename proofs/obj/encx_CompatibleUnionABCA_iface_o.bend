  +bya = EA_ProgressiveVarTestStruct.putx_bytesO(x, dd, VU.DS(dd, D, q, r, 3), U32.add(X, 1), VU.AQ(q, r), VU.AR(r), ea, VU.ar_lt(r), hd, pfs, hla, hl32a, hza, hok0)
