        B0.PB(B0.RTQ(j, U32.add(i, 1), t, 1n+s, O.padd(cur, B0.NE(x)), dd, D2, X, q, r), DK.P2(B0.BYQ(j, t, 1n+s, n, O.padd(cur, B0.NE(x)), dd, D2, X, q, r, pad, B0, LR), B0.PFQ(j, t, 1n+s, O.padd(cur, B0.NE(x)), dd, D2, X, q, r)), ih))

# ==== the list's encoder window ===================================================================

def OKL(+t: F.array__Tree<B0.MB<EM.MW>>, +N: U32) -> Bool:
  Bool.and(Nat.is_lt(B0.TDM(t), 31n), Bool.and(F.array__perfect(B0.MB<EM.MW>, B0.TDM(t), t), Bool.and(Nat.is_le(U32.to_nat(N), VB.pw(B0.TDM(t))),
    Bool.and(True{}, EOKS(U32.to_nat(N), B0.SL(t), 0n)))))
def okl_d(+t: F.array__Tree<B0.MB<EM.MW>>, +N: U32, +h: {OKL(t, N) == True{} : Bool}) -> {Nat.is_lt(B0.TDM(t), 31n) == True{} : Bool}:
  B0.and_l(Nat.is_lt(B0.TDM(t), 31n), Bool.and(F.array__perfect(B0.MB<EM.MW>, B0.TDM(t), t), Bool.and(Nat.is_le(U32.to_nat(N), VB.pw(B0.TDM(t))), Bool.and(True{}, EOKS(U32.to_nat(N), B0.SL(t), 0n)))), h)
def okl_1(+t: F.array__Tree<B0.MB<EM.MW>>, +N: U32, +h: {OKL(t, N) == True{} : Bool})
    -> {Bool.and(F.array__perfect(B0.MB<EM.MW>, B0.TDM(t), t), Bool.and(Nat.is_le(U32.to_nat(N), VB.pw(B0.TDM(t))), Bool.and(True{}, EOKS(U32.to_nat(N), B0.SL(t), 0n)))) == True{} : Bool}:
  B0.and_r(Nat.is_lt(B0.TDM(t), 31n), Bool.and(F.array__perfect(B0.MB<EM.MW>, B0.TDM(t), t), Bool.and(Nat.is_le(U32.to_nat(N), VB.pw(B0.TDM(t))), Bool.and(True{}, EOKS(U32.to_nat(N), B0.SL(t), 0n)))), h)
def okl_pf(+t: F.array__Tree<B0.MB<EM.MW>>, +N: U32, +h: {OKL(t, N) == True{} : Bool}) -> {F.array__perfect(B0.MB<EM.MW>, B0.TDM(t), t) == True{} : Bool}:
  B0.and_l(F.array__perfect(B0.MB<EM.MW>, B0.TDM(t), t), Bool.and(Nat.is_le(U32.to_nat(N), VB.pw(B0.TDM(t))), Bool.and(True{}, EOKS(U32.to_nat(N), B0.SL(t), 0n))), okl_1(t, N, h))
def okl_2(+t: F.array__Tree<B0.MB<EM.MW>>, +N: U32, +h: {OKL(t, N) == True{} : Bool})
    -> {Bool.and(Nat.is_le(U32.to_nat(N), VB.pw(B0.TDM(t))), Bool.and(True{}, EOKS(U32.to_nat(N), B0.SL(t), 0n))) == True{} : Bool}:
  B0.and_r(F.array__perfect(B0.MB<EM.MW>, B0.TDM(t), t), Bool.and(Nat.is_le(U32.to_nat(N), VB.pw(B0.TDM(t))), Bool.and(True{}, EOKS(U32.to_nat(N), B0.SL(t), 0n))), okl_1(t, N, h))
def okl_n(+t: F.array__Tree<B0.MB<EM.MW>>, +N: U32, +h: {OKL(t, N) == True{} : Bool}) -> {Nat.is_le(U32.to_nat(N), VB.pw(B0.TDM(t))) == True{} : Bool}:
  B0.and_l(Nat.is_le(U32.to_nat(N), VB.pw(B0.TDM(t))), Bool.and(True{}, EOKS(U32.to_nat(N), B0.SL(t), 0n)), okl_2(t, N, h))
def okl_3(+t: F.array__Tree<B0.MB<EM.MW>>, +N: U32, +h: {OKL(t, N) == True{} : Bool}) -> {Bool.and(True{}, EOKS(U32.to_nat(N), B0.SL(t), 0n)) == True{} : Bool}:
  B0.and_r(Nat.is_le(U32.to_nat(N), VB.pw(B0.TDM(t))), Bool.and(True{}, EOKS(U32.to_nat(N), B0.SL(t), 0n)), okl_2(t, N, h))
def okl_lim(+t: F.array__Tree<B0.MB<EM.MW>>, +N: U32, +h: {OKL(t, N) == True{} : Bool}) -> {True{} == True{} : Bool}:
  B0.and_l(True{}, EOKS(U32.to_nat(N), B0.SL(t), 0n), okl_3(t, N, h))
def okl_e(+t: F.array__Tree<B0.MB<EM.MW>>, +N: U32, +h: {OKL(t, N) == True{} : Bool}) -> {EOKS(U32.to_nat(N), B0.SL(t), 0n) == True{} : Bool}:
  B0.and_r(True{}, EOKS(U32.to_nat(N), B0.SL(t), 0n), okl_3(t, N, h))

# N <= 2^d as the runtime compares it.
def le_cap(+t: F.array__Tree<B0.MB<EM.MW>>, +N: U32, +h: {OKL(t, N) == True{} : Bool}) -> {U32.is_le(N, F.u32__pow2u(B0.TDM(t))) == True{} : Bool}:
  %Equal.sym(Bool, U32.is_le(N, F.u32__pow2u(B0.TDM(t))), Nat.is_le(U32.to_nat(N), U32.to_nat(F.u32__pow2u(B0.TDM(t)))), VU.le_u32(N, F.u32__pow2u(B0.TDM(t)))) : {_ == True{} : Bool}
  %Equal.sym(Nat, U32.to_nat(F.u32__pow2u(B0.TDM(t))), VB.pw(B0.TDM(t)), F.u32__pow2u_value(B0.TDM(t), F.nat__lt_trans(B0.TDM(t), 31n, 32n, okl_d(t, N, h), {==}))) : {Nat.is_le(U32.to_nat(N), _) == True{} : Bool}
  okl_n(t, N, h)

# The runtime's validity check of the list.
def valid_l(+t: F.array__Tree<B0.MB<EM.MW>>, +N: U32, +h: {OKL(t, N) == True{} : Bool}) -> {proglist_VarTestStruct_e.pl_VarTestStruct_valid(B0.THL(t, N)) == (B0.THL(t, N), True{}) : proglist_VarTestStruct_d.pl_VarTestStruct_Seq & Bool}:
  +d = B0.TDM(t)
  %Equal.sym(Array<O.Boxed<VarTestStruct_d.VarTestStruct>> & U32, Array.size(O.Boxed<VarTestStruct_d.VarTestStruct>, B0.AR(t)), (B0.AR(t), F.u32__pow2u(d)), B0.amsize_pl_VarTestStruct(d, t, okl_pf(t, N, h))) :
    {proglist_VarTestStruct_e.pl_VarTestStruct_va_cap(True{}, N, _) == (B0.THL(t, N), True{}) : proglist_VarTestStruct_d.pl_VarTestStruct_Seq & Bool}
  %Equal.sym(Bool, U32.is_le(N, F.u32__pow2u(d)), True{}, le_cap(t, N, h)) :
    {proglist_VarTestStruct_e.pl_VarTestStruct_va_go(Bool.and(True{}, _), N, B0.AR(t)) == (B0.THL(t, N), True{}) : proglist_VarTestStruct_d.pl_VarTestStruct_Seq & Bool}
  %Equal.sym(Array<O.Boxed<VarTestStruct_d.VarTestStruct>> & Bool, proglist_VarTestStruct_e.pl_VarTestStruct_va(U32.to_nat(N), 0, (B0.AR(t), True{})), (B0.AR(t), True{}),
      va_go(U32.to_nat(N), d, t, 0, 0n, U32.to_nat(N), {==}, {==}, okl_pf(t, N, h), okl_d(t, N, h), okl_n(t, N, h), okl_e(t, N, h))) :
    {proglist_VarTestStruct_e.pl_VarTestStruct_va_fin(N, True{}, _) == (B0.THL(t, N), True{}) : proglist_VarTestStruct_d.pl_VarTestStruct_Seq & Bool}
  {==}

# The list's bytes: the offsets of its N elements, then their bytes.
law bt_all:
  for +xs: +List<U32>
  {VS.bt(VE2.LEN(xs), xs) == xs : +List<U32>}
def bt_all(xs):
  match xs:
    case Nil{}: {==}
    case Con{+h, +r}: Equal.cong(+List<U32>, +List<U32>, z => Con{h, z}, VS.bt(VE2.LEN(r), r), r, bt_all(r))

# The model of the writer and its returned size.
def e_end(+q: Nat, +r: Nat, +L: Nat)
    -> {Nat.add(Nat.add(A.quad(q), r), Nat.add(L, WD.PADB(r, L))) == A.quad(Nat.add(q, WD.NWN(Nat.add(r, L)))) : Nat}:
  +Pd = WD.PADB(r, L)
  Equal.trans(Nat, Nat.add(Nat.add(A.quad(q), r), Nat.add(L, Pd)), Nat.add(A.quad(q), Nat.add(Nat.add(r, L), Pd)), A.quad(Nat.add(q, WD.NWN(Nat.add(r, L)))),
    Equal.trans(Nat, Nat.add(Nat.add(A.quad(q), r), Nat.add(L, Pd)), Nat.add(A.quad(q), Nat.add(r, Nat.add(L, Pd))), Nat.add(A.quad(q), Nat.add(Nat.add(r, L), Pd)),
      F.nat__add_assoc(A.quad(q), r, Nat.add(L, Pd)),
