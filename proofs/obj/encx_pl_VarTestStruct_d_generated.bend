    +hl: {Nat.is_le(Nat.add(q, WD.NWN(Nat.add(r, VE2.LEN(B0.ENCL(t, N))))), VB.pw(dd)) == True{} : Bool},
    +hz: {VS.bt(Nat.add(VE2.LEN(B0.ENCL(t, N)), WD.PADB(r, VE2.LEN(B0.ENCL(t, N)))), VS.bdr(Nat.add(A.quad(q), r), UA.BYT(D))) == UW.ZB(Nat.add(VE2.LEN(B0.ENCL(t, N)), WD.PADB(r, VE2.LEN(B0.ENCL(t, N))))) : +List<U32>})
    -> DK.P2(B0.RTX(t, N, dd, D, X, q, r), B0.BYX(t, N, dd, D, q, r)):
  goW(t, N, h, dd, D, X, q, r, e, hr, F.nat__lt_trans(dd, 29n, 31n, hd, {==}), pf, hl, VRX.hs31w(q, r, VE2.LEN(B0.ENCL(t, N)), dd, hd, hl), VRX.hl32w(q, r, VE2.LEN(B0.ENCL(t, N)), dd, hd, hl), hz)

# ---- the interface's laws ----------------------------------------------------------------------

law putxW:
  for +m: B0.MW
  for +dd: Nat
  for +D: F.array__Tree<U32>
  for +X: U32
  for +q: Nat
  for +r: Nat
  for +e: {U32.to_nat(X) == Nat.add(A.quad(q), r) : Nat}
  for +hr: {Nat.is_lt(r, 4n) == True{} : Bool}
  for +hd: {Nat.is_lt(dd, 31n) == True{} : Bool}
  for +pf: {F.array__perfect(U32, dd, D) == True{} : Bool}
  for +hl: {Nat.is_le(Nat.add(q, WD.NWN(Nat.add(r, List.length(&2, U32, B0.ENC(m))))), VB.pw(dd)) == True{} : Bool}
  for +hs31: {Nat.is_le(List.length(&2, U32, B0.ENC(m)), U32.to_nat(VB.NMAX())) == True{} : Bool}
  for +hl32: {Nat.is_lt(Nat.add(A.quad(q), Nat.add(r, List.length(&2, U32, B0.ENC(m)))), F.spec_common__pow2(32n)) == True{} : Bool}
  for +hz: {VS.bt(Nat.add(List.length(&2, U32, B0.ENC(m)), B0.PADB(r, m)), VS.bdr(Nat.add(A.quad(q), r), UA.BYT(D))) == UW.ZB(Nat.add(List.length(&2, U32, B0.ENC(m)), B0.PADB(r, m))) : +List<U32>}
  for +hok: {OK(m) == True{} : Bool}
  {proglist_VarTestStruct_e.pl_VarTestStruct_putk(F.array__thaw(U32, D), X, B0.TH(m)) == (F.array__thaw(U32, B0.PUTX(m, dd, D, q, r)), (B0.TH(m), B0.SZ(m))) : Array<U32> & (proglist_VarTestStruct_d.pl_VarTestStruct_Seq & U32)}
def putxW(m, dd, D, X, q, r, e, hr, hd, pf, hl, hs31, hl32, hz, hok):
  match m:
    case B0.MW{+t, +N}: B0.PA(B0.RTX(t, N, dd, D, X, q, r), B0.BYX(t, N, dd, D, q, r), goW(t, N, hok, dd, D, X, q, r, e, hr, hd, pf, hl, hs31, hl32, hz))

law putx:
  for +m: B0.MW
  for +dd: Nat
  for +D: F.array__Tree<U32>
  for +X: U32
  for +q: Nat
  for +r: Nat
  for +e: {U32.to_nat(X) == Nat.add(A.quad(q), r) : Nat}
  for +hr: {Nat.is_lt(r, 4n) == True{} : Bool}
  for +hd: {Nat.is_lt(dd, 29n) == True{} : Bool}
  for +pf: {F.array__perfect(U32, dd, D) == True{} : Bool}
  for +hl: {Nat.is_le(Nat.add(q, WD.NWN(Nat.add(r, List.length(&2, U32, B0.ENC(m))))), VB.pw(dd)) == True{} : Bool}
  for +hz: {VS.bt(Nat.add(List.length(&2, U32, B0.ENC(m)), B0.PADB(r, m)), VS.bdr(Nat.add(A.quad(q), r), UA.BYT(D))) == UW.ZB(Nat.add(List.length(&2, U32, B0.ENC(m)), B0.PADB(r, m))) : +List<U32>}
  for +hok: {OK(m) == True{} : Bool}
  {proglist_VarTestStruct_e.pl_VarTestStruct_putk(F.array__thaw(U32, D), X, B0.TH(m)) == (F.array__thaw(U32, B0.PUTX(m, dd, D, q, r)), (B0.TH(m), B0.SZ(m))) : Array<U32> & (proglist_VarTestStruct_d.pl_VarTestStruct_Seq & U32)}
def putx(m, dd, D, X, q, r, e, hr, hd, pf, hl, hz, hok):
