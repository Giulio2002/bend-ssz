  +g2 = B0.PB(B0.RTL(t, N, dd, D, B0.XQ(q, r), q, r), DK.P2(B0.BYLb(b, t, N, dd, D, B0.XQ(q, r), q, r), B0.PFLb(b, t, N, dd, D, B0.XQ(q, r), q, r)), g)
