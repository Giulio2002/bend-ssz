def f_off(+i: U32, +s: Nat, +j: Nat, +n: Nat, +W: List<&2, B0.MB<EM.MW>>, +q: Nat, +r: Nat, +X: U32, +dd: Nat, +pad: Nat, +LR: Nat,
    +ek: {Nat.add(s, 1n+j) == n : Nat}, +e: {U32.to_nat(X) == Nat.add(A.quad(q), r) : Nat}, +hd: {Nat.is_lt(dd, 29n) == True{} : Bool},
    +hLR: {Nat.add(B0.LLN(n, W), pad) == LR : Nat}, +hroom: {Nat.is_le(Nat.add(Nat.add(A.quad(q), r), LR), A.quad(VB.pw(dd))) == True{} : Bool}, +k: Nat, +ek30: {k == 30n : Nat}, +ei: {U32.to_nat(i) == s : Nat})
    -> DK.P2(B0.TEP(X, i, s, q, r), DK.P2(B0.THLO(s, q, r, dd), B0.TH4(s, LR))):
  +X0 = Nat.add(A.quad(q), r)
  +L = B0.LLN(n, W)
  +hs = B0.hs_of(s, j, n, ek)
  +hq30 = B0.qk(dd, k, ek30, hd)
  +hLRr = F.nat__le_trans(Nat.add(X0, LR), A.quad(VB.pw(dd)), VB.pw(k), hroom, hq30)
  +hLL = F.logic__subst(Nat, z => {Nat.is_le(L, z) == True{} : Bool}, Nat.add(L, pad), LR, hLR, Order.below_sum(L, pad))
  +hqn = F.nat__le_trans(A.quad(n), L, LR, Order.below_sum(A.quad(n), B0.BL(n, W, 0n)), hLL)
  +h4 = F.logic__subst(Nat, z => {Nat.is_le(z, LR) == True{} : Bool}, A.quad(1n+s), Nat.add(A.quad(s), 4n), F.nat__add_comm(4n, A.quad(s)),
    F.nat__le_trans(A.quad(1n+s), A.quad(n), LR, UW.quad_le(1n+s, n, F.nat__lt_succ_le_succ(s, n, hs)), hqn))
  +hbo = F.nat__le_trans(Nat.add(X0, A.quad(s)), Nat.add(X0, LR), VB.pw(1n+k),
    Order.add_left(X0, A.quad(s), LR, F.nat__le_trans(A.quad(s), Nat.add(A.quad(s), 4n), LR, Order.below_sum(A.quad(s), 4n), h4)), B0.lsuc(Nat.add(X0, LR), k, hLRr))
  +ep = B0.ep_off(X, i, q, r, s, e, ei, B0.t31(Nat.add(X0, A.quad(s)), k, ek30, hbo))
  +eo4 = Equal.trans(Nat, Nat.add(A.quad(Nat.add(s, q)), Nat.add(r, 4n)), Nat.add(Nat.add(A.quad(Nat.add(s, q)), r), 4n), Nat.add(X0, Nat.add(A.quad(s), 4n)),
    Equal.sym(Nat, Nat.add(Nat.add(A.quad(Nat.add(s, q)), r), 4n), Nat.add(A.quad(Nat.add(s, q)), Nat.add(r, 4n)), F.nat__add_assoc(A.quad(Nat.add(s, q)), r, 4n)),
    Equal.trans(Nat, Nat.add(Nat.add(A.quad(Nat.add(s, q)), r), 4n), Nat.add(Nat.add(X0, A.quad(s)), 4n), Nat.add(X0, Nat.add(A.quad(s), 4n)),
      Equal.cong(Nat, Nat, z => Nat.add(z, 4n), Nat.add(A.quad(Nat.add(s, q)), r), Nat.add(X0, A.quad(s)), UW.pos_eq(s, q, r)),
      F.nat__add_assoc(X0, A.quad(s), 4n)))
  +hlo = F.logic__subst(Nat, z => {Nat.is_le(z, VB.pw(dd)) == True{} : Bool}, WD.NWN(Nat.add(A.quad(Nat.add(s, q)), Nat.add(r, 4n))), Nat.add(Nat.add(s, q), WD.NWN(Nat.add(r, 4n))),
    nwn_quad(Nat.add(s, q), Nat.add(r, 4n)),
    B0.nwn_le(Nat.add(A.quad(Nat.add(s, q)), Nat.add(r, 4n)), VB.pw(dd),
      F.logic__subst(Nat, z => {Nat.is_le(z, A.quad(VB.pw(dd))) == True{} : Bool}, Nat.add(X0, Nat.add(A.quad(s), 4n)), Nat.add(A.quad(Nat.add(s, q)), Nat.add(r, 4n)),
        Equal.sym(Nat, Nat.add(A.quad(Nat.add(s, q)), Nat.add(r, 4n)), Nat.add(X0, Nat.add(A.quad(s), 4n)), eo4),
        F.nat__le_trans(Nat.add(X0, Nat.add(A.quad(s), 4n)), Nat.add(X0, LR), A.quad(VB.pw(dd)), Order.add_left(X0, Nat.add(A.quad(s), 4n), LR, h4), hroom))))
  (ep, (hlo, h4))

# The region's length after the offset write.
def f_lr1W(+s: Nat, +j: Nat, +n: Nat, +W: List<&2, B0.MB<EM.MW>>, +q: Nat, +r: Nat, +X: U32, +dd: Nat, +pad: Nat, +LR: Nat,
    +ek: {Nat.add(s, 1n+j) == n : Nat}, +e: {U32.to_nat(X) == Nat.add(A.quad(q), r) : Nat}, +hd: {Nat.is_lt(dd, 31n) == True{} : Bool},
    +hLR: {Nat.add(B0.LLN(n, W), pad) == LR : Nat}, +hroom: {Nat.is_le(Nat.add(Nat.add(A.quad(q), r), LR), A.quad(VB.pw(dd))) == True{} : Bool}, +k: Nat, +ek30: {k == 30n : Nat}, +h4: {Nat.is_le(Nat.add(A.quad(s), 4n), LR) == True{} : Bool})
    -> {VE2.LEN(VE2.EJ(B0.YS(s, W, 0n), B0.YE(B0.xat_pl_VarTestStruct(W, s)), B0.YS(j, W, 1n+s), A.quad(n), Nat.add(B0.BL(1n+j, W, s), pad))) == LR : Nat}:
  +y = B0.YE(B0.xat_pl_VarTestStruct(W, s))
  +L = B0.LLN(n, W)
  +hLR0 = Equal.trans(Nat, VE2.LEN(B0.EIS(s, 1n+j, W, n, pad)), Nat.add(L, pad), LR, len_eis(s, 1n+j, W, n, pad, ek), hLR)
  +P = B0.YS(s, W, 0n)
  +R = B0.YS(j, W, 1n+s)
  +Z = Nat.add(B0.BL(1n+j, W, s), pad)
  +E0 = B0.EIS(s, 1n+j, W, n, pad)
  +a0 = A.quad(VVL.CNT(P))
  +dg = N.digits(4n, Nat.add(A.quad(n), B0.BL(s, W, 0n)))
  +h4c = F.logic__subst(Nat, z => {Nat.is_le(Nat.add(A.quad(z), 4n), VE2.LEN(E0)) == True{} : Bool}, s, VVL.CNT(P), Equal.sym(Nat, VVL.CNT(P), s, B0.cnt_ys(s, W, 0n)),
