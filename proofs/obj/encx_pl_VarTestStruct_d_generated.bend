def pv_go(+k: Nat, +d: Nat, +t: F.array__Tree<B0.MB<EM.MW>>, +i: U32, +s: Nat, +n: Nat, +cur: U32, +dd: Nat, +D: F.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat, +pad: Nat, +B0: +List<U32>, +LR: Nat, +ei: {U32.to_nat(i) == s : Nat}, +ek: {Nat.add(s, k) == n : Nat}, +e: {U32.to_nat(X) == Nat.add(A.quad(q), r) : Nat}, +hr: {Nat.is_lt(r, 4n) == True{} : Bool}, +hd: {Nat.is_lt(dd, 29n) == True{} : Bool}, +pf: {F.array__perfect(B0.MB<EM.MW>, d, t) == True{} : Bool}, +hdl: {Nat.is_lt(d, 31n) == True{} : Bool}, +hn: {Nat.is_le(n, VB.pw(d)) == True{} : Bool}, +hok: {EOKS(k, B0.SL(t), s) == True{} : Bool}, +pfD: {F.array__perfect(U32, dd, D) == True{} : Bool}, +hX: {Nat.is_le(Nat.add(A.quad(q), r), VE2.LEN(B0)) == True{} : Bool}, +hLR: {Nat.add(B0.LLN(n, B0.SL(t)), pad) == LR : Nat}, +hend: {Nat.add(Nat.add(A.quad(q), r), LR) == A.quad(WD.NWN(Nat.add(Nat.add(A.quad(q), r), B0.LLN(n, B0.SL(t))))) : Nat}, +hroom: {Nat.is_le(Nat.add(Nat.add(A.quad(q), r), LR), A.quad(VB.pw(dd))) == True{} : Bool}, +kx: Nat, +ek30: {kx == 30n : Nat}, +ec: {U32.to_nat(cur) == Nat.add(A.quad(n), B0.BL(s, B0.SL(t), 0n)) : Nat}, +hI: {UA.BYT(D) == UW.SPL(B0, Nat.add(A.quad(q), r), VS.bt(LR, B0.EIS(s, k, B0.SL(t), n, pad))) : +List<U32>})
    -> DK.P2(B0.RTQ(k, i, t, s, cur, dd, D, X, q, r), DK.P2(B0.BYQ(k, t, s, n, cur, dd, D, X, q, r, pad, B0, LR), B0.PFQ(k, t, s, cur, dd, D, X, q, r))):
  match k:
    case 0n:
      +es = Equal.trans(Nat, s, Nat.add(s, 0n), n, Equal.sym(Nat, Nat.add(s, 0n), s, F.nat__add_zero(s)), ek)
      ({==}, (F.logic__subst(Nat, z => {UA.BYT(D) == UW.SPL(B0, Nat.add(A.quad(q), r), VS.bt(LR, B0.EIS(z, 0n, B0.SL(t), n, pad))) : +List<U32>}, s, n, es, hI), pfD))
