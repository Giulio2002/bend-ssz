    +e: {U32.to_nat(X) == Nat.add(A.quad(q), r) : Nat}, +hr: {Nat.is_lt(r, 4n) == True{} : Bool}, +hd: {Nat.is_lt(dd, 31n) == True{} : Bool},
    +hl: {Nat.is_le(Nat.add(q, WD.NWN(Nat.add(r, U32.to_nat(B0.NE(m))))), VB.pw(dd)) == True{} : Bool}, +hs31: {Nat.is_le(U32.to_nat(B0.NE(m)), U32.to_nat(VB.NMAX())) == True{} : Bool}, +hl32: {Nat.is_lt(Nat.add(A.quad(q), Nat.add(r, U32.to_nat(B0.NE(m)))), F.spec_common__pow2(32n)) == True{} : Bool}, +pf: {F.array__perfect(U32, dd, D) == True{} : Bool},
    +hz: {VS.bt(B0.FPE(r, m), VS.bdr(Nat.add(A.quad(q), r), UA.BYT(D))) == UW.ZB(B0.FPE(r, m)) : +List<U32>})
    -> {VarTestStruct_e.VarTestStruct_bx_putk(F.array__thaw(U32, D), X, B0.th_VarTestStruct_bx(m)) == (F.array__thaw(U32, B0.PWE(m, dd, D, q, r)), (B0.th_VarTestStruct_bx(m), B0.NE(m))) : Array<U32> & (O.Boxed<VarTestStruct_d.VarTestStruct> & U32)}:
  match m:
    case B0.MNone{}: Empty.absurd({VarTestStruct_e.VarTestStruct_bx_putk(F.array__thaw(U32, D), X, B0.th_VarTestStruct_bx(B0.MNone{})) == (F.array__thaw(U32, B0.PWE(B0.MNone{}, dd, D, q, r)), (B0.th_VarTestStruct_bx(B0.MNone{}), B0.NE(B0.MNone{}))) : Array<U32> & (O.Boxed<VarTestStruct_d.VarTestStruct> & U32)}, F.logic__false_true(h))
    case B0.MSome{+w}:
      +es = EM.szxO(w, h)
      +hl2 = F.logic__subst(Nat, z => {Nat.is_le(Nat.add(q, WD.NWN(Nat.add(r, z))), VB.pw(dd)) == True{} : Bool}, U32.to_nat(EM.SZ(w)), VE2.LEN(EM.ENC(w)), es, hl)
      +hz2 = F.logic__subst(Nat, z => {VS.bt(Nat.add(z, WD.PADB(r, z)), VS.bdr(Nat.add(A.quad(q), r), UA.BYT(D))) == UW.ZB(Nat.add(z, WD.PADB(r, z))) : +List<U32>}, U32.to_nat(EM.SZ(w)), VE2.LEN(EM.ENC(w)), es, hz)
      %Equal.sym(Array<U32> & (VarTestStruct_d.VarTestStruct & U32), VarTestStruct_e.VarTestStruct_putk(F.array__thaw(U32, D), X, EM.TH(w)), (F.array__thaw(U32, EM.PUTX(w, dd, D, q, r)), (EM.TH(w), EM.SZ(w))),
          EM.putxO(w, dd, D, X, q, r, e, hr, hd, pf, hl2, F.logic__subst(Nat, z => {Nat.is_lt(Nat.add(A.quad(q), Nat.add(r, z)), F.spec_common__pow2(32n)) == True{} : Bool}, U32.to_nat(EM.SZ(w)), VE2.LEN(EM.ENC(w)), es, hl32), hz2, h)) :
        {VarTestStruct_e.VarTestStruct_bx_pk_back(_) == (F.array__thaw(U32, EM.PUTX(w, dd, D, q, r)), (O.BSome{EM.TH(w), O.BNone{}}, EM.SZ(w))) : Array<U32> & (O.Boxed<VarTestStruct_d.VarTestStruct> & U32)}
      {==}

def bxput(+m: B0.MB<EM.MW>, +h: {EOK(m) == True{} : Bool}, +dd: Nat, +D: F.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat,
    +e: {U32.to_nat(X) == Nat.add(A.quad(q), r) : Nat}, +hr: {Nat.is_lt(r, 4n) == True{} : Bool}, +hd: {Nat.is_lt(dd, 29n) == True{} : Bool},
    +hl: {Nat.is_le(Nat.add(q, WD.NWN(Nat.add(r, U32.to_nat(B0.NE(m))))), VB.pw(dd)) == True{} : Bool}, +pf: {F.array__perfect(U32, dd, D) == True{} : Bool},
    +hz: {VS.bt(B0.FPE(r, m), VS.bdr(Nat.add(A.quad(q), r), UA.BYT(D))) == UW.ZB(B0.FPE(r, m)) : +List<U32>})
    -> {VarTestStruct_e.VarTestStruct_bx_putk(F.array__thaw(U32, D), X, B0.th_VarTestStruct_bx(m)) == (F.array__thaw(U32, B0.PWE(m, dd, D, q, r)), (B0.th_VarTestStruct_bx(m), B0.NE(m))) : Array<U32> & (O.Boxed<VarTestStruct_d.VarTestStruct> & U32)}:
  bxputW(m, h, dd, D, X, q, r, e, hr, F.nat__lt_trans(dd, 29n, 31n, hd, {==}), hl, VRX.hs31w(q, r, U32.to_nat(B0.NE(m)), dd, hd, hl), VRX.hl32w(q, r, U32.to_nat(B0.NE(m)), dd, hd, hl), pf, hz)

def bxput_bytesW(+m: B0.MB<EM.MW>, +h: {EOK(m) == True{} : Bool}, +dd: Nat, +D: F.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat,
    +e: {U32.to_nat(X) == Nat.add(A.quad(q), r) : Nat}, +hr: {Nat.is_lt(r, 4n) == True{} : Bool}, +hd: {Nat.is_lt(dd, 31n) == True{} : Bool},
    +hl: {Nat.is_le(Nat.add(q, WD.NWN(Nat.add(r, U32.to_nat(B0.NE(m))))), VB.pw(dd)) == True{} : Bool}, +hs31: {Nat.is_le(U32.to_nat(B0.NE(m)), U32.to_nat(VB.NMAX())) == True{} : Bool}, +hl32: {Nat.is_lt(Nat.add(A.quad(q), Nat.add(r, U32.to_nat(B0.NE(m)))), F.spec_common__pow2(32n)) == True{} : Bool}, +pf: {F.array__perfect(U32, dd, D) == True{} : Bool},
    +hz: {VS.bt(B0.FPE(r, m), VS.bdr(Nat.add(A.quad(q), r), UA.BYT(D))) == UW.ZB(B0.FPE(r, m)) : +List<U32>})
    -> {UA.BYT(B0.PWE(m, dd, D, q, r)) == UW.SPL(UA.BYT(D), Nat.add(A.quad(q), r), VE2.APP(B0.YE(m), UW.ZB(WD.PADB(r, U32.to_nat(B0.NE(m)))))) : +List<U32>}:
  match m:
    case B0.MNone{}: Empty.absurd({UA.BYT(B0.PWE(B0.MNone{}, dd, D, q, r)) == UW.SPL(UA.BYT(D), Nat.add(A.quad(q), r), VE2.APP(B0.YE(B0.MNone{}), UW.ZB(WD.PADB(r, U32.to_nat(B0.NE(B0.MNone{})))))) : +List<U32>}, F.logic__false_true(h))
    case B0.MSome{+w}:
      +es = EM.szxO(w, h)
      +hl2 = F.logic__subst(Nat, z => {Nat.is_le(Nat.add(q, WD.NWN(Nat.add(r, z))), VB.pw(dd)) == True{} : Bool}, U32.to_nat(EM.SZ(w)), VE2.LEN(EM.ENC(w)), es, hl)
      +hz2 = F.logic__subst(Nat, z => {VS.bt(Nat.add(z, WD.PADB(r, z)), VS.bdr(Nat.add(A.quad(q), r), UA.BYT(D))) == UW.ZB(Nat.add(z, WD.PADB(r, z))) : +List<U32>}, U32.to_nat(EM.SZ(w)), VE2.LEN(EM.ENC(w)), es, hz)
      F.logic__subst(Nat, z => {UA.BYT(EM.PUTX(w, dd, D, q, r)) == UW.SPL(UA.BYT(D), Nat.add(A.quad(q), r), VE2.APP(EM.ENC(w), UW.ZB(WD.PADB(r, z)))) : +List<U32>},
        VE2.LEN(EM.ENC(w)), U32.to_nat(EM.SZ(w)), Equal.sym(Nat, U32.to_nat(EM.SZ(w)), VE2.LEN(EM.ENC(w)), es), EM.putx_bytesO(w, dd, D, X, q, r, e, hr, hd, pf, hl2, F.logic__subst(Nat, z => {Nat.is_lt(Nat.add(A.quad(q), Nat.add(r, z)), F.spec_common__pow2(32n)) == True{} : Bool}, U32.to_nat(EM.SZ(w)), VE2.LEN(EM.ENC(w)), es, hl32), hz2, h))

def bxput_bytes(+m: B0.MB<EM.MW>, +h: {EOK(m) == True{} : Bool}, +dd: Nat, +D: F.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat,
    +e: {U32.to_nat(X) == Nat.add(A.quad(q), r) : Nat}, +hr: {Nat.is_lt(r, 4n) == True{} : Bool}, +hd: {Nat.is_lt(dd, 29n) == True{} : Bool},
    +hl: {Nat.is_le(Nat.add(q, WD.NWN(Nat.add(r, U32.to_nat(B0.NE(m))))), VB.pw(dd)) == True{} : Bool}, +pf: {F.array__perfect(U32, dd, D) == True{} : Bool},
    +hz: {VS.bt(B0.FPE(r, m), VS.bdr(Nat.add(A.quad(q), r), UA.BYT(D))) == UW.ZB(B0.FPE(r, m)) : +List<U32>})
    -> {UA.BYT(B0.PWE(m, dd, D, q, r)) == UW.SPL(UA.BYT(D), Nat.add(A.quad(q), r), VE2.APP(B0.YE(m), UW.ZB(WD.PADB(r, U32.to_nat(B0.NE(m)))))) : +List<U32>}:
  bxput_bytesW(m, h, dd, D, X, q, r, e, hr, F.nat__lt_trans(dd, 29n, 31n, hd, {==}), hl, VRX.hs31w(q, r, U32.to_nat(B0.NE(m)), dd, hd, hl), VRX.hl32w(q, r, U32.to_nat(B0.NE(m)), dd, hd, hl), pf, hz)

# ---- arithmetic ---------------------------------------------------------------------------------

law ys_split:
  for +s: Nat
  for +k: Nat
  for +W: List<&2, B0.MB<EM.MW>>
  for +i: Nat
  {B0.YS(Nat.add(s, k), W, i) == VE2.LAPP(B0.YS(s, W, i), B0.YS(k, W, Nat.add(s, i))) : +List<+List<U32>>}
def ys_split(s, k, W, i):
  match s:
    case 0n: {==}
    case 1n+ +p:
      %F.nat__add_succ(p, i) :
        {Con{B0.YE(B0.xat_pl_VarTestStruct(W, i)), B0.YS(Nat.add(p, k), W, 1n+i)} == Con{B0.YE(B0.xat_pl_VarTestStruct(W, i)), VE2.LAPP(B0.YS(p, W, 1n+i), B0.YS(k, W, _))} : +List<+List<U32>>}
      Equal.cong(+List<+List<U32>>, +List<+List<U32>>, z => Con{B0.YE(B0.xat_pl_VarTestStruct(W, i)), z}, B0.YS(Nat.add(p, k), W, 1n+i), VE2.LAPP(B0.YS(p, W, 1n+i), B0.YS(k, W, Nat.add(p, 1n+i))), ys_split(p, k, W, 1n+i))

def ys_snoc(+s: Nat, +W: List<&2, B0.MB<EM.MW>>) -> {B0.YS(1n+s, W, 0n) == VE2.LAPP(B0.YS(s, W, 0n), [B0.YE(B0.xat_pl_VarTestStruct(W, s))]) : +List<+List<U32>>}:
  +e1 = ys_split(s, 1n, W, 0n)
  +es = Equal.trans(Nat, Nat.add(s, 1n), 1n+Nat.add(s, 0n), 1n+s, F.nat__add_succ(s, 0n), Equal.cong(Nat, Nat, z => 1n+z, Nat.add(s, 0n), s, F.nat__add_zero(s)))
  %es : {B0.YS(_, W, 0n) == VE2.LAPP(B0.YS(s, W, 0n), [B0.YE(B0.xat_pl_VarTestStruct(W, s))]) : +List<+List<U32>>}
  %F.nat__add_zero(s) : {B0.YS(Nat.add(s, 1n), W, 0n) == VE2.LAPP(B0.YS(s, W, 0n), [B0.YE(B0.xat_pl_VarTestStruct(W, _))]) : +List<+List<U32>>}
  e1

def len_ye(+m: B0.MB<EM.MW>, +h: {EOK(m) == True{} : Bool}) -> {VE2.LEN(B0.YE(m)) == U32.to_nat(B0.NE(m)) : Nat}:
  match m:
    case B0.MNone{}: Empty.absurd({VE2.LEN(B0.YE(B0.MNone{})) == U32.to_nat(B0.NE(B0.MNone{})) : Nat}, F.logic__false_true(h))
    case B0.MSome{+w}: Equal.sym(Nat, U32.to_nat(EM.SZ(w)), VE2.LEN(EM.ENC(w)), EM.szxO(w, h))

# padd of two small words is their sum.
law nwn_quad:
  for +a: Nat
  for +b: Nat
  {WD.NWN(Nat.add(A.quad(a), b)) == Nat.add(a, WD.NWN(b)) : Nat}
def nwn_quad(a, b):
  match a:
    case 0n: {==}
    case 1n+ +p: Equal.cong(Nat, Nat, z => 1n+z, WD.NWN(Nat.add(A.quad(p), b)), Nat.add(p, WD.NWN(b)), nwn_quad(p, b))

law nwn_ge:
  for +y: Nat
  {Nat.is_le(y, A.quad(WD.NWN(y))) == True{} : Bool}
def nwn_ge(y):
  match y:
    case 0n: {==}
    case 1n: {==}
    case 2n: {==}
    case 3n: {==}
    case 4n+ +z: nwn_ge(z)

# The padding to the end of the last word: r + m + B0.PADB(r, m) = 4 ceil((r + m) / 4).
def padb_id(+r: Nat, +m: Nat) -> {Nat.add(Nat.add(r, m), WD.PADB(r, m)) == A.quad(WD.NWN(Nat.add(r, m))) : Nat}:
  +Q = A.quad(WD.NWN(Nat.add(r, m)))
  +hq = nwn_ge(Nat.add(r, m))
  +hr = F.nat__le_trans(r, Nat.add(r, m), Q, Order.below_sum(r, m), hq)
  +er = F.nat__sub_add(Q, r, hr)
  +hm = VZ.le_cancel(r, m, Nat.sub(Q, r), F.logic__subst(Nat, z => {Nat.is_le(Nat.add(r, m), z) == True{} : Bool}, Q, Nat.add(r, Nat.sub(Q, r)), Equal.sym(Nat, Nat.add(r, Nat.sub(Q, r)), Q, er), hq))
  +em = F.nat__sub_add(Nat.sub(Q, r), m, hm)
  Equal.trans(Nat, Nat.add(Nat.add(r, m), WD.PADB(r, m)), Nat.add(r, Nat.add(m, WD.PADB(r, m))), Q, F.nat__add_assoc(r, m, WD.PADB(r, m)),
    Equal.trans(Nat, Nat.add(r, Nat.add(m, WD.PADB(r, m))), Nat.add(r, Nat.sub(Q, r)), Q, Equal.cong(Nat, Nat, z => Nat.add(r, z), Nat.add(m, WD.PADB(r, m)), Nat.sub(Q, r), em), er))

def bl_split(+s: Nat, +k: Nat, +W: List<&2, B0.MB<EM.MW>>) -> {B0.BL(Nat.add(s, k), W, 0n) == Nat.add(B0.BL(s, W, 0n), B0.BL(k, W, s)) : Nat}:
  %Equal.sym(+List<+List<U32>>, B0.YS(Nat.add(s, k), W, 0n), VE2.LAPP(B0.YS(s, W, 0n), B0.YS(k, W, Nat.add(s, 0n))), ys_split(s, k, W, 0n)) :
    {VE2.LEN(VR.bcat(_)) == Nat.add(B0.BL(s, W, 0n), B0.BL(k, W, s)) : Nat}
  %Equal.sym(+List<U32>, VR.bcat(VE2.LAPP(B0.YS(s, W, 0n), B0.YS(k, W, Nat.add(s, 0n)))), VE2.APP(VR.bcat(B0.YS(s, W, 0n)), VR.bcat(B0.YS(k, W, Nat.add(s, 0n)))), VE2.bcat_app(B0.YS(s, W, 0n), B0.YS(k, W, Nat.add(s, 0n)))) :
    {VE2.LEN(_) == Nat.add(B0.BL(s, W, 0n), B0.BL(k, W, s)) : Nat}
  %Equal.sym(Nat, Nat.add(s, 0n), s, F.nat__add_zero(s)) :
    {VE2.LEN(VE2.APP(VR.bcat(B0.YS(s, W, 0n)), VR.bcat(B0.YS(k, W, _)))) == Nat.add(B0.BL(s, W, 0n), B0.BL(k, W, s)) : Nat}
  VS.len_app(VR.bcat(B0.YS(s, W, 0n)), VR.bcat(B0.YS(k, W, s)))

def bl_snoc(+s: Nat, +W: List<&2, B0.MB<EM.MW>>) -> {B0.BL(1n+s, W, 0n) == Nat.add(B0.BL(s, W, 0n), VE2.LEN(B0.YE(B0.xat_pl_VarTestStruct(W, s)))) : Nat}:
  %Equal.sym(+List<+List<U32>>, B0.YS(1n+s, W, 0n), VE2.LAPP(B0.YS(s, W, 0n), [B0.YE(B0.xat_pl_VarTestStruct(W, s))]), ys_snoc(s, W)) : {VE2.LEN(VR.bcat(_)) == Nat.add(B0.BL(s, W, 0n), VE2.LEN(B0.YE(B0.xat_pl_VarTestStruct(W, s)))) : Nat}
  %Equal.sym(+List<U32>, VR.bcat(VE2.LAPP(B0.YS(s, W, 0n), [B0.YE(B0.xat_pl_VarTestStruct(W, s))])), VE2.APP(VR.bcat(B0.YS(s, W, 0n)), B0.YE(B0.xat_pl_VarTestStruct(W, s))), VE2.bcat_snoc(B0.YS(s, W, 0n), B0.YE(B0.xat_pl_VarTestStruct(W, s)))) :
    {VE2.LEN(_) == Nat.add(B0.BL(s, W, 0n), VE2.LEN(B0.YE(B0.xat_pl_VarTestStruct(W, s)))) : Nat}
  VS.len_app(VR.bcat(B0.YS(s, W, 0n)), B0.YE(B0.xat_pl_VarTestStruct(W, s)))

# The region's bytes when s elements are written and k remain.
def len_eis(+s: Nat, +k: Nat, +W: List<&2, B0.MB<EM.MW>>, +n: Nat, +pad: Nat, +ek: {Nat.add(s, k) == n : Nat})
    -> {VE2.LEN(B0.EIS(s, k, W, n, pad)) == Nat.add(Nat.add(A.quad(n), B0.BL(n, W, 0n)), pad) : Nat}:
  +P = B0.YS(s, W, 0n)
  +R = B0.YS(k, W, s)
  %Equal.sym(Nat, VE2.LEN(B0.EIS(s, k, W, n, pad)), Nat.add(A.quad(VVL.CNT(P)), Nat.add(A.quad(VVL.CNT(R)), Nat.add(B0.BL(s, W, 0n), Nat.add(B0.BL(k, W, s), pad)))), VE2.len_ei(P, R, A.quad(n), Nat.add(B0.BL(k, W, s), pad))) :
    {_ == Nat.add(Nat.add(A.quad(n), B0.BL(n, W, 0n)), pad) : Nat}
  %Equal.sym(Nat, VVL.CNT(P), s, B0.cnt_ys(s, W, 0n)) :
    {Nat.add(A.quad(_), Nat.add(A.quad(VVL.CNT(R)), Nat.add(B0.BL(s, W, 0n), Nat.add(B0.BL(k, W, s), pad)))) == Nat.add(Nat.add(A.quad(n), B0.BL(n, W, 0n)), pad) : Nat}
  %Equal.sym(Nat, VVL.CNT(R), k, B0.cnt_ys(k, W, s)) :
    {Nat.add(A.quad(s), Nat.add(A.quad(_), Nat.add(B0.BL(s, W, 0n), Nat.add(B0.BL(k, W, s), pad)))) == Nat.add(Nat.add(A.quad(n), B0.BL(n, W, 0n)), pad) : Nat}
  %ek : {Nat.add(A.quad(s), Nat.add(A.quad(k), Nat.add(B0.BL(s, W, 0n), Nat.add(B0.BL(k, W, s), pad)))) == Nat.add(Nat.add(A.quad(_), B0.BL(_, W, 0n)), pad) : Nat}
  %Equal.sym(Nat, B0.BL(Nat.add(s, k), W, 0n), Nat.add(B0.BL(s, W, 0n), B0.BL(k, W, s)), bl_split(s, k, W)) :
    {Nat.add(A.quad(s), Nat.add(A.quad(k), Nat.add(B0.BL(s, W, 0n), Nat.add(B0.BL(k, W, s), pad)))) == Nat.add(Nat.add(A.quad(Nat.add(s, k)), _), pad) : Nat}
  %Equal.sym(Nat, A.quad(Nat.add(s, k)), Nat.add(A.quad(s), A.quad(k)), Equal.sym(Nat, Nat.add(A.quad(s), A.quad(k)), A.quad(Nat.add(s, k)), VF.quad_add(s, k))) :
    {Nat.add(A.quad(s), Nat.add(A.quad(k), Nat.add(B0.BL(s, W, 0n), Nat.add(B0.BL(k, W, s), pad)))) == Nat.add(Nat.add(_, Nat.add(B0.BL(s, W, 0n), B0.BL(k, W, s))), pad) : Nat}
  +a = A.quad(s)
  +b = A.quad(k)
  +c = B0.BL(s, W, 0n)
  +d = B0.BL(k, W, s)
  Equal.sym(Nat, Nat.add(Nat.add(Nat.add(a, b), Nat.add(c, d)), pad), Nat.add(a, Nat.add(b, Nat.add(c, Nat.add(d, pad)))),
    Equal.trans(Nat, Nat.add(Nat.add(Nat.add(a, b), Nat.add(c, d)), pad), Nat.add(Nat.add(a, b), Nat.add(Nat.add(c, d), pad)), Nat.add(a, Nat.add(b, Nat.add(c, Nat.add(d, pad)))),
      F.nat__add_assoc(Nat.add(a, b), Nat.add(c, d), pad),
      Equal.trans(Nat, Nat.add(Nat.add(a, b), Nat.add(Nat.add(c, d), pad)), Nat.add(a, Nat.add(b, Nat.add(Nat.add(c, d), pad))), Nat.add(a, Nat.add(b, Nat.add(c, Nat.add(d, pad)))),
        F.nat__add_assoc(a, b, Nat.add(Nat.add(c, d), pad)),
        Equal.cong(Nat, Nat, z => Nat.add(a, Nat.add(b, z)), Nat.add(Nat.add(c, d), pad), Nat.add(c, Nat.add(d, pad)), F.nat__add_assoc(c, d, pad)))))

# ---- one step of the writer: offset s, then element s ----------------------------------------------

def el_bytes(+dd: Nat, +D: F.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat, +hd: {Nat.is_lt(dd, 29n) == True{} : Bool},
    +pfD: {F.array__perfect(U32, dd, D) == True{} : Bool}, +cur: U32, +s: Nat, +W: List<&2, B0.MB<EM.MW>>, +j: Nat, +n: Nat, +pad: Nat,
    +B0: +List<U32>, +LR: Nat, +hX: {Nat.is_le(Nat.add(A.quad(q), r), VE2.LEN(B0)) == True{} : Bool},
    +hx: {EOK(B0.xat_pl_VarTestStruct(W, s)) == True{} : Bool},
    +hLR: {VE2.LEN(VE2.EJ(B0.YS(s, W, 0n), B0.YE(B0.xat_pl_VarTestStruct(W, s)), B0.YS(j, W, 1n+s), A.quad(n), Nat.add(B0.BL(1n+j, W, s), pad))) == LR : Nat},
    +hI: {UA.BYT(D) == UW.SPL(B0, Nat.add(A.quad(q), r), VS.bt(LR, VE2.EJ(B0.YS(s, W, 0n), B0.YE(B0.xat_pl_VarTestStruct(W, s)), B0.YS(j, W, 1n+s), A.quad(n), Nat.add(B0.BL(1n+j, W, s), pad)))) : +List<U32>},
    +epe: {U32.to_nat(U32.add(X, cur)) == Nat.add(Nat.add(A.quad(q), r), VE2.LEN(VE2.PJ(B0.YS(s, W, 0n), B0.YE(B0.xat_pl_VarTestStruct(W, s)), B0.YS(j, W, 1n+s), A.quad(n)))) : Nat},
    +hle: {Nat.is_le(Nat.add(B0.QX(U32.add(X, cur)), WD.NWN(Nat.add(B0.RX(U32.add(X, cur)), U32.to_nat(B0.NE(B0.xat_pl_VarTestStruct(W, s)))))), VB.pw(dd)) == True{} : Bool},
    +hfp: {Nat.is_le(Nat.add(VE2.LEN(VE2.PJ(B0.YS(s, W, 0n), B0.YE(B0.xat_pl_VarTestStruct(W, s)), B0.YS(j, W, 1n+s), A.quad(n))), B0.FPE(B0.RX(U32.add(X, cur)), B0.xat_pl_VarTestStruct(W, s))), LR) == True{} : Bool},
    +hpz: {Nat.is_le(B0.FPE(B0.RX(U32.add(X, cur)), B0.xat_pl_VarTestStruct(W, s)), Nat.add(B0.BL(1n+j, W, s), pad)) == True{} : Bool})
    -> {UA.BYT(B0.PWE(B0.xat_pl_VarTestStruct(W, s), dd, D, B0.QX(U32.add(X, cur)), B0.RX(U32.add(X, cur)))) == UW.SPL(B0, Nat.add(A.quad(q), r), VS.bt(LR, B0.EIS(1n+s, j, W, n, pad))) : +List<U32>}:
  +x = B0.xat_pl_VarTestStruct(W, s)
  +P = B0.YS(s, W, 0n)
  +y = B0.YE(x)
  +R = B0.YS(j, W, 1n+s)
  +Z = Nat.add(B0.BL(1n+j, W, s), pad)
  +zr = Nat.add(B0.BL(j, W, 1n+s), pad)
  +Xe = U32.add(X, cur)
  +X0 = Nat.add(A.quad(q), r)
  +a = VE2.LEN(VE2.PJ(P, y, R, A.quad(n)))
  +pe = WD.PADB(B0.RX(Xe), U32.to_nat(B0.NE(x)))
  +Y = VE2.APP(y, UW.ZB(pe))
  +E = VE2.EJ(P, y, R, A.quad(n), Z)
  +hE = F.nat__eq_le(LR, VE2.LEN(E), Equal.sym(Nat, VE2.LEN(E), LR, hLR))
  +epos = Equal.trans(Nat, Nat.add(X0, a), U32.to_nat(Xe), Nat.add(A.quad(B0.QX(Xe)), B0.RX(Xe)), Equal.sym(Nat, U32.to_nat(Xe), Nat.add(X0, a), epe), VC.split4(Xe))
  +ely = len_ye(x, hx)
  +eY = Equal.trans(Nat, VE2.LEN(Y), Nat.add(VE2.LEN(y), VE2.LEN(UW.ZB(pe))), B0.FPE(B0.RX(Xe), x), VS.len_app(y, UW.ZB(pe)),
    Equal.trans(Nat, Nat.add(VE2.LEN(y), VE2.LEN(UW.ZB(pe))), Nat.add(U32.to_nat(B0.NE(x)), VE2.LEN(UW.ZB(pe))), B0.FPE(B0.RX(Xe), x),
      Equal.cong(Nat, Nat, z => Nat.add(z, VE2.LEN(UW.ZB(pe))), VE2.LEN(y), U32.to_nat(B0.NE(x)), ely),
      Equal.cong(Nat, Nat, z => Nat.add(U32.to_nat(B0.NE(x)), z), VE2.LEN(UW.ZB(pe)), pe, VE2.len_zb(pe))))
  +z0 = UW.inv_zero(B0, X0, LR, E, a, B0.FPE(B0.RX(Xe), x), UA.BYT(D), hX, hI, hfp, hE, VE2.win_el(P, y, R, A.quad(n), Z, B0.FPE(B0.RX(Xe), x), hpz))
  +hz = F.logic__subst(Nat, z => {VS.bt(B0.FPE(B0.RX(Xe), x), VS.bdr(z, UA.BYT(D))) == UW.ZB(B0.FPE(B0.RX(Xe), x)) : +List<U32>}, Nat.add(X0, a), Nat.add(A.quad(B0.QX(Xe)), B0.RX(Xe)), epos, z0)
  +wb = bxput_bytes(x, hx, dd, D, Xe, B0.QX(Xe), B0.RX(Xe), VC.split4(Xe), B0.rx_lt(Xe), hd, hle, pfD, hz)
  +hop = F.logic__subst(Nat, z => {UA.BYT(B0.PWE(x, dd, D, B0.QX(Xe), B0.RX(Xe))) == UW.SPL(UA.BYT(D), z, Y) : +List<U32>}, Nat.add(A.quad(B0.QX(Xe)), B0.RX(Xe)), Nat.add(X0, a),
    Equal.sym(Nat, Nat.add(X0, a), Nat.add(A.quad(B0.QX(Xe)), B0.RX(Xe)), epos), wb)
  +hfy = F.logic__subst(Nat, z => {Nat.is_le(Nat.add(a, z), LR) == True{} : Bool}, B0.FPE(B0.RX(Xe), x), VE2.LEN(Y), Equal.sym(Nat, VE2.LEN(Y), B0.FPE(B0.RX(Xe), x), eY), hfp)
  +st = UW.inv_step(B0, X0, LR, E, a, Y, Nat.sub(LR, Nat.add(a, VE2.LEN(Y))), UA.BYT(D), UA.BYT(B0.PWE(x, dd, D, B0.QX(Xe), B0.RX(Xe))), hX, hI, hop,
    F.nat__sub_add(LR, Nat.add(a, VE2.LEN(Y)), hfy), hE)
  +eZ = Equal.trans(Nat, Z, Nat.add(Nat.add(VE2.LEN(y), B0.BL(j, W, 1n+s)), pad), Nat.add(VE2.LEN(y), zr),
    Equal.cong(Nat, Nat, z => Nat.add(z, pad), B0.BL(1n+j, W, s), Nat.add(VE2.LEN(y), B0.BL(j, W, 1n+s)), B0.bl_cons(j, W, s)),
    F.nat__add_assoc(VE2.LEN(y), B0.BL(j, W, 1n+s), pad))
  +hpz2 = F.logic__subst(Nat, z => {Nat.is_le(B0.FPE(B0.RX(Xe), x), z) == True{} : Bool}, Z, Nat.add(VE2.LEN(y), zr), eZ, hpz)
