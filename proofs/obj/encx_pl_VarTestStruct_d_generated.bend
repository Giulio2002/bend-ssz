        Equal.cong(Nat, Nat, z => WD.NWN(z), Nat.add(A.quad(q), Nat.add(r, L)), Nat.add(Nat.add(A.quad(q), r), L), Equal.sym(Nat, Nat.add(Nat.add(A.quad(q), r), L), Nat.add(A.quad(q), Nat.add(r, L)), F.nat__add_assoc(A.quad(q), r, L))))))

def eisn(+t: F.array__Tree<B0.MB<EM.MW>>, +N: U32, +pad: Nat)
    -> {VS.bt(Nat.add(B0.LL(t, N), pad), B0.EIS(U32.to_nat(N), 0n, B0.SL(t), U32.to_nat(N), pad)) == VE2.APP(B0.ENCL(t, N), UW.ZB(pad)) : +List<U32>}:
  +ys = B0.YSN(t, N)
  +O = VVL.OFFS(ys, A.quad(U32.to_nat(N)))
  +b = VR.bcat(ys)
  %Equal.sym(+List<U32>, VE2.APP(O, VE2.APP(b, UW.ZB(pad))), VE2.APP(VE2.APP(O, b), UW.ZB(pad)), Equal.sym(+List<U32>, VE2.APP(VE2.APP(O, b), UW.ZB(pad)), VE2.APP(O, VE2.APP(b, UW.ZB(pad))), VS.app_assoc(O, b, UW.ZB(pad)))) :
    {VS.bt(Nat.add(B0.LL(t, N), pad), _) == VE2.APP(B0.ENCL(t, N), UW.ZB(pad)) : +List<U32>}
  +el = Equal.trans(Nat, VE2.LEN(VE2.APP(B0.ENCL(t, N), UW.ZB(pad))), Nat.add(VE2.LEN(B0.ENCL(t, N)), VE2.LEN(UW.ZB(pad))), Nat.add(B0.LL(t, N), pad), VS.len_app(B0.ENCL(t, N), UW.ZB(pad)),
    Equal.trans(Nat, Nat.add(VE2.LEN(B0.ENCL(t, N)), VE2.LEN(UW.ZB(pad))), Nat.add(B0.LL(t, N), VE2.LEN(UW.ZB(pad))), Nat.add(B0.LL(t, N), pad),
      Equal.cong(Nat, Nat, z => Nat.add(z, VE2.LEN(UW.ZB(pad))), VE2.LEN(B0.ENCL(t, N)), B0.LL(t, N), B0.len_encl(t, N)),
      Equal.cong(Nat, Nat, z => Nat.add(B0.LL(t, N), z), VE2.LEN(UW.ZB(pad)), pad, VE2.len_zb(pad))))
  %el : {VS.bt(_, VE2.APP(B0.ENCL(t, N), UW.ZB(pad))) == VE2.APP(B0.ENCL(t, N), UW.ZB(pad)) : +List<U32>}
  bt_all(VE2.APP(B0.ENCL(t, N), UW.ZB(pad)))

def putx_lb(+b: Bool, +t: F.array__Tree<B0.MB<EM.MW>>, +N: U32, +eb: {U32.is_eq(N, 0) == b : Bool}, +h: {OKL(t, N) == True{} : Bool},
    +dd: Nat, +D: F.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat,
    +e: {U32.to_nat(X) == Nat.add(A.quad(q), r) : Nat}, +hr: {Nat.is_lt(r, 4n) == True{} : Bool}, +hd: {Nat.is_lt(dd, 29n) == True{} : Bool},
    +hl: {Nat.is_le(Nat.add(q, WD.NWN(Nat.add(r, B0.LL(t, N)))), VB.pw(dd)) == True{} : Bool}, +pf: {F.array__perfect(U32, dd, D) == True{} : Bool},
    +hz: {VS.bt(Nat.add(B0.LL(t, N), WD.PADB(r, B0.LL(t, N))), VS.bdr(Nat.add(A.quad(q), r), UA.BYT(D))) == UW.ZB(Nat.add(B0.LL(t, N), WD.PADB(r, B0.LL(t, N)))) : +List<U32>})
    -> DK.P2(B0.RTLb(b, t, N, dd, D, X, q, r), DK.P2(B0.BYLb(b, t, N, dd, D, X, q, r), B0.PFLb(b, t, N, dd, D, X, q, r))):
  match b:
    case True{}:
      +eN = VVU.eqt(N, 0, eb)
      +W = B0.SL(t)
      +P0 = WD.PADB(r, 0n)
      +by0 = UW.inv_init(UA.BYT(D), Nat.add(A.quad(q), r), P0, UW.ZB(P0),
        F.logic__subst(Nat, z => {VS.bt(Nat.add(B0.LLN(z, W), WD.PADB(r, B0.LLN(z, W))), VS.bdr(Nat.add(A.quad(q), r), UA.BYT(D))) == UW.ZB(Nat.add(B0.LLN(z, W), WD.PADB(r, B0.LLN(z, W)))) : +List<U32>}, U32.to_nat(N), 0n, eN, hz),
        VE2.bt_zb_le(P0, P0, F.nat__le_refl(P0)))
      +by1 = F.logic__subst(+List<U32>, z => {UA.BYT(D) == UW.SPL(UA.BYT(D), Nat.add(A.quad(q), r), z) : +List<U32>}, VS.bt(P0, UW.ZB(P0)), UW.ZB(P0), VE2.bt_zb_le(P0, P0, F.nat__le_refl(P0)), by0)
      ({==}, (F.logic__subst(Nat, z => {UA.BYT(D) == UW.SPL(UA.BYT(D), Nat.add(A.quad(q), r), VE2.APP(VE2.APP(VVL.OFFS(B0.YS(z, W, 0n), A.quad(z)), VR.bcat(B0.YS(z, W, 0n))), UW.ZB(WD.PADB(r, B0.LLN(z, W))))) : +List<U32>},
          0n, U32.to_nat(N), Equal.sym(Nat, U32.to_nat(N), 0n, eN), by1), pf))
    case False{}:
      +n = U32.to_nat(N)
      +W = B0.SL(t)
      +L = B0.LL(t, N)
      +pad = WD.PADB(r, L)
      +LR = Nat.add(L, pad)
      +X0 = Nat.add(A.quad(q), r)
      +ee = e_end(q, r, L)
      +hroom = F.logic__subst(Nat, z => {Nat.is_le(z, A.quad(VB.pw(dd))) == True{} : Bool}, A.quad(Nat.add(q, WD.NWN(Nat.add(r, L)))), Nat.add(X0, LR), Equal.sym(Nat, Nat.add(X0, LR), A.quad(Nat.add(q, WD.NWN(Nat.add(r, L)))), ee),
        UW.quad_le(Nat.add(q, WD.NWN(Nat.add(r, L))), VB.pw(dd), hl))
      +hX = F.logic__subst(Nat, z => {Nat.is_le(X0, z) == True{} : Bool}, A.quad(VB.pw(dd)), VE2.LEN(UA.BYT(D)), Equal.sym(Nat, VE2.LEN(UA.BYT(D)), A.quad(VB.pw(dd)), B0.len_byt(dd, D, pf)),
        F.nat__le_trans(X0, Nat.add(X0, LR), A.quad(VB.pw(dd)), Order.below_sum(X0, LR), hroom))
      +hqn = F.nat__le_trans(A.quad(n), Nat.add(X0, LR), VB.pw(30n),
        F.nat__le_trans(A.quad(n), LR, Nat.add(X0, LR), F.nat__le_trans(A.quad(n), L, LR, Order.below_sum(A.quad(n), B0.BL(n, W, 0n)), Order.below_sum(L, pad)), Order.left_below_sum(X0, LR)),
        F.nat__le_trans(Nat.add(X0, LR), A.quad(VB.pw(dd)), VB.pw(30n), hroom, B0.q30(dd, hd)))
      +ec = Equal.trans(Nat, U32.to_nat(U32.mul(4, N)), A.quad(n), Nat.add(A.quad(n), B0.BL(0n, W, 0n)), B0.mul4k(N, 30n, {==}, hqn), Equal.sym(Nat, Nat.add(A.quad(n), 0n), A.quad(n), F.nat__add_zero(A.quad(n))))
      +hI0 = UW.inv_init(UA.BYT(D), X0, LR, B0.EIS(0n, n, W, n, pad), hz, B0.ei0(t, N, pad))
      +g = pv_go(n, B0.TDM(t), t, 0, 0n, n, U32.mul(4, N), dd, D, X, q, r, pad, UA.BYT(D), LR, {==}, {==}, e, hr, hd, okl_pf(t, N, h), okl_d(t, N, h), okl_n(t, N, h), okl_e(t, N, h),
        pf, hX, {==}, e_end2(q, r, L), hroom, 30n, {==}, ec, hI0)
      +rt = B0.PA(B0.RTQ(n, 0, t, 0n, U32.mul(4, N), dd, D, X, q, r), DK.P2(B0.BYQ(n, t, 0n, n, U32.mul(4, N), dd, D, X, q, r, pad, UA.BYT(D), LR), B0.PFQ(n, t, 0n, U32.mul(4, N), dd, D, X, q, r)), g)
      +g2 = B0.PB(B0.RTQ(n, 0, t, 0n, U32.mul(4, N), dd, D, X, q, r), DK.P2(B0.BYQ(n, t, 0n, n, U32.mul(4, N), dd, D, X, q, r, pad, UA.BYT(D), LR), B0.PFQ(n, t, 0n, U32.mul(4, N), dd, D, X, q, r)), g)
      +by = B0.PA(B0.BYQ(n, t, 0n, n, U32.mul(4, N), dd, D, X, q, r, pad, UA.BYT(D), LR), B0.PFQ(n, t, 0n, U32.mul(4, N), dd, D, X, q, r), g2)
      +pw = B0.PB(B0.BYQ(n, t, 0n, n, U32.mul(4, N), dd, D, X, q, r, pad, UA.BYT(D), LR), B0.PFQ(n, t, 0n, U32.mul(4, N), dd, D, X, q, r), g2)
      (B0.putx_rt_f(t, N, dd, D, X, q, r, rt),
        (F.logic__subst(+List<U32>, z => {UA.BYT(B0.WLM(n, W, 0n, U32.mul(4, N), dd, D, X, q, r)) == UW.SPL(UA.BYT(D), X0, z) : +List<U32>}, VS.bt(LR, B0.EIS(n, 0n, W, n, pad)), VE2.APP(B0.ENCL(t, N), UW.ZB(pad)), eisn(t, N, pad), by),
         pw))

# The runtime's write, with its validity check.
def putk_rt(+t: F.array__Tree<B0.MB<EM.MW>>, +N: U32, +h: {OKL(t, N) == True{} : Bool}, +dd: Nat, +D: F.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat,
    +rtb: B0.RTLb(U32.is_eq(N, 0), t, N, dd, D, X, q, r))
    -> {proglist_VarTestStruct_e.pl_VarTestStruct_putk(F.array__thaw(U32, D), X, B0.THL(t, N)) == (F.array__thaw(U32, B0.PUTL(t, N, dd, D, X, q, r)), (B0.THL(t, N), B0.SZW(t, N))) : Array<U32> & (proglist_VarTestStruct_d.pl_VarTestStruct_Seq & U32)}:
  %Equal.sym(proglist_VarTestStruct_d.pl_VarTestStruct_Seq & Bool, proglist_VarTestStruct_e.pl_VarTestStruct_valid(B0.THL(t, N)), (B0.THL(t, N), True{}), valid_l(t, N, h)) :
    {proglist_VarTestStruct_e.pl_VarTestStruct_pk(F.array__thaw(U32, D), X, _) == (F.array__thaw(U32, B0.PUTL(t, N, dd, D, X, q, r)), (B0.THL(t, N), B0.SZW(t, N))) : Array<U32> & (proglist_VarTestStruct_d.pl_VarTestStruct_Seq & U32)}
  rtb

# ---- the list's encoder window: the interface ------------------------------------------------------

def putl(+t: F.array__Tree<B0.MB<EM.MW>>, +N: U32, +h: {OKL(t, N) == True{} : Bool}, +dd: Nat, +D: F.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat,
    +e: {U32.to_nat(X) == Nat.add(A.quad(q), r) : Nat}, +hr: {Nat.is_lt(r, 4n) == True{} : Bool}, +hd: {Nat.is_lt(dd, 29n) == True{} : Bool},
    +hl: {Nat.is_le(Nat.add(q, WD.NWN(Nat.add(r, B0.LL(t, N)))), VB.pw(dd)) == True{} : Bool}, +pf: {F.array__perfect(U32, dd, D) == True{} : Bool},
    +hz: {VS.bt(Nat.add(B0.LL(t, N), WD.PADB(r, B0.LL(t, N))), VS.bdr(Nat.add(A.quad(q), r), UA.BYT(D))) == UW.ZB(Nat.add(B0.LL(t, N), WD.PADB(r, B0.LL(t, N)))) : +List<U32>})
    -> DK.P2(B0.RTL(t, N, dd, D, X, q, r), DK.P2(B0.BYLb(U32.is_eq(N, 0), t, N, dd, D, X, q, r), B0.PFLb(U32.is_eq(N, 0), t, N, dd, D, X, q, r))):
  +b = U32.is_eq(N, 0)
  +g = putx_lb(b, t, N, {==}, h, dd, D, X, q, r, e, hr, hd, hl, pf, hz)
  (putk_rt(t, N, h, dd, D, X, q, r, B0.PA(B0.RTLb(b, t, N, dd, D, X, q, r), DK.P2(B0.BYLb(b, t, N, dd, D, X, q, r), B0.PFLb(b, t, N, dd, D, X, q, r)), g)),
    B0.PB(B0.RTLb(b, t, N, dd, D, X, q, r), DK.P2(B0.BYLb(b, t, N, dd, D, X, q, r), B0.PFLb(b, t, N, dd, D, X, q, r)), g))


# ==== any output depth dd < 31 (the encoder-window twins, written here) ============================
# At dd = 30 the tree is 2^32 bytes: the positions X + 4 i and X + cur are exact by the list's end
# below 2^32 (h32: X0 + L < 2^32), and the cursor's padd by the list's length below 2^31 (h31: L < 2^31,
# the runtime's poison bit).

# X + 4 i at byte 4 (s + q) + r, the sum below 2^32.
def f_offW(+i: U32, +s: Nat, +j: Nat, +n: Nat, +W: List<&2, B0.MB<EM.MW>>, +q: Nat, +r: Nat, +X: U32, +dd: Nat, +pad: Nat, +LR: Nat,
    +ek: {Nat.add(s, 1n+j) == n : Nat}, +e: {U32.to_nat(X) == Nat.add(A.quad(q), r) : Nat}, +hd: {Nat.is_lt(dd, 31n) == True{} : Bool},
    +hLR: {Nat.add(B0.LLN(n, W), pad) == LR : Nat}, +hroom: {Nat.is_le(Nat.add(Nat.add(A.quad(q), r), LR), A.quad(VB.pw(dd))) == True{} : Bool}, +h32: {Nat.is_lt(Nat.add(Nat.add(A.quad(q), r), B0.LLN(n, W)), F.spec_common__pow2(32n)) == True{} : Bool}, +h31: {Nat.is_le(B0.LLN(n, W), U32.to_nat(VB.NMAX())) == True{} : Bool}, +ei: {U32.to_nat(i) == s : Nat})
    -> DK.P2(B0.TEP(X, i, s, q, r), DK.P2(B0.THLO(s, q, r, dd), B0.TH4(s, LR))):
  +X0 = Nat.add(A.quad(q), r)
  +L = B0.LLN(n, W)
  +hs = B0.hs_of(s, j, n, ek)
  +hLL = F.logic__subst(Nat, z => {Nat.is_le(L, z) == True{} : Bool}, Nat.add(L, pad), LR, hLR, Order.below_sum(L, pad))
  +hqn = F.nat__le_trans(A.quad(n), L, LR, Order.below_sum(A.quad(n), B0.BL(n, W, 0n)), hLL)
  +h4 = F.logic__subst(Nat, z => {Nat.is_le(z, LR) == True{} : Bool}, A.quad(1n+s), Nat.add(A.quad(s), 4n), F.nat__add_comm(4n, A.quad(s)),
    F.nat__le_trans(A.quad(1n+s), A.quad(n), LR, UW.quad_le(1n+s, n, F.nat__lt_succ_le_succ(s, n, hs)), hqn))
  +h4L = F.logic__subst(Nat, z => {Nat.is_le(z, L) == True{} : Bool}, A.quad(1n+s), Nat.add(A.quad(s), 4n), F.nat__add_comm(4n, A.quad(s)),
    F.nat__le_trans(A.quad(1n+s), A.quad(n), L, UW.quad_le(1n+s, n, F.nat__lt_succ_le_succ(s, n, hs)), Order.below_sum(A.quad(n), B0.BL(n, W, 0n))))
  +hbo = F.nat__le_lt_trans(Nat.add(X0, A.quad(s)), Nat.add(X0, L), F.spec_common__pow2(32n),
    Order.add_left(X0, A.quad(s), L, F.nat__le_trans(A.quad(s), Nat.add(A.quad(s), 4n), L, Order.below_sum(A.quad(s), 4n), h4L)), h32)
  +ep = B0.ep_off32(X, i, q, r, s, e, ei, hbo)
  +eo4 = Equal.trans(Nat, Nat.add(A.quad(Nat.add(s, q)), Nat.add(r, 4n)), Nat.add(Nat.add(A.quad(Nat.add(s, q)), r), 4n), Nat.add(X0, Nat.add(A.quad(s), 4n)),
    Equal.sym(Nat, Nat.add(Nat.add(A.quad(Nat.add(s, q)), r), 4n), Nat.add(A.quad(Nat.add(s, q)), Nat.add(r, 4n)), F.nat__add_assoc(A.quad(Nat.add(s, q)), r, 4n)),
    Equal.trans(Nat, Nat.add(Nat.add(A.quad(Nat.add(s, q)), r), 4n), Nat.add(Nat.add(X0, A.quad(s)), 4n), Nat.add(X0, Nat.add(A.quad(s), 4n)),
      Equal.cong(Nat, Nat, z => Nat.add(z, 4n), Nat.add(A.quad(Nat.add(s, q)), r), Nat.add(X0, A.quad(s)), UW.pos_eq(s, q, r)),
      F.nat__add_assoc(X0, A.quad(s), 4n)))
  +hlo = F.logic__subst(Nat, z => {Nat.is_le(z, VB.pw(dd)) == True{} : Bool}, WD.NWN(Nat.add(A.quad(Nat.add(s, q)), Nat.add(r, 4n))), Nat.add(Nat.add(s, q), WD.NWN(Nat.add(r, 4n))),
    nwn_quad(Nat.add(s, q), Nat.add(r, 4n)),
    B0.nwn_le(Nat.add(A.quad(Nat.add(s, q)), Nat.add(r, 4n)), VB.pw(dd),
      F.logic__subst(Nat, z => {Nat.is_le(z, A.quad(VB.pw(dd))) == True{} : Bool}, Nat.add(X0, Nat.add(A.quad(s), 4n)), Nat.add(A.quad(Nat.add(s, q)), Nat.add(r, 4n)),
        Equal.sym(Nat, Nat.add(A.quad(Nat.add(s, q)), Nat.add(r, 4n)), Nat.add(X0, Nat.add(A.quad(s), 4n)), eo4),
        F.nat__le_trans(Nat.add(X0, Nat.add(A.quad(s), 4n)), Nat.add(X0, LR), A.quad(VB.pw(dd)), Order.add_left(X0, Nat.add(A.quad(s), 4n), LR, h4), hroom))))
  (ep, (hlo, h4))

def f_elW(+s: Nat, +j: Nat, +n: Nat, +W: List<&2, B0.MB<EM.MW>>, +q: Nat, +r: Nat, +X: U32, +dd: Nat, +pad: Nat, +LR: Nat,
    +ek: {Nat.add(s, 1n+j) == n : Nat}, +e: {U32.to_nat(X) == Nat.add(A.quad(q), r) : Nat}, +hd: {Nat.is_lt(dd, 31n) == True{} : Bool},
    +hLR: {Nat.add(B0.LLN(n, W), pad) == LR : Nat}, +hroom: {Nat.is_le(Nat.add(Nat.add(A.quad(q), r), LR), A.quad(VB.pw(dd))) == True{} : Bool}, +h32: {Nat.is_lt(Nat.add(Nat.add(A.quad(q), r), B0.LLN(n, W)), F.spec_common__pow2(32n)) == True{} : Bool}, +h31: {Nat.is_le(B0.LLN(n, W), U32.to_nat(VB.NMAX())) == True{} : Bool},
    +hend: {Nat.add(Nat.add(A.quad(q), r), LR) == A.quad(WD.NWN(Nat.add(Nat.add(A.quad(q), r), B0.LLN(n, W)))) : Nat}, +cur: U32, +ec: {U32.to_nat(cur) == Nat.add(A.quad(n), B0.BL(s, W, 0n)) : Nat}, +hx: {EOK(B0.xat_pl_VarTestStruct(W, s)) == True{} : Bool})
    -> DK.P2(B0.TEPE(X, cur, s, j, n, W, q, r), DK.P2(B0.THLE(X, cur, s, W, dd), DK.P2(B0.THFP(X, cur, s, j, n, W, LR), B0.THPZ(X, cur, s, j, W, pad)))):
  +x = B0.xat_pl_VarTestStruct(W, s)
  +y = B0.YE(x)
  +X0 = Nat.add(A.quad(q), r)
  +L = B0.LLN(n, W)
  +Nx = U32.to_nat(B0.NE(x))
