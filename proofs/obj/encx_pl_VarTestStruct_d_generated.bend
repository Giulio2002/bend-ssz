  +rt2 = F.logic__subst(U32, z => {proglist_VarTestStruct_e.pl_VarTestStruct_putk(F.array__thaw(U32, D), z, B0.THL(t, N)) == (F.array__thaw(U32, B0.PUTL(t, N, dd, D, B0.XQ(q, r), q, r)), (B0.THL(t, N), B0.SZW(t, N))) : Array<U32> & (proglist_VarTestStruct_d.pl_VarTestStruct_Seq & U32)},
