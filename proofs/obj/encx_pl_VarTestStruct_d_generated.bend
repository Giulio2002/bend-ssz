# ---- the writer loop ---------------------------------------------------------------------------------

# The output tree after the loop's k steps from element s (offset s at word q + s, byte r;
# element s at X + cur).
def step_rt(+j: Nat, +d: Nat, +t: F.array__Tree<B0.MB<EM.MW>>, +i: U32, +s: Nat, +cur: U32, +dd: Nat, +D: F.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat,
    +ei: {U32.to_nat(i) == s : Nat}, +pf: {F.array__perfect(B0.MB<EM.MW>, d, t) == True{} : Bool}, +hdl: {Nat.is_lt(d, 31n) == True{} : Bool},
    +hsd: {Nat.is_lt(s, VB.pw(d)) == True{} : Bool}, +hr: {Nat.is_lt(r, 4n) == True{} : Bool}, +hd: {Nat.is_lt(dd, 29n) == True{} : Bool},
    +pfD: {F.array__perfect(U32, dd, D) == True{} : Bool}, +hx: {EOK(B0.xat_pl_VarTestStruct(B0.SL(t), s)) == True{} : Bool},
    +ep: {U32.to_nat(B0.AO(X, i)) == Nat.add(A.quad(Nat.add(s, q)), r) : Nat},
    +hlo: {Nat.is_le(Nat.add(Nat.add(s, q), WD.NWN(Nat.add(r, 4n))), VB.pw(dd)) == True{} : Bool},
    +hle: {Nat.is_le(Nat.add(B0.QX(U32.add(X, cur)), WD.NWN(Nat.add(B0.RX(U32.add(X, cur)), U32.to_nat(B0.NE(B0.xat_pl_VarTestStruct(B0.SL(t), s)))))), VB.pw(dd)) == True{} : Bool},
    +hz: {VS.bt(B0.FPE(B0.RX(U32.add(X, cur)), B0.xat_pl_VarTestStruct(B0.SL(t), s)), VS.bdr(Nat.add(A.quad(B0.QX(U32.add(X, cur))), B0.RX(U32.add(X, cur))), UA.BYT(WD.W32X(r, dd, D, Nat.add(s, q), cur)))) == UW.ZB(B0.FPE(B0.RX(U32.add(X, cur)), B0.xat_pl_VarTestStruct(B0.SL(t), s))) : +List<U32>},
    +ih: {proglist_VarTestStruct_e.pl_VarTestStruct_pv(j, U32.add(i, 1), X, B0.ST(B0.PWE(B0.xat_pl_VarTestStruct(B0.SL(t), s), dd, WD.W32X(r, dd, D, Nat.add(s, q), cur), B0.QX(U32.add(X, cur)), B0.RX(U32.add(X, cur))), t, O.padd(cur, B0.NE(B0.xat_pl_VarTestStruct(B0.SL(t), s)))))
            == (F.array__thaw(U32, B0.WLM(j, B0.SL(t), 1n+s, O.padd(cur, B0.NE(B0.xat_pl_VarTestStruct(B0.SL(t), s))), dd, B0.PWE(B0.xat_pl_VarTestStruct(B0.SL(t), s), dd, WD.W32X(r, dd, D, Nat.add(s, q), cur), B0.QX(U32.add(X, cur)), B0.RX(U32.add(X, cur))), X, q, r)),
                (B0.AR(t), (B0.SZA(j, B0.SL(t), 1n+s, O.padd(cur, B0.NE(B0.xat_pl_VarTestStruct(B0.SL(t), s)))), O.BNone{}))) : Array<U32> & (Array<O.Boxed<VarTestStruct_d.VarTestStruct>> & (U32 & O.Boxed<VarTestStruct_d.VarTestStruct>))})
    -> {proglist_VarTestStruct_e.pl_VarTestStruct_pv(1n+j, i, X, B0.ST(D, t, cur)) == (F.array__thaw(U32, B0.WLM(1n+j, B0.SL(t), s, cur, dd, D, X, q, r)), (B0.AR(t), (B0.SZA(1n+j, B0.SL(t), s, cur), O.BNone{}))) : Array<U32> & (Array<O.Boxed<VarTestStruct_d.VarTestStruct>> & (U32 & O.Boxed<VarTestStruct_d.VarTestStruct>))}:
  +x = B0.xat_pl_VarTestStruct(B0.SL(t), s)
  +D1 = WD.W32X(r, dd, D, Nat.add(s, q), cur)
  +Xe = U32.add(X, cur)
