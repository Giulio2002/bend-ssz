# exq at any output depth dd < 31: X0 = to_nat X is below 2^32 anyway.
def goW(+t: F.array__Tree<B0.MB<EM.MW>>, +N: U32, +h: {OKT(t, N) == True{} : Bool}, +dd: Nat, +D: F.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat,
