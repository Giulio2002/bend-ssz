  +es = F.logic__subst(Nat, z => {UW.SPL(VE2.EJ(P, y, R, A.quad(n), z), a, Y) == VE2.EI(VE2.LAPP(P, [y]), R, A.quad(n), zr) : +List<U32>}, Nat.add(VE2.LEN(y), zr), Z,
    Equal.sym(Nat, Z, Nat.add(VE2.LEN(y), zr), eZ), VE2.el_step(P, y, R, A.quad(n), zr, pe, hp))
  %Equal.sym(+List<+List<U32>>, B0.YS(1n+s, W, 0n), VE2.LAPP(P, [y]), ys_snoc(s, W)) :
    {UA.BYT(B0.PWE(x, dd, D, B0.QX(Xe), B0.RX(Xe))) == UW.SPL(B0, X0, VS.bt(LR, VE2.EI(_, R, A.quad(n), zr))) : +List<U32>}
  %es : {UA.BYT(B0.PWE(x, dd, D, B0.QX(Xe), B0.RX(Xe))) == UW.SPL(B0, X0, VS.bt(LR, _)) : +List<U32>}
