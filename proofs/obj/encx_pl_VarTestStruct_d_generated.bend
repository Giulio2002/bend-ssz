      bxput(x, hx, dd, D1, Xe, B0.QX(Xe), B0.RX(Xe), VC.split4(Xe), B0.rx_lt(Xe), hd, hle, WD.w32x_perfect(r, dd, D, Nat.add(s, q), cur, pfD), hz)) :
    {proglist_VarTestStruct_e.pl_VarTestStruct_pv(j, U32.add(i, 1), X, proglist_VarTestStruct_e.pl_VarTestStruct_pv_placed(i, B0.AR(F.array__upd(B0.MB<EM.MW>, d, t, s, B0.MNone{})), VarTestStruct_e.VarTestStruct_bx_pvb(cur, _))) == B0.RSX(1n+j, t, s, cur, dd, D, X, q, r) : Array<U32> & (Array<O.Boxed<VarTestStruct_d.VarTestStruct>> & (U32 & O.Boxed<VarTestStruct_d.VarTestStruct>))}
  %Equal.sym(Array<O.Boxed<VarTestStruct_d.VarTestStruct>> & O.Boxed<VarTestStruct_d.VarTestStruct>, Array.swap(O.Boxed<VarTestStruct_d.VarTestStruct>, B0.AR(F.array__upd(B0.MB<EM.MW>, d, t, s, B0.MNone{})), i, B0.th_VarTestStruct_bx(x)), (B0.AR(t), O.BNone{}), swap_in(d, t, i, s, ei, pf, hdl, hsd)) :
    {proglist_VarTestStruct_e.pl_VarTestStruct_pv(j, U32.add(i, 1), X, proglist_VarTestStruct_e.pl_VarTestStruct_pv_ret(F.array__thaw(U32, B0.PWE(x, dd, D1, B0.QX(Xe), B0.RX(Xe))), O.padd(cur, B0.NE(x)), _)) == B0.RSX(1n+j, t, s, cur, dd, D, X, q, r) : Array<U32> & (Array<O.Boxed<VarTestStruct_d.VarTestStruct>> & (U32 & O.Boxed<VarTestStruct_d.VarTestStruct>))}
