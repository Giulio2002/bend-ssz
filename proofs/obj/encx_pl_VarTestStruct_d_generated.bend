      F.logic__subst(Nat, z => {Nat.is_le(z, Nat.add(B0.BL(s, W, 0n), Nat.add(Nx, B0.BL(j, W, 1n+s)))) == True{} : Bool}, Nat.add(B0.BL(s, W, 0n), Nat.add(Nx, 0n)), Nat.add(B0.BL(s, W, 0n), Nx),
