    +hpz: {Nat.is_le(B0.FPE(B0.RX(U32.add(X, cur)), B0.xat_pl_VarTestStruct(W, s)), Nat.add(B0.BL(1n+j, W, s), pad)) == True{} : Bool})
    -> {UA.BYT(B0.PWE(B0.xat_pl_VarTestStruct(W, s), dd, D, B0.QX(U32.add(X, cur)), B0.RX(U32.add(X, cur)))) == UW.SPL(B0, Nat.add(A.quad(q), r), VS.bt(LR, B0.EIS(1n+s, j, W, n, pad))) : +List<U32>}:
  +x = B0.xat_pl_VarTestStruct(W, s)
  +P = B0.YS(s, W, 0n)
  +y = B0.YE(x)
  +R = B0.YS(j, W, 1n+s)
  +Z = Nat.add(B0.BL(1n+j, W, s), pad)
  +zr = Nat.add(B0.BL(j, W, 1n+s), pad)
  +Xe = U32.add(X, cur)
  +X0 = Nat.add(A.quad(q), r)
  +a = VE2.LEN(VE2.PJ(P, y, R, A.quad(n)))
  +pe = WD.PADB(B0.RX(Xe), U32.to_nat(B0.NE(x)))
  +Y = VE2.APP(y, UW.ZB(pe))
  +E = VE2.EJ(P, y, R, A.quad(n), Z)
  +hE = F.nat__eq_le(LR, VE2.LEN(E), Equal.sym(Nat, VE2.LEN(E), LR, hLR))
  +epos = Equal.trans(Nat, Nat.add(X0, a), U32.to_nat(Xe), Nat.add(A.quad(B0.QX(Xe)), B0.RX(Xe)), Equal.sym(Nat, U32.to_nat(Xe), Nat.add(X0, a), epe), VC.split4(Xe))
  +ely = len_ye(x, hx)
  +eY = Equal.trans(Nat, VE2.LEN(Y), Nat.add(VE2.LEN(y), VE2.LEN(UW.ZB(pe))), B0.FPE(B0.RX(Xe), x), VS.len_app(y, UW.ZB(pe)),
    Equal.trans(Nat, Nat.add(VE2.LEN(y), VE2.LEN(UW.ZB(pe))), Nat.add(U32.to_nat(B0.NE(x)), VE2.LEN(UW.ZB(pe))), B0.FPE(B0.RX(Xe), x),
      Equal.cong(Nat, Nat, z => Nat.add(z, VE2.LEN(UW.ZB(pe))), VE2.LEN(y), U32.to_nat(B0.NE(x)), ely),
      Equal.cong(Nat, Nat, z => Nat.add(U32.to_nat(B0.NE(x)), z), VE2.LEN(UW.ZB(pe)), pe, VE2.len_zb(pe))))
  +z0 = UW.inv_zero(B0, X0, LR, E, a, B0.FPE(B0.RX(Xe), x), UA.BYT(D), hX, hI, hfp, hE, VE2.win_el(P, y, R, A.quad(n), Z, B0.FPE(B0.RX(Xe), x), hpz))
  +hz = F.logic__subst(Nat, z => {VS.bt(B0.FPE(B0.RX(Xe), x), VS.bdr(z, UA.BYT(D))) == UW.ZB(B0.FPE(B0.RX(Xe), x)) : +List<U32>}, Nat.add(X0, a), Nat.add(A.quad(B0.QX(Xe)), B0.RX(Xe)), epos, z0)
  +wb = bxput_bytesW(x, hx, dd, D, Xe, B0.QX(Xe), B0.RX(Xe), VC.split4(Xe), B0.rx_lt(Xe), hd, hle, hle31, hle32, pfD, hz)
  +hop = F.logic__subst(Nat, z => {UA.BYT(B0.PWE(x, dd, D, B0.QX(Xe), B0.RX(Xe))) == UW.SPL(UA.BYT(D), z, Y) : +List<U32>}, Nat.add(A.quad(B0.QX(Xe)), B0.RX(Xe)), Nat.add(X0, a),
    Equal.sym(Nat, Nat.add(X0, a), Nat.add(A.quad(B0.QX(Xe)), B0.RX(Xe)), epos), wb)
  +hfy = F.logic__subst(Nat, z => {Nat.is_le(Nat.add(a, z), LR) == True{} : Bool}, B0.FPE(B0.RX(Xe), x), VE2.LEN(Y), Equal.sym(Nat, VE2.LEN(Y), B0.FPE(B0.RX(Xe), x), eY), hfp)
  +st = UW.inv_step(B0, X0, LR, E, a, Y, Nat.sub(LR, Nat.add(a, VE2.LEN(Y))), UA.BYT(D), UA.BYT(B0.PWE(x, dd, D, B0.QX(Xe), B0.RX(Xe))), hX, hI, hop,
