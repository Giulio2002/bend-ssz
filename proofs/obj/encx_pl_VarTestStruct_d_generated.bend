  st

# ---- the writer loop ---------------------------------------------------------------------------------

def pv_goW(+k: Nat, +d: Nat, +t: F.array__Tree<B0.MB<EM.MW>>, +i: U32, +s: Nat, +n: Nat, +cur: U32, +dd: Nat, +D: F.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat, +pad: Nat, +B0: +List<U32>, +LR: Nat, +ei: {U32.to_nat(i) == s : Nat}, +ek: {Nat.add(s, k) == n : Nat}, +e: {U32.to_nat(X) == Nat.add(A.quad(q), r) : Nat}, +hr: {Nat.is_lt(r, 4n) == True{} : Bool}, +hd: {Nat.is_lt(dd, 31n) == True{} : Bool}, +pf: {F.array__perfect(B0.MB<EM.MW>, d, t) == True{} : Bool}, +hdl: {Nat.is_lt(d, 31n) == True{} : Bool}, +hn: {Nat.is_le(n, VB.pw(d)) == True{} : Bool}, +hok: {EOKS(k, B0.SL(t), s) == True{} : Bool}, +pfD: {F.array__perfect(U32, dd, D) == True{} : Bool}, +hX: {Nat.is_le(Nat.add(A.quad(q), r), VE2.LEN(B0)) == True{} : Bool}, +hLR: {Nat.add(B0.LLN(n, B0.SL(t)), pad) == LR : Nat}, +hend: {Nat.add(Nat.add(A.quad(q), r), LR) == A.quad(WD.NWN(Nat.add(Nat.add(A.quad(q), r), B0.LLN(n, B0.SL(t))))) : Nat}, +hroom: {Nat.is_le(Nat.add(Nat.add(A.quad(q), r), LR), A.quad(VB.pw(dd))) == True{} : Bool}, +h32: {Nat.is_lt(Nat.add(Nat.add(A.quad(q), r), B0.LLN(n, B0.SL(t))), F.spec_common__pow2(32n)) == True{} : Bool}, +h31: {Nat.is_le(B0.LLN(n, B0.SL(t)), U32.to_nat(VB.NMAX())) == True{} : Bool}, +ec: {U32.to_nat(cur) == Nat.add(A.quad(n), B0.BL(s, B0.SL(t), 0n)) : Nat}, +hI: {UA.BYT(D) == UW.SPL(B0, Nat.add(A.quad(q), r), VS.bt(LR, B0.EIS(s, k, B0.SL(t), n, pad))) : +List<U32>})
    -> DK.P2(B0.RTQ(k, i, t, s, cur, dd, D, X, q, r), DK.P2(B0.BYQ(k, t, s, n, cur, dd, D, X, q, r, pad, B0, LR), B0.PFQ(k, t, s, cur, dd, D, X, q, r))):
  match k:
    case 0n:
      +es = Equal.trans(Nat, s, Nat.add(s, 0n), n, Equal.sym(Nat, Nat.add(s, 0n), s, F.nat__add_zero(s)), ek)
      ({==}, (F.logic__subst(Nat, z => {UA.BYT(D) == UW.SPL(B0, Nat.add(A.quad(q), r), VS.bt(LR, B0.EIS(z, 0n, B0.SL(t), n, pad))) : +List<U32>}, s, n, es, hI), pfD))
    case 1n+ +j:
      +W = B0.SL(t)
      +x = B0.xat_pl_VarTestStruct(W, s)
      +hx = B0.and_l(EOK(x), EOKS(j, W, 1n+s), hok)
      +hs = B0.hs_of(s, j, n, ek)
      +hsd = F.nat__lt_le_trans(s, n, VB.pw(d), hs, hn)
      +fo = f_offW(i, s, j, n, W, q, r, X, dd, pad, LR, ek, e, hd, hLR, hroom, h32, h31, ei)
      +ep = B0.PA(B0.TEP(X, i, s, q, r), DK.P2(B0.THLO(s, q, r, dd), B0.TH4(s, LR)), fo)
      +hlo = B0.PA(B0.THLO(s, q, r, dd), B0.TH4(s, LR), B0.PB(B0.TEP(X, i, s, q, r), DK.P2(B0.THLO(s, q, r, dd), B0.TH4(s, LR)), fo))
      +h4 = B0.PB(B0.THLO(s, q, r, dd), B0.TH4(s, LR), B0.PB(B0.TEP(X, i, s, q, r), DK.P2(B0.THLO(s, q, r, dd), B0.TH4(s, LR)), fo))
      +hLR0 = Equal.trans(Nat, VE2.LEN(B0.EIS(s, 1n+j, W, n, pad)), Nat.add(B0.LLN(n, W), pad), LR, len_eis(s, 1n+j, W, n, pad, ek), hLR)
      +hI1 = B0.off_bytesW(dd, D, X, q, r, hr, hd, pfD, i, s, cur, W, j, n, pad, B0, LR, hX, hLR0, hI, ec, ep, hlo, h4)
      +D1 = WD.W32X(r, dd, D, Nat.add(s, q), cur)
      +pfD1 = WD.w32x_perfect(r, dd, D, Nat.add(s, q), cur, pfD)
      +hLR1 = f_lr1W(s, j, n, W, q, r, X, dd, pad, LR, ek, e, hd, hLR, hroom, 30n, {==}, h4)
      +fe = f_elW(s, j, n, W, q, r, X, dd, pad, LR, ek, e, hd, hLR, hroom, h32, h31, hend, cur, ec, hx)
      +epe = B0.PA(B0.TEPE(X, cur, s, j, n, W, q, r), DK.P2(B0.THLE(X, cur, s, W, dd), DK.P2(B0.THFP(X, cur, s, j, n, W, LR), B0.THPZ(X, cur, s, j, W, pad))), fe)
      +fe1 = B0.PB(B0.TEPE(X, cur, s, j, n, W, q, r), DK.P2(B0.THLE(X, cur, s, W, dd), DK.P2(B0.THFP(X, cur, s, j, n, W, LR), B0.THPZ(X, cur, s, j, W, pad))), fe)
      +hle = B0.PA(B0.THLE(X, cur, s, W, dd), DK.P2(B0.THFP(X, cur, s, j, n, W, LR), B0.THPZ(X, cur, s, j, W, pad)), fe1)
      +fe2 = B0.PB(B0.THLE(X, cur, s, W, dd), DK.P2(B0.THFP(X, cur, s, j, n, W, LR), B0.THPZ(X, cur, s, j, W, pad)), fe1)
      +hfp = B0.PA(B0.THFP(X, cur, s, j, n, W, LR), B0.THPZ(X, cur, s, j, W, pad), fe2)
      +hpz = B0.PB(B0.THFP(X, cur, s, j, n, W, LR), B0.THPZ(X, cur, s, j, W, pad), fe2)
      +fx = f_elx(s, j, n, W, q, r, X, dd, pad, LR, ek, e, hd, hLR, hroom, h32, h31, hend, cur, ec, hx)
      +hle32 = B0.PA(B0.TLE32(X, cur, s, W), B0.TLE31(s, W), fx)
      +hle31 = B0.PB(B0.TLE32(X, cur, s, W), B0.TLE31(s, W), fx)
      +hze = B0.el_zero(dd, D1, X, q, r, cur, s, W, j, n, pad, B0, LR, hX, hLR1, hI1, epe, hfp, hpz)
      +hI2 = el_bytesW(dd, D1, X, q, r, hd, pfD1, cur, s, W, j, n, pad, B0, LR, hX, hx, hLR1, hI1, epe, hle, hle31, hle32, hfp, hpz)
      +Xe = U32.add(X, cur)
      +D2 = B0.PWE(x, dd, D1, B0.QX(Xe), B0.RX(Xe))
      +pfD2 = B0.pwe_perfect(x, dd, D1, B0.QX(Xe), B0.RX(Xe), pfD1)
      +ec2 = f_cntW(s, j, n, W, q, r, X, dd, pad, LR, ek, e, hd, hLR, hroom, h32, h31, cur, ec, hx)
      +ek2 = Equal.trans(Nat, Nat.add(1n+s, j), 1n+Nat.add(s, j), n, {==}, Equal.trans(Nat, 1n+Nat.add(s, j), Nat.add(s, 1n+j), n, Equal.sym(Nat, Nat.add(s, 1n+j), 1n+Nat.add(s, j), F.nat__add_succ(s, j)), ek))
      +ih = pv_goW(j, d, t, U32.add(i, 1), 1n+s, n, O.padd(cur, B0.NE(x)), dd, D2, X, q, r, pad, B0, LR, B0.inc(i, s, n, d, ei, hs, hn, hdl), ek2, e, hr, hd, pf, hdl, hn,
        B0.and_r(EOK(x), EOKS(j, W, 1n+s), hok), pfD2, hX, hLR, hend, hroom, h32, h31, ec2, hI2)
      (step_rtW(j, d, t, i, s, cur, dd, D, X, q, r, ei, pf, hdl, hsd, hr, hd, pfD, hx, ep, hlo, hle, hle31, hle32, hze,
          B0.PA(B0.RTQ(j, U32.add(i, 1), t, 1n+s, O.padd(cur, B0.NE(x)), dd, D2, X, q, r), DK.P2(B0.BYQ(j, t, 1n+s, n, O.padd(cur, B0.NE(x)), dd, D2, X, q, r, pad, B0, LR), B0.PFQ(j, t, 1n+s, O.padd(cur, B0.NE(x)), dd, D2, X, q, r)), ih)),
        B0.PB(B0.RTQ(j, U32.add(i, 1), t, 1n+s, O.padd(cur, B0.NE(x)), dd, D2, X, q, r), DK.P2(B0.BYQ(j, t, 1n+s, n, O.padd(cur, B0.NE(x)), dd, D2, X, q, r, pad, B0, LR), B0.PFQ(j, t, 1n+s, O.padd(cur, B0.NE(x)), dd, D2, X, q, r)), ih))

def putx_lbW(+b: Bool, +t: F.array__Tree<B0.MB<EM.MW>>, +N: U32, +eb: {U32.is_eq(N, 0) == b : Bool}, +h: {OKL(t, N) == True{} : Bool},
    +dd: Nat, +D: F.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat,
    +e: {U32.to_nat(X) == Nat.add(A.quad(q), r) : Nat}, +hr: {Nat.is_lt(r, 4n) == True{} : Bool}, +hd: {Nat.is_lt(dd, 31n) == True{} : Bool},
    +hl: {Nat.is_le(Nat.add(q, WD.NWN(Nat.add(r, B0.LL(t, N)))), VB.pw(dd)) == True{} : Bool}, +hs31: {Nat.is_le(B0.LL(t, N), U32.to_nat(VB.NMAX())) == True{} : Bool}, +hl32: {Nat.is_lt(Nat.add(A.quad(q), Nat.add(r, B0.LL(t, N))), F.spec_common__pow2(32n)) == True{} : Bool}, +pf: {F.array__perfect(U32, dd, D) == True{} : Bool},
    +hz: {VS.bt(Nat.add(B0.LL(t, N), WD.PADB(r, B0.LL(t, N))), VS.bdr(Nat.add(A.quad(q), r), UA.BYT(D))) == UW.ZB(Nat.add(B0.LL(t, N), WD.PADB(r, B0.LL(t, N)))) : +List<U32>})
    -> DK.P2(B0.RTLb(b, t, N, dd, D, X, q, r), DK.P2(B0.BYLb(b, t, N, dd, D, X, q, r), B0.PFLb(b, t, N, dd, D, X, q, r))):
  match b:
    case True{}:
      +eN = VVU.eqt(N, 0, eb)
      +W = B0.SL(t)
      +P0 = WD.PADB(r, 0n)
      +by0 = UW.inv_init(UA.BYT(D), Nat.add(A.quad(q), r), P0, UW.ZB(P0),
        F.logic__subst(Nat, z => {VS.bt(Nat.add(B0.LLN(z, W), WD.PADB(r, B0.LLN(z, W))), VS.bdr(Nat.add(A.quad(q), r), UA.BYT(D))) == UW.ZB(Nat.add(B0.LLN(z, W), WD.PADB(r, B0.LLN(z, W)))) : +List<U32>}, U32.to_nat(N), 0n, eN, hz),
        VE2.bt_zb_le(P0, P0, F.nat__le_refl(P0)))
      +by1 = F.logic__subst(+List<U32>, z => {UA.BYT(D) == UW.SPL(UA.BYT(D), Nat.add(A.quad(q), r), z) : +List<U32>}, VS.bt(P0, UW.ZB(P0)), UW.ZB(P0), VE2.bt_zb_le(P0, P0, F.nat__le_refl(P0)), by0)
      ({==}, (F.logic__subst(Nat, z => {UA.BYT(D) == UW.SPL(UA.BYT(D), Nat.add(A.quad(q), r), VE2.APP(VE2.APP(VVL.OFFS(B0.YS(z, W, 0n), A.quad(z)), VR.bcat(B0.YS(z, W, 0n))), UW.ZB(WD.PADB(r, B0.LLN(z, W))))) : +List<U32>},
          0n, U32.to_nat(N), Equal.sym(Nat, U32.to_nat(N), 0n, eN), by1), pf))
    case False{}:
      +n = U32.to_nat(N)
      +W = B0.SL(t)
      +L = B0.LL(t, N)
      +pad = WD.PADB(r, L)
      +LR = Nat.add(L, pad)
      +X0 = Nat.add(A.quad(q), r)
      +ee = e_end(q, r, L)
      +hroom = F.logic__subst(Nat, z => {Nat.is_le(z, A.quad(VB.pw(dd))) == True{} : Bool}, A.quad(Nat.add(q, WD.NWN(Nat.add(r, L)))), Nat.add(X0, LR), Equal.sym(Nat, Nat.add(X0, LR), A.quad(Nat.add(q, WD.NWN(Nat.add(r, L)))), ee),
        UW.quad_le(Nat.add(q, WD.NWN(Nat.add(r, L))), VB.pw(dd), hl))
      +hX = F.logic__subst(Nat, z => {Nat.is_le(X0, z) == True{} : Bool}, A.quad(VB.pw(dd)), VE2.LEN(UA.BYT(D)), Equal.sym(Nat, VE2.LEN(UA.BYT(D)), A.quad(VB.pw(dd)), B0.len_byt(dd, D, pf)),
        F.nat__le_trans(X0, Nat.add(X0, LR), A.quad(VB.pw(dd)), Order.below_sum(X0, LR), hroom))
      +hqn = F.nat__le_trans(A.quad(n), L, U32.to_nat(VB.NMAX()), Order.below_sum(A.quad(n), B0.BL(n, W, 0n)), hs31)
      +ec = Equal.trans(Nat, U32.to_nat(U32.mul(4, N)), A.quad(n), Nat.add(A.quad(n), B0.BL(0n, W, 0n)), VVU.mul4(N, VB.UMAX(), B0.u31(A.quad(n), hqn)), Equal.sym(Nat, Nat.add(A.quad(n), 0n), A.quad(n), F.nat__add_zero(A.quad(n))))
      +hI0 = UW.inv_init(UA.BYT(D), X0, LR, B0.EIS(0n, n, W, n, pad), hz, B0.ei0(t, N, pad))
      +h32 = F.logic__subst(Nat, z => {Nat.is_lt(z, F.spec_common__pow2(32n)) == True{} : Bool}, Nat.add(A.quad(q), Nat.add(r, L)), Nat.add(X0, B0.LLN(n, W)),
        Equal.sym(Nat, Nat.add(X0, B0.LLN(n, W)), Nat.add(A.quad(q), Nat.add(r, L)), F.nat__add_assoc(A.quad(q), r, L)), hl32)
      +h31 = F.logic__subst(Nat, z => {Nat.is_le(z, U32.to_nat(VB.NMAX())) == True{} : Bool}, L, B0.LLN(n, W), {==}, hs31)
      +g = pv_goW(n, B0.TDM(t), t, 0, 0n, n, U32.mul(4, N), dd, D, X, q, r, pad, UA.BYT(D), LR, {==}, {==}, e, hr, hd, okl_pf(t, N, h), okl_d(t, N, h), okl_n(t, N, h), okl_e(t, N, h),
        pf, hX, {==}, e_end2(q, r, L), hroom, h32, h31, ec, hI0)
      +rt = B0.PA(B0.RTQ(n, 0, t, 0n, U32.mul(4, N), dd, D, X, q, r), DK.P2(B0.BYQ(n, t, 0n, n, U32.mul(4, N), dd, D, X, q, r, pad, UA.BYT(D), LR), B0.PFQ(n, t, 0n, U32.mul(4, N), dd, D, X, q, r)), g)
      +g2 = B0.PB(B0.RTQ(n, 0, t, 0n, U32.mul(4, N), dd, D, X, q, r), DK.P2(B0.BYQ(n, t, 0n, n, U32.mul(4, N), dd, D, X, q, r, pad, UA.BYT(D), LR), B0.PFQ(n, t, 0n, U32.mul(4, N), dd, D, X, q, r)), g)
      +by = B0.PA(B0.BYQ(n, t, 0n, n, U32.mul(4, N), dd, D, X, q, r, pad, UA.BYT(D), LR), B0.PFQ(n, t, 0n, U32.mul(4, N), dd, D, X, q, r), g2)
      +pw = B0.PB(B0.BYQ(n, t, 0n, n, U32.mul(4, N), dd, D, X, q, r, pad, UA.BYT(D), LR), B0.PFQ(n, t, 0n, U32.mul(4, N), dd, D, X, q, r), g2)
      (B0.putx_rt_f(t, N, dd, D, X, q, r, rt),
        (F.logic__subst(+List<U32>, z => {UA.BYT(B0.WLM(n, W, 0n, U32.mul(4, N), dd, D, X, q, r)) == UW.SPL(UA.BYT(D), X0, z) : +List<U32>}, VS.bt(LR, B0.EIS(n, 0n, W, n, pad)), VE2.APP(B0.ENCL(t, N), UW.ZB(pad)), eisn(t, N, pad), by),
         pw))

def putlW(+t: F.array__Tree<B0.MB<EM.MW>>, +N: U32, +h: {OKL(t, N) == True{} : Bool}, +dd: Nat, +D: F.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat,
    +e: {U32.to_nat(X) == Nat.add(A.quad(q), r) : Nat}, +hr: {Nat.is_lt(r, 4n) == True{} : Bool}, +hd: {Nat.is_lt(dd, 31n) == True{} : Bool},
    +hl: {Nat.is_le(Nat.add(q, WD.NWN(Nat.add(r, B0.LL(t, N)))), VB.pw(dd)) == True{} : Bool}, +hs31: {Nat.is_le(B0.LL(t, N), U32.to_nat(VB.NMAX())) == True{} : Bool}, +hl32: {Nat.is_lt(Nat.add(A.quad(q), Nat.add(r, B0.LL(t, N))), F.spec_common__pow2(32n)) == True{} : Bool}, +pf: {F.array__perfect(U32, dd, D) == True{} : Bool},
    +hz: {VS.bt(Nat.add(B0.LL(t, N), WD.PADB(r, B0.LL(t, N))), VS.bdr(Nat.add(A.quad(q), r), UA.BYT(D))) == UW.ZB(Nat.add(B0.LL(t, N), WD.PADB(r, B0.LL(t, N)))) : +List<U32>})
    -> DK.P2(B0.RTL(t, N, dd, D, X, q, r), DK.P2(B0.BYLb(U32.is_eq(N, 0), t, N, dd, D, X, q, r), B0.PFLb(U32.is_eq(N, 0), t, N, dd, D, X, q, r))):
  +b = U32.is_eq(N, 0)
  +g = putx_lbW(b, t, N, {==}, h, dd, D, X, q, r, e, hr, hd, hl, hs31, hl32, pf, hz)
  (putk_rt(t, N, h, dd, D, X, q, r, B0.PA(B0.RTLb(b, t, N, dd, D, X, q, r), DK.P2(B0.BYLb(b, t, N, dd, D, X, q, r), B0.PFLb(b, t, N, dd, D, X, q, r)), g)),
    B0.PB(B0.RTLb(b, t, N, dd, D, X, q, r), DK.P2(B0.BYLb(b, t, N, dd, D, X, q, r), B0.PFLb(b, t, N, dd, D, X, q, r)), g))

# ---- sizes ----------------------------------------------------------------------------------------

def sza_val(+k: Nat, +W: List<&2, B0.MB<EM.MW>>, +s: Nat, +cur: U32, +kx: Nat, +ek: {kx == 30n : Nat}, +hok: {EOKS(k, W, s) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(U32.to_nat(cur), B0.BL(k, W, s)), VB.pw(kx)) == True{} : Bool})
    -> {U32.to_nat(B0.SZA(k, W, s, cur)) == Nat.add(U32.to_nat(cur), B0.BL(k, W, s)) : Nat}:
  match k:
    case 0n: Equal.sym(Nat, Nat.add(U32.to_nat(cur), 0n), U32.to_nat(cur), F.nat__add_zero(U32.to_nat(cur)))
    case 1n+ +j:
      +x = B0.xat_pl_VarTestStruct(W, s)
      +hx = B0.and_l(EOK(x), EOKS(j, W, 1n+s), hok)
      +Nx = U32.to_nat(B0.NE(x))
      +ebl = Equal.trans(Nat, B0.BL(1n+j, W, s), Nat.add(VE2.LEN(B0.YE(x)), B0.BL(j, W, 1n+s)), Nat.add(Nx, B0.BL(j, W, 1n+s)), B0.bl_cons(j, W, s),
        Equal.cong(Nat, Nat, z => Nat.add(z, B0.BL(j, W, 1n+s)), VE2.LEN(B0.YE(x)), Nx, len_ye(x, hx)))
      +ea = Equal.trans(Nat, Nat.add(U32.to_nat(cur), B0.BL(1n+j, W, s)), Nat.add(U32.to_nat(cur), Nat.add(Nx, B0.BL(j, W, 1n+s))), Nat.add(Nat.add(U32.to_nat(cur), Nx), B0.BL(j, W, 1n+s)),
        Equal.cong(Nat, Nat, z => Nat.add(U32.to_nat(cur), z), B0.BL(1n+j, W, s), Nat.add(Nx, B0.BL(j, W, 1n+s)), ebl),
        Equal.sym(Nat, Nat.add(Nat.add(U32.to_nat(cur), Nx), B0.BL(j, W, 1n+s)), Nat.add(U32.to_nat(cur), Nat.add(Nx, B0.BL(j, W, 1n+s))), F.nat__add_assoc(U32.to_nat(cur), Nx, B0.BL(j, W, 1n+s))))
      +hb2 = F.logic__subst(Nat, z => {Nat.is_le(z, VB.pw(kx)) == True{} : Bool}, Nat.add(U32.to_nat(cur), B0.BL(1n+j, W, s)), Nat.add(Nat.add(U32.to_nat(cur), Nx), B0.BL(j, W, 1n+s)), ea, hb)
      +hcn = F.nat__le_trans(Nat.add(U32.to_nat(cur), Nx), Nat.add(Nat.add(U32.to_nat(cur), Nx), B0.BL(j, W, 1n+s)), VB.pw(kx), Order.below_sum(Nat.add(U32.to_nat(cur), Nx), B0.BL(j, W, 1n+s)), hb2)
      +ep = B0.padd_nat(cur, B0.NE(x), B0.t31s(Nat.add(U32.to_nat(cur), Nx), kx, ek, B0.bsuc(Nat.add(U32.to_nat(cur), Nx), kx, hcn)))
      +ih = sza_val(j, W, 1n+s, O.padd(cur, B0.NE(x)), kx, ek, B0.and_r(EOK(x), EOKS(j, W, 1n+s), hok),
        F.logic__subst(Nat, z => {Nat.is_le(Nat.add(z, B0.BL(j, W, 1n+s)), VB.pw(kx)) == True{} : Bool}, Nat.add(U32.to_nat(cur), Nx), U32.to_nat(O.padd(cur, B0.NE(x))), Equal.sym(Nat, U32.to_nat(O.padd(cur, B0.NE(x))), Nat.add(U32.to_nat(cur), Nx), ep), hb2))
      Equal.trans(Nat, U32.to_nat(B0.SZA(j, W, 1n+s, O.padd(cur, B0.NE(x)))), Nat.add(U32.to_nat(O.padd(cur, B0.NE(x))), B0.BL(j, W, 1n+s)), Nat.add(U32.to_nat(cur), B0.BL(1n+j, W, s)), ih,
        Equal.trans(Nat, Nat.add(U32.to_nat(O.padd(cur, B0.NE(x))), B0.BL(j, W, 1n+s)), Nat.add(Nat.add(U32.to_nat(cur), Nx), B0.BL(j, W, 1n+s)), Nat.add(U32.to_nat(cur), B0.BL(1n+j, W, s)),
          Equal.cong(Nat, Nat, z => Nat.add(z, B0.BL(j, W, 1n+s)), U32.to_nat(O.padd(cur, B0.NE(x))), Nat.add(U32.to_nat(cur), Nx), ep), Equal.sym(Nat, Nat.add(U32.to_nat(cur), B0.BL(1n+j, W, s)), Nat.add(Nat.add(U32.to_nat(cur), Nx), B0.BL(j, W, 1n+s)), ea)))

def szwb_val(+b: Bool, +t: F.array__Tree<B0.MB<EM.MW>>, +N: U32, +eb: {U32.is_eq(N, 0) == b : Bool}, +h: {OKL(t, N) == True{} : Bool}, +kx: Nat, +ek: {kx == 30n : Nat},
    +hb: {Nat.is_le(B0.LL(t, N), VB.pw(kx)) == True{} : Bool}) -> {U32.to_nat(B0.SZWb(b, t, N)) == B0.LL(t, N) : Nat}:
  match b:
    case True{}:
      +eN = VVU.eqt(N, 0, eb)
      F.logic__subst(Nat, z => {0n == B0.LLN(z, B0.SL(t)) : Nat}, 0n, U32.to_nat(N), Equal.sym(Nat, U32.to_nat(N), 0n, eN), {==})
    case False{}:
      +n = U32.to_nat(N)
      +hq = F.nat__le_trans(A.quad(n), B0.LL(t, N), VB.pw(kx), Order.below_sum(A.quad(n), B0.BL(n, B0.SL(t), 0n)), hb)
      +em = B0.mul4k(N, kx, ek, hq)
      Equal.trans(Nat, U32.to_nat(B0.SZA(n, B0.SL(t), 0n, U32.mul(4, N))), Nat.add(U32.to_nat(U32.mul(4, N)), B0.BL(n, B0.SL(t), 0n)), B0.LL(t, N),
        sza_val(n, B0.SL(t), 0n, U32.mul(4, N), kx, ek, okl_e(t, N, h),
          F.logic__subst(Nat, z => {Nat.is_le(Nat.add(z, B0.BL(n, B0.SL(t), 0n)), VB.pw(kx)) == True{} : Bool}, A.quad(n), U32.to_nat(U32.mul(4, N)), Equal.sym(Nat, U32.to_nat(U32.mul(4, N)), A.quad(n), em), hb)),
        Equal.cong(Nat, Nat, z => Nat.add(z, B0.BL(n, B0.SL(t), 0n)), U32.to_nat(U32.mul(4, N)), A.quad(n), em))

# szx: the size the writer returns is the list's byte count.
def szl(+t: F.array__Tree<B0.MB<EM.MW>>, +N: U32, +h: {OKL(t, N) == True{} : Bool}, +kx: Nat, +ek: {kx == 30n : Nat},
    +hb: {Nat.is_le(B0.LL(t, N), VB.pw(kx)) == True{} : Bool}) -> {U32.to_nat(B0.SZW(t, N)) == B0.LL(t, N) : Nat}:
  szwb_val(U32.is_eq(N, 0), t, N, {==}, h, kx, ek, hb)

# The runtime's size pass.
def sizexb(+b: Bool, +t: F.array__Tree<B0.MB<EM.MW>>, +N: U32, +h: {OKL(t, N) == True{} : Bool})
    -> {proglist_VarTestStruct_e.pl_VarTestStruct_sz_nz(b, B0.AR(t), N) == (B0.THL(t, N), B0.SZSb(b, t, N)) : proglist_VarTestStruct_d.pl_VarTestStruct_Seq & U32}:
  match b:
    case True{}: {==}
    case False{}:
      %Equal.sym(Array<O.Boxed<VarTestStruct_d.VarTestStruct>> & (U32 & O.Boxed<VarTestStruct_d.VarTestStruct>), proglist_VarTestStruct_e.pl_VarTestStruct_sz(U32.to_nat(N), 0, (B0.AR(t), (0, O.BNone{}))), (B0.AR(t), (B0.SZA(U32.to_nat(N), B0.SL(t), 0n, 0), O.BNone{})),
          sz_go(U32.to_nat(N), B0.TDM(t), t, 0, 0n, U32.to_nat(N), 0, {==}, {==}, okl_pf(t, N, h), okl_d(t, N, h), okl_n(t, N, h), okl_e(t, N, h))) :
        {proglist_VarTestStruct_e.pl_VarTestStruct_sz_fin(N, _) == (B0.THL(t, N), B0.SZSb(False{}, t, N)) : proglist_VarTestStruct_d.pl_VarTestStruct_Seq & U32}
      {==}

def sizel(+t: F.array__Tree<B0.MB<EM.MW>>, +N: U32, +h: {OKL(t, N) == True{} : Bool}) -> {proglist_VarTestStruct_e.pl_VarTestStruct_size(B0.THL(t, N)) == (B0.THL(t, N), B0.SZS(t, N)) : proglist_VarTestStruct_d.pl_VarTestStruct_Seq & U32}:
  %Equal.sym(Array<O.Boxed<VarTestStruct_d.VarTestStruct>> & U32, Array.size(O.Boxed<VarTestStruct_d.VarTestStruct>, B0.AR(t)), (B0.AR(t), F.u32__pow2u(B0.TDM(t))), B0.amsize_pl_VarTestStruct(B0.TDM(t), t, okl_pf(t, N, h))) :
    {proglist_VarTestStruct_e.pl_VarTestStruct_sz_cap(N, _) == (B0.THL(t, N), B0.SZS(t, N)) : proglist_VarTestStruct_d.pl_VarTestStruct_Seq & U32}
  %Equal.sym(Bool, U32.is_le(N, F.u32__pow2u(B0.TDM(t))), True{}, le_cap(t, N, h)) :
    {proglist_VarTestStruct_e.pl_VarTestStruct_sz_ok(_, B0.AR(t), N) == (B0.THL(t, N), B0.SZS(t, N)) : proglist_VarTestStruct_d.pl_VarTestStruct_Seq & U32}
  sizexb(U32.is_eq(N, 0), t, N, h)

def szsb_val(+b: Bool, +t: F.array__Tree<B0.MB<EM.MW>>, +N: U32, +eb: {U32.is_eq(N, 0) == b : Bool}, +h: {OKL(t, N) == True{} : Bool}, +kx: Nat, +ek: {kx == 30n : Nat},
    +hb: {Nat.is_le(B0.LL(t, N), VB.pw(kx)) == True{} : Bool}) -> {U32.to_nat(B0.SZSb(b, t, N)) == B0.LL(t, N) : Nat}:
  match b:
    case True{}:
      +eN = VVU.eqt(N, 0, eb)
      F.logic__subst(Nat, z => {0n == B0.LLN(z, B0.SL(t)) : Nat}, 0n, U32.to_nat(N), Equal.sym(Nat, U32.to_nat(N), 0n, eN), {==})
    case False{}:
      +n = U32.to_nat(N)
      +BLn = B0.BL(n, B0.SL(t), 0n)
      +hq = F.nat__le_trans(A.quad(n), B0.LL(t, N), VB.pw(kx), Order.below_sum(A.quad(n), BLn), hb)
      +em = B0.mul4k(N, kx, ek, hq)
      +hBL = F.nat__le_trans(BLn, B0.LL(t, N), VB.pw(kx), Order.left_below_sum(A.quad(n), BLn), hb)
      +es = sza_val(n, B0.SL(t), 0n, 0, kx, ek, okl_e(t, N, h), hBL)
      +hsum = F.logic__subst(Nat, z => {Nat.is_le(z, VB.pw(kx)) == True{} : Bool}, B0.LL(t, N), Nat.add(U32.to_nat(U32.mul(4, N)), U32.to_nat(B0.SZA(n, B0.SL(t), 0n, 0))),
        Equal.trans(Nat, B0.LL(t, N), Nat.add(A.quad(n), U32.to_nat(B0.SZA(n, B0.SL(t), 0n, 0))), Nat.add(U32.to_nat(U32.mul(4, N)), U32.to_nat(B0.SZA(n, B0.SL(t), 0n, 0))),
          Equal.cong(Nat, Nat, z => Nat.add(A.quad(n), z), BLn, U32.to_nat(B0.SZA(n, B0.SL(t), 0n, 0)), Equal.sym(Nat, U32.to_nat(B0.SZA(n, B0.SL(t), 0n, 0)), BLn, es)),
          Equal.cong(Nat, Nat, z => Nat.add(z, U32.to_nat(B0.SZA(n, B0.SL(t), 0n, 0))), A.quad(n), U32.to_nat(U32.mul(4, N)), Equal.sym(Nat, U32.to_nat(U32.mul(4, N)), A.quad(n), em))), hb)
      +qN = B0.t31(A.quad(n), kx, ek, B0.lsuc(A.quad(n), kx, hq))
      F.logic__subst(U32, z => {U32.to_nat(O.padd(z, B0.SZA(n, B0.SL(t), 0n, 0))) == B0.LL(t, N) : Nat}, U32.mul(4, N), O.mul4c(N), Equal.sym(U32, O.mul4c(N), U32.mul(4, N), VE.mul4c_q(N, qN)),
      Equal.trans(Nat, U32.to_nat(O.padd(U32.mul(4, N), B0.SZA(n, B0.SL(t), 0n, 0))), Nat.add(U32.to_nat(U32.mul(4, N)), U32.to_nat(B0.SZA(n, B0.SL(t), 0n, 0))), B0.LL(t, N),
        B0.padd_nat(U32.mul(4, N), B0.SZA(n, B0.SL(t), 0n, 0), B0.t31s(Nat.add(U32.to_nat(U32.mul(4, N)), U32.to_nat(B0.SZA(n, B0.SL(t), 0n, 0))), kx, ek, B0.bsuc(Nat.add(U32.to_nat(U32.mul(4, N)), U32.to_nat(B0.SZA(n, B0.SL(t), 0n, 0))), kx, hsum))),
        Equal.trans(Nat, Nat.add(U32.to_nat(U32.mul(4, N)), U32.to_nat(B0.SZA(n, B0.SL(t), 0n, 0))), Nat.add(A.quad(n), BLn), B0.LL(t, N),
          Equal.trans(Nat, Nat.add(U32.to_nat(U32.mul(4, N)), U32.to_nat(B0.SZA(n, B0.SL(t), 0n, 0))), Nat.add(A.quad(n), U32.to_nat(B0.SZA(n, B0.SL(t), 0n, 0))), Nat.add(A.quad(n), BLn),
            Equal.cong(Nat, Nat, z => Nat.add(z, U32.to_nat(B0.SZA(n, B0.SL(t), 0n, 0))), U32.to_nat(U32.mul(4, N)), A.quad(n), em),
            Equal.cong(Nat, Nat, z => Nat.add(A.quad(n), z), U32.to_nat(B0.SZA(n, B0.SL(t), 0n, 0)), BLn, es)),
          {==})))

def szs(+t: F.array__Tree<B0.MB<EM.MW>>, +N: U32, +h: {OKL(t, N) == True{} : Bool}, +kx: Nat, +ek: {kx == 30n : Nat},
    +hb: {Nat.is_le(B0.LL(t, N), VB.pw(kx)) == True{} : Bool}) -> {U32.to_nat(B0.SZS(t, N)) == B0.LL(t, N) : Nat}:
  szsb_val(U32.is_eq(N, 0), t, N, {==}, h, kx, ek, hb)

# The sizes at a list length below 2^31 (strict: any output depth; the runtime's poison bit is 2^31).
def sza_valS(+k: Nat, +W: List<&2, B0.MB<EM.MW>>, +s: Nat, +cur: U32, +hok: {EOKS(k, W, s) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(U32.to_nat(cur), B0.BL(k, W, s)), U32.to_nat(VB.NMAX())) == True{} : Bool})
    -> {U32.to_nat(B0.SZA(k, W, s, cur)) == Nat.add(U32.to_nat(cur), B0.BL(k, W, s)) : Nat}:
  match k:
    case 0n: Equal.sym(Nat, Nat.add(U32.to_nat(cur), 0n), U32.to_nat(cur), F.nat__add_zero(U32.to_nat(cur)))
    case 1n+ +j:
      +x = B0.xat_pl_VarTestStruct(W, s)
      +hx = B0.and_l(EOK(x), EOKS(j, W, 1n+s), hok)
      +Nx = U32.to_nat(B0.NE(x))
      +ebl = Equal.trans(Nat, B0.BL(1n+j, W, s), Nat.add(VE2.LEN(B0.YE(x)), B0.BL(j, W, 1n+s)), Nat.add(Nx, B0.BL(j, W, 1n+s)), B0.bl_cons(j, W, s),
        Equal.cong(Nat, Nat, z => Nat.add(z, B0.BL(j, W, 1n+s)), VE2.LEN(B0.YE(x)), Nx, len_ye(x, hx)))
      +ea = Equal.trans(Nat, Nat.add(U32.to_nat(cur), B0.BL(1n+j, W, s)), Nat.add(U32.to_nat(cur), Nat.add(Nx, B0.BL(j, W, 1n+s))), Nat.add(Nat.add(U32.to_nat(cur), Nx), B0.BL(j, W, 1n+s)),
        Equal.cong(Nat, Nat, z => Nat.add(U32.to_nat(cur), z), B0.BL(1n+j, W, s), Nat.add(Nx, B0.BL(j, W, 1n+s)), ebl),
        Equal.sym(Nat, Nat.add(Nat.add(U32.to_nat(cur), Nx), B0.BL(j, W, 1n+s)), Nat.add(U32.to_nat(cur), Nat.add(Nx, B0.BL(j, W, 1n+s))), F.nat__add_assoc(U32.to_nat(cur), Nx, B0.BL(j, W, 1n+s))))
      +hb2 = F.logic__subst(Nat, z => {Nat.is_le(z, U32.to_nat(VB.NMAX())) == True{} : Bool}, Nat.add(U32.to_nat(cur), B0.BL(1n+j, W, s)), Nat.add(Nat.add(U32.to_nat(cur), Nx), B0.BL(j, W, 1n+s)), ea, hb)
      +hcn = F.nat__le_trans(Nat.add(U32.to_nat(cur), Nx), Nat.add(Nat.add(U32.to_nat(cur), Nx), B0.BL(j, W, 1n+s)), U32.to_nat(VB.NMAX()), Order.below_sum(Nat.add(U32.to_nat(cur), Nx), B0.BL(j, W, 1n+s)), hb2)
      +ep = B0.padd_nat(cur, B0.NE(x), hcn)
      +ih = sza_valS(j, W, 1n+s, O.padd(cur, B0.NE(x)), B0.and_r(EOK(x), EOKS(j, W, 1n+s), hok),
        F.logic__subst(Nat, z => {Nat.is_le(Nat.add(z, B0.BL(j, W, 1n+s)), U32.to_nat(VB.NMAX())) == True{} : Bool}, Nat.add(U32.to_nat(cur), Nx), U32.to_nat(O.padd(cur, B0.NE(x))), Equal.sym(Nat, U32.to_nat(O.padd(cur, B0.NE(x))), Nat.add(U32.to_nat(cur), Nx), ep), hb2))
      Equal.trans(Nat, U32.to_nat(B0.SZA(j, W, 1n+s, O.padd(cur, B0.NE(x)))), Nat.add(U32.to_nat(O.padd(cur, B0.NE(x))), B0.BL(j, W, 1n+s)), Nat.add(U32.to_nat(cur), B0.BL(1n+j, W, s)), ih,
        Equal.trans(Nat, Nat.add(U32.to_nat(O.padd(cur, B0.NE(x))), B0.BL(j, W, 1n+s)), Nat.add(Nat.add(U32.to_nat(cur), Nx), B0.BL(j, W, 1n+s)), Nat.add(U32.to_nat(cur), B0.BL(1n+j, W, s)),
          Equal.cong(Nat, Nat, z => Nat.add(z, B0.BL(j, W, 1n+s)), U32.to_nat(O.padd(cur, B0.NE(x))), Nat.add(U32.to_nat(cur), Nx), ep), Equal.sym(Nat, Nat.add(U32.to_nat(cur), B0.BL(1n+j, W, s)), Nat.add(Nat.add(U32.to_nat(cur), Nx), B0.BL(j, W, 1n+s)), ea)))

def szwb_valS(+b: Bool, +t: F.array__Tree<B0.MB<EM.MW>>, +N: U32, +eb: {U32.is_eq(N, 0) == b : Bool}, +h: {OKL(t, N) == True{} : Bool},
    +hb: {Nat.is_le(B0.LL(t, N), U32.to_nat(VB.NMAX())) == True{} : Bool}) -> {U32.to_nat(B0.SZWb(b, t, N)) == B0.LL(t, N) : Nat}:
  match b:
    case True{}:
      +eN = VVU.eqt(N, 0, eb)
      F.logic__subst(Nat, z => {0n == B0.LLN(z, B0.SL(t)) : Nat}, 0n, U32.to_nat(N), Equal.sym(Nat, U32.to_nat(N), 0n, eN), {==})
    case False{}:
      +n = U32.to_nat(N)
      +hq = F.nat__le_trans(A.quad(n), B0.LL(t, N), U32.to_nat(VB.NMAX()), Order.below_sum(A.quad(n), B0.BL(n, B0.SL(t), 0n)), hb)
      +em = VVU.mul4(N, VB.UMAX(), B0.u31(A.quad(n), hq))
      Equal.trans(Nat, U32.to_nat(B0.SZA(n, B0.SL(t), 0n, U32.mul(4, N))), Nat.add(U32.to_nat(U32.mul(4, N)), B0.BL(n, B0.SL(t), 0n)), B0.LL(t, N),
        sza_valS(n, B0.SL(t), 0n, U32.mul(4, N), okl_e(t, N, h),
          F.logic__subst(Nat, z => {Nat.is_le(Nat.add(z, B0.BL(n, B0.SL(t), 0n)), U32.to_nat(VB.NMAX())) == True{} : Bool}, A.quad(n), U32.to_nat(U32.mul(4, N)), Equal.sym(Nat, U32.to_nat(U32.mul(4, N)), A.quad(n), em), hb)),
        Equal.cong(Nat, Nat, z => Nat.add(z, B0.BL(n, B0.SL(t), 0n)), U32.to_nat(U32.mul(4, N)), A.quad(n), em))

def szlS(+t: F.array__Tree<B0.MB<EM.MW>>, +N: U32, +h: {OKL(t, N) == True{} : Bool},
    +hb: {Nat.is_le(B0.LL(t, N), U32.to_nat(VB.NMAX())) == True{} : Bool}) -> {U32.to_nat(B0.SZW(t, N)) == B0.LL(t, N) : Nat}:
  szwb_valS(U32.is_eq(N, 0), t, N, {==}, h, hb)

def szsb_valS(+b: Bool, +t: F.array__Tree<B0.MB<EM.MW>>, +N: U32, +eb: {U32.is_eq(N, 0) == b : Bool}, +h: {OKL(t, N) == True{} : Bool},
    +hb: {Nat.is_le(B0.LL(t, N), U32.to_nat(VB.NMAX())) == True{} : Bool}) -> {U32.to_nat(B0.SZSb(b, t, N)) == B0.LL(t, N) : Nat}:
  match b:
    case True{}:
      +eN = VVU.eqt(N, 0, eb)
      F.logic__subst(Nat, z => {0n == B0.LLN(z, B0.SL(t)) : Nat}, 0n, U32.to_nat(N), Equal.sym(Nat, U32.to_nat(N), 0n, eN), {==})
    case False{}:
      +n = U32.to_nat(N)
      +BLn = B0.BL(n, B0.SL(t), 0n)
      +hq = F.nat__le_trans(A.quad(n), B0.LL(t, N), U32.to_nat(VB.NMAX()), Order.below_sum(A.quad(n), BLn), hb)
      +em = VVU.mul4(N, VB.UMAX(), B0.u31(A.quad(n), hq))
      +hBL = F.nat__le_trans(BLn, B0.LL(t, N), U32.to_nat(VB.NMAX()), Order.left_below_sum(A.quad(n), BLn), hb)
      +es = sza_valS(n, B0.SL(t), 0n, 0, okl_e(t, N, h), hBL)
      +hsum = F.logic__subst(Nat, z => {Nat.is_le(z, U32.to_nat(VB.NMAX())) == True{} : Bool}, B0.LL(t, N), Nat.add(U32.to_nat(U32.mul(4, N)), U32.to_nat(B0.SZA(n, B0.SL(t), 0n, 0))),
        Equal.trans(Nat, B0.LL(t, N), Nat.add(A.quad(n), U32.to_nat(B0.SZA(n, B0.SL(t), 0n, 0))), Nat.add(U32.to_nat(U32.mul(4, N)), U32.to_nat(B0.SZA(n, B0.SL(t), 0n, 0))),
          Equal.cong(Nat, Nat, z => Nat.add(A.quad(n), z), BLn, U32.to_nat(B0.SZA(n, B0.SL(t), 0n, 0)), Equal.sym(Nat, U32.to_nat(B0.SZA(n, B0.SL(t), 0n, 0)), BLn, es)),
          Equal.cong(Nat, Nat, z => Nat.add(z, U32.to_nat(B0.SZA(n, B0.SL(t), 0n, 0))), A.quad(n), U32.to_nat(U32.mul(4, N)), Equal.sym(Nat, U32.to_nat(U32.mul(4, N)), A.quad(n), em))), hb)
      F.logic__subst(U32, z => {U32.to_nat(O.padd(z, B0.SZA(n, B0.SL(t), 0n, 0))) == B0.LL(t, N) : Nat}, U32.mul(4, N), O.mul4c(N), Equal.sym(U32, O.mul4c(N), U32.mul(4, N), VE.mul4c_q(N, hq)),
      Equal.trans(Nat, U32.to_nat(O.padd(U32.mul(4, N), B0.SZA(n, B0.SL(t), 0n, 0))), Nat.add(U32.to_nat(U32.mul(4, N)), U32.to_nat(B0.SZA(n, B0.SL(t), 0n, 0))), B0.LL(t, N),
        B0.padd_nat(U32.mul(4, N), B0.SZA(n, B0.SL(t), 0n, 0), hsum),
        Equal.trans(Nat, Nat.add(U32.to_nat(U32.mul(4, N)), U32.to_nat(B0.SZA(n, B0.SL(t), 0n, 0))), Nat.add(A.quad(n), BLn), B0.LL(t, N),
          Equal.trans(Nat, Nat.add(U32.to_nat(U32.mul(4, N)), U32.to_nat(B0.SZA(n, B0.SL(t), 0n, 0))), Nat.add(A.quad(n), U32.to_nat(B0.SZA(n, B0.SL(t), 0n, 0))), Nat.add(A.quad(n), BLn),
            Equal.cong(Nat, Nat, z => Nat.add(z, U32.to_nat(B0.SZA(n, B0.SL(t), 0n, 0))), U32.to_nat(U32.mul(4, N)), A.quad(n), em),
            Equal.cong(Nat, Nat, z => Nat.add(A.quad(n), z), U32.to_nat(B0.SZA(n, B0.SL(t), 0n, 0)), BLn, es)),
          {==})))

def szsS(+t: F.array__Tree<B0.MB<EM.MW>>, +N: U32, +h: {OKL(t, N) == True{} : Bool},
    +hb: {Nat.is_le(B0.LL(t, N), U32.to_nat(VB.NMAX())) == True{} : Bool}) -> {U32.to_nat(B0.SZS(t, N)) == B0.LL(t, N) : Nat}:
  szsb_valS(U32.is_eq(N, 0), t, N, {==}, h, hb)

# ---- the spec side ---------------------------------------------------------------------------------

def dom_ye(+m: B0.MB<EM.MW>, +h: {EOK(m) == True{} : Bool}) -> {SP.bytes_domain(B0.YE(m)) == True{} : Bool}:
  match m:
    case B0.MNone{}: {==}
    case B0.MSome{+w}: EM.domxO(w, h)

# One element's spec parts: its bytes, one variable part.
def el_parts(+m: B0.MB<EM.MW>, +h: {EOK(m) == True{} : Bool}) -> {Codec.parts(B0.EV(m), Spec.VarTestStruct()) == Some{[S.Variable{B0.YE(m)}]} : Maybe<&2, +List<S.Part>>}:
  match m:
    case B0.MNone{}: Empty.absurd({Codec.parts(B0.EV(B0.MNone{}), Spec.VarTestStruct()) == Some{[S.Variable{B0.YE(B0.MNone{})}]} : Maybe<&2, +List<S.Part>>}, F.logic__false_true(h))
    case B0.MSome{+w}: EM.encx_specO(w, h)

def parts_go(+k: Nat, +W: List<&2, B0.MB<EM.MW>>, +i: Nat, +hok: {EOKS(k, W, i) == True{} : Bool})
    -> {Codec.parts(B0.XI(k, W, i), S.Repeat{Spec.VarTestStruct()}) == Some{VVL.VP(B0.YS(k, W, i))} : Maybe<&2, +List<S.Part>>}:
  match k:
    case 0n: {==}
    case 1n+ +q:
      +x = B0.xat_pl_VarTestStruct(W, i)
      VS.cat_var(Codec.parts(B0.EV(x), Spec.VarTestStruct()), B0.YE(x), Codec.parts(B0.XI(q, W, 1n+i), S.Repeat{Spec.VarTestStruct()}), VVL.VP(B0.YS(q, W, 1n+i)),
        el_parts(x, B0.and_l(EOK(x), EOKS(q, W, 1n+i), hok)), parts_go(q, W, 1n+i, B0.and_r(EOK(x), EOKS(q, W, 1n+i), hok)))

def valid_go(+k: Nat, +W: List<&2, B0.MB<EM.MW>>, +i: Nat, +hok: {EOKS(k, W, i) == True{} : Bool}) -> {Layout.bytes_valid(VVL.VP(B0.YS(k, W, i))) == True{} : Bool}:
  match k:
    case 0n: {==}
    case 1n+ +q:
      +x = B0.xat_pl_VarTestStruct(W, i)
      VVL.vp_valid(B0.YE(x), B0.YS(q, W, 1n+i), dom_ye(x, B0.and_l(EOK(x), EOKS(q, W, 1n+i), hok)), valid_go(q, W, 1n+i, B0.and_r(EOK(x), EOKS(q, W, 1n+i), hok)))

# encx_spec: the list's value has its bytes as one variable part, when they fit a tree of depth dx < 30.
def specl(+t: F.array__Tree<B0.MB<EM.MW>>, +N: U32, +h: {OKL(t, N) == True{} : Bool}, +dx: Nat, +hdx: {Nat.is_lt(dx, 30n) == True{} : Bool},
    +hL: {Nat.is_le(B0.LL(t, N), A.quad(VB.pw(dx))) == True{} : Bool})
    -> {Codec.parts(B0.VALL(t, N), S.ProgressiveList{Spec.VarTestStruct()}) == Some{[S.Variable{B0.ENCL(t, N)}]} : Maybe<&2, +List<S.Part>>}:
  +n = U32.to_nat(N)
  +W = B0.SL(t)
  +ys = B0.YS(n, W, 0n)
  +ec = B0.cnt_ys(n, W, 0n)
  +fit = F.logic__subst(Nat, z => {N.fits(4n, Nat.add(A.quad(z), VE2.LEN(VR.bcat(ys)))) == True{} : Bool}, n, VVL.CNT(ys), Equal.sym(Nat, VVL.CNT(ys), n, ec), VBZ.fitq(dx, B0.LL(t, N), hL, hdx))
  %Equal.sym(Maybe<&2, +List<S.Part>>, Codec.parts(B0.XI(n, W, 0n), S.Repeat{Spec.VarTestStruct()}), Some{VVL.VP(ys)}, parts_go(n, W, 0n, okl_e(t, N, h))) :
    {Codec.aggregate(_, None{}) == Some{[S.Variable{B0.ENCL(t, N)}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(Maybe<&2, +List<U32>>, Layout.encoding(VVL.VP(ys)), Some{VE2.APP(VVL.OFFS(ys, A.quad(VVL.CNT(ys))), VR.bcat(ys))}, VVL.vp_enc(ys, valid_go(n, W, 0n, okl_e(t, N, h)), fit)) :
    {Codec.one(_, None{}) == Some{[S.Variable{B0.ENCL(t, N)}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(Nat, VVL.CNT(ys), n, ec) :
    {Codec.one(Some{VE2.APP(VVL.OFFS(ys, A.quad(_)), VR.bcat(ys))}, None{}) == Some{[S.Variable{B0.ENCL(t, N)}]} : Maybe<&2, +List<S.Part>>}
  {==}

def bcat_dom(+k: Nat, +W: List<&2, B0.MB<EM.MW>>, +i: Nat, +hok: {EOKS(k, W, i) == True{} : Bool}) -> {SP.bytes_domain(VR.bcat(B0.YS(k, W, i))) == True{} : Bool}:
  match k:
    case 0n: {==}
    case 1n+ +q:
      +x = B0.xat_pl_VarTestStruct(W, i)
      B0.app_dom(B0.YE(x), VR.bcat(B0.YS(q, W, 1n+i)), dom_ye(x, B0.and_l(EOK(x), EOKS(q, W, 1n+i), hok)), bcat_dom(q, W, 1n+i, B0.and_r(EOK(x), EOKS(q, W, 1n+i), hok)))

# The list's bytes are bytes.
def domxl(+t: F.array__Tree<B0.MB<EM.MW>>, +N: U32, +h: {OKL(t, N) == True{} : Bool}) -> {SP.bytes_domain(B0.ENCL(t, N)) == True{} : Bool}:
  B0.app_dom(VVL.OFFS(B0.YSN(t, N), A.quad(U32.to_nat(N))), VR.bcat(B0.YSN(t, N)), B0.offs_dom(B0.YSN(t, N), A.quad(U32.to_nat(N))), bcat_dom(U32.to_nat(N), B0.SL(t), 0n, okl_e(t, N, h)))

# ==== pl_VarTestStruct in the encoder-window interface (codegen/proofs/var/progressive_small_list_codec_laws.py's ENCX, with validx and domx) ====

# The writer loop's tree is perfect.
law wlm_pf:
  for +k: Nat
  for +W: List<&2, B0.MB<EM.MW>>
  for +s: Nat
  for +cur: U32
  for +dd: Nat
  for +D: F.array__Tree<U32>
  for +X: U32
  for +q: Nat
  for +r: Nat
  for +pf: {F.array__perfect(U32, dd, D) == True{} : Bool}
  {F.array__perfect(U32, dd, B0.WLM(k, W, s, cur, dd, D, X, q, r)) == True{} : Bool}
def wlm_pf(k, W, s, cur, dd, D, X, q, r, pf):
  match k:
    case 0n: pf
    case 1n+ +j:
      wlm_pf(j, W, 1n+s, O.padd(cur, B0.NE(B0.xat_pl_VarTestStruct(W, s))), dd, B0.PWE(B0.xat_pl_VarTestStruct(W, s), dd, WD.W32X(r, dd, D, Nat.add(s, q), cur), B0.QX(U32.add(X, cur)), B0.RX(U32.add(X, cur))), X, q, r,
        B0.pwe_perfect(B0.xat_pl_VarTestStruct(W, s), dd, WD.W32X(r, dd, D, Nat.add(s, q), cur), B0.QX(U32.add(X, cur)), B0.RX(U32.add(X, cur)), WD.w32x_perfect(r, dd, D, Nat.add(s, q), cur, pf)))

def pflb(+b: Bool, +t: F.array__Tree<B0.MB<EM.MW>>, +N: U32, +dd: Nat, +D: F.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat, +pf: {F.array__perfect(U32, dd, D) == True{} : Bool})
    -> B0.PFLb(b, t, N, dd, D, X, q, r):
  match b:
    case True{}: pf
    case False{}: wlm_pf(U32.to_nat(N), B0.SL(t), 0n, U32.mul(4, N), dd, D, X, q, r, pf)

# The object's Data mirror: the tree t of the boxed elements' mirrors, and the count N.
def OKT(+t: F.array__Tree<B0.MB<EM.MW>>, +N: U32) -> Bool: Bool.and(OKL(t, N), Nat.is_le(B0.LL(t, N), U32.to_nat(VB.NMAX())))
def OK(m: B0.MW) -> Bool:
  match m:
    case B0.MW{+t, +N}: OKT(t, N)
def ok_l(+t: F.array__Tree<B0.MB<EM.MW>>, +N: U32, +h: {OKT(t, N) == True{} : Bool}) -> {OKL(t, N) == True{} : Bool}:
  B0.and_l(OKL(t, N), Nat.is_le(B0.LL(t, N), U32.to_nat(VB.NMAX())), h)
def ok_b(+t: F.array__Tree<B0.MB<EM.MW>>, +N: U32, +h: {OKT(t, N) == True{} : Bool}) -> {Nat.is_le(B0.LL(t, N), U32.to_nat(VB.NMAX())) == True{} : Bool}:
  B0.and_r(OKL(t, N), Nat.is_le(B0.LL(t, N), U32.to_nat(VB.NMAX())), h)
# (the bound with its exponent symbolic, k = 28: a literal 2^30 in a conversion would be expanded)
def ok_bk(+t: F.array__Tree<B0.MB<EM.MW>>, +N: U32, +k: Nat, +ek: {k == 31n : Nat}, +h: {OKT(t, N) == True{} : Bool}) -> {Nat.is_le(B0.LL(t, N), U32.to_nat(VB.NMAX())) == True{} : Bool}:
  ok_b(t, N, h)
def szsk(+t: F.array__Tree<B0.MB<EM.MW>>, +N: U32, +k: Nat, +ek: {k == 31n : Nat}, +h: {OKT(t, N) == True{} : Bool}) -> {U32.to_nat(B0.SZS(t, N)) == B0.LL(t, N) : Nat}:
  szsS(t, N, ok_l(t, N, h), ok_b(t, N, h))
def szwk(+t: F.array__Tree<B0.MB<EM.MW>>, +N: U32, +k: Nat, +ek: {k == 31n : Nat}, +h: {OKT(t, N) == True{} : Bool}) -> {U32.to_nat(B0.SZW(t, N)) == B0.LL(t, N) : Nat}:
  szlS(t, N, ok_l(t, N, h), ok_b(t, N, h))
def speclB(+t: F.array__Tree<B0.MB<EM.MW>>, +N: U32, +h: {OKL(t, N) == True{} : Bool}, +B: Nat, +hB: {Nat.is_le(B, U32.to_nat(VB.NMAX())) == True{} : Bool},
    +hL: {Nat.is_le(B0.LL(t, N), B) == True{} : Bool})
    -> {Codec.parts(B0.VALL(t, N), S.ProgressiveList{Spec.VarTestStruct()}) == Some{[S.Variable{B0.ENCL(t, N)}]} : Maybe<&2, +List<S.Part>>}:
  +n = U32.to_nat(N)
  +W = B0.SL(t)
  +ys = B0.YS(n, W, 0n)
  +ec = B0.cnt_ys(n, W, 0n)
  +fit = F.logic__subst(Nat, z => {N.fits(4n, Nat.add(A.quad(z), VE2.LEN(VR.bcat(ys)))) == True{} : Bool}, n, VVL.CNT(ys), Equal.sym(Nat, VVL.CNT(ys), n, ec), VBZ.fitsB(B0.LL(t, N), B, hL, hB))
  %Equal.sym(Maybe<&2, +List<S.Part>>, Codec.parts(B0.XI(n, W, 0n), S.Repeat{Spec.VarTestStruct()}), Some{VVL.VP(ys)}, parts_go(n, W, 0n, okl_e(t, N, h))) :
    {Codec.aggregate(_, None{}) == Some{[S.Variable{B0.ENCL(t, N)}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(Maybe<&2, +List<U32>>, Layout.encoding(VVL.VP(ys)), Some{VE2.APP(VVL.OFFS(ys, A.quad(VVL.CNT(ys))), VR.bcat(ys))}, VVL.vp_enc(ys, valid_go(n, W, 0n, okl_e(t, N, h)), fit)) :
    {Codec.one(_, None{}) == Some{[S.Variable{B0.ENCL(t, N)}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(Nat, VVL.CNT(ys), n, ec) :
    {Codec.one(Some{VE2.APP(VVL.OFFS(ys, A.quad(_)), VR.bcat(ys))}, None{}) == Some{[S.Variable{B0.ENCL(t, N)}]} : Maybe<&2, +List<S.Part>>}
  {==}
def speck(+t: F.array__Tree<B0.MB<EM.MW>>, +N: U32, +k: Nat, +ek: {k == 29n : Nat}, +h: {OKT(t, N) == True{} : Bool})
    -> {Codec.parts(B0.VALL(t, N), S.ProgressiveList{Spec.VarTestStruct()}) == Some{[S.Variable{B0.ENCL(t, N)}]} : Maybe<&2, +List<S.Part>>}:
  speclB(t, N, ok_l(t, N, h), B0.LL(t, N), ok_b(t, N, h), F.nat__le_refl(B0.LL(t, N)))

# The returned size of the writer is the size pass's.
def eqsz(+t: F.array__Tree<B0.MB<EM.MW>>, +N: U32, +h: {OKT(t, N) == True{} : Bool}) -> {B0.SZW(t, N) == B0.SZS(t, N) : U32}:
  F.u32__injective(B0.SZW(t, N), B0.SZS(t, N), Equal.trans(Nat, U32.to_nat(B0.SZW(t, N)), B0.LL(t, N), U32.to_nat(B0.SZS(t, N)), szwk(t, N, 31n, {==}, h),
    Equal.sym(Nat, U32.to_nat(B0.SZS(t, N)), B0.LL(t, N), szsk(t, N, 31n, {==}, h))))

# The runtime's X is B0.XQ(q, r).
def exq(+X: U32, +q: Nat, +r: Nat, +L: Nat, +dd: Nat, +e: {U32.to_nat(X) == Nat.add(A.quad(q), r) : Nat}, +hd: {Nat.is_lt(dd, 29n) == True{} : Bool},
    +hl: {Nat.is_le(Nat.add(q, WD.NWN(Nat.add(r, L))), VB.pw(dd)) == True{} : Bool}) -> {X == B0.XQ(q, r) : U32}:
  +X0 = Nat.add(A.quad(q), r)
  +E = A.quad(Nat.add(q, WD.NWN(Nat.add(r, L))))
  +h1 = F.logic__subst(Nat, z => {Nat.is_le(X0, z) == True{} : Bool}, Nat.add(X0, Nat.add(L, WD.PADB(r, L))), E, e_end(q, r, L), Order.below_sum(X0, Nat.add(L, WD.PADB(r, L))))
  +h2 = F.nat__le_trans(X0, E, VB.pw(30n), h1, F.nat__le_trans(E, A.quad(VB.pw(dd)), VB.pw(30n), UW.quad_le(Nat.add(q, WD.NWN(Nat.add(r, L))), VB.pw(dd), hl), B0.q30(dd, hd)))
