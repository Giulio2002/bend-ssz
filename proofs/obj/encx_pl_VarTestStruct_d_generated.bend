# The count after element s.
def f_cnt(+s: Nat, +j: Nat, +n: Nat, +W: List<&2, B0.MB<EM.MW>>, +q: Nat, +r: Nat, +X: U32, +dd: Nat, +pad: Nat, +LR: Nat,
    +ek: {Nat.add(s, 1n+j) == n : Nat}, +e: {U32.to_nat(X) == Nat.add(A.quad(q), r) : Nat}, +hd: {Nat.is_lt(dd, 29n) == True{} : Bool},
    +hLR: {Nat.add(B0.LLN(n, W), pad) == LR : Nat}, +hroom: {Nat.is_le(Nat.add(Nat.add(A.quad(q), r), LR), A.quad(VB.pw(dd))) == True{} : Bool}, +k: Nat, +ek30: {k == 30n : Nat}, +cur: U32, +ec: {U32.to_nat(cur) == Nat.add(A.quad(n), B0.BL(s, W, 0n)) : Nat}, +hx: {EOK(B0.xat_pl_VarTestStruct(W, s)) == True{} : Bool})
    -> {U32.to_nat(O.padd(cur, B0.NE(B0.xat_pl_VarTestStruct(W, s)))) == Nat.add(A.quad(n), B0.BL(1n+s, W, 0n)) : Nat}:
  +x = B0.xat_pl_VarTestStruct(W, s)
  +y = B0.YE(x)
  +X0 = Nat.add(A.quad(q), r)
  +L = B0.LLN(n, W)
  +Nx = U32.to_nat(B0.NE(x))
  +ely = len_ye(x, hx)
  +ebl = Equal.trans(Nat, B0.BL(n, W, 0n), Nat.add(B0.BL(s, W, 0n), B0.BL(1n+j, W, s)), Nat.add(B0.BL(s, W, 0n), Nat.add(VE2.LEN(y), B0.BL(j, W, 1n+s))),
    F.logic__subst(Nat, z => {B0.BL(z, W, 0n) == Nat.add(B0.BL(s, W, 0n), B0.BL(1n+j, W, s)) : Nat}, Nat.add(s, 1n+j), n, ek, bl_split(s, 1n+j, W)),
