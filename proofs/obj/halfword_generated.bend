  %Equal.sym(U32, U32.and(O.shr_bytes(v, 1), 255), UB.lo8(O.shr_bytes(v, 1)), UB.and255(O.shr_bytes(v, 1))) : {UB.lo8(O.shr_bytes(O.merge_word(old, v, 2, 2), 3)) == _ : U32}
  %Equal.sym(U32, U32.mul(v, 65536), U32.shln(v, 16n), WM.mul65536(v)) : {UB.lo8(O.shr_bytes(U32.or(U32.and(old, U32.not(O.mask_at(2, 2))), U32.and(_, O.mask_at(2, 2))), 3)) == UB.lo8(O.shr_bytes(v, 1)) : U32}
  hw_go_2_3(old, v)

