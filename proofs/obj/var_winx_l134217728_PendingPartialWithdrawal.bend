def RITEMS(c: Nat, +t: FD.array__Tree<U32>, +y: Nat) -> S.Value:
  match c:
    case 0n: S.EmptyItems{}
    case 1n+q: S.Items{RVAL(t, y), RITEMS(q, t, Nat.add(24n, y))}

def RIT1(+q: Nat, +t: FD.array__Tree<U32>, +y: Nat) -> {S.Items{RVAL(t, y), RITEMS(q, t, Nat.add(24n, y))} == RITEMS(1n+q, t, y) : S.Value}:
  {==}

def CHUNKS(c: Nat, +t: FD.array__Tree<U32>, +y: Nat) -> +List<+List<U32>>:
  match c:
    case 0n: []
    case 1n+q: Con{UR.RWS(6n, t, y), CHUNKS(q, t, Nat.add(24n, y))}

law cnt_items:
  for +c: Nat
  for +t: FD.array__Tree<U32>
  for +y: Nat
  {Codec.count(RITEMS(c, t, y)) == c : Nat}
def cnt_items(c, t, y):
  match c:
    case 0n: {==}
    case 1n+ +q: FD.nat__succ_cong(Codec.count(RITEMS(q, t, Nat.add(24n, y))), q, cnt_items(q, t, Nat.add(24n, y)))

law prt_items:
  for +c: Nat
  for +t: FD.array__Tree<U32>
  for +y: Nat
  {Codec.parts(RITEMS(c, t, y), S.Repeat{S.Container{["validator_index", "amount", "withdrawable_epoch"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.Unsigned{P.U64{}}, S.End{}}}}}}) == Some{F.fparts(CHUNKS(c, t, y))} : Maybe<&2, +List<S.Part>>}
def prt_items(c, t, y):
  match c:
    case 0n: {==}
    case 1n+ +q:
      %RIT1(q, t, y) : {Codec.parts(_, S.Repeat{S.Container{["validator_index", "amount", "withdrawable_epoch"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.Unsigned{P.U64{}}, S.End{}}}}}}) == Some{F.fparts(CHUNKS(1n+q, t, y))} : Maybe<&2, +List<S.Part>>}
      F.items_rep(RVAL(t, y), RITEMS(q, t, Nat.add(24n, y)), S.Container{["validator_index", "amount", "withdrawable_epoch"], S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.Unsigned{P.U64{}}, S.End{}}}}}, F.limbs(UR.RWS(6n, t, y)),
        F.fparts(CHUNKS(q, t, Nat.add(24n, y))), RPRF(t, y), prt_items(q, t, Nat.add(24n, y)))

