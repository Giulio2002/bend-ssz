  for +c: Nat
  for +d: Nat
  for +t: FD.array__Tree<U32>
  for +y: Nat
  for +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}
  for +h: {Nat.is_le(Nat.add(y, Nat.mul(c, 24n)), A.quad(VB.pw(d))) == True{} : Bool}
  {F.flat(CHUNKS(c, t, y)) == UW.WX(t, y, Nat.mul(c, 24n)) : +List<U32>}
