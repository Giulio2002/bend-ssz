    VBB.prt2(f_B, ok_hv_f_B(m_f_A, f_B, f_C, m_f_D, f_E, h)), FX.cat_fixed(Codec.parts(VBB.V1(f_C), S.BitVector{1n}), [U32.and(f_C, 255)], Codec.parts(S.Items{EX_bits6.VAL(m_f_D), S.Items{VBB.V8(f_E), S.EmptyItems{}}}, S.Chain{S.BitList{6n}, S.Chain{S.BitVector{8n}, S.End{}}}), [S.Variable{EX_bits6.ENC(m_f_D)}, S.Fixed{[U32.and(f_E, 255)]}],
    VBB.prt1(f_C, ok_hv_f_C(m_f_A, f_B, f_C, m_f_D, f_E, h)), VS.cat_var(Codec.parts(EX_bits6.VAL(m_f_D), S.BitList{6n}), EX_bits6.ENC(m_f_D), Codec.parts(S.Items{VBB.V8(f_E), S.EmptyItems{}}, S.Chain{S.BitVector{8n}, S.End{}}), [S.Fixed{[U32.and(f_E, 255)]}],
    EX_bits6.encx_spec(m_f_D, ok_hok_f_D(m_f_A, f_B, f_C, m_f_D, f_E, h)), FX.cat_fixed(Codec.parts(VBB.V8(f_E), S.BitVector{8n}), [U32.and(f_E, 255)], Codec.parts(S.EmptyItems{}, S.End{}), [],
    VBB.prt8(f_E, ok_hv_f_E(m_f_A, f_B, f_C, m_f_D, f_E, h)), {==})))))

def validC(+m_f_A: EX_bits5.MB, +f_B: U32, +f_C: U32, +m_f_D: EX_bits6.MB, +f_E: U32, +h: {OKT(m_f_A, f_B, f_C, m_f_D, f_E) == True{} : Bool}, +k: Nat, +ek: {k == 28n : Nat}) -> {Layout.bytes_valid(PSC(m_f_A, f_B, f_C, m_f_D, f_E)) == True{} : Bool}:
  FD.logic__and_intro(SP.bytes_domain(EX_bits5.ENC(m_f_A)), Layout.bytes_valid([S.Fixed{[U32.and(f_B, 255)]}, S.Fixed{[U32.and(f_C, 255)]}, S.Variable{EX_bits6.ENC(m_f_D)}, S.Fixed{[U32.and(f_E, 255)]}]), CS.domv(EX_bits5.VAL(m_f_A), S.BitList{5n}, EX_bits5.ENC(m_f_A), {==}, EX_bits5.encx_spec(m_f_A, ok_hok_f_A(m_f_A, f_B, f_C, m_f_D, f_E, h))),
    FD.logic__and_intro(SP.bytes_domain([U32.and(f_B, 255)]), Layout.bytes_valid([S.Fixed{[U32.and(f_C, 255)]}, S.Variable{EX_bits6.ENC(m_f_D)}, S.Fixed{[U32.and(f_E, 255)]}]), CS.domf(VBB.V2(f_B), S.BitVector{2n}, [U32.and(f_B, 255)], {==}, VBB.prt2(f_B, ok_hv_f_B(m_f_A, f_B, f_C, m_f_D, f_E, h))),
    FD.logic__and_intro(SP.bytes_domain([U32.and(f_C, 255)]), Layout.bytes_valid([S.Variable{EX_bits6.ENC(m_f_D)}, S.Fixed{[U32.and(f_E, 255)]}]), CS.domf(VBB.V1(f_C), S.BitVector{1n}, [U32.and(f_C, 255)], {==}, VBB.prt1(f_C, ok_hv_f_C(m_f_A, f_B, f_C, m_f_D, f_E, h))),
    FD.logic__and_intro(SP.bytes_domain(EX_bits6.ENC(m_f_D)), Layout.bytes_valid([S.Fixed{[U32.and(f_E, 255)]}]), CS.domv(EX_bits6.VAL(m_f_D), S.BitList{6n}, EX_bits6.ENC(m_f_D), {==}, EX_bits6.encx_spec(m_f_D, ok_hok_f_D(m_f_A, f_B, f_C, m_f_D, f_E, h))),
    FD.logic__and_intro(SP.bytes_domain([U32.and(f_E, 255)]), Layout.bytes_valid([]), CS.domf(VBB.V8(f_E), S.BitVector{8n}, [U32.and(f_E, 255)], {==}, VBB.prt8(f_E, ok_hv_f_E(m_f_A, f_B, f_C, m_f_D, f_E, h))),
    {==})))))

# the offsets the writer writes are the layout's
def okoC(+m_f_A: EX_bits5.MB, +f_B: U32, +f_C: U32, +m_f_D: EX_bits6.MB, +f_E: U32, +h: {OKT(m_f_A, f_B, f_C, m_f_D, f_E) == True{} : Bool}, +k: Nat, +ek: {k == 28n : Nat}) -> LY.OKO(PSC(m_f_A, f_B, f_C, m_f_D, f_E), 11n, OSC(m_f_A, f_B, f_C, m_f_D, f_E)):
  ({==}, (CS.pstep(11, EX_bits5.SZ(m_f_A), 11n, LY.LN(EX_bits5.ENC(m_f_A)), k, CS.hk29(k, ek), {==}, EX_bits5.szx(m_f_A, ok_hok_f_A(m_f_A, f_B, f_C, m_f_D, f_E, h)), CS.lel(Nat.add(11n, LY.LN(EX_bits5.ENC(m_f_A))), LY.LN(EX_bits6.ENC(m_f_D)), A.quad(VB.pw(k)), okbk(m_f_A, f_B, f_C, m_f_D, f_E, h, k, ek))), Unit{}))

# the returned size is the bytes' end
def eSZ(+m_f_A: EX_bits5.MB, +f_B: U32, +f_C: U32, +m_f_D: EX_bits6.MB, +f_E: U32, +u: Unit) -> {K.SZC(m_f_A, f_B, f_C, m_f_D, f_E) == (O.padd(O.padd(11, EX_bits5.SZ(m_f_A)), EX_bits6.SZ(m_f_D)) .|. O.pz(Bool.and(bitvector_2_e.bv2_valid(bitvector_2_d.Bitvector2{f_B}), Bool.and(bitvector_1_e.bv1_valid(bitvector_1_d.Bitvector1{f_C}), bitvector_8_e.bv8_valid(bitvector_8_d.Bitvector8{f_E})))) : U32) : U32}: {==}
def szC(+m_f_A: EX_bits5.MB, +f_B: U32, +f_C: U32, +m_f_D: EX_bits6.MB, +f_E: U32, +h: {OKT(m_f_A, f_B, f_C, m_f_D, f_E) == True{} : Bool}, +k: Nat, +ek: {k == 28n : Nat}) -> {U32.to_nat(K.SZC(m_f_A, f_B, f_C, m_f_D, f_E)) == ENDC(m_f_A, f_B, f_C, m_f_D, f_E) : Nat}:
  FD.logic__subst(U32, z => {U32.to_nat(z) == ENDC(m_f_A, f_B, f_C, m_f_D, f_E) : Nat}, O.padd(O.padd(11, EX_bits5.SZ(m_f_A)), EX_bits6.SZ(m_f_D)), K.SZC(m_f_A, f_B, f_C, m_f_D, f_E), Equal.sym(U32, K.SZC(m_f_A, f_B, f_C, m_f_D, f_E), O.padd(O.padd(11, EX_bits5.SZ(m_f_A)), EX_bits6.SZ(m_f_D)), K.szpz(m_f_A, f_B, f_C, m_f_D, f_E, ok_hpz(m_f_A, f_B, f_C, m_f_D, f_E, h))),
    CS.pstep(O.padd(11, EX_bits5.SZ(m_f_A)), EX_bits6.SZ(m_f_D), Nat.add(11n, LY.LN(EX_bits5.ENC(m_f_A))), LY.LN(EX_bits6.ENC(m_f_D)), k, CS.hk29(k, ek), CS.pstep(11, EX_bits5.SZ(m_f_A), 11n, LY.LN(EX_bits5.ENC(m_f_A)), k, CS.hk29(k, ek), {==}, EX_bits5.szx(m_f_A, ok_hok_f_A(m_f_A, f_B, f_C, m_f_D, f_E, h)), CS.lel(Nat.add(11n, LY.LN(EX_bits5.ENC(m_f_A))), LY.LN(EX_bits6.ENC(m_f_D)), A.quad(VB.pw(k)), okbk(m_f_A, f_B, f_C, m_f_D, f_E, h, k, ek))), EX_bits6.szx(m_f_D, ok_hok_f_D(m_f_A, f_B, f_C, m_f_D, f_E, h)), okbk(m_f_A, f_B, f_C, m_f_D, f_E, h, k, ek)))

# the writer's bytes: the fixed region (the layout's header), then the payloads
def eENC(+m_f_A: EX_bits5.MB, +f_B: U32, +f_C: U32, +m_f_D: EX_bits6.MB, +f_E: U32, +u: Unit) -> {K.ENCC(m_f_A, f_B, f_C, m_f_D, f_E) == VCN.CAT([I.limb(11), [U32.and(f_B, 255)], [U32.and(f_C, 255)], I.limb(O.padd(11, EX_bits5.SZ(m_f_A))), [U32.and(f_E, 255)], VCN.PC(List.length(&2, U32, EX_bits5.ENC(m_f_A)), EX_bits5.ENC(m_f_A)), VCN.PC(List.length(&2, U32, EX_bits6.ENC(m_f_D)), EX_bits6.ENC(m_f_D))]) : +List<U32>}: {==}
def eLLC(+m_f_A: EX_bits5.MB, +f_B: U32, +f_C: U32, +m_f_D: EX_bits6.MB, +f_E: U32, +dd: Nat, +D: FD.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat) -> {K.LLC(m_f_A, f_B, f_C, m_f_D, f_E, dd, D, X, q, r) == Nat.add(11n, VCN.SUM([List.length(&2, U32, EX_bits5.ENC(m_f_A)), List.length(&2, U32, EX_bits6.ENC(m_f_D))])) : Nat}: {==}
def cellsC(+m_f_A: EX_bits5.MB, +f_B: U32, +f_C: U32, +m_f_D: EX_bits6.MB, +f_E: U32, +h: {OKT(m_f_A, f_B, f_C, m_f_D, f_E) == True{} : Bool}) -> {K.ENCC(m_f_A, f_B, f_C, m_f_D, f_E) == VCN.AP(VCN.CAT([I.limb(11), [U32.and(f_B, 255)], [U32.and(f_C, 255)], I.limb(O.padd(11, EX_bits5.SZ(m_f_A))), [U32.and(f_E, 255)]]), Layout.payloads(PSC(m_f_A, f_B, f_C, m_f_D, f_E))) : +List<U32>}:
  %Equal.sym(+List<U32>, K.ENCC(m_f_A, f_B, f_C, m_f_D, f_E), VCN.CAT([I.limb(11), [U32.and(f_B, 255)], [U32.and(f_C, 255)], I.limb(O.padd(11, EX_bits5.SZ(m_f_A))), [U32.and(f_E, 255)], VCN.PC(List.length(&2, U32, EX_bits5.ENC(m_f_A)), EX_bits5.ENC(m_f_A)), VCN.PC(List.length(&2, U32, EX_bits6.ENC(m_f_D)), EX_bits6.ENC(m_f_D))]), eENC(m_f_A, f_B, f_C, m_f_D, f_E, Unit{})) :
    {_ == VCN.AP(VCN.CAT([I.limb(11), [U32.and(f_B, 255)], [U32.and(f_C, 255)], I.limb(O.padd(11, EX_bits5.SZ(m_f_A))), [U32.and(f_E, 255)]]), Layout.payloads(PSC(m_f_A, f_B, f_C, m_f_D, f_E))) : +List<U32>}
  %Equal.sym(+List<U32>, VCN.CAT([I.limb(11), [U32.and(f_B, 255)], [U32.and(f_C, 255)], I.limb(O.padd(11, EX_bits5.SZ(m_f_A))), [U32.and(f_E, 255)], VCN.PC(List.length(&2, U32, EX_bits5.ENC(m_f_A)), EX_bits5.ENC(m_f_A)), VCN.PC(List.length(&2, U32, EX_bits6.ENC(m_f_D)), EX_bits6.ENC(m_f_D))]), VCN.AP(VCN.CAT([I.limb(11), [U32.and(f_B, 255)], [U32.and(f_C, 255)], I.limb(O.padd(11, EX_bits5.SZ(m_f_A))), [U32.and(f_E, 255)]]), VCN.CAT([VCN.PC(List.length(&2, U32, EX_bits5.ENC(m_f_A)), EX_bits5.ENC(m_f_A)), VCN.PC(List.length(&2, U32, EX_bits6.ENC(m_f_D)), EX_bits6.ENC(m_f_D))])), VCN.cat_lap([I.limb(11), [U32.and(f_B, 255)], [U32.and(f_C, 255)], I.limb(O.padd(11, EX_bits5.SZ(m_f_A))), [U32.and(f_E, 255)]], [VCN.PC(List.length(&2, U32, EX_bits5.ENC(m_f_A)), EX_bits5.ENC(m_f_A)), VCN.PC(List.length(&2, U32, EX_bits6.ENC(m_f_D)), EX_bits6.ENC(m_f_D))])) :
    {_ == VCN.AP(VCN.CAT([I.limb(11), [U32.and(f_B, 255)], [U32.and(f_C, 255)], I.limb(O.padd(11, EX_bits5.SZ(m_f_A))), [U32.and(f_E, 255)]]), Layout.payloads(PSC(m_f_A, f_B, f_C, m_f_D, f_E))) : +List<U32>}
  %Equal.sym(+List<U32>, VCN.PC(List.length(&2, U32, EX_bits5.ENC(m_f_A)), EX_bits5.ENC(m_f_A)), EX_bits5.ENC(m_f_A), VCN.pc_id(List.length(&2, U32, EX_bits5.ENC(m_f_A)), EX_bits5.ENC(m_f_A), {==})) :
    {VCN.AP(VCN.CAT([I.limb(11), [U32.and(f_B, 255)], [U32.and(f_C, 255)], I.limb(O.padd(11, EX_bits5.SZ(m_f_A))), [U32.and(f_E, 255)]]), VCN.CAT([_, VCN.PC(List.length(&2, U32, EX_bits6.ENC(m_f_D)), EX_bits6.ENC(m_f_D))])) == VCN.AP(VCN.CAT([I.limb(11), [U32.and(f_B, 255)], [U32.and(f_C, 255)], I.limb(O.padd(11, EX_bits5.SZ(m_f_A))), [U32.and(f_E, 255)]]), Layout.payloads(PSC(m_f_A, f_B, f_C, m_f_D, f_E))) : +List<U32>}
  %Equal.sym(+List<U32>, VCN.PC(List.length(&2, U32, EX_bits6.ENC(m_f_D)), EX_bits6.ENC(m_f_D)), EX_bits6.ENC(m_f_D), VCN.pc_id(List.length(&2, U32, EX_bits6.ENC(m_f_D)), EX_bits6.ENC(m_f_D), {==})) :
    {VCN.AP(VCN.CAT([I.limb(11), [U32.and(f_B, 255)], [U32.and(f_C, 255)], I.limb(O.padd(11, EX_bits5.SZ(m_f_A))), [U32.and(f_E, 255)]]), VCN.CAT([EX_bits5.ENC(m_f_A), _])) == VCN.AP(VCN.CAT([I.limb(11), [U32.and(f_B, 255)], [U32.and(f_C, 255)], I.limb(O.padd(11, EX_bits5.SZ(m_f_A))), [U32.and(f_E, 255)]]), Layout.payloads(PSC(m_f_A, f_B, f_C, m_f_D, f_E))) : +List<U32>}
