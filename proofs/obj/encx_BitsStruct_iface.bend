def encE(+m_f_A: EX_bits5.MB, +f_B: U32, +f_C: U32, +m_f_D: EX_bits6.MB, +f_E: U32, +h: {OKT(m_f_A, f_B, f_C, m_f_D, f_E) == True{} : Bool}, +k: Nat, +ek: {k == 28n : Nat})
    -> {Layout.encoding(PSC(m_f_A, f_B, f_C, m_f_D, f_E)) == Some{K.ENCC(m_f_A, f_B, f_C, m_f_D, f_E)} : Maybe<&2, +List<U32>>}:
  +FP = LY.HDRW(PSC(m_f_A, f_B, f_C, m_f_D, f_E), OSC(m_f_A, f_B, f_C, m_f_D, f_E))
  +PAY = Layout.payloads(PSC(m_f_A, f_B, f_C, m_f_D, f_E))
  +hf = LY.hdr_fp(PSC(m_f_A, f_B, f_C, m_f_D, f_E), 11n, OSC(m_f_A, f_B, f_C, m_f_D, f_E), okoC(m_f_A, f_B, f_C, m_f_D, f_E, h, k, ek))
  +fit = CS.fitc(11n, PAY, ENDC(m_f_A, f_B, f_C, m_f_D, f_E), k, ek, LY.lay_end(PSC(m_f_A, f_B, f_C, m_f_D, f_E), 11n), okbk(m_f_A, f_B, f_C, m_f_D, f_E, h, k, ek))
  +e1 = LY.enc_genL(PSC(m_f_A, f_B, f_C, m_f_D, f_E), 11n, FP, PAY, {==}, hf, {==}, validC(m_f_A, f_B, f_C, m_f_D, f_E, h, k, ek), fit)
  FD.logic__subst(+List<U32>, z => {Layout.encoding(PSC(m_f_A, f_B, f_C, m_f_D, f_E)) == Some{z} : Maybe<&2, +List<U32>>}, VCN.AP(FP, PAY), K.ENCC(m_f_A, f_B, f_C, m_f_D, f_E),
    Equal.sym(+List<U32>, K.ENCC(m_f_A, f_B, f_C, m_f_D, f_E), VCN.AP(FP, PAY), cellsC(m_f_A, f_B, f_C, m_f_D, f_E, h)), e1)

# encx_spec, on the parameters
def specC(+m_f_A: EX_bits5.MB, +f_B: U32, +f_C: U32, +m_f_D: EX_bits6.MB, +f_E: U32, +h: {OKT(m_f_A, f_B, f_C, m_f_D, f_E) == True{} : Bool}, +k: Nat, +ek: {k == 28n : Nat})
    -> {Codec.parts(VALC(m_f_A, f_B, f_C, m_f_D, f_E), Spec.BitsStruct()) == Some{[S.Variable{K.ENCC(m_f_A, f_B, f_C, m_f_D, f_E)}]} : Maybe<&2, +List<S.Part>>}:
  %Equal.sym(Maybe<&2, +List<S.Part>>, Codec.parts(S.Items{EX_bits5.VAL(m_f_A), S.Items{VBB.V2(f_B), S.Items{VBB.V1(f_C), S.Items{EX_bits6.VAL(m_f_D), S.Items{VBB.V8(f_E), S.EmptyItems{}}}}}}, S.Chain{S.BitList{5n}, S.Chain{S.BitVector{2n}, S.Chain{S.BitVector{1n}, S.Chain{S.BitList{6n}, S.Chain{S.BitVector{8n}, S.End{}}}}}}), Some{PSC(m_f_A, f_B, f_C, m_f_D, f_E)}, partsC(m_f_A, f_B, f_C, m_f_D, f_E, h, k, ek)) :
    {Codec.aggregate(_, None{}) == Some{[S.Variable{K.ENCC(m_f_A, f_B, f_C, m_f_D, f_E)}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(Maybe<&2, +List<U32>>, Layout.encoding(PSC(m_f_A, f_B, f_C, m_f_D, f_E)), Some{K.ENCC(m_f_A, f_B, f_C, m_f_D, f_E)}, encE(m_f_A, f_B, f_C, m_f_D, f_E, h, k, ek)) :
    {Codec.one(_, None{}) == Some{[S.Variable{K.ENCC(m_f_A, f_B, f_C, m_f_D, f_E)}]} : Maybe<&2, +List<S.Part>>}
  {==}

# the writer's byte count
def lenC(+m_f_A: EX_bits5.MB, +f_B: U32, +f_C: U32, +m_f_D: EX_bits6.MB, +f_E: U32, +dd: Nat, +D: FD.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat) -> {List.length(&2, U32, K.ENCC(m_f_A, f_B, f_C, m_f_D, f_E)) == K.LLC(m_f_A, f_B, f_C, m_f_D, f_E, dd, D, X, q, r) : Nat}:
  +SL = Nat.add(11n, VCN.SUM([List.length(&2, U32, EX_bits5.ENC(m_f_A)), List.length(&2, U32, EX_bits6.ENC(m_f_D))]))
