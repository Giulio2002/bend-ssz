  match m:
    case MW{+m_f_A, +f_B, +f_C, +m_f_D, +f_E}: K.pfC(m_f_A, f_B, f_C, m_f_D, f_E, dd, D, XQ(q, r), q, r, pf)

def sizeC(+m_f_A: EX_bits5.MB, +f_B: U32, +f_C: U32, +m_f_D: EX_bits6.MB, +f_E: U32, +h: {OKT(m_f_A, f_B, f_C, m_f_D, f_E) == True{} : Bool}) -> {BitsStruct_e.BitsStruct_size(K.OBJC(m_f_A, f_B, f_C, m_f_D, f_E)) == (K.OBJC(m_f_A, f_B, f_C, m_f_D, f_E), K.SZC(m_f_A, f_B, f_C, m_f_D, f_E)) : BitsStruct_d.BitsStruct & U32}:
  %Equal.sym(U32, K.SZC(m_f_A, f_B, f_C, m_f_D, f_E), O.padd(O.padd(11, EX_bits5.SZ(m_f_A)), EX_bits6.SZ(m_f_D)), K.szpz(m_f_A, f_B, f_C, m_f_D, f_E, ok_hpz(m_f_A, f_B, f_C, m_f_D, f_E, h))) :
    {BitsStruct_e.BitsStruct_size(K.OBJC(m_f_A, f_B, f_C, m_f_D, f_E)) == (K.OBJC(m_f_A, f_B, f_C, m_f_D, f_E), _) : BitsStruct_d.BitsStruct & U32}
  %Equal.sym(O.Bits & U32, bitlist_5_e.bits5_size(EX_bits5.TH(m_f_A)), (EX_bits5.TH(m_f_A), EX_bits5.SZ(m_f_A)), EX_bits5.sizex(m_f_A, ok_hok_f_A(m_f_A, f_B, f_C, m_f_D, f_E, h))) :
    {BitsStruct_e.BitsStruct_sz0(bitvector_2_d.Bitvector2{f_B}, bitvector_1_d.Bitvector1{f_C}, EX_bits6.TH(m_f_D), bitvector_8_d.Bitvector8{f_E}, 11, _) == (K.OBJC(m_f_A, f_B, f_C, m_f_D, f_E), O.padd(O.padd(11, EX_bits5.SZ(m_f_A)), EX_bits6.SZ(m_f_D))) : BitsStruct_d.BitsStruct & U32}
  %Equal.sym(O.Bits & U32, bitlist_6_e.bits6_size(EX_bits6.TH(m_f_D)), (EX_bits6.TH(m_f_D), EX_bits6.SZ(m_f_D)), EX_bits6.sizex(m_f_D, ok_hok_f_D(m_f_A, f_B, f_C, m_f_D, f_E, h))) :
    {BitsStruct_e.BitsStruct_sz1(bitvector_2_d.Bitvector2{f_B}, bitvector_1_d.Bitvector1{f_C}, bitvector_8_d.Bitvector8{f_E}, EX_bits5.TH(m_f_A), O.padd(11, EX_bits5.SZ(m_f_A)), _) == (K.OBJC(m_f_A, f_B, f_C, m_f_D, f_E), O.padd(O.padd(11, EX_bits5.SZ(m_f_A)), EX_bits6.SZ(m_f_D))) : BitsStruct_d.BitsStruct & U32}
  {==}

law sizex:
  for +m: MW
  for +hok: {OK(m) == True{} : Bool}
  {BitsStruct_e.BitsStruct_size(TH(m)) == (TH(m), SZ(m)) : BitsStruct_d.BitsStruct & U32}
def sizex(m, hok):
  match m:
    case MW{+m_f_A, +f_B, +f_C, +m_f_D, +f_E}: sizeC(m_f_A, f_B, f_C, m_f_D, f_E, hok)

def rvalidC(+m_f_A: EX_bits5.MB, +f_B: U32, +f_C: U32, +m_f_D: EX_bits6.MB, +f_E: U32, +h: {OKT(m_f_A, f_B, f_C, m_f_D, f_E) == True{} : Bool}) -> {BitsStruct_e.BitsStruct_valid(K.OBJC(m_f_A, f_B, f_C, m_f_D, f_E)) == (K.OBJC(m_f_A, f_B, f_C, m_f_D, f_E), True{}) : BitsStruct_d.BitsStruct & Bool}:
  %Equal.sym(Bool, Bool.and(bitvector_2_e.bv2_valid(bitvector_2_d.Bitvector2{f_B}), Bool.and(bitvector_1_e.bv1_valid(bitvector_1_d.Bitvector1{f_C}), bitvector_8_e.bv8_valid(bitvector_8_d.Bitvector8{f_E}))), True{}, ok_hpz(m_f_A, f_B, f_C, m_f_D, f_E, h)) :
    {BitsStruct_e.BitsStruct_va0(bitvector_2_d.Bitvector2{f_B}, bitvector_1_d.Bitvector1{f_C}, EX_bits6.TH(m_f_D), bitvector_8_d.Bitvector8{f_E}, _, bitlist_5_e.bits5_valid(EX_bits5.TH(m_f_A))) == (K.OBJC(m_f_A, f_B, f_C, m_f_D, f_E), True{}) : BitsStruct_d.BitsStruct & Bool}
  %Equal.sym(O.Bits & Bool, bitlist_5_e.bits5_valid(EX_bits5.TH(m_f_A)), (EX_bits5.TH(m_f_A), True{}), EX_bits5.validx(m_f_A, ok_hok_f_A(m_f_A, f_B, f_C, m_f_D, f_E, h))) :
    {BitsStruct_e.BitsStruct_va0(bitvector_2_d.Bitvector2{f_B}, bitvector_1_d.Bitvector1{f_C}, EX_bits6.TH(m_f_D), bitvector_8_d.Bitvector8{f_E}, True{}, _) == (K.OBJC(m_f_A, f_B, f_C, m_f_D, f_E), True{}) : BitsStruct_d.BitsStruct & Bool}
  %Equal.sym(O.Bits & Bool, bitlist_6_e.bits6_valid(EX_bits6.TH(m_f_D)), (EX_bits6.TH(m_f_D), True{}), EX_bits6.validx(m_f_D, ok_hok_f_D(m_f_A, f_B, f_C, m_f_D, f_E, h))) :
    {BitsStruct_e.BitsStruct_va1(EX_bits5.TH(m_f_A), bitvector_2_d.Bitvector2{f_B}, bitvector_1_d.Bitvector1{f_C}, bitvector_8_d.Bitvector8{f_E}, Bool.and(True{}, True{}), _) == (K.OBJC(m_f_A, f_B, f_C, m_f_D, f_E), True{}) : BitsStruct_d.BitsStruct & Bool}
  {==}

law validx:
  for +m: MW
  for +hok: {OK(m) == True{} : Bool}
  {BitsStruct_e.BitsStruct_valid(TH(m)) == (TH(m), True{}) : BitsStruct_d.BitsStruct & Bool}
def validx(m, hok):
  match m:
    case MW{+m_f_A, +f_B, +f_C, +m_f_D, +f_E}: rvalidC(m_f_A, f_B, f_C, m_f_D, f_E, hok)
