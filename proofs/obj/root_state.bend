  for +i: Nat
  for +hl: Nat
  for +e: {Nat.is_lt(s, k) == True{} : Bool}
  {MD.dhead(MD.ddrop(s, xl_l16777216_HistoricalSummary(k, W, i, hl))) == RN.d_HistoricalSummary(hl, xat_l16777216_HistoricalSummary(W, Nat.add(s, i))) : D.Digest}
def xat_at_l16777216_HistoricalSummary(s, k, W, i, hl, e):
  match s:
    case 0n:
      match k:
        case 0n: Empty.absurd({MD.dhead(MD.ddrop(0n, xl_l16777216_HistoricalSummary(0n, W, i, hl))) == RN.d_HistoricalSummary(hl, xat_l16777216_HistoricalSummary(W, Nat.add(0n, i))) : D.Digest}, MD.false_true(e))
        case 1n+q: {==}
