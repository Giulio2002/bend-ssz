def v_bv4(o: T.Bitvector4) -> S.Value:
  match o:
    case T.Bitvector4{+w0}: S.BitsValue{BLP.btk(4n, BLP.bitsof([w0]))}
def d_bv4(+hl: Nat, o: T.Bitvector4) -> D.Digest:
  match o:
    case T.Bitvector4{+w0}: D.D{B.swap32(w0), 0, 0, 0, 0, 0, 0, 0}
def last_bv4(o: T.Bitvector4) -> U32:
  match o:
    case T.Bitvector4{+w0}: w0
# the representation fact: the bits past 4 are zero
def rp_bv4(o: T.Bitvector4) -> Data: {last_bv4(o) == U32{WSp.join(4n, 28n, WSp.take(4n, 32n, PD.bits(last_bv4(o))), Word.zero(28n))} : U32}
def st_bv4(+hl: Nat, -h: B.Buf, +o: T.Bitvector4, +seg: U32) -> {T.bv4_root(hl, h, o, seg) == (h, d_bv4(hl, o)) : B.Buf & D.Digest}:
  match o:
    case T.Bitvector4{+w0}: {==}
