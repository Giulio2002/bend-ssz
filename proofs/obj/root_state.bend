  for +W: List<&2, T.HistoricalSummary>
  for +i: Nat
  for +hi: {Nat.is_lt(i, F.spec_common__length(T.HistoricalSummary, W)) == True{} : Bool}
  {F.spec_common__nth(T.HistoricalSummary, W, i) == Some{xat_l16777216_HistoricalSummary(W, i)} : Maybe<&2, T.HistoricalSummary>}
def nth_l16777216_HistoricalSummary(W, i, hi):
  match W:
    case Nil{}: Empty.absurd({F.spec_common__nth(T.HistoricalSummary, Nil{}, i) == Some{xat_l16777216_HistoricalSummary(Nil{}, i)} : Maybe<&2, T.HistoricalSummary>}, MD.false_true(Equal.trans(Bool, False{}, Nat.is_lt(i, 0n), True{}, Equal.sym(Bool, Nat.is_lt(i, 0n), False{}, F.nat__not_lt_zero(i)), hi)))
    case Con{+x, +t}:
