  match k:
    case 0n: []
    case 1n+q: RN.d_HistoricalSummary(hl, xat_l16777216_HistoricalSummary(W, i)) <> xl_l16777216_HistoricalSummary(q, W, 1n+i, hl)
law xlen_l16777216_HistoricalSummary:
  for +k: Nat
  for +W: List<&2, T.HistoricalSummary>
  for +i: Nat
  for +hl: Nat
  {MD.dlen(xl_l16777216_HistoricalSummary(k, W, i, hl)) == k : Nat}
