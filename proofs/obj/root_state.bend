# ---- bit lengths of words (as codegen/root_laws_generic.py BITS_HEAD) ----
def bl32(ws: +List<U32>) -> Nat:
  match ws:
    case Nil{}: 0n
    case Con{+x, r}: Nat.add(32n, bl32(r))
law len_bitsof:
  for +ws: +List<U32>
  {List.length(&2, Bool, BLP.bitsof(ws)) == bl32(ws) : Nat}
def len_bitsof(ws):
  match ws:
    case Nil{}: {==}
    case Con{+x, +r}:
      %Equal.sym(Nat, List.length(&2, Bool, List.append(&2, Bool, BLF.wbits(x), BLP.bitsof(r))), Nat.add(32n, List.length(&2, Bool, BLP.bitsof(r))), BLF.len_app_w(x, BLP.bitsof(r))) :
        {_ == Nat.add(32n, bl32(r)) : Nat}
      %Equal.sym(Nat, List.length(&2, Bool, BLP.bitsof(r)), bl32(r), len_bitsof(r)) : {Nat.add(32n, _) == Nat.add(32n, bl32(r)) : Nat}
      {==}
law btk_len:
  for +n: Nat
  for +xs: +List<Bool>
  for +h: {Nat.is_le(n, List.length(&2, Bool, xs)) == True{} : Bool}
  {List.length(&2, Bool, BLP.btk(n, xs)) == n : Nat}
def btk_len(n, xs, h):
  match n:
    case 0n: {==}
    case 1n+ +p:
      match xs:
        case Nil{}: Empty.absurd({List.length(&2, Bool, BLP.btk(1n+p, Nil{})) == 1n+p : Nat}, MD.false_true(h))
        case Con{+b, +t}:
          %Equal.sym(Nat, List.length(&2, Bool, BLP.btk(p, t)), p, btk_len(p, t, h)) : {1n+_ == 1n+p : Nat}
          {==}

# ---- bv4: Bitvector[4] in one word (a Data field) ----
def bv4_lh(+a0: Bool, +a1: Bool, +a2: Bool, +a3: Bool) -> {Nat.is_le(4n, List.length(&2, Bool, BLP.bitsof([U32{WSp.join(4n, 28n, WCon{a0, WCon{a1, WCon{a2, WCon{a3, WNil{}}}}}, Word.zero(28n))}]))) == True{} : Bool}:
  %Equal.sym(Nat, List.length(&2, Bool, BLP.bitsof([U32{WSp.join(4n, 28n, WCon{a0, WCon{a1, WCon{a2, WCon{a3, WNil{}}}}}, Word.zero(28n))}])), bl32([U32{WSp.join(4n, 28n, WCon{a0, WCon{a1, WCon{a2, WCon{a3, WNil{}}}}}, Word.zero(28n))}]), len_bitsof([U32{WSp.join(4n, 28n, WCon{a0, WCon{a1, WCon{a2, WCon{a3, WNil{}}}}}, Word.zero(28n))}])) :
    {Nat.is_le(4n, _) == True{} : Bool}
