    case 1n+ +q:
      %xlen_l16777216_HistoricalSummary(q, W, 1n+i, hl) : {1n+MD.dlen(xl_l16777216_HistoricalSummary(q, W, 1n+i, hl)) == 1n+_ : Nat}
      {==}
law xat_at_l16777216_HistoricalSummary:
