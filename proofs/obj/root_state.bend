        case 0n: Empty.absurd({MD.dhead(MD.ddrop(1n+p1, xl_l16777216_HistoricalSummary(0n, W, i, hl))) == RN.d_HistoricalSummary(hl, xat_l16777216_HistoricalSummary(W, Nat.add(1n+p1, i))) : D.Digest}, MD.false_true(e))
        case 1n+ +q:
          %MR.add_succ(p1, i) : {MD.dhead(MD.ddrop(p1, xl_l16777216_HistoricalSummary(q, W, 1n+i, hl))) == RN.d_HistoricalSummary(hl, xat_l16777216_HistoricalSummary(W, _)) : D.Digest}
          xat_at_l16777216_HistoricalSummary(p1, q, W, 1n+i, hl, e)
