def vec_bool_513_rj(+bs: +List<U32>, +h: {Bool.and(Nat.is_eq(List.length(&2, U32, bs), 513n), VRB.ALLB(bs)) == False{} : Bool}, +v: S.Value, +e: {Codec.encoding_for_legal_type(GS.vec_bool_513(), v) == Some{bs} : Maybe<&2, +List<U32>>}) -> Empty:
