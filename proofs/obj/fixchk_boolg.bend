      %Equal.sym(+List<U32>, UW.WX(t, VRL.pos(j, 1n, x), 1n), Con{VRB.BX(t, VRL.pos(j, 1n, x)), UW.WX(t, 1n+VRL.pos(j, 1n, x), 0n)}, VRB.wxc(d, t, VRL.pos(j, 1n, x), 0n, pf, hy)) :
        {(UA.BF(t, n), Bool.and(acc, U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1))) == (UA.BF(t, n), Bool.and(acc, VRB.ALLB(_))) : B.Buf & Bool}
      %Equal.sym(Bool, Bool.and(U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1), True{}), U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1), VRB.and_true(U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1))) :
        {(UA.BF(t, n), Bool.and(acc, U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1))) == (UA.BF(t, n), Bool.and(acc, _)) : B.Buf & Bool}
      {==}
    case 1n+ +q:
    +hy = FD.nat__lt_le_trans(VRL.pos(j, 1n, x), 1n+VRL.pos(j, 1n, x), A.quad(VB.pw(d)), FD.nat__lt_succ(VRL.pos(j, 1n, x)), FD.nat__le_trans(1n+VRL.pos(j, 1n, x), VRL.pos(Nat.add(1n+k, j), 1n, x), A.quad(VB.pw(d)), VRB.pmk(k, j, x), hb))
      +c = U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1)
      +R = VRB.ALLB(UW.WX(t, VRL.pos(1n+j, 1n, x), 1n+q))
      +hx = VRL.nextfit(j, q, 1n, x, A.quad(VB.pw(d)), hb)
      +ex = VRL.posU(d, off, x, i, j, 1, 0n, {==}, e, ej, hd, hx)
      +hx1 = FD.nat__lt_le_trans(VRL.pos(1n+j, 1n, x), Nat.add(VRL.pos(1n+j, 1n, x), 1n), A.quad(VB.pw(d)), VTX.ltp(VRL.pos(1n+j, 1n, x), 0n), hx)
      +hb2 = FD.logic__subst(Nat, z => {Nat.is_le(VRL.pos(1n+z, 1n, x), A.quad(VB.pw(d))) == True{} : Bool}, 1n+Nat.add(q, j), Nat.add(q, 1n+j), Equal.sym(Nat, Nat.add(q, 1n+j), 1n+Nat.add(q, j), FD.nat__add_succ(q, j)), hb)
      %Equal.sym(+List<U32>, UW.WX(t, VRL.pos(j, 1n, x), 2n+q), Con{VRB.BX(t, VRL.pos(j, 1n, x)), UW.WX(t, 1n+VRL.pos(j, 1n, x), 1n+q)}, VRB.wxc(d, t, VRL.pos(j, 1n, x), 1n+q, pf, hy)) :
        {vec_bool_1_r.v1_bool_ck(1n+q, i, off, acc, (UA.BF(t, n), c)) == (UA.BF(t, n), Bool.and(acc, VRB.ALLB(_))) : B.Buf & Bool}
      %VRB.and_assoc(acc, c, R) : {vec_bool_1_r.v1_bool_ck(1n+q, i, off, acc, (UA.BF(t, n), c)) == (UA.BF(t, n), _) : B.Buf & Bool}
      %Equal.sym(B.Buf & Bool, O.ok_bool(UA.BF(t, n), U32.add(off, U32.mul(U32.add(i, 1), 1))), (UA.BF(t, n), U32.is_le(VRB.BX(t, VRL.pos(1n+j, 1n, x)), 1)),
          VRB.okb(d, t, n, U32.add(off, U32.mul(U32.add(i, 1), 1)), VRL.pos(1n+j, 1n, x), ex, hd, pf, hx1)) :
        {vec_bool_1_r.v1_bool_ck(q, U32.add(i, 1), off, Bool.and(acc, c), _) == (UA.BF(t, n), Bool.and(Bool.and(acc, c), R)) : B.Buf & Bool}
      vec_bool_1_ck(q, d, t, n, off, x, U32.add(i, 1), 1n+j, Bool.and(acc, c), e, VRL.succU(d, i, j, 0n, x, ej, hd, hx), hd, pf, hb2)

def vec_bool_1_at(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 1n), A.quad(VB.pw(d))) == True{} : Bool})
    -> {vec_bool_1_r.v1_bool_ok_at(UA.BF(t, n), off) == (UA.BF(t, n), VRB.ALLB(UW.WX(t, x, 1n))) : B.Buf & Bool}:
  +hx = FD.nat__lt_le_trans(x, Nat.add(x, 1n), A.quad(VB.pw(d)), VTX.ltp(x, 0n), hb)
  +hk = FD.logic__subst(Nat, z => {Nat.is_le(z, A.quad(VB.pw(d))) == True{} : Bool}, Nat.add(x, 1n), Nat.add(1n, x), FD.nat__add_comm(x, 1n), hb)
  %Equal.sym(B.Buf & Bool, O.ok_bool(UA.BF(t, n), off), (UA.BF(t, n), U32.is_le(VRB.BX(t, x), 1)), VRB.okb(d, t, n, off, x, e, hd, pf, hx)) :
    {vec_bool_1_r.v1_bool_ck(0n, 0, off, True{}, _) == (UA.BF(t, n), VRB.ALLB(UW.WX(t, x, 1n))) : B.Buf & Bool}
  vec_bool_1_ck(0n, d, t, n, off, x, 0, 0n, True{}, e, {==}, hd, pf, hk)

def vec_bool_1_okl(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 1n), A.quad(VB.pw(d))) == True{} : Bool}, +b: Bool)
    -> {vec_bool_1_r.v1_bool_ok_len(b, UA.BF(t, n), off) == (UA.BF(t, n), Bool.and(b, VRB.ALLB(UW.WX(t, x, 1n)))) : B.Buf & Bool}:
  match b:
    case True{}: vec_bool_1_at(d, t, n, off, x, e, hd, pf, hb)
    case False{}: {==}

# the validator returns the length check and ALLB of the N window bytes
def vec_bool_1_ok_eval(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 1n), A.quad(VB.pw(d))) == True{} : Bool}, +len: U32)
    -> {vec_bool_1_r.v1_bool_ok(UA.BF(t, n), off, len) == (UA.BF(t, n), Bool.and(U32.is_eq(len, 1), VRB.ALLB(UW.WX(t, x, 1n)))) : B.Buf & Bool}:
  vec_bool_1_okl(d, t, n, off, x, e, hd, pf, hb, U32.is_eq(len, 1))

# the check loop from byte j (index i) on: acc and ALLB of the next 1 + k window bytes
def vec_bool_1_ckD(+k: Nat, +d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +i: U32, +j: Nat, +acc: Bool,
    +e: {U32.to_nat(off) == x : Nat}, +ej: {U32.to_nat(i) == j : Nat}, +hd: {Nat.is_lt(d, 31n) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hb: {Nat.is_le(VRL.pos(Nat.add(1n+k, j), 1n, x), A.quad(VB.pw(d))) == True{} : Bool}, +hs: {Nat.is_lt(VRL.pos(Nat.add(1n+k, j), 1n, x), FD.spec_common__pow2(32n)) == True{} : Bool})
    -> {vec_bool_1_r.v1_bool_ck(k, i, off, acc, (UA.BF(t, n), U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1))) == (UA.BF(t, n), Bool.and(acc, VRB.ALLB(UW.WX(t, VRL.pos(j, 1n, x), 1n+k)))) : B.Buf & Bool}:
  match k:
    case 0n:
    +hy = FD.nat__lt_le_trans(VRL.pos(j, 1n, x), 1n+VRL.pos(j, 1n, x), A.quad(VB.pw(d)), FD.nat__lt_succ(VRL.pos(j, 1n, x)), FD.nat__le_trans(1n+VRL.pos(j, 1n, x), VRL.pos(Nat.add(1n+k, j), 1n, x), A.quad(VB.pw(d)), VRB.pmk(k, j, x), hb))
      %Equal.sym(+List<U32>, UW.WX(t, VRL.pos(j, 1n, x), 1n), Con{VRB.BX(t, VRL.pos(j, 1n, x)), UW.WX(t, 1n+VRL.pos(j, 1n, x), 0n)}, VRB.wxc(d, t, VRL.pos(j, 1n, x), 0n, pf, hy)) :
        {(UA.BF(t, n), Bool.and(acc, U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1))) == (UA.BF(t, n), Bool.and(acc, VRB.ALLB(_))) : B.Buf & Bool}
      %Equal.sym(Bool, Bool.and(U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1), True{}), U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1), VRB.and_true(U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1))) :
        {(UA.BF(t, n), Bool.and(acc, U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1))) == (UA.BF(t, n), Bool.and(acc, _)) : B.Buf & Bool}
      {==}
    case 1n+ +q:
    +hy = FD.nat__lt_le_trans(VRL.pos(j, 1n, x), 1n+VRL.pos(j, 1n, x), A.quad(VB.pw(d)), FD.nat__lt_succ(VRL.pos(j, 1n, x)), FD.nat__le_trans(1n+VRL.pos(j, 1n, x), VRL.pos(Nat.add(1n+k, j), 1n, x), A.quad(VB.pw(d)), VRB.pmk(k, j, x), hb))
      +c = U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1)
      +R = VRB.ALLB(UW.WX(t, VRL.pos(1n+j, 1n, x), 1n+q))
      +hx = VRL.nextfit(j, q, 1n, x, A.quad(VB.pw(d)), hb)
      +hx32 = FD.nat__le_lt_trans(Nat.add(VRL.pos(1n+j, 1n, x), 1n), VRL.pos(Nat.add(2n+q, j), 1n, x), FD.spec_common__pow2(32n), VRL.nextfit(j, q, 1n, x, VRL.pos(Nat.add(2n+q, j), 1n, x), FD.nat__le_refl(VRL.pos(Nat.add(2n+q, j), 1n, x))), hs)
  +ex = VRL.posU32(off, x, i, j, 1, 0n, {==}, e, ej, hx32)
  +hs2 = FD.logic__subst(Nat, z => {Nat.is_lt(VRL.pos(1n+z, 1n, x), FD.spec_common__pow2(32n)) == True{} : Bool}, 1n+Nat.add(q, j), Nat.add(q, 1n+j), Equal.sym(Nat, Nat.add(q, 1n+j), 1n+Nat.add(q, j), FD.nat__add_succ(q, j)), hs)
      +hx1 = FD.nat__lt_le_trans(VRL.pos(1n+j, 1n, x), Nat.add(VRL.pos(1n+j, 1n, x), 1n), A.quad(VB.pw(d)), VTX.ltp(VRL.pos(1n+j, 1n, x), 0n), hx)
      +hb2 = FD.logic__subst(Nat, z => {Nat.is_le(VRL.pos(1n+z, 1n, x), A.quad(VB.pw(d))) == True{} : Bool}, 1n+Nat.add(q, j), Nat.add(q, 1n+j), Equal.sym(Nat, Nat.add(q, 1n+j), 1n+Nat.add(q, j), FD.nat__add_succ(q, j)), hb)
      %Equal.sym(+List<U32>, UW.WX(t, VRL.pos(j, 1n, x), 2n+q), Con{VRB.BX(t, VRL.pos(j, 1n, x)), UW.WX(t, 1n+VRL.pos(j, 1n, x), 1n+q)}, VRB.wxc(d, t, VRL.pos(j, 1n, x), 1n+q, pf, hy)) :
        {vec_bool_1_r.v1_bool_ck(1n+q, i, off, acc, (UA.BF(t, n), c)) == (UA.BF(t, n), Bool.and(acc, VRB.ALLB(_))) : B.Buf & Bool}
      %VRB.and_assoc(acc, c, R) : {vec_bool_1_r.v1_bool_ck(1n+q, i, off, acc, (UA.BF(t, n), c)) == (UA.BF(t, n), _) : B.Buf & Bool}
      %Equal.sym(B.Buf & Bool, O.ok_bool(UA.BF(t, n), U32.add(off, U32.mul(U32.add(i, 1), 1))), (UA.BF(t, n), U32.is_le(VRB.BX(t, VRL.pos(1n+j, 1n, x)), 1)),
          VRB.okbD(d, t, n, U32.add(off, U32.mul(U32.add(i, 1), 1)), VRL.pos(1n+j, 1n, x), ex, hd, pf, hx1)) :
        {vec_bool_1_r.v1_bool_ck(q, U32.add(i, 1), off, Bool.and(acc, c), _) == (UA.BF(t, n), Bool.and(Bool.and(acc, c), R)) : B.Buf & Bool}
      vec_bool_1_ckD(q, d, t, n, off, x, U32.add(i, 1), 1n+j, Bool.and(acc, c), e, VRL.succU32(i, j, 0n, x, ej, hx32), hd, pf, hb2, hs2)

def vec_bool_1_atD(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 1n), A.quad(VB.pw(d))) == True{} : Bool}, +hs: {Nat.is_lt(Nat.add(x, 1n), FD.spec_common__pow2(32n)) == True{} : Bool})
    -> {vec_bool_1_r.v1_bool_ok_at(UA.BF(t, n), off) == (UA.BF(t, n), VRB.ALLB(UW.WX(t, x, 1n))) : B.Buf & Bool}:
  +hx = FD.nat__lt_le_trans(x, Nat.add(x, 1n), A.quad(VB.pw(d)), VTX.ltp(x, 0n), hb)
  +hk = FD.logic__subst(Nat, z => {Nat.is_le(z, A.quad(VB.pw(d))) == True{} : Bool}, Nat.add(x, 1n), Nat.add(1n, x), FD.nat__add_comm(x, 1n), hb)
  %Equal.sym(B.Buf & Bool, O.ok_bool(UA.BF(t, n), off), (UA.BF(t, n), U32.is_le(VRB.BX(t, x), 1)), VRB.okbD(d, t, n, off, x, e, hd, pf, hx)) :
    {vec_bool_1_r.v1_bool_ck(0n, 0, off, True{}, _) == (UA.BF(t, n), VRB.ALLB(UW.WX(t, x, 1n))) : B.Buf & Bool}
  +hk32 = FD.logic__subst(Nat, z => {Nat.is_lt(z, FD.spec_common__pow2(32n)) == True{} : Bool}, Nat.add(x, 1n), Nat.add(1n, x), FD.nat__add_comm(x, 1n), hs)
  vec_bool_1_ckD(0n, d, t, n, off, x, 0, 0n, True{}, e, {==}, hd, pf, hk, hk32)

def vec_bool_1_oklD(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 1n), A.quad(VB.pw(d))) == True{} : Bool}, +hs: {Nat.is_lt(Nat.add(x, 1n), FD.spec_common__pow2(32n)) == True{} : Bool}, +b: Bool)
    -> {vec_bool_1_r.v1_bool_ok_len(b, UA.BF(t, n), off) == (UA.BF(t, n), Bool.and(b, VRB.ALLB(UW.WX(t, x, 1n)))) : B.Buf & Bool}:
  match b:
    case True{}: vec_bool_1_atD(d, t, n, off, x, e, hd, pf, hb, hs)
    case False{}: {==}

# the validator returns the length check and ALLB of the N window bytes
def vec_bool_1_ok_evalD(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 1n), A.quad(VB.pw(d))) == True{} : Bool}, +hs: {Nat.is_lt(Nat.add(x, 1n), FD.spec_common__pow2(32n)) == True{} : Bool}, +len: U32)
    -> {vec_bool_1_r.v1_bool_ok(UA.BF(t, n), off, len) == (UA.BF(t, n), Bool.and(U32.is_eq(len, 1), VRB.ALLB(UW.WX(t, x, 1n)))) : B.Buf & Bool}:
  vec_bool_1_oklD(d, t, n, off, x, e, hd, pf, hb, hs, U32.is_eq(len, 1))

def vec_bool_1_rj(+bs: +List<U32>, +h: {Bool.and(Nat.is_eq(List.length(&2, U32, bs), 1n), VRB.ALLB(bs)) == False{} : Bool}, +v: S.Value, +e: {Codec.encoding_for_legal_type(GS.vec_bool_1(), v) == Some{bs} : Maybe<&2, +List<U32>>}) -> Empty:
  VRB.chk_true(Nat.is_eq(List.length(&2, U32, bs), 1n), VRB.ALLB(bs),
    VRB.len_eq(SS.fixed_size(GS.vec_bool_1()), 1n, bs, Codec.parts(v, GS.vec_bool_1()), DS.facts(v, GS.vec_bool_1(), {==}), {==}, e),
    VRB.vecb(v, 1n, bs, e), h)

# a byte list of another length, or with a byte above 1, is no encoding
def vec_bool_1_decode_reject(+bs: +List<U32>, +h: {Bool.and(Nat.is_eq(List.length(&2, U32, bs), 1n), VRB.ALLB(bs)) == False{} : Bool}) -> Decoding.outside_image(GS.vec_bool_1(), bs):
  v => e => vec_bool_1_rj(bs, h, v, e)

# ---- vec_bool_2 (2 bytes; validator T.v2_bool_ok: every byte a boolean) ----
# the check loop from byte j (index i) on: acc and ALLB of the next 1 + k window bytes
def vec_bool_2_ck(+k: Nat, +d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +i: U32, +j: Nat, +acc: Bool,
    +e: {U32.to_nat(off) == x : Nat}, +ej: {U32.to_nat(i) == j : Nat}, +hd: {Nat.is_lt(d, 28n) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hb: {Nat.is_le(VRL.pos(Nat.add(1n+k, j), 1n, x), A.quad(VB.pw(d))) == True{} : Bool})
    -> {vec_bool_2_r.v2_bool_ck(k, i, off, acc, (UA.BF(t, n), U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1))) == (UA.BF(t, n), Bool.and(acc, VRB.ALLB(UW.WX(t, VRL.pos(j, 1n, x), 1n+k)))) : B.Buf & Bool}:
  match k:
    case 0n:
    +hy = FD.nat__lt_le_trans(VRL.pos(j, 1n, x), 1n+VRL.pos(j, 1n, x), A.quad(VB.pw(d)), FD.nat__lt_succ(VRL.pos(j, 1n, x)), FD.nat__le_trans(1n+VRL.pos(j, 1n, x), VRL.pos(Nat.add(1n+k, j), 1n, x), A.quad(VB.pw(d)), VRB.pmk(k, j, x), hb))
      %Equal.sym(+List<U32>, UW.WX(t, VRL.pos(j, 1n, x), 1n), Con{VRB.BX(t, VRL.pos(j, 1n, x)), UW.WX(t, 1n+VRL.pos(j, 1n, x), 0n)}, VRB.wxc(d, t, VRL.pos(j, 1n, x), 0n, pf, hy)) :
        {(UA.BF(t, n), Bool.and(acc, U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1))) == (UA.BF(t, n), Bool.and(acc, VRB.ALLB(_))) : B.Buf & Bool}
      %Equal.sym(Bool, Bool.and(U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1), True{}), U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1), VRB.and_true(U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1))) :
        {(UA.BF(t, n), Bool.and(acc, U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1))) == (UA.BF(t, n), Bool.and(acc, _)) : B.Buf & Bool}
      {==}
    case 1n+ +q:
    +hy = FD.nat__lt_le_trans(VRL.pos(j, 1n, x), 1n+VRL.pos(j, 1n, x), A.quad(VB.pw(d)), FD.nat__lt_succ(VRL.pos(j, 1n, x)), FD.nat__le_trans(1n+VRL.pos(j, 1n, x), VRL.pos(Nat.add(1n+k, j), 1n, x), A.quad(VB.pw(d)), VRB.pmk(k, j, x), hb))
      +c = U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1)
      +R = VRB.ALLB(UW.WX(t, VRL.pos(1n+j, 1n, x), 1n+q))
      +hx = VRL.nextfit(j, q, 1n, x, A.quad(VB.pw(d)), hb)
      +ex = VRL.posU(d, off, x, i, j, 1, 0n, {==}, e, ej, hd, hx)
      +hx1 = FD.nat__lt_le_trans(VRL.pos(1n+j, 1n, x), Nat.add(VRL.pos(1n+j, 1n, x), 1n), A.quad(VB.pw(d)), VTX.ltp(VRL.pos(1n+j, 1n, x), 0n), hx)
      +hb2 = FD.logic__subst(Nat, z => {Nat.is_le(VRL.pos(1n+z, 1n, x), A.quad(VB.pw(d))) == True{} : Bool}, 1n+Nat.add(q, j), Nat.add(q, 1n+j), Equal.sym(Nat, Nat.add(q, 1n+j), 1n+Nat.add(q, j), FD.nat__add_succ(q, j)), hb)
      %Equal.sym(+List<U32>, UW.WX(t, VRL.pos(j, 1n, x), 2n+q), Con{VRB.BX(t, VRL.pos(j, 1n, x)), UW.WX(t, 1n+VRL.pos(j, 1n, x), 1n+q)}, VRB.wxc(d, t, VRL.pos(j, 1n, x), 1n+q, pf, hy)) :
        {vec_bool_2_r.v2_bool_ck(1n+q, i, off, acc, (UA.BF(t, n), c)) == (UA.BF(t, n), Bool.and(acc, VRB.ALLB(_))) : B.Buf & Bool}
      %VRB.and_assoc(acc, c, R) : {vec_bool_2_r.v2_bool_ck(1n+q, i, off, acc, (UA.BF(t, n), c)) == (UA.BF(t, n), _) : B.Buf & Bool}
      %Equal.sym(B.Buf & Bool, O.ok_bool(UA.BF(t, n), U32.add(off, U32.mul(U32.add(i, 1), 1))), (UA.BF(t, n), U32.is_le(VRB.BX(t, VRL.pos(1n+j, 1n, x)), 1)),
          VRB.okb(d, t, n, U32.add(off, U32.mul(U32.add(i, 1), 1)), VRL.pos(1n+j, 1n, x), ex, hd, pf, hx1)) :
        {vec_bool_2_r.v2_bool_ck(q, U32.add(i, 1), off, Bool.and(acc, c), _) == (UA.BF(t, n), Bool.and(Bool.and(acc, c), R)) : B.Buf & Bool}
      vec_bool_2_ck(q, d, t, n, off, x, U32.add(i, 1), 1n+j, Bool.and(acc, c), e, VRL.succU(d, i, j, 0n, x, ej, hd, hx), hd, pf, hb2)

def vec_bool_2_at(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 2n), A.quad(VB.pw(d))) == True{} : Bool})
    -> {vec_bool_2_r.v2_bool_ok_at(UA.BF(t, n), off) == (UA.BF(t, n), VRB.ALLB(UW.WX(t, x, 2n))) : B.Buf & Bool}:
  +hx = FD.nat__lt_le_trans(x, Nat.add(x, 2n), A.quad(VB.pw(d)), VTX.ltp(x, 1n), hb)
  +hk = FD.logic__subst(Nat, z => {Nat.is_le(z, A.quad(VB.pw(d))) == True{} : Bool}, Nat.add(x, 2n), Nat.add(2n, x), FD.nat__add_comm(x, 2n), hb)
  %Equal.sym(B.Buf & Bool, O.ok_bool(UA.BF(t, n), off), (UA.BF(t, n), U32.is_le(VRB.BX(t, x), 1)), VRB.okb(d, t, n, off, x, e, hd, pf, hx)) :
    {vec_bool_2_r.v2_bool_ck(1n, 0, off, True{}, _) == (UA.BF(t, n), VRB.ALLB(UW.WX(t, x, 2n))) : B.Buf & Bool}
  vec_bool_2_ck(1n, d, t, n, off, x, 0, 0n, True{}, e, {==}, hd, pf, hk)

def vec_bool_2_okl(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 2n), A.quad(VB.pw(d))) == True{} : Bool}, +b: Bool)
    -> {vec_bool_2_r.v2_bool_ok_len(b, UA.BF(t, n), off) == (UA.BF(t, n), Bool.and(b, VRB.ALLB(UW.WX(t, x, 2n)))) : B.Buf & Bool}:
  match b:
    case True{}: vec_bool_2_at(d, t, n, off, x, e, hd, pf, hb)
    case False{}: {==}

# the validator returns the length check and ALLB of the N window bytes
def vec_bool_2_ok_eval(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 2n), A.quad(VB.pw(d))) == True{} : Bool}, +len: U32)
    -> {vec_bool_2_r.v2_bool_ok(UA.BF(t, n), off, len) == (UA.BF(t, n), Bool.and(U32.is_eq(len, 2), VRB.ALLB(UW.WX(t, x, 2n)))) : B.Buf & Bool}:
  vec_bool_2_okl(d, t, n, off, x, e, hd, pf, hb, U32.is_eq(len, 2))

# the check loop from byte j (index i) on: acc and ALLB of the next 1 + k window bytes
def vec_bool_2_ckD(+k: Nat, +d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +i: U32, +j: Nat, +acc: Bool,
    +e: {U32.to_nat(off) == x : Nat}, +ej: {U32.to_nat(i) == j : Nat}, +hd: {Nat.is_lt(d, 31n) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hb: {Nat.is_le(VRL.pos(Nat.add(1n+k, j), 1n, x), A.quad(VB.pw(d))) == True{} : Bool}, +hs: {Nat.is_lt(VRL.pos(Nat.add(1n+k, j), 1n, x), FD.spec_common__pow2(32n)) == True{} : Bool})
    -> {vec_bool_2_r.v2_bool_ck(k, i, off, acc, (UA.BF(t, n), U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1))) == (UA.BF(t, n), Bool.and(acc, VRB.ALLB(UW.WX(t, VRL.pos(j, 1n, x), 1n+k)))) : B.Buf & Bool}:
  match k:
    case 0n:
    +hy = FD.nat__lt_le_trans(VRL.pos(j, 1n, x), 1n+VRL.pos(j, 1n, x), A.quad(VB.pw(d)), FD.nat__lt_succ(VRL.pos(j, 1n, x)), FD.nat__le_trans(1n+VRL.pos(j, 1n, x), VRL.pos(Nat.add(1n+k, j), 1n, x), A.quad(VB.pw(d)), VRB.pmk(k, j, x), hb))
      %Equal.sym(+List<U32>, UW.WX(t, VRL.pos(j, 1n, x), 1n), Con{VRB.BX(t, VRL.pos(j, 1n, x)), UW.WX(t, 1n+VRL.pos(j, 1n, x), 0n)}, VRB.wxc(d, t, VRL.pos(j, 1n, x), 0n, pf, hy)) :
        {(UA.BF(t, n), Bool.and(acc, U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1))) == (UA.BF(t, n), Bool.and(acc, VRB.ALLB(_))) : B.Buf & Bool}
      %Equal.sym(Bool, Bool.and(U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1), True{}), U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1), VRB.and_true(U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1))) :
        {(UA.BF(t, n), Bool.and(acc, U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1))) == (UA.BF(t, n), Bool.and(acc, _)) : B.Buf & Bool}
      {==}
    case 1n+ +q:
    +hy = FD.nat__lt_le_trans(VRL.pos(j, 1n, x), 1n+VRL.pos(j, 1n, x), A.quad(VB.pw(d)), FD.nat__lt_succ(VRL.pos(j, 1n, x)), FD.nat__le_trans(1n+VRL.pos(j, 1n, x), VRL.pos(Nat.add(1n+k, j), 1n, x), A.quad(VB.pw(d)), VRB.pmk(k, j, x), hb))
      +c = U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1)
      +R = VRB.ALLB(UW.WX(t, VRL.pos(1n+j, 1n, x), 1n+q))
      +hx = VRL.nextfit(j, q, 1n, x, A.quad(VB.pw(d)), hb)
      +hx32 = FD.nat__le_lt_trans(Nat.add(VRL.pos(1n+j, 1n, x), 1n), VRL.pos(Nat.add(2n+q, j), 1n, x), FD.spec_common__pow2(32n), VRL.nextfit(j, q, 1n, x, VRL.pos(Nat.add(2n+q, j), 1n, x), FD.nat__le_refl(VRL.pos(Nat.add(2n+q, j), 1n, x))), hs)
  +ex = VRL.posU32(off, x, i, j, 1, 0n, {==}, e, ej, hx32)
  +hs2 = FD.logic__subst(Nat, z => {Nat.is_lt(VRL.pos(1n+z, 1n, x), FD.spec_common__pow2(32n)) == True{} : Bool}, 1n+Nat.add(q, j), Nat.add(q, 1n+j), Equal.sym(Nat, Nat.add(q, 1n+j), 1n+Nat.add(q, j), FD.nat__add_succ(q, j)), hs)
      +hx1 = FD.nat__lt_le_trans(VRL.pos(1n+j, 1n, x), Nat.add(VRL.pos(1n+j, 1n, x), 1n), A.quad(VB.pw(d)), VTX.ltp(VRL.pos(1n+j, 1n, x), 0n), hx)
      +hb2 = FD.logic__subst(Nat, z => {Nat.is_le(VRL.pos(1n+z, 1n, x), A.quad(VB.pw(d))) == True{} : Bool}, 1n+Nat.add(q, j), Nat.add(q, 1n+j), Equal.sym(Nat, Nat.add(q, 1n+j), 1n+Nat.add(q, j), FD.nat__add_succ(q, j)), hb)
      %Equal.sym(+List<U32>, UW.WX(t, VRL.pos(j, 1n, x), 2n+q), Con{VRB.BX(t, VRL.pos(j, 1n, x)), UW.WX(t, 1n+VRL.pos(j, 1n, x), 1n+q)}, VRB.wxc(d, t, VRL.pos(j, 1n, x), 1n+q, pf, hy)) :
        {vec_bool_2_r.v2_bool_ck(1n+q, i, off, acc, (UA.BF(t, n), c)) == (UA.BF(t, n), Bool.and(acc, VRB.ALLB(_))) : B.Buf & Bool}
      %VRB.and_assoc(acc, c, R) : {vec_bool_2_r.v2_bool_ck(1n+q, i, off, acc, (UA.BF(t, n), c)) == (UA.BF(t, n), _) : B.Buf & Bool}
      %Equal.sym(B.Buf & Bool, O.ok_bool(UA.BF(t, n), U32.add(off, U32.mul(U32.add(i, 1), 1))), (UA.BF(t, n), U32.is_le(VRB.BX(t, VRL.pos(1n+j, 1n, x)), 1)),
          VRB.okbD(d, t, n, U32.add(off, U32.mul(U32.add(i, 1), 1)), VRL.pos(1n+j, 1n, x), ex, hd, pf, hx1)) :
        {vec_bool_2_r.v2_bool_ck(q, U32.add(i, 1), off, Bool.and(acc, c), _) == (UA.BF(t, n), Bool.and(Bool.and(acc, c), R)) : B.Buf & Bool}
      vec_bool_2_ckD(q, d, t, n, off, x, U32.add(i, 1), 1n+j, Bool.and(acc, c), e, VRL.succU32(i, j, 0n, x, ej, hx32), hd, pf, hb2, hs2)

def vec_bool_2_atD(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 2n), A.quad(VB.pw(d))) == True{} : Bool}, +hs: {Nat.is_lt(Nat.add(x, 2n), FD.spec_common__pow2(32n)) == True{} : Bool})
    -> {vec_bool_2_r.v2_bool_ok_at(UA.BF(t, n), off) == (UA.BF(t, n), VRB.ALLB(UW.WX(t, x, 2n))) : B.Buf & Bool}:
  +hx = FD.nat__lt_le_trans(x, Nat.add(x, 2n), A.quad(VB.pw(d)), VTX.ltp(x, 1n), hb)
  +hk = FD.logic__subst(Nat, z => {Nat.is_le(z, A.quad(VB.pw(d))) == True{} : Bool}, Nat.add(x, 2n), Nat.add(2n, x), FD.nat__add_comm(x, 2n), hb)
  %Equal.sym(B.Buf & Bool, O.ok_bool(UA.BF(t, n), off), (UA.BF(t, n), U32.is_le(VRB.BX(t, x), 1)), VRB.okbD(d, t, n, off, x, e, hd, pf, hx)) :
    {vec_bool_2_r.v2_bool_ck(1n, 0, off, True{}, _) == (UA.BF(t, n), VRB.ALLB(UW.WX(t, x, 2n))) : B.Buf & Bool}
  +hk32 = FD.logic__subst(Nat, z => {Nat.is_lt(z, FD.spec_common__pow2(32n)) == True{} : Bool}, Nat.add(x, 2n), Nat.add(2n, x), FD.nat__add_comm(x, 2n), hs)
  vec_bool_2_ckD(1n, d, t, n, off, x, 0, 0n, True{}, e, {==}, hd, pf, hk, hk32)

def vec_bool_2_oklD(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 2n), A.quad(VB.pw(d))) == True{} : Bool}, +hs: {Nat.is_lt(Nat.add(x, 2n), FD.spec_common__pow2(32n)) == True{} : Bool}, +b: Bool)
    -> {vec_bool_2_r.v2_bool_ok_len(b, UA.BF(t, n), off) == (UA.BF(t, n), Bool.and(b, VRB.ALLB(UW.WX(t, x, 2n)))) : B.Buf & Bool}:
  match b:
    case True{}: vec_bool_2_atD(d, t, n, off, x, e, hd, pf, hb, hs)
    case False{}: {==}

# the validator returns the length check and ALLB of the N window bytes
def vec_bool_2_ok_evalD(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 2n), A.quad(VB.pw(d))) == True{} : Bool}, +hs: {Nat.is_lt(Nat.add(x, 2n), FD.spec_common__pow2(32n)) == True{} : Bool}, +len: U32)
    -> {vec_bool_2_r.v2_bool_ok(UA.BF(t, n), off, len) == (UA.BF(t, n), Bool.and(U32.is_eq(len, 2), VRB.ALLB(UW.WX(t, x, 2n)))) : B.Buf & Bool}:
  vec_bool_2_oklD(d, t, n, off, x, e, hd, pf, hb, hs, U32.is_eq(len, 2))

def vec_bool_2_rj(+bs: +List<U32>, +h: {Bool.and(Nat.is_eq(List.length(&2, U32, bs), 2n), VRB.ALLB(bs)) == False{} : Bool}, +v: S.Value, +e: {Codec.encoding_for_legal_type(GS.vec_bool_2(), v) == Some{bs} : Maybe<&2, +List<U32>>}) -> Empty:
  VRB.chk_true(Nat.is_eq(List.length(&2, U32, bs), 2n), VRB.ALLB(bs),
    VRB.len_eq(SS.fixed_size(GS.vec_bool_2()), 2n, bs, Codec.parts(v, GS.vec_bool_2()), DS.facts(v, GS.vec_bool_2(), {==}), {==}, e),
    VRB.vecb(v, 2n, bs, e), h)

# a byte list of another length, or with a byte above 1, is no encoding
def vec_bool_2_decode_reject(+bs: +List<U32>, +h: {Bool.and(Nat.is_eq(List.length(&2, U32, bs), 2n), VRB.ALLB(bs)) == False{} : Bool}) -> Decoding.outside_image(GS.vec_bool_2(), bs):
  v => e => vec_bool_2_rj(bs, h, v, e)

# ---- vec_bool_31 (31 bytes; validator T.v31_bool_ok: every byte a boolean) ----
# the check loop from byte j (index i) on: acc and ALLB of the next 1 + k window bytes
def vec_bool_31_ck(+k: Nat, +d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +i: U32, +j: Nat, +acc: Bool,
    +e: {U32.to_nat(off) == x : Nat}, +ej: {U32.to_nat(i) == j : Nat}, +hd: {Nat.is_lt(d, 28n) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hb: {Nat.is_le(VRL.pos(Nat.add(1n+k, j), 1n, x), A.quad(VB.pw(d))) == True{} : Bool})
    -> {vec_bool_31_r.v31_bool_ck(k, i, off, acc, (UA.BF(t, n), U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1))) == (UA.BF(t, n), Bool.and(acc, VRB.ALLB(UW.WX(t, VRL.pos(j, 1n, x), 1n+k)))) : B.Buf & Bool}:
  match k:
    case 0n:
    +hy = FD.nat__lt_le_trans(VRL.pos(j, 1n, x), 1n+VRL.pos(j, 1n, x), A.quad(VB.pw(d)), FD.nat__lt_succ(VRL.pos(j, 1n, x)), FD.nat__le_trans(1n+VRL.pos(j, 1n, x), VRL.pos(Nat.add(1n+k, j), 1n, x), A.quad(VB.pw(d)), VRB.pmk(k, j, x), hb))
      %Equal.sym(+List<U32>, UW.WX(t, VRL.pos(j, 1n, x), 1n), Con{VRB.BX(t, VRL.pos(j, 1n, x)), UW.WX(t, 1n+VRL.pos(j, 1n, x), 0n)}, VRB.wxc(d, t, VRL.pos(j, 1n, x), 0n, pf, hy)) :
        {(UA.BF(t, n), Bool.and(acc, U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1))) == (UA.BF(t, n), Bool.and(acc, VRB.ALLB(_))) : B.Buf & Bool}
      %Equal.sym(Bool, Bool.and(U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1), True{}), U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1), VRB.and_true(U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1))) :
        {(UA.BF(t, n), Bool.and(acc, U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1))) == (UA.BF(t, n), Bool.and(acc, _)) : B.Buf & Bool}
      {==}
    case 1n+ +q:
    +hy = FD.nat__lt_le_trans(VRL.pos(j, 1n, x), 1n+VRL.pos(j, 1n, x), A.quad(VB.pw(d)), FD.nat__lt_succ(VRL.pos(j, 1n, x)), FD.nat__le_trans(1n+VRL.pos(j, 1n, x), VRL.pos(Nat.add(1n+k, j), 1n, x), A.quad(VB.pw(d)), VRB.pmk(k, j, x), hb))
      +c = U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1)
      +R = VRB.ALLB(UW.WX(t, VRL.pos(1n+j, 1n, x), 1n+q))
      +hx = VRL.nextfit(j, q, 1n, x, A.quad(VB.pw(d)), hb)
      +ex = VRL.posU(d, off, x, i, j, 1, 0n, {==}, e, ej, hd, hx)
      +hx1 = FD.nat__lt_le_trans(VRL.pos(1n+j, 1n, x), Nat.add(VRL.pos(1n+j, 1n, x), 1n), A.quad(VB.pw(d)), VTX.ltp(VRL.pos(1n+j, 1n, x), 0n), hx)
      +hb2 = FD.logic__subst(Nat, z => {Nat.is_le(VRL.pos(1n+z, 1n, x), A.quad(VB.pw(d))) == True{} : Bool}, 1n+Nat.add(q, j), Nat.add(q, 1n+j), Equal.sym(Nat, Nat.add(q, 1n+j), 1n+Nat.add(q, j), FD.nat__add_succ(q, j)), hb)
      %Equal.sym(+List<U32>, UW.WX(t, VRL.pos(j, 1n, x), 2n+q), Con{VRB.BX(t, VRL.pos(j, 1n, x)), UW.WX(t, 1n+VRL.pos(j, 1n, x), 1n+q)}, VRB.wxc(d, t, VRL.pos(j, 1n, x), 1n+q, pf, hy)) :
        {vec_bool_31_r.v31_bool_ck(1n+q, i, off, acc, (UA.BF(t, n), c)) == (UA.BF(t, n), Bool.and(acc, VRB.ALLB(_))) : B.Buf & Bool}
      %VRB.and_assoc(acc, c, R) : {vec_bool_31_r.v31_bool_ck(1n+q, i, off, acc, (UA.BF(t, n), c)) == (UA.BF(t, n), _) : B.Buf & Bool}
      %Equal.sym(B.Buf & Bool, O.ok_bool(UA.BF(t, n), U32.add(off, U32.mul(U32.add(i, 1), 1))), (UA.BF(t, n), U32.is_le(VRB.BX(t, VRL.pos(1n+j, 1n, x)), 1)),
          VRB.okb(d, t, n, U32.add(off, U32.mul(U32.add(i, 1), 1)), VRL.pos(1n+j, 1n, x), ex, hd, pf, hx1)) :
        {vec_bool_31_r.v31_bool_ck(q, U32.add(i, 1), off, Bool.and(acc, c), _) == (UA.BF(t, n), Bool.and(Bool.and(acc, c), R)) : B.Buf & Bool}
      vec_bool_31_ck(q, d, t, n, off, x, U32.add(i, 1), 1n+j, Bool.and(acc, c), e, VRL.succU(d, i, j, 0n, x, ej, hd, hx), hd, pf, hb2)

def vec_bool_31_at(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 31n), A.quad(VB.pw(d))) == True{} : Bool})
    -> {vec_bool_31_r.v31_bool_ok_at(UA.BF(t, n), off) == (UA.BF(t, n), VRB.ALLB(UW.WX(t, x, 31n))) : B.Buf & Bool}:
  +hx = FD.nat__lt_le_trans(x, Nat.add(x, 31n), A.quad(VB.pw(d)), VTX.ltp(x, 30n), hb)
  +hk = FD.logic__subst(Nat, z => {Nat.is_le(z, A.quad(VB.pw(d))) == True{} : Bool}, Nat.add(x, 31n), Nat.add(31n, x), FD.nat__add_comm(x, 31n), hb)
  %Equal.sym(B.Buf & Bool, O.ok_bool(UA.BF(t, n), off), (UA.BF(t, n), U32.is_le(VRB.BX(t, x), 1)), VRB.okb(d, t, n, off, x, e, hd, pf, hx)) :
    {vec_bool_31_r.v31_bool_ck(30n, 0, off, True{}, _) == (UA.BF(t, n), VRB.ALLB(UW.WX(t, x, 31n))) : B.Buf & Bool}
  vec_bool_31_ck(30n, d, t, n, off, x, 0, 0n, True{}, e, {==}, hd, pf, hk)

def vec_bool_31_okl(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 31n), A.quad(VB.pw(d))) == True{} : Bool}, +b: Bool)
    -> {vec_bool_31_r.v31_bool_ok_len(b, UA.BF(t, n), off) == (UA.BF(t, n), Bool.and(b, VRB.ALLB(UW.WX(t, x, 31n)))) : B.Buf & Bool}:
  match b:
    case True{}: vec_bool_31_at(d, t, n, off, x, e, hd, pf, hb)
    case False{}: {==}

# the validator returns the length check and ALLB of the N window bytes
def vec_bool_31_ok_eval(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 31n), A.quad(VB.pw(d))) == True{} : Bool}, +len: U32)
    -> {vec_bool_31_r.v31_bool_ok(UA.BF(t, n), off, len) == (UA.BF(t, n), Bool.and(U32.is_eq(len, 31), VRB.ALLB(UW.WX(t, x, 31n)))) : B.Buf & Bool}:
  vec_bool_31_okl(d, t, n, off, x, e, hd, pf, hb, U32.is_eq(len, 31))

# the check loop from byte j (index i) on: acc and ALLB of the next 1 + k window bytes
def vec_bool_31_ckD(+k: Nat, +d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +i: U32, +j: Nat, +acc: Bool,
    +e: {U32.to_nat(off) == x : Nat}, +ej: {U32.to_nat(i) == j : Nat}, +hd: {Nat.is_lt(d, 31n) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hb: {Nat.is_le(VRL.pos(Nat.add(1n+k, j), 1n, x), A.quad(VB.pw(d))) == True{} : Bool}, +hs: {Nat.is_lt(VRL.pos(Nat.add(1n+k, j), 1n, x), FD.spec_common__pow2(32n)) == True{} : Bool})
    -> {vec_bool_31_r.v31_bool_ck(k, i, off, acc, (UA.BF(t, n), U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1))) == (UA.BF(t, n), Bool.and(acc, VRB.ALLB(UW.WX(t, VRL.pos(j, 1n, x), 1n+k)))) : B.Buf & Bool}:
  match k:
    case 0n:
    +hy = FD.nat__lt_le_trans(VRL.pos(j, 1n, x), 1n+VRL.pos(j, 1n, x), A.quad(VB.pw(d)), FD.nat__lt_succ(VRL.pos(j, 1n, x)), FD.nat__le_trans(1n+VRL.pos(j, 1n, x), VRL.pos(Nat.add(1n+k, j), 1n, x), A.quad(VB.pw(d)), VRB.pmk(k, j, x), hb))
      %Equal.sym(+List<U32>, UW.WX(t, VRL.pos(j, 1n, x), 1n), Con{VRB.BX(t, VRL.pos(j, 1n, x)), UW.WX(t, 1n+VRL.pos(j, 1n, x), 0n)}, VRB.wxc(d, t, VRL.pos(j, 1n, x), 0n, pf, hy)) :
        {(UA.BF(t, n), Bool.and(acc, U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1))) == (UA.BF(t, n), Bool.and(acc, VRB.ALLB(_))) : B.Buf & Bool}
      %Equal.sym(Bool, Bool.and(U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1), True{}), U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1), VRB.and_true(U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1))) :
        {(UA.BF(t, n), Bool.and(acc, U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1))) == (UA.BF(t, n), Bool.and(acc, _)) : B.Buf & Bool}
      {==}
    case 1n+ +q:
    +hy = FD.nat__lt_le_trans(VRL.pos(j, 1n, x), 1n+VRL.pos(j, 1n, x), A.quad(VB.pw(d)), FD.nat__lt_succ(VRL.pos(j, 1n, x)), FD.nat__le_trans(1n+VRL.pos(j, 1n, x), VRL.pos(Nat.add(1n+k, j), 1n, x), A.quad(VB.pw(d)), VRB.pmk(k, j, x), hb))
      +c = U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1)
      +R = VRB.ALLB(UW.WX(t, VRL.pos(1n+j, 1n, x), 1n+q))
      +hx = VRL.nextfit(j, q, 1n, x, A.quad(VB.pw(d)), hb)
      +hx32 = FD.nat__le_lt_trans(Nat.add(VRL.pos(1n+j, 1n, x), 1n), VRL.pos(Nat.add(2n+q, j), 1n, x), FD.spec_common__pow2(32n), VRL.nextfit(j, q, 1n, x, VRL.pos(Nat.add(2n+q, j), 1n, x), FD.nat__le_refl(VRL.pos(Nat.add(2n+q, j), 1n, x))), hs)
  +ex = VRL.posU32(off, x, i, j, 1, 0n, {==}, e, ej, hx32)
  +hs2 = FD.logic__subst(Nat, z => {Nat.is_lt(VRL.pos(1n+z, 1n, x), FD.spec_common__pow2(32n)) == True{} : Bool}, 1n+Nat.add(q, j), Nat.add(q, 1n+j), Equal.sym(Nat, Nat.add(q, 1n+j), 1n+Nat.add(q, j), FD.nat__add_succ(q, j)), hs)
      +hx1 = FD.nat__lt_le_trans(VRL.pos(1n+j, 1n, x), Nat.add(VRL.pos(1n+j, 1n, x), 1n), A.quad(VB.pw(d)), VTX.ltp(VRL.pos(1n+j, 1n, x), 0n), hx)
      +hb2 = FD.logic__subst(Nat, z => {Nat.is_le(VRL.pos(1n+z, 1n, x), A.quad(VB.pw(d))) == True{} : Bool}, 1n+Nat.add(q, j), Nat.add(q, 1n+j), Equal.sym(Nat, Nat.add(q, 1n+j), 1n+Nat.add(q, j), FD.nat__add_succ(q, j)), hb)
      %Equal.sym(+List<U32>, UW.WX(t, VRL.pos(j, 1n, x), 2n+q), Con{VRB.BX(t, VRL.pos(j, 1n, x)), UW.WX(t, 1n+VRL.pos(j, 1n, x), 1n+q)}, VRB.wxc(d, t, VRL.pos(j, 1n, x), 1n+q, pf, hy)) :
        {vec_bool_31_r.v31_bool_ck(1n+q, i, off, acc, (UA.BF(t, n), c)) == (UA.BF(t, n), Bool.and(acc, VRB.ALLB(_))) : B.Buf & Bool}
      %VRB.and_assoc(acc, c, R) : {vec_bool_31_r.v31_bool_ck(1n+q, i, off, acc, (UA.BF(t, n), c)) == (UA.BF(t, n), _) : B.Buf & Bool}
      %Equal.sym(B.Buf & Bool, O.ok_bool(UA.BF(t, n), U32.add(off, U32.mul(U32.add(i, 1), 1))), (UA.BF(t, n), U32.is_le(VRB.BX(t, VRL.pos(1n+j, 1n, x)), 1)),
          VRB.okbD(d, t, n, U32.add(off, U32.mul(U32.add(i, 1), 1)), VRL.pos(1n+j, 1n, x), ex, hd, pf, hx1)) :
        {vec_bool_31_r.v31_bool_ck(q, U32.add(i, 1), off, Bool.and(acc, c), _) == (UA.BF(t, n), Bool.and(Bool.and(acc, c), R)) : B.Buf & Bool}
      vec_bool_31_ckD(q, d, t, n, off, x, U32.add(i, 1), 1n+j, Bool.and(acc, c), e, VRL.succU32(i, j, 0n, x, ej, hx32), hd, pf, hb2, hs2)

def vec_bool_31_atD(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 31n), A.quad(VB.pw(d))) == True{} : Bool}, +hs: {Nat.is_lt(Nat.add(x, 31n), FD.spec_common__pow2(32n)) == True{} : Bool})
    -> {vec_bool_31_r.v31_bool_ok_at(UA.BF(t, n), off) == (UA.BF(t, n), VRB.ALLB(UW.WX(t, x, 31n))) : B.Buf & Bool}:
  +hx = FD.nat__lt_le_trans(x, Nat.add(x, 31n), A.quad(VB.pw(d)), VTX.ltp(x, 30n), hb)
  +hk = FD.logic__subst(Nat, z => {Nat.is_le(z, A.quad(VB.pw(d))) == True{} : Bool}, Nat.add(x, 31n), Nat.add(31n, x), FD.nat__add_comm(x, 31n), hb)
  %Equal.sym(B.Buf & Bool, O.ok_bool(UA.BF(t, n), off), (UA.BF(t, n), U32.is_le(VRB.BX(t, x), 1)), VRB.okbD(d, t, n, off, x, e, hd, pf, hx)) :
    {vec_bool_31_r.v31_bool_ck(30n, 0, off, True{}, _) == (UA.BF(t, n), VRB.ALLB(UW.WX(t, x, 31n))) : B.Buf & Bool}
  +hk32 = FD.logic__subst(Nat, z => {Nat.is_lt(z, FD.spec_common__pow2(32n)) == True{} : Bool}, Nat.add(x, 31n), Nat.add(31n, x), FD.nat__add_comm(x, 31n), hs)
  vec_bool_31_ckD(30n, d, t, n, off, x, 0, 0n, True{}, e, {==}, hd, pf, hk, hk32)

def vec_bool_31_oklD(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 31n), A.quad(VB.pw(d))) == True{} : Bool}, +hs: {Nat.is_lt(Nat.add(x, 31n), FD.spec_common__pow2(32n)) == True{} : Bool}, +b: Bool)
    -> {vec_bool_31_r.v31_bool_ok_len(b, UA.BF(t, n), off) == (UA.BF(t, n), Bool.and(b, VRB.ALLB(UW.WX(t, x, 31n)))) : B.Buf & Bool}:
  match b:
    case True{}: vec_bool_31_atD(d, t, n, off, x, e, hd, pf, hb, hs)
    case False{}: {==}

# the validator returns the length check and ALLB of the N window bytes
def vec_bool_31_ok_evalD(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 31n), A.quad(VB.pw(d))) == True{} : Bool}, +hs: {Nat.is_lt(Nat.add(x, 31n), FD.spec_common__pow2(32n)) == True{} : Bool}, +len: U32)
    -> {vec_bool_31_r.v31_bool_ok(UA.BF(t, n), off, len) == (UA.BF(t, n), Bool.and(U32.is_eq(len, 31), VRB.ALLB(UW.WX(t, x, 31n)))) : B.Buf & Bool}:
  vec_bool_31_oklD(d, t, n, off, x, e, hd, pf, hb, hs, U32.is_eq(len, 31))

def vec_bool_31_rj(+bs: +List<U32>, +h: {Bool.and(Nat.is_eq(List.length(&2, U32, bs), 31n), VRB.ALLB(bs)) == False{} : Bool}, +v: S.Value, +e: {Codec.encoding_for_legal_type(GS.vec_bool_31(), v) == Some{bs} : Maybe<&2, +List<U32>>}) -> Empty:
  VRB.chk_true(Nat.is_eq(List.length(&2, U32, bs), 31n), VRB.ALLB(bs),
    VRB.len_eq(SS.fixed_size(GS.vec_bool_31()), 31n, bs, Codec.parts(v, GS.vec_bool_31()), DS.facts(v, GS.vec_bool_31(), {==}), {==}, e),
    VRB.vecb(v, 31n, bs, e), h)

# a byte list of another length, or with a byte above 1, is no encoding
def vec_bool_31_decode_reject(+bs: +List<U32>, +h: {Bool.and(Nat.is_eq(List.length(&2, U32, bs), 31n), VRB.ALLB(bs)) == False{} : Bool}) -> Decoding.outside_image(GS.vec_bool_31(), bs):
  v => e => vec_bool_31_rj(bs, h, v, e)

# ---- vec_bool_3 (3 bytes; validator T.v3_bool_ok: every byte a boolean) ----
# the check loop from byte j (index i) on: acc and ALLB of the next 1 + k window bytes
def vec_bool_3_ck(+k: Nat, +d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +i: U32, +j: Nat, +acc: Bool,
    +e: {U32.to_nat(off) == x : Nat}, +ej: {U32.to_nat(i) == j : Nat}, +hd: {Nat.is_lt(d, 28n) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hb: {Nat.is_le(VRL.pos(Nat.add(1n+k, j), 1n, x), A.quad(VB.pw(d))) == True{} : Bool})
    -> {vec_bool_3_r.v3_bool_ck(k, i, off, acc, (UA.BF(t, n), U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1))) == (UA.BF(t, n), Bool.and(acc, VRB.ALLB(UW.WX(t, VRL.pos(j, 1n, x), 1n+k)))) : B.Buf & Bool}:
  match k:
    case 0n:
    +hy = FD.nat__lt_le_trans(VRL.pos(j, 1n, x), 1n+VRL.pos(j, 1n, x), A.quad(VB.pw(d)), FD.nat__lt_succ(VRL.pos(j, 1n, x)), FD.nat__le_trans(1n+VRL.pos(j, 1n, x), VRL.pos(Nat.add(1n+k, j), 1n, x), A.quad(VB.pw(d)), VRB.pmk(k, j, x), hb))
      %Equal.sym(+List<U32>, UW.WX(t, VRL.pos(j, 1n, x), 1n), Con{VRB.BX(t, VRL.pos(j, 1n, x)), UW.WX(t, 1n+VRL.pos(j, 1n, x), 0n)}, VRB.wxc(d, t, VRL.pos(j, 1n, x), 0n, pf, hy)) :
        {(UA.BF(t, n), Bool.and(acc, U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1))) == (UA.BF(t, n), Bool.and(acc, VRB.ALLB(_))) : B.Buf & Bool}
      %Equal.sym(Bool, Bool.and(U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1), True{}), U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1), VRB.and_true(U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1))) :
        {(UA.BF(t, n), Bool.and(acc, U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1))) == (UA.BF(t, n), Bool.and(acc, _)) : B.Buf & Bool}
      {==}
    case 1n+ +q:
    +hy = FD.nat__lt_le_trans(VRL.pos(j, 1n, x), 1n+VRL.pos(j, 1n, x), A.quad(VB.pw(d)), FD.nat__lt_succ(VRL.pos(j, 1n, x)), FD.nat__le_trans(1n+VRL.pos(j, 1n, x), VRL.pos(Nat.add(1n+k, j), 1n, x), A.quad(VB.pw(d)), VRB.pmk(k, j, x), hb))
      +c = U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1)
      +R = VRB.ALLB(UW.WX(t, VRL.pos(1n+j, 1n, x), 1n+q))
      +hx = VRL.nextfit(j, q, 1n, x, A.quad(VB.pw(d)), hb)
      +ex = VRL.posU(d, off, x, i, j, 1, 0n, {==}, e, ej, hd, hx)
      +hx1 = FD.nat__lt_le_trans(VRL.pos(1n+j, 1n, x), Nat.add(VRL.pos(1n+j, 1n, x), 1n), A.quad(VB.pw(d)), VTX.ltp(VRL.pos(1n+j, 1n, x), 0n), hx)
      +hb2 = FD.logic__subst(Nat, z => {Nat.is_le(VRL.pos(1n+z, 1n, x), A.quad(VB.pw(d))) == True{} : Bool}, 1n+Nat.add(q, j), Nat.add(q, 1n+j), Equal.sym(Nat, Nat.add(q, 1n+j), 1n+Nat.add(q, j), FD.nat__add_succ(q, j)), hb)
      %Equal.sym(+List<U32>, UW.WX(t, VRL.pos(j, 1n, x), 2n+q), Con{VRB.BX(t, VRL.pos(j, 1n, x)), UW.WX(t, 1n+VRL.pos(j, 1n, x), 1n+q)}, VRB.wxc(d, t, VRL.pos(j, 1n, x), 1n+q, pf, hy)) :
        {vec_bool_3_r.v3_bool_ck(1n+q, i, off, acc, (UA.BF(t, n), c)) == (UA.BF(t, n), Bool.and(acc, VRB.ALLB(_))) : B.Buf & Bool}
      %VRB.and_assoc(acc, c, R) : {vec_bool_3_r.v3_bool_ck(1n+q, i, off, acc, (UA.BF(t, n), c)) == (UA.BF(t, n), _) : B.Buf & Bool}
      %Equal.sym(B.Buf & Bool, O.ok_bool(UA.BF(t, n), U32.add(off, U32.mul(U32.add(i, 1), 1))), (UA.BF(t, n), U32.is_le(VRB.BX(t, VRL.pos(1n+j, 1n, x)), 1)),
          VRB.okb(d, t, n, U32.add(off, U32.mul(U32.add(i, 1), 1)), VRL.pos(1n+j, 1n, x), ex, hd, pf, hx1)) :
        {vec_bool_3_r.v3_bool_ck(q, U32.add(i, 1), off, Bool.and(acc, c), _) == (UA.BF(t, n), Bool.and(Bool.and(acc, c), R)) : B.Buf & Bool}
      vec_bool_3_ck(q, d, t, n, off, x, U32.add(i, 1), 1n+j, Bool.and(acc, c), e, VRL.succU(d, i, j, 0n, x, ej, hd, hx), hd, pf, hb2)

def vec_bool_3_at(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 3n), A.quad(VB.pw(d))) == True{} : Bool})
    -> {vec_bool_3_r.v3_bool_ok_at(UA.BF(t, n), off) == (UA.BF(t, n), VRB.ALLB(UW.WX(t, x, 3n))) : B.Buf & Bool}:
  +hx = FD.nat__lt_le_trans(x, Nat.add(x, 3n), A.quad(VB.pw(d)), VTX.ltp(x, 2n), hb)
  +hk = FD.logic__subst(Nat, z => {Nat.is_le(z, A.quad(VB.pw(d))) == True{} : Bool}, Nat.add(x, 3n), Nat.add(3n, x), FD.nat__add_comm(x, 3n), hb)
  %Equal.sym(B.Buf & Bool, O.ok_bool(UA.BF(t, n), off), (UA.BF(t, n), U32.is_le(VRB.BX(t, x), 1)), VRB.okb(d, t, n, off, x, e, hd, pf, hx)) :
    {vec_bool_3_r.v3_bool_ck(2n, 0, off, True{}, _) == (UA.BF(t, n), VRB.ALLB(UW.WX(t, x, 3n))) : B.Buf & Bool}
  vec_bool_3_ck(2n, d, t, n, off, x, 0, 0n, True{}, e, {==}, hd, pf, hk)

def vec_bool_3_okl(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 3n), A.quad(VB.pw(d))) == True{} : Bool}, +b: Bool)
    -> {vec_bool_3_r.v3_bool_ok_len(b, UA.BF(t, n), off) == (UA.BF(t, n), Bool.and(b, VRB.ALLB(UW.WX(t, x, 3n)))) : B.Buf & Bool}:
  match b:
    case True{}: vec_bool_3_at(d, t, n, off, x, e, hd, pf, hb)
    case False{}: {==}

# the validator returns the length check and ALLB of the N window bytes
def vec_bool_3_ok_eval(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 3n), A.quad(VB.pw(d))) == True{} : Bool}, +len: U32)
    -> {vec_bool_3_r.v3_bool_ok(UA.BF(t, n), off, len) == (UA.BF(t, n), Bool.and(U32.is_eq(len, 3), VRB.ALLB(UW.WX(t, x, 3n)))) : B.Buf & Bool}:
  vec_bool_3_okl(d, t, n, off, x, e, hd, pf, hb, U32.is_eq(len, 3))

# the check loop from byte j (index i) on: acc and ALLB of the next 1 + k window bytes
def vec_bool_3_ckD(+k: Nat, +d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +i: U32, +j: Nat, +acc: Bool,
    +e: {U32.to_nat(off) == x : Nat}, +ej: {U32.to_nat(i) == j : Nat}, +hd: {Nat.is_lt(d, 31n) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hb: {Nat.is_le(VRL.pos(Nat.add(1n+k, j), 1n, x), A.quad(VB.pw(d))) == True{} : Bool}, +hs: {Nat.is_lt(VRL.pos(Nat.add(1n+k, j), 1n, x), FD.spec_common__pow2(32n)) == True{} : Bool})
    -> {vec_bool_3_r.v3_bool_ck(k, i, off, acc, (UA.BF(t, n), U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1))) == (UA.BF(t, n), Bool.and(acc, VRB.ALLB(UW.WX(t, VRL.pos(j, 1n, x), 1n+k)))) : B.Buf & Bool}:
  match k:
    case 0n:
    +hy = FD.nat__lt_le_trans(VRL.pos(j, 1n, x), 1n+VRL.pos(j, 1n, x), A.quad(VB.pw(d)), FD.nat__lt_succ(VRL.pos(j, 1n, x)), FD.nat__le_trans(1n+VRL.pos(j, 1n, x), VRL.pos(Nat.add(1n+k, j), 1n, x), A.quad(VB.pw(d)), VRB.pmk(k, j, x), hb))
      %Equal.sym(+List<U32>, UW.WX(t, VRL.pos(j, 1n, x), 1n), Con{VRB.BX(t, VRL.pos(j, 1n, x)), UW.WX(t, 1n+VRL.pos(j, 1n, x), 0n)}, VRB.wxc(d, t, VRL.pos(j, 1n, x), 0n, pf, hy)) :
        {(UA.BF(t, n), Bool.and(acc, U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1))) == (UA.BF(t, n), Bool.and(acc, VRB.ALLB(_))) : B.Buf & Bool}
      %Equal.sym(Bool, Bool.and(U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1), True{}), U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1), VRB.and_true(U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1))) :
        {(UA.BF(t, n), Bool.and(acc, U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1))) == (UA.BF(t, n), Bool.and(acc, _)) : B.Buf & Bool}
      {==}
    case 1n+ +q:
    +hy = FD.nat__lt_le_trans(VRL.pos(j, 1n, x), 1n+VRL.pos(j, 1n, x), A.quad(VB.pw(d)), FD.nat__lt_succ(VRL.pos(j, 1n, x)), FD.nat__le_trans(1n+VRL.pos(j, 1n, x), VRL.pos(Nat.add(1n+k, j), 1n, x), A.quad(VB.pw(d)), VRB.pmk(k, j, x), hb))
      +c = U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1)
      +R = VRB.ALLB(UW.WX(t, VRL.pos(1n+j, 1n, x), 1n+q))
      +hx = VRL.nextfit(j, q, 1n, x, A.quad(VB.pw(d)), hb)
      +hx32 = FD.nat__le_lt_trans(Nat.add(VRL.pos(1n+j, 1n, x), 1n), VRL.pos(Nat.add(2n+q, j), 1n, x), FD.spec_common__pow2(32n), VRL.nextfit(j, q, 1n, x, VRL.pos(Nat.add(2n+q, j), 1n, x), FD.nat__le_refl(VRL.pos(Nat.add(2n+q, j), 1n, x))), hs)
  +ex = VRL.posU32(off, x, i, j, 1, 0n, {==}, e, ej, hx32)
  +hs2 = FD.logic__subst(Nat, z => {Nat.is_lt(VRL.pos(1n+z, 1n, x), FD.spec_common__pow2(32n)) == True{} : Bool}, 1n+Nat.add(q, j), Nat.add(q, 1n+j), Equal.sym(Nat, Nat.add(q, 1n+j), 1n+Nat.add(q, j), FD.nat__add_succ(q, j)), hs)
      +hx1 = FD.nat__lt_le_trans(VRL.pos(1n+j, 1n, x), Nat.add(VRL.pos(1n+j, 1n, x), 1n), A.quad(VB.pw(d)), VTX.ltp(VRL.pos(1n+j, 1n, x), 0n), hx)
      +hb2 = FD.logic__subst(Nat, z => {Nat.is_le(VRL.pos(1n+z, 1n, x), A.quad(VB.pw(d))) == True{} : Bool}, 1n+Nat.add(q, j), Nat.add(q, 1n+j), Equal.sym(Nat, Nat.add(q, 1n+j), 1n+Nat.add(q, j), FD.nat__add_succ(q, j)), hb)
      %Equal.sym(+List<U32>, UW.WX(t, VRL.pos(j, 1n, x), 2n+q), Con{VRB.BX(t, VRL.pos(j, 1n, x)), UW.WX(t, 1n+VRL.pos(j, 1n, x), 1n+q)}, VRB.wxc(d, t, VRL.pos(j, 1n, x), 1n+q, pf, hy)) :
        {vec_bool_3_r.v3_bool_ck(1n+q, i, off, acc, (UA.BF(t, n), c)) == (UA.BF(t, n), Bool.and(acc, VRB.ALLB(_))) : B.Buf & Bool}
      %VRB.and_assoc(acc, c, R) : {vec_bool_3_r.v3_bool_ck(1n+q, i, off, acc, (UA.BF(t, n), c)) == (UA.BF(t, n), _) : B.Buf & Bool}
      %Equal.sym(B.Buf & Bool, O.ok_bool(UA.BF(t, n), U32.add(off, U32.mul(U32.add(i, 1), 1))), (UA.BF(t, n), U32.is_le(VRB.BX(t, VRL.pos(1n+j, 1n, x)), 1)),
          VRB.okbD(d, t, n, U32.add(off, U32.mul(U32.add(i, 1), 1)), VRL.pos(1n+j, 1n, x), ex, hd, pf, hx1)) :
        {vec_bool_3_r.v3_bool_ck(q, U32.add(i, 1), off, Bool.and(acc, c), _) == (UA.BF(t, n), Bool.and(Bool.and(acc, c), R)) : B.Buf & Bool}
      vec_bool_3_ckD(q, d, t, n, off, x, U32.add(i, 1), 1n+j, Bool.and(acc, c), e, VRL.succU32(i, j, 0n, x, ej, hx32), hd, pf, hb2, hs2)

def vec_bool_3_atD(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 3n), A.quad(VB.pw(d))) == True{} : Bool}, +hs: {Nat.is_lt(Nat.add(x, 3n), FD.spec_common__pow2(32n)) == True{} : Bool})
    -> {vec_bool_3_r.v3_bool_ok_at(UA.BF(t, n), off) == (UA.BF(t, n), VRB.ALLB(UW.WX(t, x, 3n))) : B.Buf & Bool}:
  +hx = FD.nat__lt_le_trans(x, Nat.add(x, 3n), A.quad(VB.pw(d)), VTX.ltp(x, 2n), hb)
  +hk = FD.logic__subst(Nat, z => {Nat.is_le(z, A.quad(VB.pw(d))) == True{} : Bool}, Nat.add(x, 3n), Nat.add(3n, x), FD.nat__add_comm(x, 3n), hb)
  %Equal.sym(B.Buf & Bool, O.ok_bool(UA.BF(t, n), off), (UA.BF(t, n), U32.is_le(VRB.BX(t, x), 1)), VRB.okbD(d, t, n, off, x, e, hd, pf, hx)) :
    {vec_bool_3_r.v3_bool_ck(2n, 0, off, True{}, _) == (UA.BF(t, n), VRB.ALLB(UW.WX(t, x, 3n))) : B.Buf & Bool}
  +hk32 = FD.logic__subst(Nat, z => {Nat.is_lt(z, FD.spec_common__pow2(32n)) == True{} : Bool}, Nat.add(x, 3n), Nat.add(3n, x), FD.nat__add_comm(x, 3n), hs)
  vec_bool_3_ckD(2n, d, t, n, off, x, 0, 0n, True{}, e, {==}, hd, pf, hk, hk32)

def vec_bool_3_oklD(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 3n), A.quad(VB.pw(d))) == True{} : Bool}, +hs: {Nat.is_lt(Nat.add(x, 3n), FD.spec_common__pow2(32n)) == True{} : Bool}, +b: Bool)
    -> {vec_bool_3_r.v3_bool_ok_len(b, UA.BF(t, n), off) == (UA.BF(t, n), Bool.and(b, VRB.ALLB(UW.WX(t, x, 3n)))) : B.Buf & Bool}:
  match b:
    case True{}: vec_bool_3_atD(d, t, n, off, x, e, hd, pf, hb, hs)
    case False{}: {==}

# the validator returns the length check and ALLB of the N window bytes
def vec_bool_3_ok_evalD(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 3n), A.quad(VB.pw(d))) == True{} : Bool}, +hs: {Nat.is_lt(Nat.add(x, 3n), FD.spec_common__pow2(32n)) == True{} : Bool}, +len: U32)
    -> {vec_bool_3_r.v3_bool_ok(UA.BF(t, n), off, len) == (UA.BF(t, n), Bool.and(U32.is_eq(len, 3), VRB.ALLB(UW.WX(t, x, 3n)))) : B.Buf & Bool}:
  vec_bool_3_oklD(d, t, n, off, x, e, hd, pf, hb, hs, U32.is_eq(len, 3))

def vec_bool_3_rj(+bs: +List<U32>, +h: {Bool.and(Nat.is_eq(List.length(&2, U32, bs), 3n), VRB.ALLB(bs)) == False{} : Bool}, +v: S.Value, +e: {Codec.encoding_for_legal_type(GS.vec_bool_3(), v) == Some{bs} : Maybe<&2, +List<U32>>}) -> Empty:
  VRB.chk_true(Nat.is_eq(List.length(&2, U32, bs), 3n), VRB.ALLB(bs),
    VRB.len_eq(SS.fixed_size(GS.vec_bool_3()), 3n, bs, Codec.parts(v, GS.vec_bool_3()), DS.facts(v, GS.vec_bool_3(), {==}), {==}, e),
    VRB.vecb(v, 3n, bs, e), h)

# a byte list of another length, or with a byte above 1, is no encoding
def vec_bool_3_decode_reject(+bs: +List<U32>, +h: {Bool.and(Nat.is_eq(List.length(&2, U32, bs), 3n), VRB.ALLB(bs)) == False{} : Bool}) -> Decoding.outside_image(GS.vec_bool_3(), bs):
  v => e => vec_bool_3_rj(bs, h, v, e)

# ---- vec_bool_4 (4 bytes; validator T.v4_bool_ok: every byte a boolean) ----
# the check loop from byte j (index i) on: acc and ALLB of the next 1 + k window bytes
def vec_bool_4_ck(+k: Nat, +d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +i: U32, +j: Nat, +acc: Bool,
    +e: {U32.to_nat(off) == x : Nat}, +ej: {U32.to_nat(i) == j : Nat}, +hd: {Nat.is_lt(d, 28n) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hb: {Nat.is_le(VRL.pos(Nat.add(1n+k, j), 1n, x), A.quad(VB.pw(d))) == True{} : Bool})
    -> {vec_bool_4_r.v4_bool_ck(k, i, off, acc, (UA.BF(t, n), U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1))) == (UA.BF(t, n), Bool.and(acc, VRB.ALLB(UW.WX(t, VRL.pos(j, 1n, x), 1n+k)))) : B.Buf & Bool}:
  match k:
    case 0n:
    +hy = FD.nat__lt_le_trans(VRL.pos(j, 1n, x), 1n+VRL.pos(j, 1n, x), A.quad(VB.pw(d)), FD.nat__lt_succ(VRL.pos(j, 1n, x)), FD.nat__le_trans(1n+VRL.pos(j, 1n, x), VRL.pos(Nat.add(1n+k, j), 1n, x), A.quad(VB.pw(d)), VRB.pmk(k, j, x), hb))
      %Equal.sym(+List<U32>, UW.WX(t, VRL.pos(j, 1n, x), 1n), Con{VRB.BX(t, VRL.pos(j, 1n, x)), UW.WX(t, 1n+VRL.pos(j, 1n, x), 0n)}, VRB.wxc(d, t, VRL.pos(j, 1n, x), 0n, pf, hy)) :
        {(UA.BF(t, n), Bool.and(acc, U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1))) == (UA.BF(t, n), Bool.and(acc, VRB.ALLB(_))) : B.Buf & Bool}
      %Equal.sym(Bool, Bool.and(U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1), True{}), U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1), VRB.and_true(U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1))) :
        {(UA.BF(t, n), Bool.and(acc, U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1))) == (UA.BF(t, n), Bool.and(acc, _)) : B.Buf & Bool}
      {==}
    case 1n+ +q:
    +hy = FD.nat__lt_le_trans(VRL.pos(j, 1n, x), 1n+VRL.pos(j, 1n, x), A.quad(VB.pw(d)), FD.nat__lt_succ(VRL.pos(j, 1n, x)), FD.nat__le_trans(1n+VRL.pos(j, 1n, x), VRL.pos(Nat.add(1n+k, j), 1n, x), A.quad(VB.pw(d)), VRB.pmk(k, j, x), hb))
      +c = U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1)
      +R = VRB.ALLB(UW.WX(t, VRL.pos(1n+j, 1n, x), 1n+q))
      +hx = VRL.nextfit(j, q, 1n, x, A.quad(VB.pw(d)), hb)
      +ex = VRL.posU(d, off, x, i, j, 1, 0n, {==}, e, ej, hd, hx)
      +hx1 = FD.nat__lt_le_trans(VRL.pos(1n+j, 1n, x), Nat.add(VRL.pos(1n+j, 1n, x), 1n), A.quad(VB.pw(d)), VTX.ltp(VRL.pos(1n+j, 1n, x), 0n), hx)
      +hb2 = FD.logic__subst(Nat, z => {Nat.is_le(VRL.pos(1n+z, 1n, x), A.quad(VB.pw(d))) == True{} : Bool}, 1n+Nat.add(q, j), Nat.add(q, 1n+j), Equal.sym(Nat, Nat.add(q, 1n+j), 1n+Nat.add(q, j), FD.nat__add_succ(q, j)), hb)
      %Equal.sym(+List<U32>, UW.WX(t, VRL.pos(j, 1n, x), 2n+q), Con{VRB.BX(t, VRL.pos(j, 1n, x)), UW.WX(t, 1n+VRL.pos(j, 1n, x), 1n+q)}, VRB.wxc(d, t, VRL.pos(j, 1n, x), 1n+q, pf, hy)) :
        {vec_bool_4_r.v4_bool_ck(1n+q, i, off, acc, (UA.BF(t, n), c)) == (UA.BF(t, n), Bool.and(acc, VRB.ALLB(_))) : B.Buf & Bool}
      %VRB.and_assoc(acc, c, R) : {vec_bool_4_r.v4_bool_ck(1n+q, i, off, acc, (UA.BF(t, n), c)) == (UA.BF(t, n), _) : B.Buf & Bool}
      %Equal.sym(B.Buf & Bool, O.ok_bool(UA.BF(t, n), U32.add(off, U32.mul(U32.add(i, 1), 1))), (UA.BF(t, n), U32.is_le(VRB.BX(t, VRL.pos(1n+j, 1n, x)), 1)),
          VRB.okb(d, t, n, U32.add(off, U32.mul(U32.add(i, 1), 1)), VRL.pos(1n+j, 1n, x), ex, hd, pf, hx1)) :
        {vec_bool_4_r.v4_bool_ck(q, U32.add(i, 1), off, Bool.and(acc, c), _) == (UA.BF(t, n), Bool.and(Bool.and(acc, c), R)) : B.Buf & Bool}
      vec_bool_4_ck(q, d, t, n, off, x, U32.add(i, 1), 1n+j, Bool.and(acc, c), e, VRL.succU(d, i, j, 0n, x, ej, hd, hx), hd, pf, hb2)

def vec_bool_4_at(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 4n), A.quad(VB.pw(d))) == True{} : Bool})
    -> {vec_bool_4_r.v4_bool_ok_at(UA.BF(t, n), off) == (UA.BF(t, n), VRB.ALLB(UW.WX(t, x, 4n))) : B.Buf & Bool}:
  +hx = FD.nat__lt_le_trans(x, Nat.add(x, 4n), A.quad(VB.pw(d)), VTX.ltp(x, 3n), hb)
  +hk = FD.logic__subst(Nat, z => {Nat.is_le(z, A.quad(VB.pw(d))) == True{} : Bool}, Nat.add(x, 4n), Nat.add(4n, x), FD.nat__add_comm(x, 4n), hb)
  %Equal.sym(B.Buf & Bool, O.ok_bool(UA.BF(t, n), off), (UA.BF(t, n), U32.is_le(VRB.BX(t, x), 1)), VRB.okb(d, t, n, off, x, e, hd, pf, hx)) :
    {vec_bool_4_r.v4_bool_ck(3n, 0, off, True{}, _) == (UA.BF(t, n), VRB.ALLB(UW.WX(t, x, 4n))) : B.Buf & Bool}
  vec_bool_4_ck(3n, d, t, n, off, x, 0, 0n, True{}, e, {==}, hd, pf, hk)

def vec_bool_4_okl(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 4n), A.quad(VB.pw(d))) == True{} : Bool}, +b: Bool)
    -> {vec_bool_4_r.v4_bool_ok_len(b, UA.BF(t, n), off) == (UA.BF(t, n), Bool.and(b, VRB.ALLB(UW.WX(t, x, 4n)))) : B.Buf & Bool}:
  match b:
    case True{}: vec_bool_4_at(d, t, n, off, x, e, hd, pf, hb)
    case False{}: {==}

# the validator returns the length check and ALLB of the N window bytes
def vec_bool_4_ok_eval(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 4n), A.quad(VB.pw(d))) == True{} : Bool}, +len: U32)
    -> {vec_bool_4_r.v4_bool_ok(UA.BF(t, n), off, len) == (UA.BF(t, n), Bool.and(U32.is_eq(len, 4), VRB.ALLB(UW.WX(t, x, 4n)))) : B.Buf & Bool}:
  vec_bool_4_okl(d, t, n, off, x, e, hd, pf, hb, U32.is_eq(len, 4))

# the check loop from byte j (index i) on: acc and ALLB of the next 1 + k window bytes
def vec_bool_4_ckD(+k: Nat, +d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +i: U32, +j: Nat, +acc: Bool,
    +e: {U32.to_nat(off) == x : Nat}, +ej: {U32.to_nat(i) == j : Nat}, +hd: {Nat.is_lt(d, 31n) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hb: {Nat.is_le(VRL.pos(Nat.add(1n+k, j), 1n, x), A.quad(VB.pw(d))) == True{} : Bool}, +hs: {Nat.is_lt(VRL.pos(Nat.add(1n+k, j), 1n, x), FD.spec_common__pow2(32n)) == True{} : Bool})
    -> {vec_bool_4_r.v4_bool_ck(k, i, off, acc, (UA.BF(t, n), U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1))) == (UA.BF(t, n), Bool.and(acc, VRB.ALLB(UW.WX(t, VRL.pos(j, 1n, x), 1n+k)))) : B.Buf & Bool}:
  match k:
    case 0n:
    +hy = FD.nat__lt_le_trans(VRL.pos(j, 1n, x), 1n+VRL.pos(j, 1n, x), A.quad(VB.pw(d)), FD.nat__lt_succ(VRL.pos(j, 1n, x)), FD.nat__le_trans(1n+VRL.pos(j, 1n, x), VRL.pos(Nat.add(1n+k, j), 1n, x), A.quad(VB.pw(d)), VRB.pmk(k, j, x), hb))
      %Equal.sym(+List<U32>, UW.WX(t, VRL.pos(j, 1n, x), 1n), Con{VRB.BX(t, VRL.pos(j, 1n, x)), UW.WX(t, 1n+VRL.pos(j, 1n, x), 0n)}, VRB.wxc(d, t, VRL.pos(j, 1n, x), 0n, pf, hy)) :
        {(UA.BF(t, n), Bool.and(acc, U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1))) == (UA.BF(t, n), Bool.and(acc, VRB.ALLB(_))) : B.Buf & Bool}
      %Equal.sym(Bool, Bool.and(U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1), True{}), U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1), VRB.and_true(U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1))) :
        {(UA.BF(t, n), Bool.and(acc, U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1))) == (UA.BF(t, n), Bool.and(acc, _)) : B.Buf & Bool}
      {==}
    case 1n+ +q:
    +hy = FD.nat__lt_le_trans(VRL.pos(j, 1n, x), 1n+VRL.pos(j, 1n, x), A.quad(VB.pw(d)), FD.nat__lt_succ(VRL.pos(j, 1n, x)), FD.nat__le_trans(1n+VRL.pos(j, 1n, x), VRL.pos(Nat.add(1n+k, j), 1n, x), A.quad(VB.pw(d)), VRB.pmk(k, j, x), hb))
      +c = U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1)
      +R = VRB.ALLB(UW.WX(t, VRL.pos(1n+j, 1n, x), 1n+q))
      +hx = VRL.nextfit(j, q, 1n, x, A.quad(VB.pw(d)), hb)
      +hx32 = FD.nat__le_lt_trans(Nat.add(VRL.pos(1n+j, 1n, x), 1n), VRL.pos(Nat.add(2n+q, j), 1n, x), FD.spec_common__pow2(32n), VRL.nextfit(j, q, 1n, x, VRL.pos(Nat.add(2n+q, j), 1n, x), FD.nat__le_refl(VRL.pos(Nat.add(2n+q, j), 1n, x))), hs)
  +ex = VRL.posU32(off, x, i, j, 1, 0n, {==}, e, ej, hx32)
  +hs2 = FD.logic__subst(Nat, z => {Nat.is_lt(VRL.pos(1n+z, 1n, x), FD.spec_common__pow2(32n)) == True{} : Bool}, 1n+Nat.add(q, j), Nat.add(q, 1n+j), Equal.sym(Nat, Nat.add(q, 1n+j), 1n+Nat.add(q, j), FD.nat__add_succ(q, j)), hs)
      +hx1 = FD.nat__lt_le_trans(VRL.pos(1n+j, 1n, x), Nat.add(VRL.pos(1n+j, 1n, x), 1n), A.quad(VB.pw(d)), VTX.ltp(VRL.pos(1n+j, 1n, x), 0n), hx)
      +hb2 = FD.logic__subst(Nat, z => {Nat.is_le(VRL.pos(1n+z, 1n, x), A.quad(VB.pw(d))) == True{} : Bool}, 1n+Nat.add(q, j), Nat.add(q, 1n+j), Equal.sym(Nat, Nat.add(q, 1n+j), 1n+Nat.add(q, j), FD.nat__add_succ(q, j)), hb)
      %Equal.sym(+List<U32>, UW.WX(t, VRL.pos(j, 1n, x), 2n+q), Con{VRB.BX(t, VRL.pos(j, 1n, x)), UW.WX(t, 1n+VRL.pos(j, 1n, x), 1n+q)}, VRB.wxc(d, t, VRL.pos(j, 1n, x), 1n+q, pf, hy)) :
        {vec_bool_4_r.v4_bool_ck(1n+q, i, off, acc, (UA.BF(t, n), c)) == (UA.BF(t, n), Bool.and(acc, VRB.ALLB(_))) : B.Buf & Bool}
      %VRB.and_assoc(acc, c, R) : {vec_bool_4_r.v4_bool_ck(1n+q, i, off, acc, (UA.BF(t, n), c)) == (UA.BF(t, n), _) : B.Buf & Bool}
      %Equal.sym(B.Buf & Bool, O.ok_bool(UA.BF(t, n), U32.add(off, U32.mul(U32.add(i, 1), 1))), (UA.BF(t, n), U32.is_le(VRB.BX(t, VRL.pos(1n+j, 1n, x)), 1)),
          VRB.okbD(d, t, n, U32.add(off, U32.mul(U32.add(i, 1), 1)), VRL.pos(1n+j, 1n, x), ex, hd, pf, hx1)) :
        {vec_bool_4_r.v4_bool_ck(q, U32.add(i, 1), off, Bool.and(acc, c), _) == (UA.BF(t, n), Bool.and(Bool.and(acc, c), R)) : B.Buf & Bool}
      vec_bool_4_ckD(q, d, t, n, off, x, U32.add(i, 1), 1n+j, Bool.and(acc, c), e, VRL.succU32(i, j, 0n, x, ej, hx32), hd, pf, hb2, hs2)

def vec_bool_4_atD(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 4n), A.quad(VB.pw(d))) == True{} : Bool}, +hs: {Nat.is_lt(Nat.add(x, 4n), FD.spec_common__pow2(32n)) == True{} : Bool})
    -> {vec_bool_4_r.v4_bool_ok_at(UA.BF(t, n), off) == (UA.BF(t, n), VRB.ALLB(UW.WX(t, x, 4n))) : B.Buf & Bool}:
  +hx = FD.nat__lt_le_trans(x, Nat.add(x, 4n), A.quad(VB.pw(d)), VTX.ltp(x, 3n), hb)
  +hk = FD.logic__subst(Nat, z => {Nat.is_le(z, A.quad(VB.pw(d))) == True{} : Bool}, Nat.add(x, 4n), Nat.add(4n, x), FD.nat__add_comm(x, 4n), hb)
  %Equal.sym(B.Buf & Bool, O.ok_bool(UA.BF(t, n), off), (UA.BF(t, n), U32.is_le(VRB.BX(t, x), 1)), VRB.okbD(d, t, n, off, x, e, hd, pf, hx)) :
    {vec_bool_4_r.v4_bool_ck(3n, 0, off, True{}, _) == (UA.BF(t, n), VRB.ALLB(UW.WX(t, x, 4n))) : B.Buf & Bool}
  +hk32 = FD.logic__subst(Nat, z => {Nat.is_lt(z, FD.spec_common__pow2(32n)) == True{} : Bool}, Nat.add(x, 4n), Nat.add(4n, x), FD.nat__add_comm(x, 4n), hs)
  vec_bool_4_ckD(3n, d, t, n, off, x, 0, 0n, True{}, e, {==}, hd, pf, hk, hk32)

def vec_bool_4_oklD(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 4n), A.quad(VB.pw(d))) == True{} : Bool}, +hs: {Nat.is_lt(Nat.add(x, 4n), FD.spec_common__pow2(32n)) == True{} : Bool}, +b: Bool)
    -> {vec_bool_4_r.v4_bool_ok_len(b, UA.BF(t, n), off) == (UA.BF(t, n), Bool.and(b, VRB.ALLB(UW.WX(t, x, 4n)))) : B.Buf & Bool}:
  match b:
    case True{}: vec_bool_4_atD(d, t, n, off, x, e, hd, pf, hb, hs)
    case False{}: {==}

# the validator returns the length check and ALLB of the N window bytes
def vec_bool_4_ok_evalD(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 4n), A.quad(VB.pw(d))) == True{} : Bool}, +hs: {Nat.is_lt(Nat.add(x, 4n), FD.spec_common__pow2(32n)) == True{} : Bool}, +len: U32)
    -> {vec_bool_4_r.v4_bool_ok(UA.BF(t, n), off, len) == (UA.BF(t, n), Bool.and(U32.is_eq(len, 4), VRB.ALLB(UW.WX(t, x, 4n)))) : B.Buf & Bool}:
  vec_bool_4_oklD(d, t, n, off, x, e, hd, pf, hb, hs, U32.is_eq(len, 4))

def vec_bool_4_rj(+bs: +List<U32>, +h: {Bool.and(Nat.is_eq(List.length(&2, U32, bs), 4n), VRB.ALLB(bs)) == False{} : Bool}, +v: S.Value, +e: {Codec.encoding_for_legal_type(GS.vec_bool_4(), v) == Some{bs} : Maybe<&2, +List<U32>>}) -> Empty:
  VRB.chk_true(Nat.is_eq(List.length(&2, U32, bs), 4n), VRB.ALLB(bs),
    VRB.len_eq(SS.fixed_size(GS.vec_bool_4()), 4n, bs, Codec.parts(v, GS.vec_bool_4()), DS.facts(v, GS.vec_bool_4(), {==}), {==}, e),
    VRB.vecb(v, 4n, bs, e), h)

# a byte list of another length, or with a byte above 1, is no encoding
def vec_bool_4_decode_reject(+bs: +List<U32>, +h: {Bool.and(Nat.is_eq(List.length(&2, U32, bs), 4n), VRB.ALLB(bs)) == False{} : Bool}) -> Decoding.outside_image(GS.vec_bool_4(), bs):
  v => e => vec_bool_4_rj(bs, h, v, e)

# ---- vec_bool_512 (512 bytes; validator T.v512_bool_ok: every byte a boolean) ----
# the check loop from byte j (index i) on: acc and ALLB of the next 1 + k window bytes
def vec_bool_512_ck(+k: Nat, +d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +i: U32, +j: Nat, +acc: Bool,
    +e: {U32.to_nat(off) == x : Nat}, +ej: {U32.to_nat(i) == j : Nat}, +hd: {Nat.is_lt(d, 28n) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hb: {Nat.is_le(VRL.pos(Nat.add(1n+k, j), 1n, x), A.quad(VB.pw(d))) == True{} : Bool})
    -> {vec_bool_512_r.v512_bool_ck(k, i, off, acc, (UA.BF(t, n), U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1))) == (UA.BF(t, n), Bool.and(acc, VRB.ALLB(UW.WX(t, VRL.pos(j, 1n, x), 1n+k)))) : B.Buf & Bool}:
  match k:
    case 0n:
    +hy = FD.nat__lt_le_trans(VRL.pos(j, 1n, x), 1n+VRL.pos(j, 1n, x), A.quad(VB.pw(d)), FD.nat__lt_succ(VRL.pos(j, 1n, x)), FD.nat__le_trans(1n+VRL.pos(j, 1n, x), VRL.pos(Nat.add(1n+k, j), 1n, x), A.quad(VB.pw(d)), VRB.pmk(k, j, x), hb))
      %Equal.sym(+List<U32>, UW.WX(t, VRL.pos(j, 1n, x), 1n), Con{VRB.BX(t, VRL.pos(j, 1n, x)), UW.WX(t, 1n+VRL.pos(j, 1n, x), 0n)}, VRB.wxc(d, t, VRL.pos(j, 1n, x), 0n, pf, hy)) :
        {(UA.BF(t, n), Bool.and(acc, U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1))) == (UA.BF(t, n), Bool.and(acc, VRB.ALLB(_))) : B.Buf & Bool}
      %Equal.sym(Bool, Bool.and(U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1), True{}), U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1), VRB.and_true(U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1))) :
        {(UA.BF(t, n), Bool.and(acc, U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1))) == (UA.BF(t, n), Bool.and(acc, _)) : B.Buf & Bool}
      {==}
    case 1n+ +q:
    +hy = FD.nat__lt_le_trans(VRL.pos(j, 1n, x), 1n+VRL.pos(j, 1n, x), A.quad(VB.pw(d)), FD.nat__lt_succ(VRL.pos(j, 1n, x)), FD.nat__le_trans(1n+VRL.pos(j, 1n, x), VRL.pos(Nat.add(1n+k, j), 1n, x), A.quad(VB.pw(d)), VRB.pmk(k, j, x), hb))
      +c = U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1)
      +R = VRB.ALLB(UW.WX(t, VRL.pos(1n+j, 1n, x), 1n+q))
      +hx = VRL.nextfit(j, q, 1n, x, A.quad(VB.pw(d)), hb)
      +ex = VRL.posU(d, off, x, i, j, 1, 0n, {==}, e, ej, hd, hx)
      +hx1 = FD.nat__lt_le_trans(VRL.pos(1n+j, 1n, x), Nat.add(VRL.pos(1n+j, 1n, x), 1n), A.quad(VB.pw(d)), VTX.ltp(VRL.pos(1n+j, 1n, x), 0n), hx)
      +hb2 = FD.logic__subst(Nat, z => {Nat.is_le(VRL.pos(1n+z, 1n, x), A.quad(VB.pw(d))) == True{} : Bool}, 1n+Nat.add(q, j), Nat.add(q, 1n+j), Equal.sym(Nat, Nat.add(q, 1n+j), 1n+Nat.add(q, j), FD.nat__add_succ(q, j)), hb)
      %Equal.sym(+List<U32>, UW.WX(t, VRL.pos(j, 1n, x), 2n+q), Con{VRB.BX(t, VRL.pos(j, 1n, x)), UW.WX(t, 1n+VRL.pos(j, 1n, x), 1n+q)}, VRB.wxc(d, t, VRL.pos(j, 1n, x), 1n+q, pf, hy)) :
        {vec_bool_512_r.v512_bool_ck(1n+q, i, off, acc, (UA.BF(t, n), c)) == (UA.BF(t, n), Bool.and(acc, VRB.ALLB(_))) : B.Buf & Bool}
      %VRB.and_assoc(acc, c, R) : {vec_bool_512_r.v512_bool_ck(1n+q, i, off, acc, (UA.BF(t, n), c)) == (UA.BF(t, n), _) : B.Buf & Bool}
      %Equal.sym(B.Buf & Bool, O.ok_bool(UA.BF(t, n), U32.add(off, U32.mul(U32.add(i, 1), 1))), (UA.BF(t, n), U32.is_le(VRB.BX(t, VRL.pos(1n+j, 1n, x)), 1)),
          VRB.okb(d, t, n, U32.add(off, U32.mul(U32.add(i, 1), 1)), VRL.pos(1n+j, 1n, x), ex, hd, pf, hx1)) :
        {vec_bool_512_r.v512_bool_ck(q, U32.add(i, 1), off, Bool.and(acc, c), _) == (UA.BF(t, n), Bool.and(Bool.and(acc, c), R)) : B.Buf & Bool}
      vec_bool_512_ck(q, d, t, n, off, x, U32.add(i, 1), 1n+j, Bool.and(acc, c), e, VRL.succU(d, i, j, 0n, x, ej, hd, hx), hd, pf, hb2)

def vec_bool_512_at(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 512n), A.quad(VB.pw(d))) == True{} : Bool})
    -> {vec_bool_512_r.v512_bool_ok_at(UA.BF(t, n), off) == (UA.BF(t, n), VRB.ALLB(UW.WX(t, x, 512n))) : B.Buf & Bool}:
  +hx = FD.nat__lt_le_trans(x, Nat.add(x, 512n), A.quad(VB.pw(d)), VTX.ltp(x, 511n), hb)
  +hk = FD.logic__subst(Nat, z => {Nat.is_le(z, A.quad(VB.pw(d))) == True{} : Bool}, Nat.add(x, 512n), Nat.add(512n, x), FD.nat__add_comm(x, 512n), hb)
  %Equal.sym(B.Buf & Bool, O.ok_bool(UA.BF(t, n), off), (UA.BF(t, n), U32.is_le(VRB.BX(t, x), 1)), VRB.okb(d, t, n, off, x, e, hd, pf, hx)) :
    {vec_bool_512_r.v512_bool_ck(511n, 0, off, True{}, _) == (UA.BF(t, n), VRB.ALLB(UW.WX(t, x, 512n))) : B.Buf & Bool}
  vec_bool_512_ck(511n, d, t, n, off, x, 0, 0n, True{}, e, {==}, hd, pf, hk)

def vec_bool_512_okl(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 512n), A.quad(VB.pw(d))) == True{} : Bool}, +b: Bool)
    -> {vec_bool_512_r.v512_bool_ok_len(b, UA.BF(t, n), off) == (UA.BF(t, n), Bool.and(b, VRB.ALLB(UW.WX(t, x, 512n)))) : B.Buf & Bool}:
  match b:
    case True{}: vec_bool_512_at(d, t, n, off, x, e, hd, pf, hb)
    case False{}: {==}

# the validator returns the length check and ALLB of the N window bytes
def vec_bool_512_ok_eval(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 512n), A.quad(VB.pw(d))) == True{} : Bool}, +len: U32)
    -> {vec_bool_512_r.v512_bool_ok(UA.BF(t, n), off, len) == (UA.BF(t, n), Bool.and(U32.is_eq(len, 512), VRB.ALLB(UW.WX(t, x, 512n)))) : B.Buf & Bool}:
  vec_bool_512_okl(d, t, n, off, x, e, hd, pf, hb, U32.is_eq(len, 512))

# the check loop from byte j (index i) on: acc and ALLB of the next 1 + k window bytes
def vec_bool_512_ckD(+k: Nat, +d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +i: U32, +j: Nat, +acc: Bool,
    +e: {U32.to_nat(off) == x : Nat}, +ej: {U32.to_nat(i) == j : Nat}, +hd: {Nat.is_lt(d, 31n) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hb: {Nat.is_le(VRL.pos(Nat.add(1n+k, j), 1n, x), A.quad(VB.pw(d))) == True{} : Bool}, +hs: {Nat.is_lt(VRL.pos(Nat.add(1n+k, j), 1n, x), FD.spec_common__pow2(32n)) == True{} : Bool})
    -> {vec_bool_512_r.v512_bool_ck(k, i, off, acc, (UA.BF(t, n), U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1))) == (UA.BF(t, n), Bool.and(acc, VRB.ALLB(UW.WX(t, VRL.pos(j, 1n, x), 1n+k)))) : B.Buf & Bool}:
  match k:
    case 0n:
    +hy = FD.nat__lt_le_trans(VRL.pos(j, 1n, x), 1n+VRL.pos(j, 1n, x), A.quad(VB.pw(d)), FD.nat__lt_succ(VRL.pos(j, 1n, x)), FD.nat__le_trans(1n+VRL.pos(j, 1n, x), VRL.pos(Nat.add(1n+k, j), 1n, x), A.quad(VB.pw(d)), VRB.pmk(k, j, x), hb))
      %Equal.sym(+List<U32>, UW.WX(t, VRL.pos(j, 1n, x), 1n), Con{VRB.BX(t, VRL.pos(j, 1n, x)), UW.WX(t, 1n+VRL.pos(j, 1n, x), 0n)}, VRB.wxc(d, t, VRL.pos(j, 1n, x), 0n, pf, hy)) :
        {(UA.BF(t, n), Bool.and(acc, U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1))) == (UA.BF(t, n), Bool.and(acc, VRB.ALLB(_))) : B.Buf & Bool}
      %Equal.sym(Bool, Bool.and(U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1), True{}), U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1), VRB.and_true(U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1))) :
        {(UA.BF(t, n), Bool.and(acc, U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1))) == (UA.BF(t, n), Bool.and(acc, _)) : B.Buf & Bool}
      {==}
    case 1n+ +q:
    +hy = FD.nat__lt_le_trans(VRL.pos(j, 1n, x), 1n+VRL.pos(j, 1n, x), A.quad(VB.pw(d)), FD.nat__lt_succ(VRL.pos(j, 1n, x)), FD.nat__le_trans(1n+VRL.pos(j, 1n, x), VRL.pos(Nat.add(1n+k, j), 1n, x), A.quad(VB.pw(d)), VRB.pmk(k, j, x), hb))
      +c = U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1)
      +R = VRB.ALLB(UW.WX(t, VRL.pos(1n+j, 1n, x), 1n+q))
      +hx = VRL.nextfit(j, q, 1n, x, A.quad(VB.pw(d)), hb)
      +hx32 = FD.nat__le_lt_trans(Nat.add(VRL.pos(1n+j, 1n, x), 1n), VRL.pos(Nat.add(2n+q, j), 1n, x), FD.spec_common__pow2(32n), VRL.nextfit(j, q, 1n, x, VRL.pos(Nat.add(2n+q, j), 1n, x), FD.nat__le_refl(VRL.pos(Nat.add(2n+q, j), 1n, x))), hs)
  +ex = VRL.posU32(off, x, i, j, 1, 0n, {==}, e, ej, hx32)
  +hs2 = FD.logic__subst(Nat, z => {Nat.is_lt(VRL.pos(1n+z, 1n, x), FD.spec_common__pow2(32n)) == True{} : Bool}, 1n+Nat.add(q, j), Nat.add(q, 1n+j), Equal.sym(Nat, Nat.add(q, 1n+j), 1n+Nat.add(q, j), FD.nat__add_succ(q, j)), hs)
      +hx1 = FD.nat__lt_le_trans(VRL.pos(1n+j, 1n, x), Nat.add(VRL.pos(1n+j, 1n, x), 1n), A.quad(VB.pw(d)), VTX.ltp(VRL.pos(1n+j, 1n, x), 0n), hx)
      +hb2 = FD.logic__subst(Nat, z => {Nat.is_le(VRL.pos(1n+z, 1n, x), A.quad(VB.pw(d))) == True{} : Bool}, 1n+Nat.add(q, j), Nat.add(q, 1n+j), Equal.sym(Nat, Nat.add(q, 1n+j), 1n+Nat.add(q, j), FD.nat__add_succ(q, j)), hb)
      %Equal.sym(+List<U32>, UW.WX(t, VRL.pos(j, 1n, x), 2n+q), Con{VRB.BX(t, VRL.pos(j, 1n, x)), UW.WX(t, 1n+VRL.pos(j, 1n, x), 1n+q)}, VRB.wxc(d, t, VRL.pos(j, 1n, x), 1n+q, pf, hy)) :
        {vec_bool_512_r.v512_bool_ck(1n+q, i, off, acc, (UA.BF(t, n), c)) == (UA.BF(t, n), Bool.and(acc, VRB.ALLB(_))) : B.Buf & Bool}
      %VRB.and_assoc(acc, c, R) : {vec_bool_512_r.v512_bool_ck(1n+q, i, off, acc, (UA.BF(t, n), c)) == (UA.BF(t, n), _) : B.Buf & Bool}
      %Equal.sym(B.Buf & Bool, O.ok_bool(UA.BF(t, n), U32.add(off, U32.mul(U32.add(i, 1), 1))), (UA.BF(t, n), U32.is_le(VRB.BX(t, VRL.pos(1n+j, 1n, x)), 1)),
          VRB.okbD(d, t, n, U32.add(off, U32.mul(U32.add(i, 1), 1)), VRL.pos(1n+j, 1n, x), ex, hd, pf, hx1)) :
        {vec_bool_512_r.v512_bool_ck(q, U32.add(i, 1), off, Bool.and(acc, c), _) == (UA.BF(t, n), Bool.and(Bool.and(acc, c), R)) : B.Buf & Bool}
      vec_bool_512_ckD(q, d, t, n, off, x, U32.add(i, 1), 1n+j, Bool.and(acc, c), e, VRL.succU32(i, j, 0n, x, ej, hx32), hd, pf, hb2, hs2)

def vec_bool_512_atD(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 512n), A.quad(VB.pw(d))) == True{} : Bool}, +hs: {Nat.is_lt(Nat.add(x, 512n), FD.spec_common__pow2(32n)) == True{} : Bool})
    -> {vec_bool_512_r.v512_bool_ok_at(UA.BF(t, n), off) == (UA.BF(t, n), VRB.ALLB(UW.WX(t, x, 512n))) : B.Buf & Bool}:
  +hx = FD.nat__lt_le_trans(x, Nat.add(x, 512n), A.quad(VB.pw(d)), VTX.ltp(x, 511n), hb)
  +hk = FD.logic__subst(Nat, z => {Nat.is_le(z, A.quad(VB.pw(d))) == True{} : Bool}, Nat.add(x, 512n), Nat.add(512n, x), FD.nat__add_comm(x, 512n), hb)
  %Equal.sym(B.Buf & Bool, O.ok_bool(UA.BF(t, n), off), (UA.BF(t, n), U32.is_le(VRB.BX(t, x), 1)), VRB.okbD(d, t, n, off, x, e, hd, pf, hx)) :
    {vec_bool_512_r.v512_bool_ck(511n, 0, off, True{}, _) == (UA.BF(t, n), VRB.ALLB(UW.WX(t, x, 512n))) : B.Buf & Bool}
  +hk32 = FD.logic__subst(Nat, z => {Nat.is_lt(z, FD.spec_common__pow2(32n)) == True{} : Bool}, Nat.add(x, 512n), Nat.add(512n, x), FD.nat__add_comm(x, 512n), hs)
  vec_bool_512_ckD(511n, d, t, n, off, x, 0, 0n, True{}, e, {==}, hd, pf, hk, hk32)

def vec_bool_512_oklD(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 512n), A.quad(VB.pw(d))) == True{} : Bool}, +hs: {Nat.is_lt(Nat.add(x, 512n), FD.spec_common__pow2(32n)) == True{} : Bool}, +b: Bool)
    -> {vec_bool_512_r.v512_bool_ok_len(b, UA.BF(t, n), off) == (UA.BF(t, n), Bool.and(b, VRB.ALLB(UW.WX(t, x, 512n)))) : B.Buf & Bool}:
  match b:
    case True{}: vec_bool_512_atD(d, t, n, off, x, e, hd, pf, hb, hs)
    case False{}: {==}

# the validator returns the length check and ALLB of the N window bytes
def vec_bool_512_ok_evalD(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 512n), A.quad(VB.pw(d))) == True{} : Bool}, +hs: {Nat.is_lt(Nat.add(x, 512n), FD.spec_common__pow2(32n)) == True{} : Bool}, +len: U32)
    -> {vec_bool_512_r.v512_bool_ok(UA.BF(t, n), off, len) == (UA.BF(t, n), Bool.and(U32.is_eq(len, 512), VRB.ALLB(UW.WX(t, x, 512n)))) : B.Buf & Bool}:
  vec_bool_512_oklD(d, t, n, off, x, e, hd, pf, hb, hs, U32.is_eq(len, 512))

def vec_bool_512_rj(+bs: +List<U32>, +h: {Bool.and(Nat.is_eq(List.length(&2, U32, bs), 512n), VRB.ALLB(bs)) == False{} : Bool}, +v: S.Value, +e: {Codec.encoding_for_legal_type(GS.vec_bool_512(), v) == Some{bs} : Maybe<&2, +List<U32>>}) -> Empty:
  VRB.chk_true(Nat.is_eq(List.length(&2, U32, bs), 512n), VRB.ALLB(bs),
    VRB.len_eq(SS.fixed_size(GS.vec_bool_512()), 512n, bs, Codec.parts(v, GS.vec_bool_512()), DS.facts(v, GS.vec_bool_512(), {==}), {==}, e),
    VRB.vecb(v, 512n, bs, e), h)

# a byte list of another length, or with a byte above 1, is no encoding
def vec_bool_512_decode_reject(+bs: +List<U32>, +h: {Bool.and(Nat.is_eq(List.length(&2, U32, bs), 512n), VRB.ALLB(bs)) == False{} : Bool}) -> Decoding.outside_image(GS.vec_bool_512(), bs):
  v => e => vec_bool_512_rj(bs, h, v, e)

# ---- vec_bool_513 (513 bytes; validator T.v513_bool_ok: every byte a boolean) ----
# the check loop from byte j (index i) on: acc and ALLB of the next 1 + k window bytes
def vec_bool_513_ck(+k: Nat, +d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +i: U32, +j: Nat, +acc: Bool,
    +e: {U32.to_nat(off) == x : Nat}, +ej: {U32.to_nat(i) == j : Nat}, +hd: {Nat.is_lt(d, 28n) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hb: {Nat.is_le(VRL.pos(Nat.add(1n+k, j), 1n, x), A.quad(VB.pw(d))) == True{} : Bool})
    -> {vec_bool_513_r.v513_bool_ck(k, i, off, acc, (UA.BF(t, n), U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1))) == (UA.BF(t, n), Bool.and(acc, VRB.ALLB(UW.WX(t, VRL.pos(j, 1n, x), 1n+k)))) : B.Buf & Bool}:
  match k:
    case 0n:
    +hy = FD.nat__lt_le_trans(VRL.pos(j, 1n, x), 1n+VRL.pos(j, 1n, x), A.quad(VB.pw(d)), FD.nat__lt_succ(VRL.pos(j, 1n, x)), FD.nat__le_trans(1n+VRL.pos(j, 1n, x), VRL.pos(Nat.add(1n+k, j), 1n, x), A.quad(VB.pw(d)), VRB.pmk(k, j, x), hb))
      %Equal.sym(+List<U32>, UW.WX(t, VRL.pos(j, 1n, x), 1n), Con{VRB.BX(t, VRL.pos(j, 1n, x)), UW.WX(t, 1n+VRL.pos(j, 1n, x), 0n)}, VRB.wxc(d, t, VRL.pos(j, 1n, x), 0n, pf, hy)) :
        {(UA.BF(t, n), Bool.and(acc, U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1))) == (UA.BF(t, n), Bool.and(acc, VRB.ALLB(_))) : B.Buf & Bool}
      %Equal.sym(Bool, Bool.and(U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1), True{}), U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1), VRB.and_true(U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1))) :
        {(UA.BF(t, n), Bool.and(acc, U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1))) == (UA.BF(t, n), Bool.and(acc, _)) : B.Buf & Bool}
      {==}
    case 1n+ +q:
    +hy = FD.nat__lt_le_trans(VRL.pos(j, 1n, x), 1n+VRL.pos(j, 1n, x), A.quad(VB.pw(d)), FD.nat__lt_succ(VRL.pos(j, 1n, x)), FD.nat__le_trans(1n+VRL.pos(j, 1n, x), VRL.pos(Nat.add(1n+k, j), 1n, x), A.quad(VB.pw(d)), VRB.pmk(k, j, x), hb))
      +c = U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1)
      +R = VRB.ALLB(UW.WX(t, VRL.pos(1n+j, 1n, x), 1n+q))
      +hx = VRL.nextfit(j, q, 1n, x, A.quad(VB.pw(d)), hb)
      +ex = VRL.posU(d, off, x, i, j, 1, 0n, {==}, e, ej, hd, hx)
      +hx1 = FD.nat__lt_le_trans(VRL.pos(1n+j, 1n, x), Nat.add(VRL.pos(1n+j, 1n, x), 1n), A.quad(VB.pw(d)), VTX.ltp(VRL.pos(1n+j, 1n, x), 0n), hx)
      +hb2 = FD.logic__subst(Nat, z => {Nat.is_le(VRL.pos(1n+z, 1n, x), A.quad(VB.pw(d))) == True{} : Bool}, 1n+Nat.add(q, j), Nat.add(q, 1n+j), Equal.sym(Nat, Nat.add(q, 1n+j), 1n+Nat.add(q, j), FD.nat__add_succ(q, j)), hb)
      %Equal.sym(+List<U32>, UW.WX(t, VRL.pos(j, 1n, x), 2n+q), Con{VRB.BX(t, VRL.pos(j, 1n, x)), UW.WX(t, 1n+VRL.pos(j, 1n, x), 1n+q)}, VRB.wxc(d, t, VRL.pos(j, 1n, x), 1n+q, pf, hy)) :
        {vec_bool_513_r.v513_bool_ck(1n+q, i, off, acc, (UA.BF(t, n), c)) == (UA.BF(t, n), Bool.and(acc, VRB.ALLB(_))) : B.Buf & Bool}
      %VRB.and_assoc(acc, c, R) : {vec_bool_513_r.v513_bool_ck(1n+q, i, off, acc, (UA.BF(t, n), c)) == (UA.BF(t, n), _) : B.Buf & Bool}
      %Equal.sym(B.Buf & Bool, O.ok_bool(UA.BF(t, n), U32.add(off, U32.mul(U32.add(i, 1), 1))), (UA.BF(t, n), U32.is_le(VRB.BX(t, VRL.pos(1n+j, 1n, x)), 1)),
          VRB.okb(d, t, n, U32.add(off, U32.mul(U32.add(i, 1), 1)), VRL.pos(1n+j, 1n, x), ex, hd, pf, hx1)) :
        {vec_bool_513_r.v513_bool_ck(q, U32.add(i, 1), off, Bool.and(acc, c), _) == (UA.BF(t, n), Bool.and(Bool.and(acc, c), R)) : B.Buf & Bool}
      vec_bool_513_ck(q, d, t, n, off, x, U32.add(i, 1), 1n+j, Bool.and(acc, c), e, VRL.succU(d, i, j, 0n, x, ej, hd, hx), hd, pf, hb2)

def vec_bool_513_at(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 513n), A.quad(VB.pw(d))) == True{} : Bool})
    -> {vec_bool_513_r.v513_bool_ok_at(UA.BF(t, n), off) == (UA.BF(t, n), VRB.ALLB(UW.WX(t, x, 513n))) : B.Buf & Bool}:
  +hx = FD.nat__lt_le_trans(x, Nat.add(x, 513n), A.quad(VB.pw(d)), VTX.ltp(x, 512n), hb)
  +hk = FD.logic__subst(Nat, z => {Nat.is_le(z, A.quad(VB.pw(d))) == True{} : Bool}, Nat.add(x, 513n), Nat.add(513n, x), FD.nat__add_comm(x, 513n), hb)
  %Equal.sym(B.Buf & Bool, O.ok_bool(UA.BF(t, n), off), (UA.BF(t, n), U32.is_le(VRB.BX(t, x), 1)), VRB.okb(d, t, n, off, x, e, hd, pf, hx)) :
    {vec_bool_513_r.v513_bool_ck(512n, 0, off, True{}, _) == (UA.BF(t, n), VRB.ALLB(UW.WX(t, x, 513n))) : B.Buf & Bool}
  vec_bool_513_ck(512n, d, t, n, off, x, 0, 0n, True{}, e, {==}, hd, pf, hk)

def vec_bool_513_okl(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 513n), A.quad(VB.pw(d))) == True{} : Bool}, +b: Bool)
