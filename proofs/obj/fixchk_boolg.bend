    {vec_bool_5_r.v5_bool_ck(4n, 0, off, True{}, _) == (UA.BF(t, n), VRB.ALLB(UW.WX(t, x, 5n))) : B.Buf & Bool}
  vec_bool_5_ck(4n, d, t, n, off, x, 0, 0n, True{}, e, {==}, hd, pf, hk)

