  match b:
    case True{}: vec_bool_513_at(d, t, n, off, x, e, hd, pf, hb)
    case False{}: {==}

# the validator returns the length check and ALLB of the N window bytes
def vec_bool_513_ok_eval(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 513n), A.quad(VB.pw(d))) == True{} : Bool}, +len: U32)
