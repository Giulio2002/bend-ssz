  VRB.chk_true(Nat.is_eq(List.length(&2, U32, bs), 5n), VRB.ALLB(bs),
    VRB.len_eq(SS.fixed_size(GS.vec_bool_5()), 5n, bs, Codec.parts(v, GS.vec_bool_5()), DS.facts(v, GS.vec_bool_5(), {==}), {==}, e),
    VRB.vecb(v, 5n, bs, e), h)

# a byte list of another length, or with a byte above 1, is no encoding
def vec_bool_5_decode_reject(+bs: +List<U32>, +h: {Bool.and(Nat.is_eq(List.length(&2, U32, bs), 5n), VRB.ALLB(bs)) == False{} : Bool}) -> Decoding.outside_image(GS.vec_bool_5(), bs):
  v => e => vec_bool_5_rj(bs, h, v, e)

# ---- vec_bool_8 (8 bytes; validator T.v8_bool_ok: every byte a boolean) ----
# the check loop from byte j (index i) on: acc and ALLB of the next 1 + k window bytes
def vec_bool_8_ck(+k: Nat, +d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +i: U32, +j: Nat, +acc: Bool,
    +e: {U32.to_nat(off) == x : Nat}, +ej: {U32.to_nat(i) == j : Nat}, +hd: {Nat.is_lt(d, 28n) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hb: {Nat.is_le(VRL.pos(Nat.add(1n+k, j), 1n, x), A.quad(VB.pw(d))) == True{} : Bool})
    -> {vec_bool_8_r.v8_bool_ck(k, i, off, acc, (UA.BF(t, n), U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1))) == (UA.BF(t, n), Bool.and(acc, VRB.ALLB(UW.WX(t, VRL.pos(j, 1n, x), 1n+k)))) : B.Buf & Bool}:
  match k:
    case 0n:
    +hy = FD.nat__lt_le_trans(VRL.pos(j, 1n, x), 1n+VRL.pos(j, 1n, x), A.quad(VB.pw(d)), FD.nat__lt_succ(VRL.pos(j, 1n, x)), FD.nat__le_trans(1n+VRL.pos(j, 1n, x), VRL.pos(Nat.add(1n+k, j), 1n, x), A.quad(VB.pw(d)), VRB.pmk(k, j, x), hb))
      %Equal.sym(+List<U32>, UW.WX(t, VRL.pos(j, 1n, x), 1n), Con{VRB.BX(t, VRL.pos(j, 1n, x)), UW.WX(t, 1n+VRL.pos(j, 1n, x), 0n)}, VRB.wxc(d, t, VRL.pos(j, 1n, x), 0n, pf, hy)) :
        {(UA.BF(t, n), Bool.and(acc, U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1))) == (UA.BF(t, n), Bool.and(acc, VRB.ALLB(_))) : B.Buf & Bool}
      %Equal.sym(Bool, Bool.and(U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1), True{}), U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1), VRB.and_true(U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1))) :
        {(UA.BF(t, n), Bool.and(acc, U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1))) == (UA.BF(t, n), Bool.and(acc, _)) : B.Buf & Bool}
      {==}
    case 1n+ +q:
    +hy = FD.nat__lt_le_trans(VRL.pos(j, 1n, x), 1n+VRL.pos(j, 1n, x), A.quad(VB.pw(d)), FD.nat__lt_succ(VRL.pos(j, 1n, x)), FD.nat__le_trans(1n+VRL.pos(j, 1n, x), VRL.pos(Nat.add(1n+k, j), 1n, x), A.quad(VB.pw(d)), VRB.pmk(k, j, x), hb))
      +c = U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1)
      +R = VRB.ALLB(UW.WX(t, VRL.pos(1n+j, 1n, x), 1n+q))
      +hx = VRL.nextfit(j, q, 1n, x, A.quad(VB.pw(d)), hb)
      +ex = VRL.posU(d, off, x, i, j, 1, 0n, {==}, e, ej, hd, hx)
      +hx1 = FD.nat__lt_le_trans(VRL.pos(1n+j, 1n, x), Nat.add(VRL.pos(1n+j, 1n, x), 1n), A.quad(VB.pw(d)), VTX.ltp(VRL.pos(1n+j, 1n, x), 0n), hx)
      +hb2 = FD.logic__subst(Nat, z => {Nat.is_le(VRL.pos(1n+z, 1n, x), A.quad(VB.pw(d))) == True{} : Bool}, 1n+Nat.add(q, j), Nat.add(q, 1n+j), Equal.sym(Nat, Nat.add(q, 1n+j), 1n+Nat.add(q, j), FD.nat__add_succ(q, j)), hb)
      %Equal.sym(+List<U32>, UW.WX(t, VRL.pos(j, 1n, x), 2n+q), Con{VRB.BX(t, VRL.pos(j, 1n, x)), UW.WX(t, 1n+VRL.pos(j, 1n, x), 1n+q)}, VRB.wxc(d, t, VRL.pos(j, 1n, x), 1n+q, pf, hy)) :
        {vec_bool_8_r.v8_bool_ck(1n+q, i, off, acc, (UA.BF(t, n), c)) == (UA.BF(t, n), Bool.and(acc, VRB.ALLB(_))) : B.Buf & Bool}
      %VRB.and_assoc(acc, c, R) : {vec_bool_8_r.v8_bool_ck(1n+q, i, off, acc, (UA.BF(t, n), c)) == (UA.BF(t, n), _) : B.Buf & Bool}
      %Equal.sym(B.Buf & Bool, O.ok_bool(UA.BF(t, n), U32.add(off, U32.mul(U32.add(i, 1), 1))), (UA.BF(t, n), U32.is_le(VRB.BX(t, VRL.pos(1n+j, 1n, x)), 1)),
          VRB.okb(d, t, n, U32.add(off, U32.mul(U32.add(i, 1), 1)), VRL.pos(1n+j, 1n, x), ex, hd, pf, hx1)) :
        {vec_bool_8_r.v8_bool_ck(q, U32.add(i, 1), off, Bool.and(acc, c), _) == (UA.BF(t, n), Bool.and(Bool.and(acc, c), R)) : B.Buf & Bool}
      vec_bool_8_ck(q, d, t, n, off, x, U32.add(i, 1), 1n+j, Bool.and(acc, c), e, VRL.succU(d, i, j, 0n, x, ej, hd, hx), hd, pf, hb2)

def vec_bool_8_at(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 8n), A.quad(VB.pw(d))) == True{} : Bool})
    -> {vec_bool_8_r.v8_bool_ok_at(UA.BF(t, n), off) == (UA.BF(t, n), VRB.ALLB(UW.WX(t, x, 8n))) : B.Buf & Bool}:
  +hx = FD.nat__lt_le_trans(x, Nat.add(x, 8n), A.quad(VB.pw(d)), VTX.ltp(x, 7n), hb)
  +hk = FD.logic__subst(Nat, z => {Nat.is_le(z, A.quad(VB.pw(d))) == True{} : Bool}, Nat.add(x, 8n), Nat.add(8n, x), FD.nat__add_comm(x, 8n), hb)
  %Equal.sym(B.Buf & Bool, O.ok_bool(UA.BF(t, n), off), (UA.BF(t, n), U32.is_le(VRB.BX(t, x), 1)), VRB.okb(d, t, n, off, x, e, hd, pf, hx)) :
    {vec_bool_8_r.v8_bool_ck(7n, 0, off, True{}, _) == (UA.BF(t, n), VRB.ALLB(UW.WX(t, x, 8n))) : B.Buf & Bool}
  vec_bool_8_ck(7n, d, t, n, off, x, 0, 0n, True{}, e, {==}, hd, pf, hk)

def vec_bool_8_okl(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 8n), A.quad(VB.pw(d))) == True{} : Bool}, +b: Bool)
    -> {vec_bool_8_r.v8_bool_ok_len(b, UA.BF(t, n), off) == (UA.BF(t, n), Bool.and(b, VRB.ALLB(UW.WX(t, x, 8n)))) : B.Buf & Bool}:
  match b:
    case True{}: vec_bool_8_at(d, t, n, off, x, e, hd, pf, hb)
    case False{}: {==}

# the validator returns the length check and ALLB of the N window bytes
def vec_bool_8_ok_eval(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 8n), A.quad(VB.pw(d))) == True{} : Bool}, +len: U32)
    -> {vec_bool_8_r.v8_bool_ok(UA.BF(t, n), off, len) == (UA.BF(t, n), Bool.and(U32.is_eq(len, 8), VRB.ALLB(UW.WX(t, x, 8n)))) : B.Buf & Bool}:
  vec_bool_8_okl(d, t, n, off, x, e, hd, pf, hb, U32.is_eq(len, 8))

# the check loop from byte j (index i) on: acc and ALLB of the next 1 + k window bytes
def vec_bool_8_ckD(+k: Nat, +d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +i: U32, +j: Nat, +acc: Bool,
    +e: {U32.to_nat(off) == x : Nat}, +ej: {U32.to_nat(i) == j : Nat}, +hd: {Nat.is_lt(d, 31n) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hb: {Nat.is_le(VRL.pos(Nat.add(1n+k, j), 1n, x), A.quad(VB.pw(d))) == True{} : Bool}, +hs: {Nat.is_lt(VRL.pos(Nat.add(1n+k, j), 1n, x), FD.spec_common__pow2(32n)) == True{} : Bool})
    -> {vec_bool_8_r.v8_bool_ck(k, i, off, acc, (UA.BF(t, n), U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1))) == (UA.BF(t, n), Bool.and(acc, VRB.ALLB(UW.WX(t, VRL.pos(j, 1n, x), 1n+k)))) : B.Buf & Bool}:
  match k:
    case 0n:
    +hy = FD.nat__lt_le_trans(VRL.pos(j, 1n, x), 1n+VRL.pos(j, 1n, x), A.quad(VB.pw(d)), FD.nat__lt_succ(VRL.pos(j, 1n, x)), FD.nat__le_trans(1n+VRL.pos(j, 1n, x), VRL.pos(Nat.add(1n+k, j), 1n, x), A.quad(VB.pw(d)), VRB.pmk(k, j, x), hb))
      %Equal.sym(+List<U32>, UW.WX(t, VRL.pos(j, 1n, x), 1n), Con{VRB.BX(t, VRL.pos(j, 1n, x)), UW.WX(t, 1n+VRL.pos(j, 1n, x), 0n)}, VRB.wxc(d, t, VRL.pos(j, 1n, x), 0n, pf, hy)) :
        {(UA.BF(t, n), Bool.and(acc, U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1))) == (UA.BF(t, n), Bool.and(acc, VRB.ALLB(_))) : B.Buf & Bool}
      %Equal.sym(Bool, Bool.and(U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1), True{}), U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1), VRB.and_true(U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1))) :
        {(UA.BF(t, n), Bool.and(acc, U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1))) == (UA.BF(t, n), Bool.and(acc, _)) : B.Buf & Bool}
      {==}
    case 1n+ +q:
    +hy = FD.nat__lt_le_trans(VRL.pos(j, 1n, x), 1n+VRL.pos(j, 1n, x), A.quad(VB.pw(d)), FD.nat__lt_succ(VRL.pos(j, 1n, x)), FD.nat__le_trans(1n+VRL.pos(j, 1n, x), VRL.pos(Nat.add(1n+k, j), 1n, x), A.quad(VB.pw(d)), VRB.pmk(k, j, x), hb))
      +c = U32.is_le(VRB.BX(t, VRL.pos(j, 1n, x)), 1)
      +R = VRB.ALLB(UW.WX(t, VRL.pos(1n+j, 1n, x), 1n+q))
      +hx = VRL.nextfit(j, q, 1n, x, A.quad(VB.pw(d)), hb)
      +hx32 = FD.nat__le_lt_trans(Nat.add(VRL.pos(1n+j, 1n, x), 1n), VRL.pos(Nat.add(2n+q, j), 1n, x), FD.spec_common__pow2(32n), VRL.nextfit(j, q, 1n, x, VRL.pos(Nat.add(2n+q, j), 1n, x), FD.nat__le_refl(VRL.pos(Nat.add(2n+q, j), 1n, x))), hs)
  +ex = VRL.posU32(off, x, i, j, 1, 0n, {==}, e, ej, hx32)
  +hs2 = FD.logic__subst(Nat, z => {Nat.is_lt(VRL.pos(1n+z, 1n, x), FD.spec_common__pow2(32n)) == True{} : Bool}, 1n+Nat.add(q, j), Nat.add(q, 1n+j), Equal.sym(Nat, Nat.add(q, 1n+j), 1n+Nat.add(q, j), FD.nat__add_succ(q, j)), hs)
      +hx1 = FD.nat__lt_le_trans(VRL.pos(1n+j, 1n, x), Nat.add(VRL.pos(1n+j, 1n, x), 1n), A.quad(VB.pw(d)), VTX.ltp(VRL.pos(1n+j, 1n, x), 0n), hx)
      +hb2 = FD.logic__subst(Nat, z => {Nat.is_le(VRL.pos(1n+z, 1n, x), A.quad(VB.pw(d))) == True{} : Bool}, 1n+Nat.add(q, j), Nat.add(q, 1n+j), Equal.sym(Nat, Nat.add(q, 1n+j), 1n+Nat.add(q, j), FD.nat__add_succ(q, j)), hb)
      %Equal.sym(+List<U32>, UW.WX(t, VRL.pos(j, 1n, x), 2n+q), Con{VRB.BX(t, VRL.pos(j, 1n, x)), UW.WX(t, 1n+VRL.pos(j, 1n, x), 1n+q)}, VRB.wxc(d, t, VRL.pos(j, 1n, x), 1n+q, pf, hy)) :
        {vec_bool_8_r.v8_bool_ck(1n+q, i, off, acc, (UA.BF(t, n), c)) == (UA.BF(t, n), Bool.and(acc, VRB.ALLB(_))) : B.Buf & Bool}
      %VRB.and_assoc(acc, c, R) : {vec_bool_8_r.v8_bool_ck(1n+q, i, off, acc, (UA.BF(t, n), c)) == (UA.BF(t, n), _) : B.Buf & Bool}
      %Equal.sym(B.Buf & Bool, O.ok_bool(UA.BF(t, n), U32.add(off, U32.mul(U32.add(i, 1), 1))), (UA.BF(t, n), U32.is_le(VRB.BX(t, VRL.pos(1n+j, 1n, x)), 1)),
          VRB.okbD(d, t, n, U32.add(off, U32.mul(U32.add(i, 1), 1)), VRL.pos(1n+j, 1n, x), ex, hd, pf, hx1)) :
        {vec_bool_8_r.v8_bool_ck(q, U32.add(i, 1), off, Bool.and(acc, c), _) == (UA.BF(t, n), Bool.and(Bool.and(acc, c), R)) : B.Buf & Bool}
      vec_bool_8_ckD(q, d, t, n, off, x, U32.add(i, 1), 1n+j, Bool.and(acc, c), e, VRL.succU32(i, j, 0n, x, ej, hx32), hd, pf, hb2, hs2)

def vec_bool_8_atD(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 8n), A.quad(VB.pw(d))) == True{} : Bool}, +hs: {Nat.is_lt(Nat.add(x, 8n), FD.spec_common__pow2(32n)) == True{} : Bool})
    -> {vec_bool_8_r.v8_bool_ok_at(UA.BF(t, n), off) == (UA.BF(t, n), VRB.ALLB(UW.WX(t, x, 8n))) : B.Buf & Bool}:
  +hx = FD.nat__lt_le_trans(x, Nat.add(x, 8n), A.quad(VB.pw(d)), VTX.ltp(x, 7n), hb)
  +hk = FD.logic__subst(Nat, z => {Nat.is_le(z, A.quad(VB.pw(d))) == True{} : Bool}, Nat.add(x, 8n), Nat.add(8n, x), FD.nat__add_comm(x, 8n), hb)
  %Equal.sym(B.Buf & Bool, O.ok_bool(UA.BF(t, n), off), (UA.BF(t, n), U32.is_le(VRB.BX(t, x), 1)), VRB.okbD(d, t, n, off, x, e, hd, pf, hx)) :
    {vec_bool_8_r.v8_bool_ck(7n, 0, off, True{}, _) == (UA.BF(t, n), VRB.ALLB(UW.WX(t, x, 8n))) : B.Buf & Bool}
  +hk32 = FD.logic__subst(Nat, z => {Nat.is_lt(z, FD.spec_common__pow2(32n)) == True{} : Bool}, Nat.add(x, 8n), Nat.add(8n, x), FD.nat__add_comm(x, 8n), hs)
  vec_bool_8_ckD(7n, d, t, n, off, x, 0, 0n, True{}, e, {==}, hd, pf, hk, hk32)

def vec_bool_8_oklD(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 8n), A.quad(VB.pw(d))) == True{} : Bool}, +hs: {Nat.is_lt(Nat.add(x, 8n), FD.spec_common__pow2(32n)) == True{} : Bool}, +b: Bool)
    -> {vec_bool_8_r.v8_bool_ok_len(b, UA.BF(t, n), off) == (UA.BF(t, n), Bool.and(b, VRB.ALLB(UW.WX(t, x, 8n)))) : B.Buf & Bool}:
  match b:
    case True{}: vec_bool_8_atD(d, t, n, off, x, e, hd, pf, hb, hs)
    case False{}: {==}

# the validator returns the length check and ALLB of the N window bytes
def vec_bool_8_ok_evalD(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 8n), A.quad(VB.pw(d))) == True{} : Bool}, +hs: {Nat.is_lt(Nat.add(x, 8n), FD.spec_common__pow2(32n)) == True{} : Bool}, +len: U32)
    -> {vec_bool_8_r.v8_bool_ok(UA.BF(t, n), off, len) == (UA.BF(t, n), Bool.and(U32.is_eq(len, 8), VRB.ALLB(UW.WX(t, x, 8n)))) : B.Buf & Bool}:
  vec_bool_8_oklD(d, t, n, off, x, e, hd, pf, hb, hs, U32.is_eq(len, 8))

def vec_bool_8_rj(+bs: +List<U32>, +h: {Bool.and(Nat.is_eq(List.length(&2, U32, bs), 8n), VRB.ALLB(bs)) == False{} : Bool}, +v: S.Value, +e: {Codec.encoding_for_legal_type(GS.vec_bool_8(), v) == Some{bs} : Maybe<&2, +List<U32>>}) -> Empty:
  VRB.chk_true(Nat.is_eq(List.length(&2, U32, bs), 8n), VRB.ALLB(bs),
    VRB.len_eq(SS.fixed_size(GS.vec_bool_8()), 8n, bs, Codec.parts(v, GS.vec_bool_8()), DS.facts(v, GS.vec_bool_8(), {==}), {==}, e),
    VRB.vecb(v, 8n, bs, e), h)

# a byte list of another length, or with a byte above 1, is no encoding
def vec_bool_8_decode_reject(+bs: +List<U32>, +h: {Bool.and(Nat.is_eq(List.length(&2, U32, bs), 8n), VRB.ALLB(bs)) == False{} : Bool}) -> Decoding.outside_image(GS.vec_bool_8(), bs):
  v => e => vec_bool_8_rj(bs, h, v, e)

