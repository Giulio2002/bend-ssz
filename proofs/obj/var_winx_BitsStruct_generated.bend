      Equal.cong(Nat, Nat, z => Nat.add(U32.to_nat(11), z), U32.to_nat(LJ0(t, x)), LY.LN(UW.WX(t, XJ0(t, x), U32.to_nat(LJ0(t, x)))), Equal.sym(Nat, LY.LN(UW.WX(t, XJ0(t, x), U32.to_nat(LJ0(t, x)))), U32.to_nat(LJ0(t, x)), lY0(d, t, n, x, off, len, eo, hd, hw, hw32, pf, h)))))
