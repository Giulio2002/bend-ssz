    {LY.HDRW(PSW(t, x, len), [O0(t, x), O1(t, x)]) == _ : +List<U32>}
  %UR.rwn_bytes(d, t, Nat.add(x, U32.to_nat(0)), pf, roomFXD(d, t, n, x, off, len, eo, hd, hw, hw32, pf, hF, U32.to_nat(0), 4n, VA.lea(0, 4, 11, 4n, {==}, {==}, {==}))) :
    {LY.HDRW(PSW(t, x, len), [O0(t, x), O1(t, x)]) == List.append(&2, U32, _, UW.WX(t, Nat.add(x, U32.to_nat(4)), U32.to_nat(7))) : +List<U32>}
  %Equal.sym(+List<U32>, UW.WX(t, Nat.add(x, U32.to_nat(4)), U32.to_nat(7)), List.append(&2, U32, UW.WX(t, Nat.add(x, U32.to_nat(4)), 1n), UW.WX(t, Nat.add(x, U32.to_nat(5)), U32.to_nat(6))), splitXe(t, x, U32.to_nat(4), 1n, U32.to_nat(6), U32.to_nat(7), U32.to_nat(5), VA.stpL(1, 6, 7, 1n, {==}, {==}, {==}), VA.stp(4, 1, 5, 1n, {==}, {==}, {==}))) :
    {LY.HDRW(PSW(t, x, len), [O0(t, x), O1(t, x)]) == List.append(&2, U32, F.limbs([UR.RWN(t, Nat.add(x, U32.to_nat(0)))]), _) : +List<U32>}
