def OBJw(+d: Nat, +t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32) -> BitsStruct_d.BitsStruct: BitsStruct_d.BitsStruct{CH0.OBJw(d, t, XJ0(t, x), FJ0(off, t, x), LJ0(t, x)), FX_bv2.OBJ(d, t, Nat.add(x, U32.to_nat(4))), FX_bv1.OBJ(d, t, Nat.add(x, U32.to_nat(5))), CH1.OBJw(d, t, XJ1(t, x), FJ1(off, t, x), LJ1(t, x, len)), FX_bv8.OBJ(d, t, Nat.add(x, U32.to_nat(10)))}

# The reader on the window, when the checks hold.
def readwD(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +hw32: {Nat.is_lt(Nat.add(x, U32.to_nat(len)), FD.spec_common__pow2(32n)) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hchk: {CHKw(t, x, off, len) == True{} : Bool}) -> {BitsStruct_r.BitsStruct_read(BF(t, n), off, len) == (BF(t, n), OBJw(d, t, x, off, len)) : B.Buf & BitsStruct_d.BitsStruct}:
  rd_all(d, t, n, x, off, len, eo, hd, hw, hw32, pf, hchk)
def PSW(+t: FD.array__Tree<U32>, +x: Nat, +len: U32) -> +List<S.Part>: [S.Variable{UW.WX(t, XJ0(t, x), U32.to_nat(LJ0(t, x)))}, S.Fixed{UW.WX(t, Nat.add(x, U32.to_nat(4)), 1n)}, S.Fixed{UW.WX(t, Nat.add(x, U32.to_nat(5)), 1n)}, S.Variable{UW.WX(t, XJ1(t, x), U32.to_nat(LJ1(t, x, len)))}, S.Fixed{UW.WX(t, Nat.add(x, U32.to_nat(10)), 1n)}]
def RST4(+t: FD.array__Tree<U32>, +x: Nat, +len: U32) -> +List<S.Part>: []
def RST3(+t: FD.array__Tree<U32>, +x: Nat, +len: U32) -> +List<S.Part>: Con{S.Fixed{UW.WX(t, Nat.add(x, U32.to_nat(10)), 1n)}, RST4(t, x, len)}
def RST2(+t: FD.array__Tree<U32>, +x: Nat, +len: U32) -> +List<S.Part>: Con{S.Variable{UW.WX(t, XJ1(t, x), U32.to_nat(LJ1(t, x, len)))}, RST3(t, x, len)}
def RST1(+t: FD.array__Tree<U32>, +x: Nat, +len: U32) -> +List<S.Part>: Con{S.Fixed{UW.WX(t, Nat.add(x, U32.to_nat(5)), 1n)}, RST2(t, x, len)}
def RST0(+t: FD.array__Tree<U32>, +x: Nat, +len: U32) -> +List<S.Part>: Con{S.Fixed{UW.WX(t, Nat.add(x, U32.to_nat(4)), 1n)}, RST1(t, x, len)}
def ITS5(+t: FD.array__Tree<U32>, +x: Nat, +len: U32) -> S.Value: S.EmptyItems{}
def ITS4(+t: FD.array__Tree<U32>, +x: Nat, +len: U32) -> S.Value: S.Items{FX_bv8.VAL(t, Nat.add(x, U32.to_nat(10))), ITS5(t, x, len)}
def ITS3(+t: FD.array__Tree<U32>, +x: Nat, +len: U32) -> S.Value: S.Items{CH1.VALw(t, XJ1(t, x), LJ1(t, x, len)), ITS4(t, x, len)}
def ITS2(+t: FD.array__Tree<U32>, +x: Nat, +len: U32) -> S.Value: S.Items{FX_bv1.VAL(t, Nat.add(x, U32.to_nat(5))), ITS3(t, x, len)}
def ITS1(+t: FD.array__Tree<U32>, +x: Nat, +len: U32) -> S.Value: S.Items{FX_bv2.VAL(t, Nat.add(x, U32.to_nat(4))), ITS2(t, x, len)}
def ITS0(+t: FD.array__Tree<U32>, +x: Nat, +len: U32) -> S.Value: S.Items{CH0.VALw(t, XJ0(t, x), LJ0(t, x)), ITS1(t, x, len)}


# ---- the schema, taken apart without unfolding it ----------------------------------------------

def TL0(+sv: S.Schema) -> S.Schema: SH.Container_fields(sv)
def TL1(+sv: S.Schema) -> S.Schema: SH.Chain_tail(TL0(sv))
def TL2(+sv: S.Schema) -> S.Schema: SH.Chain_tail(TL1(sv))
def TL3(+sv: S.Schema) -> S.Schema: SH.Chain_tail(TL2(sv))
def TL4(+sv: S.Schema) -> S.Schema: SH.Chain_tail(TL3(sv))
def TL5(+sv: S.Schema) -> S.Schema: SH.Chain_tail(TL4(sv))
def HD0(+sv: S.Schema) -> S.Schema: SH.Chain_head(TL0(sv))
def HD1(+sv: S.Schema) -> S.Schema: SH.Chain_head(TL1(sv))
def HD2(+sv: S.Schema) -> S.Schema: SH.Chain_head(TL2(sv))
def HD3(+sv: S.Schema) -> S.Schema: SH.Chain_head(TL3(sv))
def HD4(+sv: S.Schema) -> S.Schema: SH.Chain_head(TL4(sv))
def isc(+sv: S.Schema, +esv: {sv == GS.BitsStruct() : S.Schema}) -> {SH.is_Container(sv) == True{} : Bool}:
  FD.logic__subst(S.Schema, z => {SH.is_Container(z) == True{} : Bool}, GS.BitsStruct(), sv, Equal.sym(S.Schema, sv, GS.BitsStruct(), esv), {==})
def fsn(+sv: S.Schema, +esv: {sv == GS.BitsStruct() : S.Schema}) -> {SS.fixed_size(SH.Container_fields(sv)) == None{} : Maybe<&2, Nat>}:
  FD.logic__subst(S.Schema, z => {SS.fixed_size(SH.Container_fields(z)) == None{} : Maybe<&2, Nat>}, GS.BitsStruct(), sv, Equal.sym(S.Schema, sv, GS.BitsStruct(), esv), {==})
def es0(+sv: S.Schema, +esv: {sv == GS.BitsStruct() : S.Schema}) -> {HD0(sv) == S.BitList{5n} : S.Schema}:
  FD.logic__subst(S.Schema, z => {HD0(z) == S.BitList{5n} : S.Schema}, GS.BitsStruct(), sv, Equal.sym(S.Schema, sv, GS.BitsStruct(), esv), {==})
def isch0(+sv: S.Schema, +esv: {sv == GS.BitsStruct() : S.Schema}) -> {SH.is_Chain(TL0(sv)) == True{} : Bool}:
  FD.logic__subst(S.Schema, z => {SH.is_Chain(TL0(z)) == True{} : Bool}, GS.BitsStruct(), sv, Equal.sym(S.Schema, sv, GS.BitsStruct(), esv), {==})
def es1(+sv: S.Schema, +esv: {sv == GS.BitsStruct() : S.Schema}) -> {HD1(sv) == S.BitVector{2n} : S.Schema}:
  FD.logic__subst(S.Schema, z => {HD1(z) == S.BitVector{2n} : S.Schema}, GS.BitsStruct(), sv, Equal.sym(S.Schema, sv, GS.BitsStruct(), esv), {==})
def isch1(+sv: S.Schema, +esv: {sv == GS.BitsStruct() : S.Schema}) -> {SH.is_Chain(TL1(sv)) == True{} : Bool}:
  FD.logic__subst(S.Schema, z => {SH.is_Chain(TL1(z)) == True{} : Bool}, GS.BitsStruct(), sv, Equal.sym(S.Schema, sv, GS.BitsStruct(), esv), {==})
def es2(+sv: S.Schema, +esv: {sv == GS.BitsStruct() : S.Schema}) -> {HD2(sv) == S.BitVector{1n} : S.Schema}:
  FD.logic__subst(S.Schema, z => {HD2(z) == S.BitVector{1n} : S.Schema}, GS.BitsStruct(), sv, Equal.sym(S.Schema, sv, GS.BitsStruct(), esv), {==})
def isch2(+sv: S.Schema, +esv: {sv == GS.BitsStruct() : S.Schema}) -> {SH.is_Chain(TL2(sv)) == True{} : Bool}:
  FD.logic__subst(S.Schema, z => {SH.is_Chain(TL2(z)) == True{} : Bool}, GS.BitsStruct(), sv, Equal.sym(S.Schema, sv, GS.BitsStruct(), esv), {==})
def es3(+sv: S.Schema, +esv: {sv == GS.BitsStruct() : S.Schema}) -> {HD3(sv) == S.BitList{6n} : S.Schema}:
  FD.logic__subst(S.Schema, z => {HD3(z) == S.BitList{6n} : S.Schema}, GS.BitsStruct(), sv, Equal.sym(S.Schema, sv, GS.BitsStruct(), esv), {==})
def isch3(+sv: S.Schema, +esv: {sv == GS.BitsStruct() : S.Schema}) -> {SH.is_Chain(TL3(sv)) == True{} : Bool}:
  FD.logic__subst(S.Schema, z => {SH.is_Chain(TL3(z)) == True{} : Bool}, GS.BitsStruct(), sv, Equal.sym(S.Schema, sv, GS.BitsStruct(), esv), {==})
def es4(+sv: S.Schema, +esv: {sv == GS.BitsStruct() : S.Schema}) -> {HD4(sv) == S.BitVector{8n} : S.Schema}:
  FD.logic__subst(S.Schema, z => {HD4(z) == S.BitVector{8n} : S.Schema}, GS.BitsStruct(), sv, Equal.sym(S.Schema, sv, GS.BitsStruct(), esv), {==})
def isch4(+sv: S.Schema, +esv: {sv == GS.BitsStruct() : S.Schema}) -> {SH.is_Chain(TL4(sv)) == True{} : Bool}:
  FD.logic__subst(S.Schema, z => {SH.is_Chain(TL4(z)) == True{} : Bool}, GS.BitsStruct(), sv, Equal.sym(S.Schema, sv, GS.BitsStruct(), esv), {==})
def isend(+sv: S.Schema, +esv: {sv == GS.BitsStruct() : S.Schema}) -> {SH.is_End(TL5(sv)) == True{} : Bool}:
  FD.logic__subst(S.Schema, z => {SH.is_End(TL5(z)) == True{} : Bool}, GS.BitsStruct(), sv, Equal.sym(S.Schema, sv, GS.BitsStruct(), esv), {==})
def CHS5(+sv: S.Schema) -> S.Schema: S.End{}
def CHS4(+sv: S.Schema) -> S.Schema: S.Chain{HD4(sv), CHS5(sv)}
def CHS3(+sv: S.Schema) -> S.Schema: S.Chain{HD3(sv), CHS4(sv)}
def CHS2(+sv: S.Schema) -> S.Schema: S.Chain{HD2(sv), CHS3(sv)}
def CHS1(+sv: S.Schema) -> S.Schema: S.Chain{HD1(sv), CHS2(sv)}
def CHS0(+sv: S.Schema) -> S.Schema: S.Chain{HD0(sv), CHS1(sv)}
def fe5(+sv: S.Schema, +esv: {sv == GS.BitsStruct() : S.Schema}) -> {TL5(sv) == S.End{} : S.Schema}: SH.End_shape(TL5(sv), isend(sv, esv))
def fe4(+sv: S.Schema, +esv: {sv == GS.BitsStruct() : S.Schema}) -> {TL4(sv) == CHS4(sv) : S.Schema}:
  Equal.trans(S.Schema, TL4(sv), S.Chain{HD4(sv), TL5(sv)}, CHS4(sv), SH.Chain_shape(TL4(sv), isch4(sv, esv)),
    Equal.cong(S.Schema, S.Schema, z => S.Chain{HD4(sv), z}, TL5(sv), CHS5(sv), fe5(sv, esv)))
def fe3(+sv: S.Schema, +esv: {sv == GS.BitsStruct() : S.Schema}) -> {TL3(sv) == CHS3(sv) : S.Schema}:
  Equal.trans(S.Schema, TL3(sv), S.Chain{HD3(sv), TL4(sv)}, CHS3(sv), SH.Chain_shape(TL3(sv), isch3(sv, esv)),
    Equal.cong(S.Schema, S.Schema, z => S.Chain{HD3(sv), z}, TL4(sv), CHS4(sv), fe4(sv, esv)))
def fe2(+sv: S.Schema, +esv: {sv == GS.BitsStruct() : S.Schema}) -> {TL2(sv) == CHS2(sv) : S.Schema}:
  Equal.trans(S.Schema, TL2(sv), S.Chain{HD2(sv), TL3(sv)}, CHS2(sv), SH.Chain_shape(TL2(sv), isch2(sv, esv)),
    Equal.cong(S.Schema, S.Schema, z => S.Chain{HD2(sv), z}, TL3(sv), CHS3(sv), fe3(sv, esv)))
def fe1(+sv: S.Schema, +esv: {sv == GS.BitsStruct() : S.Schema}) -> {TL1(sv) == CHS1(sv) : S.Schema}:
  Equal.trans(S.Schema, TL1(sv), S.Chain{HD1(sv), TL2(sv)}, CHS1(sv), SH.Chain_shape(TL1(sv), isch1(sv, esv)),
    Equal.cong(S.Schema, S.Schema, z => S.Chain{HD1(sv), z}, TL2(sv), CHS2(sv), fe2(sv, esv)))
def fe0(+sv: S.Schema, +esv: {sv == GS.BitsStruct() : S.Schema}) -> {TL0(sv) == CHS0(sv) : S.Schema}:
  Equal.trans(S.Schema, TL0(sv), S.Chain{HD0(sv), TL1(sv)}, CHS0(sv), SH.Chain_shape(TL0(sv), isch0(sv, esv)),
    Equal.cong(S.Schema, S.Schema, z => S.Chain{HD0(sv), z}, TL1(sv), CHS1(sv), fe1(sv, esv)))

