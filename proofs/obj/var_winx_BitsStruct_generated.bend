    {[None{}, Some{_}, Some{List.length(&2, U32, UW.WX(t, Nat.add(x, U32.to_nat(5)), 1n))}, None{}, Some{List.length(&2, U32, UW.WX(t, Nat.add(x, U32.to_nat(10)), 1n))}] == WSS0() : +List<Maybe<&2, Nat>>}
  %Equal.sym(Nat, List.length(&2, U32, UW.WX(t, Nat.add(x, U32.to_nat(5)), 1n)), 1n, UW.lenWX(d, t, Nat.add(x, U32.to_nat(5)), 1n, pf, roomFXD(d, t, n, x, off, len, eo, hd, hw, hw32, pf, hF, U32.to_nat(5), 1n, VA.lea(5, 1, 11, 1n, {==}, {==}, {==})))) :
    {[None{}, Some{1n}, Some{_}, None{}, Some{List.length(&2, U32, UW.WX(t, Nat.add(x, U32.to_nat(10)), 1n))}] == WSS0() : +List<Maybe<&2, Nat>>}
  %Equal.sym(Nat, List.length(&2, U32, UW.WX(t, Nat.add(x, U32.to_nat(10)), 1n)), 1n, UW.lenWX(d, t, Nat.add(x, U32.to_nat(10)), 1n, pf, roomFXD(d, t, n, x, off, len, eo, hd, hw, hw32, pf, hF, U32.to_nat(10), 1n, VA.lea(10, 1, 11, 1n, {==}, {==}, {==})))) :
    {[None{}, Some{1n}, Some{1n}, None{}, Some{_}] == WSS0() : +List<Maybe<&2, Nat>>}
  %Equal.sym(+List<Maybe<&2, Nat>>, [None{}, Some{1n}, Some{1n}, None{}, Some{1n}], WSS0(), {==}) : {_ == WSS0() : +List<Maybe<&2, Nat>>}
  {==}

