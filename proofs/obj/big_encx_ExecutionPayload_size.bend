# ---- the size pass on the container's mirror ----
def SZSM(m: CI.MW) -> U32:
  match m:
    case CI.MW{+parent_hash, +fee_recipient, +state_root, +receipts_root, +dB_logs_bloom, +TB_logs_bloom, +prev_randao, +block_number, +gas_limit, +gas_used, +timestamp, +m_extra_data, +base_fee_per_gas, +block_hash, +t_transactions, +N_transactions, +A_withdrawals, +N_withdrawals, +blob_gas_used, +excess_blob_gas}: SZS(parent_hash, fee_recipient, state_root, receipts_root, dB_logs_bloom, TB_logs_bloom, prev_randao, block_number, gas_limit, gas_used, timestamp, m_extra_data, base_fee_per_gas, block_hash, t_transactions, N_transactions, A_withdrawals, N_withdrawals, blob_gas_used, excess_blob_gas)

law sizex:
  for +m: CI.MW
  for +hok: {CI.OK(m) == True{} : Bool}
  {T.ExecutionPayload_size(CI.TH(m)) == (CI.TH(m), SZSM(m)) : T.ExecutionPayload & U32}
def sizex(m, hok):
  match m:
    case CI.MW{+parent_hash, +fee_recipient, +state_root, +receipts_root, +dB_logs_bloom, +TB_logs_bloom, +prev_randao, +block_number, +gas_limit, +gas_used, +timestamp, +m_extra_data, +base_fee_per_gas, +block_hash, +t_transactions, +N_transactions, +A_withdrawals, +N_withdrawals, +blob_gas_used, +excess_blob_gas}: sizeC(parent_hash, fee_recipient, state_root, receipts_root, dB_logs_bloom, TB_logs_bloom, prev_randao, block_number, gas_limit, gas_used, timestamp, m_extra_data, base_fee_per_gas, block_hash, t_transactions, N_transactions, A_withdrawals, N_withdrawals, blob_gas_used, excess_blob_gas, hok)

