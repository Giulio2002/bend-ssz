# ---- the list's spec side -------------------------------------------------------------------------

# The records j .. j + c - 1 are valid.
def ALLV(c: Nat, +j: Nat, +t: FD.array__Tree<U32>, +x: Nat) -> Bool:
  match c:
    case 0n: True{}
    case 1n+q: Bool.and(VCK(t, VRL.pos(j, 121n, x)), ALLV(q, 1n+j, t, x))

def cka_acc(k: Nat, +j: Nat, +acc: Bool, +t: FD.array__Tree<U32>, +x: Nat, +h: {CKA(k, j, acc, t, x) == True{} : Bool}) -> {acc == True{} : Bool}:
  match k:
    case 0n: FD.logic__and_left(acc, VCK(t, VRL.pos(j, 121n, x)), h)
    case 1n+ +q: FD.logic__and_left(acc, VCK(t, VRL.pos(j, 121n, x)), cka_acc(q, 1n+j, Bool.and(acc, VCK(t, VRL.pos(j, 121n, x))), t, x, h))

def cka_all(k: Nat, +j: Nat, +acc: Bool, +t: FD.array__Tree<U32>, +x: Nat, +h: {CKA(k, j, acc, t, x) == True{} : Bool}) -> {ALLV(1n+k, j, t, x) == True{} : Bool}:
  match k:
    case 0n: FD.logic__and_intro(VCK(t, VRL.pos(j, 121n, x)), True{}, FD.logic__and_right(acc, VCK(t, VRL.pos(j, 121n, x)), h), {==})
    case 1n+ +q:
      FD.logic__and_intro(VCK(t, VRL.pos(j, 121n, x)), ALLV(1n+q, 1n+j, t, x), FD.logic__and_right(acc, VCK(t, VRL.pos(j, 121n, x)), cka_acc(q, 1n+j, Bool.and(acc, VCK(t, VRL.pos(j, 121n, x))), t, x, h)),
        cka_all(q, 1n+j, Bool.and(acc, VCK(t, VRL.pos(j, 121n, x))), t, x, h))

def zck_all(+t: FD.array__Tree<U32>, +x: Nat, +len: U32, +e: Bool, +ee: {U32.is_eq(NN(len), 0) == e : Bool}, +h: {ZCK(e, t, x, len) == True{} : Bool})
    -> {ALLV(CC(len), 0n, t, x) == True{} : Bool}:
  match e:
    case True{}:
