  {VBL.nthb(List.append(&2, U32, p, q), Nat.add(List.length(&2, U32, p), k)) == VBL.nthb(q, k) : U32}
def nth_app(p, q, k):
  match p:
    case Nil{}: {==}
    case Con{+h, +r}: nth_app(r, q, k)

