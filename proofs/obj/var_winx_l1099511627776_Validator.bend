        rprt(d, t, VRL.pos(j, 121n, x), pf, fitc(j, q, x, A.quad(VB.pw(d)), hb), FD.logic__and_left(VCK(t, VRL.pos(j, 121n, x)), ALLV(q, 1n+j, t, x), hv)),
        prt_items(q, 1n+j, d, t, x, pf, hbs(j, q, x, A.quad(VB.pw(d)), hb), FD.logic__and_right(VCK(t, VRL.pos(j, 121n, x)), ALLV(q, 1n+j, t, x), hv)))

law rp_size:
