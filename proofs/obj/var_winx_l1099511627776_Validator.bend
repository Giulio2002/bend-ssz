def ZCK(e: Bool, +t: FD.array__Tree<U32>, +x: Nat, +len: U32) -> Bool:
  match e:
    case True{}: True{}
    case False{}: CKA(KK(len), 0n, True{}, t, x)

def LCK(a: Bool, +t: FD.array__Tree<U32>, +x: Nat, +len: U32) -> Bool:
  match a:
    case False{}: False{}
    case True{}: ZCK(U32.is_eq(NN(len), 0), t, x, len)

# Whole records, and each record's boolean byte is at most 1.
def CHKw(+t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32) -> Bool: LCK(Bool.and(U32.is_eq(len, (U32.div(len, 121) * 121 : U32)), True{}), t, x, len)

