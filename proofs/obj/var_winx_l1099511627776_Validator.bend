def RITEMS(c: Nat, +j: Nat, +t: FD.array__Tree<U32>, +x: Nat) -> S.Value:
  match c:
    case 0n: S.EmptyItems{}
    case 1n+q: S.Items{RVAL(t, VRL.pos(j, 121n, x)), RITEMS(q, 1n+j, t, x)}

def RPARTS(c: Nat, +j: Nat, +t: FD.array__Tree<U32>, +x: Nat) -> +List<S.Part>:
  match c:
    case 0n: []
    case 1n+q: S.Fixed{UW.WX(t, VRL.pos(j, 121n, x), 121n)} <> RPARTS(q, 1n+j, t, x)

def FLAT(c: Nat, +j: Nat, +t: FD.array__Tree<U32>, +x: Nat) -> +List<U32>:
  match c:
    case 0n: []
    case 1n+q: List.append(&2, U32, UW.WX(t, VRL.pos(j, 121n, x), 121n), FLAT(q, 1n+j, t, x))

law cnt_items:
  for +c: Nat
