# The record's check: its boolean byte is at most 1.
def VCK(+t: FD.array__Tree<U32>, +y: Nat) -> Bool: U32.is_le(LB(t, 88n+y), 1)

def c0id(+b: Bool, +off: U32, buf: B.Buf) -> {FuluValidator_r.Validator_c0(b, buf, off) == (buf, b) : B.Buf & Bool}:
  match b:
    case True{}: {==}
    case False{}: {==}

