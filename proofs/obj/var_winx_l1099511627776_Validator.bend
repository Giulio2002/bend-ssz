def RVAL(+t: FD.array__Tree<U32>, +y: Nat) -> S.Value: S.Sequence{RCV0(t, y)}

# The record's bytes are the window's 121 bytes at y.
def winR(+d: Nat, +t: FD.array__Tree<U32>, +y: Nat, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(y, 121n), A.quad(VB.pw(d))) == True{} : Bool})
    -> {List.append(&2, U32, List.append(&2, U32, F.limbs([UR.RWN(t, y), UR.RWN(t, 4n+y), UR.RWN(t, 8n+y), UR.RWN(t, 12n+y), UR.RWN(t, 16n+y), UR.RWN(t, 20n+y), UR.RWN(t, 24n+y), UR.RWN(t, 28n+y), UR.RWN(t, 32n+y), UR.RWN(t, 36n+y), UR.RWN(t, 40n+y), UR.RWN(t, 44n+y)]), List.append(&2, U32, F.limbs([UR.RWN(t, 48n+y), UR.RWN(t, 52n+y), UR.RWN(t, 56n+y), UR.RWN(t, 60n+y), UR.RWN(t, 64n+y), UR.RWN(t, 68n+y), UR.RWN(t, 72n+y), UR.RWN(t, 76n+y)]), List.append(&2, U32, F.limbs([UR.RWN(t, 80n+y), UR.RWN(t, 84n+y)]), List.append(&2, U32, [LB(t, 88n+y)], List.append(&2, U32, F.limbs([UR.RWN(t, 89n+y), UR.RWN(t, 93n+y)]), List.append(&2, U32, F.limbs([UR.RWN(t, 97n+y), UR.RWN(t, 101n+y)]), List.append(&2, U32, F.limbs([UR.RWN(t, 105n+y), UR.RWN(t, 109n+y)]), List.append(&2, U32, F.limbs([UR.RWN(t, 113n+y), UR.RWN(t, 117n+y)]), [])))))))), []) == UW.WX(t, y, 121n) : +List<U32>}:
  +hc = FD.logic__subst(Nat, z => {Nat.is_le(z, A.quad(VB.pw(d))) == True{} : Bool}, Nat.add(y, 121n), Nat.add(121n, y), A.add_right(y, 121n), hb)
  +a = Nat.add(A.quad(22n), y)
  +b = Nat.add(1n, a)
  %Equal.sym(+List<U32>, UW.WX(t, y, Nat.add(A.quad(22n), 33n)), List.append(&2, U32, F.limbs(UR.RWS(22n, t, y)), UW.WX(t, a, 33n)), UW.headWX(d, t, y, 22n, 33n, pf, hb)) :
    {List.append(&2, U32, List.append(&2, U32, F.limbs([UR.RWN(t, y), UR.RWN(t, 4n+y), UR.RWN(t, 8n+y), UR.RWN(t, 12n+y), UR.RWN(t, 16n+y), UR.RWN(t, 20n+y), UR.RWN(t, 24n+y), UR.RWN(t, 28n+y), UR.RWN(t, 32n+y), UR.RWN(t, 36n+y), UR.RWN(t, 40n+y), UR.RWN(t, 44n+y)]), List.append(&2, U32, F.limbs([UR.RWN(t, 48n+y), UR.RWN(t, 52n+y), UR.RWN(t, 56n+y), UR.RWN(t, 60n+y), UR.RWN(t, 64n+y), UR.RWN(t, 68n+y), UR.RWN(t, 72n+y), UR.RWN(t, 76n+y)]), List.append(&2, U32, F.limbs([UR.RWN(t, 80n+y), UR.RWN(t, 84n+y)]), List.append(&2, U32, [LB(t, 88n+y)], List.append(&2, U32, F.limbs([UR.RWN(t, 89n+y), UR.RWN(t, 93n+y)]), List.append(&2, U32, F.limbs([UR.RWN(t, 97n+y), UR.RWN(t, 101n+y)]), List.append(&2, U32, F.limbs([UR.RWN(t, 105n+y), UR.RWN(t, 109n+y)]), List.append(&2, U32, F.limbs([UR.RWN(t, 113n+y), UR.RWN(t, 117n+y)]), [])))))))), []) == _ : +List<U32>}
  %Equal.sym(+List<U32>, UW.WX(t, a, Nat.add(1n, 32n)), List.append(&2, U32, UW.WX(t, a, 1n), UW.WX(t, b, 32n)), UW.splitWX(t, a, 1n, 32n)) :
    {List.append(&2, U32, List.append(&2, U32, F.limbs([UR.RWN(t, y), UR.RWN(t, 4n+y), UR.RWN(t, 8n+y), UR.RWN(t, 12n+y), UR.RWN(t, 16n+y), UR.RWN(t, 20n+y), UR.RWN(t, 24n+y), UR.RWN(t, 28n+y), UR.RWN(t, 32n+y), UR.RWN(t, 36n+y), UR.RWN(t, 40n+y), UR.RWN(t, 44n+y)]), List.append(&2, U32, F.limbs([UR.RWN(t, 48n+y), UR.RWN(t, 52n+y), UR.RWN(t, 56n+y), UR.RWN(t, 60n+y), UR.RWN(t, 64n+y), UR.RWN(t, 68n+y), UR.RWN(t, 72n+y), UR.RWN(t, 76n+y)]), List.append(&2, U32, F.limbs([UR.RWN(t, 80n+y), UR.RWN(t, 84n+y)]), List.append(&2, U32, [LB(t, 88n+y)], List.append(&2, U32, F.limbs([UR.RWN(t, 89n+y), UR.RWN(t, 93n+y)]), List.append(&2, U32, F.limbs([UR.RWN(t, 97n+y), UR.RWN(t, 101n+y)]), List.append(&2, U32, F.limbs([UR.RWN(t, 105n+y), UR.RWN(t, 109n+y)]), List.append(&2, U32, F.limbs([UR.RWN(t, 113n+y), UR.RWN(t, 117n+y)]), [])))))))), []) == List.append(&2, U32, F.limbs(UR.RWS(22n, t, y)), _) : +List<U32>}
  %Equal.sym(+List<U32>, UW.WX(t, a, 1n), [LB(t, a)], wx1(d, t, a, pf, FD.nat__le_trans(Nat.add(1n, a), Nat.add(121n, y), A.quad(VB.pw(d)), Order.left_below_sum(32n, y), hc))) :
    {List.append(&2, U32, List.append(&2, U32, F.limbs([UR.RWN(t, y), UR.RWN(t, 4n+y), UR.RWN(t, 8n+y), UR.RWN(t, 12n+y), UR.RWN(t, 16n+y), UR.RWN(t, 20n+y), UR.RWN(t, 24n+y), UR.RWN(t, 28n+y), UR.RWN(t, 32n+y), UR.RWN(t, 36n+y), UR.RWN(t, 40n+y), UR.RWN(t, 44n+y)]), List.append(&2, U32, F.limbs([UR.RWN(t, 48n+y), UR.RWN(t, 52n+y), UR.RWN(t, 56n+y), UR.RWN(t, 60n+y), UR.RWN(t, 64n+y), UR.RWN(t, 68n+y), UR.RWN(t, 72n+y), UR.RWN(t, 76n+y)]), List.append(&2, U32, F.limbs([UR.RWN(t, 80n+y), UR.RWN(t, 84n+y)]), List.append(&2, U32, [LB(t, 88n+y)], List.append(&2, U32, F.limbs([UR.RWN(t, 89n+y), UR.RWN(t, 93n+y)]), List.append(&2, U32, F.limbs([UR.RWN(t, 97n+y), UR.RWN(t, 101n+y)]), List.append(&2, U32, F.limbs([UR.RWN(t, 105n+y), UR.RWN(t, 109n+y)]), List.append(&2, U32, F.limbs([UR.RWN(t, 113n+y), UR.RWN(t, 117n+y)]), [])))))))), []) == List.append(&2, U32, F.limbs(UR.RWS(22n, t, y)), List.append(&2, U32, _, UW.WX(t, b, 32n))) : +List<U32>}
  %Equal.sym(+List<U32>, UW.WX(t, b, Nat.add(A.quad(8n), 0n)), List.append(&2, U32, F.limbs(UR.RWS(8n, t, b)), UW.WX(t, Nat.add(A.quad(8n), b), 0n)),
      UW.headWX(d, t, b, 8n, 0n, pf, FD.logic__subst(Nat, z => {Nat.is_le(z, A.quad(VB.pw(d))) == True{} : Bool}, Nat.add(32n, b), Nat.add(b, 32n), Equal.sym(Nat, Nat.add(b, 32n), Nat.add(32n, b), A.add_right(b, 32n)), hc))) :
    {List.append(&2, U32, List.append(&2, U32, F.limbs([UR.RWN(t, y), UR.RWN(t, 4n+y), UR.RWN(t, 8n+y), UR.RWN(t, 12n+y), UR.RWN(t, 16n+y), UR.RWN(t, 20n+y), UR.RWN(t, 24n+y), UR.RWN(t, 28n+y), UR.RWN(t, 32n+y), UR.RWN(t, 36n+y), UR.RWN(t, 40n+y), UR.RWN(t, 44n+y)]), List.append(&2, U32, F.limbs([UR.RWN(t, 48n+y), UR.RWN(t, 52n+y), UR.RWN(t, 56n+y), UR.RWN(t, 60n+y), UR.RWN(t, 64n+y), UR.RWN(t, 68n+y), UR.RWN(t, 72n+y), UR.RWN(t, 76n+y)]), List.append(&2, U32, F.limbs([UR.RWN(t, 80n+y), UR.RWN(t, 84n+y)]), List.append(&2, U32, [LB(t, 88n+y)], List.append(&2, U32, F.limbs([UR.RWN(t, 89n+y), UR.RWN(t, 93n+y)]), List.append(&2, U32, F.limbs([UR.RWN(t, 97n+y), UR.RWN(t, 101n+y)]), List.append(&2, U32, F.limbs([UR.RWN(t, 105n+y), UR.RWN(t, 109n+y)]), List.append(&2, U32, F.limbs([UR.RWN(t, 113n+y), UR.RWN(t, 117n+y)]), [])))))))), []) == List.append(&2, U32, F.limbs(UR.RWS(22n, t, y)), List.append(&2, U32, [LB(t, a)], _)) : +List<U32>}
  {==}

def ctl8(+t: FD.array__Tree<U32>, +y: Nat, +hc: {VCK(t, y) == True{} : Bool}) -> {Codec.parts(RCV8(t, y), RCS8()) == Some{RCP8(t, y)} : Maybe<&2, +List<S.Part>>}: {==}
def ctl7(+t: FD.array__Tree<U32>, +y: Nat, +hc: {VCK(t, y) == True{} : Bool}) -> {Codec.parts(RCV7(t, y), RCS7()) == Some{RCP7(t, y)} : Maybe<&2, +List<S.Part>>}:
  %Equal.sym(S.Value, RCV7(t, y), S.Items{S.UnsignedValue{P.UInt{UR.RWN(t, 113n+y), UR.RWN(t, 117n+y), 0, 0, 0, 0, 0, 0}}, RCV8(t, y)}, {==}) : {Codec.parts(_, RCS7()) == Some{RCP7(t, y)} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(S.Schema, RCS7(), S.Chain{S.Unsigned{P.U64{}}, RCS8()}, {==}) : {Codec.parts(S.Items{S.UnsignedValue{P.UInt{UR.RWN(t, 113n+y), UR.RWN(t, 117n+y), 0, 0, 0, 0, 0, 0}}, RCV8(t, y)}, _) == Some{RCP7(t, y)} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(+List<S.Part>, RCP7(t, y), Con{S.Fixed{F.limbs([UR.RWN(t, 113n+y), UR.RWN(t, 117n+y)])}, RCP8(t, y)}, {==}) : {Codec.parts(S.Items{S.UnsignedValue{P.UInt{UR.RWN(t, 113n+y), UR.RWN(t, 117n+y), 0, 0, 0, 0, 0, 0}}, RCV8(t, y)}, S.Chain{S.Unsigned{P.U64{}}, RCS8()}) == Some{_} : Maybe<&2, +List<S.Part>>}
  VS.chain_fixed(S.UnsignedValue{P.UInt{UR.RWN(t, 113n+y), UR.RWN(t, 117n+y), 0, 0, 0, 0, 0, 0}}, RCV8(t, y), S.Unsigned{P.U64{}}, RCS8(), F.limbs([UR.RWN(t, 113n+y), UR.RWN(t, 117n+y)]), RCP8(t, y), F.uint64_part(UR.RWN(t, 113n+y), UR.RWN(t, 117n+y)), ctl8(t, y, hc))
def ctl6(+t: FD.array__Tree<U32>, +y: Nat, +hc: {VCK(t, y) == True{} : Bool}) -> {Codec.parts(RCV6(t, y), RCS6()) == Some{RCP6(t, y)} : Maybe<&2, +List<S.Part>>}:
  %Equal.sym(S.Value, RCV6(t, y), S.Items{S.UnsignedValue{P.UInt{UR.RWN(t, 105n+y), UR.RWN(t, 109n+y), 0, 0, 0, 0, 0, 0}}, RCV7(t, y)}, {==}) : {Codec.parts(_, RCS6()) == Some{RCP6(t, y)} : Maybe<&2, +List<S.Part>>}
