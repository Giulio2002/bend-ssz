def allv(+t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32, +hchk: {CHKw(t, x, off, len) == True{} : Bool}) -> {ALLV(CC(len), 0n, t, x) == True{} : Bool}:
