def VALw(+t: FD.array__Tree<U32>, +x: Nat, +len: U32) -> S.Value: S.Sequence{RITEMS(CC(len), 0n, t, x)}

# The spec parts of the value: one variable part, the window's bytes.
def specwD(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +hw32: {Nat.is_lt(Nat.add(x, U32.to_nat(len)), FD.spec_common__pow2(32n)) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hchk: {CHKw(t, x, off, len) == True{} : Bool})
    -> {Codec.parts(VALw(t, x, len), Spec.Schema78()) == Some{[S.Variable{UW.WX(t, x, U32.to_nat(len))}]} : Maybe<&2, +List<S.Part>>}:
  +c = CC(len)
  +ec = ecw(len, hwh(t, x, off, len, hchk))
  +M = Nat.mul(c, 121n)
  +hL = FD.logic__subst(Nat, z => {Nat.is_le(z, A.quad(VB.pw(d))) == True{} : Bool}, Nat.add(x, U32.to_nat(len)), Nat.add(U32.to_nat(len), x), FD.nat__add_comm(x, U32.to_nat(len)), hw)
  +hLc = FD.logic__subst(Nat, z => {Nat.is_le(Nat.add(z, x), A.quad(VB.pw(d))) == True{} : Bool}, U32.to_nat(len), M, ec, hL)
  +hb = FD.logic__subst(Nat, z => {Nat.is_le(VRL.pos(z, 121n, x), A.quad(VB.pw(d))) == True{} : Bool}, c, Nat.add(c, 0n), Equal.sym(Nat, Nat.add(c, 0n), c, FD.nat__add_zero(c)), hLc)
  +fit = FD.logic__subst(Nat, z => {N.fits(4n, z) == True{} : Bool}, U32.to_nat(len), Nat.add(M, 0n), Equal.trans(Nat, U32.to_nat(len), M, Nat.add(M, 0n), ec, Equal.sym(Nat, Nat.add(M, 0n), M, FD.nat__add_zero(M))),
    VFT.fits4lt(U32.to_nat(len), VB.u32_lt(len)))
  %Equal.sym(Nat, Codec.count(RITEMS(c, 0n, t, x)), c, cnt_items(c, 0n, t, x)) :
    {Codec.require(Nat.is_le(_, Nat.mul(U32.to_nat(1073741824), 1024n)), Codec.aggregate(Codec.parts(RITEMS(c, 0n, t, x), S.Repeat{Spec.Schema58()}), None{})) == Some{[S.Variable{UW.WX(t, x, U32.to_nat(len))}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(Bool, Nat.is_le(c, Nat.mul(U32.to_nat(1073741824), 1024n)), True{}, V40.u32le40(NN(len))) :
    {Codec.require(_, Codec.aggregate(Codec.parts(RITEMS(c, 0n, t, x), S.Repeat{Spec.Schema58()}), None{})) == Some{[S.Variable{UW.WX(t, x, U32.to_nat(len))}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(Maybe<&2, +List<S.Part>>, Codec.parts(RITEMS(c, 0n, t, x), S.Repeat{Spec.Schema58()}), Some{RPARTS(c, 0n, t, x)}, prt_items(c, 0n, d, t, x, pf, hb, allv(t, x, off, len, hchk))) :
    {Codec.require(True{}, Codec.aggregate(_, None{})) == Some{[S.Variable{UW.WX(t, x, U32.to_nat(len))}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(Maybe<&2, +List<U32>>, Layout.encoding(RPARTS(c, 0n, t, x)), Some{List.append(&2, U32, FLAT(c, 0n, t, x), [])},
      VMV.enc_gen(RPARTS(c, 0n, t, x), M, FLAT(c, 0n, t, x), [], rp_size(c, 0n, d, t, x, pf, hb), rp_fp(c, 0n, t, x, M), rp_pay(c, 0n, t, x), rp_valid(c, 0n, t, x), fit)) :
    {Codec.one(_, None{}) == Some{[S.Variable{UW.WX(t, x, U32.to_nat(len))}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(+List<U32>, List.append(&2, U32, FLAT(c, 0n, t, x), []), FLAT(c, 0n, t, x), VS.app_nil(FLAT(c, 0n, t, x))) :
    {Codec.one(Some{_}, None{}) == Some{[S.Variable{UW.WX(t, x, U32.to_nat(len))}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(+List<U32>, FLAT(c, 0n, t, x), UW.WX(t, VRL.pos(0n, 121n, x), M), flat_wx(c, 0n, t, x)) :
    {Codec.one(Some{_}, None{}) == Some{[S.Variable{UW.WX(t, x, U32.to_nat(len))}]} : Maybe<&2, +List<S.Part>>}
  %ec : {Codec.one(Some{UW.WX(t, x, _)}, None{}) == Some{[S.Variable{UW.WX(t, x, U32.to_nat(len))}]} : Maybe<&2, +List<S.Part>>}
  {==}

# ---- the inversion: one record -------------------------------------------------------------------

def fixpay(ps: +List<S.Part>) -> +List<U32>:
  match ps:
    case Con{S.Fixed{+xs}, t}: xs
    case _: []

def fixed_inj(+a: +List<U32>, +b: +List<U32>, +e: {Some{[S.Fixed{a}]} == Some{[S.Fixed{b}]} : Maybe<&2, +List<S.Part>>}) -> {a == b : +List<U32>}:
