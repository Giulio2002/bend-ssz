  VS.chain_fixed(S.UnsignedValue{P.UInt{UR.RWN(t, 105n+y), UR.RWN(t, 109n+y), 0, 0, 0, 0, 0, 0}}, RCV7(t, y), S.Unsigned{P.U64{}}, RCS7(), F.limbs([UR.RWN(t, 105n+y), UR.RWN(t, 109n+y)]), RCP7(t, y), F.uint64_part(UR.RWN(t, 105n+y), UR.RWN(t, 109n+y)), ctl7(t, y, hc))
