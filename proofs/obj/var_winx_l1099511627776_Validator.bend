  VS.chain_fixed(S.BooleanValue{U32.is_eq(LB(t, 88n+y), 1)}, RCV4(t, y), S.Boolean{}, RCS4(), [LB(t, 88n+y)], RCP4(t, y), Equal.cong(+List<U32>, Maybe<&2, +List<S.Part>>, z => Some{[S.Fixed{z}]}, SP.boolean_encoding(U32.is_eq(LB(t, 88n+y), 1)), [LB(t, 88n+y)], b01(LB(t, 88n+y), hc)), ctl4(t, y, hc))
