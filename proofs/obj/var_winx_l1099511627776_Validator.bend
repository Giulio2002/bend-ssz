# ---- the list's checks ---------------------------------------------------------------------------

def vR() -> Word(31n): FD.spec_numeric__from_nat(31n, 121n)
def NN(+len: U32) -> U32: U32.div(len, 121)
def CC(+len: U32) -> Nat: U32.to_nat(NN(len))
def KK(+len: U32) -> Nat: U32.to_nat(U32.sub(NN(len), 1))

# The records j, j + 1, .. j + k pass, after acc (left to right, as the runtime's loop).
def CKA(k: Nat, +j: Nat, +acc: Bool, +t: FD.array__Tree<U32>, +x: Nat) -> Bool:
