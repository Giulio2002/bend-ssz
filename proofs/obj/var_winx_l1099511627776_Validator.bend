          FD.lru_nat_algebra__add_swap(VRL.pos(j, 121n, x), 121n, L2), Equal.sym(Nat, Nat.add(Nat.add(121n, VRL.pos(j, 121n, x)), L2), Nat.add(121n, Nat.add(VRL.pos(j, 121n, x), L2)), FD.nat__add_assoc(121n, VRL.pos(j, 121n, x), L2))), hb1)
