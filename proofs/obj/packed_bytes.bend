    case P.U8{}: {==}
    case P.U16{}: Empty.absurd({P.U16{} == P.U8{} : P.Width}, MD.false_true(e))
    case P.U32Width{}: Empty.absurd({P.U32Width{} == P.U8{} : P.Width}, MD.false_true(e))
    case P.U64{}: Empty.absurd({P.U64{} == P.U8{} : P.Width}, MD.false_true(e))
    case P.U128{}: Empty.absurd({P.U128{} == P.U8{} : P.Width}, MD.false_true(e))
    case P.U256{}: Empty.absurd({P.U256{} == P.U8{} : P.Width}, MD.false_true(e))

def ok_v1(+s: S.Schema, +depth: Nat) -> Bool:
  Bool.and(SH.is_Vector(s), Bool.and(SH.is_Unsigned(SH.Vector_element(s)), Bool.and(is_U8(SH.Unsigned_width(SH.Vector_element(s))), Lim.minimal(Nat.div(Nat.add(Nat.mul(SH.Vector_length(s), 1n), 31n), 32n), depth))))

# The storage bytes are bytes (the chunk scope of the storage).
def vscope(+N: U32, +q: Nat, +r: Nat, +dw: Nat, +t: F.array__Tree<U32>,
    +enq: {U32.to_nat(N) == Nat.add(WS.e32(q), r) : Nat},
    +h32: {Nat.is_le(r, 32n) == True{} : Bool},
    +pf: {F.array__perfect(U32, dw, t) == True{} : Bool},
    +room: {Nat.is_le(O.e8(1n+q), F.spec_common__pow2(dw)) == True{} : Bool})
    -> {SP.byte_scope(U32.to_nat(N), WS.btake(U32.to_nat(N), FX.limbs(F.array__slots(U32, t)))) == True{} : Bool}:
  %Equal.sym(Nat, U32.to_nat(N), Nat.add(WS.e32(q), r), enq) :
    {SP.byte_scope(_, WS.btake(_, FX.limbs(F.array__slots(U32, t)))) == True{} : Bool}
  WS.chunk_scope(q, r, F.array__slots(U32, t), 0n, h32, WR.cap_at(q, dw, t, pf, room))

def v1_lim(+N: U32, +q: Nat, +r: Nat, +L: Nat, +t: F.array__Tree<U32>,
    +enq: {U32.to_nat(N) == Nat.add(WS.e32(q), r) : Nat},
    +h1: {Nat.is_lt(0n, r) == True{} : Bool}, +h32: {Nat.is_le(r, 32n) == True{} : Bool},
    +hvN: {Nat.is_le(U32.to_nat(N), L) == True{} : Bool})
    -> {Nat.is_le(MD.dlen(MR.clist(1n+q, F.array__slots(U32, t), 0n)), Nat.div(Nat.add(Nat.mul(L, 1n), 31n), 32n)) == True{} : Bool}:
  +hm = UL.rw_le_r(U32.to_nat(N), L, Nat.mul(L, 1n), mul1(L), hvN)
  +hn = UL.rw_le_l(U32.to_nat(N), Nat.add(WS.e32(q), r), Nat.mul(L, 1n), enq, hm)
  LR.bl_hlen(q, t, Nat.mul(L, 1n), NF.chunk_le(q, r, Nat.mul(L, 1n), h1, h32, hn))

def v1_body(+hl: Nat, +ehl: {hl == 64n : Nat}, -o: O.Words, +L: Nat, +depth: Nat,
    +wf: WO.wf1(o),
    +hv: {Nat.is_eq(U32.to_nat(WO.len(o)), L) == True{} : Bool},
    +hmin: {Lim.minimal(Nat.div(Nat.add(Nat.mul(L, 1n), 31n), 32n), depth) == True{} : Bool},
    +hdep: {Nat.is_lt(depth, 64n) == True{} : Bool})
    -> RR.roots(LV.vview1(o), S.Vector{S.Unsigned{P.U8{}}, L}, [D.bytes(WO.wdig(hl, o, depth))]):
  (+t, w1) = wf
  (+dw, w2) = w1
  (+N, w3) = w2
  (+q, w4) = w3
  (+r, w5) = w4
  (+eo, w6) = w5
  (+pf, w7) = w6
  (+hd, w8) = w7
  (+enq, w9) = w8
  (+h1, w10) = w9
  (+h32, w11) = w10
  (+room, +slack) = w11
  +hvN = PK.eq_le(U32.to_nat(N), L, WO.eq_len(o, t, N, L, eo, hv))
  +sc = vscope(N, q, r, dw, t, enq, h32, pf, room)
  %Equal.sym(O.Words, o, O.Words{F.array__thaw(U32, t), N}, eo) :
    RR.roots(LV.vview1(_), S.Vector{S.Unsigned{P.U8{}}, L}, [D.bytes(WO.wdig(hl, _, depth))])
  %Equal.sym(F.array__Tree<U32>, F.array__freeze(U32, F.array__thaw(U32, t)), t, F.array__freeze_thaw(U32, t)) :
    RR.roots(S.Sequence{LV.it1(U32.to_nat(N), WS.btake(U32.to_nat(N), FX.limbs(F.array__slots(U32, _))))}, S.Vector{S.Unsigned{P.U8{}}, L}, [D.bytes(MD.rtree(depth, Nat.is_lt(0n, O.chunks_of(N)), hl, MR.clist(O.chunks_of(N), F.array__slots(U32, _), 0n), 0n))])
  %Equal.sym(Nat, O.chunks_of(N), 1n+q, WO.chunks_q(N, q, r, enq, h1, h32)) :
    RR.roots(S.Sequence{LV.it1(U32.to_nat(N), WS.btake(U32.to_nat(N), FX.limbs(F.array__slots(U32, t))))}, S.Vector{S.Unsigned{P.U8{}}, L}, [D.bytes(MD.rtree(depth, Nat.is_lt(0n, _), hl, MR.clist(_, F.array__slots(U32, t), 0n), 0n))])
  (MD.bytes_list(MR.clist(1n+q, F.array__slots(U32, t), 0n)),
    ((WS.btake(U32.to_nat(N), FX.limbs(F.array__slots(U32, t))), (pb1(U32.to_nat(N), WS.btake(U32.to_nat(N), FX.limbs(F.array__slots(U32, t))), sc), UL.ul_pack(N, q, r, dw, t, enq, h1, h32, pf, room, slack))),
     (D.bytes(MD.rtree(depth, True{}, hl, MR.clist(1n+q, F.array__slots(U32, t), 0n), 0n)),
      ((depth, (hmin, RS.at_depth_tree(Nat.div(Nat.add(Nat.mul(L, 1n), 31n), 32n), depth, hl, MR.clist(1n+q, F.array__slots(U32, t), 0n), hdep, v1_lim(N, q, r, L, t, enq, h1, h32, hvN), ehl))),
       {==}))))

def v1_rs(+hl: Nat, +ehl: {hl == 64n : Nat}, -o: O.Words, +s: S.Schema, +depth: Nat,
    +rep: LV.rep_v1(o, s),
    +ok: {ok_v1(s, depth) == True{} : Bool},
    +hdep: {Nat.is_lt(depth, 64n) == True{} : Bool})
    -> RR.roots(LV.vview1(o), s, [D.bytes(WO.wdig(hl, o, depth))]):
  (+wf, +hq) = rep
  +c0 = DK.and_l(SH.is_Vector(s), Bool.and(SH.is_Unsigned(SH.Vector_element(s)), Bool.and(is_U8(SH.Unsigned_width(SH.Vector_element(s))), Lim.minimal(Nat.div(Nat.add(Nat.mul(SH.Vector_length(s), 1n), 31n), 32n), depth))), ok)
  +k1 = DK.and_r(SH.is_Vector(s), Bool.and(SH.is_Unsigned(SH.Vector_element(s)), Bool.and(is_U8(SH.Unsigned_width(SH.Vector_element(s))), Lim.minimal(Nat.div(Nat.add(Nat.mul(SH.Vector_length(s), 1n), 31n), 32n), depth))), ok)
  +c1 = DK.and_l(SH.is_Unsigned(SH.Vector_element(s)), Bool.and(is_U8(SH.Unsigned_width(SH.Vector_element(s))), Lim.minimal(Nat.div(Nat.add(Nat.mul(SH.Vector_length(s), 1n), 31n), 32n), depth)), k1)
  +k2 = DK.and_r(SH.is_Unsigned(SH.Vector_element(s)), Bool.and(is_U8(SH.Unsigned_width(SH.Vector_element(s))), Lim.minimal(Nat.div(Nat.add(Nat.mul(SH.Vector_length(s), 1n), 31n), 32n), depth)), k1)
  +c2 = DK.and_l(is_U8(SH.Unsigned_width(SH.Vector_element(s))), Lim.minimal(Nat.div(Nat.add(Nat.mul(SH.Vector_length(s), 1n), 31n), 32n), depth), k2)
  +c3 = DK.and_r(is_U8(SH.Unsigned_width(SH.Vector_element(s))), Lim.minimal(Nat.div(Nat.add(Nat.mul(SH.Vector_length(s), 1n), 31n), 32n), depth), k2)
  %Equal.sym(S.Schema, s, S.Vector{SH.Vector_element(s), SH.Vector_length(s)}, SH.Vector_shape(s, c0)) :
    RR.roots(LV.vview1(o), _, [D.bytes(WO.wdig(hl, o, depth))])
  %Equal.sym(S.Schema, SH.Vector_element(s), S.Unsigned{SH.Unsigned_width(SH.Vector_element(s))}, SH.Unsigned_shape(SH.Vector_element(s), c1)) :
    RR.roots(LV.vview1(o), S.Vector{_, SH.Vector_length(s)}, [D.bytes(WO.wdig(hl, o, depth))])
  %Equal.sym(P.Width, SH.Unsigned_width(SH.Vector_element(s)), P.U8{}, is_U8_shape(SH.Unsigned_width(SH.Vector_element(s)), c2)) :
    RR.roots(LV.vview1(o), S.Vector{S.Unsigned{_}, SH.Vector_length(s)}, [D.bytes(WO.wdig(hl, o, depth))])
  v1_body(hl, ehl, o, SH.Vector_length(s), depth, wf, hq, c3, hdep)

# ---- boolean: one byte per element ----------------------------------------

law pbb:
  for +k: Nat
  for +xs: +List<U32>
  for +hs: {LV.bscope(k, xs) == True{} : Bool}
  {RR.basic_bytes(LV.itb(k, xs), S.Boolean{}) == Some{xs} : Maybe<&2, +List<U32>>}
def pbb(k, xs, hs):
  match k:
    case 0n:
      match xs:
        case Nil{}: {==}
        case Con{+h, +t}: Empty.absurd({RR.basic_bytes(LV.itb(0n, Con{h, t}), S.Boolean{}) == Some{Con{h, t}} : Maybe<&2, +List<U32>>}, MD.false_true(hs))
    case 1n+ +c:
      match xs:
        case Nil{}: Empty.absurd({RR.basic_bytes(LV.itb(1n+c, Nil{}), S.Boolean{}) == Some{Nil{}} : Maybe<&2, +List<U32>>}, MD.false_true(hs))
        case Con{+h, +t}:
