          +ht = V.and_right(U32.is_lt(h, 2), LV.bscope(c, t), hs)
          %Equal.sym(Maybe<&2, +List<U32>>, RR.basic_one(S.BooleanValue{U32.is_eq(h, 1)}, S.Boolean{}), Some{[h]}, bbool(h, hh)) :
            {RR.join(_, RR.basic_bytes(LV.itb(c, t), S.Boolean{})) == Some{Con{h, t}} : Maybe<&2, +List<U32>>}
          %Equal.sym(Maybe<&2, +List<U32>>, RR.basic_bytes(LV.itb(c, t), S.Boolean{}), Some{t}, pbb(c, t, ht)) :
            {RR.join(Some{[h]}, _) == Some{Con{h, t}} : Maybe<&2, +List<U32>>}
          {==}

def rep_wfb(-o: O.Words, +s: S.Schema, +rep: LV.rep_vb(o, s)) -> WO.wf1(o):
  (+wf, +r) = rep
  wf

def ok_vb(+s: S.Schema, +depth: Nat) -> Bool:
  Bool.and(SH.is_Vector(s), Bool.and(SH.is_Boolean(SH.Vector_element(s)), Lim.minimal(Nat.div(Nat.add(Nat.mul(SH.Vector_length(s), 1n), 31n), 32n), depth)))

# The boolean fact about the object, about its destructured storage.
def bsc(-o: O.Words, +t: F.array__Tree<U32>, +N: U32, +eo: {o == O.Words{F.array__thaw(U32, t), N} : O.Words},
    +hb: {LV.bscope(U32.to_nat(WO.len(o)), WO.wview(o)) == True{} : Bool})
    -> {LV.bscope(U32.to_nat(N), WS.btake(U32.to_nat(N), FX.limbs(F.array__slots(U32, t)))) == True{} : Bool}:
  %F.array__freeze_thaw(U32, t) :
    {LV.bscope(U32.to_nat(N), WS.btake(U32.to_nat(N), FX.limbs(F.array__slots(U32, _)))) == True{} : Bool}
  %Equal.cong(O.Words, Bool, x => LV.bscope(U32.to_nat(WO.len(x)), WO.wview(x)), o, O.Words{F.array__thaw(U32, t), N}, eo) : {_ == True{} : Bool}
  hb

def vb_lim(+N: U32, +q: Nat, +r: Nat, +L: Nat, +t: F.array__Tree<U32>,
    +enq: {U32.to_nat(N) == Nat.add(WS.e32(q), r) : Nat},
    +h1: {Nat.is_lt(0n, r) == True{} : Bool}, +h32: {Nat.is_le(r, 32n) == True{} : Bool},
    +hvN: {Nat.is_le(U32.to_nat(N), L) == True{} : Bool})
    -> {Nat.is_le(MD.dlen(MR.clist(1n+q, F.array__slots(U32, t), 0n)), Nat.div(Nat.add(Nat.mul(L, 1n), 31n), 32n)) == True{} : Bool}:
  +hm = UL.rw_le_r(U32.to_nat(N), L, Nat.mul(L, 1n), mul1(L), hvN)
  +hn = UL.rw_le_l(U32.to_nat(N), Nat.add(WS.e32(q), r), Nat.mul(L, 1n), enq, hm)
  LR.bl_hlen(q, t, Nat.mul(L, 1n), NF.chunk_le(q, r, Nat.mul(L, 1n), h1, h32, hn))

def vb_body(+hl: Nat, +ehl: {hl == 64n : Nat}, -o: O.Words, +L: Nat, +depth: Nat,
    +wf: WO.wf1(o),
    +hv: {Nat.is_eq(U32.to_nat(WO.len(o)), L) == True{} : Bool},
    +hb: {LV.bscope(U32.to_nat(WO.len(o)), WO.wview(o)) == True{} : Bool},
    +hmin: {Lim.minimal(Nat.div(Nat.add(Nat.mul(L, 1n), 31n), 32n), depth) == True{} : Bool},
    +hdep: {Nat.is_lt(depth, 64n) == True{} : Bool})
    -> RR.roots(LV.vviewb(o), S.Vector{S.Boolean{}, L}, [D.bytes(WO.wdig(hl, o, depth))]):
  (+t, w1) = wf
  (+dw, w2) = w1
  (+N, w3) = w2
  (+q, w4) = w3
  (+r, w5) = w4
  (+eo, w6) = w5
  (+pf, w7) = w6
  (+hd, w8) = w7
  (+enq, w9) = w8
  (+h1, w10) = w9
  (+h32, w11) = w10
  (+room, +slack) = w11
  +hvN = PK.eq_le(U32.to_nat(N), L, WO.eq_len(o, t, N, L, eo, hv))
  +sc = bsc(o, t, N, eo, hb)
  %Equal.sym(O.Words, o, O.Words{F.array__thaw(U32, t), N}, eo) :
    RR.roots(LV.vviewb(_), S.Vector{S.Boolean{}, L}, [D.bytes(WO.wdig(hl, _, depth))])
  %Equal.sym(F.array__Tree<U32>, F.array__freeze(U32, F.array__thaw(U32, t)), t, F.array__freeze_thaw(U32, t)) :
    RR.roots(S.Sequence{LV.itb(U32.to_nat(N), WS.btake(U32.to_nat(N), FX.limbs(F.array__slots(U32, _))))}, S.Vector{S.Boolean{}, L}, [D.bytes(MD.rtree(depth, Nat.is_lt(0n, O.chunks_of(N)), hl, MR.clist(O.chunks_of(N), F.array__slots(U32, _), 0n), 0n))])
  %Equal.sym(Nat, O.chunks_of(N), 1n+q, WO.chunks_q(N, q, r, enq, h1, h32)) :
    RR.roots(S.Sequence{LV.itb(U32.to_nat(N), WS.btake(U32.to_nat(N), FX.limbs(F.array__slots(U32, t))))}, S.Vector{S.Boolean{}, L}, [D.bytes(MD.rtree(depth, Nat.is_lt(0n, _), hl, MR.clist(_, F.array__slots(U32, t), 0n), 0n))])
  (MD.bytes_list(MR.clist(1n+q, F.array__slots(U32, t), 0n)),
    ((WS.btake(U32.to_nat(N), FX.limbs(F.array__slots(U32, t))), (pbb(U32.to_nat(N), WS.btake(U32.to_nat(N), FX.limbs(F.array__slots(U32, t))), sc), UL.ul_pack(N, q, r, dw, t, enq, h1, h32, pf, room, slack))),
     (D.bytes(MD.rtree(depth, True{}, hl, MR.clist(1n+q, F.array__slots(U32, t), 0n), 0n)),
      ((depth, (hmin, RS.at_depth_tree(Nat.div(Nat.add(Nat.mul(L, 1n), 31n), 32n), depth, hl, MR.clist(1n+q, F.array__slots(U32, t), 0n), hdep, vb_lim(N, q, r, L, t, enq, h1, h32, hvN), ehl))),
       {==}))))

def vb_rs(+hl: Nat, +ehl: {hl == 64n : Nat}, -o: O.Words, +s: S.Schema, +depth: Nat,
    +rep: LV.rep_vb(o, s),
    +ok: {ok_vb(s, depth) == True{} : Bool},
    +hdep: {Nat.is_lt(depth, 64n) == True{} : Bool})
    -> RR.roots(LV.vviewb(o), s, [D.bytes(WO.wdig(hl, o, depth))]):
  (+wf, +r1) = rep
  (+hq, +hb) = r1
  +c0 = DK.and_l(SH.is_Vector(s), Bool.and(SH.is_Boolean(SH.Vector_element(s)), Lim.minimal(Nat.div(Nat.add(Nat.mul(SH.Vector_length(s), 1n), 31n), 32n), depth)), ok)
  +k1 = DK.and_r(SH.is_Vector(s), Bool.and(SH.is_Boolean(SH.Vector_element(s)), Lim.minimal(Nat.div(Nat.add(Nat.mul(SH.Vector_length(s), 1n), 31n), 32n), depth)), ok)
  +c1 = DK.and_l(SH.is_Boolean(SH.Vector_element(s)), Lim.minimal(Nat.div(Nat.add(Nat.mul(SH.Vector_length(s), 1n), 31n), 32n), depth), k1)
  +c3 = DK.and_r(SH.is_Boolean(SH.Vector_element(s)), Lim.minimal(Nat.div(Nat.add(Nat.mul(SH.Vector_length(s), 1n), 31n), 32n), depth), k1)
  %Equal.sym(S.Schema, s, S.Vector{SH.Vector_element(s), SH.Vector_length(s)}, SH.Vector_shape(s, c0)) :
    RR.roots(LV.vviewb(o), _, [D.bytes(WO.wdig(hl, o, depth))])
  %Equal.sym(S.Schema, SH.Vector_element(s), S.Boolean{}, SH.Boolean_shape(SH.Vector_element(s), c1)) :
    RR.roots(LV.vviewb(o), S.Vector{_, SH.Vector_length(s)}, [D.bytes(WO.wdig(hl, o, depth))])
  vb_body(hl, ehl, o, SH.Vector_length(s), depth, wf, hq, hb, c3, hdep)

# ---- uint16: two bytes per element ----------------------------------------

law two8:
  for +t0: Word(8n)
  for +t1: Word(8n)
  {RR.basic_one(S.UnsignedValue{P.UInt{LV.v16of(PD.embed8(t0), PD.embed8(t1)), 0, 0, 0, 0, 0, 0, 0}}, S.Unsigned{P.U16{}}) == Some{[PD.embed8(t0), PD.embed8(t1)]} : Maybe<&2, +List<U32>>}
def two8(t0, t1):
  match t0 t1:
    case WCon{+a0, WCon{+a1, WCon{+a2, WCon{+a3, WCon{+a4, WCon{+a5, WCon{+a6, WCon{+a7, WNil{}}}}}}}}} WCon{+b0, WCon{+b1, WCon{+b2, WCon{+b3, WCon{+b4, WCon{+b5, WCon{+b6, WCon{+b7, WNil{}}}}}}}}}:
      %IE.limb_correct(U32{WSp.join(8n, 24n, WCon{a0, WCon{a1, WCon{a2, WCon{a3, WCon{a4, WCon{a5, WCon{a6, WCon{a7, WNil{}}}}}}}}}, WSp.join(8n, 16n, WCon{b0, WCon{b1, WCon{b2, WCon{b3, WCon{b4, WCon{b5, WCon{b6, WCon{b7, WNil{}}}}}}}}}, Word.zero(16n)))}) :
        {SP.optional(SP.fits(2n, List.append(&2, U32, _, List.append(&2, U32, SP.limb_digits(0), List.append(&2, U32, SP.limb_digits(0), List.append(&2, U32, SP.limb_digits(0), List.append(&2, U32, SP.limb_digits(0), List.append(&2, U32, SP.limb_digits(0), List.append(&2, U32, SP.limb_digits(0), SP.limb_digits(0))))))))), SP.prefix(2n, List.append(&2, U32, _, List.append(&2, U32, SP.limb_digits(0), List.append(&2, U32, SP.limb_digits(0), List.append(&2, U32, SP.limb_digits(0), List.append(&2, U32, SP.limb_digits(0), List.append(&2, U32, SP.limb_digits(0), List.append(&2, U32, SP.limb_digits(0), SP.limb_digits(0)))))))))) == Some{[PD.embed8(WCon{a0, WCon{a1, WCon{a2, WCon{a3, WCon{a4, WCon{a5, WCon{a6, WCon{a7, WNil{}}}}}}}}}), PD.embed8(WCon{b0, WCon{b1, WCon{b2, WCon{b3, WCon{b4, WCon{b5, WCon{b6, WCon{b7, WNil{}}}}}}}}})]} : Maybe<&2, +List<U32>>}
      %Equal.sym(Bool, Bool.and(a0, True{}), a0, andt(a0)) :
        {Some{[U32{WCon{_, WCon{Bool.and(a1, True{}), WCon{Bool.and(a2, True{}), WCon{Bool.and(a3, True{}), WCon{Bool.and(a4, True{}), WCon{Bool.and(a5, True{}), WCon{Bool.and(a6, True{}), WCon{Bool.and(a7, True{}), WCon{Bool.and(b0, False{}), WCon{Bool.and(b1, False{}), WCon{Bool.and(b2, False{}), WCon{Bool.and(b3, False{}), WCon{Bool.and(b4, False{}), WCon{Bool.and(b5, False{}), WCon{Bool.and(b6, False{}), WCon{Bool.and(b7, False{}), Word.zero(16n)}}}}}}}}}}}}}}}}}, U32{WCon{Bool.and(b0, True{}), WCon{Bool.and(b1, True{}), WCon{Bool.and(b2, True{}), WCon{Bool.and(b3, True{}), WCon{Bool.and(b4, True{}), WCon{Bool.and(b5, True{}), WCon{Bool.and(b6, True{}), WCon{Bool.and(b7, True{}), Word.zero(24n)}}}}}}}}}]} == Some{[PD.embed8(WCon{a0, WCon{a1, WCon{a2, WCon{a3, WCon{a4, WCon{a5, WCon{a6, WCon{a7, WNil{}}}}}}}}}), PD.embed8(WCon{b0, WCon{b1, WCon{b2, WCon{b3, WCon{b4, WCon{b5, WCon{b6, WCon{b7, WNil{}}}}}}}}})]} : Maybe<&2, +List<U32>>}
      %Equal.sym(Bool, Bool.and(a1, True{}), a1, andt(a1)) :
        {Some{[U32{WCon{a0, WCon{_, WCon{Bool.and(a2, True{}), WCon{Bool.and(a3, True{}), WCon{Bool.and(a4, True{}), WCon{Bool.and(a5, True{}), WCon{Bool.and(a6, True{}), WCon{Bool.and(a7, True{}), WCon{Bool.and(b0, False{}), WCon{Bool.and(b1, False{}), WCon{Bool.and(b2, False{}), WCon{Bool.and(b3, False{}), WCon{Bool.and(b4, False{}), WCon{Bool.and(b5, False{}), WCon{Bool.and(b6, False{}), WCon{Bool.and(b7, False{}), Word.zero(16n)}}}}}}}}}}}}}}}}}, U32{WCon{Bool.and(b0, True{}), WCon{Bool.and(b1, True{}), WCon{Bool.and(b2, True{}), WCon{Bool.and(b3, True{}), WCon{Bool.and(b4, True{}), WCon{Bool.and(b5, True{}), WCon{Bool.and(b6, True{}), WCon{Bool.and(b7, True{}), Word.zero(24n)}}}}}}}}}]} == Some{[PD.embed8(WCon{a0, WCon{a1, WCon{a2, WCon{a3, WCon{a4, WCon{a5, WCon{a6, WCon{a7, WNil{}}}}}}}}}), PD.embed8(WCon{b0, WCon{b1, WCon{b2, WCon{b3, WCon{b4, WCon{b5, WCon{b6, WCon{b7, WNil{}}}}}}}}})]} : Maybe<&2, +List<U32>>}
      %Equal.sym(Bool, Bool.and(a2, True{}), a2, andt(a2)) :
        {Some{[U32{WCon{a0, WCon{a1, WCon{_, WCon{Bool.and(a3, True{}), WCon{Bool.and(a4, True{}), WCon{Bool.and(a5, True{}), WCon{Bool.and(a6, True{}), WCon{Bool.and(a7, True{}), WCon{Bool.and(b0, False{}), WCon{Bool.and(b1, False{}), WCon{Bool.and(b2, False{}), WCon{Bool.and(b3, False{}), WCon{Bool.and(b4, False{}), WCon{Bool.and(b5, False{}), WCon{Bool.and(b6, False{}), WCon{Bool.and(b7, False{}), Word.zero(16n)}}}}}}}}}}}}}}}}}, U32{WCon{Bool.and(b0, True{}), WCon{Bool.and(b1, True{}), WCon{Bool.and(b2, True{}), WCon{Bool.and(b3, True{}), WCon{Bool.and(b4, True{}), WCon{Bool.and(b5, True{}), WCon{Bool.and(b6, True{}), WCon{Bool.and(b7, True{}), Word.zero(24n)}}}}}}}}}]} == Some{[PD.embed8(WCon{a0, WCon{a1, WCon{a2, WCon{a3, WCon{a4, WCon{a5, WCon{a6, WCon{a7, WNil{}}}}}}}}}), PD.embed8(WCon{b0, WCon{b1, WCon{b2, WCon{b3, WCon{b4, WCon{b5, WCon{b6, WCon{b7, WNil{}}}}}}}}})]} : Maybe<&2, +List<U32>>}
