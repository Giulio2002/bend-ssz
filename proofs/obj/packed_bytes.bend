law two:
  for +x0: U32
  for +x1: U32
  for +e0: {U32.is_lt(x0, 256) == True{} : Bool}
  for +e1: {U32.is_lt(x1, 256) == True{} : Bool}
  {RR.basic_one(S.UnsignedValue{P.UInt{LV.v16of(x0, x1), 0, 0, 0, 0, 0, 0, 0}}, S.Unsigned{P.U16{}}) == Some{[x0, x1]} : Maybe<&2, +List<U32>>}
def two(x0, x1, e0, e1):
  %Equal.sym(U32, x0, PD.embed8(WSp.take(8n, 32n, PD.bits(x0))), ID.byte_shape(x0, e0)) :
    {RR.basic_one(S.UnsignedValue{P.UInt{LV.v16of(_, x1), 0, 0, 0, 0, 0, 0, 0}}, S.Unsigned{P.U16{}}) == Some{[_, x1]} : Maybe<&2, +List<U32>>}
  %Equal.sym(U32, x1, PD.embed8(WSp.take(8n, 32n, PD.bits(x1))), ID.byte_shape(x1, e1)) :
    {RR.basic_one(S.UnsignedValue{P.UInt{LV.v16of(PD.embed8(WSp.take(8n, 32n, PD.bits(x0))), _), 0, 0, 0, 0, 0, 0, 0}}, S.Unsigned{P.U16{}}) == Some{[PD.embed8(WSp.take(8n, 32n, PD.bits(x0))), _]} : Maybe<&2, +List<U32>>}
  two8(WSp.take(8n, 32n, PD.bits(x0)), WSp.take(8n, 32n, PD.bits(x1)))

law pb2:
  for +k: Nat
  for +xs: +List<U32>
  for +hs: {SP.byte_scope(Nat.double(k), xs) == True{} : Bool}
  {RR.basic_bytes(LV.it2(k, xs), S.Unsigned{P.U16{}}) == Some{xs} : Maybe<&2, +List<U32>>}
def pb2(k, xs, hs):
  match k:
    case 0n:
      match xs:
        case Nil{}: {==}
        case Con{+h, +t}: Empty.absurd({RR.basic_bytes(LV.it2(0n, Con{h, t}), S.Unsigned{P.U16{}}) == Some{Con{h, t}} : Maybe<&2, +List<U32>>}, MD.false_true(hs))
    case 1n+ +c:
      match xs:
        case Nil{}: Empty.absurd({RR.basic_bytes(LV.it2(1n+c, Nil{}), S.Unsigned{P.U16{}}) == Some{Nil{}} : Maybe<&2, +List<U32>>}, MD.false_true(hs))
        case Con{+x0, +t}:
          match t:
            case Nil{}: Empty.absurd({RR.basic_bytes(LV.it2(1n+c, Con{x0, Nil{}}), S.Unsigned{P.U16{}}) == Some{Con{x0, Nil{}}} : Maybe<&2, +List<U32>>}, MD.false_true(V.and_right(U32.is_lt(x0, 256), False{}, hs)))
            case Con{+x1, +rest}:
              +e0 = V.and_left(U32.is_lt(x0, 256), Bool.and(U32.is_lt(x1, 256), SP.byte_scope(Nat.double(c), rest)), hs)
              +k1 = V.and_right(U32.is_lt(x0, 256), Bool.and(U32.is_lt(x1, 256), SP.byte_scope(Nat.double(c), rest)), hs)
              +e1 = V.and_left(U32.is_lt(x1, 256), SP.byte_scope(Nat.double(c), rest), k1)
              +hr = V.and_right(U32.is_lt(x1, 256), SP.byte_scope(Nat.double(c), rest), k1)
              %Equal.sym(Maybe<&2, +List<U32>>, RR.basic_one(S.UnsignedValue{P.UInt{LV.v16of(x0, x1), 0, 0, 0, 0, 0, 0, 0}}, S.Unsigned{P.U16{}}), Some{[x0, x1]}, two(x0, x1, e0, e1)) :
                {RR.join(_, RR.basic_bytes(LV.it2(c, rest), S.Unsigned{P.U16{}})) == Some{Con{x0, Con{x1, rest}}} : Maybe<&2, +List<U32>>}
              %Equal.sym(Maybe<&2, +List<U32>>, RR.basic_bytes(LV.it2(c, rest), S.Unsigned{P.U16{}}), Some{rest}, pb2(c, rest, hr)) :
                {RR.join(Some{[x0, x1]}, _) == Some{Con{x0, Con{x1, rest}}} : Maybe<&2, +List<U32>>}
              {==}

def rep_wf2(-o: O.Words, +s: S.Schema, +rep: LV.rep_v2(o, s)) -> WO.wf1(o):
  (+wf, +r) = rep
  wf

def is_U16(w: P.Width) -> Bool:
  match w:
    case P.U16{}: True{}
    case _: False{}

law is_U16_shape:
  for +w: P.Width
  for +e: {is_U16(w) == True{} : Bool}
  {w == P.U16{} : P.Width}
def is_U16_shape(w, e):
  match w:
    case P.U8{}: Empty.absurd({P.U8{} == P.U16{} : P.Width}, MD.false_true(e))
    case P.U16{}: {==}
    case P.U32Width{}: Empty.absurd({P.U32Width{} == P.U16{} : P.Width}, MD.false_true(e))
    case P.U64{}: Empty.absurd({P.U64{} == P.U16{} : P.Width}, MD.false_true(e))
    case P.U128{}: Empty.absurd({P.U128{} == P.U16{} : P.Width}, MD.false_true(e))
    case P.U256{}: Empty.absurd({P.U256{} == P.U16{} : P.Width}, MD.false_true(e))

def ok_v2(+s: S.Schema, +depth: Nat) -> Bool:
  Bool.and(SH.is_Vector(s), Bool.and(SH.is_Unsigned(SH.Vector_element(s)), Bool.and(is_U16(SH.Unsigned_width(SH.Vector_element(s))), Lim.minimal(Nat.div(Nat.add(Nat.mul(SH.Vector_length(s), 2n), 31n), 32n), depth))))

law dbl_mul:
  for +L: Nat
  {Nat.double(L) == Nat.mul(L, 2n) : Nat}
def dbl_mul(L):
  match L:
    case 0n: {==}
    case 1n+ +p:
      %Equal.sym(Nat, Nat.double(p), Nat.mul(p, 2n), dbl_mul(p)) : {2n+_ == Nat.add(2n, Nat.mul(p, 2n)) : Nat}
      {==}

def eq_n2(-o: O.Words, +t: F.array__Tree<U32>, +N: U32, +eo: {o == O.Words{F.array__thaw(U32, t), N} : O.Words},
    +eN: {U32.to_nat(WO.len(o)) == Nat.double(LV.cnt2(o)) : Nat}) -> {U32.to_nat(N) == Nat.double(U32.to_nat(U32.shrn(N, 1n))) : Nat}:
  %Equal.cong(O.Words, U32, WO.len, o, O.Words{F.array__thaw(U32, t), N}, eo) : {U32.to_nat(_) == Nat.double(U32.to_nat(U32.shrn(_, 1n))) : Nat}
  eN

def eqn_n2(-o: O.Words, +t: F.array__Tree<U32>, +N: U32, +L: Nat, +eo: {o == O.Words{F.array__thaw(U32, t), N} : O.Words},
    +hv: {Nat.is_eq(LV.cnt2(o), L) == True{} : Bool}) -> {Nat.is_eq(U32.to_nat(U32.shrn(N, 1n)), L) == True{} : Bool}:
  %Equal.cong(O.Words, U32, WO.len, o, O.Words{F.array__thaw(U32, t), N}, eo) : {Nat.is_eq(U32.to_nat(U32.shrn(_, 1n)), L) == True{} : Bool}
  hv

def v2_scope(+N: U32, +q: Nat, +r: Nat, +dw: Nat, +t: F.array__Tree<U32>,
    +eNN: {U32.to_nat(N) == Nat.double(U32.to_nat(U32.shrn(N, 1n))) : Nat},
    +enq: {U32.to_nat(N) == Nat.add(WS.e32(q), r) : Nat},
    +h32: {Nat.is_le(r, 32n) == True{} : Bool},
    +pf: {F.array__perfect(U32, dw, t) == True{} : Bool},
    +room: {Nat.is_le(O.e8(1n+q), F.spec_common__pow2(dw)) == True{} : Bool})
    -> {SP.byte_scope(Nat.double(U32.to_nat(U32.shrn(N, 1n))), WS.btake(U32.to_nat(N), FX.limbs(F.array__slots(U32, t)))) == True{} : Bool}:
  %eNN : {SP.byte_scope(_, WS.btake(U32.to_nat(N), FX.limbs(F.array__slots(U32, t)))) == True{} : Bool}
  vscope(N, q, r, dw, t, enq, h32, pf, room)

def v2_enc(+N: U32, +q: Nat, +r: Nat, +dw: Nat, +t: F.array__Tree<U32>,
    +eNN: {U32.to_nat(N) == Nat.double(U32.to_nat(U32.shrn(N, 1n))) : Nat},
    +enq: {U32.to_nat(N) == Nat.add(WS.e32(q), r) : Nat},
    +h32: {Nat.is_le(r, 32n) == True{} : Bool},
    +pf: {F.array__perfect(U32, dw, t) == True{} : Bool},
    +room: {Nat.is_le(O.e8(1n+q), F.spec_common__pow2(dw)) == True{} : Bool})
    -> {RR.basic_bytes(LV.it2(U32.to_nat(U32.shrn(N, 1n)), WS.btake(U32.to_nat(N), FX.limbs(F.array__slots(U32, t)))), S.Unsigned{P.U16{}}) == Some{WS.btake(U32.to_nat(N), FX.limbs(F.array__slots(U32, t)))} : Maybe<&2, +List<U32>>}:
  pb2(U32.to_nat(U32.shrn(N, 1n)), WS.btake(U32.to_nat(N), FX.limbs(F.array__slots(U32, t))), v2_scope(N, q, r, dw, t, eNN, enq, h32, pf, room))

def v2_lim(+N: U32, +q: Nat, +r: Nat, +L: Nat, +t: F.array__Tree<U32>,
    +eNN: {U32.to_nat(N) == Nat.double(U32.to_nat(U32.shrn(N, 1n))) : Nat},
    +enq: {U32.to_nat(N) == Nat.add(WS.e32(q), r) : Nat},
    +h1: {Nat.is_lt(0n, r) == True{} : Bool}, +h32: {Nat.is_le(r, 32n) == True{} : Bool},
    +hvN: {Nat.is_le(U32.to_nat(U32.shrn(N, 1n)), L) == True{} : Bool})
    -> {Nat.is_le(MD.dlen(MR.clist(1n+q, F.array__slots(U32, t), 0n)), Nat.div(Nat.add(Nat.mul(L, 2n), 31n), 32n)) == True{} : Bool}:
  +hd = Order.double_monotone(U32.to_nat(U32.shrn(N, 1n)), L, hvN)
  +hm = UL.rw_le_r(Nat.double(U32.to_nat(U32.shrn(N, 1n))), Nat.double(L), Nat.mul(L, 2n), dbl_mul(L), hd)
  +hN = UL.rw_le_l(Nat.double(U32.to_nat(U32.shrn(N, 1n))), U32.to_nat(N), Nat.mul(L, 2n), Equal.sym(Nat, U32.to_nat(N), Nat.double(U32.to_nat(U32.shrn(N, 1n))), eNN), hm)
  +hn = UL.rw_le_l(U32.to_nat(N), Nat.add(WS.e32(q), r), Nat.mul(L, 2n), enq, hN)
  LR.bl_hlen(q, t, Nat.mul(L, 2n), NF.chunk_le(q, r, Nat.mul(L, 2n), h1, h32, hn))

def v2_body(+hl: Nat, +ehl: {hl == 64n : Nat}, -o: O.Words, +L: Nat, +depth: Nat,
    +wf: WO.wf1(o),
    +eN: {U32.to_nat(WO.len(o)) == Nat.double(LV.cnt2(o)) : Nat},
    +hv: {Nat.is_eq(LV.cnt2(o), L) == True{} : Bool},
    +hmin: {Lim.minimal(Nat.div(Nat.add(Nat.mul(L, 2n), 31n), 32n), depth) == True{} : Bool},
    +hdep: {Nat.is_lt(depth, 64n) == True{} : Bool})
    -> RR.roots(LV.vview2(o), S.Vector{S.Unsigned{P.U16{}}, L}, [D.bytes(WO.wdig(hl, o, depth))]):
  (+t, w1) = wf
  (+dw, w2) = w1
  (+N, w3) = w2
  (+q, w4) = w3
  (+r, w5) = w4
  (+eo, w6) = w5
  (+pf, w7) = w6
  (+hd, w8) = w7
  (+enq, w9) = w8
  (+h1, w10) = w9
  (+h32, w11) = w10
  (+room, +slack) = w11
  +eNN = eq_n2(o, t, N, eo, eN)
  +hvN = PK.eq_le(U32.to_nat(U32.shrn(N, 1n)), L, eqn_n2(o, t, N, L, eo, hv))
  %Equal.sym(O.Words, o, O.Words{F.array__thaw(U32, t), N}, eo) :
    RR.roots(LV.vview2(_), S.Vector{S.Unsigned{P.U16{}}, L}, [D.bytes(WO.wdig(hl, _, depth))])
  %Equal.sym(F.array__Tree<U32>, F.array__freeze(U32, F.array__thaw(U32, t)), t, F.array__freeze_thaw(U32, t)) :
    RR.roots(S.Sequence{LV.it2(U32.to_nat(U32.shrn(N, 1n)), WS.btake(U32.to_nat(N), FX.limbs(F.array__slots(U32, _))))}, S.Vector{S.Unsigned{P.U16{}}, L}, [D.bytes(MD.rtree(depth, Nat.is_lt(0n, O.chunks_of(N)), hl, MR.clist(O.chunks_of(N), F.array__slots(U32, _), 0n), 0n))])
  %Equal.sym(Nat, O.chunks_of(N), 1n+q, WO.chunks_q(N, q, r, enq, h1, h32)) :
    RR.roots(S.Sequence{LV.it2(U32.to_nat(U32.shrn(N, 1n)), WS.btake(U32.to_nat(N), FX.limbs(F.array__slots(U32, t))))}, S.Vector{S.Unsigned{P.U16{}}, L}, [D.bytes(MD.rtree(depth, Nat.is_lt(0n, _), hl, MR.clist(_, F.array__slots(U32, t), 0n), 0n))])
  (MD.bytes_list(MR.clist(1n+q, F.array__slots(U32, t), 0n)),
    ((WS.btake(U32.to_nat(N), FX.limbs(F.array__slots(U32, t))), (v2_enc(N, q, r, dw, t, eNN, enq, h32, pf, room), UL.ul_pack(N, q, r, dw, t, enq, h1, h32, pf, room, slack))),
     (D.bytes(MD.rtree(depth, True{}, hl, MR.clist(1n+q, F.array__slots(U32, t), 0n), 0n)),
      ((depth, (hmin, RS.at_depth_tree(Nat.div(Nat.add(Nat.mul(L, 2n), 31n), 32n), depth, hl, MR.clist(1n+q, F.array__slots(U32, t), 0n), hdep, v2_lim(N, q, r, L, t, eNN, enq, h1, h32, hvN), ehl))),
       {==}))))

def v2_rs(+hl: Nat, +ehl: {hl == 64n : Nat}, -o: O.Words, +s: S.Schema, +depth: Nat,
    +rep: LV.rep_v2(o, s),
    +ok: {ok_v2(s, depth) == True{} : Bool},
    +hdep: {Nat.is_lt(depth, 64n) == True{} : Bool})
    -> RR.roots(LV.vview2(o), s, [D.bytes(WO.wdig(hl, o, depth))]):
  (+wf, +r1) = rep
  (+eN, +hq) = r1
  +c0 = DK.and_l(SH.is_Vector(s), Bool.and(SH.is_Unsigned(SH.Vector_element(s)), Bool.and(is_U16(SH.Unsigned_width(SH.Vector_element(s))), Lim.minimal(Nat.div(Nat.add(Nat.mul(SH.Vector_length(s), 2n), 31n), 32n), depth))), ok)
  +k1 = DK.and_r(SH.is_Vector(s), Bool.and(SH.is_Unsigned(SH.Vector_element(s)), Bool.and(is_U16(SH.Unsigned_width(SH.Vector_element(s))), Lim.minimal(Nat.div(Nat.add(Nat.mul(SH.Vector_length(s), 2n), 31n), 32n), depth))), ok)
  +c1 = DK.and_l(SH.is_Unsigned(SH.Vector_element(s)), Bool.and(is_U16(SH.Unsigned_width(SH.Vector_element(s))), Lim.minimal(Nat.div(Nat.add(Nat.mul(SH.Vector_length(s), 2n), 31n), 32n), depth)), k1)
  +k2 = DK.and_r(SH.is_Unsigned(SH.Vector_element(s)), Bool.and(is_U16(SH.Unsigned_width(SH.Vector_element(s))), Lim.minimal(Nat.div(Nat.add(Nat.mul(SH.Vector_length(s), 2n), 31n), 32n), depth)), k1)
  +c2 = DK.and_l(is_U16(SH.Unsigned_width(SH.Vector_element(s))), Lim.minimal(Nat.div(Nat.add(Nat.mul(SH.Vector_length(s), 2n), 31n), 32n), depth), k2)
  +c3 = DK.and_r(is_U16(SH.Unsigned_width(SH.Vector_element(s))), Lim.minimal(Nat.div(Nat.add(Nat.mul(SH.Vector_length(s), 2n), 31n), 32n), depth), k2)
  %Equal.sym(S.Schema, s, S.Vector{SH.Vector_element(s), SH.Vector_length(s)}, SH.Vector_shape(s, c0)) :
    RR.roots(LV.vview2(o), _, [D.bytes(WO.wdig(hl, o, depth))])
  %Equal.sym(S.Schema, SH.Vector_element(s), S.Unsigned{SH.Unsigned_width(SH.Vector_element(s))}, SH.Unsigned_shape(SH.Vector_element(s), c1)) :
    RR.roots(LV.vview2(o), S.Vector{_, SH.Vector_length(s)}, [D.bytes(WO.wdig(hl, o, depth))])
  %Equal.sym(P.Width, SH.Unsigned_width(SH.Vector_element(s)), P.U16{}, is_U16_shape(SH.Unsigned_width(SH.Vector_element(s)), c2)) :
    RR.roots(LV.vview2(o), S.Vector{S.Unsigned{_}, SH.Vector_length(s)}, [D.bytes(WO.wdig(hl, o, depth))])
  v2_body(hl, ehl, o, SH.Vector_length(s), depth, wf, eN, hq, c3, hdep)

