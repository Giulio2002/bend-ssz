  rdxD(d, t, n, off, x, e, FD.nat__lt_trans(d, 28n, 31n, hd, {==}), pf, hb)

def VAL(+t: FD.array__Tree<U32>, +x: Nat) -> S.Value: S.BitsValue{FB.bitsof([UR.RWN(t, x), UR.RWN(t, 4n+x), UR.RWN(t, 8n+x), UR.RWN(t, 12n+x), UR.RWN(t, 16n+x), UR.RWN(t, 20n+x), UR.RWN(t, 24n+x), UR.RWN(t, 28n+x)])}

def prt(+d: Nat, +t: FD.array__Tree<U32>, +x: Nat, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hb: {Nat.is_le(Nat.add(x, 32n), A.quad(VB.pw(d))) == True{} : Bool},
    +s: S.Schema, +es: {s == S.BitVector{256n} : S.Schema})
    -> {Codec.parts(VAL(t, x), s) == Some{[S.Fixed{UW.WX(t, x, 32n)}]} : Maybe<&2, +List<S.Part>>}:
  %Equal.sym(S.Schema, s, S.BitVector{256n}, es) : {Codec.parts(VAL(t, x), _) == Some{[S.Fixed{UW.WX(t, x, 32n)}]} : Maybe<&2, +List<S.Part>>}
  %UR.rws_bytes(8n, d, t, x, pf, hb) : {Codec.parts(VAL(t, x), S.BitVector{256n}) == Some{[S.Fixed{_}]} : Maybe<&2, +List<S.Part>>}
  FB.bits_part([UR.RWN(t, x), UR.RWN(t, 4n+x), UR.RWN(t, 8n+x), UR.RWN(t, 12n+x), UR.RWN(t, 16n+x), UR.RWN(t, 20n+x), UR.RWN(t, 24n+x), UR.RWN(t, 28n+x)], 256n, {==}, {==})

