def VALC(+m_attesting_indices: EX_l131072_u64.MW, +data: T.AttestationData, +signature: T.Bytes96) -> S.Value: S.Sequence{S.Items{EX_l131072_u64.VAL(m_attesting_indices), S.Items{LV_AttestationData(data), S.Items{LV_b96(signature), S.EmptyItems{}}}}}
