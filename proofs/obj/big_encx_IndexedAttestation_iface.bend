# ---- the interface's laws ----------------------------------------------------------------------

law putx:
  for +m: MW
  for +dd: Nat
  for +D: FD.array__Tree<U32>
  for +X: U32
  for +q: Nat
  for +r: Nat
  for +e: {U32.to_nat(X) == Nat.add(A.quad(q), r) : Nat}
  for +hr: {Nat.is_lt(r, 4n) == True{} : Bool}
  for +hd: {Nat.is_lt(dd, 29n) == True{} : Bool}
  for +pf: {FD.array__perfect(U32, dd, D) == True{} : Bool}
  for +hl: {Nat.is_le(Nat.add(q, WD.NWN(Nat.add(r, List.length(&2, U32, ENC(m))))), VB.pw(dd)) == True{} : Bool}
  for +hz: {VS.bt(Nat.add(List.length(&2, U32, ENC(m)), PADB(r, m)), VS.bdr(Nat.add(A.quad(q), r), UA.BYT(D))) == UW.ZB(Nat.add(List.length(&2, U32, ENC(m)), PADB(r, m))) : +List<U32>}
  for +hok: {OK(m) == True{} : Bool}
  {T.IndexedAttestation_putk(FD.array__thaw(U32, D), X, TH(m)) == (FD.array__thaw(U32, PUTX(m, dd, D, q, r)), (TH(m), SZ(m))) : Array<U32> & (T.IndexedAttestation & U32)}
def putx(m, dd, D, X, q, r, e, hr, hd, pf, hl, hz, hok):
  match m:
    case MW{+m_attesting_indices, +data, +signature}: PA(RTX(m_attesting_indices, data, signature, dd, D, X, q, r), BYX(m_attesting_indices, data, signature, dd, D, q, r), go(m_attesting_indices, data, signature, hok, dd, D, X, q, r, e, hr, hd, pf, hl, hz))

law putx_bytes:
  for +m: MW
  for +dd: Nat
  for +D: FD.array__Tree<U32>
  for +X: U32
  for +q: Nat
  for +r: Nat
  for +e: {U32.to_nat(X) == Nat.add(A.quad(q), r) : Nat}
  for +hr: {Nat.is_lt(r, 4n) == True{} : Bool}
  for +hd: {Nat.is_lt(dd, 29n) == True{} : Bool}
  for +pf: {FD.array__perfect(U32, dd, D) == True{} : Bool}
  for +hl: {Nat.is_le(Nat.add(q, WD.NWN(Nat.add(r, List.length(&2, U32, ENC(m))))), VB.pw(dd)) == True{} : Bool}
  for +hz: {VS.bt(Nat.add(List.length(&2, U32, ENC(m)), PADB(r, m)), VS.bdr(Nat.add(A.quad(q), r), UA.BYT(D))) == UW.ZB(Nat.add(List.length(&2, U32, ENC(m)), PADB(r, m))) : +List<U32>}
  for +hok: {OK(m) == True{} : Bool}
  {UA.BYT(PUTX(m, dd, D, q, r)) == UW.SPL(UA.BYT(D), Nat.add(A.quad(q), r), List.append(&2, U32, ENC(m), UW.ZB(PADB(r, m)))) : +List<U32>}
def putx_bytes(m, dd, D, X, q, r, e, hr, hd, pf, hl, hz, hok):
  match m:
    case MW{+m_attesting_indices, +data, +signature}: PB(RTX(m_attesting_indices, data, signature, dd, D, X, q, r), BYX(m_attesting_indices, data, signature, dd, D, q, r), go(m_attesting_indices, data, signature, hok, dd, D, X, q, r, e, hr, hd, pf, hl, hz))

law szx:
  for +m: MW
  for +hok: {OK(m) == True{} : Bool}
  {U32.to_nat(SZ(m)) == List.length(&2, U32, ENC(m)) : Nat}
def szx(m, hok):
  match m:
    case MW{+m_attesting_indices, +data, +signature}: Equal.trans(Nat, U32.to_nat(K.SZC(m_attesting_indices, data, signature)), ENDC(m_attesting_indices, data, signature), List.length(&2, U32, K.ENCC(m_attesting_indices, data, signature)), szC(m_attesting_indices, data, signature, hok, 28n, {==}), Equal.sym(Nat, List.length(&2, U32, K.ENCC(m_attesting_indices, data, signature)), ENDC(m_attesting_indices, data, signature), lenE(m_attesting_indices, data, signature, hok)))

law encx_spec:
  for +m: MW
  for +hok: {OK(m) == True{} : Bool}
  {Codec.parts(VAL(m), Spec.IndexedAttestation()) == Some{[S.Variable{ENC(m)}]} : Maybe<&2, +List<S.Part>>}
def encx_spec(m, hok):
  match m:
    case MW{+m_attesting_indices, +data, +signature}: specC(m_attesting_indices, data, signature, hok, 28n, {==})

law domx:
  for +m: MW
  for +hok: {OK(m) == True{} : Bool}
  {SP.bytes_domain(ENC(m)) == True{} : Bool}
def domx(m, hok):
  match m:
    case MW{+m_attesting_indices, +data, +signature}: CS.domv(VALC(m_attesting_indices, data, signature), Spec.IndexedAttestation(), K.ENCC(m_attesting_indices, data, signature), {==}, specC(m_attesting_indices, data, signature, hok, 28n, {==}))

law pfx:
  for +m: MW
  for +dd: Nat
  for +D: FD.array__Tree<U32>
  for +q: Nat
  for +r: Nat
  for +pf: {FD.array__perfect(U32, dd, D) == True{} : Bool}
  {FD.array__perfect(U32, dd, PUTX(m, dd, D, q, r)) == True{} : Bool}
def pfx(m, dd, D, q, r, pf):
  match m:
    case MW{+m_attesting_indices, +data, +signature}: K.pfC(m_attesting_indices, data, signature, dd, D, XQ(q, r), q, r, pf)

def sizeC(+m_attesting_indices: EX_l131072_u64.MW, +data: T.AttestationData, +signature: T.Bytes96, +h: {OKT(m_attesting_indices, data, signature) == True{} : Bool}) -> {T.IndexedAttestation_size(K.OBJC(m_attesting_indices, data, signature)) == (K.OBJC(m_attesting_indices, data, signature), K.SZC(m_attesting_indices, data, signature)) : T.IndexedAttestation & U32}:
  %Equal.sym(O.Words & U32, T.l131072_u64_size(EX_l131072_u64.TH(m_attesting_indices)), (EX_l131072_u64.TH(m_attesting_indices), EX_l131072_u64.SZ(m_attesting_indices)), EX_l131072_u64.sizex(m_attesting_indices, ok_hok_attesting_indices(m_attesting_indices, data, signature, h))) :
    {T.IndexedAttestation_sz0(data, signature, 228, _) == (K.OBJC(m_attesting_indices, data, signature), K.SZC(m_attesting_indices, data, signature)) : T.IndexedAttestation & U32}
  {==}

law sizex:
  for +m: MW
  for +hok: {OK(m) == True{} : Bool}
  {T.IndexedAttestation_size(TH(m)) == (TH(m), SZ(m)) : T.IndexedAttestation & U32}
def sizex(m, hok):
  match m:
    case MW{+m_attesting_indices, +data, +signature}: sizeC(m_attesting_indices, data, signature, hok)

def rvalidC(+m_attesting_indices: EX_l131072_u64.MW, +data: T.AttestationData, +signature: T.Bytes96, +h: {OKT(m_attesting_indices, data, signature) == True{} : Bool}) -> {T.IndexedAttestation_valid(K.OBJC(m_attesting_indices, data, signature)) == (K.OBJC(m_attesting_indices, data, signature), True{}) : T.IndexedAttestation & Bool}:
  %Equal.sym(O.Words & Bool, T.l131072_u64_valid(EX_l131072_u64.TH(m_attesting_indices)), (EX_l131072_u64.TH(m_attesting_indices), True{}), EX_l131072_u64.validx(m_attesting_indices, ok_hok_attesting_indices(m_attesting_indices, data, signature, h))) :
    {T.IndexedAttestation_va0(data, signature, True{}, _) == (K.OBJC(m_attesting_indices, data, signature), True{}) : T.IndexedAttestation & Bool}
  {==}

law validx:
  for +m: MW
  for +hok: {OK(m) == True{} : Bool}
  {T.IndexedAttestation_valid(TH(m)) == (TH(m), True{}) : T.IndexedAttestation & Bool}
def validx(m, hok):
  match m:
    case MW{+m_attesting_indices, +data, +signature}: rvalidC(m_attesting_indices, data, signature, hok)
