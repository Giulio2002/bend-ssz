# ==== IndexedAttestation in the encoder-window interface ====

type MW is Data:
  MW{m_attesting_indices: EX_l131072_u64.MW, data: T.AttestationData, signature: T.Bytes96}

def TH(m: MW) -> T.IndexedAttestation:
  match m:
    case MW{+m_attesting_indices, +data, +signature}: K.OBJC(m_attesting_indices, data, signature)
def OK(m: MW) -> Bool:
  match m:
    case MW{+m_attesting_indices, +data, +signature}: OKT(m_attesting_indices, data, signature)
def ENC(m: MW) -> +List<U32>:
  match m:
    case MW{+m_attesting_indices, +data, +signature}: K.ENCC(m_attesting_indices, data, signature)
def VAL(m: MW) -> S.Value:
  match m:
    case MW{+m_attesting_indices, +data, +signature}: VALC(m_attesting_indices, data, signature)
def SZ(m: MW) -> U32:
  match m:
    case MW{+m_attesting_indices, +data, +signature}: K.SZC(m_attesting_indices, data, signature)
def XQ(+q: Nat, +r: Nat) -> U32: U32.from_nat(Nat.add(A.quad(q), r))
def PUTX(m: MW, +dd: Nat, +D: FD.array__Tree<U32>, +q: Nat, +r: Nat) -> FD.array__Tree<U32>:
  match m:
    case MW{+m_attesting_indices, +data, +signature}: K.PUTC(m_attesting_indices, data, signature, dd, D, XQ(q, r), q, r)
def PADB(+r: Nat, m: MW) -> Nat: WD.PADB(r, List.length(&2, U32, ENC(m)))

def RTX(+m_attesting_indices: EX_l131072_u64.MW, +data: T.AttestationData, +signature: T.Bytes96, +dd: Nat, +D: FD.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat) -> Data:
  {T.IndexedAttestation_putk(FD.array__thaw(U32, D), X, K.OBJC(m_attesting_indices, data, signature)) == (FD.array__thaw(U32, K.PUTC(m_attesting_indices, data, signature, dd, D, XQ(q, r), q, r)), (K.OBJC(m_attesting_indices, data, signature), K.SZC(m_attesting_indices, data, signature))) : Array<U32> & (T.IndexedAttestation & U32)}
def BYX(+m_attesting_indices: EX_l131072_u64.MW, +data: T.AttestationData, +signature: T.Bytes96, +dd: Nat, +D: FD.array__Tree<U32>, +q: Nat, +r: Nat) -> Data:
  {UA.BYT(K.PUTC(m_attesting_indices, data, signature, dd, D, XQ(q, r), q, r)) == UW.SPL(UA.BYT(D), Nat.add(A.quad(q), r), VCN.AP(K.ENCC(m_attesting_indices, data, signature), UW.ZB(WD.PADB(r, List.length(&2, U32, K.ENCC(m_attesting_indices, data, signature)))))) : +List<U32>}

def go(+m_attesting_indices: EX_l131072_u64.MW, +data: T.AttestationData, +signature: T.Bytes96, +h: {OKT(m_attesting_indices, data, signature) == True{} : Bool}, +dd: Nat, +D: FD.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat,
    +e: {U32.to_nat(X) == Nat.add(A.quad(q), r) : Nat}, +hr: {Nat.is_lt(r, 4n) == True{} : Bool}, +hd: {Nat.is_lt(dd, 29n) == True{} : Bool}, +pf: {FD.array__perfect(U32, dd, D) == True{} : Bool},
    +hl: {Nat.is_le(Nat.add(q, WD.NWN(Nat.add(r, List.length(&2, U32, K.ENCC(m_attesting_indices, data, signature))))), VB.pw(dd)) == True{} : Bool},
    +hz: {VS.bt(Nat.add(List.length(&2, U32, K.ENCC(m_attesting_indices, data, signature)), WD.PADB(r, List.length(&2, U32, K.ENCC(m_attesting_indices, data, signature)))), VS.bdr(Nat.add(A.quad(q), r), UA.BYT(D))) == UW.ZB(Nat.add(List.length(&2, U32, K.ENCC(m_attesting_indices, data, signature)), WD.PADB(r, List.length(&2, U32, K.ENCC(m_attesting_indices, data, signature))))) : +List<U32>})
    -> DK.P2(RTX(m_attesting_indices, data, signature, dd, D, X, q, r), BYX(m_attesting_indices, data, signature, dd, D, q, r)):
  +LLv = K.LLC(m_attesting_indices, data, signature, dd, D, XQ(q, r), q, r)
  +el = lenC(m_attesting_indices, data, signature, dd, D, XQ(q, r), q, r)
  +hl2 = FD.logic__subst(Nat, z => {Nat.is_le(Nat.add(q, WD.NWN(Nat.add(r, z))), VB.pw(dd)) == True{} : Bool}, List.length(&2, U32, K.ENCC(m_attesting_indices, data, signature)), LLv, el, hl)
  +hz2 = FD.logic__subst(Nat, z => {VS.bt(Nat.add(z, WD.PADB(r, z)), VS.bdr(Nat.add(A.quad(q), r), UA.BYT(D))) == UW.ZB(Nat.add(z, WD.PADB(r, z))) : +List<U32>}, List.length(&2, U32, K.ENCC(m_attesting_indices, data, signature)), LLv, el, hz)
  +ex = CS.exq(X, q, r, LLv, dd, e, hd, hl2)
  +e2 = FD.logic__subst(U32, z => {U32.to_nat(z) == Nat.add(A.quad(q), r) : Nat}, X, XQ(q, r), ex, e)
