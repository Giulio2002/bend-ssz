# the bound with its exponent symbolic (k = 28)
def okbk(+m_attesting_indices: EX_l131072_u64.MW, +data: T.AttestationData, +signature: T.Bytes96, +h: {OKT(m_attesting_indices, data, signature) == True{} : Bool}, +k: Nat, +ek: {k == 28n : Nat}) -> {Nat.is_le(ENDC(m_attesting_indices, data, signature), A.quad(VB.pw(k))) == True{} : Bool}:
