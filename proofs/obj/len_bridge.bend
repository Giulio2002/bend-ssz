def lyr(+b: Bool, +y: Nat) -> Nat: Nat.add(F.spec_numeric__bit_value(b), Nat.double(y))

law double_add:
  for +a: Nat
  for +b: Nat
  {Nat.double(Nat.add(a, b)) == Nat.add(Nat.double(a), Nat.double(b)) : Nat}
def double_add(a, b):
  match a:
    case 0n: {==}
    case 1n+ +p:
      %double_add(p, b) : {2n+Nat.double(Nat.add(p, b)) == 2n+_ : Nat}
      {==}

law add_assoc:
  for +x: Nat
  for +y: Nat
  for +z: Nat
  {Nat.add(Nat.add(x, y), z) == Nat.add(x, Nat.add(y, z)) : Nat}
def add_assoc(x, y, z):
  match x:
    case 0n: {==}
    case 1n+ +p:
      %add_assoc(p, y, z) : {1n+Nat.add(Nat.add(p, y), z) == 1n+_ : Nat}
      {==}

# One binary layer is linear in its tail.
law lin:
  for +b: Bool
  for +y: Nat
  for +t: Nat
  {lyr(b, Nat.add(y, t)) == Nat.add(lyr(b, y), Nat.double(t)) : Nat}
def lin(b, y, t):
  %Equal.sym(Nat, Nat.double(Nat.add(y, t)), Nat.add(Nat.double(y), Nat.double(t)), double_add(y, t)) :
    {Nat.add(F.spec_numeric__bit_value(b), _) == Nat.add(lyr(b, y), Nat.double(t)) : Nat}
  %Equal.sym(Nat, Nat.add(Nat.add(F.spec_numeric__bit_value(b), Nat.double(y)), Nat.double(t)), Nat.add(F.spec_numeric__bit_value(b), Nat.add(Nat.double(y), Nat.double(t))), add_assoc(F.spec_numeric__bit_value(b), Nat.double(y), Nat.double(t))) :
    {Nat.add(F.spec_numeric__bit_value(b), Nat.add(Nat.double(y), Nat.double(t))) == _ : Nat}
  {==}

law d8:
  for +t: Nat
  {Nat.double(Nat.double(Nat.double(Nat.double(Nat.double(Nat.double(Nat.double(Nat.double(t)))))))) == Nat.mul(t, 256n) : Nat}
def d8(t):
  match t:
    case 0n: {==}
    case 1n+ +p:
      %d8(p) : {Nat.double(Nat.double(Nat.double(Nat.double(Nat.double(Nat.double(Nat.double(Nat.double(1n+p)))))))) == Nat.add(256n, _) : Nat}
      {==}

# Eight layers: the byte they spell plus 256 times the rest.
