def disc(b: Bool) -> Type:
  match b:
    case True{}: Unit
    case False{}: Empty

def false_true(e: {False{} == True{} : Bool}) -> Empty:
  %Equal.sym(Bool, False{}, True{}, e) : disc(_)
  Unit{}

def zero_succ(+n: Nat, +e: {1n+n == 0n : Nat}) -> Empty: F.nat__zero_succ(n, Equal.sym(Nat, 1n+n, 0n, e))

def and_l(+a: Bool, +b: Bool, +e: {Bool.and(a, b) == True{} : Bool}) -> {a == True{} : Bool}:
  match a:
    case True{}: {==}
    case False{}: Empty.absurd({False{} == True{} : Bool}, false_true(e))

def and_r(+a: Bool, +b: Bool, +e: {Bool.and(a, b) == True{} : Bool}) -> {b == True{} : Bool}:
  match a:
    case True{}: e
    case False{}: Empty.absurd({b == True{} : Bool}, false_true(e))

# A byte below 256 is at most 255.
def small(+h: U32, +e: {U32.is_lt(h, 256) == True{} : Bool}) -> {Nat.is_le(U32.to_nat(h), 255n) == True{} : Bool}:
  F.nat__lt_succ_le(U32.to_nat(h), 255n, Equal.trans(Bool, Nat.is_lt(U32.to_nat(h), 256n), U32.is_lt(h, 256), True{},
    Equal.sym(Bool, U32.is_lt(h, 256), Nat.is_lt(U32.to_nat(h), U32.to_nat(256)), UO.u32_less(h, 256)), e))

law fits_value:
  for +width: Nat
  for +xs: +List<U32>
  for +sized: {List.length(&2, U32, xs) == width : Nat}
  for +scope: {SP.bytes_domain(xs) == True{} : Bool}
  {N.fits(width, N.value(xs)) == True{} : Bool}
def fits_value(width, xs, sized, scope):
  match width:
    case 0n:
      match xs:
        case Nil{}: {==}
        case Con{h, t}: Empty.absurd({N.fits(0n, N.value(Con{h, t})) == True{} : Bool}, zero_succ(List.length(&2, U32, t), sized))
    case 1n+ +p:
      match xs:
        case Nil{}: Empty.absurd({N.fits(1n+p, N.value(Nil{})) == True{} : Bool}, zero_succ(p, Equal.sym(Nat, 0n, 1n+p, sized)))
        case Con{+h, +t}:
          %Equal.sym(Nat, Nat.div(N.value(h <> t), 256n), N.value(t), OD.value_tail(h, t, small(h, and_l(U32.is_lt(h, 256), SP.bytes_domain(t), scope)))) :
            {N.fits(p, _) == True{} : Bool}
          fits_value(p, t, F.nat__succ_inj(List.length(&2, U32, t), p, sized), and_r(U32.is_lt(h, 256), SP.bytes_domain(t), scope))

# The 32-byte specification encoding of a count is its length chunk's bytes.
law len_bytes:
  for +x: U32
  {N.encoding(32n, U32.to_nat(x)) == Some{List.append(&2, U32, FX.limbs([x]), SP.zero_bytes(28n))} : Maybe<&2, +List<U32>>}
def len_bytes(x):
  %Equal.sym(Nat, U32.to_nat(x), N.value(I.limb(x)), u32_value(x)) : {N.encoding(32n, _) == Some{List.append(&2, U32, FX.limbs([x]), SP.zero_bytes(28n))} : Maybe<&2, +List<U32>>}
  %Equal.sym(Bool, N.fits(32n, N.value(List.append(&2, U32, FX.limbs([x]), SP.zero_bytes(28n)))), True{}, fits_value(32n, List.append(&2, U32, FX.limbs([x]), SP.zero_bytes(28n)), {==}, V.append_domain(FX.limbs([x]), SP.zero_bytes(28n), FX.domain_limbs([x]), {==}))) :
    {SP.optional(_, N.digits(32n, N.value(I.limb(x)))) == Some{List.append(&2, U32, FX.limbs([x]), SP.zero_bytes(28n))} : Maybe<&2, +List<U32>>}
  %Equal.sym(+List<U32>, N.digits(32n, N.value(List.append(&2, U32, FX.limbs([x]), SP.zero_bytes(28n)))), List.append(&2, U32, FX.limbs([x]), SP.zero_bytes(28n)), OD.digits_of_value(32n, List.append(&2, U32, FX.limbs([x]), SP.zero_bytes(28n)), {==}, V.append_domain(FX.limbs([x]), SP.zero_bytes(28n), FX.domain_limbs([x]), {==}))) :
    {SP.optional(True{}, _) == Some{List.append(&2, U32, FX.limbs([x]), SP.zero_bytes(28n))} : Maybe<&2, +List<U32>>}
  {==}
