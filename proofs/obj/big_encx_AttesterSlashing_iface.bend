def lenE(+m_attestation_1: EC_IndexedAttestation.MW, +m_attestation_2: EC_IndexedAttestation.MW, +h: {OKT(m_attestation_1, m_attestation_2) == True{} : Bool}) -> {List.length(&2, U32, K.ENCC(m_attestation_1, m_attestation_2)) == ENDC(m_attestation_1, m_attestation_2) : Nat}:
