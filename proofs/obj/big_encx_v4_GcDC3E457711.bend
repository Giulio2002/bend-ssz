      %Equal.sym(Array<T.GcDC3E457711> & T.GcDC3E457711, AG(A, 0), (FD.array__thaw(T.GcDC3E457711, A), EL(A, 0n)), get0(da, A, pfA, hda31(da, A, N, h), h0)) :
