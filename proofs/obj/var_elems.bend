  match k:
    case 0n: 0n
    case 1n+c: 8n+b2(c)

def it2(k: Nat, W: List<&2, U32>) -> S.Value:
  match k:
    case 0n: S.EmptyItems{}
    case 1n+c:
      match W:
        case Nil{}: S.EmptyItems{}
        case Con{+a0, t0}:
          match t0:
            case Nil{}: S.EmptyItems{}
            case Con{+a1, rest}:
              S.Items{S.UnsignedValue{P.UInt{a0, a1, 0, 0, 0, 0, 0, 0}}, it2(c, rest)}

def gp2(k: Nat, W: List<&2, U32>) -> +List<+List<U32>>:
  match k:
    case 0n: []
    case 1n+c:
      match W:
        case Nil{}: []
        case Con{+a0, t0}:
          match t0:
            case Nil{}: []
            case Con{+a1, rest}:
              [a0, a1] <> gp2(c, rest)

def nn2(k: Nat, W: List<&2, U32>) -> Nat:
  match k:
    case 0n: 0n
    case 1n+c:
      match W:
        case Nil{}: 0n
        case Con{+a0, t0}:
          match t0:
            case Nil{}: 0n
            case Con{+a1, rest}:
              1n+nn2(c, rest)

