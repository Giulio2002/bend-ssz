    case 0n: {==}
    case 1n++ c:
      match W:
        case Nil{}: {==}
        case Con{+a0, + t0}:
          match t0:
            case Nil{}: {==}
            case Con{+a1, + rest}:
              %Equal.sym(+List<U32>, FX.flat(gp2(c, rest)), FX.limbs(VS.wtake(w2(nn2(c, rest)), rest)), flat2(c, rest)) : {List.append(&2, U32, FX.limbs([a0, a1]), _) == FX.limbs(a0 <> a1 <> VS.wtake(w2(nn2(c, rest)), rest)) : +List<U32>}
              Equal.sym(+List<U32>, FX.limbs(VF.app([a0, a1], VS.wtake(w2(nn2(c, rest)), rest))), List.append(&2, U32, FX.limbs([a0, a1]), FX.limbs(VS.wtake(w2(nn2(c, rest)), rest))), VF.limbs_app([a0, a1], VS.wtake(w2(nn2(c, rest)), rest)))

law lenflat2:
  for +k: Nat
  for +W: List<&2, U32>
  {List.length(&2, U32, FX.flat(gp2(k, W))) == b2(nn2(k, W)) : Nat}
def lenflat2(k, W):
  match k:
    case 0n: {==}
    case 1n++ c:
      match W:
        case Nil{}: {==}
        case Con{+a0, + t0}:
          match t0:
            case Nil{}: {==}
            case Con{+a1, + rest}:
              %lenflat2(c, rest) : {List.length(&2, U32, List.append(&2, U32, FX.limbs([a0, a1]), FX.flat(gp2(c, rest)))) == 8n+_ : Nat}
              {==}

law bq2:
  for +c: Nat
  {b2(c) == A.quad(w2(c)) : Nat}
def bq2(c):
  match c:
    case 0n: {==}
    case 1n+ +p:
      %Equal.sym(Nat, b2(p), A.quad(w2(p)), bq2(p)) : {8n+_ == A.quad(2n+w2(p)) : Nat}
      {==}

law mulb2:
  for +c: Nat
  {Nat.mul(c, 8n) == b2(c) : Nat}
def mulb2(c):
  match c:
    case 0n: {==}
    case 1n+ +p:
      %Equal.sym(Nat, Nat.mul(p, 8n), b2(p), mulb2(p)) : {Nat.add(8n, _) == b2(1n+p) : Nat}
      {==}

# The progressive list of k elements over W is one variable part: the limbs of
# the first E k words of W.
def plenc2(+k: Nat, +W: List<&2, U32>, +hl: {Nat.is_le(w2(k), F.spec_common__length(U32, W)) == True{} : Bool}, +fit: {N.fits(4n, b2(k)) == True{} : Bool})
    -> {Codec.bytes(Codec.parts(S.Sequence{it2(k, W)}, S.ProgressiveList{uS2()})) == Some{FX.limbs(VS.wtake(w2(k), W))} : Maybe<&2, +List<U32>>}:
  +G = gp2(k, W)
  +e1 = Equal.trans(Nat, List.length(&2, U32, FX.flat(G)), b2(nn2(k, W)), b2(k), lenflat2(k, W),
    Equal.cong(Nat, Nat, z => b2(z), nn2(k, W), k, neq2(k, W, hl)))
  +fit2 = F.logic__subst(Nat, z => {N.fits(4n, z) == True{} : Bool}, b2(k), List.length(&2, U32, FX.flat(G)), Equal.sym(Nat, List.length(&2, U32, FX.flat(G)), b2(k), e1), fit)
  %Equal.sym(Maybe<&2, +List<S.Part>>, Codec.parts(it2(k, W), S.Repeat{uS2()}), Some{FX.fparts(G)}, parts2(k, W)) :
    {Codec.bytes(Codec.aggregate(_, None{})) == Some{FX.limbs(VS.wtake(w2(k), W))} : Maybe<&2, +List<U32>>}
  %Equal.sym(Maybe<&2, +List<U32>>, Layout.encoding(FX.fparts(G)), Some{FX.flat(G)}, VS.encoding_fparts(G, fit2)) :
    {Codec.bytes(Codec.one(_, None{})) == Some{FX.limbs(VS.wtake(w2(k), W))} : Maybe<&2, +List<U32>>}
  %Equal.sym(+List<U32>, FX.flat(G), FX.limbs(VS.wtake(w2(nn2(k, W)), W)), flat2(k, W)) :
    {Codec.bytes(Codec.one(Some{_}, None{})) == Some{FX.limbs(VS.wtake(w2(k), W))} : Maybe<&2, +List<U32>>}
  %Equal.sym(Nat, nn2(k, W), k, neq2(k, W, hl)) :
    {Codec.bytes(Codec.one(Some{FX.limbs(VS.wtake(w2(_), W))}, None{})) == Some{FX.limbs(VS.wtake(w2(k), W))} : Maybe<&2, +List<U32>>}
  {==}

def REPF2(+its: S.Value, +ps: +List<S.Part>) -> Type:
  {VS.allfix(ps) == True{} : Bool} & {Layout.fixed_size(ps) == b2(Codec.count(its)) : Nat}

def rlen2(+P8: +List<U32>, +pb: +List<S.Part>, +t: S.Value, +l8: {List.length(&2, U32, P8) == 8n : Nat},
    +hs: {Layout.fixed_size(pb) == b2(Codec.count(t)) : Nat})
    -> {Nat.add(List.length(&2, U32, P8), Layout.fixed_size(pb)) == 8n+b2(Codec.count(t)) : Nat}:
  %Equal.sym(Nat, List.length(&2, U32, P8), 8n, l8) : {Nat.add(_, Layout.fixed_size(pb)) == 8n+b2(Codec.count(t)) : Nat}
  %Equal.sym(Nat, Layout.fixed_size(pb), b2(Codec.count(t)), hs) : {8n+_ == 8n+b2(Codec.count(t)) : Nat}
  {==}

def rt22(+P8: +List<U32>, +el: S.Value, +t: S.Value, +pb: +List<S.Part>, +l8: {List.length(&2, U32, P8) == 8n : Nat}, r: REPF2(t, pb))
    -> REPF2(S.Items{el, t}, S.Fixed{P8} <> pb):
  (+ha, +hs) = r
  (ha, rlen2(P8, pb, t, l8, hs))

def rt2(+P8: +List<U32>, +el: S.Value, +t: S.Value, +ps: +List<S.Part>, +mB: Maybe<&2, +List<S.Part>>,
    +eB: {Codec.parts(t, S.Repeat{uS2()}) == mB : Maybe<&2, +List<S.Part>>},
    +l8: {List.length(&2, U32, P8) == 8n : Nat},
    +e: {Codec.concatenate(Some{[S.Fixed{P8}]}, mB) == Some{ps} : Maybe<&2, +List<S.Part>>},
    ih: @+pb: +List<S.Part> -> {Codec.parts(t, S.Repeat{uS2()}) == Some{pb} : Maybe<&2, +List<S.Part>>} -> REPF2(t, pb))
    -> REPF2(S.Items{el, t}, ps):
  match mB:
    case None{}: Empty.absurd(REPF2(S.Items{el, t}, ps), F.logic__none_some(+List<S.Part>, ps, e))
    case Some{+pb}:
      +eps = F.logic__some_inj(+List<S.Part>, S.Fixed{P8} <> pb, ps, e)
      %Equal.sym(+List<S.Part>, ps, S.Fixed{P8} <> pb, Equal.sym(+List<S.Part>, S.Fixed{P8} <> pb, ps, eps)) : REPF2(S.Items{el, t}, _)
      rt22(P8, el, t, pb, l8, ih(pb, eB))

def ru2(+a0: U32, +a1: U32, +a2: U32, +a3: U32, +a4: U32, +a5: U32, +a6: U32, +a7: U32, +t: S.Value, +ps: +List<S.Part>, +b: Bool,
    +e: {Codec.concatenate(Codec.one(SP.optional(b, SP.prefix(8n, SP.full_digits(P.UInt{a0, a1, a2, a3, a4, a5, a6, a7}))), Some{8n}), Codec.parts(t, S.Repeat{uS2()})) == Some{ps} : Maybe<&2, +List<S.Part>>},
    ih: @+pb: +List<S.Part> -> {Codec.parts(t, S.Repeat{uS2()}) == Some{pb} : Maybe<&2, +List<S.Part>>} -> REPF2(t, pb))
    -> REPF2(S.Items{S.UnsignedValue{P.UInt{a0, a1, a2, a3, a4, a5, a6, a7}}, t}, ps):
  match b:
    case False{}: Empty.absurd(REPF2(S.Items{S.UnsignedValue{P.UInt{a0, a1, a2, a3, a4, a5, a6, a7}}, t}, ps), F.logic__none_some(+List<S.Part>, ps, e))
    case True{}: rt2(SP.prefix(8n, SP.full_digits(P.UInt{a0, a1, a2, a3, a4, a5, a6, a7})), S.UnsignedValue{P.UInt{a0, a1, a2, a3, a4, a5, a6, a7}}, t, ps, Codec.parts(t, S.Repeat{uS2()}), {==}, {==}, e, ih)

law rep_facts2:
  for +its: S.Value
  for +ps: +List<S.Part>
  for +e: {Codec.parts(its, S.Repeat{uS2()}) == Some{ps} : Maybe<&2, +List<S.Part>>}
  REPF2(its, ps)
def rep_facts2(its, ps, e):
  match its:
    case S.EmptyItems{}:
      +eps = F.logic__some_inj(+List<S.Part>, [], ps, e)
      %Equal.sym(+List<S.Part>, ps, [], Equal.sym(+List<S.Part>, [], ps, eps)) : REPF2(S.EmptyItems{}, _)
      ({==}, {==})
    case S.Items{S.UnsignedValue{P.UInt{+a0, +a1, +a2, +a3, +a4, +a5, +a6, +a7}}, +t}:
      ru2(a0, a1, a2, a3, a4, a5, a6, a7, t, ps, SP.uint_domain(P.U64{}, P.UInt{a0, a1, a2, a3, a4, a5, a6, a7}), e, pb => eb => rep_facts2(t, pb, eb))
    case S.BooleanValue{+b}: Empty.absurd(REPF2(S.BooleanValue{b}, ps), F.logic__none_some(+List<S.Part>, ps, e))
    case S.UnsignedValue{+u}: Empty.absurd(REPF2(S.UnsignedValue{u}, ps), F.logic__none_some(+List<S.Part>, ps, e))
    case S.BytesValue{+xs}: Empty.absurd(REPF2(S.BytesValue{xs}, ps), F.logic__none_some(+List<S.Part>, ps, e))
    case S.BitsValue{+bs}: Empty.absurd(REPF2(S.BitsValue{bs}, ps), F.logic__none_some(+List<S.Part>, ps, e))
    case S.Sequence{+it}: Empty.absurd(REPF2(S.Sequence{it}, ps), F.logic__none_some(+List<S.Part>, ps, e))
    case S.Items{S.BooleanValue{+b}, +t}: Empty.absurd(REPF2(S.Items{S.BooleanValue{b}, t}, ps), F.logic__none_some(+List<S.Part>, ps, e))
    case S.Items{S.BytesValue{+xs}, +t}: Empty.absurd(REPF2(S.Items{S.BytesValue{xs}, t}, ps), F.logic__none_some(+List<S.Part>, ps, e))
    case S.Items{S.BitsValue{+bs}, +t}: Empty.absurd(REPF2(S.Items{S.BitsValue{bs}, t}, ps), F.logic__none_some(+List<S.Part>, ps, e))
    case S.Items{S.Sequence{+it}, +t}: Empty.absurd(REPF2(S.Items{S.Sequence{it}, t}, ps), F.logic__none_some(+List<S.Part>, ps, e))
    case S.Items{S.Items{+hd, +tl}, +t}: Empty.absurd(REPF2(S.Items{S.Items{hd, tl}, t}, ps), F.logic__none_some(+List<S.Part>, ps, e))
    case S.Items{S.EmptyItems{}, +t}: Empty.absurd(REPF2(S.Items{S.EmptyItems{}, t}, ps), F.logic__none_some(+List<S.Part>, ps, e))
    case S.Items{S.Selected{+sel, +sv}, +t}: Empty.absurd(REPF2(S.Items{S.Selected{sel, sv}, t}, ps), F.logic__none_some(+List<S.Part>, ps, e))
    case S.Items{S.NullValue{}, +t}: Empty.absurd(REPF2(S.Items{S.NullValue{}, t}, ps), F.logic__none_some(+List<S.Part>, ps, e))
    case S.Selected{+sel, +sv}: Empty.absurd(REPF2(S.Selected{sel, sv}, ps), F.logic__none_some(+List<S.Part>, ps, e))
    case S.NullValue{}: Empty.absurd(REPF2(S.NullValue{}, ps), F.logic__none_some(+List<S.Part>, ps, e))

# ---- elements of 4 word(s) ------------------------------------------------------------

def uS4() -> S.Schema: S.Unsigned{P.U128{}}

def w4(k: Nat) -> Nat:
  match k:
    case 0n: 0n
    case 1n+c: 4n+w4(c)

def b4(k: Nat) -> Nat:
  match k:
    case 0n: 0n
    case 1n+c: 16n+b4(c)

def it4(k: Nat, W: List<&2, U32>) -> S.Value:
  match k:
    case 0n: S.EmptyItems{}
    case 1n+c:
      match W:
        case Nil{}: S.EmptyItems{}
        case Con{+a0, t0}:
          match t0:
            case Nil{}: S.EmptyItems{}
            case Con{+a1, t1}:
              match t1:
                case Nil{}: S.EmptyItems{}
                case Con{+a2, t2}:
                  match t2:
                    case Nil{}: S.EmptyItems{}
                    case Con{+a3, rest}:
                      S.Items{S.UnsignedValue{P.UInt{a0, a1, a2, a3, 0, 0, 0, 0}}, it4(c, rest)}

def gp4(k: Nat, W: List<&2, U32>) -> +List<+List<U32>>:
  match k:
    case 0n: []
    case 1n+c:
      match W:
        case Nil{}: []
        case Con{+a0, t0}:
          match t0:
            case Nil{}: []
            case Con{+a1, t1}:
              match t1:
                case Nil{}: []
                case Con{+a2, t2}:
                  match t2:
                    case Nil{}: []
                    case Con{+a3, rest}:
                      [a0, a1, a2, a3] <> gp4(c, rest)

def nn4(k: Nat, W: List<&2, U32>) -> Nat:
  match k:
    case 0n: 0n
    case 1n+c:
      match W:
        case Nil{}: 0n
        case Con{+a0, t0}:
          match t0:
            case Nil{}: 0n
            case Con{+a1, t1}:
              match t1:
                case Nil{}: 0n
                case Con{+a2, t2}:
                  match t2:
                    case Nil{}: 0n
                    case Con{+a3, rest}:
                      1n+nn4(c, rest)

def eu4(+a0: U32, +a1: U32, +a2: U32, +a3: U32) -> {Codec.parts(S.UnsignedValue{P.UInt{a0, a1, a2, a3, 0, 0, 0, 0}}, uS4()) == Some{[S.Fixed{FX.limbs([a0, a1, a2, a3])}]} : Maybe<&2, +List<S.Part>>}:
  F.logic__subst(S.Schema, z => {Codec.parts(S.UnsignedValue{P.UInt{a0, a1, a2, a3, 0, 0, 0, 0}}, z) == Some{[S.Fixed{FX.limbs([a0, a1, a2, a3])}]} : Maybe<&2, +List<S.Part>>}, S.Unsigned{P.U128{}}, uS4(), {==}, FX.uint128_part(a0, a1, a2, a3))

law parts4:
  for +k: Nat
  for +W: List<&2, U32>
  {Codec.parts(it4(k, W), S.Repeat{uS4()}) == Some{FX.fparts(gp4(k, W))} : Maybe<&2, +List<S.Part>>}
def parts4(k, W):
  match k:
    case 0n: {==}
    case 1n++ c:
      match W:
        case Nil{}: {==}
        case Con{+a0, + t0}:
          match t0:
            case Nil{}: {==}
            case Con{+a1, + t1}:
              match t1:
                case Nil{}: {==}
                case Con{+a2, + t2}:
                  match t2:
                    case Nil{}: {==}
                    case Con{+a3, + rest}:
                      F.logic__subst(S.Value, z => {Codec.parts(z, S.Repeat{uS4()}) == Some{FX.fparts(gp4(1n+c, Con{a0, Con{a1, Con{a2, Con{a3, rest}}}}))} : Maybe<&2, +List<S.Part>>}, S.Items{S.UnsignedValue{P.UInt{a0, a1, a2, a3, 0, 0, 0, 0}}, it4(c, rest)}, it4(1n+c, Con{a0, Con{a1, Con{a2, Con{a3, rest}}}}), {==}, rcf(S.UnsignedValue{P.UInt{a0, a1, a2, a3, 0, 0, 0, 0}}, it4(c, rest), uS4(), FX.limbs([a0, a1, a2, a3]), FX.fparts(gp4(c, rest)), eu4(a0, a1, a2, a3), parts4(c, rest)))

law cnt4:
  for +k: Nat
  for +W: List<&2, U32>
  for +hl: {Nat.is_le(w4(k), F.spec_common__length(U32, W)) == True{} : Bool}
  {Codec.count(it4(k, W)) == k : Nat}
def cnt4(k, W, hl):
  match k:
    case 0n: {==}
    case 1n++ c:
      match W:
        case Nil{}: Empty.absurd({Codec.count(it4(1n+c, [])) == 1n+c : Nat}, F.logic__false_true(hl))
        case Con{+a0, + t0}:
          match t0:
            case Nil{}: Empty.absurd({Codec.count(it4(1n+c, [a0])) == 1n+c : Nat}, F.logic__false_true(hl))
            case Con{+a1, + t1}:
              match t1:
                case Nil{}: Empty.absurd({Codec.count(it4(1n+c, [a0, a1])) == 1n+c : Nat}, F.logic__false_true(hl))
                case Con{+a2, + t2}:
                  match t2:
                    case Nil{}: Empty.absurd({Codec.count(it4(1n+c, [a0, a1, a2])) == 1n+c : Nat}, F.logic__false_true(hl))
                    case Con{+a3, + rest}:
                      %Equal.sym(Nat, Codec.count(it4(c, rest)), c, cnt4(c, rest, hl)) : {1n+_ == 1n+c : Nat}
                      {==}

law neq4:
  for +k: Nat
  for +W: List<&2, U32>
  for +hl: {Nat.is_le(w4(k), F.spec_common__length(U32, W)) == True{} : Bool}
  {nn4(k, W) == k : Nat}
def neq4(k, W, hl):
  match k:
    case 0n: {==}
    case 1n++ c:
      match W:
        case Nil{}: Empty.absurd({nn4(1n+c, []) == 1n+c : Nat}, F.logic__false_true(hl))
        case Con{+a0, + t0}:
          match t0:
            case Nil{}: Empty.absurd({nn4(1n+c, [a0]) == 1n+c : Nat}, F.logic__false_true(hl))
            case Con{+a1, + t1}:
              match t1:
                case Nil{}: Empty.absurd({nn4(1n+c, [a0, a1]) == 1n+c : Nat}, F.logic__false_true(hl))
                case Con{+a2, + t2}:
                  match t2:
                    case Nil{}: Empty.absurd({nn4(1n+c, [a0, a1, a2]) == 1n+c : Nat}, F.logic__false_true(hl))
                    case Con{+a3, + rest}:
                      %Equal.sym(Nat, nn4(c, rest), c, neq4(c, rest, hl)) : {1n+_ == 1n+c : Nat}
                      {==}

law nle4:
  for +k: Nat
  for +W: List<&2, U32>
  {Nat.is_le(nn4(k, W), k) == True{} : Bool}
def nle4(k, W):
  match k:
    case 0n: {==}
    case 1n++ c:
      match W:
        case Nil{}: {==}
        case Con{+a0, + t0}:
          match t0:
            case Nil{}: {==}
            case Con{+a1, + t1}:
              match t1:
                case Nil{}: {==}
                case Con{+a2, + t2}:
                  match t2:
                    case Nil{}: {==}
                    case Con{+a3, + rest}:
                      nle4(c, rest)

law flat4:
  for +k: Nat
  for +W: List<&2, U32>
  {FX.flat(gp4(k, W)) == FX.limbs(VS.wtake(w4(nn4(k, W)), W)) : +List<U32>}
def flat4(k, W):
  match k:
    case 0n: {==}
    case 1n++ c:
      match W:
        case Nil{}: {==}
        case Con{+a0, + t0}:
          match t0:
            case Nil{}: {==}
            case Con{+a1, + t1}:
              match t1:
                case Nil{}: {==}
                case Con{+a2, + t2}:
                  match t2:
                    case Nil{}: {==}
                    case Con{+a3, + rest}:
                      %Equal.sym(+List<U32>, FX.flat(gp4(c, rest)), FX.limbs(VS.wtake(w4(nn4(c, rest)), rest)), flat4(c, rest)) : {List.append(&2, U32, FX.limbs([a0, a1, a2, a3]), _) == FX.limbs(a0 <> a1 <> a2 <> a3 <> VS.wtake(w4(nn4(c, rest)), rest)) : +List<U32>}
                      Equal.sym(+List<U32>, FX.limbs(VF.app([a0, a1, a2, a3], VS.wtake(w4(nn4(c, rest)), rest))), List.append(&2, U32, FX.limbs([a0, a1, a2, a3]), FX.limbs(VS.wtake(w4(nn4(c, rest)), rest))), VF.limbs_app([a0, a1, a2, a3], VS.wtake(w4(nn4(c, rest)), rest)))

law lenflat4:
  for +k: Nat
  for +W: List<&2, U32>
  {List.length(&2, U32, FX.flat(gp4(k, W))) == b4(nn4(k, W)) : Nat}
def lenflat4(k, W):
  match k:
    case 0n: {==}
    case 1n++ c:
      match W:
        case Nil{}: {==}
        case Con{+a0, + t0}:
          match t0:
            case Nil{}: {==}
            case Con{+a1, + t1}:
              match t1:
                case Nil{}: {==}
                case Con{+a2, + t2}:
                  match t2:
                    case Nil{}: {==}
                    case Con{+a3, + rest}:
                      %lenflat4(c, rest) : {List.length(&2, U32, List.append(&2, U32, FX.limbs([a0, a1, a2, a3]), FX.flat(gp4(c, rest)))) == 16n+_ : Nat}
                      {==}

law bq4:
  for +c: Nat
  {b4(c) == A.quad(w4(c)) : Nat}
def bq4(c):
  match c:
    case 0n: {==}
    case 1n+ +p:
      %Equal.sym(Nat, b4(p), A.quad(w4(p)), bq4(p)) : {16n+_ == A.quad(4n+w4(p)) : Nat}
      {==}

law mulb4:
  for +c: Nat
  {Nat.mul(c, 16n) == b4(c) : Nat}
def mulb4(c):
  match c:
    case 0n: {==}
    case 1n+ +p:
      %Equal.sym(Nat, Nat.mul(p, 16n), b4(p), mulb4(p)) : {Nat.add(16n, _) == b4(1n+p) : Nat}
      {==}

# The progressive list of k elements over W is one variable part: the limbs of
# the first E k words of W.
def plenc4(+k: Nat, +W: List<&2, U32>, +hl: {Nat.is_le(w4(k), F.spec_common__length(U32, W)) == True{} : Bool}, +fit: {N.fits(4n, b4(k)) == True{} : Bool})
    -> {Codec.bytes(Codec.parts(S.Sequence{it4(k, W)}, S.ProgressiveList{uS4()})) == Some{FX.limbs(VS.wtake(w4(k), W))} : Maybe<&2, +List<U32>>}:
  +G = gp4(k, W)
  +e1 = Equal.trans(Nat, List.length(&2, U32, FX.flat(G)), b4(nn4(k, W)), b4(k), lenflat4(k, W),
    Equal.cong(Nat, Nat, z => b4(z), nn4(k, W), k, neq4(k, W, hl)))
  +fit2 = F.logic__subst(Nat, z => {N.fits(4n, z) == True{} : Bool}, b4(k), List.length(&2, U32, FX.flat(G)), Equal.sym(Nat, List.length(&2, U32, FX.flat(G)), b4(k), e1), fit)
  %Equal.sym(Maybe<&2, +List<S.Part>>, Codec.parts(it4(k, W), S.Repeat{uS4()}), Some{FX.fparts(G)}, parts4(k, W)) :
    {Codec.bytes(Codec.aggregate(_, None{})) == Some{FX.limbs(VS.wtake(w4(k), W))} : Maybe<&2, +List<U32>>}
  %Equal.sym(Maybe<&2, +List<U32>>, Layout.encoding(FX.fparts(G)), Some{FX.flat(G)}, VS.encoding_fparts(G, fit2)) :
    {Codec.bytes(Codec.one(_, None{})) == Some{FX.limbs(VS.wtake(w4(k), W))} : Maybe<&2, +List<U32>>}
  %Equal.sym(+List<U32>, FX.flat(G), FX.limbs(VS.wtake(w4(nn4(k, W)), W)), flat4(k, W)) :
    {Codec.bytes(Codec.one(Some{_}, None{})) == Some{FX.limbs(VS.wtake(w4(k), W))} : Maybe<&2, +List<U32>>}
  %Equal.sym(Nat, nn4(k, W), k, neq4(k, W, hl)) :
    {Codec.bytes(Codec.one(Some{FX.limbs(VS.wtake(w4(_), W))}, None{})) == Some{FX.limbs(VS.wtake(w4(k), W))} : Maybe<&2, +List<U32>>}
  {==}

def REPF4(+its: S.Value, +ps: +List<S.Part>) -> Type:
  {VS.allfix(ps) == True{} : Bool} & {Layout.fixed_size(ps) == b4(Codec.count(its)) : Nat}

def rlen4(+P8: +List<U32>, +pb: +List<S.Part>, +t: S.Value, +l8: {List.length(&2, U32, P8) == 16n : Nat},
    +hs: {Layout.fixed_size(pb) == b4(Codec.count(t)) : Nat})
    -> {Nat.add(List.length(&2, U32, P8), Layout.fixed_size(pb)) == 16n+b4(Codec.count(t)) : Nat}:
  %Equal.sym(Nat, List.length(&2, U32, P8), 16n, l8) : {Nat.add(_, Layout.fixed_size(pb)) == 16n+b4(Codec.count(t)) : Nat}
  %Equal.sym(Nat, Layout.fixed_size(pb), b4(Codec.count(t)), hs) : {16n+_ == 16n+b4(Codec.count(t)) : Nat}
  {==}

def rt24(+P8: +List<U32>, +el: S.Value, +t: S.Value, +pb: +List<S.Part>, +l8: {List.length(&2, U32, P8) == 16n : Nat}, r: REPF4(t, pb))
    -> REPF4(S.Items{el, t}, S.Fixed{P8} <> pb):
  (+ha, +hs) = r
  (ha, rlen4(P8, pb, t, l8, hs))

def rt4(+P8: +List<U32>, +el: S.Value, +t: S.Value, +ps: +List<S.Part>, +mB: Maybe<&2, +List<S.Part>>,
    +eB: {Codec.parts(t, S.Repeat{uS4()}) == mB : Maybe<&2, +List<S.Part>>},
    +l8: {List.length(&2, U32, P8) == 16n : Nat},
    +e: {Codec.concatenate(Some{[S.Fixed{P8}]}, mB) == Some{ps} : Maybe<&2, +List<S.Part>>},
    ih: @+pb: +List<S.Part> -> {Codec.parts(t, S.Repeat{uS4()}) == Some{pb} : Maybe<&2, +List<S.Part>>} -> REPF4(t, pb))
    -> REPF4(S.Items{el, t}, ps):
  match mB:
    case None{}: Empty.absurd(REPF4(S.Items{el, t}, ps), F.logic__none_some(+List<S.Part>, ps, e))
    case Some{+pb}:
      +eps = F.logic__some_inj(+List<S.Part>, S.Fixed{P8} <> pb, ps, e)
      %Equal.sym(+List<S.Part>, ps, S.Fixed{P8} <> pb, Equal.sym(+List<S.Part>, S.Fixed{P8} <> pb, ps, eps)) : REPF4(S.Items{el, t}, _)
      rt24(P8, el, t, pb, l8, ih(pb, eB))

def ru4(+a0: U32, +a1: U32, +a2: U32, +a3: U32, +a4: U32, +a5: U32, +a6: U32, +a7: U32, +t: S.Value, +ps: +List<S.Part>, +b: Bool,
    +e: {Codec.concatenate(Codec.one(SP.optional(b, SP.prefix(16n, SP.full_digits(P.UInt{a0, a1, a2, a3, a4, a5, a6, a7}))), Some{16n}), Codec.parts(t, S.Repeat{uS4()})) == Some{ps} : Maybe<&2, +List<S.Part>>},
    ih: @+pb: +List<S.Part> -> {Codec.parts(t, S.Repeat{uS4()}) == Some{pb} : Maybe<&2, +List<S.Part>>} -> REPF4(t, pb))
    -> REPF4(S.Items{S.UnsignedValue{P.UInt{a0, a1, a2, a3, a4, a5, a6, a7}}, t}, ps):
  match b:
    case False{}: Empty.absurd(REPF4(S.Items{S.UnsignedValue{P.UInt{a0, a1, a2, a3, a4, a5, a6, a7}}, t}, ps), F.logic__none_some(+List<S.Part>, ps, e))
    case True{}: rt4(SP.prefix(16n, SP.full_digits(P.UInt{a0, a1, a2, a3, a4, a5, a6, a7})), S.UnsignedValue{P.UInt{a0, a1, a2, a3, a4, a5, a6, a7}}, t, ps, Codec.parts(t, S.Repeat{uS4()}), {==}, {==}, e, ih)

law rep_facts4:
  for +its: S.Value
  for +ps: +List<S.Part>
  for +e: {Codec.parts(its, S.Repeat{uS4()}) == Some{ps} : Maybe<&2, +List<S.Part>>}
  REPF4(its, ps)
def rep_facts4(its, ps, e):
  match its:
    case S.EmptyItems{}:
      +eps = F.logic__some_inj(+List<S.Part>, [], ps, e)
      %Equal.sym(+List<S.Part>, ps, [], Equal.sym(+List<S.Part>, [], ps, eps)) : REPF4(S.EmptyItems{}, _)
      ({==}, {==})
    case S.Items{S.UnsignedValue{P.UInt{+a0, +a1, +a2, +a3, +a4, +a5, +a6, +a7}}, +t}:
      ru4(a0, a1, a2, a3, a4, a5, a6, a7, t, ps, SP.uint_domain(P.U128{}, P.UInt{a0, a1, a2, a3, a4, a5, a6, a7}), e, pb => eb => rep_facts4(t, pb, eb))
    case S.BooleanValue{+b}: Empty.absurd(REPF4(S.BooleanValue{b}, ps), F.logic__none_some(+List<S.Part>, ps, e))
    case S.UnsignedValue{+u}: Empty.absurd(REPF4(S.UnsignedValue{u}, ps), F.logic__none_some(+List<S.Part>, ps, e))
    case S.BytesValue{+xs}: Empty.absurd(REPF4(S.BytesValue{xs}, ps), F.logic__none_some(+List<S.Part>, ps, e))
    case S.BitsValue{+bs}: Empty.absurd(REPF4(S.BitsValue{bs}, ps), F.logic__none_some(+List<S.Part>, ps, e))
    case S.Sequence{+it}: Empty.absurd(REPF4(S.Sequence{it}, ps), F.logic__none_some(+List<S.Part>, ps, e))
    case S.Items{S.BooleanValue{+b}, +t}: Empty.absurd(REPF4(S.Items{S.BooleanValue{b}, t}, ps), F.logic__none_some(+List<S.Part>, ps, e))
    case S.Items{S.BytesValue{+xs}, +t}: Empty.absurd(REPF4(S.Items{S.BytesValue{xs}, t}, ps), F.logic__none_some(+List<S.Part>, ps, e))
    case S.Items{S.BitsValue{+bs}, +t}: Empty.absurd(REPF4(S.Items{S.BitsValue{bs}, t}, ps), F.logic__none_some(+List<S.Part>, ps, e))
    case S.Items{S.Sequence{+it}, +t}: Empty.absurd(REPF4(S.Items{S.Sequence{it}, t}, ps), F.logic__none_some(+List<S.Part>, ps, e))
    case S.Items{S.Items{+hd, +tl}, +t}: Empty.absurd(REPF4(S.Items{S.Items{hd, tl}, t}, ps), F.logic__none_some(+List<S.Part>, ps, e))
    case S.Items{S.EmptyItems{}, +t}: Empty.absurd(REPF4(S.Items{S.EmptyItems{}, t}, ps), F.logic__none_some(+List<S.Part>, ps, e))
    case S.Items{S.Selected{+sel, +sv}, +t}: Empty.absurd(REPF4(S.Items{S.Selected{sel, sv}, t}, ps), F.logic__none_some(+List<S.Part>, ps, e))
    case S.Items{S.NullValue{}, +t}: Empty.absurd(REPF4(S.Items{S.NullValue{}, t}, ps), F.logic__none_some(+List<S.Part>, ps, e))
    case S.Selected{+sel, +sv}: Empty.absurd(REPF4(S.Selected{sel, sv}, ps), F.logic__none_some(+List<S.Part>, ps, e))
    case S.NullValue{}: Empty.absurd(REPF4(S.NullValue{}, ps), F.logic__none_some(+List<S.Part>, ps, e))

# ---- elements of 8 word(s) ------------------------------------------------------------

def uS8() -> S.Schema: S.Unsigned{P.U256{}}

def w8(k: Nat) -> Nat:
  match k:
    case 0n: 0n
    case 1n+c: 8n+w8(c)

def b8(k: Nat) -> Nat:
  match k:
    case 0n: 0n
    case 1n+c: 32n+b8(c)

def it8(k: Nat, W: List<&2, U32>) -> S.Value:
  match k:
    case 0n: S.EmptyItems{}
    case 1n+c:
      match W:
        case Nil{}: S.EmptyItems{}
        case Con{+a0, t0}:
          match t0:
            case Nil{}: S.EmptyItems{}
            case Con{+a1, t1}:
              match t1:
                case Nil{}: S.EmptyItems{}
                case Con{+a2, t2}:
                  match t2:
                    case Nil{}: S.EmptyItems{}
                    case Con{+a3, t3}:
                      match t3:
                        case Nil{}: S.EmptyItems{}
                        case Con{+a4, t4}:
                          match t4:
                            case Nil{}: S.EmptyItems{}
                            case Con{+a5, t5}:
                              match t5:
                                case Nil{}: S.EmptyItems{}
                                case Con{+a6, t6}:
                                  match t6:
                                    case Nil{}: S.EmptyItems{}
                                    case Con{+a7, rest}:
                                      S.Items{S.UnsignedValue{P.UInt{a0, a1, a2, a3, a4, a5, a6, a7}}, it8(c, rest)}

def gp8(k: Nat, W: List<&2, U32>) -> +List<+List<U32>>:
  match k:
    case 0n: []
    case 1n+c:
      match W:
        case Nil{}: []
        case Con{+a0, t0}:
          match t0:
            case Nil{}: []
            case Con{+a1, t1}:
              match t1:
                case Nil{}: []
                case Con{+a2, t2}:
                  match t2:
                    case Nil{}: []
                    case Con{+a3, t3}:
                      match t3:
                        case Nil{}: []
                        case Con{+a4, t4}:
                          match t4:
                            case Nil{}: []
                            case Con{+a5, t5}:
                              match t5:
                                case Nil{}: []
                                case Con{+a6, t6}:
                                  match t6:
                                    case Nil{}: []
                                    case Con{+a7, rest}:
                                      [a0, a1, a2, a3, a4, a5, a6, a7] <> gp8(c, rest)

def nn8(k: Nat, W: List<&2, U32>) -> Nat:
  match k:
    case 0n: 0n
    case 1n+c:
      match W:
        case Nil{}: 0n
        case Con{+a0, t0}:
          match t0:
            case Nil{}: 0n
            case Con{+a1, t1}:
              match t1:
                case Nil{}: 0n
                case Con{+a2, t2}:
                  match t2:
                    case Nil{}: 0n
                    case Con{+a3, t3}:
                      match t3:
                        case Nil{}: 0n
                        case Con{+a4, t4}:
                          match t4:
                            case Nil{}: 0n
                            case Con{+a5, t5}:
                              match t5:
                                case Nil{}: 0n
                                case Con{+a6, t6}:
                                  match t6:
                                    case Nil{}: 0n
                                    case Con{+a7, rest}:
                                      1n+nn8(c, rest)

def eu8(+a0: U32, +a1: U32, +a2: U32, +a3: U32, +a4: U32, +a5: U32, +a6: U32, +a7: U32) -> {Codec.parts(S.UnsignedValue{P.UInt{a0, a1, a2, a3, a4, a5, a6, a7}}, uS8()) == Some{[S.Fixed{FX.limbs([a0, a1, a2, a3, a4, a5, a6, a7])}]} : Maybe<&2, +List<S.Part>>}:
  F.logic__subst(S.Schema, z => {Codec.parts(S.UnsignedValue{P.UInt{a0, a1, a2, a3, a4, a5, a6, a7}}, z) == Some{[S.Fixed{FX.limbs([a0, a1, a2, a3, a4, a5, a6, a7])}]} : Maybe<&2, +List<S.Part>>}, S.Unsigned{P.U256{}}, uS8(), {==}, FX.uint256_part(a0, a1, a2, a3, a4, a5, a6, a7))

law parts8:
  for +k: Nat
  for +W: List<&2, U32>
  {Codec.parts(it8(k, W), S.Repeat{uS8()}) == Some{FX.fparts(gp8(k, W))} : Maybe<&2, +List<S.Part>>}
def parts8(k, W):
  match k:
    case 0n: {==}
    case 1n++ c:
      match W:
        case Nil{}: {==}
        case Con{+a0, + t0}:
          match t0:
            case Nil{}: {==}
            case Con{+a1, + t1}:
              match t1:
                case Nil{}: {==}
                case Con{+a2, + t2}:
                  match t2:
                    case Nil{}: {==}
                    case Con{+a3, + t3}:
                      match t3:
                        case Nil{}: {==}
                        case Con{+a4, + t4}:
                          match t4:
                            case Nil{}: {==}
                            case Con{+a5, + t5}:
                              match t5:
                                case Nil{}: {==}
                                case Con{+a6, + t6}:
                                  match t6:
                                    case Nil{}: {==}
                                    case Con{+a7, + rest}:
                                      F.logic__subst(S.Value, z => {Codec.parts(z, S.Repeat{uS8()}) == Some{FX.fparts(gp8(1n+c, Con{a0, Con{a1, Con{a2, Con{a3, Con{a4, Con{a5, Con{a6, Con{a7, rest}}}}}}}}))} : Maybe<&2, +List<S.Part>>}, S.Items{S.UnsignedValue{P.UInt{a0, a1, a2, a3, a4, a5, a6, a7}}, it8(c, rest)}, it8(1n+c, Con{a0, Con{a1, Con{a2, Con{a3, Con{a4, Con{a5, Con{a6, Con{a7, rest}}}}}}}}), {==}, rcf(S.UnsignedValue{P.UInt{a0, a1, a2, a3, a4, a5, a6, a7}}, it8(c, rest), uS8(), FX.limbs([a0, a1, a2, a3, a4, a5, a6, a7]), FX.fparts(gp8(c, rest)), eu8(a0, a1, a2, a3, a4, a5, a6, a7), parts8(c, rest)))

law cnt8:
  for +k: Nat
  for +W: List<&2, U32>
  for +hl: {Nat.is_le(w8(k), F.spec_common__length(U32, W)) == True{} : Bool}
  {Codec.count(it8(k, W)) == k : Nat}
def cnt8(k, W, hl):
  match k:
    case 0n: {==}
    case 1n++ c:
      match W:
        case Nil{}: Empty.absurd({Codec.count(it8(1n+c, [])) == 1n+c : Nat}, F.logic__false_true(hl))
        case Con{+a0, + t0}:
          match t0:
            case Nil{}: Empty.absurd({Codec.count(it8(1n+c, [a0])) == 1n+c : Nat}, F.logic__false_true(hl))
            case Con{+a1, + t1}:
              match t1:
                case Nil{}: Empty.absurd({Codec.count(it8(1n+c, [a0, a1])) == 1n+c : Nat}, F.logic__false_true(hl))
                case Con{+a2, + t2}:
                  match t2:
                    case Nil{}: Empty.absurd({Codec.count(it8(1n+c, [a0, a1, a2])) == 1n+c : Nat}, F.logic__false_true(hl))
                    case Con{+a3, + t3}:
                      match t3:
                        case Nil{}: Empty.absurd({Codec.count(it8(1n+c, [a0, a1, a2, a3])) == 1n+c : Nat}, F.logic__false_true(hl))
                        case Con{+a4, + t4}:
                          match t4:
                            case Nil{}: Empty.absurd({Codec.count(it8(1n+c, [a0, a1, a2, a3, a4])) == 1n+c : Nat}, F.logic__false_true(hl))
                            case Con{+a5, + t5}:
                              match t5:
                                case Nil{}: Empty.absurd({Codec.count(it8(1n+c, [a0, a1, a2, a3, a4, a5])) == 1n+c : Nat}, F.logic__false_true(hl))
                                case Con{+a6, + t6}:
                                  match t6:
                                    case Nil{}: Empty.absurd({Codec.count(it8(1n+c, [a0, a1, a2, a3, a4, a5, a6])) == 1n+c : Nat}, F.logic__false_true(hl))
                                    case Con{+a7, + rest}:
                                      %Equal.sym(Nat, Codec.count(it8(c, rest)), c, cnt8(c, rest, hl)) : {1n+_ == 1n+c : Nat}
                                      {==}

law neq8:
  for +k: Nat
  for +W: List<&2, U32>
  for +hl: {Nat.is_le(w8(k), F.spec_common__length(U32, W)) == True{} : Bool}
  {nn8(k, W) == k : Nat}
def neq8(k, W, hl):
  match k:
    case 0n: {==}
    case 1n++ c:
      match W:
        case Nil{}: Empty.absurd({nn8(1n+c, []) == 1n+c : Nat}, F.logic__false_true(hl))
        case Con{+a0, + t0}:
          match t0:
            case Nil{}: Empty.absurd({nn8(1n+c, [a0]) == 1n+c : Nat}, F.logic__false_true(hl))
            case Con{+a1, + t1}:
              match t1:
                case Nil{}: Empty.absurd({nn8(1n+c, [a0, a1]) == 1n+c : Nat}, F.logic__false_true(hl))
                case Con{+a2, + t2}:
                  match t2:
                    case Nil{}: Empty.absurd({nn8(1n+c, [a0, a1, a2]) == 1n+c : Nat}, F.logic__false_true(hl))
                    case Con{+a3, + t3}:
                      match t3:
                        case Nil{}: Empty.absurd({nn8(1n+c, [a0, a1, a2, a3]) == 1n+c : Nat}, F.logic__false_true(hl))
                        case Con{+a4, + t4}:
                          match t4:
                            case Nil{}: Empty.absurd({nn8(1n+c, [a0, a1, a2, a3, a4]) == 1n+c : Nat}, F.logic__false_true(hl))
                            case Con{+a5, + t5}:
                              match t5:
                                case Nil{}: Empty.absurd({nn8(1n+c, [a0, a1, a2, a3, a4, a5]) == 1n+c : Nat}, F.logic__false_true(hl))
                                case Con{+a6, + t6}:
                                  match t6:
                                    case Nil{}: Empty.absurd({nn8(1n+c, [a0, a1, a2, a3, a4, a5, a6]) == 1n+c : Nat}, F.logic__false_true(hl))
                                    case Con{+a7, + rest}:
                                      %Equal.sym(Nat, nn8(c, rest), c, neq8(c, rest, hl)) : {1n+_ == 1n+c : Nat}
                                      {==}

law nle8:
  for +k: Nat
  for +W: List<&2, U32>
  {Nat.is_le(nn8(k, W), k) == True{} : Bool}
def nle8(k, W):
  match k:
    case 0n: {==}
    case 1n++ c:
      match W:
        case Nil{}: {==}
        case Con{+a0, + t0}:
          match t0:
            case Nil{}: {==}
            case Con{+a1, + t1}:
              match t1:
                case Nil{}: {==}
                case Con{+a2, + t2}:
                  match t2:
                    case Nil{}: {==}
                    case Con{+a3, + t3}:
                      match t3:
                        case Nil{}: {==}
                        case Con{+a4, + t4}:
                          match t4:
                            case Nil{}: {==}
                            case Con{+a5, + t5}:
                              match t5:
                                case Nil{}: {==}
                                case Con{+a6, + t6}:
                                  match t6:
                                    case Nil{}: {==}
                                    case Con{+a7, + rest}:
                                      nle8(c, rest)

law flat8:
  for +k: Nat
  for +W: List<&2, U32>
  {FX.flat(gp8(k, W)) == FX.limbs(VS.wtake(w8(nn8(k, W)), W)) : +List<U32>}
def flat8(k, W):
  match k:
    case 0n: {==}
    case 1n++ c:
      match W:
        case Nil{}: {==}
        case Con{+a0, + t0}:
          match t0:
            case Nil{}: {==}
            case Con{+a1, + t1}:
              match t1:
                case Nil{}: {==}
                case Con{+a2, + t2}:
                  match t2:
                    case Nil{}: {==}
                    case Con{+a3, + t3}:
                      match t3:
                        case Nil{}: {==}
                        case Con{+a4, + t4}:
                          match t4:
                            case Nil{}: {==}
                            case Con{+a5, + t5}:
                              match t5:
                                case Nil{}: {==}
                                case Con{+a6, + t6}:
                                  match t6:
                                    case Nil{}: {==}
                                    case Con{+a7, + rest}:
                                      %Equal.sym(+List<U32>, FX.flat(gp8(c, rest)), FX.limbs(VS.wtake(w8(nn8(c, rest)), rest)), flat8(c, rest)) : {List.append(&2, U32, FX.limbs([a0, a1, a2, a3, a4, a5, a6, a7]), _) == FX.limbs(a0 <> a1 <> a2 <> a3 <> a4 <> a5 <> a6 <> a7 <> VS.wtake(w8(nn8(c, rest)), rest)) : +List<U32>}
                                      Equal.sym(+List<U32>, FX.limbs(VF.app([a0, a1, a2, a3, a4, a5, a6, a7], VS.wtake(w8(nn8(c, rest)), rest))), List.append(&2, U32, FX.limbs([a0, a1, a2, a3, a4, a5, a6, a7]), FX.limbs(VS.wtake(w8(nn8(c, rest)), rest))), VF.limbs_app([a0, a1, a2, a3, a4, a5, a6, a7], VS.wtake(w8(nn8(c, rest)), rest)))

law lenflat8:
  for +k: Nat
  for +W: List<&2, U32>
  {List.length(&2, U32, FX.flat(gp8(k, W))) == b8(nn8(k, W)) : Nat}
def lenflat8(k, W):
  match k:
    case 0n: {==}
    case 1n++ c:
      match W:
        case Nil{}: {==}
        case Con{+a0, + t0}:
          match t0:
            case Nil{}: {==}
            case Con{+a1, + t1}:
              match t1:
                case Nil{}: {==}
                case Con{+a2, + t2}:
                  match t2:
                    case Nil{}: {==}
                    case Con{+a3, + t3}:
                      match t3:
                        case Nil{}: {==}
                        case Con{+a4, + t4}:
                          match t4:
                            case Nil{}: {==}
                            case Con{+a5, + t5}:
                              match t5:
                                case Nil{}: {==}
                                case Con{+a6, + t6}:
                                  match t6:
                                    case Nil{}: {==}
                                    case Con{+a7, + rest}:
                                      %lenflat8(c, rest) : {List.length(&2, U32, List.append(&2, U32, FX.limbs([a0, a1, a2, a3, a4, a5, a6, a7]), FX.flat(gp8(c, rest)))) == 32n+_ : Nat}
                                      {==}

law bq8:
  for +c: Nat
  {b8(c) == A.quad(w8(c)) : Nat}
def bq8(c):
  match c:
    case 0n: {==}
    case 1n+ +p:
      %Equal.sym(Nat, b8(p), A.quad(w8(p)), bq8(p)) : {32n+_ == A.quad(8n+w8(p)) : Nat}
      {==}

law mulb8:
  for +c: Nat
  {Nat.mul(c, 32n) == b8(c) : Nat}
def mulb8(c):
  match c:
    case 0n: {==}
    case 1n+ +p:
      %Equal.sym(Nat, Nat.mul(p, 32n), b8(p), mulb8(p)) : {Nat.add(32n, _) == b8(1n+p) : Nat}
      {==}

# The progressive list of k elements over W is one variable part: the limbs of
# the first E k words of W.
def plenc8(+k: Nat, +W: List<&2, U32>, +hl: {Nat.is_le(w8(k), F.spec_common__length(U32, W)) == True{} : Bool}, +fit: {N.fits(4n, b8(k)) == True{} : Bool})
    -> {Codec.bytes(Codec.parts(S.Sequence{it8(k, W)}, S.ProgressiveList{uS8()})) == Some{FX.limbs(VS.wtake(w8(k), W))} : Maybe<&2, +List<U32>>}:
  +G = gp8(k, W)
  +e1 = Equal.trans(Nat, List.length(&2, U32, FX.flat(G)), b8(nn8(k, W)), b8(k), lenflat8(k, W),
    Equal.cong(Nat, Nat, z => b8(z), nn8(k, W), k, neq8(k, W, hl)))
  +fit2 = F.logic__subst(Nat, z => {N.fits(4n, z) == True{} : Bool}, b8(k), List.length(&2, U32, FX.flat(G)), Equal.sym(Nat, List.length(&2, U32, FX.flat(G)), b8(k), e1), fit)
  %Equal.sym(Maybe<&2, +List<S.Part>>, Codec.parts(it8(k, W), S.Repeat{uS8()}), Some{FX.fparts(G)}, parts8(k, W)) :
    {Codec.bytes(Codec.aggregate(_, None{})) == Some{FX.limbs(VS.wtake(w8(k), W))} : Maybe<&2, +List<U32>>}
  %Equal.sym(Maybe<&2, +List<U32>>, Layout.encoding(FX.fparts(G)), Some{FX.flat(G)}, VS.encoding_fparts(G, fit2)) :
    {Codec.bytes(Codec.one(_, None{})) == Some{FX.limbs(VS.wtake(w8(k), W))} : Maybe<&2, +List<U32>>}
  %Equal.sym(+List<U32>, FX.flat(G), FX.limbs(VS.wtake(w8(nn8(k, W)), W)), flat8(k, W)) :
    {Codec.bytes(Codec.one(Some{_}, None{})) == Some{FX.limbs(VS.wtake(w8(k), W))} : Maybe<&2, +List<U32>>}
  %Equal.sym(Nat, nn8(k, W), k, neq8(k, W, hl)) :
    {Codec.bytes(Codec.one(Some{FX.limbs(VS.wtake(w8(_), W))}, None{})) == Some{FX.limbs(VS.wtake(w8(k), W))} : Maybe<&2, +List<U32>>}
  {==}

def REPF8(+its: S.Value, +ps: +List<S.Part>) -> Type:
  {VS.allfix(ps) == True{} : Bool} & {Layout.fixed_size(ps) == b8(Codec.count(its)) : Nat}

def rlen8(+P8: +List<U32>, +pb: +List<S.Part>, +t: S.Value, +l8: {List.length(&2, U32, P8) == 32n : Nat},
    +hs: {Layout.fixed_size(pb) == b8(Codec.count(t)) : Nat})
    -> {Nat.add(List.length(&2, U32, P8), Layout.fixed_size(pb)) == 32n+b8(Codec.count(t)) : Nat}:
  %Equal.sym(Nat, List.length(&2, U32, P8), 32n, l8) : {Nat.add(_, Layout.fixed_size(pb)) == 32n+b8(Codec.count(t)) : Nat}
  %Equal.sym(Nat, Layout.fixed_size(pb), b8(Codec.count(t)), hs) : {32n+_ == 32n+b8(Codec.count(t)) : Nat}
  {==}

def rt28(+P8: +List<U32>, +el: S.Value, +t: S.Value, +pb: +List<S.Part>, +l8: {List.length(&2, U32, P8) == 32n : Nat}, r: REPF8(t, pb))
    -> REPF8(S.Items{el, t}, S.Fixed{P8} <> pb):
  (+ha, +hs) = r
  (ha, rlen8(P8, pb, t, l8, hs))

def rt8(+P8: +List<U32>, +el: S.Value, +t: S.Value, +ps: +List<S.Part>, +mB: Maybe<&2, +List<S.Part>>,
    +eB: {Codec.parts(t, S.Repeat{uS8()}) == mB : Maybe<&2, +List<S.Part>>},
    +l8: {List.length(&2, U32, P8) == 32n : Nat},
    +e: {Codec.concatenate(Some{[S.Fixed{P8}]}, mB) == Some{ps} : Maybe<&2, +List<S.Part>>},
    ih: @+pb: +List<S.Part> -> {Codec.parts(t, S.Repeat{uS8()}) == Some{pb} : Maybe<&2, +List<S.Part>>} -> REPF8(t, pb))
    -> REPF8(S.Items{el, t}, ps):
  match mB:
    case None{}: Empty.absurd(REPF8(S.Items{el, t}, ps), F.logic__none_some(+List<S.Part>, ps, e))
    case Some{+pb}:
      +eps = F.logic__some_inj(+List<S.Part>, S.Fixed{P8} <> pb, ps, e)
      %Equal.sym(+List<S.Part>, ps, S.Fixed{P8} <> pb, Equal.sym(+List<S.Part>, S.Fixed{P8} <> pb, ps, eps)) : REPF8(S.Items{el, t}, _)
      rt28(P8, el, t, pb, l8, ih(pb, eB))

def ru8(+a0: U32, +a1: U32, +a2: U32, +a3: U32, +a4: U32, +a5: U32, +a6: U32, +a7: U32, +t: S.Value, +ps: +List<S.Part>, +b: Bool,
    +e: {Codec.concatenate(Codec.one(SP.optional(b, SP.prefix(32n, SP.full_digits(P.UInt{a0, a1, a2, a3, a4, a5, a6, a7}))), Some{32n}), Codec.parts(t, S.Repeat{uS8()})) == Some{ps} : Maybe<&2, +List<S.Part>>},
    ih: @+pb: +List<S.Part> -> {Codec.parts(t, S.Repeat{uS8()}) == Some{pb} : Maybe<&2, +List<S.Part>>} -> REPF8(t, pb))
    -> REPF8(S.Items{S.UnsignedValue{P.UInt{a0, a1, a2, a3, a4, a5, a6, a7}}, t}, ps):
  match b:
    case False{}: Empty.absurd(REPF8(S.Items{S.UnsignedValue{P.UInt{a0, a1, a2, a3, a4, a5, a6, a7}}, t}, ps), F.logic__none_some(+List<S.Part>, ps, e))
    case True{}: rt8(SP.prefix(32n, SP.full_digits(P.UInt{a0, a1, a2, a3, a4, a5, a6, a7})), S.UnsignedValue{P.UInt{a0, a1, a2, a3, a4, a5, a6, a7}}, t, ps, Codec.parts(t, S.Repeat{uS8()}), {==}, {==}, e, ih)

law rep_facts8:
  for +its: S.Value
  for +ps: +List<S.Part>
  for +e: {Codec.parts(its, S.Repeat{uS8()}) == Some{ps} : Maybe<&2, +List<S.Part>>}
  REPF8(its, ps)
def rep_facts8(its, ps, e):
  match its:
    case S.EmptyItems{}:
      +eps = F.logic__some_inj(+List<S.Part>, [], ps, e)
      %Equal.sym(+List<S.Part>, ps, [], Equal.sym(+List<S.Part>, [], ps, eps)) : REPF8(S.EmptyItems{}, _)
      ({==}, {==})
    case S.Items{S.UnsignedValue{P.UInt{+a0, +a1, +a2, +a3, +a4, +a5, +a6, +a7}}, +t}:
      ru8(a0, a1, a2, a3, a4, a5, a6, a7, t, ps, SP.uint_domain(P.U256{}, P.UInt{a0, a1, a2, a3, a4, a5, a6, a7}), e, pb => eb => rep_facts8(t, pb, eb))
    case S.BooleanValue{+b}: Empty.absurd(REPF8(S.BooleanValue{b}, ps), F.logic__none_some(+List<S.Part>, ps, e))
    case S.UnsignedValue{+u}: Empty.absurd(REPF8(S.UnsignedValue{u}, ps), F.logic__none_some(+List<S.Part>, ps, e))
    case S.BytesValue{+xs}: Empty.absurd(REPF8(S.BytesValue{xs}, ps), F.logic__none_some(+List<S.Part>, ps, e))
    case S.BitsValue{+bs}: Empty.absurd(REPF8(S.BitsValue{bs}, ps), F.logic__none_some(+List<S.Part>, ps, e))
    case S.Sequence{+it}: Empty.absurd(REPF8(S.Sequence{it}, ps), F.logic__none_some(+List<S.Part>, ps, e))
    case S.Items{S.BooleanValue{+b}, +t}: Empty.absurd(REPF8(S.Items{S.BooleanValue{b}, t}, ps), F.logic__none_some(+List<S.Part>, ps, e))
    case S.Items{S.BytesValue{+xs}, +t}: Empty.absurd(REPF8(S.Items{S.BytesValue{xs}, t}, ps), F.logic__none_some(+List<S.Part>, ps, e))
    case S.Items{S.BitsValue{+bs}, +t}: Empty.absurd(REPF8(S.Items{S.BitsValue{bs}, t}, ps), F.logic__none_some(+List<S.Part>, ps, e))
    case S.Items{S.Sequence{+it}, +t}: Empty.absurd(REPF8(S.Items{S.Sequence{it}, t}, ps), F.logic__none_some(+List<S.Part>, ps, e))
    case S.Items{S.Items{+hd, +tl}, +t}: Empty.absurd(REPF8(S.Items{S.Items{hd, tl}, t}, ps), F.logic__none_some(+List<S.Part>, ps, e))
    case S.Items{S.EmptyItems{}, +t}: Empty.absurd(REPF8(S.Items{S.EmptyItems{}, t}, ps), F.logic__none_some(+List<S.Part>, ps, e))
    case S.Items{S.Selected{+sel, +sv}, +t}: Empty.absurd(REPF8(S.Items{S.Selected{sel, sv}, t}, ps), F.logic__none_some(+List<S.Part>, ps, e))
    case S.Items{S.NullValue{}, +t}: Empty.absurd(REPF8(S.Items{S.NullValue{}, t}, ps), F.logic__none_some(+List<S.Part>, ps, e))
    case S.Selected{+sel, +sv}: Empty.absurd(REPF8(S.Selected{sel, sv}, ps), F.logic__none_some(+List<S.Part>, ps, e))
    case S.NullValue{}: Empty.absurd(REPF8(S.NullValue{}, ps), F.logic__none_some(+List<S.Part>, ps, e))

