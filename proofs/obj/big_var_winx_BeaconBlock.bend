            hwj(d, t, n, x, off, len, eo, hd, hw, pf, O0(t, x), len, FD.logic__subst(Nat, z => {Nat.is_le(z, U32.to_nat(len)) == True{} : Bool}, 84n, U32.to_nat(O0(t, x)), Equal.sym(Nat, U32.to_nat(O0(t, x)), 84n, Equal.cong(U32, Nat, z => U32.to_nat(z), O0(t, x), 84, FD.u32alg__eq_of(O0(t, x), 84, hI1))), hF), Order.reflexive(U32.to_nat(len))), pf)) :
        {T.BeaconBlock_v1(off, len, O0(t, x), _) == (BF(t, n), K2(t, x, off, len)) : B.Buf & Bool}
      okc1(d, t, n, x, off, len, eo, hd, hw, pf, hF, hI1, IT2(t, x, off, len), {==})

def okl(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +a: Bool, +ea: {IT0(t, x, off, len) == a : Bool})
