      +is_ = F.u32__injective(s, 0, es)
      +ib = F.u32__injective(b, 2, eb)
      +h1 = F.logic__subst(U32, z => {O.tail_zero(z, old) == True{} : Bool}, r, 3, ir, h)
      +c = tzc_3_0_2(old, x, h1)
      +c2 = F.logic__subst(U32, z => {O.tail_zero(3, O.merge_word(old, x, s, z)) == True{} : Bool}, 2, b, Equal.sym(U32, b, 2, ib), F.logic__subst(U32, z => {O.tail_zero(3, O.merge_word(old, x, z, 2)) == True{} : Bool}, 0, s, Equal.sym(U32, s, 0, is_), c))
      F.logic__subst(U32, z => {O.tail_zero(z, O.merge_word(old, x, s, b)) == True{} : Bool}, 3, r, Equal.sym(U32, r, 3, ir), c2)
    case 3n 0n 3n+ +u: Empty.absurd({O.tail_zero(r, O.merge_word(old, x, s, b)) == True{} : Bool}, F.logic__false_true(hb2))
    case 3n 1n 0n: Empty.absurd({O.tail_zero(r, O.merge_word(old, x, s, b)) == True{} : Bool}, F.logic__false_true(hb1))
    case 3n 1n 1n:
      +ir = F.u32__injective(r, 3, er)
      +is_ = F.u32__injective(s, 1, es)
      +ib = F.u32__injective(b, 1, eb)
      +h1 = F.logic__subst(U32, z => {O.tail_zero(z, old) == True{} : Bool}, r, 3, ir, h)
      +c = tzc_3_1_1(old, x, h1)
      +c2 = F.logic__subst(U32, z => {O.tail_zero(3, O.merge_word(old, x, s, z)) == True{} : Bool}, 1, b, Equal.sym(U32, b, 1, ib), F.logic__subst(U32, z => {O.tail_zero(3, O.merge_word(old, x, z, 1)) == True{} : Bool}, 1, s, Equal.sym(U32, s, 1, is_), c))
      F.logic__subst(U32, z => {O.tail_zero(z, O.merge_word(old, x, s, b)) == True{} : Bool}, 3, r, Equal.sym(U32, r, 3, ir), c2)
    case 3n 1n 2n:
      +ir = F.u32__injective(r, 3, er)
      +is_ = F.u32__injective(s, 1, es)
      +ib = F.u32__injective(b, 2, eb)
      +h1 = F.logic__subst(U32, z => {O.tail_zero(z, old) == True{} : Bool}, r, 3, ir, h)
      +c = tzc_3_1_2(old, x, h1)
      +c2 = F.logic__subst(U32, z => {O.tail_zero(3, O.merge_word(old, x, s, z)) == True{} : Bool}, 2, b, Equal.sym(U32, b, 2, ib), F.logic__subst(U32, z => {O.tail_zero(3, O.merge_word(old, x, z, 2)) == True{} : Bool}, 1, s, Equal.sym(U32, s, 1, is_), c))
      F.logic__subst(U32, z => {O.tail_zero(z, O.merge_word(old, x, s, b)) == True{} : Bool}, 3, r, Equal.sym(U32, r, 3, ir), c2)
    case 3n 1n 3n+ +u: Empty.absurd({O.tail_zero(r, O.merge_word(old, x, s, b)) == True{} : Bool}, F.logic__false_true(hb2))
    case 3n 2n 0n: Empty.absurd({O.tail_zero(r, O.merge_word(old, x, s, b)) == True{} : Bool}, F.logic__false_true(hb1))
    case 3n 2n 1n:
      +ir = F.u32__injective(r, 3, er)
      +is_ = F.u32__injective(s, 2, es)
      +ib = F.u32__injective(b, 1, eb)
      +h1 = F.logic__subst(U32, z => {O.tail_zero(z, old) == True{} : Bool}, r, 3, ir, h)
      +c = tzc_3_2_1(old, x, h1)
      +c2 = F.logic__subst(U32, z => {O.tail_zero(3, O.merge_word(old, x, s, z)) == True{} : Bool}, 1, b, Equal.sym(U32, b, 1, ib), F.logic__subst(U32, z => {O.tail_zero(3, O.merge_word(old, x, z, 1)) == True{} : Bool}, 2, s, Equal.sym(U32, s, 2, is_), c))
      F.logic__subst(U32, z => {O.tail_zero(z, O.merge_word(old, x, s, b)) == True{} : Bool}, 3, r, Equal.sym(U32, r, 3, ir), c2)
    case 3n 2n 2n: Empty.absurd({O.tail_zero(r, O.merge_word(old, x, s, b)) == True{} : Bool}, F.logic__false_true(hsb))
    case 3n 2n 3n+ +u: Empty.absurd({O.tail_zero(r, O.merge_word(old, x, s, b)) == True{} : Bool}, F.logic__false_true(hb2))
    case 3n 3n 0n: Empty.absurd({O.tail_zero(r, O.merge_word(old, x, s, b)) == True{} : Bool}, F.logic__false_true(hb1))
    case 3n 3n 1n: Empty.absurd({O.tail_zero(r, O.merge_word(old, x, s, b)) == True{} : Bool}, F.logic__false_true(hsb))
    case 3n 3n 2n: Empty.absurd({O.tail_zero(r, O.merge_word(old, x, s, b)) == True{} : Bool}, F.logic__false_true(hsb))
    case 3n 3n 3n+ +u: Empty.absurd({O.tail_zero(r, O.merge_word(old, x, s, b)) == True{} : Bool}, F.logic__false_true(hb2))
    case 3n 4n+ +q 0n: Empty.absurd({O.tail_zero(r, O.merge_word(old, x, s, b)) == True{} : Bool}, F.logic__false_true(hb1))
    case 3n 4n+ +q 1n: Empty.absurd({O.tail_zero(r, O.merge_word(old, x, s, b)) == True{} : Bool}, F.logic__false_true(hsb))
    case 3n 4n+ +q 2n: Empty.absurd({O.tail_zero(r, O.merge_word(old, x, s, b)) == True{} : Bool}, F.logic__false_true(hsb))
    case 3n 4n+ +q 3n+ +u: Empty.absurd({O.tail_zero(r, O.merge_word(old, x, s, b)) == True{} : Bool}, F.logic__false_true(hb2))
    case 4n+ +p _ _: Empty.absurd({O.tail_zero(r, O.merge_word(old, x, s, b)) == True{} : Bool}, F.logic__false_true(hr))

# the tail of the last word after a write of b bytes at offset s, all below the r bytes in use
def tz_merge(+r: U32, +s: U32, +b: U32, +old: U32, +x: U32, +hsb: {Nat.is_le(Nat.add(U32.to_nat(s), U32.to_nat(b)), U32.to_nat(r)) == True{} : Bool}, +hr: {Nat.is_le(U32.to_nat(r), 3n) == True{} : Bool},
    +hb1: {Nat.is_lt(0n, U32.to_nat(b)) == True{} : Bool}, +hb2: {Nat.is_le(U32.to_nat(b), 2n) == True{} : Bool}, +h: {O.tail_zero(r, old) == True{} : Bool})
    -> {O.tail_zero(r, O.merge_word(old, x, s, b)) == True{} : Bool}:
  tz_cases(U32.to_nat(r), U32.to_nat(s), U32.to_nat(b), r, s, b, old, x, {==}, {==}, {==}, hsb, hr, hb1, hb2, h)

