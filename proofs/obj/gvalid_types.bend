# ---- l16_ProposerSlashing: list of ProposerSlashing_bx ----
law vtlen_l16_ProposerSlashing:
  for +k: Nat
  for +W: List<&2, RT.MB<RT.M_ProposerSlashing>>
  for +i: Nat
  {VD.items_length(RT.xi_l16_ProposerSlashing(k, W, i)) == k : Nat}
def vtlen_l16_ProposerSlashing(k, W, i):
  match k:
    case 0n: {==}
    case 1n+ +q:
      %Equal.sym(Nat, VD.items_length(RT.xi_l16_ProposerSlashing(q, W, 1n+i)), q, vtlen_l16_ProposerSlashing(q, W, 1n+i)) : {1n+_ == 1n+q : Nat}
      {==}
law vtval_l16_ProposerSlashing:
  for +k: Nat
  for +W: List<&2, RT.MB<RT.M_ProposerSlashing>>
  for +i: Nat
  for +sE: S.Schema
  for +er: RT.ereps_l16_ProposerSlashing(k, W, i, sE)
  for +dv: OS.DV
  for +edv: {dv == OS.DV0() : OS.DV}
  for +ok: {RT.ok_ProposerSlashing_bx(sE, dv) == True{} : Bool}
  for +eq: RT.eqs_ProposerSlashing_bx(sE)
  {VD.root_valid(RT.xi_l16_ProposerSlashing(k, W, i), S.Repeat{sE}) == True{} : Bool}
def vtval_l16_ProposerSlashing(k, W, i, sE, er, dv, edv, ok, eq):
  match k:
    case 0n: {==}
    case 1n+ +q:
      (+r0, +rs) = er
      %Equal.sym(Bool, VD.root_valid(RT.v_ProposerSlashing_bx(RT.th_ProposerSlashing_bx(RT.xat_l16_ProposerSlashing(W, i))), sE), True{}, vr_ProposerSlashing_bx(RT.th_ProposerSlashing_bx(RT.xat_l16_ProposerSlashing(W, i)), sE, r0, dv, edv, ok, eq)) :
        {Bool.and(_, VD.root_valid(RT.xi_l16_ProposerSlashing(q, W, 1n+i), S.Repeat{sE})) == True{} : Bool}
      vtval_l16_ProposerSlashing(q, W, 1n+i, sE, rs, dv, edv, ok, eq)
def vr_l16_ProposerSlashing(-o: T.l16_ProposerSlashing_Seq, +s: S.Schema, +rep: RT.rep_l16_ProposerSlashing(o, s), +dv: OS.DV, +edv: {dv == OS.DV0() : OS.DV}, +ok: {RT.ok_l16_ProposerSlashing(s, dv) == True{} : Bool}, +eq: RT.eqs_l16_ProposerSlashing(s))
    -> {VD.root_valid(RT.xv_l16_ProposerSlashing(o), s) == True{} : Bool}:
  (+wf, +hv) = rep
  (+t, w1) = wf
  (+dw, w2) = w1
  (+N, w3) = w2
  (+eo, w4) = w3
  (+pf, w5) = w4
  (+hd, w6) = w5
  (+hn, +er) = w6
  +k0 = DK.and_l(SH.is_ListOf(s), Bool.and(Lim.minimal(SH.ListOf_limit(s), 4n), RT.ok_ProposerSlashing_bx(SH.ListOf_element(s), dv)), ok)
  +k1 = DK.and_r(SH.is_ListOf(s), Bool.and(Lim.minimal(SH.ListOf_limit(s), 4n), RT.ok_ProposerSlashing_bx(SH.ListOf_element(s), dv)), ok)
