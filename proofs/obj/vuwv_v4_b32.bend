def wl_v4_b32(+dB: Nat, +TB: FD.array__Tree<U32>, +pfB: {FD.array__perfect(U32, dB, TB) == True{} : Bool}, +hrB: {Nat.is_le(32n, VB.pw(dB)) == True{} : Bool})
    -> {WL_v4_b32(TB) == VS.wtake(32n, UW.SLW(TB)) : List<&2, U32>}:
  Equal.sym(List<&2, U32>, VS.wtake(32n, UW.SLW(TB)), WL_v4_b32(TB),
    VWB.tks(32n, 0n, UW.SLW(TB), FD.logic__subst(Nat, z => {Nat.is_le(32n, z) == True{} : Bool}, VB.pw(dB), VB.len(UW.SLW(TB)), Equal.sym(Nat, VB.len(UW.SLW(TB)), VB.pw(dB), FD.array__slots_length(U32, dB, TB, pfB)), hrB)))

def PX_v4_b32(+r: Nat, +dd: Nat, +D: FD.array__Tree<U32>, +q: Nat, +TB: FD.array__Tree<U32>) -> FD.array__Tree<U32>:
  match r:
    case 0n: VF.updv(VS.wtake(32n, UW.SLW(TB)), dd, D, q)
    case 1n: UW.SWc(1, VS.wtake(32n, UW.SLW(TB)), dd, D, q, 0)
    case 2n: UW.SWc(2, VS.wtake(32n, UW.SLW(TB)), dd, D, q, 0)
    case 3n: UW.SWc(3, VS.wtake(32n, UW.SLW(TB)), dd, D, q, 0)
    case 4n+t: D

def v4_b32x_perfect(+r: Nat, +dd: Nat, +D: FD.array__Tree<U32>, +q: Nat, +TB: FD.array__Tree<U32>, +pf: {FD.array__perfect(U32, dd, D) == True{} : Bool})
    -> {FD.array__perfect(U32, dd, PX_v4_b32(r, dd, D, q, TB)) == True{} : Bool}:
  match r:
    case 0n: VF.updv_perfect(VS.wtake(32n, UW.SLW(TB)), dd, D, q, pf)
    case 1n: UW.swc_perfect(1, VS.wtake(32n, UW.SLW(TB)), dd, D, q, 0, pf)
    case 2n: UW.swc_perfect(2, VS.wtake(32n, UW.SLW(TB)), dd, D, q, 0, pf)
    case 3n: UW.swc_perfect(3, VS.wtake(32n, UW.SLW(TB)), dd, D, q, 0, pf)
    case 4n+ +t: pf

# T.v4_b32_putk at any byte position X = 4 q + r (its validity check, then its copy).
def v4_b32_any(+dd: Nat, +D: FD.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat, +dB: Nat, +TB: FD.array__Tree<U32>, +e: {U32.to_nat(X) == Nat.add(A.quad(q), r) : Nat}, +hr: {Nat.is_lt(r, 4n) == True{} : Bool},
    +hd: {Nat.is_lt(dd, 29n) == True{} : Bool}, +hl: {Nat.is_le(Nat.add(q, UWD.NWN(Nat.add(r, 128n))), VB.pw(dd)) == True{} : Bool},
    +pf: {FD.array__perfect(U32, dd, D) == True{} : Bool}, +pfB: {FD.array__perfect(U32, dB, TB) == True{} : Bool},
    +hdB: {Nat.is_lt(dB, 31n) == True{} : Bool}, +hrB: {Nat.is_le(32n, VB.pw(dB)) == True{} : Bool},
    +hz: {VS.bt(128n, VS.bdr(Nat.add(A.quad(q), r), UA.BYT(D))) == UW.ZB(128n) : +List<U32>})
    -> {T.v4_b32_putk(FD.array__thaw(U32, D), X, O.Words{FD.array__thaw(U32, TB), 128}) == (FD.array__thaw(U32, PX_v4_b32(r, dd, D, q, TB)), (O.Words{FD.array__thaw(U32, TB), 128}, 0)) : Array<U32> & (O.Words & U32)}:
  match r:
    case 0n:
      %wl_v4_b32(dB, TB, pfB, hrB) : {T.v4_b32_putk(FD.array__thaw(U32, D), X, O.Words{FD.array__thaw(U32, TB), 128}) == (FD.array__thaw(U32, VF.updv(_, dd, D, q)), (O.Words{FD.array__thaw(U32, TB), 128}, 0)) : Array<U32> & (O.Words & U32)}
      gwput_v4_b32(dd, D, X, q, FD.logic__subst(Nat, z => {U32.to_nat(X) == z : Nat}, Nat.add(A.quad(q), 0n), A.quad(q), FD.nat__add_zero(A.quad(q)), e), hd, pf,
        FD.logic__subst(Nat, z => {Nat.is_le(z, VB.pw(dd)) == True{} : Bool}, Nat.add(q, 32n), Nat.add(32n, q), FD.nat__add_comm(q, 32n), hl), dB, TB, pfB, hdB, hrB)
    case 1n:
      +e3 = UW.ua_3(X, q, 1n, 1, {==}, e, {==})
      %Equal.sym(O.Words & Bool, T.v4_b32_valid(O.Words{FD.array__thaw(U32, TB), 128}), (O.Words{FD.array__thaw(U32, TB), 128}, True{}), VBE.words_ok_b(dB, TB, 128, 128, 128, 8n, pfB, hdB, {==}, {==}, {==}, {==}, hrB, {==}, 32, {==})) :
        {T.v4_b32_pk(FD.array__thaw(U32, D), X, _) == (FD.array__thaw(U32, PX_v4_b32(1n, dd, D, q, TB)), (O.Words{FD.array__thaw(U32, TB), 128}, 0)) : Array<U32> & (O.Words & U32)}
      %Equal.sym(U32, U32.and(X, 3), 1, e3) : {T.v4_b32_pk_ok(T.v4_b32_pw(U32.is_eq(_, 0), FD.array__thaw(U32, D), X, FD.array__thaw(U32, TB), 128)) == (FD.array__thaw(U32, PX_v4_b32(1n, dd, D, q, TB)), (O.Words{FD.array__thaw(U32, TB), 128}, 0)) : Array<U32> & (O.Words & U32)}
      %Equal.sym(Array<U32> & O.Words, O.put_words(FD.array__thaw(U32, D), X, O.Words{FD.array__thaw(U32, TB), 128}), (FD.array__thaw(U32, UWD.PWM(1n, dd, D, q, TB, 128)), O.Words{FD.array__thaw(U32, TB), 128}),
          UWD.putw_loose(dd, D, X, q, 1n, dB, TB, 128, 8n, e, {==}, hd, hdB, {==}, {==}, hrB, UWD.le_q(q, 32n, VB.pw(dd), hl), pf, pfB, hz)) :
        {T.v4_b32_pk_ok(_) == (FD.array__thaw(U32, PX_v4_b32(1n, dd, D, q, TB)), (O.Words{FD.array__thaw(U32, TB), 128}, 0)) : Array<U32> & (O.Words & U32)}
      {==}
    case 2n:
      +e3 = UW.ua_3(X, q, 2n, 2, {==}, e, {==})
      %Equal.sym(O.Words & Bool, T.v4_b32_valid(O.Words{FD.array__thaw(U32, TB), 128}), (O.Words{FD.array__thaw(U32, TB), 128}, True{}), VBE.words_ok_b(dB, TB, 128, 128, 128, 8n, pfB, hdB, {==}, {==}, {==}, {==}, hrB, {==}, 32, {==})) :
        {T.v4_b32_pk(FD.array__thaw(U32, D), X, _) == (FD.array__thaw(U32, PX_v4_b32(2n, dd, D, q, TB)), (O.Words{FD.array__thaw(U32, TB), 128}, 0)) : Array<U32> & (O.Words & U32)}
      %Equal.sym(U32, U32.and(X, 3), 2, e3) : {T.v4_b32_pk_ok(T.v4_b32_pw(U32.is_eq(_, 0), FD.array__thaw(U32, D), X, FD.array__thaw(U32, TB), 128)) == (FD.array__thaw(U32, PX_v4_b32(2n, dd, D, q, TB)), (O.Words{FD.array__thaw(U32, TB), 128}, 0)) : Array<U32> & (O.Words & U32)}
      %Equal.sym(Array<U32> & O.Words, O.put_words(FD.array__thaw(U32, D), X, O.Words{FD.array__thaw(U32, TB), 128}), (FD.array__thaw(U32, UWD.PWM(2n, dd, D, q, TB, 128)), O.Words{FD.array__thaw(U32, TB), 128}),
          UWD.putw_loose(dd, D, X, q, 2n, dB, TB, 128, 8n, e, {==}, hd, hdB, {==}, {==}, hrB, UWD.le_q(q, 32n, VB.pw(dd), hl), pf, pfB, hz)) :
        {T.v4_b32_pk_ok(_) == (FD.array__thaw(U32, PX_v4_b32(2n, dd, D, q, TB)), (O.Words{FD.array__thaw(U32, TB), 128}, 0)) : Array<U32> & (O.Words & U32)}
      {==}
    case 3n:
      +e3 = UW.ua_3(X, q, 3n, 3, {==}, e, {==})
      %Equal.sym(O.Words & Bool, T.v4_b32_valid(O.Words{FD.array__thaw(U32, TB), 128}), (O.Words{FD.array__thaw(U32, TB), 128}, True{}), VBE.words_ok_b(dB, TB, 128, 128, 128, 8n, pfB, hdB, {==}, {==}, {==}, {==}, hrB, {==}, 32, {==})) :
        {T.v4_b32_pk(FD.array__thaw(U32, D), X, _) == (FD.array__thaw(U32, PX_v4_b32(3n, dd, D, q, TB)), (O.Words{FD.array__thaw(U32, TB), 128}, 0)) : Array<U32> & (O.Words & U32)}
      %Equal.sym(U32, U32.and(X, 3), 3, e3) : {T.v4_b32_pk_ok(T.v4_b32_pw(U32.is_eq(_, 0), FD.array__thaw(U32, D), X, FD.array__thaw(U32, TB), 128)) == (FD.array__thaw(U32, PX_v4_b32(3n, dd, D, q, TB)), (O.Words{FD.array__thaw(U32, TB), 128}, 0)) : Array<U32> & (O.Words & U32)}
