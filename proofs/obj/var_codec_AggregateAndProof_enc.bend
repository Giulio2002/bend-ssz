# The sizes: SFSX(K) = 344 + (K / 8 + 1).
def eSX(+K: U32, +hN: {Nat.is_le(U32.to_nat(K), U32.to_nat(131072)) == True{} : Bool}) -> {U32.to_nat(SFSX(K)) == Nat.add(344n, U32.to_nat(CO.NK(K))) : Nat}:
  +h = FD.logic__subst(Nat, z => {Nat.is_le(Nat.add(108n, z), U32.to_nat(131417)) == True{} : Bool}, Nat.add(236n, U32.to_nat(CO.NK(K))), U32.to_nat(E.SFS(K)),
    Equal.sym(Nat, U32.to_nat(E.SFS(K)), Nat.add(236n, U32.to_nat(CO.NK(K))), E.eS(K, hN)),
    FD.nat__le_trans(Nat.add(108n, Nat.add(236n, U32.to_nat(CO.NK(K)))), Nat.add(108n, Nat.add(236n, Nat.add(U32.to_nat(131072), 1n))), U32.to_nat(131417),
      Order.add_left(108n, Nat.add(236n, U32.to_nat(CO.NK(K))), Nat.add(236n, Nat.add(U32.to_nat(131072), 1n)), Order.add_left(236n, U32.to_nat(CO.NK(K)), Nat.add(U32.to_nat(131072), 1n), E.eNK(K, hN))), {==}))
  Equal.trans(Nat, U32.to_nat(SFSX(K)), Nat.add(108n, U32.to_nat(E.SFS(K))), Nat.add(344n, U32.to_nat(CO.NK(K))), A.add_le(108, E.SFS(K), 131417, h),
    Equal.cong(Nat, Nat, z => Nat.add(108n, z), U32.to_nat(E.SFS(K)), Nat.add(236n, U32.to_nat(CO.NK(K))), E.eS(K, hN)))

def paddX(+K: U32, +hN: {Nat.is_le(U32.to_nat(K), U32.to_nat(131072)) == True{} : Bool}) -> {O.padd(108, E.SFS(K)) == SFSX(K) : U32}:
  VE.padd_ok(108, E.SFS(K), VE.winit(31n, VE.bits32(108)), VE.winit(31n, VE.bits32(E.SFS(K))), {==},
    VE.small_pad(E.SFS(K), 18n, {==}, FD.logic__subst(Nat, z => {Nat.is_lt(z, FD.spec_common__pow2(18n)) == True{} : Bool}, Nat.add(236n, U32.to_nat(CO.NK(K))), U32.to_nat(E.SFS(K)),
      Equal.sym(Nat, U32.to_nat(E.SFS(K)), Nat.add(236n, U32.to_nat(CO.NK(K))), E.eS(K, hN)),
      FD.nat__le_lt_trans(Nat.add(236n, U32.to_nat(CO.NK(K))), Nat.add(236n, Nat.add(U32.to_nat(131072), 1n)), FD.spec_common__pow2(18n), Order.add_left(236n, U32.to_nat(CO.NK(K)), Nat.add(U32.to_nat(131072), 1n), E.eNK(K, hN)), {==}))))

