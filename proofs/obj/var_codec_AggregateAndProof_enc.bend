# The encoding's words: the header's 86, then the bit list's q + 1.
def nwS(+K: U32, +hN: {Nat.is_le(U32.to_nat(K), U32.to_nat(131072)) == True{} : Bool}) -> {VC.NW(SFSX(K)) == Nat.add(86n, Nat.add(VBT.QK(K), 1n)) : Nat}:
  +j = VBT.JK(K)
  +b = VBT.BKk(K)
  +hj = FD.nat__le_lt_trans(j, 3n, 4n, RD.and_le(VBT.PDK(K), 3), {==})
  +hb = FD.nat__le_lt_trans(b, 7n, 8n, RD.and_le(K, 7), {==})
  +cf = BW.cfj(j, b, hj, hb)
  +cD = DL.p1(DL.TD(j), DL.CE(j, b), DL.p2(DL.TC(j, b), DL.CD(j, b), DL.p2(DL.TB(b), DL.CC(j, b), DL.p2(DL.TA(j, b), DL.CB(j, b), cf))))
  +e1 = Equal.trans(Nat, U32.to_nat(SFSX(K)), Nat.add(344n, U32.to_nat(CO.NK(K))), Nat.add(A.quad(Nat.add(86n, VBT.QK(K))), Nat.add(j, 1n)), eSX(K, hN),
    Equal.trans(Nat, Nat.add(344n, U32.to_nat(CO.NK(K))), Nat.add(A.quad(86n), Nat.add(A.quad(VBT.QK(K)), Nat.add(j, 1n))), Nat.add(A.quad(Nat.add(86n, VBT.QK(K))), Nat.add(j, 1n)),
      Equal.cong(Nat, Nat, z => Nat.add(344n, z), U32.to_nat(CO.NK(K)), Nat.add(A.quad(VBT.QK(K)), Nat.add(j, 1n)), VBT.G4(K, 18n, {==}, E.hKk(K, hN), j, {==})),
      Equal.trans(Nat, Nat.add(A.quad(86n), Nat.add(A.quad(VBT.QK(K)), Nat.add(j, 1n))), Nat.add(Nat.add(A.quad(86n), A.quad(VBT.QK(K))), Nat.add(j, 1n)), Nat.add(A.quad(Nat.add(86n, VBT.QK(K))), Nat.add(j, 1n)),
        Equal.sym(Nat, Nat.add(Nat.add(A.quad(86n), A.quad(VBT.QK(K))), Nat.add(j, 1n)), Nat.add(A.quad(86n), Nat.add(A.quad(VBT.QK(K)), Nat.add(j, 1n))), FD.nat__add_assoc(A.quad(86n), A.quad(VBT.QK(K)), Nat.add(j, 1n))),
        Equal.cong(Nat, Nat, z => Nat.add(z, Nat.add(j, 1n)), Nat.add(A.quad(86n), A.quad(VBT.QK(K))), A.quad(Nat.add(86n, VBT.QK(K))), VF.quad_add(86n, VBT.QK(K))))))
  +h3 = FD.logic__subst(Nat, z => {Nat.is_le(Nat.add(z, 3n), O.pow2n(18n)) == True{} : Bool}, Nat.add(344n, U32.to_nat(CO.NK(K))), U32.to_nat(SFSX(K)), Equal.sym(Nat, U32.to_nat(SFSX(K)), Nat.add(344n, U32.to_nat(CO.NK(K))), eSX(K, hN)),
    FD.nat__le_trans(Nat.add(Nat.add(344n, U32.to_nat(CO.NK(K))), 3n), Nat.add(Nat.add(344n, Nat.add(U32.to_nat(131072), 1n)), 3n), O.pow2n(18n),
      Order.add_right(Nat.add(344n, U32.to_nat(CO.NK(K))), Nat.add(344n, Nat.add(U32.to_nat(131072), 1n)), 3n, Order.add_left(344n, U32.to_nat(CO.NK(K)), Nat.add(U32.to_nat(131072), 1n), E.eNK(K, hN))), hNk2()))
  +e2 = VBT.NWq(SFSX(K), Nat.add(86n, VBT.QK(K)), Nat.add(j, 1n), 18n, {==}, h3, e1)
  Equal.trans(Nat, VC.NW(SFSX(K)), Nat.add(Nat.add(86n, VBT.QK(K)), VD.s_rng(2n, Nat.add(Nat.add(j, 1n), 3n))), Nat.add(86n, Nat.add(VBT.QK(K), 1n)), e2,
    Equal.trans(Nat, Nat.add(Nat.add(86n, VBT.QK(K)), VD.s_rng(2n, Nat.add(Nat.add(j, 1n), 3n))), Nat.add(Nat.add(86n, VBT.QK(K)), 1n), Nat.add(86n, Nat.add(VBT.QK(K), 1n)),
      Equal.cong(Nat, Nat, z => Nat.add(Nat.add(86n, VBT.QK(K)), z), VD.s_rng(2n, Nat.add(Nat.add(j, 1n), 3n)), 1n, cD),
      FD.nat__add_assoc(86n, VBT.QK(K), 1n)))

