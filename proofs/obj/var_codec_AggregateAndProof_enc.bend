def hDq(+K: U32, +hN: {Nat.is_le(U32.to_nat(K), U32.to_nat(131072)) == True{} : Bool}) -> {Nat.is_le(Nat.add(86n, Nat.add(VBT.QK(K), 1n)), VB.pw(DO(K))) == True{} : Bool}:
