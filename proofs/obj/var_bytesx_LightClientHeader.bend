def XCP2(+t: FD.array__Tree<U32>, +x: Nat, +Yb: +List<U32>) -> +List<S.Part>: Con{S.Fixed{F.limbs([UR.RWN(t, 116n+x), UR.RWN(t, 120n+x), UR.RWN(t, 124n+x), UR.RWN(t, 128n+x), UR.RWN(t, 132n+x), UR.RWN(t, 136n+x), UR.RWN(t, 140n+x), UR.RWN(t, 144n+x), UR.RWN(t, 148n+x), UR.RWN(t, 152n+x), UR.RWN(t, 156n+x), UR.RWN(t, 160n+x), UR.RWN(t, 164n+x), UR.RWN(t, 168n+x), UR.RWN(t, 172n+x), UR.RWN(t, 176n+x), UR.RWN(t, 180n+x), UR.RWN(t, 184n+x), UR.RWN(t, 188n+x), UR.RWN(t, 192n+x), UR.RWN(t, 196n+x), UR.RWN(t, 200n+x), UR.RWN(t, 204n+x), UR.RWN(t, 208n+x), UR.RWN(t, 212n+x), UR.RWN(t, 216n+x), UR.RWN(t, 220n+x), UR.RWN(t, 224n+x), UR.RWN(t, 228n+x), UR.RWN(t, 232n+x), UR.RWN(t, 236n+x), UR.RWN(t, 240n+x)])}, XCP3(t, x, Yb)}
