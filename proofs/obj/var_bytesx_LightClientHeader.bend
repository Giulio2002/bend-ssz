def VALw(+t: FD.array__Tree<U32>, +x: Nat, +len: U32) -> S.Value: XVw(t, x, YW.VALw(t, 244n+x, LL(len)))
# VALw's body, as a rewrite (a spec-parts goal over VALw compared with one over its body ran the spec encoder)
def VALq(+t: FD.array__Tree<U32>, +x: Nat, +len: U32) -> {XVw(t, x, YW.VALw(t, 244n+x, LL(len))) == VALw(t, x, len) : S.Value}: {==}

def hwH(+d: Nat, +x: Nat, +len: U32, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +hw32: {Nat.is_lt(Nat.add(x, U32.to_nat(len)), FD.spec_common__pow2(32n)) == True{} : Bool}, +ha: {U32.is_le(244, len) == True{} : Bool})
    -> {Nat.is_le(Nat.add(x, Nat.add(A.quad(61n), U32.to_nat(LL(len)))), A.quad(VB.pw(d))) == True{} : Bool}:
  %Equal.sym(Nat, Nat.add(244n, U32.to_nat(LL(len))), U32.to_nat(len), enFS(len, ha)) : {Nat.is_le(Nat.add(x, _), A.quad(VB.pw(d))) == True{} : Bool}
  hw

# The header's bytes and the child's window's bytes are the window's bytes.
def bytesw(+d: Nat, +t: FD.array__Tree<U32>, +x: Nat, +len: U32, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +hw32: {Nat.is_lt(Nat.add(x, U32.to_nat(len)), FD.spec_common__pow2(32n)) == True{} : Bool}, +ha: {U32.is_le(244, len) == True{} : Bool}, +epo: {SPOw(t, x) == 244 : U32})
