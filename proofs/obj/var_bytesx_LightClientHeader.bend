def specw_go(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat}, +hd: {Nat.is_lt(d, 31n) == True{} : Bool},
    +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +hw32: {Nat.is_lt(Nat.add(x, U32.to_nat(len)), FD.spec_common__pow2(32n)) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +ha: {U32.is_le(244, len) == True{} : Bool}, +epo: {SPOw(t, x) == 244 : U32},
    +hY: {YW.CHKw(t, 244n+x, U32.add(off, 244), LL(len)) == True{} : Bool})
    -> {Codec.parts(VALw(t, x, len), Spec.LightClientHeader()) == Some{[S.Variable{UW.WX(t, x, U32.to_nat(len))}]} : Maybe<&2, +List<S.Part>>}:
  %VALq(t, x, len) :
    {Codec.parts(_, Spec.LightClientHeader()) == Some{[S.Variable{UW.WX(t, x, U32.to_nat(len))}]} : Maybe<&2, +List<S.Part>>}
  %bytesw(d, t, x, len, pf, hw, hw32, ha, epo) :
    {Codec.parts(XVw(t, x, YW.VALw(t, 244n+x, LL(len))), Spec.LightClientHeader()) == Some{[S.Variable{_}]} : Maybe<&2, +List<S.Part>>}
  encpw(t, x, YW.VALw(t, 244n+x, LL(len)), UW.WX(t, 244n+x, U32.to_nat(LL(len))), YW.specwD(d, t, n, 244n+x, U32.add(off, 244), LL(len), ecYD(d, x, off, len, eo, hd, hw, hw32, ha), hd, hwY(d, x, len, hw, ha), hwY32(x, len, hw32, ha), pf, hY),
    UW.domWX(t, 244n+x, U32.to_nat(LL(len))), fitw(d, t, x, len, pf, hd, hw, hw32, ha))

# When the window's checks hold, the spec parts of VALw are its bytes, as one variable part.
def specwD(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat}, +hd: {Nat.is_lt(d, 31n) == True{} : Bool},
    +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +hw32: {Nat.is_lt(Nat.add(x, U32.to_nat(len)), FD.spec_common__pow2(32n)) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hchk: {CHKw(t, x, off, len) == True{} : Bool})
    -> {Codec.parts(VALw(t, x, len), Spec.LightClientHeader()) == Some{[S.Variable{UW.WX(t, x, U32.to_nat(len))}]} : Maybe<&2, +List<S.Part>>}:
  +a = U32.is_le(244, len)
  +b = U32.is_eq(SPOw(t, x), 244)
  +c = YW.CHKw(t, 244n+x, U32.add(off, 244), LL(len))
  +epo = FD.u32alg__eq_of(SPOw(t, x), 244, chk_b(a, b, c, hchk))
  specw_go(d, t, n, x, off, len, eo, hd, hw, hw32, pf, chk_a(a, b, c, hchk), epo, chk_c(a, b, c, hchk))


# ---- every value whose spec parts are the window's bytes passes the checks ----------------------

def ek_sub(+n: U32, +k: Nat, +en: {U32.to_nat(n) == Nat.add(244n, k) : Nat}) -> {U32.to_nat(LL(n)) == k : Nat}:
  +le = FD.logic__subst(Nat, z => {Nat.is_le(244n, z) == True{} : Bool}, Nat.add(244n, k), U32.to_nat(n), Equal.sym(Nat, U32.to_nat(n), Nat.add(244n, k), en), Order.below_sum(244n, k))
  %Equal.sym(Nat, U32.to_nat(LL(n)), Nat.sub(U32.to_nat(n), 244n), FD.u32__sub_nat(n, 244, le)) : {_ == k : Nat}
  %Equal.sym(Nat, U32.to_nat(n), Nat.add(244n, k), en) : {Nat.sub(_, 244n) == k : Nat}
  FD.nat__add_sub_cancel(244n, k)

def chk_truew(+t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32, +k: Nat, +en: {U32.to_nat(len) == Nat.add(244n, k) : Nat},
    +epo: {SPOw(t, x) == 244 : U32}, +hY: {YW.CHKw(t, 244n+x, U32.add(off, 244), LL(len)) == True{} : Bool}) -> {CHKw(t, x, off, len) == True{} : Bool}:
  +le = FD.logic__subst(Nat, z => {Nat.is_le(244n, z) == True{} : Bool}, Nat.add(244n, k), U32.to_nat(len), Equal.sym(Nat, U32.to_nat(len), Nat.add(244n, k), en), Order.below_sum(244n, k))
  %Equal.sym(Bool, U32.is_le(244, len), True{}, FD.logic__subst(Bool, z => {z == True{} : Bool}, Nat.is_le(244n, U32.to_nat(len)), U32.is_le(244, len), Equal.sym(Bool, U32.is_le(244, len), Nat.is_le(244n, U32.to_nat(len)), VU.le_u32(244, len)), le)) :
    {chk3(_, U32.is_eq(SPOw(t, x), 244), YW.CHKw(t, 244n+x, U32.add(off, 244), LL(len))) == True{} : Bool}
  %Equal.sym(U32, SPOw(t, x), 244, epo) : {chk3(True{}, U32.is_eq(_, 244), YW.CHKw(t, 244n+x, U32.add(off, 244), LL(len))) == True{} : Bool}
  hY

def byteP(+d: Nat, +t: FD.array__Tree<U32>, +x: Nat, +len: U32, +k: Nat, +en: {U32.to_nat(len) == Nat.add(244n, k) : Nat}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +hw32: {Nat.is_lt(Nat.add(x, U32.to_nat(len)), FD.spec_common__pow2(32n)) == True{} : Bool})
    -> {VS.bt(4n, VS.bdr(112n, UW.WX(t, x, U32.to_nat(len)))) == F.limbs([SPOw(t, x)]) : +List<U32>}:
  +hw2 = FD.logic__subst(Nat, z => {Nat.is_le(Nat.add(x, z), A.quad(VB.pw(d))) == True{} : Bool}, U32.to_nat(len), Nat.add(112n, 4n+Nat.add(128n, k)), en, hw)
  %Equal.sym(Nat, U32.to_nat(len), Nat.add(112n, 4n+Nat.add(128n, k)), en) : {VS.bt(4n, VS.bdr(112n, UW.WX(t, x, _))) == F.limbs([SPOw(t, x)]) : +List<U32>}
  UW.byteWX(d, t, x, 112n, Nat.add(128n, k), pf, hw2)

# The child's bytes: the window after the header.
def eys(+t: FD.array__Tree<U32>, +x: Nat, +len: U32, +k: Nat, +en: {U32.to_nat(len) == Nat.add(244n, k) : Nat})
    -> {VS.bdr(244n, UW.WX(t, x, U32.to_nat(len))) == UW.WX(t, 244n+x, U32.to_nat(LL(len))) : +List<U32>}:
  %Equal.sym(Nat, U32.to_nat(len), Nat.add(244n, k), en) : {VS.bdr(244n, UW.WX(t, x, _)) == UW.WX(t, 244n+x, U32.to_nat(LL(len))) : +List<U32>}
  %Equal.sym(Nat, U32.to_nat(LL(len)), k, ek_sub(len, k, en)) : {VS.bdr(244n, UW.WX(t, x, Nat.add(244n, k))) == UW.WX(t, 244n+x, _) : +List<U32>}
  UW.tailWX(t, x, 244n, k)

def inv_tail(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat}, +hd: {Nat.is_lt(d, 31n) == True{} : Bool},
    +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +hw32: {Nat.is_lt(Nat.add(x, U32.to_nat(len)), FD.spec_common__pow2(32n)) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {VS.bt(4n, VS.bdr(112n, UW.WX(t, x, U32.to_nat(len)))) == [244, 0, 0, 0] : +List<U32>}, +hv0: S.Value, +ys: +List<U32>,
    +hlen: {List.length(&2, U32, UW.WX(t, x, U32.to_nat(len))) == Nat.add(244n, List.length(&2, U32, ys)) : Nat},
    +hdr: {VS.bdr(244n, UW.WX(t, x, U32.to_nat(len))) == ys : +List<U32>},
    +hvp: {Codec.parts(hv0, Spec.ExecutionPayloadHeader()) == Some{[S.Variable{ys}]} : Maybe<&2, +List<S.Part>>})
    -> {CHKw(t, x, off, len) == True{} : Bool}:
  +k = List.length(&2, U32, ys)
  +en = Equal.trans(Nat, U32.to_nat(len), List.length(&2, U32, UW.WX(t, x, U32.to_nat(len))), Nat.add(244n, k), Equal.sym(Nat, List.length(&2, U32, UW.WX(t, x, U32.to_nat(len))), U32.to_nat(len), UW.lenWX(d, t, x, U32.to_nat(len), pf, hw)), hlen)
  +ha = FD.logic__subst(Bool, z => {z == True{} : Bool}, Nat.is_le(244n, U32.to_nat(len)), U32.is_le(244, len), Equal.sym(Bool, U32.is_le(244, len), Nat.is_le(244n, U32.to_nat(len)), VU.le_u32(244, len)),
    FD.logic__subst(Nat, z => {Nat.is_le(244n, z) == True{} : Bool}, Nat.add(244n, k), U32.to_nat(len), Equal.sym(Nat, U32.to_nat(len), Nat.add(244n, k), en), Order.below_sum(244n, k)))
  +epo = XI.wordFS(SPOw(t, x), Equal.trans(+List<U32>, F.limbs([SPOw(t, x)]), VS.bt(4n, VS.bdr(112n, UW.WX(t, x, U32.to_nat(len)))), [244, 0, 0, 0],
    Equal.sym(+List<U32>, VS.bt(4n, VS.bdr(112n, UW.WX(t, x, U32.to_nat(len)))), F.limbs([SPOw(t, x)]), byteP(d, t, x, len, k, en, pf, hw, hw32)), hb))
  +ey = Equal.trans(+List<U32>, ys, VS.bdr(244n, UW.WX(t, x, U32.to_nat(len))), UW.WX(t, 244n+x, U32.to_nat(LL(len))), Equal.sym(+List<U32>, VS.bdr(244n, UW.WX(t, x, U32.to_nat(len))), ys, hdr), eys(t, x, len, k, en))
  +hv = FD.logic__subst(+List<U32>, z => {Codec.parts(hv0, Spec.ExecutionPayloadHeader()) == Some{[S.Variable{z}]} : Maybe<&2, +List<S.Part>>}, ys, UW.WX(t, 244n+x, U32.to_nat(LL(len))), ey, hvp)
  chk_truew(t, x, off, len, k, en, epo,
    YW.invwD(d, t, n, 244n+x, U32.add(off, 244), LL(len), ecYD(d, x, off, len, eo, hd, hw, hw32, ha), hd, hwY(d, x, len, hw, ha), hwY32(x, len, hw32, ha), pf, hv0, hv))

def inv_p2(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat}, +hd: {Nat.is_lt(d, 31n) == True{} : Bool},
    +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +hw32: {Nat.is_lt(Nat.add(x, U32.to_nat(len)), FD.spec_common__pow2(32n)) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {VS.bt(4n, VS.bdr(112n, UW.WX(t, x, U32.to_nat(len)))) == [244, 0, 0, 0] : +List<U32>}, +hv0: S.Value, +ys: +List<U32>,
    +hlen: {List.length(&2, U32, UW.WX(t, x, U32.to_nat(len))) == Nat.add(244n, List.length(&2, U32, ys)) : Nat},
    r3: DK.P2({VS.bdr(244n, UW.WX(t, x, U32.to_nat(len))) == ys : +List<U32>}, {Codec.parts(hv0, Spec.ExecutionPayloadHeader()) == Some{[S.Variable{ys}]} : Maybe<&2, +List<S.Part>>}))
    -> {CHKw(t, x, off, len) == True{} : Bool}:
  (+hdr, hvp) = r3
  inv_tail(d, t, n, x, off, len, eo, hd, hw, hw32, pf, hb, hv0, ys, hlen, hdr, hvp)

def inv_facts(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat}, +hd: {Nat.is_lt(d, 31n) == True{} : Bool},
    +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +hw32: {Nat.is_lt(Nat.add(x, U32.to_nat(len)), FD.spec_common__pow2(32n)) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, facts: XI.FACTS(UW.WX(t, x, U32.to_nat(len))))
    -> {CHKw(t, x, off, len) == True{} : Bool}:
  (+hb, ex) = facts
  (+hv0, r1) = ex
  (+ys, r2) = r1
  (+hlen, r3) = r2
  inv_p2(d, t, n, x, off, len, eo, hd, hw, hw32, pf, hb, hv0, ys, hlen, r3)

# Every value whose spec parts are the window's bytes passes the checks.
def invwD(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat}, +hd: {Nat.is_lt(d, 31n) == True{} : Bool},
    +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +hw32: {Nat.is_lt(Nat.add(x, U32.to_nat(len)), FD.spec_common__pow2(32n)) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +v: S.Value, +e: {Codec.parts(v, Spec.LightClientHeader()) == Some{[S.Variable{UW.WX(t, x, U32.to_nat(len))}]} : Maybe<&2, +List<S.Part>>})
    -> {CHKw(t, x, off, len) == True{} : Bool}:
  inv_facts(d, t, n, x, off, len, eo, hd, hw, hw32, pf, XI.inv_p(v, UW.WX(t, x, U32.to_nat(len)), e))

# ---- the window interface as it was (d < 28, no hw32), for the callers not yet deep ----

def ok_evalw(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat}, +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool})
    -> {FuluLightClientHeader_r.LightClientHeader_ok(UA.BF(t, n), off, len) == (UA.BF(t, n), CHKw(t, x, off, len)) : B.Buf & Bool}:
  ok_evalwD(d, t, n, x, off, len, eo, FD.nat__lt_trans(d, 28n, 31n, hd, {==}), hw, VB.hw32of(d, Nat.add(x, U32.to_nat(len)), FD.nat__lt_trans(d, 28n, 30n, hd, {==}), hw), pf)

def readw(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat}, +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hchk: {CHKw(t, x, off, len) == True{} : Bool})
    -> {FuluLightClientHeader_r.LightClientHeader_read(UA.BF(t, n), off, len) == (UA.BF(t, n), OBJw(d, t, x, off, len)) : B.Buf & FuluLightClientHeader_d.LightClientHeader}:
  readwD(d, t, n, x, off, len, eo, FD.nat__lt_trans(d, 28n, 31n, hd, {==}), hw, VB.hw32of(d, Nat.add(x, U32.to_nat(len)), FD.nat__lt_trans(d, 28n, 30n, hd, {==}), hw), pf, hchk)

def specw(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat}, +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hchk: {CHKw(t, x, off, len) == True{} : Bool})
    -> {Codec.parts(VALw(t, x, len), Spec.LightClientHeader()) == Some{[S.Variable{UW.WX(t, x, U32.to_nat(len))}]} : Maybe<&2, +List<S.Part>>}:
  specwD(d, t, n, x, off, len, eo, FD.nat__lt_trans(d, 28n, 31n, hd, {==}), hw, VB.hw32of(d, Nat.add(x, U32.to_nat(len)), FD.nat__lt_trans(d, 28n, 30n, hd, {==}), hw), pf, hchk)

def invw(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat}, +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +v: S.Value, +e: {Codec.parts(v, Spec.LightClientHeader()) == Some{[S.Variable{UW.WX(t, x, U32.to_nat(len))}]} : Maybe<&2, +List<S.Part>>})
    -> {CHKw(t, x, off, len) == True{} : Bool}:
