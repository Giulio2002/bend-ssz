    case Nil{} _: Empty.absurd({RTL.xat_l16_SignedVoluntaryExit(F.spec_common__update(FuluSignedVoluntaryExit_d.SignedVoluntaryExit, Nil{}, J, e), J) == e : FuluSignedVoluntaryExit_d.SignedVoluntaryExit}, F.nat__lt_zero_absurd(J, h))
    case Con{x, t} 0n: {==}
    case Con{x, t} 1n+p: l16_SignedVoluntaryExit_xat_same(t, p, e, h)

