        {S.Items{vm_l8_Attestation(RTL.xat_l8_Attestation(W, i0)), _} == S.Items{vm_l8_Attestation(RTL.xat_l8_Attestation(W, i0)), VS.items_snoc(RTL.xi_l8_Attestation(p, W, 1n+i0), vm_l8_Attestation(e))} : S.Value}
      {==}

