def swlbo(r, w, W, c, hl, hz, hc):
  match r W:
    case _ Nil{}: Empty.absurd({FX.limbs(UW.SWLo(3, Con{w, r}, Nil{}, c)) == List.append(&2, U32, VS.bt(3n, I.limb(U32.or(FD.flat__nthc(Nil{}, 0n), c))), List.append(&2, U32, VS.bt(Nat.add(1n, A.quad(List.length(&2, U32, r))), FX.limbs(Con{w, r})), VS.bdr(4n+A.quad(List.length(&2, U32, r)), FX.limbs(Nil{})))) : +List<U32>}, FD.logic__false_true(hl))
    case Nil{} Con{+h, +t}:
      +ha = Equal.cong(+List<U32>, +List<U32>, z => VS.bt(1n, z), VS.bt(1n, VS.bdr(3n, FX.limbs(Con{h, t}))), UW.ZB(1n), hz)
      +eh = UWB.zl3(h, ha)
      %Equal.sym(+List<U32>, I.limb(U32.or(h, U32.or(O.shl_bytes(w, 3), c))), List.append(&2, U32, VS.bt(3n, I.limb(U32.or(h, c))), VS.bt(1n, I.limb(w))), e1(h, w, c, eh, hc)) :
        {List.append(&2, U32, _, FX.limbs(t)) == List.append(&2, U32, VS.bt(3n, I.limb(U32.or(h, c))), List.append(&2, U32, VS.bt(1n, FX.limbs([w])), VS.bdr(4n, FX.limbs(Con{h, t})))) : +List<U32>}
      {==}
    case Con{+w2, +r2} Con{+h, +t}:
      match t:
        case Nil{}: Empty.absurd({FX.limbs(UW.SWLo(3, Con{w, Con{w2, r2}}, Con{h, Nil{}}, c)) == List.append(&2, U32, VS.bt(3n, I.limb(U32.or(h, c))), List.append(&2, U32, VS.bt(Nat.add(1n, A.quad(List.length(&2, U32, Con{w2, r2}))), FX.limbs(Con{w, Con{w2, r2}})), VS.bdr(4n+A.quad(List.length(&2, U32, Con{w2, r2})), FX.limbs(Con{h, Nil{}})))) : +List<U32>}, FD.logic__false_true(hl))
        case Con{+t0, +tr}:
          +X = A.quad(List.length(&2, U32, r2))
          +L2 = FX.limbs(Con{t0, tr})
          +HZ = VS.bt(Nat.add(1n, A.quad(List.length(&2, U32, Con{w2, r2}))), VS.bdr(3n, FX.limbs(Con{h, Con{t0, tr}})))
          +ZZ = UW.ZB(Nat.add(1n, A.quad(List.length(&2, U32, Con{w2, r2}))))
          +ha = Equal.cong(+List<U32>, +List<U32>, z => VS.bt(1n, z), HZ, ZZ, hz)
          +hb = Equal.cong(+List<U32>, +List<U32>, z => VS.bdr(1n, z), HZ, ZZ, hz)
          +hb2 = Equal.trans(+List<U32>, VS.bt(4n+X, L2), VS.bdr(1n, HZ), UW.ZB(4n+X), {==}, Equal.trans(+List<U32>, VS.bdr(1n, HZ), VS.bdr(1n, ZZ), UW.ZB(4n+X), hb, {==}))
          +hc0 = Equal.cong(+List<U32>, +List<U32>, z => VS.bt(3n, z), VS.bt(4n+X, L2), UW.ZB(4n+X), hb2)
          +hzi = Equal.trans(+List<U32>, VS.bt(Nat.add(1n, X), VS.bdr(3n, L2)), VS.bt(Nat.add(1n, X), VS.bdr(3n, VS.bt(4n+X, L2))), UW.ZB(Nat.add(1n, X)),
            UW.bt_bdr_bt(Nat.add(1n, X), 3n, 4n+X, L2, FD.nat__le_refl(4n+X)),
            Equal.trans(+List<U32>, VS.bt(Nat.add(1n, X), VS.bdr(3n, VS.bt(4n+X, L2))), VS.bt(Nat.add(1n, X), VS.bdr(3n, UW.ZB(4n+X))), UW.ZB(Nat.add(1n, X)),
              Equal.cong(+List<U32>, +List<U32>, z => VS.bt(Nat.add(1n, X), VS.bdr(3n, z)), VS.bt(4n+X, L2), UW.ZB(4n+X), hb2),
              UW.zb_win(3n, Nat.add(1n, X), 4n+X, FD.nat__le_refl(4n+X))))
          +eh = UWB.zl3(h, ha)
          +ez = UWB.zh3(t0, hc0)
          +ih = swlbo(r2, w2, Con{t0, tr}, O.shr_over(w, 3), hl, hzi, UWB.cm3(w))
          +RHS = List.append(&2, U32, VS.bt(3n, I.limb(U32.or(h, c))), List.append(&2, U32, VS.bt(Nat.add(1n, A.quad(List.length(&2, U32, Con{w2, r2}))), FX.limbs(Con{w, Con{w2, r2}})), VS.bdr(4n+A.quad(List.length(&2, U32, Con{w2, r2})), FX.limbs(Con{h, Con{t0, tr}}))))
          %Equal.sym(+List<U32>, I.limb(U32.or(h, U32.or(O.shl_bytes(w, 3), c))), List.append(&2, U32, VS.bt(3n, I.limb(U32.or(h, c))), VS.bt(1n, I.limb(w))), e1(h, w, c, eh, hc)) :
            {List.append(&2, U32, _, FX.limbs(UW.SWLo(3, Con{w2, r2}, Con{t0, tr}, O.shr_over(w, 3)))) == RHS : +List<U32>}
          %Equal.sym(+List<U32>, FX.limbs(UW.SWLo(3, Con{w2, r2}, Con{t0, tr}, O.shr_over(w, 3))), List.append(&2, U32, VS.bt(3n, I.limb(U32.or(t0, O.shr_over(w, 3)))), List.append(&2, U32, VS.bt(Nat.add(1n, X), FX.limbs(Con{w2, r2})), VS.bdr(4n+X, L2))), ih) :
            {List.append(&2, U32, List.append(&2, U32, VS.bt(3n, I.limb(U32.or(h, c))), VS.bt(1n, I.limb(w))), _) == RHS : +List<U32>}
          %Equal.sym(+List<U32>, VS.bt(3n, I.limb(U32.or(t0, O.shr_over(w, 3)))), VS.bdr(1n, I.limb(w)), e2(t0, w, ez)) :
            {List.append(&2, U32, List.append(&2, U32, VS.bt(3n, I.limb(U32.or(h, c))), VS.bt(1n, I.limb(w))), List.append(&2, U32, _, List.append(&2, U32, VS.bt(Nat.add(1n, X), FX.limbs(Con{w2, r2})), VS.bdr(4n+X, L2)))) == RHS : +List<U32>}
          {==}

# The open tree model's bytes: writing w : r at byte 3 of word i (no carry before, the
# carry out dropped) splices the first 4 |w : r| - 3 bytes of their limbs into the tree's
# bytes at 4 i + 3, when those were zero; the run's own words suffice (i + |w : r| <= 2^dd).
def swcbo(+w: U32, +r: +List<U32>, +dd: Nat, +D: FD.array__Tree<U32>, +i: Nat, +pf: {FD.array__perfect(U32, dd, D) == True{} : Bool},
    +hr: {Nat.is_le(Nat.add(i, 1n+List.length(&2, U32, r)), VB.pw(dd)) == True{} : Bool},
    +hz: {VS.bt(Nat.add(1n, A.quad(List.length(&2, U32, r))), VS.bdr(Nat.add(A.quad(i), 3n), UA.BYT(D))) == UW.ZB(Nat.add(1n, A.quad(List.length(&2, U32, r)))) : +List<U32>})
    -> {UA.BYT(UW.SWo(3, Con{w, r}, dd, D, i, 0)) == UW.SPL(UA.BYT(D), Nat.add(A.quad(i), 3n), VS.bt(Nat.add(1n, A.quad(List.length(&2, U32, r))), FX.limbs(Con{w, r}))) : +List<U32>}:
  +LZ = Nat.add(1n, A.quad(List.length(&2, U32, r)))
  +Y = VS.bt(LZ, FX.limbs(Con{w, r}))
  +eL = Equal.sym(Nat, VB.len(UW.SLW(D)), VB.pw(dd), FD.array__slots_length(U32, dd, D, pf))
  +hi2 = FD.logic__subst(Nat, z => {Nat.is_le(Nat.add(i, 1n+List.length(&2, U32, r)), z) == True{} : Bool}, VB.pw(dd), VB.len(UW.SLW(D)), eL, hr)
  +hi = FD.nat__lt_le_trans(i, Nat.add(i, 1n+List.length(&2, U32, r)), VB.pw(dd),
    FD.logic__subst(Nat, z => {Nat.is_lt(i, z) == True{} : Bool}, 1n+Nat.add(i, List.length(&2, U32, r)), Nat.add(i, 1n+List.length(&2, U32, r)),
      Equal.sym(Nat, Nat.add(i, 1n+List.length(&2, U32, r)), 1n+Nat.add(i, List.length(&2, U32, r)), FD.nat__add_succ(i, List.length(&2, U32, r))),
      FD.nat__le_lt_succ(i, Nat.add(i, List.length(&2, U32, r)), Order.below_sum(i, List.length(&2, U32, r)))), hr)
  +hl = FD.logic__subst(Nat, z => {Nat.is_lt(i, z) == True{} : Bool}, VB.pw(dd), VB.len(UW.SLW(D)), eL, hi)
  +eW = Equal.trans(+List<U32>, VS.bdr(Nat.add(A.quad(i), 3n), UA.BYT(D)), VS.bdr(3n, VS.bdr(A.quad(i), UA.BYT(D))), VS.bdr(3n, FX.limbs(VB.wdr(i, UW.SLW(D)))),
    UW.bdr_add(A.quad(i), 3n, UA.BYT(D)),
    Equal.cong(+List<U32>, +List<U32>, z => VS.bdr(3n, z), VS.bdr(A.quad(i), UA.BYT(D)), FX.limbs(VB.wdr(i, UW.SLW(D))), UW.bdr_limbs_w(i, UW.SLW(D))))
  +hz2 = FD.logic__subst(+List<U32>, z => {VS.bt(LZ, z) == UW.ZB(LZ) : +List<U32>}, VS.bdr(Nat.add(A.quad(i), 3n), UA.BYT(D)), VS.bdr(3n, FX.limbs(VB.wdr(i, UW.SLW(D)))), eW, hz)
  +sw = swlbo(r, w, VB.wdr(i, UW.SLW(D)), 0, UW.le_wdr(i, 1n+List.length(&2, U32, r), UW.SLW(D), hi2), hz2, {==})
  +eY = VS.bt_len(LZ, FX.limbs(Con{w, r}), FD.logic__subst(Nat, z => {Nat.is_le(LZ, z) == True{} : Bool}, 4n+A.quad(List.length(&2, U32, r)), List.length(&2, U32, FX.limbs(Con{w, r})),
    Equal.sym(Nat, List.length(&2, U32, FX.limbs(Con{w, r})), A.quad(List.length(&2, U32, Con{w, r})), UW.len_limbs_q(Con{w, r})), Order.add_right(1n, 4n, A.quad(List.length(&2, U32, r)), {==})))
  +RHS = UW.SPL(UA.BYT(D), Nat.add(A.quad(i), 3n), Y)
  +SWLt = UW.SWLo(3, Con{w, r}, VB.wdr(i, UW.SLW(D)), 0)
  %Equal.sym(List<&2, U32>, UW.SLW(UW.SWo(3, Con{w, r}, dd, D, i, 0)), VF.app(VS.wtake(i, UW.SLW(D)), SWLt), UW.swo_slots(3, Con{w, r}, dd, D, i, 0, pf, hr)) :
    {FX.limbs(_) == RHS : +List<U32>}
  %Equal.sym(+List<U32>, FX.limbs(VF.app(VS.wtake(i, UW.SLW(D)), SWLt)), List.append(&2, U32, FX.limbs(VS.wtake(i, UW.SLW(D))), FX.limbs(SWLt)), VF.limbs_app(VS.wtake(i, UW.SLW(D)), SWLt)) :
    {_ == RHS : +List<U32>}
  %VS.bt_limbs(i, UW.SLW(D)) : {List.append(&2, U32, _, FX.limbs(SWLt)) == RHS : +List<U32>}
  %Equal.sym(+List<U32>, FX.limbs(SWLt), List.append(&2, U32, VS.bt(3n, I.limb(U32.or(FD.flat__nthc(VB.wdr(i, UW.SLW(D)), 0n), 0))), List.append(&2, U32, Y, VS.bdr(4n+A.quad(List.length(&2, U32, r)), FX.limbs(VB.wdr(i, UW.SLW(D)))))), sw) :
    {List.append(&2, U32, VS.bt(A.quad(i), UA.BYT(D)), _) == RHS : +List<U32>}
  %Equal.sym(U32, FD.flat__nthc(VB.wdr(i, UW.SLW(D)), 0n), FD.flat__nthc(UW.SLW(D), i), UW.nthc_wdr(i, UW.SLW(D))) :
    {List.append(&2, U32, VS.bt(A.quad(i), UA.BYT(D)), List.append(&2, U32, VS.bt(3n, I.limb(U32.or(_, 0))), List.append(&2, U32, Y, VS.bdr(4n+A.quad(List.length(&2, U32, r)), FX.limbs(VB.wdr(i, UW.SLW(D))))))) == RHS : +List<U32>}
  %Equal.sym(U32, U32.or(FD.flat__nthc(UW.SLW(D), i), 0), FD.flat__nthc(UW.SLW(D), i), UWB.or0r(FD.flat__nthc(UW.SLW(D), i))) :
    {List.append(&2, U32, VS.bt(A.quad(i), UA.BYT(D)), List.append(&2, U32, VS.bt(3n, I.limb(_)), List.append(&2, U32, Y, VS.bdr(4n+A.quad(List.length(&2, U32, r)), FX.limbs(VB.wdr(i, UW.SLW(D))))))) == RHS : +List<U32>}
  %UW.slot_limb(UW.SLW(D), i, hl) :
    {List.append(&2, U32, VS.bt(A.quad(i), UA.BYT(D)), List.append(&2, U32, VS.bt(3n, _), List.append(&2, U32, Y, VS.bdr(4n+A.quad(List.length(&2, U32, r)), FX.limbs(VB.wdr(i, UW.SLW(D))))))) == RHS : +List<U32>}
  %Equal.sym(+List<U32>, VS.bt(3n, VS.bt(Nat.add(3n, 1n), VS.bdr(A.quad(i), UA.BYT(D)))), VS.bt(3n, VS.bdr(A.quad(i), UA.BYT(D))), VS.bt_bt(3n, 1n, VS.bdr(A.quad(i), UA.BYT(D)))) :
    {List.append(&2, U32, VS.bt(A.quad(i), UA.BYT(D)), List.append(&2, U32, _, List.append(&2, U32, Y, VS.bdr(4n+A.quad(List.length(&2, U32, r)), FX.limbs(VB.wdr(i, UW.SLW(D))))))) == RHS : +List<U32>}
  %UW.bdr_limbs_w(i, UW.SLW(D)) :
    {List.append(&2, U32, VS.bt(A.quad(i), UA.BYT(D)), List.append(&2, U32, VS.bt(3n, VS.bdr(A.quad(i), UA.BYT(D))), List.append(&2, U32, Y, VS.bdr(4n+A.quad(List.length(&2, U32, r)), _)))) == RHS : +List<U32>}
  %eY :
    {List.append(&2, U32, VS.bt(A.quad(i), UA.BYT(D)), List.append(&2, U32, VS.bt(3n, VS.bdr(A.quad(i), UA.BYT(D))), List.append(&2, U32, Y, VS.bdr(Nat.add(3n, _), VS.bdr(A.quad(i), UA.BYT(D)))))) == RHS : +List<U32>}
  UW.spl_comb(UA.BYT(D), A.quad(i), 3n, Y)
