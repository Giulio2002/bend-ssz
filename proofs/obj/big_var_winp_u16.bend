    -> {Nat.add(List.length(&2, U32, P8), Layout.fixed_size(pb)) == 2n+Nat.double(Codec.count(t)) : Nat}:
  %Equal.sym(Nat, List.length(&2, U32, P8), 2n, l8) : {Nat.add(_, Layout.fixed_size(pb)) == 2n+Nat.double(Codec.count(t)) : Nat}
  %Equal.sym(Nat, Layout.fixed_size(pb), Nat.double(Codec.count(t)), hs) : {2n+_ == 2n+Nat.double(Codec.count(t)) : Nat}
  {==}

def rep_t2(+P8: +List<U32>, +el: S.Value, +t: S.Value, +pb: +List<S.Part>, +l8: {List.length(&2, U32, P8) == 2n : Nat}, r: REPF(t, pb))
    -> REPF(S.Items{el, t}, S.Fixed{P8} <> pb):
  (+ha, +hs) = r
  (ha, rep_len(P8, pb, t, l8, hs))

def rep_t(+P8: +List<U32>, +el: S.Value, +t: S.Value, +ps: +List<S.Part>, +mB: Maybe<&2, +List<S.Part>>,
    +eB: {Codec.parts(t, S.Repeat{U16S()}) == mB : Maybe<&2, +List<S.Part>>},
    +l8: {List.length(&2, U32, P8) == 2n : Nat},
    +e: {Codec.concatenate(Some{[S.Fixed{P8}]}, mB) == Some{ps} : Maybe<&2, +List<S.Part>>},
    ih: @+pb: +List<S.Part> -> {Codec.parts(t, S.Repeat{U16S()}) == Some{pb} : Maybe<&2, +List<S.Part>>} -> REPF(t, pb))
    -> REPF(S.Items{el, t}, ps):
  match mB:
    case None{}: Empty.absurd(REPF(S.Items{el, t}, ps), FD.logic__none_some(+List<S.Part>, ps, e))
    case Some{+pb}:
      +eps = FD.logic__some_inj(+List<S.Part>, S.Fixed{P8} <> pb, ps, e)
      %Equal.sym(+List<S.Part>, ps, S.Fixed{P8} <> pb, Equal.sym(+List<S.Part>, S.Fixed{P8} <> pb, ps, eps)) : REPF(S.Items{el, t}, _)
      rep_t2(P8, el, t, pb, l8, ih(pb, eB))


def rep_u(+a0: U32, +a1: U32, +a2: U32, +a3: U32, +a4: U32, +a5: U32, +a6: U32, +a7: U32, +t: S.Value, +ps: +List<S.Part>, +b: Bool,
    +e: {Codec.concatenate(Codec.one(SP.optional(b, SP.prefix(2n, SP.full_digits(P.UInt{a0, a1, a2, a3, a4, a5, a6, a7}))), Some{2n}), Codec.parts(t, S.Repeat{U16S()})) == Some{ps} : Maybe<&2, +List<S.Part>>},
    ih: @+pb: +List<S.Part> -> {Codec.parts(t, S.Repeat{U16S()}) == Some{pb} : Maybe<&2, +List<S.Part>>} -> REPF(t, pb))
    -> REPF(S.Items{S.UnsignedValue{P.UInt{a0, a1, a2, a3, a4, a5, a6, a7}}, t}, ps):
  match b:
    case False{}: Empty.absurd(REPF(S.Items{S.UnsignedValue{P.UInt{a0, a1, a2, a3, a4, a5, a6, a7}}, t}, ps), FD.logic__none_some(+List<S.Part>, ps, e))
    case True{}: rep_t(SP.prefix(2n, SP.full_digits(P.UInt{a0, a1, a2, a3, a4, a5, a6, a7})), S.UnsignedValue{P.UInt{a0, a1, a2, a3, a4, a5, a6, a7}}, t, ps, Codec.parts(t, S.Repeat{U16S()}), {==}, {==}, e, ih)

law rep_facts:
  for +its: S.Value
  for +ps: +List<S.Part>
  for +e: {Codec.parts(its, S.Repeat{U16S()}) == Some{ps} : Maybe<&2, +List<S.Part>>}
  REPF(its, ps)
def rep_facts(its, ps, e):
  match its:
    case S.EmptyItems{}:
      +eps = FD.logic__some_inj(+List<S.Part>, [], ps, e)
      %Equal.sym(+List<S.Part>, ps, [], Equal.sym(+List<S.Part>, [], ps, eps)) : REPF(S.EmptyItems{}, _)
      ({==}, {==})
    case S.Items{S.UnsignedValue{P.UInt{+a0, +a1, +a2, +a3, +a4, +a5, +a6, +a7}}, +t}:
      rep_u(a0, a1, a2, a3, a4, a5, a6, a7, t, ps, SP.uint_domain(P.U16{}, P.UInt{a0, a1, a2, a3, a4, a5, a6, a7}), e, pb => eb => rep_facts(t, pb, eb))
    case S.BooleanValue{+b}: Empty.absurd(REPF(S.BooleanValue{b}, ps), FD.logic__none_some(+List<S.Part>, ps, e))
    case S.UnsignedValue{+u}: Empty.absurd(REPF(S.UnsignedValue{u}, ps), FD.logic__none_some(+List<S.Part>, ps, e))
    case S.BytesValue{+xs}: Empty.absurd(REPF(S.BytesValue{xs}, ps), FD.logic__none_some(+List<S.Part>, ps, e))
    case S.BitsValue{+bs}: Empty.absurd(REPF(S.BitsValue{bs}, ps), FD.logic__none_some(+List<S.Part>, ps, e))
    case S.Sequence{+it}: Empty.absurd(REPF(S.Sequence{it}, ps), FD.logic__none_some(+List<S.Part>, ps, e))
    case S.Items{S.BooleanValue{+b}, +t}: Empty.absurd(REPF(S.Items{S.BooleanValue{b}, t}, ps), FD.logic__none_some(+List<S.Part>, ps, e))
    case S.Items{S.BytesValue{+xs}, +t}: Empty.absurd(REPF(S.Items{S.BytesValue{xs}, t}, ps), FD.logic__none_some(+List<S.Part>, ps, e))
    case S.Items{S.BitsValue{+bs}, +t}: Empty.absurd(REPF(S.Items{S.BitsValue{bs}, t}, ps), FD.logic__none_some(+List<S.Part>, ps, e))
    case S.Items{S.Sequence{+it}, +t}: Empty.absurd(REPF(S.Items{S.Sequence{it}, t}, ps), FD.logic__none_some(+List<S.Part>, ps, e))
    case S.Items{S.Items{+hd, +tl}, +t}: Empty.absurd(REPF(S.Items{S.Items{hd, tl}, t}, ps), FD.logic__none_some(+List<S.Part>, ps, e))
    case S.Items{S.EmptyItems{}, +t}: Empty.absurd(REPF(S.Items{S.EmptyItems{}, t}, ps), FD.logic__none_some(+List<S.Part>, ps, e))
    case S.Items{S.Selected{+sel, +sv}, +t}: Empty.absurd(REPF(S.Items{S.Selected{sel, sv}, t}, ps), FD.logic__none_some(+List<S.Part>, ps, e))
    case S.Items{S.NullValue{}, +t}: Empty.absurd(REPF(S.Items{S.NullValue{}, t}, ps), FD.logic__none_some(+List<S.Part>, ps, e))
    case S.Selected{+sel, +sv}: Empty.absurd(REPF(S.Selected{sel, sv}, ps), FD.logic__none_some(+List<S.Part>, ps, e))
    case S.NullValue{}: Empty.absurd(REPF(S.NullValue{}, ps), FD.logic__none_some(+List<S.Part>, ps, e))

def ivf(+d: Nat, +t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +c: Nat,
    +ys: +List<U32>, +ly: {List.length(&2, U32, ys) == Nat.double(c) : Nat}, +ey: {ys == UW.WX(t, x, U32.to_nat(len)) : +List<U32>})
    -> {CHKw(t, x, off, len) == True{} : Bool}:
  +el = Equal.trans(Nat, U32.to_nat(len), List.length(&2, U32, UW.WX(t, x, U32.to_nat(len))), Nat.double(c),
    Equal.sym(Nat, List.length(&2, U32, UW.WX(t, x, U32.to_nat(len))), U32.to_nat(len), UW.lenWX(d, t, x, U32.to_nat(len), pf, hw)),
    Equal.trans(Nat, List.length(&2, U32, UW.WX(t, x, U32.to_nat(len))), List.length(&2, U32, ys), Nat.double(c),
      Equal.cong(+List<U32>, Nat, z => List.length(&2, U32, z), UW.WX(t, x, U32.to_nat(len)), ys, Equal.sym(+List<U32>, ys, UW.WX(t, x, U32.to_nat(len)), ey)), ly))
  chk2(t, x, off, len, c, el)

def ivm4(+d: Nat, +t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +its: S.Value,
    +ps: +List<S.Part>, +em3: {Codec.parts(its, S.Repeat{U16S()}) == Some{ps} : Maybe<&2, +List<S.Part>>},
    +m4: Maybe<&2, +List<U32>>, +em4: {Layout.encoding(ps) == m4 : Maybe<&2, +List<U32>>},
    +e: {Codec.one(m4, None{}) == Some{[S.Variable{UW.WX(t, x, U32.to_nat(len))}]} : Maybe<&2, +List<S.Part>>})
    -> {CHKw(t, x, off, len) == True{} : Bool}:
  match m4:
    case None{}: Empty.absurd({CHKw(t, x, off, len) == True{} : Bool}, FD.logic__none_some(+List<S.Part>, [S.Variable{UW.WX(t, x, U32.to_nat(len))}], e))
    case Some{+ys}:
      +lys = Equal.trans(Nat, List.length(&2, U32, ys), Layout.fixed_size(ps), Nat.double(Codec.count(its)),
        VS.enc_len(ps, ys, Pair.fst({VS.allfix(ps) == True{} : Bool}, {Layout.fixed_size(ps) == Nat.double(Codec.count(its)) : Nat}, rep_facts(its, ps, em3)), em4),
        Pair.snd({VS.allfix(ps) == True{} : Bool}, {Layout.fixed_size(ps) == Nat.double(Codec.count(its)) : Nat}, rep_facts(its, ps, em3)))
      ivf(d, t, x, off, len, hw, pf, Codec.count(its), ys, lys, var_inj(ys, UW.WX(t, x, U32.to_nat(len)), e))

def ivm3(+d: Nat, +t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +its: S.Value,
    +m3: Maybe<&2, +List<S.Part>>, +em3: {Codec.parts(its, S.Repeat{U16S()}) == m3 : Maybe<&2, +List<S.Part>>},
    +e: {Codec.aggregate(m3, None{}) == Some{[S.Variable{UW.WX(t, x, U32.to_nat(len))}]} : Maybe<&2, +List<S.Part>>})
    -> {CHKw(t, x, off, len) == True{} : Bool}:
  match m3:
    case None{}: Empty.absurd({CHKw(t, x, off, len) == True{} : Bool}, FD.logic__none_some(+List<S.Part>, [S.Variable{UW.WX(t, x, U32.to_nat(len))}], e))
    case Some{+ps}: ivm4(d, t, x, off, len, hw, pf, its, ps, em3, Layout.encoding(ps), {==}, e)

# Every value whose spec parts are the window's bytes passes the checks.
def invw(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +v: S.Value,
    +e: {Codec.parts(v, Spec.GtF23A2FB97E()) == Some{[S.Variable{UW.WX(t, x, U32.to_nat(len))}]} : Maybe<&2, +List<S.Part>>})
    -> {CHKw(t, x, off, len) == True{} : Bool}:
  match v:
    case S.Sequence{+its}: ivm3(d, t, x, off, len, hw, pf, its, Codec.parts(its, S.Repeat{U16S()}), {==}, e)
    case S.BooleanValue{+b0}: Empty.absurd({CHKw(t, x, off, len) == True{} : Bool}, FD.logic__none_some(+List<S.Part>, [S.Variable{UW.WX(t, x, U32.to_nat(len))}], e))
    case S.UnsignedValue{+u0}: Empty.absurd({CHKw(t, x, off, len) == True{} : Bool}, FD.logic__none_some(+List<S.Part>, [S.Variable{UW.WX(t, x, U32.to_nat(len))}], e))
    case S.BytesValue{+xs0}: Empty.absurd({CHKw(t, x, off, len) == True{} : Bool}, FD.logic__none_some(+List<S.Part>, [S.Variable{UW.WX(t, x, U32.to_nat(len))}], e))
    case S.BitsValue{+bs0}: Empty.absurd({CHKw(t, x, off, len) == True{} : Bool}, FD.logic__none_some(+List<S.Part>, [S.Variable{UW.WX(t, x, U32.to_nat(len))}], e))
    case S.Items{+hd0, +tl0}: Empty.absurd({CHKw(t, x, off, len) == True{} : Bool}, FD.logic__none_some(+List<S.Part>, [S.Variable{UW.WX(t, x, U32.to_nat(len))}], e))
    case S.EmptyItems{}: Empty.absurd({CHKw(t, x, off, len) == True{} : Bool}, FD.logic__none_some(+List<S.Part>, [S.Variable{UW.WX(t, x, U32.to_nat(len))}], e))
    case S.Selected{+sel0, +sv0}: Empty.absurd({CHKw(t, x, off, len) == True{} : Bool}, FD.logic__none_some(+List<S.Part>, [S.Variable{UW.WX(t, x, U32.to_nat(len))}], e))
    case S.NullValue{}: Empty.absurd({CHKw(t, x, off, len) == True{} : Bool}, FD.logic__none_some(+List<S.Part>, [S.Variable{UW.WX(t, x, U32.to_nat(len))}], e))
