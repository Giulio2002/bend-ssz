def AC7_5(+t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32) -> Bool: Bool.and(AC7_4(t, x, off, len), EW(Bool.and(AC7_4(t, x, off, len), Bool.and(U32.is_le(O4(t, x), O5(t, x)), U32.is_le(O5(t, x), len))), D7_4(t, x, off, len)))
def AC7_6(+t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32) -> Bool: Bool.and(AC7_5(t, x, off, len), EW(Bool.and(AC7_5(t, x, off, len), Bool.and(U32.is_le(O5(t, x), O6(t, x)), U32.is_le(O6(t, x), len))), D7_5(t, x, off, len)))
def AC7_7(+t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32) -> Bool: Bool.and(AC7_6(t, x, off, len), EW(Bool.and(AC7_6(t, x, off, len), Bool.and(U32.is_le(O6(t, x), len), U32.is_le(len, len))), D7_6(t, x, off, len)))

def D8_0(+t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32) -> Bool: CH.CHKw(t, Nat.add(U32.to_nat(O0(t, x)), x), U32.add(off, O0(t, x)), U32.sub(O1(t, x), O0(t, x)))
def D8_1(+t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32) -> Bool: CH.CHKw(t, Nat.add(U32.to_nat(O1(t, x)), x), U32.add(off, O1(t, x)), U32.sub(O2(t, x), O1(t, x)))
def D8_2(+t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32) -> Bool: CH.CHKw(t, Nat.add(U32.to_nat(O2(t, x)), x), U32.add(off, O2(t, x)), U32.sub(O3(t, x), O2(t, x)))
def D8_3(+t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32) -> Bool: CH.CHKw(t, Nat.add(U32.to_nat(O3(t, x)), x), U32.add(off, O3(t, x)), U32.sub(O4(t, x), O3(t, x)))
def D8_4(+t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32) -> Bool: CH.CHKw(t, Nat.add(U32.to_nat(O4(t, x)), x), U32.add(off, O4(t, x)), U32.sub(O5(t, x), O4(t, x)))
def D8_5(+t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32) -> Bool: CH.CHKw(t, Nat.add(U32.to_nat(O5(t, x)), x), U32.add(off, O5(t, x)), U32.sub(O6(t, x), O5(t, x)))
def D8_6(+t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32) -> Bool: CH.CHKw(t, Nat.add(U32.to_nat(O6(t, x)), x), U32.add(off, O6(t, x)), U32.sub(O7(t, x), O6(t, x)))
def D8_7(+t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32) -> Bool: CH.CHKw(t, Nat.add(U32.to_nat(O7(t, x)), x), U32.add(off, O7(t, x)), U32.sub(len, O7(t, x)))
def AC8_0(+t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32) -> Bool: True{}
def AC8_1(+t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32) -> Bool: Bool.and(AC8_0(t, x, off, len), EW(Bool.and(AC8_0(t, x, off, len), Bool.and(U32.is_le(O0(t, x), O1(t, x)), U32.is_le(O1(t, x), len))), D8_0(t, x, off, len)))
def AC8_2(+t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32) -> Bool: Bool.and(AC8_1(t, x, off, len), EW(Bool.and(AC8_1(t, x, off, len), Bool.and(U32.is_le(O1(t, x), O2(t, x)), U32.is_le(O2(t, x), len))), D8_1(t, x, off, len)))
def AC8_3(+t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32) -> Bool: Bool.and(AC8_2(t, x, off, len), EW(Bool.and(AC8_2(t, x, off, len), Bool.and(U32.is_le(O2(t, x), O3(t, x)), U32.is_le(O3(t, x), len))), D8_2(t, x, off, len)))
def AC8_4(+t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32) -> Bool: Bool.and(AC8_3(t, x, off, len), EW(Bool.and(AC8_3(t, x, off, len), Bool.and(U32.is_le(O3(t, x), O4(t, x)), U32.is_le(O4(t, x), len))), D8_3(t, x, off, len)))
def AC8_5(+t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32) -> Bool: Bool.and(AC8_4(t, x, off, len), EW(Bool.and(AC8_4(t, x, off, len), Bool.and(U32.is_le(O4(t, x), O5(t, x)), U32.is_le(O5(t, x), len))), D8_4(t, x, off, len)))
def AC8_6(+t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32) -> Bool: Bool.and(AC8_5(t, x, off, len), EW(Bool.and(AC8_5(t, x, off, len), Bool.and(U32.is_le(O5(t, x), O6(t, x)), U32.is_le(O6(t, x), len))), D8_5(t, x, off, len)))
def AC8_7(+t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32) -> Bool: Bool.and(AC8_6(t, x, off, len), EW(Bool.and(AC8_6(t, x, off, len), Bool.and(U32.is_le(O6(t, x), O7(t, x)), U32.is_le(O7(t, x), len))), D8_6(t, x, off, len)))
def AC8_8(+t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32) -> Bool: Bool.and(AC8_7(t, x, off, len), EW(Bool.and(AC8_7(t, x, off, len), Bool.and(U32.is_le(O7(t, x), len), U32.is_le(len, len))), D8_7(t, x, off, len)))

def LOOP(q: Nat, +t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32) -> Bool:
  match q:
    case 0n: False{}
    case 1n: AC1_1(t, x, off, len)
    case 2n: AC2_2(t, x, off, len)
    case 3n: AC3_3(t, x, off, len)
    case 4n: AC4_4(t, x, off, len)
    case 5n: AC5_5(t, x, off, len)
    case 6n: AC6_6(t, x, off, len)
    case 7n: AC7_7(t, x, off, len)
    case 8n: AC8_8(t, x, off, len)
    case 9n+r: False{}

def HK(h: Bool, +t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32) -> Bool:
  match h:
    case True{}: LOOP(NQ(t, x), t, x, off, len)
    case False{}: False{}

def L4(s: Bool, +t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32) -> Bool:
  match s:
    case True{}: False{}
    case False{}: HK(HC(t, x, len), t, x, off, len)

def LZ(z: Bool, +t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32) -> Bool:
  match z:
    case True{}: True{}
    case False{}: L4(U32.is_lt(len, 4), t, x, off, len)

# Empty, or at least 4 bytes, a first offset 4 m with 1 <= m <= N inside the
# window, and the m element windows pass (CK_m = AC_m_m).
def CHKw(+t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32) -> Bool: LZ(U32.is_eq(len, 0), t, x, off, len)

def le_nat(+a: U32, +b: U32, +h: {U32.is_le(a, b) == True{} : Bool}) -> {Nat.is_le(U32.to_nat(a), U32.to_nat(b)) == True{} : Bool}:
  FD.logic__subst(Bool, z => {z == True{} : Bool}, U32.is_le(a, b), Nat.is_le(U32.to_nat(a), U32.to_nat(b)), VU.le_u32(a, b), h)

def u32le(+a: U32, +b: U32, +h: {Nat.is_le(U32.to_nat(a), U32.to_nat(b)) == True{} : Bool}) -> {U32.is_le(a, b) == True{} : Bool}:
  FD.logic__subst(Bool, z => {z == True{} : Bool}, Nat.is_le(U32.to_nat(a), U32.to_nat(b)), U32.is_le(a, b), Equal.sym(Bool, U32.is_le(a, b), Nat.is_le(U32.to_nat(a), U32.to_nat(b)), VU.le_u32(a, b)), h)

def and_l(+a: Bool, +b: Bool, +h: {Bool.and(a, b) == True{} : Bool}) -> {a == True{} : Bool}: FD.logic__and_left(a, b, h)
def and_r(+a: Bool, +b: Bool, +h: {Bool.and(a, b) == True{} : Bool}) -> {b == True{} : Bool}: FD.logic__and_right(a, b, h)

def ew_l(+ok: Bool, +dd: Bool, +h: {EW(ok, dd) == True{} : Bool}) -> {ok == True{} : Bool}:
  match ok:
    case True{}: {==}
    case False{}: h

def ew_r(+ok: Bool, +dd: Bool, +h: {EW(ok, dd) == True{} : Bool}) -> {dd == True{} : Bool}:
  match ok:
    case True{}: h
    case False{}: Empty.absurd({dd == True{} : Bool}, FD.logic__false_true(h))

# A byte position o <= len of the window, as an offset: off + o at o + x.
def eoj(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +o: U32, +h: {Nat.is_le(U32.to_nat(o), U32.to_nat(len)) == True{} : Bool})
    -> {U32.to_nat(U32.add(off, o)) == Nat.add(U32.to_nat(o), x) : Nat}:
  +hl = FD.nat__le_trans(Nat.add(U32.to_nat(o), x), Nat.add(U32.to_nat(len), x), A.quad(VB.pw(d)), Order.add_right(U32.to_nat(o), U32.to_nat(len), x, h),
    FD.logic__subst(Nat, z => {Nat.is_le(z, A.quad(VB.pw(d))) == True{} : Bool}, Nat.add(x, U32.to_nat(len)), Nat.add(U32.to_nat(len), x), FD.nat__add_comm(x, U32.to_nat(len)), hw))
  VB.add_at(off, o, x, 3n+d, eo, FD.nat__lt_trans(3n+d, 31n, 32n, hd, {==}), VB.le_pw_lt(Nat.add(U32.to_nat(o), x), 2n+d, hl))

def alg(+o: Nat, +x: Nat, +e: Nat, +h: {Nat.is_le(o, e) == True{} : Bool}) -> {Nat.add(Nat.add(o, x), Nat.sub(e, o)) == Nat.add(x, e) : Nat}:
  %Equal.sym(Nat, Nat.add(Nat.add(o, x), Nat.sub(e, o)), Nat.add(o, Nat.add(x, Nat.sub(e, o))), FD.nat__add_assoc(o, x, Nat.sub(e, o))) : {_ == Nat.add(x, e) : Nat}
  %Equal.sym(Nat, Nat.add(o, Nat.add(x, Nat.sub(e, o))), Nat.add(x, Nat.add(o, Nat.sub(e, o))), FD.lru_nat_algebra__add_swap(o, x, Nat.sub(e, o))) : {_ == Nat.add(x, e) : Nat}
  %Equal.sym(Nat, Nat.add(o, Nat.sub(e, o)), e, FD.nat__sub_add(e, o, h)) : {Nat.add(x, _) == Nat.add(x, e) : Nat}
  {==}

# The window [o, e) of the window: (o + x) + (e - o) <= 4 2^d.
def hwj(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +o: U32, +e: U32, +h1: {Nat.is_le(U32.to_nat(o), U32.to_nat(e)) == True{} : Bool}, +h2: {Nat.is_le(U32.to_nat(e), U32.to_nat(len)) == True{} : Bool})
    -> {Nat.is_le(Nat.add(Nat.add(U32.to_nat(o), x), U32.to_nat(U32.sub(e, o))), A.quad(VB.pw(d))) == True{} : Bool}:
  %Equal.sym(Nat, U32.to_nat(U32.sub(e, o)), Nat.sub(U32.to_nat(e), U32.to_nat(o)), FD.u32__sub_nat(e, o, h1)) : {Nat.is_le(Nat.add(Nat.add(U32.to_nat(o), x), _), A.quad(VB.pw(d))) == True{} : Bool}
  %Equal.sym(Nat, Nat.add(Nat.add(U32.to_nat(o), x), Nat.sub(U32.to_nat(e), U32.to_nat(o))), Nat.add(x, U32.to_nat(e)), alg(U32.to_nat(o), x, U32.to_nat(e), h1)) :
    {Nat.is_le(_, A.quad(VB.pw(d))) == True{} : Bool}
  FD.nat__le_trans(Nat.add(x, U32.to_nat(e)), Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d)), Order.add_left(x, U32.to_nat(e), U32.to_nat(len), h2), hw)

# The four-byte read at off + c (c + 4 <= len).
def rdo(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +c: U32, +k: Nat, +ec: {U32.to_nat(c) == k : Nat}, +h: {Nat.is_le(Nat.add(k, 4n), U32.to_nat(len)) == True{} : Bool})
    -> {B.read32(BF(t, n), U32.add(off, c)) == (BF(t, n), UR.RWN(t, Nat.add(k, x))) : B.Buf & U32}:
  +hk = FD.nat__le_trans(k, Nat.add(k, 4n), U32.to_nat(len), Order.below_sum(k, 4n), h)
  +eoc = eoj(d, t, n, x, off, len, eo, hd, hw, pf, c, FD.logic__subst(Nat, z => {Nat.is_le(z, U32.to_nat(len)) == True{} : Bool}, k, U32.to_nat(c), Equal.sym(Nat, U32.to_nat(c), k, ec), hk))
  UR.rwx(d, t, n, U32.add(off, c), Nat.add(k, x), FD.logic__subst(Nat, z => {U32.to_nat(U32.add(off, c)) == Nat.add(z, x) : Nat}, U32.to_nat(c), k, ec, eoc),
    FD.nat__lt_trans(d, 28n, 31n, hd, {==}), pf, UR.roomw(x, U32.to_nat(len), k, A.quad(VB.pw(d)), hw, h))

# The element check at [a, b): the child's validator, when the ranges hold.
def ewl(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +acc: Bool, +a: U32, +b: U32, +ok: Bool, +e: {Bool.and(acc, Bool.and(U32.is_le(a, b), U32.is_le(b, len))) == ok : Bool})
    -> {Fulu_list_Attestation_8_r.l8_Attestation_ew(ok, BF(t, n), off, a, b) == (BF(t, n), EW(ok, CH.CHKw(t, Nat.add(U32.to_nat(a), x), U32.add(off, a), U32.sub(b, a)))) : B.Buf & Bool}:
  match ok:
    case False{}: {==}
    case True{}:
      +r = and_r(acc, Bool.and(U32.is_le(a, b), U32.is_le(b, len)), e)
      +hab = le_nat(a, b, and_l(U32.is_le(a, b), U32.is_le(b, len), r))
      +hbl = le_nat(b, len, and_r(U32.is_le(a, b), U32.is_le(b, len), r))
      %Equal.sym(B.Buf & Bool, FuluAttestation_r.Attestation_ok(BF(t, n), U32.add(off, a), U32.sub(b, a)), (BF(t, n), CH.CHKw(t, Nat.add(U32.to_nat(a), x), U32.add(off, a), U32.sub(b, a))),
          CH.ok_evalw(d, t, n, Nat.add(U32.to_nat(a), x), U32.add(off, a), U32.sub(b, a), eoj(d, t, n, x, off, len, eo, hd, hw, pf, a, FD.nat__le_trans(U32.to_nat(a), U32.to_nat(b), U32.to_nat(len), hab, hbl)), hd,
            hwj(d, t, n, x, off, len, eo, hd, hw, pf, a, b, hab, hbl), pf)) :
        {_ == (BF(t, n), CH.CHKw(t, Nat.add(U32.to_nat(a), x), U32.add(off, a), U32.sub(b, a))) : B.Buf & Bool}
      {==}

# A header check fails for a window of fewer than 4 bytes, whatever the first word.
def hc_small(+v: U32, +len: U32, +h: {Nat.is_lt(U32.to_nat(len), 4n) == True{} : Bool}, +a: Bool, +ea: {U32.is_eq(U32.and(v, 3), 0) == a : Bool},
    +b: Bool, +eb: {U32.is_le(v, len) == b : Bool}, +c: Bool, +ec: {U32.is_le(4, v) == c : Bool})
    -> {Bool.and(Bool.and(a, b), Bool.and(c, U32.is_le(U32.shrn(v, 2n), 8))) == False{} : Bool}:
  match a b c:
    case False{} _ _: {==}
    case True{} False{} _: {==}
    case True{} True{} False{}: {==}
    case True{} True{} True{}:
      +h4 = FD.nat__le_trans(4n, U32.to_nat(v), U32.to_nat(len), le_nat(4, v, ec), le_nat(v, len, eb))
      Empty.absurd({Bool.and(Bool.and(True{}, True{}), Bool.and(True{}, U32.is_le(U32.shrn(v, 2n), 8))) == False{} : Bool},
        FD.logic__false_true(FD.nat__le_lt_trans(4n, U32.to_nat(len), 4n, h4, h)))
def walk1(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hf: {Nat.is_le(Nat.add(4n, 0n), U32.to_nat(len)) == True{} : Bool})
    -> {Fulu_list_Attestation_8_r.l8_Attestation_ev(0n, 0, 1, off, len, Fulu_list_Attestation_8_r.l8_Attestation_ee(True{}, off, len, O0(t, x), Fulu_list_Attestation_8_r.l8_Attestation_next(U32.is_eq(1, 1), BF(t, n), off, len, 0))) == (BF(t, n), AC1_1(t, x, off, len)) : B.Buf & Bool}:
  %Equal.sym(B.Buf & Bool, Fulu_list_Attestation_8_r.l8_Attestation_ew(Bool.and(True{}, Bool.and(U32.is_le(O0(t, x), len), U32.is_le(len, len))), BF(t, n), off, O0(t, x), len), (BF(t, n), EW(Bool.and(True{}, Bool.and(U32.is_le(O0(t, x), len), U32.is_le(len, len))), D1_0(t, x, off, len))), ewl(d, t, n, x, off, len, eo, hd, hw, pf, True{}, O0(t, x), len, Bool.and(True{}, Bool.and(U32.is_le(O0(t, x), len), U32.is_le(len, len))), {==})) :
    {Fulu_list_Attestation_8_r.l8_Attestation_ev(0n, 0, 1, off, len, Fulu_list_Attestation_8_r.l8_Attestation_eb(len, O.and_pair(True{}, _))) == (BF(t, n), AC1_1(t, x, off, len)) : B.Buf & Bool}
  {==}

def walk2(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hf: {Nat.is_le(Nat.add(8n, 0n), U32.to_nat(len)) == True{} : Bool})
