      %Equal.sym(B.Buf & U32, B.read32(BF(t, n), off), (BF(t, n), O0(t, x)), UR.rwx(d, t, n, off, x, eo, FD.nat__lt_trans(d, 28n, 31n, hd, {==}), pf,
