  +ew7 = and_r(AC8_7(t, x, off, len), EW(Bool.and(AC8_7(t, x, off, len), Bool.and(U32.is_le(O7(t, x), len), U32.is_le(len, len))), D8_7(t, x, off, len)), ha8)
  +ha7 = and_l(AC8_7(t, x, off, len), EW(Bool.and(AC8_7(t, x, off, len), Bool.and(U32.is_le(O7(t, x), len), U32.is_le(len, len))), D8_7(t, x, off, len)), ha8)
  +ok7 = ew_l(Bool.and(AC8_7(t, x, off, len), Bool.and(U32.is_le(O7(t, x), len), U32.is_le(len, len))), D8_7(t, x, off, len), ew7)
  +hk7 = ew_r(Bool.and(AC8_7(t, x, off, len), Bool.and(U32.is_le(O7(t, x), len), U32.is_le(len, len))), D8_7(t, x, off, len), ew7)
  +rg7 = and_r(AC8_7(t, x, off, len), Bool.and(U32.is_le(O7(t, x), len), U32.is_le(len, len)), ok7)
  +hab7 = le_nat(O7(t, x), len, and_l(U32.is_le(O7(t, x), len), U32.is_le(len, len), rg7))
  +hbl7 = le_nat(len, len, and_r(U32.is_le(O7(t, x), len), U32.is_le(len, len), rg7))
