    case True{}: Empty.absurd({Codec.parts(V4(True{}, t, x, len), Spec.Schema99()) == Some{[S.Variable{UW.WX(t, x, U32.to_nat(len))}]} : Maybe<&2, +List<S.Part>>}, FD.logic__false_true(hc))
    case False{}:
      +hh = hk_l(HC(t, x, len), t, x, off, len, hc)
      +c1 = and_l(Bool.and(U32.is_eq(U32.and(O0(t, x), 3), 0), U32.is_le(O0(t, x), len)), Bool.and(U32.is_le(4, O0(t, x)), U32.is_le(U32.shrn(O0(t, x), 2n), 8)), hh)
      +hlp = FD.logic__subst(Bool, z => {HK(z, t, x, off, len) == True{} : Bool}, HC(t, x, len), True{}, hh, hc)
      specq(d, t, n, x, off, len, eo, hd, hw, pf, NQ(t, x), {==}, FD.u32alg__eq_of(U32.and(O0(t, x), 3), 0, and_l(U32.is_eq(U32.and(O0(t, x), 3), 0), U32.is_le(O0(t, x), len), c1)), hlp,
        le_nat(O0(t, x), len, and_r(U32.is_eq(U32.and(O0(t, x), 3), 0), U32.is_le(O0(t, x), len), c1)))

def specz(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +z: Bool, +ez: {U32.is_eq(len, 0) == z : Bool}, +hc: {LZ(z, t, x, off, len) == True{} : Bool})
    -> {Codec.parts(VZ(z, t, x, len), Spec.Schema99()) == Some{[S.Variable{UW.WX(t, x, U32.to_nat(len))}]} : Maybe<&2, +List<S.Part>>}:
