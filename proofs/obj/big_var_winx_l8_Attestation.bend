      +V = UR.RWW(d, t, off)
      %Equal.sym(B.Buf & U32, B.read32(BF(t, n), off), (BF(t, n), V), UR.rd_lt(d, t, n, off, FD.nat__lt_trans(d, 28n, 31n, hd, {==}), pf, hx)) :
        {Fulu_list_Attestation_8_r.l8_Attestation_head(len, off, _) == (BF(t, n), False{}) : B.Buf & Bool}
      %Equal.sym(Bool, Bool.and(Bool.and(U32.is_eq(U32.and(V, 3), 0), U32.is_le(V, len)), Bool.and(U32.is_le(4, V), U32.is_le(U32.shrn(V, 2n), 8))), False{},
          hc_small(V, len, hl4, U32.is_eq(U32.and(V, 3), 0), {==}, U32.is_le(V, len), {==}, U32.is_le(4, V), {==})) :
