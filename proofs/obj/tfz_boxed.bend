def amperf_l8_Attestation(+d: Nat, +t: F.array__Tree<RT.MB<RT.M_Attestation>>, +pf: {F.array__perfect(RT.MB<RT.M_Attestation>, d, t) == True{} : Bool}) -> TA.tperf(O.Boxed<FuluAttestation_d.Attestation>, d, RT.am_l8_Attestation(t)):
