    {O.pad_pick(1, (UA.BF(t, n), VRB.BX(t, Nat.add(2n, x)))) == (UA.BF(t, n), U32.is_eq(U32.and(_, U32.not(O.low_mask(1))), 0)) : B.Buf & Bool}
  %Equal.sym(Nat, Nat.add(x, 2n), Nat.add(2n, x), FD.nat__add_comm(x, 2n)) :
    {O.pad_pick(1, (UA.BF(t, n), VRB.BX(t, Nat.add(2n, x)))) == (UA.BF(t, n), U32.is_eq(U32.and(VBL.nthb(UA.BYT(t), _), U32.not(O.low_mask(1))), 0)) : B.Buf & Bool}
  {==}

def bitvector_17_oklD(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 3n), A.quad(VB.pw(d))) == True{} : Bool}, +b: Bool)
    -> {bitvector_17_r.bv17_ok_len(b, UA.BF(t, n), off) == (UA.BF(t, n), Bool.and(b, VRP.PADK(UW.WX(t, x, 3n), 2n, 1))) : B.Buf & Bool}:
  match b:
    case True{}: bitvector_17_atD(d, t, n, off, x, e, hd, pf, hb)
    case False{}: {==}

# the validator returns the length check and the padding check of the last window byte
def bitvector_17_ok_evalD(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 3n), A.quad(VB.pw(d))) == True{} : Bool}, +len: U32)
    -> {bitvector_17_r.bv17_ok(UA.BF(t, n), off, len) == (UA.BF(t, n), Bool.and(U32.is_eq(len, 3), VRP.PADK(UW.WX(t, x, 3n), 2n, 1))) : B.Buf & Bool}:
  bitvector_17_oklD(d, t, n, off, x, e, hd, pf, hb, U32.is_eq(len, 3))

# every encoding at BitVector[17]: its padding bits clear
def bitvector_17_dom(+bits: +List<Bool>, +bs: +List<U32>, +c: Bool, +ec: {Bool.and(Nat.is_lt(0n, 17n), Nat.is_eq(List.length(&2, Bool, bits), 17n)) == c : Bool},
    +e: {Codec.bytes(Codec.one(SBF.encoding(c, bits), Some{Nat.div(Nat.add(17n, 7n), 8n)})) == Some{bs} : Maybe<&2, +List<U32>>})
    -> {VRP.PADK(bs, 2n, 1) == True{} : Bool}:
  match c:
    case False{}: Empty.absurd({VRP.PADK(bs, 2n, 1) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case True{}:
      FD.logic__subst(+List<U32>, z => {VRP.PADK(z, 2n, 1) == True{} : Bool}, Bp.pack(bits), bs, FD.logic__some_inj(+List<U32>, Bp.pack(bits), bs, e), VRP.padq1(2n, bits, ec))
def bitvector_17_pv(+v: S.Value, +bs: +List<U32>, +e: {Codec.encoding_for_legal_type(GS.bitvector_17(), v) == Some{bs} : Maybe<&2, +List<U32>>})
    -> {VRP.PADK(bs, 2n, 1) == True{} : Bool}:
  match v:
    case S.BitsValue{+bits}: bitvector_17_dom(bits, bs, Bool.and(Nat.is_lt(0n, 17n), Nat.is_eq(List.length(&2, Bool, bits), 17n)), {==}, e)
    case S.BooleanValue{+b}: Empty.absurd({VRP.PADK(bs, 2n, 1) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case S.UnsignedValue{+u}: Empty.absurd({VRP.PADK(bs, 2n, 1) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case S.BytesValue{+xs}: Empty.absurd({VRP.PADK(bs, 2n, 1) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case S.Sequence{+it}: Empty.absurd({VRP.PADK(bs, 2n, 1) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case S.Items{+hh, +tt}: Empty.absurd({VRP.PADK(bs, 2n, 1) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case S.EmptyItems{}: Empty.absurd({VRP.PADK(bs, 2n, 1) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case S.Selected{+sel, +sv}: Empty.absurd({VRP.PADK(bs, 2n, 1) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case S.NullValue{}: Empty.absurd({VRP.PADK(bs, 2n, 1) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))

def bitvector_17_rj(+bs: +List<U32>, +h: {Bool.and(Nat.is_eq(List.length(&2, U32, bs), 3n), VRP.PADK(bs, 2n, 1)) == False{} : Bool}, +v: S.Value,
    +e: {Codec.encoding_for_legal_type(GS.bitvector_17(), v) == Some{bs} : Maybe<&2, +List<U32>>}) -> Empty:
  VRB.chk_true(Nat.is_eq(List.length(&2, U32, bs), 3n), VRP.PADK(bs, 2n, 1),
    VRB.len_eq(SS.fixed_size(GS.bitvector_17()), 3n, bs, Codec.parts(v, GS.bitvector_17()), DS.facts(v, GS.bitvector_17(), {==}), {==}, e), bitvector_17_pv(v, bs, e), h)

# a byte list of another length, or with a padding bit set, is no encoding
def bitvector_17_decode_reject(+bs: +List<U32>, +h: {Bool.and(Nat.is_eq(List.length(&2, U32, bs), 3n), VRP.PADK(bs, 2n, 1)) == False{} : Bool}) -> Decoding.outside_image(GS.bitvector_17(), bs):
  v => e => bitvector_17_rj(bs, h, v, e)

# ---- bitvector_1 (BitVector[1], 1 bytes; validator T.bv1_ok: bits 1..7 of byte 0 clear) ----
def bitvector_1_at(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 1n), A.quad(VB.pw(d))) == True{} : Bool})
    -> {bitvector_1_r.bv1_ok_at(UA.BF(t, n), off) == (UA.BF(t, n), VRP.PADK(UW.WX(t, x, 1n), 0n, 1)) : B.Buf & Bool}:
  +hk = FD.nat__lt_le_trans(Nat.add(x, 0n), Nat.add(x, 1n), A.quad(VB.pw(d)), FD.nat__lt_add_left(0n, 1n, x, {==}), hb)
  +hy = FD.logic__subst(Nat, z => {Nat.is_lt(z, A.quad(VB.pw(d))) == True{} : Bool}, Nat.add(x, 0n), Nat.add(0n, x), FD.nat__add_comm(x, 0n), hk)
  +ey = UR.offx(d, off, 0, x, e, FD.nat__lt_trans(d, 28n, 30n, hd, {==}), hy)
  %Equal.sym(B.Buf & U32, B.byte_at(UA.BF(t, n), U32.add(off, 0)), (UA.BF(t, n), VR.VX(t, U32.add(off, 0))),
      VR.byte_at_ok(d, t, n, U32.add(off, 0), FD.nat__lt_trans(d, 28n, 32n, hd, {==}), VR.hiX(d, U32.add(off, 0), Nat.add(0n, x), ey, hy), pf)) :
    {O.pad_pick(1, _) == (UA.BF(t, n), VRP.PADK(UW.WX(t, x, 1n), 0n, 1)) : B.Buf & Bool}
  %Equal.sym(U32, VR.VX(t, U32.add(off, 0)), VRB.BX(t, Nat.add(0n, x)), VRB.vx_bx(t, U32.add(off, 0), Nat.add(0n, x), ey)) :
    {O.pad_pick(1, (UA.BF(t, n), _)) == (UA.BF(t, n), VRP.PADK(UW.WX(t, x, 1n), 0n, 1)) : B.Buf & Bool}
  %Equal.sym(U32, VBL.nthb(UW.WX(t, x, 1n), 0n), VBL.nthb(UA.BYT(t), Nat.add(x, 0n)),
      Equal.trans(U32, VBL.nthb(UW.WX(t, x, 1n), 0n), VBL.nthb(VS.bdr(x, UA.BYT(t)), 0n), VBL.nthb(UA.BYT(t), Nat.add(x, 0n)),
        VR.nth_bt(1n, VS.bdr(x, UA.BYT(t)), 0n, {==}), VR.nth_bdr(x, UA.BYT(t), 0n))) :
    {O.pad_pick(1, (UA.BF(t, n), VRB.BX(t, Nat.add(0n, x)))) == (UA.BF(t, n), U32.is_eq(U32.and(_, U32.not(O.low_mask(1))), 0)) : B.Buf & Bool}
  %Equal.sym(Nat, Nat.add(x, 0n), Nat.add(0n, x), FD.nat__add_comm(x, 0n)) :
    {O.pad_pick(1, (UA.BF(t, n), VRB.BX(t, Nat.add(0n, x)))) == (UA.BF(t, n), U32.is_eq(U32.and(VBL.nthb(UA.BYT(t), _), U32.not(O.low_mask(1))), 0)) : B.Buf & Bool}
  {==}

def bitvector_1_okl(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 1n), A.quad(VB.pw(d))) == True{} : Bool}, +b: Bool)
    -> {bitvector_1_r.bv1_ok_len(b, UA.BF(t, n), off) == (UA.BF(t, n), Bool.and(b, VRP.PADK(UW.WX(t, x, 1n), 0n, 1))) : B.Buf & Bool}:
  match b:
    case True{}: bitvector_1_at(d, t, n, off, x, e, hd, pf, hb)
    case False{}: {==}

# the validator returns the length check and the padding check of the last window byte
def bitvector_1_ok_eval(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 1n), A.quad(VB.pw(d))) == True{} : Bool}, +len: U32)
    -> {bitvector_1_r.bv1_ok(UA.BF(t, n), off, len) == (UA.BF(t, n), Bool.and(U32.is_eq(len, 1), VRP.PADK(UW.WX(t, x, 1n), 0n, 1))) : B.Buf & Bool}:
  bitvector_1_okl(d, t, n, off, x, e, hd, pf, hb, U32.is_eq(len, 1))

def bitvector_1_atD(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 1n), A.quad(VB.pw(d))) == True{} : Bool})
    -> {bitvector_1_r.bv1_ok_at(UA.BF(t, n), off) == (UA.BF(t, n), VRP.PADK(UW.WX(t, x, 1n), 0n, 1)) : B.Buf & Bool}:
  +hk = FD.nat__lt_le_trans(Nat.add(x, 0n), Nat.add(x, 1n), A.quad(VB.pw(d)), FD.nat__lt_add_left(0n, 1n, x, {==}), hb)
  +hy = FD.logic__subst(Nat, z => {Nat.is_lt(z, A.quad(VB.pw(d))) == True{} : Bool}, Nat.add(x, 0n), Nat.add(0n, x), FD.nat__add_comm(x, 0n), hk)
  +ey = UR.offx31(d, off, 0, x, e, hd, hy)
  %Equal.sym(B.Buf & U32, B.byte_at(UA.BF(t, n), U32.add(off, 0)), (UA.BF(t, n), VR.VX(t, U32.add(off, 0))),
      VR.byte_at_ok(d, t, n, U32.add(off, 0), FD.nat__lt_trans(d, 31n, 32n, hd, {==}), VR.hiX(d, U32.add(off, 0), Nat.add(0n, x), ey, hy), pf)) :
    {O.pad_pick(1, _) == (UA.BF(t, n), VRP.PADK(UW.WX(t, x, 1n), 0n, 1)) : B.Buf & Bool}
  %Equal.sym(U32, VR.VX(t, U32.add(off, 0)), VRB.BX(t, Nat.add(0n, x)), VRB.vx_bx(t, U32.add(off, 0), Nat.add(0n, x), ey)) :
    {O.pad_pick(1, (UA.BF(t, n), _)) == (UA.BF(t, n), VRP.PADK(UW.WX(t, x, 1n), 0n, 1)) : B.Buf & Bool}
  %Equal.sym(U32, VBL.nthb(UW.WX(t, x, 1n), 0n), VBL.nthb(UA.BYT(t), Nat.add(x, 0n)),
      Equal.trans(U32, VBL.nthb(UW.WX(t, x, 1n), 0n), VBL.nthb(VS.bdr(x, UA.BYT(t)), 0n), VBL.nthb(UA.BYT(t), Nat.add(x, 0n)),
        VR.nth_bt(1n, VS.bdr(x, UA.BYT(t)), 0n, {==}), VR.nth_bdr(x, UA.BYT(t), 0n))) :
    {O.pad_pick(1, (UA.BF(t, n), VRB.BX(t, Nat.add(0n, x)))) == (UA.BF(t, n), U32.is_eq(U32.and(_, U32.not(O.low_mask(1))), 0)) : B.Buf & Bool}
  %Equal.sym(Nat, Nat.add(x, 0n), Nat.add(0n, x), FD.nat__add_comm(x, 0n)) :
    {O.pad_pick(1, (UA.BF(t, n), VRB.BX(t, Nat.add(0n, x)))) == (UA.BF(t, n), U32.is_eq(U32.and(VBL.nthb(UA.BYT(t), _), U32.not(O.low_mask(1))), 0)) : B.Buf & Bool}
  {==}

def bitvector_1_oklD(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 1n), A.quad(VB.pw(d))) == True{} : Bool}, +b: Bool)
    -> {bitvector_1_r.bv1_ok_len(b, UA.BF(t, n), off) == (UA.BF(t, n), Bool.and(b, VRP.PADK(UW.WX(t, x, 1n), 0n, 1))) : B.Buf & Bool}:
  match b:
    case True{}: bitvector_1_atD(d, t, n, off, x, e, hd, pf, hb)
    case False{}: {==}

# the validator returns the length check and the padding check of the last window byte
def bitvector_1_ok_evalD(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 1n), A.quad(VB.pw(d))) == True{} : Bool}, +len: U32)
    -> {bitvector_1_r.bv1_ok(UA.BF(t, n), off, len) == (UA.BF(t, n), Bool.and(U32.is_eq(len, 1), VRP.PADK(UW.WX(t, x, 1n), 0n, 1))) : B.Buf & Bool}:
  bitvector_1_oklD(d, t, n, off, x, e, hd, pf, hb, U32.is_eq(len, 1))

# every encoding at BitVector[1]: its padding bits clear
def bitvector_1_dom(+bits: +List<Bool>, +bs: +List<U32>, +c: Bool, +ec: {Bool.and(Nat.is_lt(0n, 1n), Nat.is_eq(List.length(&2, Bool, bits), 1n)) == c : Bool},
    +e: {Codec.bytes(Codec.one(SBF.encoding(c, bits), Some{Nat.div(Nat.add(1n, 7n), 8n)})) == Some{bs} : Maybe<&2, +List<U32>>})
    -> {VRP.PADK(bs, 0n, 1) == True{} : Bool}:
  match c:
    case False{}: Empty.absurd({VRP.PADK(bs, 0n, 1) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case True{}:
      FD.logic__subst(+List<U32>, z => {VRP.PADK(z, 0n, 1) == True{} : Bool}, Bp.pack(bits), bs, FD.logic__some_inj(+List<U32>, Bp.pack(bits), bs, e), VRP.padq1(0n, bits, ec))
def bitvector_1_pv(+v: S.Value, +bs: +List<U32>, +e: {Codec.encoding_for_legal_type(GS.bitvector_1(), v) == Some{bs} : Maybe<&2, +List<U32>>})
    -> {VRP.PADK(bs, 0n, 1) == True{} : Bool}:
  match v:
    case S.BitsValue{+bits}: bitvector_1_dom(bits, bs, Bool.and(Nat.is_lt(0n, 1n), Nat.is_eq(List.length(&2, Bool, bits), 1n)), {==}, e)
    case S.BooleanValue{+b}: Empty.absurd({VRP.PADK(bs, 0n, 1) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case S.UnsignedValue{+u}: Empty.absurd({VRP.PADK(bs, 0n, 1) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case S.BytesValue{+xs}: Empty.absurd({VRP.PADK(bs, 0n, 1) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case S.Sequence{+it}: Empty.absurd({VRP.PADK(bs, 0n, 1) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case S.Items{+hh, +tt}: Empty.absurd({VRP.PADK(bs, 0n, 1) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case S.EmptyItems{}: Empty.absurd({VRP.PADK(bs, 0n, 1) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case S.Selected{+sel, +sv}: Empty.absurd({VRP.PADK(bs, 0n, 1) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case S.NullValue{}: Empty.absurd({VRP.PADK(bs, 0n, 1) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))

def bitvector_1_rj(+bs: +List<U32>, +h: {Bool.and(Nat.is_eq(List.length(&2, U32, bs), 1n), VRP.PADK(bs, 0n, 1)) == False{} : Bool}, +v: S.Value,
    +e: {Codec.encoding_for_legal_type(GS.bitvector_1(), v) == Some{bs} : Maybe<&2, +List<U32>>}) -> Empty:
  VRB.chk_true(Nat.is_eq(List.length(&2, U32, bs), 1n), VRP.PADK(bs, 0n, 1),
    VRB.len_eq(SS.fixed_size(GS.bitvector_1()), 1n, bs, Codec.parts(v, GS.bitvector_1()), DS.facts(v, GS.bitvector_1(), {==}), {==}, e), bitvector_1_pv(v, bs, e), h)

# a byte list of another length, or with a padding bit set, is no encoding
def bitvector_1_decode_reject(+bs: +List<U32>, +h: {Bool.and(Nat.is_eq(List.length(&2, U32, bs), 1n), VRP.PADK(bs, 0n, 1)) == False{} : Bool}) -> Decoding.outside_image(GS.bitvector_1(), bs):
  v => e => bitvector_1_rj(bs, h, v, e)

# ---- bitvector_2 (BitVector[2], 1 bytes; validator T.bv2_ok: bits 2..7 of byte 0 clear) ----
def bitvector_2_at(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 1n), A.quad(VB.pw(d))) == True{} : Bool})
    -> {bitvector_2_r.bv2_ok_at(UA.BF(t, n), off) == (UA.BF(t, n), VRP.PADK(UW.WX(t, x, 1n), 0n, 2)) : B.Buf & Bool}:
  +hk = FD.nat__lt_le_trans(Nat.add(x, 0n), Nat.add(x, 1n), A.quad(VB.pw(d)), FD.nat__lt_add_left(0n, 1n, x, {==}), hb)
  +hy = FD.logic__subst(Nat, z => {Nat.is_lt(z, A.quad(VB.pw(d))) == True{} : Bool}, Nat.add(x, 0n), Nat.add(0n, x), FD.nat__add_comm(x, 0n), hk)
  +ey = UR.offx(d, off, 0, x, e, FD.nat__lt_trans(d, 28n, 30n, hd, {==}), hy)
  %Equal.sym(B.Buf & U32, B.byte_at(UA.BF(t, n), U32.add(off, 0)), (UA.BF(t, n), VR.VX(t, U32.add(off, 0))),
      VR.byte_at_ok(d, t, n, U32.add(off, 0), FD.nat__lt_trans(d, 28n, 32n, hd, {==}), VR.hiX(d, U32.add(off, 0), Nat.add(0n, x), ey, hy), pf)) :
    {O.pad_pick(2, _) == (UA.BF(t, n), VRP.PADK(UW.WX(t, x, 1n), 0n, 2)) : B.Buf & Bool}
  %Equal.sym(U32, VR.VX(t, U32.add(off, 0)), VRB.BX(t, Nat.add(0n, x)), VRB.vx_bx(t, U32.add(off, 0), Nat.add(0n, x), ey)) :
    {O.pad_pick(2, (UA.BF(t, n), _)) == (UA.BF(t, n), VRP.PADK(UW.WX(t, x, 1n), 0n, 2)) : B.Buf & Bool}
  %Equal.sym(U32, VBL.nthb(UW.WX(t, x, 1n), 0n), VBL.nthb(UA.BYT(t), Nat.add(x, 0n)),
      Equal.trans(U32, VBL.nthb(UW.WX(t, x, 1n), 0n), VBL.nthb(VS.bdr(x, UA.BYT(t)), 0n), VBL.nthb(UA.BYT(t), Nat.add(x, 0n)),
        VR.nth_bt(1n, VS.bdr(x, UA.BYT(t)), 0n, {==}), VR.nth_bdr(x, UA.BYT(t), 0n))) :
    {O.pad_pick(2, (UA.BF(t, n), VRB.BX(t, Nat.add(0n, x)))) == (UA.BF(t, n), U32.is_eq(U32.and(_, U32.not(O.low_mask(2))), 0)) : B.Buf & Bool}
  %Equal.sym(Nat, Nat.add(x, 0n), Nat.add(0n, x), FD.nat__add_comm(x, 0n)) :
    {O.pad_pick(2, (UA.BF(t, n), VRB.BX(t, Nat.add(0n, x)))) == (UA.BF(t, n), U32.is_eq(U32.and(VBL.nthb(UA.BYT(t), _), U32.not(O.low_mask(2))), 0)) : B.Buf & Bool}
  {==}

def bitvector_2_okl(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 1n), A.quad(VB.pw(d))) == True{} : Bool}, +b: Bool)
    -> {bitvector_2_r.bv2_ok_len(b, UA.BF(t, n), off) == (UA.BF(t, n), Bool.and(b, VRP.PADK(UW.WX(t, x, 1n), 0n, 2))) : B.Buf & Bool}:
  match b:
    case True{}: bitvector_2_at(d, t, n, off, x, e, hd, pf, hb)
    case False{}: {==}

# the validator returns the length check and the padding check of the last window byte
def bitvector_2_ok_eval(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 1n), A.quad(VB.pw(d))) == True{} : Bool}, +len: U32)
    -> {bitvector_2_r.bv2_ok(UA.BF(t, n), off, len) == (UA.BF(t, n), Bool.and(U32.is_eq(len, 1), VRP.PADK(UW.WX(t, x, 1n), 0n, 2))) : B.Buf & Bool}:
  bitvector_2_okl(d, t, n, off, x, e, hd, pf, hb, U32.is_eq(len, 1))

def bitvector_2_atD(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 1n), A.quad(VB.pw(d))) == True{} : Bool})
    -> {bitvector_2_r.bv2_ok_at(UA.BF(t, n), off) == (UA.BF(t, n), VRP.PADK(UW.WX(t, x, 1n), 0n, 2)) : B.Buf & Bool}:
  +hk = FD.nat__lt_le_trans(Nat.add(x, 0n), Nat.add(x, 1n), A.quad(VB.pw(d)), FD.nat__lt_add_left(0n, 1n, x, {==}), hb)
  +hy = FD.logic__subst(Nat, z => {Nat.is_lt(z, A.quad(VB.pw(d))) == True{} : Bool}, Nat.add(x, 0n), Nat.add(0n, x), FD.nat__add_comm(x, 0n), hk)
  +ey = UR.offx31(d, off, 0, x, e, hd, hy)
  %Equal.sym(B.Buf & U32, B.byte_at(UA.BF(t, n), U32.add(off, 0)), (UA.BF(t, n), VR.VX(t, U32.add(off, 0))),
      VR.byte_at_ok(d, t, n, U32.add(off, 0), FD.nat__lt_trans(d, 31n, 32n, hd, {==}), VR.hiX(d, U32.add(off, 0), Nat.add(0n, x), ey, hy), pf)) :
    {O.pad_pick(2, _) == (UA.BF(t, n), VRP.PADK(UW.WX(t, x, 1n), 0n, 2)) : B.Buf & Bool}
  %Equal.sym(U32, VR.VX(t, U32.add(off, 0)), VRB.BX(t, Nat.add(0n, x)), VRB.vx_bx(t, U32.add(off, 0), Nat.add(0n, x), ey)) :
    {O.pad_pick(2, (UA.BF(t, n), _)) == (UA.BF(t, n), VRP.PADK(UW.WX(t, x, 1n), 0n, 2)) : B.Buf & Bool}
  %Equal.sym(U32, VBL.nthb(UW.WX(t, x, 1n), 0n), VBL.nthb(UA.BYT(t), Nat.add(x, 0n)),
      Equal.trans(U32, VBL.nthb(UW.WX(t, x, 1n), 0n), VBL.nthb(VS.bdr(x, UA.BYT(t)), 0n), VBL.nthb(UA.BYT(t), Nat.add(x, 0n)),
        VR.nth_bt(1n, VS.bdr(x, UA.BYT(t)), 0n, {==}), VR.nth_bdr(x, UA.BYT(t), 0n))) :
    {O.pad_pick(2, (UA.BF(t, n), VRB.BX(t, Nat.add(0n, x)))) == (UA.BF(t, n), U32.is_eq(U32.and(_, U32.not(O.low_mask(2))), 0)) : B.Buf & Bool}
  %Equal.sym(Nat, Nat.add(x, 0n), Nat.add(0n, x), FD.nat__add_comm(x, 0n)) :
    {O.pad_pick(2, (UA.BF(t, n), VRB.BX(t, Nat.add(0n, x)))) == (UA.BF(t, n), U32.is_eq(U32.and(VBL.nthb(UA.BYT(t), _), U32.not(O.low_mask(2))), 0)) : B.Buf & Bool}
  {==}

def bitvector_2_oklD(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 1n), A.quad(VB.pw(d))) == True{} : Bool}, +b: Bool)
    -> {bitvector_2_r.bv2_ok_len(b, UA.BF(t, n), off) == (UA.BF(t, n), Bool.and(b, VRP.PADK(UW.WX(t, x, 1n), 0n, 2))) : B.Buf & Bool}:
  match b:
    case True{}: bitvector_2_atD(d, t, n, off, x, e, hd, pf, hb)
    case False{}: {==}

# the validator returns the length check and the padding check of the last window byte
def bitvector_2_ok_evalD(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 1n), A.quad(VB.pw(d))) == True{} : Bool}, +len: U32)
    -> {bitvector_2_r.bv2_ok(UA.BF(t, n), off, len) == (UA.BF(t, n), Bool.and(U32.is_eq(len, 1), VRP.PADK(UW.WX(t, x, 1n), 0n, 2))) : B.Buf & Bool}:
  bitvector_2_oklD(d, t, n, off, x, e, hd, pf, hb, U32.is_eq(len, 1))

# every encoding at BitVector[2]: its padding bits clear
def bitvector_2_dom(+bits: +List<Bool>, +bs: +List<U32>, +c: Bool, +ec: {Bool.and(Nat.is_lt(0n, 2n), Nat.is_eq(List.length(&2, Bool, bits), 2n)) == c : Bool},
    +e: {Codec.bytes(Codec.one(SBF.encoding(c, bits), Some{Nat.div(Nat.add(2n, 7n), 8n)})) == Some{bs} : Maybe<&2, +List<U32>>})
    -> {VRP.PADK(bs, 0n, 2) == True{} : Bool}:
  match c:
    case False{}: Empty.absurd({VRP.PADK(bs, 0n, 2) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case True{}:
      FD.logic__subst(+List<U32>, z => {VRP.PADK(z, 0n, 2) == True{} : Bool}, Bp.pack(bits), bs, FD.logic__some_inj(+List<U32>, Bp.pack(bits), bs, e), VRP.padq2(0n, bits, ec))
def bitvector_2_pv(+v: S.Value, +bs: +List<U32>, +e: {Codec.encoding_for_legal_type(GS.bitvector_2(), v) == Some{bs} : Maybe<&2, +List<U32>>})
    -> {VRP.PADK(bs, 0n, 2) == True{} : Bool}:
  match v:
    case S.BitsValue{+bits}: bitvector_2_dom(bits, bs, Bool.and(Nat.is_lt(0n, 2n), Nat.is_eq(List.length(&2, Bool, bits), 2n)), {==}, e)
    case S.BooleanValue{+b}: Empty.absurd({VRP.PADK(bs, 0n, 2) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case S.UnsignedValue{+u}: Empty.absurd({VRP.PADK(bs, 0n, 2) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case S.BytesValue{+xs}: Empty.absurd({VRP.PADK(bs, 0n, 2) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case S.Sequence{+it}: Empty.absurd({VRP.PADK(bs, 0n, 2) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case S.Items{+hh, +tt}: Empty.absurd({VRP.PADK(bs, 0n, 2) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case S.EmptyItems{}: Empty.absurd({VRP.PADK(bs, 0n, 2) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case S.Selected{+sel, +sv}: Empty.absurd({VRP.PADK(bs, 0n, 2) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case S.NullValue{}: Empty.absurd({VRP.PADK(bs, 0n, 2) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))

def bitvector_2_rj(+bs: +List<U32>, +h: {Bool.and(Nat.is_eq(List.length(&2, U32, bs), 1n), VRP.PADK(bs, 0n, 2)) == False{} : Bool}, +v: S.Value,
    +e: {Codec.encoding_for_legal_type(GS.bitvector_2(), v) == Some{bs} : Maybe<&2, +List<U32>>}) -> Empty:
  VRB.chk_true(Nat.is_eq(List.length(&2, U32, bs), 1n), VRP.PADK(bs, 0n, 2),
    VRB.len_eq(SS.fixed_size(GS.bitvector_2()), 1n, bs, Codec.parts(v, GS.bitvector_2()), DS.facts(v, GS.bitvector_2(), {==}), {==}, e), bitvector_2_pv(v, bs, e), h)

# a byte list of another length, or with a padding bit set, is no encoding
def bitvector_2_decode_reject(+bs: +List<U32>, +h: {Bool.and(Nat.is_eq(List.length(&2, U32, bs), 1n), VRP.PADK(bs, 0n, 2)) == False{} : Bool}) -> Decoding.outside_image(GS.bitvector_2(), bs):
  v => e => bitvector_2_rj(bs, h, v, e)

# ---- bitvector_31 (BitVector[31], 4 bytes; validator T.bv31_ok: bits 7..7 of byte 3 clear) ----
def bitvector_31_at(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 4n), A.quad(VB.pw(d))) == True{} : Bool})
    -> {bitvector_31_r.bv31_ok_at(UA.BF(t, n), off) == (UA.BF(t, n), VRP.PADK(UW.WX(t, x, 4n), 3n, 7)) : B.Buf & Bool}:
  +hk = FD.nat__lt_le_trans(Nat.add(x, 3n), Nat.add(x, 4n), A.quad(VB.pw(d)), FD.nat__lt_add_left(3n, 4n, x, {==}), hb)
  +hy = FD.logic__subst(Nat, z => {Nat.is_lt(z, A.quad(VB.pw(d))) == True{} : Bool}, Nat.add(x, 3n), Nat.add(3n, x), FD.nat__add_comm(x, 3n), hk)
  +ey = UR.offx(d, off, 3, x, e, FD.nat__lt_trans(d, 28n, 30n, hd, {==}), hy)
  %Equal.sym(B.Buf & U32, B.byte_at(UA.BF(t, n), U32.add(off, 3)), (UA.BF(t, n), VR.VX(t, U32.add(off, 3))),
      VR.byte_at_ok(d, t, n, U32.add(off, 3), FD.nat__lt_trans(d, 28n, 32n, hd, {==}), VR.hiX(d, U32.add(off, 3), Nat.add(3n, x), ey, hy), pf)) :
    {O.pad_pick(7, _) == (UA.BF(t, n), VRP.PADK(UW.WX(t, x, 4n), 3n, 7)) : B.Buf & Bool}
  %Equal.sym(U32, VR.VX(t, U32.add(off, 3)), VRB.BX(t, Nat.add(3n, x)), VRB.vx_bx(t, U32.add(off, 3), Nat.add(3n, x), ey)) :
    {O.pad_pick(7, (UA.BF(t, n), _)) == (UA.BF(t, n), VRP.PADK(UW.WX(t, x, 4n), 3n, 7)) : B.Buf & Bool}
  %Equal.sym(U32, VBL.nthb(UW.WX(t, x, 4n), 3n), VBL.nthb(UA.BYT(t), Nat.add(x, 3n)),
      Equal.trans(U32, VBL.nthb(UW.WX(t, x, 4n), 3n), VBL.nthb(VS.bdr(x, UA.BYT(t)), 3n), VBL.nthb(UA.BYT(t), Nat.add(x, 3n)),
        VR.nth_bt(4n, VS.bdr(x, UA.BYT(t)), 3n, {==}), VR.nth_bdr(x, UA.BYT(t), 3n))) :
    {O.pad_pick(7, (UA.BF(t, n), VRB.BX(t, Nat.add(3n, x)))) == (UA.BF(t, n), U32.is_eq(U32.and(_, U32.not(O.low_mask(7))), 0)) : B.Buf & Bool}
  %Equal.sym(Nat, Nat.add(x, 3n), Nat.add(3n, x), FD.nat__add_comm(x, 3n)) :
    {O.pad_pick(7, (UA.BF(t, n), VRB.BX(t, Nat.add(3n, x)))) == (UA.BF(t, n), U32.is_eq(U32.and(VBL.nthb(UA.BYT(t), _), U32.not(O.low_mask(7))), 0)) : B.Buf & Bool}
  {==}

def bitvector_31_okl(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
