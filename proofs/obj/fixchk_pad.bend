    case S.BytesValue{+xs}: Empty.absurd({VRP.PADK(bs, 0n, 7) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case S.Sequence{+it}: Empty.absurd({VRP.PADK(bs, 0n, 7) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
