    {O.pad_pick(7, (UA.BF(t, n), VRB.BX(t, Nat.add(63n, x)))) == (UA.BF(t, n), U32.is_eq(U32.and(_, U32.not(O.low_mask(7))), 0)) : B.Buf & Bool}
