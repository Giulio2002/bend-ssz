# every encoding at BitVector[31]: its padding bits clear
def bitvector_31_dom(+bits: +List<Bool>, +bs: +List<U32>, +c: Bool, +ec: {Bool.and(Nat.is_lt(0n, 31n), Nat.is_eq(List.length(&2, Bool, bits), 31n)) == c : Bool},
    +e: {Codec.bytes(Codec.one(SBF.encoding(c, bits), Some{Nat.div(Nat.add(31n, 7n), 8n)})) == Some{bs} : Maybe<&2, +List<U32>>})
    -> {VRP.PADK(bs, 3n, 7) == True{} : Bool}:
  match c:
    case False{}: Empty.absurd({VRP.PADK(bs, 3n, 7) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case True{}:
      FD.logic__subst(+List<U32>, z => {VRP.PADK(z, 3n, 7) == True{} : Bool}, Bp.pack(bits), bs, FD.logic__some_inj(+List<U32>, Bp.pack(bits), bs, e), VRP.padq7(3n, bits, ec))
def bitvector_31_pv(+v: S.Value, +bs: +List<U32>, +e: {Codec.encoding_for_legal_type(GS.bitvector_31(), v) == Some{bs} : Maybe<&2, +List<U32>>})
    -> {VRP.PADK(bs, 3n, 7) == True{} : Bool}:
  match v:
    case S.BitsValue{+bits}: bitvector_31_dom(bits, bs, Bool.and(Nat.is_lt(0n, 31n), Nat.is_eq(List.length(&2, Bool, bits), 31n)), {==}, e)
    case S.BooleanValue{+b}: Empty.absurd({VRP.PADK(bs, 3n, 7) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case S.UnsignedValue{+u}: Empty.absurd({VRP.PADK(bs, 3n, 7) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case S.BytesValue{+xs}: Empty.absurd({VRP.PADK(bs, 3n, 7) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case S.Sequence{+it}: Empty.absurd({VRP.PADK(bs, 3n, 7) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case S.Items{+hh, +tt}: Empty.absurd({VRP.PADK(bs, 3n, 7) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case S.EmptyItems{}: Empty.absurd({VRP.PADK(bs, 3n, 7) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case S.Selected{+sel, +sv}: Empty.absurd({VRP.PADK(bs, 3n, 7) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case S.NullValue{}: Empty.absurd({VRP.PADK(bs, 3n, 7) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))

def bitvector_31_rj(+bs: +List<U32>, +h: {Bool.and(Nat.is_eq(List.length(&2, U32, bs), 4n), VRP.PADK(bs, 3n, 7)) == False{} : Bool}, +v: S.Value,
    +e: {Codec.encoding_for_legal_type(GS.bitvector_31(), v) == Some{bs} : Maybe<&2, +List<U32>>}) -> Empty:
  VRB.chk_true(Nat.is_eq(List.length(&2, U32, bs), 4n), VRP.PADK(bs, 3n, 7),
    VRB.len_eq(SS.fixed_size(GS.bitvector_31()), 4n, bs, Codec.parts(v, GS.bitvector_31()), DS.facts(v, GS.bitvector_31(), {==}), {==}, e), bitvector_31_pv(v, bs, e), h)

# a byte list of another length, or with a padding bit set, is no encoding
def bitvector_31_decode_reject(+bs: +List<U32>, +h: {Bool.and(Nat.is_eq(List.length(&2, U32, bs), 4n), VRP.PADK(bs, 3n, 7)) == False{} : Bool}) -> Decoding.outside_image(GS.bitvector_31(), bs):
  v => e => bitvector_31_rj(bs, h, v, e)

# ---- bitvector_33 (BitVector[33], 5 bytes; validator T.bv33_ok: bits 1..7 of byte 4 clear) ----
def bitvector_33_at(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 5n), A.quad(VB.pw(d))) == True{} : Bool})
    -> {bitvector_33_r.bv33_ok_at(UA.BF(t, n), off) == (UA.BF(t, n), VRP.PADK(UW.WX(t, x, 5n), 4n, 1)) : B.Buf & Bool}:
  +hk = FD.nat__lt_le_trans(Nat.add(x, 4n), Nat.add(x, 5n), A.quad(VB.pw(d)), FD.nat__lt_add_left(4n, 5n, x, {==}), hb)
  +hy = FD.logic__subst(Nat, z => {Nat.is_lt(z, A.quad(VB.pw(d))) == True{} : Bool}, Nat.add(x, 4n), Nat.add(4n, x), FD.nat__add_comm(x, 4n), hk)
  +ey = UR.offx(d, off, 4, x, e, FD.nat__lt_trans(d, 28n, 30n, hd, {==}), hy)
  %Equal.sym(B.Buf & U32, B.byte_at(UA.BF(t, n), U32.add(off, 4)), (UA.BF(t, n), VR.VX(t, U32.add(off, 4))),
      VR.byte_at_ok(d, t, n, U32.add(off, 4), FD.nat__lt_trans(d, 28n, 32n, hd, {==}), VR.hiX(d, U32.add(off, 4), Nat.add(4n, x), ey, hy), pf)) :
    {O.pad_pick(1, _) == (UA.BF(t, n), VRP.PADK(UW.WX(t, x, 5n), 4n, 1)) : B.Buf & Bool}
  %Equal.sym(U32, VR.VX(t, U32.add(off, 4)), VRB.BX(t, Nat.add(4n, x)), VRB.vx_bx(t, U32.add(off, 4), Nat.add(4n, x), ey)) :
    {O.pad_pick(1, (UA.BF(t, n), _)) == (UA.BF(t, n), VRP.PADK(UW.WX(t, x, 5n), 4n, 1)) : B.Buf & Bool}
  %Equal.sym(U32, VBL.nthb(UW.WX(t, x, 5n), 4n), VBL.nthb(UA.BYT(t), Nat.add(x, 4n)),
      Equal.trans(U32, VBL.nthb(UW.WX(t, x, 5n), 4n), VBL.nthb(VS.bdr(x, UA.BYT(t)), 4n), VBL.nthb(UA.BYT(t), Nat.add(x, 4n)),
        VR.nth_bt(5n, VS.bdr(x, UA.BYT(t)), 4n, {==}), VR.nth_bdr(x, UA.BYT(t), 4n))) :
    {O.pad_pick(1, (UA.BF(t, n), VRB.BX(t, Nat.add(4n, x)))) == (UA.BF(t, n), U32.is_eq(U32.and(_, U32.not(O.low_mask(1))), 0)) : B.Buf & Bool}
  %Equal.sym(Nat, Nat.add(x, 4n), Nat.add(4n, x), FD.nat__add_comm(x, 4n)) :
    {O.pad_pick(1, (UA.BF(t, n), VRB.BX(t, Nat.add(4n, x)))) == (UA.BF(t, n), U32.is_eq(U32.and(VBL.nthb(UA.BYT(t), _), U32.not(O.low_mask(1))), 0)) : B.Buf & Bool}
  {==}

def bitvector_33_okl(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 5n), A.quad(VB.pw(d))) == True{} : Bool}, +b: Bool)
    -> {bitvector_33_r.bv33_ok_len(b, UA.BF(t, n), off) == (UA.BF(t, n), Bool.and(b, VRP.PADK(UW.WX(t, x, 5n), 4n, 1))) : B.Buf & Bool}:
  match b:
    case True{}: bitvector_33_at(d, t, n, off, x, e, hd, pf, hb)
    case False{}: {==}

# the validator returns the length check and the padding check of the last window byte
def bitvector_33_ok_eval(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 5n), A.quad(VB.pw(d))) == True{} : Bool}, +len: U32)
    -> {bitvector_33_r.bv33_ok(UA.BF(t, n), off, len) == (UA.BF(t, n), Bool.and(U32.is_eq(len, 5), VRP.PADK(UW.WX(t, x, 5n), 4n, 1))) : B.Buf & Bool}:
  bitvector_33_okl(d, t, n, off, x, e, hd, pf, hb, U32.is_eq(len, 5))

def bitvector_33_atD(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 5n), A.quad(VB.pw(d))) == True{} : Bool})
    -> {bitvector_33_r.bv33_ok_at(UA.BF(t, n), off) == (UA.BF(t, n), VRP.PADK(UW.WX(t, x, 5n), 4n, 1)) : B.Buf & Bool}:
  +hk = FD.nat__lt_le_trans(Nat.add(x, 4n), Nat.add(x, 5n), A.quad(VB.pw(d)), FD.nat__lt_add_left(4n, 5n, x, {==}), hb)
  +hy = FD.logic__subst(Nat, z => {Nat.is_lt(z, A.quad(VB.pw(d))) == True{} : Bool}, Nat.add(x, 4n), Nat.add(4n, x), FD.nat__add_comm(x, 4n), hk)
  +ey = UR.offx31(d, off, 4, x, e, hd, hy)
  %Equal.sym(B.Buf & U32, B.byte_at(UA.BF(t, n), U32.add(off, 4)), (UA.BF(t, n), VR.VX(t, U32.add(off, 4))),
      VR.byte_at_ok(d, t, n, U32.add(off, 4), FD.nat__lt_trans(d, 31n, 32n, hd, {==}), VR.hiX(d, U32.add(off, 4), Nat.add(4n, x), ey, hy), pf)) :
    {O.pad_pick(1, _) == (UA.BF(t, n), VRP.PADK(UW.WX(t, x, 5n), 4n, 1)) : B.Buf & Bool}
  %Equal.sym(U32, VR.VX(t, U32.add(off, 4)), VRB.BX(t, Nat.add(4n, x)), VRB.vx_bx(t, U32.add(off, 4), Nat.add(4n, x), ey)) :
    {O.pad_pick(1, (UA.BF(t, n), _)) == (UA.BF(t, n), VRP.PADK(UW.WX(t, x, 5n), 4n, 1)) : B.Buf & Bool}
  %Equal.sym(U32, VBL.nthb(UW.WX(t, x, 5n), 4n), VBL.nthb(UA.BYT(t), Nat.add(x, 4n)),
      Equal.trans(U32, VBL.nthb(UW.WX(t, x, 5n), 4n), VBL.nthb(VS.bdr(x, UA.BYT(t)), 4n), VBL.nthb(UA.BYT(t), Nat.add(x, 4n)),
        VR.nth_bt(5n, VS.bdr(x, UA.BYT(t)), 4n, {==}), VR.nth_bdr(x, UA.BYT(t), 4n))) :
    {O.pad_pick(1, (UA.BF(t, n), VRB.BX(t, Nat.add(4n, x)))) == (UA.BF(t, n), U32.is_eq(U32.and(_, U32.not(O.low_mask(1))), 0)) : B.Buf & Bool}
  %Equal.sym(Nat, Nat.add(x, 4n), Nat.add(4n, x), FD.nat__add_comm(x, 4n)) :
    {O.pad_pick(1, (UA.BF(t, n), VRB.BX(t, Nat.add(4n, x)))) == (UA.BF(t, n), U32.is_eq(U32.and(VBL.nthb(UA.BYT(t), _), U32.not(O.low_mask(1))), 0)) : B.Buf & Bool}
  {==}

def bitvector_33_oklD(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 5n), A.quad(VB.pw(d))) == True{} : Bool}, +b: Bool)
    -> {bitvector_33_r.bv33_ok_len(b, UA.BF(t, n), off) == (UA.BF(t, n), Bool.and(b, VRP.PADK(UW.WX(t, x, 5n), 4n, 1))) : B.Buf & Bool}:
  match b:
    case True{}: bitvector_33_atD(d, t, n, off, x, e, hd, pf, hb)
    case False{}: {==}

# the validator returns the length check and the padding check of the last window byte
def bitvector_33_ok_evalD(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 5n), A.quad(VB.pw(d))) == True{} : Bool}, +len: U32)
    -> {bitvector_33_r.bv33_ok(UA.BF(t, n), off, len) == (UA.BF(t, n), Bool.and(U32.is_eq(len, 5), VRP.PADK(UW.WX(t, x, 5n), 4n, 1))) : B.Buf & Bool}:
  bitvector_33_oklD(d, t, n, off, x, e, hd, pf, hb, U32.is_eq(len, 5))

# every encoding at BitVector[33]: its padding bits clear
def bitvector_33_dom(+bits: +List<Bool>, +bs: +List<U32>, +c: Bool, +ec: {Bool.and(Nat.is_lt(0n, 33n), Nat.is_eq(List.length(&2, Bool, bits), 33n)) == c : Bool},
    +e: {Codec.bytes(Codec.one(SBF.encoding(c, bits), Some{Nat.div(Nat.add(33n, 7n), 8n)})) == Some{bs} : Maybe<&2, +List<U32>>})
    -> {VRP.PADK(bs, 4n, 1) == True{} : Bool}:
  match c:
    case False{}: Empty.absurd({VRP.PADK(bs, 4n, 1) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case True{}:
      FD.logic__subst(+List<U32>, z => {VRP.PADK(z, 4n, 1) == True{} : Bool}, Bp.pack(bits), bs, FD.logic__some_inj(+List<U32>, Bp.pack(bits), bs, e), VRP.padq1(4n, bits, ec))
def bitvector_33_pv(+v: S.Value, +bs: +List<U32>, +e: {Codec.encoding_for_legal_type(GS.bitvector_33(), v) == Some{bs} : Maybe<&2, +List<U32>>})
    -> {VRP.PADK(bs, 4n, 1) == True{} : Bool}:
  match v:
    case S.BitsValue{+bits}: bitvector_33_dom(bits, bs, Bool.and(Nat.is_lt(0n, 33n), Nat.is_eq(List.length(&2, Bool, bits), 33n)), {==}, e)
    case S.BooleanValue{+b}: Empty.absurd({VRP.PADK(bs, 4n, 1) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case S.UnsignedValue{+u}: Empty.absurd({VRP.PADK(bs, 4n, 1) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case S.BytesValue{+xs}: Empty.absurd({VRP.PADK(bs, 4n, 1) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case S.Sequence{+it}: Empty.absurd({VRP.PADK(bs, 4n, 1) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case S.Items{+hh, +tt}: Empty.absurd({VRP.PADK(bs, 4n, 1) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case S.EmptyItems{}: Empty.absurd({VRP.PADK(bs, 4n, 1) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case S.Selected{+sel, +sv}: Empty.absurd({VRP.PADK(bs, 4n, 1) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case S.NullValue{}: Empty.absurd({VRP.PADK(bs, 4n, 1) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))

def bitvector_33_rj(+bs: +List<U32>, +h: {Bool.and(Nat.is_eq(List.length(&2, U32, bs), 5n), VRP.PADK(bs, 4n, 1)) == False{} : Bool}, +v: S.Value,
    +e: {Codec.encoding_for_legal_type(GS.bitvector_33(), v) == Some{bs} : Maybe<&2, +List<U32>>}) -> Empty:
  VRB.chk_true(Nat.is_eq(List.length(&2, U32, bs), 5n), VRP.PADK(bs, 4n, 1),
    VRB.len_eq(SS.fixed_size(GS.bitvector_33()), 5n, bs, Codec.parts(v, GS.bitvector_33()), DS.facts(v, GS.bitvector_33(), {==}), {==}, e), bitvector_33_pv(v, bs, e), h)

# a byte list of another length, or with a padding bit set, is no encoding
def bitvector_33_decode_reject(+bs: +List<U32>, +h: {Bool.and(Nat.is_eq(List.length(&2, U32, bs), 5n), VRP.PADK(bs, 4n, 1)) == False{} : Bool}) -> Decoding.outside_image(GS.bitvector_33(), bs):
  v => e => bitvector_33_rj(bs, h, v, e)

# ---- bitvector_3 (BitVector[3], 1 bytes; validator T.bv3_ok: bits 3..7 of byte 0 clear) ----
def bitvector_3_at(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 1n), A.quad(VB.pw(d))) == True{} : Bool})
    -> {bitvector_3_r.bv3_ok_at(UA.BF(t, n), off) == (UA.BF(t, n), VRP.PADK(UW.WX(t, x, 1n), 0n, 3)) : B.Buf & Bool}:
  +hk = FD.nat__lt_le_trans(Nat.add(x, 0n), Nat.add(x, 1n), A.quad(VB.pw(d)), FD.nat__lt_add_left(0n, 1n, x, {==}), hb)
  +hy = FD.logic__subst(Nat, z => {Nat.is_lt(z, A.quad(VB.pw(d))) == True{} : Bool}, Nat.add(x, 0n), Nat.add(0n, x), FD.nat__add_comm(x, 0n), hk)
  +ey = UR.offx(d, off, 0, x, e, FD.nat__lt_trans(d, 28n, 30n, hd, {==}), hy)
  %Equal.sym(B.Buf & U32, B.byte_at(UA.BF(t, n), U32.add(off, 0)), (UA.BF(t, n), VR.VX(t, U32.add(off, 0))),
      VR.byte_at_ok(d, t, n, U32.add(off, 0), FD.nat__lt_trans(d, 28n, 32n, hd, {==}), VR.hiX(d, U32.add(off, 0), Nat.add(0n, x), ey, hy), pf)) :
    {O.pad_pick(3, _) == (UA.BF(t, n), VRP.PADK(UW.WX(t, x, 1n), 0n, 3)) : B.Buf & Bool}
  %Equal.sym(U32, VR.VX(t, U32.add(off, 0)), VRB.BX(t, Nat.add(0n, x)), VRB.vx_bx(t, U32.add(off, 0), Nat.add(0n, x), ey)) :
    {O.pad_pick(3, (UA.BF(t, n), _)) == (UA.BF(t, n), VRP.PADK(UW.WX(t, x, 1n), 0n, 3)) : B.Buf & Bool}
  %Equal.sym(U32, VBL.nthb(UW.WX(t, x, 1n), 0n), VBL.nthb(UA.BYT(t), Nat.add(x, 0n)),
      Equal.trans(U32, VBL.nthb(UW.WX(t, x, 1n), 0n), VBL.nthb(VS.bdr(x, UA.BYT(t)), 0n), VBL.nthb(UA.BYT(t), Nat.add(x, 0n)),
        VR.nth_bt(1n, VS.bdr(x, UA.BYT(t)), 0n, {==}), VR.nth_bdr(x, UA.BYT(t), 0n))) :
    {O.pad_pick(3, (UA.BF(t, n), VRB.BX(t, Nat.add(0n, x)))) == (UA.BF(t, n), U32.is_eq(U32.and(_, U32.not(O.low_mask(3))), 0)) : B.Buf & Bool}
  %Equal.sym(Nat, Nat.add(x, 0n), Nat.add(0n, x), FD.nat__add_comm(x, 0n)) :
    {O.pad_pick(3, (UA.BF(t, n), VRB.BX(t, Nat.add(0n, x)))) == (UA.BF(t, n), U32.is_eq(U32.and(VBL.nthb(UA.BYT(t), _), U32.not(O.low_mask(3))), 0)) : B.Buf & Bool}
  {==}

def bitvector_3_okl(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 1n), A.quad(VB.pw(d))) == True{} : Bool}, +b: Bool)
    -> {bitvector_3_r.bv3_ok_len(b, UA.BF(t, n), off) == (UA.BF(t, n), Bool.and(b, VRP.PADK(UW.WX(t, x, 1n), 0n, 3))) : B.Buf & Bool}:
  match b:
    case True{}: bitvector_3_at(d, t, n, off, x, e, hd, pf, hb)
    case False{}: {==}

# the validator returns the length check and the padding check of the last window byte
def bitvector_3_ok_eval(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 1n), A.quad(VB.pw(d))) == True{} : Bool}, +len: U32)
    -> {bitvector_3_r.bv3_ok(UA.BF(t, n), off, len) == (UA.BF(t, n), Bool.and(U32.is_eq(len, 1), VRP.PADK(UW.WX(t, x, 1n), 0n, 3))) : B.Buf & Bool}:
  bitvector_3_okl(d, t, n, off, x, e, hd, pf, hb, U32.is_eq(len, 1))

def bitvector_3_atD(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 1n), A.quad(VB.pw(d))) == True{} : Bool})
    -> {bitvector_3_r.bv3_ok_at(UA.BF(t, n), off) == (UA.BF(t, n), VRP.PADK(UW.WX(t, x, 1n), 0n, 3)) : B.Buf & Bool}:
  +hk = FD.nat__lt_le_trans(Nat.add(x, 0n), Nat.add(x, 1n), A.quad(VB.pw(d)), FD.nat__lt_add_left(0n, 1n, x, {==}), hb)
  +hy = FD.logic__subst(Nat, z => {Nat.is_lt(z, A.quad(VB.pw(d))) == True{} : Bool}, Nat.add(x, 0n), Nat.add(0n, x), FD.nat__add_comm(x, 0n), hk)
  +ey = UR.offx31(d, off, 0, x, e, hd, hy)
  %Equal.sym(B.Buf & U32, B.byte_at(UA.BF(t, n), U32.add(off, 0)), (UA.BF(t, n), VR.VX(t, U32.add(off, 0))),
      VR.byte_at_ok(d, t, n, U32.add(off, 0), FD.nat__lt_trans(d, 31n, 32n, hd, {==}), VR.hiX(d, U32.add(off, 0), Nat.add(0n, x), ey, hy), pf)) :
    {O.pad_pick(3, _) == (UA.BF(t, n), VRP.PADK(UW.WX(t, x, 1n), 0n, 3)) : B.Buf & Bool}
  %Equal.sym(U32, VR.VX(t, U32.add(off, 0)), VRB.BX(t, Nat.add(0n, x)), VRB.vx_bx(t, U32.add(off, 0), Nat.add(0n, x), ey)) :
    {O.pad_pick(3, (UA.BF(t, n), _)) == (UA.BF(t, n), VRP.PADK(UW.WX(t, x, 1n), 0n, 3)) : B.Buf & Bool}
  %Equal.sym(U32, VBL.nthb(UW.WX(t, x, 1n), 0n), VBL.nthb(UA.BYT(t), Nat.add(x, 0n)),
      Equal.trans(U32, VBL.nthb(UW.WX(t, x, 1n), 0n), VBL.nthb(VS.bdr(x, UA.BYT(t)), 0n), VBL.nthb(UA.BYT(t), Nat.add(x, 0n)),
        VR.nth_bt(1n, VS.bdr(x, UA.BYT(t)), 0n, {==}), VR.nth_bdr(x, UA.BYT(t), 0n))) :
    {O.pad_pick(3, (UA.BF(t, n), VRB.BX(t, Nat.add(0n, x)))) == (UA.BF(t, n), U32.is_eq(U32.and(_, U32.not(O.low_mask(3))), 0)) : B.Buf & Bool}
  %Equal.sym(Nat, Nat.add(x, 0n), Nat.add(0n, x), FD.nat__add_comm(x, 0n)) :
    {O.pad_pick(3, (UA.BF(t, n), VRB.BX(t, Nat.add(0n, x)))) == (UA.BF(t, n), U32.is_eq(U32.and(VBL.nthb(UA.BYT(t), _), U32.not(O.low_mask(3))), 0)) : B.Buf & Bool}
  {==}

def bitvector_3_oklD(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 1n), A.quad(VB.pw(d))) == True{} : Bool}, +b: Bool)
    -> {bitvector_3_r.bv3_ok_len(b, UA.BF(t, n), off) == (UA.BF(t, n), Bool.and(b, VRP.PADK(UW.WX(t, x, 1n), 0n, 3))) : B.Buf & Bool}:
  match b:
    case True{}: bitvector_3_atD(d, t, n, off, x, e, hd, pf, hb)
    case False{}: {==}

# the validator returns the length check and the padding check of the last window byte
def bitvector_3_ok_evalD(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 1n), A.quad(VB.pw(d))) == True{} : Bool}, +len: U32)
    -> {bitvector_3_r.bv3_ok(UA.BF(t, n), off, len) == (UA.BF(t, n), Bool.and(U32.is_eq(len, 1), VRP.PADK(UW.WX(t, x, 1n), 0n, 3))) : B.Buf & Bool}:
  bitvector_3_oklD(d, t, n, off, x, e, hd, pf, hb, U32.is_eq(len, 1))

# every encoding at BitVector[3]: its padding bits clear
def bitvector_3_dom(+bits: +List<Bool>, +bs: +List<U32>, +c: Bool, +ec: {Bool.and(Nat.is_lt(0n, 3n), Nat.is_eq(List.length(&2, Bool, bits), 3n)) == c : Bool},
    +e: {Codec.bytes(Codec.one(SBF.encoding(c, bits), Some{Nat.div(Nat.add(3n, 7n), 8n)})) == Some{bs} : Maybe<&2, +List<U32>>})
    -> {VRP.PADK(bs, 0n, 3) == True{} : Bool}:
  match c:
    case False{}: Empty.absurd({VRP.PADK(bs, 0n, 3) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case True{}:
      FD.logic__subst(+List<U32>, z => {VRP.PADK(z, 0n, 3) == True{} : Bool}, Bp.pack(bits), bs, FD.logic__some_inj(+List<U32>, Bp.pack(bits), bs, e), VRP.padq3(0n, bits, ec))
def bitvector_3_pv(+v: S.Value, +bs: +List<U32>, +e: {Codec.encoding_for_legal_type(GS.bitvector_3(), v) == Some{bs} : Maybe<&2, +List<U32>>})
    -> {VRP.PADK(bs, 0n, 3) == True{} : Bool}:
  match v:
    case S.BitsValue{+bits}: bitvector_3_dom(bits, bs, Bool.and(Nat.is_lt(0n, 3n), Nat.is_eq(List.length(&2, Bool, bits), 3n)), {==}, e)
    case S.BooleanValue{+b}: Empty.absurd({VRP.PADK(bs, 0n, 3) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case S.UnsignedValue{+u}: Empty.absurd({VRP.PADK(bs, 0n, 3) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case S.BytesValue{+xs}: Empty.absurd({VRP.PADK(bs, 0n, 3) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case S.Sequence{+it}: Empty.absurd({VRP.PADK(bs, 0n, 3) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case S.Items{+hh, +tt}: Empty.absurd({VRP.PADK(bs, 0n, 3) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case S.EmptyItems{}: Empty.absurd({VRP.PADK(bs, 0n, 3) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case S.Selected{+sel, +sv}: Empty.absurd({VRP.PADK(bs, 0n, 3) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case S.NullValue{}: Empty.absurd({VRP.PADK(bs, 0n, 3) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))

def bitvector_3_rj(+bs: +List<U32>, +h: {Bool.and(Nat.is_eq(List.length(&2, U32, bs), 1n), VRP.PADK(bs, 0n, 3)) == False{} : Bool}, +v: S.Value,
    +e: {Codec.encoding_for_legal_type(GS.bitvector_3(), v) == Some{bs} : Maybe<&2, +List<U32>>}) -> Empty:
  VRB.chk_true(Nat.is_eq(List.length(&2, U32, bs), 1n), VRP.PADK(bs, 0n, 3),
    VRB.len_eq(SS.fixed_size(GS.bitvector_3()), 1n, bs, Codec.parts(v, GS.bitvector_3()), DS.facts(v, GS.bitvector_3(), {==}), {==}, e), bitvector_3_pv(v, bs, e), h)

# a byte list of another length, or with a padding bit set, is no encoding
def bitvector_3_decode_reject(+bs: +List<U32>, +h: {Bool.and(Nat.is_eq(List.length(&2, U32, bs), 1n), VRP.PADK(bs, 0n, 3)) == False{} : Bool}) -> Decoding.outside_image(GS.bitvector_3(), bs):
  v => e => bitvector_3_rj(bs, h, v, e)

# ---- bitvector_4 (BitVector[4], 1 bytes; validator T.bv4_ok: bits 4..7 of byte 0 clear) ----
def bitvector_4_at(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 1n), A.quad(VB.pw(d))) == True{} : Bool})
    -> {Fulu_bitvector_4_r.bv4_ok_at(UA.BF(t, n), off) == (UA.BF(t, n), VRP.PADK(UW.WX(t, x, 1n), 0n, 4)) : B.Buf & Bool}:
  +hk = FD.nat__lt_le_trans(Nat.add(x, 0n), Nat.add(x, 1n), A.quad(VB.pw(d)), FD.nat__lt_add_left(0n, 1n, x, {==}), hb)
  +hy = FD.logic__subst(Nat, z => {Nat.is_lt(z, A.quad(VB.pw(d))) == True{} : Bool}, Nat.add(x, 0n), Nat.add(0n, x), FD.nat__add_comm(x, 0n), hk)
  +ey = UR.offx(d, off, 0, x, e, FD.nat__lt_trans(d, 28n, 30n, hd, {==}), hy)
  %Equal.sym(B.Buf & U32, B.byte_at(UA.BF(t, n), U32.add(off, 0)), (UA.BF(t, n), VR.VX(t, U32.add(off, 0))),
      VR.byte_at_ok(d, t, n, U32.add(off, 0), FD.nat__lt_trans(d, 28n, 32n, hd, {==}), VR.hiX(d, U32.add(off, 0), Nat.add(0n, x), ey, hy), pf)) :
    {O.pad_pick(4, _) == (UA.BF(t, n), VRP.PADK(UW.WX(t, x, 1n), 0n, 4)) : B.Buf & Bool}
  %Equal.sym(U32, VR.VX(t, U32.add(off, 0)), VRB.BX(t, Nat.add(0n, x)), VRB.vx_bx(t, U32.add(off, 0), Nat.add(0n, x), ey)) :
    {O.pad_pick(4, (UA.BF(t, n), _)) == (UA.BF(t, n), VRP.PADK(UW.WX(t, x, 1n), 0n, 4)) : B.Buf & Bool}
  %Equal.sym(U32, VBL.nthb(UW.WX(t, x, 1n), 0n), VBL.nthb(UA.BYT(t), Nat.add(x, 0n)),
      Equal.trans(U32, VBL.nthb(UW.WX(t, x, 1n), 0n), VBL.nthb(VS.bdr(x, UA.BYT(t)), 0n), VBL.nthb(UA.BYT(t), Nat.add(x, 0n)),
        VR.nth_bt(1n, VS.bdr(x, UA.BYT(t)), 0n, {==}), VR.nth_bdr(x, UA.BYT(t), 0n))) :
    {O.pad_pick(4, (UA.BF(t, n), VRB.BX(t, Nat.add(0n, x)))) == (UA.BF(t, n), U32.is_eq(U32.and(_, U32.not(O.low_mask(4))), 0)) : B.Buf & Bool}
  %Equal.sym(Nat, Nat.add(x, 0n), Nat.add(0n, x), FD.nat__add_comm(x, 0n)) :
    {O.pad_pick(4, (UA.BF(t, n), VRB.BX(t, Nat.add(0n, x)))) == (UA.BF(t, n), U32.is_eq(U32.and(VBL.nthb(UA.BYT(t), _), U32.not(O.low_mask(4))), 0)) : B.Buf & Bool}
  {==}

def bitvector_4_okl(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
