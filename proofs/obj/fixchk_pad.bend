    +e: {Codec.encoding_for_legal_type(GS.bitvector_513(), v) == Some{bs} : Maybe<&2, +List<U32>>}) -> Empty:
  VRB.chk_true(Nat.is_eq(List.length(&2, U32, bs), 65n), VRP.PADK(bs, 64n, 1),
    VRB.len_eq(SS.fixed_size(GS.bitvector_513()), 65n, bs, Codec.parts(v, GS.bitvector_513()), DS.facts(v, GS.bitvector_513(), {==}), {==}, e), bitvector_513_pv(v, bs, e), h)

# a byte list of another length, or with a padding bit set, is no encoding
def bitvector_513_decode_reject(+bs: +List<U32>, +h: {Bool.and(Nat.is_eq(List.length(&2, U32, bs), 65n), VRP.PADK(bs, 64n, 1)) == False{} : Bool}) -> Decoding.outside_image(GS.bitvector_513(), bs):
  v => e => bitvector_513_rj(bs, h, v, e)

# ---- bitvector_5 (BitVector[5], 1 bytes; validator T.bv5_ok: bits 5..7 of byte 0 clear) ----
def bitvector_5_at(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 1n), A.quad(VB.pw(d))) == True{} : Bool})
    -> {bitvector_5_r.bv5_ok_at(UA.BF(t, n), off) == (UA.BF(t, n), VRP.PADK(UW.WX(t, x, 1n), 0n, 5)) : B.Buf & Bool}:
  +hk = FD.nat__lt_le_trans(Nat.add(x, 0n), Nat.add(x, 1n), A.quad(VB.pw(d)), FD.nat__lt_add_left(0n, 1n, x, {==}), hb)
  +hy = FD.logic__subst(Nat, z => {Nat.is_lt(z, A.quad(VB.pw(d))) == True{} : Bool}, Nat.add(x, 0n), Nat.add(0n, x), FD.nat__add_comm(x, 0n), hk)
  +ey = UR.offx(d, off, 0, x, e, FD.nat__lt_trans(d, 28n, 30n, hd, {==}), hy)
  %Equal.sym(B.Buf & U32, B.byte_at(UA.BF(t, n), U32.add(off, 0)), (UA.BF(t, n), VR.VX(t, U32.add(off, 0))),
      VR.byte_at_ok(d, t, n, U32.add(off, 0), FD.nat__lt_trans(d, 28n, 32n, hd, {==}), VR.hiX(d, U32.add(off, 0), Nat.add(0n, x), ey, hy), pf)) :
    {O.pad_pick(5, _) == (UA.BF(t, n), VRP.PADK(UW.WX(t, x, 1n), 0n, 5)) : B.Buf & Bool}
  %Equal.sym(U32, VR.VX(t, U32.add(off, 0)), VRB.BX(t, Nat.add(0n, x)), VRB.vx_bx(t, U32.add(off, 0), Nat.add(0n, x), ey)) :
    {O.pad_pick(5, (UA.BF(t, n), _)) == (UA.BF(t, n), VRP.PADK(UW.WX(t, x, 1n), 0n, 5)) : B.Buf & Bool}
  %Equal.sym(U32, VBL.nthb(UW.WX(t, x, 1n), 0n), VBL.nthb(UA.BYT(t), Nat.add(x, 0n)),
      Equal.trans(U32, VBL.nthb(UW.WX(t, x, 1n), 0n), VBL.nthb(VS.bdr(x, UA.BYT(t)), 0n), VBL.nthb(UA.BYT(t), Nat.add(x, 0n)),
        VR.nth_bt(1n, VS.bdr(x, UA.BYT(t)), 0n, {==}), VR.nth_bdr(x, UA.BYT(t), 0n))) :
    {O.pad_pick(5, (UA.BF(t, n), VRB.BX(t, Nat.add(0n, x)))) == (UA.BF(t, n), U32.is_eq(U32.and(_, U32.not(O.low_mask(5))), 0)) : B.Buf & Bool}
  %Equal.sym(Nat, Nat.add(x, 0n), Nat.add(0n, x), FD.nat__add_comm(x, 0n)) :
    {O.pad_pick(5, (UA.BF(t, n), VRB.BX(t, Nat.add(0n, x)))) == (UA.BF(t, n), U32.is_eq(U32.and(VBL.nthb(UA.BYT(t), _), U32.not(O.low_mask(5))), 0)) : B.Buf & Bool}
  {==}

def bitvector_5_okl(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 1n), A.quad(VB.pw(d))) == True{} : Bool}, +b: Bool)
    -> {bitvector_5_r.bv5_ok_len(b, UA.BF(t, n), off) == (UA.BF(t, n), Bool.and(b, VRP.PADK(UW.WX(t, x, 1n), 0n, 5))) : B.Buf & Bool}:
  match b:
    case True{}: bitvector_5_at(d, t, n, off, x, e, hd, pf, hb)
    case False{}: {==}

# the validator returns the length check and the padding check of the last window byte
def bitvector_5_ok_eval(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 1n), A.quad(VB.pw(d))) == True{} : Bool}, +len: U32)
    -> {bitvector_5_r.bv5_ok(UA.BF(t, n), off, len) == (UA.BF(t, n), Bool.and(U32.is_eq(len, 1), VRP.PADK(UW.WX(t, x, 1n), 0n, 5))) : B.Buf & Bool}:
  bitvector_5_okl(d, t, n, off, x, e, hd, pf, hb, U32.is_eq(len, 1))

def bitvector_5_atD(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 1n), A.quad(VB.pw(d))) == True{} : Bool})
    -> {bitvector_5_r.bv5_ok_at(UA.BF(t, n), off) == (UA.BF(t, n), VRP.PADK(UW.WX(t, x, 1n), 0n, 5)) : B.Buf & Bool}:
  +hk = FD.nat__lt_le_trans(Nat.add(x, 0n), Nat.add(x, 1n), A.quad(VB.pw(d)), FD.nat__lt_add_left(0n, 1n, x, {==}), hb)
  +hy = FD.logic__subst(Nat, z => {Nat.is_lt(z, A.quad(VB.pw(d))) == True{} : Bool}, Nat.add(x, 0n), Nat.add(0n, x), FD.nat__add_comm(x, 0n), hk)
  +ey = UR.offx31(d, off, 0, x, e, hd, hy)
  %Equal.sym(B.Buf & U32, B.byte_at(UA.BF(t, n), U32.add(off, 0)), (UA.BF(t, n), VR.VX(t, U32.add(off, 0))),
      VR.byte_at_ok(d, t, n, U32.add(off, 0), FD.nat__lt_trans(d, 31n, 32n, hd, {==}), VR.hiX(d, U32.add(off, 0), Nat.add(0n, x), ey, hy), pf)) :
    {O.pad_pick(5, _) == (UA.BF(t, n), VRP.PADK(UW.WX(t, x, 1n), 0n, 5)) : B.Buf & Bool}
  %Equal.sym(U32, VR.VX(t, U32.add(off, 0)), VRB.BX(t, Nat.add(0n, x)), VRB.vx_bx(t, U32.add(off, 0), Nat.add(0n, x), ey)) :
    {O.pad_pick(5, (UA.BF(t, n), _)) == (UA.BF(t, n), VRP.PADK(UW.WX(t, x, 1n), 0n, 5)) : B.Buf & Bool}
  %Equal.sym(U32, VBL.nthb(UW.WX(t, x, 1n), 0n), VBL.nthb(UA.BYT(t), Nat.add(x, 0n)),
      Equal.trans(U32, VBL.nthb(UW.WX(t, x, 1n), 0n), VBL.nthb(VS.bdr(x, UA.BYT(t)), 0n), VBL.nthb(UA.BYT(t), Nat.add(x, 0n)),
        VR.nth_bt(1n, VS.bdr(x, UA.BYT(t)), 0n, {==}), VR.nth_bdr(x, UA.BYT(t), 0n))) :
    {O.pad_pick(5, (UA.BF(t, n), VRB.BX(t, Nat.add(0n, x)))) == (UA.BF(t, n), U32.is_eq(U32.and(_, U32.not(O.low_mask(5))), 0)) : B.Buf & Bool}
  %Equal.sym(Nat, Nat.add(x, 0n), Nat.add(0n, x), FD.nat__add_comm(x, 0n)) :
    {O.pad_pick(5, (UA.BF(t, n), VRB.BX(t, Nat.add(0n, x)))) == (UA.BF(t, n), U32.is_eq(U32.and(VBL.nthb(UA.BYT(t), _), U32.not(O.low_mask(5))), 0)) : B.Buf & Bool}
  {==}

def bitvector_5_oklD(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 1n), A.quad(VB.pw(d))) == True{} : Bool}, +b: Bool)
    -> {bitvector_5_r.bv5_ok_len(b, UA.BF(t, n), off) == (UA.BF(t, n), Bool.and(b, VRP.PADK(UW.WX(t, x, 1n), 0n, 5))) : B.Buf & Bool}:
  match b:
    case True{}: bitvector_5_atD(d, t, n, off, x, e, hd, pf, hb)
    case False{}: {==}

# the validator returns the length check and the padding check of the last window byte
def bitvector_5_ok_evalD(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 1n), A.quad(VB.pw(d))) == True{} : Bool}, +len: U32)
    -> {bitvector_5_r.bv5_ok(UA.BF(t, n), off, len) == (UA.BF(t, n), Bool.and(U32.is_eq(len, 1), VRP.PADK(UW.WX(t, x, 1n), 0n, 5))) : B.Buf & Bool}:
  bitvector_5_oklD(d, t, n, off, x, e, hd, pf, hb, U32.is_eq(len, 1))

# every encoding at BitVector[5]: its padding bits clear
def bitvector_5_dom(+bits: +List<Bool>, +bs: +List<U32>, +c: Bool, +ec: {Bool.and(Nat.is_lt(0n, 5n), Nat.is_eq(List.length(&2, Bool, bits), 5n)) == c : Bool},
    +e: {Codec.bytes(Codec.one(SBF.encoding(c, bits), Some{Nat.div(Nat.add(5n, 7n), 8n)})) == Some{bs} : Maybe<&2, +List<U32>>})
    -> {VRP.PADK(bs, 0n, 5) == True{} : Bool}:
  match c:
    case False{}: Empty.absurd({VRP.PADK(bs, 0n, 5) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case True{}:
      FD.logic__subst(+List<U32>, z => {VRP.PADK(z, 0n, 5) == True{} : Bool}, Bp.pack(bits), bs, FD.logic__some_inj(+List<U32>, Bp.pack(bits), bs, e), VRP.padq5(0n, bits, ec))
def bitvector_5_pv(+v: S.Value, +bs: +List<U32>, +e: {Codec.encoding_for_legal_type(GS.bitvector_5(), v) == Some{bs} : Maybe<&2, +List<U32>>})
    -> {VRP.PADK(bs, 0n, 5) == True{} : Bool}:
  match v:
    case S.BitsValue{+bits}: bitvector_5_dom(bits, bs, Bool.and(Nat.is_lt(0n, 5n), Nat.is_eq(List.length(&2, Bool, bits), 5n)), {==}, e)
    case S.BooleanValue{+b}: Empty.absurd({VRP.PADK(bs, 0n, 5) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case S.UnsignedValue{+u}: Empty.absurd({VRP.PADK(bs, 0n, 5) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case S.BytesValue{+xs}: Empty.absurd({VRP.PADK(bs, 0n, 5) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case S.Sequence{+it}: Empty.absurd({VRP.PADK(bs, 0n, 5) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case S.Items{+hh, +tt}: Empty.absurd({VRP.PADK(bs, 0n, 5) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case S.EmptyItems{}: Empty.absurd({VRP.PADK(bs, 0n, 5) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case S.Selected{+sel, +sv}: Empty.absurd({VRP.PADK(bs, 0n, 5) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case S.NullValue{}: Empty.absurd({VRP.PADK(bs, 0n, 5) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))

def bitvector_5_rj(+bs: +List<U32>, +h: {Bool.and(Nat.is_eq(List.length(&2, U32, bs), 1n), VRP.PADK(bs, 0n, 5)) == False{} : Bool}, +v: S.Value,
    +e: {Codec.encoding_for_legal_type(GS.bitvector_5(), v) == Some{bs} : Maybe<&2, +List<U32>>}) -> Empty:
  VRB.chk_true(Nat.is_eq(List.length(&2, U32, bs), 1n), VRP.PADK(bs, 0n, 5),
    VRB.len_eq(SS.fixed_size(GS.bitvector_5()), 1n, bs, Codec.parts(v, GS.bitvector_5()), DS.facts(v, GS.bitvector_5(), {==}), {==}, e), bitvector_5_pv(v, bs, e), h)

# a byte list of another length, or with a padding bit set, is no encoding
def bitvector_5_decode_reject(+bs: +List<U32>, +h: {Bool.and(Nat.is_eq(List.length(&2, U32, bs), 1n), VRP.PADK(bs, 0n, 5)) == False{} : Bool}) -> Decoding.outside_image(GS.bitvector_5(), bs):
  v => e => bitvector_5_rj(bs, h, v, e)

# ---- bitvector_6 (BitVector[6], 1 bytes; validator T.bv6_ok: bits 6..7 of byte 0 clear) ----
def bitvector_6_at(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 1n), A.quad(VB.pw(d))) == True{} : Bool})
    -> {bitvector_6_r.bv6_ok_at(UA.BF(t, n), off) == (UA.BF(t, n), VRP.PADK(UW.WX(t, x, 1n), 0n, 6)) : B.Buf & Bool}:
  +hk = FD.nat__lt_le_trans(Nat.add(x, 0n), Nat.add(x, 1n), A.quad(VB.pw(d)), FD.nat__lt_add_left(0n, 1n, x, {==}), hb)
  +hy = FD.logic__subst(Nat, z => {Nat.is_lt(z, A.quad(VB.pw(d))) == True{} : Bool}, Nat.add(x, 0n), Nat.add(0n, x), FD.nat__add_comm(x, 0n), hk)
  +ey = UR.offx(d, off, 0, x, e, FD.nat__lt_trans(d, 28n, 30n, hd, {==}), hy)
  %Equal.sym(B.Buf & U32, B.byte_at(UA.BF(t, n), U32.add(off, 0)), (UA.BF(t, n), VR.VX(t, U32.add(off, 0))),
      VR.byte_at_ok(d, t, n, U32.add(off, 0), FD.nat__lt_trans(d, 28n, 32n, hd, {==}), VR.hiX(d, U32.add(off, 0), Nat.add(0n, x), ey, hy), pf)) :
    {O.pad_pick(6, _) == (UA.BF(t, n), VRP.PADK(UW.WX(t, x, 1n), 0n, 6)) : B.Buf & Bool}
  %Equal.sym(U32, VR.VX(t, U32.add(off, 0)), VRB.BX(t, Nat.add(0n, x)), VRB.vx_bx(t, U32.add(off, 0), Nat.add(0n, x), ey)) :
    {O.pad_pick(6, (UA.BF(t, n), _)) == (UA.BF(t, n), VRP.PADK(UW.WX(t, x, 1n), 0n, 6)) : B.Buf & Bool}
  %Equal.sym(U32, VBL.nthb(UW.WX(t, x, 1n), 0n), VBL.nthb(UA.BYT(t), Nat.add(x, 0n)),
      Equal.trans(U32, VBL.nthb(UW.WX(t, x, 1n), 0n), VBL.nthb(VS.bdr(x, UA.BYT(t)), 0n), VBL.nthb(UA.BYT(t), Nat.add(x, 0n)),
        VR.nth_bt(1n, VS.bdr(x, UA.BYT(t)), 0n, {==}), VR.nth_bdr(x, UA.BYT(t), 0n))) :
    {O.pad_pick(6, (UA.BF(t, n), VRB.BX(t, Nat.add(0n, x)))) == (UA.BF(t, n), U32.is_eq(U32.and(_, U32.not(O.low_mask(6))), 0)) : B.Buf & Bool}
  %Equal.sym(Nat, Nat.add(x, 0n), Nat.add(0n, x), FD.nat__add_comm(x, 0n)) :
    {O.pad_pick(6, (UA.BF(t, n), VRB.BX(t, Nat.add(0n, x)))) == (UA.BF(t, n), U32.is_eq(U32.and(VBL.nthb(UA.BYT(t), _), U32.not(O.low_mask(6))), 0)) : B.Buf & Bool}
  {==}

def bitvector_6_okl(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
