# the validator returns the length check and the padding check of the last window byte
def bitvector_9_ok_eval(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 2n), A.quad(VB.pw(d))) == True{} : Bool}, +len: U32)
    -> {bitvector_9_r.bv9_ok(UA.BF(t, n), off, len) == (UA.BF(t, n), Bool.and(U32.is_eq(len, 2), VRP.PADK(UW.WX(t, x, 2n), 1n, 1))) : B.Buf & Bool}:
  bitvector_9_okl(d, t, n, off, x, e, hd, pf, hb, U32.is_eq(len, 2))

def bitvector_9_atD(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 2n), A.quad(VB.pw(d))) == True{} : Bool})
    -> {bitvector_9_r.bv9_ok_at(UA.BF(t, n), off) == (UA.BF(t, n), VRP.PADK(UW.WX(t, x, 2n), 1n, 1)) : B.Buf & Bool}:
  +hk = FD.nat__lt_le_trans(Nat.add(x, 1n), Nat.add(x, 2n), A.quad(VB.pw(d)), FD.nat__lt_add_left(1n, 2n, x, {==}), hb)
  +hy = FD.logic__subst(Nat, z => {Nat.is_lt(z, A.quad(VB.pw(d))) == True{} : Bool}, Nat.add(x, 1n), Nat.add(1n, x), FD.nat__add_comm(x, 1n), hk)
  +ey = UR.offx31(d, off, 1, x, e, hd, hy)
  %Equal.sym(B.Buf & U32, B.byte_at(UA.BF(t, n), U32.add(off, 1)), (UA.BF(t, n), VR.VX(t, U32.add(off, 1))),
      VR.byte_at_ok(d, t, n, U32.add(off, 1), FD.nat__lt_trans(d, 31n, 32n, hd, {==}), VR.hiX(d, U32.add(off, 1), Nat.add(1n, x), ey, hy), pf)) :
    {O.pad_pick(1, _) == (UA.BF(t, n), VRP.PADK(UW.WX(t, x, 2n), 1n, 1)) : B.Buf & Bool}
  %Equal.sym(U32, VR.VX(t, U32.add(off, 1)), VRB.BX(t, Nat.add(1n, x)), VRB.vx_bx(t, U32.add(off, 1), Nat.add(1n, x), ey)) :
    {O.pad_pick(1, (UA.BF(t, n), _)) == (UA.BF(t, n), VRP.PADK(UW.WX(t, x, 2n), 1n, 1)) : B.Buf & Bool}
  %Equal.sym(U32, VBL.nthb(UW.WX(t, x, 2n), 1n), VBL.nthb(UA.BYT(t), Nat.add(x, 1n)),
      Equal.trans(U32, VBL.nthb(UW.WX(t, x, 2n), 1n), VBL.nthb(VS.bdr(x, UA.BYT(t)), 1n), VBL.nthb(UA.BYT(t), Nat.add(x, 1n)),
        VR.nth_bt(2n, VS.bdr(x, UA.BYT(t)), 1n, {==}), VR.nth_bdr(x, UA.BYT(t), 1n))) :
    {O.pad_pick(1, (UA.BF(t, n), VRB.BX(t, Nat.add(1n, x)))) == (UA.BF(t, n), U32.is_eq(U32.and(_, U32.not(O.low_mask(1))), 0)) : B.Buf & Bool}
  %Equal.sym(Nat, Nat.add(x, 1n), Nat.add(1n, x), FD.nat__add_comm(x, 1n)) :
    {O.pad_pick(1, (UA.BF(t, n), VRB.BX(t, Nat.add(1n, x)))) == (UA.BF(t, n), U32.is_eq(U32.and(VBL.nthb(UA.BYT(t), _), U32.not(O.low_mask(1))), 0)) : B.Buf & Bool}
  {==}

def bitvector_9_oklD(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 2n), A.quad(VB.pw(d))) == True{} : Bool}, +b: Bool)
    -> {bitvector_9_r.bv9_ok_len(b, UA.BF(t, n), off) == (UA.BF(t, n), Bool.and(b, VRP.PADK(UW.WX(t, x, 2n), 1n, 1))) : B.Buf & Bool}:
  match b:
    case True{}: bitvector_9_atD(d, t, n, off, x, e, hd, pf, hb)
    case False{}: {==}

# the validator returns the length check and the padding check of the last window byte
def bitvector_9_ok_evalD(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +off: U32, +x: Nat, +e: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(x, 2n), A.quad(VB.pw(d))) == True{} : Bool}, +len: U32)
    -> {bitvector_9_r.bv9_ok(UA.BF(t, n), off, len) == (UA.BF(t, n), Bool.and(U32.is_eq(len, 2), VRP.PADK(UW.WX(t, x, 2n), 1n, 1))) : B.Buf & Bool}:
  bitvector_9_oklD(d, t, n, off, x, e, hd, pf, hb, U32.is_eq(len, 2))

# every encoding at BitVector[9]: its padding bits clear
def bitvector_9_dom(+bits: +List<Bool>, +bs: +List<U32>, +c: Bool, +ec: {Bool.and(Nat.is_lt(0n, 9n), Nat.is_eq(List.length(&2, Bool, bits), 9n)) == c : Bool},
    +e: {Codec.bytes(Codec.one(SBF.encoding(c, bits), Some{Nat.div(Nat.add(9n, 7n), 8n)})) == Some{bs} : Maybe<&2, +List<U32>>})
    -> {VRP.PADK(bs, 1n, 1) == True{} : Bool}:
  match c:
    case False{}: Empty.absurd({VRP.PADK(bs, 1n, 1) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case True{}:
      FD.logic__subst(+List<U32>, z => {VRP.PADK(z, 1n, 1) == True{} : Bool}, Bp.pack(bits), bs, FD.logic__some_inj(+List<U32>, Bp.pack(bits), bs, e), VRP.padq1(1n, bits, ec))
def bitvector_9_pv(+v: S.Value, +bs: +List<U32>, +e: {Codec.encoding_for_legal_type(GS.bitvector_9(), v) == Some{bs} : Maybe<&2, +List<U32>>})
    -> {VRP.PADK(bs, 1n, 1) == True{} : Bool}:
  match v:
    case S.BitsValue{+bits}: bitvector_9_dom(bits, bs, Bool.and(Nat.is_lt(0n, 9n), Nat.is_eq(List.length(&2, Bool, bits), 9n)), {==}, e)
    case S.BooleanValue{+b}: Empty.absurd({VRP.PADK(bs, 1n, 1) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case S.UnsignedValue{+u}: Empty.absurd({VRP.PADK(bs, 1n, 1) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case S.BytesValue{+xs}: Empty.absurd({VRP.PADK(bs, 1n, 1) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case S.Sequence{+it}: Empty.absurd({VRP.PADK(bs, 1n, 1) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case S.Items{+hh, +tt}: Empty.absurd({VRP.PADK(bs, 1n, 1) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case S.EmptyItems{}: Empty.absurd({VRP.PADK(bs, 1n, 1) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case S.Selected{+sel, +sv}: Empty.absurd({VRP.PADK(bs, 1n, 1) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case S.NullValue{}: Empty.absurd({VRP.PADK(bs, 1n, 1) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))

def bitvector_9_rj(+bs: +List<U32>, +h: {Bool.and(Nat.is_eq(List.length(&2, U32, bs), 2n), VRP.PADK(bs, 1n, 1)) == False{} : Bool}, +v: S.Value,
    +e: {Codec.encoding_for_legal_type(GS.bitvector_9(), v) == Some{bs} : Maybe<&2, +List<U32>>}) -> Empty:
  VRB.chk_true(Nat.is_eq(List.length(&2, U32, bs), 2n), VRP.PADK(bs, 1n, 1),
    VRB.len_eq(SS.fixed_size(GS.bitvector_9()), 2n, bs, Codec.parts(v, GS.bitvector_9()), DS.facts(v, GS.bitvector_9(), {==}), {==}, e), bitvector_9_pv(v, bs, e), h)

# a byte list of another length, or with a padding bit set, is no encoding
def bitvector_9_decode_reject(+bs: +List<U32>, +h: {Bool.and(Nat.is_eq(List.length(&2, U32, bs), 2n), VRP.PADK(bs, 1n, 1)) == False{} : Bool}) -> Decoding.outside_image(GS.bitvector_9(), bs):
  v => e => bitvector_9_rj(bs, h, v, e)

