# every encoding at BitVector[511]: its padding bits clear
def bitvector_511_dom(+bits: +List<Bool>, +bs: +List<U32>, +c: Bool, +ec: {Bool.and(Nat.is_lt(0n, 511n), Nat.is_eq(List.length(&2, Bool, bits), 511n)) == c : Bool},
    +e: {Codec.bytes(Codec.one(SBF.encoding(c, bits), Some{Nat.div(Nat.add(511n, 7n), 8n)})) == Some{bs} : Maybe<&2, +List<U32>>})
    -> {VRP.PADK(bs, 63n, 7) == True{} : Bool}:
  match c:
    case False{}: Empty.absurd({VRP.PADK(bs, 63n, 7) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case True{}:
      FD.logic__subst(+List<U32>, z => {VRP.PADK(z, 63n, 7) == True{} : Bool}, Bp.pack(bits), bs, FD.logic__some_inj(+List<U32>, Bp.pack(bits), bs, e), VRP.padq7(63n, bits, ec))
def bitvector_511_pv(+v: S.Value, +bs: +List<U32>, +e: {Codec.encoding_for_legal_type(GS.bitvector_511(), v) == Some{bs} : Maybe<&2, +List<U32>>})
    -> {VRP.PADK(bs, 63n, 7) == True{} : Bool}:
  match v:
    case S.BitsValue{+bits}: bitvector_511_dom(bits, bs, Bool.and(Nat.is_lt(0n, 511n), Nat.is_eq(List.length(&2, Bool, bits), 511n)), {==}, e)
    case S.BooleanValue{+b}: Empty.absurd({VRP.PADK(bs, 63n, 7) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case S.UnsignedValue{+u}: Empty.absurd({VRP.PADK(bs, 63n, 7) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case S.BytesValue{+xs}: Empty.absurd({VRP.PADK(bs, 63n, 7) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case S.Sequence{+it}: Empty.absurd({VRP.PADK(bs, 63n, 7) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case S.Items{+hh, +tt}: Empty.absurd({VRP.PADK(bs, 63n, 7) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case S.EmptyItems{}: Empty.absurd({VRP.PADK(bs, 63n, 7) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case S.Selected{+sel, +sv}: Empty.absurd({VRP.PADK(bs, 63n, 7) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case S.NullValue{}: Empty.absurd({VRP.PADK(bs, 63n, 7) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))

def bitvector_511_rj(+bs: +List<U32>, +h: {Bool.and(Nat.is_eq(List.length(&2, U32, bs), 64n), VRP.PADK(bs, 63n, 7)) == False{} : Bool}, +v: S.Value,
    +e: {Codec.encoding_for_legal_type(GS.bitvector_511(), v) == Some{bs} : Maybe<&2, +List<U32>>}) -> Empty:
  VRB.chk_true(Nat.is_eq(List.length(&2, U32, bs), 64n), VRP.PADK(bs, 63n, 7),
    VRB.len_eq(SS.fixed_size(GS.bitvector_511()), 64n, bs, Codec.parts(v, GS.bitvector_511()), DS.facts(v, GS.bitvector_511(), {==}), {==}, e), bitvector_511_pv(v, bs, e), h)

# a byte list of another length, or with a padding bit set, is no encoding
def bitvector_511_decode_reject(+bs: +List<U32>, +h: {Bool.and(Nat.is_eq(List.length(&2, U32, bs), 64n), VRP.PADK(bs, 63n, 7)) == False{} : Bool}) -> Decoding.outside_image(GS.bitvector_511(), bs):
  v => e => bitvector_511_rj(bs, h, v, e)

