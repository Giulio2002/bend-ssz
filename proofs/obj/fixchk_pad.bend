      FD.logic__subst(+List<U32>, z => {VRP.PADK(z, 1n, 7) == True{} : Bool}, Bp.pack(bits), bs, FD.logic__some_inj(+List<U32>, Bp.pack(bits), bs, e), VRP.padq7(1n, bits, ec))
