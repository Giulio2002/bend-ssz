# every encoding at BitVector[4]: its padding bits clear
def bitvector_4_dom(+bits: +List<Bool>, +bs: +List<U32>, +c: Bool, +ec: {Bool.and(Nat.is_lt(0n, 4n), Nat.is_eq(List.length(&2, Bool, bits), 4n)) == c : Bool},
    +e: {Codec.bytes(Codec.one(SBF.encoding(c, bits), Some{Nat.div(Nat.add(4n, 7n), 8n)})) == Some{bs} : Maybe<&2, +List<U32>>})
    -> {VRP.PADK(bs, 0n, 4) == True{} : Bool}:
  match c:
    case False{}: Empty.absurd({VRP.PADK(bs, 0n, 4) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case True{}:
      FD.logic__subst(+List<U32>, z => {VRP.PADK(z, 0n, 4) == True{} : Bool}, Bp.pack(bits), bs, FD.logic__some_inj(+List<U32>, Bp.pack(bits), bs, e), VRP.padq4(0n, bits, ec))
def bitvector_4_pv(+v: S.Value, +bs: +List<U32>, +e: {Codec.encoding_for_legal_type(GS.bitvector_4(), v) == Some{bs} : Maybe<&2, +List<U32>>})
    -> {VRP.PADK(bs, 0n, 4) == True{} : Bool}:
  match v:
    case S.BitsValue{+bits}: bitvector_4_dom(bits, bs, Bool.and(Nat.is_lt(0n, 4n), Nat.is_eq(List.length(&2, Bool, bits), 4n)), {==}, e)
    case S.BooleanValue{+b}: Empty.absurd({VRP.PADK(bs, 0n, 4) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case S.UnsignedValue{+u}: Empty.absurd({VRP.PADK(bs, 0n, 4) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case S.BytesValue{+xs}: Empty.absurd({VRP.PADK(bs, 0n, 4) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case S.Sequence{+it}: Empty.absurd({VRP.PADK(bs, 0n, 4) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case S.Items{+hh, +tt}: Empty.absurd({VRP.PADK(bs, 0n, 4) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case S.EmptyItems{}: Empty.absurd({VRP.PADK(bs, 0n, 4) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case S.Selected{+sel, +sv}: Empty.absurd({VRP.PADK(bs, 0n, 4) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case S.NullValue{}: Empty.absurd({VRP.PADK(bs, 0n, 4) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))

def bitvector_4_rj(+bs: +List<U32>, +h: {Bool.and(Nat.is_eq(List.length(&2, U32, bs), 1n), VRP.PADK(bs, 0n, 4)) == False{} : Bool}, +v: S.Value,
    +e: {Codec.encoding_for_legal_type(GS.bitvector_4(), v) == Some{bs} : Maybe<&2, +List<U32>>}) -> Empty:
  VRB.chk_true(Nat.is_eq(List.length(&2, U32, bs), 1n), VRP.PADK(bs, 0n, 4),
    VRB.len_eq(SS.fixed_size(GS.bitvector_4()), 1n, bs, Codec.parts(v, GS.bitvector_4()), DS.facts(v, GS.bitvector_4(), {==}), {==}, e), bitvector_4_pv(v, bs, e), h)

# a byte list of another length, or with a padding bit set, is no encoding
def bitvector_4_decode_reject(+bs: +List<U32>, +h: {Bool.and(Nat.is_eq(List.length(&2, U32, bs), 1n), VRP.PADK(bs, 0n, 4)) == False{} : Bool}) -> Decoding.outside_image(GS.bitvector_4(), bs):
  v => e => bitvector_4_rj(bs, h, v, e)

