# every size other than 24624 is refused
def SyncCommittee_spec_reject(buf: B.Buf, +m: U32, e: {U32.is_eq(m, 24624) == False{} : Bool})
    -> {T.SyncCommittee_decode(buf, m) == (buf, None{}) : B.Buf & Maybe<&1, T.SyncCommittee>}:
  %Equal.sym(Bool, U32.is_eq(m, 24624), False{}, e) : {T.SyncCommittee_built(m, T.SyncCommittee_ok_len(_, buf, 0)) == (buf, None{}) : B.Buf & Maybe<&1, T.SyncCommittee>}
  {==}

