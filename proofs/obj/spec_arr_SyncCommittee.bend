# encoder soundness against spec/codec.bend
def SyncCommittee_spec_encode(+a: F.array__Tree<U32>, +b: F.array__Tree<U32>, +pa: {F.array__perfect(U32, 12n, a) == True{} : Bool}, +pb: {F.array__perfect(U32, 11n, b) == True{} : Bool}, +g0: U32, +g1: U32, +g2: U32, +g3: U32, +g4: U32, +g5: U32, +g6: U32, +g7: U32, +g8: U32, +g9: U32, +g10: U32, +g11: U32, +s: S.Schema, +es: {s == Spec.SyncCommittee() : S.Schema})
    -> Decoding.decodes(s, SF.limbs(F.spec_common__append(U32, F.array__slots(U32, a), F.spec_common__append(U32, F.array__slots(U32, b), [g0, g1, g2, g3, g4, g5, g6, g7, g8, g9, g10, g11]))), S.Sequence{S.Items{S.Sequence{AV.ch12(F.spec_common__append(U32, F.array__slots(U32, a), F.array__slots(U32, b)))}, S.Items{S.BytesValue{SF.limbs([g0, g1, g2, g3, g4, g5, g6, g7, g8, g9, g10, g11])}, S.EmptyItems{}}}}):
