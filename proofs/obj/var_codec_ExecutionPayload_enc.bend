# ---- the laws, on the container's mirror ----
def SZSM(m: CI.MW) -> U32:
  match m:
    case CI.MW{+parent_hash, +fee_recipient, +state_root, +receipts_root, +dB_logs_bloom, +TB_logs_bloom, +prev_randao, +block_number, +gas_limit, +gas_used, +timestamp, +m_extra_data, +base_fee_per_gas, +block_hash, +t_transactions, +N_transactions, +A_withdrawals, +N_withdrawals, +blob_gas_used, +excess_blob_gas}: Z.SZS(parent_hash, fee_recipient, state_root, receipts_root, dB_logs_bloom, TB_logs_bloom, prev_randao, block_number, gas_limit, gas_used, timestamp, m_extra_data, base_fee_per_gas, block_hash, t_transactions, N_transactions, A_withdrawals, N_withdrawals, blob_gas_used, excess_blob_gas)
def OUTE(m: CI.MW) -> FD.array__Tree<U32>:
  match m:
    case CI.MW{+parent_hash, +fee_recipient, +state_root, +receipts_root, +dB_logs_bloom, +TB_logs_bloom, +prev_randao, +block_number, +gas_limit, +gas_used, +timestamp, +m_extra_data, +base_fee_per_gas, +block_hash, +t_transactions, +N_transactions, +A_withdrawals, +N_withdrawals, +blob_gas_used, +excess_blob_gas}: OUTC(parent_hash, fee_recipient, state_root, receipts_root, dB_logs_bloom, TB_logs_bloom, prev_randao, block_number, gas_limit, gas_used, timestamp, m_extra_data, base_fee_per_gas, block_hash, t_transactions, N_transactions, A_withdrawals, N_withdrawals, blob_gas_used, excess_blob_gas)

# The encoder returns the object and the buffer of OUTE(m), its bytes.
law encode_eval:
  for +m: CI.MW
  for +hok: {CI.OK(m) == True{} : Bool}
  {FuluExecutionPayload_e.ExecutionPayload_encode(CI.TH(m)) == (CI.TH(m), B.Buf{FD.array__thaw(U32, OUTE(m)), SZSM(m)}) : FuluExecutionPayload_d.ExecutionPayload & B.Buf}
def encode_eval(m, hok):
  match m:
    case CI.MW{+parent_hash, +fee_recipient, +state_root, +receipts_root, +dB_logs_bloom, +TB_logs_bloom, +prev_randao, +block_number, +gas_limit, +gas_used, +timestamp, +m_extra_data, +base_fee_per_gas, +block_hash, +t_transactions, +N_transactions, +A_withdrawals, +N_withdrawals, +blob_gas_used, +excess_blob_gas}: eval_go(parent_hash, fee_recipient, state_root, receipts_root, dB_logs_bloom, TB_logs_bloom, prev_randao, block_number, gas_limit, gas_used, timestamp, m_extra_data, base_fee_per_gas, block_hash, t_transactions, N_transactions, A_withdrawals, N_withdrawals, blob_gas_used, excess_blob_gas, hok)

# The buffer's bytes are the spec encoding of the object's value.
law encode_spec:
  for +m: CI.MW
  for +hok: {CI.OK(m) == True{} : Bool}
  Decoding.decodes(Spec.ExecutionPayload(), VS.bt(U32.to_nat(SZSM(m)), FX.limbs(FD.array__slots(U32, OUTE(m)))), CI.VAL(m))
def encode_spec(m, hok):
  match m:
    case CI.MW{+parent_hash, +fee_recipient, +state_root, +receipts_root, +dB_logs_bloom, +TB_logs_bloom, +prev_randao, +block_number, +gas_limit, +gas_used, +timestamp, +m_extra_data, +base_fee_per_gas, +block_hash, +t_transactions, +N_transactions, +A_withdrawals, +N_withdrawals, +blob_gas_used, +excess_blob_gas}: spec_go(parent_hash, fee_recipient, state_root, receipts_root, dB_logs_bloom, TB_logs_bloom, prev_randao, block_number, gas_limit, gas_used, timestamp, m_extra_data, base_fee_per_gas, block_hash, t_transactions, N_transactions, A_withdrawals, N_withdrawals, blob_gas_used, excess_blob_gas, hok)

