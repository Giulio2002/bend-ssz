  %lnq(K.ENCC(wR)) : {VS.bt(_, VCN.AP(K.ENCC(wR), VCN.AP(UW.ZB(WD.PADB(0n, K.LLC(wR, VL.DO(Z.SZS(wR)), VC.ZT(VL.DO(Z.SZS(wR))), 0, 0n, 0n))), R))) == K.ENCC(wR) : +List<U32>}
  %apq(K.ENCC(wR), VCN.AP(UW.ZB(WD.PADB(0n, K.LLC(wR, VL.DO(Z.SZS(wR)), VC.ZT(VL.DO(Z.SZS(wR))), 0, 0n, 0n))), R)) : {VS.bt(VRX.LN(K.ENCC(wR)), _) == K.ENCC(wR) : +List<U32>}
  VRX.bt_all(K.ENCC(wR), VCN.AP(UW.ZB(WD.PADB(0n, K.LLC(wR, VL.DO(Z.SZS(wR)), VC.ZT(VL.DO(Z.SZS(wR))), 0, 0n, 0n))), R))

def spec_go(+wR: K.KW, +h: {CI.OKT(wR) == True{} : Bool})
    -> Decoding.decodes(Spec.BeaconState(), VS.bt(U32.to_nat(Z.SZS(wR)), FX.limbs(FD.array__slots(U32, K.PUTC(wR, VL.DO(Z.SZS(wR)), VC.ZT(VL.DO(Z.SZS(wR))), 0, 0n, 0n)))), CI.VALC(wR)):
  %Equal.sym(Maybe<&2, +List<S.Part>>, Codec.parts(CI.VALC(wR), Spec.BeaconState()), Some{[S.Variable{K.ENCC(wR)}]}, CI.encx_spec(CI.MW{wR}, h)) :
    {Codec.bytes(_) == Some{VS.bt(U32.to_nat(Z.SZS(wR)), FX.limbs(FD.array__slots(U32, K.PUTC(wR, VL.DO(Z.SZS(wR)), VC.ZT(VL.DO(Z.SZS(wR))), 0, 0n, 0n))))} : Maybe<&2, +List<U32>>}
  %Equal.sym(+List<U32>, VS.bt(U32.to_nat(Z.SZS(wR)), FX.limbs(FD.array__slots(U32, K.PUTC(wR, VL.DO(Z.SZS(wR)), VC.ZT(VL.DO(Z.SZS(wR))), 0, 0n, 0n)))), K.ENCC(wR), obytes(wR, h, 28n, {==})) :
    {Some{K.ENCC(wR)} == Some{_} : Maybe<&2, +List<U32>>}
  {==}

# ---- the laws, on the container's mirror ----
def SZSM(m: CI.MW) -> U32:
  match m:
    case CI.MW{+wR}: Z.SZS(wR)
def OUTE(m: CI.MW) -> FD.array__Tree<U32>:
  match m:
    case CI.MW{+wR}: K.PUTC(wR, VL.DO(Z.SZS(wR)), VC.ZT(VL.DO(Z.SZS(wR))), 0, 0n, 0n)

# The encoder returns the object and the buffer of OUTE(m), its bytes.
law encode_eval:
  for +m: CI.MW
  for +hok: {CI.OK(m) == True{} : Bool}
  {FuluBeaconState_e.BeaconState_encode(CI.TH(m)) == (CI.TH(m), B.Buf{FD.array__thaw(U32, OUTE(m)), SZSM(m)}) : FuluBeaconState_d.BeaconState & B.Buf}
def encode_eval(m, hok):
  match m:
    case CI.MW{+wR}: eval_go(wR, hok)

# The buffer's bytes are the spec encoding of the object's value.
law encode_spec:
  for +m: CI.MW
  for +hok: {CI.OK(m) == True{} : Bool}
  Decoding.decodes(Spec.BeaconState(), VS.bt(U32.to_nat(SZSM(m)), FX.limbs(FD.array__slots(U32, OUTE(m)))), CI.VAL(m))
def encode_spec(m, hok):
  match m:
    case CI.MW{+wR}: spec_go(wR, hok)

