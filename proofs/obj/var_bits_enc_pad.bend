law padw1:
  for +S: List<&2, U32>
  for +Q: Nat
  for +hp: {WS.bdrop(1n, WS.cb(S, Nat.add(Q, 0n))) == SP.zero_bytes(31n) : +List<U32>}
  {WS.bdrop(1n, I.limb(MR.wd(S, Nat.add(O.e8(Nat.add(Q, 0n)), 0n)))) == SP.zero_bytes(3n) : +List<U32>}
def padw1(S, Q, hp):
  Equal.cong(+List<U32>, +List<U32>, z => WS.btake(3n, z), WS.bdrop(1n, WS.cb(S, Nat.add(Q, 0n))), SP.zero_bytes(31n), hp)

