law cwb:
  for +b: Nat
  for +hb: {Nat.is_lt(b, 8n) == True{} : Bool}
  {VD.s_rng(3n, Nat.add(b, 7n)) == BW.CWr(b) : Nat}
def cwb(b, hb):
  match b:
    case 0n: {==}
    case 1n: {==}
    case 2n: {==}
    case 3n: {==}
    case 4n: {==}
    case 5n: {==}
    case 6n: {==}
    case 7n: {==}
    case 8n+ +e: Empty.absurd({VD.s_rng(3n, Nat.add(8n+e, 7n)) == BW.CWr(8n+e) : Nat}, F.nat__lt_zero_absurd(e, hb))

# The offset 4 i + j + [b > 0] of a byte count in its chunk is at most 32.
law cib:
  for +j: Nat
  for +b: Nat
  for +i: Nat
  for +hj: {Nat.is_lt(j, 4n) == True{} : Bool}
  for +hb: {Nat.is_lt(b, 8n) == True{} : Bool}
  for +hi: {Nat.is_lt(i, 8n) == True{} : Bool}
  {Nat.is_le(Nat.add(A.quad(i), Nat.add(j, BW.CWr(b))), 32n) == True{} : Bool}
def cib(j, b, i, hj, hb, hi):
  match j b i:
    case 0n 0n 0n: {==}
    case 0n 0n 1n: {==}
    case 0n 0n 2n: {==}
    case 0n 0n 3n: {==}
    case 0n 0n 4n: {==}
    case 0n 0n 5n: {==}
    case 0n 0n 6n: {==}
    case 0n 0n 7n: {==}
    case 0n 0n 8n+ +e: Empty.absurd({Nat.is_le(Nat.add(A.quad(8n+e), Nat.add(0n, BW.CWr(0n))), 32n) == True{} : Bool}, F.nat__lt_zero_absurd(e, hi))
    case 0n 1n 0n: {==}
    case 0n 1n 1n: {==}
    case 0n 1n 2n: {==}
    case 0n 1n 3n: {==}
    case 0n 1n 4n: {==}
    case 0n 1n 5n: {==}
    case 0n 1n 6n: {==}
    case 0n 1n 7n: {==}
    case 0n 1n 8n+ +e: Empty.absurd({Nat.is_le(Nat.add(A.quad(8n+e), Nat.add(0n, BW.CWr(1n))), 32n) == True{} : Bool}, F.nat__lt_zero_absurd(e, hi))
    case 0n 2n 0n: {==}
    case 0n 2n 1n: {==}
    case 0n 2n 2n: {==}
    case 0n 2n 3n: {==}
    case 0n 2n 4n: {==}
    case 0n 2n 5n: {==}
    case 0n 2n 6n: {==}
    case 0n 2n 7n: {==}
    case 0n 2n 8n+ +e: Empty.absurd({Nat.is_le(Nat.add(A.quad(8n+e), Nat.add(0n, BW.CWr(2n))), 32n) == True{} : Bool}, F.nat__lt_zero_absurd(e, hi))
    case 0n 3n 0n: {==}
    case 0n 3n 1n: {==}
    case 0n 3n 2n: {==}
    case 0n 3n 3n: {==}
    case 0n 3n 4n: {==}
    case 0n 3n 5n: {==}
    case 0n 3n 6n: {==}
    case 0n 3n 7n: {==}
    case 0n 3n 8n+ +e: Empty.absurd({Nat.is_le(Nat.add(A.quad(8n+e), Nat.add(0n, BW.CWr(3n))), 32n) == True{} : Bool}, F.nat__lt_zero_absurd(e, hi))
    case 0n 4n 0n: {==}
    case 0n 4n 1n: {==}
    case 0n 4n 2n: {==}
    case 0n 4n 3n: {==}
    case 0n 4n 4n: {==}
    case 0n 4n 5n: {==}
    case 0n 4n 6n: {==}
    case 0n 4n 7n: {==}
    case 0n 4n 8n+ +e: Empty.absurd({Nat.is_le(Nat.add(A.quad(8n+e), Nat.add(0n, BW.CWr(4n))), 32n) == True{} : Bool}, F.nat__lt_zero_absurd(e, hi))
    case 0n 5n 0n: {==}
    case 0n 5n 1n: {==}
    case 0n 5n 2n: {==}
    case 0n 5n 3n: {==}
    case 0n 5n 4n: {==}
    case 0n 5n 5n: {==}
    case 0n 5n 6n: {==}
