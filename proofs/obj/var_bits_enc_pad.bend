    case 4n+ +e _ _: Empty.absurd({Nat.is_le(Nat.add(A.quad(i), Nat.add(4n+e, BW.CWr(b))), 32n) == True{} : Bool}, F.nat__lt_zero_absurd(e, hj))

# A nonzero bit offset 8 j + b has a nonzero byte count j + [b > 0] in its word.
law cpos:
  for +j: Nat
  for +b: Nat
  for +hj: {Nat.is_lt(j, 4n) == True{} : Bool}
  for +hb: {Nat.is_lt(b, 8n) == True{} : Bool}
  for +h: {Nat.is_lt(0n, Nat.add(VS.x8(j), b)) == True{} : Bool}
  {Nat.is_lt(0n, Nat.add(j, BW.CWr(b))) == True{} : Bool}
def cpos(j, b, hj, hb, h):
  match j b:
    case 0n 0n: Empty.absurd({Nat.is_lt(0n, Nat.add(0n, BW.CWr(0n))) == True{} : Bool}, F.logic__false_true(h))
    case 0n 1n: {==}
    case 0n 2n: {==}
    case 0n 3n: {==}
    case 0n 4n: {==}
    case 0n 5n: {==}
    case 0n 6n: {==}
    case 0n 7n: {==}
    case 0n 8n+ +e: Empty.absurd({Nat.is_lt(0n, Nat.add(0n, BW.CWr(8n+e))) == True{} : Bool}, F.nat__lt_zero_absurd(e, hb))
    case 1n 0n: {==}
    case 1n 1n: {==}
    case 1n 2n: {==}
    case 1n 3n: {==}
    case 1n 4n: {==}
    case 1n 5n: {==}
    case 1n 6n: {==}
    case 1n 7n: {==}
    case 1n 8n+ +e: Empty.absurd({Nat.is_lt(0n, Nat.add(1n, BW.CWr(8n+e))) == True{} : Bool}, F.nat__lt_zero_absurd(e, hb))
    case 2n 0n: {==}
    case 2n 1n: {==}
    case 2n 2n: {==}
    case 2n 3n: {==}
    case 2n 4n: {==}
    case 2n 5n: {==}
    case 2n 6n: {==}
    case 2n 7n: {==}
    case 2n 8n+ +e: Empty.absurd({Nat.is_lt(0n, Nat.add(2n, BW.CWr(8n+e))) == True{} : Bool}, F.nat__lt_zero_absurd(e, hb))
    case 3n 0n: {==}
    case 3n 1n: {==}
    case 3n 2n: {==}
    case 3n 3n: {==}
    case 3n 4n: {==}
    case 3n 5n: {==}
    case 3n 6n: {==}
    case 3n 7n: {==}
    case 3n 8n+ +e: Empty.absurd({Nat.is_lt(0n, Nat.add(3n, BW.CWr(8n+e))) == True{} : Bool}, F.nat__lt_zero_absurd(e, hb))
    case 4n+ +e _: Empty.absurd({Nat.is_lt(0n, Nat.add(4n+e, BW.CWr(b))) == True{} : Bool}, F.nat__lt_zero_absurd(e, hj))

# At byte j, bit b of word 8 Q + i of the storage (the last chunk Q).
law hzd:
  for +j: Nat
  for +b: Nat
  for +i: Nat
  for +S: List<&2, U32>
  for +Q: Nat
  for +hj: {Nat.is_lt(j, 4n) == True{} : Bool}
  for +hb: {Nat.is_lt(b, 8n) == True{} : Bool}
  for +hi: {Nat.is_lt(i, 8n) == True{} : Bool}
  for +hz: {BK.zw(Nat.add(VS.x8(j), b), MR.wd(S, Nat.add(O.e8(Nat.add(Q, 0n)), i))) == True{} : Bool}
  for +hp: {WS.bdrop(Nat.add(A.quad(i), Nat.add(j, BW.CWr(b))), WS.cb(S, Nat.add(Q, 0n))) == SP.zero_bytes(Nat.sub(32n, Nat.add(A.quad(i), Nat.add(j, BW.CWr(b))))) : +List<U32>}
  {DL.HZ(Nat.add(VS.x8(j), b), MR.wd(S, Nat.add(O.e8(Nat.add(Q, 0n)), i))) == True{} : Bool}
def hzd(j, b, i, S, Q, hj, hb, hi, hz, hp):
  match j b i:
    case 0n 0n 0n:
      {==}
    case 0n 0n 1n:
      {==}
    case 0n 0n 2n:
      {==}
    case 0n 0n 3n:
      {==}
    case 0n 0n 4n:
      {==}
    case 0n 0n 5n:
      {==}
    case 0n 0n 6n:
      {==}
    case 0n 0n 7n:
      {==}
    case 0n 0n 8n+ +e: Empty.absurd({DL.HZ(Nat.add(VS.x8(0n), 0n), MR.wd(S, Nat.add(O.e8(Nat.add(Q, 0n)), 8n+e))) == True{} : Bool}, F.nat__lt_zero_absurd(e, hi))
    case 0n 1n 0n:
      hzp1(MR.wd(S, Nat.add(O.e8(Nat.add(Q, 0n)), 0n)), hz, padw1(S, Q, hp))
    case 0n 1n 1n:
      hzp1(MR.wd(S, Nat.add(O.e8(Nat.add(Q, 0n)), 1n)), hz, padw5(S, Q, hp))
    case 0n 1n 2n:
      hzp1(MR.wd(S, Nat.add(O.e8(Nat.add(Q, 0n)), 2n)), hz, padw9(S, Q, hp))
    case 0n 1n 3n:
      hzp1(MR.wd(S, Nat.add(O.e8(Nat.add(Q, 0n)), 3n)), hz, padw13(S, Q, hp))
    case 0n 1n 4n:
      hzp1(MR.wd(S, Nat.add(O.e8(Nat.add(Q, 0n)), 4n)), hz, padw17(S, Q, hp))
    case 0n 1n 5n:
      hzp1(MR.wd(S, Nat.add(O.e8(Nat.add(Q, 0n)), 5n)), hz, padw21(S, Q, hp))
    case 0n 1n 6n:
      hzp1(MR.wd(S, Nat.add(O.e8(Nat.add(Q, 0n)), 6n)), hz, padw25(S, Q, hp))
    case 0n 1n 7n:
      hzp1(MR.wd(S, Nat.add(O.e8(Nat.add(Q, 0n)), 7n)), hz, padw29(S, Q, hp))
    case 0n 1n 8n+ +e: Empty.absurd({DL.HZ(Nat.add(VS.x8(0n), 1n), MR.wd(S, Nat.add(O.e8(Nat.add(Q, 0n)), 8n+e))) == True{} : Bool}, F.nat__lt_zero_absurd(e, hi))
    case 0n 2n 0n:
      hzp2(MR.wd(S, Nat.add(O.e8(Nat.add(Q, 0n)), 0n)), hz, padw1(S, Q, hp))
    case 0n 2n 1n:
      hzp2(MR.wd(S, Nat.add(O.e8(Nat.add(Q, 0n)), 1n)), hz, padw5(S, Q, hp))
    case 0n 2n 2n:
      hzp2(MR.wd(S, Nat.add(O.e8(Nat.add(Q, 0n)), 2n)), hz, padw9(S, Q, hp))
    case 0n 2n 3n:
      hzp2(MR.wd(S, Nat.add(O.e8(Nat.add(Q, 0n)), 3n)), hz, padw13(S, Q, hp))
    case 0n 2n 4n:
      hzp2(MR.wd(S, Nat.add(O.e8(Nat.add(Q, 0n)), 4n)), hz, padw17(S, Q, hp))
    case 0n 2n 5n:
      hzp2(MR.wd(S, Nat.add(O.e8(Nat.add(Q, 0n)), 5n)), hz, padw21(S, Q, hp))
    case 0n 2n 6n:
      hzp2(MR.wd(S, Nat.add(O.e8(Nat.add(Q, 0n)), 6n)), hz, padw25(S, Q, hp))
    case 0n 2n 7n:
      hzp2(MR.wd(S, Nat.add(O.e8(Nat.add(Q, 0n)), 7n)), hz, padw29(S, Q, hp))
    case 0n 2n 8n+ +e: Empty.absurd({DL.HZ(Nat.add(VS.x8(0n), 2n), MR.wd(S, Nat.add(O.e8(Nat.add(Q, 0n)), 8n+e))) == True{} : Bool}, F.nat__lt_zero_absurd(e, hi))
