law hzp19:
  for +x: U32
  for +hz: {BK.zw(19n, x) == True{} : Bool}
  for +hp: {WS.bdrop(3n, I.limb(x)) == SP.zero_bytes(1n) : +List<U32>}
  {BW.hzw(19n, x) == True{} : Bool}
