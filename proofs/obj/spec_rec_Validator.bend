# every size other than 121 is refused
def Validator_spec_reject(buf: B.Buf, +m: U32, e: {U32.is_eq(m, 121) == False{} : Bool})
    -> {FuluValidator_r.Validator_decode(buf, m) == (buf, None{}) : B.Buf & Maybe<&1, FuluValidator_d.Validator>}:
  %Equal.sym(Bool, U32.is_eq(m, 121), False{}, e) : {FuluValidator_r.Validator_built(m, FuluValidator_r.Validator_ok_len(_, buf, 0)) == (buf, None{}) : B.Buf & Maybe<&1, FuluValidator_d.Validator>}
  {==}
