# the spec relates exactly those bytes to the value of the object the decoder returns
def Validator_spec_decoded(+w0: U32, +w1: U32, +w2: U32, +w3: U32, +w4: U32, +w5: U32, +w6: U32, +w7: U32, +w8: U32, +w9: U32, +w10: U32, +w11: U32, +w12: U32, +w13: U32, +w14: U32, +w15: U32, +w16: U32, +w17: U32, +w18: U32, +w19: U32, +w20: U32, +w21: U32, +w22: U32, +w23: U32, +w24: U32, +w25: U32, +w26: U32, +w27: U32, +w28: U32, +w29: U32, +w30: U32, +w31: U32, +h: {U32.is_le(B.byte_sel(0, w22), 1) == True{} : Bool})
    -> Decoding.decodes(Spec.Validator(), List.append(&2, U32, F.limbs([w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11, w12, w13, w14, w15, w16, w17, w18, w19, w20, w21, w22, w23, w24, w25, w26, w27, w28, w29]), [B.byte_sel(0, w30)]), S.Sequence{S.Items{S.BytesValue{F.limbs([w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11])}, S.Items{S.BytesValue{F.limbs([w12, w13, w14, w15, w16, w17, w18, w19])}, S.Items{S.UnsignedValue{P.UInt{w20, w21, 0, 0, 0, 0, 0, 0}}, S.Items{S.BooleanValue{U32.is_eq(B.byte_sel(0, w22), 1)}, S.Items{S.UnsignedValue{P.UInt{B.join_sel(1, w22, w23), B.join_sel(1, w23, w24), 0, 0, 0, 0, 0, 0}}, S.Items{S.UnsignedValue{P.UInt{B.join_sel(1, w24, w25), B.join_sel(1, w25, w26), 0, 0, 0, 0, 0, 0}}, S.Items{S.UnsignedValue{P.UInt{B.join_sel(1, w26, w27), B.join_sel(1, w27, w28), 0, 0, 0, 0, 0, 0}}, S.Items{S.UnsignedValue{P.UInt{B.join_sel(1, w28, w29), B.join_sel(1, w29, w30), 0, 0, 0, 0, 0, 0}}, S.EmptyItems{}}}}}}}}}}):
  +eq = Validator_bytes_eq(w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11, w12, w13, w14, w15, w16, w17, w18, w19, w20, w21, w22, w23, w24, w25, w26, w27, w28, w29, w30, w31, h)
  FD.logic__subst(+List<U32>, z => Decoding.decodes(Spec.Validator(), z, S.Sequence{S.Items{S.BytesValue{F.limbs([w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11])}, S.Items{S.BytesValue{F.limbs([w12, w13, w14, w15, w16, w17, w18, w19])}, S.Items{S.UnsignedValue{P.UInt{w20, w21, 0, 0, 0, 0, 0, 0}}, S.Items{S.BooleanValue{U32.is_eq(B.byte_sel(0, w22), 1)}, S.Items{S.UnsignedValue{P.UInt{B.join_sel(1, w22, w23), B.join_sel(1, w23, w24), 0, 0, 0, 0, 0, 0}}, S.Items{S.UnsignedValue{P.UInt{B.join_sel(1, w24, w25), B.join_sel(1, w25, w26), 0, 0, 0, 0, 0, 0}}, S.Items{S.UnsignedValue{P.UInt{B.join_sel(1, w26, w27), B.join_sel(1, w27, w28), 0, 0, 0, 0, 0, 0}}, S.Items{S.UnsignedValue{P.UInt{B.join_sel(1, w28, w29), B.join_sel(1, w29, w30), 0, 0, 0, 0, 0, 0}}, S.EmptyItems{}}}}}}}}}}), List.append(&2, U32, F.limbs([w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11, w12, w13, w14, w15, w16, w17, w18, w19, w20, w21]), List.append(&2, U32, SP.boolean_encoding(U32.is_eq(B.byte_sel(0, w22), 1)), F.limbs([B.join_sel(1, w22, w23), B.join_sel(1, w23, w24), B.join_sel(1, w24, w25), B.join_sel(1, w25, w26), B.join_sel(1, w26, w27), B.join_sel(1, w27, w28), B.join_sel(1, w28, w29), B.join_sel(1, w29, w30)]))), List.append(&2, U32, F.limbs([w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11, w12, w13, w14, w15, w16, w17, w18, w19, w20, w21, w22, w23, w24, w25, w26, w27, w28, w29]), [B.byte_sel(0, w30)]), eq,
    Validator_spec_encode(w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11, w12, w13, w14, w15, w16, w17, w18, w19, w20, w21, U32.is_eq(B.byte_sel(0, w22), 1), B.join_sel(1, w22, w23), B.join_sel(1, w23, w24), B.join_sel(1, w24, w25), B.join_sel(1, w25, w26), B.join_sel(1, w26, w27), B.join_sel(1, w27, w28), B.join_sel(1, w28, w29), B.join_sel(1, w29, w30)))

# every size other than 121 is refused
def Validator_spec_reject(buf: B.Buf, +m: U32, e: {U32.is_eq(m, 121) == False{} : Bool})
    -> {T.Validator_decode(buf, m) == (buf, None{}) : B.Buf & Maybe<&1, T.Validator>}:
  %Equal.sym(Bool, U32.is_eq(m, 121), False{}, e) : {T.Validator_built(m, T.Validator_ok_len(_, buf, 0)) == (buf, None{}) : B.Buf & Maybe<&1, T.Validator>}
  {==}
