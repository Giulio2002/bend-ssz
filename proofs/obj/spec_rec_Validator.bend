# the limbs of a joined word: bytes 1..3 of lo, byte 0 of hi
def Validator_lj(+lo: U32, +hi: U32, +rest: +List<U32>)
    -> {F.limbs(Con{B.join_sel(1, lo, hi), rest}) == Con{B.byte_sel(1, lo), Con{B.byte_sel(2, lo), Con{B.byte_sel(3, lo), Con{B.byte_sel(0, hi), F.limbs(rest)}}}} : +List<U32>}:
  %Equal.sym(U32, B.byte_sel(0, B.join_sel(1, lo, hi)), B.byte_sel(1, lo), Validator_jb0(lo, hi)) :
    {Con{_, Con{B.byte_sel(1, B.join_sel(1, lo, hi)), Con{B.byte_sel(2, B.join_sel(1, lo, hi)), Con{B.byte_sel(3, B.join_sel(1, lo, hi)), F.limbs(rest)}}}} == Con{B.byte_sel(1, lo), Con{B.byte_sel(2, lo), Con{B.byte_sel(3, lo), Con{B.byte_sel(0, hi), F.limbs(rest)}}}} : +List<U32>}
  %Equal.sym(U32, B.byte_sel(1, B.join_sel(1, lo, hi)), B.byte_sel(2, lo), Validator_jb1(lo, hi)) :
    {Con{B.byte_sel(1, lo), Con{_, Con{B.byte_sel(2, B.join_sel(1, lo, hi)), Con{B.byte_sel(3, B.join_sel(1, lo, hi)), F.limbs(rest)}}}} == Con{B.byte_sel(1, lo), Con{B.byte_sel(2, lo), Con{B.byte_sel(3, lo), Con{B.byte_sel(0, hi), F.limbs(rest)}}}} : +List<U32>}
  %Equal.sym(U32, B.byte_sel(2, B.join_sel(1, lo, hi)), B.byte_sel(3, lo), Validator_jb2(lo, hi)) :
    {Con{B.byte_sel(1, lo), Con{B.byte_sel(2, lo), Con{_, Con{B.byte_sel(3, B.join_sel(1, lo, hi)), F.limbs(rest)}}}} == Con{B.byte_sel(1, lo), Con{B.byte_sel(2, lo), Con{B.byte_sel(3, lo), Con{B.byte_sel(0, hi), F.limbs(rest)}}}} : +List<U32>}
  %Equal.sym(U32, B.byte_sel(3, B.join_sel(1, lo, hi)), B.byte_sel(0, hi), Validator_jb3(lo, hi)) :
    {Con{B.byte_sel(1, lo), Con{B.byte_sel(2, lo), Con{B.byte_sel(3, lo), Con{_, F.limbs(rest)}}}} == Con{B.byte_sel(1, lo), Con{B.byte_sel(2, lo), Con{B.byte_sel(3, lo), Con{B.byte_sel(0, hi), F.limbs(rest)}}}} : +List<U32>}
  {==}

# a word the decoder accepts as a boolean (at most 1) is the byte of that boolean
def Validator_bb_go(+x: U32, +n: Nat, +en: {U32.to_nat(x) == n : Nat}, +h: {Cmp.is_le(Nat.cmp(n, 1n)) == True{} : Bool})
    -> {SP.boolean_encoding(U32.is_eq(x, 1)) == [x] : +List<U32>}:
  match n:
    case 0n: FD.logic__subst(U32, z => {SP.boolean_encoding(U32.is_eq(z, 1)) == [z] : +List<U32>}, 0, x, Equal.sym(U32, x, 0, FD.u32__injective(x, 0, en)), {==})
    case 1n: FD.logic__subst(U32, z => {SP.boolean_encoding(U32.is_eq(z, 1)) == [z] : +List<U32>}, 1, x, Equal.sym(U32, x, 1, FD.u32__injective(x, 1, en)), {==})
    case 2n+m: Empty.absurd({SP.boolean_encoding(U32.is_eq(x, 1)) == [x] : +List<U32>}, FD.logic__false_true(h))

def Validator_bool_byte(+x: U32, +h: {U32.is_le(x, 1) == True{} : Bool}) -> {SP.boolean_encoding(U32.is_eq(x, 1)) == [x] : +List<U32>}:
  Validator_bb_go(x, U32.to_nat(x), {==}, FD.logic__subst(Cmp, c => {Cmp.is_le(c) == True{} : Bool}, U32.cmp(x, 1), Nat.cmp(U32.to_nat(x), 1n), FD.u32__u32_cmp(x, 1), h))

# decoding a buffer of 121 bytes whose byte 88 is at most 1 accepts: the object of
# words 0..21, that boolean, and the four epochs read across words 22..30
def Validator_spec_decode(+w0: U32, +w1: U32, +w2: U32, +w3: U32, +w4: U32, +w5: U32, +w6: U32, +w7: U32, +w8: U32, +w9: U32, +w10: U32, +w11: U32, +w12: U32, +w13: U32, +w14: U32, +w15: U32, +w16: U32, +w17: U32, +w18: U32, +w19: U32, +w20: U32, +w21: U32, +w22: U32, +w23: U32, +w24: U32, +w25: U32, +w26: U32, +w27: U32, +w28: U32, +w29: U32, +w30: U32, +w31: U32, +h: {U32.is_le(B.byte_sel(0, w22), 1) == True{} : Bool})
