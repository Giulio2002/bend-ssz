  AS.agg(cw1(ws), AS.unsome(SSC.times(k, SSC.fixed_size(S.Unsigned{P.U32Width{}}))), N, hN2, hf)

def m2(k: Nat) -> Nat:
  match k:
    case 0n: 0n
    case 1n+q: 2n+m2(q)

def cw2(ws: List<&2, U32>) -> +List<+List<U32>>:
  match ws:
    case Nil{}: []
    case Con{w0, r0}:
      match r0:
        case Nil{}: []
        case Con{w1, r}: Con{[w0, w1], cw2(r)}

def flt2_z(+ws: List<&2, U32>, +hl: {F.spec_common__length(U32, ws) == 0n : Nat}) -> {SF.flat(cw2(ws)) == SF.limbs(ws) : +List<U32>}:
  match ws:
    case Nil{}: {==}
    case Con{x, t}: Empty.absurd({SF.flat(cw2(Con{x, t})) == SF.limbs(Con{x, t}) : +List<U32>}, F.nat__succ_zero(F.spec_common__length(U32, t), hl))

def flt2_s(+q: Nat, +ws: List<&2, U32>, +hl: {F.spec_common__length(U32, ws) == 2n+m2(q) : Nat},
    ih: @+r: List<&2, U32> -> @+hr: {F.spec_common__length(U32, r) == m2(q) : Nat} -> {SF.flat(cw2(r)) == SF.limbs(r) : +List<U32>}) -> {SF.flat(cw2(ws)) == SF.limbs(ws) : +List<U32>}:
  match ws:
    case Nil{}: Empty.absurd({SF.flat(cw2(Nil{})) == SF.limbs(Nil{}) : +List<U32>}, F.nat__zero_succ(1n+m2(q), peel(0n, 0n, 2n+m2(q), hl)))
    case Con{+w0, +r0}:
      match r0:
        case Nil{}: Empty.absurd({SF.flat(cw2(Con{w0, Nil{}})) == SF.limbs(Con{w0, Nil{}}) : +List<U32>}, F.nat__zero_succ(0n+m2(q), peel(1n, 0n, 1n+m2(q), hl)))
        case Con{+w1, +r}:
          Equal.cong(+List<U32>, +List<U32>, z => List.append(&2, U32, SF.limbs([w0, w1]), z), SF.flat(cw2(r)), SF.limbs(r), ih(r, peel(2n, F.spec_common__length(U32, r), m2(q), hl)))

law flt2:
  for +k: Nat
  for +ws: List<&2, U32>
  for +hl: {F.spec_common__length(U32, ws) == m2(k) : Nat}
  {SF.flat(cw2(ws)) == SF.limbs(ws) : +List<U32>}
def flt2(k, ws, hl):
  match k:
    case 0n: flt2_z(ws, hl)
    case 1n+ +q: flt2_s(q, ws, hl, r => hr => flt2(q, r, hr))

def fsz2_z(+ws: List<&2, U32>, +hl: {F.spec_common__length(U32, ws) == 0n : Nat}) -> {Layout.fixed_size(SF.fparts(cw2(ws))) == SF.wlen(ws) : Nat}:
  match ws:
    case Nil{}: {==}
    case Con{x, t}: Empty.absurd({Layout.fixed_size(SF.fparts(cw2(Con{x, t}))) == SF.wlen(Con{x, t}) : Nat}, F.nat__succ_zero(F.spec_common__length(U32, t), hl))

def fsz2_s(+q: Nat, +ws: List<&2, U32>, +hl: {F.spec_common__length(U32, ws) == 2n+m2(q) : Nat},
    ih: @+r: List<&2, U32> -> @+hr: {F.spec_common__length(U32, r) == m2(q) : Nat} -> {Layout.fixed_size(SF.fparts(cw2(r))) == SF.wlen(r) : Nat}) -> {Layout.fixed_size(SF.fparts(cw2(ws))) == SF.wlen(ws) : Nat}:
  match ws:
    case Nil{}: Empty.absurd({Layout.fixed_size(SF.fparts(cw2(Nil{}))) == SF.wlen(Nil{}) : Nat}, F.nat__zero_succ(1n+m2(q), peel(0n, 0n, 2n+m2(q), hl)))
    case Con{+w0, +r0}:
      match r0:
        case Nil{}: Empty.absurd({Layout.fixed_size(SF.fparts(cw2(Con{w0, Nil{}}))) == SF.wlen(Con{w0, Nil{}}) : Nat}, F.nat__zero_succ(0n+m2(q), peel(1n, 0n, 1n+m2(q), hl)))
        case Con{+w1, +r}:
          Equal.cong(Nat, Nat, z => Nat.add(8n, z), Layout.fixed_size(SF.fparts(cw2(r))), SF.wlen(r), ih(r, peel(2n, F.spec_common__length(U32, r), m2(q), hl)))

law fsz2:
  for +k: Nat
  for +ws: List<&2, U32>
  for +hl: {F.spec_common__length(U32, ws) == m2(k) : Nat}
  {Layout.fixed_size(SF.fparts(cw2(ws))) == SF.wlen(ws) : Nat}
def fsz2(k, ws, hl):
  match k:
    case 0n: fsz2_z(ws, hl)
    case 1n+ +q: fsz2_s(q, ws, hl, r => hr => fsz2(q, r, hr))

def chu2(ws: List<&2, U32>) -> S.Value:
  match ws:
    case Nil{}: S.EmptyItems{}
    case Con{w0, r0}:
      match r0:
        case Nil{}: S.EmptyItems{}
        case Con{w1, r}: S.Items{S.UnsignedValue{P.UInt{w0, w1, 0, 0, 0, 0, 0, 0}}, chu2(r)}

def cnt_chu2_z(+ws: List<&2, U32>, +hl: {F.spec_common__length(U32, ws) == 0n : Nat}) -> {Codec.count(chu2(ws)) == 0n : Nat}:
  match ws:
    case Nil{}: {==}
    case Con{x, t}: Empty.absurd({Codec.count(chu2(Con{x, t})) == 0n : Nat}, F.nat__succ_zero(F.spec_common__length(U32, t), hl))

def cnt_chu2_s(+q: Nat, +ws: List<&2, U32>, +hl: {F.spec_common__length(U32, ws) == 2n+m2(q) : Nat},
    ih: @+r: List<&2, U32> -> @+hr: {F.spec_common__length(U32, r) == m2(q) : Nat} -> {Codec.count(chu2(r)) == q : Nat}) -> {Codec.count(chu2(ws)) == 1n+q : Nat}:
  match ws:
    case Nil{}: Empty.absurd({Codec.count(chu2(Nil{})) == 1n+q : Nat}, F.nat__zero_succ(1n+m2(q), peel(0n, 0n, 2n+m2(q), hl)))
    case Con{+w0, +r0}:
      match r0:
        case Nil{}: Empty.absurd({Codec.count(chu2(Con{w0, Nil{}})) == 1n+q : Nat}, F.nat__zero_succ(0n+m2(q), peel(1n, 0n, 1n+m2(q), hl)))
        case Con{+w1, +r}:
          F.nat__succ_cong(Codec.count(chu2(r)), q, ih(r, peel(2n, F.spec_common__length(U32, r), m2(q), hl)))

law cnt_chu2:
  for +k: Nat
  for +ws: List<&2, U32>
  for +hl: {F.spec_common__length(U32, ws) == m2(k) : Nat}
  {Codec.count(chu2(ws)) == k : Nat}
def cnt_chu2(k, ws, hl):
  match k:
