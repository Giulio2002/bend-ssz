    case Con{+w0, +r}:
      %Equal.sym(S.Value, chu1(Con{w0, r}), S.Items{S.UnsignedValue{P.UInt{w0, 0, 0, 0, 0, 0, 0, 0}}, chu1(r)}, cc_chu1(w0, r)) :
