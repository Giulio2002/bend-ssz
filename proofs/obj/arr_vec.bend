    case Con{+w0, +r0}:
      match r0:
        case Nil{}: Empty.absurd({Codec.parts(chu4(Con{w0, Nil{}}), S.Repeat{S.Unsigned{P.U128{}}}) == Some{SF.fparts(cw4(Con{w0, Nil{}}))} : Maybe<&2, +List<S.Part>>}, F.nat__zero_succ(2n+m4(q), peel(1n, 0n, 3n+m4(q), hl)))
        case Con{+w1, +r1}:
          match r1:
            case Nil{}: Empty.absurd({Codec.parts(chu4(Con{w0, Con{w1, Nil{}}}), S.Repeat{S.Unsigned{P.U128{}}}) == Some{SF.fparts(cw4(Con{w0, Con{w1, Nil{}}}))} : Maybe<&2, +List<S.Part>>}, F.nat__zero_succ(1n+m4(q), peel(2n, 0n, 2n+m4(q), hl)))
            case Con{+w2, +r2}:
