    case Nil{}: Empty.absurd({Codec.parts(ch12(Nil{}), S.Repeat{S.ByteVector{48n}}) == Some{SF.fparts(cw12(Nil{}))} : Maybe<&2, +List<S.Part>>}, F.nat__zero_succ(11n+m12(q), peel(0n, 0n, 12n+m12(q), hl)))
    case Con{+w0, +r0}:
