law vpartsu1:
  for +s: S.Schema
  for +ws: List<&2, U32>
  for +k: Nat
  for +L: Nat
  for +N: Nat
  for +hs: {SH.is_Vector(s) == True{} : Bool}
  for +he: {SH.Vector_element(s) == S.Unsigned{P.U32Width{}} : S.Schema}
  for +hk: {Nat.is_eq(SH.Vector_length(s), k) == True{} : Bool}
  for +hk0: {Nat.is_lt(0n, k) == True{} : Bool}
  for +hl: {F.spec_common__length(U32, ws) == L : Nat}
  for +hL: {Nat.is_eq(m1(k), L) == True{} : Bool}
  for +hN: {SF.wlen(ws) == N : Nat}
  for +hf: {NB.fits(4n, Nat.add(N, 0n)) == True{} : Bool}
  {Codec.parts(S.Sequence{chu1(ws)}, s) == Some{[S.Fixed{SF.limbs(ws)}]} : Maybe<&2, +List<S.Part>>}
def vpartsu1(s, ws, k, L, N, hs, he, hk, hk0, hl, hL, hN, hf):
  +hl2 = Equal.trans(Nat, F.spec_common__length(U32, ws), L, m1(k), hl, Equal.sym(Nat, m1(k), L, F.nat__eq_from_is_eq(m1(k), L, hL)))
  +ek = F.nat__eq_from_is_eq(SH.Vector_length(s), k, hk)
  +hN2 = Equal.trans(Nat, Layout.fixed_size(SF.fparts(cw1(ws))), SF.wlen(ws), N, fsz1(k, ws, hl2), hN)
  %Equal.sym(S.Schema, s, S.Vector{SH.Vector_element(s), SH.Vector_length(s)}, SH.Vector_shape(s, hs)) :
    {Codec.parts(S.Sequence{chu1(ws)}, _) == Some{[S.Fixed{SF.limbs(ws)}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(S.Schema, SH.Vector_element(s), S.Unsigned{P.U32Width{}}, he) : {Codec.parts(S.Sequence{chu1(ws)}, S.Vector{_, SH.Vector_length(s)}) == Some{[S.Fixed{SF.limbs(ws)}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(Nat, SH.Vector_length(s), k, ek) :
    {Codec.require(Bool.and(Nat.is_lt(0n, _), Nat.is_eq(Codec.count(chu1(ws)), _)), Codec.aggregate(Codec.parts(chu1(ws), S.Repeat{S.Unsigned{P.U32Width{}}}), SSC.times(_, SSC.fixed_size(S.Unsigned{P.U32Width{}})))) == Some{[S.Fixed{SF.limbs(ws)}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(Nat, Codec.count(chu1(ws)), k, cnt_chu1(k, ws, hl2)) :
    {Codec.require(Bool.and(Nat.is_lt(0n, k), Nat.is_eq(_, k)), Codec.aggregate(Codec.parts(chu1(ws), S.Repeat{S.Unsigned{P.U32Width{}}}), SSC.times(k, SSC.fixed_size(S.Unsigned{P.U32Width{}})))) == Some{[S.Fixed{SF.limbs(ws)}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(Bool, Nat.is_lt(0n, k), True{}, hk0) :
    {Codec.require(Bool.and(_, Nat.is_eq(k, k)), Codec.aggregate(Codec.parts(chu1(ws), S.Repeat{S.Unsigned{P.U32Width{}}}), SSC.times(k, SSC.fixed_size(S.Unsigned{P.U32Width{}})))) == Some{[S.Fixed{SF.limbs(ws)}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(Bool, Nat.is_eq(k, k), True{}, F.nat__is_eq_refl(k)) :
    {Codec.require(Bool.and(True{}, _), Codec.aggregate(Codec.parts(chu1(ws), S.Repeat{S.Unsigned{P.U32Width{}}}), SSC.times(k, SSC.fixed_size(S.Unsigned{P.U32Width{}})))) == Some{[S.Fixed{SF.limbs(ws)}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(Maybe<&2, +List<S.Part>>, Codec.parts(chu1(ws), S.Repeat{S.Unsigned{P.U32Width{}}}), Some{SF.fparts(cw1(ws))}, prt_chu1(k, ws, hl2)) :
    {Codec.require(Bool.and(True{}, True{}), Codec.aggregate(_, SSC.times(k, SSC.fixed_size(S.Unsigned{P.U32Width{}})))) == Some{[S.Fixed{SF.limbs(ws)}]} : Maybe<&2, +List<S.Part>>}
  %flt1(k, ws, hl2) :
