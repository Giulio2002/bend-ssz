    case Con{x, t}: Empty.absurd({Codec.count(chu8(Con{x, t})) == 0n : Nat}, F.nat__succ_zero(F.spec_common__length(U32, t), hl))

def cnt_chu8_s(+q: Nat, +ws: List<&2, U32>, +hl: {F.spec_common__length(U32, ws) == 8n+m8(q) : Nat},
    ih: @+r: List<&2, U32> -> @+hr: {F.spec_common__length(U32, r) == m8(q) : Nat} -> {Codec.count(chu8(r)) == q : Nat}) -> {Codec.count(chu8(ws)) == 1n+q : Nat}:
