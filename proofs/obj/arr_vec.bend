def cc_chu4(+w0: U32, +w1: U32, +w2: U32, +w3: U32, +r: List<&2, U32>) -> {chu4(Con{w0, Con{w1, Con{w2, Con{w3, r}}}}) == S.Items{S.UnsignedValue{P.UInt{w0, w1, w2, w3, 0, 0, 0, 0}}, chu4(r)} : S.Value}: {==}

