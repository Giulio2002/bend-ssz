    case 1n+ +q: prt_ch12_s(q, ws, hl, r => hr => prt_ch12(q, r, hr))

law vparts12:
  for +s: S.Schema
  for +ws: List<&2, U32>
  for +k: Nat
  for +L: Nat
  for +N: Nat
  for +hs: {SH.is_Vector(s) == True{} : Bool}
  for +he: {SH.Vector_element(s) == S.ByteVector{48n} : S.Schema}
  for +hk: {Nat.is_eq(SH.Vector_length(s), k) == True{} : Bool}
  for +hk0: {Nat.is_lt(0n, k) == True{} : Bool}
  for +hl: {F.spec_common__length(U32, ws) == L : Nat}
  for +hL: {Nat.is_eq(m12(k), L) == True{} : Bool}
  for +hN: {SF.wlen(ws) == N : Nat}
  for +hf: {NB.fits(4n, Nat.add(N, 0n)) == True{} : Bool}
  {Codec.parts(S.Sequence{ch12(ws)}, s) == Some{[S.Fixed{SF.limbs(ws)}]} : Maybe<&2, +List<S.Part>>}
def vparts12(s, ws, k, L, N, hs, he, hk, hk0, hl, hL, hN, hf):
  +hl2 = Equal.trans(Nat, F.spec_common__length(U32, ws), L, m12(k), hl, Equal.sym(Nat, m12(k), L, F.nat__eq_from_is_eq(m12(k), L, hL)))
  +ek = F.nat__eq_from_is_eq(SH.Vector_length(s), k, hk)
  +hN2 = Equal.trans(Nat, Layout.fixed_size(SF.fparts(cw12(ws))), SF.wlen(ws), N, fsz12(k, ws, hl2), hN)
  %Equal.sym(S.Schema, s, S.Vector{SH.Vector_element(s), SH.Vector_length(s)}, SH.Vector_shape(s, hs)) :
    {Codec.parts(S.Sequence{ch12(ws)}, _) == Some{[S.Fixed{SF.limbs(ws)}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(S.Schema, SH.Vector_element(s), S.ByteVector{48n}, he) : {Codec.parts(S.Sequence{ch12(ws)}, S.Vector{_, SH.Vector_length(s)}) == Some{[S.Fixed{SF.limbs(ws)}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(Nat, SH.Vector_length(s), k, ek) :
    {Codec.require(Bool.and(Nat.is_lt(0n, _), Nat.is_eq(Codec.count(ch12(ws)), _)), Codec.aggregate(Codec.parts(ch12(ws), S.Repeat{S.ByteVector{48n}}), SSC.times(_, SSC.fixed_size(S.ByteVector{48n})))) == Some{[S.Fixed{SF.limbs(ws)}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(Nat, Codec.count(ch12(ws)), k, cnt_ch12(k, ws, hl2)) :
    {Codec.require(Bool.and(Nat.is_lt(0n, k), Nat.is_eq(_, k)), Codec.aggregate(Codec.parts(ch12(ws), S.Repeat{S.ByteVector{48n}}), SSC.times(k, SSC.fixed_size(S.ByteVector{48n})))) == Some{[S.Fixed{SF.limbs(ws)}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(Bool, Nat.is_lt(0n, k), True{}, hk0) :
    {Codec.require(Bool.and(_, Nat.is_eq(k, k)), Codec.aggregate(Codec.parts(ch12(ws), S.Repeat{S.ByteVector{48n}}), SSC.times(k, SSC.fixed_size(S.ByteVector{48n})))) == Some{[S.Fixed{SF.limbs(ws)}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(Bool, Nat.is_eq(k, k), True{}, F.nat__is_eq_refl(k)) :
    {Codec.require(Bool.and(True{}, _), Codec.aggregate(Codec.parts(ch12(ws), S.Repeat{S.ByteVector{48n}}), SSC.times(k, SSC.fixed_size(S.ByteVector{48n})))) == Some{[S.Fixed{SF.limbs(ws)}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(Maybe<&2, +List<S.Part>>, Codec.parts(ch12(ws), S.Repeat{S.ByteVector{48n}}), Some{SF.fparts(cw12(ws))}, prt_ch12(k, ws, hl2)) :
    {Codec.require(Bool.and(True{}, True{}), Codec.aggregate(_, SSC.times(k, SSC.fixed_size(S.ByteVector{48n})))) == Some{[S.Fixed{SF.limbs(ws)}]} : Maybe<&2, +List<S.Part>>}
  %flt12(k, ws, hl2) :
    {Codec.aggregate(Some{SF.fparts(cw12(ws))}, SSC.times(k, SSC.fixed_size(S.ByteVector{48n}))) == Some{[S.Fixed{_}]} : Maybe<&2, +List<S.Part>>}
  AS.agg(cw12(ws), AS.unsome(SSC.times(k, SSC.fixed_size(S.ByteVector{48n}))), N, hN2, hf)

def m1(k: Nat) -> Nat:
  match k:
    case 0n: 0n
    case 1n+q: 1n+m1(q)

def cw1(ws: List<&2, U32>) -> +List<+List<U32>>:
  match ws:
    case Nil{}: []
    case Con{w0, r}: Con{[w0], cw1(r)}

def flt1_z(+ws: List<&2, U32>, +hl: {F.spec_common__length(U32, ws) == 0n : Nat}) -> {SF.flat(cw1(ws)) == SF.limbs(ws) : +List<U32>}:
  match ws:
    case Nil{}: {==}
    case Con{x, t}: Empty.absurd({SF.flat(cw1(Con{x, t})) == SF.limbs(Con{x, t}) : +List<U32>}, F.nat__succ_zero(F.spec_common__length(U32, t), hl))

def flt1_s(+q: Nat, +ws: List<&2, U32>, +hl: {F.spec_common__length(U32, ws) == 1n+m1(q) : Nat},
    ih: @+r: List<&2, U32> -> @+hr: {F.spec_common__length(U32, r) == m1(q) : Nat} -> {SF.flat(cw1(r)) == SF.limbs(r) : +List<U32>}) -> {SF.flat(cw1(ws)) == SF.limbs(ws) : +List<U32>}:
  match ws:
    case Nil{}: Empty.absurd({SF.flat(cw1(Nil{})) == SF.limbs(Nil{}) : +List<U32>}, F.nat__zero_succ(0n+m1(q), peel(0n, 0n, 1n+m1(q), hl)))
    case Con{+w0, +r}:
      Equal.cong(+List<U32>, +List<U32>, z => List.append(&2, U32, SF.limbs([w0]), z), SF.flat(cw1(r)), SF.limbs(r), ih(r, peel(1n, F.spec_common__length(U32, r), m1(q), hl)))

law flt1:
  for +k: Nat
  for +ws: List<&2, U32>
  for +hl: {F.spec_common__length(U32, ws) == m1(k) : Nat}
  {SF.flat(cw1(ws)) == SF.limbs(ws) : +List<U32>}
def flt1(k, ws, hl):
  match k:
    case 0n: flt1_z(ws, hl)
    case 1n+ +q: flt1_s(q, ws, hl, r => hr => flt1(q, r, hr))

def fsz1_z(+ws: List<&2, U32>, +hl: {F.spec_common__length(U32, ws) == 0n : Nat}) -> {Layout.fixed_size(SF.fparts(cw1(ws))) == SF.wlen(ws) : Nat}:
  match ws:
    case Nil{}: {==}
    case Con{x, t}: Empty.absurd({Layout.fixed_size(SF.fparts(cw1(Con{x, t}))) == SF.wlen(Con{x, t}) : Nat}, F.nat__succ_zero(F.spec_common__length(U32, t), hl))

def fsz1_s(+q: Nat, +ws: List<&2, U32>, +hl: {F.spec_common__length(U32, ws) == 1n+m1(q) : Nat},
    ih: @+r: List<&2, U32> -> @+hr: {F.spec_common__length(U32, r) == m1(q) : Nat} -> {Layout.fixed_size(SF.fparts(cw1(r))) == SF.wlen(r) : Nat}) -> {Layout.fixed_size(SF.fparts(cw1(ws))) == SF.wlen(ws) : Nat}:
  match ws:
    case Nil{}: Empty.absurd({Layout.fixed_size(SF.fparts(cw1(Nil{}))) == SF.wlen(Nil{}) : Nat}, F.nat__zero_succ(0n+m1(q), peel(0n, 0n, 1n+m1(q), hl)))
    case Con{+w0, +r}:
      Equal.cong(Nat, Nat, z => Nat.add(4n, z), Layout.fixed_size(SF.fparts(cw1(r))), SF.wlen(r), ih(r, peel(1n, F.spec_common__length(U32, r), m1(q), hl)))

law fsz1:
  for +k: Nat
  for +ws: List<&2, U32>
  for +hl: {F.spec_common__length(U32, ws) == m1(k) : Nat}
  {Layout.fixed_size(SF.fparts(cw1(ws))) == SF.wlen(ws) : Nat}
def fsz1(k, ws, hl):
  match k:
    case 0n: fsz1_z(ws, hl)
    case 1n+ +q: fsz1_s(q, ws, hl, r => hr => fsz1(q, r, hr))

def chu1(ws: List<&2, U32>) -> S.Value:
  match ws:
    case Nil{}: S.EmptyItems{}
    case Con{w0, r}: S.Items{S.UnsignedValue{P.UInt{w0, 0, 0, 0, 0, 0, 0, 0}}, chu1(r)}

def cnt_chu1_z(+ws: List<&2, U32>, +hl: {F.spec_common__length(U32, ws) == 0n : Nat}) -> {Codec.count(chu1(ws)) == 0n : Nat}:
  match ws:
    case Nil{}: {==}
    case Con{x, t}: Empty.absurd({Codec.count(chu1(Con{x, t})) == 0n : Nat}, F.nat__succ_zero(F.spec_common__length(U32, t), hl))

def cnt_chu1_s(+q: Nat, +ws: List<&2, U32>, +hl: {F.spec_common__length(U32, ws) == 1n+m1(q) : Nat},
    ih: @+r: List<&2, U32> -> @+hr: {F.spec_common__length(U32, r) == m1(q) : Nat} -> {Codec.count(chu1(r)) == q : Nat}) -> {Codec.count(chu1(ws)) == 1n+q : Nat}:
  match ws:
    case Nil{}: Empty.absurd({Codec.count(chu1(Nil{})) == 1n+q : Nat}, F.nat__zero_succ(0n+m1(q), peel(0n, 0n, 1n+m1(q), hl)))
    case Con{+w0, +r}:
      F.nat__succ_cong(Codec.count(chu1(r)), q, ih(r, peel(1n, F.spec_common__length(U32, r), m1(q), hl)))

law cnt_chu1:
  for +k: Nat
  for +ws: List<&2, U32>
  for +hl: {F.spec_common__length(U32, ws) == m1(k) : Nat}
  {Codec.count(chu1(ws)) == k : Nat}
def cnt_chu1(k, ws, hl):
  match k:
    case 0n: cnt_chu1_z(ws, hl)
    case 1n+ +q: cnt_chu1_s(q, ws, hl, r => hr => cnt_chu1(q, r, hr))

def cc_chu1(+w0: U32, +r: List<&2, U32>) -> {chu1(Con{w0, r}) == S.Items{S.UnsignedValue{P.UInt{w0, 0, 0, 0, 0, 0, 0, 0}}, chu1(r)} : S.Value}: {==}

def prep(+v: S.Value, +rest: S.Value, +s: S.Schema)
    -> {Codec.parts(S.Items{v, rest}, S.Repeat{s}) == Codec.concatenate(Codec.parts(v, s), Codec.parts(rest, S.Repeat{s})) : Maybe<&2, +List<S.Part>>}: {==}

def prt_chu1_z(+ws: List<&2, U32>, +hl: {F.spec_common__length(U32, ws) == 0n : Nat}) -> {Codec.parts(chu1(ws), S.Repeat{S.Unsigned{P.U32Width{}}}) == Some{SF.fparts(cw1(ws))} : Maybe<&2, +List<S.Part>>}:
  match ws:
    case Nil{}: {==}
    case Con{x, t}: Empty.absurd({Codec.parts(chu1(Con{x, t}), S.Repeat{S.Unsigned{P.U32Width{}}}) == Some{SF.fparts(cw1(Con{x, t}))} : Maybe<&2, +List<S.Part>>}, F.nat__succ_zero(F.spec_common__length(U32, t), hl))

def prt_chu1_s(+q: Nat, +ws: List<&2, U32>, +hl: {F.spec_common__length(U32, ws) == 1n+m1(q) : Nat},
    ih: @+r: List<&2, U32> -> @+hr: {F.spec_common__length(U32, r) == m1(q) : Nat} -> {Codec.parts(chu1(r), S.Repeat{S.Unsigned{P.U32Width{}}}) == Some{SF.fparts(cw1(r))} : Maybe<&2, +List<S.Part>>}) -> {Codec.parts(chu1(ws), S.Repeat{S.Unsigned{P.U32Width{}}}) == Some{SF.fparts(cw1(ws))} : Maybe<&2, +List<S.Part>>}:
  match ws:
