def prt_chu4_s(+q: Nat, +ws: List<&2, U32>, +hl: {F.spec_common__length(U32, ws) == 4n+m4(q) : Nat},
    ih: @+r: List<&2, U32> -> @+hr: {F.spec_common__length(U32, r) == m4(q) : Nat} -> {Codec.parts(chu4(r), S.Repeat{S.Unsigned{P.U128{}}}) == Some{SF.fparts(cw4(r))} : Maybe<&2, +List<S.Part>>}) -> {Codec.parts(chu4(ws), S.Repeat{S.Unsigned{P.U128{}}}) == Some{SF.fparts(cw4(ws))} : Maybe<&2, +List<S.Part>>}:
