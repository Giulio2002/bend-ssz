            case Nil{}: Empty.absurd({Codec.count(chu8(Con{w0, Con{w1, Nil{}}})) == 1n+q : Nat}, F.nat__zero_succ(5n+m8(q), peel(2n, 0n, 6n+m8(q), hl)))
            case Con{+w2, +r2}:
              match r2:
                case Nil{}: Empty.absurd({Codec.count(chu8(Con{w0, Con{w1, Con{w2, Nil{}}}})) == 1n+q : Nat}, F.nat__zero_succ(4n+m8(q), peel(3n, 0n, 5n+m8(q), hl)))
                case Con{+w3, +r3}:
                  match r3:
                    case Nil{}: Empty.absurd({Codec.count(chu8(Con{w0, Con{w1, Con{w2, Con{w3, Nil{}}}}})) == 1n+q : Nat}, F.nat__zero_succ(3n+m8(q), peel(4n, 0n, 4n+m8(q), hl)))
                    case Con{+w4, +r4}:
                      match r4:
                        case Nil{}: Empty.absurd({Codec.count(chu8(Con{w0, Con{w1, Con{w2, Con{w3, Con{w4, Nil{}}}}}})) == 1n+q : Nat}, F.nat__zero_succ(2n+m8(q), peel(5n, 0n, 3n+m8(q), hl)))
                        case Con{+w5, +r5}:
                          match r5:
                            case Nil{}: Empty.absurd({Codec.count(chu8(Con{w0, Con{w1, Con{w2, Con{w3, Con{w4, Con{w5, Nil{}}}}}}})) == 1n+q : Nat}, F.nat__zero_succ(1n+m8(q), peel(6n, 0n, 2n+m8(q), hl)))
                            case Con{+w6, +r6}:
                              match r6:
                                case Nil{}: Empty.absurd({Codec.count(chu8(Con{w0, Con{w1, Con{w2, Con{w3, Con{w4, Con{w5, Con{w6, Nil{}}}}}}}})) == 1n+q : Nat}, F.nat__zero_succ(0n+m8(q), peel(7n, 0n, 1n+m8(q), hl)))
                                case Con{+w7, +r}:
                                  F.nat__succ_cong(Codec.count(chu8(r)), q, ih(r, peel(8n, F.spec_common__length(U32, r), m8(q), hl)))

law cnt_chu8:
  for +k: Nat
  for +ws: List<&2, U32>
  for +hl: {F.spec_common__length(U32, ws) == m8(k) : Nat}
  {Codec.count(chu8(ws)) == k : Nat}
def cnt_chu8(k, ws, hl):
  match k:
    case 0n: cnt_chu8_z(ws, hl)
    case 1n+ +q: cnt_chu8_s(q, ws, hl, r => hr => cnt_chu8(q, r, hr))

def cc_chu8(+w0: U32, +w1: U32, +w2: U32, +w3: U32, +w4: U32, +w5: U32, +w6: U32, +w7: U32, +r: List<&2, U32>) -> {chu8(Con{w0, Con{w1, Con{w2, Con{w3, Con{w4, Con{w5, Con{w6, Con{w7, r}}}}}}}}) == S.Items{S.UnsignedValue{P.UInt{w0, w1, w2, w3, w4, w5, w6, w7}}, chu8(r)} : S.Value}: {==}

def prt_chu8_z(+ws: List<&2, U32>, +hl: {F.spec_common__length(U32, ws) == 0n : Nat}) -> {Codec.parts(chu8(ws), S.Repeat{S.Unsigned{P.U256{}}}) == Some{SF.fparts(cw8(ws))} : Maybe<&2, +List<S.Part>>}:
  match ws:
    case Nil{}: {==}
    case Con{x, t}: Empty.absurd({Codec.parts(chu8(Con{x, t}), S.Repeat{S.Unsigned{P.U256{}}}) == Some{SF.fparts(cw8(Con{x, t}))} : Maybe<&2, +List<S.Part>>}, F.nat__succ_zero(F.spec_common__length(U32, t), hl))

def prt_chu8_s(+q: Nat, +ws: List<&2, U32>, +hl: {F.spec_common__length(U32, ws) == 8n+m8(q) : Nat},
    ih: @+r: List<&2, U32> -> @+hr: {F.spec_common__length(U32, r) == m8(q) : Nat} -> {Codec.parts(chu8(r), S.Repeat{S.Unsigned{P.U256{}}}) == Some{SF.fparts(cw8(r))} : Maybe<&2, +List<S.Part>>}) -> {Codec.parts(chu8(ws), S.Repeat{S.Unsigned{P.U256{}}}) == Some{SF.fparts(cw8(ws))} : Maybe<&2, +List<S.Part>>}:
  match ws:
    case Nil{}: Empty.absurd({Codec.parts(chu8(Nil{}), S.Repeat{S.Unsigned{P.U256{}}}) == Some{SF.fparts(cw8(Nil{}))} : Maybe<&2, +List<S.Part>>}, F.nat__zero_succ(7n+m8(q), peel(0n, 0n, 8n+m8(q), hl)))
    case Con{+w0, +r0}:
      match r0:
        case Nil{}: Empty.absurd({Codec.parts(chu8(Con{w0, Nil{}}), S.Repeat{S.Unsigned{P.U256{}}}) == Some{SF.fparts(cw8(Con{w0, Nil{}}))} : Maybe<&2, +List<S.Part>>}, F.nat__zero_succ(6n+m8(q), peel(1n, 0n, 7n+m8(q), hl)))
        case Con{+w1, +r1}:
          match r1:
            case Nil{}: Empty.absurd({Codec.parts(chu8(Con{w0, Con{w1, Nil{}}}), S.Repeat{S.Unsigned{P.U256{}}}) == Some{SF.fparts(cw8(Con{w0, Con{w1, Nil{}}}))} : Maybe<&2, +List<S.Part>>}, F.nat__zero_succ(5n+m8(q), peel(2n, 0n, 6n+m8(q), hl)))
            case Con{+w2, +r2}:
              match r2:
                case Nil{}: Empty.absurd({Codec.parts(chu8(Con{w0, Con{w1, Con{w2, Nil{}}}}), S.Repeat{S.Unsigned{P.U256{}}}) == Some{SF.fparts(cw8(Con{w0, Con{w1, Con{w2, Nil{}}}}))} : Maybe<&2, +List<S.Part>>}, F.nat__zero_succ(4n+m8(q), peel(3n, 0n, 5n+m8(q), hl)))
                case Con{+w3, +r3}:
                  match r3:
                    case Nil{}: Empty.absurd({Codec.parts(chu8(Con{w0, Con{w1, Con{w2, Con{w3, Nil{}}}}}), S.Repeat{S.Unsigned{P.U256{}}}) == Some{SF.fparts(cw8(Con{w0, Con{w1, Con{w2, Con{w3, Nil{}}}}}))} : Maybe<&2, +List<S.Part>>}, F.nat__zero_succ(3n+m8(q), peel(4n, 0n, 4n+m8(q), hl)))
                    case Con{+w4, +r4}:
                      match r4:
                        case Nil{}: Empty.absurd({Codec.parts(chu8(Con{w0, Con{w1, Con{w2, Con{w3, Con{w4, Nil{}}}}}}), S.Repeat{S.Unsigned{P.U256{}}}) == Some{SF.fparts(cw8(Con{w0, Con{w1, Con{w2, Con{w3, Con{w4, Nil{}}}}}}))} : Maybe<&2, +List<S.Part>>}, F.nat__zero_succ(2n+m8(q), peel(5n, 0n, 3n+m8(q), hl)))
                        case Con{+w5, +r5}:
                          match r5:
                            case Nil{}: Empty.absurd({Codec.parts(chu8(Con{w0, Con{w1, Con{w2, Con{w3, Con{w4, Con{w5, Nil{}}}}}}}), S.Repeat{S.Unsigned{P.U256{}}}) == Some{SF.fparts(cw8(Con{w0, Con{w1, Con{w2, Con{w3, Con{w4, Con{w5, Nil{}}}}}}}))} : Maybe<&2, +List<S.Part>>}, F.nat__zero_succ(1n+m8(q), peel(6n, 0n, 2n+m8(q), hl)))
                            case Con{+w6, +r6}:
                              match r6:
                                case Nil{}: Empty.absurd({Codec.parts(chu8(Con{w0, Con{w1, Con{w2, Con{w3, Con{w4, Con{w5, Con{w6, Nil{}}}}}}}}), S.Repeat{S.Unsigned{P.U256{}}}) == Some{SF.fparts(cw8(Con{w0, Con{w1, Con{w2, Con{w3, Con{w4, Con{w5, Con{w6, Nil{}}}}}}}}))} : Maybe<&2, +List<S.Part>>}, F.nat__zero_succ(0n+m8(q), peel(7n, 0n, 1n+m8(q), hl)))
                                case Con{+w7, +r}:
                                  %Equal.sym(S.Value, chu8(Con{w0, Con{w1, Con{w2, Con{w3, Con{w4, Con{w5, Con{w6, Con{w7, r}}}}}}}}), S.Items{S.UnsignedValue{P.UInt{w0, w1, w2, w3, w4, w5, w6, w7}}, chu8(r)}, cc_chu8(w0, w1, w2, w3, w4, w5, w6, w7, r)) :
                                    {Codec.parts(_, S.Repeat{S.Unsigned{P.U256{}}}) == Some{SF.fparts(cw8(Con{w0, Con{w1, Con{w2, Con{w3, Con{w4, Con{w5, Con{w6, Con{w7, r}}}}}}}}))} : Maybe<&2, +List<S.Part>>}
                                  %Equal.sym(Maybe<&2, +List<S.Part>>, Codec.parts(S.Items{S.UnsignedValue{P.UInt{w0, w1, w2, w3, w4, w5, w6, w7}}, chu8(r)}, S.Repeat{S.Unsigned{P.U256{}}}), Codec.concatenate(Codec.parts(S.UnsignedValue{P.UInt{w0, w1, w2, w3, w4, w5, w6, w7}}, S.Unsigned{P.U256{}}), Codec.parts(chu8(r), S.Repeat{S.Unsigned{P.U256{}}})), prep(S.UnsignedValue{P.UInt{w0, w1, w2, w3, w4, w5, w6, w7}}, chu8(r), S.Unsigned{P.U256{}})) :
                                    {_ == Some{SF.fparts(cw8(Con{w0, Con{w1, Con{w2, Con{w3, Con{w4, Con{w5, Con{w6, Con{w7, r}}}}}}}}))} : Maybe<&2, +List<S.Part>>}
                                  SF.cat_fixed(Codec.parts(S.UnsignedValue{P.UInt{w0, w1, w2, w3, w4, w5, w6, w7}}, S.Unsigned{P.U256{}}), SF.limbs([w0, w1, w2, w3, w4, w5, w6, w7]), Codec.parts(chu8(r), S.Repeat{S.Unsigned{P.U256{}}}), SF.fparts(cw8(r)), SF.uint256_part(w0, w1, w2, w3, w4, w5, w6, w7), ih(r, peel(8n, F.spec_common__length(U32, r), m8(q), hl)))

law prt_chu8:
  for +k: Nat
  for +ws: List<&2, U32>
  for +hl: {F.spec_common__length(U32, ws) == m8(k) : Nat}
  {Codec.parts(chu8(ws), S.Repeat{S.Unsigned{P.U256{}}}) == Some{SF.fparts(cw8(ws))} : Maybe<&2, +List<S.Part>>}
def prt_chu8(k, ws, hl):
  match k:
    case 0n: prt_chu8_z(ws, hl)
    case 1n+ +q: prt_chu8_s(q, ws, hl, r => hr => prt_chu8(q, r, hr))

law vpartsu8:
  for +s: S.Schema
  for +ws: List<&2, U32>
  for +k: Nat
  for +L: Nat
  for +N: Nat
  for +hs: {SH.is_Vector(s) == True{} : Bool}
  for +he: {SH.Vector_element(s) == S.Unsigned{P.U256{}} : S.Schema}
  for +hk: {Nat.is_eq(SH.Vector_length(s), k) == True{} : Bool}
  for +hk0: {Nat.is_lt(0n, k) == True{} : Bool}
  for +hl: {F.spec_common__length(U32, ws) == L : Nat}
  for +hL: {Nat.is_eq(m8(k), L) == True{} : Bool}
  for +hN: {SF.wlen(ws) == N : Nat}
  for +hf: {NB.fits(4n, Nat.add(N, 0n)) == True{} : Bool}
  {Codec.parts(S.Sequence{chu8(ws)}, s) == Some{[S.Fixed{SF.limbs(ws)}]} : Maybe<&2, +List<S.Part>>}
def vpartsu8(s, ws, k, L, N, hs, he, hk, hk0, hl, hL, hN, hf):
  +hl2 = Equal.trans(Nat, F.spec_common__length(U32, ws), L, m8(k), hl, Equal.sym(Nat, m8(k), L, F.nat__eq_from_is_eq(m8(k), L, hL)))
  +ek = F.nat__eq_from_is_eq(SH.Vector_length(s), k, hk)
  +hN2 = Equal.trans(Nat, Layout.fixed_size(SF.fparts(cw8(ws))), SF.wlen(ws), N, fsz8(k, ws, hl2), hN)
  %Equal.sym(S.Schema, s, S.Vector{SH.Vector_element(s), SH.Vector_length(s)}, SH.Vector_shape(s, hs)) :
    {Codec.parts(S.Sequence{chu8(ws)}, _) == Some{[S.Fixed{SF.limbs(ws)}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(S.Schema, SH.Vector_element(s), S.Unsigned{P.U256{}}, he) : {Codec.parts(S.Sequence{chu8(ws)}, S.Vector{_, SH.Vector_length(s)}) == Some{[S.Fixed{SF.limbs(ws)}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(Nat, SH.Vector_length(s), k, ek) :
    {Codec.require(Bool.and(Nat.is_lt(0n, _), Nat.is_eq(Codec.count(chu8(ws)), _)), Codec.aggregate(Codec.parts(chu8(ws), S.Repeat{S.Unsigned{P.U256{}}}), SSC.times(_, SSC.fixed_size(S.Unsigned{P.U256{}})))) == Some{[S.Fixed{SF.limbs(ws)}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(Nat, Codec.count(chu8(ws)), k, cnt_chu8(k, ws, hl2)) :
    {Codec.require(Bool.and(Nat.is_lt(0n, k), Nat.is_eq(_, k)), Codec.aggregate(Codec.parts(chu8(ws), S.Repeat{S.Unsigned{P.U256{}}}), SSC.times(k, SSC.fixed_size(S.Unsigned{P.U256{}})))) == Some{[S.Fixed{SF.limbs(ws)}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(Bool, Nat.is_lt(0n, k), True{}, hk0) :
    {Codec.require(Bool.and(_, Nat.is_eq(k, k)), Codec.aggregate(Codec.parts(chu8(ws), S.Repeat{S.Unsigned{P.U256{}}}), SSC.times(k, SSC.fixed_size(S.Unsigned{P.U256{}})))) == Some{[S.Fixed{SF.limbs(ws)}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(Bool, Nat.is_eq(k, k), True{}, F.nat__is_eq_refl(k)) :
    {Codec.require(Bool.and(True{}, _), Codec.aggregate(Codec.parts(chu8(ws), S.Repeat{S.Unsigned{P.U256{}}}), SSC.times(k, SSC.fixed_size(S.Unsigned{P.U256{}})))) == Some{[S.Fixed{SF.limbs(ws)}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(Maybe<&2, +List<S.Part>>, Codec.parts(chu8(ws), S.Repeat{S.Unsigned{P.U256{}}}), Some{SF.fparts(cw8(ws))}, prt_chu8(k, ws, hl2)) :
    {Codec.require(Bool.and(True{}, True{}), Codec.aggregate(_, SSC.times(k, SSC.fixed_size(S.Unsigned{P.U256{}})))) == Some{[S.Fixed{SF.limbs(ws)}]} : Maybe<&2, +List<S.Part>>}
  %flt8(k, ws, hl2) :
    {Codec.aggregate(Some{SF.fparts(cw8(ws))}, SSC.times(k, SSC.fixed_size(S.Unsigned{P.U256{}}))) == Some{[S.Fixed{_}]} : Maybe<&2, +List<S.Part>>}
  AS.agg(cw8(ws), AS.unsome(SSC.times(k, SSC.fixed_size(S.Unsigned{P.U256{}}))), N, hN2, hf)

