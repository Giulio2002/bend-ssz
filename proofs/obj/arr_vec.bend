  AS.agg(cw8(ws), AS.unsome(SSC.times(k, SSC.fixed_size(S.ByteVector{32n}))), N, hN2, hf)

def m12(k: Nat) -> Nat:
  match k:
    case 0n: 0n
    case 1n+q: 12n+m12(q)

def cw12(ws: List<&2, U32>) -> +List<+List<U32>>:
  match ws:
    case Nil{}: []
    case Con{w0, r0}:
      match r0:
        case Nil{}: []
        case Con{w1, r1}:
          match r1:
            case Nil{}: []
            case Con{w2, r2}:
              match r2:
                case Nil{}: []
                case Con{w3, r3}:
                  match r3:
                    case Nil{}: []
                    case Con{w4, r4}:
                      match r4:
                        case Nil{}: []
                        case Con{w5, r5}:
                          match r5:
                            case Nil{}: []
                            case Con{w6, r6}:
                              match r6:
                                case Nil{}: []
                                case Con{w7, r7}:
                                  match r7:
                                    case Nil{}: []
                                    case Con{w8, r8}:
                                      match r8:
                                        case Nil{}: []
                                        case Con{w9, r9}:
                                          match r9:
                                            case Nil{}: []
                                            case Con{w10, r10}:
                                              match r10:
                                                case Nil{}: []
                                                case Con{w11, r}: Con{[w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11], cw12(r)}

def flt12_z(+ws: List<&2, U32>, +hl: {F.spec_common__length(U32, ws) == 0n : Nat}) -> {SF.flat(cw12(ws)) == SF.limbs(ws) : +List<U32>}:
  match ws:
    case Nil{}: {==}
    case Con{x, t}: Empty.absurd({SF.flat(cw12(Con{x, t})) == SF.limbs(Con{x, t}) : +List<U32>}, F.nat__succ_zero(F.spec_common__length(U32, t), hl))

def flt12_s(+q: Nat, +ws: List<&2, U32>, +hl: {F.spec_common__length(U32, ws) == 12n+m12(q) : Nat},
    ih: @+r: List<&2, U32> -> @+hr: {F.spec_common__length(U32, r) == m12(q) : Nat} -> {SF.flat(cw12(r)) == SF.limbs(r) : +List<U32>}) -> {SF.flat(cw12(ws)) == SF.limbs(ws) : +List<U32>}:
  match ws:
    case Nil{}: Empty.absurd({SF.flat(cw12(Nil{})) == SF.limbs(Nil{}) : +List<U32>}, F.nat__zero_succ(11n+m12(q), peel(0n, 0n, 12n+m12(q), hl)))
    case Con{+w0, +r0}:
      match r0:
        case Nil{}: Empty.absurd({SF.flat(cw12(Con{w0, Nil{}})) == SF.limbs(Con{w0, Nil{}}) : +List<U32>}, F.nat__zero_succ(10n+m12(q), peel(1n, 0n, 11n+m12(q), hl)))
        case Con{+w1, +r1}:
          match r1:
            case Nil{}: Empty.absurd({SF.flat(cw12(Con{w0, Con{w1, Nil{}}})) == SF.limbs(Con{w0, Con{w1, Nil{}}}) : +List<U32>}, F.nat__zero_succ(9n+m12(q), peel(2n, 0n, 10n+m12(q), hl)))
            case Con{+w2, +r2}:
              match r2:
                case Nil{}: Empty.absurd({SF.flat(cw12(Con{w0, Con{w1, Con{w2, Nil{}}}})) == SF.limbs(Con{w0, Con{w1, Con{w2, Nil{}}}}) : +List<U32>}, F.nat__zero_succ(8n+m12(q), peel(3n, 0n, 9n+m12(q), hl)))
                case Con{+w3, +r3}:
                  match r3:
                    case Nil{}: Empty.absurd({SF.flat(cw12(Con{w0, Con{w1, Con{w2, Con{w3, Nil{}}}}})) == SF.limbs(Con{w0, Con{w1, Con{w2, Con{w3, Nil{}}}}}) : +List<U32>}, F.nat__zero_succ(7n+m12(q), peel(4n, 0n, 8n+m12(q), hl)))
                    case Con{+w4, +r4}:
                      match r4:
                        case Nil{}: Empty.absurd({SF.flat(cw12(Con{w0, Con{w1, Con{w2, Con{w3, Con{w4, Nil{}}}}}})) == SF.limbs(Con{w0, Con{w1, Con{w2, Con{w3, Con{w4, Nil{}}}}}}) : +List<U32>}, F.nat__zero_succ(6n+m12(q), peel(5n, 0n, 7n+m12(q), hl)))
                        case Con{+w5, +r5}:
                          match r5:
                            case Nil{}: Empty.absurd({SF.flat(cw12(Con{w0, Con{w1, Con{w2, Con{w3, Con{w4, Con{w5, Nil{}}}}}}})) == SF.limbs(Con{w0, Con{w1, Con{w2, Con{w3, Con{w4, Con{w5, Nil{}}}}}}}) : +List<U32>}, F.nat__zero_succ(5n+m12(q), peel(6n, 0n, 6n+m12(q), hl)))
                            case Con{+w6, +r6}:
                              match r6:
                                case Nil{}: Empty.absurd({SF.flat(cw12(Con{w0, Con{w1, Con{w2, Con{w3, Con{w4, Con{w5, Con{w6, Nil{}}}}}}}})) == SF.limbs(Con{w0, Con{w1, Con{w2, Con{w3, Con{w4, Con{w5, Con{w6, Nil{}}}}}}}}) : +List<U32>}, F.nat__zero_succ(4n+m12(q), peel(7n, 0n, 5n+m12(q), hl)))
                                case Con{+w7, +r7}:
                                  match r7:
                                    case Nil{}: Empty.absurd({SF.flat(cw12(Con{w0, Con{w1, Con{w2, Con{w3, Con{w4, Con{w5, Con{w6, Con{w7, Nil{}}}}}}}}})) == SF.limbs(Con{w0, Con{w1, Con{w2, Con{w3, Con{w4, Con{w5, Con{w6, Con{w7, Nil{}}}}}}}}}) : +List<U32>}, F.nat__zero_succ(3n+m12(q), peel(8n, 0n, 4n+m12(q), hl)))
                                    case Con{+w8, +r8}:
                                      match r8:
                                        case Nil{}: Empty.absurd({SF.flat(cw12(Con{w0, Con{w1, Con{w2, Con{w3, Con{w4, Con{w5, Con{w6, Con{w7, Con{w8, Nil{}}}}}}}}}})) == SF.limbs(Con{w0, Con{w1, Con{w2, Con{w3, Con{w4, Con{w5, Con{w6, Con{w7, Con{w8, Nil{}}}}}}}}}}) : +List<U32>}, F.nat__zero_succ(2n+m12(q), peel(9n, 0n, 3n+m12(q), hl)))
                                        case Con{+w9, +r9}:
                                          match r9:
                                            case Nil{}: Empty.absurd({SF.flat(cw12(Con{w0, Con{w1, Con{w2, Con{w3, Con{w4, Con{w5, Con{w6, Con{w7, Con{w8, Con{w9, Nil{}}}}}}}}}}})) == SF.limbs(Con{w0, Con{w1, Con{w2, Con{w3, Con{w4, Con{w5, Con{w6, Con{w7, Con{w8, Con{w9, Nil{}}}}}}}}}}}) : +List<U32>}, F.nat__zero_succ(1n+m12(q), peel(10n, 0n, 2n+m12(q), hl)))
                                            case Con{+w10, +r10}:
                                              match r10:
                                                case Nil{}: Empty.absurd({SF.flat(cw12(Con{w0, Con{w1, Con{w2, Con{w3, Con{w4, Con{w5, Con{w6, Con{w7, Con{w8, Con{w9, Con{w10, Nil{}}}}}}}}}}}})) == SF.limbs(Con{w0, Con{w1, Con{w2, Con{w3, Con{w4, Con{w5, Con{w6, Con{w7, Con{w8, Con{w9, Con{w10, Nil{}}}}}}}}}}}}) : +List<U32>}, F.nat__zero_succ(0n+m12(q), peel(11n, 0n, 1n+m12(q), hl)))
                                                case Con{+w11, +r}:
                                                  Equal.cong(+List<U32>, +List<U32>, z => List.append(&2, U32, SF.limbs([w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11]), z), SF.flat(cw12(r)), SF.limbs(r), ih(r, peel(12n, F.spec_common__length(U32, r), m12(q), hl)))

law flt12:
  for +k: Nat
  for +ws: List<&2, U32>
  for +hl: {F.spec_common__length(U32, ws) == m12(k) : Nat}
  {SF.flat(cw12(ws)) == SF.limbs(ws) : +List<U32>}
def flt12(k, ws, hl):
  match k:
    case 0n: flt12_z(ws, hl)
    case 1n+ +q: flt12_s(q, ws, hl, r => hr => flt12(q, r, hr))

def fsz12_z(+ws: List<&2, U32>, +hl: {F.spec_common__length(U32, ws) == 0n : Nat}) -> {Layout.fixed_size(SF.fparts(cw12(ws))) == SF.wlen(ws) : Nat}:
  match ws:
    case Nil{}: {==}
    case Con{x, t}: Empty.absurd({Layout.fixed_size(SF.fparts(cw12(Con{x, t}))) == SF.wlen(Con{x, t}) : Nat}, F.nat__succ_zero(F.spec_common__length(U32, t), hl))

def fsz12_s(+q: Nat, +ws: List<&2, U32>, +hl: {F.spec_common__length(U32, ws) == 12n+m12(q) : Nat},
    ih: @+r: List<&2, U32> -> @+hr: {F.spec_common__length(U32, r) == m12(q) : Nat} -> {Layout.fixed_size(SF.fparts(cw12(r))) == SF.wlen(r) : Nat}) -> {Layout.fixed_size(SF.fparts(cw12(ws))) == SF.wlen(ws) : Nat}:
  match ws:
    case Nil{}: Empty.absurd({Layout.fixed_size(SF.fparts(cw12(Nil{}))) == SF.wlen(Nil{}) : Nat}, F.nat__zero_succ(11n+m12(q), peel(0n, 0n, 12n+m12(q), hl)))
    case Con{+w0, +r0}:
      match r0:
        case Nil{}: Empty.absurd({Layout.fixed_size(SF.fparts(cw12(Con{w0, Nil{}}))) == SF.wlen(Con{w0, Nil{}}) : Nat}, F.nat__zero_succ(10n+m12(q), peel(1n, 0n, 11n+m12(q), hl)))
        case Con{+w1, +r1}:
          match r1:
            case Nil{}: Empty.absurd({Layout.fixed_size(SF.fparts(cw12(Con{w0, Con{w1, Nil{}}}))) == SF.wlen(Con{w0, Con{w1, Nil{}}}) : Nat}, F.nat__zero_succ(9n+m12(q), peel(2n, 0n, 10n+m12(q), hl)))
            case Con{+w2, +r2}:
              match r2:
                case Nil{}: Empty.absurd({Layout.fixed_size(SF.fparts(cw12(Con{w0, Con{w1, Con{w2, Nil{}}}}))) == SF.wlen(Con{w0, Con{w1, Con{w2, Nil{}}}}) : Nat}, F.nat__zero_succ(8n+m12(q), peel(3n, 0n, 9n+m12(q), hl)))
                case Con{+w3, +r3}:
                  match r3:
                    case Nil{}: Empty.absurd({Layout.fixed_size(SF.fparts(cw12(Con{w0, Con{w1, Con{w2, Con{w3, Nil{}}}}}))) == SF.wlen(Con{w0, Con{w1, Con{w2, Con{w3, Nil{}}}}}) : Nat}, F.nat__zero_succ(7n+m12(q), peel(4n, 0n, 8n+m12(q), hl)))
                    case Con{+w4, +r4}:
                      match r4:
                        case Nil{}: Empty.absurd({Layout.fixed_size(SF.fparts(cw12(Con{w0, Con{w1, Con{w2, Con{w3, Con{w4, Nil{}}}}}}))) == SF.wlen(Con{w0, Con{w1, Con{w2, Con{w3, Con{w4, Nil{}}}}}}) : Nat}, F.nat__zero_succ(6n+m12(q), peel(5n, 0n, 7n+m12(q), hl)))
                        case Con{+w5, +r5}:
                          match r5:
                            case Nil{}: Empty.absurd({Layout.fixed_size(SF.fparts(cw12(Con{w0, Con{w1, Con{w2, Con{w3, Con{w4, Con{w5, Nil{}}}}}}}))) == SF.wlen(Con{w0, Con{w1, Con{w2, Con{w3, Con{w4, Con{w5, Nil{}}}}}}}) : Nat}, F.nat__zero_succ(5n+m12(q), peel(6n, 0n, 6n+m12(q), hl)))
                            case Con{+w6, +r6}:
                              match r6:
                                case Nil{}: Empty.absurd({Layout.fixed_size(SF.fparts(cw12(Con{w0, Con{w1, Con{w2, Con{w3, Con{w4, Con{w5, Con{w6, Nil{}}}}}}}}))) == SF.wlen(Con{w0, Con{w1, Con{w2, Con{w3, Con{w4, Con{w5, Con{w6, Nil{}}}}}}}}) : Nat}, F.nat__zero_succ(4n+m12(q), peel(7n, 0n, 5n+m12(q), hl)))
                                case Con{+w7, +r7}:
                                  match r7:
                                    case Nil{}: Empty.absurd({Layout.fixed_size(SF.fparts(cw12(Con{w0, Con{w1, Con{w2, Con{w3, Con{w4, Con{w5, Con{w6, Con{w7, Nil{}}}}}}}}}))) == SF.wlen(Con{w0, Con{w1, Con{w2, Con{w3, Con{w4, Con{w5, Con{w6, Con{w7, Nil{}}}}}}}}}) : Nat}, F.nat__zero_succ(3n+m12(q), peel(8n, 0n, 4n+m12(q), hl)))
                                    case Con{+w8, +r8}:
                                      match r8:
                                        case Nil{}: Empty.absurd({Layout.fixed_size(SF.fparts(cw12(Con{w0, Con{w1, Con{w2, Con{w3, Con{w4, Con{w5, Con{w6, Con{w7, Con{w8, Nil{}}}}}}}}}}))) == SF.wlen(Con{w0, Con{w1, Con{w2, Con{w3, Con{w4, Con{w5, Con{w6, Con{w7, Con{w8, Nil{}}}}}}}}}}) : Nat}, F.nat__zero_succ(2n+m12(q), peel(9n, 0n, 3n+m12(q), hl)))
                                        case Con{+w9, +r9}:
                                          match r9:
                                            case Nil{}: Empty.absurd({Layout.fixed_size(SF.fparts(cw12(Con{w0, Con{w1, Con{w2, Con{w3, Con{w4, Con{w5, Con{w6, Con{w7, Con{w8, Con{w9, Nil{}}}}}}}}}}}))) == SF.wlen(Con{w0, Con{w1, Con{w2, Con{w3, Con{w4, Con{w5, Con{w6, Con{w7, Con{w8, Con{w9, Nil{}}}}}}}}}}}) : Nat}, F.nat__zero_succ(1n+m12(q), peel(10n, 0n, 2n+m12(q), hl)))
                                            case Con{+w10, +r10}:
                                              match r10:
                                                case Nil{}: Empty.absurd({Layout.fixed_size(SF.fparts(cw12(Con{w0, Con{w1, Con{w2, Con{w3, Con{w4, Con{w5, Con{w6, Con{w7, Con{w8, Con{w9, Con{w10, Nil{}}}}}}}}}}}}))) == SF.wlen(Con{w0, Con{w1, Con{w2, Con{w3, Con{w4, Con{w5, Con{w6, Con{w7, Con{w8, Con{w9, Con{w10, Nil{}}}}}}}}}}}}) : Nat}, F.nat__zero_succ(0n+m12(q), peel(11n, 0n, 1n+m12(q), hl)))
                                                case Con{+w11, +r}:
                                                  Equal.cong(Nat, Nat, z => Nat.add(48n, z), Layout.fixed_size(SF.fparts(cw12(r))), SF.wlen(r), ih(r, peel(12n, F.spec_common__length(U32, r), m12(q), hl)))

law fsz12:
  for +k: Nat
  for +ws: List<&2, U32>
  for +hl: {F.spec_common__length(U32, ws) == m12(k) : Nat}
  {Layout.fixed_size(SF.fparts(cw12(ws))) == SF.wlen(ws) : Nat}
def fsz12(k, ws, hl):
  match k:
    case 0n: fsz12_z(ws, hl)
    case 1n+ +q: fsz12_s(q, ws, hl, r => hr => fsz12(q, r, hr))

def ch12(ws: List<&2, U32>) -> S.Value:
  match ws:
    case Nil{}: S.EmptyItems{}
    case Con{w0, r0}:
      match r0:
        case Nil{}: S.EmptyItems{}
        case Con{w1, r1}:
          match r1:
            case Nil{}: S.EmptyItems{}
            case Con{w2, r2}:
              match r2:
                case Nil{}: S.EmptyItems{}
                case Con{w3, r3}:
                  match r3:
                    case Nil{}: S.EmptyItems{}
                    case Con{w4, r4}:
                      match r4:
                        case Nil{}: S.EmptyItems{}
                        case Con{w5, r5}:
                          match r5:
                            case Nil{}: S.EmptyItems{}
                            case Con{w6, r6}:
                              match r6:
                                case Nil{}: S.EmptyItems{}
                                case Con{w7, r7}:
                                  match r7:
                                    case Nil{}: S.EmptyItems{}
                                    case Con{w8, r8}:
                                      match r8:
                                        case Nil{}: S.EmptyItems{}
                                        case Con{w9, r9}:
                                          match r9:
                                            case Nil{}: S.EmptyItems{}
                                            case Con{w10, r10}:
                                              match r10:
                                                case Nil{}: S.EmptyItems{}
                                                case Con{w11, r}: S.Items{S.BytesValue{SF.limbs([w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11])}, ch12(r)}

def cnt_ch12_z(+ws: List<&2, U32>, +hl: {F.spec_common__length(U32, ws) == 0n : Nat}) -> {Codec.count(ch12(ws)) == 0n : Nat}:
  match ws:
    case Nil{}: {==}
    case Con{x, t}: Empty.absurd({Codec.count(ch12(Con{x, t})) == 0n : Nat}, F.nat__succ_zero(F.spec_common__length(U32, t), hl))

def cnt_ch12_s(+q: Nat, +ws: List<&2, U32>, +hl: {F.spec_common__length(U32, ws) == 12n+m12(q) : Nat},
    ih: @+r: List<&2, U32> -> @+hr: {F.spec_common__length(U32, r) == m12(q) : Nat} -> {Codec.count(ch12(r)) == q : Nat}) -> {Codec.count(ch12(ws)) == 1n+q : Nat}:
  match ws:
    case Nil{}: Empty.absurd({Codec.count(ch12(Nil{})) == 1n+q : Nat}, F.nat__zero_succ(11n+m12(q), peel(0n, 0n, 12n+m12(q), hl)))
    case Con{+w0, +r0}:
      match r0:
        case Nil{}: Empty.absurd({Codec.count(ch12(Con{w0, Nil{}})) == 1n+q : Nat}, F.nat__zero_succ(10n+m12(q), peel(1n, 0n, 11n+m12(q), hl)))
        case Con{+w1, +r1}:
          match r1:
            case Nil{}: Empty.absurd({Codec.count(ch12(Con{w0, Con{w1, Nil{}}})) == 1n+q : Nat}, F.nat__zero_succ(9n+m12(q), peel(2n, 0n, 10n+m12(q), hl)))
            case Con{+w2, +r2}:
              match r2:
                case Nil{}: Empty.absurd({Codec.count(ch12(Con{w0, Con{w1, Con{w2, Nil{}}}})) == 1n+q : Nat}, F.nat__zero_succ(8n+m12(q), peel(3n, 0n, 9n+m12(q), hl)))
                case Con{+w3, +r3}:
                  match r3:
                    case Nil{}: Empty.absurd({Codec.count(ch12(Con{w0, Con{w1, Con{w2, Con{w3, Nil{}}}}})) == 1n+q : Nat}, F.nat__zero_succ(7n+m12(q), peel(4n, 0n, 8n+m12(q), hl)))
                    case Con{+w4, +r4}:
                      match r4:
                        case Nil{}: Empty.absurd({Codec.count(ch12(Con{w0, Con{w1, Con{w2, Con{w3, Con{w4, Nil{}}}}}})) == 1n+q : Nat}, F.nat__zero_succ(6n+m12(q), peel(5n, 0n, 7n+m12(q), hl)))
                        case Con{+w5, +r5}:
                          match r5:
                            case Nil{}: Empty.absurd({Codec.count(ch12(Con{w0, Con{w1, Con{w2, Con{w3, Con{w4, Con{w5, Nil{}}}}}}})) == 1n+q : Nat}, F.nat__zero_succ(5n+m12(q), peel(6n, 0n, 6n+m12(q), hl)))
                            case Con{+w6, +r6}:
                              match r6:
                                case Nil{}: Empty.absurd({Codec.count(ch12(Con{w0, Con{w1, Con{w2, Con{w3, Con{w4, Con{w5, Con{w6, Nil{}}}}}}}})) == 1n+q : Nat}, F.nat__zero_succ(4n+m12(q), peel(7n, 0n, 5n+m12(q), hl)))
                                case Con{+w7, +r7}:
                                  match r7:
