  AS.agg(cw2(ws), AS.unsome(SSC.times(k, SSC.fixed_size(S.Unsigned{P.U64{}}))), N, hN2, hf)

def m4(k: Nat) -> Nat:
  match k:
    case 0n: 0n
    case 1n+q: 4n+m4(q)

def cw4(ws: List<&2, U32>) -> +List<+List<U32>>:
  match ws:
    case Nil{}: []
    case Con{w0, r0}:
      match r0:
        case Nil{}: []
        case Con{w1, r1}:
          match r1:
            case Nil{}: []
            case Con{w2, r2}:
              match r2:
                case Nil{}: []
                case Con{w3, r}: Con{[w0, w1, w2, w3], cw4(r)}

def flt4_z(+ws: List<&2, U32>, +hl: {F.spec_common__length(U32, ws) == 0n : Nat}) -> {SF.flat(cw4(ws)) == SF.limbs(ws) : +List<U32>}:
  match ws:
    case Nil{}: {==}
    case Con{x, t}: Empty.absurd({SF.flat(cw4(Con{x, t})) == SF.limbs(Con{x, t}) : +List<U32>}, F.nat__succ_zero(F.spec_common__length(U32, t), hl))

def flt4_s(+q: Nat, +ws: List<&2, U32>, +hl: {F.spec_common__length(U32, ws) == 4n+m4(q) : Nat},
    ih: @+r: List<&2, U32> -> @+hr: {F.spec_common__length(U32, r) == m4(q) : Nat} -> {SF.flat(cw4(r)) == SF.limbs(r) : +List<U32>}) -> {SF.flat(cw4(ws)) == SF.limbs(ws) : +List<U32>}:
  match ws:
    case Nil{}: Empty.absurd({SF.flat(cw4(Nil{})) == SF.limbs(Nil{}) : +List<U32>}, F.nat__zero_succ(3n+m4(q), peel(0n, 0n, 4n+m4(q), hl)))
    case Con{+w0, +r0}:
      match r0:
        case Nil{}: Empty.absurd({SF.flat(cw4(Con{w0, Nil{}})) == SF.limbs(Con{w0, Nil{}}) : +List<U32>}, F.nat__zero_succ(2n+m4(q), peel(1n, 0n, 3n+m4(q), hl)))
        case Con{+w1, +r1}:
          match r1:
            case Nil{}: Empty.absurd({SF.flat(cw4(Con{w0, Con{w1, Nil{}}})) == SF.limbs(Con{w0, Con{w1, Nil{}}}) : +List<U32>}, F.nat__zero_succ(1n+m4(q), peel(2n, 0n, 2n+m4(q), hl)))
            case Con{+w2, +r2}:
              match r2:
                case Nil{}: Empty.absurd({SF.flat(cw4(Con{w0, Con{w1, Con{w2, Nil{}}}})) == SF.limbs(Con{w0, Con{w1, Con{w2, Nil{}}}}) : +List<U32>}, F.nat__zero_succ(0n+m4(q), peel(3n, 0n, 1n+m4(q), hl)))
                case Con{+w3, +r}:
                  Equal.cong(+List<U32>, +List<U32>, z => List.append(&2, U32, SF.limbs([w0, w1, w2, w3]), z), SF.flat(cw4(r)), SF.limbs(r), ih(r, peel(4n, F.spec_common__length(U32, r), m4(q), hl)))

law flt4:
  for +k: Nat
  for +ws: List<&2, U32>
  for +hl: {F.spec_common__length(U32, ws) == m4(k) : Nat}
  {SF.flat(cw4(ws)) == SF.limbs(ws) : +List<U32>}
def flt4(k, ws, hl):
  match k:
    case 0n: flt4_z(ws, hl)
    case 1n+ +q: flt4_s(q, ws, hl, r => hr => flt4(q, r, hr))

def fsz4_z(+ws: List<&2, U32>, +hl: {F.spec_common__length(U32, ws) == 0n : Nat}) -> {Layout.fixed_size(SF.fparts(cw4(ws))) == SF.wlen(ws) : Nat}:
  match ws:
    case Nil{}: {==}
    case Con{x, t}: Empty.absurd({Layout.fixed_size(SF.fparts(cw4(Con{x, t}))) == SF.wlen(Con{x, t}) : Nat}, F.nat__succ_zero(F.spec_common__length(U32, t), hl))

def fsz4_s(+q: Nat, +ws: List<&2, U32>, +hl: {F.spec_common__length(U32, ws) == 4n+m4(q) : Nat},
    ih: @+r: List<&2, U32> -> @+hr: {F.spec_common__length(U32, r) == m4(q) : Nat} -> {Layout.fixed_size(SF.fparts(cw4(r))) == SF.wlen(r) : Nat}) -> {Layout.fixed_size(SF.fparts(cw4(ws))) == SF.wlen(ws) : Nat}:
  match ws:
    case Nil{}: Empty.absurd({Layout.fixed_size(SF.fparts(cw4(Nil{}))) == SF.wlen(Nil{}) : Nat}, F.nat__zero_succ(3n+m4(q), peel(0n, 0n, 4n+m4(q), hl)))
    case Con{+w0, +r0}:
      match r0:
        case Nil{}: Empty.absurd({Layout.fixed_size(SF.fparts(cw4(Con{w0, Nil{}}))) == SF.wlen(Con{w0, Nil{}}) : Nat}, F.nat__zero_succ(2n+m4(q), peel(1n, 0n, 3n+m4(q), hl)))
        case Con{+w1, +r1}:
          match r1:
            case Nil{}: Empty.absurd({Layout.fixed_size(SF.fparts(cw4(Con{w0, Con{w1, Nil{}}}))) == SF.wlen(Con{w0, Con{w1, Nil{}}}) : Nat}, F.nat__zero_succ(1n+m4(q), peel(2n, 0n, 2n+m4(q), hl)))
            case Con{+w2, +r2}:
              match r2:
                case Nil{}: Empty.absurd({Layout.fixed_size(SF.fparts(cw4(Con{w0, Con{w1, Con{w2, Nil{}}}}))) == SF.wlen(Con{w0, Con{w1, Con{w2, Nil{}}}}) : Nat}, F.nat__zero_succ(0n+m4(q), peel(3n, 0n, 1n+m4(q), hl)))
                case Con{+w3, +r}:
                  Equal.cong(Nat, Nat, z => Nat.add(16n, z), Layout.fixed_size(SF.fparts(cw4(r))), SF.wlen(r), ih(r, peel(4n, F.spec_common__length(U32, r), m4(q), hl)))

law fsz4:
  for +k: Nat
  for +ws: List<&2, U32>
  for +hl: {F.spec_common__length(U32, ws) == m4(k) : Nat}
  {Layout.fixed_size(SF.fparts(cw4(ws))) == SF.wlen(ws) : Nat}
def fsz4(k, ws, hl):
  match k:
    case 0n: fsz4_z(ws, hl)
    case 1n+ +q: fsz4_s(q, ws, hl, r => hr => fsz4(q, r, hr))

def chu4(ws: List<&2, U32>) -> S.Value:
  match ws:
    case Nil{}: S.EmptyItems{}
    case Con{w0, r0}:
      match r0:
        case Nil{}: S.EmptyItems{}
        case Con{w1, r1}:
          match r1:
            case Nil{}: S.EmptyItems{}
            case Con{w2, r2}:
              match r2:
                case Nil{}: S.EmptyItems{}
                case Con{w3, r}: S.Items{S.UnsignedValue{P.UInt{w0, w1, w2, w3, 0, 0, 0, 0}}, chu4(r)}

def cnt_chu4_z(+ws: List<&2, U32>, +hl: {F.spec_common__length(U32, ws) == 0n : Nat}) -> {Codec.count(chu4(ws)) == 0n : Nat}:
  match ws:
    case Nil{}: {==}
    case Con{x, t}: Empty.absurd({Codec.count(chu4(Con{x, t})) == 0n : Nat}, F.nat__succ_zero(F.spec_common__length(U32, t), hl))

def cnt_chu4_s(+q: Nat, +ws: List<&2, U32>, +hl: {F.spec_common__length(U32, ws) == 4n+m4(q) : Nat},
    ih: @+r: List<&2, U32> -> @+hr: {F.spec_common__length(U32, r) == m4(q) : Nat} -> {Codec.count(chu4(r)) == q : Nat}) -> {Codec.count(chu4(ws)) == 1n+q : Nat}:
  match ws:
    case Nil{}: Empty.absurd({Codec.count(chu4(Nil{})) == 1n+q : Nat}, F.nat__zero_succ(3n+m4(q), peel(0n, 0n, 4n+m4(q), hl)))
    case Con{+w0, +r0}:
      match r0:
        case Nil{}: Empty.absurd({Codec.count(chu4(Con{w0, Nil{}})) == 1n+q : Nat}, F.nat__zero_succ(2n+m4(q), peel(1n, 0n, 3n+m4(q), hl)))
        case Con{+w1, +r1}:
          match r1:
            case Nil{}: Empty.absurd({Codec.count(chu4(Con{w0, Con{w1, Nil{}}})) == 1n+q : Nat}, F.nat__zero_succ(1n+m4(q), peel(2n, 0n, 2n+m4(q), hl)))
            case Con{+w2, +r2}:
              match r2:
                case Nil{}: Empty.absurd({Codec.count(chu4(Con{w0, Con{w1, Con{w2, Nil{}}}})) == 1n+q : Nat}, F.nat__zero_succ(0n+m4(q), peel(3n, 0n, 1n+m4(q), hl)))
                case Con{+w3, +r}:
                  F.nat__succ_cong(Codec.count(chu4(r)), q, ih(r, peel(4n, F.spec_common__length(U32, r), m4(q), hl)))

law cnt_chu4:
  for +k: Nat
  for +ws: List<&2, U32>
  for +hl: {F.spec_common__length(U32, ws) == m4(k) : Nat}
