def prt_ch12_s(+q: Nat, +ws: List<&2, U32>, +hl: {F.spec_common__length(U32, ws) == 12n+m12(q) : Nat},
    ih: @+r: List<&2, U32> -> @+hr: {F.spec_common__length(U32, r) == m12(q) : Nat} -> {Codec.parts(ch12(r), S.Repeat{S.ByteVector{48n}}) == Some{SF.fparts(cw12(r))} : Maybe<&2, +List<S.Part>>}) -> {Codec.parts(ch12(ws), S.Repeat{S.ByteVector{48n}}) == Some{SF.fparts(cw12(ws))} : Maybe<&2, +List<S.Part>>}:
