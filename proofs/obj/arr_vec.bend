law vpartsu4:
  for +s: S.Schema
  for +ws: List<&2, U32>
  for +k: Nat
  for +L: Nat
  for +N: Nat
  for +hs: {SH.is_Vector(s) == True{} : Bool}
  for +he: {SH.Vector_element(s) == S.Unsigned{P.U128{}} : S.Schema}
  for +hk: {Nat.is_eq(SH.Vector_length(s), k) == True{} : Bool}
  for +hk0: {Nat.is_lt(0n, k) == True{} : Bool}
  for +hl: {F.spec_common__length(U32, ws) == L : Nat}
  for +hL: {Nat.is_eq(m4(k), L) == True{} : Bool}
  for +hN: {SF.wlen(ws) == N : Nat}
  for +hf: {NB.fits(4n, Nat.add(N, 0n)) == True{} : Bool}
  {Codec.parts(S.Sequence{chu4(ws)}, s) == Some{[S.Fixed{SF.limbs(ws)}]} : Maybe<&2, +List<S.Part>>}
def vpartsu4(s, ws, k, L, N, hs, he, hk, hk0, hl, hL, hN, hf):
  +hl2 = Equal.trans(Nat, F.spec_common__length(U32, ws), L, m4(k), hl, Equal.sym(Nat, m4(k), L, F.nat__eq_from_is_eq(m4(k), L, hL)))
  +ek = F.nat__eq_from_is_eq(SH.Vector_length(s), k, hk)
  +hN2 = Equal.trans(Nat, Layout.fixed_size(SF.fparts(cw4(ws))), SF.wlen(ws), N, fsz4(k, ws, hl2), hN)
  %Equal.sym(S.Schema, s, S.Vector{SH.Vector_element(s), SH.Vector_length(s)}, SH.Vector_shape(s, hs)) :
    {Codec.parts(S.Sequence{chu4(ws)}, _) == Some{[S.Fixed{SF.limbs(ws)}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(S.Schema, SH.Vector_element(s), S.Unsigned{P.U128{}}, he) : {Codec.parts(S.Sequence{chu4(ws)}, S.Vector{_, SH.Vector_length(s)}) == Some{[S.Fixed{SF.limbs(ws)}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(Nat, SH.Vector_length(s), k, ek) :
    {Codec.require(Bool.and(Nat.is_lt(0n, _), Nat.is_eq(Codec.count(chu4(ws)), _)), Codec.aggregate(Codec.parts(chu4(ws), S.Repeat{S.Unsigned{P.U128{}}}), SSC.times(_, SSC.fixed_size(S.Unsigned{P.U128{}})))) == Some{[S.Fixed{SF.limbs(ws)}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(Nat, Codec.count(chu4(ws)), k, cnt_chu4(k, ws, hl2)) :
    {Codec.require(Bool.and(Nat.is_lt(0n, k), Nat.is_eq(_, k)), Codec.aggregate(Codec.parts(chu4(ws), S.Repeat{S.Unsigned{P.U128{}}}), SSC.times(k, SSC.fixed_size(S.Unsigned{P.U128{}})))) == Some{[S.Fixed{SF.limbs(ws)}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(Bool, Nat.is_lt(0n, k), True{}, hk0) :
    {Codec.require(Bool.and(_, Nat.is_eq(k, k)), Codec.aggregate(Codec.parts(chu4(ws), S.Repeat{S.Unsigned{P.U128{}}}), SSC.times(k, SSC.fixed_size(S.Unsigned{P.U128{}})))) == Some{[S.Fixed{SF.limbs(ws)}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(Bool, Nat.is_eq(k, k), True{}, F.nat__is_eq_refl(k)) :
    {Codec.require(Bool.and(True{}, _), Codec.aggregate(Codec.parts(chu4(ws), S.Repeat{S.Unsigned{P.U128{}}}), SSC.times(k, SSC.fixed_size(S.Unsigned{P.U128{}})))) == Some{[S.Fixed{SF.limbs(ws)}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(Maybe<&2, +List<S.Part>>, Codec.parts(chu4(ws), S.Repeat{S.Unsigned{P.U128{}}}), Some{SF.fparts(cw4(ws))}, prt_chu4(k, ws, hl2)) :
    {Codec.require(Bool.and(True{}, True{}), Codec.aggregate(_, SSC.times(k, SSC.fixed_size(S.Unsigned{P.U128{}})))) == Some{[S.Fixed{SF.limbs(ws)}]} : Maybe<&2, +List<S.Part>>}
  %flt4(k, ws, hl2) :
    {Codec.aggregate(Some{SF.fparts(cw4(ws))}, SSC.times(k, SSC.fixed_size(S.Unsigned{P.U128{}}))) == Some{[S.Fixed{_}]} : Maybe<&2, +List<S.Part>>}
  AS.agg(cw4(ws), AS.unsome(SSC.times(k, SSC.fixed_size(S.Unsigned{P.U128{}}))), N, hN2, hf)

def chu8(ws: List<&2, U32>) -> S.Value:
  match ws:
    case Nil{}: S.EmptyItems{}
    case Con{w0, r0}:
      match r0:
        case Nil{}: S.EmptyItems{}
        case Con{w1, r1}:
          match r1:
            case Nil{}: S.EmptyItems{}
            case Con{w2, r2}:
              match r2:
                case Nil{}: S.EmptyItems{}
                case Con{w3, r3}:
                  match r3:
                    case Nil{}: S.EmptyItems{}
                    case Con{w4, r4}:
                      match r4:
                        case Nil{}: S.EmptyItems{}
                        case Con{w5, r5}:
                          match r5:
                            case Nil{}: S.EmptyItems{}
                            case Con{w6, r6}:
                              match r6:
                                case Nil{}: S.EmptyItems{}
                                case Con{w7, r}: S.Items{S.UnsignedValue{P.UInt{w0, w1, w2, w3, w4, w5, w6, w7}}, chu8(r)}

def cnt_chu8_z(+ws: List<&2, U32>, +hl: {F.spec_common__length(U32, ws) == 0n : Nat}) -> {Codec.count(chu8(ws)) == 0n : Nat}:
