                                    case Con{+w8, +r8}:
                                      match r8:
                                        case Nil{}: Empty.absurd({Codec.parts(ch12(Con{w0, Con{w1, Con{w2, Con{w3, Con{w4, Con{w5, Con{w6, Con{w7, Con{w8, Nil{}}}}}}}}}}), S.Repeat{S.ByteVector{48n}}) == Some{SF.fparts(cw12(Con{w0, Con{w1, Con{w2, Con{w3, Con{w4, Con{w5, Con{w6, Con{w7, Con{w8, Nil{}}}}}}}}}}))} : Maybe<&2, +List<S.Part>>}, F.nat__zero_succ(2n+m12(q), peel(9n, 0n, 3n+m12(q), hl)))
                                        case Con{+w9, +r9}:
