        case Nil{}: Empty.absurd({Codec.parts(ch12(Con{w0, Nil{}}), S.Repeat{S.ByteVector{48n}}) == Some{SF.fparts(cw12(Con{w0, Nil{}}))} : Maybe<&2, +List<S.Part>>}, F.nat__zero_succ(10n+m12(q), peel(1n, 0n, 11n+m12(q), hl)))
        case Con{+w1, +r1}:
          match r1:
            case Nil{}: Empty.absurd({Codec.parts(ch12(Con{w0, Con{w1, Nil{}}}), S.Repeat{S.ByteVector{48n}}) == Some{SF.fparts(cw12(Con{w0, Con{w1, Nil{}}}))} : Maybe<&2, +List<S.Part>>}, F.nat__zero_succ(9n+m12(q), peel(2n, 0n, 10n+m12(q), hl)))
