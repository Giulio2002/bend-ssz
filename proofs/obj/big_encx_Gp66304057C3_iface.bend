law sizex:
  for +m: MW
  for +hok: {OK(m) == True{} : Bool}
  {ProgressiveVarTestStruct_e.Gp66304057C3_size(TH(m)) == (TH(m), SZ(m)) : ProgressiveVarTestStruct_d.Gp66304057C3 & U32}
def sizex(m, hok):
  match m:
    case MW{+f_A, +m_f_B, +m_f_C}: sizeC(f_A, m_f_B, m_f_C, hok)

