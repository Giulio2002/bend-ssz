def VarTestStruct_root_valid(-o: VarTestStruct_d.VarTestStruct, +s: S.Schema, +es: {s == Spec.VarTestStruct() : S.Schema}, +rep: RT_L.rep_VarTestStruct(o, s))
    -> {VD.root_valid(RT_L.v_VarTestStruct(o), s) == True{} : Bool}:
  vr_VarTestStruct(o, s, rep, OS.DV0(), {==}, RT.VarTestStruct_ok(s, es, OS.DV0(), {==}), RT.VarTestStruct_eqs(s, es))

