def Gt0B0C03B454_h(-h: B.Buf, +hl: Nat, +ehl: {hl == 64n : Nat}, +w0: U32, +w1: U32, +w2: U32, +w3: U32, +w4: U32, +w5: U32, +w6: U32, +w7: U32, +w8: U32, +w9: U32, +w10: U32, +w11: U32, +w12: U32, +w13: U32, +w14: U32, +w15: U32, +t: Word(1n))
    -> RR.roots(S.BitsValue{BLP.btk(513n, BLP.bitsof([w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11, w12, w13, w14, w15, U32{WSp.join(1n, 31n, t, Word.zero(31n))}]))}, Spec.Gt0B0C03B454(), [D.bytes(Pair.snd(B.Buf, D.Digest, bitvector_513_h.bv513_root(hl, h, bitvector_513_d.Bitvector513{w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11, w12, w13, w14, w15, U32{WSp.join(1n, 31n, t, Word.zero(31n))}}, 0)))]):
  match t:
    case WCon{+a0, WNil{}}:
      %Equal.sym(B.Buf & D.Digest, bitvector_513_h.bv513_root(hl, h, bitvector_513_d.Bitvector513{w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11, w12, w13, w14, w15, U32{WSp.join(1n, 31n, WCon{a0, WNil{}}, Word.zero(31n))}}, 0), (h, MD.rtree(2n, True{}, hl, [D.D{B.swap32(w0), B.swap32(w1), B.swap32(w2), B.swap32(w3), B.swap32(w4), B.swap32(w5), B.swap32(w6), B.swap32(w7)}, D.D{B.swap32(w8), B.swap32(w9), B.swap32(w10), B.swap32(w11), B.swap32(w12), B.swap32(w13), B.swap32(w14), B.swap32(w15)}, D.D{B.swap32(U32{WSp.join(1n, 31n, WCon{a0, WNil{}}, Word.zero(31n))}), 0, 0, 0, 0, 0, 0, 0}], 0n)), Gt0B0C03B454_st(hl, h, w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11, w12, w13, w14, w15, a0)) :
        RR.roots(S.BitsValue{BLP.btk(513n, BLP.bitsof([w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11, w12, w13, w14, w15, U32{WSp.join(1n, 31n, WCon{a0, WNil{}}, Word.zero(31n))}]))}, Spec.Gt0B0C03B454(), [D.bytes(Pair.snd(B.Buf, D.Digest, _))])
      Gt0B0C03B454_fin(h, MD.rtree(2n, True{}, hl, [D.D{B.swap32(w0), B.swap32(w1), B.swap32(w2), B.swap32(w3), B.swap32(w4), B.swap32(w5), B.swap32(w6), B.swap32(w7)}, D.D{B.swap32(w8), B.swap32(w9), B.swap32(w10), B.swap32(w11), B.swap32(w12), B.swap32(w13), B.swap32(w14), B.swap32(w15)}, D.D{B.swap32(U32{WSp.join(1n, 31n, WCon{a0, WNil{}}, Word.zero(31n))}), 0, 0, 0, 0, 0, 0, 0}], 0n), w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11, w12, w13, w14, w15, a0, Gt0B0C03B454_g(hl, ehl, w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11, w12, w13, w14, w15, a0))
def Gt0B0C03B454_lawg(-h: B.Buf, +hl: Nat, +ehl: {hl == 64n : Nat}, +o: bitvector_513_d.Bitvector513, +e: {LV.Gt0B0C03B454_last(o) == U32{WSp.join(1n, 31n, WSp.take(1n, 32n, PD.bits(LV.Gt0B0C03B454_last(o))), Word.zero(31n))} : U32})
    -> RR.roots(S.BitsValue{LV.Gt0B0C03B454_bits(o)}, Spec.Gt0B0C03B454(), [D.bytes(Pair.snd(B.Buf, D.Digest, bitvector_513_h.bv513_root(hl, h, o, 0)))]):
  match o:
    case bitvector_513_d.Bitvector513{+w0, +w1, +w2, +w3, +w4, +w5, +w6, +w7, +w8, +w9, +w10, +w11, +w12, +w13, +w14, +w15, +w16}:
      %Equal.sym(U32, w16, U32{WSp.join(1n, 31n, WSp.take(1n, 32n, PD.bits(w16)), Word.zero(31n))}, e) :
        RR.roots(S.BitsValue{BLP.btk(513n, BLP.bitsof([w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11, w12, w13, w14, w15, _]))}, Spec.Gt0B0C03B454(), [D.bytes(Pair.snd(B.Buf, D.Digest, bitvector_513_h.bv513_root(hl, h, bitvector_513_d.Bitvector513{w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11, w12, w13, w14, w15, _}, 0)))])
      Gt0B0C03B454_h(h, hl, ehl, w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11, w12, w13, w14, w15, WSp.take(1n, 32n, PD.bits(w16)))
# Gt0B0C03B454: for every object whose bits past 513 are zero, the runtime root is a
# specification root of its bits.
law Gt0B0C03B454_root_correct:
  for -h: B.Buf
  for +o: bitvector_513_d.Bitvector513
  for +e: {LV.Gt0B0C03B454_last(o) == U32{WSp.join(1n, 31n, WSp.take(1n, 32n, PD.bits(LV.Gt0B0C03B454_last(o))), Word.zero(31n))} : U32}
  RR.roots(S.BitsValue{LV.Gt0B0C03B454_bits(o)}, Spec.Gt0B0C03B454(), [D.bytes(Pair.snd(B.Buf, D.Digest, bitvector_513_h.Gt0B0C03B454_hash_tree_root(h, o)))])
def Gt0B0C03B454_root_correct(h, o, e):
  %Equal.sym(B.Buf & D.Digest, bitvector_513_h.Gt0B0C03B454_hash_tree_root(h, o), bitvector_513_h.bv513_root(64n, h, o, 0), Gt0B0C03B454_htr(h, o)) :
    RR.roots(S.BitsValue{LV.Gt0B0C03B454_bits(o)}, Spec.Gt0B0C03B454(), [D.bytes(Pair.snd(B.Buf, D.Digest, _))])
  Gt0B0C03B454_lawg(h, 64n, {==}, o, e)

