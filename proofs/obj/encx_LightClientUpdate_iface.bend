def TH(m: MW) -> FuluLightClientUpdate_d.LightClientUpdate:
  match m:
    case MW{+wR}: K.OBJC(wR)
def OK(m: MW) -> Bool:
  match m:
    case MW{+wR}: OKT(wR)
def OKW(m: MW) -> Bool:
  match m:
    case MW{+wR}: OKTW(wR)
def ENC(m: MW) -> +List<U32>:
  match m:
    case MW{+wR}: K.ENCC(wR)
def VAL(m: MW) -> S.Value:
  match m:
    case MW{+wR}: VALC(wR)
def SZ(m: MW) -> U32:
  match m:
    case MW{+wR}: K.SZC(wR)
def XQ(+q: Nat, +r: Nat) -> U32: U32.from_nat(Nat.add(A.quad(q), r))
def PUTX(m: MW, +dd: Nat, +D: FD.array__Tree<U32>, +q: Nat, +r: Nat) -> FD.array__Tree<U32>:
  match m:
    case MW{+wR}: K.PUTC(wR, dd, D, XQ(q, r), q, r)
def PADB(+r: Nat, m: MW) -> Nat: WD.PADB(r, List.length(&2, U32, ENC(m)))

