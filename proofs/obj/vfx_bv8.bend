# a byte: the embedding of its eight bits
def bvp8(+w8: Word(8n)) -> {Codec.parts(VBN(PD.embed8(w8)), S.BitVector{8n}) == Some{[S.Fixed{[PD.embed8(w8)]}]} : Maybe<&2, +List<S.Part>>}:
  match w8:
    case WCon{+a0, WCon{+a1, WCon{+a2, WCon{+a3, WCon{+a4, WCon{+a5, WCon{+a6, WCon{+a7, WNil{}}}}}}}}}: z7(a0, a1, a2, a3, a4, a5, a6, a7)

def prt(+d: Nat, +t: FD.array__Tree<U32>, +x: Nat, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hb: {Nat.is_le(Nat.add(x, 1n), A.quad(VB.pw(d))) == True{} : Bool},
    +s: S.Schema, +es: {s == S.BitVector{8n} : S.Schema})
    -> {Codec.parts(VAL(t, x), s) == Some{[S.Fixed{UW.WX(t, x, 1n)}]} : Maybe<&2, +List<S.Part>>}:
  +e1 = wx1(d, t, x, pf, hb)
  +dm = FD.logic__subst(+List<U32>, z => {SP.bytes_domain(z) == True{} : Bool}, UW.WX(t, x, 1n), [BX(t, x)], e1, UW.domWX(t, x, 1n))
  %Equal.sym(S.Schema, s, S.BitVector{8n}, es) : {Codec.parts(VAL(t, x), _) == Some{[S.Fixed{UW.WX(t, x, 1n)}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(+List<U32>, UW.WX(t, x, 1n), [BX(t, x)], e1) : {Codec.parts(VAL(t, x), S.BitVector{8n}) == Some{[S.Fixed{_}]} : Maybe<&2, +List<S.Part>>}
  %VBL.ebyte(BX(t, x), FD.logic__and_left(U32.is_lt(BX(t, x), 256), True{}, dm)) :
    {Codec.parts(VBN(_), S.BitVector{8n}) == Some{[S.Fixed{[_]}]} : Maybe<&2, +List<S.Part>>}
  bvp8(VBL.W8(BX(t, x)))

