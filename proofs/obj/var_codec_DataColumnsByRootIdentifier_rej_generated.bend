# The offset word's index is below 2^d.
def hpoD(+d: Nat, +n: U32, +hn: {Nat.is_le(U32.to_nat(n), A.quad(VB.pw(d))) == True{} : Bool}, +hF: {Nat.is_le(36n, U32.to_nat(n)) == True{} : Bool})
    -> {Nat.is_lt(8n, VB.pw(d)) == True{} : Bool}:
  F.nat__lt_le_trans(8n, 9n, VB.pw(d), {==}, VC.quad_inv(9n, VB.pw(d), F.nat__le_trans(36n, U32.to_nat(n), A.quad(VB.pw(d)), hF, hn)))

