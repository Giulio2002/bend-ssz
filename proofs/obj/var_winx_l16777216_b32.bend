# The spec bytes ys of any value of the list are whole records, at most 16777216.
law linvr:
  for +h: S.Value
  for +ys: +List<U32>
  for +e: {Codec.bytes(Codec.parts(h, S.ListOf{S.ByteVector{32n}, U32.to_nat(16777216)})) == Some{ys} : Maybe<&2, +List<U32>>}
  VMR.LF(ys, 32n, U32.to_nat(16777216))
def linvr(h, ys, e):
  match h:
    case S.Sequence{+its}: lb(its, ys, Nat.is_le(Codec.count(its), U32.to_nat(16777216)), {==}, e)
    case S.BooleanValue{+b0}: Empty.absurd(VMR.LF(ys, 32n, U32.to_nat(16777216)), FD.logic__none_some(+List<U32>, ys, e))
    case S.UnsignedValue{+u0}: Empty.absurd(VMR.LF(ys, 32n, U32.to_nat(16777216)), FD.logic__none_some(+List<U32>, ys, e))
    case S.BytesValue{+xs0}: Empty.absurd(VMR.LF(ys, 32n, U32.to_nat(16777216)), FD.logic__none_some(+List<U32>, ys, e))
    case S.BitsValue{+bs0}: Empty.absurd(VMR.LF(ys, 32n, U32.to_nat(16777216)), FD.logic__none_some(+List<U32>, ys, e))
    case S.Items{+hd0, +tl0}: Empty.absurd(VMR.LF(ys, 32n, U32.to_nat(16777216)), FD.logic__none_some(+List<U32>, ys, e))
    case S.EmptyItems{}: Empty.absurd(VMR.LF(ys, 32n, U32.to_nat(16777216)), FD.logic__none_some(+List<U32>, ys, e))
    case S.Selected{+sel0, +sv0}: Empty.absurd(VMR.LF(ys, 32n, U32.to_nat(16777216)), FD.logic__none_some(+List<U32>, ys, e))
    case S.NullValue{}: Empty.absurd(VMR.LF(ys, 32n, U32.to_nat(16777216)), FD.logic__none_some(+List<U32>, ys, e))

def chk_i(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat},
