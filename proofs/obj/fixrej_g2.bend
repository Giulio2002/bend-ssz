def vec_uint64_16_rj(+bs: +List<U32>, +hn: {Nat.is_eq(List.length(&2, U32, bs), 128n) == False{} : Bool}, +v: S.Value, e: Decoding.decodes(GS.vec_uint64_16(), bs, v)) -> Empty:
  VRF.lo(SS.fixed_size(GS.vec_uint64_16()), 128n, bs, Codec.parts(v, GS.vec_uint64_16()), DS.facts(v, GS.vec_uint64_16(), {==}), {==}, e, hn)
def vec_uint64_16_decode_reject(+bs: +List<U32>, +hn: {Nat.is_eq(List.length(&2, U32, bs), 128n) == False{} : Bool}) -> Decoding.outside_image(GS.vec_uint64_16(), bs):
  v => e => vec_uint64_16_rj(bs, hn, v, e)

