    -> {L == U32{Word.shr.pad(31n, VE.winit(31n, VE.bits32(L)))} : U32}:
  VE.small_pad(L, 24n, {==}, FD.logic__subst(Nat, z => {Nat.is_lt(z, VB.pw(24n)) == True{} : Bool}, A.quad(m), U32.to_nat(L), Equal.sym(Nat, U32.to_nat(L), A.quad(m), em), qlt(N0, N1, N2, c0, c1, c2, ec0, ec1, ec2, hc0, hc1, hc2, m, hm)))
