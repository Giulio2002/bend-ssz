    -> {T.v4_b32_pa31(57, FD.array__thaw(U32, X), (FD.array__thaw(U32, TP), VB.slot(TP, 31n))) == (FD.array__thaw(U32, VF.updv([VB.slot(TP, 31n)], dd, X, 88n)), FD.array__thaw(U32, TP)) : Array<U32> & Array<U32>}:
  %Equal.sym(Array<U32>, Array.set(U32, FD.array__thaw(U32, X), 88, VB.slot(TP, 31n)), FD.array__thaw(U32, FD.array__upd(U32, dd, X, 88n, VB.slot(TP, 31n))), VB.set_n(dd, X, 88, 88n, VB.slot(TP, 31n), {==}, hd32, FD.nat__lt_le_trans(88n, 89n, VB.pw(dd), {==}, h89), pfX)) :
    {(_, FD.array__thaw(U32, TP)) == (FD.array__thaw(U32, VF.updv([VB.slot(TP, 31n)], dd, X, 88n)), FD.array__thaw(U32, TP)) : Array<U32> & Array<U32>}
  {==}

