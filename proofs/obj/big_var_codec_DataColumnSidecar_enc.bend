# ---- the inclusion proof: 32 words from TP to word 57 -------------------------------------------

def pa31(+dd: Nat, +X: FD.array__Tree<U32>, +TP: FD.array__Tree<U32>, +dp: Nat, +pfX: {FD.array__perfect(U32, dd, X) == True{} : Bool}, +hd32: {Nat.is_lt(dd, 32n) == True{} : Bool},
