  VE.padd_ok(356, N0, VE.winit(31n, VE.bits32(356)), VE.winit(31n, VE.bits32(N0)), {==}, ltN(N0, N1, N2, c0, c1, c2, ec0, ec1, ec2, hc0, hc1, hc2, N0, M0(c0), ec0, lM0N(c0, c1, c2)))
