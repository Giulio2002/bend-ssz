# no top bit: the counts are below 2^24
def ltN(+N0: U32, +N1: U32, +N2: U32, +c0: Nat, +c1: Nat, +c2: Nat,
    +ec0: {U32.to_nat(N0) == A.quad(M0(c0)) : Nat}, +ec1: {U32.to_nat(N1) == A.quad(M1(c1)) : Nat}, +ec2: {U32.to_nat(N2) == A.quad(M2(c2)) : Nat},
