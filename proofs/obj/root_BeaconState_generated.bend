def BeaconState_rc(-h: B.Buf, -o: FuluBeaconState_d.BeaconState, +s: S.Schema, +es: {s == Spec.BeaconState() : S.Schema}, +rep: ST_L.rep_BeaconState(o, s), +dv: OS.DV, +edv: {dv == OS.DV0() : OS.DV})
    -> RR.roots(ST_L.v_BeaconState(o), s, [D.bytes(Pair.snd(FuluBeaconState_d.BeaconState, D.Digest, Pair.snd(B.Buf, FuluBeaconState_d.BeaconState & D.Digest, FuluBeaconState_h.BeaconState_hash_tree_root(h, o))))]):
  %Equal.sym(B.Buf & (FuluBeaconState_d.BeaconState & D.Digest), FuluBeaconState_h.BeaconState_root(64n, h, o, 0), (h, (o, ST.d_BeaconState(64n, o))), ST.st_BeaconState(64n, h, o, 0, s, rep)) :
    RR.roots(ST_L.v_BeaconState(o), s, [D.bytes(Pair.snd(FuluBeaconState_d.BeaconState, D.Digest, Pair.snd(B.Buf, FuluBeaconState_d.BeaconState & D.Digest, _)))])
  ST.rs_BeaconState(64n, {==}, h, o, s, rep, dv, edv, BeaconState_ok(s, es, dv, edv), BeaconState_eqs(s, es))
law BeaconState_root_correct:
  for -h: B.Buf
  for -o: FuluBeaconState_d.BeaconState
  for +s: S.Schema
  for +es: {s == Spec.BeaconState() : S.Schema}
  for +rep: ST_L.rep_BeaconState(o, s)
  RR.roots(ST_L.v_BeaconState(o), s, [D.bytes(Pair.snd(FuluBeaconState_d.BeaconState, D.Digest, Pair.snd(B.Buf, FuluBeaconState_d.BeaconState & D.Digest, FuluBeaconState_h.BeaconState_hash_tree_root(h, o))))])
def BeaconState_root_correct(h, o, s, es, rep): BeaconState_rc(h, o, s, es, rep, OS.DV0(), {==})

