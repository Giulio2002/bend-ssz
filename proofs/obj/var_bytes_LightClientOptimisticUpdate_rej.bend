# Every byte string the spec relates to a value has the checked shape.
law inv_v:
  for +v: S.Value
  for +bs: +List<U32>
  for +e: {Codec.encoding_for_legal_type(Spec.LightClientOptimisticUpdate(), v) == Some{bs} : Maybe<&2, +List<U32>>}
  FACTS(bs)
def inv_v(v, bs, e):
  match v:
    case S.BooleanValue{+b0}: Empty.absurd(FACTS(bs), F.logic__none_some(+List<U32>, bs, e))
    case S.UnsignedValue{+u0}: Empty.absurd(FACTS(bs), F.logic__none_some(+List<U32>, bs, e))
    case S.BytesValue{+xs0}: Empty.absurd(FACTS(bs), F.logic__none_some(+List<U32>, bs, e))
    case S.BitsValue{+bs0}: Empty.absurd(FACTS(bs), F.logic__none_some(+List<U32>, bs, e))
    case S.Sequence{+items}: st0(items, bs, e)
    case S.Items{+hd0, +tl0}: Empty.absurd(FACTS(bs), F.logic__none_some(+List<U32>, bs, e))
    case S.EmptyItems{}: Empty.absurd(FACTS(bs), F.logic__none_some(+List<U32>, bs, e))
    case S.Selected{+sel0, +sv0}: Empty.absurd(FACTS(bs), F.logic__none_some(+List<U32>, bs, e))
    case S.NullValue{}: Empty.absurd(FACTS(bs), F.logic__none_some(+List<U32>, bs, e))

# ---- the buffer's bytes ------------------------------------------------------------------

law wdr0_eq:
  for +n: Nat
  for +W: List<&2, U32>
  {VS.wdr0(n, W) == VB.wdr(n, W) : List<&2, U32>}
def wdr0_eq(n, W):
  match n W:
    case 0n _: {==}
    case 1n+ +p Nil{}: {==}
    case 1n+ +p Con{+h, +t}: wdr0_eq(p, t)

law len_eq:
  for +W: List<&2, U32>
  {List.length(&2, U32, W) == F.spec_common__length(U32, W) : Nat}
def len_eq(W):
  match W:
    case Nil{}: {==}
    case Con{+h, +t}:
      %Equal.sym(Nat, List.length(&2, U32, t), F.spec_common__length(U32, t), len_eq(t)) : {1n+_ == 1n+F.spec_common__length(U32, t) : Nat}
      {==}

def SL(t: F.array__Tree<U32>) -> List<&2, U32>: F.array__slots(U32, t)

def lenS(+d: Nat, +t: F.array__Tree<U32>, +pf: {F.array__perfect(U32, d, t) == True{} : Bool})
    -> {List.length(&2, U32, FX.limbs(SL(t))) == A.quad(VB.pw(d)) : Nat}:
  %Equal.sym(Nat, List.length(&2, U32, FX.limbs(SL(t))), FX.wlen(SL(t)), VS.len_limbs(SL(t))) : {_ == A.quad(VB.pw(d)) : Nat}
  %Equal.sym(Nat, FX.wlen(SL(t)), A.quad(List.length(&2, U32, SL(t))), VS.wlen_quad(SL(t))) : {_ == A.quad(VB.pw(d)) : Nat}
  %Equal.sym(Nat, List.length(&2, U32, SL(t)), VB.pw(d), Equal.trans(Nat, List.length(&2, U32, SL(t)), F.spec_common__length(U32, SL(t)), VB.pw(d), len_eq(SL(t)), F.array__slots_length(U32, d, t, pf))) : {A.quad(_) == A.quad(VB.pw(d)) : Nat}
  {==}

def lenVW(+d: Nat, +t: F.array__Tree<U32>, +n: U32, +pf: {F.array__perfect(U32, d, t) == True{} : Bool},
    +hn: {Nat.is_le(U32.to_nat(n), A.quad(VB.pw(d))) == True{} : Bool})
    -> {List.length(&2, U32, DC.VW(t, n)) == U32.to_nat(n) : Nat}:
  VS.bt_len(U32.to_nat(n), FX.limbs(SL(t)),
    F.logic__subst(Nat, z => {Nat.is_le(U32.to_nat(n), z) == True{} : Bool}, A.quad(VB.pw(d)), List.length(&2, U32, FX.limbs(SL(t))), Equal.sym(Nat, List.length(&2, U32, FX.limbs(SL(t))), A.quad(VB.pw(d)), lenS(d, t, pf)), hn))

# The offset word's index is below 2^d.
def hpoS(+d: Nat, +t: F.array__Tree<U32>, +n: U32, +pf: {F.array__perfect(U32, d, t) == True{} : Bool},
    +hn: {Nat.is_le(U32.to_nat(n), A.quad(VB.pw(d))) == True{} : Bool}, +hF: {Nat.is_le(172n, U32.to_nat(n)) == True{} : Bool})
    -> {Nat.is_lt(0n, VB.len(SL(t))) == True{} : Bool}:
  %Equal.sym(Nat, VB.len(SL(t)), VB.pw(d), F.array__slots_length(U32, d, t, pf)) : {Nat.is_lt(0n, _) == True{} : Bool}
  F.nat__lt_le_trans(0n, 43n, VB.pw(d), {==}, VC.quad_inv(43n, VB.pw(d), F.nat__le_trans(172n, U32.to_nat(n), A.quad(VB.pw(d)), hF, hn)))
# The four bytes at the offset field are the limbs of the offset word.
def byteP(+t: F.array__Tree<U32>, +n: U32, +X: Nat, +en: {U32.to_nat(n) == 172n+X : Nat}, +hp: {Nat.is_lt(0n, VB.len(SL(t))) == True{} : Bool})
    -> {VS.bt(4n, VS.bdr(0n, DC.VW(t, n))) == FX.limbs([VB.slot(t, 0n)]) : +List<U32>}:
  %Equal.sym(Nat, U32.to_nat(n), 172n+X, en) : {VS.bt(4n, VS.bdr(0n, VS.bt(_, FX.limbs(SL(t))))) == FX.limbs([VB.slot(t, 0n)]) : +List<U32>}
  %Equal.sym(+List<U32>, VS.bdr(0n, VS.bt(172n+X, FX.limbs(SL(t)))), VS.bt(172n+X, VS.bdr(0n, FX.limbs(SL(t)))), VS.bdr_bt(0n, 172n+X, FX.limbs(SL(t)))) :
    {VS.bt(4n, _) == FX.limbs([VB.slot(t, 0n)]) : +List<U32>}
  %Equal.sym(+List<U32>, VS.bt(4n, VS.bt(172n+X, VS.bdr(0n, FX.limbs(SL(t))))), VS.bt(4n, VS.bdr(0n, FX.limbs(SL(t)))), VS.bt_bt(4n, 168n+X, VS.bdr(0n, FX.limbs(SL(t))))) :
    {_ == FX.limbs([VB.slot(t, 0n)]) : +List<U32>}
  %Equal.sym(+List<U32>, VS.bdr(0n, FX.limbs(SL(t))), FX.limbs(VS.wdr0(0n, SL(t))), VS.bdr_limbs(0n, SL(t))) :
    {VS.bt(4n, _) == FX.limbs([VB.slot(t, 0n)]) : +List<U32>}
  %Equal.sym(+List<U32>, VS.bt(4n, FX.limbs(VS.wdr0(0n, SL(t)))), FX.limbs(VS.wtake(1n, VS.wdr0(0n, SL(t)))), VS.bt_limbs(1n, VS.wdr0(0n, SL(t)))) :
    {_ == FX.limbs([VB.slot(t, 0n)]) : +List<U32>}
  %Equal.sym(List<&2, U32>, VS.wdr0(0n, SL(t)), VB.wdr(0n, SL(t)), wdr0_eq(0n, SL(t))) :
    {FX.limbs(VS.wtake(1n, _)) == FX.limbs([VB.slot(t, 0n)]) : +List<U32>}
  %Equal.sym(List<&2, U32>, VS.wtake(1n, VB.wdr(0n, SL(t))), Con{F.flat__nthc(SL(t), 0n), VS.wtake(0n, VB.wdr(1n+0n, SL(t)))}, VB.wt_eta(0n, 0n, SL(t), hp)) :
    {FX.limbs(_) == FX.limbs([VB.slot(t, 0n)]) : +List<U32>}
  {==}

def q0(xs: +List<U32>) -> U32:
  match xs:
    case Con{h, t}: h
    case Nil{}: 0
def q1(xs: +List<U32>) -> U32:
  match xs:
    case Con{h, t}: q0(t)
    case Nil{}: 0
def q2(xs: +List<U32>) -> U32:
  match xs:
    case Con{h, t}: q1(t)
    case Nil{}: 0
def q3(xs: +List<U32>) -> U32:
  match xs:
    case Con{h, t}: q2(t)
    case Nil{}: 0

# A word whose limbs are those of 172 is 172.
def wordFS(+x: U32, +h: {FX.limbs([x]) == [172, 0, 0, 0] : +List<U32>}) -> {x == 172 : U32}:
  Equal.trans(U32, x, BT.asm(B.byte_sel(0, x), B.byte_sel(1, x), B.byte_sel(2, x), B.byte_sel(3, x)), 172, BT.reassemble(x),
    BT.asm_cong(B.byte_sel(0, x), B.byte_sel(1, x), B.byte_sel(2, x), B.byte_sel(3, x), 172, 0, 0, 0,
      Equal.cong(+List<U32>, U32, l => q0(l), FX.limbs([x]), [172, 0, 0, 0], h),
      Equal.cong(+List<U32>, U32, l => q1(l), FX.limbs([x]), [172, 0, 0, 0], h),
      Equal.cong(+List<U32>, U32, l => q2(l), FX.limbs([x]), [172, 0, 0, 0], h),
      Equal.cong(+List<U32>, U32, l => q3(l), FX.limbs([x]), [172, 0, 0, 0], h)))


# ---- the window's bytes (for nesting) ------------------------------------------------------

def WV(t: F.array__Tree<U32>, +i: Nat, +len: U32) -> +List<U32>: VS.bt(U32.to_nat(len), FX.limbs(VB.wdr(i, SL(t))))

# Every value whose spec parts are one variable part has its bytes in the checked shape.
def inv_p(+v: S.Value, +bs: +List<U32>, +e: {Codec.parts(v, Spec.LightClientOptimisticUpdate()) == Some{[S.Variable{bs}]} : Maybe<&2, +List<S.Part>>}) -> FACTS(bs):
  inv_v(v, bs, Equal.cong(Maybe<&2, +List<S.Part>>, Maybe<&2, +List<U32>>, z => Codec.bytes(z), Codec.parts(v, Spec.LightClientOptimisticUpdate()), Some{[S.Variable{bs}]}, e))

def lenWV(+d: Nat, +t: F.array__Tree<U32>, +i: Nat, +len: U32, +pf: {F.array__perfect(U32, d, t) == True{} : Bool},
    +hw: {Nat.is_le(Nat.add(A.quad(i), U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool})
    -> {List.length(&2, U32, WV(t, i, len)) == U32.to_nat(len) : Nat}:
  VS.bt_len(U32.to_nat(len), FX.limbs(VB.wdr(i, SL(t))), VZ.win_room(d, t, i, len, pf, hw))

def haw(+len: U32, +X: Nat, +en: {U32.to_nat(len) == 172n+X : Nat}) -> {U32.is_le(172, len) == True{} : Bool}:
  F.logic__subst(Bool, z => {z == True{} : Bool}, Nat.is_le(172n, U32.to_nat(len)), U32.is_le(172, len), Equal.sym(Bool, U32.is_le(172, len), Nat.is_le(172n, U32.to_nat(len)), VU.le_u32(172, len)),
    F.logic__subst(Nat, z => {Nat.is_le(172n, z) == True{} : Bool}, 172n+X, U32.to_nat(len), Equal.sym(Nat, U32.to_nat(len), 172n+X, en), Order.below_sum(172n, X)))

# The four bytes at the window's offset field are the limbs of its offset word.
def bytePw(+d: Nat, +t: F.array__Tree<U32>, +i: Nat, +len: U32, +X: Nat, +en: {U32.to_nat(len) == 172n+X : Nat},
    +pf: {F.array__perfect(U32, d, t) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(A.quad(i), U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool})
    -> {VS.bt(4n, VS.bdr(0n, WV(t, i, len))) == FX.limbs([W.SPOw(t, i)]) : +List<U32>}:
  +hp = F.logic__subst(Nat, z => {Nat.is_lt(Nat.add(0n, i), z) == True{} : Bool}, VB.pw(d), VB.len(SL(t)), Equal.sym(Nat, VB.len(SL(t)), VB.pw(d), F.array__slots_length(U32, d, t, pf)),
    W.hiw(d, i, len, 0n, {==}, hw, haw(len, X, en)))
  %Equal.sym(Nat, U32.to_nat(len), 172n+X, en) : {VS.bt(4n, VS.bdr(0n, VS.bt(_, FX.limbs(VB.wdr(i, SL(t)))))) == FX.limbs([W.SPOw(t, i)]) : +List<U32>}
  %Equal.sym(+List<U32>, VS.bdr(0n, VS.bt(172n+X, FX.limbs(VB.wdr(i, SL(t))))), VS.bt(172n+X, VS.bdr(0n, FX.limbs(VB.wdr(i, SL(t))))), VS.bdr_bt(0n, 172n+X, FX.limbs(VB.wdr(i, SL(t))))) :
    {VS.bt(4n, _) == FX.limbs([W.SPOw(t, i)]) : +List<U32>}
  %Equal.sym(+List<U32>, VS.bt(4n, VS.bt(172n+X, VS.bdr(0n, FX.limbs(VB.wdr(i, SL(t)))))), VS.bt(4n, VS.bdr(0n, FX.limbs(VB.wdr(i, SL(t))))), VS.bt_bt(4n, 168n+X, VS.bdr(0n, FX.limbs(VB.wdr(i, SL(t)))))) :
    {_ == FX.limbs([W.SPOw(t, i)]) : +List<U32>}
  %Equal.sym(+List<U32>, VS.bdr(0n, FX.limbs(VB.wdr(i, SL(t)))), FX.limbs(VS.wdr0(0n, VB.wdr(i, SL(t)))), VS.bdr_limbs(0n, VB.wdr(i, SL(t)))) :
    {VS.bt(4n, _) == FX.limbs([W.SPOw(t, i)]) : +List<U32>}
  %Equal.sym(+List<U32>, VS.bt(4n, FX.limbs(VS.wdr0(0n, VB.wdr(i, SL(t))))), FX.limbs(VS.wtake(1n, VS.wdr0(0n, VB.wdr(i, SL(t))))), VS.bt_limbs(1n, VS.wdr0(0n, VB.wdr(i, SL(t))))) :
    {_ == FX.limbs([W.SPOw(t, i)]) : +List<U32>}
  %Equal.sym(List<&2, U32>, VS.wdr0(0n, VB.wdr(i, SL(t))), VB.wdr(0n, VB.wdr(i, SL(t))), wdr0_eq(0n, VB.wdr(i, SL(t)))) :
    {FX.limbs(VS.wtake(1n, _)) == FX.limbs([W.SPOw(t, i)]) : +List<U32>}
  %Equal.sym(List<&2, U32>, VB.wdr(0n, VB.wdr(i, SL(t))), VB.wdr(Nat.add(i, 0n), SL(t)), VF.wdr_add(0n, i, SL(t))) :
    {FX.limbs(VS.wtake(1n, _)) == FX.limbs([W.SPOw(t, i)]) : +List<U32>}
  %Equal.sym(Nat, Nat.add(i, 0n), Nat.add(0n, i), F.nat__add_comm(i, 0n)) :
    {FX.limbs(VS.wtake(1n, VB.wdr(_, SL(t)))) == FX.limbs([W.SPOw(t, i)]) : +List<U32>}
  %Equal.sym(List<&2, U32>, VS.wtake(1n, VB.wdr(Nat.add(0n, i), SL(t))), Con{F.flat__nthc(SL(t), Nat.add(0n, i)), VS.wtake(0n, VB.wdr(1n+Nat.add(0n, i), SL(t)))}, VB.wt_eta(0n, Nat.add(0n, i), SL(t), hp)) :
    {FX.limbs(_) == FX.limbs([W.SPOw(t, i)]) : +List<U32>}
  {==}

# The child's window: the bytes after the header.
def wv_dr(+t: F.array__Tree<U32>, +i: Nat, +len: U32, +X: Nat, +en: {U32.to_nat(len) == Nat.add(172n, X) : Nat})
    -> {VS.bdr(172n, WV(t, i, len)) == YR.WV(t, Nat.add(43n, i), W.LL(len)) : +List<U32>}:
  %Equal.sym(Nat, U32.to_nat(len), Nat.add(172n, U32.to_nat(W.LL(len))), Equal.sym(Nat, Nat.add(172n, U32.to_nat(W.LL(len))), U32.to_nat(len), W.enFS(len, haw(len, X, en)))) :
    {VS.bdr(172n, VS.bt(_, FX.limbs(VB.wdr(i, SL(t))))) == YR.WV(t, Nat.add(43n, i), W.LL(len)) : +List<U32>}
  %Equal.sym(+List<U32>, VS.bdr(172n, VS.bt(Nat.add(172n, U32.to_nat(W.LL(len))), FX.limbs(VB.wdr(i, SL(t))))), VS.bt(U32.to_nat(W.LL(len)), VS.bdr(172n, FX.limbs(VB.wdr(i, SL(t))))),
      VS.bdr_bt(172n, U32.to_nat(W.LL(len)), FX.limbs(VB.wdr(i, SL(t))))) :
    {_ == YR.WV(t, Nat.add(43n, i), W.LL(len)) : +List<U32>}
  %Equal.sym(+List<U32>, VS.bdr(172n, FX.limbs(VB.wdr(i, SL(t)))), FX.limbs(VS.wdr0(43n, VB.wdr(i, SL(t)))), VS.bdr_limbs(43n, VB.wdr(i, SL(t)))) :
    {VS.bt(U32.to_nat(W.LL(len)), _) == YR.WV(t, Nat.add(43n, i), W.LL(len)) : +List<U32>}
  %Equal.sym(List<&2, U32>, VS.wdr0(43n, VB.wdr(i, SL(t))), VB.wdr(43n, VB.wdr(i, SL(t))), wdr0_eq(43n, VB.wdr(i, SL(t)))) :
    {VS.bt(U32.to_nat(W.LL(len)), FX.limbs(_)) == YR.WV(t, Nat.add(43n, i), W.LL(len)) : +List<U32>}
  %Equal.sym(List<&2, U32>, VB.wdr(43n, VB.wdr(i, SL(t))), VB.wdr(Nat.add(i, 43n), SL(t)), VF.wdr_add(43n, i, SL(t))) :
    {VS.bt(U32.to_nat(W.LL(len)), FX.limbs(_)) == YR.WV(t, Nat.add(43n, i), W.LL(len)) : +List<U32>}
  %Equal.sym(Nat, Nat.add(i, 43n), Nat.add(43n, i), F.nat__add_comm(i, 43n)) :
    {VS.bt(U32.to_nat(W.LL(len)), FX.limbs(VB.wdr(_, SL(t)))) == YR.WV(t, Nat.add(43n, i), W.LL(len)) : +List<U32>}
  {==}

# The window's checks hold when its offset is 172 and the child's window passes its checks.
def chk_truew(+t: F.array__Tree<U32>, +i: Nat, +len: U32, +X: Nat, +en: {U32.to_nat(len) == Nat.add(172n, X) : Nat},
    +epo: {W.SPOw(t, i) == 172 : U32}, +hY: {YW.CHKw(t, Nat.add(43n, i), W.LL(len)) == True{} : Bool}) -> {W.CHKw(t, i, len) == True{} : Bool}:
  %Equal.sym(Bool, U32.is_le(172, len), True{}, haw(len, X, en)) :
    {W.chk3(_, U32.is_eq(W.SPOw(t, i), 172), YW.CHKw(t, Nat.add(43n, i), W.LL(len))) == True{} : Bool}
  %Equal.sym(U32, W.SPOw(t, i), 172, epo) :
    {W.chk3(True{}, U32.is_eq(_, 172), YW.CHKw(t, Nat.add(43n, i), W.LL(len))) == True{} : Bool}
  hY

def rej_tail(+d: Nat, +t: F.array__Tree<U32>, +i: Nat, +len: U32, +pf: {F.array__perfect(U32, d, t) == True{} : Bool},
    +hw: {Nat.is_le(Nat.add(A.quad(i), U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool},
    +hb: {VS.bt(4n, VS.bdr(0n, WV(t, i, len))) == [172, 0, 0, 0] : +List<U32>}, +hv0: S.Value, +ys: +List<U32>,
    +hlen: {List.length(&2, U32, WV(t, i, len)) == Nat.add(172n, List.length(&2, U32, ys)) : Nat},
    +hdr: {VS.bdr(172n, WV(t, i, len)) == ys : +List<U32>},
    +hvp: {Codec.parts(hv0, Spec.LightClientHeader()) == Some{[S.Variable{ys}]} : Maybe<&2, +List<S.Part>>})
    -> {W.CHKw(t, i, len) == True{} : Bool}:
  +en = Equal.trans(Nat, U32.to_nat(len), List.length(&2, U32, WV(t, i, len)), Nat.add(172n, List.length(&2, U32, ys)), Equal.sym(Nat, List.length(&2, U32, WV(t, i, len)), U32.to_nat(len), lenWV(d, t, i, len, pf, hw)), hlen)
  +epo = wordFS(W.SPOw(t, i), Equal.trans(+List<U32>, FX.limbs([W.SPOw(t, i)]), VS.bt(4n, VS.bdr(0n, WV(t, i, len))), [172, 0, 0, 0],
    Equal.sym(+List<U32>, VS.bt(4n, VS.bdr(0n, WV(t, i, len))), FX.limbs([W.SPOw(t, i)]), bytePw(d, t, i, len, List.length(&2, U32, ys), en, pf, hw)), hb))
  +eys = Equal.trans(+List<U32>, ys, VS.bdr(172n, WV(t, i, len)), YR.WV(t, Nat.add(43n, i), W.LL(len)), Equal.sym(+List<U32>, VS.bdr(172n, WV(t, i, len)), ys, hdr),
    wv_dr(t, i, len, List.length(&2, U32, ys), en))
  fy = F.logic__subst(+List<U32>, z => YR.FACTS(z), ys, YR.WV(t, Nat.add(43n, i), W.LL(len)), eys, YR.inv_p(hv0, ys, hvp))
  chk_truew(t, i, len, List.length(&2, U32, ys), en, epo,
    YR.rej_facts(d, t, Nat.add(43n, i), W.LL(len), pf, W.hwY(d, i, len, hw, haw(len, List.length(&2, U32, ys), en)), fy))

def rej_p2(+d: Nat, +t: F.array__Tree<U32>, +i: Nat, +len: U32, +pf: {F.array__perfect(U32, d, t) == True{} : Bool},
    +hw: {Nat.is_le(Nat.add(A.quad(i), U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool},
    +hb: {VS.bt(4n, VS.bdr(0n, WV(t, i, len))) == [172, 0, 0, 0] : +List<U32>}, +hv0: S.Value, +ys: +List<U32>,
    +hlen: {List.length(&2, U32, WV(t, i, len)) == Nat.add(172n, List.length(&2, U32, ys)) : Nat},
    r3: DK.P2({VS.bdr(172n, WV(t, i, len)) == ys : +List<U32>}, {Codec.parts(hv0, Spec.LightClientHeader()) == Some{[S.Variable{ys}]} : Maybe<&2, +List<S.Part>>}))
    -> {W.CHKw(t, i, len) == True{} : Bool}:
  (+hdr, hvp) = r3
  rej_tail(d, t, i, len, pf, hw, hb, hv0, ys, hlen, hdr, hvp)

# A window whose bytes have the checked shape passes the window's checks.
def rej_facts(+d: Nat, +t: F.array__Tree<U32>, +i: Nat, +len: U32, +pf: {F.array__perfect(U32, d, t) == True{} : Bool},
    +hw: {Nat.is_le(Nat.add(A.quad(i), U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, facts: FACTS(WV(t, i, len)))
    -> {W.CHKw(t, i, len) == True{} : Bool}:
  (+hb, ex) = facts
  (+hv0, r1) = ex
  (+ys, r2) = r1
  (+hlen, r3) = r2
  rej_p2(d, t, i, len, pf, hw, hb, hv0, ys, hlen, r3)

# When the validator refuses, no value is related to the buffer's bytes.
law decode_reject:
  for +d: Nat
  for +t: F.array__Tree<U32>
  for +n: U32
  for +pf: {F.array__perfect(U32, d, t) == True{} : Bool}
  for +hn: {Nat.is_le(U32.to_nat(n), A.quad(VB.pw(d))) == True{} : Bool}
  for +hchk: {DC.CHK(t, n) == False{} : Bool}
  Decoding.outside_image(Spec.LightClientOptimisticUpdate(), DC.VW(t, n))
def decode_reject(d, t, n, pf, hn, hchk):
  v => e => F.logic__true_false(Equal.trans(Bool, True{}, DC.CHK(t, n), False{}, Equal.sym(Bool, DC.CHK(t, n), True{}, rej_facts(d, t, 0n, n, pf, hn, inv_v(v, DC.VW(t, n), e))), hchk))

# When the validator refuses, the decoder returns None and the buffer.
law decode_none:
  for +d: Nat
  for +t: F.array__Tree<U32>
  for +n: U32
  for +pf: {F.array__perfect(U32, d, t) == True{} : Bool}
  for +hd: {Nat.is_lt(d, 29n) == True{} : Bool}
  for +hn: {Nat.is_le(U32.to_nat(n), A.quad(VB.pw(d))) == True{} : Bool}
  for +hchk: {DC.CHK(t, n) == False{} : Bool}
  {FuluLightClientOptimisticUpdate_r.LightClientOptimisticUpdate_decode(DC.BF(t, n), n) == (DC.BF(t, n), None{}) : B.Buf & Maybe<&1, FuluLightClientOptimisticUpdate_d.LightClientOptimisticUpdate>}
def decode_none(d, t, n, pf, hd, hn, hchk):
  %Equal.sym(B.Buf & Bool, FuluLightClientOptimisticUpdate_r.LightClientOptimisticUpdate_ok(DC.BF(t, n), 0, n), (DC.BF(t, n), DC.CHK(t, n)), DC.ok_eval(d, t, n, pf, hd, hn)) :
    {FuluLightClientOptimisticUpdate_r.LightClientOptimisticUpdate_built(n, _) == (DC.BF(t, n), None{}) : B.Buf & Maybe<&1, FuluLightClientOptimisticUpdate_d.LightClientOptimisticUpdate>}
  %Equal.sym(Bool, DC.CHK(t, n), False{}, hchk) :
    {FuluLightClientOptimisticUpdate_r.LightClientOptimisticUpdate_built(n, (DC.BF(t, n), _)) == (DC.BF(t, n), None{}) : B.Buf & Maybe<&1, FuluLightClientOptimisticUpdate_d.LightClientOptimisticUpdate>}
  {==}

