# T.bv1280_putk at a word-aligned position 4 P: its validity check, then its unrolled copy of the
# storage's first 40 words, the run VF.updv.
def gwput_bv1280(+dd: Nat, +D: FD.array__Tree<U32>, +pos: U32, +P: Nat, +e: {U32.to_nat(pos) == A.quad(P) : Nat},
    +hdd: {Nat.is_lt(dd, 29n) == True{} : Bool}, +pf: {FD.array__perfect(U32, dd, D) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(40n, P), VB.pw(dd)) == True{} : Bool}, +dB: Nat, +TB: FD.array__Tree<U32>,
    +pfB: {FD.array__perfect(U32, dB, TB) == True{} : Bool}, +hdB: {Nat.is_lt(dB, 31n) == True{} : Bool},
    +hrB: {Nat.is_le(40n, VB.pw(dB)) == True{} : Bool})
    -> {T.bv1280_putk(FD.array__thaw(U32, D), pos, O.Words{FD.array__thaw(U32, TB), 160}) == (FD.array__thaw(U32, VF.updv(WL_bv1280(TB), dd, D, P)), (O.Words{FD.array__thaw(U32, TB), 160}, 0)) : Array<U32> & (O.Words & U32)}:
  +hd32 = VB.lt32(dd, FD.nat__lt_trans(dd, 29n, 31n, hdd, {==}))
  +hB32 = VB.lt32(dB, hdB)
  %Equal.sym(O.Words & Bool, T.bv1280_valid(O.Words{FD.array__thaw(U32, TB), 160}), (O.Words{FD.array__thaw(U32, TB), 160}, True{}),
      VBE.words_ok_b(dB, TB, 160, 160, 160, 8n, pfB, hdB, {==}, {==}, {==}, {==}, hrB, {==}, 1, {==})) :
    {T.bv1280_pk(FD.array__thaw(U32, D), pos, _) == (FD.array__thaw(U32, VF.updv(WL_bv1280(TB), dd, D, P)), (O.Words{FD.array__thaw(U32, TB), 160}, 0)) : Array<U32> & (O.Words & U32)}
  %Equal.sym(U32, U32.and(pos, 3), 0, VF.al_3(pos, P, e)) :
    {T.bv1280_pk_ok(T.bv1280_pw(U32.is_eq(_, 0), FD.array__thaw(U32, D), pos, FD.array__thaw(U32, TB), 160)) == (FD.array__thaw(U32, VF.updv(WL_bv1280(TB), dd, D, P)), (O.Words{FD.array__thaw(U32, TB), 160}, 0)) : Array<U32> & (O.Words & U32)}
  %Equal.sym(Array<U32> & U32, Array.get(U32, FD.array__thaw(U32, TB), 0), (FD.array__thaw(U32, TB), VB.slot(TB, 0n)), VB.get_n(dB, TB, 0, 0n, {==}, hB32, FD.nat__lt_le_trans(0n, 40n, VB.pw(dB), {==}, hrB), pfB)) :
    {T.bv1280_pk_ok(T.bv1280_pal(160, T.bv1280_pa0(U32.shrn(pos, 2n), FD.array__thaw(U32, VF.updv(WP0_bv1280(TB), dd, D, P)), _))) == (FD.array__thaw(U32, VF.updv(WL_bv1280(TB), dd, D, P)), (O.Words{FD.array__thaw(U32, TB), 160}, 0)) : Array<U32> & (O.Words & U32)}
  %Equal.sym(Array<U32>, Array.set(U32, FD.array__thaw(U32, VF.updv(WP0_bv1280(TB), dd, D, P)), U32.add(U32.shrn(pos, 2n), 0), VB.slot(TB, 0n)), FD.array__thaw(U32, VF.updv(WP1_bv1280(TB), dd, D, P)),
      VB.set_at(dd, VF.updv(WP0_bv1280(TB), dd, D, P), U32.shrn(pos, 2n), 0, P, VB.slot(TB, 0n), VF.al_q(pos, P, e), hd32,
        VF.in_lt(0n, 40n, P, VB.pw(dd), {==}, hb), VF.updv_perfect(WP0_bv1280(TB), dd, D, P, pf))) :
    {T.bv1280_pk_ok(T.bv1280_pal(160, T.bv1280_pa1(U32.shrn(pos, 2n), _, Array.get(U32, FD.array__thaw(U32, TB), 1)))) == (FD.array__thaw(U32, VF.updv(WL_bv1280(TB), dd, D, P)), (O.Words{FD.array__thaw(U32, TB), 160}, 0)) : Array<U32> & (O.Words & U32)}
