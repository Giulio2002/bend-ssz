  %Equal.sym(Array<U32>, Array.set(U32, FD.array__thaw(U32, VF.updv(WP2_bv1280(TB), dd, D, P)), U32.add(U32.shrn(pos, 2n), 2), VB.slot(TB, 2n)), FD.array__thaw(U32, VF.updv(WP3_bv1280(TB), dd, D, P)),
