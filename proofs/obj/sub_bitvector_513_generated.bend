    -> {bitvector_513_r.bitvector_513_decode_in(buf, m) == (buf, None{}) : B.Buf & Maybe<&1, bitvector_513_d.Bitvector513>}:
  %Equal.sym(Bool, U32.is_eq(m, 65), False{}, e) : {bitvector_513_r.bitvector_513_built(m, bitvector_513_r.bv513_ok_len(_, buf, 0)) == (buf, None{}) : B.Buf & Maybe<&1, bitvector_513_d.Bitvector513>}
  {==}

def bitvector_513_spec_reject(buf: B.Buf, +m: U32, e: {U32.is_eq(m, 65) == False{} : Bool})
    -> {bitvector_513_r.bitvector_513_decode(buf, m) == (buf, None{}) : B.Buf & Maybe<&1, bitvector_513_d.Bitvector513>}:
  DW_bitvector_513.bitvector_513_win_none_f(buf, m, b_ => bitvector_513_spec_reject_in(b_, m, e))

