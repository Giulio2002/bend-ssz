# ==== ProgressiveTestStruct in the encoder-window interface ====

type MW is Data:
  MW{m_f_A: EX_pl_u8.MW, m_f_B: EX_pl_u64.MW, m_f_C: EX_pl_SmallTestStruct.MW, m_f_D: EX_pl_pl_VarTestStruct.MW}

def TH(m: MW) -> ProgressiveTestStruct_d.ProgressiveTestStruct:
  match m:
    case MW{+m_f_A, +m_f_B, +m_f_C, +m_f_D}: K.OBJC(m_f_A, m_f_B, m_f_C, m_f_D)
def OK(m: MW) -> Bool:
  match m:
    case MW{+m_f_A, +m_f_B, +m_f_C, +m_f_D}: OKT(m_f_A, m_f_B, m_f_C, m_f_D)
def OKW(m: MW) -> Bool:
  match m:
    case MW{+m_f_A, +m_f_B, +m_f_C, +m_f_D}: OKTW(m_f_A, m_f_B, m_f_C, m_f_D)
def ENC(m: MW) -> +List<U32>:
  match m:
    case MW{+m_f_A, +m_f_B, +m_f_C, +m_f_D}: K.ENCC(m_f_A, m_f_B, m_f_C, m_f_D)
def VAL(m: MW) -> S.Value:
  match m:
    case MW{+m_f_A, +m_f_B, +m_f_C, +m_f_D}: VALC(m_f_A, m_f_B, m_f_C, m_f_D)
def SZ(m: MW) -> U32:
  match m:
    case MW{+m_f_A, +m_f_B, +m_f_C, +m_f_D}: K.SZC(m_f_A, m_f_B, m_f_C, m_f_D)
def XQ(+q: Nat, +r: Nat) -> U32: U32.from_nat(Nat.add(A.quad(q), r))
def PUTX(m: MW, +dd: Nat, +D: FD.array__Tree<U32>, +q: Nat, +r: Nat) -> FD.array__Tree<U32>:
  match m:
    case MW{+m_f_A, +m_f_B, +m_f_C, +m_f_D}: K.PUTC(m_f_A, m_f_B, m_f_C, m_f_D, dd, D, XQ(q, r), q, r)
def PADB(+r: Nat, m: MW) -> Nat: WD.PADB(r, List.length(&2, U32, ENC(m)))

def RTX(+m_f_A: EX_pl_u8.MW, +m_f_B: EX_pl_u64.MW, +m_f_C: EX_pl_SmallTestStruct.MW, +m_f_D: EX_pl_pl_VarTestStruct.MW, +dd: Nat, +D: FD.array__Tree<U32>, +X: U32, +q: Nat, +r: Nat) -> Data:
