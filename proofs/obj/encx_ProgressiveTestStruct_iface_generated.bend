def encE(+m_f_A: EX_pl_u8.MW, +m_f_B: EX_pl_u64.MW, +m_f_C: EX_pl_SmallTestStruct.MW, +m_f_D: EX_pl_pl_VarTestStruct.MW, +h: {OKT(m_f_A, m_f_B, m_f_C, m_f_D) == True{} : Bool}, +k: Nat, +ek: {k == 28n : Nat})
