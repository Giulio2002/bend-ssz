    -> DK.P2(RTX(m_f_A, m_f_B, m_f_C, m_f_D, dd, D, X, q, r), BYX(m_f_A, m_f_B, m_f_C, m_f_D, dd, D, q, r)):
  +LLv = K.LLC(m_f_A, m_f_B, m_f_C, m_f_D, dd, D, XQ(q, r), q, r)
  +el = lenC(m_f_A, m_f_B, m_f_C, m_f_D, dd, D, XQ(q, r), q, r)
