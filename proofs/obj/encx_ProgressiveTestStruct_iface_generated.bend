  +FP = LY.HDRW(PSC(m_f_A, m_f_B, m_f_C, m_f_D), OSC(m_f_A, m_f_B, m_f_C, m_f_D))
  +PAY = Layout.payloads(PSC(m_f_A, m_f_B, m_f_C, m_f_D))
  +hf = LY.hdr_fp(PSC(m_f_A, m_f_B, m_f_C, m_f_D), 16n, OSC(m_f_A, m_f_B, m_f_C, m_f_D), okoC(m_f_A, m_f_B, m_f_C, m_f_D, h, k, ek))
  +fit = CS.fitc(16n, PAY, ENDC(m_f_A, m_f_B, m_f_C, m_f_D), k, ek, LY.lay_end(PSC(m_f_A, m_f_B, m_f_C, m_f_D), 16n), okbk(m_f_A, m_f_B, m_f_C, m_f_D, h, k, ek))
  +e1 = LY.enc_genL(PSC(m_f_A, m_f_B, m_f_C, m_f_D), 16n, FP, PAY, {==}, hf, {==}, validC(m_f_A, m_f_B, m_f_C, m_f_D, h, k, ek), fit)
