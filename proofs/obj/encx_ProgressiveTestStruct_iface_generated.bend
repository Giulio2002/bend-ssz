    VCN.eposv([I.limb(16), I.limb(O.padd(16, EX_pl_u8.SZ(m_f_A))), I.limb(O.padd(O.padd(16, EX_pl_u8.SZ(m_f_A)), EX_pl_u64.SZ(m_f_B))), I.limb(O.padd(O.padd(O.padd(16, EX_pl_u8.SZ(m_f_A)), EX_pl_u64.SZ(m_f_B)), EX_pl_SmallTestStruct.SZ(m_f_C)))], [EX_pl_u8.ENC(m_f_A), EX_pl_u64.ENC(m_f_B), EX_pl_SmallTestStruct.ENC(m_f_C), EX_pl_pl_VarTestStruct.ENC(m_f_D)], [List.length(&2, U32, EX_pl_u8.ENC(m_f_A)), List.length(&2, U32, EX_pl_u64.ENC(m_f_B)), List.length(&2, U32, EX_pl_SmallTestStruct.ENC(m_f_C)), List.length(&2, U32, EX_pl_pl_VarTestStruct.ENC(m_f_D))]))
