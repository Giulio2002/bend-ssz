def padq6(+q: Nat, +bits: +List<Bool>, +h: {Nat.is_eq(List.length(&2, Bool, bits), LB(q, 6n)) == True{} : Bool})
    -> {PADK(Bp.pack(bits), q, 6) == True{} : Bool}:
  match q:
    case 0n:
      match bits:
        case Nil{}: Empty.absurd({PADK(Bp.pack(Nil{}), 0n, 6) == True{} : Bool}, FD.logic__false_true(h))
        case Con{+b0, +r0}:
          match r0:
            case Nil{}: Empty.absurd({PADK(Bp.pack(Con{b0, Nil{}}), 0n, 6) == True{} : Bool}, FD.logic__false_true(h))
            case Con{+b1, +r1}:
              match r1:
                case Nil{}: Empty.absurd({PADK(Bp.pack(Con{b0, Con{b1, Nil{}}}), 0n, 6) == True{} : Bool}, FD.logic__false_true(h))
                case Con{+b2, +r2}:
                  match r2:
                    case Nil{}: Empty.absurd({PADK(Bp.pack(Con{b0, Con{b1, Con{b2, Nil{}}}}), 0n, 6) == True{} : Bool}, FD.logic__false_true(h))
                    case Con{+b3, +r3}:
                      match r3:
                        case Nil{}: Empty.absurd({PADK(Bp.pack(Con{b0, Con{b1, Con{b2, Con{b3, Nil{}}}}}), 0n, 6) == True{} : Bool}, FD.logic__false_true(h))
                        case Con{+b4, +r4}:
                          match r4:
                            case Nil{}: Empty.absurd({PADK(Bp.pack(Con{b0, Con{b1, Con{b2, Con{b3, Con{b4, Nil{}}}}}}), 0n, 6) == True{} : Bool}, FD.logic__false_true(h))
                            case Con{+b5, +r5}:
                              match r5:
                                case Nil{}: base6(b0, b1, b2, b3, b4, b5)
                                case Con{+c, +cr}: Empty.absurd({PADK(Bp.pack(Con{b0, Con{b1, Con{b2, Con{b3, Con{b4, Con{b5, Con{c, cr}}}}}}}), 0n, 6) == True{} : Bool}, FD.logic__false_true(h))
    case 1n+ +p:
      match bits:
        case Nil{}: Empty.absurd({PADK(Bp.pack(Nil{}), 1n+p, 6) == True{} : Bool}, FD.logic__false_true(h))
        case Con{+c0, +s0}:
          match s0:
            case Nil{}: Empty.absurd({PADK(Bp.pack(Con{c0, Nil{}}), 1n+p, 6) == True{} : Bool}, FD.logic__false_true(h))
            case Con{+c1, +s1}:
              match s1:
                case Nil{}: Empty.absurd({PADK(Bp.pack(Con{c0, Con{c1, Nil{}}}), 1n+p, 6) == True{} : Bool}, FD.logic__false_true(h))
                case Con{+c2, +s2}:
                  match s2:
                    case Nil{}: Empty.absurd({PADK(Bp.pack(Con{c0, Con{c1, Con{c2, Nil{}}}}), 1n+p, 6) == True{} : Bool}, FD.logic__false_true(h))
                    case Con{+c3, +s3}:
                      match s3:
                        case Nil{}: Empty.absurd({PADK(Bp.pack(Con{c0, Con{c1, Con{c2, Con{c3, Nil{}}}}}), 1n+p, 6) == True{} : Bool}, FD.logic__false_true(h))
                        case Con{+c4, +s4}:
                          match s4:
                            case Nil{}: Empty.absurd({PADK(Bp.pack(Con{c0, Con{c1, Con{c2, Con{c3, Con{c4, Nil{}}}}}}), 1n+p, 6) == True{} : Bool}, FD.logic__false_true(h))
                            case Con{+c5, +s5}:
                              match s5:
                                case Nil{}: Empty.absurd({PADK(Bp.pack(Con{c0, Con{c1, Con{c2, Con{c3, Con{c4, Con{c5, Nil{}}}}}}}), 1n+p, 6) == True{} : Bool}, FD.logic__false_true(h))
                                case Con{+c6, +s6}:
                                  match s6:
                                    case Nil{}: Empty.absurd({PADK(Bp.pack(Con{c0, Con{c1, Con{c2, Con{c3, Con{c4, Con{c5, Con{c6, Nil{}}}}}}}}), 1n+p, 6) == True{} : Bool}, FD.logic__false_true(h))
                                    case Con{+c7, +s7}:
                                      padq6(p, s7, h)

