                                    case Con{+c, +cr}: Empty.absurd({PADK(Bp.pack(Con{b0, Con{b1, Con{b2, Con{b3, Con{b4, Con{b5, Con{b6, Con{c, cr}}}}}}}}), 0n, 7) == True{} : Bool}, FD.logic__false_true(h))
