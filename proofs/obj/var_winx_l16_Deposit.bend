# the records j, j + 1, ..., j + k set into the runtime storage A from index i on
def RT(+d: Nat, k: Nat, +i: U32, +j: Nat, A: Array<O.Boxed<FuluDeposit_d.Deposit>>, +t: FD.array__Tree<U32>, +x: Nat) -> Array<O.Boxed<FuluDeposit_d.Deposit>>:
  match k:
    case 0n: Array.set(O.Boxed<FuluDeposit_d.Deposit>, A, i, RX(d, t, VRL.pos(j, 1240n, x)))
    case 1n+q: RT(d, q, U32.add(i, 1), 1n+j, Array.set(O.Boxed<FuluDeposit_d.Deposit>, A, i, RX(d, t, VRL.pos(j, 1240n, x))), t, x)

# ---- the validator ------------------------------------------------------------------------------

def CHKw(+t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32) -> Bool:
  Bool.and(U32.is_eq(len, (U32.div(len, 1240) * 1240 : U32)), U32.is_le(U32.div(len, 1240), 16))

def ok_evalwD(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +hw32: {Nat.is_lt(Nat.add(x, U32.to_nat(len)), FD.spec_common__pow2(32n)) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}) -> {Fulu_list_Deposit_16_r.l16_Deposit_ok(BF(t, n), off, len) == (BF(t, n), CHKw(t, x, off, len)) : B.Buf & Bool}:
  {==}

def vR() -> Word(31n): FD.spec_numeric__from_nat(31n, 1240n)

# The window is c whole records, c <= 16.
def NN(+len: U32) -> U32: U32.div(len, 1240)
def CC(+len: U32) -> Nat: U32.to_nat(NN(len))
def ecw(+len: U32, +h: {Bool.and(U32.is_eq(len, (U32.div(len, 1240) * 1240 : U32)), U32.is_le(U32.div(len, 1240), 16)) == True{} : Bool})
    -> {U32.to_nat(len) == Nat.mul(CC(len), 1240n) : Nat}:
  Pair.fst({U32.to_nat(len) == Nat.mul(CC(len), U32.to_nat(1240)) : Nat}, {Nat.is_le(CC(len), U32.to_nat(16)) == True{} : Bool}, VU.whole_t(len, 1240, 16, vR(), {==}, {==}, {==}, h))
def hcw(+len: U32, +h: {Bool.and(U32.is_eq(len, (U32.div(len, 1240) * 1240 : U32)), U32.is_le(U32.div(len, 1240), 16)) == True{} : Bool})
    -> {Nat.is_le(CC(len), U32.to_nat(16)) == True{} : Bool}:
  Pair.snd({U32.to_nat(len) == Nat.mul(CC(len), U32.to_nat(1240)) : Nat}, {Nat.is_le(CC(len), U32.to_nat(16)) == True{} : Bool}, VU.whole_t(len, 1240, 16, vR(), {==}, {==}, {==}, h))

# ---- the reader ---------------------------------------------------------------------------------

def LOBJ(+d: Nat, e: Bool, +t: FD.array__Tree<U32>, +x: Nat, +len: U32) -> Fulu_list_Deposit_16_d.l16_Deposit_Seq:
  match e:
    case True{}: Fulu_list_Deposit_16_d.l16_Deposit_Seq{Fulu_list_Deposit_16_d.l16_Deposit_fill(0n), 0}
    case False{}: Fulu_list_Deposit_16_d.l16_Deposit_Seq{RT(d, U32.to_nat(U32.sub(NN(len), 1)), 0, 0n, Fulu_list_Deposit_16_d.l16_Deposit_fill(Fulu_list_Deposit_16_d.l16_Deposit_cap(NN(len))), t, x), NN(len)}
def OBJw(+d: Nat, +t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32) -> Fulu_list_Deposit_16_d.l16_Deposit_Seq: LOBJ(d, U32.is_eq(len, 0), t, x, len)

# The read loop from record j (index i) on.
def lp(k: Nat, +d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +i: U32, +j: Nat, A: Array<O.Boxed<FuluDeposit_d.Deposit>>,
    +eo: {U32.to_nat(off) == x : Nat}, +ej: {U32.to_nat(i) == j : Nat}, +hd: {Nat.is_lt(d, 31n) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hb: {Nat.is_le(VRL.pos(Nat.add(1n+k, j), 1240n, x), A.quad(VB.pw(d))) == True{} : Bool}, +hb32: {Nat.is_lt(VRL.pos(Nat.add(1n+k, j), 1240n, x), FD.spec_common__pow2(32n)) == True{} : Bool})
    -> {Fulu_list_Deposit_16_r.l16_Deposit_rd(k, i, off, A, (BF(t, n), RX(d, t, VRL.pos(j, 1240n, x)))) == (BF(t, n), RT(d, k, i, j, A, t, x)) : B.Buf & Array<O.Boxed<FuluDeposit_d.Deposit>>}:
  match k:
    case 0n: {==}
    case 1n+ +q:
      +hb2 = FD.logic__subst(Nat, z => {Nat.is_le(VRL.pos(1n+z, 1240n, x), A.quad(VB.pw(d))) == True{} : Bool}, 1n+Nat.add(q, j), Nat.add(q, 1n+j), Equal.sym(Nat, Nat.add(q, 1n+j), 1n+Nat.add(q, j), FD.nat__add_succ(q, j)), hb)
      +hx = VRL.nextfit(j, q, 1240n, x, A.quad(VB.pw(d)), hb)
      +hx32 = FD.nat__le_lt_trans(Nat.add(VRL.pos(1n+j, 1240n, x), 1240n), VRL.pos(Nat.add(2n+q, j), 1240n, x), FD.spec_common__pow2(32n),
        VRL.nextfit(j, q, 1240n, x, VRL.pos(Nat.add(2n+q, j), 1240n, x), FD.nat__le_refl(VRL.pos(Nat.add(2n+q, j), 1240n, x))), hb32)
      +hb232 = FD.logic__subst(Nat, z => {Nat.is_lt(VRL.pos(1n+z, 1240n, x), FD.spec_common__pow2(32n)) == True{} : Bool}, 1n+Nat.add(q, j), Nat.add(q, 1n+j), Equal.sym(Nat, Nat.add(q, 1n+j), 1n+Nat.add(q, j), FD.nat__add_succ(q, j)), hb32)
      +ex = VRL.posU32(off, x, i, j, 1240, 1239n, {==}, eo, ej, hx32)
      %Equal.sym(B.Buf & O.Boxed<FuluDeposit_d.Deposit>, FuluDeposit_r.Deposit_bx_read(BF(t, n), U32.add(off, U32.mul(U32.add(i, 1), 1240)), 1240), (BF(t, n), RX(d, t, VRL.pos(1n+j, 1240n, x))),
          VXB.rdbxd_Deposit(d, t, n, U32.add(off, U32.mul(U32.add(i, 1), 1240)), VRL.pos(1n+j, 1240n, x), ex, hd, pf, hx)) :
        {Fulu_list_Deposit_16_r.l16_Deposit_rd(q, U32.add(i, 1), off, Array.set(O.Boxed<FuluDeposit_d.Deposit>, A, i, RX(d, t, VRL.pos(j, 1240n, x))), _) == (BF(t, n), RT(d, 1n+q, i, j, A, t, x)) : B.Buf & Array<O.Boxed<FuluDeposit_d.Deposit>>}
      lp(q, d, t, n, x, off, U32.add(i, 1), 1n+j, Array.set(O.Boxed<FuluDeposit_d.Deposit>, A, i, RX(d, t, VRL.pos(j, 1240n, x))), eo, VRL.succU32(i, j, 1239n, x, ej, hx32), hd, pf, hb2, hb232)

# A non-empty window holds c >= 1 records.
def cpos(+len: U32, +c: Nat, +ec: {U32.to_nat(len) == Nat.mul(c, 1240n) : Nat}, +eb: {U32.is_eq(len, 0) == False{} : Bool})
    -> {Nat.is_le(1n, c) == True{} : Bool}:
  match c:
    case 0n: Empty.absurd({Nat.is_le(1n, 0n) == True{} : Bool}, FD.logic__true_false(Equal.trans(Bool, True{}, U32.is_eq(len, 0), False{},
      Equal.sym(Bool, U32.is_eq(len, 0), True{}, FD.u32alg__eq_true(len, 0, FD.u32__injective(len, 0, ec))), eb)))
    case 1n+ +p: FD.nat__zero_le(p)

def rd_go(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +hw32: {Nat.is_lt(Nat.add(x, U32.to_nat(len)), FD.spec_common__pow2(32n)) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hchk: {CHKw(t, x, off, len) == True{} : Bool}, +b: Bool, +eb: {U32.is_eq(len, 0) == b : Bool})
    -> {Fulu_list_Deposit_16_r.l16_Deposit_rd_start(b, off, NN(len), BF(t, n)) == (BF(t, n), LOBJ(d, b, t, x, len)) : B.Buf & Fulu_list_Deposit_16_d.l16_Deposit_Seq}:
  match b:
    case True{}: {==}
    case False{}:
      +c = CC(len)
      +ec = ecw(len, hchk)
      +h1 = cpos(len, c, ec, eb)
      +k = U32.to_nat(U32.sub(NN(len), 1))
      +e1 = Equal.trans(Nat, 1n+k, 1n+Nat.sub(c, 1n), c, Equal.cong(Nat, Nat, z => 1n+z, k, Nat.sub(c, 1n), FD.u32__sub_nat(NN(len), 1, h1)), FD.nat__sub_add(c, 1n, h1))
      +P = A.quad(VB.pw(d))
      +hL = FD.logic__subst(Nat, z => {Nat.is_le(z, P) == True{} : Bool}, Nat.add(x, U32.to_nat(len)), Nat.add(U32.to_nat(len), x), FD.nat__add_comm(x, U32.to_nat(len)), hw)
      +hLc = FD.logic__subst(Nat, z => {Nat.is_le(Nat.add(z, x), P) == True{} : Bool}, U32.to_nat(len), Nat.mul(c, 1240n), ec, hL)
      +hb = FD.logic__subst(Nat, z => {Nat.is_le(VRL.pos(z, 1240n, x), P) == True{} : Bool}, c, Nat.add(1n+k, 0n),
        Equal.trans(Nat, c, 1n+k, Nat.add(1n+k, 0n), Equal.sym(Nat, 1n+k, c, e1), Equal.sym(Nat, Nat.add(1n+k, 0n), 1n+k, FD.nat__add_zero(1n+k))), hLc)
      +hL32 = FD.logic__subst(Nat, z => {Nat.is_lt(z, FD.spec_common__pow2(32n)) == True{} : Bool}, Nat.add(x, U32.to_nat(len)), Nat.add(U32.to_nat(len), x), FD.nat__add_comm(x, U32.to_nat(len)), hw32)
      +hLc32 = FD.logic__subst(Nat, z => {Nat.is_lt(Nat.add(z, x), FD.spec_common__pow2(32n)) == True{} : Bool}, U32.to_nat(len), Nat.mul(c, 1240n), ec, hL32)
      +hb32 = FD.logic__subst(Nat, z => {Nat.is_lt(VRL.pos(z, 1240n, x), FD.spec_common__pow2(32n)) == True{} : Bool}, c, Nat.add(1n+k, 0n),
        Equal.trans(Nat, c, 1n+k, Nat.add(1n+k, 0n), Equal.sym(Nat, 1n+k, c, e1), Equal.sym(Nat, Nat.add(1n+k, 0n), 1n+k, FD.nat__add_zero(1n+k))), hLc32)
      +hb0 = FD.nat__le_trans(Nat.add(x, 1240n), Nat.add(x, U32.to_nat(len)), P,
        Order.add_left(x, 1240n, U32.to_nat(len), FD.logic__subst(Nat, z => {Nat.is_le(1240n, z) == True{} : Bool}, Nat.mul(c, 1240n), U32.to_nat(len), Equal.sym(Nat, U32.to_nat(len), Nat.mul(c, 1240n), ec),
          FD.logic__subst(Nat, z => {Nat.is_le(1240n, Nat.mul(z, 1240n)) == True{} : Bool}, 1n+k, c, e1, Order.below_sum(1240n, Nat.mul(k, 1240n))))), hw)
      %Equal.sym(B.Buf & O.Boxed<FuluDeposit_d.Deposit>, FuluDeposit_r.Deposit_bx_read(BF(t, n), off, 1240), (BF(t, n), RX(d, t, x)), VXB.rdbxd_Deposit(d, t, n, off, x, eo, hd, pf, hb0)) :
        {Fulu_list_Deposit_16_r.l16_Deposit_rd_fin(NN(len), Fulu_list_Deposit_16_r.l16_Deposit_rd(k, 0, off, Fulu_list_Deposit_16_d.l16_Deposit_fill(Fulu_list_Deposit_16_d.l16_Deposit_cap(NN(len))), _)) == (BF(t, n), LOBJ(d, False{}, t, x, len)) : B.Buf & Fulu_list_Deposit_16_d.l16_Deposit_Seq}
      %Equal.sym(B.Buf & Array<O.Boxed<FuluDeposit_d.Deposit>>, Fulu_list_Deposit_16_r.l16_Deposit_rd(k, 0, off, Fulu_list_Deposit_16_d.l16_Deposit_fill(Fulu_list_Deposit_16_d.l16_Deposit_cap(NN(len))), (BF(t, n), RX(d, t, x))), (BF(t, n), RT(d, k, 0, 0n, Fulu_list_Deposit_16_d.l16_Deposit_fill(Fulu_list_Deposit_16_d.l16_Deposit_cap(NN(len))), t, x)),
          lp(k, d, t, n, x, off, 0, 0n, Fulu_list_Deposit_16_d.l16_Deposit_fill(Fulu_list_Deposit_16_d.l16_Deposit_cap(NN(len))), eo, {==}, hd, pf, hb, hb32)) :
        {Fulu_list_Deposit_16_r.l16_Deposit_rd_fin(NN(len), _) == (BF(t, n), LOBJ(d, False{}, t, x, len)) : B.Buf & Fulu_list_Deposit_16_d.l16_Deposit_Seq}
      {==}

def readwD(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +hw32: {Nat.is_lt(Nat.add(x, U32.to_nat(len)), FD.spec_common__pow2(32n)) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hchk: {CHKw(t, x, off, len) == True{} : Bool})
    -> {Fulu_list_Deposit_16_r.l16_Deposit_read(BF(t, n), off, len) == (BF(t, n), OBJw(d, t, x, off, len)) : B.Buf & Fulu_list_Deposit_16_d.l16_Deposit_Seq}:
  rd_go(d, t, n, x, off, len, eo, hd, hw, hw32, pf, hchk, U32.is_eq(len, 0), {==})

# ---- the spec side ------------------------------------------------------------------------------

def RITEMS(c: Nat, +t: FD.array__Tree<U32>, +y: Nat) -> S.Value:
  match c:
    case 0n: S.EmptyItems{}
    case 1n+q: S.Items{RVAL(t, y), RITEMS(q, t, Nat.add(1240n, y))}

def RIT1(+q: Nat, +t: FD.array__Tree<U32>, +y: Nat) -> {S.Items{RVAL(t, y), RITEMS(q, t, Nat.add(1240n, y))} == RITEMS(1n+q, t, y) : S.Value}:
  {==}

def CHUNKS(c: Nat, +t: FD.array__Tree<U32>, +y: Nat) -> +List<+List<U32>>:
  match c:
    case 0n: []
    case 1n+q: Con{UR.RWS(310n, t, y), CHUNKS(q, t, Nat.add(1240n, y))}

law cnt_items:
  for +c: Nat
  for +t: FD.array__Tree<U32>
  for +y: Nat
  {Codec.count(RITEMS(c, t, y)) == c : Nat}
def cnt_items(c, t, y):
  match c:
    case 0n: {==}
    case 1n+ +q: FD.nat__succ_cong(Codec.count(RITEMS(q, t, Nat.add(1240n, y))), q, cnt_items(q, t, Nat.add(1240n, y)))

law prt_items:
  for +c: Nat
  for +t: FD.array__Tree<U32>
  for +y: Nat
  {Codec.parts(RITEMS(c, t, y), S.Repeat{S.Container{["proof", "data"], S.Chain{S.Vector{S.ByteVector{32n}, 33n}, S.Chain{S.Container{["pubkey", "withdrawal_credentials", "amount", "signature"], S.Chain{S.ByteVector{48n}, S.Chain{S.ByteVector{32n}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{96n}, S.End{}}}}}}, S.End{}}}}}) == Some{F.fparts(CHUNKS(c, t, y))} : Maybe<&2, +List<S.Part>>}
def prt_items(c, t, y):
  match c:
    case 0n: {==}
    case 1n+ +q:
      %RIT1(q, t, y) : {Codec.parts(_, S.Repeat{S.Container{["proof", "data"], S.Chain{S.Vector{S.ByteVector{32n}, 33n}, S.Chain{S.Container{["pubkey", "withdrawal_credentials", "amount", "signature"], S.Chain{S.ByteVector{48n}, S.Chain{S.ByteVector{32n}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{96n}, S.End{}}}}}}, S.End{}}}}}) == Some{F.fparts(CHUNKS(1n+q, t, y))} : Maybe<&2, +List<S.Part>>}
      F.items_rep(RVAL(t, y), RITEMS(q, t, Nat.add(1240n, y)), S.Container{["proof", "data"], S.Chain{S.Vector{S.ByteVector{32n}, 33n}, S.Chain{S.Container{["pubkey", "withdrawal_credentials", "amount", "signature"], S.Chain{S.ByteVector{48n}, S.Chain{S.ByteVector{32n}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{96n}, S.End{}}}}}}, S.End{}}}}, F.limbs(UR.RWS(310n, t, y)),
        F.fparts(CHUNKS(q, t, Nat.add(1240n, y))), RPRF(t, y), prt_items(q, t, Nat.add(1240n, y)))

law flat_chunks:
  for +c: Nat
  for +d: Nat
  for +t: FD.array__Tree<U32>
  for +y: Nat
  for +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}
  for +h: {Nat.is_le(Nat.add(y, Nat.mul(c, 1240n)), A.quad(VB.pw(d))) == True{} : Bool}
  {F.flat(CHUNKS(c, t, y)) == UW.WX(t, y, Nat.mul(c, 1240n)) : +List<U32>}
def flat_chunks(c, d, t, y, pf, h):
  match c:
    case 0n: {==}
    case 1n+ +q:
      +M = Nat.mul(q, 1240n)
      +e = Equal.trans(Nat, Nat.add(Nat.add(1240n, y), M), Nat.add(1240n, Nat.add(y, M)), Nat.add(y, Nat.add(1240n, M)),
        FD.nat__add_assoc(1240n, y, M), FD.lru_nat_algebra__add_swap(1240n, y, M))
      +h2 = FD.logic__subst(Nat, z => {Nat.is_le(z, A.quad(VB.pw(d))) == True{} : Bool}, Nat.add(y, Nat.add(1240n, M)), Nat.add(Nat.add(1240n, y), M), Equal.sym(Nat, Nat.add(Nat.add(1240n, y), M), Nat.add(y, Nat.add(1240n, M)), e), h)
      %Equal.sym(+List<U32>, F.flat(CHUNKS(q, t, Nat.add(1240n, y))), UW.WX(t, Nat.add(1240n, y), M), flat_chunks(q, d, t, Nat.add(1240n, y), pf, h2)) :
        {List.append(&2, U32, F.limbs(UR.RWS(310n, t, y)), _) == UW.WX(t, y, Nat.mul(1n+q, 1240n)) : +List<U32>}
      Equal.sym(+List<U32>, UW.WX(t, y, Nat.add(A.quad(310n), M)), List.append(&2, U32, F.limbs(UR.RWS(310n, t, y)), UW.WX(t, Nat.add(A.quad(310n), y), M)), UW.headWX(d, t, y, 310n, M, pf, h))

def VALw(+t: FD.array__Tree<U32>, +x: Nat, +len: U32) -> S.Value: S.Sequence{RITEMS(CC(len), t, x)}

def specwD(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +hw32: {Nat.is_lt(Nat.add(x, U32.to_nat(len)), FD.spec_common__pow2(32n)) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hchk: {CHKw(t, x, off, len) == True{} : Bool})
    -> {Codec.parts(VALw(t, x, len), S.ListOf{S.Container{["proof", "data"], S.Chain{S.Vector{S.ByteVector{32n}, 33n}, S.Chain{S.Container{["pubkey", "withdrawal_credentials", "amount", "signature"], S.Chain{S.ByteVector{48n}, S.Chain{S.ByteVector{32n}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{96n}, S.End{}}}}}}, S.End{}}}}, U32.to_nat(16)}) == Some{[S.Variable{UW.WX(t, x, U32.to_nat(len))}]} : Maybe<&2, +List<S.Part>>}:
  +c = CC(len)
  +ec = ecw(len, hchk)
  +hf = FD.logic__subst(Nat, z => {Nat.is_le(Nat.add(x, z), A.quad(VB.pw(d))) == True{} : Bool}, U32.to_nat(len), Nat.mul(c, 1240n), ec, hw)
  +hf32 = FD.logic__subst(Nat, z => {Nat.is_lt(Nat.add(x, z), FD.spec_common__pow2(32n)) == True{} : Bool}, U32.to_nat(len), Nat.mul(c, 1240n), ec, hw32)
  +fl = flat_chunks(c, d, t, x, pf, hf)
  +fit = FD.logic__subst(+List<U32>, z => {N.fits(4n, List.length(&2, U32, z)) == True{} : Bool}, UW.WX(t, x, Nat.mul(c, 1240n)), F.flat(CHUNKS(c, t, x)), Equal.sym(+List<U32>, F.flat(CHUNKS(c, t, x)), UW.WX(t, x, Nat.mul(c, 1240n)), fl),
    FD.logic__subst(Nat, z => {N.fits(4n, z) == True{} : Bool}, Nat.mul(c, 1240n), List.length(&2, U32, UW.WX(t, x, Nat.mul(c, 1240n))), Equal.sym(Nat, List.length(&2, U32, UW.WX(t, x, Nat.mul(c, 1240n))), Nat.mul(c, 1240n), UW.lenWX(d, t, x, Nat.mul(c, 1240n), pf, hf)),
      VFT.fits4lt(Nat.mul(c, 1240n), FD.nat__le_lt_trans(Nat.mul(c, 1240n), Nat.add(x, Nat.mul(c, 1240n)), FD.spec_common__pow2(32n), Order.left_below_sum(x, Nat.mul(c, 1240n)), hf32))))
  %Equal.sym(Nat, Codec.count(RITEMS(c, t, x)), c, cnt_items(c, t, x)) :
    {Codec.require(Nat.is_le(_, U32.to_nat(16)), Codec.aggregate(Codec.parts(RITEMS(c, t, x), S.Repeat{S.Container{["proof", "data"], S.Chain{S.Vector{S.ByteVector{32n}, 33n}, S.Chain{S.Container{["pubkey", "withdrawal_credentials", "amount", "signature"], S.Chain{S.ByteVector{48n}, S.Chain{S.ByteVector{32n}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{96n}, S.End{}}}}}}, S.End{}}}}}), None{})) == Some{[S.Variable{UW.WX(t, x, U32.to_nat(len))}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(Bool, Nat.is_le(c, U32.to_nat(16)), True{}, hcw(len, hchk)) :
    {Codec.require(_, Codec.aggregate(Codec.parts(RITEMS(c, t, x), S.Repeat{S.Container{["proof", "data"], S.Chain{S.Vector{S.ByteVector{32n}, 33n}, S.Chain{S.Container{["pubkey", "withdrawal_credentials", "amount", "signature"], S.Chain{S.ByteVector{48n}, S.Chain{S.ByteVector{32n}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{96n}, S.End{}}}}}}, S.End{}}}}}), None{})) == Some{[S.Variable{UW.WX(t, x, U32.to_nat(len))}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(Maybe<&2, +List<S.Part>>, Codec.parts(RITEMS(c, t, x), S.Repeat{S.Container{["proof", "data"], S.Chain{S.Vector{S.ByteVector{32n}, 33n}, S.Chain{S.Container{["pubkey", "withdrawal_credentials", "amount", "signature"], S.Chain{S.ByteVector{48n}, S.Chain{S.ByteVector{32n}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{96n}, S.End{}}}}}}, S.End{}}}}}), Some{F.fparts(CHUNKS(c, t, x))}, prt_items(c, t, x)) :
    {Codec.require(True{}, Codec.aggregate(_, None{})) == Some{[S.Variable{UW.WX(t, x, U32.to_nat(len))}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(Maybe<&2, +List<U32>>, Layout.encoding(F.fparts(CHUNKS(c, t, x))), Some{F.flat(CHUNKS(c, t, x))}, VS.encoding_fparts(CHUNKS(c, t, x), fit)) :
    {Codec.one(_, None{}) == Some{[S.Variable{UW.WX(t, x, U32.to_nat(len))}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(+List<U32>, F.flat(CHUNKS(c, t, x)), UW.WX(t, x, Nat.mul(c, 1240n)), fl) :
    {Codec.one(Some{_}, None{}) == Some{[S.Variable{UW.WX(t, x, U32.to_nat(len))}]} : Maybe<&2, +List<S.Part>>}
  %ec : {Codec.one(Some{UW.WX(t, x, _)}, None{}) == Some{[S.Variable{UW.WX(t, x, U32.to_nat(len))}]} : Maybe<&2, +List<S.Part>>}
  {==}

# ---- the inversion ------------------------------------------------------------------------------

def rp_t(+xs: +List<U32>, +el: S.Value, +tl: S.Value, +ps: +List<S.Part>, +mB: Maybe<&2, +List<S.Part>>,
    +eB: {Codec.parts(tl, S.Repeat{S.Container{["proof", "data"], S.Chain{S.Vector{S.ByteVector{32n}, 33n}, S.Chain{S.Container{["pubkey", "withdrawal_credentials", "amount", "signature"], S.Chain{S.ByteVector{48n}, S.Chain{S.ByteVector{32n}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{96n}, S.End{}}}}}}, S.End{}}}}}) == mB : Maybe<&2, +List<S.Part>>},
    +lx: {List.length(&2, U32, xs) == 1240n : Nat},
    +e: {Codec.concatenate(Some{[S.Fixed{xs}]}, mB) == Some{ps} : Maybe<&2, +List<S.Part>>},
    ih: @+pb: +List<S.Part> -> {Codec.parts(tl, S.Repeat{S.Container{["proof", "data"], S.Chain{S.Vector{S.ByteVector{32n}, 33n}, S.Chain{S.Container{["pubkey", "withdrawal_credentials", "amount", "signature"], S.Chain{S.ByteVector{48n}, S.Chain{S.ByteVector{32n}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{96n}, S.End{}}}}}}, S.End{}}}}}) == Some{pb} : Maybe<&2, +List<S.Part>>} -> VMR.REPB(tl, pb, 1240n))
    -> VMR.REPB(S.Items{el, tl}, ps, 1240n):
  match mB:
    case None{}: Empty.absurd(VMR.REPB(S.Items{el, tl}, ps, 1240n), FD.logic__none_some(+List<S.Part>, ps, e))
    case Some{+pb}:
      +eps = FD.logic__some_inj(+List<S.Part>, S.Fixed{xs} <> pb, ps, e)
      %Equal.sym(+List<S.Part>, ps, S.Fixed{xs} <> pb, Equal.sym(+List<S.Part>, S.Fixed{xs} <> pb, ps, eps)) : VMR.REPB(S.Items{el, tl}, _, 1240n)
      VMR.rpb_t2(xs, el, tl, pb, 1240n, lx, ih(pb, eB))

def rp_p(+el: S.Value, +tl: S.Value, +ps: +List<S.Part>, +ph: +List<S.Part>, hf: DF.single(Some{1240n}, ph),
    +e: {Codec.concatenate(Some{ph}, Codec.parts(tl, S.Repeat{S.Container{["proof", "data"], S.Chain{S.Vector{S.ByteVector{32n}, 33n}, S.Chain{S.Container{["pubkey", "withdrawal_credentials", "amount", "signature"], S.Chain{S.ByteVector{48n}, S.Chain{S.ByteVector{32n}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{96n}, S.End{}}}}}}, S.End{}}}}})) == Some{ps} : Maybe<&2, +List<S.Part>>},
    ih: @+pb: +List<S.Part> -> {Codec.parts(tl, S.Repeat{S.Container{["proof", "data"], S.Chain{S.Vector{S.ByteVector{32n}, 33n}, S.Chain{S.Container{["pubkey", "withdrawal_credentials", "amount", "signature"], S.Chain{S.ByteVector{48n}, S.Chain{S.ByteVector{32n}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{96n}, S.End{}}}}}}, S.End{}}}}}) == Some{pb} : Maybe<&2, +List<S.Part>>} -> VMR.REPB(tl, pb, 1240n))
    -> VMR.REPB(S.Items{el, tl}, ps, 1240n):
  match ph:
    case Nil{}: Empty.absurd(VMR.REPB(S.Items{el, tl}, ps, 1240n), hf)
    case Con{S.Fixed{+xs}, Nil{}}:
      rp_t(xs, el, tl, ps, Codec.parts(tl, S.Repeat{S.Container{["proof", "data"], S.Chain{S.Vector{S.ByteVector{32n}, 33n}, S.Chain{S.Container{["pubkey", "withdrawal_credentials", "amount", "signature"], S.Chain{S.ByteVector{48n}, S.Chain{S.ByteVector{32n}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{96n}, S.End{}}}}}}, S.End{}}}}}), {==}, Equal.sym(Nat, 1240n, List.length(&2, U32, xs), FD.logic__some_inj(Nat, 1240n, List.length(&2, U32, xs), hf)), e, ih)
    case Con{S.Variable{+xs}, Nil{}}: Empty.absurd(VMR.REPB(S.Items{el, tl}, ps, 1240n), FD.logic__none_some(Nat, 1240n, Equal.sym(Maybe<&2, Nat>, Some{1240n}, None{}, hf)))
    case Con{S.Fixed{+xs}, Con{+a, +b}}: Empty.absurd(VMR.REPB(S.Items{el, tl}, ps, 1240n), hf)
    case Con{S.Variable{+xs}, Con{+a, +b}}: Empty.absurd(VMR.REPB(S.Items{el, tl}, ps, 1240n), hf)

def rp_m(+el: S.Value, +tl: S.Value, +ps: +List<S.Part>, +mh: Maybe<&2, +List<S.Part>>, hf: DF.single_result(Some{1240n}, mh),
    +e: {Codec.concatenate(mh, Codec.parts(tl, S.Repeat{S.Container{["proof", "data"], S.Chain{S.Vector{S.ByteVector{32n}, 33n}, S.Chain{S.Container{["pubkey", "withdrawal_credentials", "amount", "signature"], S.Chain{S.ByteVector{48n}, S.Chain{S.ByteVector{32n}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{96n}, S.End{}}}}}}, S.End{}}}}})) == Some{ps} : Maybe<&2, +List<S.Part>>},
    ih: @+pb: +List<S.Part> -> {Codec.parts(tl, S.Repeat{S.Container{["proof", "data"], S.Chain{S.Vector{S.ByteVector{32n}, 33n}, S.Chain{S.Container{["pubkey", "withdrawal_credentials", "amount", "signature"], S.Chain{S.ByteVector{48n}, S.Chain{S.ByteVector{32n}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{96n}, S.End{}}}}}}, S.End{}}}}}) == Some{pb} : Maybe<&2, +List<S.Part>>} -> VMR.REPB(tl, pb, 1240n))
    -> VMR.REPB(S.Items{el, tl}, ps, 1240n):
  match mh:
    case None{}: Empty.absurd(VMR.REPB(S.Items{el, tl}, ps, 1240n), FD.logic__none_some(+List<S.Part>, ps, e))
    case Some{+ph}: rp_p(el, tl, ps, ph, hf, e, ih)

# The parts of records are fixed parts of 1240 bytes each.
law rep_r:
  for +its: S.Value
  for +ps: +List<S.Part>
  for +e: {Codec.parts(its, S.Repeat{S.Container{["proof", "data"], S.Chain{S.Vector{S.ByteVector{32n}, 33n}, S.Chain{S.Container{["pubkey", "withdrawal_credentials", "amount", "signature"], S.Chain{S.ByteVector{48n}, S.Chain{S.ByteVector{32n}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{96n}, S.End{}}}}}}, S.End{}}}}}) == Some{ps} : Maybe<&2, +List<S.Part>>}
  VMR.REPB(its, ps, 1240n)
def rep_r(its, ps, e):
  match its:
    case S.EmptyItems{}:
      +eps = FD.logic__some_inj(+List<S.Part>, [], ps, e)
      %Equal.sym(+List<S.Part>, ps, [], Equal.sym(+List<S.Part>, [], ps, eps)) : VMR.REPB(S.EmptyItems{}, _, 1240n)
      ({==}, {==})
    case S.Items{+h, +tl}: rp_m(h, tl, ps, Codec.parts(h, S.Container{["proof", "data"], S.Chain{S.Vector{S.ByteVector{32n}, 33n}, S.Chain{S.Container{["pubkey", "withdrawal_credentials", "amount", "signature"], S.Chain{S.ByteVector{48n}, S.Chain{S.ByteVector{32n}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{96n}, S.End{}}}}}}, S.End{}}}}), DS.facts(h, S.Container{["proof", "data"], S.Chain{S.Vector{S.ByteVector{32n}, 33n}, S.Chain{S.Container{["pubkey", "withdrawal_credentials", "amount", "signature"], S.Chain{S.ByteVector{48n}, S.Chain{S.ByteVector{32n}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{96n}, S.End{}}}}}}, S.End{}}}}, {==}), e, pb => eb => rep_r(tl, pb, eb))
    case S.BooleanValue{+b}: Empty.absurd(VMR.REPB(S.BooleanValue{b}, ps, 1240n), FD.logic__none_some(+List<S.Part>, ps, e))
    case S.UnsignedValue{+u}: Empty.absurd(VMR.REPB(S.UnsignedValue{u}, ps, 1240n), FD.logic__none_some(+List<S.Part>, ps, e))
    case S.BytesValue{+xs}: Empty.absurd(VMR.REPB(S.BytesValue{xs}, ps, 1240n), FD.logic__none_some(+List<S.Part>, ps, e))
    case S.BitsValue{+bs}: Empty.absurd(VMR.REPB(S.BitsValue{bs}, ps, 1240n), FD.logic__none_some(+List<S.Part>, ps, e))
    case S.Sequence{+it}: Empty.absurd(VMR.REPB(S.Sequence{it}, ps, 1240n), FD.logic__none_some(+List<S.Part>, ps, e))
    case S.Selected{+sel, +sv}: Empty.absurd(VMR.REPB(S.Selected{sel, sv}, ps, 1240n), FD.logic__none_some(+List<S.Part>, ps, e))
    case S.NullValue{}: Empty.absurd(VMR.REPB(S.NullValue{}, ps, 1240n), FD.logic__none_some(+List<S.Part>, ps, e))

def lm4(+its: S.Value, +ys: +List<U32>, +hk: {Nat.is_le(Codec.count(its), U32.to_nat(16)) == True{} : Bool}, +ps: +List<S.Part>,
    +em3: {Codec.parts(its, S.Repeat{S.Container{["proof", "data"], S.Chain{S.Vector{S.ByteVector{32n}, 33n}, S.Chain{S.Container{["pubkey", "withdrawal_credentials", "amount", "signature"], S.Chain{S.ByteVector{48n}, S.Chain{S.ByteVector{32n}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{96n}, S.End{}}}}}}, S.End{}}}}}) == Some{ps} : Maybe<&2, +List<S.Part>>}, +m4: Maybe<&2, +List<U32>>,
    +em4: {Layout.encoding(ps) == m4 : Maybe<&2, +List<U32>>}, +e: {Codec.bytes(Codec.one(m4, None{})) == Some{ys} : Maybe<&2, +List<U32>>})
    -> VMR.LF(ys, 1240n, U32.to_nat(16)):
  match m4:
    case None{}: Empty.absurd(VMR.LF(ys, 1240n, U32.to_nat(16)), FD.logic__none_some(+List<U32>, ys, e))
    case Some{+zs}:
      +ez = FD.logic__some_inj(+List<U32>, zs, ys, e)
      +lz = Equal.trans(Nat, List.length(&2, U32, zs), Layout.fixed_size(ps), Nat.mul(Codec.count(its), 1240n),
        VS.enc_len(ps, zs, Pair.fst({VS.allfix(ps) == True{} : Bool}, {Layout.fixed_size(ps) == Nat.mul(Codec.count(its), 1240n) : Nat}, rep_r(its, ps, em3)), em4),
        Pair.snd({VS.allfix(ps) == True{} : Bool}, {Layout.fixed_size(ps) == Nat.mul(Codec.count(its), 1240n) : Nat}, rep_r(its, ps, em3)))
      (Codec.count(its), (FD.logic__subst(+List<U32>, z => {List.length(&2, U32, z) == Nat.mul(Codec.count(its), 1240n) : Nat}, zs, ys, ez, lz), hk))

def lm3(+its: S.Value, +ys: +List<U32>, +hk: {Nat.is_le(Codec.count(its), U32.to_nat(16)) == True{} : Bool}, +m3: Maybe<&2, +List<S.Part>>,
    +em3: {Codec.parts(its, S.Repeat{S.Container{["proof", "data"], S.Chain{S.Vector{S.ByteVector{32n}, 33n}, S.Chain{S.Container{["pubkey", "withdrawal_credentials", "amount", "signature"], S.Chain{S.ByteVector{48n}, S.Chain{S.ByteVector{32n}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{96n}, S.End{}}}}}}, S.End{}}}}}) == m3 : Maybe<&2, +List<S.Part>>}, +e: {Codec.bytes(Codec.aggregate(m3, None{})) == Some{ys} : Maybe<&2, +List<U32>>})
    -> VMR.LF(ys, 1240n, U32.to_nat(16)):
  match m3:
    case None{}: Empty.absurd(VMR.LF(ys, 1240n, U32.to_nat(16)), FD.logic__none_some(+List<U32>, ys, e))
    case Some{+ps}: lm4(its, ys, hk, ps, em3, Layout.encoding(ps), {==}, e)

def lb(+its: S.Value, +ys: +List<U32>, +b: Bool, +eb: {Nat.is_le(Codec.count(its), U32.to_nat(16)) == b : Bool},
    +e: {Codec.bytes(Codec.require(b, Codec.aggregate(Codec.parts(its, S.Repeat{S.Container{["proof", "data"], S.Chain{S.Vector{S.ByteVector{32n}, 33n}, S.Chain{S.Container{["pubkey", "withdrawal_credentials", "amount", "signature"], S.Chain{S.ByteVector{48n}, S.Chain{S.ByteVector{32n}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{96n}, S.End{}}}}}}, S.End{}}}}}), None{}))) == Some{ys} : Maybe<&2, +List<U32>>})
    -> VMR.LF(ys, 1240n, U32.to_nat(16)):
  match b:
    case False{}: Empty.absurd(VMR.LF(ys, 1240n, U32.to_nat(16)), FD.logic__none_some(+List<U32>, ys, e))
    case True{}: lm3(its, ys, eb, Codec.parts(its, S.Repeat{S.Container{["proof", "data"], S.Chain{S.Vector{S.ByteVector{32n}, 33n}, S.Chain{S.Container{["pubkey", "withdrawal_credentials", "amount", "signature"], S.Chain{S.ByteVector{48n}, S.Chain{S.ByteVector{32n}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{96n}, S.End{}}}}}}, S.End{}}}}}), {==}, e)

# The spec bytes ys of any value of the list are whole records, at most 16.
law linvr:
  for +h: S.Value
  for +ys: +List<U32>
  for +e: {Codec.bytes(Codec.parts(h, S.ListOf{S.Container{["proof", "data"], S.Chain{S.Vector{S.ByteVector{32n}, 33n}, S.Chain{S.Container{["pubkey", "withdrawal_credentials", "amount", "signature"], S.Chain{S.ByteVector{48n}, S.Chain{S.ByteVector{32n}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{96n}, S.End{}}}}}}, S.End{}}}}, U32.to_nat(16)})) == Some{ys} : Maybe<&2, +List<U32>>}
  VMR.LF(ys, 1240n, U32.to_nat(16))
def linvr(h, ys, e):
  match h:
    case S.Sequence{+its}: lb(its, ys, Nat.is_le(Codec.count(its), U32.to_nat(16)), {==}, e)
    case S.BooleanValue{+b0}: Empty.absurd(VMR.LF(ys, 1240n, U32.to_nat(16)), FD.logic__none_some(+List<U32>, ys, e))
    case S.UnsignedValue{+u0}: Empty.absurd(VMR.LF(ys, 1240n, U32.to_nat(16)), FD.logic__none_some(+List<U32>, ys, e))
    case S.BytesValue{+xs0}: Empty.absurd(VMR.LF(ys, 1240n, U32.to_nat(16)), FD.logic__none_some(+List<U32>, ys, e))
    case S.BitsValue{+bs0}: Empty.absurd(VMR.LF(ys, 1240n, U32.to_nat(16)), FD.logic__none_some(+List<U32>, ys, e))
    case S.Items{+hd0, +tl0}: Empty.absurd(VMR.LF(ys, 1240n, U32.to_nat(16)), FD.logic__none_some(+List<U32>, ys, e))
    case S.EmptyItems{}: Empty.absurd(VMR.LF(ys, 1240n, U32.to_nat(16)), FD.logic__none_some(+List<U32>, ys, e))
    case S.Selected{+sel0, +sv0}: Empty.absurd(VMR.LF(ys, 1240n, U32.to_nat(16)), FD.logic__none_some(+List<U32>, ys, e))
    case S.NullValue{}: Empty.absurd(VMR.LF(ys, 1240n, U32.to_nat(16)), FD.logic__none_some(+List<U32>, ys, e))

def chk_i(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +hw32: {Nat.is_lt(Nat.add(x, U32.to_nat(len)), FD.spec_common__pow2(32n)) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, f: VMR.LF(UW.WX(t, x, U32.to_nat(len)), 1240n, U32.to_nat(16))) -> {CHKw(t, x, off, len) == True{} : Bool}:
  (+k, +pr) = f
  (+hl, +hk) = pr
  VU.whole_i(len, 1240, 16, vR(), {==}, {==}, {==}, k,
    Equal.trans(Nat, U32.to_nat(len), List.length(&2, U32, UW.WX(t, x, U32.to_nat(len))), Nat.mul(k, 1240n),
      Equal.sym(Nat, List.length(&2, U32, UW.WX(t, x, U32.to_nat(len))), U32.to_nat(len), UW.lenWX(d, t, x, U32.to_nat(len), pf, hw)), hl), hk)

# Every value whose parts are the window's bytes passes the check.
def invwD(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +hw32: {Nat.is_lt(Nat.add(x, U32.to_nat(len)), FD.spec_common__pow2(32n)) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +v: S.Value,
    +e: {Codec.parts(v, S.ListOf{S.Container{["proof", "data"], S.Chain{S.Vector{S.ByteVector{32n}, 33n}, S.Chain{S.Container{["pubkey", "withdrawal_credentials", "amount", "signature"], S.Chain{S.ByteVector{48n}, S.Chain{S.ByteVector{32n}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{96n}, S.End{}}}}}}, S.End{}}}}, U32.to_nat(16)}) == Some{[S.Variable{UW.WX(t, x, U32.to_nat(len))}]} : Maybe<&2, +List<S.Part>>})
    -> {CHKw(t, x, off, len) == True{} : Bool}:
  chk_i(d, t, n, x, off, len, eo, hd, hw, hw32, pf, linvr(v, UW.WX(t, x, U32.to_nat(len)),
    Equal.cong(Maybe<&2, +List<S.Part>>, Maybe<&2, +List<U32>>, z => Codec.bytes(z), Codec.parts(v, S.ListOf{S.Container{["proof", "data"], S.Chain{S.Vector{S.ByteVector{32n}, 33n}, S.Chain{S.Container{["pubkey", "withdrawal_credentials", "amount", "signature"], S.Chain{S.ByteVector{48n}, S.Chain{S.ByteVector{32n}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{96n}, S.End{}}}}}}, S.End{}}}}, U32.to_nat(16)}), Some{[S.Variable{UW.WX(t, x, U32.to_nat(len))}]}, e)))

# ---- the window interface as it was (d < 28, no hw32), for the callers not yet deep ----

def ok_evalw(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat}, +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}) -> {Fulu_list_Deposit_16_r.l16_Deposit_ok(BF(t, n), off, len) == (BF(t, n), CHKw(t, x, off, len)) : B.Buf & Bool}:
  ok_evalwD(d, t, n, x, off, len, eo, FD.nat__lt_trans(d, 28n, 31n, hd, {==}), hw, VB.hw32of(d, Nat.add(x, U32.to_nat(len)), FD.nat__lt_trans(d, 28n, 30n, hd, {==}), hw), pf)

def readw(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat}, +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hchk: {CHKw(t, x, off, len) == True{} : Bool})
    -> {Fulu_list_Deposit_16_r.l16_Deposit_read(BF(t, n), off, len) == (BF(t, n), OBJw(d, t, x, off, len)) : B.Buf & Fulu_list_Deposit_16_d.l16_Deposit_Seq}:
  readwD(d, t, n, x, off, len, eo, FD.nat__lt_trans(d, 28n, 31n, hd, {==}), hw, VB.hw32of(d, Nat.add(x, U32.to_nat(len)), FD.nat__lt_trans(d, 28n, 30n, hd, {==}), hw), pf, hchk)

def specw(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat}, +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hchk: {CHKw(t, x, off, len) == True{} : Bool})
    -> {Codec.parts(VALw(t, x, len), S.ListOf{S.Container{["proof", "data"], S.Chain{S.Vector{S.ByteVector{32n}, 33n}, S.Chain{S.Container{["pubkey", "withdrawal_credentials", "amount", "signature"], S.Chain{S.ByteVector{48n}, S.Chain{S.ByteVector{32n}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{96n}, S.End{}}}}}}, S.End{}}}}, U32.to_nat(16)}) == Some{[S.Variable{UW.WX(t, x, U32.to_nat(len))}]} : Maybe<&2, +List<S.Part>>}:
  specwD(d, t, n, x, off, len, eo, FD.nat__lt_trans(d, 28n, 31n, hd, {==}), hw, VB.hw32of(d, Nat.add(x, U32.to_nat(len)), FD.nat__lt_trans(d, 28n, 30n, hd, {==}), hw), pf, hchk)

def invw(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat}, +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +v: S.Value, +e: {Codec.parts(v, S.ListOf{S.Container{["proof", "data"], S.Chain{S.Vector{S.ByteVector{32n}, 33n}, S.Chain{S.Container{["pubkey", "withdrawal_credentials", "amount", "signature"], S.Chain{S.ByteVector{48n}, S.Chain{S.ByteVector{32n}, S.Chain{S.Unsigned{P.U64{}}, S.Chain{S.ByteVector{96n}, S.End{}}}}}}, S.End{}}}}, U32.to_nat(16)}) == Some{[S.Variable{UW.WX(t, x, U32.to_nat(len))}]} : Maybe<&2, +List<S.Part>>})
    -> {CHKw(t, x, off, len) == True{} : Bool}:
  invwD(d, t, n, x, off, len, eo, FD.nat__lt_trans(d, 28n, 31n, hd, {==}), hw, VB.hw32of(d, Nat.add(x, U32.to_nat(len)), FD.nat__lt_trans(d, 28n, 30n, hd, {==}), hw), pf, v, e)
