    case S.Sequence{+it0}: Empty.absurd(FACTS(bs), F.logic__none_some(+List<U32>, bs, e))
    case S.Items{+h, +t}: fd0(h, t, bs, e)
    case S.EmptyItems{}: Empty.absurd(FACTS(bs), F.logic__none_some(+List<U32>, bs, e))
    case S.Selected{+sel0, +sv0}: Empty.absurd(FACTS(bs), F.logic__none_some(+List<U32>, bs, e))
    case S.NullValue{}: Empty.absurd(FACTS(bs), F.logic__none_some(+List<U32>, bs, e))

# Every byte string the spec relates to a value has the checked shape.
law inv_v:
  for +v: S.Value
  for +bs: +List<U32>
  for +e: {Codec.encoding_for_legal_type(Spec.IndexedAttestation(), v) == Some{bs} : Maybe<&2, +List<U32>>}
  FACTS(bs)
def inv_v(v, bs, e):
  match v:
    case S.BooleanValue{+b0}: Empty.absurd(FACTS(bs), F.logic__none_some(+List<U32>, bs, e))
    case S.UnsignedValue{+u0}: Empty.absurd(FACTS(bs), F.logic__none_some(+List<U32>, bs, e))
    case S.BytesValue{+xs0}: Empty.absurd(FACTS(bs), F.logic__none_some(+List<U32>, bs, e))
    case S.BitsValue{+bs0}: Empty.absurd(FACTS(bs), F.logic__none_some(+List<U32>, bs, e))
    case S.Sequence{+items}: st0(items, bs, e)
    case S.Items{+hd0, +tl0}: Empty.absurd(FACTS(bs), F.logic__none_some(+List<U32>, bs, e))
    case S.EmptyItems{}: Empty.absurd(FACTS(bs), F.logic__none_some(+List<U32>, bs, e))
    case S.Selected{+sel0, +sv0}: Empty.absurd(FACTS(bs), F.logic__none_some(+List<U32>, bs, e))
    case S.NullValue{}: Empty.absurd(FACTS(bs), F.logic__none_some(+List<U32>, bs, e))

# ---- the buffer's bytes ------------------------------------------------------------------

law wdr0_eq:
  for +n: Nat
  for +W: List<&2, U32>
  {VS.wdr0(n, W) == VB.wdr(n, W) : List<&2, U32>}
def wdr0_eq(n, W):
  match n W:
    case 0n _: {==}
    case 1n+ +p Nil{}: {==}
    case 1n+ +p Con{+h, +t}: wdr0_eq(p, t)

law len_eq:
  for +W: List<&2, U32>
  {List.length(&2, U32, W) == F.spec_common__length(U32, W) : Nat}
def len_eq(W):
  match W:
    case Nil{}: {==}
    case Con{+h, +t}:
      %Equal.sym(Nat, List.length(&2, U32, t), F.spec_common__length(U32, t), len_eq(t)) : {1n+_ == 1n+F.spec_common__length(U32, t) : Nat}
      {==}

def SL(t: F.array__Tree<U32>) -> List<&2, U32>: F.array__slots(U32, t)

def lenS(+d: Nat, +t: F.array__Tree<U32>, +pf: {F.array__perfect(U32, d, t) == True{} : Bool})
    -> {List.length(&2, U32, FX.limbs(SL(t))) == A.quad(VB.pw(d)) : Nat}:
  %Equal.sym(Nat, List.length(&2, U32, FX.limbs(SL(t))), FX.wlen(SL(t)), VS.len_limbs(SL(t))) : {_ == A.quad(VB.pw(d)) : Nat}
  %Equal.sym(Nat, FX.wlen(SL(t)), A.quad(List.length(&2, U32, SL(t))), VS.wlen_quad(SL(t))) : {_ == A.quad(VB.pw(d)) : Nat}
  %Equal.sym(Nat, List.length(&2, U32, SL(t)), VB.pw(d), Equal.trans(Nat, List.length(&2, U32, SL(t)), F.spec_common__length(U32, SL(t)), VB.pw(d), len_eq(SL(t)), F.array__slots_length(U32, d, t, pf))) : {A.quad(_) == A.quad(VB.pw(d)) : Nat}
  {==}

def lenVW(+d: Nat, +t: F.array__Tree<U32>, +n: U32, +pf: {F.array__perfect(U32, d, t) == True{} : Bool},
    +hn: {Nat.is_le(U32.to_nat(n), A.quad(VB.pw(d))) == True{} : Bool})
    -> {List.length(&2, U32, DC.VW(t, n)) == U32.to_nat(n) : Nat}:
  VS.bt_len(U32.to_nat(n), FX.limbs(SL(t)),
    F.logic__subst(Nat, z => {Nat.is_le(U32.to_nat(n), z) == True{} : Bool}, A.quad(VB.pw(d)), List.length(&2, U32, FX.limbs(SL(t))), Equal.sym(Nat, List.length(&2, U32, FX.limbs(SL(t))), A.quad(VB.pw(d)), lenS(d, t, pf)), hn))

# The offset word's index is below 2^d.
def hpoD(+d: Nat, +n: U32, +hn: {Nat.is_le(U32.to_nat(n), A.quad(VB.pw(d))) == True{} : Bool}, +hF: {Nat.is_le(228n, U32.to_nat(n)) == True{} : Bool})
    -> {Nat.is_lt(0n, VB.pw(d)) == True{} : Bool}:
  F.nat__lt_le_trans(0n, 57n, VB.pw(d), {==}, VC.quad_inv(57n, VB.pw(d), F.nat__le_trans(228n, U32.to_nat(n), A.quad(VB.pw(d)), hF, hn)))

def hpoS(+d: Nat, +t: F.array__Tree<U32>, +n: U32, +pf: {F.array__perfect(U32, d, t) == True{} : Bool},
    +hn: {Nat.is_le(U32.to_nat(n), A.quad(VB.pw(d))) == True{} : Bool}, +hF: {Nat.is_le(228n, U32.to_nat(n)) == True{} : Bool})
    -> {Nat.is_lt(0n, VB.len(SL(t))) == True{} : Bool}:
  %Equal.sym(Nat, VB.len(SL(t)), VB.pw(d), F.array__slots_length(U32, d, t, pf)) : {Nat.is_lt(0n, _) == True{} : Bool}
  hpoD(d, n, hn, hF)

# The four bytes at the offset field are the limbs of the offset word.
def byteP(+t: F.array__Tree<U32>, +n: U32, +X: Nat, +en: {U32.to_nat(n) == 228n+X : Nat}, +hp: {Nat.is_lt(0n, VB.len(SL(t))) == True{} : Bool})
    -> {VS.bt(4n, VS.bdr(0n, DC.VW(t, n))) == FX.limbs([VB.slot(t, 0n)]) : +List<U32>}:
  %Equal.sym(Nat, U32.to_nat(n), 228n+X, en) : {VS.bt(4n, VS.bdr(0n, VS.bt(_, FX.limbs(SL(t))))) == FX.limbs([VB.slot(t, 0n)]) : +List<U32>}
  %Equal.sym(+List<U32>, VS.bdr(0n, VS.bt(228n+X, FX.limbs(SL(t)))), VS.bt(228n+X, VS.bdr(0n, FX.limbs(SL(t)))), VS.bdr_bt(0n, 228n+X, FX.limbs(SL(t)))) :
    {VS.bt(4n, _) == FX.limbs([VB.slot(t, 0n)]) : +List<U32>}
  %Equal.sym(+List<U32>, VS.bt(4n, VS.bt(228n+X, VS.bdr(0n, FX.limbs(SL(t))))), VS.bt(4n, VS.bdr(0n, FX.limbs(SL(t)))), VS.bt_bt(4n, 224n+X, VS.bdr(0n, FX.limbs(SL(t))))) :
    {_ == FX.limbs([VB.slot(t, 0n)]) : +List<U32>}
  %Equal.sym(+List<U32>, VS.bdr(0n, FX.limbs(SL(t))), FX.limbs(VS.wdr0(0n, SL(t))), VS.bdr_limbs(0n, SL(t))) :
    {VS.bt(4n, _) == FX.limbs([VB.slot(t, 0n)]) : +List<U32>}
  %Equal.sym(+List<U32>, VS.bt(4n, FX.limbs(VS.wdr0(0n, SL(t)))), FX.limbs(VS.wtake(1n, VS.wdr0(0n, SL(t)))), VS.bt_limbs(1n, VS.wdr0(0n, SL(t)))) :
    {_ == FX.limbs([VB.slot(t, 0n)]) : +List<U32>}
  %Equal.sym(List<&2, U32>, VS.wdr0(0n, SL(t)), VB.wdr(0n, SL(t)), wdr0_eq(0n, SL(t))) :
    {FX.limbs(VS.wtake(1n, _)) == FX.limbs([VB.slot(t, 0n)]) : +List<U32>}
  %Equal.sym(List<&2, U32>, VS.wtake(1n, VB.wdr(0n, SL(t))), Con{F.flat__nthc(SL(t), 0n), VS.wtake(0n, VB.wdr(1n+0n, SL(t)))}, VB.wt_eta(0n, 0n, SL(t), hp)) :
    {FX.limbs(_) == FX.limbs([VB.slot(t, 0n)]) : +List<U32>}
  {==}

def q0(xs: +List<U32>) -> U32:
  match xs:
    case Con{h, t}: h
    case Nil{}: 0
def q1(xs: +List<U32>) -> U32:
  match xs:
    case Con{h, t}: q0(t)
    case Nil{}: 0
def q2(xs: +List<U32>) -> U32:
  match xs:
    case Con{h, t}: q1(t)
    case Nil{}: 0
def q3(xs: +List<U32>) -> U32:
  match xs:
    case Con{h, t}: q2(t)
    case Nil{}: 0

# A word whose limbs are those of 228 is 228.
def wordFS(+x: U32, +h: {FX.limbs([x]) == [228, 0, 0, 0] : +List<U32>}) -> {x == 228 : U32}:
  Equal.trans(U32, x, BT.asm(B.byte_sel(0, x), B.byte_sel(1, x), B.byte_sel(2, x), B.byte_sel(3, x)), 228, BT.reassemble(x),
    BT.asm_cong(B.byte_sel(0, x), B.byte_sel(1, x), B.byte_sel(2, x), B.byte_sel(3, x), 228, 0, 0, 0,
      Equal.cong(+List<U32>, U32, l => q0(l), FX.limbs([x]), [228, 0, 0, 0], h),
      Equal.cong(+List<U32>, U32, l => q1(l), FX.limbs([x]), [228, 0, 0, 0], h),
      Equal.cong(+List<U32>, U32, l => q2(l), FX.limbs([x]), [228, 0, 0, 0], h),
      Equal.cong(+List<U32>, U32, l => q3(l), FX.limbs([x]), [228, 0, 0, 0], h)))

def ec_sub(+n: U32, +k: Nat, +en: {U32.to_nat(n) == 228n+VS.x8(k) : Nat})
    -> {U32.to_nat(DC.LL(n)) == Nat.mul(k, U32.to_nat(8)) : Nat}:
  +le = F.logic__subst(Nat, z => {Nat.is_le(228n, z) == True{} : Bool}, 228n+VS.x8(k), U32.to_nat(n), Equal.sym(Nat, U32.to_nat(n), 228n+VS.x8(k), en), Order.below_sum(228n, VS.x8(k)))
  %Equal.sym(Nat, U32.to_nat(DC.LL(n)), Nat.sub(U32.to_nat(n), 228n), F.u32__sub_nat(n, 228, le)) : {_ == Nat.mul(k, U32.to_nat(8)) : Nat}
  %Equal.sym(Nat, U32.to_nat(n), 228n+VS.x8(k), en) : {Nat.sub(_, 228n) == Nat.mul(k, U32.to_nat(8)) : Nat}
  %VC.x8_mul(k) : {Nat.sub(228n+_, 228n) == Nat.mul(k, U32.to_nat(8)) : Nat}
  F.nat__add_sub_cancel(228n, Nat.mul(k, 8n))

# The validator accepts every buffer whose bytes have the shape.
def chk_true(+t: F.array__Tree<U32>, +n: U32, +k: Nat, +en: {U32.to_nat(n) == 228n+VS.x8(k) : Nat}, +hk: {Nat.is_le(k, U32.to_nat(131072)) == True{} : Bool},
    +epo: {DC.SPO(t) == 228 : U32}) -> {DC.CHK(t, n) == True{} : Bool}:
  +le = F.logic__subst(Nat, z => {Nat.is_le(228n, z) == True{} : Bool}, 228n+VS.x8(k), U32.to_nat(n), Equal.sym(Nat, U32.to_nat(n), 228n+VS.x8(k), en), Order.below_sum(228n, VS.x8(k)))
  %Equal.sym(Bool, U32.is_le(228, n), True{}, F.logic__subst(Bool, z => {z == True{} : Bool}, Nat.is_le(228n, U32.to_nat(n)), U32.is_le(228, n), Equal.sym(Bool, U32.is_le(228, n), Nat.is_le(228n, U32.to_nat(n)), VU.le_u32(228, n)), le)) :
    {DC.chk3(_, U32.is_eq(DC.SPO(t), 228), DC.whole(U32.sub(n, DC.SPO(t)))) == True{} : Bool}
  %Equal.sym(U32, DC.SPO(t), 228, epo) :
    {DC.chk3(True{}, U32.is_eq(_, 228), DC.whole(U32.sub(n, _))) == True{} : Bool}
  VU.whole_i(DC.LL(n), 8, 131072, DC.v8(), {==}, {==}, {==}, k, ec_sub(n, k, en), hk)

def rej_k(+d: Nat, +t: F.array__Tree<U32>, +n: U32, +pf: {F.array__perfect(U32, d, t) == True{} : Bool},
    +hn: {Nat.is_le(U32.to_nat(n), A.quad(VB.pw(d))) == True{} : Bool}, +hchk: {DC.CHK(t, n) == False{} : Bool},
    +hb: {VS.bt(4n, VS.bdr(0n, DC.VW(t, n))) == [228, 0, 0, 0] : +List<U32>},
    ex: DK.Ex(Nat, k => DK.P2({List.length(&2, U32, DC.VW(t, n)) == Nat.add(228n, VS.x8(k)) : Nat}, {Nat.is_le(k, U32.to_nat(131072)) == True{} : Bool}))) -> Empty:
  (+k, +pr) = ex
  (+hlen, +hk) = pr
  +en = Equal.trans(Nat, U32.to_nat(n), List.length(&2, U32, DC.VW(t, n)), 228n+VS.x8(k), Equal.sym(Nat, List.length(&2, U32, DC.VW(t, n)), U32.to_nat(n), lenVW(d, t, n, pf, hn)), hlen)
  +hF = F.logic__subst(Nat, z => {Nat.is_le(228n, z) == True{} : Bool}, 228n+VS.x8(k), U32.to_nat(n), Equal.sym(Nat, U32.to_nat(n), 228n+VS.x8(k), en), Order.below_sum(228n, VS.x8(k)))
  +hp = hpoS(d, t, n, pf, hn, hF)
  +epo = wordFS(DC.SPO(t), Equal.trans(+List<U32>, FX.limbs([DC.SPO(t)]), VS.bt(4n, VS.bdr(0n, DC.VW(t, n))), [228, 0, 0, 0],
    Equal.sym(+List<U32>, VS.bt(4n, VS.bdr(0n, DC.VW(t, n))), FX.limbs([DC.SPO(t)]), byteP(t, n, VS.x8(k), en, hp)), hb))
  F.logic__true_false(Equal.trans(Bool, True{}, DC.CHK(t, n), False{}, Equal.sym(Bool, DC.CHK(t, n), True{}, chk_true(t, n, k, en, hk, epo)), hchk))

def rej_f(+d: Nat, +t: F.array__Tree<U32>, +n: U32, +pf: {F.array__perfect(U32, d, t) == True{} : Bool},
    +hn: {Nat.is_le(U32.to_nat(n), A.quad(VB.pw(d))) == True{} : Bool}, +hchk: {DC.CHK(t, n) == False{} : Bool},
    facts: FACTS(DC.VW(t, n))) -> Empty:
  (+hb, ex) = facts
  rej_k(d, t, n, pf, hn, hchk, hb, ex)

# When the validator refuses, no value is related to the buffer's bytes.
law decode_reject:
  for +d: Nat
  for +t: F.array__Tree<U32>
  for +n: U32
  for +pf: {F.array__perfect(U32, d, t) == True{} : Bool}
  for +hn: {Nat.is_le(U32.to_nat(n), A.quad(VB.pw(d))) == True{} : Bool}
  for +hchk: {DC.CHK(t, n) == False{} : Bool}
  Decoding.outside_image(Spec.IndexedAttestation(), DC.VW(t, n))
def decode_reject(d, t, n, pf, hn, hchk):
  v => e => rej_f(d, t, n, pf, hn, hchk, inv_v(v, DC.VW(t, n), e))

# decode window: the proof is on the decoder of a window inside the buffer
def none_go_in(+d: Nat, +t: F.array__Tree<U32>, +n: U32, +pf: {F.array__perfect(U32, d, t) == True{} : Bool}, +hd: {Nat.is_lt(d, 31n) == True{} : Bool},
    +hn: {Nat.is_le(U32.to_nat(n), A.quad(VB.pw(d))) == True{} : Bool}, +hchk: {DC.CHK(t, n) == False{} : Bool},
    +a: Bool, +ea: {U32.is_le(228, n) == a : Bool})
    -> {FuluIndexedAttestation_r.IndexedAttestation_decode_in(DC.BF(t, n), n) == (DC.BF(t, n), None{}) : B.Buf & Maybe<&1, FuluIndexedAttestation_d.IndexedAttestation>}:
  match a:
    case False{}:
      %Equal.sym(Bool, U32.is_le(228, n), False{}, ea) :
        {FuluIndexedAttestation_r.IndexedAttestation_built(n, FuluIndexedAttestation_r.IndexedAttestation_ok_len(_, DC.BF(t, n), 0, n)) == (DC.BF(t, n), None{}) : B.Buf & Maybe<&1, FuluIndexedAttestation_d.IndexedAttestation>}
      {==}
    case True{}:
      +hF = F.logic__subst(Bool, z => {z == True{} : Bool}, U32.is_le(228, n), Nat.is_le(228n, U32.to_nat(n)), VU.le_u32(228, n), ea)
      %Equal.sym(B.Buf & Bool, FuluIndexedAttestation_r.IndexedAttestation_ok(DC.BF(t, n), 0, n), (DC.BF(t, n), DC.CHK(t, n)), DC.ok_eval(d, t, n, VB.lt32(d, hd), hpoD(d, n, hn, hF), pf)) :
        {FuluIndexedAttestation_r.IndexedAttestation_built(n, _) == (DC.BF(t, n), None{}) : B.Buf & Maybe<&1, FuluIndexedAttestation_d.IndexedAttestation>}
      %Equal.sym(Bool, DC.CHK(t, n), False{}, hchk) :
        {FuluIndexedAttestation_r.IndexedAttestation_built(n, (DC.BF(t, n), _)) == (DC.BF(t, n), None{}) : B.Buf & Maybe<&1, FuluIndexedAttestation_d.IndexedAttestation>}
      {==}

def none_go(+d: Nat, +t: F.array__Tree<U32>, +n: U32, +pf: {F.array__perfect(U32, d, t) == True{} : Bool}, +hd: {Nat.is_lt(d, 31n) == True{} : Bool},
    +hn: {Nat.is_le(U32.to_nat(n), A.quad(VB.pw(d))) == True{} : Bool}, +hchk: {DC.CHK(t, n) == False{} : Bool},
    +a: Bool, +ea: {U32.is_le(228, n) == a : Bool})
    -> {FuluIndexedAttestation_r.IndexedAttestation_decode(DC.BF(t, n), n) == (DC.BF(t, n), None{}) : B.Buf & Maybe<&1, FuluIndexedAttestation_d.IndexedAttestation>}:
  DW_FuluIndexedAttestation.IndexedAttestation_win_none(DC.BF(t, n), n, none_go_in(d, t, n, pf, hd, hn, hchk, a, ea))

# When the validator refuses, the decoder returns None and the buffer.
# decode window: the proof is on the decoder of a window inside the buffer
law decode_none_in:
  for +d: Nat
  for +t: F.array__Tree<U32>
  for +n: U32
  for +pf: {F.array__perfect(U32, d, t) == True{} : Bool}
  for +hd: {Nat.is_lt(d, 31n) == True{} : Bool}
  for +hn: {Nat.is_le(U32.to_nat(n), A.quad(VB.pw(d))) == True{} : Bool}
  for +hchk: {DC.CHK(t, n) == False{} : Bool}
  {FuluIndexedAttestation_r.IndexedAttestation_decode_in(DC.BF(t, n), n) == (DC.BF(t, n), None{}) : B.Buf & Maybe<&1, FuluIndexedAttestation_d.IndexedAttestation>}
def decode_none_in(d, t, n, pf, hd, hn, hchk):
  none_go_in(d, t, n, pf, hd, hn, hchk, U32.is_le(228, n), {==})

law decode_none:
  for +d: Nat
  for +t: F.array__Tree<U32>
  for +n: U32
  for +pf: {F.array__perfect(U32, d, t) == True{} : Bool}
  for +hd: {Nat.is_lt(d, 31n) == True{} : Bool}
  for +hn: {Nat.is_le(U32.to_nat(n), A.quad(VB.pw(d))) == True{} : Bool}
  for +hchk: {DC.CHK(t, n) == False{} : Bool}
  {FuluIndexedAttestation_r.IndexedAttestation_decode(DC.BF(t, n), n) == (DC.BF(t, n), None{}) : B.Buf & Maybe<&1, FuluIndexedAttestation_d.IndexedAttestation>}
def decode_none(d, t, n, pf, hd, hn, hchk):
  DW_FuluIndexedAttestation.IndexedAttestation_win_none(DC.BF(t, n), n, decode_none_in(d, t, n, pf, hd, hn, hchk))

