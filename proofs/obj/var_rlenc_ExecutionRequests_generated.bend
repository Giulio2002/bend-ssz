# ---- l2_ConsolidationRequest: the object's value, and the windows of its writes ----

def ITW_l2_ConsolidationRequest(c: Nat, +A: FD.array__Tree<FuluConsolidationRequest_d.ConsolidationRequest>, +j: Nat) -> S.Value:
  match c:
    case 0n: S.EmptyItems{}
    case 1n+q: S.Items{RVW_ConsolidationRequest(EL_l2_ConsolidationRequest(A, j)), ITW_l2_ConsolidationRequest(q, A, 1n+j)}

def CHW_l2_ConsolidationRequest(c: Nat, +A: FD.array__Tree<FuluConsolidationRequest_d.ConsolidationRequest>, +j: Nat) -> +List<+List<U32>>:
  match c:
    case 0n: []
    case 1n+q: Con{RWD_ConsolidationRequest(EL_l2_ConsolidationRequest(A, j)), CHW_l2_ConsolidationRequest(q, A, 1n+j)}

def RWA_l2_ConsolidationRequest(c: Nat, +A: FD.array__Tree<FuluConsolidationRequest_d.ConsolidationRequest>, +j: Nat) -> List<&2, U32>:
  match c:
    case 0n: []
    case 1n+q: VF.app(RWD_ConsolidationRequest(EL_l2_ConsolidationRequest(A, j)), RWA_l2_ConsolidationRequest(q, A, 1n+j))

law cntW_l2_ConsolidationRequest:
  for +c: Nat
  for +A: FD.array__Tree<FuluConsolidationRequest_d.ConsolidationRequest>
  for +j: Nat
  {Codec.count(ITW_l2_ConsolidationRequest(c, A, j)) == c : Nat}
def cntW_l2_ConsolidationRequest(c, A, j):
  match c:
    case 0n: {==}
    case 1n+ +q: FD.nat__succ_cong(Codec.count(ITW_l2_ConsolidationRequest(q, A, 1n+j)), q, cntW_l2_ConsolidationRequest(q, A, 1n+j))

law prtW_l2_ConsolidationRequest:
  for +c: Nat
  for +A: FD.array__Tree<FuluConsolidationRequest_d.ConsolidationRequest>
  for +j: Nat
  {Codec.parts(ITW_l2_ConsolidationRequest(c, A, j), S.Repeat{S.Container{["source_address", "source_pubkey", "target_pubkey"], S.Chain{S.ByteVector{20n}, S.Chain{S.ByteVector{48n}, S.Chain{S.ByteVector{48n}, S.End{}}}}}}) == Some{F.fparts(CHW_l2_ConsolidationRequest(c, A, j))} : Maybe<&2, +List<S.Part>>}
def prtW_l2_ConsolidationRequest(c, A, j):
  match c:
    case 0n: {==}
    case 1n+ +q:
      F.cat_fixed(Codec.parts(RVW_ConsolidationRequest(EL_l2_ConsolidationRequest(A, j)), S.Container{["source_address", "source_pubkey", "target_pubkey"], S.Chain{S.ByteVector{20n}, S.Chain{S.ByteVector{48n}, S.Chain{S.ByteVector{48n}, S.End{}}}}}), F.limbs(RWD_ConsolidationRequest(EL_l2_ConsolidationRequest(A, j))), Codec.parts(ITW_l2_ConsolidationRequest(q, A, 1n+j), S.Repeat{S.Container{["source_address", "source_pubkey", "target_pubkey"], S.Chain{S.ByteVector{20n}, S.Chain{S.ByteVector{48n}, S.Chain{S.ByteVector{48n}, S.End{}}}}}}),
        F.fparts(CHW_l2_ConsolidationRequest(q, A, 1n+j)), rparts_ConsolidationRequest(EL_l2_ConsolidationRequest(A, j)), prtW_l2_ConsolidationRequest(q, A, 1n+j))

law flatW_l2_ConsolidationRequest:
  for +c: Nat
  for +A: FD.array__Tree<FuluConsolidationRequest_d.ConsolidationRequest>
  for +j: Nat
  {F.flat(CHW_l2_ConsolidationRequest(c, A, j)) == F.limbs(RWA_l2_ConsolidationRequest(c, A, j)) : +List<U32>}
def flatW_l2_ConsolidationRequest(c, A, j):
  match c:
    case 0n: {==}
    case 1n+ +q:
      %Equal.sym(+List<U32>, F.flat(CHW_l2_ConsolidationRequest(q, A, 1n+j)), F.limbs(RWA_l2_ConsolidationRequest(q, A, 1n+j)), flatW_l2_ConsolidationRequest(q, A, 1n+j)) :
        {List.append(&2, U32, F.limbs(RWD_ConsolidationRequest(EL_l2_ConsolidationRequest(A, j))), _) == F.limbs(RWA_l2_ConsolidationRequest(1n+q, A, j)) : +List<U32>}
      Equal.sym(+List<U32>, F.limbs(VF.app(RWD_ConsolidationRequest(EL_l2_ConsolidationRequest(A, j)), RWA_l2_ConsolidationRequest(q, A, 1n+j))), List.append(&2, U32, F.limbs(RWD_ConsolidationRequest(EL_l2_ConsolidationRequest(A, j))), F.limbs(RWA_l2_ConsolidationRequest(q, A, 1n+j))),
        VF.limbs_app(RWD_ConsolidationRequest(EL_l2_ConsolidationRequest(A, j)), RWA_l2_ConsolidationRequest(q, A, 1n+j)))

law lenW_l2_ConsolidationRequest:
  for +c: Nat
  for +A: FD.array__Tree<FuluConsolidationRequest_d.ConsolidationRequest>
  for +j: Nat
  {VF.slen(RWA_l2_ConsolidationRequest(c, A, j)) == Nat.mul(c, 29n) : Nat}
def lenW_l2_ConsolidationRequest(c, A, j):
  match c:
    case 0n: {==}
    case 1n+ +q:
      %Equal.sym(Nat, VF.slen(RWA_l2_ConsolidationRequest(1n+q, A, j)), Nat.add(VF.slen(RWD_ConsolidationRequest(EL_l2_ConsolidationRequest(A, j))), VF.slen(RWA_l2_ConsolidationRequest(q, A, 1n+j))), FD.list__length_append(U32, RWD_ConsolidationRequest(EL_l2_ConsolidationRequest(A, j)), RWA_l2_ConsolidationRequest(q, A, 1n+j))) :
        {_ == Nat.mul(1n+q, 29n) : Nat}
      %Equal.sym(Nat, VF.slen(RWD_ConsolidationRequest(EL_l2_ConsolidationRequest(A, j))), 29n, rlen_ConsolidationRequest(EL_l2_ConsolidationRequest(A, j))) : {Nat.add(_, VF.slen(RWA_l2_ConsolidationRequest(q, A, 1n+j))) == Nat.mul(1n+q, 29n) : Nat}
      %Equal.sym(Nat, VF.slen(RWA_l2_ConsolidationRequest(q, A, 1n+j)), Nat.mul(q, 29n), lenW_l2_ConsolidationRequest(q, A, 1n+j)) : {Nat.add(29n, _) == Nat.mul(1n+q, 29n) : Nat}
      {==}

# The value of c records, a list of at most 2: one variable part, the limbs of their words.
def lpart_l2_ConsolidationRequest(+c: Nat, +A: FD.array__Tree<FuluConsolidationRequest_d.ConsolidationRequest>, +hl: {Nat.is_le(c, U32.to_nat(2)) == True{} : Bool},
    +fit: {N.fits(4n, List.length(&2, U32, F.limbs(RWA_l2_ConsolidationRequest(c, A, 0n)))) == True{} : Bool})
