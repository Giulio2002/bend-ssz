# the run of record j lies in the tree
def hbj_l16_WithdrawalRequest(+j: Nat, +dd: Nat, +Q: Nat, +A: FD.array__Tree<FuluWithdrawalRequest_d.WithdrawalRequest>, +P: Nat, +h: {Nat.is_le(VRL.pos(1n+j, 19n, Q), P) == True{} : Bool})
