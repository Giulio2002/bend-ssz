    case 1n+ +q:
      %Equal.sym(Nat, VF.slen(RWA_l16_WithdrawalRequest(1n+q, A, j)), Nat.add(VF.slen(RWD_WithdrawalRequest(EL_l16_WithdrawalRequest(A, j))), VF.slen(RWA_l16_WithdrawalRequest(q, A, 1n+j))), FD.list__length_append(U32, RWD_WithdrawalRequest(EL_l16_WithdrawalRequest(A, j)), RWA_l16_WithdrawalRequest(q, A, 1n+j))) :
