      +hb2 = FD.logic__subst(Nat, z => {Nat.is_le(VRL.pos(1n+z, 19n, Q), VB.pw(dd)) == True{} : Bool}, 1n+Nat.add(q, j), Nat.add(q, 1n+j), Equal.sym(Nat, Nat.add(q, 1n+j), 1n+Nat.add(q, j), FD.nat__add_succ(q, j)), hb)
      Equal.trans(List<&2, U32>, VF.WIN(m, p, FD.array__slots(U32, WT_l16_WithdrawalRequest(q, 1n+j, dd, D1, Q, A))), VF.WIN(m, p, FD.array__slots(U32, D1)), VF.WIN(m, p, FD.array__slots(U32, D)),
        WTlo_l16_WithdrawalRequest(q, 1n+j, dd, D1, Q, A, m, p, VF.updv_perfect(RWD_WithdrawalRequest(EL_l16_WithdrawalRequest(A, j)), dd, D, VRL.pos(j, 19n, Q), pf), hb2, FD.nat__le_trans(Nat.add(m, p), VRL.pos(j, 19n, Q), VRL.pos(1n+j, 19n, Q), h, VRL.pmono(j, 19n, Q))),
        V2.peel_hi(RWD_WithdrawalRequest(EL_l16_WithdrawalRequest(A, j)), dd, D, VRL.pos(j, 19n, Q), m, p, pf, hbj_l16_WithdrawalRequest(j, dd, Q, A, VB.pw(dd), VRL.fit0inv(j, 19n, Q, VB.pw(dd), VRL.fitk(j, q, 19n, Q, VB.pw(dd), hb))), h))

