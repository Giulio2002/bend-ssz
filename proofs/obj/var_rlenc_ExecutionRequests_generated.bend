# ---- l16_WithdrawalRequest: the object's value, and the windows of its writes ----

def ITW_l16_WithdrawalRequest(c: Nat, +A: FD.array__Tree<FuluWithdrawalRequest_d.WithdrawalRequest>, +j: Nat) -> S.Value:
  match c:
    case 0n: S.EmptyItems{}
    case 1n+q: S.Items{RVW_WithdrawalRequest(EL_l16_WithdrawalRequest(A, j)), ITW_l16_WithdrawalRequest(q, A, 1n+j)}

def CHW_l16_WithdrawalRequest(c: Nat, +A: FD.array__Tree<FuluWithdrawalRequest_d.WithdrawalRequest>, +j: Nat) -> +List<+List<U32>>:
  match c:
    case 0n: []
    case 1n+q: Con{RWD_WithdrawalRequest(EL_l16_WithdrawalRequest(A, j)), CHW_l16_WithdrawalRequest(q, A, 1n+j)}

def RWA_l16_WithdrawalRequest(c: Nat, +A: FD.array__Tree<FuluWithdrawalRequest_d.WithdrawalRequest>, +j: Nat) -> List<&2, U32>:
  match c:
    case 0n: []
    case 1n+q: VF.app(RWD_WithdrawalRequest(EL_l16_WithdrawalRequest(A, j)), RWA_l16_WithdrawalRequest(q, A, 1n+j))

law cntW_l16_WithdrawalRequest:
  for +c: Nat
  for +A: FD.array__Tree<FuluWithdrawalRequest_d.WithdrawalRequest>
  for +j: Nat
  {Codec.count(ITW_l16_WithdrawalRequest(c, A, j)) == c : Nat}
def cntW_l16_WithdrawalRequest(c, A, j):
  match c:
    case 0n: {==}
    case 1n+ +q: FD.nat__succ_cong(Codec.count(ITW_l16_WithdrawalRequest(q, A, 1n+j)), q, cntW_l16_WithdrawalRequest(q, A, 1n+j))

law prtW_l16_WithdrawalRequest:
  for +c: Nat
  for +A: FD.array__Tree<FuluWithdrawalRequest_d.WithdrawalRequest>
  for +j: Nat
  {Codec.parts(ITW_l16_WithdrawalRequest(c, A, j), S.Repeat{S.Container{["source_address", "validator_pubkey", "amount"], S.Chain{S.ByteVector{20n}, S.Chain{S.ByteVector{48n}, S.Chain{S.Unsigned{P.U64{}}, S.End{}}}}}}) == Some{F.fparts(CHW_l16_WithdrawalRequest(c, A, j))} : Maybe<&2, +List<S.Part>>}
def prtW_l16_WithdrawalRequest(c, A, j):
  match c:
    case 0n: {==}
    case 1n+ +q:
      F.cat_fixed(Codec.parts(RVW_WithdrawalRequest(EL_l16_WithdrawalRequest(A, j)), S.Container{["source_address", "validator_pubkey", "amount"], S.Chain{S.ByteVector{20n}, S.Chain{S.ByteVector{48n}, S.Chain{S.Unsigned{P.U64{}}, S.End{}}}}}), F.limbs(RWD_WithdrawalRequest(EL_l16_WithdrawalRequest(A, j))), Codec.parts(ITW_l16_WithdrawalRequest(q, A, 1n+j), S.Repeat{S.Container{["source_address", "validator_pubkey", "amount"], S.Chain{S.ByteVector{20n}, S.Chain{S.ByteVector{48n}, S.Chain{S.Unsigned{P.U64{}}, S.End{}}}}}}),
        F.fparts(CHW_l16_WithdrawalRequest(q, A, 1n+j)), rparts_WithdrawalRequest(EL_l16_WithdrawalRequest(A, j)), prtW_l16_WithdrawalRequest(q, A, 1n+j))

law flatW_l16_WithdrawalRequest:
  for +c: Nat
  for +A: FD.array__Tree<FuluWithdrawalRequest_d.WithdrawalRequest>
  for +j: Nat
  {F.flat(CHW_l16_WithdrawalRequest(c, A, j)) == F.limbs(RWA_l16_WithdrawalRequest(c, A, j)) : +List<U32>}
def flatW_l16_WithdrawalRequest(c, A, j):
  match c:
    case 0n: {==}
    case 1n+ +q:
      %Equal.sym(+List<U32>, F.flat(CHW_l16_WithdrawalRequest(q, A, 1n+j)), F.limbs(RWA_l16_WithdrawalRequest(q, A, 1n+j)), flatW_l16_WithdrawalRequest(q, A, 1n+j)) :
        {List.append(&2, U32, F.limbs(RWD_WithdrawalRequest(EL_l16_WithdrawalRequest(A, j))), _) == F.limbs(RWA_l16_WithdrawalRequest(1n+q, A, j)) : +List<U32>}
      Equal.sym(+List<U32>, F.limbs(VF.app(RWD_WithdrawalRequest(EL_l16_WithdrawalRequest(A, j)), RWA_l16_WithdrawalRequest(q, A, 1n+j))), List.append(&2, U32, F.limbs(RWD_WithdrawalRequest(EL_l16_WithdrawalRequest(A, j))), F.limbs(RWA_l16_WithdrawalRequest(q, A, 1n+j))),
        VF.limbs_app(RWD_WithdrawalRequest(EL_l16_WithdrawalRequest(A, j)), RWA_l16_WithdrawalRequest(q, A, 1n+j)))

law lenW_l16_WithdrawalRequest:
  for +c: Nat
  for +A: FD.array__Tree<FuluWithdrawalRequest_d.WithdrawalRequest>
  for +j: Nat
  {VF.slen(RWA_l16_WithdrawalRequest(c, A, j)) == Nat.mul(c, 19n) : Nat}
