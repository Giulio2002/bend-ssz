    Equal.sym(+List<U32>, F.flat(CHW_l16_WithdrawalRequest(c, A, 0n)), F.limbs(RWA_l16_WithdrawalRequest(c, A, 0n)), flatW_l16_WithdrawalRequest(c, A, 0n)), fit)
