    {Codec.require(_, Codec.aggregate(Codec.parts(ITW_l16_WithdrawalRequest(c, A, 0n), S.Repeat{S.Container{["source_address", "validator_pubkey", "amount"], S.Chain{S.ByteVector{20n}, S.Chain{S.ByteVector{48n}, S.Chain{S.Unsigned{P.U64{}}, S.End{}}}}}}), None{})) == Some{[S.Variable{F.limbs(RWA_l16_WithdrawalRequest(c, A, 0n))}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(Maybe<&2, +List<S.Part>>, Codec.parts(ITW_l16_WithdrawalRequest(c, A, 0n), S.Repeat{S.Container{["source_address", "validator_pubkey", "amount"], S.Chain{S.ByteVector{20n}, S.Chain{S.ByteVector{48n}, S.Chain{S.Unsigned{P.U64{}}, S.End{}}}}}}), Some{F.fparts(CHW_l16_WithdrawalRequest(c, A, 0n))}, prtW_l16_WithdrawalRequest(c, A, 0n)) :
