  %Equal.sym(Maybe<&2, +List<U32>>, Layout.encoding(F.fparts(CHW_l16_WithdrawalRequest(c, A, 0n))), Some{F.flat(CHW_l16_WithdrawalRequest(c, A, 0n))}, VS.encoding_fparts(CHW_l16_WithdrawalRequest(c, A, 0n), fit2)) :
