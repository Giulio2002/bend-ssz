  +h3 = F.logic__subst(Nat, z => {Nat.is_le(Nat.add(VD.s_rng(2n, VC.YL(L)), 8n), z) == True{} : Bool}, Nat.double(P), O.pow2n(1n+d), VD.s_pow2_eq(1n+d), h2)
