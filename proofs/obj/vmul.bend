    Equal.sym(Nat, Nat.add(A.quad(U32.to_nat(U32.shrn(x, 2n))), 0n), A.quad(U32.to_nat(U32.shrn(x, 2n))), F.nat__add_zero(A.quad(U32.to_nat(U32.shrn(x, 2n))))),
