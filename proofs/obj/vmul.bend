def le15(+P: Nat) -> {Nat.add(15n, P) == Nat.add(7n+P, 8n) : Nat}:
  Equal.sym(Nat, Nat.add(7n+P, 8n), 15n+P, F.nat__add_comm(7n+P, 8n))

