  F.nat__sub_add(U32.to_nat(a), U32.to_nat(b), hn)

# quad is injective
def quad_inj(+a: Nat, +b: Nat, +e: {A.quad(a) == A.quad(b) : Nat}) -> {a == b : Nat}:
  F.nat__double_inj(a, b, F.nat__double_inj(Nat.double(a), Nat.double(b), e))

