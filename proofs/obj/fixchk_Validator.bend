# every encoding at Validator: its byte 88 is 0 or 1
def pv_r(+ps: +List<S.Part>, +items: S.Value, +em: {Codec.parts(items, S.Chain{Spec.Schema8(), S.Chain{Spec.Schema7(), S.Chain{Spec.Schema3(), S.Chain{Spec.Schema0(), S.Chain{Spec.Schema3(), S.Chain{Spec.Schema3(), S.Chain{Spec.Schema3(), S.Chain{Spec.Schema3(), S.End{}}}}}}}}}) == Some{ps} : Maybe<&2, +List<S.Part>>},
    +w: Maybe<&2, Nat>, +bs: +List<U32>, +r: Maybe<&2, +List<U32>>, +er: {Layout.encoding(ps) == r : Maybe<&2, +List<U32>>},
    +e: {Codec.bytes(Codec.one(r, w)) == Some{bs} : Maybe<&2, +List<U32>>})
    -> {U32.is_le(VBL.nthb(bs, 88n), 1) == True{} : Bool}:
  match r:
    case None{}: Empty.absurd({U32.is_le(VBL.nthb(bs, 88n), 1) == True{} : Bool}, FD.logic__none_some(+List<U32>, bs, e))
    case Some{+xs}:
      +c = Bool.and(Layout.bytes_valid(ps), N.fits(4n, Nat.add(Layout.fixed_size(ps), List.length(&2, U32, Layout.payloads(ps)))))
      +e1 = VRB.opt_some(c, List.append(&2, U32, Layout.fixed_parts(ps, Layout.fixed_size(ps)), Layout.payloads(ps)), xs, er)
      FD.logic__subst(+List<U32>, z => {U32.is_le(VBL.nthb(z, 88n), 1) == True{} : Bool}, List.append(&2, U32, Layout.fixed_parts(ps, Layout.fixed_size(ps)), Layout.payloads(ps)), bs,
        Equal.trans(+List<U32>, List.append(&2, U32, Layout.fixed_parts(ps, Layout.fixed_size(ps)), Layout.payloads(ps)), xs, bs, e1, VRB.frag(w, xs, bs, e)),
        lvl0(items, ps, Layout.fixed_size(ps), em))
