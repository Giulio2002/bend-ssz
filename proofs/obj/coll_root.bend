      +slack2 = UT.tail_w(d, t, q, x0, x1, Nat.add(qc, 0n), U32.to_nat(i), qc, U32.to_nat(U32.shrn(n, 3n)), r, F.nat__add_zero(qc), hqe, hlt1, h1, h32, hr, pf, slack, UT.split8(Nat.double(Nat.double(qc)), U32.to_nat(U32.shrn(n, 3n)), r, ecq))
