# The window's bytes: the header words' limbs, then the child's window.
def limw(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +ha: {U32.is_le(36, len) == True{} : Bool}, +epo: {SPOw(t, x) == 36 : U32})
    -> {List.append(&2, U32, F.limbs([UR.RWN(t, x), UR.RWN(t, 4n+x), UR.RWN(t, 8n+x), UR.RWN(t, 12n+x), UR.RWN(t, 16n+x), UR.RWN(t, 20n+x), UR.RWN(t, 24n+x), UR.RWN(t, 28n+x), 36]), UW.WX(t, JW(x), U32.to_nat(LLw(len)))) == UW.WX(t, x, U32.to_nat(len)) : +List<U32>}:
  +hw2 = FD.logic__subst(Nat, z => {Nat.is_le(Nat.add(x, z), A.quad(VB.pw(d))) == True{} : Bool}, U32.to_nat(len), Nat.add(36n, U32.to_nat(LLw(len))), Equal.sym(Nat, Nat.add(36n, U32.to_nat(LLw(len))), U32.to_nat(len), enF(len, ha)), hw)
  %enF(len, ha) : {List.append(&2, U32, F.limbs([UR.RWN(t, x), UR.RWN(t, 4n+x), UR.RWN(t, 8n+x), UR.RWN(t, 12n+x), UR.RWN(t, 16n+x), UR.RWN(t, 20n+x), UR.RWN(t, 24n+x), UR.RWN(t, 28n+x), 36]), UW.WX(t, JW(x), U32.to_nat(LLw(len)))) == UW.WX(t, x, _) : +List<U32>}
  %Equal.sym(+List<U32>, UW.WX(t, x, Nat.add(A.quad(9n), U32.to_nat(LLw(len)))), List.append(&2, U32, F.limbs(UR.RWS(9n, t, x)), UW.WX(t, Nat.add(A.quad(9n), x), U32.to_nat(LLw(len)))),
      UW.headWX(d, t, x, 9n, U32.to_nat(LLw(len)), pf, hw2)) :
    {List.append(&2, U32, F.limbs([UR.RWN(t, x), UR.RWN(t, 4n+x), UR.RWN(t, 8n+x), UR.RWN(t, 12n+x), UR.RWN(t, 16n+x), UR.RWN(t, 20n+x), UR.RWN(t, 24n+x), UR.RWN(t, 28n+x), 36]), UW.WX(t, JW(x), U32.to_nat(LLw(len)))) == _ : +List<U32>}
  %epo : {List.append(&2, U32, F.limbs([UR.RWN(t, x), UR.RWN(t, 4n+x), UR.RWN(t, 8n+x), UR.RWN(t, 12n+x), UR.RWN(t, 16n+x), UR.RWN(t, 20n+x), UR.RWN(t, 24n+x), UR.RWN(t, 28n+x), _]), UW.WX(t, JW(x), U32.to_nat(LLw(len)))) == List.append(&2, U32, F.limbs(UR.RWS(9n, t, x)), UW.WX(t, JW(x), U32.to_nat(LLw(len)))) : +List<U32>}
  {==}

# Definitions per step: a container's parts one step down and one field before the rest, over opaque values
# (a conversion that is not a syntactic match would evaluate the fields' parts).
def gcv_(+v: S.Value, +vs: S.Value, +s: S.Schema, +rs: S.Schema, +y: +List<U32>, +rest: +List<S.Part>,
    +ea: {Codec.parts(v, s) == Some{[S.Variable{y}]} : Maybe<&2, +List<S.Part>>}, +eb: {Codec.parts(vs, rs) == Some{rest} : Maybe<&2, +List<S.Part>>})
    -> {Codec.parts(S.Items{v, vs}, S.Chain{s, rs}) == Some{S.Variable{y} <> rest} : Maybe<&2, +List<S.Part>>}:
  VS.cat_var(Codec.parts(v, s), y, Codec.parts(vs, rs), rest, ea, eb)

def gcf_(+v: S.Value, +vs: S.Value, +s: S.Schema, +rs: S.Schema, +xs: +List<U32>, +rest: +List<S.Part>,
    +ea: {Codec.parts(v, s) == Some{[S.Fixed{xs}]} : Maybe<&2, +List<S.Part>>}, +eb: {Codec.parts(vs, rs) == Some{rest} : Maybe<&2, +List<S.Part>>})
    -> {Codec.parts(S.Items{v, vs}, S.Chain{s, rs}) == Some{S.Fixed{xs} <> rest} : Maybe<&2, +List<S.Part>>}:
  F.cat_fixed(Codec.parts(v, s), xs, Codec.parts(vs, rs), rest, ea, eb)

def FVc0(+t: FD.array__Tree<U32>, +x: Nat) -> S.Value: S.BytesValue{F.limbs([UR.RWN(t, x), UR.RWN(t, 4n+x), UR.RWN(t, 8n+x), UR.RWN(t, 12n+x), UR.RWN(t, 16n+x), UR.RWN(t, 20n+x), UR.RWN(t, 24n+x), UR.RWN(t, 28n+x)])}

def fvq0(+t: FD.array__Tree<U32>, +x: Nat) -> {S.BytesValue{F.limbs([UR.RWN(t, x), UR.RWN(t, 4n+x), UR.RWN(t, 8n+x), UR.RWN(t, 12n+x), UR.RWN(t, 16n+x), UR.RWN(t, 20n+x), UR.RWN(t, 24n+x), UR.RWN(t, 28n+x)])} == FVc0(t, x) : S.Value}:
