    case FuluSingleAttestation_d.SingleAttestation{+x0, +x1, +x2, +x3}: S.Sequence{S.Items{v_u64(x0), S.Items{v_u64(x1), S.Items{v_AttestationData(x2), S.Items{v_b96(x3), S.EmptyItems{}}}}}}
def vb_bv64(o: Fulu_bitvector_64_d.Bitvector64) -> +List<U32>:
  match o:
    case Fulu_bitvector_64_d.Bitvector64{+w0, +w1}: F.limbs([w0, w1])
def domain_bv64(+o: Fulu_bitvector_64_d.Bitvector64) -> {VD.bytevector_domain(8n, vb_bv64(o)) == True{} : Bool}:
  match o:
    case Fulu_bitvector_64_d.Bitvector64{+w0, +w1}: F.scope_limbs([w0, w1])
def bits_bv64(o: Fulu_bitvector_64_d.Bitvector64) -> +List<Bool>:
  match o:
    case Fulu_bitvector_64_d.Bitvector64{+w0, +w1}: List.append(&2, Bool, BL.wbits(w0), List.append(&2, Bool, BL.wbits(w1), []))
def v_bv64(o: Fulu_bitvector_64_d.Bitvector64) -> S.Value: S.BitsValue{bits_bv64(o)}
def blen_bv64(+o: Fulu_bitvector_64_d.Bitvector64) -> {List.length(&2, Bool, bits_bv64(o)) == 64n : Nat}:
  match o:
    case Fulu_bitvector_64_d.Bitvector64{+w0, +w1}:
      %Equal.sym(Nat, List.length(&2, Bool, List.append(&2, Bool, BL.wbits(w0), List.append(&2, Bool, BL.wbits(w1), []))), Nat.add(32n, List.length(&2, Bool, List.append(&2, Bool, BL.wbits(w1), []))), BL.len_app_w(w0, List.append(&2, Bool, BL.wbits(w1), []))) :
        {_ == 64n : Nat}
      %Equal.sym(Nat, List.length(&2, Bool, List.append(&2, Bool, BL.wbits(w1), [])), Nat.add(32n, List.length(&2, Bool, [])), BL.len_app_w(w1, [])) :
        {Nat.add(32n, _) == 64n : Nat}
      {==}
