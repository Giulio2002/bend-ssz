  DK.P2({U32.is_eq(Bp.octet(b0, True{}, False{}, False{}, False{}, False{}, False{}, False{}), 0) == False{} : Bool}, {1n == hb(Bp.octet(b0, True{}, False{}, False{}, False{}, False{}, False{}, False{})) : Nat})
def inv1(b0):
  %Equal.sym(U32, Bp.octet(b0, True{}, False{}, False{}, False{}, False{}, False{}, False{}), PD.embed8(WCon{b0, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WNil{}}}}}}}}}), BLf.oct8(b0, True{}, False{}, False{}, False{}, False{}, False{}, False{})) :
    DK.P2({U32.is_eq(_, 0) == False{} : Bool}, {1n == hb(_) : Nat})
  ({==}, hb1(b0))

