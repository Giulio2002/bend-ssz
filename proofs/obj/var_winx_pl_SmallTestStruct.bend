      +hcP = FD.logic__subst(Nat, z => {Nat.is_le(c, z) == True{} : Bool}, O.pow2n(B.words_depth(NN(len))), VB.pw(B.words_depth(NN(len))), Equal.sym(Nat, VB.pw(B.words_depth(NN(len))), O.pow2n(B.words_depth(NN(len))), VD.s_pow2_eq(B.words_depth(NN(len)))), hcp)
      +hk = FD.logic__subst(Nat, z => {Nat.is_lt(z, VB.pw(B.words_depth(NN(len)))) == True{} : Bool}, k, Nat.add(k, 0n), Equal.sym(Nat, Nat.add(k, 0n), k, FD.nat__add_zero(k)),
        FD.nat__lt_le_trans(k, c, VB.pw(B.words_depth(NN(len))), FD.logic__subst(Nat, z => {Nat.is_lt(k, z) == True{} : Bool}, 1n+k, c, e1, FD.nat__lt_succ(k)), hcP))
      +hdd = FD.nat__le_lt_trans(B.words_depth(NN(len)), d, 32n, VD.wd_min(NN(len), d, hcN), FD.nat__lt_trans(d, 31n, 32n, hd, {==}))
      +hb0 = FD.nat__le_trans(Nat.add(x, 4n), Nat.add(x, U32.to_nat(len)), P,
        Order.add_left(x, 4n, U32.to_nat(len), FD.logic__subst(Nat, z => {Nat.is_le(4n, z) == True{} : Bool}, Nat.mul(c, 4n), U32.to_nat(len), Equal.sym(Nat, U32.to_nat(len), Nat.mul(c, 4n), ec),
          FD.logic__subst(Nat, z => {Nat.is_le(4n, Nat.mul(z, 4n)) == True{} : Bool}, 1n+k, c, e1, Order.below_sum(4n, Nat.mul(k, 4n))))), hw)
      +cap = B.words_depth(NN(len))
      %Equal.sym(B.Buf & SmallTestStruct_d.SmallTestStruct, SmallTestStruct_r.SmallTestStruct_read(BF(t, n), off, 4), (BF(t, n), RX(t, x)), rdb(d, t, n, off, x, eo, hd, pf, hb0)) :
        {proglist_SmallTestStruct_r.pl_SmallTestStruct_rd_fin(NN(len), proglist_SmallTestStruct_r.pl_SmallTestStruct_rd(k, 0, off, proglist_SmallTestStruct_d.pl_SmallTestStruct_fill(proglist_SmallTestStruct_d.pl_SmallTestStruct_cap(NN(len))), _)) == (BF(t, n), LOBJ(False{}, t, x, len)) : B.Buf & proglist_SmallTestStruct_d.pl_SmallTestStruct_Seq}
      %Equal.sym(Array<SmallTestStruct_d.SmallTestStruct>, Array.new(SmallTestStruct_d.SmallTestStruct, cap, SmallTestStruct_d.SmallTestStruct_default()), FD.array__thaw(SmallTestStruct_d.SmallTestStruct, FD.array__trep(SmallTestStruct_d.SmallTestStruct, cap, SmallTestStruct_d.SmallTestStruct_default())), FD.array__new(SmallTestStruct_d.SmallTestStruct, cap, SmallTestStruct_d.SmallTestStruct_default())) :
        {proglist_SmallTestStruct_r.pl_SmallTestStruct_rd_fin(NN(len), proglist_SmallTestStruct_r.pl_SmallTestStruct_rd(k, 0, off, _, (BF(t, n), RX(t, x)))) == (BF(t, n), LOBJ(False{}, t, x, len)) : B.Buf & proglist_SmallTestStruct_d.pl_SmallTestStruct_Seq}
      %Equal.sym(B.Buf & Array<SmallTestStruct_d.SmallTestStruct>, proglist_SmallTestStruct_r.pl_SmallTestStruct_rd(k, 0, off, FD.array__thaw(SmallTestStruct_d.SmallTestStruct, FD.array__trep(SmallTestStruct_d.SmallTestStruct, cap, SmallTestStruct_d.SmallTestStruct_default())), (BF(t, n), RX(t, x))),
          (BF(t, n), FD.array__thaw(SmallTestStruct_d.SmallTestStruct, RT(k, 0n, cap, FD.array__trep(SmallTestStruct_d.SmallTestStruct, cap, SmallTestStruct_d.SmallTestStruct_default()), t, x))),
          lp(k, d, t, n, x, off, 0, 0n, cap, FD.array__trep(SmallTestStruct_d.SmallTestStruct, cap, SmallTestStruct_d.SmallTestStruct_default()), eo, {==}, hd, pf, hb, hb32, hdd, hk, FD.array__trep_perfect(SmallTestStruct_d.SmallTestStruct, cap, SmallTestStruct_d.SmallTestStruct_default()))) :
        {proglist_SmallTestStruct_r.pl_SmallTestStruct_rd_fin(NN(len), _) == (BF(t, n), LOBJ(False{}, t, x, len)) : B.Buf & proglist_SmallTestStruct_d.pl_SmallTestStruct_Seq}
      {==}

def readwD(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +hw32: {Nat.is_lt(Nat.add(x, U32.to_nat(len)), FD.spec_common__pow2(32n)) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hchk: {CHKw(t, x, off, len) == True{} : Bool})
    -> {proglist_SmallTestStruct_r.pl_SmallTestStruct_read(BF(t, n), off, len) == (BF(t, n), OBJw(d, t, x, off, len)) : B.Buf & proglist_SmallTestStruct_d.pl_SmallTestStruct_Seq}:
  rd_go(d, t, n, x, off, len, eo, hd, hw, hw32, pf, hchk, U32.is_eq(len, 0), {==})

# ---- the spec side ------------------------------------------------------------------------------

def RITEMS(c: Nat, +t: FD.array__Tree<U32>, +y: Nat) -> S.Value:
  match c:
    case 0n: S.EmptyItems{}
    case 1n+q: S.Items{RVAL(t, y), RITEMS(q, t, Nat.add(4n, y))}

# the records' parts: a fixed part of each record's bytes
def BP(c: Nat, +t: FD.array__Tree<U32>, +y: Nat) -> +List<S.Part>:
  match c:
    case 0n: []
    case 1n+q: Con{S.Fixed{UW.WX(t, y, 4n)}, BP(q, t, Nat.add(4n, y))}

law cnt_items:
  for +c: Nat
  for +t: FD.array__Tree<U32>
  for +y: Nat
  {Codec.count(RITEMS(c, t, y)) == c : Nat}
def cnt_items(c, t, y):
  match c:
    case 0n: {==}
    case 1n+ +q: FD.nat__succ_cong(Codec.count(RITEMS(q, t, Nat.add(4n, y))), q, cnt_items(q, t, Nat.add(4n, y)))

law bp_all:
  for +c: Nat
  for +t: FD.array__Tree<U32>
  for +y: Nat
  {SP2.allfx(BP(c, t, y)) == True{} : Bool}
def bp_all(c, t, y):
  match c:
    case 0n: {==}
    case 1n+ +q: bp_all(q, t, Nat.add(4n, y))

law bp_cat:
  for +c: Nat
  for +t: FD.array__Tree<U32>
  for +y: Nat
  {SP2.fcat(BP(c, t, y)) == UW.WX(t, y, Nat.mul(c, 4n)) : +List<U32>}
def bp_cat(c, t, y):
  match c:
    case 0n: {==}
    case 1n+ +q:
      +M = Nat.mul(q, 4n)
      %Equal.sym(+List<U32>, SP2.fcat(BP(q, t, Nat.add(4n, y))), UW.WX(t, Nat.add(4n, y), M), bp_cat(q, t, Nat.add(4n, y))) :
        {List.append(&2, U32, UW.WX(t, y, 4n), _) == UW.WX(t, y, Nat.mul(1n+q, 4n)) : +List<U32>}
      Equal.sym(+List<U32>, UW.WX(t, y, Nat.add(4n, M)), List.append(&2, U32, UW.WX(t, y, 4n), UW.WX(t, Nat.add(4n, y), M)), UW.splitWX(t, y, 4n, M))

# The records' parts are their bytes.
law prt_items:
  for +c: Nat
  for +d: Nat
  for +t: FD.array__Tree<U32>
  for +y: Nat
  for +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}
  for +h: {Nat.is_le(Nat.add(y, Nat.mul(c, 4n)), A.quad(VB.pw(d))) == True{} : Bool}
  {Codec.parts(RITEMS(c, t, y), S.Repeat{S.Container{["f_A", "f_B"], S.Chain{S.Unsigned{P.U16{}}, S.Chain{S.Unsigned{P.U16{}}, S.End{}}}}}) == Some{BP(c, t, y)} : Maybe<&2, +List<S.Part>>}
def prt_items(c, d, t, y, pf, h):
  match c:
    case 0n: {==}
    case 1n+ +q:
      +M = Nat.mul(q, 4n)
      +e = Equal.trans(Nat, Nat.add(Nat.add(4n, y), M), Nat.add(4n, Nat.add(y, M)), Nat.add(y, Nat.add(4n, M)),
        FD.nat__add_assoc(4n, y, M), FD.lru_nat_algebra__add_swap(4n, y, M))
      +h2 = FD.logic__subst(Nat, z => {Nat.is_le(z, A.quad(VB.pw(d))) == True{} : Bool}, Nat.add(y, Nat.add(4n, M)), Nat.add(Nat.add(4n, y), M), Equal.sym(Nat, Nat.add(Nat.add(4n, y), M), Nat.add(y, Nat.add(4n, M)), e), h)
      +h1 = FD.nat__le_trans(Nat.add(y, 4n), Nat.add(y, Nat.add(4n, M)), A.quad(VB.pw(d)), Order.add_left(y, 4n, Nat.add(4n, M), Order.below_sum(4n, M)), h)
      F.cat_fixed(Codec.parts(RVAL(t, y), S.Container{["f_A", "f_B"], S.Chain{S.Unsigned{P.U16{}}, S.Chain{S.Unsigned{P.U16{}}, S.End{}}}}), UW.WX(t, y, 4n), Codec.parts(RITEMS(q, t, Nat.add(4n, y)), S.Repeat{S.Container{["f_A", "f_B"], S.Chain{S.Unsigned{P.U16{}}, S.Chain{S.Unsigned{P.U16{}}, S.End{}}}}}), BP(q, t, Nat.add(4n, y)),
        RPRF(d, t, y, pf, h1), prt_items(q, d, t, Nat.add(4n, y), pf, h2))

def VALw(+t: FD.array__Tree<U32>, +x: Nat, +len: U32) -> S.Value: S.Sequence{RITEMS(CC(len), t, x)}

def specwD(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +hw32: {Nat.is_lt(Nat.add(x, U32.to_nat(len)), FD.spec_common__pow2(32n)) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hchk: {CHKw(t, x, off, len) == True{} : Bool})
    -> {Codec.parts(VALw(t, x, len), S.ProgressiveList{S.Container{["f_A", "f_B"], S.Chain{S.Unsigned{P.U16{}}, S.Chain{S.Unsigned{P.U16{}}, S.End{}}}}}) == Some{[S.Variable{UW.WX(t, x, U32.to_nat(len))}]} : Maybe<&2, +List<S.Part>>}:
  +c = CC(len)
  +ec = ecw(len, hchk)
  +Y = UW.WX(t, x, Nat.mul(c, 4n))
  +hf = FD.logic__subst(Nat, z => {Nat.is_le(Nat.add(x, z), A.quad(VB.pw(d))) == True{} : Bool}, U32.to_nat(len), Nat.mul(c, 4n), ec, hw)
  +hf32 = FD.logic__subst(Nat, z => {Nat.is_lt(Nat.add(x, z), FD.spec_common__pow2(32n)) == True{} : Bool}, U32.to_nat(len), Nat.mul(c, 4n), ec, hw32)
  +lY = UW.lenWX(d, t, x, Nat.mul(c, 4n), pf, hf)
  +fit = FD.logic__subst(Nat, z => {N.fits(4n, z) == True{} : Bool}, Nat.mul(c, 4n), Nat.add(Nat.mul(c, 4n), 0n), Equal.sym(Nat, Nat.add(Nat.mul(c, 4n), 0n), Nat.mul(c, 4n), FD.nat__add_zero(Nat.mul(c, 4n))),
    VFT.fits4lt(Nat.mul(c, 4n), FD.nat__le_lt_trans(Nat.mul(c, 4n), Nat.add(x, Nat.mul(c, 4n)), FD.spec_common__pow2(32n), Order.left_below_sum(x, Nat.mul(c, 4n)), hf32)))
  +ha = bp_all(c, t, x)
  +cat = bp_cat(c, t, x)
  +hs = Equal.trans(Nat, Layout.fixed_size(BP(c, t, x)), List.length(&2, U32, SP2.fcat(BP(c, t, x))), Nat.mul(c, 4n), SP2.fsz(BP(c, t, x), ha),
    Equal.trans(Nat, List.length(&2, U32, SP2.fcat(BP(c, t, x))), List.length(&2, U32, Y), Nat.mul(c, 4n), Equal.cong(+List<U32>, Nat, z => List.length(&2, U32, z), SP2.fcat(BP(c, t, x)), Y, cat), lY))
  +hfp = Equal.trans(+List<U32>, Layout.fixed_parts(BP(c, t, x), Nat.mul(c, 4n)), SP2.fcat(BP(c, t, x)), Y, SP2.fxp(BP(c, t, x), Nat.mul(c, 4n), ha), cat)
  +hv = SP2.bvl(BP(c, t, x), ha, FD.logic__subst(+List<U32>, z => {SP.bytes_domain(z) == True{} : Bool}, Y, SP2.fcat(BP(c, t, x)), Equal.sym(+List<U32>, SP2.fcat(BP(c, t, x)), Y, cat), UW.domWX(t, x, Nat.mul(c, 4n))))
  %Equal.sym(Nat, U32.to_nat(len), Nat.mul(c, 4n), ec) : {Codec.parts(VALw(t, x, len), S.ProgressiveList{S.Container{["f_A", "f_B"], S.Chain{S.Unsigned{P.U16{}}, S.Chain{S.Unsigned{P.U16{}}, S.End{}}}}}) == Some{[S.Variable{UW.WX(t, x, _)}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(Maybe<&2, +List<S.Part>>, Codec.parts(RITEMS(c, t, x), S.Repeat{S.Container{["f_A", "f_B"], S.Chain{S.Unsigned{P.U16{}}, S.Chain{S.Unsigned{P.U16{}}, S.End{}}}}}), Some{BP(c, t, x)}, prt_items(c, d, t, x, pf, hf)) :
    {Codec.aggregate(_, None{}) == Some{[S.Variable{Y}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(Maybe<&2, +List<U32>>, Layout.encoding(BP(c, t, x)), Some{List.append(&2, U32, Y, [])},
      VMV.enc_gen(BP(c, t, x), Nat.mul(c, 4n), Y, [], hs, hfp, SP2.pay0(BP(c, t, x), ha), hv, fit)) :
    {Codec.one(_, None{}) == Some{[S.Variable{Y}]} : Maybe<&2, +List<S.Part>>}
  %Equal.sym(+List<U32>, List.append(&2, U32, Y, []), Y, VS.app_nil(Y)) : {Codec.one(Some{_}, None{}) == Some{[S.Variable{Y}]} : Maybe<&2, +List<S.Part>>}
  {==}

# ---- the inversion ------------------------------------------------------------------------------

def rp_t(+xs: +List<U32>, +el: S.Value, +tl: S.Value, +ps: +List<S.Part>, +mB: Maybe<&2, +List<S.Part>>,
    +eB: {Codec.parts(tl, S.Repeat{S.Container{["f_A", "f_B"], S.Chain{S.Unsigned{P.U16{}}, S.Chain{S.Unsigned{P.U16{}}, S.End{}}}}}) == mB : Maybe<&2, +List<S.Part>>},
    +lx: {List.length(&2, U32, xs) == 4n : Nat},
    +e: {Codec.concatenate(Some{[S.Fixed{xs}]}, mB) == Some{ps} : Maybe<&2, +List<S.Part>>},
    ih: @+pb: +List<S.Part> -> {Codec.parts(tl, S.Repeat{S.Container{["f_A", "f_B"], S.Chain{S.Unsigned{P.U16{}}, S.Chain{S.Unsigned{P.U16{}}, S.End{}}}}}) == Some{pb} : Maybe<&2, +List<S.Part>>} -> VMR.REPB(tl, pb, 4n))
    -> VMR.REPB(S.Items{el, tl}, ps, 4n):
  match mB:
    case None{}: Empty.absurd(VMR.REPB(S.Items{el, tl}, ps, 4n), FD.logic__none_some(+List<S.Part>, ps, e))
    case Some{+pb}:
      +eps = FD.logic__some_inj(+List<S.Part>, S.Fixed{xs} <> pb, ps, e)
      %Equal.sym(+List<S.Part>, ps, S.Fixed{xs} <> pb, Equal.sym(+List<S.Part>, S.Fixed{xs} <> pb, ps, eps)) : VMR.REPB(S.Items{el, tl}, _, 4n)
      VMR.rpb_t2(xs, el, tl, pb, 4n, lx, ih(pb, eB))

def rp_p(+el: S.Value, +tl: S.Value, +ps: +List<S.Part>, +ph: +List<S.Part>, hf: DF.single(Some{4n}, ph),
    +e: {Codec.concatenate(Some{ph}, Codec.parts(tl, S.Repeat{S.Container{["f_A", "f_B"], S.Chain{S.Unsigned{P.U16{}}, S.Chain{S.Unsigned{P.U16{}}, S.End{}}}}})) == Some{ps} : Maybe<&2, +List<S.Part>>},
    ih: @+pb: +List<S.Part> -> {Codec.parts(tl, S.Repeat{S.Container{["f_A", "f_B"], S.Chain{S.Unsigned{P.U16{}}, S.Chain{S.Unsigned{P.U16{}}, S.End{}}}}}) == Some{pb} : Maybe<&2, +List<S.Part>>} -> VMR.REPB(tl, pb, 4n))
    -> VMR.REPB(S.Items{el, tl}, ps, 4n):
  match ph:
    case Nil{}: Empty.absurd(VMR.REPB(S.Items{el, tl}, ps, 4n), hf)
    case Con{S.Fixed{+xs}, Nil{}}:
      rp_t(xs, el, tl, ps, Codec.parts(tl, S.Repeat{S.Container{["f_A", "f_B"], S.Chain{S.Unsigned{P.U16{}}, S.Chain{S.Unsigned{P.U16{}}, S.End{}}}}}), {==}, Equal.sym(Nat, 4n, List.length(&2, U32, xs), FD.logic__some_inj(Nat, 4n, List.length(&2, U32, xs), hf)), e, ih)
    case Con{S.Variable{+xs}, Nil{}}: Empty.absurd(VMR.REPB(S.Items{el, tl}, ps, 4n), FD.logic__none_some(Nat, 4n, Equal.sym(Maybe<&2, Nat>, Some{4n}, None{}, hf)))
    case Con{S.Fixed{+xs}, Con{+a, +b}}: Empty.absurd(VMR.REPB(S.Items{el, tl}, ps, 4n), hf)
    case Con{S.Variable{+xs}, Con{+a, +b}}: Empty.absurd(VMR.REPB(S.Items{el, tl}, ps, 4n), hf)

def rp_m(+el: S.Value, +tl: S.Value, +ps: +List<S.Part>, +mh: Maybe<&2, +List<S.Part>>, hf: DF.single_result(Some{4n}, mh),
    +e: {Codec.concatenate(mh, Codec.parts(tl, S.Repeat{S.Container{["f_A", "f_B"], S.Chain{S.Unsigned{P.U16{}}, S.Chain{S.Unsigned{P.U16{}}, S.End{}}}}})) == Some{ps} : Maybe<&2, +List<S.Part>>},
    ih: @+pb: +List<S.Part> -> {Codec.parts(tl, S.Repeat{S.Container{["f_A", "f_B"], S.Chain{S.Unsigned{P.U16{}}, S.Chain{S.Unsigned{P.U16{}}, S.End{}}}}}) == Some{pb} : Maybe<&2, +List<S.Part>>} -> VMR.REPB(tl, pb, 4n))
    -> VMR.REPB(S.Items{el, tl}, ps, 4n):
  match mh:
    case None{}: Empty.absurd(VMR.REPB(S.Items{el, tl}, ps, 4n), FD.logic__none_some(+List<S.Part>, ps, e))
    case Some{+ph}: rp_p(el, tl, ps, ph, hf, e, ih)

# The parts of records are fixed parts of 4 bytes each.
law rep_r:
  for +its: S.Value
  for +ps: +List<S.Part>
  for +e: {Codec.parts(its, S.Repeat{S.Container{["f_A", "f_B"], S.Chain{S.Unsigned{P.U16{}}, S.Chain{S.Unsigned{P.U16{}}, S.End{}}}}}) == Some{ps} : Maybe<&2, +List<S.Part>>}
  VMR.REPB(its, ps, 4n)
def rep_r(its, ps, e):
  match its:
    case S.EmptyItems{}:
      +eps = FD.logic__some_inj(+List<S.Part>, [], ps, e)
      %Equal.sym(+List<S.Part>, ps, [], Equal.sym(+List<S.Part>, [], ps, eps)) : VMR.REPB(S.EmptyItems{}, _, 4n)
      ({==}, {==})
    case S.Items{+h, +tl}: rp_m(h, tl, ps, Codec.parts(h, S.Container{["f_A", "f_B"], S.Chain{S.Unsigned{P.U16{}}, S.Chain{S.Unsigned{P.U16{}}, S.End{}}}}), DS.facts(h, S.Container{["f_A", "f_B"], S.Chain{S.Unsigned{P.U16{}}, S.Chain{S.Unsigned{P.U16{}}, S.End{}}}}, {==}), e, pb => eb => rep_r(tl, pb, eb))
    case S.BooleanValue{+b}: Empty.absurd(VMR.REPB(S.BooleanValue{b}, ps, 4n), FD.logic__none_some(+List<S.Part>, ps, e))
    case S.UnsignedValue{+u}: Empty.absurd(VMR.REPB(S.UnsignedValue{u}, ps, 4n), FD.logic__none_some(+List<S.Part>, ps, e))
    case S.BytesValue{+xs}: Empty.absurd(VMR.REPB(S.BytesValue{xs}, ps, 4n), FD.logic__none_some(+List<S.Part>, ps, e))
    case S.BitsValue{+bs}: Empty.absurd(VMR.REPB(S.BitsValue{bs}, ps, 4n), FD.logic__none_some(+List<S.Part>, ps, e))
    case S.Sequence{+it}: Empty.absurd(VMR.REPB(S.Sequence{it}, ps, 4n), FD.logic__none_some(+List<S.Part>, ps, e))
    case S.Selected{+sel, +sv}: Empty.absurd(VMR.REPB(S.Selected{sel, sv}, ps, 4n), FD.logic__none_some(+List<S.Part>, ps, e))
    case S.NullValue{}: Empty.absurd(VMR.REPB(S.NullValue{}, ps, 4n), FD.logic__none_some(+List<S.Part>, ps, e))

def PF(+ys: +List<U32>) -> Data: DK.Ex(Nat, k => DK.P2({List.length(&2, U32, ys) == Nat.mul(k, 4n) : Nat}, {k == k : Nat}))

def pm4(+its: S.Value, +ys: +List<U32>, +ps: +List<S.Part>,
    +em3: {Codec.parts(its, S.Repeat{S.Container{["f_A", "f_B"], S.Chain{S.Unsigned{P.U16{}}, S.Chain{S.Unsigned{P.U16{}}, S.End{}}}}}) == Some{ps} : Maybe<&2, +List<S.Part>>}, +m4: Maybe<&2, +List<U32>>,
    +em4: {Layout.encoding(ps) == m4 : Maybe<&2, +List<U32>>}, +e: {Codec.bytes(Codec.one(m4, None{})) == Some{ys} : Maybe<&2, +List<U32>>})
    -> PF(ys):
  match m4:
    case None{}: Empty.absurd(PF(ys), FD.logic__none_some(+List<U32>, ys, e))
    case Some{+zs}:
      +ez = FD.logic__some_inj(+List<U32>, zs, ys, e)
      +lz = Equal.trans(Nat, List.length(&2, U32, zs), Layout.fixed_size(ps), Nat.mul(Codec.count(its), 4n),
        VS.enc_len(ps, zs, Pair.fst({VS.allfix(ps) == True{} : Bool}, {Layout.fixed_size(ps) == Nat.mul(Codec.count(its), 4n) : Nat}, rep_r(its, ps, em3)), em4),
        Pair.snd({VS.allfix(ps) == True{} : Bool}, {Layout.fixed_size(ps) == Nat.mul(Codec.count(its), 4n) : Nat}, rep_r(its, ps, em3)))
      (Codec.count(its), (FD.logic__subst(+List<U32>, z => {List.length(&2, U32, z) == Nat.mul(Codec.count(its), 4n) : Nat}, zs, ys, ez, lz), {==}))

def pm3(+its: S.Value, +ys: +List<U32>, +m3: Maybe<&2, +List<S.Part>>,
    +em3: {Codec.parts(its, S.Repeat{S.Container{["f_A", "f_B"], S.Chain{S.Unsigned{P.U16{}}, S.Chain{S.Unsigned{P.U16{}}, S.End{}}}}}) == m3 : Maybe<&2, +List<S.Part>>}, +e: {Codec.bytes(Codec.aggregate(m3, None{})) == Some{ys} : Maybe<&2, +List<U32>>})
    -> PF(ys):
  match m3:
    case None{}: Empty.absurd(PF(ys), FD.logic__none_some(+List<U32>, ys, e))
    case Some{+ps}: pm4(its, ys, ps, em3, Layout.encoding(ps), {==}, e)

# The spec bytes ys of any value of the list are whole records.
law linvr:
  for +h: S.Value
  for +ys: +List<U32>
  for +e: {Codec.bytes(Codec.parts(h, S.ProgressiveList{S.Container{["f_A", "f_B"], S.Chain{S.Unsigned{P.U16{}}, S.Chain{S.Unsigned{P.U16{}}, S.End{}}}}})) == Some{ys} : Maybe<&2, +List<U32>>}
  PF(ys)
def linvr(h, ys, e):
  match h:
    case S.Sequence{+its}: pm3(its, ys, Codec.parts(its, S.Repeat{S.Container{["f_A", "f_B"], S.Chain{S.Unsigned{P.U16{}}, S.Chain{S.Unsigned{P.U16{}}, S.End{}}}}}), {==}, e)
    case S.BooleanValue{+b0}: Empty.absurd(PF(ys), FD.logic__none_some(+List<U32>, ys, e))
    case S.UnsignedValue{+u0}: Empty.absurd(PF(ys), FD.logic__none_some(+List<U32>, ys, e))
    case S.BytesValue{+xs0}: Empty.absurd(PF(ys), FD.logic__none_some(+List<U32>, ys, e))
    case S.BitsValue{+bs0}: Empty.absurd(PF(ys), FD.logic__none_some(+List<U32>, ys, e))
    case S.Items{+hd0, +tl0}: Empty.absurd(PF(ys), FD.logic__none_some(+List<U32>, ys, e))
    case S.EmptyItems{}: Empty.absurd(PF(ys), FD.logic__none_some(+List<U32>, ys, e))
    case S.Selected{+sel0, +sv0}: Empty.absurd(PF(ys), FD.logic__none_some(+List<U32>, ys, e))
    case S.NullValue{}: Empty.absurd(PF(ys), FD.logic__none_some(+List<U32>, ys, e))

def chk_i(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +hw32: {Nat.is_lt(Nat.add(x, U32.to_nat(len)), FD.spec_common__pow2(32n)) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, f: PF(UW.WX(t, x, U32.to_nat(len)))) -> {CHKw(t, x, off, len) == True{} : Bool}:
  (+k, +pr) = f
  (+hl, +kk) = pr
  +ek = Equal.trans(Nat, U32.to_nat(len), List.length(&2, U32, UW.WX(t, x, U32.to_nat(len))), Nat.mul(k, 4n),
    Equal.sym(Nat, List.length(&2, U32, UW.WX(t, x, U32.to_nat(len))), U32.to_nat(len), UW.lenWX(d, t, x, U32.to_nat(len), pf, hw)), hl)
  +hc = FD.logic__subst(Nat, z => {Nat.is_le(k, z) == True{} : Bool}, Nat.mul(k, 4n), U32.to_nat(len), Equal.sym(Nat, U32.to_nat(len), Nat.mul(k, 4n), ek), VRL.le_mul(k, 3n))
  +w = VU.whole_i(len, 4, len, vR(), {==}, {==}, {==}, k, ek, hc)
  FD.logic__and_intro(U32.is_eq(len, (U32.div(len, 4) * 4 : U32)), True{}, FD.logic__and_left(U32.is_eq(len, (U32.div(len, 4) * 4 : U32)), U32.is_le(U32.div(len, 4), len), w), {==})

# Every value whose parts are the window's bytes passes the check.
def invwD(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat},
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +hw32: {Nat.is_lt(Nat.add(x, U32.to_nat(len)), FD.spec_common__pow2(32n)) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +v: S.Value,
    +e: {Codec.parts(v, S.ProgressiveList{S.Container{["f_A", "f_B"], S.Chain{S.Unsigned{P.U16{}}, S.Chain{S.Unsigned{P.U16{}}, S.End{}}}}}) == Some{[S.Variable{UW.WX(t, x, U32.to_nat(len))}]} : Maybe<&2, +List<S.Part>>})
    -> {CHKw(t, x, off, len) == True{} : Bool}:
  chk_i(d, t, n, x, off, len, eo, hd, hw, hw32, pf, linvr(v, UW.WX(t, x, U32.to_nat(len)),
    Equal.cong(Maybe<&2, +List<S.Part>>, Maybe<&2, +List<U32>>, z => Codec.bytes(z), Codec.parts(v, S.ProgressiveList{S.Container{["f_A", "f_B"], S.Chain{S.Unsigned{P.U16{}}, S.Chain{S.Unsigned{P.U16{}}, S.End{}}}}}), Some{[S.Variable{UW.WX(t, x, U32.to_nat(len))}]}, e)))

# ---- the window interface as it was (d < 28, no hw32), for the callers not yet deep ----

def ok_evalw(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat}, +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}) -> {proglist_SmallTestStruct_r.pl_SmallTestStruct_ok(BF(t, n), off, len) == (BF(t, n), CHKw(t, x, off, len)) : B.Buf & Bool}:
  ok_evalwD(d, t, n, x, off, len, eo, FD.nat__lt_trans(d, 28n, 31n, hd, {==}), hw, VB.hw32of(d, Nat.add(x, U32.to_nat(len)), FD.nat__lt_trans(d, 28n, 30n, hd, {==}), hw), pf)

def readw(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat}, +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hchk: {CHKw(t, x, off, len) == True{} : Bool})
    -> {proglist_SmallTestStruct_r.pl_SmallTestStruct_read(BF(t, n), off, len) == (BF(t, n), OBJw(d, t, x, off, len)) : B.Buf & proglist_SmallTestStruct_d.pl_SmallTestStruct_Seq}:
  readwD(d, t, n, x, off, len, eo, FD.nat__lt_trans(d, 28n, 31n, hd, {==}), hw, VB.hw32of(d, Nat.add(x, U32.to_nat(len)), FD.nat__lt_trans(d, 28n, 30n, hd, {==}), hw), pf, hchk)

def specw(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat}, +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hchk: {CHKw(t, x, off, len) == True{} : Bool})
    -> {Codec.parts(VALw(t, x, len), S.ProgressiveList{S.Container{["f_A", "f_B"], S.Chain{S.Unsigned{P.U16{}}, S.Chain{S.Unsigned{P.U16{}}, S.End{}}}}}) == Some{[S.Variable{UW.WX(t, x, U32.to_nat(len))}]} : Maybe<&2, +List<S.Part>>}:
  specwD(d, t, n, x, off, len, eo, FD.nat__lt_trans(d, 28n, 31n, hd, {==}), hw, VB.hw32of(d, Nat.add(x, U32.to_nat(len)), FD.nat__lt_trans(d, 28n, 30n, hd, {==}), hw), pf, hchk)

def invw(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat}, +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +v: S.Value, +e: {Codec.parts(v, S.ProgressiveList{S.Container{["f_A", "f_B"], S.Chain{S.Unsigned{P.U16{}}, S.Chain{S.Unsigned{P.U16{}}, S.End{}}}}}) == Some{[S.Variable{UW.WX(t, x, U32.to_nat(len))}]} : Maybe<&2, +List<S.Part>>})
    -> {CHKw(t, x, off, len) == True{} : Bool}:
  invwD(d, t, n, x, off, len, eo, FD.nat__lt_trans(d, 28n, 31n, hd, {==}), hw, VB.hw32of(d, Nat.add(x, U32.to_nat(len)), FD.nat__lt_trans(d, 28n, 30n, hd, {==}), hw), pf, v, e)
