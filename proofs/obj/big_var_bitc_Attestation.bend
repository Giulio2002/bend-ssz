        {==})))

def zeros_at(+du: U32, +k: Nat, +e: {U32.to_nat(du) == k : Nat}, +hk: {Nat.is_le(k, 13n) == True{} : Bool})
    -> {B.zeros(du) == Array.new(U32, k, 0) : Array<U32>}:
  match k:
    case 0n:
      %Equal.sym(U32, du, 0, FD.u32__injective(du, 0, e)) : {B.zeros(_) == Array.new(U32, 0n, 0) : Array<U32>}
      {==}
    case 1n:
      %Equal.sym(U32, du, 1, FD.u32__injective(du, 1, e)) : {B.zeros(_) == Array.new(U32, 1n, 0) : Array<U32>}
      {==}
    case 2n:
      %Equal.sym(U32, du, 2, FD.u32__injective(du, 2, e)) : {B.zeros(_) == Array.new(U32, 2n, 0) : Array<U32>}
      {==}
    case 3n:
      %Equal.sym(U32, du, 3, FD.u32__injective(du, 3, e)) : {B.zeros(_) == Array.new(U32, 3n, 0) : Array<U32>}
      {==}
    case 4n:
      %Equal.sym(U32, du, 4, FD.u32__injective(du, 4, e)) : {B.zeros(_) == Array.new(U32, 4n, 0) : Array<U32>}
      {==}
    case 5n:
      %Equal.sym(U32, du, 5, FD.u32__injective(du, 5, e)) : {B.zeros(_) == Array.new(U32, 5n, 0) : Array<U32>}
      {==}
    case 6n:
      %Equal.sym(U32, du, 6, FD.u32__injective(du, 6, e)) : {B.zeros(_) == Array.new(U32, 6n, 0) : Array<U32>}
      {==}
    case 7n:
      %Equal.sym(U32, du, 7, FD.u32__injective(du, 7, e)) : {B.zeros(_) == Array.new(U32, 7n, 0) : Array<U32>}
      {==}
    case 8n:
      %Equal.sym(U32, du, 8, FD.u32__injective(du, 8, e)) : {B.zeros(_) == Array.new(U32, 8n, 0) : Array<U32>}
      {==}
    case 9n:
      %Equal.sym(U32, du, 9, FD.u32__injective(du, 9, e)) : {B.zeros(_) == Array.new(U32, 9n, 0) : Array<U32>}
      {==}
    case 10n:
      %Equal.sym(U32, du, 10, FD.u32__injective(du, 10, e)) : {B.zeros(_) == Array.new(U32, 10n, 0) : Array<U32>}
      {==}
    case 11n:
      %Equal.sym(U32, du, 11, FD.u32__injective(du, 11, e)) : {B.zeros(_) == Array.new(U32, 11n, 0) : Array<U32>}
      {==}
    case 12n:
      %Equal.sym(U32, du, 12, FD.u32__injective(du, 12, e)) : {B.zeros(_) == Array.new(U32, 12n, 0) : Array<U32>}
      {==}
    case 13n:
      %Equal.sym(U32, du, 13, FD.u32__injective(du, 13, e)) : {B.zeros(_) == Array.new(U32, 13n, 0) : Array<U32>}
      {==}
    case 14n+p: Empty.absurd({B.zeros(du) == Array.new(U32, 14n+p, 0) : Array<U32>}, FD.logic__false_true(hk))

def NBW(+t: FD.array__Tree<U32>, +n: U32) -> U32: U32.add(U32.mul(8, U32.sub(LL(n), 1)), O.high_bit(VWB(t, n)))

# The reader returns the object of the buffer words (bit list storage: depth dz).
def rd_ok(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +dz: Nat, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hd: {Nat.is_lt(d, 28n) == True{} : Bool}, +hdz: {Nat.is_lt(dz, 31n) == True{} : Bool},
