  +bd1 = FD.logic__subst(Nat, z => {Nat.is_le(Nat.add(z, U32.to_nat(O.high_bit(VWB(t, n)))), U32.to_nat(131072)) == True{} : Bool}, Nat.mul(8n, M1(n)), VS.x8(M1(n)), VR.mul8(M1(n)), bd)
