  %lct2(S.Items{CH.VALw(t, 8n+x, A0(t, x)), S.Items{CH.VALw(t, J1(t, x), L1(t, x, len)), S.EmptyItems{}}}) : {_ == Some{[S.Variable{LS(t, x, len)}]} : Maybe<&2, +List<S.Part>>}
