# The bytes of every buffer the validator accepts are the spec encoding of VAL(t, n).
law decode_spec:
  for +d: Nat
  for +t: FD.array__Tree<U32>
  for +n: U32
  for +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}
  for +hd: {Nat.is_lt(d, 31n) == True{} : Bool}
  for +hn: {Nat.is_le(U32.to_nat(n), A.quad(VB.pw(d))) == True{} : Bool}
  for +hN: {U32.is_le(n, VB.NMAX()) == True{} : Bool}
  for +hchk: {CHK(t, n) == True{} : Bool}
  Decoding.decodes(Spec.ExecutionPayload(), VW(t, n), VAL(t, n))
def decode_spec(d, t, n, pf, hd, hn, hN, hchk):
  # the encoding opened over variables first (F.efl_bytes): the parts rewrite's motive over
  # Codec.bytes was compared with the spec encoding by running the encoder
  %F.efl_bytes(Spec.ExecutionPayload(), VAL(t, n)) : {_ == Some{VW(t, n)} : Maybe<&2, +List<U32>>}
  %Equal.sym(Maybe<&2, +List<S.Part>>, Codec.parts(VAL(t, n), Spec.ExecutionPayload()), Some{[S.Variable{UW.WX(t, 0n, U32.to_nat(n))}]}, EW.specwD(d, t, n, 0n, 0, n, {==}, hd, hn, FD.logic__subst(Bool, z => {z == True{} : Bool}, U32.is_le(n, VB.NMAX()), Nat.is_le(U32.to_nat(n), U32.to_nat(VB.NMAX())), VB.le_u32n(n, VB.NMAX()), hN), pf, hchk)) :
    {Codec.bytes(_) == Some{VW(t, n)} : Maybe<&2, +List<U32>>}
  {==}

# Every spec value of an accepted buffer's bytes is VAL(t, n).
law decode_unique:
  for +d: Nat
  for +t: FD.array__Tree<U32>
  for +n: U32
  for +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}
  for +hd: {Nat.is_lt(d, 31n) == True{} : Bool}
  for +hn: {Nat.is_le(U32.to_nat(n), A.quad(VB.pw(d))) == True{} : Bool}
  for +hN: {U32.is_le(n, VB.NMAX()) == True{} : Bool}
  for +hchk: {CHK(t, n) == True{} : Bool}
  for +v: S.Value
  for spec: Decoding.decodes(Spec.ExecutionPayload(), VW(t, n), v)
  {v == VAL(t, n) : S.Value}
def decode_unique(d, t, n, pf, hd, hn, hN, hchk, v, spec):
  DCO.valid_unique(Spec.ExecutionPayload(), VW(t, n), v, VAL(t, n), {==}, spec, decode_spec(d, t, n, pf, hd, hn, hN, hchk))

# A value encoding to the buffer's bytes has them as its one variable part.
def rj_p(+v: S.Value, +ys: +List<U32>, +ps: +List<S.Part>, hf: DF.single(None{}, ps),
    +em: {Codec.parts(v, Spec.ExecutionPayload()) == Some{ps} : Maybe<&2, +List<S.Part>>}, +e: {Codec.bytes(Some{ps}) == Some{ys} : Maybe<&2, +List<U32>>})
    -> {Codec.parts(v, Spec.ExecutionPayload()) == Some{[S.Variable{ys}]} : Maybe<&2, +List<S.Part>>}:
  match ps:
    case Nil{}: Empty.absurd({Codec.parts(v, Spec.ExecutionPayload()) == Some{[S.Variable{ys}]} : Maybe<&2, +List<S.Part>>}, hf)
    case Con{S.Fixed{+xs}, Nil{}}: Empty.absurd({Codec.parts(v, Spec.ExecutionPayload()) == Some{[S.Variable{ys}]} : Maybe<&2, +List<S.Part>>}, FD.logic__none_some(Nat, List.length(&2, U32, xs), hf))
    case Con{S.Variable{+xs}, Nil{}}:
      %FD.logic__some_inj(+List<U32>, xs, ys, e) : {Codec.parts(v, Spec.ExecutionPayload()) == Some{[S.Variable{_}]} : Maybe<&2, +List<S.Part>>}
      em
    case Con{S.Fixed{+xs}, Con{+a, +b}}: Empty.absurd({Codec.parts(v, Spec.ExecutionPayload()) == Some{[S.Variable{ys}]} : Maybe<&2, +List<S.Part>>}, hf)
    case Con{S.Variable{+xs}, Con{+a, +b}}: Empty.absurd({Codec.parts(v, Spec.ExecutionPayload()) == Some{[S.Variable{ys}]} : Maybe<&2, +List<S.Part>>}, hf)

def rj_m(+v: S.Value, +ys: +List<U32>, +mm: Maybe<&2, +List<S.Part>>, hf: DF.single_result(None{}, mm),
    +em: {Codec.parts(v, Spec.ExecutionPayload()) == mm : Maybe<&2, +List<S.Part>>}, +e: {Codec.bytes(mm) == Some{ys} : Maybe<&2, +List<U32>>})
    -> {Codec.parts(v, Spec.ExecutionPayload()) == Some{[S.Variable{ys}]} : Maybe<&2, +List<S.Part>>}:
  match mm:
    case None{}: Empty.absurd({Codec.parts(v, Spec.ExecutionPayload()) == Some{[S.Variable{ys}]} : Maybe<&2, +List<S.Part>>}, FD.logic__none_some(+List<U32>, ys, e))
    case Some{+ps}: rj_p(v, ys, ps, hf, em, e)

def rej_f(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hd: {Nat.is_lt(d, 31n) == True{} : Bool},
    +hn: {Nat.is_le(U32.to_nat(n), A.quad(VB.pw(d))) == True{} : Bool}, +hN: {U32.is_le(n, VB.NMAX()) == True{} : Bool}, +hchk: {CHK(t, n) == False{} : Bool}, +v: S.Value,
    +e: {Codec.encoding_for_legal_type(Spec.ExecutionPayload(), v) == Some{VW(t, n)} : Maybe<&2, +List<U32>>}) -> Empty:
  FD.logic__true_false(Equal.trans(Bool, True{}, CHK(t, n), False{},
    Equal.sym(Bool, CHK(t, n), True{}, EW.invwD(d, t, n, 0n, 0, n, {==}, hd, hn, FD.logic__subst(Bool, z => {z == True{} : Bool}, U32.is_le(n, VB.NMAX()), Nat.is_le(U32.to_nat(n), U32.to_nat(VB.NMAX())), VB.le_u32n(n, VB.NMAX()), hN), pf, v, rj_m(v, VW(t, n), Codec.parts(v, Spec.ExecutionPayload()), UW.vsingle(v, ["parent_hash", "fee_recipient", "state_root", "receipts_root", "logs_bloom", "prev_randao", "block_number", "gas_limit", "gas_used", "timestamp", "extra_data", "base_fee_per_gas", "block_hash", "transactions", "withdrawals", "blob_gas_used", "excess_blob_gas"], S.Chain{Spec.Schema7(), S.Chain{Spec.Schema11(), S.Chain{Spec.Schema7(), S.Chain{Spec.Schema7(), S.Chain{Spec.Schema69(), S.Chain{Spec.Schema7(), S.Chain{Spec.Schema3(), S.Chain{Spec.Schema3(), S.Chain{Spec.Schema3(), S.Chain{Spec.Schema3(), S.Chain{Spec.Schema70(), S.Chain{Spec.Schema4(), S.Chain{Spec.Schema7(), S.Chain{Spec.Schema73(), S.Chain{Spec.Schema74(), S.Chain{Spec.Schema3(), S.Chain{Spec.Schema3(), S.End{}}}}}}}}}}}}}}}}}}, {==}), {==}, e))), hchk))

# When the validator refuses, no value is related to the buffer's bytes.
law decode_reject:
  for +d: Nat
  for +t: FD.array__Tree<U32>
  for +n: U32
  for +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}
  for +hd: {Nat.is_lt(d, 31n) == True{} : Bool}
  for +hn: {Nat.is_le(U32.to_nat(n), A.quad(VB.pw(d))) == True{} : Bool}
  for +hN: {U32.is_le(n, VB.NMAX()) == True{} : Bool}
  for +hchk: {CHK(t, n) == False{} : Bool}
  Decoding.outside_image(Spec.ExecutionPayload(), VW(t, n))
def decode_reject(d, t, n, pf, hd, hn, hN, hchk):
  v => e => rej_f(d, t, n, pf, hd, hn, hN, hchk, v, e)

def none_go(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hd: {Nat.is_lt(d, 31n) == True{} : Bool},
    +hn: {Nat.is_le(U32.to_nat(n), A.quad(VB.pw(d))) == True{} : Bool}, +hN: {U32.is_le(n, VB.NMAX()) == True{} : Bool}, +hchk: {CHK(t, n) == False{} : Bool})
    -> {FuluExecutionPayload_r.ExecutionPayload_decode(BF(t, n), n) == (BF(t, n), None{}) : B.Buf & Maybe<&1, FuluExecutionPayload_d.ExecutionPayload>}:
  %Equal.sym(B.Buf & Bool, FuluExecutionPayload_r.ExecutionPayload_ok(BF(t, n), 0, n), (BF(t, n), CHK(t, n)), ok_eval(d, t, n, pf, hd, hn, hN)) :
    {FuluExecutionPayload_r.ExecutionPayload_built(n, _) == (BF(t, n), None{}) : B.Buf & Maybe<&1, FuluExecutionPayload_d.ExecutionPayload>}
  %Equal.sym(Bool, CHK(t, n), False{}, hchk) :
    {FuluExecutionPayload_r.ExecutionPayload_built(n, (BF(t, n), _)) == (BF(t, n), None{}) : B.Buf & Maybe<&1, FuluExecutionPayload_d.ExecutionPayload>}
  {==}

# When the validator refuses, the decoder returns None and the buffer.
law decode_none:
  for +d: Nat
  for +t: FD.array__Tree<U32>
  for +n: U32
  for +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}
  for +hd: {Nat.is_lt(d, 31n) == True{} : Bool}
  for +hn: {Nat.is_le(U32.to_nat(n), A.quad(VB.pw(d))) == True{} : Bool}
  for +hN: {U32.is_le(n, VB.NMAX()) == True{} : Bool}
  for +hchk: {CHK(t, n) == False{} : Bool}
  {FuluExecutionPayload_r.ExecutionPayload_decode(BF(t, n), n) == (BF(t, n), None{}) : B.Buf & Maybe<&1, FuluExecutionPayload_d.ExecutionPayload>}
def decode_none(d, t, n, pf, hd, hn, hN, hchk): none_go(d, t, n, pf, hd, hn, hN, hchk)

