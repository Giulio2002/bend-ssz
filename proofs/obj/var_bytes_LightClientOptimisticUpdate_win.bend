# When the window's checks hold, the spec parts of VALw are its bytes, as one variable part.
def specw(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +i: Nat, +len: U32, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hd: {Nat.is_lt(d, 29n) == True{} : Bool},
    +hw: {Nat.is_le(Nat.add(A.quad(i), U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +hchk: {CHKw(t, i, len) == True{} : Bool})
    -> {Codec.parts(VALw(t, i, len), Spec.LightClientOptimisticUpdate()) == Some{[S.Variable{VS.bt(U32.to_nat(len), F.limbs(VB.wdr(i, FD.array__slots(U32, t))))}]} : Maybe<&2, +List<S.Part>>}:
  +a = U32.is_le(172, len)
  +b = U32.is_eq(SPOw(t, i), 172)
  +c = YW.CHKw(t, Nat.add(43n, i), LL(len))
  +epo = FD.u32alg__eq_of(SPOw(t, i), 172, chk_b(a, b, c, hchk))
  specw_go(d, t, n, i, len, pf, hd, hw, chk_a(a, b, c, hchk), epo, chk_c(a, b, c, hchk))

