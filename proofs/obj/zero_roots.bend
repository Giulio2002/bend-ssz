                                                                                                                                  Empty.absurd({encd(D.zconst(1n+63n+k63)) == HH(encd(D.zconst(63n+k63))) : SH.HS}, false_true(Equal.trans(Bool, False{}, Nat.is_lt(k63, 0n), True{}, Equal.sym(Bool, Nat.is_lt(k63, 0n), False{}, F.nat__not_lt_zero(k63)), hk)))

law zconst_step:
  for +k: Nat
  for +hk: {Nat.is_lt(k, 63n) == True{} : Bool}
  {D.bytes(D.zconst(1n+k)) == VF.sha256_bytes(List.append(&2, U32, D.bytes(D.zconst(k)), D.bytes(D.zconst(k)))) : List<&2, U32>}
def zconst_step(k, hk):
  Equal.trans(List<&2, U32>, D.bytes(D.zconst(1n+k)), D.bytes(decd(HH(encd(D.zconst(k))))), VF.sha256_bytes(List.append(&2, U32, D.bytes(D.zconst(k)), D.bytes(D.zconst(k)))), Equal.trans(List<&2, U32>, D.bytes(D.zconst(1n+k)), D.bytes(decd(encd(D.zconst(1n+k)))), D.bytes(decd(HH(encd(D.zconst(k))))), Equal.cong(D.Digest, List<&2, U32>, zq_ => D.bytes(zq_), D.zconst(1n+k), decd(encd(D.zconst(1n+k))), Equal.sym(D.Digest, decd(encd(D.zconst(1n+k))), D.zconst(1n+k), ded(D.zconst(1n+k)))), Equal.cong(SH.HS, List<&2, U32>, zq_ => D.bytes(decd(zq_)), encd(D.zconst(1n+k)), HH(encd(D.zconst(k))), zhex(k, hk))), Equal.sym(List<&2, U32>, VF.sha256_bytes(List.append(&2, U32, D.bytes(D.zconst(k)), D.bytes(D.zconst(k)))), D.bytes(decd(HH(encd(D.zconst(k))))), g(D.zconst(k))))

law zconst_spec:
  for +k: Nat
  for +hk: {Nat.is_lt(k, 64n) == True{} : Bool}
  {D.bytes(D.zconst(k)) == M.zero_subtree(k) : List<&2, U32>}
def zconst_spec(k, hk):
  match k:
    case 0n: {==}
    case 1n+ +p:
      %zconst_spec(p, F.nat__lt_trans(p, 63n, 64n, hk, {==})) :
        {D.bytes(D.zconst(1n+p)) == VF.sha256_bytes(List.append(&2, U32, _, _)) : List<&2, U32>}
      zconst_step(p, hk)
