# The spec parts of the value: one variable part, the window's bytes.
def specw(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +i: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == A.quad(i) : Nat},
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(A.quad(i), U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +hw32: {Nat.is_lt(Nat.add(A.quad(i), U32.to_nat(len)), FD.spec_common__pow2(32n)) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hchk: {CHKw(t, i, off, len) == True{} : Bool}) -> {Codec.parts(VALw(t, i, len), Spec.AggregateAndProof()) == Some{[S.Variable{VR.WB(t, i, U32.to_nat(len))}]} : Maybe<&2, +List<S.Part>>}:
  +a = U32.is_le(108, len)
  +b = U32.is_eq(SPOw(t, i), 108)
  +c = CH.CHKw(t, JW(i), OWc(off), LLw(len))
  specg(d, t, n, i, off, len, eo, hd, hw, hw32, pf, ch_a(a, b, c, hchk), FD.u32alg__eq_of(SPOw(t, i), 108, ch_b(a, b, c, hchk)), ch_c(a, b, c, hchk))

# ---- every value whose spec parts are the window's bytes passes the checks ------------------

def eP(+xs0: +List<U32>, +lx0: {List.length(&2, U32, xs0) == 8n : Nat}, +hv: S.Value, +ys: +List<U32>, +eh: {Codec.parts(hv, Spec.Schema40()) == Some{[S.Variable{ys}]} : Maybe<&2, +List<S.Part>>}, +xs2: +List<U32>, +lx2: {List.length(&2, U32, xs2) == 96n : Nat}) -> {VRJ.lens([xs0]) == 8n : Nat}:
  %Equal.sym(Nat, List.length(&2, U32, xs0), 8n, lx0) : {Nat.add(_, 0n) == 8n : Nat}
  {==}

def eQ(+xs0: +List<U32>, +lx0: {List.length(&2, U32, xs0) == 8n : Nat}, +hv: S.Value, +ys: +List<U32>, +eh: {Codec.parts(hv, Spec.Schema40()) == Some{[S.Variable{ys}]} : Maybe<&2, +List<S.Part>>}, +xs2: +List<U32>, +lx2: {List.length(&2, U32, xs2) == 96n : Nat}) -> {VRJ.lens([xs2]) == 96n : Nat}:
  %Equal.sym(Nat, List.length(&2, U32, xs2), 96n, lx2) : {Nat.add(_, 0n) == 96n : Nat}
  {==}

def fz_eq(+xs0: +List<U32>, +lx0: {List.length(&2, U32, xs0) == 8n : Nat}, +hv: S.Value, +ys: +List<U32>, +eh: {Codec.parts(hv, Spec.Schema40()) == Some{[S.Variable{ys}]} : Maybe<&2, +List<S.Part>>}, +xs2: +List<U32>, +lx2: {List.length(&2, U32, xs2) == 96n : Nat}) -> {VRJ.FZ([xs0], [xs2]) == 108n : Nat}:
  %Equal.sym(Nat, VRJ.lens([xs0]), 8n, eP(xs0, lx0, hv, ys, eh, xs2, lx2)) : {Nat.add(_, 4n+VRJ.lens([xs2])) == 108n : Nat}
  %Equal.sym(Nat, VRJ.lens([xs2]), 96n, eQ(xs0, lx0, hv, ys, eh, xs2, lx2)) : {Nat.add(8n, 4n+_) == 108n : Nat}
