  %Equal.sym(U32, MR.wd(F.array__slots(U32, WW.tk([x0, x1], d, t, qw, 0n)), Nat.add(O.e8(iq), 6n)), MR.wd(F.array__slots(U32, t), Nat.add(O.e8(iq), 6n)), e6) : {WS.bdrop(24n, FX.limbs([MR.wd(F.array__slots(U32, WW.tk([x0, x1], d, t, qw, 0n)), Nat.add(O.e8(iq), 0n)), MR.wd(F.array__slots(U32, WW.tk([x0, x1], d, t, qw, 0n)), Nat.add(O.e8(iq), 1n)), MR.wd(F.array__slots(U32, WW.tk([x0, x1], d, t, qw, 0n)), Nat.add(O.e8(iq), 2n)), MR.wd(F.array__slots(U32, WW.tk([x0, x1], d, t, qw, 0n)), Nat.add(O.e8(iq), 3n)), MR.wd(F.array__slots(U32, WW.tk([x0, x1], d, t, qw, 0n)), Nat.add(O.e8(iq), 4n)), MR.wd(F.array__slots(U32, WW.tk([x0, x1], d, t, qw, 0n)), Nat.add(O.e8(iq), 5n)), _, MR.wd(F.array__slots(U32, WW.tk([x0, x1], d, t, qw, 0n)), Nat.add(O.e8(iq), 7n))])) == WS.bdrop(24n, WS.cb(F.array__slots(U32, t), iq)) : +List<U32>}
  %Equal.sym(U32, MR.wd(F.array__slots(U32, WW.tk([x0, x1], d, t, qw, 0n)), Nat.add(O.e8(iq), 7n)), MR.wd(F.array__slots(U32, t), Nat.add(O.e8(iq), 7n)), e7) : {WS.bdrop(24n, FX.limbs([MR.wd(F.array__slots(U32, WW.tk([x0, x1], d, t, qw, 0n)), Nat.add(O.e8(iq), 0n)), MR.wd(F.array__slots(U32, WW.tk([x0, x1], d, t, qw, 0n)), Nat.add(O.e8(iq), 1n)), MR.wd(F.array__slots(U32, WW.tk([x0, x1], d, t, qw, 0n)), Nat.add(O.e8(iq), 2n)), MR.wd(F.array__slots(U32, WW.tk([x0, x1], d, t, qw, 0n)), Nat.add(O.e8(iq), 3n)), MR.wd(F.array__slots(U32, WW.tk([x0, x1], d, t, qw, 0n)), Nat.add(O.e8(iq), 4n)), MR.wd(F.array__slots(U32, WW.tk([x0, x1], d, t, qw, 0n)), Nat.add(O.e8(iq), 5n)), MR.wd(F.array__slots(U32, t), Nat.add(O.e8(iq), 6n)), _])) == WS.bdrop(24n, WS.cb(F.array__slots(U32, t), iq)) : +List<U32>}
  {==}

def tail_m3(+d: Nat, +t: F.array__Tree<U32>, +qw: Nat, +x0: U32, +x1: U32, +iq: Nat, +i: Nat, +qc: Nat, +c: Nat, +eiq: {iq == qc : Nat}, +hq: {qw == Nat.double(i) : Nat},
    +hlt: {Nat.is_le(1n+i, c) == True{} : Bool}, +hc: {c == Nat.add(Nat.double(Nat.double(qc)), 3n) : Nat}, +hb: {Nat.is_le(Nat.add(qw, 2n), F.spec_common__pow2(d)) == True{} : Bool},
    +pf: {F.array__perfect(U32, d, t) == True{} : Bool}, +slack: {WS.bdrop(24n, WS.cb(F.array__slots(U32, t), iq)) == SP.zero_bytes(Nat.sub(32n, 24n)) : +List<U32>})
    -> {WS.bdrop(24n, WS.cb(F.array__slots(U32, WW.tk([x0, x1], d, t, qw, 0n)), iq)) == SP.zero_bytes(Nat.sub(32n, 24n)) : +List<U32>}:
  +e6 = WW.wd_after([x0, x1], d, t, qw, Nat.add(O.e8(iq), 6n), F.logic__subst(Nat, z => {Nat.is_le(Nat.add(qw, 2n), Nat.add(O.e8(z), 6n)) == True{} : Bool}, qc, iq, Equal.sym(Nat, iq, qc, eiq), y_le(i, qw, qc, c, 3n, 6n, hq, hlt, hc, {==})), hb, pf)
  +e7 = WW.wd_after([x0, x1], d, t, qw, Nat.add(O.e8(iq), 7n), F.logic__subst(Nat, z => {Nat.is_le(Nat.add(qw, 2n), Nat.add(O.e8(z), 7n)) == True{} : Bool}, qc, iq, Equal.sym(Nat, iq, qc, eiq), y_le(i, qw, qc, c, 3n, 7n, hq, hlt, hc, {==})), hb, pf)
  Equal.trans(+List<U32>, WS.bdrop(24n, WS.cb(F.array__slots(U32, WW.tk([x0, x1], d, t, qw, 0n)), iq)), WS.bdrop(24n, WS.cb(F.array__slots(U32, t), iq)), SP.zero_bytes(Nat.sub(32n, 24n)),
    bdeq_m3(d, t, qw, x0, x1, iq, e6, e7),
