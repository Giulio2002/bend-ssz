# the limbs of the written chunk, past the first 24 bytes: the words 6 .. 7 are the old words
def bdeq_m3(+d: Nat, +t: F.array__Tree<U32>, +qw: Nat, +x0: U32, +x1: U32, +iq: Nat, +e6: {MR.wd(F.array__slots(U32, WW.tk([x0, x1], d, t, qw, 0n)), Nat.add(O.e8(iq), 6n)) == MR.wd(F.array__slots(U32, t), Nat.add(O.e8(iq), 6n)) : U32}, +e7: {MR.wd(F.array__slots(U32, WW.tk([x0, x1], d, t, qw, 0n)), Nat.add(O.e8(iq), 7n)) == MR.wd(F.array__slots(U32, t), Nat.add(O.e8(iq), 7n)) : U32})
