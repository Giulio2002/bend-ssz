def tail_m2(+d: Nat, +t: F.array__Tree<U32>, +qw: Nat, +x0: U32, +x1: U32, +iq: Nat, +i: Nat, +qc: Nat, +c: Nat, +eiq: {iq == qc : Nat}, +hq: {qw == Nat.double(i) : Nat},
    +hlt: {Nat.is_le(1n+i, c) == True{} : Bool}, +hc: {c == Nat.add(Nat.double(Nat.double(qc)), 2n) : Nat}, +hb: {Nat.is_le(Nat.add(qw, 2n), F.spec_common__pow2(d)) == True{} : Bool},
