# the limbs of the written chunk, past the first 32 bytes: the words 8 .. 7 are the old words
def bdeq_m4(+d: Nat, +t: F.array__Tree<U32>, +qw: Nat, +x0: U32, +x1: U32, +iq: Nat, )
    -> {WS.bdrop(32n, WS.cb(F.array__slots(U32, WW.tk([x0, x1], d, t, qw, 0n)), iq)) == WS.bdrop(32n, WS.cb(F.array__slots(U32, t), iq)) : +List<U32>}:
  {==}

def tail_m4(+d: Nat, +t: F.array__Tree<U32>, +qw: Nat, +x0: U32, +x1: U32, +iq: Nat, +i: Nat, +qc: Nat, +c: Nat, +eiq: {iq == qc : Nat}, +hq: {qw == Nat.double(i) : Nat},
    +hlt: {Nat.is_le(1n+i, c) == True{} : Bool}, +hc: {c == Nat.add(Nat.double(Nat.double(qc)), 4n) : Nat}, +hb: {Nat.is_le(Nat.add(qw, 2n), F.spec_common__pow2(d)) == True{} : Bool},
    +pf: {F.array__perfect(U32, d, t) == True{} : Bool}, +slack: {WS.bdrop(32n, WS.cb(F.array__slots(U32, t), iq)) == SP.zero_bytes(Nat.sub(32n, 32n)) : +List<U32>})
    -> {WS.bdrop(32n, WS.cb(F.array__slots(U32, WW.tk([x0, x1], d, t, qw, 0n)), iq)) == SP.zero_bytes(Nat.sub(32n, 32n)) : +List<U32>}:
  Equal.trans(+List<U32>, WS.bdrop(32n, WS.cb(F.array__slots(U32, WW.tk([x0, x1], d, t, qw, 0n)), iq)), WS.bdrop(32n, WS.cb(F.array__slots(U32, t), iq)), SP.zero_bytes(Nat.sub(32n, 32n)),
    bdeq_m4(d, t, qw, x0, x1, iq, ),
    slack)

# the bytes in use are 8, 16, 24 or 32: the tail of the written tree is the old tail
def tail_u(+m: Nat, +d: Nat, +t: F.array__Tree<U32>, +qw: Nat, +x0: U32, +x1: U32, +iq: Nat, +i: Nat, +qc: Nat, +c: Nat, +r: Nat, +eiq: {iq == qc : Nat}, +hq: {qw == Nat.double(i) : Nat},
    +hlt: {Nat.is_le(1n+i, c) == True{} : Bool}, +hc: {c == Nat.add(Nat.double(Nat.double(qc)), m) : Nat}, +er: {r == O.e8(m) : Nat}, +h1: {Nat.is_lt(0n, r) == True{} : Bool},
    +h32: {Nat.is_le(r, 32n) == True{} : Bool}, +hb: {Nat.is_le(Nat.add(qw, 2n), F.spec_common__pow2(d)) == True{} : Bool}, +pf: {F.array__perfect(U32, d, t) == True{} : Bool},
    +slack: {WS.bdrop(r, WS.cb(F.array__slots(U32, t), iq)) == SP.zero_bytes(Nat.sub(32n, r)) : +List<U32>})
    -> {WS.bdrop(r, WS.cb(F.array__slots(U32, WW.tk([x0, x1], d, t, qw, 0n)), iq)) == SP.zero_bytes(Nat.sub(32n, r)) : +List<U32>}:
  match m:
    case 0n: Empty.absurd({WS.bdrop(r, WS.cb(F.array__slots(U32, WW.tk([x0, x1], d, t, qw, 0n)), iq)) == SP.zero_bytes(Nat.sub(32n, r)) : +List<U32>}, F.logic__false_true(F.logic__subst(Nat, z => {Nat.is_lt(0n, z) == True{} : Bool}, r, 0n, er, h1)))
    case 1n:
      F.logic__subst(Nat, z => {WS.bdrop(z, WS.cb(F.array__slots(U32, WW.tk([x0, x1], d, t, qw, 0n)), iq)) == SP.zero_bytes(Nat.sub(32n, z)) : +List<U32>}, 8n, r, Equal.sym(Nat, r, 8n, er),
        tail_m1(d, t, qw, x0, x1, iq, i, qc, c, eiq, hq, hlt, hc, hb, pf, F.logic__subst(Nat, z => {WS.bdrop(z, WS.cb(F.array__slots(U32, t), iq)) == SP.zero_bytes(Nat.sub(32n, z)) : +List<U32>}, r, 8n, er, slack)))
    case 2n:
      F.logic__subst(Nat, z => {WS.bdrop(z, WS.cb(F.array__slots(U32, WW.tk([x0, x1], d, t, qw, 0n)), iq)) == SP.zero_bytes(Nat.sub(32n, z)) : +List<U32>}, 16n, r, Equal.sym(Nat, r, 16n, er),
        tail_m2(d, t, qw, x0, x1, iq, i, qc, c, eiq, hq, hlt, hc, hb, pf, F.logic__subst(Nat, z => {WS.bdrop(z, WS.cb(F.array__slots(U32, t), iq)) == SP.zero_bytes(Nat.sub(32n, z)) : +List<U32>}, r, 16n, er, slack)))
    case 3n:
      F.logic__subst(Nat, z => {WS.bdrop(z, WS.cb(F.array__slots(U32, WW.tk([x0, x1], d, t, qw, 0n)), iq)) == SP.zero_bytes(Nat.sub(32n, z)) : +List<U32>}, 24n, r, Equal.sym(Nat, r, 24n, er),
        tail_m3(d, t, qw, x0, x1, iq, i, qc, c, eiq, hq, hlt, hc, hb, pf, F.logic__subst(Nat, z => {WS.bdrop(z, WS.cb(F.array__slots(U32, t), iq)) == SP.zero_bytes(Nat.sub(32n, z)) : +List<U32>}, r, 24n, er, slack)))
    case 4n:
      F.logic__subst(Nat, z => {WS.bdrop(z, WS.cb(F.array__slots(U32, WW.tk([x0, x1], d, t, qw, 0n)), iq)) == SP.zero_bytes(Nat.sub(32n, z)) : +List<U32>}, 32n, r, Equal.sym(Nat, r, 32n, er),
        tail_m4(d, t, qw, x0, x1, iq, i, qc, c, eiq, hq, hlt, hc, hb, pf, F.logic__subst(Nat, z => {WS.bdrop(z, WS.cb(F.array__slots(U32, t), iq)) == SP.zero_bytes(Nat.sub(32n, z)) : +List<U32>}, r, 32n, er, slack)))
    case 5n+ +p: Empty.absurd({WS.bdrop(r, WS.cb(F.array__slots(U32, WW.tk([x0, x1], d, t, qw, 0n)), iq)) == SP.zero_bytes(Nat.sub(32n, r)) : +List<U32>}, F.logic__false_true(F.logic__subst(Nat, z => {Nat.is_le(z, 32n) == True{} : Bool}, r, O.e8(5n+p), er, h32)))

# the same with the cases of m given as a value (split8)
def tail_w(+d: Nat, +t: F.array__Tree<U32>, +qw: Nat, +x0: U32, +x1: U32, +iq: Nat, +i: Nat, +qc: Nat, +c: Nat, +r: Nat, +eiq: {iq == qc : Nat}, +hq: {qw == Nat.double(i) : Nat},
    +hlt: {Nat.is_le(1n+i, c) == True{} : Bool}, +h1: {Nat.is_lt(0n, r) == True{} : Bool}, +h32: {Nat.is_le(r, 32n) == True{} : Bool},
    +hb: {Nat.is_le(Nat.add(qw, 2n), F.spec_common__pow2(d)) == True{} : Bool}, +pf: {F.array__perfect(U32, d, t) == True{} : Bool},
    +slack: {WS.bdrop(r, WS.cb(F.array__slots(U32, t), iq)) == SP.zero_bytes(Nat.sub(32n, r)) : +List<U32>},
    +sp: DK.Ex(Nat, m => DK.P2({c == Nat.add(Nat.double(Nat.double(qc)), m) : Nat}, {r == O.e8(m) : Nat})))
    -> {WS.bdrop(r, WS.cb(F.array__slots(U32, WW.tk([x0, x1], d, t, qw, 0n)), iq)) == SP.zero_bytes(Nat.sub(32n, r)) : +List<U32>}:
  (+m, +p) = sp
  (+hc, +er) = p
  tail_u(m, d, t, qw, x0, x1, iq, i, qc, c, r, eiq, hq, hlt, hc, er, h1, h32, hb, pf, slack)
