  +e4 = WW.wd_after([x0, x1], d, t, qw, Nat.add(O.e8(iq), 4n), F.logic__subst(Nat, z => {Nat.is_le(Nat.add(qw, 2n), Nat.add(O.e8(z), 4n)) == True{} : Bool}, qc, iq, Equal.sym(Nat, iq, qc, eiq), y_le(i, qw, qc, c, 2n, 4n, hq, hlt, hc, {==})), hb, pf)
  +e5 = WW.wd_after([x0, x1], d, t, qw, Nat.add(O.e8(iq), 5n), F.logic__subst(Nat, z => {Nat.is_le(Nat.add(qw, 2n), Nat.add(O.e8(z), 5n)) == True{} : Bool}, qc, iq, Equal.sym(Nat, iq, qc, eiq), y_le(i, qw, qc, c, 2n, 5n, hq, hlt, hc, {==})), hb, pf)
  +e6 = WW.wd_after([x0, x1], d, t, qw, Nat.add(O.e8(iq), 6n), F.logic__subst(Nat, z => {Nat.is_le(Nat.add(qw, 2n), Nat.add(O.e8(z), 6n)) == True{} : Bool}, qc, iq, Equal.sym(Nat, iq, qc, eiq), y_le(i, qw, qc, c, 2n, 6n, hq, hlt, hc, {==})), hb, pf)
  +e7 = WW.wd_after([x0, x1], d, t, qw, Nat.add(O.e8(iq), 7n), F.logic__subst(Nat, z => {Nat.is_le(Nat.add(qw, 2n), Nat.add(O.e8(z), 7n)) == True{} : Bool}, qc, iq, Equal.sym(Nat, iq, qc, eiq), y_le(i, qw, qc, c, 2n, 7n, hq, hlt, hc, {==})), hb, pf)
  Equal.trans(+List<U32>, WS.bdrop(16n, WS.cb(F.array__slots(U32, WW.tk([x0, x1], d, t, qw, 0n)), iq)), WS.bdrop(16n, WS.cb(F.array__slots(U32, t), iq)), SP.zero_bytes(Nat.sub(32n, 16n)),
    bdeq_m2(d, t, qw, x0, x1, iq, e4, e5, e6, e7),
