  match k:
    case 0n: S.EmptyItems{}
    case 1n+c:
      match xs:
        case Nil{}: S.EmptyItems{}
        case Con{+x, t}: S.Items{S.BooleanValue{U32.is_eq(x, 1)}, itb(c, t)}

def vviewb(o: O.Words) -> S.Value:
