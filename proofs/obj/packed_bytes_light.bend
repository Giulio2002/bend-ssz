# Exactly n bytes, each 0 or 1.
def bscope(n: Nat, xs: +List<U32>) -> Bool:
  match n:
    case 0n:
      match xs:
        case Nil{}: True{}
        case Con{h, t}: False{}
    case 1n+p:
      match xs:
        case Nil{}: False{}
        case Con{h, t}: Bool.and(U32.is_lt(h, 2), bscope(p, t))

