            case T.BitVector{a0} T.Chain{b0, b1}: Empty.absurd(F.finite(S.Slots{}, T.BitVector{a0}, T.Chain{b0, b1}), W.false_true(accepted))
            case T.BitVector{a0} T.End{}: F.slots_end_right(T.BitVector{a0})
            case T.BitVector{a0} T.Repeat{b0}: Empty.absurd(F.finite(S.Slots{}, T.BitVector{a0}, T.Repeat{b0}), W.false_true(accepted))
            case T.BitVector{a0} T.Named{b0, b1}: Empty.absurd(F.finite(S.Slots{}, T.BitVector{a0}, T.Named{b0, b1}), W.false_true(accepted))
            case T.BitVector{a0} T.ProgressiveList{b0}: Empty.absurd(F.finite(S.Slots{}, T.BitVector{a0}, T.ProgressiveList{b0}), W.false_true(accepted))
            case T.BitVector{a0} T.ProgressiveBits{}: Empty.absurd(F.finite(S.Slots{}, T.BitVector{a0}, T.ProgressiveBits{}), W.false_true(accepted))
