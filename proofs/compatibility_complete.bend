import Base
import ../types/schema.bend as T
import ../src/schema.bend as I
import ../spec/compatibility.bend as S
import ./compatibility_finite.bend as F
import ./compatibility_finite_identity.bend as Identity
import ./compatibility_positions.bend as Positions
import ./validator_metadata.bend as M
import ./primitive_invariants.bend as V
import ./word_facts.bend as W

law progressive:
  for +na: +List<String>
  for +fa: T.Schema
  for +aa: +List<Bool>
  for +nb: +List<String>
  for +fb: T.Schema
  for +ab: +List<Bool>
  for positions: {S.shared_positions(S.slots(aa, na, fa), S.slots(ab, nb, fb), 0n) == True{} : Bool}
  for child: F.finite(S.Slots{}, S.slots(aa, na, fa), S.slots(ab, nb, fb))
  F.finite(S.Pair{}, T.ProgressiveContainer{na, fa, aa}, T.ProgressiveContainer{nb, fb, ab})
def progressive(na, fa, aa, nb, fb, ab, positions, child):
  F.progressive(na, fa, aa, nb, fb, ab,
    %Equal.sym(Bool, I.shared_positions(I.active_fields(aa, na, fa), I.active_fields(ab, nb, fb), 0n), S.shared_positions(I.active_fields(aa, na, fa), I.active_fields(ab, nb, fb), 0n), Positions.shared_positions(I.active_fields(aa, na, fa), I.active_fields(ab, nb, fb), 0n)) : {_ == True{} : Bool}
    %Equal.sym(T.Schema, I.active_fields(aa, na, fa), S.slots(aa, na, fa), M.active_slots(aa, na, fa)) : {S.shared_positions(_, I.active_fields(ab, nb, fb), 0n) == True{} : Bool}
    %Equal.sym(T.Schema, I.active_fields(ab, nb, fb), S.slots(ab, nb, fb), M.active_slots(ab, nb, fb)) : {S.shared_positions(S.slots(aa, na, fa), _, 0n) == True{} : Bool}
    positions,
    %Equal.sym(T.Schema, I.active_fields(aa, na, fa), S.slots(aa, na, fa), M.active_slots(aa, na, fa)) : F.finite(S.Slots{}, _, I.active_fields(ab, nb, fb))
    %Equal.sym(T.Schema, I.active_fields(ab, nb, fb), S.slots(ab, nb, fb), M.active_slots(ab, nb, fb)) : F.finite(S.Slots{}, S.slots(aa, na, fa), _)
    child)

# Witness induction is unrestricted; no implementation success is a premise.
law complete:
  for +witness: S.Derivation
  for +mode: S.Judgement
  for +a: T.Schema
  for +b: T.Schema
  for +accepted: {S.derives(witness, mode, a, b) == True{} : Bool}
  F.finite(mode, a, b)
def complete(witness, mode, a, b, accepted):
  match witness:
    case S.Leaf{}:
      match mode:
        case S.Pair{}: Identity.finite_identity(a, b, accepted)
        case S.All{}:
          match a:
            case T.Boolean{}: Empty.absurd(F.finite(S.All{}, T.Boolean{}, b), W.false_true(accepted))
            case T.Unsigned{x0}: Empty.absurd(F.finite(S.All{}, T.Unsigned{x0}, b), W.false_true(accepted))
            case T.ByteVector{x0}: Empty.absurd(F.finite(S.All{}, T.ByteVector{x0}, b), W.false_true(accepted))
            case T.ByteList{x0}: Empty.absurd(F.finite(S.All{}, T.ByteList{x0}, b), W.false_true(accepted))
            case T.BitVector{x0}: Empty.absurd(F.finite(S.All{}, T.BitVector{x0}, b), W.false_true(accepted))
            case T.BitList{x0}: Empty.absurd(F.finite(S.All{}, T.BitList{x0}, b), W.false_true(accepted))
            case T.Vector{x0, x1}: Empty.absurd(F.finite(S.All{}, T.Vector{x0, x1}, b), W.false_true(accepted))
            case T.ListOf{x0, x1}: Empty.absurd(F.finite(S.All{}, T.ListOf{x0, x1}, b), W.false_true(accepted))
            case T.Container{x0, x1}: Empty.absurd(F.finite(S.All{}, T.Container{x0, x1}, b), W.false_true(accepted))
            case T.Union{x0}: Empty.absurd(F.finite(S.All{}, T.Union{x0}, b), W.false_true(accepted))
            case T.Null{}: Empty.absurd(F.finite(S.All{}, T.Null{}, b), W.false_true(accepted))
            case T.Chain{x0, x1}: Empty.absurd(F.finite(S.All{}, T.Chain{x0, x1}, b), W.false_true(accepted))
            case T.End{}: (1n, {==})
            case T.Repeat{x0}: Empty.absurd(F.finite(S.All{}, T.Repeat{x0}, b), W.false_true(accepted))
            case T.Named{x0, x1}: Empty.absurd(F.finite(S.All{}, T.Named{x0, x1}, b), W.false_true(accepted))
            case T.ProgressiveList{x0}: Empty.absurd(F.finite(S.All{}, T.ProgressiveList{x0}, b), W.false_true(accepted))
            case T.ProgressiveBits{}: Empty.absurd(F.finite(S.All{}, T.ProgressiveBits{}, b), W.false_true(accepted))
            case T.ProgressiveContainer{x0, x1, x2}: Empty.absurd(F.finite(S.All{}, T.ProgressiveContainer{x0, x1, x2}, b), W.false_true(accepted))
            case T.CompatibleUnion{x0, x1}: Empty.absurd(F.finite(S.All{}, T.CompatibleUnion{x0, x1}, b), W.false_true(accepted))
        case S.Row{}:
          match b:
            case T.Boolean{}: Empty.absurd(F.finite(S.Row{}, a, T.Boolean{}), W.false_true(accepted))
            case T.Unsigned{x0}: Empty.absurd(F.finite(S.Row{}, a, T.Unsigned{x0}), W.false_true(accepted))
            case T.ByteVector{x0}: Empty.absurd(F.finite(S.Row{}, a, T.ByteVector{x0}), W.false_true(accepted))
            case T.ByteList{x0}: Empty.absurd(F.finite(S.Row{}, a, T.ByteList{x0}), W.false_true(accepted))
            case T.BitVector{x0}: Empty.absurd(F.finite(S.Row{}, a, T.BitVector{x0}), W.false_true(accepted))
            case T.BitList{x0}: Empty.absurd(F.finite(S.Row{}, a, T.BitList{x0}), W.false_true(accepted))
            case T.Vector{x0, x1}: Empty.absurd(F.finite(S.Row{}, a, T.Vector{x0, x1}), W.false_true(accepted))
            case T.ListOf{x0, x1}: Empty.absurd(F.finite(S.Row{}, a, T.ListOf{x0, x1}), W.false_true(accepted))
            case T.Container{x0, x1}: Empty.absurd(F.finite(S.Row{}, a, T.Container{x0, x1}), W.false_true(accepted))
            case T.Union{x0}: Empty.absurd(F.finite(S.Row{}, a, T.Union{x0}), W.false_true(accepted))
            case T.Null{}: Empty.absurd(F.finite(S.Row{}, a, T.Null{}), W.false_true(accepted))
            case T.Chain{x0, x1}: Empty.absurd(F.finite(S.Row{}, a, T.Chain{x0, x1}), W.false_true(accepted))
            case T.End{}: (1n, {==})
            case T.Repeat{x0}: Empty.absurd(F.finite(S.Row{}, a, T.Repeat{x0}), W.false_true(accepted))
            case T.Named{x0, x1}: Empty.absurd(F.finite(S.Row{}, a, T.Named{x0, x1}), W.false_true(accepted))
            case T.ProgressiveList{x0}: Empty.absurd(F.finite(S.Row{}, a, T.ProgressiveList{x0}), W.false_true(accepted))
            case T.ProgressiveBits{}: Empty.absurd(F.finite(S.Row{}, a, T.ProgressiveBits{}), W.false_true(accepted))
            case T.ProgressiveContainer{x0, x1, x2}: Empty.absurd(F.finite(S.Row{}, a, T.ProgressiveContainer{x0, x1, x2}), W.false_true(accepted))
            case T.CompatibleUnion{x0, x1}: Empty.absurd(F.finite(S.Row{}, a, T.CompatibleUnion{x0, x1}), W.false_true(accepted))
        case S.Slots{}:
          match a b:
            case T.Boolean{} T.Boolean{}: Empty.absurd(F.finite(S.Slots{}, T.Boolean{}, T.Boolean{}), W.false_true(accepted))
            case T.Boolean{} T.Unsigned{b0}: Empty.absurd(F.finite(S.Slots{}, T.Boolean{}, T.Unsigned{b0}), W.false_true(accepted))
            case T.Boolean{} T.ByteVector{b0}: Empty.absurd(F.finite(S.Slots{}, T.Boolean{}, T.ByteVector{b0}), W.false_true(accepted))
            case T.Boolean{} T.ByteList{b0}: Empty.absurd(F.finite(S.Slots{}, T.Boolean{}, T.ByteList{b0}), W.false_true(accepted))
            case T.Boolean{} T.BitVector{b0}: Empty.absurd(F.finite(S.Slots{}, T.Boolean{}, T.BitVector{b0}), W.false_true(accepted))
            case T.Boolean{} T.BitList{b0}: Empty.absurd(F.finite(S.Slots{}, T.Boolean{}, T.BitList{b0}), W.false_true(accepted))
            case T.Boolean{} T.Vector{b0, b1}: Empty.absurd(F.finite(S.Slots{}, T.Boolean{}, T.Vector{b0, b1}), W.false_true(accepted))
            case T.Boolean{} T.ListOf{b0, b1}: Empty.absurd(F.finite(S.Slots{}, T.Boolean{}, T.ListOf{b0, b1}), W.false_true(accepted))
            case T.Boolean{} T.Container{b0, b1}: Empty.absurd(F.finite(S.Slots{}, T.Boolean{}, T.Container{b0, b1}), W.false_true(accepted))
            case T.Boolean{} T.Union{b0}: Empty.absurd(F.finite(S.Slots{}, T.Boolean{}, T.Union{b0}), W.false_true(accepted))
            case T.Boolean{} T.Null{}: Empty.absurd(F.finite(S.Slots{}, T.Boolean{}, T.Null{}), W.false_true(accepted))
            case T.Boolean{} T.Chain{b0, b1}: Empty.absurd(F.finite(S.Slots{}, T.Boolean{}, T.Chain{b0, b1}), W.false_true(accepted))
            case T.Boolean{} T.End{}: F.slots_end_right(T.Boolean{})
            case T.Boolean{} T.Repeat{b0}: Empty.absurd(F.finite(S.Slots{}, T.Boolean{}, T.Repeat{b0}), W.false_true(accepted))
            case T.Boolean{} T.Named{b0, b1}: Empty.absurd(F.finite(S.Slots{}, T.Boolean{}, T.Named{b0, b1}), W.false_true(accepted))
            case T.Boolean{} T.ProgressiveList{b0}: Empty.absurd(F.finite(S.Slots{}, T.Boolean{}, T.ProgressiveList{b0}), W.false_true(accepted))
            case T.Boolean{} T.ProgressiveBits{}: Empty.absurd(F.finite(S.Slots{}, T.Boolean{}, T.ProgressiveBits{}), W.false_true(accepted))
            case T.Boolean{} T.ProgressiveContainer{b0, b1, b2}: Empty.absurd(F.finite(S.Slots{}, T.Boolean{}, T.ProgressiveContainer{b0, b1, b2}), W.false_true(accepted))
            case T.Boolean{} T.CompatibleUnion{b0, b1}: Empty.absurd(F.finite(S.Slots{}, T.Boolean{}, T.CompatibleUnion{b0, b1}), W.false_true(accepted))
            case T.Unsigned{a0} T.Boolean{}: Empty.absurd(F.finite(S.Slots{}, T.Unsigned{a0}, T.Boolean{}), W.false_true(accepted))
            case T.Unsigned{a0} T.Unsigned{b0}: Empty.absurd(F.finite(S.Slots{}, T.Unsigned{a0}, T.Unsigned{b0}), W.false_true(accepted))
            case T.Unsigned{a0} T.ByteVector{b0}: Empty.absurd(F.finite(S.Slots{}, T.Unsigned{a0}, T.ByteVector{b0}), W.false_true(accepted))
            case T.Unsigned{a0} T.ByteList{b0}: Empty.absurd(F.finite(S.Slots{}, T.Unsigned{a0}, T.ByteList{b0}), W.false_true(accepted))
            case T.Unsigned{a0} T.BitVector{b0}: Empty.absurd(F.finite(S.Slots{}, T.Unsigned{a0}, T.BitVector{b0}), W.false_true(accepted))
            case T.Unsigned{a0} T.BitList{b0}: Empty.absurd(F.finite(S.Slots{}, T.Unsigned{a0}, T.BitList{b0}), W.false_true(accepted))
            case T.Unsigned{a0} T.Vector{b0, b1}: Empty.absurd(F.finite(S.Slots{}, T.Unsigned{a0}, T.Vector{b0, b1}), W.false_true(accepted))
            case T.Unsigned{a0} T.ListOf{b0, b1}: Empty.absurd(F.finite(S.Slots{}, T.Unsigned{a0}, T.ListOf{b0, b1}), W.false_true(accepted))
            case T.Unsigned{a0} T.Container{b0, b1}: Empty.absurd(F.finite(S.Slots{}, T.Unsigned{a0}, T.Container{b0, b1}), W.false_true(accepted))
            case T.Unsigned{a0} T.Union{b0}: Empty.absurd(F.finite(S.Slots{}, T.Unsigned{a0}, T.Union{b0}), W.false_true(accepted))
            case T.Unsigned{a0} T.Null{}: Empty.absurd(F.finite(S.Slots{}, T.Unsigned{a0}, T.Null{}), W.false_true(accepted))
            case T.Unsigned{a0} T.Chain{b0, b1}: Empty.absurd(F.finite(S.Slots{}, T.Unsigned{a0}, T.Chain{b0, b1}), W.false_true(accepted))
            case T.Unsigned{a0} T.End{}: F.slots_end_right(T.Unsigned{a0})
            case T.Unsigned{a0} T.Repeat{b0}: Empty.absurd(F.finite(S.Slots{}, T.Unsigned{a0}, T.Repeat{b0}), W.false_true(accepted))
            case T.Unsigned{a0} T.Named{b0, b1}: Empty.absurd(F.finite(S.Slots{}, T.Unsigned{a0}, T.Named{b0, b1}), W.false_true(accepted))
            case T.Unsigned{a0} T.ProgressiveList{b0}: Empty.absurd(F.finite(S.Slots{}, T.Unsigned{a0}, T.ProgressiveList{b0}), W.false_true(accepted))
            case T.Unsigned{a0} T.ProgressiveBits{}: Empty.absurd(F.finite(S.Slots{}, T.Unsigned{a0}, T.ProgressiveBits{}), W.false_true(accepted))
            case T.Unsigned{a0} T.ProgressiveContainer{b0, b1, b2}: Empty.absurd(F.finite(S.Slots{}, T.Unsigned{a0}, T.ProgressiveContainer{b0, b1, b2}), W.false_true(accepted))
            case T.Unsigned{a0} T.CompatibleUnion{b0, b1}: Empty.absurd(F.finite(S.Slots{}, T.Unsigned{a0}, T.CompatibleUnion{b0, b1}), W.false_true(accepted))
            case T.ByteVector{a0} T.Boolean{}: Empty.absurd(F.finite(S.Slots{}, T.ByteVector{a0}, T.Boolean{}), W.false_true(accepted))
            case T.ByteVector{a0} T.Unsigned{b0}: Empty.absurd(F.finite(S.Slots{}, T.ByteVector{a0}, T.Unsigned{b0}), W.false_true(accepted))
            case T.ByteVector{a0} T.ByteVector{b0}: Empty.absurd(F.finite(S.Slots{}, T.ByteVector{a0}, T.ByteVector{b0}), W.false_true(accepted))
            case T.ByteVector{a0} T.ByteList{b0}: Empty.absurd(F.finite(S.Slots{}, T.ByteVector{a0}, T.ByteList{b0}), W.false_true(accepted))
            case T.ByteVector{a0} T.BitVector{b0}: Empty.absurd(F.finite(S.Slots{}, T.ByteVector{a0}, T.BitVector{b0}), W.false_true(accepted))
            case T.ByteVector{a0} T.BitList{b0}: Empty.absurd(F.finite(S.Slots{}, T.ByteVector{a0}, T.BitList{b0}), W.false_true(accepted))
            case T.ByteVector{a0} T.Vector{b0, b1}: Empty.absurd(F.finite(S.Slots{}, T.ByteVector{a0}, T.Vector{b0, b1}), W.false_true(accepted))
            case T.ByteVector{a0} T.ListOf{b0, b1}: Empty.absurd(F.finite(S.Slots{}, T.ByteVector{a0}, T.ListOf{b0, b1}), W.false_true(accepted))
            case T.ByteVector{a0} T.Container{b0, b1}: Empty.absurd(F.finite(S.Slots{}, T.ByteVector{a0}, T.Container{b0, b1}), W.false_true(accepted))
            case T.ByteVector{a0} T.Union{b0}: Empty.absurd(F.finite(S.Slots{}, T.ByteVector{a0}, T.Union{b0}), W.false_true(accepted))
            case T.ByteVector{a0} T.Null{}: Empty.absurd(F.finite(S.Slots{}, T.ByteVector{a0}, T.Null{}), W.false_true(accepted))
            case T.ByteVector{a0} T.Chain{b0, b1}: Empty.absurd(F.finite(S.Slots{}, T.ByteVector{a0}, T.Chain{b0, b1}), W.false_true(accepted))
            case T.ByteVector{a0} T.End{}: F.slots_end_right(T.ByteVector{a0})
            case T.ByteVector{a0} T.Repeat{b0}: Empty.absurd(F.finite(S.Slots{}, T.ByteVector{a0}, T.Repeat{b0}), W.false_true(accepted))
            case T.ByteVector{a0} T.Named{b0, b1}: Empty.absurd(F.finite(S.Slots{}, T.ByteVector{a0}, T.Named{b0, b1}), W.false_true(accepted))
            case T.ByteVector{a0} T.ProgressiveList{b0}: Empty.absurd(F.finite(S.Slots{}, T.ByteVector{a0}, T.ProgressiveList{b0}), W.false_true(accepted))
            case T.ByteVector{a0} T.ProgressiveBits{}: Empty.absurd(F.finite(S.Slots{}, T.ByteVector{a0}, T.ProgressiveBits{}), W.false_true(accepted))
            case T.ByteVector{a0} T.ProgressiveContainer{b0, b1, b2}: Empty.absurd(F.finite(S.Slots{}, T.ByteVector{a0}, T.ProgressiveContainer{b0, b1, b2}), W.false_true(accepted))
            case T.ByteVector{a0} T.CompatibleUnion{b0, b1}: Empty.absurd(F.finite(S.Slots{}, T.ByteVector{a0}, T.CompatibleUnion{b0, b1}), W.false_true(accepted))
            case T.ByteList{a0} T.Boolean{}: Empty.absurd(F.finite(S.Slots{}, T.ByteList{a0}, T.Boolean{}), W.false_true(accepted))
            case T.ByteList{a0} T.Unsigned{b0}: Empty.absurd(F.finite(S.Slots{}, T.ByteList{a0}, T.Unsigned{b0}), W.false_true(accepted))
            case T.ByteList{a0} T.ByteVector{b0}: Empty.absurd(F.finite(S.Slots{}, T.ByteList{a0}, T.ByteVector{b0}), W.false_true(accepted))
            case T.ByteList{a0} T.ByteList{b0}: Empty.absurd(F.finite(S.Slots{}, T.ByteList{a0}, T.ByteList{b0}), W.false_true(accepted))
            case T.ByteList{a0} T.BitVector{b0}: Empty.absurd(F.finite(S.Slots{}, T.ByteList{a0}, T.BitVector{b0}), W.false_true(accepted))
            case T.ByteList{a0} T.BitList{b0}: Empty.absurd(F.finite(S.Slots{}, T.ByteList{a0}, T.BitList{b0}), W.false_true(accepted))
            case T.ByteList{a0} T.Vector{b0, b1}: Empty.absurd(F.finite(S.Slots{}, T.ByteList{a0}, T.Vector{b0, b1}), W.false_true(accepted))
            case T.ByteList{a0} T.ListOf{b0, b1}: Empty.absurd(F.finite(S.Slots{}, T.ByteList{a0}, T.ListOf{b0, b1}), W.false_true(accepted))
            case T.ByteList{a0} T.Container{b0, b1}: Empty.absurd(F.finite(S.Slots{}, T.ByteList{a0}, T.Container{b0, b1}), W.false_true(accepted))
            case T.ByteList{a0} T.Union{b0}: Empty.absurd(F.finite(S.Slots{}, T.ByteList{a0}, T.Union{b0}), W.false_true(accepted))
            case T.ByteList{a0} T.Null{}: Empty.absurd(F.finite(S.Slots{}, T.ByteList{a0}, T.Null{}), W.false_true(accepted))
            case T.ByteList{a0} T.Chain{b0, b1}: Empty.absurd(F.finite(S.Slots{}, T.ByteList{a0}, T.Chain{b0, b1}), W.false_true(accepted))
            case T.ByteList{a0} T.End{}: F.slots_end_right(T.ByteList{a0})
            case T.ByteList{a0} T.Repeat{b0}: Empty.absurd(F.finite(S.Slots{}, T.ByteList{a0}, T.Repeat{b0}), W.false_true(accepted))
            case T.ByteList{a0} T.Named{b0, b1}: Empty.absurd(F.finite(S.Slots{}, T.ByteList{a0}, T.Named{b0, b1}), W.false_true(accepted))
            case T.ByteList{a0} T.ProgressiveList{b0}: Empty.absurd(F.finite(S.Slots{}, T.ByteList{a0}, T.ProgressiveList{b0}), W.false_true(accepted))
            case T.ByteList{a0} T.ProgressiveBits{}: Empty.absurd(F.finite(S.Slots{}, T.ByteList{a0}, T.ProgressiveBits{}), W.false_true(accepted))
            case T.ByteList{a0} T.ProgressiveContainer{b0, b1, b2}: Empty.absurd(F.finite(S.Slots{}, T.ByteList{a0}, T.ProgressiveContainer{b0, b1, b2}), W.false_true(accepted))
            case T.ByteList{a0} T.CompatibleUnion{b0, b1}: Empty.absurd(F.finite(S.Slots{}, T.ByteList{a0}, T.CompatibleUnion{b0, b1}), W.false_true(accepted))
            case T.BitVector{a0} T.Boolean{}: Empty.absurd(F.finite(S.Slots{}, T.BitVector{a0}, T.Boolean{}), W.false_true(accepted))
            case T.BitVector{a0} T.Unsigned{b0}: Empty.absurd(F.finite(S.Slots{}, T.BitVector{a0}, T.Unsigned{b0}), W.false_true(accepted))
            case T.BitVector{a0} T.ByteVector{b0}: Empty.absurd(F.finite(S.Slots{}, T.BitVector{a0}, T.ByteVector{b0}), W.false_true(accepted))
            case T.BitVector{a0} T.ByteList{b0}: Empty.absurd(F.finite(S.Slots{}, T.BitVector{a0}, T.ByteList{b0}), W.false_true(accepted))
            case T.BitVector{a0} T.BitVector{b0}: Empty.absurd(F.finite(S.Slots{}, T.BitVector{a0}, T.BitVector{b0}), W.false_true(accepted))
            case T.BitVector{a0} T.BitList{b0}: Empty.absurd(F.finite(S.Slots{}, T.BitVector{a0}, T.BitList{b0}), W.false_true(accepted))
            case T.BitVector{a0} T.Vector{b0, b1}: Empty.absurd(F.finite(S.Slots{}, T.BitVector{a0}, T.Vector{b0, b1}), W.false_true(accepted))
            case T.BitVector{a0} T.ListOf{b0, b1}: Empty.absurd(F.finite(S.Slots{}, T.BitVector{a0}, T.ListOf{b0, b1}), W.false_true(accepted))
            case T.BitVector{a0} T.Container{b0, b1}: Empty.absurd(F.finite(S.Slots{}, T.BitVector{a0}, T.Container{b0, b1}), W.false_true(accepted))
            case T.BitVector{a0} T.Union{b0}: Empty.absurd(F.finite(S.Slots{}, T.BitVector{a0}, T.Union{b0}), W.false_true(accepted))
