# ---------------------------------------------------------------------------
# Every relational root satisfies the uint256 length-mixer conditions: a
# length whose uint256 encoding does not exist has no mixed root.

def nat_some(r: Maybe<&2, Nat>) -> Bool:
  match r:
    case None{}: False{}
    case Some{n}: True{}

def some_bytes(r: Maybe<&2, +List<U32>>) -> Bool:
  match r:
    case None{}: False{}
    case Some{x}: True{}

law single_none:
  for +outs: +List<+List<U32>>
  for s: R.single(None{}, outs)
  Empty
def single_none(outs, s):
  match outs:
    case Nil{}: s
    case Con{r, rest}:
      match rest:
        case Nil{}: W.false_true(Equal.cong(Maybe<&2, +List<U32>>, Bool, some_bytes, None{}, Some{r}, s))
        case Con{a, b}: s

law mix_fits:
  for +root: Maybe<&2, +List<U32>>
  for +ok: Bool
  for +ys: +List<U32>
  for +outs: +List<+List<U32>>
  for s: R.single(SBits.mix_length_bytes(root, SP.optional(ok, ys)), outs)
  {ok == True{} : Bool}
def mix_fits(root, ok, ys, outs, s):
  match root:
    case None{}:
      match ok:
        case True{}: {==}
        case False{}: Empty.absurd({False{} == True{} : Bool}, single_none(outs, s))
    case Some{x}:
      match ok:
        case True{}: {==}
        case False{}: Empty.absurd({False{} == True{} : Bool}, single_none(outs, s))

law aggregate_fits:
  for +prog: Bool
  for +limit: Nat
  for +chunks: +List<+List<U32>>
  for +n: Nat
  for +outs: +List<+List<U32>>
  for agg: R.aggregate(prog, limit, chunks, Some{n}, outs)
  {SLen.fits(32n, n) == True{} : Bool}
def aggregate_fits(prog, limit, chunks, n, outs, agg):
  (+root, (tree, mixed)) = agg
  mix_fits(Some{root}, SLen.fits(32n, n), SLen.digits(32n, n), outs, mixed)

law bytelist_gate_fits:
  for +ok: Bool
  for +n: Nat
  for +depth: Nat
  for +xs: +List<U32>
  for +outs: +List<+List<U32>>
  for s: R.single(SBL.root_gate(ok, n, depth, xs), outs)
  {SLen.fits(32n, List.length(&2, U32, xs)) == True{} : Bool}
def bytelist_gate_fits(ok, n, depth, xs, outs, s):
  match ok:
    case False{}: Empty.absurd({SLen.fits(32n, List.length(&2, U32, xs)) == True{} : Bool}, single_none(outs, s))
    case True{}: mix_fits(SL.at_depth(SBL.chunk_limit(n), depth, SPack.scan(xs, 31n, [], [])), SLen.fits(32n, List.length(&2, U32, xs)), SLen.digits(32n, List.length(&2, U32, xs)), outs, s)

law bitlist_gate_fits:
  for +ok: Bool
  for +n: Nat
  for +depth: Nat
  for +bits: +List<Bool>
  for +outs: +List<+List<U32>>
  for s: R.single(SBits.list_gate(ok, n, depth, bits), outs)
  {SLen.fits(32n, List.length(&2, Bool, bits)) == True{} : Bool}
def bitlist_gate_fits(ok, n, depth, bits, outs, s):
  match ok:
    case False{}: Empty.absurd({SLen.fits(32n, List.length(&2, Bool, bits)) == True{} : Bool}, single_none(outs, s))
    case True{}: mix_fits(SL.at_depth(SBits.chunk_limit(n), depth, SBits.chunks(bits)), SLen.fits(32n, List.length(&2, Bool, bits)), SLen.digits(32n, List.length(&2, Bool, bits)), outs, s)

law join_left:
  for +a: Maybe<&2, +List<U32>>
  for +b: Maybe<&2, +List<U32>>
  for +bytes: +List<U32>
  for +eq: {R.join(a, b) == Some{bytes} : Maybe<&2, +List<U32>>}
  Exists(+List<U32>, x => {a == Some{x} : Maybe<&2, +List<U32>>})
def join_left(a, b, bytes, eq):
  match a:
    case None{}: Empty.absurd(Exists(+List<U32>, x => {None{} == Some{x} : Maybe<&2, +List<U32>>}), W.false_true(Equal.cong(Maybe<&2, +List<U32>>, Bool, some_bytes, None{}, Some{bytes}, eq)))
    case Some{x}: (x, {==})

law join_right:
  for +a: Maybe<&2, +List<U32>>
  for +b: Maybe<&2, +List<U32>>
  for +bytes: +List<U32>
  for +eq: {R.join(a, b) == Some{bytes} : Maybe<&2, +List<U32>>}
  Exists(+List<U32>, y => {b == Some{y} : Maybe<&2, +List<U32>>})
def join_right(a, b, bytes, eq):
  match a:
    case None{}: Empty.absurd(Exists(+List<U32>, y => {b == Some{y} : Maybe<&2, +List<U32>>}), W.false_true(Equal.cong(Maybe<&2, +List<U32>>, Bool, some_bytes, None{}, Some{bytes}, eq)))
    case Some{x}:
      match b:
        case None{}: Empty.absurd(Exists(+List<U32>, y => {None{} == Some{y} : Maybe<&2, +List<U32>>}), W.false_true(Equal.cong(Maybe<&2, +List<U32>>, Bool, some_bytes, None{}, Some{bytes}, eq)))
        case Some{y}: (y, {==})

law one_mixing:
  for +h: T.Value
  for +s: T.Schema
  for +x: +List<U32>
  for +eq: {R.basic_one(h, s) == Some{x} : Maybe<&2, +List<U32>>}
  {VD.mixing_lengths(h, s) == True{} : Bool}
def one_mixing(h, s, x, eq):
  match h:
    case T.BooleanValue{v0}: {==}
    case T.UnsignedValue{v0}: {==}
    case T.BytesValue{v0}: Empty.absurd({VD.mixing_lengths(T.BytesValue{v0}, s) == True{} : Bool}, W.false_true(Equal.cong(Maybe<&2, +List<U32>>, Bool, some_bytes, None{}, Some{x}, eq)))
    case T.BitsValue{v0}: Empty.absurd({VD.mixing_lengths(T.BitsValue{v0}, s) == True{} : Bool}, W.false_true(Equal.cong(Maybe<&2, +List<U32>>, Bool, some_bytes, None{}, Some{x}, eq)))
    case T.Sequence{v0}: Empty.absurd({VD.mixing_lengths(T.Sequence{v0}, s) == True{} : Bool}, W.false_true(Equal.cong(Maybe<&2, +List<U32>>, Bool, some_bytes, None{}, Some{x}, eq)))
    case T.Items{v0, v1}: Empty.absurd({VD.mixing_lengths(T.Items{v0, v1}, s) == True{} : Bool}, W.false_true(Equal.cong(Maybe<&2, +List<U32>>, Bool, some_bytes, None{}, Some{x}, eq)))
    case T.EmptyItems{}: {==}
    case T.Selected{v0, v1}: Empty.absurd({VD.mixing_lengths(T.Selected{v0, v1}, s) == True{} : Bool}, W.false_true(Equal.cong(Maybe<&2, +List<U32>>, Bool, some_bytes, None{}, Some{x}, eq)))
    case T.NullValue{}: {==}

law mix_pair:
  for +h: T.Value
  for +t: T.Value
  for +s: T.Schema
  for left: Exists(+List<U32>, x => {R.basic_one(h, s) == Some{x} : Maybe<&2, +List<U32>>})
  for right: Exists(+List<U32>, y => {R.basic_bytes(t, s) == Some{y} : Maybe<&2, +List<U32>>})
  for recur: @+y: +List<U32> -> @+e: {R.basic_bytes(t, s) == Some{y} : Maybe<&2, +List<U32>>} -> {VD.mixing_lengths(t, T.Repeat{s}) == True{} : Bool}
  {Bool.and(VD.mixing_lengths(h, s), VD.mixing_lengths(t, T.Repeat{s})) == True{} : Bool}
def mix_pair(h, t, s, left, right, recur):
  (+x, ex) = left
  (+y, ey) = right
  V.and_true(VD.mixing_lengths(h, s), VD.mixing_lengths(t, T.Repeat{s}), one_mixing(h, s, x, ex), recur(y, ey))

law basic_mixing:
  for +items: T.Value
  for +s: T.Schema
  for +bytes: +List<U32>
  for +eq: {R.basic_bytes(items, s) == Some{bytes} : Maybe<&2, +List<U32>>}
  {VD.mixing_lengths(items, T.Repeat{s}) == True{} : Bool}
def basic_mixing(items, s, bytes, eq):
  match items:
    case T.BooleanValue{v0}: Empty.absurd({VD.mixing_lengths(T.BooleanValue{v0}, T.Repeat{s}) == True{} : Bool}, W.false_true(Equal.cong(Maybe<&2, +List<U32>>, Bool, some_bytes, None{}, Some{bytes}, eq)))
    case T.UnsignedValue{v0}: Empty.absurd({VD.mixing_lengths(T.UnsignedValue{v0}, T.Repeat{s}) == True{} : Bool}, W.false_true(Equal.cong(Maybe<&2, +List<U32>>, Bool, some_bytes, None{}, Some{bytes}, eq)))
    case T.BytesValue{v0}: Empty.absurd({VD.mixing_lengths(T.BytesValue{v0}, T.Repeat{s}) == True{} : Bool}, W.false_true(Equal.cong(Maybe<&2, +List<U32>>, Bool, some_bytes, None{}, Some{bytes}, eq)))
    case T.BitsValue{v0}: Empty.absurd({VD.mixing_lengths(T.BitsValue{v0}, T.Repeat{s}) == True{} : Bool}, W.false_true(Equal.cong(Maybe<&2, +List<U32>>, Bool, some_bytes, None{}, Some{bytes}, eq)))
    case T.Sequence{v0}: Empty.absurd({VD.mixing_lengths(T.Sequence{v0}, T.Repeat{s}) == True{} : Bool}, W.false_true(Equal.cong(Maybe<&2, +List<U32>>, Bool, some_bytes, None{}, Some{bytes}, eq)))
    case T.Items{h, t}:
      mix_pair(h, t, s, join_left(R.basic_one(h, s), R.basic_bytes(t, s), bytes, eq), join_right(R.basic_one(h, s), R.basic_bytes(t, s), bytes, eq), y => ey => basic_mixing(t, s, y, ey))
    case T.EmptyItems{}: {==}
    case T.Selected{v0, v1}: Empty.absurd({VD.mixing_lengths(T.Selected{v0, v1}, T.Repeat{s}) == True{} : Bool}, W.false_true(Equal.cong(Maybe<&2, +List<U32>>, Bool, some_bytes, None{}, Some{bytes}, eq)))
    case T.NullValue{}: {==}

law chunks_mixing:
  for +size: Maybe<&2, Nat>
  for +items: T.Value
  for +s: T.Schema
  for +chunks: +List<+List<U32>>
  for sc: R.sequence_chunks(size, R.basic_bytes(items, s), cs => R.roots(items, T.Repeat{s}, cs), chunks)
  for recur: @+cs: +List<+List<U32>> -> R.roots(items, T.Repeat{s}, cs) -> {VD.mixing_lengths(items, T.Repeat{s}) == True{} : Bool}
  {VD.mixing_lengths(items, T.Repeat{s}) == True{} : Bool}
def chunks_mixing(size, items, s, chunks, sc, recur):
  match size:
    case None{}: recur(chunks, sc)
    case Some{w}:
      (+bytes, (eq, packed)) = sc
      basic_mixing(items, s, bytes, eq)

law selected_mixing:
  for +found: Maybe<&2, T.Schema>
  for +v: T.Value
  for +selector: U32
  for +outs: +List<+List<U32>>
  for rel: R.selected(found, s => Exists(+List<U32>, root => R.roots(v, s, [root]) & R.single(SMixing.mix_in_selector(root, selector), outs)))
  for recur: @+s: T.Schema -> @+root: +List<U32> -> R.roots(v, s, [root]) -> {VD.mixing_lengths(v, s) == True{} : Bool}
  {VD.selected(found, s => VD.mixing_lengths(v, s)) == True{} : Bool}
def selected_mixing(found, v, selector, outs, rel, recur):
  match found:
    case None{}:
      match rel:
    case Some{s}:
      (+root, (child, mixed)) = rel
      recur(s, root, child)

law relation_mixing:
  for +value: T.Value
  for +schema: T.Schema
  for +outs: +List<+List<U32>>
  for rel: R.roots(value, schema, outs)
  {VD.mixing_lengths(value, schema) == True{} : Bool}
def relation_mixing(value, schema, outs, rel):
  match value:
    case T.BooleanValue{v0}:
      match schema:
        case T.Boolean{}: {==}
        case T.Unsigned{s0}:
          match rel:
        case T.ByteVector{s0}:
          match rel:
        case T.ByteList{s0}:
          match rel:
        case T.BitVector{s0}:
          match rel:
        case T.BitList{s0}:
