import Base
import ../types/schema.bend as T
import ../src/schema.bend as I
import ../src/primitives.bend as P
import ../spec/compatibility.bend as S
import ./compatibility_derivation.bend as D
import ./compatibility_named.bend as Named
import ./compatibility_identity.bend as Identity
import ./compatibility_positions.bend as Positions
import ./compatibility_slot_shape.bend as Shape
import ./validator_metadata.bend as M
import ./primitive_invariants.bend as V
import ./word_facts.bend as W
import ./compatibility_choice.bend as Choice

def code(mode: S.Judgement) -> U32:
  match mode:
    case S.Pair{}: 0
    case S.All{}: 1
    case S.Row{}: 2
    case S.Slots{}: 3

def requirement(mode: S.Judgement, a: T.Schema, b: T.Schema) -> Type:
  match mode:
    case S.Slots{}: {Shape.slot_forest(a) == True{} : Bool} & {Shape.slot_forest(b) == True{} : Bool}
    case _: Unit

law progressive:
  for +na: +List<String>
  for +fa: T.Schema
  for +aa: +List<Bool>
  for +nb: +List<String>
  for +fb: T.Schema
  for +ab: +List<Bool>
  for positions: {I.shared_positions(I.active_fields(aa, na, fa), I.active_fields(ab, nb, fb), 0n) == True{} : Bool}
  for child: D.evidence(S.Slots{}, I.active_fields(aa, na, fa), I.active_fields(ab, nb, fb))
  S.compatible(T.ProgressiveContainer{na, fa, aa}, T.ProgressiveContainer{nb, fb, ab})
def progressive(na, fa, aa, nb, fb, ab, positions, child):
  D.progressive_container(na, fa, aa, nb, fb, ab,
    %M.active_slots(aa, na, fa) : {S.shared_positions(_, S.slots(ab, nb, fb), 0n) == True{} : Bool}
    %M.active_slots(ab, nb, fb) : {S.shared_positions(I.active_fields(aa, na, fa), _, 0n) == True{} : Bool}
    %Positions.shared_positions(I.active_fields(aa, na, fa), I.active_fields(ab, nb, fb), 0n) : {_ == True{} : Bool}
    positions,
    %M.active_slots(aa, na, fa) : D.evidence(S.Slots{}, _, S.slots(ab, nb, fb))
    %M.active_slots(ab, nb, fb) : D.evidence(S.Slots{}, I.active_fields(aa, na, fa), _)
    child)

# Every successful actual traversal has an independent finite derivation.
# The sole auxiliary invariant (for Slots) is established by active expansion.
law sound:
  for +fuel: Nat
  for +mode: S.Judgement
  for +a: T.Schema
  for +b: T.Schema
  for slots: requirement(mode, a, b)
  for +accepted: {I.compatible_go(fuel, code(mode), a, b) == True{} : Bool}
  D.evidence(mode, a, b)
def sound(fuel, mode, a, b, slots, accepted):
  match fuel:
    case 0n: Empty.absurd(D.evidence(mode, a, b), W.false_true(accepted))
    case 1n+p:
      match mode:
        case S.All{}:
          match a:
            case T.Boolean{}: Empty.absurd(D.evidence(S.All{}, T.Boolean{}, b), W.false_true(accepted))
            case T.Unsigned{x0}: Empty.absurd(D.evidence(S.All{}, T.Unsigned{x0}, b), W.false_true(accepted))
            case T.ByteVector{x0}: Empty.absurd(D.evidence(S.All{}, T.ByteVector{x0}, b), W.false_true(accepted))
            case T.ByteList{x0}: Empty.absurd(D.evidence(S.All{}, T.ByteList{x0}, b), W.false_true(accepted))
            case T.BitVector{x0}: Empty.absurd(D.evidence(S.All{}, T.BitVector{x0}, b), W.false_true(accepted))
            case T.BitList{x0}: Empty.absurd(D.evidence(S.All{}, T.BitList{x0}, b), W.false_true(accepted))
            case T.Vector{x0, x1}: Empty.absurd(D.evidence(S.All{}, T.Vector{x0, x1}, b), W.false_true(accepted))
            case T.ListOf{x0, x1}: Empty.absurd(D.evidence(S.All{}, T.ListOf{x0, x1}, b), W.false_true(accepted))
            case T.Container{x0, x1}: Empty.absurd(D.evidence(S.All{}, T.Container{x0, x1}, b), W.false_true(accepted))
            case T.Union{x0}: Empty.absurd(D.evidence(S.All{}, T.Union{x0}, b), W.false_true(accepted))
            case T.Null{}: Empty.absurd(D.evidence(S.All{}, T.Null{}, b), W.false_true(accepted))
            case T.Chain{x0, x1}: D.all(x0, x1, b, sound(p, S.Row{}, x0, b, Unit{}, V.and_left(I.compatible_go(p, 2, x0, b), I.compatible_go(p, 1, x1, b), accepted)), sound(p, S.All{}, x1, b, Unit{}, V.and_right(I.compatible_go(p, 2, x0, b), I.compatible_go(p, 1, x1, b), accepted)))
            case T.End{}: (S.Leaf{}, {==})
            case T.Repeat{x0}: Empty.absurd(D.evidence(S.All{}, T.Repeat{x0}, b), W.false_true(accepted))
            case T.Named{x0, x1}: Empty.absurd(D.evidence(S.All{}, T.Named{x0, x1}, b), W.false_true(accepted))
            case T.ProgressiveList{x0}: Empty.absurd(D.evidence(S.All{}, T.ProgressiveList{x0}, b), W.false_true(accepted))
            case T.ProgressiveBits{}: Empty.absurd(D.evidence(S.All{}, T.ProgressiveBits{}, b), W.false_true(accepted))
            case T.ProgressiveContainer{x0, x1, x2}: Empty.absurd(D.evidence(S.All{}, T.ProgressiveContainer{x0, x1, x2}, b), W.false_true(accepted))
            case T.CompatibleUnion{x0, x1}: Empty.absurd(D.evidence(S.All{}, T.CompatibleUnion{x0, x1}, b), W.false_true(accepted))
        case S.Row{}:
          match b:
            case T.Boolean{}: Empty.absurd(D.evidence(S.Row{}, a, T.Boolean{}), W.false_true(accepted))
            case T.Unsigned{x0}: Empty.absurd(D.evidence(S.Row{}, a, T.Unsigned{x0}), W.false_true(accepted))
            case T.ByteVector{x0}: Empty.absurd(D.evidence(S.Row{}, a, T.ByteVector{x0}), W.false_true(accepted))
            case T.ByteList{x0}: Empty.absurd(D.evidence(S.Row{}, a, T.ByteList{x0}), W.false_true(accepted))
            case T.BitVector{x0}: Empty.absurd(D.evidence(S.Row{}, a, T.BitVector{x0}), W.false_true(accepted))
            case T.BitList{x0}: Empty.absurd(D.evidence(S.Row{}, a, T.BitList{x0}), W.false_true(accepted))
            case T.Vector{x0, x1}: Empty.absurd(D.evidence(S.Row{}, a, T.Vector{x0, x1}), W.false_true(accepted))
            case T.ListOf{x0, x1}: Empty.absurd(D.evidence(S.Row{}, a, T.ListOf{x0, x1}), W.false_true(accepted))
            case T.Container{x0, x1}: Empty.absurd(D.evidence(S.Row{}, a, T.Container{x0, x1}), W.false_true(accepted))
            case T.Union{x0}: Empty.absurd(D.evidence(S.Row{}, a, T.Union{x0}), W.false_true(accepted))
            case T.Null{}: Empty.absurd(D.evidence(S.Row{}, a, T.Null{}), W.false_true(accepted))
            case T.Chain{x0, x1}: D.row(a, x0, x1, sound(p, S.Pair{}, a, x0, Unit{}, V.and_left(I.compatible_go(p, 0, a, x0), I.compatible_go(p, 2, a, x1), accepted)), sound(p, S.Row{}, a, x1, Unit{}, V.and_right(I.compatible_go(p, 0, a, x0), I.compatible_go(p, 2, a, x1), accepted)))
            case T.End{}: (S.Leaf{}, {==})
            case T.Repeat{x0}: Empty.absurd(D.evidence(S.Row{}, a, T.Repeat{x0}), W.false_true(accepted))
            case T.Named{x0, x1}: Empty.absurd(D.evidence(S.Row{}, a, T.Named{x0, x1}), W.false_true(accepted))
            case T.ProgressiveList{x0}: Empty.absurd(D.evidence(S.Row{}, a, T.ProgressiveList{x0}), W.false_true(accepted))
            case T.ProgressiveBits{}: Empty.absurd(D.evidence(S.Row{}, a, T.ProgressiveBits{}), W.false_true(accepted))
            case T.ProgressiveContainer{x0, x1, x2}: Empty.absurd(D.evidence(S.Row{}, a, T.ProgressiveContainer{x0, x1, x2}), W.false_true(accepted))
            case T.CompatibleUnion{x0, x1}: Empty.absurd(D.evidence(S.Row{}, a, T.CompatibleUnion{x0, x1}), W.false_true(accepted))
        case S.Slots{}:
          match a b:
            case T.Boolean{} T.Boolean{}:
              (left, right) = slots
              Empty.absurd(D.evidence(S.Slots{}, T.Boolean{}, T.Boolean{}), W.false_true(left))
            case T.Boolean{} T.Unsigned{b0}:
              (left, right) = slots
              Empty.absurd(D.evidence(S.Slots{}, T.Boolean{}, T.Unsigned{b0}), W.false_true(left))
            case T.Boolean{} T.ByteVector{b0}:
              (left, right) = slots
              Empty.absurd(D.evidence(S.Slots{}, T.Boolean{}, T.ByteVector{b0}), W.false_true(left))
            case T.Boolean{} T.ByteList{b0}:
              (left, right) = slots
              Empty.absurd(D.evidence(S.Slots{}, T.Boolean{}, T.ByteList{b0}), W.false_true(left))
            case T.Boolean{} T.BitVector{b0}:
              (left, right) = slots
              Empty.absurd(D.evidence(S.Slots{}, T.Boolean{}, T.BitVector{b0}), W.false_true(left))
            case T.Boolean{} T.BitList{b0}:
              (left, right) = slots
              Empty.absurd(D.evidence(S.Slots{}, T.Boolean{}, T.BitList{b0}), W.false_true(left))
            case T.Boolean{} T.Vector{b0, b1}:
              (left, right) = slots
              Empty.absurd(D.evidence(S.Slots{}, T.Boolean{}, T.Vector{b0, b1}), W.false_true(left))
            case T.Boolean{} T.ListOf{b0, b1}:
              (left, right) = slots
              Empty.absurd(D.evidence(S.Slots{}, T.Boolean{}, T.ListOf{b0, b1}), W.false_true(left))
            case T.Boolean{} T.Container{b0, b1}:
              (left, right) = slots
              Empty.absurd(D.evidence(S.Slots{}, T.Boolean{}, T.Container{b0, b1}), W.false_true(left))
            case T.Boolean{} T.Union{b0}:
              (left, right) = slots
              Empty.absurd(D.evidence(S.Slots{}, T.Boolean{}, T.Union{b0}), W.false_true(left))
            case T.Boolean{} T.Null{}:
              (left, right) = slots
              Empty.absurd(D.evidence(S.Slots{}, T.Boolean{}, T.Null{}), W.false_true(left))
            case T.Boolean{} T.Chain{T.Boolean{}, b1}:
              (left, right) = slots
              Empty.absurd(D.evidence(S.Slots{}, T.Boolean{}, T.Chain{T.Boolean{}, b1}), W.false_true(left))
            case T.Boolean{} T.Chain{T.Unsigned{bc0}, b1}:
              (left, right) = slots
              Empty.absurd(D.evidence(S.Slots{}, T.Boolean{}, T.Chain{T.Unsigned{bc0}, b1}), W.false_true(left))
            case T.Boolean{} T.Chain{T.ByteVector{bc0}, b1}:
              (left, right) = slots
              Empty.absurd(D.evidence(S.Slots{}, T.Boolean{}, T.Chain{T.ByteVector{bc0}, b1}), W.false_true(left))
            case T.Boolean{} T.Chain{T.ByteList{bc0}, b1}:
              (left, right) = slots
              Empty.absurd(D.evidence(S.Slots{}, T.Boolean{}, T.Chain{T.ByteList{bc0}, b1}), W.false_true(left))
            case T.Boolean{} T.Chain{T.BitVector{bc0}, b1}:
              (left, right) = slots
              Empty.absurd(D.evidence(S.Slots{}, T.Boolean{}, T.Chain{T.BitVector{bc0}, b1}), W.false_true(left))
            case T.Boolean{} T.Chain{T.BitList{bc0}, b1}:
              (left, right) = slots
              Empty.absurd(D.evidence(S.Slots{}, T.Boolean{}, T.Chain{T.BitList{bc0}, b1}), W.false_true(left))
            case T.Boolean{} T.Chain{T.Vector{bc0, bc1}, b1}:
              (left, right) = slots
              Empty.absurd(D.evidence(S.Slots{}, T.Boolean{}, T.Chain{T.Vector{bc0, bc1}, b1}), W.false_true(left))
            case T.Boolean{} T.Chain{T.ListOf{bc0, bc1}, b1}:
              (left, right) = slots
              Empty.absurd(D.evidence(S.Slots{}, T.Boolean{}, T.Chain{T.ListOf{bc0, bc1}, b1}), W.false_true(left))
            case T.Boolean{} T.Chain{T.Container{bc0, bc1}, b1}:
              (left, right) = slots
              Empty.absurd(D.evidence(S.Slots{}, T.Boolean{}, T.Chain{T.Container{bc0, bc1}, b1}), W.false_true(left))
            case T.Boolean{} T.Chain{T.Union{bc0}, b1}:
              (left, right) = slots
              Empty.absurd(D.evidence(S.Slots{}, T.Boolean{}, T.Chain{T.Union{bc0}, b1}), W.false_true(left))
            case T.Boolean{} T.Chain{T.Null{}, b1}:
              (left, right) = slots
              Empty.absurd(D.evidence(S.Slots{}, T.Boolean{}, T.Chain{T.Null{}, b1}), W.false_true(left))
            case T.Boolean{} T.Chain{T.Chain{bc0, bc1}, b1}:
              (left, right) = slots
              Empty.absurd(D.evidence(S.Slots{}, T.Boolean{}, T.Chain{T.Chain{bc0, bc1}, b1}), W.false_true(left))
            case T.Boolean{} T.Chain{T.End{}, b1}:
              (left, right) = slots
              Empty.absurd(D.evidence(S.Slots{}, T.Boolean{}, T.Chain{T.End{}, b1}), W.false_true(left))
            case T.Boolean{} T.Chain{T.Repeat{bc0}, b1}:
              (left, right) = slots
              Empty.absurd(D.evidence(S.Slots{}, T.Boolean{}, T.Chain{T.Repeat{bc0}, b1}), W.false_true(left))
            case T.Boolean{} T.Chain{T.Named{bc0, bc1}, b1}:
              (left, right) = slots
              Empty.absurd(D.evidence(S.Slots{}, T.Boolean{}, T.Chain{T.Named{bc0, bc1}, b1}), W.false_true(left))
            case T.Boolean{} T.Chain{T.ProgressiveList{bc0}, b1}:
              (left, right) = slots
              Empty.absurd(D.evidence(S.Slots{}, T.Boolean{}, T.Chain{T.ProgressiveList{bc0}, b1}), W.false_true(left))
            case T.Boolean{} T.Chain{T.ProgressiveBits{}, b1}:
              (left, right) = slots
              Empty.absurd(D.evidence(S.Slots{}, T.Boolean{}, T.Chain{T.ProgressiveBits{}, b1}), W.false_true(left))
            case T.Boolean{} T.Chain{T.ProgressiveContainer{bc0, bc1, bc2}, b1}:
              (left, right) = slots
              Empty.absurd(D.evidence(S.Slots{}, T.Boolean{}, T.Chain{T.ProgressiveContainer{bc0, bc1, bc2}, b1}), W.false_true(left))
            case T.Boolean{} T.Chain{T.CompatibleUnion{bc0, bc1}, b1}:
              (left, right) = slots
              Empty.absurd(D.evidence(S.Slots{}, T.Boolean{}, T.Chain{T.CompatibleUnion{bc0, bc1}, b1}), W.false_true(left))
            case T.Boolean{} T.End{}:
              (left, right) = slots
              (S.Leaf{}, {==})
            case T.Boolean{} T.Repeat{b0}:
              (left, right) = slots
              Empty.absurd(D.evidence(S.Slots{}, T.Boolean{}, T.Repeat{b0}), W.false_true(left))
            case T.Boolean{} T.Named{b0, b1}:
              (left, right) = slots
              Empty.absurd(D.evidence(S.Slots{}, T.Boolean{}, T.Named{b0, b1}), W.false_true(left))
            case T.Boolean{} T.ProgressiveList{b0}:
              (left, right) = slots
              Empty.absurd(D.evidence(S.Slots{}, T.Boolean{}, T.ProgressiveList{b0}), W.false_true(left))
            case T.Boolean{} T.ProgressiveBits{}:
              (left, right) = slots
              Empty.absurd(D.evidence(S.Slots{}, T.Boolean{}, T.ProgressiveBits{}), W.false_true(left))
            case T.Boolean{} T.ProgressiveContainer{b0, b1, b2}:
              (left, right) = slots
              Empty.absurd(D.evidence(S.Slots{}, T.Boolean{}, T.ProgressiveContainer{b0, b1, b2}), W.false_true(left))
            case T.Boolean{} T.CompatibleUnion{b0, b1}:
              (left, right) = slots
              Empty.absurd(D.evidence(S.Slots{}, T.Boolean{}, T.CompatibleUnion{b0, b1}), W.false_true(left))
            case T.Unsigned{a0} T.Boolean{}:
              (left, right) = slots
              Empty.absurd(D.evidence(S.Slots{}, T.Unsigned{a0}, T.Boolean{}), W.false_true(left))
            case T.Unsigned{a0} T.Unsigned{b0}:
              (left, right) = slots
              Empty.absurd(D.evidence(S.Slots{}, T.Unsigned{a0}, T.Unsigned{b0}), W.false_true(left))
            case T.Unsigned{a0} T.ByteVector{b0}:
              (left, right) = slots
              Empty.absurd(D.evidence(S.Slots{}, T.Unsigned{a0}, T.ByteVector{b0}), W.false_true(left))
            case T.Unsigned{a0} T.ByteList{b0}:
              (left, right) = slots
              Empty.absurd(D.evidence(S.Slots{}, T.Unsigned{a0}, T.ByteList{b0}), W.false_true(left))
            case T.Unsigned{a0} T.BitVector{b0}:
              (left, right) = slots
              Empty.absurd(D.evidence(S.Slots{}, T.Unsigned{a0}, T.BitVector{b0}), W.false_true(left))
            case T.Unsigned{a0} T.BitList{b0}:
              (left, right) = slots
              Empty.absurd(D.evidence(S.Slots{}, T.Unsigned{a0}, T.BitList{b0}), W.false_true(left))
            case T.Unsigned{a0} T.Vector{b0, b1}:
              (left, right) = slots
              Empty.absurd(D.evidence(S.Slots{}, T.Unsigned{a0}, T.Vector{b0, b1}), W.false_true(left))
            case T.Unsigned{a0} T.ListOf{b0, b1}:
              (left, right) = slots
              Empty.absurd(D.evidence(S.Slots{}, T.Unsigned{a0}, T.ListOf{b0, b1}), W.false_true(left))
            case T.Unsigned{a0} T.Container{b0, b1}:
              (left, right) = slots
              Empty.absurd(D.evidence(S.Slots{}, T.Unsigned{a0}, T.Container{b0, b1}), W.false_true(left))
            case T.Unsigned{a0} T.Union{b0}:
              (left, right) = slots
              Empty.absurd(D.evidence(S.Slots{}, T.Unsigned{a0}, T.Union{b0}), W.false_true(left))
            case T.Unsigned{a0} T.Null{}:
              (left, right) = slots
              Empty.absurd(D.evidence(S.Slots{}, T.Unsigned{a0}, T.Null{}), W.false_true(left))
            case T.Unsigned{a0} T.Chain{T.Boolean{}, b1}:
              (left, right) = slots
              Empty.absurd(D.evidence(S.Slots{}, T.Unsigned{a0}, T.Chain{T.Boolean{}, b1}), W.false_true(left))
            case T.Unsigned{a0} T.Chain{T.Unsigned{bc0}, b1}:
              (left, right) = slots
              Empty.absurd(D.evidence(S.Slots{}, T.Unsigned{a0}, T.Chain{T.Unsigned{bc0}, b1}), W.false_true(left))
            case T.Unsigned{a0} T.Chain{T.ByteVector{bc0}, b1}:
              (left, right) = slots
              Empty.absurd(D.evidence(S.Slots{}, T.Unsigned{a0}, T.Chain{T.ByteVector{bc0}, b1}), W.false_true(left))
            case T.Unsigned{a0} T.Chain{T.ByteList{bc0}, b1}:
              (left, right) = slots
              Empty.absurd(D.evidence(S.Slots{}, T.Unsigned{a0}, T.Chain{T.ByteList{bc0}, b1}), W.false_true(left))
            case T.Unsigned{a0} T.Chain{T.BitVector{bc0}, b1}:
              (left, right) = slots
              Empty.absurd(D.evidence(S.Slots{}, T.Unsigned{a0}, T.Chain{T.BitVector{bc0}, b1}), W.false_true(left))
            case T.Unsigned{a0} T.Chain{T.BitList{bc0}, b1}:
              (left, right) = slots
              Empty.absurd(D.evidence(S.Slots{}, T.Unsigned{a0}, T.Chain{T.BitList{bc0}, b1}), W.false_true(left))
            case T.Unsigned{a0} T.Chain{T.Vector{bc0, bc1}, b1}:
              (left, right) = slots
              Empty.absurd(D.evidence(S.Slots{}, T.Unsigned{a0}, T.Chain{T.Vector{bc0, bc1}, b1}), W.false_true(left))
            case T.Unsigned{a0} T.Chain{T.ListOf{bc0, bc1}, b1}:
              (left, right) = slots
              Empty.absurd(D.evidence(S.Slots{}, T.Unsigned{a0}, T.Chain{T.ListOf{bc0, bc1}, b1}), W.false_true(left))
            case T.Unsigned{a0} T.Chain{T.Container{bc0, bc1}, b1}:
              (left, right) = slots
              Empty.absurd(D.evidence(S.Slots{}, T.Unsigned{a0}, T.Chain{T.Container{bc0, bc1}, b1}), W.false_true(left))
            case T.Unsigned{a0} T.Chain{T.Union{bc0}, b1}:
              (left, right) = slots
              Empty.absurd(D.evidence(S.Slots{}, T.Unsigned{a0}, T.Chain{T.Union{bc0}, b1}), W.false_true(left))
            case T.Unsigned{a0} T.Chain{T.Null{}, b1}:
              (left, right) = slots
              Empty.absurd(D.evidence(S.Slots{}, T.Unsigned{a0}, T.Chain{T.Null{}, b1}), W.false_true(left))
            case T.Unsigned{a0} T.Chain{T.Chain{bc0, bc1}, b1}:
              (left, right) = slots
              Empty.absurd(D.evidence(S.Slots{}, T.Unsigned{a0}, T.Chain{T.Chain{bc0, bc1}, b1}), W.false_true(left))
            case T.Unsigned{a0} T.Chain{T.End{}, b1}:
              (left, right) = slots
              Empty.absurd(D.evidence(S.Slots{}, T.Unsigned{a0}, T.Chain{T.End{}, b1}), W.false_true(left))
            case T.Unsigned{a0} T.Chain{T.Repeat{bc0}, b1}:
              (left, right) = slots
              Empty.absurd(D.evidence(S.Slots{}, T.Unsigned{a0}, T.Chain{T.Repeat{bc0}, b1}), W.false_true(left))
            case T.Unsigned{a0} T.Chain{T.Named{bc0, bc1}, b1}:
              (left, right) = slots
              Empty.absurd(D.evidence(S.Slots{}, T.Unsigned{a0}, T.Chain{T.Named{bc0, bc1}, b1}), W.false_true(left))
            case T.Unsigned{a0} T.Chain{T.ProgressiveList{bc0}, b1}:
              (left, right) = slots
              Empty.absurd(D.evidence(S.Slots{}, T.Unsigned{a0}, T.Chain{T.ProgressiveList{bc0}, b1}), W.false_true(left))
            case T.Unsigned{a0} T.Chain{T.ProgressiveBits{}, b1}:
              (left, right) = slots
              Empty.absurd(D.evidence(S.Slots{}, T.Unsigned{a0}, T.Chain{T.ProgressiveBits{}, b1}), W.false_true(left))
            case T.Unsigned{a0} T.Chain{T.ProgressiveContainer{bc0, bc1, bc2}, b1}:
              (left, right) = slots
              Empty.absurd(D.evidence(S.Slots{}, T.Unsigned{a0}, T.Chain{T.ProgressiveContainer{bc0, bc1, bc2}, b1}), W.false_true(left))
            case T.Unsigned{a0} T.Chain{T.CompatibleUnion{bc0, bc1}, b1}:
              (left, right) = slots
              Empty.absurd(D.evidence(S.Slots{}, T.Unsigned{a0}, T.Chain{T.CompatibleUnion{bc0, bc1}, b1}), W.false_true(left))
            case T.Unsigned{a0} T.End{}:
              (left, right) = slots
              (S.Leaf{}, {==})
            case T.Unsigned{a0} T.Repeat{b0}:
              (left, right) = slots
              Empty.absurd(D.evidence(S.Slots{}, T.Unsigned{a0}, T.Repeat{b0}), W.false_true(left))
            case T.Unsigned{a0} T.Named{b0, b1}:
              (left, right) = slots
              Empty.absurd(D.evidence(S.Slots{}, T.Unsigned{a0}, T.Named{b0, b1}), W.false_true(left))
            case T.Unsigned{a0} T.ProgressiveList{b0}:
              (left, right) = slots
