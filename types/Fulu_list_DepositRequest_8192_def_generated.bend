  l8192_DepositRequest_croot_fin(hl, n, d, arr, nodes, l8192_DepositRequest_pad_go(hl, Nat.sub(13n, d), O.nat_u32(d), r, (h, D.zconst(d))))

def l8192_DepositRequest_croot_read(+hl: Nat, +n: U32, +d: Nat, h: B.Buf, arr: Array<FuluDepositRequest_d.DepositRequest>, pr: Array<D.Digest> & D.Digest) -> B.Buf & (l8192_DepositRequest_Cached & D.Digest):
  (nodes, +r) = pr
  l8192_DepositRequest_croot_pad(hl, n, d, arr, nodes, h, r)

def l8192_DepositRequest_croot_top(+hl: Nat, +n: U32, +d: Nat, ts: l8192_DepositRequest_TS) -> B.Buf & (l8192_DepositRequest_Cached & D.Digest):
  match ts:
    case l8192_DepositRequest_TS{h, arr, nodes}: l8192_DepositRequest_croot_read(hl, n, d, h, arr, Array.get(D.Digest, nodes, 1))

def l8192_DepositRequest_cached_root(+hl: Nat, h: B.Buf, c: l8192_DepositRequest_Cached, +seg: U32) -> B.Buf & (l8192_DepositRequest_Cached & D.Digest):
  match c:
    case l8192_DepositRequest_Cached{arr, +n, +d, nodes, +lo, +hi}:
      l8192_DepositRequest_croot_top(hl, n, d, l8192_DepositRequest_sweep_pick(hl, U32.is_le(lo, hi), d, lo, hi, n, seg, l8192_DepositRequest_TS{h, arr, nodes}))
