    case True{}: O.encoded(bitvector_8_encode(o))
    case False{}: O.refused()

def bitvector_8_serialize(+o: bitvector_8_d.Bitvector8) -> O.Encoded: bitvector_8_ser_pick(bv8_valid(o), o)
