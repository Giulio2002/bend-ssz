  match o:
    case ExecutionPayload{g0, g1, +g2}: ExecutionPayload_g0_dump(g0, ExecutionPayload_g1_dump(g1, ExecutionPayload_g2_dump(g2, t)))

def ExecutionPayload_bx_wrap(v: ExecutionPayload) -> O.Boxed<ExecutionPayload>: O.BSome{v, O.BNone{}}

def ExecutionPayload_bx_default() -> O.Boxed<ExecutionPayload>: ExecutionPayload_bx_wrap(ExecutionPayload_default())

def ExecutionPayload_bx_unbox(o: O.Boxed<ExecutionPayload>) -> ExecutionPayload:
  match o:
    case O.BSome{v, rest}: v
    case O.BNone{}: ExecutionPayload_default()

def ExecutionPayload_bx_size_back(pair: ExecutionPayload & U32) -> O.Boxed<ExecutionPayload> & U32:
  (v, +n) = pair
  (ExecutionPayload_bx_wrap(v), n)

def ExecutionPayload_bx_force(o: O.Boxed<ExecutionPayload>) -> O.Boxed<ExecutionPayload> & U32:
  match o:
    case O.BSome{v, rest}: ExecutionPayload_bx_size_back(ExecutionPayload_force(v))
    case O.BNone{}: (ExecutionPayload_bx_default(), 0)

def ExecutionPayload_bx_dump(o: O.Boxed<ExecutionPayload>, t: +List<U32>) -> +List<U32>:
  match o:
    case O.BSome{v, rest}: ExecutionPayload_dump(v, t)
    case O.BNone{}: ExecutionPayload_dump(ExecutionPayload_default(), t)

def ExecutionPayload_fz0_fin(ok: Bool, pr: ExecutionPayload & O.Words) -> ExecutionPayload & Bool:
  (obj, old) = pr
  (obj, ok)

def ExecutionPayload_fz0_back(obj: ExecutionPayload, res: O.Words & Bool) -> ExecutionPayload & Bool:
  (c, ok) = res
  ExecutionPayload_fz0_fin(ok, ExecutionPayload_swap_logs_bloom(obj, c))

def ExecutionPayload_fz0_in(+a: U32, +b: U32, pr: ExecutionPayload & O.Words) -> ExecutionPayload & Bool:
  (obj, c) = pr
  ExecutionPayload_fz0_back(obj, Fulu_bytevec_256_d.b256_set(c, a, (b .&. 255 : U32)))

def ExecutionPayload_fz0(o: ExecutionPayload, +a: U32, +b: U32) -> ExecutionPayload & Bool:
  ExecutionPayload_fz0_in(a, b, ExecutionPayload_swap_logs_bloom(o, Fulu_bytevec_256_d.b256_default()))

def ExecutionPayload_fz1_fin(ok: Bool, pr: ExecutionPayload & O.Words) -> ExecutionPayload & Bool:
  (obj, old) = pr
  (obj, ok)

def ExecutionPayload_fz1_back(obj: ExecutionPayload, res: O.Words & Bool) -> ExecutionPayload & Bool:
  (c, ok) = res
  ExecutionPayload_fz1_fin(ok, ExecutionPayload_swap_extra_data(obj, c))

def ExecutionPayload_fz1_in(+a: U32, +b: U32, pr: ExecutionPayload & O.Words) -> ExecutionPayload & Bool:
  (obj, c) = pr
  ExecutionPayload_fz1_back(obj, Fulu_bytelist_32_d.bl32_set(c, a, (b .&. 255 : U32)))

def ExecutionPayload_fz1(o: ExecutionPayload, +a: U32, +b: U32) -> ExecutionPayload & Bool:
  ExecutionPayload_fz1_in(a, b, ExecutionPayload_swap_extra_data(o, Fulu_bytelist_32_d.bl32_default()))

def ExecutionPayload_fzc0(o: ExecutionPayload, +sel: U32, +a: U32, +b: U32) -> ExecutionPayload & Bool:
  match sel:
    case 0: ExecutionPayload_fz0(o, a, b)
    case _: ExecutionPayload_fz1(o, a, b)

def ExecutionPayload_fuzz_hi(+c: U32, o: ExecutionPayload, +sel: U32, +a: U32, +b: U32) -> ExecutionPayload & Bool:
  match c:
    case _: ExecutionPayload_fzc0(o, sel, a, b)

def ExecutionPayload_fuzz(o: ExecutionPayload, +sel: U32, +a: U32, +b: U32) -> ExecutionPayload & Bool:
  ExecutionPayload_fuzz_hi(U32.shrn(sel, 3n), o, sel, a, b)

def ExecutionPayload_g2_valid(o: ExecutionPayload_g2) -> Bool:
  match o:
    case ExecutionPayload_g2{+excess_blob_gas}: True{}
