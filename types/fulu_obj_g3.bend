    case A_SignedContributionAndProof{v}: FuluSignedContributionAndProof_d.SignedContributionAndProof_dump(v, t)
    case A_SyncCommitteeMessage{+v}: FuluSyncCommitteeMessage_d.SyncCommitteeMessage_dump(v, t)
    case A_Eth1Block{+v}: FuluEth1Block_d.Eth1Block_dump(v, t)
    case A_BeaconBlockHeader{+v}: FuluBeaconBlockHeader_d.BeaconBlockHeader_dump(v, t)
    case A_SignedBeaconBlockHeader{+v}: FuluSignedBeaconBlockHeader_d.SignedBeaconBlockHeader_dump(v, t)
    case A_ProposerSlashing{v}: FuluProposerSlashing_d.ProposerSlashing_dump(v, t)
    case A_HistoricalBatch{v}: FuluHistoricalBatch_d.HistoricalBatch_dump(v, t)
    case A_Eth1Data{+v}: FuluEth1Data_d.Eth1Data_dump(v, t)
    case A_Checkpoint{+v}: FuluCheckpoint_d.Checkpoint_dump(v, t)
    case A_AttestationData{+v}: FuluAttestationData_d.AttestationData_dump(v, t)
    case A_SingleAttestation{+v}: FuluSingleAttestation_d.SingleAttestation_dump(v, t)
    case A_boxed{v}: dump(v, t)
def force_fin(buf: B.Buf, pair: Any & U32) -> B.Buf & (U32 & U32):
  (a, +x) = pair
  (buf, (x, 1))
def force_m(m: Maybe<&1, Any>, buf: B.Buf) -> B.Buf & (U32 & U32):
  match m:
    case None{}: (buf, (0, 0))
    case Some{a}: force_fin(buf, force(a))
def force_p(pair: B.Buf & Maybe<&1, Any>) -> B.Buf & (U32 & U32):
  (buf, m) = pair
  force_m(m, buf)
def decode_force(+i: U32, buf: B.Buf, +size: U32) -> B.Buf & (U32 & U32):
  force_p(decode(i, buf, size))
