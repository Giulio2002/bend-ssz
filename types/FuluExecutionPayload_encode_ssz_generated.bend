  (out, r) = pair
  (o, m) = r
  ExecutionPayload_senc_out(n, out, o, m)

def ExecutionPayload_senc_go(bad: Bool, +n: U32, o: FuluExecutionPayload_d.ExecutionPayload) -> FuluExecutionPayload_d.ExecutionPayload & O.Encoded:
  match bad:
    case True{}: (o, O.refused())
    case False{}: ExecutionPayload_senc_put(n, ExecutionPayload_putk(O.out_new(n), 0, o))

def ExecutionPayload_senc_sized(pair: FuluExecutionPayload_d.ExecutionPayload & U32) -> FuluExecutionPayload_d.ExecutionPayload & O.Encoded:
  (o, +n) = pair
  ExecutionPayload_senc_go(O.is_poisoned(n), n, o)

def ExecutionPayload_serialize(o: FuluExecutionPayload_d.ExecutionPayload) -> FuluExecutionPayload_d.ExecutionPayload & O.Encoded: ExecutionPayload_senc_sized(ExecutionPayload_size(o))
