    case A_SignedAggregateAndProof{v}: FuluSignedAggregateAndProof_d.SignedAggregateAndProof_dump(v, t)
    case A_PendingAttestation{v}: FuluPendingAttestation_d.PendingAttestation_dump(v, t)
    case A_IndexedAttestation{v}: FuluIndexedAttestation_d.IndexedAttestation_dump(v, t)
    case A_AttesterSlashing{v}: FuluAttesterSlashing_d.AttesterSlashing_dump(v, t)
    case A_ForkData{+v}: FuluForkData_d.ForkData_dump(v, t)
    case A_ForkDigest{+v}: FuluBytes4_d.b4_dump(v, t)
    case A_Domain{+v}: FuluBytes32_d.b32_dump(v, t)
    case A_SigningData{+v}: FuluSigningData_d.SigningData_dump(v, t)
    case A_BLSPubkey{+v}: FuluBytes48_d.b48_dump(v, t)
    case A_DepositRequest{+v}: FuluDepositRequest_d.DepositRequest_dump(v, t)
    case A_boxed{v}: dump(v, t)
def force_fin(buf: B.Buf, pair: Any & U32) -> B.Buf & (U32 & U32):
  (a, +x) = pair
  (buf, (x, 1))
def force_m(m: Maybe<&1, Any>, buf: B.Buf) -> B.Buf & (U32 & U32):
  match m:
    case None{}: (buf, (0, 0))
    case Some{a}: force_fin(buf, force(a))
def force_p(pair: B.Buf & Maybe<&1, Any>) -> B.Buf & (U32 & U32):
  (buf, m) = pair
  force_m(m, buf)
def decode_force(+i: U32, buf: B.Buf, +size: U32) -> B.Buf & (U32 & U32):
  force_p(decode(i, buf, size))
