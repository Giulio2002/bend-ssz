# GENERATED by generate (codegen: runtime_refs): the typed object runtime (generic), split per name and operation.
# proglist_bool: its decoder, validator, reader and builder

def pl_bool_read(buf: B.Buf, +off: U32, +len: U32) -> B.Buf & O.Words: O.copy_in(buf, off, len)

def pl_bool_ck(+k: Nat, +i: U32, +off: U32, +acc: Bool, pair: B.Buf & Bool) -> B.Buf & Bool:
  match k:
    case 0n: O.and_pair(acc, pair)
    case 1n+q:
      (buf, ok) = pair
      pl_bool_ck(q, (i + 1 : U32), off, Bool.and(acc, ok), O.ok_bool(buf, (off + (i + 1 : U32) * 1 : U32)))

def pl_bool_ok_nz(empty: Bool, buf: B.Buf, +off: U32, +n: U32) -> B.Buf & Bool:
  match empty:
    case True{}: (buf, True{})
    case False{}: pl_bool_ck(U32.to_nat((n - 1 : U32)), 0, off, True{}, O.ok_bool(buf, off))

def pl_bool_ok_n(buf: B.Buf, +off: U32, +n: U32) -> B.Buf & Bool:
  pl_bool_ok_nz(U32.is_eq(n, 0), buf, off, n)

def pl_bool_ok_len(ok: Bool, buf: B.Buf, +off: U32, +len: U32) -> B.Buf & Bool:
  match ok:
    case True{}: pl_bool_ok_n(buf, off, U32.div(len, 1))
    case False{}: (buf, False{})

def pl_bool_ok(buf: B.Buf, +off: U32, +len: U32) -> B.Buf & Bool: pl_bool_ok_len(Bool.and(U32.is_eq(len, (U32.div(len, 1) * 1 : U32)), True{}), buf, off, len)

def proglist_bool_some(pair: B.Buf & O.Words) -> B.Buf & Maybe<&1, O.Words>:
  (buf, v) = pair
  (buf, Some{v})

def proglist_bool_built(+size: U32, pair: B.Buf & Bool) -> B.Buf & Maybe<&1, O.Words>:
  (buf, ok) = pair
  match ok:
    case True{}: proglist_bool_some(pl_bool_read(buf, 0, size))
    case False{}: (buf, None{})

def proglist_bool_decode(buf: B.Buf, +size: U32) -> B.Buf & Maybe<&1, O.Words>:
  proglist_bool_built(size, pl_bool_ok(buf, 0, size))

def proglist_bool_build(buf: B.Buf, +size: U32) -> B.Buf & O.Words: pl_bool_read(buf, 0, size)
