  MatrixEntry_rd3(off, len, cell, kzg_proof, column_index, u64_read(buf, (off + 2104 : U32), 8))

def MatrixEntry_rd1(+off: U32, +len: U32, cell: O.Words, pair: B.Buf & Bytes48) -> B.Buf & MatrixEntry:
  (buf, +kzg_proof) = pair
  MatrixEntry_rd2(off, len, cell, kzg_proof, u64_read(buf, (off + 2096 : U32), 8))

def MatrixEntry_rd0(+off: U32, +len: U32, pair: B.Buf & O.Words) -> B.Buf & MatrixEntry:
