def v64_u64_pk_ok(pair: Array<U32> & O.Words) -> Array<U32> & (O.Words & U32):
  (out, o) = pair
  (out, (o, 0))

def v64_u64_pk(out: Array<U32>, +pos: U32, pair: O.Words & Bool) -> Array<U32> & (O.Words & U32):
  (o, ok) = pair
  match ok:
    case True{}: v64_u64_pk_ok(v64_u64_put(out, pos, o))
    case False{}: (out, (o, 2147483648))

def v64_u64_valid(o: O.Words) -> O.Words & Bool: O.words_ok(o, 512, 512, False{}, 8)

def v64_u64_putk(out: Array<U32>, +pos: U32, o: O.Words) -> Array<U32> & (O.Words & U32): v64_u64_pk(out, pos, v64_u64_valid(o))

