  match o:
    case BLSToExecutionChange{+validator_index, +from_bls_pubkey, +to_execution_address}: (BLSToExecutionChange{validator_index, from_bls_pubkey, to_execution_address}, validator_index)

def BLSToExecutionChange_set_validator_index(o: BLSToExecutionChange, +v: O.U64) -> BLSToExecutionChange:
  match o:
    case BLSToExecutionChange{+validator_index, +from_bls_pubkey, +to_execution_address}: BLSToExecutionChange{v, from_bls_pubkey, to_execution_address}

def BLSToExecutionChange_get_from_bls_pubkey(o: BLSToExecutionChange) -> BLSToExecutionChange & Bytes48:
