    case HistoricalBatch{block_roots, state_roots}: HistoricalBatch{block_roots, v}

def HistoricalBatch_fo1(block_roots: O.Words, +acc: U32, pair: O.Words & U32) -> HistoricalBatch & U32:
  (state_roots, +x) = pair
  (HistoricalBatch{block_roots, state_roots}, (acc .^. x : U32))

def HistoricalBatch_fo0(state_roots: O.Words, +acc: U32, pair: O.Words & U32) -> HistoricalBatch & U32:
  (block_roots, +x) = pair
  HistoricalBatch_fo1(block_roots, (acc .^. x : U32), v8192_b32_force(state_roots))

def HistoricalBatch_force(o: HistoricalBatch) -> HistoricalBatch & U32:
  match o:
    case HistoricalBatch{block_roots, state_roots}: HistoricalBatch_fo0(state_roots, (0 : U32), v8192_b32_force(block_roots))

