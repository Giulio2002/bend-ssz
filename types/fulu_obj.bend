def ExecutionRequests_sz2(deposits: l8192_DepositRequest_Seq, withdrawals: l16_WithdrawalRequest_Seq, +acc: U32, pair: l2_ConsolidationRequest_Seq & U32) -> ExecutionRequests & U32:
  (consolidations, +m) = pair
  (ExecutionRequests{deposits, withdrawals, consolidations}, O.padd(acc, m))

