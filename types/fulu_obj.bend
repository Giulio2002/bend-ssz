    case Attestation{aggregation_bits, +data, +signature, +committee_bits}: (Attestation{aggregation_bits, data, signature, committee_bits}, data)

def Attestation_set_data(o: Attestation, +v: AttestationData) -> Attestation:
  match o:
    case Attestation{aggregation_bits, +data, +signature, +committee_bits}: Attestation{aggregation_bits, v, signature, committee_bits}

def Attestation_get_signature(o: Attestation) -> Attestation & Bytes96:
  match o:
    case Attestation{aggregation_bits, +data, +signature, +committee_bits}: (Attestation{aggregation_bits, data, signature, committee_bits}, signature)

def Attestation_set_signature(o: Attestation, +v: Bytes96) -> Attestation:
