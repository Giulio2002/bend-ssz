def ExecutionRequests_fo2(deposits: l8192_DepositRequest_Seq, withdrawals: l16_WithdrawalRequest_Seq, +acc: U32, pair: l2_ConsolidationRequest_Seq & U32) -> ExecutionRequests & U32:
  (consolidations, +x) = pair
  (ExecutionRequests{deposits, withdrawals, consolidations}, (acc .^. x : U32))

def ExecutionRequests_fo1(deposits: l8192_DepositRequest_Seq, consolidations: l2_ConsolidationRequest_Seq, +acc: U32, pair: l16_WithdrawalRequest_Seq & U32) -> ExecutionRequests & U32:
  (withdrawals, +x) = pair
