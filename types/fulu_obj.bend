def PendingAttestation_get_proposer_index(o: PendingAttestation) -> PendingAttestation & O.U64:
  match o:
    case PendingAttestation{aggregation_bits, +data, +inclusion_delay, +proposer_index}: (PendingAttestation{aggregation_bits, data, inclusion_delay, proposer_index}, proposer_index)

def PendingAttestation_set_proposer_index(o: PendingAttestation, +v: O.U64) -> PendingAttestation:
