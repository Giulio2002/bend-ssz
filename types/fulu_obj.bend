  PendingAttestation_c1(ok, buf, off, len, o0)

def PendingAttestation_c0(ok: Bool, buf: B.Buf, +off: U32, +len: U32, +o0: U32) -> B.Buf & Bool:
  match ok:
    case True{}: PendingAttestation_v1(off, len, o0, bits2048_ok(buf, (off + o0 : U32), (len - o0 : U32)))
    case False{}: (buf, False{})

def PendingAttestation_v0(+off: U32, +len: U32, pair: B.Buf & U32) -> B.Buf & Bool:
  (buf, +o0) = pair
  PendingAttestation_c0(U32.is_eq(o0, 148), buf, off, len, o0)

def PendingAttestation_ok_len(ok: Bool, buf: B.Buf, +off: U32, +len: U32) -> B.Buf & Bool:
  match ok:
    case True{}: PendingAttestation_v0(off, len, B.read32(buf, (off + 0 : U32)))
    case False{}: (buf, False{})

def PendingAttestation_ok(buf: B.Buf, +off: U32, +len: U32) -> B.Buf & Bool: PendingAttestation_ok_len(U32.is_le(148, len), buf, off, len)

def l131072_u64_default() -> O.Words: O.words_new(0)

def l131072_u64_read(buf: B.Buf, +off: U32, +len: U32) -> B.Buf & O.Words: O.copy_in(buf, off, len)

def l131072_u64_size(o: O.Words) -> O.Words & U32: O.words_sizek(o)

def l131072_u64_put(out: Array<U32>, +pos: U32, o: O.Words) -> Array<U32> & O.Words: O.put_words(out, pos, o)

def l131072_u64_putn(out: Array<U32>, +pos: U32, o: O.Words) -> Array<U32> & (O.Words & U32): O.put_words_n(out, pos, o)

def l131072_u64_root(+hl: Nat, h: B.Buf, o: O.Words, +seg: U32) -> B.Buf & (O.Words & D.Digest): O.mix_count(hl, 3n, O.words_root(hl, h, o, 15, seg))

def l131072_u64_force(o: O.Words) -> O.Words & U32: O.words_len(o)

def l131072_u64_pk(out: Array<U32>, +pos: U32, pair: O.Words & Bool) -> Array<U32> & (O.Words & U32):
  (o, ok) = pair
  match ok:
    case True{}: l131072_u64_putn(out, pos, o)
    case False{}: (out, (o, 2147483648))

def l131072_u64_valid(o: O.Words) -> O.Words & Bool: O.words_ok(o, 0, 1048576, False{}, 8)

def l131072_u64_putk(out: Array<U32>, +pos: U32, o: O.Words) -> Array<U32> & (O.Words & U32): l131072_u64_pk(out, pos, l131072_u64_valid(o))

def l131072_u64_dump(o: O.Words, t: +List<U32>) -> +List<U32>: O.dump_words_n(o, t)

def l131072_u64_ok(buf: B.Buf, +off: U32, +len: U32) -> B.Buf & Bool: (buf, Bool.and(U32.is_eq(len, (U32.div(len, 8) * 8 : U32)), U32.is_le(U32.div(len, 8), 131072)))

def l131072_u64_len_of(pair: O.Words & U32) -> O.Words & U32:
  (o, +n) = pair
  (o, U32.div(n, 8))

def l131072_u64_len(o: O.Words) -> O.Words & U32: l131072_u64_len_of(O.words_len(o))

def l131072_u64_at(o: O.Words, +i: U32) -> O.Words & O.U64: O.words_u64_at(o, (i * 8 : U32))

def l131072_u64_some(pair: O.Words & O.U64) -> O.Words & Maybe<&1, O.U64>:
  (o, +v) = pair
  (o, Some{v})

def l131072_u64_get_in(inside: Bool, o: O.Words, +i: U32) -> O.Words & Maybe<&1, O.U64>:
  match inside:
    case True{}: l131072_u64_some(l131072_u64_at(o, i))
    case False{}: (o, None{})

def l131072_u64_get_n(+i: U32, pair: O.Words & U32) -> O.Words & Maybe<&1, O.U64>:
  (o, +n) = pair
  l131072_u64_get_in(U32.is_lt(i, n), o, i)

def l131072_u64_get(o: O.Words, +i: U32) -> O.Words & Maybe<&1, O.U64>: l131072_u64_get_n(i, l131072_u64_len(o))

def l131072_u64_put_at(ok: Bool, o: O.Words, +i: U32, +v: O.U64) -> O.Words & Bool:
  match ok:
    case True{}: (O.words_write_u64(o, (i * 8 : U32), v), True{})
    case False{}: (o, False{})

def l131072_u64_set_n(+i: U32, +v: O.U64, pair: O.Words & U32) -> O.Words & Bool:
  (o, +n) = pair
  l131072_u64_put_at(U32.is_lt(i, n), o, i, v)

def l131072_u64_set(o: O.Words, +i: U32, +v: O.U64) -> O.Words & Bool: l131072_u64_set_n(i, v, l131072_u64_len(o))

def l131072_u64_grow(ok: Bool, o: O.Words, +n: U32, +v: O.U64) -> O.Words & Bool:
  match ok:
    case True{}: l131072_u64_put_at(True{}, O.words_resize(O.words_fit(o, ((n + 1 : U32) * 8 : U32)), ((n + 1 : U32) * 8 : U32)), n, v)
    case False{}: (o, False{})

def l131072_u64_app_n(+v: O.U64, pair: O.Words & U32) -> O.Words & Bool:
  (o, +n) = pair
  l131072_u64_grow(U32.is_le((n + 1 : U32), 131072), o, n, v)

def l131072_u64_append(o: O.Words, +v: O.U64) -> O.Words & Bool: l131072_u64_app_n(v, l131072_u64_len(o))

type IndexedAttestation is Type:
  IndexedAttestation{attesting_indices: O.Words, data: AttestationData, signature: Bytes96}

def IndexedAttestation_default() -> IndexedAttestation: IndexedAttestation{l131072_u64_default(), AttestationData_default(), b96_default()}

def IndexedAttestation_rd3(+off: U32, +len: U32, +o_attesting_indices: U32, attesting_indices: O.Words, +data: AttestationData, pair: B.Buf & Bytes96) -> B.Buf & IndexedAttestation:
  (buf, +signature) = pair
  (buf, IndexedAttestation{attesting_indices, data, signature})

def IndexedAttestation_rd2(+off: U32, +len: U32, +o_attesting_indices: U32, attesting_indices: O.Words, pair: B.Buf & AttestationData) -> B.Buf & IndexedAttestation:
  (buf, +data) = pair
  IndexedAttestation_rd3(off, len, o_attesting_indices, attesting_indices, data, b96_read(buf, (off + 132 : U32), 96))

def IndexedAttestation_rd1(+off: U32, +len: U32, +o_attesting_indices: U32, pair: B.Buf & O.Words) -> B.Buf & IndexedAttestation:
