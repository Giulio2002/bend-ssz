type Eth1Data is Data:
  Eth1Data{deposit_root: Bytes32, deposit_count: O.U64, block_hash: Bytes32}

def Eth1Data_default() -> Eth1Data: Eth1Data{b32_default(), u64_default(), b32_default()}

def Eth1Data_rd2(+off: U32, +len: U32, +deposit_root: Bytes32, +deposit_count: O.U64, pair: B.Buf & Bytes32) -> B.Buf & Eth1Data:
  (buf, +block_hash) = pair
  (buf, Eth1Data{deposit_root, deposit_count, block_hash})

def Eth1Data_rd1(+off: U32, +len: U32, +deposit_root: Bytes32, pair: B.Buf & O.U64) -> B.Buf & Eth1Data:
  (buf, +deposit_count) = pair
  Eth1Data_rd2(off, len, deposit_root, deposit_count, b32_read(buf, (off + 40 : U32), 32))

def Eth1Data_rd0(+off: U32, +len: U32, pair: B.Buf & Bytes32) -> B.Buf & Eth1Data:
  (buf, +deposit_root) = pair
  Eth1Data_rd1(off, len, deposit_root, u64_read(buf, (off + 32 : U32), 8))

def Eth1Data_read(buf: B.Buf, +off: U32, +len: U32) -> B.Buf & Eth1Data: Eth1Data_rd0(off, len, b32_read(buf, (off + 0 : U32), 32))

def Eth1Data_put(out: Array<U32>, +pos: U32, o: Eth1Data) -> Array<U32>:
