def SingleAttestation_get_attester_index(o: SingleAttestation) -> SingleAttestation & O.U64:
  match o:
    case SingleAttestation{+committee_index, +attester_index, +data, +signature}: (SingleAttestation{committee_index, attester_index, data, signature}, attester_index)

def SingleAttestation_set_attester_index(o: SingleAttestation, +v: O.U64) -> SingleAttestation:
