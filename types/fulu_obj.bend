def bv128_default() -> Bitvector128: Bitvector128{0, 0, 0, 0}

def bv128_r3(+off: U32, +w0: U32, +w1: U32, +w2: U32, pair: B.Buf & U32) -> B.Buf & Bitvector128:
  (buf, +x) = pair
  (buf, Bitvector128{w0, w1, w2, x})

def bv128_r2(+off: U32, +w0: U32, +w1: U32, pair: B.Buf & U32) -> B.Buf & Bitvector128:
  (buf, +x) = pair
  bv128_r3(off, w0, w1, x, B.read32(buf, (off + 12 : U32)))

def bv128_r1(+off: U32, +w0: U32, pair: B.Buf & U32) -> B.Buf & Bitvector128:
  (buf, +x) = pair
  bv128_r2(off, w0, x, B.read32(buf, (off + 8 : U32)))

def bv128_r0(+off: U32, pair: B.Buf & U32) -> B.Buf & Bitvector128:
  (buf, +x) = pair
  bv128_r1(off, x, B.read32(buf, (off + 4 : U32)))

def bv128_read(buf: B.Buf, +off: U32, +len: U32) -> B.Buf & Bitvector128: bv128_r0(off, B.read32(buf, off))

def bv128_pw0(out: Array<U32>, +q: U32, +w0: U32, +w1: U32, +w2: U32, +w3: U32) -> Array<U32>: Array.set(U32, Array.set(U32, Array.set(U32, Array.set(U32, out, (q + 0 : U32), w0), (q + 1 : U32), w1), (q + 2 : U32), w2), (q + 3 : U32), w3)

def bv128_pw1(out: Array<U32>, +q: U32, +w0: U32, +w1: U32, +w2: U32, +w3: U32) -> Array<U32>: O.or_skip(Array.set(U32, Array.set(U32, Array.set(U32, O.or_word(out, (q + 0 : U32), (w0 * 256 : U32)), (q + 1 : U32), ((w1 * 256 : U32) .|. U32.shrn(w0, 24n) : U32)), (q + 2 : U32), ((w2 * 256 : U32) .|. U32.shrn(w1, 24n) : U32)), (q + 3 : U32), ((w3 * 256 : U32) .|. U32.shrn(w2, 24n) : U32)), (q + 4 : U32), U32.shrn(w3, 24n))

def bv128_pw2(out: Array<U32>, +q: U32, +w0: U32, +w1: U32, +w2: U32, +w3: U32) -> Array<U32>: O.or_skip(Array.set(U32, Array.set(U32, Array.set(U32, O.or_word(out, (q + 0 : U32), (w0 * 65536 : U32)), (q + 1 : U32), ((w1 * 65536 : U32) .|. U32.shrn(w0, 16n) : U32)), (q + 2 : U32), ((w2 * 65536 : U32) .|. U32.shrn(w1, 16n) : U32)), (q + 3 : U32), ((w3 * 65536 : U32) .|. U32.shrn(w2, 16n) : U32)), (q + 4 : U32), U32.shrn(w3, 16n))

def bv128_pw3(out: Array<U32>, +q: U32, +w0: U32, +w1: U32, +w2: U32, +w3: U32) -> Array<U32>: O.or_skip(Array.set(U32, Array.set(U32, Array.set(U32, O.or_word(out, (q + 0 : U32), (w0 * 16777216 : U32)), (q + 1 : U32), ((w1 * 16777216 : U32) .|. U32.shrn(w0, 8n) : U32)), (q + 2 : U32), ((w2 * 16777216 : U32) .|. U32.shrn(w1, 8n) : U32)), (q + 3 : U32), ((w3 * 16777216 : U32) .|. U32.shrn(w2, 8n) : U32)), (q + 4 : U32), U32.shrn(w3, 8n))

def bv128_pwu(+s: U32, out: Array<U32>, +q: U32, +w0: U32, +w1: U32, +w2: U32, +w3: U32) -> Array<U32>:
  match s:
    case 1: bv128_pw1(out, q, w0, w1, w2, w3)
    case 2: bv128_pw2(out, q, w0, w1, w2, w3)
    case _: bv128_pw3(out, q, w0, w1, w2, w3)

def bv128_pwd(aligned: Bool, +s: U32, out: Array<U32>, +q: U32, +w0: U32, +w1: U32, +w2: U32, +w3: U32) -> Array<U32>:
  match aligned:
    case True{}: bv128_pw0(out, q, w0, w1, w2, w3)
    case False{}: bv128_pwu(s, out, q, w0, w1, w2, w3)

def bv128_put(out: Array<U32>, +pos: U32, o: Bitvector128) -> Array<U32>:
  match o:
    case Bitvector128{+w0, +w1, +w2, +w3}: bv128_pwd(U32.is_eq((pos .&. 3 : U32), 0), (pos .&. 3 : U32), out, U32.shrn(pos, 2n), w0, w1, w2, w3)

def bv128_root(+hl: Nat, h: B.Buf, o: Bitvector128, +seg: U32) -> B.Buf & D.Digest:
  match o:
    case Bitvector128{+w0, +w1, +w2, +w3}: (h, D.D{B.swap32(w0), B.swap32(w1), B.swap32(w2), B.swap32(w3), 0, 0, 0, 0})

def bv128_force(o: Bitvector128) -> U32:
  match o:
    case Bitvector128{+w0, +w1, +w2, +w3}: (((w0 .^. w1 : U32) .^. w2 : U32) .^. w3 : U32)

def bv128_dump(o: Bitvector128, t: +List<U32>) -> +List<U32>:
  match o:
    case Bitvector128{+w0, +w1, +w2, +w3}: O.dump_le(w0, 4, O.dump_le(w1, 4, O.dump_le(w2, 4, O.dump_le(w3, 4, t))))

def bv128_ok_at(buf: B.Buf, +off: U32) -> B.Buf & Bool: (buf, True{})

def bv128_ok_len(ok: Bool, buf: B.Buf, +off: U32) -> B.Buf & Bool:
  match ok:
    case True{}: bv128_ok_at(buf, off)
    case False{}: (buf, False{})

def bv128_ok(buf: B.Buf, +off: U32, +len: U32) -> B.Buf & Bool: bv128_ok_len(U32.is_eq(len, 16), buf, off)

def Bitvector128_wr3(+j: U32, +w0: U32, +w1: U32, +w2: U32, pair: O.Words & U32) -> O.Words & Bitvector128:
  (o, +x) = pair
  (o, Bitvector128{w0, w1, w2, x})

def Bitvector128_wr2(+j: U32, +w0: U32, +w1: U32, pair: O.Words & U32) -> O.Words & Bitvector128:
  (o, +x) = pair
  Bitvector128_wr3(j, w0, w1, x, O.words_word(o, (j + 3 : U32)))

def Bitvector128_wr1(+j: U32, +w0: U32, pair: O.Words & U32) -> O.Words & Bitvector128:
  (o, +x) = pair
  Bitvector128_wr2(j, w0, x, O.words_word(o, (j + 2 : U32)))

def Bitvector128_wr0(+j: U32, pair: O.Words & U32) -> O.Words & Bitvector128:
  (o, +x) = pair
  Bitvector128_wr1(j, x, O.words_word(o, (j + 1 : U32)))

def Bitvector128_of_words(o: O.Words, +p: U32) -> O.Words & Bitvector128: Bitvector128_wr0(U32.shrn(p, 2n), O.words_word(o, U32.shrn(p, 2n)))

def Bitvector128_into_words(o: O.Words, +p: U32, v: Bitvector128) -> O.Words:
  match v:
    case Bitvector128{+w0, +w1, +w2, +w3}: O.words_setw(O.words_setw(O.words_setw(O.words_setw(o, (U32.shrn(p, 2n) + 0 : U32), w0), (U32.shrn(p, 2n) + 1 : U32), w1), (U32.shrn(p, 2n) + 2 : U32), w2), (U32.shrn(p, 2n) + 3 : U32), w3)

def bv128_seed(+x: U32) -> Bitvector128: Bitvector128{(x + 0 : U32), (x + 1 : U32), (x + 2 : U32), (x + 3 : U32)}

