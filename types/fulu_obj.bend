# ---- Attestation ----

def Attestation_some(pair: B.Buf & Attestation) -> B.Buf & Maybe<&1, Attestation>:
  (buf, v) = pair
  (buf, Some{v})

def Attestation_built(+size: U32, pair: B.Buf & Bool) -> B.Buf & Maybe<&1, Attestation>:
  (buf, ok) = pair
  match ok:
    case True{}: Attestation_some(Attestation_read(buf, 0, size))
    case False{}: (buf, None{})

def Attestation_decode(buf: B.Buf, +size: U32) -> B.Buf & Maybe<&1, Attestation>:
  Attestation_built(size, Attestation_ok(buf, 0, size))

def Attestation_build(buf: B.Buf, +size: U32) -> B.Buf & Attestation: Attestation_read(buf, 0, size)

def Attestation_enc_out(+n: U32, out: Array<U32>, o: Attestation, +m: U32) -> Attestation & B.Buf:
  (o, O.out_done(n, out))

def Attestation_enc_put(+n: U32, pair: Array<U32> & (Attestation & U32)) -> Attestation & B.Buf:
  (out, r) = pair
  (o, m) = r
  Attestation_enc_out(n, out, o, m)

def Attestation_enc_sized(pair: Attestation & U32) -> Attestation & B.Buf:
  (o, +n) = pair
  Attestation_enc_put(n, Attestation_putn(O.out_new(n), 0, o))

def Attestation_encode(o: Attestation) -> Attestation & B.Buf: Attestation_enc_sized(Attestation_size(o))

def Attestation_hash_tree_root(h: B.Buf, o: Attestation) -> B.Buf & (Attestation & D.Digest): Attestation_root(64n, h, o, 0)

def Attestation_fz0_fin(ok: Bool, pr: Attestation & O.Bits) -> Attestation & Bool:
  (obj, old) = pr
  (obj, ok)

def Attestation_fz0_back(obj: Attestation, res: O.Bits & Bool) -> Attestation & Bool:
  (c, ok) = res
  Attestation_fz0_fin(ok, Attestation_swap_aggregation_bits(obj, c))

def Attestation_fz0_in(+a: U32, +b: U32, pr: Attestation & O.Bits) -> Attestation & Bool:
  (obj, c) = pr
  Attestation_fz0_back(obj, bits131072_set(c, a, U32.is_eq((b .&. 1 : U32), 1)))

def Attestation_fz0(o: Attestation, +a: U32, +b: U32) -> Attestation & Bool:
  Attestation_fz0_in(a, b, Attestation_swap_aggregation_bits(o, bits131072_default()))

def Attestation_fz1_fin(ok: Bool, pr: Attestation & O.Bits) -> Attestation & Bool:
  (obj, old) = pr
  (obj, ok)

def Attestation_fz1_back(obj: Attestation, res: O.Bits & Bool) -> Attestation & Bool:
  (c, ok) = res
  Attestation_fz1_fin(ok, Attestation_swap_aggregation_bits(obj, c))

def Attestation_fz1_in(+a: U32, +b: U32, pr: Attestation & O.Bits) -> Attestation & Bool:
  (obj, c) = pr
  Attestation_fz1_back(obj, bits131072_append(c, U32.is_eq((b .&. 1 : U32), 1)))

def Attestation_fz1(o: Attestation, +a: U32, +b: U32) -> Attestation & Bool:
  Attestation_fz1_in(a, b, Attestation_swap_aggregation_bits(o, bits131072_default()))

def Attestation_fz2(o: Attestation, +a: U32, +b: U32) -> Attestation & Bool:
  (Attestation_set_data(o, AttestationData_seed(b)), True{})

def Attestation_fz3(o: Attestation, +a: U32, +b: U32) -> Attestation & Bool:
  (Attestation_set_signature(o, b96_seed(b)), True{})

def Attestation_fz4(o: Attestation, +a: U32, +b: U32) -> Attestation & Bool:
  (Attestation_set_committee_bits(o, bv64_seed(b)), True{})

def Attestation_fzc0(o: Attestation, +sel: U32, +a: U32, +b: U32) -> Attestation & Bool:
  match sel:
    case 0: Attestation_fz0(o, a, b)
    case 1: Attestation_fz1(o, a, b)
    case 2: Attestation_fz2(o, a, b)
    case 3: Attestation_fz3(o, a, b)
    case _: Attestation_fz4(o, a, b)

def Attestation_fuzz_hi(+c: U32, o: Attestation, +sel: U32, +a: U32, +b: U32) -> Attestation & Bool:
  match c:
    case _: Attestation_fzc0(o, sel, a, b)

def Attestation_fuzz(o: Attestation, +sel: U32, +a: U32, +b: U32) -> Attestation & Bool:
  Attestation_fuzz_hi(U32.shrn(sel, 3n), o, sel, a, b)

