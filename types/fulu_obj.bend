def DataColumnSidecar_fz4_fin(ok: Bool, pr: DataColumnSidecar & O.Words) -> DataColumnSidecar & Bool:
  (obj, old) = pr
  (obj, ok)

def DataColumnSidecar_fz4_back(obj: DataColumnSidecar, res: O.Words & Bool) -> DataColumnSidecar & Bool:
  (c, ok) = res
  DataColumnSidecar_fz4_fin(ok, DataColumnSidecar_swap_kzg_proofs(obj, c))

def DataColumnSidecar_fz4_in(+a: U32, +b: U32, pr: DataColumnSidecar & O.Words) -> DataColumnSidecar & Bool:
  (obj, c) = pr
  DataColumnSidecar_fz4_back(obj, l4096_b48_append(c, b48_seed(b)))

def DataColumnSidecar_fz4(o: DataColumnSidecar, +a: U32, +b: U32) -> DataColumnSidecar & Bool:
  DataColumnSidecar_fz4_in(a, b, DataColumnSidecar_swap_kzg_proofs(o, l4096_b48_default()))

def DataColumnSidecar_fz5_fin(ok: Bool, pr: DataColumnSidecar & O.Words) -> DataColumnSidecar & Bool:
  (obj, old) = pr
  (obj, ok)

def DataColumnSidecar_fz5_back(obj: DataColumnSidecar, res: O.Words & Bool) -> DataColumnSidecar & Bool:
  (c, ok) = res
  DataColumnSidecar_fz5_fin(ok, DataColumnSidecar_swap_kzg_commitments_inclusion_proof(obj, c))

def DataColumnSidecar_fz5_in(+a: U32, +b: U32, pr: DataColumnSidecar & O.Words) -> DataColumnSidecar & Bool:
  (obj, c) = pr
  DataColumnSidecar_fz5_back(obj, v4_b32_set(c, a, b32_seed(b)))

def DataColumnSidecar_fz5(o: DataColumnSidecar, +a: U32, +b: U32) -> DataColumnSidecar & Bool:
  DataColumnSidecar_fz5_in(a, b, DataColumnSidecar_swap_kzg_commitments_inclusion_proof(o, v4_b32_default()))

def DataColumnSidecar_fzc0(o: DataColumnSidecar, +sel: U32, +a: U32, +b: U32) -> DataColumnSidecar & Bool:
  match sel:
    case 0: DataColumnSidecar_fz0(o, a, b)
    case 1: DataColumnSidecar_fz1(o, a, b)
    case 2: DataColumnSidecar_fz2(o, a, b)
    case 3: DataColumnSidecar_fz3(o, a, b)
    case 4: DataColumnSidecar_fz4(o, a, b)
    case _: DataColumnSidecar_fz5(o, a, b)

def DataColumnSidecar_fuzz_hi(+c: U32, o: DataColumnSidecar, +sel: U32, +a: U32, +b: U32) -> DataColumnSidecar & Bool:
  match c:
    case _: DataColumnSidecar_fzc0(o, sel, a, b)

def DataColumnSidecar_fuzz(o: DataColumnSidecar, +sel: U32, +a: U32, +b: U32) -> DataColumnSidecar & Bool:
  DataColumnSidecar_fuzz_hi(U32.shrn(sel, 3n), o, sel, a, b)

