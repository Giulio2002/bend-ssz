def v64_u64_ok_at(buf: B.Buf, +off: U32) -> B.Buf & Bool: (buf, True{})

def v64_u64_ok_len(ok: Bool, buf: B.Buf, +off: U32) -> B.Buf & Bool:
  match ok:
    case True{}: v64_u64_ok_at(buf, off)
    case False{}: (buf, False{})

def v64_u64_ok(buf: B.Buf, +off: U32, +len: U32) -> B.Buf & Bool: v64_u64_ok_len(U32.is_eq(len, 512), buf, off)

def v64_u64_len_of(pair: O.Words & U32) -> O.Words & U32:
  (o, +n) = pair
  (o, U32.div(n, 8))

def v64_u64_len(o: O.Words) -> O.Words & U32: v64_u64_len_of(O.words_len(o))

def v64_u64_at(o: O.Words, +i: U32) -> O.Words & O.U64: O.words_u64_at(o, (i * 8 : U32))

def v64_u64_some(pair: O.Words & O.U64) -> O.Words & Maybe<&1, O.U64>:
  (o, +v) = pair
  (o, Some{v})

def v64_u64_get_in(inside: Bool, o: O.Words, +i: U32) -> O.Words & Maybe<&1, O.U64>:
  match inside:
    case True{}: v64_u64_some(v64_u64_at(o, i))
    case False{}: (o, None{})

def v64_u64_get_n(+i: U32, pair: O.Words & U32) -> O.Words & Maybe<&1, O.U64>:
  (o, +n) = pair
  v64_u64_get_in(U32.is_lt(i, n), o, i)

def v64_u64_get(o: O.Words, +i: U32) -> O.Words & Maybe<&1, O.U64>: v64_u64_get_n(i, v64_u64_len(o))

def v64_u64_put_at(ok: Bool, o: O.Words, +i: U32, +v: O.U64) -> O.Words & Bool:
  match ok:
    case True{}: (O.words_write_u64(o, (i * 8 : U32), v), True{})
    case False{}: (o, False{})

def v64_u64_set_n(+i: U32, +v: O.U64, pair: O.Words & U32) -> O.Words & Bool:
  (o, +n) = pair
  v64_u64_put_at(U32.is_lt(i, n), o, i, v)

def v64_u64_set(o: O.Words, +i: U32, +v: O.U64) -> O.Words & Bool: v64_u64_set_n(i, v, v64_u64_len(o))

