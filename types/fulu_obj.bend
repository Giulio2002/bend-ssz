type ExecutionRequests is Type:
  ExecutionRequests{deposits: l8192_DepositRequest_Seq, withdrawals: l16_WithdrawalRequest_Seq, consolidations: l2_ConsolidationRequest_Seq}

def ExecutionRequests_default() -> ExecutionRequests: ExecutionRequests{l8192_DepositRequest_default(), l16_WithdrawalRequest_default(), l2_ConsolidationRequest_default()}

def ExecutionRequests_rd5(+off: U32, +len: U32, +o_deposits: U32, +o_withdrawals: U32, +o_consolidations: U32, deposits: l8192_DepositRequest_Seq, withdrawals: l16_WithdrawalRequest_Seq, pair: B.Buf & l2_ConsolidationRequest_Seq) -> B.Buf & ExecutionRequests:
  (buf, consolidations) = pair
  (buf, ExecutionRequests{deposits, withdrawals, consolidations})

def ExecutionRequests_rd4(+off: U32, +len: U32, +o_deposits: U32, +o_withdrawals: U32, +o_consolidations: U32, deposits: l8192_DepositRequest_Seq, pair: B.Buf & l16_WithdrawalRequest_Seq) -> B.Buf & ExecutionRequests:
  (buf, withdrawals) = pair
  ExecutionRequests_rd5(off, len, o_deposits, o_withdrawals, o_consolidations, deposits, withdrawals, l2_ConsolidationRequest_read(buf, (off + o_consolidations : U32), (len - o_consolidations : U32)))

def ExecutionRequests_rd3(+off: U32, +len: U32, +o_deposits: U32, +o_withdrawals: U32, +o_consolidations: U32, pair: B.Buf & l8192_DepositRequest_Seq) -> B.Buf & ExecutionRequests:
  (buf, deposits) = pair
  ExecutionRequests_rd4(off, len, o_deposits, o_withdrawals, o_consolidations, deposits, l16_WithdrawalRequest_read(buf, (off + o_withdrawals : U32), (o_consolidations - o_withdrawals : U32)))

def ExecutionRequests_rd2(+off: U32, +len: U32, +o_deposits: U32, +o_withdrawals: U32, pair: B.Buf & U32) -> B.Buf & ExecutionRequests:
  (buf, +o_consolidations) = pair
  ExecutionRequests_rd3(off, len, o_deposits, o_withdrawals, o_consolidations, l8192_DepositRequest_read(buf, (off + o_deposits : U32), (o_withdrawals - o_deposits : U32)))

def ExecutionRequests_rd1(+off: U32, +len: U32, +o_deposits: U32, pair: B.Buf & U32) -> B.Buf & ExecutionRequests:
  (buf, +o_withdrawals) = pair
