def b8_pw2(out: Array<U32>, +q: U32, +w0: U32, +w1: U32) -> Array<U32>: O.or_skip(Array.set(U32, O.or_word(out, (q + 0 : U32), (w0 * 65536 : U32)), (q + 1 : U32), ((w1 * 65536 : U32) .|. U32.shrn(w0, 16n) : U32)), (q + 2 : U32), U32.shrn(w1, 16n))

