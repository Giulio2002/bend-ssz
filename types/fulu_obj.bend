    case WithdrawalRequest{+source_address, +validator_pubkey, +amount}: (WithdrawalRequest{source_address, validator_pubkey, amount}, amount)

def WithdrawalRequest_set_amount(o: WithdrawalRequest, +v: O.U64) -> WithdrawalRequest:
  match o:
    case WithdrawalRequest{+source_address, +validator_pubkey, +amount}: WithdrawalRequest{source_address, validator_pubkey, v}

def WithdrawalRequest_force(o: WithdrawalRequest) -> U32:
  match o:
    case WithdrawalRequest{+source_address, +validator_pubkey, +amount}: (b20_force(source_address) .^. b48_force(validator_pubkey) .^. u64_force(amount) : U32)

def WithdrawalRequest_dump(o: WithdrawalRequest, t: +List<U32>) -> +List<U32>:
  match o:
    case WithdrawalRequest{+source_address, +validator_pubkey, +amount}: b20_dump(source_address, b48_dump(validator_pubkey, u64_dump(amount, t)))

def WithdrawalRequest_ok_at(buf: B.Buf, +off: U32) -> B.Buf & Bool: (buf, True{})

def WithdrawalRequest_ok_len(ok: Bool, buf: B.Buf, +off: U32) -> B.Buf & Bool:
  match ok:
    case True{}: WithdrawalRequest_ok_at(buf, off)
    case False{}: (buf, False{})

def WithdrawalRequest_ok(buf: B.Buf, +off: U32, +len: U32) -> B.Buf & Bool: WithdrawalRequest_ok_len(U32.is_eq(len, 76), buf, off)

def WithdrawalRequest_seed(+x: U32) -> WithdrawalRequest: WithdrawalRequest{b20_seed((x + 1 : U32)), b48_seed((x + 2 : U32)), u64_seed((x + 3 : U32))}

type l8192_DepositRequest_Seq is Type:
  l8192_DepositRequest_Seq{items: Array<DepositRequest>, n: U32}

def l8192_DepositRequest_fill(+d: Nat) -> Array<DepositRequest>: Array.new(DepositRequest, d, DepositRequest_default())

def l8192_DepositRequest_cap(+n: U32) -> Nat: B.words_depth(n)

def l8192_DepositRequest_default() -> l8192_DepositRequest_Seq: l8192_DepositRequest_Seq{l8192_DepositRequest_fill(0n), 0}

def l8192_DepositRequest_rd(+k: Nat, +i: U32, +off: U32, arr: Array<DepositRequest>, pair: B.Buf & DepositRequest) -> B.Buf & Array<DepositRequest>:
  match k:
    case 0n:
      (buf, +v) = pair
      (buf, Array.set(DepositRequest, arr, i, v))
    case 1n+q:
      (buf, +v) = pair
      l8192_DepositRequest_rd(q, (i + 1 : U32), off, Array.set(DepositRequest, arr, i, v), DepositRequest_read(buf, (off + (i + 1 : U32) * 192 : U32), 192))

def l8192_DepositRequest_rd_fin(+n: U32, pair: B.Buf & Array<DepositRequest>) -> B.Buf & l8192_DepositRequest_Seq:
  (buf, arr) = pair
  (buf, l8192_DepositRequest_Seq{arr, n})

def l8192_DepositRequest_rd_start(empty: Bool, +off: U32, +n: U32, buf: B.Buf) -> B.Buf & l8192_DepositRequest_Seq:
  match empty:
    case True{}: (buf, l8192_DepositRequest_Seq{l8192_DepositRequest_fill(0n), 0})
    case False{}: l8192_DepositRequest_rd_fin(n, l8192_DepositRequest_rd(U32.to_nat((n - 1 : U32)), 0, off, l8192_DepositRequest_fill(l8192_DepositRequest_cap(n)), DepositRequest_read(buf, off, 192)))

def l8192_DepositRequest_read(buf: B.Buf, +off: U32, +len: U32) -> B.Buf & l8192_DepositRequest_Seq: l8192_DepositRequest_rd_start(U32.is_eq(len, 0), off, U32.div(len, 192), buf)

def l8192_DepositRequest_szf(+n: U32, pair: Array<DepositRequest> & U32) -> l8192_DepositRequest_Seq & U32:
  (arr, +c) = pair
  (l8192_DepositRequest_Seq{arr, n}, O.pick(U32.is_le(n, c), (n * 192 : U32), 2147483648))

def l8192_DepositRequest_size(o: l8192_DepositRequest_Seq) -> l8192_DepositRequest_Seq & U32:
  match o:
    case l8192_DepositRequest_Seq{arr, +n}: l8192_DepositRequest_szf(n, Array.size(DepositRequest, arr))

def l8192_DepositRequest_pt(+k: Nat, +i: U32, +pos: U32, out: Array<U32>, pair: Array<DepositRequest> & DepositRequest) -> Array<U32> & Array<DepositRequest>:
  match k:
    case 0n:
      (arr, +v) = pair
      (DepositRequest_put(out, (pos + i * 192 : U32), v), arr)
    case 1n+q:
      (arr, +v) = pair
      l8192_DepositRequest_pt(q, (i + 1 : U32), pos, DepositRequest_put(out, (pos + i * 192 : U32), v), Array.get(DepositRequest, arr, (i + 1 : U32)))

def l8192_DepositRequest_pt_fin(+n: U32, pair: Array<U32> & Array<DepositRequest>) -> Array<U32> & l8192_DepositRequest_Seq:
  (out, arr) = pair
  (out, l8192_DepositRequest_Seq{arr, n})

def l8192_DepositRequest_pt_nz(empty: Bool, +pos: U32, +n: U32, out: Array<U32>, arr: Array<DepositRequest>) -> Array<U32> & l8192_DepositRequest_Seq:
  match empty:
    case True{}: (out, l8192_DepositRequest_Seq{arr, n})
    case False{}: l8192_DepositRequest_pt_fin(n, l8192_DepositRequest_pt(U32.to_nat((n - 1 : U32)), 0, pos, out, Array.get(DepositRequest, arr, 0)))

def l8192_DepositRequest_put(out: Array<U32>, +pos: U32, o: l8192_DepositRequest_Seq) -> Array<U32> & l8192_DepositRequest_Seq:
  match o:
    case l8192_DepositRequest_Seq{arr, +n}: l8192_DepositRequest_pt_nz(U32.is_eq(n, 0), pos, n, out, arr)

