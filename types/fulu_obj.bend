  DataColumnSidecar_rd6(off, len, o_column, o_kzg_commitments, o_kzg_proofs, index, column, kzg_commitments, l4096_b48_read(buf, (off + o_kzg_proofs : U32), (len - o_kzg_proofs : U32)))

def DataColumnSidecar_rd4(+off: U32, +len: U32, +o_column: U32, +o_kzg_commitments: U32, +o_kzg_proofs: U32, +index: O.U64, pair: B.Buf & O.Words) -> B.Buf & DataColumnSidecar:
