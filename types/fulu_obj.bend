def HistoricalBatch_fz0_fin(ok: Bool, pr: HistoricalBatch & O.Words) -> HistoricalBatch & Bool:
  (obj, old) = pr
  (obj, ok)

def HistoricalBatch_fz0_back(obj: HistoricalBatch, res: O.Words & Bool) -> HistoricalBatch & Bool:
  (c, ok) = res
  HistoricalBatch_fz0_fin(ok, HistoricalBatch_swap_block_roots(obj, c))

def HistoricalBatch_fz0_in(+a: U32, +b: U32, pr: HistoricalBatch & O.Words) -> HistoricalBatch & Bool:
  (obj, c) = pr
  HistoricalBatch_fz0_back(obj, v8192_b32_set(c, a, b32_seed(b)))

def HistoricalBatch_fz0(o: HistoricalBatch, +a: U32, +b: U32) -> HistoricalBatch & Bool:
  HistoricalBatch_fz0_in(a, b, HistoricalBatch_swap_block_roots(o, v8192_b32_default()))

def HistoricalBatch_fz1_fin(ok: Bool, pr: HistoricalBatch & O.Words) -> HistoricalBatch & Bool:
  (obj, old) = pr
  (obj, ok)

def HistoricalBatch_fz1_back(obj: HistoricalBatch, res: O.Words & Bool) -> HistoricalBatch & Bool:
