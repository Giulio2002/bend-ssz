def ExecutionRequests_c2(ok: Bool, buf: B.Buf, +off: U32, +len: U32, +o0: U32, +o1: U32, +o2: U32) -> B.Buf & Bool:
  match ok:
    case True{}: ExecutionRequests_v3(off, len, o0, o1, o2, l8192_DepositRequest_ok(buf, (off + o0 : U32), (o1 - o0 : U32)))
    case False{}: (buf, False{})

def ExecutionRequests_v2(+off: U32, +len: U32, +o0: U32, +o1: U32, pair: B.Buf & U32) -> B.Buf & Bool:
  (buf, +o2) = pair
  ExecutionRequests_c2(Bool.and(U32.is_le(o1, o2), U32.is_le(o2, len)), buf, off, len, o0, o1, o2)

def ExecutionRequests_c1(ok: Bool, buf: B.Buf, +off: U32, +len: U32, +o0: U32, +o1: U32) -> B.Buf & Bool:
  match ok:
    case True{}: ExecutionRequests_v2(off, len, o0, o1, B.read32(buf, (off + 8 : U32)))
    case False{}: (buf, False{})

def ExecutionRequests_v1(+off: U32, +len: U32, +o0: U32, pair: B.Buf & U32) -> B.Buf & Bool:
  (buf, +o1) = pair
  ExecutionRequests_c1(Bool.and(U32.is_le(o0, o1), U32.is_le(o1, len)), buf, off, len, o0, o1)

def ExecutionRequests_c0(ok: Bool, buf: B.Buf, +off: U32, +len: U32, +o0: U32) -> B.Buf & Bool:
  match ok:
