def ExecutionRequests_root(+hl: Nat, h: B.Buf, o: ExecutionRequests, +seg: U32) -> B.Buf & (ExecutionRequests & D.Digest):
  match o:
    case ExecutionRequests{deposits, withdrawals, consolidations}: ExecutionRequests_rt0(hl, seg, withdrawals, consolidations, l8192_DepositRequest_root(hl, h, deposits, seg))

