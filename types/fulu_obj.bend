# ---- DataColumnSidecar ----

def DataColumnSidecar_some(pair: B.Buf & DataColumnSidecar) -> B.Buf & Maybe<&1, DataColumnSidecar>:
  (buf, v) = pair
  (buf, Some{v})

def DataColumnSidecar_built(+size: U32, pair: B.Buf & Bool) -> B.Buf & Maybe<&1, DataColumnSidecar>:
  (buf, ok) = pair
  match ok:
    case True{}: DataColumnSidecar_some(DataColumnSidecar_read(buf, 0, size))
    case False{}: (buf, None{})

def DataColumnSidecar_decode(buf: B.Buf, +size: U32) -> B.Buf & Maybe<&1, DataColumnSidecar>:
  DataColumnSidecar_built(size, DataColumnSidecar_ok(buf, 0, size))

def DataColumnSidecar_build(buf: B.Buf, +size: U32) -> B.Buf & DataColumnSidecar: DataColumnSidecar_read(buf, 0, size)

def DataColumnSidecar_enc_out(+n: U32, out: Array<U32>, o: DataColumnSidecar, +m: U32) -> DataColumnSidecar & B.Buf:
  (o, O.out_done(n, out))

def DataColumnSidecar_enc_put(+n: U32, pair: Array<U32> & (DataColumnSidecar & U32)) -> DataColumnSidecar & B.Buf:
  (out, r) = pair
  (o, m) = r
  DataColumnSidecar_enc_out(n, out, o, m)

def DataColumnSidecar_enc_sized(pair: DataColumnSidecar & U32) -> DataColumnSidecar & B.Buf:
  (o, +n) = pair
  DataColumnSidecar_enc_put(n, DataColumnSidecar_putn(O.out_new(n), 0, o))

def DataColumnSidecar_encode(o: DataColumnSidecar) -> DataColumnSidecar & B.Buf: DataColumnSidecar_enc_sized(DataColumnSidecar_size(o))

def DataColumnSidecar_hash_tree_root(h: B.Buf, o: DataColumnSidecar) -> B.Buf & (DataColumnSidecar & D.Digest): DataColumnSidecar_root(64n, h, o, 0)

def DataColumnSidecar_fz0(o: DataColumnSidecar, +a: U32, +b: U32) -> DataColumnSidecar & Bool:
  (DataColumnSidecar_set_index(o, u64_seed(b)), True{})

def DataColumnSidecar_fz1_fin(ok: Bool, pr: DataColumnSidecar & O.Words) -> DataColumnSidecar & Bool:
  (obj, old) = pr
  (obj, ok)

def DataColumnSidecar_fz1_back(obj: DataColumnSidecar, res: O.Words & Bool) -> DataColumnSidecar & Bool:
  (c, ok) = res
  DataColumnSidecar_fz1_fin(ok, DataColumnSidecar_swap_kzg_commitments(obj, c))

def DataColumnSidecar_fz1_in(+a: U32, +b: U32, pr: DataColumnSidecar & O.Words) -> DataColumnSidecar & Bool:
  (obj, c) = pr
  DataColumnSidecar_fz1_back(obj, l4096_b48_set(c, a, b48_seed(b)))

def DataColumnSidecar_fz1(o: DataColumnSidecar, +a: U32, +b: U32) -> DataColumnSidecar & Bool:
  DataColumnSidecar_fz1_in(a, b, DataColumnSidecar_swap_kzg_commitments(o, l4096_b48_default()))

def DataColumnSidecar_fz2_fin(ok: Bool, pr: DataColumnSidecar & O.Words) -> DataColumnSidecar & Bool:
  (obj, old) = pr
  (obj, ok)

def DataColumnSidecar_fz2_back(obj: DataColumnSidecar, res: O.Words & Bool) -> DataColumnSidecar & Bool:
  (c, ok) = res
  DataColumnSidecar_fz2_fin(ok, DataColumnSidecar_swap_kzg_commitments(obj, c))

def DataColumnSidecar_fz2_in(+a: U32, +b: U32, pr: DataColumnSidecar & O.Words) -> DataColumnSidecar & Bool:
  (obj, c) = pr
  DataColumnSidecar_fz2_back(obj, l4096_b48_append(c, b48_seed(b)))

def DataColumnSidecar_fz2(o: DataColumnSidecar, +a: U32, +b: U32) -> DataColumnSidecar & Bool:
  DataColumnSidecar_fz2_in(a, b, DataColumnSidecar_swap_kzg_commitments(o, l4096_b48_default()))

def DataColumnSidecar_fz3_fin(ok: Bool, pr: DataColumnSidecar & O.Words) -> DataColumnSidecar & Bool:
  (obj, old) = pr
  (obj, ok)

def DataColumnSidecar_fz3_back(obj: DataColumnSidecar, res: O.Words & Bool) -> DataColumnSidecar & Bool:
  (c, ok) = res
  DataColumnSidecar_fz3_fin(ok, DataColumnSidecar_swap_kzg_proofs(obj, c))

def DataColumnSidecar_fz3_in(+a: U32, +b: U32, pr: DataColumnSidecar & O.Words) -> DataColumnSidecar & Bool:
  (obj, c) = pr
  DataColumnSidecar_fz3_back(obj, l4096_b48_set(c, a, b48_seed(b)))

def DataColumnSidecar_fz3(o: DataColumnSidecar, +a: U32, +b: U32) -> DataColumnSidecar & Bool:
