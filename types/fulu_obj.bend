def AttestationData_seed(+x: U32) -> AttestationData: AttestationData{u64_seed((x + 1 : U32)), u64_seed((x + 2 : U32)), b32_seed((x + 3 : U32)), Checkpoint_seed((x + 4 : U32)), Checkpoint_seed((x + 5 : U32))}

type SingleAttestation is Data:
  SingleAttestation{committee_index: O.U64, attester_index: O.U64, data: AttestationData, signature: Bytes96}

def SingleAttestation_default() -> SingleAttestation: SingleAttestation{u64_default(), u64_default(), AttestationData_default(), b96_default()}

def SingleAttestation_rd3(+off: U32, +len: U32, +committee_index: O.U64, +attester_index: O.U64, +data: AttestationData, pair: B.Buf & Bytes96) -> B.Buf & SingleAttestation:
  (buf, +signature) = pair
  (buf, SingleAttestation{committee_index, attester_index, data, signature})

def SingleAttestation_rd2(+off: U32, +len: U32, +committee_index: O.U64, +attester_index: O.U64, pair: B.Buf & AttestationData) -> B.Buf & SingleAttestation:
  (buf, +data) = pair
  SingleAttestation_rd3(off, len, committee_index, attester_index, data, b96_read(buf, (off + 144 : U32), 96))

def SingleAttestation_rd1(+off: U32, +len: U32, +committee_index: O.U64, pair: B.Buf & O.U64) -> B.Buf & SingleAttestation:
  (buf, +attester_index) = pair
  SingleAttestation_rd2(off, len, committee_index, attester_index, AttestationData_read(buf, (off + 16 : U32), 128))

def SingleAttestation_rd0(+off: U32, +len: U32, pair: B.Buf & O.U64) -> B.Buf & SingleAttestation:
  (buf, +committee_index) = pair
  SingleAttestation_rd1(off, len, committee_index, u64_read(buf, (off + 8 : U32), 8))

def SingleAttestation_read(buf: B.Buf, +off: U32, +len: U32) -> B.Buf & SingleAttestation: SingleAttestation_rd0(off, len, u64_read(buf, (off + 0 : U32), 8))

def SingleAttestation_put(out: Array<U32>, +pos: U32, o: SingleAttestation) -> Array<U32>:
  match o:
    case SingleAttestation{+committee_index, +attester_index, +data, +signature}: b96_put(AttestationData_put(u64_put(u64_put(out, (pos + 0 : U32), committee_index), (pos + 8 : U32), attester_index), (pos + 16 : U32), data), (pos + 144 : U32), signature)

def SingleAttestation_rt3(+hl: Nat, +seg: U32, +committee_index: O.U64, +attester_index: O.U64, +data: AttestationData, +signature: Bytes96, d_committee_index: D.Digest, d_attester_index: D.Digest, d_data: D.Digest, pair: B.Buf & D.Digest) -> B.Buf & D.Digest:
  (h, d_signature) = pair
  (h, D.node(hl, D.node(hl, d_committee_index, d_attester_index), D.node(hl, d_data, d_signature)))

def SingleAttestation_rt2(+hl: Nat, +seg: U32, +committee_index: O.U64, +attester_index: O.U64, +data: AttestationData, +signature: Bytes96, d_committee_index: D.Digest, d_attester_index: D.Digest, pair: B.Buf & D.Digest) -> B.Buf & D.Digest:
  (h, d_data) = pair
  SingleAttestation_rt3(hl, seg, committee_index, attester_index, data, signature, d_committee_index, d_attester_index, d_data, b96_root(hl, h, signature, seg))

def SingleAttestation_rt1(+hl: Nat, +seg: U32, +committee_index: O.U64, +attester_index: O.U64, +data: AttestationData, +signature: Bytes96, d_committee_index: D.Digest, pair: B.Buf & D.Digest) -> B.Buf & D.Digest:
  (h, d_attester_index) = pair
  SingleAttestation_rt2(hl, seg, committee_index, attester_index, data, signature, d_committee_index, d_attester_index, AttestationData_root(hl, h, data, seg))

def SingleAttestation_rt0(+hl: Nat, +seg: U32, +committee_index: O.U64, +attester_index: O.U64, +data: AttestationData, +signature: Bytes96, pair: B.Buf & D.Digest) -> B.Buf & D.Digest:
  (h, d_committee_index) = pair
  SingleAttestation_rt1(hl, seg, committee_index, attester_index, data, signature, d_committee_index, u64_root(hl, h, attester_index, seg))

def SingleAttestation_root(+hl: Nat, h: B.Buf, o: SingleAttestation, +seg: U32) -> B.Buf & D.Digest:
  match o:
    case SingleAttestation{+committee_index, +attester_index, +data, +signature}: SingleAttestation_rt0(hl, seg, committee_index, attester_index, data, signature, u64_root(hl, h, committee_index, seg))

def SingleAttestation_get_committee_index(o: SingleAttestation) -> SingleAttestation & O.U64:
  match o:
    case SingleAttestation{+committee_index, +attester_index, +data, +signature}: (SingleAttestation{committee_index, attester_index, data, signature}, committee_index)

def SingleAttestation_set_committee_index(o: SingleAttestation, +v: O.U64) -> SingleAttestation:
