def FinalityBranch_build(buf: B.Buf, +size: U32) -> B.Buf & O.Words: v7_b32_read(buf, 0, size)

def FinalityBranch_enc_out(pair: Array<U32> & O.Words) -> O.Words & B.Buf:
  (out, o) = pair
  (o, O.out_done(224, out))

def FinalityBranch_encode(o: O.Words) -> O.Words & B.Buf: FinalityBranch_enc_out(v7_b32_put(O.out_at(6n), 0, o))

