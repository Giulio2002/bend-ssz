type Fork is Data:
  Fork{previous_version: Bytes4, current_version: Bytes4, epoch: O.U64}

def Fork_default() -> Fork: Fork{b4_default(), b4_default(), u64_default()}

def Fork_rd2(+off: U32, +len: U32, +previous_version: Bytes4, +current_version: Bytes4, pair: B.Buf & O.U64) -> B.Buf & Fork:
  (buf, +epoch) = pair
  (buf, Fork{previous_version, current_version, epoch})

def Fork_rd1(+off: U32, +len: U32, +previous_version: Bytes4, pair: B.Buf & Bytes4) -> B.Buf & Fork:
  (buf, +current_version) = pair
  Fork_rd2(off, len, previous_version, current_version, u64_read(buf, (off + 8 : U32), 8))

def Fork_rd0(+off: U32, +len: U32, pair: B.Buf & Bytes4) -> B.Buf & Fork:
  (buf, +previous_version) = pair
  Fork_rd1(off, len, previous_version, b4_read(buf, (off + 4 : U32), 4))

def Fork_read(buf: B.Buf, +off: U32, +len: U32) -> B.Buf & Fork: Fork_rd0(off, len, b4_read(buf, (off + 0 : U32), 4))

def Fork_put(out: Array<U32>, +pos: U32, o: Fork) -> Array<U32>:
  match o:
    case Fork{+previous_version, +current_version, +epoch}: u64_put(b4_put(b4_put(out, (pos + 0 : U32), previous_version), (pos + 4 : U32), current_version), (pos + 8 : U32), epoch)

def Fork_rt2(+hl: Nat, +seg: U32, +previous_version: Bytes4, +current_version: Bytes4, +epoch: O.U64, d_previous_version: D.Digest, d_current_version: D.Digest, pair: B.Buf & D.Digest) -> B.Buf & D.Digest:
  (h, d_epoch) = pair
  (h, D.node(hl, D.node(hl, d_previous_version, d_current_version), D.node(hl, d_epoch, D.zero())))

def Fork_rt1(+hl: Nat, +seg: U32, +previous_version: Bytes4, +current_version: Bytes4, +epoch: O.U64, d_previous_version: D.Digest, pair: B.Buf & D.Digest) -> B.Buf & D.Digest:
  (h, d_current_version) = pair
  Fork_rt2(hl, seg, previous_version, current_version, epoch, d_previous_version, d_current_version, u64_root(hl, h, epoch, seg))

def Fork_rt0(+hl: Nat, +seg: U32, +previous_version: Bytes4, +current_version: Bytes4, +epoch: O.U64, pair: B.Buf & D.Digest) -> B.Buf & D.Digest:
  (h, d_previous_version) = pair
  Fork_rt1(hl, seg, previous_version, current_version, epoch, d_previous_version, b4_root(hl, h, current_version, seg))

def Fork_root(+hl: Nat, h: B.Buf, o: Fork, +seg: U32) -> B.Buf & D.Digest:
  match o:
    case Fork{+previous_version, +current_version, +epoch}: Fork_rt0(hl, seg, previous_version, current_version, epoch, b4_root(hl, h, previous_version, seg))

def Fork_get_previous_version(o: Fork) -> Fork & Bytes4:
  match o:
    case Fork{+previous_version, +current_version, +epoch}: (Fork{previous_version, current_version, epoch}, previous_version)

def Fork_set_previous_version(o: Fork, +v: Bytes4) -> Fork:
  match o:
    case Fork{+previous_version, +current_version, +epoch}: Fork{v, current_version, epoch}

def Fork_get_current_version(o: Fork) -> Fork & Bytes4:
  match o:
    case Fork{+previous_version, +current_version, +epoch}: (Fork{previous_version, current_version, epoch}, current_version)

def Fork_set_current_version(o: Fork, +v: Bytes4) -> Fork:
  match o:
    case Fork{+previous_version, +current_version, +epoch}: Fork{previous_version, v, epoch}

def Fork_get_epoch(o: Fork) -> Fork & O.U64:
  match o:
    case Fork{+previous_version, +current_version, +epoch}: (Fork{previous_version, current_version, epoch}, epoch)

def Fork_set_epoch(o: Fork, +v: O.U64) -> Fork:
  match o:
    case Fork{+previous_version, +current_version, +epoch}: Fork{previous_version, current_version, v}

def Fork_force(o: Fork) -> U32:
  match o:
    case Fork{+previous_version, +current_version, +epoch}: (b4_force(previous_version) .^. b4_force(current_version) .^. u64_force(epoch) : U32)

def Fork_dump(o: Fork, t: +List<U32>) -> +List<U32>:
  match o:
    case Fork{+previous_version, +current_version, +epoch}: b4_dump(previous_version, b4_dump(current_version, u64_dump(epoch, t)))

def Fork_ok_at(buf: B.Buf, +off: U32) -> B.Buf & Bool: (buf, True{})

def Fork_ok_len(ok: Bool, buf: B.Buf, +off: U32) -> B.Buf & Bool:
  match ok:
    case True{}: Fork_ok_at(buf, off)
    case False{}: (buf, False{})

def Fork_ok(buf: B.Buf, +off: U32, +len: U32) -> B.Buf & Bool: Fork_ok_len(U32.is_eq(len, 16), buf, off)

def Fork_seed(+x: U32) -> Fork: Fork{b4_seed((x + 1 : U32)), b4_seed((x + 2 : U32)), u64_seed((x + 3 : U32))}

