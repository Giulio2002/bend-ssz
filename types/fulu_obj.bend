  BlobSidecar_fz4_in(a, b, BlobSidecar_swap_kzg_commitment_inclusion_proof(o, v17_b32_default()))

def BlobSidecar_fzc0(o: BlobSidecar, +sel: U32, +a: U32, +b: U32) -> BlobSidecar & Bool:
  match sel:
    case 0: BlobSidecar_fz0(o, a, b)
