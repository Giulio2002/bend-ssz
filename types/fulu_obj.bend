def l16_Withdrawal_read(buf: B.Buf, +off: U32, +len: U32) -> B.Buf & l16_Withdrawal_Seq: l16_Withdrawal_rd_start(U32.is_eq(len, 0), off, U32.div(len, 44), buf)

def l16_Withdrawal_szf(+n: U32, pair: Array<Withdrawal> & U32) -> l16_Withdrawal_Seq & U32:
  (arr, +c) = pair
  (l16_Withdrawal_Seq{arr, n}, O.pick(U32.is_le(n, c), (n * 44 : U32), 2147483648))

def l16_Withdrawal_size(o: l16_Withdrawal_Seq) -> l16_Withdrawal_Seq & U32:
  match o:
    case l16_Withdrawal_Seq{arr, +n}: l16_Withdrawal_szf(n, Array.size(Withdrawal, arr))

def l16_Withdrawal_pt(+k: Nat, +i: U32, +pos: U32, out: Array<U32>, pair: Array<Withdrawal> & Withdrawal) -> Array<U32> & Array<Withdrawal>:
  match k:
    case 0n:
      (arr, +v) = pair
      (Withdrawal_put(out, (pos + i * 44 : U32), v), arr)
    case 1n+q:
      (arr, +v) = pair
      l16_Withdrawal_pt(q, (i + 1 : U32), pos, Withdrawal_put(out, (pos + i * 44 : U32), v), Array.get(Withdrawal, arr, (i + 1 : U32)))

def l16_Withdrawal_pt_fin(+n: U32, pair: Array<U32> & Array<Withdrawal>) -> Array<U32> & l16_Withdrawal_Seq:
  (out, arr) = pair
  (out, l16_Withdrawal_Seq{arr, n})

def l16_Withdrawal_pt_nz(empty: Bool, +pos: U32, +n: U32, out: Array<U32>, arr: Array<Withdrawal>) -> Array<U32> & l16_Withdrawal_Seq:
  match empty:
    case True{}: (out, l16_Withdrawal_Seq{arr, n})
    case False{}: l16_Withdrawal_pt_fin(n, l16_Withdrawal_pt(U32.to_nat((n - 1 : U32)), 0, pos, out, Array.get(Withdrawal, arr, 0)))

def l16_Withdrawal_put(out: Array<U32>, +pos: U32, o: l16_Withdrawal_Seq) -> Array<U32> & l16_Withdrawal_Seq:
  match o:
    case l16_Withdrawal_Seq{arr, +n}: l16_Withdrawal_pt_nz(U32.is_eq(n, 0), pos, n, out, arr)

def l16_Withdrawal_ptn_fin(+n: U32, pair: Array<U32> & l16_Withdrawal_Seq) -> Array<U32> & (l16_Withdrawal_Seq & U32):
  (out, sq) = pair
  (out, (sq, (n * 44 : U32)))

def l16_Withdrawal_putn(out: Array<U32>, +pos: U32, o: l16_Withdrawal_Seq) -> Array<U32> & (l16_Withdrawal_Seq & U32):
  match o:
    case l16_Withdrawal_Seq{arr, +n}: l16_Withdrawal_ptn_fin(n, l16_Withdrawal_pt_nz(U32.is_eq(n, 0), pos, n, out, arr))

def l16_Withdrawal_rl_d(arr: Array<Withdrawal>, pair: B.Buf & D.Digest) -> B.Buf & (Array<Withdrawal> & D.Digest):
  (h, d) = pair
  (h, (arr, d))

def l16_Withdrawal_rl(+hl: Nat, +seg: U32, h: B.Buf, pair: Array<Withdrawal> & Withdrawal) -> B.Buf & (Array<Withdrawal> & D.Digest):
  (arr, +v) = pair
  l16_Withdrawal_rl_d(arr, Withdrawal_root(hl, h, v, (seg + 64 : U32)))

def l16_Withdrawal_mj(+hl: Nat, dl: D.Digest, pair: B.Buf & (Array<Withdrawal> & D.Digest)) -> B.Buf & (Array<Withdrawal> & D.Digest):
  (h, r) = pair
  (arr, dr) = r
  (h, (arr, D.node(hl, dl, dr)))

def l16_Withdrawal_mt(d: Nat, m: Nat, inside: Bool, +hl: Nat, +seg: U32, +w: Nat, +s: Nat, +n: Nat, st: B.Buf & (Array<Withdrawal> & D.Digest)) -> B.Buf & (Array<Withdrawal> & D.Digest):
  match d:
    case 0n:
      match m:
        case 0n:
          match inside:
            case False{}:
              (h, r) = st
              (arr, dl) = r
              (h, (arr, D.zconst(0n)))
            case True{}:
              (h, r) = st
              (arr, dl) = r
              l16_Withdrawal_rl(hl, seg, h, Array.get(Withdrawal, arr, U32.from_nat(s)))
        case 1n+q:
          (h, r) = st
          (arr, dl) = r
          l16_Withdrawal_mj(hl, dl, l16_Withdrawal_mt(0n, q, inside, hl, seg, w, s, n, (h, (arr, D.zero()))))
    case 1n+ +p:
      match m:
        case 0n:
          match inside:
            case False{}:
              (h, r) = st
              (arr, dl) = r
              (h, (arr, D.zconst(1n+p)))
            case True{}:
              l16_Withdrawal_mt(p, 1n, Nat.is_lt(Nat.add(s, Nat.div(w, 2n)), n), hl, seg, Nat.div(w, 2n), Nat.add(s, Nat.div(w, 2n)), n,
                l16_Withdrawal_mt(p, 0n, True{}, hl, seg, Nat.div(w, 2n), s, n, st))
        case 1n+q:
          (h, r) = st
          (arr, dl) = r
          l16_Withdrawal_mj(hl, dl, l16_Withdrawal_mt(1n+p, q, inside, hl, seg, w, s, n, (h, (arr, D.zero()))))

def l16_Withdrawal_mt0(+d: Nat, inside: Bool, +hl: Nat, +seg: U32, +n: Nat, st: B.Buf & (Array<Withdrawal> & D.Digest)) -> B.Buf & (Array<Withdrawal> & D.Digest):
  match d:
    case 0n: l16_Withdrawal_mt(0n, 0n, inside, hl, seg, 1n, 0n, n, st)
    case 1n+q:
      match inside:
        case False{}:
          (h, r) = st
          (arr, dl) = r
          (h, (arr, D.zconst(1n+q)))
        case True{}:
          l16_Withdrawal_mt(q, 1n, Nat.is_lt(Nat.add(0n, O.pow2n(q)), n), hl, seg, O.pow2n(q), Nat.add(0n, O.pow2n(q)), n,
            l16_Withdrawal_mt(q, 0n, True{}, hl, seg, O.pow2n(q), 0n, n, st))

def l16_Withdrawal_rt_fin(+hl: Nat, +n: U32, pair: B.Buf & (Array<Withdrawal> & D.Digest)) -> B.Buf & (l16_Withdrawal_Seq & D.Digest):
  (h, r) = pair
  (arr, d) = r
  (h, (l16_Withdrawal_Seq{arr, n}, O.mix_len(hl, d, n)))

def l16_Withdrawal_root(+hl: Nat, h: B.Buf, o: l16_Withdrawal_Seq, +seg: U32) -> B.Buf & (l16_Withdrawal_Seq & D.Digest):
  match o:
    case l16_Withdrawal_Seq{arr, +n}: l16_Withdrawal_rt_fin(hl, n, l16_Withdrawal_mt0(4n, Nat.is_lt(0n, U32.to_nat(n)), hl, seg, U32.to_nat(n), (h, (arr, D.zero()))))

def l16_Withdrawal_fo(+k: Nat, +i: U32, +acc: U32, pair: Array<Withdrawal> & Withdrawal) -> Array<Withdrawal> & U32:
  match k:
    case 0n:
      (arr, +v) = pair
      (arr, (acc .^. Withdrawal_force(v) : U32))
    case 1n+q:
      (arr, +v) = pair
      l16_Withdrawal_fo(q, (i + 1 : U32), (acc .^. Withdrawal_force(v) : U32), Array.get(Withdrawal, arr, (i + 1 : U32)))

def l16_Withdrawal_fo_fin(+n: U32, pair: Array<Withdrawal> & U32) -> l16_Withdrawal_Seq & U32:
  (arr, +x) = pair
  (l16_Withdrawal_Seq{arr, n}, x)

def l16_Withdrawal_fo_nz(empty: Bool, +n: U32, arr: Array<Withdrawal>) -> l16_Withdrawal_Seq & U32:
  match empty:
    case True{}: (l16_Withdrawal_Seq{arr, n}, 0)
    case False{}: l16_Withdrawal_fo_fin(n, l16_Withdrawal_fo(U32.to_nat((n - 1 : U32)), 0, 0, Array.get(Withdrawal, arr, 0)))

def l16_Withdrawal_force(o: l16_Withdrawal_Seq) -> l16_Withdrawal_Seq & U32:
  match o:
    case l16_Withdrawal_Seq{arr, +n}: l16_Withdrawal_fo_nz(U32.is_eq(n, 0), n, arr)

def l16_Withdrawal_pk(out: Array<U32>, +pos: U32, pair: l16_Withdrawal_Seq & Bool) -> Array<U32> & (l16_Withdrawal_Seq & U32):
  (o, ok) = pair
  match ok:
    case True{}: l16_Withdrawal_putn(out, pos, o)
    case False{}: (out, (o, 2147483648))

def l16_Withdrawal_va_cap(ok: Bool, +n: U32, pair: Array<Withdrawal> & U32) -> l16_Withdrawal_Seq & Bool:
  (arr, +c) = pair
  (l16_Withdrawal_Seq{arr, n}, Bool.and(ok, U32.is_le(n, c)))

def l16_Withdrawal_valid(o: l16_Withdrawal_Seq) -> l16_Withdrawal_Seq & Bool:
  match o:
    case l16_Withdrawal_Seq{arr, +n}: l16_Withdrawal_va_cap(Bool.or(False{}, U32.is_le(n, 16)), n, Array.size(Withdrawal, arr))

def l16_Withdrawal_putk(out: Array<U32>, +pos: U32, o: l16_Withdrawal_Seq) -> Array<U32> & (l16_Withdrawal_Seq & U32): l16_Withdrawal_pk(out, pos, l16_Withdrawal_valid(o))

def l16_Withdrawal_du_took(t: +List<U32>, pair: Array<Withdrawal> & Withdrawal) -> Array<Withdrawal> & +List<U32>:
  (arr, +v) = pair
  (arr, Withdrawal_dump(v, t))

def l16_Withdrawal_du(+k: Nat, +i: U32, st: Array<Withdrawal> & +List<U32>) -> Array<Withdrawal> & +List<U32>:
  match k:
    case 0n: st
    case 1n+q:
      (arr, t) = st
      l16_Withdrawal_du(q, (i - 1 : U32), l16_Withdrawal_du_took(t, Array.get(Withdrawal, arr, (i - 1 : U32))))

def l16_Withdrawal_du_fin(+n: U32, st: Array<Withdrawal> & +List<U32>) -> +List<U32>:
  (arr, t) = st
  O.dump_le(n, 4, t)

def l16_Withdrawal_dump(o: l16_Withdrawal_Seq, t: +List<U32>) -> +List<U32>:
  match o:
    case l16_Withdrawal_Seq{arr, +n}: l16_Withdrawal_du_fin(n, l16_Withdrawal_du(U32.to_nat(n), n, (arr, t)))

def l16_Withdrawal_ok(buf: B.Buf, +off: U32, +len: U32) -> B.Buf & Bool: (buf, Bool.and(U32.is_eq(len, (U32.div(len, 44) * 44 : U32)), U32.is_le(U32.div(len, 44), 16)))

def l16_Withdrawal_len(o: l16_Withdrawal_Seq) -> l16_Withdrawal_Seq & U32:
  match o:
    case l16_Withdrawal_Seq{arr, +n}: (l16_Withdrawal_Seq{arr, n}, n)

def l16_Withdrawal_took(+n: U32, pair: Array<Withdrawal> & Withdrawal) -> l16_Withdrawal_Seq & Maybe<&1, Withdrawal>:
  (arr, +v) = pair
  (l16_Withdrawal_Seq{arr, n}, Some{v})

def l16_Withdrawal_at(arr: Array<Withdrawal>, +n: U32, +i: U32) -> l16_Withdrawal_Seq & Maybe<&1, Withdrawal>:
  l16_Withdrawal_took(n, Array.get(Withdrawal, arr, i))

def l16_Withdrawal_get_in(inside: Bool, arr: Array<Withdrawal>, +n: U32, +i: U32) -> l16_Withdrawal_Seq & Maybe<&1, Withdrawal>:
  match inside:
    case True{}: l16_Withdrawal_at(arr, n, i)
    case False{}: (l16_Withdrawal_Seq{arr, n}, None{})

def l16_Withdrawal_get(o: l16_Withdrawal_Seq, +i: U32) -> l16_Withdrawal_Seq & Maybe<&1, Withdrawal>:
  match o:
    case l16_Withdrawal_Seq{arr, +n}: l16_Withdrawal_get_in(U32.is_lt(i, n), arr, n, i)

def l16_Withdrawal_put_in(ok: Bool, arr: Array<Withdrawal>, +n: U32, +i: U32, v: Withdrawal) -> l16_Withdrawal_Seq & Bool:
  match ok:
    case True{}: (l16_Withdrawal_Seq{Array.set(Withdrawal, arr, i, v), n}, True{})
    case False{}: (l16_Withdrawal_Seq{arr, n}, False{})

def l16_Withdrawal_set(o: l16_Withdrawal_Seq, +i: U32, v: Withdrawal) -> l16_Withdrawal_Seq & Bool:
  match o:
    case l16_Withdrawal_Seq{arr, +n}: l16_Withdrawal_put_in(U32.is_lt(i, n), arr, n, i, v)

def l16_Withdrawal_moved(+i: U32, fresh: Array<Withdrawal>, pair: Array<Withdrawal> & Withdrawal) -> Array<Withdrawal> & Array<Withdrawal>:
  (old, v) = pair
  (Array.set(Withdrawal, fresh, i, v), old)

def l16_Withdrawal_copy(+k: Nat, +i: U32, pair: Array<Withdrawal> & Array<Withdrawal>) -> Array<Withdrawal>:
  match k:
    case 0n:
      (fresh, old) = pair
      fresh
    case 1n+q:
      (fresh, old) = pair
      l16_Withdrawal_copy(q, (i + 1 : U32), l16_Withdrawal_moved(i, fresh, Array.swap(Withdrawal, old, i, Withdrawal_default())))

def l16_Withdrawal_room_pick(fits: Bool, arr: Array<Withdrawal>, +n: U32) -> Array<Withdrawal>:
  match fits:
    case True{}: arr
    case False{}: l16_Withdrawal_copy(U32.to_nat(n), 0, (l16_Withdrawal_fill(l16_Withdrawal_cap((n + 1 : U32))), arr))

def l16_Withdrawal_room_sized(+n: U32, pair: Array<Withdrawal> & U32) -> Array<Withdrawal>:
  (arr, +cap) = pair
  l16_Withdrawal_room_pick(U32.is_lt(n, cap), arr, n)

def l16_Withdrawal_room(arr: Array<Withdrawal>, +n: U32) -> Array<Withdrawal>: l16_Withdrawal_room_sized(n, Array.size(Withdrawal, arr))

def l16_Withdrawal_app_in(ok: Bool, arr: Array<Withdrawal>, +n: U32, v: Withdrawal) -> l16_Withdrawal_Seq & Bool:
  match ok:
    case True{}: (l16_Withdrawal_Seq{Array.set(Withdrawal, l16_Withdrawal_room(arr, n), n, v), (n + 1 : U32)}, True{})
    case False{}: (l16_Withdrawal_Seq{arr, n}, False{})

def l16_Withdrawal_append(o: l16_Withdrawal_Seq, v: Withdrawal) -> l16_Withdrawal_Seq & Bool:
  match o:
    case l16_Withdrawal_Seq{arr, +n}: l16_Withdrawal_app_in(U32.is_le((n + 1 : U32), 16), arr, n, v)

type l16_Withdrawal_Cached is Type:
  l16_Withdrawal_Cached{items: Array<Withdrawal>, n: U32, d: Nat, nodes: Array<D.Digest>, lo: U32, hi: U32}

type l16_Withdrawal_TS is Type:
  l16_Withdrawal_TS{h: B.Buf, items: Array<Withdrawal>, nodes: Array<D.Digest>}

def l16_Withdrawal_dfill(+d: Nat) -> Array<D.Digest>: Array.new(D.Digest, d, D.zero())

def l16_Withdrawal_cache_at(arr: Array<Withdrawal>, +n: U32, +d: Nat) -> l16_Withdrawal_Cached:
  l16_Withdrawal_Cached{arr, n, d, l16_Withdrawal_dfill(1n+d), 0, (O.pow2u(d) - 1 : U32)}

def l16_Withdrawal_cache(o: l16_Withdrawal_Seq) -> l16_Withdrawal_Cached:
  match o:
    case l16_Withdrawal_Seq{arr, +n}: l16_Withdrawal_cache_at(arr, n, l16_Withdrawal_cap(n))

def l16_Withdrawal_uncache(c: l16_Withdrawal_Cached) -> l16_Withdrawal_Seq:
  match c:
    case l16_Withdrawal_Cached{arr, +n, +d, nodes, +lo, +hi}: l16_Withdrawal_Seq{arr, n}

def l16_Withdrawal_clen(c: l16_Withdrawal_Cached) -> l16_Withdrawal_Cached & U32:
  match c:
    case l16_Withdrawal_Cached{arr, +n, +d, nodes, +lo, +hi}: (l16_Withdrawal_Cached{arr, n, d, nodes, lo, hi}, n)

def l16_Withdrawal_ctook(+n: U32, +d: Nat, nodes: Array<D.Digest>, +lo: U32, +hi: U32, pair: Array<Withdrawal> & Withdrawal) -> l16_Withdrawal_Cached & Maybe<&1, Withdrawal>:
  (arr, +v) = pair
  (l16_Withdrawal_Cached{arr, n, d, nodes, lo, hi}, Some{v})

def l16_Withdrawal_cget_in(inside: Bool, arr: Array<Withdrawal>, +n: U32, +d: Nat, nodes: Array<D.Digest>, +lo: U32, +hi: U32, +i: U32) -> l16_Withdrawal_Cached & Maybe<&1, Withdrawal>:
  match inside:
    case True{}: l16_Withdrawal_ctook(n, d, nodes, lo, hi, Array.get(Withdrawal, arr, i))
    case False{}: (l16_Withdrawal_Cached{arr, n, d, nodes, lo, hi}, None{})

def l16_Withdrawal_cget(c: l16_Withdrawal_Cached, +i: U32) -> l16_Withdrawal_Cached & Maybe<&1, Withdrawal>:
  match c:
    case l16_Withdrawal_Cached{arr, +n, +d, nodes, +lo, +hi}: l16_Withdrawal_cget_in(U32.is_lt(i, n), arr, n, d, nodes, lo, hi, i)

def l16_Withdrawal_cset_in(ok: Bool, arr: Array<Withdrawal>, +n: U32, +d: Nat, nodes: Array<D.Digest>, +lo: U32, +hi: U32, +i: U32, v: Withdrawal) -> l16_Withdrawal_Cached & Bool:
  match ok:
    case True{}: (l16_Withdrawal_Cached{Array.set(Withdrawal, arr, i, v), n, d, nodes, O.pick(U32.is_le(lo, i), lo, i), O.pick(U32.is_le(i, hi), hi, i)}, True{})
    case False{}: (l16_Withdrawal_Cached{arr, n, d, nodes, lo, hi}, False{})

def l16_Withdrawal_cset(c: l16_Withdrawal_Cached, +i: U32, v: Withdrawal) -> l16_Withdrawal_Cached & Bool:
  match c:
    case l16_Withdrawal_Cached{arr, +n, +d, nodes, +lo, +hi}: l16_Withdrawal_cset_in(U32.is_lt(i, n), arr, n, d, nodes, lo, hi, i, v)

def l16_Withdrawal_capp_fit(fits: Bool, arr: Array<Withdrawal>, +n: U32, +d: Nat, nodes: Array<D.Digest>, +lo: U32, +hi: U32, v: Withdrawal) -> l16_Withdrawal_Cached:
  match fits:
    case True{}: l16_Withdrawal_Cached{Array.set(Withdrawal, arr, n, v), (n + 1 : U32), d, nodes, O.pick(U32.is_le(lo, n), lo, n), O.pick(U32.is_le(n, hi), hi, n)}
    case False{}: l16_Withdrawal_Cached{Array.set(Withdrawal, l16_Withdrawal_room(arr, n), n, v), (n + 1 : U32), 1n+d, l16_Withdrawal_dfill(2n+d), 0, (O.pow2u(1n+d) - 1 : U32)}

def l16_Withdrawal_capp_in(ok: Bool, arr: Array<Withdrawal>, +n: U32, +d: Nat, nodes: Array<D.Digest>, +lo: U32, +hi: U32, v: Withdrawal) -> l16_Withdrawal_Cached & Bool:
  match ok:
    case True{}: (l16_Withdrawal_capp_fit(U32.is_lt(n, O.pow2u(d)), arr, n, d, nodes, lo, hi, v), True{})
    case False{}: (l16_Withdrawal_Cached{arr, n, d, nodes, lo, hi}, False{})

def l16_Withdrawal_capp(c: l16_Withdrawal_Cached, v: Withdrawal) -> l16_Withdrawal_Cached & Bool:
  match c:
    case l16_Withdrawal_Cached{arr, +n, +d, nodes, +lo, +hi}: l16_Withdrawal_capp_in(U32.is_le((n + 1 : U32), 16), arr, n, d, nodes, lo, hi, v)

def l16_Withdrawal_ts_store(ts: l16_Withdrawal_TS, +k: U32, +dg: D.Digest) -> l16_Withdrawal_TS:
  match ts:
    case l16_Withdrawal_TS{h, arr, nodes}: l16_Withdrawal_TS{h, arr, Array.set(D.Digest, nodes, k, dg)}

def l16_Withdrawal_leaf_fin(+k: U32, arr: Array<Withdrawal>, nodes: Array<D.Digest>, pr: B.Buf & D.Digest) -> l16_Withdrawal_TS:
  (h, +dg) = pr
  l16_Withdrawal_ts_store(l16_Withdrawal_TS{h, arr, nodes}, k, dg)

def l16_Withdrawal_leaf_go(+hl: Nat, +k: U32, +seg: U32, nodes: Array<D.Digest>, h: B.Buf, pr: Array<Withdrawal> & Withdrawal) -> l16_Withdrawal_TS:
  (arr, +v) = pr
  l16_Withdrawal_leaf_fin(k, arr, nodes, Withdrawal_root(hl, h, v, (seg + 64 : U32)))

def l16_Withdrawal_leaf_hash(+hl: Nat, +k: U32, +i: U32, +seg: U32, ts: l16_Withdrawal_TS) -> l16_Withdrawal_TS:
  match ts:
    case l16_Withdrawal_TS{h, arr, nodes}: l16_Withdrawal_leaf_go(hl, k, seg, nodes, h, Array.get(Withdrawal, arr, i))

def l16_Withdrawal_leaf_step(+hl: Nat, inside: Bool, +k: U32, +i: U32, +seg: U32, ts: l16_Withdrawal_TS) -> l16_Withdrawal_TS:
  match inside:
    case True{}: l16_Withdrawal_leaf_hash(hl, k, i, seg, ts)
    case False{}: l16_Withdrawal_ts_store(ts, k, D.zero())

def l16_Withdrawal_leaves(+hl: Nat, +q: Nat, +i: U32, +n: U32, +seg: U32, +cap: U32, ts: l16_Withdrawal_TS) -> l16_Withdrawal_TS:
  match q:
    case 0n: ts
    case 1n+r:
      l16_Withdrawal_leaves(hl, r, (i + 1 : U32), n, seg, cap, l16_Withdrawal_leaf_step(hl, U32.is_lt(i, n), (cap + i : U32), i, seg, ts))

def l16_Withdrawal_node_fin(+hl: Nat, +j: U32, h: B.Buf, arr: Array<Withdrawal>, +dl: D.Digest, pr: Array<D.Digest> & D.Digest) -> l16_Withdrawal_TS:
  (nodes, +dr) = pr
  l16_Withdrawal_ts_store(l16_Withdrawal_TS{h, arr, nodes}, j, D.node(hl, dl, dr))

def l16_Withdrawal_node_go(+hl: Nat, +j: U32, h: B.Buf, arr: Array<Withdrawal>, pr: Array<D.Digest> & D.Digest) -> l16_Withdrawal_TS:
  (nodes, +dl) = pr
  l16_Withdrawal_node_fin(hl, j, h, arr, dl, Array.get(D.Digest, nodes, (2 * j + 1 : U32)))

def l16_Withdrawal_node_step(+hl: Nat, +j: U32, ts: l16_Withdrawal_TS) -> l16_Withdrawal_TS:
  match ts:
    case l16_Withdrawal_TS{h, arr, nodes}: l16_Withdrawal_node_go(hl, j, h, arr, Array.get(D.Digest, nodes, (2 * j : U32)))

def l16_Withdrawal_level(+hl: Nat, +q: Nat, +j: U32, ts: l16_Withdrawal_TS) -> l16_Withdrawal_TS:
  match q:
    case 0n: ts
    case 1n+r: l16_Withdrawal_level(hl, r, (j + 1 : U32), l16_Withdrawal_node_step(hl, j, ts))

def l16_Withdrawal_levels(+hl: Nat, +L: Nat, +klo: U32, +khi: U32, ts: l16_Withdrawal_TS) -> l16_Withdrawal_TS:
  match L:
    case 0n: ts
    case 1n+q:
      l16_Withdrawal_levels(hl, q, U32.shrn(klo, 1n), U32.shrn(khi, 1n), l16_Withdrawal_level(hl, U32.to_nat((U32.shrn(khi, 1n) - U32.shrn(klo, 1n) + 1 : U32)), U32.shrn(klo, 1n), ts))

def l16_Withdrawal_sweep(+hl: Nat, +d: Nat, +lo: U32, +hi: U32, +n: U32, +seg: U32, ts: l16_Withdrawal_TS) -> l16_Withdrawal_TS:
  l16_Withdrawal_levels(hl, d, (O.pow2u(d) + lo : U32), (O.pow2u(d) + hi : U32), l16_Withdrawal_leaves(hl, U32.to_nat((hi - lo + 1 : U32)), lo, n, seg, O.pow2u(d), ts))

def l16_Withdrawal_sweep_pick(+hl: Nat, some: Bool, +d: Nat, +lo: U32, +hi: U32, +n: U32, +seg: U32, ts: l16_Withdrawal_TS) -> l16_Withdrawal_TS:
  match some:
    case True{}: l16_Withdrawal_sweep(hl, d, lo, hi, n, seg, ts)
    case False{}: ts

def l16_Withdrawal_pad_go(+hl: Nat, +k: Nat, +lvl: U32, +r: D.Digest, pr: B.Buf & D.Digest) -> B.Buf & D.Digest:
  match k:
    case 0n:
      (h, +z) = pr
      (h, r)
    case 1n+q:
      (h, +z) = pr
      l16_Withdrawal_pad_go(hl, q, (lvl + 1 : U32), D.node(hl, r, z), (h, D.zconst(U32.to_nat((lvl + 1 : U32)))))

def l16_Withdrawal_croot_fin(+hl: Nat, +n: U32, +d: Nat, arr: Array<Withdrawal>, nodes: Array<D.Digest>, pr: B.Buf & D.Digest) -> B.Buf & (l16_Withdrawal_Cached & D.Digest):
  (h, +r) = pr
  (h, (l16_Withdrawal_Cached{arr, n, d, nodes, n, 0}, O.mix_len(hl, r, n)))

def l16_Withdrawal_croot_pad(+hl: Nat, +n: U32, +d: Nat, arr: Array<Withdrawal>, nodes: Array<D.Digest>, h: B.Buf, +r: D.Digest) -> B.Buf & (l16_Withdrawal_Cached & D.Digest):
  l16_Withdrawal_croot_fin(hl, n, d, arr, nodes, l16_Withdrawal_pad_go(hl, Nat.sub(4n, d), O.nat_u32(d), r, (h, D.zconst(d))))

def l16_Withdrawal_croot_read(+hl: Nat, +n: U32, +d: Nat, h: B.Buf, arr: Array<Withdrawal>, pr: Array<D.Digest> & D.Digest) -> B.Buf & (l16_Withdrawal_Cached & D.Digest):
  (nodes, +r) = pr
  l16_Withdrawal_croot_pad(hl, n, d, arr, nodes, h, r)

def l16_Withdrawal_croot_top(+hl: Nat, +n: U32, +d: Nat, ts: l16_Withdrawal_TS) -> B.Buf & (l16_Withdrawal_Cached & D.Digest):
  match ts:
    case l16_Withdrawal_TS{h, arr, nodes}: l16_Withdrawal_croot_read(hl, n, d, h, arr, Array.get(D.Digest, nodes, 1))

def l16_Withdrawal_cached_root(+hl: Nat, h: B.Buf, c: l16_Withdrawal_Cached, +seg: U32) -> B.Buf & (l16_Withdrawal_Cached & D.Digest):
  match c:
    case l16_Withdrawal_Cached{arr, +n, +d, nodes, +lo, +hi}:
      l16_Withdrawal_croot_top(hl, n, d, l16_Withdrawal_sweep_pick(hl, U32.is_le(lo, hi), d, lo, hi, n, seg, l16_Withdrawal_TS{h, arr, nodes}))

