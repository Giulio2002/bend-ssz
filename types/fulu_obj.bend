    case 1: b8_pw1(out, q, w0, w1)
    case 2: b8_pw2(out, q, w0, w1)
    case _: b8_pw3(out, q, w0, w1)

def b8_pwd(aligned: Bool, +s: U32, out: Array<U32>, +q: U32, +w0: U32, +w1: U32) -> Array<U32>:
