def BLSToExecutionChange_ok_at(buf: B.Buf, +off: U32) -> B.Buf & Bool: (buf, True{})

def BLSToExecutionChange_ok_len(ok: Bool, buf: B.Buf, +off: U32) -> B.Buf & Bool:
