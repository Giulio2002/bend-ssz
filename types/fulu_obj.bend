def PendingAttestation_get_data(o: PendingAttestation) -> PendingAttestation & AttestationData:
  match o:
    case PendingAttestation{aggregation_bits, +data, +inclusion_delay, +proposer_index}: (PendingAttestation{aggregation_bits, data, inclusion_delay, proposer_index}, data)

def PendingAttestation_set_data(o: PendingAttestation, +v: AttestationData) -> PendingAttestation:
  match o:
    case PendingAttestation{aggregation_bits, +data, +inclusion_delay, +proposer_index}: PendingAttestation{aggregation_bits, v, inclusion_delay, proposer_index}

def PendingAttestation_get_inclusion_delay(o: PendingAttestation) -> PendingAttestation & O.U64:
  match o:
