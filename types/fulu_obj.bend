    case SingleAttestation{+committee_index, +attester_index, +data, +signature}: SingleAttestation{committee_index, attester_index, v, signature}

def SingleAttestation_get_signature(o: SingleAttestation) -> SingleAttestation & Bytes96:
  match o:
    case SingleAttestation{+committee_index, +attester_index, +data, +signature}: (SingleAttestation{committee_index, attester_index, data, signature}, signature)

def SingleAttestation_set_signature(o: SingleAttestation, +v: Bytes96) -> SingleAttestation:
  match o:
    case SingleAttestation{+committee_index, +attester_index, +data, +signature}: SingleAttestation{committee_index, attester_index, data, v}

def SingleAttestation_force(o: SingleAttestation) -> U32:
  match o:
    case SingleAttestation{+committee_index, +attester_index, +data, +signature}: (u64_force(committee_index) .^. u64_force(attester_index) .^. AttestationData_force(data) .^. b96_force(signature) : U32)

def SingleAttestation_dump(o: SingleAttestation, t: +List<U32>) -> +List<U32>:
  match o:
    case SingleAttestation{+committee_index, +attester_index, +data, +signature}: u64_dump(committee_index, u64_dump(attester_index, AttestationData_dump(data, b96_dump(signature, t))))

def SingleAttestation_ok_at(buf: B.Buf, +off: U32) -> B.Buf & Bool: (buf, True{})

def SingleAttestation_ok_len(ok: Bool, buf: B.Buf, +off: U32) -> B.Buf & Bool:
  match ok:
    case True{}: SingleAttestation_ok_at(buf, off)
    case False{}: (buf, False{})

def SingleAttestation_ok(buf: B.Buf, +off: U32, +len: U32) -> B.Buf & Bool: SingleAttestation_ok_len(U32.is_eq(len, 240), buf, off)

def SingleAttestation_seed(+x: U32) -> SingleAttestation: SingleAttestation{u64_seed((x + 1 : U32)), u64_seed((x + 2 : U32)), AttestationData_seed((x + 3 : U32)), b96_seed((x + 4 : U32))}

def bits131072_default() -> O.Bits: O.Bits{Array.new(U32, 3n, 0), 0}

def bits131072_read(buf: B.Buf, +off: U32, +len: U32) -> B.Buf & O.Bits: O.bits_in(buf, off, len)

def bits131072_size(o: O.Bits) -> O.Bits & U32: O.bits_sizek(o)

def bits131072_put(out: Array<U32>, +pos: U32, o: O.Bits) -> Array<U32> & O.Bits: O.put_bits(out, pos, o)

def bits131072_putn(out: Array<U32>, +pos: U32, o: O.Bits) -> Array<U32> & (O.Bits & U32): O.put_bits_n(out, pos, o)

def bits131072_root(+hl: Nat, h: B.Buf, o: O.Bits, +seg: U32) -> B.Buf & (O.Bits & D.Digest): O.bits_root(hl, h, o, 9, seg)

def bits131072_force(o: O.Bits) -> O.Bits & U32: O.bits_size(o)

def bits131072_pk(out: Array<U32>, +pos: U32, pair: O.Bits & Bool) -> Array<U32> & (O.Bits & U32):
  (o, ok) = pair
  match ok:
    case True{}: bits131072_putn(out, pos, o)
    case False{}: (out, (o, 2147483648))

def bits131072_valid(o: O.Bits) -> O.Bits & Bool: O.bits_ok(o, 131072, False{})

def bits131072_putk(out: Array<U32>, +pos: U32, o: O.Bits) -> Array<U32> & (O.Bits & U32): bits131072_pk(out, pos, bits131072_valid(o))

def bits131072_dump(o: O.Bits, t: +List<U32>) -> +List<U32>: O.dump_bits_n(o, t)

def bits131072_ok(buf: B.Buf, +off: U32, +len: U32) -> B.Buf & Bool: O.ok_bitlist(buf, off, len, 131072, False{})

def bits131072_len(o: O.Bits) -> O.Bits & U32: O.bits_len(o)

def bits131072_some(pair: O.Bits & Bool) -> O.Bits & Maybe<&1, Bool>:
  (o, v) = pair
  (o, Some{v})

def bits131072_get_in(inside: Bool, o: O.Bits, +i: U32) -> O.Bits & Maybe<&1, Bool>:
  match inside:
    case True{}: bits131072_some(O.bits_get(o, i))
    case False{}: (o, None{})

def bits131072_get_n(+i: U32, pair: O.Bits & U32) -> O.Bits & Maybe<&1, Bool>:
  (o, +n) = pair
  bits131072_get_in(U32.is_lt(i, n), o, i)

def bits131072_get(o: O.Bits, +i: U32) -> O.Bits & Maybe<&1, Bool>: bits131072_get_n(i, O.bits_len(o))

def bits131072_put_at(ok: Bool, o: O.Bits, +i: U32, v: Bool) -> O.Bits & Bool:
  match ok:
    case True{}: (O.bits_set(o, i, v), True{})
    case False{}: (o, False{})

def bits131072_set_n(+i: U32, v: Bool, pair: O.Bits & U32) -> O.Bits & Bool:
  (o, +n) = pair
  bits131072_put_at(U32.is_lt(i, n), o, i, v)

def bits131072_set(o: O.Bits, +i: U32, v: Bool) -> O.Bits & Bool: bits131072_set_n(i, v, O.bits_len(o))

def bits131072_push(ok: Bool, o: O.Bits, v: Bool) -> O.Bits & Bool:
  match ok:
    case True{}: (O.bits_push(o, v), True{})
    case False{}: (o, False{})

def bits131072_app_n(v: Bool, pair: O.Bits & U32) -> O.Bits & Bool:
  (o, +n) = pair
  bits131072_push(U32.is_le((n + 1 : U32), 131072), o, v)

def bits131072_append(o: O.Bits, v: Bool) -> O.Bits & Bool: bits131072_app_n(v, O.bits_len(o))

def bv64_default() -> Bitvector64: Bitvector64{0, 0}

def bv64_r1(+off: U32, +w0: U32, pair: B.Buf & U32) -> B.Buf & Bitvector64:
  (buf, +x) = pair
  (buf, Bitvector64{w0, x})

def bv64_r0(+off: U32, pair: B.Buf & U32) -> B.Buf & Bitvector64:
  (buf, +x) = pair
  bv64_r1(off, x, B.read32(buf, (off + 4 : U32)))

def bv64_read(buf: B.Buf, +off: U32, +len: U32) -> B.Buf & Bitvector64: bv64_r0(off, B.read32(buf, off))

def bv64_pw0(out: Array<U32>, +q: U32, +w0: U32, +w1: U32) -> Array<U32>: Array.set(U32, Array.set(U32, out, (q + 0 : U32), w0), (q + 1 : U32), w1)

def bv64_pw1(out: Array<U32>, +q: U32, +w0: U32, +w1: U32) -> Array<U32>: O.or_skip(Array.set(U32, O.or_word(out, (q + 0 : U32), (w0 * 256 : U32)), (q + 1 : U32), ((w1 * 256 : U32) .|. U32.shrn(w0, 24n) : U32)), (q + 2 : U32), U32.shrn(w1, 24n))

def bv64_pw2(out: Array<U32>, +q: U32, +w0: U32, +w1: U32) -> Array<U32>: O.or_skip(Array.set(U32, O.or_word(out, (q + 0 : U32), (w0 * 65536 : U32)), (q + 1 : U32), ((w1 * 65536 : U32) .|. U32.shrn(w0, 16n) : U32)), (q + 2 : U32), U32.shrn(w1, 16n))

def bv64_pw3(out: Array<U32>, +q: U32, +w0: U32, +w1: U32) -> Array<U32>: O.or_skip(Array.set(U32, O.or_word(out, (q + 0 : U32), (w0 * 16777216 : U32)), (q + 1 : U32), ((w1 * 16777216 : U32) .|. U32.shrn(w0, 8n) : U32)), (q + 2 : U32), U32.shrn(w1, 8n))

def bv64_pwu(+s: U32, out: Array<U32>, +q: U32, +w0: U32, +w1: U32) -> Array<U32>:
  match s:
    case 1: bv64_pw1(out, q, w0, w1)
    case 2: bv64_pw2(out, q, w0, w1)
    case _: bv64_pw3(out, q, w0, w1)

def bv64_pwd(aligned: Bool, +s: U32, out: Array<U32>, +q: U32, +w0: U32, +w1: U32) -> Array<U32>:
  match aligned:
    case True{}: bv64_pw0(out, q, w0, w1)
    case False{}: bv64_pwu(s, out, q, w0, w1)

def bv64_put(out: Array<U32>, +pos: U32, o: Bitvector64) -> Array<U32>:
  match o:
    case Bitvector64{+w0, +w1}: bv64_pwd(U32.is_eq((pos .&. 3 : U32), 0), (pos .&. 3 : U32), out, U32.shrn(pos, 2n), w0, w1)

def bv64_root(+hl: Nat, h: B.Buf, o: Bitvector64, +seg: U32) -> B.Buf & D.Digest:
  match o:
    case Bitvector64{+w0, +w1}: (h, D.D{B.swap32(w0), B.swap32(w1), 0, 0, 0, 0, 0, 0})

def bv64_force(o: Bitvector64) -> U32:
  match o:
    case Bitvector64{+w0, +w1}: (w0 .^. w1 : U32)

def bv64_dump(o: Bitvector64, t: +List<U32>) -> +List<U32>:
  match o:
    case Bitvector64{+w0, +w1}: O.dump_le(w0, 4, O.dump_le(w1, 4, t))

def bv64_ok_at(buf: B.Buf, +off: U32) -> B.Buf & Bool: (buf, True{})

def bv64_ok_len(ok: Bool, buf: B.Buf, +off: U32) -> B.Buf & Bool:
  match ok:
    case True{}: bv64_ok_at(buf, off)
    case False{}: (buf, False{})

def bv64_ok(buf: B.Buf, +off: U32, +len: U32) -> B.Buf & Bool: bv64_ok_len(U32.is_eq(len, 8), buf, off)

def Bitvector64_wr1(+j: U32, +w0: U32, pair: O.Words & U32) -> O.Words & Bitvector64:
  (o, +x) = pair
  (o, Bitvector64{w0, x})

def Bitvector64_wr0(+j: U32, pair: O.Words & U32) -> O.Words & Bitvector64:
  (o, +x) = pair
  Bitvector64_wr1(j, x, O.words_word(o, (j + 1 : U32)))

def Bitvector64_of_words(o: O.Words, +p: U32) -> O.Words & Bitvector64: Bitvector64_wr0(U32.shrn(p, 2n), O.words_word(o, U32.shrn(p, 2n)))

def Bitvector64_into_words(o: O.Words, +p: U32, v: Bitvector64) -> O.Words:
  match v:
    case Bitvector64{+w0, +w1}: O.words_setw(O.words_setw(o, (U32.shrn(p, 2n) + 0 : U32), w0), (U32.shrn(p, 2n) + 1 : U32), w1)

def bv64_seed(+x: U32) -> Bitvector64: Bitvector64{(x + 0 : U32), (x + 1 : U32)}

type Attestation is Type:
  Attestation{aggregation_bits: O.Bits, data: AttestationData, signature: Bytes96, committee_bits: Bitvector64}

def Attestation_default() -> Attestation: Attestation{bits131072_default(), AttestationData_default(), b96_default(), bv64_default()}

def Attestation_rd4(+off: U32, +len: U32, +o_aggregation_bits: U32, aggregation_bits: O.Bits, +data: AttestationData, +signature: Bytes96, pair: B.Buf & Bitvector64) -> B.Buf & Attestation:
  (buf, +committee_bits) = pair
  (buf, Attestation{aggregation_bits, data, signature, committee_bits})

def Attestation_rd3(+off: U32, +len: U32, +o_aggregation_bits: U32, aggregation_bits: O.Bits, +data: AttestationData, pair: B.Buf & Bytes96) -> B.Buf & Attestation:
  (buf, +signature) = pair
  Attestation_rd4(off, len, o_aggregation_bits, aggregation_bits, data, signature, bv64_read(buf, (off + 228 : U32), 8))

def Attestation_rd2(+off: U32, +len: U32, +o_aggregation_bits: U32, aggregation_bits: O.Bits, pair: B.Buf & AttestationData) -> B.Buf & Attestation:
  (buf, +data) = pair
  Attestation_rd3(off, len, o_aggregation_bits, aggregation_bits, data, b96_read(buf, (off + 132 : U32), 96))

def Attestation_rd1(+off: U32, +len: U32, +o_aggregation_bits: U32, pair: B.Buf & O.Bits) -> B.Buf & Attestation:
  (buf, aggregation_bits) = pair
  Attestation_rd2(off, len, o_aggregation_bits, aggregation_bits, AttestationData_read(buf, (off + 4 : U32), 128))

def Attestation_rd0(+off: U32, +len: U32, pair: B.Buf & U32) -> B.Buf & Attestation:
  (buf, +o_aggregation_bits) = pair
  Attestation_rd1(off, len, o_aggregation_bits, bits131072_read(buf, (off + o_aggregation_bits : U32), (len - o_aggregation_bits : U32)))

def Attestation_read(buf: B.Buf, +off: U32, +len: U32) -> B.Buf & Attestation: Attestation_rd0(off, len, B.read32(buf, (off + 0 : U32)))

def Attestation_sz0(+data: AttestationData, +signature: Bytes96, +committee_bits: Bitvector64, +acc: U32, pair: O.Bits & U32) -> Attestation & U32:
  (aggregation_bits, +m) = pair
  (Attestation{aggregation_bits, data, signature, committee_bits}, O.padd(acc, m))

def Attestation_size(o: Attestation) -> Attestation & U32:
  match o:
    case Attestation{aggregation_bits, +data, +signature, +committee_bits}: Attestation_sz0(data, signature, committee_bits, 236, bits131072_size(aggregation_bits))

def bits131072_pvb(+cur: U32, pair: Array<U32> & (O.Bits & U32)) -> Array<U32> & (O.Bits & U32):
  (out, r) = pair
  (v, sz) = r
  (out, (v, O.padd(cur, sz)))

def bits131072_putv(out: Array<U32>, +pos: U32, +hoff: U32, +cur: U32, v: O.Bits) -> Array<U32> & (O.Bits & U32):
  bits131072_pvb(cur, bits131072_putk(O.w32(out, (pos + hoff : U32), cur), (pos + cur : U32), v))

def Attestation_pw0(+pos: U32, +data: AttestationData, +signature: Bytes96, +committee_bits: Bitvector64, pair: Array<U32> & (O.Bits & U32)) -> Array<U32> & (Attestation & U32):
  (out, r) = pair
  (aggregation_bits, c) = r
  (bv64_put(b96_put(AttestationData_put(out, (pos + 4 : U32), data), (pos + 132 : U32), signature), (pos + 228 : U32), committee_bits), (Attestation{aggregation_bits, data, signature, committee_bits}, c))

def Attestation_putn(out: Array<U32>, +pos: U32, o: Attestation) -> Array<U32> & (Attestation & U32):
  match o:
    case Attestation{aggregation_bits, +data, +signature, +committee_bits}: Attestation_pw0(pos, data, signature, committee_bits, bits131072_putv(out, pos, 0, 236, aggregation_bits))

def Attestation_putk(out: Array<U32>, +pos: U32, o: Attestation) -> Array<U32> & (Attestation & U32): Attestation_putn(out, pos, o)

def Attestation_put_drop_go(out: Array<U32>, v: Attestation, +m: U32) -> Array<U32> & Attestation: (out, v)

def Attestation_put_drop(pair: Array<U32> & (Attestation & U32)) -> Array<U32> & Attestation:
  (out, r) = pair
  (v, m) = r
  Attestation_put_drop_go(out, v, m)

def Attestation_put(out: Array<U32>, +pos: U32, o: Attestation) -> Array<U32> & Attestation: Attestation_put_drop(Attestation_putn(out, pos, o))

def Attestation_rt3(+hl: Nat, +seg: U32, aggregation_bits: O.Bits, +data: AttestationData, +signature: Bytes96, +committee_bits: Bitvector64, d_aggregation_bits: D.Digest, d_data: D.Digest, d_signature: D.Digest, pair: B.Buf & D.Digest) -> B.Buf & (Attestation & D.Digest):
  (h, d_committee_bits) = pair
  (h, (Attestation{aggregation_bits, data, signature, committee_bits}, D.node(hl, D.node(hl, d_aggregation_bits, d_data), D.node(hl, d_signature, d_committee_bits))))

def Attestation_rt2(+hl: Nat, +seg: U32, aggregation_bits: O.Bits, +data: AttestationData, +signature: Bytes96, +committee_bits: Bitvector64, d_aggregation_bits: D.Digest, d_data: D.Digest, pair: B.Buf & D.Digest) -> B.Buf & (Attestation & D.Digest):
  (h, d_signature) = pair
  Attestation_rt3(hl, seg, aggregation_bits, data, signature, committee_bits, d_aggregation_bits, d_data, d_signature, bv64_root(hl, h, committee_bits, seg))

def Attestation_rt1(+hl: Nat, +seg: U32, aggregation_bits: O.Bits, +data: AttestationData, +signature: Bytes96, +committee_bits: Bitvector64, d_aggregation_bits: D.Digest, pair: B.Buf & D.Digest) -> B.Buf & (Attestation & D.Digest):
  (h, d_data) = pair
  Attestation_rt2(hl, seg, aggregation_bits, data, signature, committee_bits, d_aggregation_bits, d_data, b96_root(hl, h, signature, seg))

def Attestation_rt0(+hl: Nat, +seg: U32, +data: AttestationData, +signature: Bytes96, +committee_bits: Bitvector64, pair: B.Buf & (O.Bits & D.Digest)) -> B.Buf & (Attestation & D.Digest):
  (h, r) = pair
  (aggregation_bits, d_aggregation_bits) = r
  Attestation_rt1(hl, seg, aggregation_bits, data, signature, committee_bits, d_aggregation_bits, AttestationData_root(hl, h, data, seg))

def Attestation_root(+hl: Nat, h: B.Buf, o: Attestation, +seg: U32) -> B.Buf & (Attestation & D.Digest):
  match o:
    case Attestation{aggregation_bits, +data, +signature, +committee_bits}: Attestation_rt0(hl, seg, data, signature, committee_bits, bits131072_root(hl, h, aggregation_bits, seg))

def Attestation_swap_aggregation_bits(o: Attestation, v: O.Bits) -> Attestation & O.Bits:
  match o:
    case Attestation{aggregation_bits, +data, +signature, +committee_bits}: (Attestation{v, data, signature, committee_bits}, aggregation_bits)

def Attestation_set_aggregation_bits(o: Attestation, v: O.Bits) -> Attestation:
  match o:
    case Attestation{aggregation_bits, +data, +signature, +committee_bits}: Attestation{v, data, signature, committee_bits}

def Attestation_get_data(o: Attestation) -> Attestation & AttestationData:
