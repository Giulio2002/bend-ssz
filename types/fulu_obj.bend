  (out, O.Words{ws, n})

def v7_b32_pw(aligned: Bool, out: Array<U32>, +pos: U32, ws: Array<U32>, +n: U32) -> Array<U32> & O.Words:
  match aligned:
    case True{}: v7_b32_pal(n, v7_b32_pa0(U32.shrn(pos, 2n), out, Array.get(U32, ws, 0)))
    case False{}: O.put_words(out, pos, O.Words{ws, n})

def v7_b32_put(out: Array<U32>, +pos: U32, o: O.Words) -> Array<U32> & O.Words:
  match o:
    case O.Words{ws, +n}: v7_b32_pw(U32.is_eq((pos .&. 3 : U32), 0), out, pos, ws, n)

