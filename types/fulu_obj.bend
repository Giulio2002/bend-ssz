type Checkpoint is Data:
  Checkpoint{epoch: O.U64, root: Bytes32}

def Checkpoint_default() -> Checkpoint: Checkpoint{u64_default(), b32_default()}

def Checkpoint_rd1(+off: U32, +len: U32, +epoch: O.U64, pair: B.Buf & Bytes32) -> B.Buf & Checkpoint:
  (buf, +root) = pair
  (buf, Checkpoint{epoch, root})

def Checkpoint_rd0(+off: U32, +len: U32, pair: B.Buf & O.U64) -> B.Buf & Checkpoint:
  (buf, +epoch) = pair
  Checkpoint_rd1(off, len, epoch, b32_read(buf, (off + 8 : U32), 32))

def Checkpoint_read(buf: B.Buf, +off: U32, +len: U32) -> B.Buf & Checkpoint: Checkpoint_rd0(off, len, u64_read(buf, (off + 0 : U32), 8))

def Checkpoint_put(out: Array<U32>, +pos: U32, o: Checkpoint) -> Array<U32>:
  match o:
    case Checkpoint{+epoch, +root}: b32_put(u64_put(out, (pos + 0 : U32), epoch), (pos + 8 : U32), root)

def Checkpoint_rt1(+hl: Nat, +seg: U32, +epoch: O.U64, +root: Bytes32, d_epoch: D.Digest, pair: B.Buf & D.Digest) -> B.Buf & D.Digest:
  (h, d_root) = pair
  (h, D.node(hl, d_epoch, d_root))

def Checkpoint_rt0(+hl: Nat, +seg: U32, +epoch: O.U64, +root: Bytes32, pair: B.Buf & D.Digest) -> B.Buf & D.Digest:
  (h, d_epoch) = pair
  Checkpoint_rt1(hl, seg, epoch, root, d_epoch, b32_root(hl, h, root, seg))

def Checkpoint_root(+hl: Nat, h: B.Buf, o: Checkpoint, +seg: U32) -> B.Buf & D.Digest:
  match o:
    case Checkpoint{+epoch, +root}: Checkpoint_rt0(hl, seg, epoch, root, u64_root(hl, h, epoch, seg))

def Checkpoint_get_epoch(o: Checkpoint) -> Checkpoint & O.U64:
  match o:
    case Checkpoint{+epoch, +root}: (Checkpoint{epoch, root}, epoch)

def Checkpoint_set_epoch(o: Checkpoint, +v: O.U64) -> Checkpoint:
  match o:
    case Checkpoint{+epoch, +root}: Checkpoint{v, root}

def Checkpoint_get_root(o: Checkpoint) -> Checkpoint & Bytes32:
  match o:
    case Checkpoint{+epoch, +root}: (Checkpoint{epoch, root}, root)

def Checkpoint_set_root(o: Checkpoint, +v: Bytes32) -> Checkpoint:
  match o:
    case Checkpoint{+epoch, +root}: Checkpoint{epoch, v}

def Checkpoint_force(o: Checkpoint) -> U32:
  match o:
    case Checkpoint{+epoch, +root}: (u64_force(epoch) .^. b32_force(root) : U32)

def Checkpoint_dump(o: Checkpoint, t: +List<U32>) -> +List<U32>:
  match o:
    case Checkpoint{+epoch, +root}: u64_dump(epoch, b32_dump(root, t))

def Checkpoint_ok_at(buf: B.Buf, +off: U32) -> B.Buf & Bool: (buf, True{})

def Checkpoint_ok_len(ok: Bool, buf: B.Buf, +off: U32) -> B.Buf & Bool:
  match ok:
    case True{}: Checkpoint_ok_at(buf, off)
    case False{}: (buf, False{})

def Checkpoint_ok(buf: B.Buf, +off: U32, +len: U32) -> B.Buf & Bool: Checkpoint_ok_len(U32.is_eq(len, 40), buf, off)

def Checkpoint_seed(+x: U32) -> Checkpoint: Checkpoint{u64_seed((x + 1 : U32)), b32_seed((x + 2 : U32))}

type AttestationData is Data:
  AttestationData{slot: O.U64, index: O.U64, beacon_block_root: Bytes32, source: Checkpoint, target: Checkpoint}

def AttestationData_default() -> AttestationData: AttestationData{u64_default(), u64_default(), b32_default(), Checkpoint_default(), Checkpoint_default()}

def AttestationData_rd4(+off: U32, +len: U32, +slot: O.U64, +index: O.U64, +beacon_block_root: Bytes32, +source: Checkpoint, pair: B.Buf & Checkpoint) -> B.Buf & AttestationData:
  (buf, +target) = pair
  (buf, AttestationData{slot, index, beacon_block_root, source, target})

def AttestationData_rd3(+off: U32, +len: U32, +slot: O.U64, +index: O.U64, +beacon_block_root: Bytes32, pair: B.Buf & Checkpoint) -> B.Buf & AttestationData:
  (buf, +source) = pair
  AttestationData_rd4(off, len, slot, index, beacon_block_root, source, Checkpoint_read(buf, (off + 88 : U32), 40))

def AttestationData_rd2(+off: U32, +len: U32, +slot: O.U64, +index: O.U64, pair: B.Buf & Bytes32) -> B.Buf & AttestationData:
  (buf, +beacon_block_root) = pair
  AttestationData_rd3(off, len, slot, index, beacon_block_root, Checkpoint_read(buf, (off + 48 : U32), 40))

def AttestationData_rd1(+off: U32, +len: U32, +slot: O.U64, pair: B.Buf & O.U64) -> B.Buf & AttestationData:
  (buf, +index) = pair
  AttestationData_rd2(off, len, slot, index, b32_read(buf, (off + 16 : U32), 32))

def AttestationData_rd0(+off: U32, +len: U32, pair: B.Buf & O.U64) -> B.Buf & AttestationData:
  (buf, +slot) = pair
  AttestationData_rd1(off, len, slot, u64_read(buf, (off + 8 : U32), 8))

def AttestationData_read(buf: B.Buf, +off: U32, +len: U32) -> B.Buf & AttestationData: AttestationData_rd0(off, len, u64_read(buf, (off + 0 : U32), 8))

def AttestationData_put(out: Array<U32>, +pos: U32, o: AttestationData) -> Array<U32>:
  match o:
    case AttestationData{+slot, +index, +beacon_block_root, +source, +target}: Checkpoint_put(Checkpoint_put(b32_put(u64_put(u64_put(out, (pos + 0 : U32), slot), (pos + 8 : U32), index), (pos + 16 : U32), beacon_block_root), (pos + 48 : U32), source), (pos + 88 : U32), target)

def AttestationData_rt5(+hl: Nat, +seg: U32, +slot: O.U64, +index: O.U64, +beacon_block_root: Bytes32, +source: Checkpoint, +target: Checkpoint, d_slot: D.Digest, d_index: D.Digest, d_beacon_block_root: D.Digest, d_source: D.Digest, d_target: D.Digest, pair: B.Buf & D.Digest) -> B.Buf & D.Digest:
  (h, z1) = pair
  (h, D.node(hl, D.node(hl, D.node(hl, d_slot, d_index), D.node(hl, d_beacon_block_root, d_source)), D.node(hl, D.node(hl, d_target, D.zero()), z1)))

def AttestationData_rt4(+hl: Nat, +seg: U32, +slot: O.U64, +index: O.U64, +beacon_block_root: Bytes32, +source: Checkpoint, +target: Checkpoint, d_slot: D.Digest, d_index: D.Digest, d_beacon_block_root: D.Digest, d_source: D.Digest, pair: B.Buf & D.Digest) -> B.Buf & D.Digest:
  (h, d_target) = pair
  AttestationData_rt5(hl, seg, slot, index, beacon_block_root, source, target, d_slot, d_index, d_beacon_block_root, d_source, d_target, (h, D.zconst(1n)))

def AttestationData_rt3(+hl: Nat, +seg: U32, +slot: O.U64, +index: O.U64, +beacon_block_root: Bytes32, +source: Checkpoint, +target: Checkpoint, d_slot: D.Digest, d_index: D.Digest, d_beacon_block_root: D.Digest, pair: B.Buf & D.Digest) -> B.Buf & D.Digest:
  (h, d_source) = pair
  AttestationData_rt4(hl, seg, slot, index, beacon_block_root, source, target, d_slot, d_index, d_beacon_block_root, d_source, Checkpoint_root(hl, h, target, seg))

def AttestationData_rt2(+hl: Nat, +seg: U32, +slot: O.U64, +index: O.U64, +beacon_block_root: Bytes32, +source: Checkpoint, +target: Checkpoint, d_slot: D.Digest, d_index: D.Digest, pair: B.Buf & D.Digest) -> B.Buf & D.Digest:
  (h, d_beacon_block_root) = pair
