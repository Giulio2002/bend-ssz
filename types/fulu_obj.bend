def SignedAggregateAndProof_dump(o: SignedAggregateAndProof, t: +List<U32>) -> +List<U32>:
  match o:
    case SignedAggregateAndProof{message, +signature}: AggregateAndProof_dump(message, b96_dump(signature, t))

def SignedAggregateAndProof_c1(ok: Bool, buf: B.Buf, +off: U32, +len: U32, +o0: U32) -> B.Buf & Bool:
  match ok:
    case True{}: (buf, True{})
    case False{}: (buf, False{})

def SignedAggregateAndProof_v1(+off: U32, +len: U32, +o0: U32, pair: B.Buf & Bool) -> B.Buf & Bool:
  (buf, ok) = pair
  SignedAggregateAndProof_c1(ok, buf, off, len, o0)

def SignedAggregateAndProof_c0(ok: Bool, buf: B.Buf, +off: U32, +len: U32, +o0: U32) -> B.Buf & Bool:
  match ok:
    case True{}: SignedAggregateAndProof_v1(off, len, o0, AggregateAndProof_ok(buf, (off + o0 : U32), (len - o0 : U32)))
    case False{}: (buf, False{})

def SignedAggregateAndProof_v0(+off: U32, +len: U32, pair: B.Buf & U32) -> B.Buf & Bool:
  (buf, +o0) = pair
  SignedAggregateAndProof_c0(U32.is_eq(o0, 100), buf, off, len, o0)

def SignedAggregateAndProof_ok_len(ok: Bool, buf: B.Buf, +off: U32, +len: U32) -> B.Buf & Bool:
  match ok:
    case True{}: SignedAggregateAndProof_v0(off, len, B.read32(buf, (off + 0 : U32)))
    case False{}: (buf, False{})

def SignedAggregateAndProof_ok(buf: B.Buf, +off: U32, +len: U32) -> B.Buf & Bool: SignedAggregateAndProof_ok_len(U32.is_le(100, len), buf, off, len)

def bits2048_default() -> O.Bits: O.Bits{Array.new(U32, 3n, 0), 0}

def bits2048_read(buf: B.Buf, +off: U32, +len: U32) -> B.Buf & O.Bits: O.bits_in(buf, off, len)

def bits2048_size(o: O.Bits) -> O.Bits & U32: O.bits_sizek(o)

def bits2048_put(out: Array<U32>, +pos: U32, o: O.Bits) -> Array<U32> & O.Bits: O.put_bits(out, pos, o)

def bits2048_putn(out: Array<U32>, +pos: U32, o: O.Bits) -> Array<U32> & (O.Bits & U32): O.put_bits_n(out, pos, o)

def bits2048_root(+hl: Nat, h: B.Buf, o: O.Bits, +seg: U32) -> B.Buf & (O.Bits & D.Digest): O.bits_root(hl, h, o, 3, seg)

def bits2048_force(o: O.Bits) -> O.Bits & U32: O.bits_size(o)

def bits2048_pk(out: Array<U32>, +pos: U32, pair: O.Bits & Bool) -> Array<U32> & (O.Bits & U32):
  (o, ok) = pair
  match ok:
    case True{}: bits2048_putn(out, pos, o)
    case False{}: (out, (o, 2147483648))

def bits2048_valid(o: O.Bits) -> O.Bits & Bool: O.bits_ok(o, 2048, False{})

def bits2048_putk(out: Array<U32>, +pos: U32, o: O.Bits) -> Array<U32> & (O.Bits & U32): bits2048_pk(out, pos, bits2048_valid(o))

def bits2048_dump(o: O.Bits, t: +List<U32>) -> +List<U32>: O.dump_bits_n(o, t)

def bits2048_ok(buf: B.Buf, +off: U32, +len: U32) -> B.Buf & Bool: O.ok_bitlist(buf, off, len, 2048, False{})

def bits2048_len(o: O.Bits) -> O.Bits & U32: O.bits_len(o)

def bits2048_some(pair: O.Bits & Bool) -> O.Bits & Maybe<&1, Bool>:
  (o, v) = pair
  (o, Some{v})

def bits2048_get_in(inside: Bool, o: O.Bits, +i: U32) -> O.Bits & Maybe<&1, Bool>:
  match inside:
    case True{}: bits2048_some(O.bits_get(o, i))
    case False{}: (o, None{})

def bits2048_get_n(+i: U32, pair: O.Bits & U32) -> O.Bits & Maybe<&1, Bool>:
  (o, +n) = pair
  bits2048_get_in(U32.is_lt(i, n), o, i)

def bits2048_get(o: O.Bits, +i: U32) -> O.Bits & Maybe<&1, Bool>: bits2048_get_n(i, O.bits_len(o))

def bits2048_put_at(ok: Bool, o: O.Bits, +i: U32, v: Bool) -> O.Bits & Bool:
  match ok:
    case True{}: (O.bits_set(o, i, v), True{})
    case False{}: (o, False{})

def bits2048_set_n(+i: U32, v: Bool, pair: O.Bits & U32) -> O.Bits & Bool:
  (o, +n) = pair
  bits2048_put_at(U32.is_lt(i, n), o, i, v)

def bits2048_set(o: O.Bits, +i: U32, v: Bool) -> O.Bits & Bool: bits2048_set_n(i, v, O.bits_len(o))

def bits2048_push(ok: Bool, o: O.Bits, v: Bool) -> O.Bits & Bool:
  match ok:
    case True{}: (O.bits_push(o, v), True{})
    case False{}: (o, False{})

def bits2048_app_n(v: Bool, pair: O.Bits & U32) -> O.Bits & Bool:
  (o, +n) = pair
  bits2048_push(U32.is_le((n + 1 : U32), 2048), o, v)

def bits2048_append(o: O.Bits, v: Bool) -> O.Bits & Bool: bits2048_app_n(v, O.bits_len(o))

type PendingAttestation is Type:
  PendingAttestation{aggregation_bits: O.Bits, data: AttestationData, inclusion_delay: O.U64, proposer_index: O.U64}

def PendingAttestation_default() -> PendingAttestation: PendingAttestation{bits2048_default(), AttestationData_default(), u64_default(), u64_default()}

def PendingAttestation_rd4(+off: U32, +len: U32, +o_aggregation_bits: U32, aggregation_bits: O.Bits, +data: AttestationData, +inclusion_delay: O.U64, pair: B.Buf & O.U64) -> B.Buf & PendingAttestation:
  (buf, +proposer_index) = pair
  (buf, PendingAttestation{aggregation_bits, data, inclusion_delay, proposer_index})

def PendingAttestation_rd3(+off: U32, +len: U32, +o_aggregation_bits: U32, aggregation_bits: O.Bits, +data: AttestationData, pair: B.Buf & O.U64) -> B.Buf & PendingAttestation:
  (buf, +inclusion_delay) = pair
  PendingAttestation_rd4(off, len, o_aggregation_bits, aggregation_bits, data, inclusion_delay, u64_read(buf, (off + 140 : U32), 8))

def PendingAttestation_rd2(+off: U32, +len: U32, +o_aggregation_bits: U32, aggregation_bits: O.Bits, pair: B.Buf & AttestationData) -> B.Buf & PendingAttestation:
  (buf, +data) = pair
  PendingAttestation_rd3(off, len, o_aggregation_bits, aggregation_bits, data, u64_read(buf, (off + 132 : U32), 8))

def PendingAttestation_rd1(+off: U32, +len: U32, +o_aggregation_bits: U32, pair: B.Buf & O.Bits) -> B.Buf & PendingAttestation:
  (buf, aggregation_bits) = pair
  PendingAttestation_rd2(off, len, o_aggregation_bits, aggregation_bits, AttestationData_read(buf, (off + 4 : U32), 128))

def PendingAttestation_rd0(+off: U32, +len: U32, pair: B.Buf & U32) -> B.Buf & PendingAttestation:
  (buf, +o_aggregation_bits) = pair
  PendingAttestation_rd1(off, len, o_aggregation_bits, bits2048_read(buf, (off + o_aggregation_bits : U32), (len - o_aggregation_bits : U32)))

def PendingAttestation_read(buf: B.Buf, +off: U32, +len: U32) -> B.Buf & PendingAttestation: PendingAttestation_rd0(off, len, B.read32(buf, (off + 0 : U32)))

def PendingAttestation_sz0(+data: AttestationData, +inclusion_delay: O.U64, +proposer_index: O.U64, +acc: U32, pair: O.Bits & U32) -> PendingAttestation & U32:
  (aggregation_bits, +m) = pair
  (PendingAttestation{aggregation_bits, data, inclusion_delay, proposer_index}, O.padd(acc, m))

def PendingAttestation_size(o: PendingAttestation) -> PendingAttestation & U32:
  match o:
    case PendingAttestation{aggregation_bits, +data, +inclusion_delay, +proposer_index}: PendingAttestation_sz0(data, inclusion_delay, proposer_index, 148, bits2048_size(aggregation_bits))

def bits2048_pvb(+cur: U32, pair: Array<U32> & (O.Bits & U32)) -> Array<U32> & (O.Bits & U32):
  (out, r) = pair
  (v, sz) = r
  (out, (v, O.padd(cur, sz)))

def bits2048_putv(out: Array<U32>, +pos: U32, +hoff: U32, +cur: U32, v: O.Bits) -> Array<U32> & (O.Bits & U32):
  bits2048_pvb(cur, bits2048_putk(O.w32(out, (pos + hoff : U32), cur), (pos + cur : U32), v))

def PendingAttestation_pw0(+pos: U32, +data: AttestationData, +inclusion_delay: O.U64, +proposer_index: O.U64, pair: Array<U32> & (O.Bits & U32)) -> Array<U32> & (PendingAttestation & U32):
  (out, r) = pair
  (aggregation_bits, c) = r
  (u64_put(u64_put(AttestationData_put(out, (pos + 4 : U32), data), (pos + 132 : U32), inclusion_delay), (pos + 140 : U32), proposer_index), (PendingAttestation{aggregation_bits, data, inclusion_delay, proposer_index}, c))

def PendingAttestation_putn(out: Array<U32>, +pos: U32, o: PendingAttestation) -> Array<U32> & (PendingAttestation & U32):
  match o:
    case PendingAttestation{aggregation_bits, +data, +inclusion_delay, +proposer_index}: PendingAttestation_pw0(pos, data, inclusion_delay, proposer_index, bits2048_putv(out, pos, 0, 148, aggregation_bits))

def PendingAttestation_putk(out: Array<U32>, +pos: U32, o: PendingAttestation) -> Array<U32> & (PendingAttestation & U32): PendingAttestation_putn(out, pos, o)

def PendingAttestation_put_drop_go(out: Array<U32>, v: PendingAttestation, +m: U32) -> Array<U32> & PendingAttestation: (out, v)

def PendingAttestation_put_drop(pair: Array<U32> & (PendingAttestation & U32)) -> Array<U32> & PendingAttestation:
  (out, r) = pair
  (v, m) = r
  PendingAttestation_put_drop_go(out, v, m)

def PendingAttestation_put(out: Array<U32>, +pos: U32, o: PendingAttestation) -> Array<U32> & PendingAttestation: PendingAttestation_put_drop(PendingAttestation_putn(out, pos, o))

def PendingAttestation_rt3(+hl: Nat, +seg: U32, aggregation_bits: O.Bits, +data: AttestationData, +inclusion_delay: O.U64, +proposer_index: O.U64, d_aggregation_bits: D.Digest, d_data: D.Digest, d_inclusion_delay: D.Digest, pair: B.Buf & D.Digest) -> B.Buf & (PendingAttestation & D.Digest):
  (h, d_proposer_index) = pair
  (h, (PendingAttestation{aggregation_bits, data, inclusion_delay, proposer_index}, D.node(hl, D.node(hl, d_aggregation_bits, d_data), D.node(hl, d_inclusion_delay, d_proposer_index))))

def PendingAttestation_rt2(+hl: Nat, +seg: U32, aggregation_bits: O.Bits, +data: AttestationData, +inclusion_delay: O.U64, +proposer_index: O.U64, d_aggregation_bits: D.Digest, d_data: D.Digest, pair: B.Buf & D.Digest) -> B.Buf & (PendingAttestation & D.Digest):
  (h, d_inclusion_delay) = pair
  PendingAttestation_rt3(hl, seg, aggregation_bits, data, inclusion_delay, proposer_index, d_aggregation_bits, d_data, d_inclusion_delay, u64_root(hl, h, proposer_index, seg))

def PendingAttestation_rt1(+hl: Nat, +seg: U32, aggregation_bits: O.Bits, +data: AttestationData, +inclusion_delay: O.U64, +proposer_index: O.U64, d_aggregation_bits: D.Digest, pair: B.Buf & D.Digest) -> B.Buf & (PendingAttestation & D.Digest):
  (h, d_data) = pair
  PendingAttestation_rt2(hl, seg, aggregation_bits, data, inclusion_delay, proposer_index, d_aggregation_bits, d_data, u64_root(hl, h, inclusion_delay, seg))

def PendingAttestation_rt0(+hl: Nat, +seg: U32, +data: AttestationData, +inclusion_delay: O.U64, +proposer_index: O.U64, pair: B.Buf & (O.Bits & D.Digest)) -> B.Buf & (PendingAttestation & D.Digest):
  (h, r) = pair
  (aggregation_bits, d_aggregation_bits) = r
  PendingAttestation_rt1(hl, seg, aggregation_bits, data, inclusion_delay, proposer_index, d_aggregation_bits, AttestationData_root(hl, h, data, seg))

def PendingAttestation_root(+hl: Nat, h: B.Buf, o: PendingAttestation, +seg: U32) -> B.Buf & (PendingAttestation & D.Digest):
  match o:
    case PendingAttestation{aggregation_bits, +data, +inclusion_delay, +proposer_index}: PendingAttestation_rt0(hl, seg, data, inclusion_delay, proposer_index, bits2048_root(hl, h, aggregation_bits, seg))

def PendingAttestation_swap_aggregation_bits(o: PendingAttestation, v: O.Bits) -> PendingAttestation & O.Bits:
  match o:
    case PendingAttestation{aggregation_bits, +data, +inclusion_delay, +proposer_index}: (PendingAttestation{v, data, inclusion_delay, proposer_index}, aggregation_bits)

def PendingAttestation_set_aggregation_bits(o: PendingAttestation, v: O.Bits) -> PendingAttestation:
