  ExecutionRequests_c4(ok, buf, off, len, o0, o1, o2)

def ExecutionRequests_c3(ok: Bool, buf: B.Buf, +off: U32, +len: U32, +o0: U32, +o1: U32, +o2: U32) -> B.Buf & Bool:
  match ok:
    case True{}: ExecutionRequests_v4(off, len, o0, o1, o2, l16_WithdrawalRequest_ok(buf, (off + o1 : U32), (o2 - o1 : U32)))
    case False{}: (buf, False{})

def ExecutionRequests_v3(+off: U32, +len: U32, +o0: U32, +o1: U32, +o2: U32, pair: B.Buf & Bool) -> B.Buf & Bool:
