  (state_roots, d_state_roots) = r
  (h, (HistoricalBatch{block_roots, state_roots}, D.node(hl, d_block_roots, d_state_roots)))

def HistoricalBatch_rt0(+hl: Nat, +seg: U32, state_roots: O.Words, pair: B.Buf & (O.Words & D.Digest)) -> B.Buf & (HistoricalBatch & D.Digest):
  (h, r) = pair
  (block_roots, d_block_roots) = r
  HistoricalBatch_rt1(hl, seg, block_roots, d_block_roots, v8192_b32_root(hl, h, state_roots, seg))

def HistoricalBatch_root(+hl: Nat, h: B.Buf, o: HistoricalBatch, +seg: U32) -> B.Buf & (HistoricalBatch & D.Digest):
