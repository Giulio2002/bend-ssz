def PendingAttestation_fo0(+data: AttestationData, +inclusion_delay: O.U64, +proposer_index: O.U64, +acc: U32, pair: O.Bits & U32) -> PendingAttestation & U32:
  (aggregation_bits, +x) = pair
  (PendingAttestation{aggregation_bits, data, inclusion_delay, proposer_index}, (acc .^. x : U32))

def PendingAttestation_force(o: PendingAttestation) -> PendingAttestation & U32:
  match o:
    case PendingAttestation{aggregation_bits, +data, +inclusion_delay, +proposer_index}: PendingAttestation_fo0(data, inclusion_delay, proposer_index, (AttestationData_force(data) .^. u64_force(inclusion_delay) .^. u64_force(proposer_index) : U32), bits2048_force(aggregation_bits))

def PendingAttestation_dump(o: PendingAttestation, t: +List<U32>) -> +List<U32>:
  match o:
    case PendingAttestation{aggregation_bits, +data, +inclusion_delay, +proposer_index}: bits2048_dump(aggregation_bits, AttestationData_dump(data, u64_dump(inclusion_delay, u64_dump(proposer_index, t))))

def PendingAttestation_c1(ok: Bool, buf: B.Buf, +off: U32, +len: U32, +o0: U32) -> B.Buf & Bool:
  match ok:
    case True{}: (buf, True{})
    case False{}: (buf, False{})

def PendingAttestation_v1(+off: U32, +len: U32, +o0: U32, pair: B.Buf & Bool) -> B.Buf & Bool:
