    case False{}: (l1_AttesterSlashing_Cached{arr, n, d, nodes, lo, hi}, False{})

def l1_AttesterSlashing_capp(c: l1_AttesterSlashing_Cached, v: AttesterSlashing) -> l1_AttesterSlashing_Cached & Bool:
  match c:
    case l1_AttesterSlashing_Cached{arr, +n, +d, nodes, +lo, +hi}: l1_AttesterSlashing_capp_in(U32.is_le((n + 1 : U32), 1), arr, n, d, nodes, lo, hi, v)

def l1_AttesterSlashing_ts_store(ts: l1_AttesterSlashing_TS, +k: U32, +dg: D.Digest) -> l1_AttesterSlashing_TS:
  match ts:
    case l1_AttesterSlashing_TS{h, arr, nodes}: l1_AttesterSlashing_TS{h, arr, Array.set(D.Digest, nodes, k, dg)}

def l1_AttesterSlashing_leaf_put(+k: U32, h: B.Buf, arr: Array<O.Boxed<AttesterSlashing>>, nodes: Array<D.Digest>, +dg: D.Digest) -> l1_AttesterSlashing_TS:
  l1_AttesterSlashing_ts_store(l1_AttesterSlashing_TS{h, arr, nodes}, k, dg)

def l1_AttesterSlashing_leaf_fin(+k: U32, +i: U32, arr: Array<O.Boxed<AttesterSlashing>>, nodes: Array<D.Digest>, pr: B.Buf & (O.Boxed<AttesterSlashing> & D.Digest)) -> l1_AttesterSlashing_TS:
  (h, r) = pr
  (v, dg) = r
  l1_AttesterSlashing_leaf_put(k, h, Array.set(O.Boxed<AttesterSlashing>, arr, i, v), nodes, dg)

def l1_AttesterSlashing_leaf_go(+hl: Nat, +k: U32, +i: U32, +seg: U32, nodes: Array<D.Digest>, h: B.Buf, pr: Array<O.Boxed<AttesterSlashing>> & O.Boxed<AttesterSlashing>) -> l1_AttesterSlashing_TS:
  (arr, v) = pr
  l1_AttesterSlashing_leaf_fin(k, i, arr, nodes, AttesterSlashing_bx_root(hl, h, v, (seg + 64 : U32)))

def l1_AttesterSlashing_leaf_hash(+hl: Nat, +k: U32, +i: U32, +seg: U32, ts: l1_AttesterSlashing_TS) -> l1_AttesterSlashing_TS:
  match ts:
    case l1_AttesterSlashing_TS{h, arr, nodes}: l1_AttesterSlashing_leaf_go(hl, k, i, seg, nodes, h, Array.swap(O.Boxed<AttesterSlashing>, arr, i, O.BNone{}))

def l1_AttesterSlashing_leaf_step(+hl: Nat, inside: Bool, +k: U32, +i: U32, +seg: U32, ts: l1_AttesterSlashing_TS) -> l1_AttesterSlashing_TS:
  match inside:
    case True{}: l1_AttesterSlashing_leaf_hash(hl, k, i, seg, ts)
    case False{}: l1_AttesterSlashing_ts_store(ts, k, D.zero())

def l1_AttesterSlashing_leaves(+hl: Nat, +q: Nat, +i: U32, +n: U32, +seg: U32, +cap: U32, ts: l1_AttesterSlashing_TS) -> l1_AttesterSlashing_TS:
  match q:
    case 0n: ts
    case 1n+r:
      l1_AttesterSlashing_leaves(hl, r, (i + 1 : U32), n, seg, cap, l1_AttesterSlashing_leaf_step(hl, U32.is_lt(i, n), (cap + i : U32), i, seg, ts))

def l1_AttesterSlashing_node_fin(+hl: Nat, +j: U32, h: B.Buf, arr: Array<O.Boxed<AttesterSlashing>>, +dl: D.Digest, pr: Array<D.Digest> & D.Digest) -> l1_AttesterSlashing_TS:
  (nodes, +dr) = pr
  l1_AttesterSlashing_ts_store(l1_AttesterSlashing_TS{h, arr, nodes}, j, D.node(hl, dl, dr))

def l1_AttesterSlashing_node_go(+hl: Nat, +j: U32, h: B.Buf, arr: Array<O.Boxed<AttesterSlashing>>, pr: Array<D.Digest> & D.Digest) -> l1_AttesterSlashing_TS:
  (nodes, +dl) = pr
  l1_AttesterSlashing_node_fin(hl, j, h, arr, dl, Array.get(D.Digest, nodes, (2 * j + 1 : U32)))

def l1_AttesterSlashing_node_step(+hl: Nat, +j: U32, ts: l1_AttesterSlashing_TS) -> l1_AttesterSlashing_TS:
  match ts:
    case l1_AttesterSlashing_TS{h, arr, nodes}: l1_AttesterSlashing_node_go(hl, j, h, arr, Array.get(D.Digest, nodes, (2 * j : U32)))

def l1_AttesterSlashing_level(+hl: Nat, +q: Nat, +j: U32, ts: l1_AttesterSlashing_TS) -> l1_AttesterSlashing_TS:
  match q:
    case 0n: ts
    case 1n+r: l1_AttesterSlashing_level(hl, r, (j + 1 : U32), l1_AttesterSlashing_node_step(hl, j, ts))

def l1_AttesterSlashing_levels(+hl: Nat, +L: Nat, +klo: U32, +khi: U32, ts: l1_AttesterSlashing_TS) -> l1_AttesterSlashing_TS:
  match L:
    case 0n: ts
    case 1n+q:
      l1_AttesterSlashing_levels(hl, q, U32.shrn(klo, 1n), U32.shrn(khi, 1n), l1_AttesterSlashing_level(hl, U32.to_nat((U32.shrn(khi, 1n) - U32.shrn(klo, 1n) + 1 : U32)), U32.shrn(klo, 1n), ts))

def l1_AttesterSlashing_sweep(+hl: Nat, +d: Nat, +lo: U32, +hi: U32, +n: U32, +seg: U32, ts: l1_AttesterSlashing_TS) -> l1_AttesterSlashing_TS:
  l1_AttesterSlashing_levels(hl, d, (O.pow2u(d) + lo : U32), (O.pow2u(d) + hi : U32), l1_AttesterSlashing_leaves(hl, U32.to_nat((hi - lo + 1 : U32)), lo, n, seg, O.pow2u(d), ts))

def l1_AttesterSlashing_sweep_pick(+hl: Nat, some: Bool, +d: Nat, +lo: U32, +hi: U32, +n: U32, +seg: U32, ts: l1_AttesterSlashing_TS) -> l1_AttesterSlashing_TS:
  match some:
    case True{}: l1_AttesterSlashing_sweep(hl, d, lo, hi, n, seg, ts)
    case False{}: ts

def l1_AttesterSlashing_pad_go(+hl: Nat, +k: Nat, +lvl: U32, +r: D.Digest, pr: B.Buf & D.Digest) -> B.Buf & D.Digest:
  match k:
    case 0n:
      (h, +z) = pr
      (h, r)
    case 1n+q:
      (h, +z) = pr
      l1_AttesterSlashing_pad_go(hl, q, (lvl + 1 : U32), D.node(hl, r, z), (h, D.zconst(U32.to_nat((lvl + 1 : U32)))))

def l1_AttesterSlashing_croot_fin(+hl: Nat, +n: U32, +d: Nat, arr: Array<O.Boxed<AttesterSlashing>>, nodes: Array<D.Digest>, pr: B.Buf & D.Digest) -> B.Buf & (l1_AttesterSlashing_Cached & D.Digest):
  (h, +r) = pr
  (h, (l1_AttesterSlashing_Cached{arr, n, d, nodes, n, 0}, O.mix_len(hl, r, n)))

def l1_AttesterSlashing_croot_pad(+hl: Nat, +n: U32, +d: Nat, arr: Array<O.Boxed<AttesterSlashing>>, nodes: Array<D.Digest>, h: B.Buf, +r: D.Digest) -> B.Buf & (l1_AttesterSlashing_Cached & D.Digest):
  l1_AttesterSlashing_croot_fin(hl, n, d, arr, nodes, l1_AttesterSlashing_pad_go(hl, Nat.sub(0n, d), O.nat_u32(d), r, (h, D.zconst(d))))

def l1_AttesterSlashing_croot_read(+hl: Nat, +n: U32, +d: Nat, h: B.Buf, arr: Array<O.Boxed<AttesterSlashing>>, pr: Array<D.Digest> & D.Digest) -> B.Buf & (l1_AttesterSlashing_Cached & D.Digest):
  (nodes, +r) = pr
  l1_AttesterSlashing_croot_pad(hl, n, d, arr, nodes, h, r)

def l1_AttesterSlashing_croot_top(+hl: Nat, +n: U32, +d: Nat, ts: l1_AttesterSlashing_TS) -> B.Buf & (l1_AttesterSlashing_Cached & D.Digest):
  match ts:
    case l1_AttesterSlashing_TS{h, arr, nodes}: l1_AttesterSlashing_croot_read(hl, n, d, h, arr, Array.get(D.Digest, nodes, 1))

def l1_AttesterSlashing_cached_root(+hl: Nat, h: B.Buf, c: l1_AttesterSlashing_Cached, +seg: U32) -> B.Buf & (l1_AttesterSlashing_Cached & D.Digest):
  match c:
    case l1_AttesterSlashing_Cached{arr, +n, +d, nodes, +lo, +hi}:
      l1_AttesterSlashing_croot_top(hl, n, d, l1_AttesterSlashing_sweep_pick(hl, U32.is_le(lo, hi), d, lo, hi, n, seg, l1_AttesterSlashing_TS{h, arr, nodes}))

type l8_Attestation_Seq is Type:
  l8_Attestation_Seq{items: Array<O.Boxed<Attestation>>, n: U32}

def l8_Attestation_fill(+d: Nat) -> Array<O.Boxed<Attestation>>:
  match d:
    case 0n: ALeaf{O.BNone{}}
    case 1n+q: ANode{l8_Attestation_fill(q), l8_Attestation_fill(q)}

def l8_Attestation_cap(+n: U32) -> Nat: B.words_depth(n)

def l8_Attestation_default() -> l8_Attestation_Seq: l8_Attestation_Seq{l8_Attestation_fill(0n), 0}

def l8_Attestation_win_end(+s: U32, pair: B.Buf & U32) -> B.Buf & (U32 & U32):
  (buf, +e) = pair
  (buf, (s, e))

def l8_Attestation_win_last(last: Bool, +off: U32, +len: U32, +i: U32, +s: U32, buf: B.Buf) -> B.Buf & (U32 & U32):
  match last:
    case True{}: (buf, (s, len))
    case False{}: l8_Attestation_win_end(s, B.read32(buf, (off + 4 * (i + 1 : U32) : U32)))

def l8_Attestation_win_start(+off: U32, +len: U32, +i: U32, +n: U32, pair: B.Buf & U32) -> B.Buf & (U32 & U32):
  (buf, +s) = pair
  l8_Attestation_win_last(U32.is_eq((i + 1 : U32), n), off, len, i, s, buf)

def l8_Attestation_elem_win(+off: U32, +s: U32, +e: U32, buf: B.Buf) -> B.Buf & O.Boxed<Attestation>: Attestation_bx_read(buf, (off + s : U32), (e - s : U32))

def l8_Attestation_elem(+off: U32, pair: B.Buf & (U32 & U32)) -> B.Buf & O.Boxed<Attestation>:
  (buf, se) = pair
  (s, e) = se
  l8_Attestation_elem_win(off, s, e, buf)

def l8_Attestation_rv(+k: Nat, +i: U32, +off: U32, +len: U32, +n: U32, arr: Array<O.Boxed<Attestation>>, pair: B.Buf & O.Boxed<Attestation>) -> B.Buf & Array<O.Boxed<Attestation>>:
  match k:
    case 0n:
      (buf, v) = pair
      (buf, Array.set(O.Boxed<Attestation>, arr, i, v))
    case 1n+q:
      (buf, v) = pair
      l8_Attestation_rv(q, (i + 1 : U32), off, len, n, Array.set(O.Boxed<Attestation>, arr, i, v), l8_Attestation_elem(off, l8_Attestation_win_start(off, len, (i + 1 : U32), n, B.read32(buf, (off + 4 * (i + 1 : U32) : U32)))))

def l8_Attestation_rv_fin(+n: U32, pair: B.Buf & Array<O.Boxed<Attestation>>) -> B.Buf & l8_Attestation_Seq:
  (buf, arr) = pair
  (buf, l8_Attestation_Seq{arr, n})

def l8_Attestation_rv_count(+off: U32, +len: U32, pair: B.Buf & U32) -> B.Buf & l8_Attestation_Seq:
  (buf, +first) = pair
  l8_Attestation_rv_fin(U32.shrn(first, 2n), l8_Attestation_rv(U32.to_nat((U32.shrn(first, 2n) - 1 : U32)), 0, off, len, U32.shrn(first, 2n), l8_Attestation_fill(l8_Attestation_cap(U32.shrn(first, 2n))), l8_Attestation_elem(off, l8_Attestation_win_start(off, len, 0, U32.shrn(first, 2n), B.read32(buf, off)))))

def l8_Attestation_read_nz(empty: Bool, buf: B.Buf, +off: U32, +len: U32) -> B.Buf & l8_Attestation_Seq:
  match empty:
    case True{}: (buf, l8_Attestation_Seq{l8_Attestation_fill(0n), 0})
    case False{}: l8_Attestation_rv_count(off, len, B.read32(buf, off))

def l8_Attestation_read(buf: B.Buf, +off: U32, +len: U32) -> B.Buf & l8_Attestation_Seq: l8_Attestation_read_nz(U32.is_eq(len, 0), buf, off, len)

def l8_Attestation_sz_ret(+acc: U32, pair: Array<O.Boxed<Attestation>> & O.Boxed<Attestation>) -> Array<O.Boxed<Attestation>> & (U32 & O.Boxed<Attestation>):
  (arr, sp) = pair
  (arr, (acc, sp))

def l8_Attestation_sz_back(+i: U32, +acc: U32, arr: Array<O.Boxed<Attestation>>, pair: O.Boxed<Attestation> & U32) -> Array<O.Boxed<Attestation>> & (U32 & O.Boxed<Attestation>):
  (v, +m) = pair
  l8_Attestation_sz_ret(O.padd(acc, m), Array.swap(O.Boxed<Attestation>, arr, i, v))

def l8_Attestation_sz_one(+i: U32, +acc: U32, pair: Array<O.Boxed<Attestation>> & O.Boxed<Attestation>) -> Array<O.Boxed<Attestation>> & (U32 & O.Boxed<Attestation>):
  (arr, v) = pair
  l8_Attestation_sz_back(i, acc, arr, Attestation_bx_size(v))

def l8_Attestation_sz(+k: Nat, +i: U32, st: Array<O.Boxed<Attestation>> & (U32 & O.Boxed<Attestation>)) -> Array<O.Boxed<Attestation>> & (U32 & O.Boxed<Attestation>):
  match k:
    case 0n: st
    case 1n+q:
      (arr, r) = st
      (acc, sp) = r
      l8_Attestation_sz(q, (i + 1 : U32), l8_Attestation_sz_one(i, acc, Array.swap(O.Boxed<Attestation>, arr, i, sp)))

def l8_Attestation_sz_fin(+n: U32, st: Array<O.Boxed<Attestation>> & (U32 & O.Boxed<Attestation>)) -> l8_Attestation_Seq & U32:
  (arr, r) = st
  (m, sp) = r
  (l8_Attestation_Seq{arr, n}, O.padd((4 * n : U32), m))

def l8_Attestation_sz_nz(empty: Bool, arr: Array<O.Boxed<Attestation>>, +n: U32) -> l8_Attestation_Seq & U32:
  match empty:
    case True{}: (l8_Attestation_Seq{arr, n}, 0)
    case False{}: l8_Attestation_sz_fin(n, l8_Attestation_sz(U32.to_nat(n), 0, (arr, (0, O.BNone{}))))

def l8_Attestation_sz_ok(ok: Bool, arr: Array<O.Boxed<Attestation>>, +n: U32) -> l8_Attestation_Seq & U32:
  match ok:
    case True{}: l8_Attestation_sz_nz(U32.is_eq(n, 0), arr, n)
    case False{}: (l8_Attestation_Seq{arr, n}, 2147483648)

def l8_Attestation_sz_cap(+n: U32, pair: Array<O.Boxed<Attestation>> & U32) -> l8_Attestation_Seq & U32:
  (arr, +c) = pair
  l8_Attestation_sz_ok(U32.is_le(n, c), arr, n)

def l8_Attestation_size(o: l8_Attestation_Seq) -> l8_Attestation_Seq & U32:
  match o:
    case l8_Attestation_Seq{arr, +n}: l8_Attestation_sz_cap(n, Array.size(O.Boxed<Attestation>, arr))

def l8_Attestation_pv_ret(out: Array<U32>, c: U32, pair: Array<O.Boxed<Attestation>> & O.Boxed<Attestation>) -> Array<U32> & (Array<O.Boxed<Attestation>> & (U32 & O.Boxed<Attestation>)):
  (arr, sp) = pair
  (out, (arr, (c, sp)))

def l8_Attestation_pv_placed(+i: U32, arr: Array<O.Boxed<Attestation>>, pair: Array<U32> & (O.Boxed<Attestation> & U32)) -> Array<U32> & (Array<O.Boxed<Attestation>> & (U32 & O.Boxed<Attestation>)):
  (out, r) = pair
  (v, c) = r
  l8_Attestation_pv_ret(out, c, Array.swap(O.Boxed<Attestation>, arr, i, v))

def l8_Attestation_pv_one(+i: U32, +pos: U32, +cur: U32, out: Array<U32>, pair: Array<O.Boxed<Attestation>> & O.Boxed<Attestation>) -> Array<U32> & (Array<O.Boxed<Attestation>> & (U32 & O.Boxed<Attestation>)):
  (arr, v) = pair
  l8_Attestation_pv_placed(i, arr, Attestation_bx_putv(out, pos, (4 * i : U32), cur, v))

def l8_Attestation_pv(+k: Nat, +i: U32, +pos: U32, st: Array<U32> & (Array<O.Boxed<Attestation>> & (U32 & O.Boxed<Attestation>))) -> Array<U32> & (Array<O.Boxed<Attestation>> & (U32 & O.Boxed<Attestation>)):
  match k:
    case 0n: st
    case 1n+q:
      (out, s1) = st
      (arr, s2) = s1
      (cur, sp) = s2
      l8_Attestation_pv(q, (i + 1 : U32), pos, l8_Attestation_pv_one(i, pos, cur, out, Array.swap(O.Boxed<Attestation>, arr, i, sp)))

def l8_Attestation_pvn_go(+n: U32, out: Array<U32>, arr: Array<O.Boxed<Attestation>>, +cur: U32) -> Array<U32> & (l8_Attestation_Seq & U32):
  (out, (l8_Attestation_Seq{arr, n}, cur))

def l8_Attestation_pvn_fin(+n: U32, st: Array<U32> & (Array<O.Boxed<Attestation>> & (U32 & O.Boxed<Attestation>))) -> Array<U32> & (l8_Attestation_Seq & U32):
  (out, s1) = st
  (arr, s2) = s1
  (cur, sp) = s2
  l8_Attestation_pvn_go(n, out, arr, cur)

def l8_Attestation_pvn_nz(empty: Bool, out: Array<U32>, +pos: U32, arr: Array<O.Boxed<Attestation>>, +n: U32) -> Array<U32> & (l8_Attestation_Seq & U32):
  match empty:
    case True{}: (out, (l8_Attestation_Seq{arr, n}, 0))
    case False{}: l8_Attestation_pvn_fin(n, l8_Attestation_pv(U32.to_nat(n), 0, pos, (out, (arr, ((4 * n : U32), O.BNone{})))))

def l8_Attestation_putn(out: Array<U32>, +pos: U32, o: l8_Attestation_Seq) -> Array<U32> & (l8_Attestation_Seq & U32):
  match o:
    case l8_Attestation_Seq{arr, +n}: l8_Attestation_pvn_nz(U32.is_eq(n, 0), out, pos, arr, n)

def l8_Attestation_pv_drop(pair: Array<U32> & (l8_Attestation_Seq & U32)) -> Array<U32> & l8_Attestation_Seq:
  (out, r) = pair
  (sq, m) = r
  (out, sq)

def l8_Attestation_pt_nz(empty: Bool, +pos: U32, +n: U32, out: Array<U32>, arr: Array<O.Boxed<Attestation>>) -> Array<U32> & l8_Attestation_Seq:
  l8_Attestation_pv_drop(l8_Attestation_pvn_nz(empty, out, pos, arr, n))

def l8_Attestation_put(out: Array<U32>, +pos: U32, o: l8_Attestation_Seq) -> Array<U32> & l8_Attestation_Seq:
  match o:
    case l8_Attestation_Seq{arr, +n}: l8_Attestation_pt_nz(U32.is_eq(n, 0), pos, n, out, arr)

def l8_Attestation_rl_n(+i: U32, arr: Array<O.Boxed<Attestation>>, pair: B.Buf & (O.Boxed<Attestation> & D.Digest)) -> B.Buf & (Array<O.Boxed<Attestation>> & D.Digest):
  (h, r) = pair
  (v, d) = r
  (h, (Array.set(O.Boxed<Attestation>, arr, i, v), d))

def l8_Attestation_rl(+hl: Nat, +i: U32, +seg: U32, h: B.Buf, pair: Array<O.Boxed<Attestation>> & O.Boxed<Attestation>) -> B.Buf & (Array<O.Boxed<Attestation>> & D.Digest):
  (arr, v) = pair
  l8_Attestation_rl_n(i, arr, Attestation_bx_root(hl, h, v, (seg + 64 : U32)))

def l8_Attestation_mj(+hl: Nat, dl: D.Digest, pair: B.Buf & (Array<O.Boxed<Attestation>> & D.Digest)) -> B.Buf & (Array<O.Boxed<Attestation>> & D.Digest):
  (h, r) = pair
  (arr, dr) = r
  (h, (arr, D.node(hl, dl, dr)))

def l8_Attestation_mt(d: Nat, m: Nat, inside: Bool, +hl: Nat, +seg: U32, +w: Nat, +s: Nat, +n: Nat, st: B.Buf & (Array<O.Boxed<Attestation>> & D.Digest)) -> B.Buf & (Array<O.Boxed<Attestation>> & D.Digest):
  match d:
    case 0n:
      match m:
        case 0n:
          match inside:
            case False{}:
              (h, r) = st
              (arr, dl) = r
              (h, (arr, D.zconst(0n)))
            case True{}:
              (h, r) = st
              (arr, dl) = r
              l8_Attestation_rl(hl, U32.from_nat(s), seg, h, Array.swap(O.Boxed<Attestation>, arr, U32.from_nat(s), O.BNone{}))
        case 1n+q:
          (h, r) = st
          (arr, dl) = r
          l8_Attestation_mj(hl, dl, l8_Attestation_mt(0n, q, inside, hl, seg, w, s, n, (h, (arr, D.zero()))))
    case 1n+ +p:
      match m:
        case 0n:
          match inside:
            case False{}:
              (h, r) = st
              (arr, dl) = r
              (h, (arr, D.zconst(1n+p)))
            case True{}:
              l8_Attestation_mt(p, 1n, Nat.is_lt(Nat.add(s, Nat.div(w, 2n)), n), hl, seg, Nat.div(w, 2n), Nat.add(s, Nat.div(w, 2n)), n,
                l8_Attestation_mt(p, 0n, True{}, hl, seg, Nat.div(w, 2n), s, n, st))
        case 1n+q:
          (h, r) = st
          (arr, dl) = r
          l8_Attestation_mj(hl, dl, l8_Attestation_mt(1n+p, q, inside, hl, seg, w, s, n, (h, (arr, D.zero()))))

def l8_Attestation_mt0(+d: Nat, inside: Bool, +hl: Nat, +seg: U32, +n: Nat, st: B.Buf & (Array<O.Boxed<Attestation>> & D.Digest)) -> B.Buf & (Array<O.Boxed<Attestation>> & D.Digest):
  match d:
    case 0n: l8_Attestation_mt(0n, 0n, inside, hl, seg, 1n, 0n, n, st)
    case 1n+q:
      match inside:
        case False{}:
          (h, r) = st
          (arr, dl) = r
          (h, (arr, D.zconst(1n+q)))
        case True{}:
          l8_Attestation_mt(q, 1n, Nat.is_lt(Nat.add(0n, O.pow2n(q)), n), hl, seg, O.pow2n(q), Nat.add(0n, O.pow2n(q)), n,
            l8_Attestation_mt(q, 0n, True{}, hl, seg, O.pow2n(q), 0n, n, st))

def l8_Attestation_rt_fin(+hl: Nat, +n: U32, pair: B.Buf & (Array<O.Boxed<Attestation>> & D.Digest)) -> B.Buf & (l8_Attestation_Seq & D.Digest):
  (h, r) = pair
  (arr, d) = r
  (h, (l8_Attestation_Seq{arr, n}, O.mix_len(hl, d, n)))

def l8_Attestation_root(+hl: Nat, h: B.Buf, o: l8_Attestation_Seq, +seg: U32) -> B.Buf & (l8_Attestation_Seq & D.Digest):
  match o:
    case l8_Attestation_Seq{arr, +n}: l8_Attestation_rt_fin(hl, n, l8_Attestation_mt0(3n, Nat.is_lt(0n, U32.to_nat(n)), hl, seg, U32.to_nat(n), (h, (arr, D.zero()))))

def l8_Attestation_fo_back(+i: U32, +acc: U32, arr: Array<O.Boxed<Attestation>>, pair: O.Boxed<Attestation> & U32) -> Array<O.Boxed<Attestation>> & U32:
  (v, +x) = pair
  (Array.set(O.Boxed<Attestation>, arr, i, v), (acc .^. x : U32))

def l8_Attestation_fo_one(+i: U32, +acc: U32, pair: Array<O.Boxed<Attestation>> & O.Boxed<Attestation>) -> Array<O.Boxed<Attestation>> & U32:
  (arr, v) = pair
  l8_Attestation_fo_back(i, acc, arr, Attestation_bx_force(v))

def l8_Attestation_fo(+k: Nat, +i: U32, pair: Array<O.Boxed<Attestation>> & U32) -> Array<O.Boxed<Attestation>> & U32:
  match k:
    case 0n: pair
    case 1n+q:
      (arr, +acc) = pair
      l8_Attestation_fo(q, (i + 1 : U32), l8_Attestation_fo_one(i, acc, Array.swap(O.Boxed<Attestation>, arr, i, O.BNone{})))

def l8_Attestation_fo_fin(+n: U32, pair: Array<O.Boxed<Attestation>> & U32) -> l8_Attestation_Seq & U32:
  (arr, +x) = pair
  (l8_Attestation_Seq{arr, n}, x)

def l8_Attestation_fo_nz(empty: Bool, +n: U32, arr: Array<O.Boxed<Attestation>>) -> l8_Attestation_Seq & U32:
  l8_Attestation_fo_fin(n, l8_Attestation_fo(U32.to_nat(n), 0, (arr, 0)))

def l8_Attestation_force(o: l8_Attestation_Seq) -> l8_Attestation_Seq & U32:
  match o:
    case l8_Attestation_Seq{arr, +n}: l8_Attestation_fo_nz(U32.is_eq(n, 0), n, arr)

def l8_Attestation_pk(out: Array<U32>, +pos: U32, pair: l8_Attestation_Seq & Bool) -> Array<U32> & (l8_Attestation_Seq & U32):
  (o, ok) = pair
  match ok:
    case True{}: l8_Attestation_putn(out, pos, o)
    case False{}: (out, (o, 2147483648))

def l8_Attestation_va_fin(+n: U32, ok: Bool, pair: Array<O.Boxed<Attestation>> & Bool) -> l8_Attestation_Seq & Bool:
  (arr, b) = pair
  (l8_Attestation_Seq{arr, n}, Bool.and(ok, b))

def Attestation_bx_va_back(pair: Attestation & Bool) -> O.Boxed<Attestation> & Bool:
  (v, ok) = pair
  (O.BSome{v, O.BNone{}}, ok)

def Attestation_va0(+data: AttestationData, +signature: Bytes96, +committee_bits: Bitvector64, acc: Bool, pair: O.Bits & Bool) -> Attestation & Bool:
  (aggregation_bits, ok) = pair
  (Attestation{aggregation_bits, data, signature, committee_bits}, Bool.and(acc, ok))

def Attestation_valid(o: Attestation) -> Attestation & Bool:
  match o:
    case Attestation{aggregation_bits, +data, +signature, +committee_bits}: Attestation_va0(data, signature, committee_bits, True{}, bits131072_valid(aggregation_bits))

def Attestation_bx_valid(o: O.Boxed<Attestation>) -> O.Boxed<Attestation> & Bool:
  match o:
    case O.BSome{v, rest}: Attestation_bx_va_back(Attestation_valid(v))
    case O.BNone{}: (O.BNone{}, False{})

def l8_Attestation_va_back(+i: U32, acc: Bool, arr: Array<O.Boxed<Attestation>>, pair: O.Boxed<Attestation> & Bool) -> Array<O.Boxed<Attestation>> & Bool:
  (v, ok) = pair
  (Array.set(O.Boxed<Attestation>, arr, i, v), Bool.and(acc, ok))

def l8_Attestation_va_one(+i: U32, acc: Bool, pair: Array<O.Boxed<Attestation>> & O.Boxed<Attestation>) -> Array<O.Boxed<Attestation>> & Bool:
  (arr, v) = pair
  l8_Attestation_va_back(i, acc, arr, Attestation_bx_valid(v))

def l8_Attestation_va(+k: Nat, +i: U32, pair: Array<O.Boxed<Attestation>> & Bool) -> Array<O.Boxed<Attestation>> & Bool:
  match k:
    case 0n: pair
    case 1n+q:
      (arr, acc) = pair
      l8_Attestation_va(q, (i + 1 : U32), l8_Attestation_va_one(i, acc, Array.swap(O.Boxed<Attestation>, arr, i, O.BNone{})))

def l8_Attestation_va_nz(empty: Bool, +n: U32, arr: Array<O.Boxed<Attestation>>) -> Array<O.Boxed<Attestation>> & Bool:
  l8_Attestation_va(U32.to_nat(n), 0, (arr, True{}))

def l8_Attestation_va_go(ok: Bool, +n: U32, arr: Array<O.Boxed<Attestation>>) -> l8_Attestation_Seq & Bool:
  match ok:
    case True{}: l8_Attestation_va_fin(n, True{}, l8_Attestation_va_nz(U32.is_eq(n, 0), n, arr))
    case False{}: (l8_Attestation_Seq{arr, n}, False{})

def l8_Attestation_va_cap(ok: Bool, +n: U32, pair: Array<O.Boxed<Attestation>> & U32) -> l8_Attestation_Seq & Bool:
  (arr, +c) = pair
  l8_Attestation_va_go(Bool.and(ok, U32.is_le(n, c)), n, arr)

def l8_Attestation_valid(o: l8_Attestation_Seq) -> l8_Attestation_Seq & Bool:
  match o:
    case l8_Attestation_Seq{arr, +n}: l8_Attestation_va_cap(Bool.or(False{}, U32.is_le(n, 8)), n, Array.size(O.Boxed<Attestation>, arr))

def l8_Attestation_putk(out: Array<U32>, +pos: U32, o: l8_Attestation_Seq) -> Array<U32> & (l8_Attestation_Seq & U32): l8_Attestation_pk(out, pos, l8_Attestation_valid(o))

def l8_Attestation_du_took(t: +List<U32>, pair: Array<O.Boxed<Attestation>> & O.Boxed<Attestation>) -> Array<O.Boxed<Attestation>> & +List<U32>:
  (arr, v) = pair
  (arr, Attestation_bx_dump(v, t))

def l8_Attestation_du(+k: Nat, +i: U32, st: Array<O.Boxed<Attestation>> & +List<U32>) -> Array<O.Boxed<Attestation>> & +List<U32>:
  match k:
    case 0n: st
    case 1n+q:
      (arr, t) = st
      l8_Attestation_du(q, (i - 1 : U32), l8_Attestation_du_took(t, Array.swap(O.Boxed<Attestation>, arr, (i - 1 : U32), O.BNone{})))

def l8_Attestation_du_fin(+n: U32, st: Array<O.Boxed<Attestation>> & +List<U32>) -> +List<U32>:
  (arr, t) = st
  O.dump_le(n, 4, t)

def l8_Attestation_dump(o: l8_Attestation_Seq, t: +List<U32>) -> +List<U32>:
  match o:
    case l8_Attestation_Seq{arr, +n}: l8_Attestation_du_fin(n, l8_Attestation_du(U32.to_nat(n), n, (arr, t)))

def l8_Attestation_ew(ok: Bool, buf: B.Buf, +off: U32, +a: U32, +b: U32) -> B.Buf & Bool:
  match ok:
    case True{}: Attestation_bx_ok(buf, (off + a : U32), (b - a : U32))
    case False{}: (buf, False{})

def l8_Attestation_eb(+b: U32, pair: B.Buf & Bool) -> B.Buf & (Bool & U32):
  (buf, ok) = pair
  (buf, (ok, b))

def l8_Attestation_ee(+acc: Bool, +off: U32, +len: U32, +a: U32, pair: B.Buf & U32) -> B.Buf & (Bool & U32):
  (buf, +b) = pair
  l8_Attestation_eb(b, O.and_pair(acc, l8_Attestation_ew(Bool.and(acc, Bool.and(U32.is_le(a, b), U32.is_le(b, len))), buf, off, a, b)))

def l8_Attestation_next(last: Bool, buf: B.Buf, +off: U32, +len: U32, +i: U32) -> B.Buf & U32:
  match last:
    case True{}: (buf, len)
    case False{}: B.read32(buf, (off + 4 * (i + 1 : U32) : U32))

def l8_Attestation_ev(+k: Nat, +i: U32, +n: U32, +off: U32, +len: U32, pair: B.Buf & (Bool & U32)) -> B.Buf & Bool:
  match k:
    case 0n:
      (buf, r) = pair
      (ok, a) = r
      (buf, ok)
    case 1n+q:
      (buf, r) = pair
      (ok, a) = r
      l8_Attestation_ev(q, (i + 1 : U32), n, off, len, l8_Attestation_ee(ok, off, len, a, l8_Attestation_next(U32.is_eq((i + 2 : U32), n), buf, off, len, (i + 1 : U32))))

def l8_Attestation_first(ok: Bool, buf: B.Buf, +off: U32, +len: U32, +first: U32) -> B.Buf & Bool:
  match ok:
    case True{}: l8_Attestation_ev(U32.to_nat((U32.shrn(first, 2n) - 1 : U32)), 0, U32.shrn(first, 2n), off, len, l8_Attestation_ee(True{}, off, len, first, l8_Attestation_next(U32.is_eq(1, U32.shrn(first, 2n)), buf, off, len, 0)))
    case False{}: (buf, False{})

def l8_Attestation_head(+len: U32, +off: U32, pair: B.Buf & U32) -> B.Buf & Bool:
  (buf, +first) = pair
  l8_Attestation_first(Bool.and(Bool.and(U32.is_eq((first .&. 3 : U32), 0), U32.is_le(first, len)), Bool.and(U32.is_le(4, first), U32.is_le(U32.shrn(first, 2n), 8))), buf, off, len, first)

def l8_Attestation_ok_nz(empty: Bool, buf: B.Buf, +off: U32, +len: U32) -> B.Buf & Bool:
  match empty:
    case True{}: (buf, True{})
    case False{}: l8_Attestation_head(len, off, B.read32(buf, off))

def l8_Attestation_ok(buf: B.Buf, +off: U32, +len: U32) -> B.Buf & Bool: l8_Attestation_ok_nz(U32.is_eq(len, 0), buf, off, len)

def l8_Attestation_len(o: l8_Attestation_Seq) -> l8_Attestation_Seq & U32:
  match o:
    case l8_Attestation_Seq{arr, +n}: (l8_Attestation_Seq{arr, n}, n)

def l8_Attestation_took(+n: U32, pair: Array<O.Boxed<Attestation>> & O.Boxed<Attestation>) -> l8_Attestation_Seq & Maybe<&1, Attestation>:
  (arr, v) = pair
  (l8_Attestation_Seq{arr, n}, Some{Attestation_bx_unbox(v)})

def l8_Attestation_at(arr: Array<O.Boxed<Attestation>>, +n: U32, +i: U32) -> l8_Attestation_Seq & Maybe<&1, Attestation>:
  l8_Attestation_took(n, Array.swap(O.Boxed<Attestation>, arr, i, O.BNone{}))

def l8_Attestation_get_in(inside: Bool, arr: Array<O.Boxed<Attestation>>, +n: U32, +i: U32) -> l8_Attestation_Seq & Maybe<&1, Attestation>:
  match inside:
    case True{}: l8_Attestation_at(arr, n, i)
    case False{}: (l8_Attestation_Seq{arr, n}, None{})

def l8_Attestation_get(o: l8_Attestation_Seq, +i: U32) -> l8_Attestation_Seq & Maybe<&1, Attestation>:
  match o:
    case l8_Attestation_Seq{arr, +n}: l8_Attestation_get_in(U32.is_lt(i, n), arr, n, i)

def l8_Attestation_put_in(ok: Bool, arr: Array<O.Boxed<Attestation>>, +n: U32, +i: U32, v: Attestation) -> l8_Attestation_Seq & Bool:
  match ok:
    case True{}: (l8_Attestation_Seq{Array.set(O.Boxed<Attestation>, arr, i, Attestation_bx_wrap(v)), n}, True{})
    case False{}: (l8_Attestation_Seq{arr, n}, False{})

def l8_Attestation_set(o: l8_Attestation_Seq, +i: U32, v: Attestation) -> l8_Attestation_Seq & Bool:
  match o:
    case l8_Attestation_Seq{arr, +n}: l8_Attestation_put_in(U32.is_lt(i, n), arr, n, i, v)

def l8_Attestation_moved(+i: U32, fresh: Array<O.Boxed<Attestation>>, pair: Array<O.Boxed<Attestation>> & O.Boxed<Attestation>) -> Array<O.Boxed<Attestation>> & Array<O.Boxed<Attestation>>:
  (old, v) = pair
  (Array.set(O.Boxed<Attestation>, fresh, i, v), old)

def l8_Attestation_copy(+k: Nat, +i: U32, pair: Array<O.Boxed<Attestation>> & Array<O.Boxed<Attestation>>) -> Array<O.Boxed<Attestation>>:
  match k:
    case 0n:
      (fresh, old) = pair
      fresh
    case 1n+q:
      (fresh, old) = pair
      l8_Attestation_copy(q, (i + 1 : U32), l8_Attestation_moved(i, fresh, Array.swap(O.Boxed<Attestation>, old, i, O.BNone{})))

def l8_Attestation_room_pick(fits: Bool, arr: Array<O.Boxed<Attestation>>, +n: U32) -> Array<O.Boxed<Attestation>>:
  match fits:
    case True{}: arr
    case False{}: l8_Attestation_copy(U32.to_nat(n), 0, (l8_Attestation_fill(l8_Attestation_cap((n + 1 : U32))), arr))

def l8_Attestation_room_sized(+n: U32, pair: Array<O.Boxed<Attestation>> & U32) -> Array<O.Boxed<Attestation>>:
  (arr, +cap) = pair
  l8_Attestation_room_pick(U32.is_lt(n, cap), arr, n)

def l8_Attestation_room(arr: Array<O.Boxed<Attestation>>, +n: U32) -> Array<O.Boxed<Attestation>>: l8_Attestation_room_sized(n, Array.size(O.Boxed<Attestation>, arr))

def l8_Attestation_app_in(ok: Bool, arr: Array<O.Boxed<Attestation>>, +n: U32, v: Attestation) -> l8_Attestation_Seq & Bool:
  match ok:
    case True{}: (l8_Attestation_Seq{Array.set(O.Boxed<Attestation>, l8_Attestation_room(arr, n), n, Attestation_bx_wrap(v)), (n + 1 : U32)}, True{})
    case False{}: (l8_Attestation_Seq{arr, n}, False{})

def l8_Attestation_append(o: l8_Attestation_Seq, v: Attestation) -> l8_Attestation_Seq & Bool:
  match o:
    case l8_Attestation_Seq{arr, +n}: l8_Attestation_app_in(U32.is_le((n + 1 : U32), 8), arr, n, v)

type l8_Attestation_Cached is Type:
  l8_Attestation_Cached{items: Array<O.Boxed<Attestation>>, n: U32, d: Nat, nodes: Array<D.Digest>, lo: U32, hi: U32}

type l8_Attestation_TS is Type:
  l8_Attestation_TS{h: B.Buf, items: Array<O.Boxed<Attestation>>, nodes: Array<D.Digest>}

def l8_Attestation_dfill(+d: Nat) -> Array<D.Digest>: Array.new(D.Digest, d, D.zero())

def l8_Attestation_cache_at(arr: Array<O.Boxed<Attestation>>, +n: U32, +d: Nat) -> l8_Attestation_Cached:
  l8_Attestation_Cached{arr, n, d, l8_Attestation_dfill(1n+d), 0, (O.pow2u(d) - 1 : U32)}

def l8_Attestation_cache(o: l8_Attestation_Seq) -> l8_Attestation_Cached:
  match o:
    case l8_Attestation_Seq{arr, +n}: l8_Attestation_cache_at(arr, n, l8_Attestation_cap(n))

def l8_Attestation_uncache(c: l8_Attestation_Cached) -> l8_Attestation_Seq:
  match c:
    case l8_Attestation_Cached{arr, +n, +d, nodes, +lo, +hi}: l8_Attestation_Seq{arr, n}

def l8_Attestation_clen(c: l8_Attestation_Cached) -> l8_Attestation_Cached & U32:
  match c:
    case l8_Attestation_Cached{arr, +n, +d, nodes, +lo, +hi}: (l8_Attestation_Cached{arr, n, d, nodes, lo, hi}, n)

def l8_Attestation_ctook(+n: U32, +d: Nat, nodes: Array<D.Digest>, +lo: U32, +hi: U32, pair: Array<O.Boxed<Attestation>> & O.Boxed<Attestation>) -> l8_Attestation_Cached & Maybe<&1, Attestation>:
  (arr, v) = pair
  (l8_Attestation_Cached{arr, n, d, nodes, lo, hi}, Some{Attestation_bx_unbox(v)})

def l8_Attestation_cget_in(inside: Bool, arr: Array<O.Boxed<Attestation>>, +n: U32, +d: Nat, nodes: Array<D.Digest>, +lo: U32, +hi: U32, +i: U32) -> l8_Attestation_Cached & Maybe<&1, Attestation>:
  match inside:
    case True{}: l8_Attestation_ctook(n, d, nodes, lo, hi, Array.swap(O.Boxed<Attestation>, arr, i, O.BNone{}))
    case False{}: (l8_Attestation_Cached{arr, n, d, nodes, lo, hi}, None{})

def l8_Attestation_cget(c: l8_Attestation_Cached, +i: U32) -> l8_Attestation_Cached & Maybe<&1, Attestation>:
  match c:
    case l8_Attestation_Cached{arr, +n, +d, nodes, +lo, +hi}: l8_Attestation_cget_in(U32.is_lt(i, n), arr, n, d, nodes, lo, hi, i)

def l8_Attestation_cset_in(ok: Bool, arr: Array<O.Boxed<Attestation>>, +n: U32, +d: Nat, nodes: Array<D.Digest>, +lo: U32, +hi: U32, +i: U32, v: Attestation) -> l8_Attestation_Cached & Bool:
  match ok:
    case True{}: (l8_Attestation_Cached{Array.set(O.Boxed<Attestation>, arr, i, Attestation_bx_wrap(v)), n, d, nodes, O.pick(U32.is_le(lo, i), lo, i), O.pick(U32.is_le(i, hi), hi, i)}, True{})
    case False{}: (l8_Attestation_Cached{arr, n, d, nodes, lo, hi}, False{})

def l8_Attestation_cset(c: l8_Attestation_Cached, +i: U32, v: Attestation) -> l8_Attestation_Cached & Bool:
  match c:
    case l8_Attestation_Cached{arr, +n, +d, nodes, +lo, +hi}: l8_Attestation_cset_in(U32.is_lt(i, n), arr, n, d, nodes, lo, hi, i, v)

def l8_Attestation_capp_fit(fits: Bool, arr: Array<O.Boxed<Attestation>>, +n: U32, +d: Nat, nodes: Array<D.Digest>, +lo: U32, +hi: U32, v: Attestation) -> l8_Attestation_Cached:
  match fits:
    case True{}: l8_Attestation_Cached{Array.set(O.Boxed<Attestation>, arr, n, Attestation_bx_wrap(v)), (n + 1 : U32), d, nodes, O.pick(U32.is_le(lo, n), lo, n), O.pick(U32.is_le(n, hi), hi, n)}
    case False{}: l8_Attestation_Cached{Array.set(O.Boxed<Attestation>, l8_Attestation_room(arr, n), n, Attestation_bx_wrap(v)), (n + 1 : U32), 1n+d, l8_Attestation_dfill(2n+d), 0, (O.pow2u(1n+d) - 1 : U32)}

def l8_Attestation_capp_in(ok: Bool, arr: Array<O.Boxed<Attestation>>, +n: U32, +d: Nat, nodes: Array<D.Digest>, +lo: U32, +hi: U32, v: Attestation) -> l8_Attestation_Cached & Bool:
  match ok:
    case True{}: (l8_Attestation_capp_fit(U32.is_lt(n, O.pow2u(d)), arr, n, d, nodes, lo, hi, v), True{})
    case False{}: (l8_Attestation_Cached{arr, n, d, nodes, lo, hi}, False{})

def l8_Attestation_capp(c: l8_Attestation_Cached, v: Attestation) -> l8_Attestation_Cached & Bool:
  match c:
    case l8_Attestation_Cached{arr, +n, +d, nodes, +lo, +hi}: l8_Attestation_capp_in(U32.is_le((n + 1 : U32), 8), arr, n, d, nodes, lo, hi, v)

def l8_Attestation_ts_store(ts: l8_Attestation_TS, +k: U32, +dg: D.Digest) -> l8_Attestation_TS:
  match ts:
    case l8_Attestation_TS{h, arr, nodes}: l8_Attestation_TS{h, arr, Array.set(D.Digest, nodes, k, dg)}

def l8_Attestation_leaf_put(+k: U32, h: B.Buf, arr: Array<O.Boxed<Attestation>>, nodes: Array<D.Digest>, +dg: D.Digest) -> l8_Attestation_TS:
  l8_Attestation_ts_store(l8_Attestation_TS{h, arr, nodes}, k, dg)

def l8_Attestation_leaf_fin(+k: U32, +i: U32, arr: Array<O.Boxed<Attestation>>, nodes: Array<D.Digest>, pr: B.Buf & (O.Boxed<Attestation> & D.Digest)) -> l8_Attestation_TS:
  (h, r) = pr
  (v, dg) = r
  l8_Attestation_leaf_put(k, h, Array.set(O.Boxed<Attestation>, arr, i, v), nodes, dg)

def l8_Attestation_leaf_go(+hl: Nat, +k: U32, +i: U32, +seg: U32, nodes: Array<D.Digest>, h: B.Buf, pr: Array<O.Boxed<Attestation>> & O.Boxed<Attestation>) -> l8_Attestation_TS:
  (arr, v) = pr
  l8_Attestation_leaf_fin(k, i, arr, nodes, Attestation_bx_root(hl, h, v, (seg + 64 : U32)))

def l8_Attestation_leaf_hash(+hl: Nat, +k: U32, +i: U32, +seg: U32, ts: l8_Attestation_TS) -> l8_Attestation_TS:
  match ts:
    case l8_Attestation_TS{h, arr, nodes}: l8_Attestation_leaf_go(hl, k, i, seg, nodes, h, Array.swap(O.Boxed<Attestation>, arr, i, O.BNone{}))

def l8_Attestation_leaf_step(+hl: Nat, inside: Bool, +k: U32, +i: U32, +seg: U32, ts: l8_Attestation_TS) -> l8_Attestation_TS:
  match inside:
    case True{}: l8_Attestation_leaf_hash(hl, k, i, seg, ts)
    case False{}: l8_Attestation_ts_store(ts, k, D.zero())

def l8_Attestation_leaves(+hl: Nat, +q: Nat, +i: U32, +n: U32, +seg: U32, +cap: U32, ts: l8_Attestation_TS) -> l8_Attestation_TS:
  match q:
    case 0n: ts
    case 1n+r:
      l8_Attestation_leaves(hl, r, (i + 1 : U32), n, seg, cap, l8_Attestation_leaf_step(hl, U32.is_lt(i, n), (cap + i : U32), i, seg, ts))

def l8_Attestation_node_fin(+hl: Nat, +j: U32, h: B.Buf, arr: Array<O.Boxed<Attestation>>, +dl: D.Digest, pr: Array<D.Digest> & D.Digest) -> l8_Attestation_TS:
  (nodes, +dr) = pr
  l8_Attestation_ts_store(l8_Attestation_TS{h, arr, nodes}, j, D.node(hl, dl, dr))

def l8_Attestation_node_go(+hl: Nat, +j: U32, h: B.Buf, arr: Array<O.Boxed<Attestation>>, pr: Array<D.Digest> & D.Digest) -> l8_Attestation_TS:
  (nodes, +dl) = pr
  l8_Attestation_node_fin(hl, j, h, arr, dl, Array.get(D.Digest, nodes, (2 * j + 1 : U32)))

def l8_Attestation_node_step(+hl: Nat, +j: U32, ts: l8_Attestation_TS) -> l8_Attestation_TS:
  match ts:
    case l8_Attestation_TS{h, arr, nodes}: l8_Attestation_node_go(hl, j, h, arr, Array.get(D.Digest, nodes, (2 * j : U32)))

def l8_Attestation_level(+hl: Nat, +q: Nat, +j: U32, ts: l8_Attestation_TS) -> l8_Attestation_TS:
  match q:
    case 0n: ts
    case 1n+r: l8_Attestation_level(hl, r, (j + 1 : U32), l8_Attestation_node_step(hl, j, ts))

def l8_Attestation_levels(+hl: Nat, +L: Nat, +klo: U32, +khi: U32, ts: l8_Attestation_TS) -> l8_Attestation_TS:
  match L:
    case 0n: ts
    case 1n+q:
      l8_Attestation_levels(hl, q, U32.shrn(klo, 1n), U32.shrn(khi, 1n), l8_Attestation_level(hl, U32.to_nat((U32.shrn(khi, 1n) - U32.shrn(klo, 1n) + 1 : U32)), U32.shrn(klo, 1n), ts))

def l8_Attestation_sweep(+hl: Nat, +d: Nat, +lo: U32, +hi: U32, +n: U32, +seg: U32, ts: l8_Attestation_TS) -> l8_Attestation_TS:
  l8_Attestation_levels(hl, d, (O.pow2u(d) + lo : U32), (O.pow2u(d) + hi : U32), l8_Attestation_leaves(hl, U32.to_nat((hi - lo + 1 : U32)), lo, n, seg, O.pow2u(d), ts))

def l8_Attestation_sweep_pick(+hl: Nat, some: Bool, +d: Nat, +lo: U32, +hi: U32, +n: U32, +seg: U32, ts: l8_Attestation_TS) -> l8_Attestation_TS:
  match some:
    case True{}: l8_Attestation_sweep(hl, d, lo, hi, n, seg, ts)
    case False{}: ts

def l8_Attestation_pad_go(+hl: Nat, +k: Nat, +lvl: U32, +r: D.Digest, pr: B.Buf & D.Digest) -> B.Buf & D.Digest:
  match k:
    case 0n:
      (h, +z) = pr
      (h, r)
    case 1n+q:
      (h, +z) = pr
      l8_Attestation_pad_go(hl, q, (lvl + 1 : U32), D.node(hl, r, z), (h, D.zconst(U32.to_nat((lvl + 1 : U32)))))

def l8_Attestation_croot_fin(+hl: Nat, +n: U32, +d: Nat, arr: Array<O.Boxed<Attestation>>, nodes: Array<D.Digest>, pr: B.Buf & D.Digest) -> B.Buf & (l8_Attestation_Cached & D.Digest):
  (h, +r) = pr
  (h, (l8_Attestation_Cached{arr, n, d, nodes, n, 0}, O.mix_len(hl, r, n)))

def l8_Attestation_croot_pad(+hl: Nat, +n: U32, +d: Nat, arr: Array<O.Boxed<Attestation>>, nodes: Array<D.Digest>, h: B.Buf, +r: D.Digest) -> B.Buf & (l8_Attestation_Cached & D.Digest):
  l8_Attestation_croot_fin(hl, n, d, arr, nodes, l8_Attestation_pad_go(hl, Nat.sub(3n, d), O.nat_u32(d), r, (h, D.zconst(d))))

def l8_Attestation_croot_read(+hl: Nat, +n: U32, +d: Nat, h: B.Buf, arr: Array<O.Boxed<Attestation>>, pr: Array<D.Digest> & D.Digest) -> B.Buf & (l8_Attestation_Cached & D.Digest):
  (nodes, +r) = pr
  l8_Attestation_croot_pad(hl, n, d, arr, nodes, h, r)

def l8_Attestation_croot_top(+hl: Nat, +n: U32, +d: Nat, ts: l8_Attestation_TS) -> B.Buf & (l8_Attestation_Cached & D.Digest):
  match ts:
    case l8_Attestation_TS{h, arr, nodes}: l8_Attestation_croot_read(hl, n, d, h, arr, Array.get(D.Digest, nodes, 1))

def l8_Attestation_cached_root(+hl: Nat, h: B.Buf, c: l8_Attestation_Cached, +seg: U32) -> B.Buf & (l8_Attestation_Cached & D.Digest):
  match c:
    case l8_Attestation_Cached{arr, +n, +d, nodes, +lo, +hi}:
      l8_Attestation_croot_top(hl, n, d, l8_Attestation_sweep_pick(hl, U32.is_le(lo, hi), d, lo, hi, n, seg, l8_Attestation_TS{h, arr, nodes}))

def Deposit_bx_wrap(v: Deposit) -> O.Boxed<Deposit>: O.BSome{v, O.BNone{}}

def Deposit_bx_default() -> O.Boxed<Deposit>: Deposit_bx_wrap(Deposit_default())

def Deposit_bx_unbox(o: O.Boxed<Deposit>) -> Deposit:
  match o:
    case O.BSome{v, rest}: v
    case O.BNone{}: Deposit_default()

def Deposit_bx_rd(pair: B.Buf & Deposit) -> B.Buf & O.Boxed<Deposit>:
  (buf, v) = pair
  (buf, Deposit_bx_wrap(v))

def Deposit_bx_read(buf: B.Buf, +off: U32, +len: U32) -> B.Buf & O.Boxed<Deposit>: Deposit_bx_rd(Deposit_read(buf, off, len))

def Deposit_bx_put_back(pair: Array<U32> & Deposit) -> Array<U32> & O.Boxed<Deposit>:
  (out, v) = pair
  (out, Deposit_bx_wrap(v))

def Deposit_bx_put(out: Array<U32>, +pos: U32, o: O.Boxed<Deposit>) -> Array<U32> & O.Boxed<Deposit>:
  match o:
    case O.BSome{v, rest}: Deposit_bx_put_back(Deposit_put(out, pos, v))
    case O.BNone{}: (out, Deposit_bx_default())

def Deposit_bx_size_back(pair: Deposit & U32) -> O.Boxed<Deposit> & U32:
  (v, +n) = pair
  (Deposit_bx_wrap(v), n)

def Deposit_bx_size(o: O.Boxed<Deposit>) -> O.Boxed<Deposit> & U32:
  match o:
    case O.BSome{v, rest}: Deposit_bx_size_back(Deposit_size(v))
    case O.BNone{}: (Deposit_bx_default(), 0)

def Deposit_bx_rt(pair: B.Buf & (Deposit & D.Digest)) -> B.Buf & (O.Boxed<Deposit> & D.Digest):
  (h, r) = pair
  (v, d) = r
  (h, (Deposit_bx_wrap(v), d))

def Deposit_bx_root(+hl: Nat, h: B.Buf, o: O.Boxed<Deposit>, +seg: U32) -> B.Buf & (O.Boxed<Deposit> & D.Digest):
  match o:
    case O.BSome{v, rest}: Deposit_bx_rt(Deposit_root(hl, h, v, seg))
    case O.BNone{}: (h, (Deposit_bx_default(), D.zero()))

def Deposit_bx_force(o: O.Boxed<Deposit>) -> O.Boxed<Deposit> & U32:
  match o:
    case O.BSome{v, rest}: Deposit_bx_size_back(Deposit_force(v))
    case O.BNone{}: (Deposit_bx_default(), 0)

def Deposit_bx_pk_back(pair: Array<U32> & (Deposit & U32)) -> Array<U32> & (O.Boxed<Deposit> & U32):
  (out, r) = pair
  (v, m) = r
  (out, (O.BSome{v, O.BNone{}}, m))

def Deposit_bx_putk(out: Array<U32>, +pos: U32, o: O.Boxed<Deposit>) -> Array<U32> & (O.Boxed<Deposit> & U32):
  match o:
    case O.BSome{v, rest}: Deposit_bx_pk_back(Deposit_putk(out, pos, v))
    case O.BNone{}: (out, (O.BNone{}, 2147483648))

def Deposit_bx_dump(o: O.Boxed<Deposit>, t: +List<U32>) -> +List<U32>:
  match o:
    case O.BSome{v, rest}: Deposit_dump(v, t)
    case O.BNone{}: Deposit_dump(Deposit_default(), t)

def Deposit_bx_ok(buf: B.Buf, +off: U32, +len: U32) -> B.Buf & Bool: Deposit_ok(buf, off, len)

def Deposit_bx_ok_at(buf: B.Buf, +off: U32) -> B.Buf & Bool: Deposit_ok_at(buf, off)

type l16_Deposit_Seq is Type:
  l16_Deposit_Seq{items: Array<O.Boxed<Deposit>>, n: U32}

def l16_Deposit_fill(+d: Nat) -> Array<O.Boxed<Deposit>>:
  match d:
    case 0n: ALeaf{O.BNone{}}
    case 1n+q: ANode{l16_Deposit_fill(q), l16_Deposit_fill(q)}

def l16_Deposit_cap(+n: U32) -> Nat: B.words_depth(n)

def l16_Deposit_default() -> l16_Deposit_Seq: l16_Deposit_Seq{l16_Deposit_fill(0n), 0}

def l16_Deposit_rd(+k: Nat, +i: U32, +off: U32, arr: Array<O.Boxed<Deposit>>, pair: B.Buf & O.Boxed<Deposit>) -> B.Buf & Array<O.Boxed<Deposit>>:
  match k:
    case 0n:
      (buf, v) = pair
      (buf, Array.set(O.Boxed<Deposit>, arr, i, v))
    case 1n+q:
      (buf, v) = pair
      l16_Deposit_rd(q, (i + 1 : U32), off, Array.set(O.Boxed<Deposit>, arr, i, v), Deposit_bx_read(buf, (off + (i + 1 : U32) * 1240 : U32), 1240))

def l16_Deposit_rd_fin(+n: U32, pair: B.Buf & Array<O.Boxed<Deposit>>) -> B.Buf & l16_Deposit_Seq:
  (buf, arr) = pair
  (buf, l16_Deposit_Seq{arr, n})

def l16_Deposit_rd_start(empty: Bool, +off: U32, +n: U32, buf: B.Buf) -> B.Buf & l16_Deposit_Seq:
  match empty:
    case True{}: (buf, l16_Deposit_Seq{l16_Deposit_fill(0n), 0})
    case False{}: l16_Deposit_rd_fin(n, l16_Deposit_rd(U32.to_nat((n - 1 : U32)), 0, off, l16_Deposit_fill(l16_Deposit_cap(n)), Deposit_bx_read(buf, off, 1240)))

def l16_Deposit_read(buf: B.Buf, +off: U32, +len: U32) -> B.Buf & l16_Deposit_Seq: l16_Deposit_rd_start(U32.is_eq(len, 0), off, U32.div(len, 1240), buf)

def l16_Deposit_szf(+n: U32, pair: Array<O.Boxed<Deposit>> & U32) -> l16_Deposit_Seq & U32:
  (arr, +c) = pair
  (l16_Deposit_Seq{arr, n}, O.pick(U32.is_le(n, c), (n * 1240 : U32), 2147483648))

def l16_Deposit_size(o: l16_Deposit_Seq) -> l16_Deposit_Seq & U32:
  match o:
    case l16_Deposit_Seq{arr, +n}: l16_Deposit_szf(n, Array.size(O.Boxed<Deposit>, arr))

def l16_Deposit_pt_ret(out: Array<U32>, pair: Array<O.Boxed<Deposit>> & O.Boxed<Deposit>) -> Array<U32> & (Array<O.Boxed<Deposit>> & O.Boxed<Deposit>):
  (arr, sp) = pair
  (out, (arr, sp))

def l16_Deposit_pt_back(+i: U32, arr: Array<O.Boxed<Deposit>>, pair: Array<U32> & O.Boxed<Deposit>) -> Array<U32> & (Array<O.Boxed<Deposit>> & O.Boxed<Deposit>):
  (out, v) = pair
  l16_Deposit_pt_ret(out, Array.swap(O.Boxed<Deposit>, arr, i, v))

def l16_Deposit_pt_one(+i: U32, +pos: U32, out: Array<U32>, pair: Array<O.Boxed<Deposit>> & O.Boxed<Deposit>) -> Array<U32> & (Array<O.Boxed<Deposit>> & O.Boxed<Deposit>):
  (arr, v) = pair
  l16_Deposit_pt_back(i, arr, Deposit_bx_put(out, (pos + i * 1240 : U32), v))

def l16_Deposit_pt(+k: Nat, +i: U32, +pos: U32, st: Array<U32> & (Array<O.Boxed<Deposit>> & O.Boxed<Deposit>)) -> Array<U32> & (Array<O.Boxed<Deposit>> & O.Boxed<Deposit>):
  match k:
    case 0n: st
    case 1n+q:
      (out, r) = st
      (arr, sp) = r
      l16_Deposit_pt(q, (i + 1 : U32), pos, l16_Deposit_pt_one(i, pos, out, Array.swap(O.Boxed<Deposit>, arr, i, sp)))

def l16_Deposit_pt_fin(+n: U32, st: Array<U32> & (Array<O.Boxed<Deposit>> & O.Boxed<Deposit>)) -> Array<U32> & l16_Deposit_Seq:
  (out, r) = st
  (arr, sp) = r
  (out, l16_Deposit_Seq{arr, n})

def l16_Deposit_pt_nz(empty: Bool, +pos: U32, +n: U32, out: Array<U32>, arr: Array<O.Boxed<Deposit>>) -> Array<U32> & l16_Deposit_Seq:
  match empty:
    case True{}: (out, l16_Deposit_Seq{arr, n})
    case False{}: l16_Deposit_pt_fin(n, l16_Deposit_pt(U32.to_nat(n), 0, pos, (out, (arr, O.BNone{}))))

def l16_Deposit_put(out: Array<U32>, +pos: U32, o: l16_Deposit_Seq) -> Array<U32> & l16_Deposit_Seq:
  match o:
    case l16_Deposit_Seq{arr, +n}: l16_Deposit_pt_nz(U32.is_eq(n, 0), pos, n, out, arr)

def l16_Deposit_ptn_fin(+n: U32, pair: Array<U32> & l16_Deposit_Seq) -> Array<U32> & (l16_Deposit_Seq & U32):
  (out, sq) = pair
  (out, (sq, (n * 1240 : U32)))

def l16_Deposit_putn(out: Array<U32>, +pos: U32, o: l16_Deposit_Seq) -> Array<U32> & (l16_Deposit_Seq & U32):
  match o:
    case l16_Deposit_Seq{arr, +n}: l16_Deposit_ptn_fin(n, l16_Deposit_pt_nz(U32.is_eq(n, 0), pos, n, out, arr))

def l16_Deposit_rl_n(+i: U32, arr: Array<O.Boxed<Deposit>>, pair: B.Buf & (O.Boxed<Deposit> & D.Digest)) -> B.Buf & (Array<O.Boxed<Deposit>> & D.Digest):
  (h, r) = pair
  (v, d) = r
  (h, (Array.set(O.Boxed<Deposit>, arr, i, v), d))

def l16_Deposit_rl(+hl: Nat, +i: U32, +seg: U32, h: B.Buf, pair: Array<O.Boxed<Deposit>> & O.Boxed<Deposit>) -> B.Buf & (Array<O.Boxed<Deposit>> & D.Digest):
  (arr, v) = pair
  l16_Deposit_rl_n(i, arr, Deposit_bx_root(hl, h, v, (seg + 64 : U32)))

def l16_Deposit_mj(+hl: Nat, dl: D.Digest, pair: B.Buf & (Array<O.Boxed<Deposit>> & D.Digest)) -> B.Buf & (Array<O.Boxed<Deposit>> & D.Digest):
  (h, r) = pair
  (arr, dr) = r
  (h, (arr, D.node(hl, dl, dr)))

def l16_Deposit_mt(d: Nat, m: Nat, inside: Bool, +hl: Nat, +seg: U32, +w: Nat, +s: Nat, +n: Nat, st: B.Buf & (Array<O.Boxed<Deposit>> & D.Digest)) -> B.Buf & (Array<O.Boxed<Deposit>> & D.Digest):
  match d:
    case 0n:
      match m:
        case 0n:
          match inside:
            case False{}:
              (h, r) = st
              (arr, dl) = r
              (h, (arr, D.zconst(0n)))
            case True{}:
              (h, r) = st
              (arr, dl) = r
              l16_Deposit_rl(hl, U32.from_nat(s), seg, h, Array.swap(O.Boxed<Deposit>, arr, U32.from_nat(s), O.BNone{}))
        case 1n+q:
          (h, r) = st
          (arr, dl) = r
          l16_Deposit_mj(hl, dl, l16_Deposit_mt(0n, q, inside, hl, seg, w, s, n, (h, (arr, D.zero()))))
    case 1n+ +p:
      match m:
        case 0n:
          match inside:
            case False{}:
              (h, r) = st
              (arr, dl) = r
              (h, (arr, D.zconst(1n+p)))
            case True{}:
              l16_Deposit_mt(p, 1n, Nat.is_lt(Nat.add(s, Nat.div(w, 2n)), n), hl, seg, Nat.div(w, 2n), Nat.add(s, Nat.div(w, 2n)), n,
                l16_Deposit_mt(p, 0n, True{}, hl, seg, Nat.div(w, 2n), s, n, st))
        case 1n+q:
          (h, r) = st
          (arr, dl) = r
          l16_Deposit_mj(hl, dl, l16_Deposit_mt(1n+p, q, inside, hl, seg, w, s, n, (h, (arr, D.zero()))))

def l16_Deposit_mt0(+d: Nat, inside: Bool, +hl: Nat, +seg: U32, +n: Nat, st: B.Buf & (Array<O.Boxed<Deposit>> & D.Digest)) -> B.Buf & (Array<O.Boxed<Deposit>> & D.Digest):
  match d:
    case 0n: l16_Deposit_mt(0n, 0n, inside, hl, seg, 1n, 0n, n, st)
    case 1n+q:
      match inside:
        case False{}:
          (h, r) = st
          (arr, dl) = r
          (h, (arr, D.zconst(1n+q)))
        case True{}:
          l16_Deposit_mt(q, 1n, Nat.is_lt(Nat.add(0n, O.pow2n(q)), n), hl, seg, O.pow2n(q), Nat.add(0n, O.pow2n(q)), n,
            l16_Deposit_mt(q, 0n, True{}, hl, seg, O.pow2n(q), 0n, n, st))

def l16_Deposit_rt_fin(+hl: Nat, +n: U32, pair: B.Buf & (Array<O.Boxed<Deposit>> & D.Digest)) -> B.Buf & (l16_Deposit_Seq & D.Digest):
  (h, r) = pair
  (arr, d) = r
  (h, (l16_Deposit_Seq{arr, n}, O.mix_len(hl, d, n)))

def l16_Deposit_root(+hl: Nat, h: B.Buf, o: l16_Deposit_Seq, +seg: U32) -> B.Buf & (l16_Deposit_Seq & D.Digest):
  match o:
    case l16_Deposit_Seq{arr, +n}: l16_Deposit_rt_fin(hl, n, l16_Deposit_mt0(4n, Nat.is_lt(0n, U32.to_nat(n)), hl, seg, U32.to_nat(n), (h, (arr, D.zero()))))

def l16_Deposit_fo_back(+i: U32, +acc: U32, arr: Array<O.Boxed<Deposit>>, pair: O.Boxed<Deposit> & U32) -> Array<O.Boxed<Deposit>> & U32:
  (v, +x) = pair
  (Array.set(O.Boxed<Deposit>, arr, i, v), (acc .^. x : U32))

def l16_Deposit_fo_one(+i: U32, +acc: U32, pair: Array<O.Boxed<Deposit>> & O.Boxed<Deposit>) -> Array<O.Boxed<Deposit>> & U32:
  (arr, v) = pair
  l16_Deposit_fo_back(i, acc, arr, Deposit_bx_force(v))

def l16_Deposit_fo(+k: Nat, +i: U32, pair: Array<O.Boxed<Deposit>> & U32) -> Array<O.Boxed<Deposit>> & U32:
  match k:
    case 0n: pair
    case 1n+q:
      (arr, +acc) = pair
      l16_Deposit_fo(q, (i + 1 : U32), l16_Deposit_fo_one(i, acc, Array.swap(O.Boxed<Deposit>, arr, i, O.BNone{})))

def l16_Deposit_fo_fin(+n: U32, pair: Array<O.Boxed<Deposit>> & U32) -> l16_Deposit_Seq & U32:
  (arr, +x) = pair
  (l16_Deposit_Seq{arr, n}, x)

def l16_Deposit_fo_nz(empty: Bool, +n: U32, arr: Array<O.Boxed<Deposit>>) -> l16_Deposit_Seq & U32:
  l16_Deposit_fo_fin(n, l16_Deposit_fo(U32.to_nat(n), 0, (arr, 0)))

def l16_Deposit_force(o: l16_Deposit_Seq) -> l16_Deposit_Seq & U32:
  match o:
    case l16_Deposit_Seq{arr, +n}: l16_Deposit_fo_nz(U32.is_eq(n, 0), n, arr)

def l16_Deposit_pk(out: Array<U32>, +pos: U32, pair: l16_Deposit_Seq & Bool) -> Array<U32> & (l16_Deposit_Seq & U32):
  (o, ok) = pair
  match ok:
    case True{}: l16_Deposit_putn(out, pos, o)
    case False{}: (out, (o, 2147483648))

def l16_Deposit_va_fin(+n: U32, ok: Bool, pair: Array<O.Boxed<Deposit>> & Bool) -> l16_Deposit_Seq & Bool:
  (arr, b) = pair
  (l16_Deposit_Seq{arr, n}, Bool.and(ok, b))

def Deposit_bx_va_back(pair: Deposit & Bool) -> O.Boxed<Deposit> & Bool:
  (v, ok) = pair
  (O.BSome{v, O.BNone{}}, ok)

def DepositData_bx_valid(o: O.Boxed<DepositData>) -> O.Boxed<DepositData> & Bool:
  match o:
    case O.BSome{+v, rest}: (O.BSome{v, O.BNone{}}, DepositData_valid(v))
    case O.BNone{}: (O.BNone{}, False{})

def Deposit_va1(proof: O.Words, acc: Bool, pair: O.Boxed<DepositData> & Bool) -> Deposit & Bool:
  (data, ok) = pair
  (Deposit{proof, data}, Bool.and(acc, ok))

def Deposit_va0(data: O.Boxed<DepositData>, acc: Bool, pair: O.Words & Bool) -> Deposit & Bool:
  (proof, ok) = pair
  Deposit_va1(proof, Bool.and(acc, ok), DepositData_bx_valid(data))

def Deposit_valid(o: Deposit) -> Deposit & Bool:
  match o:
    case Deposit{proof, data}: Deposit_va0(data, True{}, v33_b32_valid(proof))

def Deposit_bx_valid(o: O.Boxed<Deposit>) -> O.Boxed<Deposit> & Bool:
  match o:
    case O.BSome{v, rest}: Deposit_bx_va_back(Deposit_valid(v))
    case O.BNone{}: (O.BNone{}, False{})

def l16_Deposit_va_back(+i: U32, acc: Bool, arr: Array<O.Boxed<Deposit>>, pair: O.Boxed<Deposit> & Bool) -> Array<O.Boxed<Deposit>> & Bool:
  (v, ok) = pair
  (Array.set(O.Boxed<Deposit>, arr, i, v), Bool.and(acc, ok))

def l16_Deposit_va_one(+i: U32, acc: Bool, pair: Array<O.Boxed<Deposit>> & O.Boxed<Deposit>) -> Array<O.Boxed<Deposit>> & Bool:
  (arr, v) = pair
  l16_Deposit_va_back(i, acc, arr, Deposit_bx_valid(v))

def l16_Deposit_va(+k: Nat, +i: U32, pair: Array<O.Boxed<Deposit>> & Bool) -> Array<O.Boxed<Deposit>> & Bool:
  match k:
    case 0n: pair
    case 1n+q:
      (arr, acc) = pair
      l16_Deposit_va(q, (i + 1 : U32), l16_Deposit_va_one(i, acc, Array.swap(O.Boxed<Deposit>, arr, i, O.BNone{})))

def l16_Deposit_va_nz(empty: Bool, +n: U32, arr: Array<O.Boxed<Deposit>>) -> Array<O.Boxed<Deposit>> & Bool:
  l16_Deposit_va(U32.to_nat(n), 0, (arr, True{}))

def l16_Deposit_va_go(ok: Bool, +n: U32, arr: Array<O.Boxed<Deposit>>) -> l16_Deposit_Seq & Bool:
  match ok:
    case True{}: l16_Deposit_va_fin(n, True{}, l16_Deposit_va_nz(U32.is_eq(n, 0), n, arr))
    case False{}: (l16_Deposit_Seq{arr, n}, False{})

def l16_Deposit_va_cap(ok: Bool, +n: U32, pair: Array<O.Boxed<Deposit>> & U32) -> l16_Deposit_Seq & Bool:
  (arr, +c) = pair
  l16_Deposit_va_go(Bool.and(ok, U32.is_le(n, c)), n, arr)

def l16_Deposit_valid(o: l16_Deposit_Seq) -> l16_Deposit_Seq & Bool:
  match o:
    case l16_Deposit_Seq{arr, +n}: l16_Deposit_va_cap(Bool.or(False{}, U32.is_le(n, 16)), n, Array.size(O.Boxed<Deposit>, arr))

def l16_Deposit_putk(out: Array<U32>, +pos: U32, o: l16_Deposit_Seq) -> Array<U32> & (l16_Deposit_Seq & U32): l16_Deposit_pk(out, pos, l16_Deposit_valid(o))

def l16_Deposit_du_took(t: +List<U32>, pair: Array<O.Boxed<Deposit>> & O.Boxed<Deposit>) -> Array<O.Boxed<Deposit>> & +List<U32>:
  (arr, v) = pair
  (arr, Deposit_bx_dump(v, t))

def l16_Deposit_du(+k: Nat, +i: U32, st: Array<O.Boxed<Deposit>> & +List<U32>) -> Array<O.Boxed<Deposit>> & +List<U32>:
  match k:
    case 0n: st
    case 1n+q:
      (arr, t) = st
      l16_Deposit_du(q, (i - 1 : U32), l16_Deposit_du_took(t, Array.swap(O.Boxed<Deposit>, arr, (i - 1 : U32), O.BNone{})))

def l16_Deposit_du_fin(+n: U32, st: Array<O.Boxed<Deposit>> & +List<U32>) -> +List<U32>:
  (arr, t) = st
  O.dump_le(n, 4, t)

def l16_Deposit_dump(o: l16_Deposit_Seq, t: +List<U32>) -> +List<U32>:
  match o:
    case l16_Deposit_Seq{arr, +n}: l16_Deposit_du_fin(n, l16_Deposit_du(U32.to_nat(n), n, (arr, t)))

def l16_Deposit_ok(buf: B.Buf, +off: U32, +len: U32) -> B.Buf & Bool: (buf, Bool.and(U32.is_eq(len, (U32.div(len, 1240) * 1240 : U32)), U32.is_le(U32.div(len, 1240), 16)))

def l16_Deposit_len(o: l16_Deposit_Seq) -> l16_Deposit_Seq & U32:
  match o:
    case l16_Deposit_Seq{arr, +n}: (l16_Deposit_Seq{arr, n}, n)

def l16_Deposit_took(+n: U32, pair: Array<O.Boxed<Deposit>> & O.Boxed<Deposit>) -> l16_Deposit_Seq & Maybe<&1, Deposit>:
  (arr, v) = pair
  (l16_Deposit_Seq{arr, n}, Some{Deposit_bx_unbox(v)})

def l16_Deposit_at(arr: Array<O.Boxed<Deposit>>, +n: U32, +i: U32) -> l16_Deposit_Seq & Maybe<&1, Deposit>:
  l16_Deposit_took(n, Array.swap(O.Boxed<Deposit>, arr, i, O.BNone{}))

def l16_Deposit_get_in(inside: Bool, arr: Array<O.Boxed<Deposit>>, +n: U32, +i: U32) -> l16_Deposit_Seq & Maybe<&1, Deposit>:
  match inside:
    case True{}: l16_Deposit_at(arr, n, i)
    case False{}: (l16_Deposit_Seq{arr, n}, None{})

def l16_Deposit_get(o: l16_Deposit_Seq, +i: U32) -> l16_Deposit_Seq & Maybe<&1, Deposit>:
  match o:
    case l16_Deposit_Seq{arr, +n}: l16_Deposit_get_in(U32.is_lt(i, n), arr, n, i)

def l16_Deposit_put_in(ok: Bool, arr: Array<O.Boxed<Deposit>>, +n: U32, +i: U32, v: Deposit) -> l16_Deposit_Seq & Bool:
  match ok:
    case True{}: (l16_Deposit_Seq{Array.set(O.Boxed<Deposit>, arr, i, Deposit_bx_wrap(v)), n}, True{})
    case False{}: (l16_Deposit_Seq{arr, n}, False{})

def l16_Deposit_set(o: l16_Deposit_Seq, +i: U32, v: Deposit) -> l16_Deposit_Seq & Bool:
  match o:
    case l16_Deposit_Seq{arr, +n}: l16_Deposit_put_in(U32.is_lt(i, n), arr, n, i, v)

def l16_Deposit_moved(+i: U32, fresh: Array<O.Boxed<Deposit>>, pair: Array<O.Boxed<Deposit>> & O.Boxed<Deposit>) -> Array<O.Boxed<Deposit>> & Array<O.Boxed<Deposit>>:
  (old, v) = pair
  (Array.set(O.Boxed<Deposit>, fresh, i, v), old)

def l16_Deposit_copy(+k: Nat, +i: U32, pair: Array<O.Boxed<Deposit>> & Array<O.Boxed<Deposit>>) -> Array<O.Boxed<Deposit>>:
  match k:
    case 0n:
      (fresh, old) = pair
      fresh
    case 1n+q:
      (fresh, old) = pair
      l16_Deposit_copy(q, (i + 1 : U32), l16_Deposit_moved(i, fresh, Array.swap(O.Boxed<Deposit>, old, i, O.BNone{})))

def l16_Deposit_room_pick(fits: Bool, arr: Array<O.Boxed<Deposit>>, +n: U32) -> Array<O.Boxed<Deposit>>:
  match fits:
    case True{}: arr
    case False{}: l16_Deposit_copy(U32.to_nat(n), 0, (l16_Deposit_fill(l16_Deposit_cap((n + 1 : U32))), arr))

def l16_Deposit_room_sized(+n: U32, pair: Array<O.Boxed<Deposit>> & U32) -> Array<O.Boxed<Deposit>>:
  (arr, +cap) = pair
  l16_Deposit_room_pick(U32.is_lt(n, cap), arr, n)

def l16_Deposit_room(arr: Array<O.Boxed<Deposit>>, +n: U32) -> Array<O.Boxed<Deposit>>: l16_Deposit_room_sized(n, Array.size(O.Boxed<Deposit>, arr))

def l16_Deposit_app_in(ok: Bool, arr: Array<O.Boxed<Deposit>>, +n: U32, v: Deposit) -> l16_Deposit_Seq & Bool:
  match ok:
    case True{}: (l16_Deposit_Seq{Array.set(O.Boxed<Deposit>, l16_Deposit_room(arr, n), n, Deposit_bx_wrap(v)), (n + 1 : U32)}, True{})
    case False{}: (l16_Deposit_Seq{arr, n}, False{})

def l16_Deposit_append(o: l16_Deposit_Seq, v: Deposit) -> l16_Deposit_Seq & Bool:
  match o:
    case l16_Deposit_Seq{arr, +n}: l16_Deposit_app_in(U32.is_le((n + 1 : U32), 16), arr, n, v)

type l16_Deposit_Cached is Type:
  l16_Deposit_Cached{items: Array<O.Boxed<Deposit>>, n: U32, d: Nat, nodes: Array<D.Digest>, lo: U32, hi: U32}

type l16_Deposit_TS is Type:
  l16_Deposit_TS{h: B.Buf, items: Array<O.Boxed<Deposit>>, nodes: Array<D.Digest>}

def l16_Deposit_dfill(+d: Nat) -> Array<D.Digest>: Array.new(D.Digest, d, D.zero())

def l16_Deposit_cache_at(arr: Array<O.Boxed<Deposit>>, +n: U32, +d: Nat) -> l16_Deposit_Cached:
  l16_Deposit_Cached{arr, n, d, l16_Deposit_dfill(1n+d), 0, (O.pow2u(d) - 1 : U32)}

def l16_Deposit_cache(o: l16_Deposit_Seq) -> l16_Deposit_Cached:
  match o:
    case l16_Deposit_Seq{arr, +n}: l16_Deposit_cache_at(arr, n, l16_Deposit_cap(n))

def l16_Deposit_uncache(c: l16_Deposit_Cached) -> l16_Deposit_Seq:
  match c:
    case l16_Deposit_Cached{arr, +n, +d, nodes, +lo, +hi}: l16_Deposit_Seq{arr, n}

def l16_Deposit_clen(c: l16_Deposit_Cached) -> l16_Deposit_Cached & U32:
  match c:
    case l16_Deposit_Cached{arr, +n, +d, nodes, +lo, +hi}: (l16_Deposit_Cached{arr, n, d, nodes, lo, hi}, n)

def l16_Deposit_ctook(+n: U32, +d: Nat, nodes: Array<D.Digest>, +lo: U32, +hi: U32, pair: Array<O.Boxed<Deposit>> & O.Boxed<Deposit>) -> l16_Deposit_Cached & Maybe<&1, Deposit>:
  (arr, v) = pair
  (l16_Deposit_Cached{arr, n, d, nodes, lo, hi}, Some{Deposit_bx_unbox(v)})

def l16_Deposit_cget_in(inside: Bool, arr: Array<O.Boxed<Deposit>>, +n: U32, +d: Nat, nodes: Array<D.Digest>, +lo: U32, +hi: U32, +i: U32) -> l16_Deposit_Cached & Maybe<&1, Deposit>:
  match inside:
    case True{}: l16_Deposit_ctook(n, d, nodes, lo, hi, Array.swap(O.Boxed<Deposit>, arr, i, O.BNone{}))
    case False{}: (l16_Deposit_Cached{arr, n, d, nodes, lo, hi}, None{})

def l16_Deposit_cget(c: l16_Deposit_Cached, +i: U32) -> l16_Deposit_Cached & Maybe<&1, Deposit>:
  match c:
    case l16_Deposit_Cached{arr, +n, +d, nodes, +lo, +hi}: l16_Deposit_cget_in(U32.is_lt(i, n), arr, n, d, nodes, lo, hi, i)

def l16_Deposit_cset_in(ok: Bool, arr: Array<O.Boxed<Deposit>>, +n: U32, +d: Nat, nodes: Array<D.Digest>, +lo: U32, +hi: U32, +i: U32, v: Deposit) -> l16_Deposit_Cached & Bool:
  match ok:
    case True{}: (l16_Deposit_Cached{Array.set(O.Boxed<Deposit>, arr, i, Deposit_bx_wrap(v)), n, d, nodes, O.pick(U32.is_le(lo, i), lo, i), O.pick(U32.is_le(i, hi), hi, i)}, True{})
    case False{}: (l16_Deposit_Cached{arr, n, d, nodes, lo, hi}, False{})

def l16_Deposit_cset(c: l16_Deposit_Cached, +i: U32, v: Deposit) -> l16_Deposit_Cached & Bool:
  match c:
    case l16_Deposit_Cached{arr, +n, +d, nodes, +lo, +hi}: l16_Deposit_cset_in(U32.is_lt(i, n), arr, n, d, nodes, lo, hi, i, v)

def l16_Deposit_capp_fit(fits: Bool, arr: Array<O.Boxed<Deposit>>, +n: U32, +d: Nat, nodes: Array<D.Digest>, +lo: U32, +hi: U32, v: Deposit) -> l16_Deposit_Cached:
  match fits:
    case True{}: l16_Deposit_Cached{Array.set(O.Boxed<Deposit>, arr, n, Deposit_bx_wrap(v)), (n + 1 : U32), d, nodes, O.pick(U32.is_le(lo, n), lo, n), O.pick(U32.is_le(n, hi), hi, n)}
    case False{}: l16_Deposit_Cached{Array.set(O.Boxed<Deposit>, l16_Deposit_room(arr, n), n, Deposit_bx_wrap(v)), (n + 1 : U32), 1n+d, l16_Deposit_dfill(2n+d), 0, (O.pow2u(1n+d) - 1 : U32)}

def l16_Deposit_capp_in(ok: Bool, arr: Array<O.Boxed<Deposit>>, +n: U32, +d: Nat, nodes: Array<D.Digest>, +lo: U32, +hi: U32, v: Deposit) -> l16_Deposit_Cached & Bool:
  match ok:
    case True{}: (l16_Deposit_capp_fit(U32.is_lt(n, O.pow2u(d)), arr, n, d, nodes, lo, hi, v), True{})
    case False{}: (l16_Deposit_Cached{arr, n, d, nodes, lo, hi}, False{})

def l16_Deposit_capp(c: l16_Deposit_Cached, v: Deposit) -> l16_Deposit_Cached & Bool:
  match c:
    case l16_Deposit_Cached{arr, +n, +d, nodes, +lo, +hi}: l16_Deposit_capp_in(U32.is_le((n + 1 : U32), 16), arr, n, d, nodes, lo, hi, v)

def l16_Deposit_ts_store(ts: l16_Deposit_TS, +k: U32, +dg: D.Digest) -> l16_Deposit_TS:
  match ts:
    case l16_Deposit_TS{h, arr, nodes}: l16_Deposit_TS{h, arr, Array.set(D.Digest, nodes, k, dg)}

def l16_Deposit_leaf_put(+k: U32, h: B.Buf, arr: Array<O.Boxed<Deposit>>, nodes: Array<D.Digest>, +dg: D.Digest) -> l16_Deposit_TS:
  l16_Deposit_ts_store(l16_Deposit_TS{h, arr, nodes}, k, dg)

def l16_Deposit_leaf_fin(+k: U32, +i: U32, arr: Array<O.Boxed<Deposit>>, nodes: Array<D.Digest>, pr: B.Buf & (O.Boxed<Deposit> & D.Digest)) -> l16_Deposit_TS:
  (h, r) = pr
  (v, dg) = r
  l16_Deposit_leaf_put(k, h, Array.set(O.Boxed<Deposit>, arr, i, v), nodes, dg)

def l16_Deposit_leaf_go(+hl: Nat, +k: U32, +i: U32, +seg: U32, nodes: Array<D.Digest>, h: B.Buf, pr: Array<O.Boxed<Deposit>> & O.Boxed<Deposit>) -> l16_Deposit_TS:
  (arr, v) = pr
  l16_Deposit_leaf_fin(k, i, arr, nodes, Deposit_bx_root(hl, h, v, (seg + 64 : U32)))

def l16_Deposit_leaf_hash(+hl: Nat, +k: U32, +i: U32, +seg: U32, ts: l16_Deposit_TS) -> l16_Deposit_TS:
  match ts:
    case l16_Deposit_TS{h, arr, nodes}: l16_Deposit_leaf_go(hl, k, i, seg, nodes, h, Array.swap(O.Boxed<Deposit>, arr, i, O.BNone{}))

def l16_Deposit_leaf_step(+hl: Nat, inside: Bool, +k: U32, +i: U32, +seg: U32, ts: l16_Deposit_TS) -> l16_Deposit_TS:
  match inside:
    case True{}: l16_Deposit_leaf_hash(hl, k, i, seg, ts)
    case False{}: l16_Deposit_ts_store(ts, k, D.zero())

def l16_Deposit_leaves(+hl: Nat, +q: Nat, +i: U32, +n: U32, +seg: U32, +cap: U32, ts: l16_Deposit_TS) -> l16_Deposit_TS:
  match q:
    case 0n: ts
    case 1n+r:
      l16_Deposit_leaves(hl, r, (i + 1 : U32), n, seg, cap, l16_Deposit_leaf_step(hl, U32.is_lt(i, n), (cap + i : U32), i, seg, ts))

def l16_Deposit_node_fin(+hl: Nat, +j: U32, h: B.Buf, arr: Array<O.Boxed<Deposit>>, +dl: D.Digest, pr: Array<D.Digest> & D.Digest) -> l16_Deposit_TS:
  (nodes, +dr) = pr
  l16_Deposit_ts_store(l16_Deposit_TS{h, arr, nodes}, j, D.node(hl, dl, dr))

def l16_Deposit_node_go(+hl: Nat, +j: U32, h: B.Buf, arr: Array<O.Boxed<Deposit>>, pr: Array<D.Digest> & D.Digest) -> l16_Deposit_TS:
  (nodes, +dl) = pr
  l16_Deposit_node_fin(hl, j, h, arr, dl, Array.get(D.Digest, nodes, (2 * j + 1 : U32)))

def l16_Deposit_node_step(+hl: Nat, +j: U32, ts: l16_Deposit_TS) -> l16_Deposit_TS:
  match ts:
    case l16_Deposit_TS{h, arr, nodes}: l16_Deposit_node_go(hl, j, h, arr, Array.get(D.Digest, nodes, (2 * j : U32)))

def l16_Deposit_level(+hl: Nat, +q: Nat, +j: U32, ts: l16_Deposit_TS) -> l16_Deposit_TS:
  match q:
    case 0n: ts
    case 1n+r: l16_Deposit_level(hl, r, (j + 1 : U32), l16_Deposit_node_step(hl, j, ts))

def l16_Deposit_levels(+hl: Nat, +L: Nat, +klo: U32, +khi: U32, ts: l16_Deposit_TS) -> l16_Deposit_TS:
  match L:
    case 0n: ts
    case 1n+q:
      l16_Deposit_levels(hl, q, U32.shrn(klo, 1n), U32.shrn(khi, 1n), l16_Deposit_level(hl, U32.to_nat((U32.shrn(khi, 1n) - U32.shrn(klo, 1n) + 1 : U32)), U32.shrn(klo, 1n), ts))

def l16_Deposit_sweep(+hl: Nat, +d: Nat, +lo: U32, +hi: U32, +n: U32, +seg: U32, ts: l16_Deposit_TS) -> l16_Deposit_TS:
  l16_Deposit_levels(hl, d, (O.pow2u(d) + lo : U32), (O.pow2u(d) + hi : U32), l16_Deposit_leaves(hl, U32.to_nat((hi - lo + 1 : U32)), lo, n, seg, O.pow2u(d), ts))

def l16_Deposit_sweep_pick(+hl: Nat, some: Bool, +d: Nat, +lo: U32, +hi: U32, +n: U32, +seg: U32, ts: l16_Deposit_TS) -> l16_Deposit_TS:
  match some:
    case True{}: l16_Deposit_sweep(hl, d, lo, hi, n, seg, ts)
    case False{}: ts

def l16_Deposit_pad_go(+hl: Nat, +k: Nat, +lvl: U32, +r: D.Digest, pr: B.Buf & D.Digest) -> B.Buf & D.Digest:
  match k:
    case 0n:
      (h, +z) = pr
      (h, r)
    case 1n+q:
      (h, +z) = pr
      l16_Deposit_pad_go(hl, q, (lvl + 1 : U32), D.node(hl, r, z), (h, D.zconst(U32.to_nat((lvl + 1 : U32)))))

def l16_Deposit_croot_fin(+hl: Nat, +n: U32, +d: Nat, arr: Array<O.Boxed<Deposit>>, nodes: Array<D.Digest>, pr: B.Buf & D.Digest) -> B.Buf & (l16_Deposit_Cached & D.Digest):
  (h, +r) = pr
  (h, (l16_Deposit_Cached{arr, n, d, nodes, n, 0}, O.mix_len(hl, r, n)))

def l16_Deposit_croot_pad(+hl: Nat, +n: U32, +d: Nat, arr: Array<O.Boxed<Deposit>>, nodes: Array<D.Digest>, h: B.Buf, +r: D.Digest) -> B.Buf & (l16_Deposit_Cached & D.Digest):
  l16_Deposit_croot_fin(hl, n, d, arr, nodes, l16_Deposit_pad_go(hl, Nat.sub(4n, d), O.nat_u32(d), r, (h, D.zconst(d))))

def l16_Deposit_croot_read(+hl: Nat, +n: U32, +d: Nat, h: B.Buf, arr: Array<O.Boxed<Deposit>>, pr: Array<D.Digest> & D.Digest) -> B.Buf & (l16_Deposit_Cached & D.Digest):
  (nodes, +r) = pr
  l16_Deposit_croot_pad(hl, n, d, arr, nodes, h, r)

def l16_Deposit_croot_top(+hl: Nat, +n: U32, +d: Nat, ts: l16_Deposit_TS) -> B.Buf & (l16_Deposit_Cached & D.Digest):
  match ts:
    case l16_Deposit_TS{h, arr, nodes}: l16_Deposit_croot_read(hl, n, d, h, arr, Array.get(D.Digest, nodes, 1))

def l16_Deposit_cached_root(+hl: Nat, h: B.Buf, c: l16_Deposit_Cached, +seg: U32) -> B.Buf & (l16_Deposit_Cached & D.Digest):
  match c:
    case l16_Deposit_Cached{arr, +n, +d, nodes, +lo, +hi}:
      l16_Deposit_croot_top(hl, n, d, l16_Deposit_sweep_pick(hl, U32.is_le(lo, hi), d, lo, hi, n, seg, l16_Deposit_TS{h, arr, nodes}))

type l16_SignedVoluntaryExit_Seq is Type:
  l16_SignedVoluntaryExit_Seq{items: Array<SignedVoluntaryExit>, n: U32}

def l16_SignedVoluntaryExit_fill(+d: Nat) -> Array<SignedVoluntaryExit>: Array.new(SignedVoluntaryExit, d, SignedVoluntaryExit_default())

def l16_SignedVoluntaryExit_cap(+n: U32) -> Nat: B.words_depth(n)

def l16_SignedVoluntaryExit_default() -> l16_SignedVoluntaryExit_Seq: l16_SignedVoluntaryExit_Seq{l16_SignedVoluntaryExit_fill(0n), 0}

def l16_SignedVoluntaryExit_rd(+k: Nat, +i: U32, +off: U32, arr: Array<SignedVoluntaryExit>, pair: B.Buf & SignedVoluntaryExit) -> B.Buf & Array<SignedVoluntaryExit>:
  match k:
    case 0n:
      (buf, +v) = pair
      (buf, Array.set(SignedVoluntaryExit, arr, i, v))
    case 1n+q:
      (buf, +v) = pair
      l16_SignedVoluntaryExit_rd(q, (i + 1 : U32), off, Array.set(SignedVoluntaryExit, arr, i, v), SignedVoluntaryExit_read(buf, (off + (i + 1 : U32) * 112 : U32), 112))

def l16_SignedVoluntaryExit_rd_fin(+n: U32, pair: B.Buf & Array<SignedVoluntaryExit>) -> B.Buf & l16_SignedVoluntaryExit_Seq:
  (buf, arr) = pair
  (buf, l16_SignedVoluntaryExit_Seq{arr, n})

def l16_SignedVoluntaryExit_rd_start(empty: Bool, +off: U32, +n: U32, buf: B.Buf) -> B.Buf & l16_SignedVoluntaryExit_Seq:
  match empty:
    case True{}: (buf, l16_SignedVoluntaryExit_Seq{l16_SignedVoluntaryExit_fill(0n), 0})
    case False{}: l16_SignedVoluntaryExit_rd_fin(n, l16_SignedVoluntaryExit_rd(U32.to_nat((n - 1 : U32)), 0, off, l16_SignedVoluntaryExit_fill(l16_SignedVoluntaryExit_cap(n)), SignedVoluntaryExit_read(buf, off, 112)))

def l16_SignedVoluntaryExit_read(buf: B.Buf, +off: U32, +len: U32) -> B.Buf & l16_SignedVoluntaryExit_Seq: l16_SignedVoluntaryExit_rd_start(U32.is_eq(len, 0), off, U32.div(len, 112), buf)

def l16_SignedVoluntaryExit_szf(+n: U32, pair: Array<SignedVoluntaryExit> & U32) -> l16_SignedVoluntaryExit_Seq & U32:
  (arr, +c) = pair
  (l16_SignedVoluntaryExit_Seq{arr, n}, O.pick(U32.is_le(n, c), (n * 112 : U32), 2147483648))

def l16_SignedVoluntaryExit_size(o: l16_SignedVoluntaryExit_Seq) -> l16_SignedVoluntaryExit_Seq & U32:
  match o:
    case l16_SignedVoluntaryExit_Seq{arr, +n}: l16_SignedVoluntaryExit_szf(n, Array.size(SignedVoluntaryExit, arr))

def l16_SignedVoluntaryExit_pt(+k: Nat, +i: U32, +pos: U32, out: Array<U32>, pair: Array<SignedVoluntaryExit> & SignedVoluntaryExit) -> Array<U32> & Array<SignedVoluntaryExit>:
  match k:
    case 0n:
      (arr, +v) = pair
      (SignedVoluntaryExit_put(out, (pos + i * 112 : U32), v), arr)
    case 1n+q:
      (arr, +v) = pair
      l16_SignedVoluntaryExit_pt(q, (i + 1 : U32), pos, SignedVoluntaryExit_put(out, (pos + i * 112 : U32), v), Array.get(SignedVoluntaryExit, arr, (i + 1 : U32)))

def l16_SignedVoluntaryExit_pt_fin(+n: U32, pair: Array<U32> & Array<SignedVoluntaryExit>) -> Array<U32> & l16_SignedVoluntaryExit_Seq:
  (out, arr) = pair
  (out, l16_SignedVoluntaryExit_Seq{arr, n})

def l16_SignedVoluntaryExit_pt_nz(empty: Bool, +pos: U32, +n: U32, out: Array<U32>, arr: Array<SignedVoluntaryExit>) -> Array<U32> & l16_SignedVoluntaryExit_Seq:
  match empty:
    case True{}: (out, l16_SignedVoluntaryExit_Seq{arr, n})
    case False{}: l16_SignedVoluntaryExit_pt_fin(n, l16_SignedVoluntaryExit_pt(U32.to_nat((n - 1 : U32)), 0, pos, out, Array.get(SignedVoluntaryExit, arr, 0)))

def l16_SignedVoluntaryExit_put(out: Array<U32>, +pos: U32, o: l16_SignedVoluntaryExit_Seq) -> Array<U32> & l16_SignedVoluntaryExit_Seq:
  match o:
    case l16_SignedVoluntaryExit_Seq{arr, +n}: l16_SignedVoluntaryExit_pt_nz(U32.is_eq(n, 0), pos, n, out, arr)

def l16_SignedVoluntaryExit_ptn_fin(+n: U32, pair: Array<U32> & l16_SignedVoluntaryExit_Seq) -> Array<U32> & (l16_SignedVoluntaryExit_Seq & U32):
  (out, sq) = pair
  (out, (sq, (n * 112 : U32)))

def l16_SignedVoluntaryExit_putn(out: Array<U32>, +pos: U32, o: l16_SignedVoluntaryExit_Seq) -> Array<U32> & (l16_SignedVoluntaryExit_Seq & U32):
  match o:
    case l16_SignedVoluntaryExit_Seq{arr, +n}: l16_SignedVoluntaryExit_ptn_fin(n, l16_SignedVoluntaryExit_pt_nz(U32.is_eq(n, 0), pos, n, out, arr))

def l16_SignedVoluntaryExit_rl_d(arr: Array<SignedVoluntaryExit>, pair: B.Buf & D.Digest) -> B.Buf & (Array<SignedVoluntaryExit> & D.Digest):
  (h, d) = pair
  (h, (arr, d))

def l16_SignedVoluntaryExit_rl(+hl: Nat, +seg: U32, h: B.Buf, pair: Array<SignedVoluntaryExit> & SignedVoluntaryExit) -> B.Buf & (Array<SignedVoluntaryExit> & D.Digest):
