def AttestationData_rt1(+hl: Nat, +seg: U32, +slot: O.U64, +index: O.U64, +beacon_block_root: Bytes32, +source: Checkpoint, +target: Checkpoint, d_slot: D.Digest, pair: B.Buf & D.Digest) -> B.Buf & D.Digest:
  (h, d_index) = pair
  AttestationData_rt2(hl, seg, slot, index, beacon_block_root, source, target, d_slot, d_index, b32_root(hl, h, beacon_block_root, seg))

def AttestationData_rt0(+hl: Nat, +seg: U32, +slot: O.U64, +index: O.U64, +beacon_block_root: Bytes32, +source: Checkpoint, +target: Checkpoint, pair: B.Buf & D.Digest) -> B.Buf & D.Digest:
