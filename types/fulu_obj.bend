def HistoricalBatch_pw0(+pos: U32, +cur: U32, state_roots: O.Words, pair: Array<U32> & (O.Words & U32)) -> Array<U32> & (HistoricalBatch & U32):
  (out, r) = pair
  (block_roots, fl) = r
  HistoricalBatch_pw1(pos, (cur .|. fl : U32), block_roots, v8192_b32_putk(out, (pos + 262144 : U32), state_roots))

def HistoricalBatch_putk(out: Array<U32>, +pos: U32, o: HistoricalBatch) -> Array<U32> & (HistoricalBatch & U32):
  match o:
    case HistoricalBatch{block_roots, state_roots}: HistoricalBatch_pw0(pos, 0, state_roots, v8192_b32_putk(out, (pos + 0 : U32), block_roots))

def HistoricalBatch_put_drop_go(out: Array<U32>, v: HistoricalBatch, +m: U32) -> Array<U32> & HistoricalBatch: (out, v)

def HistoricalBatch_put_drop(pair: Array<U32> & (HistoricalBatch & U32)) -> Array<U32> & HistoricalBatch:
  (out, r) = pair
  (v, m) = r
  HistoricalBatch_put_drop_go(out, v, m)

def HistoricalBatch_put(out: Array<U32>, +pos: U32, o: HistoricalBatch) -> Array<U32> & HistoricalBatch: HistoricalBatch_put_drop(HistoricalBatch_putk(out, pos, o))

def HistoricalBatch_rt1(+hl: Nat, +seg: U32, block_roots: O.Words, d_block_roots: D.Digest, pair: B.Buf & (O.Words & D.Digest)) -> B.Buf & (HistoricalBatch & D.Digest):
