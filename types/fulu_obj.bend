    case False{}: (buf, False{})

def ExecutionRequests_v0(+off: U32, +len: U32, pair: B.Buf & U32) -> B.Buf & Bool:
  (buf, +o0) = pair
  ExecutionRequests_c0(U32.is_eq(o0, 12), buf, off, len, o0)

def ExecutionRequests_ok_len(ok: Bool, buf: B.Buf, +off: U32, +len: U32) -> B.Buf & Bool:
  match ok:
    case True{}: ExecutionRequests_v0(off, len, B.read32(buf, (off + 0 : U32)))
    case False{}: (buf, False{})

def ExecutionRequests_ok(buf: B.Buf, +off: U32, +len: U32) -> B.Buf & Bool: ExecutionRequests_ok_len(U32.is_le(12, len), buf, off, len)

type BLSToExecutionChange is Data:
  BLSToExecutionChange{validator_index: O.U64, from_bls_pubkey: Bytes48, to_execution_address: Bytes20}

def BLSToExecutionChange_default() -> BLSToExecutionChange: BLSToExecutionChange{u64_default(), b48_default(), b20_default()}

def BLSToExecutionChange_rd2(+off: U32, +len: U32, +validator_index: O.U64, +from_bls_pubkey: Bytes48, pair: B.Buf & Bytes20) -> B.Buf & BLSToExecutionChange:
  (buf, +to_execution_address) = pair
  (buf, BLSToExecutionChange{validator_index, from_bls_pubkey, to_execution_address})

def BLSToExecutionChange_rd1(+off: U32, +len: U32, +validator_index: O.U64, pair: B.Buf & Bytes48) -> B.Buf & BLSToExecutionChange:
  (buf, +from_bls_pubkey) = pair
  BLSToExecutionChange_rd2(off, len, validator_index, from_bls_pubkey, b20_read(buf, (off + 56 : U32), 20))

def BLSToExecutionChange_rd0(+off: U32, +len: U32, pair: B.Buf & O.U64) -> B.Buf & BLSToExecutionChange:
  (buf, +validator_index) = pair
  BLSToExecutionChange_rd1(off, len, validator_index, b48_read(buf, (off + 8 : U32), 48))

def BLSToExecutionChange_read(buf: B.Buf, +off: U32, +len: U32) -> B.Buf & BLSToExecutionChange: BLSToExecutionChange_rd0(off, len, u64_read(buf, (off + 0 : U32), 8))

def BLSToExecutionChange_put(out: Array<U32>, +pos: U32, o: BLSToExecutionChange) -> Array<U32>:
  match o:
    case BLSToExecutionChange{+validator_index, +from_bls_pubkey, +to_execution_address}: b20_put(b48_put(u64_put(out, (pos + 0 : U32), validator_index), (pos + 8 : U32), from_bls_pubkey), (pos + 56 : U32), to_execution_address)

def BLSToExecutionChange_rt2(+hl: Nat, +seg: U32, +validator_index: O.U64, +from_bls_pubkey: Bytes48, +to_execution_address: Bytes20, d_validator_index: D.Digest, d_from_bls_pubkey: D.Digest, pair: B.Buf & D.Digest) -> B.Buf & D.Digest:
  (h, d_to_execution_address) = pair
  (h, D.node(hl, D.node(hl, d_validator_index, d_from_bls_pubkey), D.node(hl, d_to_execution_address, D.zero())))

def BLSToExecutionChange_rt1(+hl: Nat, +seg: U32, +validator_index: O.U64, +from_bls_pubkey: Bytes48, +to_execution_address: Bytes20, d_validator_index: D.Digest, pair: B.Buf & D.Digest) -> B.Buf & D.Digest:
  (h, d_from_bls_pubkey) = pair
  BLSToExecutionChange_rt2(hl, seg, validator_index, from_bls_pubkey, to_execution_address, d_validator_index, d_from_bls_pubkey, b20_root(hl, h, to_execution_address, seg))

def BLSToExecutionChange_rt0(+hl: Nat, +seg: U32, +validator_index: O.U64, +from_bls_pubkey: Bytes48, +to_execution_address: Bytes20, pair: B.Buf & D.Digest) -> B.Buf & D.Digest:
  (h, d_validator_index) = pair
  BLSToExecutionChange_rt1(hl, seg, validator_index, from_bls_pubkey, to_execution_address, d_validator_index, b48_root(hl, h, from_bls_pubkey, seg))

def BLSToExecutionChange_root(+hl: Nat, h: B.Buf, o: BLSToExecutionChange, +seg: U32) -> B.Buf & D.Digest:
  match o:
    case BLSToExecutionChange{+validator_index, +from_bls_pubkey, +to_execution_address}: BLSToExecutionChange_rt0(hl, seg, validator_index, from_bls_pubkey, to_execution_address, u64_root(hl, h, validator_index, seg))

