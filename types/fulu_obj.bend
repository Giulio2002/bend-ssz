def Eth1Data_rt2(+hl: Nat, +seg: U32, +deposit_root: Bytes32, +deposit_count: O.U64, +block_hash: Bytes32, d_deposit_root: D.Digest, d_deposit_count: D.Digest, pair: B.Buf & D.Digest) -> B.Buf & D.Digest:
