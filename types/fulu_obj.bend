def ExecutionRequests_fo0(withdrawals: l16_WithdrawalRequest_Seq, consolidations: l2_ConsolidationRequest_Seq, +acc: U32, pair: l8192_DepositRequest_Seq & U32) -> ExecutionRequests & U32:
