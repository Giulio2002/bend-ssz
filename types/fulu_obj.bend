# ---- PendingAttestation ----

def PendingAttestation_some(pair: B.Buf & PendingAttestation) -> B.Buf & Maybe<&1, PendingAttestation>:
  (buf, v) = pair
  (buf, Some{v})

def PendingAttestation_built(+size: U32, pair: B.Buf & Bool) -> B.Buf & Maybe<&1, PendingAttestation>:
  (buf, ok) = pair
  match ok:
    case True{}: PendingAttestation_some(PendingAttestation_read(buf, 0, size))
    case False{}: (buf, None{})

def PendingAttestation_decode(buf: B.Buf, +size: U32) -> B.Buf & Maybe<&1, PendingAttestation>:
  PendingAttestation_built(size, PendingAttestation_ok(buf, 0, size))

def PendingAttestation_build(buf: B.Buf, +size: U32) -> B.Buf & PendingAttestation: PendingAttestation_read(buf, 0, size)

def PendingAttestation_enc_out(+n: U32, out: Array<U32>, o: PendingAttestation, +m: U32) -> PendingAttestation & B.Buf:
  (o, O.out_done(n, out))

def PendingAttestation_enc_put(+n: U32, pair: Array<U32> & (PendingAttestation & U32)) -> PendingAttestation & B.Buf:
  (out, r) = pair
  (o, m) = r
  PendingAttestation_enc_out(n, out, o, m)

def PendingAttestation_enc_sized(pair: PendingAttestation & U32) -> PendingAttestation & B.Buf:
  (o, +n) = pair
  PendingAttestation_enc_put(n, PendingAttestation_putn(O.out_new(n), 0, o))

def PendingAttestation_encode(o: PendingAttestation) -> PendingAttestation & B.Buf: PendingAttestation_enc_sized(PendingAttestation_size(o))

def PendingAttestation_hash_tree_root(h: B.Buf, o: PendingAttestation) -> B.Buf & (PendingAttestation & D.Digest): PendingAttestation_root(64n, h, o, 0)

def PendingAttestation_fz0_fin(ok: Bool, pr: PendingAttestation & O.Bits) -> PendingAttestation & Bool:
  (obj, old) = pr
  (obj, ok)

def PendingAttestation_fz0_back(obj: PendingAttestation, res: O.Bits & Bool) -> PendingAttestation & Bool:
  (c, ok) = res
  PendingAttestation_fz0_fin(ok, PendingAttestation_swap_aggregation_bits(obj, c))

def PendingAttestation_fz0_in(+a: U32, +b: U32, pr: PendingAttestation & O.Bits) -> PendingAttestation & Bool:
  (obj, c) = pr
  PendingAttestation_fz0_back(obj, bits2048_set(c, a, U32.is_eq((b .&. 1 : U32), 1)))

def PendingAttestation_fz0(o: PendingAttestation, +a: U32, +b: U32) -> PendingAttestation & Bool:
  PendingAttestation_fz0_in(a, b, PendingAttestation_swap_aggregation_bits(o, bits2048_default()))

def PendingAttestation_fz1_fin(ok: Bool, pr: PendingAttestation & O.Bits) -> PendingAttestation & Bool:
  (obj, old) = pr
  (obj, ok)

def PendingAttestation_fz1_back(obj: PendingAttestation, res: O.Bits & Bool) -> PendingAttestation & Bool:
  (c, ok) = res
  PendingAttestation_fz1_fin(ok, PendingAttestation_swap_aggregation_bits(obj, c))

def PendingAttestation_fz1_in(+a: U32, +b: U32, pr: PendingAttestation & O.Bits) -> PendingAttestation & Bool:
  (obj, c) = pr
  PendingAttestation_fz1_back(obj, bits2048_append(c, U32.is_eq((b .&. 1 : U32), 1)))

def PendingAttestation_fz1(o: PendingAttestation, +a: U32, +b: U32) -> PendingAttestation & Bool:
  PendingAttestation_fz1_in(a, b, PendingAttestation_swap_aggregation_bits(o, bits2048_default()))

def PendingAttestation_fz2(o: PendingAttestation, +a: U32, +b: U32) -> PendingAttestation & Bool:
  (PendingAttestation_set_data(o, AttestationData_seed(b)), True{})

def PendingAttestation_fz3(o: PendingAttestation, +a: U32, +b: U32) -> PendingAttestation & Bool:
  (PendingAttestation_set_inclusion_delay(o, u64_seed(b)), True{})

def PendingAttestation_fz4(o: PendingAttestation, +a: U32, +b: U32) -> PendingAttestation & Bool:
  (PendingAttestation_set_proposer_index(o, u64_seed(b)), True{})

def PendingAttestation_fzc0(o: PendingAttestation, +sel: U32, +a: U32, +b: U32) -> PendingAttestation & Bool:
  match sel:
    case 0: PendingAttestation_fz0(o, a, b)
    case 1: PendingAttestation_fz1(o, a, b)
    case 2: PendingAttestation_fz2(o, a, b)
    case 3: PendingAttestation_fz3(o, a, b)
    case _: PendingAttestation_fz4(o, a, b)

def PendingAttestation_fuzz_hi(+c: U32, o: PendingAttestation, +sel: U32, +a: U32, +b: U32) -> PendingAttestation & Bool:
  match c:
    case _: PendingAttestation_fzc0(o, sel, a, b)

