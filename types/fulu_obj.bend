def Validator_c0(ok: Bool, buf: B.Buf, +off: U32) -> B.Buf & Bool:
  match ok:
    case True{}: (buf, True{})
    case False{}: (buf, False{})

def Validator_v0(+off: U32, pair: B.Buf & Bool) -> B.Buf & Bool:
  (buf, ok) = pair
  Validator_c0(ok, buf, off)

def Validator_ok_at(buf: B.Buf, +off: U32) -> B.Buf & Bool: Validator_v0(off, bool_ok_at(buf, (off + 88 : U32)))

def Validator_ok_len(ok: Bool, buf: B.Buf, +off: U32) -> B.Buf & Bool:
  match ok:
    case True{}: Validator_ok_at(buf, off)
    case False{}: (buf, False{})

def Validator_ok(buf: B.Buf, +off: U32, +len: U32) -> B.Buf & Bool: Validator_ok_len(U32.is_eq(len, 121), buf, off)

def Validator_seed(+x: U32) -> Validator: Validator{b48_seed((x + 1 : U32)), b32_seed((x + 2 : U32)), u64_seed((x + 3 : U32)), bool_seed((x + 4 : U32)), u64_seed((x + 5 : U32)), u64_seed((x + 6 : U32)), u64_seed((x + 7 : U32)), u64_seed((x + 8 : U32))}

def v6_b32_default() -> O.Words: O.words_new(192)

def v6_b32_read(buf: B.Buf, +off: U32, +len: U32) -> B.Buf & O.Words: O.copy_into(buf, off, 192, Array.new(U32, 6n, 0))

def v6_b32_size(o: O.Words) -> O.Words & U32: O.words_sizek(o)

