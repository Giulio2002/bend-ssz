  DataColumnSidecar_c1(Bool.and(U32.is_le(o0, o1), U32.is_le(o1, len)), buf, off, len, o0, o1)

def DataColumnSidecar_c0(ok: Bool, buf: B.Buf, +off: U32, +len: U32, +o0: U32) -> B.Buf & Bool:
