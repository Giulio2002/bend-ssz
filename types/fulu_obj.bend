  (obj, ok)

def BlobSidecar_fz1_back(obj: BlobSidecar, res: O.Words & Bool) -> BlobSidecar & Bool:
  (c, ok) = res
  BlobSidecar_fz1_fin(ok, BlobSidecar_swap_blob(obj, c))

def BlobSidecar_fz1_in(+a: U32, +b: U32, pr: BlobSidecar & O.Words) -> BlobSidecar & Bool:
  (obj, c) = pr
  BlobSidecar_fz1_back(obj, b131072_set(c, a, (b .&. 255 : U32)))

def BlobSidecar_fz1(o: BlobSidecar, +a: U32, +b: U32) -> BlobSidecar & Bool:
  BlobSidecar_fz1_in(a, b, BlobSidecar_swap_blob(o, b131072_default()))

def BlobSidecar_fz2(o: BlobSidecar, +a: U32, +b: U32) -> BlobSidecar & Bool:
