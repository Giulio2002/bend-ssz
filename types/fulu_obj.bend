def HistoricalBatch_swap_block_roots(o: HistoricalBatch, v: O.Words) -> HistoricalBatch & O.Words:
  match o:
    case HistoricalBatch{block_roots, state_roots}: (HistoricalBatch{v, state_roots}, block_roots)

def HistoricalBatch_set_block_roots(o: HistoricalBatch, v: O.Words) -> HistoricalBatch:
  match o:
    case HistoricalBatch{block_roots, state_roots}: HistoricalBatch{v, state_roots}

def HistoricalBatch_swap_state_roots(o: HistoricalBatch, v: O.Words) -> HistoricalBatch & O.Words:
  match o:
    case HistoricalBatch{block_roots, state_roots}: (HistoricalBatch{block_roots, v}, state_roots)

def HistoricalBatch_set_state_roots(o: HistoricalBatch, v: O.Words) -> HistoricalBatch:
