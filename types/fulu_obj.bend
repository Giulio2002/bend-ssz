  (deposits, +m) = pair
  ExecutionRequests_sz1(consolidations, deposits, O.padd(acc, m), l16_WithdrawalRequest_size(withdrawals))

def ExecutionRequests_size(o: ExecutionRequests) -> ExecutionRequests & U32:
  match o:
    case ExecutionRequests{deposits, withdrawals, consolidations}: ExecutionRequests_sz0(withdrawals, consolidations, 12, l8192_DepositRequest_size(deposits))

