  HistoricalBatch_fz1_in(a, b, HistoricalBatch_swap_state_roots(o, v8192_b32_default()))

def HistoricalBatch_fzc0(o: HistoricalBatch, +sel: U32, +a: U32, +b: U32) -> HistoricalBatch & Bool:
  match sel:
