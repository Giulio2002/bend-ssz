    case False{}: (buf, False{})

def BLSToExecutionChange_ok(buf: B.Buf, +off: U32, +len: U32) -> B.Buf & Bool: BLSToExecutionChange_ok_len(U32.is_eq(len, 76), buf, off)

def BLSToExecutionChange_seed(+x: U32) -> BLSToExecutionChange: BLSToExecutionChange{u64_seed((x + 1 : U32)), b48_seed((x + 2 : U32)), b20_seed((x + 3 : U32))}

type SignedBLSToExecutionChange is Data:
  SignedBLSToExecutionChange{message: BLSToExecutionChange, signature: Bytes96}

def SignedBLSToExecutionChange_default() -> SignedBLSToExecutionChange: SignedBLSToExecutionChange{BLSToExecutionChange_default(), b96_default()}

