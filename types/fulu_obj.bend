  (out, r) = pair
  (v, sz) = r
  (out, (v, O.padd(cur, sz)))

def l8192_DepositRequest_putv(out: Array<U32>, +pos: U32, +hoff: U32, +cur: U32, v: l8192_DepositRequest_Seq) -> Array<U32> & (l8192_DepositRequest_Seq & U32):
  l8192_DepositRequest_pvb(cur, l8192_DepositRequest_putk(O.w32(out, (pos + hoff : U32), cur), (pos + cur : U32), v))

def l16_WithdrawalRequest_pvb(+cur: U32, pair: Array<U32> & (l16_WithdrawalRequest_Seq & U32)) -> Array<U32> & (l16_WithdrawalRequest_Seq & U32):
