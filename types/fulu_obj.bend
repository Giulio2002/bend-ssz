def l4096_b2048_default() -> O.Words: O.words_new(0)

def l4096_b2048_read(buf: B.Buf, +off: U32, +len: U32) -> B.Buf & O.Words: O.copy_in(buf, off, len)

def l4096_b2048_mix(+hl: Nat, pair: B.Buf & (O.Words & D.Digest)) -> B.Buf & (O.Words & D.Digest):
  (h, r) = pair
  (o, d) = r
  match o:
    case O.Words{ws, +n}: (h, (O.Words{ws, n}, O.mix_len(hl, d, U32.div(n, 2048))))

def l4096_b2048_size(o: O.Words) -> O.Words & U32: O.words_sizek(o)

def l4096_b2048_put(out: Array<U32>, +pos: U32, o: O.Words) -> Array<U32> & O.Words: O.put_words(out, pos, o)

def l4096_b2048_putn(out: Array<U32>, +pos: U32, o: O.Words) -> Array<U32> & (O.Words & U32): O.put_words_n(out, pos, o)

def l4096_b2048_root(+hl: Nat, h: B.Buf, o: O.Words, +seg: U32) -> B.Buf & (O.Words & D.Digest): l4096_b2048_mix(hl, O.elems_root(hl, h, o, 512, 6, 12, seg))

def l4096_b2048_force(o: O.Words) -> O.Words & U32: O.words_len(o)

def l4096_b2048_pk(out: Array<U32>, +pos: U32, pair: O.Words & Bool) -> Array<U32> & (O.Words & U32):
  (o, ok) = pair
  match ok:
    case True{}: l4096_b2048_putn(out, pos, o)
    case False{}: (out, (o, 2147483648))

def l4096_b2048_valid(o: O.Words) -> O.Words & Bool: O.words_ok(o, 0, 8388608, False{}, 2048)

def l4096_b2048_putk(out: Array<U32>, +pos: U32, o: O.Words) -> Array<U32> & (O.Words & U32): l4096_b2048_pk(out, pos, l4096_b2048_valid(o))

def l4096_b2048_dump(o: O.Words, t: +List<U32>) -> +List<U32>: O.dump_words_n(o, t)

def l4096_b2048_ok(buf: B.Buf, +off: U32, +len: U32) -> B.Buf & Bool: (buf, Bool.and(U32.is_eq(len, (U32.div(len, 2048) * 2048 : U32)), U32.is_le(U32.div(len, 2048), 4096)))

def l4096_b2048_len_of(pair: O.Words & U32) -> O.Words & U32:
  (o, +n) = pair
  (o, U32.div(n, 2048))

def l4096_b2048_len(o: O.Words) -> O.Words & U32: l4096_b2048_len_of(O.words_len(o))

def l4096_b2048_blit(pair: O.Words & O.Words) -> O.Words:
  (o, src) = pair
  o

def l4096_b2048_at(o: O.Words, +i: U32) -> O.Words & O.Words: O.words_slice(o, (i * 2048 : U32), 2048)

def l4096_b2048_some(pair: O.Words & O.Words) -> O.Words & Maybe<&1, O.Words>:
  (o, v) = pair
  (o, Some{v})

def l4096_b2048_get_in(inside: Bool, o: O.Words, +i: U32) -> O.Words & Maybe<&1, O.Words>:
  match inside:
    case True{}: l4096_b2048_some(l4096_b2048_at(o, i))
    case False{}: (o, None{})

def l4096_b2048_get_n(+i: U32, pair: O.Words & U32) -> O.Words & Maybe<&1, O.Words>:
  (o, +n) = pair
  l4096_b2048_get_in(U32.is_lt(i, n), o, i)

def l4096_b2048_get(o: O.Words, +i: U32) -> O.Words & Maybe<&1, O.Words>: l4096_b2048_get_n(i, l4096_b2048_len(o))

def l4096_b2048_put_at(ok: Bool, o: O.Words, +i: U32, v: O.Words) -> O.Words & Bool:
  match ok:
    case True{}: (l4096_b2048_blit(O.words_blit(o, (i * 2048 : U32), v)), True{})
    case False{}: (o, False{})

def l4096_b2048_set_n(+i: U32, v: O.Words, pair: O.Words & U32) -> O.Words & Bool:
  (o, +n) = pair
  l4096_b2048_put_at(U32.is_lt(i, n), o, i, v)

def l4096_b2048_set(o: O.Words, +i: U32, v: O.Words) -> O.Words & Bool: l4096_b2048_set_n(i, v, l4096_b2048_len(o))

def l4096_b2048_grow(ok: Bool, o: O.Words, +n: U32, v: O.Words) -> O.Words & Bool:
  match ok:
    case True{}: l4096_b2048_put_at(True{}, O.words_resize(O.words_fit(o, ((n + 1 : U32) * 2048 : U32)), ((n + 1 : U32) * 2048 : U32)), n, v)
    case False{}: (o, False{})

def l4096_b2048_app_n(v: O.Words, pair: O.Words & U32) -> O.Words & Bool:
  (o, +n) = pair
  l4096_b2048_grow(U32.is_le((n + 1 : U32), 4096), o, n, v)

def l4096_b2048_append(o: O.Words, v: O.Words) -> O.Words & Bool: l4096_b2048_app_n(v, l4096_b2048_len(o))

