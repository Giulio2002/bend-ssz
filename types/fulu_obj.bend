def FinalityBranch_fz0(o: O.Words, +a: U32, +b: U32) -> O.Words & Bool:
  v7_b32_set(o, a, b32_seed(b))

def FinalityBranch_fzc0(o: O.Words, +sel: U32, +a: U32, +b: U32) -> O.Words & Bool:
  match sel:
    case _: FinalityBranch_fz0(o, a, b)

def FinalityBranch_fuzz_hi(+c: U32, o: O.Words, +sel: U32, +a: U32, +b: U32) -> O.Words & Bool:
  match c:
    case _: FinalityBranch_fzc0(o, sel, a, b)

