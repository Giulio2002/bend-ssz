  l2_ConsolidationRequest_pvb(cur, l2_ConsolidationRequest_putk(O.w32(out, (pos + hoff : U32), cur), (pos + cur : U32), v))

def ExecutionRequests_pw2(+pos: U32, deposits: l8192_DepositRequest_Seq, withdrawals: l16_WithdrawalRequest_Seq, pair: Array<U32> & (l2_ConsolidationRequest_Seq & U32)) -> Array<U32> & (ExecutionRequests & U32):
  (out, r) = pair
  (consolidations, c) = r
  (out, (ExecutionRequests{deposits, withdrawals, consolidations}, c))

def ExecutionRequests_pw1(+pos: U32, deposits: l8192_DepositRequest_Seq, consolidations: l2_ConsolidationRequest_Seq, pair: Array<U32> & (l16_WithdrawalRequest_Seq & U32)) -> Array<U32> & (ExecutionRequests & U32):
  (out, r) = pair
  (withdrawals, c) = r
  ExecutionRequests_pw2(pos, deposits, withdrawals, l2_ConsolidationRequest_putv(out, pos, 8, c, consolidations))

def ExecutionRequests_pw0(+pos: U32, withdrawals: l16_WithdrawalRequest_Seq, consolidations: l2_ConsolidationRequest_Seq, pair: Array<U32> & (l8192_DepositRequest_Seq & U32)) -> Array<U32> & (ExecutionRequests & U32):
  (out, r) = pair
  (deposits, c) = r
  ExecutionRequests_pw1(pos, deposits, consolidations, l16_WithdrawalRequest_putv(out, pos, 4, c, withdrawals))

def ExecutionRequests_putn(out: Array<U32>, +pos: U32, o: ExecutionRequests) -> Array<U32> & (ExecutionRequests & U32):
  match o:
    case ExecutionRequests{deposits, withdrawals, consolidations}: ExecutionRequests_pw0(pos, withdrawals, consolidations, l8192_DepositRequest_putv(out, pos, 0, 12, deposits))

def ExecutionRequests_putk(out: Array<U32>, +pos: U32, o: ExecutionRequests) -> Array<U32> & (ExecutionRequests & U32): ExecutionRequests_putn(out, pos, o)

def ExecutionRequests_put_drop_go(out: Array<U32>, v: ExecutionRequests, +m: U32) -> Array<U32> & ExecutionRequests: (out, v)

def ExecutionRequests_put_drop(pair: Array<U32> & (ExecutionRequests & U32)) -> Array<U32> & ExecutionRequests:
  (out, r) = pair
  (v, m) = r
  ExecutionRequests_put_drop_go(out, v, m)

def ExecutionRequests_put(out: Array<U32>, +pos: U32, o: ExecutionRequests) -> Array<U32> & ExecutionRequests: ExecutionRequests_put_drop(ExecutionRequests_putn(out, pos, o))

def ExecutionRequests_rt2(+hl: Nat, +seg: U32, deposits: l8192_DepositRequest_Seq, withdrawals: l16_WithdrawalRequest_Seq, d_deposits: D.Digest, d_withdrawals: D.Digest, pair: B.Buf & (l2_ConsolidationRequest_Seq & D.Digest)) -> B.Buf & (ExecutionRequests & D.Digest):
