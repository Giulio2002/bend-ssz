def SignedBLSToExecutionChange_rd0(+off: U32, +len: U32, pair: B.Buf & BLSToExecutionChange) -> B.Buf & SignedBLSToExecutionChange:
  (buf, +message) = pair
  SignedBLSToExecutionChange_rd1(off, len, message, b96_read(buf, (off + 76 : U32), 96))

def SignedBLSToExecutionChange_read(buf: B.Buf, +off: U32, +len: U32) -> B.Buf & SignedBLSToExecutionChange: SignedBLSToExecutionChange_rd0(off, len, BLSToExecutionChange_read(buf, (off + 0 : U32), 76))

def SignedBLSToExecutionChange_put(out: Array<U32>, +pos: U32, o: SignedBLSToExecutionChange) -> Array<U32>:
  match o:
    case SignedBLSToExecutionChange{+message, +signature}: b96_put(BLSToExecutionChange_put(out, (pos + 0 : U32), message), (pos + 76 : U32), signature)

def SignedBLSToExecutionChange_rt1(+hl: Nat, +seg: U32, +message: BLSToExecutionChange, +signature: Bytes96, d_message: D.Digest, pair: B.Buf & D.Digest) -> B.Buf & D.Digest:
  (h, d_signature) = pair
  (h, D.node(hl, d_message, d_signature))

def SignedBLSToExecutionChange_rt0(+hl: Nat, +seg: U32, +message: BLSToExecutionChange, +signature: Bytes96, pair: B.Buf & D.Digest) -> B.Buf & D.Digest:
  (h, d_message) = pair
  SignedBLSToExecutionChange_rt1(hl, seg, message, signature, d_message, b96_root(hl, h, signature, seg))

def SignedBLSToExecutionChange_root(+hl: Nat, h: B.Buf, o: SignedBLSToExecutionChange, +seg: U32) -> B.Buf & D.Digest:
  match o:
    case SignedBLSToExecutionChange{+message, +signature}: SignedBLSToExecutionChange_rt0(hl, seg, message, signature, BLSToExecutionChange_root(hl, h, message, seg))

def SignedBLSToExecutionChange_get_message(o: SignedBLSToExecutionChange) -> SignedBLSToExecutionChange & BLSToExecutionChange:
  match o:
    case SignedBLSToExecutionChange{+message, +signature}: (SignedBLSToExecutionChange{message, signature}, message)

def SignedBLSToExecutionChange_set_message(o: SignedBLSToExecutionChange, +v: BLSToExecutionChange) -> SignedBLSToExecutionChange:
  match o:
    case SignedBLSToExecutionChange{+message, +signature}: SignedBLSToExecutionChange{v, signature}

def SignedBLSToExecutionChange_get_signature(o: SignedBLSToExecutionChange) -> SignedBLSToExecutionChange & Bytes96:
  match o:
    case SignedBLSToExecutionChange{+message, +signature}: (SignedBLSToExecutionChange{message, signature}, signature)

def SignedBLSToExecutionChange_set_signature(o: SignedBLSToExecutionChange, +v: Bytes96) -> SignedBLSToExecutionChange:
  match o:
    case SignedBLSToExecutionChange{+message, +signature}: SignedBLSToExecutionChange{message, v}

def SignedBLSToExecutionChange_force(o: SignedBLSToExecutionChange) -> U32:
  match o:
    case SignedBLSToExecutionChange{+message, +signature}: (BLSToExecutionChange_force(message) .^. b96_force(signature) : U32)

def SignedBLSToExecutionChange_dump(o: SignedBLSToExecutionChange, t: +List<U32>) -> +List<U32>:
  match o:
    case SignedBLSToExecutionChange{+message, +signature}: BLSToExecutionChange_dump(message, b96_dump(signature, t))

def SignedBLSToExecutionChange_ok_at(buf: B.Buf, +off: U32) -> B.Buf & Bool: (buf, True{})

def SignedBLSToExecutionChange_ok_len(ok: Bool, buf: B.Buf, +off: U32) -> B.Buf & Bool:
  match ok:
    case True{}: SignedBLSToExecutionChange_ok_at(buf, off)
    case False{}: (buf, False{})

def SignedBLSToExecutionChange_ok(buf: B.Buf, +off: U32, +len: U32) -> B.Buf & Bool: SignedBLSToExecutionChange_ok_len(U32.is_eq(len, 172), buf, off)

def SignedBLSToExecutionChange_seed(+x: U32) -> SignedBLSToExecutionChange: SignedBLSToExecutionChange{BLSToExecutionChange_seed((x + 1 : U32)), b96_seed((x + 2 : U32))}

def b256_default() -> O.Words: O.words_new(256)

def b256_read(buf: B.Buf, +off: U32, +len: U32) -> B.Buf & O.Words: O.copy_into(buf, off, 256, Array.new(U32, 7n, 0))

def b256_size(o: O.Words) -> O.Words & U32: O.words_sizek(o)

