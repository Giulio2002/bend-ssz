  MatrixEntry_rd1(off, len, cell, b48_read(buf, (off + 2048 : U32), 48))

def MatrixEntry_read(buf: B.Buf, +off: U32, +len: U32) -> B.Buf & MatrixEntry: MatrixEntry_rd0(off, len, b2048_read(buf, (off + 0 : U32), 2048))

def MatrixEntry_size(o: MatrixEntry) -> MatrixEntry & U32: (o, 2112)

def MatrixEntry_pw0(+pos: U32, +cur: U32, +kzg_proof: Bytes48, +column_index: O.U64, +row_index: O.U64, pair: Array<U32> & (O.Words & U32)) -> Array<U32> & (MatrixEntry & U32):
