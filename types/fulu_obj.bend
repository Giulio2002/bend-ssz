  (h, D.node(hl, D.node(hl, d_deposit_root, d_deposit_count), D.node(hl, d_block_hash, D.zero())))

def Eth1Data_rt1(+hl: Nat, +seg: U32, +deposit_root: Bytes32, +deposit_count: O.U64, +block_hash: Bytes32, d_deposit_root: D.Digest, pair: B.Buf & D.Digest) -> B.Buf & D.Digest:
