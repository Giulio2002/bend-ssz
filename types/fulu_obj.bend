def l16_WithdrawalRequest_putv(out: Array<U32>, +pos: U32, +hoff: U32, +cur: U32, v: l16_WithdrawalRequest_Seq) -> Array<U32> & (l16_WithdrawalRequest_Seq & U32):
  l16_WithdrawalRequest_pvb(cur, l16_WithdrawalRequest_putk(O.w32(out, (pos + hoff : U32), cur), (pos + cur : U32), v))

def l2_ConsolidationRequest_pvb(+cur: U32, pair: Array<U32> & (l2_ConsolidationRequest_Seq & U32)) -> Array<U32> & (l2_ConsolidationRequest_Seq & U32):
