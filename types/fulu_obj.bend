  (out, sq) = pair
  (out, (sq, (n * 192 : U32)))

def l8192_DepositRequest_putn(out: Array<U32>, +pos: U32, o: l8192_DepositRequest_Seq) -> Array<U32> & (l8192_DepositRequest_Seq & U32):
  match o:
    case l8192_DepositRequest_Seq{arr, +n}: l8192_DepositRequest_ptn_fin(n, l8192_DepositRequest_pt_nz(U32.is_eq(n, 0), pos, n, out, arr))

def l8192_DepositRequest_rl_d(arr: Array<DepositRequest>, pair: B.Buf & D.Digest) -> B.Buf & (Array<DepositRequest> & D.Digest):
  (h, d) = pair
  (h, (arr, d))

def l8192_DepositRequest_rl(+hl: Nat, +seg: U32, h: B.Buf, pair: Array<DepositRequest> & DepositRequest) -> B.Buf & (Array<DepositRequest> & D.Digest):
  (arr, +v) = pair
  l8192_DepositRequest_rl_d(arr, DepositRequest_root(hl, h, v, (seg + 64 : U32)))

def l8192_DepositRequest_mj(+hl: Nat, dl: D.Digest, pair: B.Buf & (Array<DepositRequest> & D.Digest)) -> B.Buf & (Array<DepositRequest> & D.Digest):
  (h, r) = pair
  (arr, dr) = r
  (h, (arr, D.node(hl, dl, dr)))

def l8192_DepositRequest_mt(d: Nat, m: Nat, inside: Bool, +hl: Nat, +seg: U32, +w: Nat, +s: Nat, +n: Nat, st: B.Buf & (Array<DepositRequest> & D.Digest)) -> B.Buf & (Array<DepositRequest> & D.Digest):
  match d:
    case 0n:
      match m:
        case 0n:
          match inside:
            case False{}:
              (h, r) = st
              (arr, dl) = r
              (h, (arr, D.zconst(0n)))
            case True{}:
              (h, r) = st
              (arr, dl) = r
              l8192_DepositRequest_rl(hl, seg, h, Array.get(DepositRequest, arr, U32.from_nat(s)))
        case 1n+q:
          (h, r) = st
          (arr, dl) = r
          l8192_DepositRequest_mj(hl, dl, l8192_DepositRequest_mt(0n, q, inside, hl, seg, w, s, n, (h, (arr, D.zero()))))
    case 1n+ +p:
      match m:
        case 0n:
          match inside:
            case False{}:
              (h, r) = st
              (arr, dl) = r
              (h, (arr, D.zconst(1n+p)))
            case True{}:
              l8192_DepositRequest_mt(p, 1n, Nat.is_lt(Nat.add(s, Nat.div(w, 2n)), n), hl, seg, Nat.div(w, 2n), Nat.add(s, Nat.div(w, 2n)), n,
                l8192_DepositRequest_mt(p, 0n, True{}, hl, seg, Nat.div(w, 2n), s, n, st))
        case 1n+q:
          (h, r) = st
          (arr, dl) = r
          l8192_DepositRequest_mj(hl, dl, l8192_DepositRequest_mt(1n+p, q, inside, hl, seg, w, s, n, (h, (arr, D.zero()))))

def l8192_DepositRequest_mt0(+d: Nat, inside: Bool, +hl: Nat, +seg: U32, +n: Nat, st: B.Buf & (Array<DepositRequest> & D.Digest)) -> B.Buf & (Array<DepositRequest> & D.Digest):
  match d:
    case 0n: l8192_DepositRequest_mt(0n, 0n, inside, hl, seg, 1n, 0n, n, st)
    case 1n+q:
      match inside:
        case False{}:
          (h, r) = st
          (arr, dl) = r
          (h, (arr, D.zconst(1n+q)))
        case True{}:
          l8192_DepositRequest_mt(q, 1n, Nat.is_lt(Nat.add(0n, O.pow2n(q)), n), hl, seg, O.pow2n(q), Nat.add(0n, O.pow2n(q)), n,
            l8192_DepositRequest_mt(q, 0n, True{}, hl, seg, O.pow2n(q), 0n, n, st))

def l8192_DepositRequest_rt_fin(+hl: Nat, +n: U32, pair: B.Buf & (Array<DepositRequest> & D.Digest)) -> B.Buf & (l8192_DepositRequest_Seq & D.Digest):
  (h, r) = pair
  (arr, d) = r
  (h, (l8192_DepositRequest_Seq{arr, n}, O.mix_len(hl, d, n)))

def l8192_DepositRequest_root(+hl: Nat, h: B.Buf, o: l8192_DepositRequest_Seq, +seg: U32) -> B.Buf & (l8192_DepositRequest_Seq & D.Digest):
  match o:
    case l8192_DepositRequest_Seq{arr, +n}: l8192_DepositRequest_rt_fin(hl, n, l8192_DepositRequest_mt0(13n, Nat.is_lt(0n, U32.to_nat(n)), hl, seg, U32.to_nat(n), (h, (arr, D.zero()))))

def l8192_DepositRequest_fo(+k: Nat, +i: U32, +acc: U32, pair: Array<DepositRequest> & DepositRequest) -> Array<DepositRequest> & U32:
