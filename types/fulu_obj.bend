  (v, m) = r
  SyncCommittee_put_drop_go(out, v, m)

def SyncCommittee_put(out: Array<U32>, +pos: U32, o: SyncCommittee) -> Array<U32> & SyncCommittee: SyncCommittee_put_drop(SyncCommittee_putk(out, pos, o))

