def v4_b32_pal(+n: U32, pair: Array<U32> & Array<U32>) -> Array<U32> & O.Words:
  (out, ws) = pair
  (out, O.Words{ws, n})

def v4_b32_pw(aligned: Bool, out: Array<U32>, +pos: U32, ws: Array<U32>, +n: U32) -> Array<U32> & O.Words:
  match aligned:
    case True{}: v4_b32_pal(n, v4_b32_pa0(U32.shrn(pos, 2n), out, Array.get(U32, ws, 0)))
    case False{}: O.put_words(out, pos, O.Words{ws, n})

def v4_b32_put(out: Array<U32>, +pos: U32, o: O.Words) -> Array<U32> & O.Words:
  match o:
    case O.Words{ws, +n}: v4_b32_pw(U32.is_eq((pos .&. 3 : U32), 0), out, pos, ws, n)

def v4_b32_root(+hl: Nat, h: B.Buf, o: O.Words, +seg: U32) -> B.Buf & (O.Words & D.Digest): O.words_root(hl, h, o, 2, seg)

def v4_b32_force(o: O.Words) -> O.Words & U32: O.words_len(o)

def v4_b32_pk_ok(pair: Array<U32> & O.Words) -> Array<U32> & (O.Words & U32):
  (out, o) = pair
  (out, (o, 0))

def v4_b32_pk(out: Array<U32>, +pos: U32, pair: O.Words & Bool) -> Array<U32> & (O.Words & U32):
  (o, ok) = pair
  match ok:
    case True{}: v4_b32_pk_ok(v4_b32_put(out, pos, o))
    case False{}: (out, (o, 2147483648))

def v4_b32_valid(o: O.Words) -> O.Words & Bool: O.words_ok(o, 128, 128, False{}, 32)

def v4_b32_putk(out: Array<U32>, +pos: U32, o: O.Words) -> Array<U32> & (O.Words & U32): v4_b32_pk(out, pos, v4_b32_valid(o))

def v4_b32_dump(o: O.Words, t: +List<U32>) -> +List<U32>: O.dump_words(o, t)

def v4_b32_ok_at(buf: B.Buf, +off: U32) -> B.Buf & Bool: (buf, True{})

def v4_b32_ok_len(ok: Bool, buf: B.Buf, +off: U32) -> B.Buf & Bool:
  match ok:
    case True{}: v4_b32_ok_at(buf, off)
    case False{}: (buf, False{})

def v4_b32_ok(buf: B.Buf, +off: U32, +len: U32) -> B.Buf & Bool: v4_b32_ok_len(U32.is_eq(len, 128), buf, off)

def v4_b32_len_of(pair: O.Words & U32) -> O.Words & U32:
  (o, +n) = pair
  (o, U32.div(n, 32))

def v4_b32_len(o: O.Words) -> O.Words & U32: v4_b32_len_of(O.words_len(o))

def v4_b32_at(o: O.Words, +i: U32) -> O.Words & Bytes32: Bytes32_of_words(o, (i * 32 : U32))

def v4_b32_some(pair: O.Words & Bytes32) -> O.Words & Maybe<&1, Bytes32>:
  (o, +v) = pair
  (o, Some{v})

def v4_b32_get_in(inside: Bool, o: O.Words, +i: U32) -> O.Words & Maybe<&1, Bytes32>:
  match inside:
    case True{}: v4_b32_some(v4_b32_at(o, i))
    case False{}: (o, None{})

def v4_b32_get_n(+i: U32, pair: O.Words & U32) -> O.Words & Maybe<&1, Bytes32>:
  (o, +n) = pair
  v4_b32_get_in(U32.is_lt(i, n), o, i)

def v4_b32_get(o: O.Words, +i: U32) -> O.Words & Maybe<&1, Bytes32>: v4_b32_get_n(i, v4_b32_len(o))

def v4_b32_put_at(ok: Bool, o: O.Words, +i: U32, +v: Bytes32) -> O.Words & Bool:
  match ok:
    case True{}: (Bytes32_into_words(o, (i * 32 : U32), v), True{})
    case False{}: (o, False{})

def v4_b32_set_n(+i: U32, +v: Bytes32, pair: O.Words & U32) -> O.Words & Bool:
  (o, +n) = pair
  v4_b32_put_at(U32.is_lt(i, n), o, i, v)

def v4_b32_set(o: O.Words, +i: U32, +v: Bytes32) -> O.Words & Bool: v4_b32_set_n(i, v, v4_b32_len(o))

type LightClientHeader is Type:
  LightClientHeader{beacon: BeaconBlockHeader, execution: O.Boxed<ExecutionPayloadHeader>, execution_branch: O.Words}

def LightClientHeader_default() -> LightClientHeader: LightClientHeader{BeaconBlockHeader_default(), ExecutionPayloadHeader_bx_default(), v4_b32_default()}

def LightClientHeader_rd3(+off: U32, +len: U32, +o_execution: U32, +beacon: BeaconBlockHeader, execution: O.Boxed<ExecutionPayloadHeader>, pair: B.Buf & O.Words) -> B.Buf & LightClientHeader:
  (buf, execution_branch) = pair
  (buf, LightClientHeader{beacon, execution, execution_branch})

def LightClientHeader_rd2(+off: U32, +len: U32, +o_execution: U32, +beacon: BeaconBlockHeader, pair: B.Buf & O.Boxed<ExecutionPayloadHeader>) -> B.Buf & LightClientHeader:
  (buf, execution) = pair
  LightClientHeader_rd3(off, len, o_execution, beacon, execution, v4_b32_read(buf, (off + 116 : U32), 128))

def LightClientHeader_rd1(+off: U32, +len: U32, +o_execution: U32, pair: B.Buf & BeaconBlockHeader) -> B.Buf & LightClientHeader:
  (buf, +beacon) = pair
  LightClientHeader_rd2(off, len, o_execution, beacon, ExecutionPayloadHeader_bx_read(buf, (off + o_execution : U32), (len - o_execution : U32)))

def LightClientHeader_rd0(+off: U32, +len: U32, pair: B.Buf & U32) -> B.Buf & LightClientHeader:
  (buf, +o_execution) = pair
  LightClientHeader_rd1(off, len, o_execution, BeaconBlockHeader_read(buf, (off + 0 : U32), 112))

def LightClientHeader_read(buf: B.Buf, +off: U32, +len: U32) -> B.Buf & LightClientHeader: LightClientHeader_rd0(off, len, B.read32(buf, (off + 112 : U32)))

def LightClientHeader_sz0(+beacon: BeaconBlockHeader, execution_branch: O.Words, +acc: U32, pair: O.Boxed<ExecutionPayloadHeader> & U32) -> LightClientHeader & U32:
  (execution, +m) = pair
  (LightClientHeader{beacon, execution, execution_branch}, O.padd(acc, m))

def LightClientHeader_size(o: LightClientHeader) -> LightClientHeader & U32:
  match o:
    case LightClientHeader{+beacon, execution, execution_branch}: LightClientHeader_sz0(beacon, execution_branch, 244, ExecutionPayloadHeader_bx_size(execution))

def LightClientHeader_pw1(+pos: U32, +cur: U32, +beacon: BeaconBlockHeader, execution: O.Boxed<ExecutionPayloadHeader>, pair: Array<U32> & (O.Words & U32)) -> Array<U32> & (LightClientHeader & U32):
  (out, r) = pair
  (execution_branch, fl) = r
  (BeaconBlockHeader_put(out, (pos + 0 : U32), beacon), (LightClientHeader{beacon, execution, execution_branch}, (cur .|. fl : U32)))

def LightClientHeader_pw0(+pos: U32, +beacon: BeaconBlockHeader, execution_branch: O.Words, pair: Array<U32> & (O.Boxed<ExecutionPayloadHeader> & U32)) -> Array<U32> & (LightClientHeader & U32):
  (out, r) = pair
  (execution, c) = r
  LightClientHeader_pw1(pos, c, beacon, execution, v4_b32_putk(out, (pos + 116 : U32), execution_branch))

def LightClientHeader_putn(out: Array<U32>, +pos: U32, o: LightClientHeader) -> Array<U32> & (LightClientHeader & U32):
  match o:
    case LightClientHeader{+beacon, execution, execution_branch}: LightClientHeader_pw0(pos, beacon, execution_branch, ExecutionPayloadHeader_bx_putv(out, pos, 112, 244, execution))

def LightClientHeader_putk(out: Array<U32>, +pos: U32, o: LightClientHeader) -> Array<U32> & (LightClientHeader & U32): LightClientHeader_putn(out, pos, o)

def LightClientHeader_put_drop_go(out: Array<U32>, v: LightClientHeader, +m: U32) -> Array<U32> & LightClientHeader: (out, v)

def LightClientHeader_put_drop(pair: Array<U32> & (LightClientHeader & U32)) -> Array<U32> & LightClientHeader:
  (out, r) = pair
  (v, m) = r
  LightClientHeader_put_drop_go(out, v, m)

def LightClientHeader_put(out: Array<U32>, +pos: U32, o: LightClientHeader) -> Array<U32> & LightClientHeader: LightClientHeader_put_drop(LightClientHeader_putn(out, pos, o))

def LightClientHeader_rt2(+hl: Nat, +seg: U32, +beacon: BeaconBlockHeader, execution: O.Boxed<ExecutionPayloadHeader>, d_beacon: D.Digest, d_execution: D.Digest, pair: B.Buf & (O.Words & D.Digest)) -> B.Buf & (LightClientHeader & D.Digest):
  (h, r) = pair
  (execution_branch, d_execution_branch) = r
  (h, (LightClientHeader{beacon, execution, execution_branch}, D.node(hl, D.node(hl, d_beacon, d_execution), D.node(hl, d_execution_branch, D.zero()))))

def LightClientHeader_rt1(+hl: Nat, +seg: U32, +beacon: BeaconBlockHeader, execution_branch: O.Words, d_beacon: D.Digest, pair: B.Buf & (O.Boxed<ExecutionPayloadHeader> & D.Digest)) -> B.Buf & (LightClientHeader & D.Digest):
  (h, r) = pair
  (execution, d_execution) = r
  LightClientHeader_rt2(hl, seg, beacon, execution, d_beacon, d_execution, v4_b32_root(hl, h, execution_branch, seg))

def LightClientHeader_rt0(+hl: Nat, +seg: U32, +beacon: BeaconBlockHeader, execution: O.Boxed<ExecutionPayloadHeader>, execution_branch: O.Words, pair: B.Buf & D.Digest) -> B.Buf & (LightClientHeader & D.Digest):
  (h, d_beacon) = pair
  LightClientHeader_rt1(hl, seg, beacon, execution_branch, d_beacon, ExecutionPayloadHeader_bx_root(hl, h, execution, seg))

def LightClientHeader_root(+hl: Nat, h: B.Buf, o: LightClientHeader, +seg: U32) -> B.Buf & (LightClientHeader & D.Digest):
  match o:
    case LightClientHeader{+beacon, execution, execution_branch}: LightClientHeader_rt0(hl, seg, beacon, execution, execution_branch, BeaconBlockHeader_root(hl, h, beacon, seg))

def LightClientHeader_get_beacon(o: LightClientHeader) -> LightClientHeader & BeaconBlockHeader:
  match o:
    case LightClientHeader{+beacon, execution, execution_branch}: (LightClientHeader{beacon, execution, execution_branch}, beacon)

def LightClientHeader_set_beacon(o: LightClientHeader, +v: BeaconBlockHeader) -> LightClientHeader:
  match o:
    case LightClientHeader{+beacon, execution, execution_branch}: LightClientHeader{v, execution, execution_branch}

def LightClientHeader_swap_execution(o: LightClientHeader, v: O.Boxed<ExecutionPayloadHeader>) -> LightClientHeader & O.Boxed<ExecutionPayloadHeader>:
  match o:
    case LightClientHeader{+beacon, execution, execution_branch}: (LightClientHeader{beacon, v, execution_branch}, execution)

def LightClientHeader_set_execution(o: LightClientHeader, v: O.Boxed<ExecutionPayloadHeader>) -> LightClientHeader:
  match o:
    case LightClientHeader{+beacon, execution, execution_branch}: LightClientHeader{beacon, v, execution_branch}

def LightClientHeader_swap_execution_branch(o: LightClientHeader, v: O.Words) -> LightClientHeader & O.Words:
  match o:
    case LightClientHeader{+beacon, execution, execution_branch}: (LightClientHeader{beacon, execution, v}, execution_branch)

def LightClientHeader_set_execution_branch(o: LightClientHeader, v: O.Words) -> LightClientHeader:
  match o:
    case LightClientHeader{+beacon, execution, execution_branch}: LightClientHeader{beacon, execution, v}

def LightClientHeader_fo1(+beacon: BeaconBlockHeader, execution: O.Boxed<ExecutionPayloadHeader>, +acc: U32, pair: O.Words & U32) -> LightClientHeader & U32:
  (execution_branch, +x) = pair
  (LightClientHeader{beacon, execution, execution_branch}, (acc .^. x : U32))

def LightClientHeader_fo0(+beacon: BeaconBlockHeader, execution_branch: O.Words, +acc: U32, pair: O.Boxed<ExecutionPayloadHeader> & U32) -> LightClientHeader & U32:
  (execution, +x) = pair
  LightClientHeader_fo1(beacon, execution, (acc .^. x : U32), v4_b32_force(execution_branch))

def LightClientHeader_force(o: LightClientHeader) -> LightClientHeader & U32:
  match o:
    case LightClientHeader{+beacon, execution, execution_branch}: LightClientHeader_fo0(beacon, execution_branch, (BeaconBlockHeader_force(beacon) : U32), ExecutionPayloadHeader_bx_force(execution))

def LightClientHeader_dump(o: LightClientHeader, t: +List<U32>) -> +List<U32>:
  match o:
    case LightClientHeader{+beacon, execution, execution_branch}: BeaconBlockHeader_dump(beacon, ExecutionPayloadHeader_bx_dump(execution, v4_b32_dump(execution_branch, t)))

def LightClientHeader_c1(ok: Bool, buf: B.Buf, +off: U32, +len: U32, +o0: U32) -> B.Buf & Bool:
  match ok:
    case True{}: (buf, True{})
    case False{}: (buf, False{})

def LightClientHeader_v1(+off: U32, +len: U32, +o0: U32, pair: B.Buf & Bool) -> B.Buf & Bool:
  (buf, ok) = pair
  LightClientHeader_c1(ok, buf, off, len, o0)

def LightClientHeader_c0(ok: Bool, buf: B.Buf, +off: U32, +len: U32, +o0: U32) -> B.Buf & Bool:
  match ok:
    case True{}: LightClientHeader_v1(off, len, o0, ExecutionPayloadHeader_bx_ok(buf, (off + o0 : U32), (len - o0 : U32)))
    case False{}: (buf, False{})

def LightClientHeader_v0(+off: U32, +len: U32, pair: B.Buf & U32) -> B.Buf & Bool:
  (buf, +o0) = pair
  LightClientHeader_c0(U32.is_eq(o0, 244), buf, off, len, o0)

def LightClientHeader_ok_len(ok: Bool, buf: B.Buf, +off: U32, +len: U32) -> B.Buf & Bool:
  match ok:
    case True{}: LightClientHeader_v0(off, len, B.read32(buf, (off + 112 : U32)))
    case False{}: (buf, False{})

def LightClientHeader_ok(buf: B.Buf, +off: U32, +len: U32) -> B.Buf & Bool: LightClientHeader_ok_len(U32.is_le(244, len), buf, off, len)

def SyncAggregate_bx_wrap(v: SyncAggregate) -> O.Boxed<SyncAggregate>: O.BSome{v, O.BNone{}}

def SyncAggregate_bx_default() -> O.Boxed<SyncAggregate>: SyncAggregate_bx_wrap(SyncAggregate_default())

def SyncAggregate_bx_unbox(o: O.Boxed<SyncAggregate>) -> SyncAggregate:
  match o:
    case O.BSome{+v, rest}: v
    case O.BNone{}: SyncAggregate_default()

def SyncAggregate_bx_rd(pair: B.Buf & SyncAggregate) -> B.Buf & O.Boxed<SyncAggregate>:
  (buf, +v) = pair
  (buf, SyncAggregate_bx_wrap(v))

def SyncAggregate_bx_read(buf: B.Buf, +off: U32, +len: U32) -> B.Buf & O.Boxed<SyncAggregate>: SyncAggregate_bx_rd(SyncAggregate_read(buf, off, len))

def SyncAggregate_bx_put(out: Array<U32>, +pos: U32, o: O.Boxed<SyncAggregate>) -> Array<U32> & O.Boxed<SyncAggregate>:
  match o:
    case O.BSome{+v, rest}: (SyncAggregate_put(out, pos, v), SyncAggregate_bx_wrap(v))
    case O.BNone{}: (out, SyncAggregate_bx_default())

def SyncAggregate_bx_size(o: O.Boxed<SyncAggregate>) -> O.Boxed<SyncAggregate> & U32: (o, 160)

def SyncAggregate_bx_rt(+v: SyncAggregate, pair: B.Buf & D.Digest) -> B.Buf & (O.Boxed<SyncAggregate> & D.Digest):
