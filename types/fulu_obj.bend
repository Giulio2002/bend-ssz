def SyncCommittee_size(o: SyncCommittee) -> SyncCommittee & U32: (o, 24624)

def SyncCommittee_pw0(+pos: U32, +cur: U32, +aggregate_pubkey: Bytes48, pair: Array<U32> & (O.Words & U32)) -> Array<U32> & (SyncCommittee & U32):
  (out, r) = pair
  (pubkeys, fl) = r
  (b48_put(out, (pos + 24576 : U32), aggregate_pubkey), (SyncCommittee{pubkeys, aggregate_pubkey}, (cur .|. fl : U32)))

def SyncCommittee_putk(out: Array<U32>, +pos: U32, o: SyncCommittee) -> Array<U32> & (SyncCommittee & U32):
  match o:
    case SyncCommittee{pubkeys, +aggregate_pubkey}: SyncCommittee_pw0(pos, 0, aggregate_pubkey, v512_b48_putk(out, (pos + 0 : U32), pubkeys))

def SyncCommittee_put_drop_go(out: Array<U32>, v: SyncCommittee, +m: U32) -> Array<U32> & SyncCommittee: (out, v)

def SyncCommittee_put_drop(pair: Array<U32> & (SyncCommittee & U32)) -> Array<U32> & SyncCommittee:
