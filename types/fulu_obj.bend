def v7_b32_ok(buf: B.Buf, +off: U32, +len: U32) -> B.Buf & Bool: v7_b32_ok_len(U32.is_eq(len, 224), buf, off)

def v7_b32_len_of(pair: O.Words & U32) -> O.Words & U32:
