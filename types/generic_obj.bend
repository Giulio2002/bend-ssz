  match s:
    case 1: bv15_pw1(out, q, w0)
    case 2: bv15_pw2(out, q, w0)
    case _: bv15_pw3(out, q, w0)

def bv15_pwd(aligned: Bool, +s: U32, out: Array<U32>, +q: U32, +w0: U32) -> Array<U32>:
  match aligned:
    case True{}: bv15_pw0(out, q, w0)
    case False{}: bv15_pwu(s, out, q, w0)

