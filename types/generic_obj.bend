    case False{}: (o, False{})

def v8_bool_set_n(+i: U32, +v: Bool, pair: O.Words & U32) -> O.Words & Bool:
  (o, +n) = pair
  v8_bool_put_at(U32.is_lt(i, n), o, i, v)

def v8_bool_set(o: O.Words, +i: U32, +v: Bool) -> O.Words & Bool: v8_bool_set_n(i, v, v8_bool_len(o))

def pl_u128_default() -> O.Words: O.words_new(0)

def pl_u128_read(buf: B.Buf, +off: U32, +len: U32) -> B.Buf & O.Words: O.copy_in(buf, off, len)

def pl_u128_size(o: O.Words) -> O.Words & U32: O.words_sizek(o)

def pl_u128_put(out: Array<U32>, +pos: U32, o: O.Words) -> Array<U32> & O.Words: O.put_words(out, pos, o)

def pl_u128_putn(out: Array<U32>, +pos: U32, o: O.Words) -> Array<U32> & (O.Words & U32): O.put_words_n(out, pos, o)

def pl_u128_root(+hl: Nat, h: B.Buf, o: O.Words, +seg: U32) -> B.Buf & (O.Words & D.Digest): O.mix_count(hl, 4n, O.words_root_prog(hl, h, o, seg))

def pl_u128_force(o: O.Words) -> O.Words & U32: O.words_len(o)

def pl_u128_pk(out: Array<U32>, +pos: U32, pair: O.Words & Bool) -> Array<U32> & (O.Words & U32):
  (o, ok) = pair
  match ok:
    case True{}: pl_u128_putn(out, pos, o)
    case False{}: (out, (o, 2147483648))

def pl_u128_valid(o: O.Words) -> O.Words & Bool: O.words_ok(o, 0, 0, True{}, 16)

def pl_u128_putk(out: Array<U32>, +pos: U32, o: O.Words) -> Array<U32> & (O.Words & U32): pl_u128_pk(out, pos, pl_u128_valid(o))

def pl_u128_dump(o: O.Words, t: +List<U32>) -> +List<U32>: O.dump_words_n(o, t)

def pl_u128_ok(buf: B.Buf, +off: U32, +len: U32) -> B.Buf & Bool: (buf, Bool.and(U32.is_eq(len, (U32.div(len, 16) * 16 : U32)), True{}))

def pl_u128_len_of(pair: O.Words & U32) -> O.Words & U32:
  (o, +n) = pair
  (o, U32.div(n, 16))

def pl_u128_len(o: O.Words) -> O.Words & U32: pl_u128_len_of(O.words_len(o))

def Uint128_wr3(+j: U32, +w0: U32, +w1: U32, +w2: U32, pair: O.Words & U32) -> O.Words & Uint128:
  (o, +x) = pair
  (o, Uint128{w0, w1, w2, x})

def Uint128_wr2(+j: U32, +w0: U32, +w1: U32, pair: O.Words & U32) -> O.Words & Uint128:
  (o, +x) = pair
  Uint128_wr3(j, w0, w1, x, O.words_word(o, (j + 3 : U32)))

def Uint128_wr1(+j: U32, +w0: U32, pair: O.Words & U32) -> O.Words & Uint128:
  (o, +x) = pair
  Uint128_wr2(j, w0, x, O.words_word(o, (j + 2 : U32)))

def Uint128_wr0(+j: U32, pair: O.Words & U32) -> O.Words & Uint128:
  (o, +x) = pair
  Uint128_wr1(j, x, O.words_word(o, (j + 1 : U32)))

def Uint128_of_words(o: O.Words, +p: U32) -> O.Words & Uint128: Uint128_wr0(U32.shrn(p, 2n), O.words_word(o, U32.shrn(p, 2n)))

def pl_u128_at(o: O.Words, +i: U32) -> O.Words & Uint128: Uint128_of_words(o, (i * 16 : U32))

def pl_u128_some(pair: O.Words & Uint128) -> O.Words & Maybe<&1, Uint128>:
  (o, +v) = pair
  (o, Some{v})

def pl_u128_get_in(inside: Bool, o: O.Words, +i: U32) -> O.Words & Maybe<&1, Uint128>:
  match inside:
    case True{}: pl_u128_some(pl_u128_at(o, i))
    case False{}: (o, None{})

def pl_u128_get_n(+i: U32, pair: O.Words & U32) -> O.Words & Maybe<&1, Uint128>:
  (o, +n) = pair
  pl_u128_get_in(U32.is_lt(i, n), o, i)

def pl_u128_get(o: O.Words, +i: U32) -> O.Words & Maybe<&1, Uint128>: pl_u128_get_n(i, pl_u128_len(o))

def Uint128_into_words(o: O.Words, +p: U32, v: Uint128) -> O.Words:
  match v:
    case Uint128{+w0, +w1, +w2, +w3}: O.words_setw(O.words_setw(O.words_setw(O.words_setw(o, (U32.shrn(p, 2n) + 0 : U32), w0), (U32.shrn(p, 2n) + 1 : U32), w1), (U32.shrn(p, 2n) + 2 : U32), w2), (U32.shrn(p, 2n) + 3 : U32), w3)

def pl_u128_put_at(ok: Bool, o: O.Words, +i: U32, +v: Uint128) -> O.Words & Bool:
  match ok:
    case True{}: (Uint128_into_words(o, (i * 16 : U32), v), True{})
    case False{}: (o, False{})

def pl_u128_set_n(+i: U32, +v: Uint128, pair: O.Words & U32) -> O.Words & Bool:
  (o, +n) = pair
  pl_u128_put_at(U32.is_lt(i, n), o, i, v)

def pl_u128_set(o: O.Words, +i: U32, +v: Uint128) -> O.Words & Bool: pl_u128_set_n(i, v, pl_u128_len(o))

def pl_u128_grow(ok: Bool, o: O.Words, +n: U32, +v: Uint128) -> O.Words & Bool:
  match ok:
    case True{}: pl_u128_put_at(True{}, O.words_resize(O.words_fit(o, ((n + 1 : U32) * 16 : U32)), ((n + 1 : U32) * 16 : U32)), n, v)
    case False{}: (o, False{})

def pl_u128_app_n(+v: Uint128, pair: O.Words & U32) -> O.Words & Bool:
  (o, +n) = pair
  pl_u128_grow(True{}, o, n, v)

def pl_u128_append(o: O.Words, +v: Uint128) -> O.Words & Bool: pl_u128_app_n(v, pl_u128_len(o))

