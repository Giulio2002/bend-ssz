def v8_bool_ok(buf: B.Buf, +off: U32, +len: U32) -> B.Buf & Bool: v8_bool_ok_len(U32.is_eq(len, 8), buf, off)

def v8_bool_len_of(pair: O.Words & U32) -> O.Words & U32:
