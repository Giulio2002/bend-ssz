def v8_bool_get(o: O.Words, +i: U32) -> O.Words & Maybe<&1, Bool>: v8_bool_get_n(i, v8_bool_len(o))

def v8_bool_put_at(ok: Bool, o: O.Words, +i: U32, +v: Bool) -> O.Words & Bool:
  match ok:
