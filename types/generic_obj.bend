  (o, U32.is_eq(x, 1))

def pl_bool_at(o: O.Words, +i: U32) -> O.Words & Bool: pl_bool_bool_at(O.words_byte_at(o, i, 1))

def pl_bool_some(pair: O.Words & Bool) -> O.Words & Maybe<&1, Bool>:
  (o, +v) = pair
  (o, Some{v})

def pl_bool_get_in(inside: Bool, o: O.Words, +i: U32) -> O.Words & Maybe<&1, Bool>:
