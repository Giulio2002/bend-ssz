    case True{}: pl_bool_some(pl_bool_at(o, i))
    case False{}: (o, None{})

def pl_bool_get_n(+i: U32, pair: O.Words & U32) -> O.Words & Maybe<&1, Bool>:
  (o, +n) = pair
  pl_bool_get_in(U32.is_lt(i, n), o, i)

def pl_bool_get(o: O.Words, +i: U32) -> O.Words & Maybe<&1, Bool>: pl_bool_get_n(i, pl_bool_len(o))

def pl_bool_put_at(ok: Bool, o: O.Words, +i: U32, +v: Bool) -> O.Words & Bool:
