def v8_bool_at(o: O.Words, +i: U32) -> O.Words & Bool: v8_bool_bool_at(O.words_byte_at(o, i, 1))

def v8_bool_some(pair: O.Words & Bool) -> O.Words & Maybe<&1, Bool>:
