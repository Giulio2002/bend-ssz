  (ExecutionPayloadHeader{g0, g1, g2}, (acc .^. x : U32))

def ExecutionPayloadHeader_fo0(g1: ExecutionPayloadHeader_g1, +g2: ExecutionPayloadHeader_g2, +acc: U32, pair: ExecutionPayloadHeader_g0 & U32) -> ExecutionPayloadHeader & U32:
  (g0, +x) = pair
  ExecutionPayloadHeader_fo1(g0, g2, (acc .^. x : U32), ExecutionPayloadHeader_g1_force(g1))

def ExecutionPayloadHeader_force(o: ExecutionPayloadHeader) -> ExecutionPayloadHeader & U32:
  match o:
    case ExecutionPayloadHeader{g0, g1, +g2}: ExecutionPayloadHeader_fo0(g1, g2, (ExecutionPayloadHeader_g2_force(g2) : U32), ExecutionPayloadHeader_g0_force(g0))

def ExecutionPayloadHeader_dump(o: ExecutionPayloadHeader, t: +List<U32>) -> +List<U32>:
  match o:
    case ExecutionPayloadHeader{g0, g1, +g2}: ExecutionPayloadHeader_g0_dump(g0, ExecutionPayloadHeader_g1_dump(g1, ExecutionPayloadHeader_g2_dump(g2, t)))

def ExecutionPayloadHeader_bx_wrap(v: ExecutionPayloadHeader) -> O.Boxed<ExecutionPayloadHeader>: O.BSome{v, O.BNone{}}

def ExecutionPayloadHeader_bx_default() -> O.Boxed<ExecutionPayloadHeader>: ExecutionPayloadHeader_bx_wrap(ExecutionPayloadHeader_default())

def ExecutionPayloadHeader_bx_unbox(o: O.Boxed<ExecutionPayloadHeader>) -> ExecutionPayloadHeader:
  match o:
    case O.BSome{v, rest}: v
    case O.BNone{}: ExecutionPayloadHeader_default()

def ExecutionPayloadHeader_bx_size_back(pair: ExecutionPayloadHeader & U32) -> O.Boxed<ExecutionPayloadHeader> & U32:
  (v, +n) = pair
  (ExecutionPayloadHeader_bx_wrap(v), n)

def ExecutionPayloadHeader_bx_force(o: O.Boxed<ExecutionPayloadHeader>) -> O.Boxed<ExecutionPayloadHeader> & U32:
  match o:
    case O.BSome{v, rest}: ExecutionPayloadHeader_bx_size_back(ExecutionPayloadHeader_force(v))
    case O.BNone{}: (ExecutionPayloadHeader_bx_default(), 0)

def ExecutionPayloadHeader_bx_dump(o: O.Boxed<ExecutionPayloadHeader>, t: +List<U32>) -> +List<U32>:
  match o:
    case O.BSome{v, rest}: ExecutionPayloadHeader_dump(v, t)
    case O.BNone{}: ExecutionPayloadHeader_dump(ExecutionPayloadHeader_default(), t)

def ExecutionPayloadHeader_fz0_fin(ok: Bool, pr: ExecutionPayloadHeader & O.Words) -> ExecutionPayloadHeader & Bool:
  (obj, old) = pr
  (obj, ok)

def ExecutionPayloadHeader_fz0_back(obj: ExecutionPayloadHeader, res: O.Words & Bool) -> ExecutionPayloadHeader & Bool:
  (c, ok) = res
  ExecutionPayloadHeader_fz0_fin(ok, ExecutionPayloadHeader_swap_logs_bloom(obj, c))

def ExecutionPayloadHeader_fz0_in(+a: U32, +b: U32, pr: ExecutionPayloadHeader & O.Words) -> ExecutionPayloadHeader & Bool:
  (obj, c) = pr
  ExecutionPayloadHeader_fz0_back(obj, Fulu_bytevec_256_d.b256_set(c, a, (b .&. 255 : U32)))

def ExecutionPayloadHeader_fz0(o: ExecutionPayloadHeader, +a: U32, +b: U32) -> ExecutionPayloadHeader & Bool:
  ExecutionPayloadHeader_fz0_in(a, b, ExecutionPayloadHeader_swap_logs_bloom(o, Fulu_bytevec_256_d.b256_default()))

def ExecutionPayloadHeader_fz1_fin(ok: Bool, pr: ExecutionPayloadHeader & O.Words) -> ExecutionPayloadHeader & Bool:
  (obj, old) = pr
  (obj, ok)

def ExecutionPayloadHeader_fz1_back(obj: ExecutionPayloadHeader, res: O.Words & Bool) -> ExecutionPayloadHeader & Bool:
  (c, ok) = res
  ExecutionPayloadHeader_fz1_fin(ok, ExecutionPayloadHeader_swap_extra_data(obj, c))

def ExecutionPayloadHeader_fz1_in(+a: U32, +b: U32, pr: ExecutionPayloadHeader & O.Words) -> ExecutionPayloadHeader & Bool:
  (obj, c) = pr
  ExecutionPayloadHeader_fz1_back(obj, Fulu_bytelist_32_d.bl32_set(c, a, (b .&. 255 : U32)))

def ExecutionPayloadHeader_fz1(o: ExecutionPayloadHeader, +a: U32, +b: U32) -> ExecutionPayloadHeader & Bool:
  ExecutionPayloadHeader_fz1_in(a, b, ExecutionPayloadHeader_swap_extra_data(o, Fulu_bytelist_32_d.bl32_default()))

def ExecutionPayloadHeader_fzc0(o: ExecutionPayloadHeader, +sel: U32, +a: U32, +b: U32) -> ExecutionPayloadHeader & Bool:
  match sel:
    case 0: ExecutionPayloadHeader_fz0(o, a, b)
    case _: ExecutionPayloadHeader_fz1(o, a, b)

def ExecutionPayloadHeader_fuzz_hi(+c: U32, o: ExecutionPayloadHeader, +sel: U32, +a: U32, +b: U32) -> ExecutionPayloadHeader & Bool:
  match c:
    case _: ExecutionPayloadHeader_fzc0(o, sel, a, b)

def ExecutionPayloadHeader_fuzz(o: ExecutionPayloadHeader, +sel: U32, +a: U32, +b: U32) -> ExecutionPayloadHeader & Bool:
  ExecutionPayloadHeader_fuzz_hi(U32.shrn(sel, 3n), o, sel, a, b)

def ExecutionPayloadHeader_g2_valid(o: ExecutionPayloadHeader_g2) -> Bool:
  match o:
    case ExecutionPayloadHeader_g2{+excess_blob_gas}: True{}
