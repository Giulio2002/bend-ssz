def b256_pal(+n: U32, pair: Array<U32> & Array<U32>) -> Array<U32> & O.Words:
  (out, ws) = pair
  (out, O.Words{ws, n})

def b256_pw(aligned: Bool, out: Array<U32>, +pos: U32, ws: Array<U32>, +n: U32) -> Array<U32> & O.Words:
  match aligned:
    case True{}: b256_pal(n, b256_pa0(U32.shrn(pos, 2n), out, Array.get(U32, ws, 0)))
    case False{}: O.put_words(out, pos, O.Words{ws, n})

def b256_put(out: Array<U32>, +pos: U32, o: O.Words) -> Array<U32> & O.Words:
  match o:
    case O.Words{ws, +n}: b256_pw(U32.is_eq((pos .&. 3 : U32), 0), out, pos, ws, n)

def b256_pk_ok(pair: Array<U32> & O.Words) -> Array<U32> & (O.Words & U32):
  (out, o) = pair
  (out, (o, 0))

def b256_pk(out: Array<U32>, +pos: U32, pair: O.Words & Bool) -> Array<U32> & (O.Words & U32):
  (o, ok) = pair
  match ok:
    case True{}: b256_pk_ok(b256_put(out, pos, o))
    case False{}: (out, (o, 2147483648))

def b256_valid(o: O.Words) -> O.Words & Bool: O.words_ok(o, 256, 256, False{}, 1)

def b256_putk(out: Array<U32>, +pos: U32, o: O.Words) -> Array<U32> & (O.Words & U32): b256_pk(out, pos, b256_valid(o))
