  PowBlock_rt1(hl, seg, block_hash, parent_hash, total_difficulty, d_block_hash, FuluBytes32_h.b32_root(hl, h, parent_hash, seg))

def PowBlock_root(+hl: Nat, h: B.Buf, o: FuluPowBlock_d.PowBlock, +seg: U32) -> B.Buf & D.Digest:
  match o:
    case FuluPowBlock_d.PowBlock{+block_hash, +parent_hash, +total_difficulty}: PowBlock_rt0(hl, seg, block_hash, parent_hash, total_difficulty, FuluBytes32_h.b32_root(hl, h, block_hash, seg))

def PowBlock_hash_tree_root(h: B.Buf, +o: FuluPowBlock_d.PowBlock) -> B.Buf & D.Digest: PowBlock_root(64n, h, o, 0)
