# GENERATED by codegen/generate.py (codegen/runtime_refs.py): the runtime split, additive stage; the runtime is still types/fulu_obj.bend.
# FuluPowBlock: its hash_tree_root

def PowBlock_rt2(+hl: Nat, +seg: U32, +block_hash: FuluBytes32_d.Bytes32, +parent_hash: FuluBytes32_d.Bytes32, +total_difficulty: uint256_d.Uint256, d_block_hash: D.Digest, d_parent_hash: D.Digest, pair: B.Buf & D.Digest) -> B.Buf & D.Digest:
  (h, d_total_difficulty) = pair
  (h, D.node(hl, D.node(hl, d_block_hash, d_parent_hash), D.node(hl, d_total_difficulty, D.zero())))

def PowBlock_rt1(+hl: Nat, +seg: U32, +block_hash: FuluBytes32_d.Bytes32, +parent_hash: FuluBytes32_d.Bytes32, +total_difficulty: uint256_d.Uint256, d_block_hash: D.Digest, pair: B.Buf & D.Digest) -> B.Buf & D.Digest:
  (h, d_parent_hash) = pair
  PowBlock_rt2(hl, seg, block_hash, parent_hash, total_difficulty, d_block_hash, d_parent_hash, uint256_h.u256_root(hl, h, total_difficulty, seg))

def PowBlock_rt0(+hl: Nat, +seg: U32, +block_hash: FuluBytes32_d.Bytes32, +parent_hash: FuluBytes32_d.Bytes32, +total_difficulty: uint256_d.Uint256, pair: B.Buf & D.Digest) -> B.Buf & D.Digest:
