  (nodes, +r) = pr
  l262144_PendingConsolidation_croot_pad(hl, n, d, arr, nodes, h, r)

def l262144_PendingConsolidation_croot_top(+hl: Nat, +n: U32, +d: Nat, ts: l262144_PendingConsolidation_TS) -> B.Buf & (l262144_PendingConsolidation_Cached & D.Digest):
  match ts:
    case l262144_PendingConsolidation_TS{h, arr, nodes}: l262144_PendingConsolidation_croot_read(hl, n, d, h, arr, Array.get(D.Digest, nodes, 1))

def l262144_PendingConsolidation_cached_root(+hl: Nat, h: B.Buf, c: l262144_PendingConsolidation_Cached, +seg: U32) -> B.Buf & (l262144_PendingConsolidation_Cached & D.Digest):
  match c:
    case l262144_PendingConsolidation_Cached{arr, +n, +d, nodes, +lo, +hi}:
      l262144_PendingConsolidation_croot_top(hl, n, d, l262144_PendingConsolidation_sweep_pick(hl, U32.is_le(lo, hi), d, lo, hi, n, seg, l262144_PendingConsolidation_TS{h, arr, nodes}))
