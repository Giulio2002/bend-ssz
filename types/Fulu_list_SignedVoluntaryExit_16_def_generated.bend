def l16_SignedVoluntaryExit_cached_root(+hl: Nat, h: B.Buf, c: l16_SignedVoluntaryExit_Cached, +seg: U32) -> B.Buf & (l16_SignedVoluntaryExit_Cached & D.Digest):
  match c:
    case l16_SignedVoluntaryExit_Cached{arr, +n, +d, nodes, +lo, +hi}:
      l16_SignedVoluntaryExit_croot_top(hl, n, d, l16_SignedVoluntaryExit_sweep_pick(hl, U32.is_le(lo, hi), d, lo, hi, n, seg, l16_SignedVoluntaryExit_TS{h, arr, nodes}))
