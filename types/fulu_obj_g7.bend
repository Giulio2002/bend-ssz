    case A_ExecutionBranch{v}: FuluExecutionBranch_d.v4_b32_dump(v, t)
    case A_LightClientHeader{v}: FuluLightClientHeader_d.LightClientHeader_dump(v, t)
    case A_LightClientOptimisticUpdate{v}: FuluLightClientOptimisticUpdate_d.LightClientOptimisticUpdate_dump(v, t)
    case A_LightClientFinalityUpdate{v}: FuluLightClientFinalityUpdate_d.LightClientFinalityUpdate_dump(v, t)
    case A_LightClientUpdate{v}: FuluLightClientUpdate_d.LightClientUpdate_dump(v, t)
    case A_LightClientBootstrap{v}: FuluLightClientBootstrap_d.LightClientBootstrap_dump(v, t)
    case A_BlobIndex{+v}: uint64_d.u64_dump(v, t)
    case A_BlobIdentifier{+v}: FuluBlobIdentifier_d.BlobIdentifier_dump(v, t)
    case A_KZGCommitment{+v}: FuluBytes48_d.b48_dump(v, t)
    case A_BeaconBlockBody{v}: FuluBeaconBlockBody_d.BeaconBlockBody_dump(v, t)
    case A_BeaconBlock{v}: FuluBeaconBlock_d.BeaconBlock_dump(v, t)
    case A_boxed{v}: dump(v, t)
def force_fin(buf: B.Buf, pair: Any & U32) -> B.Buf & (U32 & U32):
  (a, +x) = pair
  (buf, (x, 1))
def force_m(m: Maybe<&1, Any>, buf: B.Buf) -> B.Buf & (U32 & U32):
  match m:
    case None{}: (buf, (0, 0))
    case Some{a}: force_fin(buf, force(a))
def force_p(pair: B.Buf & Maybe<&1, Any>) -> B.Buf & (U32 & U32):
  (buf, m) = pair
  force_m(m, buf)
def decode_force(+i: U32, buf: B.Buf, +size: U32) -> B.Buf & (U32 & U32):
  force_p(decode(i, buf, size))
