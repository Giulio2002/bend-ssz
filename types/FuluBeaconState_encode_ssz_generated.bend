  (out, r) = pair
  (o, m) = r
  BeaconState_senc_out(n, out, o, m)

def BeaconState_senc_go(bad: Bool, +n: U32, o: FuluBeaconState_d.BeaconState) -> FuluBeaconState_d.BeaconState & O.Encoded:
  match bad:
    case True{}: (o, O.refused())
    case False{}: BeaconState_senc_put(n, BeaconState_putk(O.out_new(n), 0, o))

def BeaconState_senc_sized(pair: FuluBeaconState_d.BeaconState & U32) -> FuluBeaconState_d.BeaconState & O.Encoded:
  (o, +n) = pair
  BeaconState_senc_go(O.is_poisoned(n), n, o)

def BeaconState_serialize(o: FuluBeaconState_d.BeaconState) -> FuluBeaconState_d.BeaconState & O.Encoded: BeaconState_senc_sized(BeaconState_size(o))
