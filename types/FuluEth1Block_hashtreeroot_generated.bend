  Eth1Block_rt2(hl, seg, timestamp, deposit_root, deposit_count, d_timestamp, d_deposit_root, uint64_h.u64_root(hl, h, deposit_count, seg))

def Eth1Block_rt0(+hl: Nat, +seg: U32, +timestamp: O.U64, +deposit_root: FuluBytes32_d.Bytes32, +deposit_count: O.U64, pair: B.Buf & D.Digest) -> B.Buf & D.Digest:
