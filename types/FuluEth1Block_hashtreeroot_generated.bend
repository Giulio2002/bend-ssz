  Eth1Block_rt1(hl, seg, timestamp, deposit_root, deposit_count, d_timestamp, FuluBytes32_h.b32_root(hl, h, deposit_root, seg))

def Eth1Block_root(+hl: Nat, h: B.Buf, o: FuluEth1Block_d.Eth1Block, +seg: U32) -> B.Buf & D.Digest:
  match o:
    case FuluEth1Block_d.Eth1Block{+timestamp, +deposit_root, +deposit_count}: Eth1Block_rt0(hl, seg, timestamp, deposit_root, deposit_count, uint64_h.u64_root(hl, h, timestamp, seg))

def Eth1Block_hash_tree_root(h: B.Buf, +o: FuluEth1Block_d.Eth1Block) -> B.Buf & D.Digest: Eth1Block_root(64n, h, o, 0)
