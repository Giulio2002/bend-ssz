  (h, D.node(hl, D.node(hl, d_timestamp, d_deposit_root), D.node(hl, d_deposit_count, D.zero())))

def Eth1Block_rt1(+hl: Nat, +seg: U32, +timestamp: O.U64, +deposit_root: FuluBytes32_d.Bytes32, +deposit_count: O.U64, d_timestamp: D.Digest, pair: B.Buf & D.Digest) -> B.Buf & D.Digest:
