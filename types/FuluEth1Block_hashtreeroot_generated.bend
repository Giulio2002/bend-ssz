# FuluEth1Block: its hash_tree_root

def Eth1Block_rt2(+hl: Nat, +seg: U32, +timestamp: O.U64, +deposit_root: FuluBytes32_d.Bytes32, +deposit_count: O.U64, d_timestamp: D.Digest, d_deposit_root: D.Digest, pair: B.Buf & D.Digest) -> B.Buf & D.Digest:
