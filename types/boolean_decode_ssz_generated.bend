def bool_read(buf: B.Buf, +off: U32, +len: U32) -> B.Buf & Bool: O.rd_bool(buf, off)

def bool_ok_at(buf: B.Buf, +off: U32) -> B.Buf & Bool: O.ok_bool(buf, off)

def bool_ok_len(ok: Bool, buf: B.Buf, +off: U32) -> B.Buf & Bool:
  match ok:
    case True{}: bool_ok_at(buf, off)
    case False{}: (buf, False{})

def bool_ok(buf: B.Buf, +off: U32, +len: U32) -> B.Buf & Bool: bool_ok_len(U32.is_eq(len, 1), buf, off)

def boolean_some(pair: B.Buf & Bool) -> B.Buf & Maybe<&1, Bool>:
  (buf, +v) = pair
  (buf, Some{v})

def boolean_built(+size: U32, pair: B.Buf & Bool) -> B.Buf & Maybe<&1, Bool>:
  (buf, ok) = pair
  match ok:
    case True{}: boolean_some(bool_read(buf, 0, size))
    case False{}: (buf, None{})

def boolean_decode(buf: B.Buf, +size: U32) -> B.Buf & Maybe<&1, Bool>:
  boolean_built(size, bool_ok(buf, 0, size))

def boolean_build(buf: B.Buf, +size: U32) -> B.Buf & Bool: bool_read(buf, 0, size)
