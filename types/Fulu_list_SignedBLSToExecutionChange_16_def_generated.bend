def l16_SignedBLSToExecutionChange_pad_go(+hl: Nat, +k: Nat, +lvl: U32, +r: D.Digest, pr: B.Buf & D.Digest) -> B.Buf & D.Digest:
  match k:
    case 0n:
      (h, +z) = pr
      (h, r)
    case 1n+q:
      (h, +z) = pr
      l16_SignedBLSToExecutionChange_pad_go(hl, q, (lvl + 1 : U32), D.node(hl, r, z), (h, D.zconst(U32.to_nat((lvl + 1 : U32)))))

def l16_SignedBLSToExecutionChange_croot_fin(+hl: Nat, +n: U32, +d: Nat, arr: Array<FuluSignedBLSToExecutionChange_d.SignedBLSToExecutionChange>, nodes: Array<D.Digest>, pr: B.Buf & D.Digest) -> B.Buf & (l16_SignedBLSToExecutionChange_Cached & D.Digest):
  (h, +r) = pr
  (h, (l16_SignedBLSToExecutionChange_Cached{arr, n, d, nodes, n, 0}, O.mix_len(hl, r, n)))

def l16_SignedBLSToExecutionChange_croot_pad(+hl: Nat, +n: U32, +d: Nat, arr: Array<FuluSignedBLSToExecutionChange_d.SignedBLSToExecutionChange>, nodes: Array<D.Digest>, h: B.Buf, +r: D.Digest) -> B.Buf & (l16_SignedBLSToExecutionChange_Cached & D.Digest):
  l16_SignedBLSToExecutionChange_croot_fin(hl, n, d, arr, nodes, l16_SignedBLSToExecutionChange_pad_go(hl, Nat.sub(4n, d), O.nat_u32(d), r, (h, D.zconst(d))))

def l16_SignedBLSToExecutionChange_croot_read(+hl: Nat, +n: U32, +d: Nat, h: B.Buf, arr: Array<FuluSignedBLSToExecutionChange_d.SignedBLSToExecutionChange>, pr: Array<D.Digest> & D.Digest) -> B.Buf & (l16_SignedBLSToExecutionChange_Cached & D.Digest):
  (nodes, +r) = pr
  l16_SignedBLSToExecutionChange_croot_pad(hl, n, d, arr, nodes, h, r)

def l16_SignedBLSToExecutionChange_croot_top(+hl: Nat, +n: U32, +d: Nat, ts: l16_SignedBLSToExecutionChange_TS) -> B.Buf & (l16_SignedBLSToExecutionChange_Cached & D.Digest):
  match ts:
    case l16_SignedBLSToExecutionChange_TS{h, arr, nodes}: l16_SignedBLSToExecutionChange_croot_read(hl, n, d, h, arr, Array.get(D.Digest, nodes, 1))

def l16_SignedBLSToExecutionChange_cached_root(+hl: Nat, h: B.Buf, c: l16_SignedBLSToExecutionChange_Cached, +seg: U32) -> B.Buf & (l16_SignedBLSToExecutionChange_Cached & D.Digest):
  match c:
    case l16_SignedBLSToExecutionChange_Cached{arr, +n, +d, nodes, +lo, +hi}:
      l16_SignedBLSToExecutionChange_croot_top(hl, n, d, l16_SignedBLSToExecutionChange_sweep_pick(hl, U32.is_le(lo, hi), d, lo, hi, n, seg, l16_SignedBLSToExecutionChange_TS{h, arr, nodes}))
