# uint32: its decoder, validator, reader and builder

def u32_read(buf: B.Buf, +off: U32, +len: U32) -> B.Buf & U32: O.rd_u32(buf, off)

def u32_ok_at(buf: B.Buf, +off: U32) -> B.Buf & Bool: (buf, True{})

def u32_ok_len(ok: Bool, buf: B.Buf, +off: U32) -> B.Buf & Bool:
  match ok:
    case True{}: u32_ok_at(buf, off)
    case False{}: (buf, False{})

def u32_ok(buf: B.Buf, +off: U32, +len: U32) -> B.Buf & Bool: u32_ok_len(U32.is_eq(len, 4), buf, off)

def uint32_some(pair: B.Buf & U32) -> B.Buf & Maybe<&1, U32>:
  (buf, +v) = pair
  (buf, Some{v})

def uint32_built(+size: U32, pair: B.Buf & Bool) -> B.Buf & Maybe<&1, U32>:
  (buf, ok) = pair
  match ok:
    case True{}: uint32_some(u32_read(buf, 0, size))
    case False{}: (buf, None{})

def uint32_decode(buf: B.Buf, +size: U32) -> B.Buf & Maybe<&1, U32>:
  uint32_built(size, u32_ok(buf, 0, size))

def uint32_build(buf: B.Buf, +size: U32) -> B.Buf & U32: u32_read(buf, 0, size)
