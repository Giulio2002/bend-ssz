def b256_default() -> O.Words: O.words_new(256)

def b256_force(o: O.Words) -> O.Words & U32: O.words_len(o)

def b256_dump(o: O.Words, t: +List<U32>) -> +List<U32>: O.dump_words(o, t)

def b256_len(o: O.Words) -> O.Words & U32: O.words_len(o)

def b256_some(pair: O.Words & U32) -> O.Words & Maybe<&1, U32>:
  (o, +v) = pair
  (o, Some{v})

def b256_get_in(inside: Bool, o: O.Words, +i: U32) -> O.Words & Maybe<&1, U32>:
  match inside:
    case True{}: b256_some(O.words_byte_at(o, i, 1))
    case False{}: (o, None{})

def b256_get_n(+i: U32, pair: O.Words & U32) -> O.Words & Maybe<&1, U32>:
  (o, +n) = pair
  b256_get_in(U32.is_lt(i, n), o, i)

def b256_get(o: O.Words, +i: U32) -> O.Words & Maybe<&1, U32>: b256_get_n(i, O.words_len(o))

def b256_put_at(ok: Bool, o: O.Words, +i: U32, +v: U32) -> O.Words & Bool:
  match ok:
    case True{}: (O.words_write(o, i, v, 1), True{})
    case False{}: (o, False{})

def b256_set_n(+i: U32, +v: U32, pair: O.Words & U32) -> O.Words & Bool:
  (o, +n) = pair
  b256_put_at(Bool.and(U32.is_lt(i, n), U32.is_le(v, 255)), o, i, v)

def b256_set(o: O.Words, +i: U32, +v: U32) -> O.Words & Bool: b256_set_n(i, v, O.words_len(o))
