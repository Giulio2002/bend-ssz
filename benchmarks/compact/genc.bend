import Base
import ../../src/buffer.bend as B
import ../../src/api.bend as API
import ../../src/access.bend as A
import ../../types/generic_cschema_index.bend as Ix
import ../../src/cschema.bend as CS
import ./io.bend as IOx

# serialize through the compact primary API, SSZ_OPS times. The input is
# decoded (validated) once before the clock starts, as Go's benchmark decodes
# into its struct before timing MarshalSSZ; a rejected input exits 1. Each
# encode builds a fresh packed buffer holding the value's encoding, and each is
# consumed by reading its last word. After timing, the last encoding is written
# to SSZ_OUTPUT so the runner can compare it with the input byte for byte.

def wrote(pair: File & Result<&1, &1, U32 & String, Unit>) -> IO(File):
  (file, result) = pair
  do IO<File>:
    IO.pass(Unit, result)
    IO.pure(File, file)

def write_piece(file: File, pair: B.Buf & +List<U32>) -> IO(File & B.Buf):
  (buf, data) = pair
  do IO<File & B.Buf>:
    got : File & Result<&1, &1, U32 & String, Unit> <- File.write_bytes(file, data)
    done : File <- wrote(got)
    IO.pure(File & B.Buf, (done, buf))

def write_loop(k: Nat, +w: U32, +words: U32, pair: File & B.Buf) -> IO(File & B.Buf):
  match k:
    case 0n: IO.pure(File & B.Buf, pair)
    case 1n+p:
      (file, buf) = pair
      do IO<File & B.Buf>:
        next : File & B.Buf <- write_piece(file,
          B.emit(buf, w, B.pick(U32.is_le((w + 16384 : U32), words), 16384, (words - w : U32))))
        write_loop(p, (w + 16384 : U32), words, next)

def close_out(pair: File & B.Buf) -> IO(Unit):
  (file, buf) = pair
  File.close(file)

def write_out(+size: U32, pair: B.Buf & B.Buf) -> IO(Unit):
  (buf, out) = pair
  do IO<Unit>:
    path : String <- IO.try(String, IO.get_env("SSZ_OUTPUT"))
    file : File <- IO.try(File, File.open(path, "w"))
    done : File & B.Buf <- write_loop(Nat.div(Nat.add(U32.to_nat(size), 65535n), 65536n), 0,
      U32.shrn((size + 3 : U32), 2n), (file, out))
    close_out(done)

def word_value(pair: B.Buf & U32) -> U32:
  (b, +w) = pair
  w

# Consumes an encoding by reading its last word.
def last_of(b: B.Buf, +size: U32) -> U32: word_value(B.word(b, U32.shrn(size, 2n)))

# `pair` holds the previous encoding; the loop runs k more encodes, folding the
# last word of each encoding it replaces into `acc`, and returns the final one.
def loop(+k: Nat, +size: U32, +acc: U32, pair: B.Buf & B.Buf) -> B.Buf & (U32 & B.Buf):
  match k:
    case 0n:
      (buf, out) = pair
      (buf, (acc, out))
    case 1n+p:
      (buf, out) = pair
      loop(p, size, (acc .^. last_of(out, size) : U32), A.encode(A.View{0, size}, buf))

def finish(+size: U32, +t0: Nat, buf: B.Buf, r: U32 & B.Buf) -> IO(Unit):
  (+acc, out) = r
  do IO<Unit>:
    t1 : Nat <- IO.now()
    IO.print("MS=" ++ Nat.show(Nat.sub(t1, t0)) ++ " ACC=" ++ U32.show(acc))
    write_out(size, (buf, out))

def timed(+size: U32, +t0: Nat, pair: B.Buf & (U32 & B.Buf)) -> IO(Unit):
  (buf, r) = pair
  finish(size, t0, buf, r)

def gate(ok: Bool, +size: U32, +ops: U32, buf: B.Buf) -> IO(Unit):
  match ok:
    case False{}: IO.die(Unit, 1, "decode rejected")
    case True{}:
      do IO<Unit>:
        t0 : Nat <- IO.now()
        timed(size, t0, loop(U32.to_nat((ops - 1 : U32)), size, 0, A.encode(A.View{0, size}, buf)))

def checked(+size: U32, +ops: U32, pair: B.Buf & Bool) -> IO(Unit):
  (buf, o) = pair
  gate(o, size, ops, buf)

def with_input(+schema: CS.CS, +ops: U32, pair: B.Buf & U32) -> IO(Unit):
  (buf, +size) = pair
  checked(size, ops, API.validate(schema, size, buf))

def main() -> IO(Unit):
  do IO<Unit>:
    +index : U32 <- IOx.env_u32("SSZ_INDEX")
    +ops : U32 <- IOx.env_u32("SSZ_OPS")
    input : B.Buf & U32 <- IOx.load()
    with_input(Ix.by_index(index), ops, input)
