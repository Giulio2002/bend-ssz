def vec_uint8_512_e2e_encode(-o: O.Words, +rep: M1_PB.rep_v1(o, Spec.Gt28605B5D5C()), +hc: {E3.at_depth(o, 8n) == True{} : Bool}) -> {Some{E.obytes(Pair.snd(O.Words, B.Buf, vec_uint8_512_e.Gt28605B5D5C_encode(o)))} == API.serialize(Spec.Gt28605B5D5C(), M1_PB.vview1(o)) : Maybe<&2, +List<U32>>}:
  (+w, +cf) = rep
  vec_uint8_512_w1(o, w, cf, hc)

