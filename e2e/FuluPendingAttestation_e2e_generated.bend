    +hv: {O.bits_above_zero(U32.and(K, 31), VB.slot(T, VBT.QK(K))) == True{} : Bool},
    +eo: {o == FuluPendingAttestation_d.PendingAttestation{O.Bits{FD.array__thaw(U32, T), K}, FuluAttestationData_d.AttestationData{O.U64{w1, w2}, O.U64{w3, w4}, FuluBytes32_d.Bytes32{w5, w6, w7, w8, w9, w10, w11, w12}, FuluCheckpoint_d.Checkpoint{O.U64{w13, w14}, FuluBytes32_d.Bytes32{w15, w16, w17, w18, w19, w20, w21, w22}}, FuluCheckpoint_d.Checkpoint{O.U64{w23, w24}, FuluBytes32_d.Bytes32{w25, w26, w27, w28, w29, w30, w31, w32}}}, x2, x3} : FuluPendingAttestation_d.PendingAttestation}) -> {Some{E.obytes(Pair.snd(FuluPendingAttestation_d.PendingAttestation, B.Buf, FuluPendingAttestation_e.PendingAttestation_encode(o)))} == API.serialize(Spec.PendingAttestation(), RT.v_PendingAttestation(o)) : Maybe<&2, +List<U32>>}:
  match x2:
    case O.U64{+w33, +w34}:
      e2(o, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11, w12, w13, w14, w15, w16, w17, w18, w19, w20, w21, w22, w23, w24, w25, w26, w27, w28, w29, w30, w31, w32, w33, w34, x3, dw, T, K, pf, hdw, rep, hcap, hv, eo)

def e0(-o: FuluPendingAttestation_d.PendingAttestation, +x1: FuluAttestationData_d.AttestationData, +x2: O.U64, +x3: O.U64, +dw: Nat, +T: FD.array__Tree<U32>, +K: U32, +pf: {FD.array__perfect(U32, dw, T) == True{} : Bool}, +hdw: {Nat.is_lt(dw, 31n) == True{} : Bool},
    +rep: BO.rep_bits(O.Bits{FD.array__thaw(U32, T), K}, SH.Chain_head(SH.Container_fields(Spec.PendingAttestation()))), +hcap: {Nat.is_le(Nat.add(U32.to_nat(U32.shrn(K, 5n)), 1n), VB.pw(dw)) == True{} : Bool},
    +hv: {O.bits_above_zero(U32.and(K, 31), VB.slot(T, VBT.QK(K))) == True{} : Bool},
    +eo: {o == FuluPendingAttestation_d.PendingAttestation{O.Bits{FD.array__thaw(U32, T), K}, x1, x2, x3} : FuluPendingAttestation_d.PendingAttestation}) -> {Some{E.obytes(Pair.snd(FuluPendingAttestation_d.PendingAttestation, B.Buf, FuluPendingAttestation_e.PendingAttestation_encode(o)))} == API.serialize(Spec.PendingAttestation(), RT.v_PendingAttestation(o)) : Maybe<&2, +List<U32>>}:
  match x1:
    case FuluAttestationData_d.AttestationData{O.U64{+w1, +w2}, O.U64{+w3, +w4}, FuluBytes32_d.Bytes32{+w5, +w6, +w7, +w8, +w9, +w10, +w11, +w12}, FuluCheckpoint_d.Checkpoint{O.U64{+w13, +w14}, FuluBytes32_d.Bytes32{+w15, +w16, +w17, +w18, +w19, +w20, +w21, +w22}}, FuluCheckpoint_d.Checkpoint{O.U64{+w23, +w24}, FuluBytes32_d.Bytes32{+w25, +w26, +w27, +w28, +w29, +w30, +w31, +w32}}}:
      e1(o, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11, w12, w13, w14, w15, w16, w17, w18, w19, w20, w21, w22, w23, w24, w25, w26, w27, w28, w29, w30, w31, w32, x2, x3, dw, T, K, pf, hdw, rep, hcap, hv, eo)

# (i): for every object the root law represents (rep) whose bit list's storage satisfies the encode laws' premises (hs)
def FuluPendingAttestation_e2e_encode(-o: FuluPendingAttestation_d.PendingAttestation, +rep: RT.rep_PendingAttestation(o, Spec.PendingAttestation()), +hs: BTV.sdbv(RT.pj_PendingAttestation_0(o))) -> {Some{E.obytes(Pair.snd(FuluPendingAttestation_d.PendingAttestation, B.Buf, FuluPendingAttestation_e.PendingAttestation_encode(o)))} == API.serialize(Spec.PendingAttestation(), RT.v_PendingAttestation(o)) : Maybe<&2, +List<U32>>}:
  (+x1, q1) = rep
  (+x2, q2) = q1
  (+x3, q3) = q2
  (+eo, +rb) = q3
  (+T, s1) = hs
  (+dw, s2) = s1
  (+K, s3) = s2
  (+ew, s4) = s3
  (+pf, s5) = s4
  (+hdw, s6) = s5
  (+hcap, +hv) = s6
  +eo1 = Equal.trans(FuluPendingAttestation_d.PendingAttestation, o, FuluPendingAttestation_d.PendingAttestation{RT.pj_PendingAttestation_0(o), x1, x2, x3}, FuluPendingAttestation_d.PendingAttestation{O.Bits{FD.array__thaw(U32, T), K}, x1, x2, x3}, eo, Equal.cong(O.Bits, FuluPendingAttestation_d.PendingAttestation, z => FuluPendingAttestation_d.PendingAttestation{z, x1, x2, x3}, RT.pj_PendingAttestation_0(o), O.Bits{FD.array__thaw(U32, T), K}, ew))
  +rb1 = FD.logic__subst(O.Bits, z => BO.rep_bits(z, SH.Chain_head(SH.Container_fields(Spec.PendingAttestation()))), RT.pj_PendingAttestation_0(o), O.Bits{FD.array__thaw(U32, T), K}, ew, rb)
  e0(o, x1, x2, x3, dw, T, K, pf, hdw, rb1, hcap, hv, eo1)
