    case False{}: Empty.absurd({Pair.snd(B.Buf, Maybe<&1, Fulu_bitvector_512_d.Bitvector512>, bitvector_512_r.bitvector_512_decode(B.fill_at(B.alloc(n), 0, bs), n)) == Some{o} : Maybe<&1, Fulu_bitvector_512_d.Bitvector512>}, FD.logic__none_some(S.Value, M3.v_bv512(o), Equal.trans(Maybe<&2, S.Value>, None{}, API.deserialize(GS.bitvector_512(), bs), Some{M3.v_bv512(o)}, Equal.sym(Maybe<&2, S.Value>, API.deserialize(GS.bitvector_512(), bs), None{}, bitvector_512_d_anone(bs, ec)), aa)))
    case True{}: bitvector_512_d_ibt(bs, n, o, hn, ec, aa)

def bitvector_512_d_ra(+bs: +List<U32>, +n: U32, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +hd: {SP.bytes_domain(bs) == True{} : Bool}, +c: Bool, +ec: {Nat.is_eq(List.length(&2, U32, bs), 64n) == c : Bool}, +dn: {Pair.snd(B.Buf, Maybe<&1, Fulu_bitvector_512_d.Bitvector512>, bitvector_512_r.bitvector_512_decode(B.fill_at(B.alloc(n), 0, bs), n)) == None{} : Maybe<&1, Fulu_bitvector_512_d.Bitvector512>}) -> {API.deserialize(GS.bitvector_512(), bs) == None{} : Maybe<&2, S.Value>}:
  match c:
    case False{}: bitvector_512_d_anone(bs, ec)
    case True{}: Empty.absurd({API.deserialize(GS.bitvector_512(), bs) == None{} : Maybe<&2, S.Value>}, E.none_someT(Fulu_bitvector_512_d.Bitvector512, Fulu_bitvector_512_d.Bitvector512{E.wn(0n, bs), E.wn(1n, bs), E.wn(2n, bs), E.wn(3n, bs), E.wn(4n, bs), E.wn(5n, bs), E.wn(6n, bs), E.wn(7n, bs), E.wn(8n, bs), E.wn(9n, bs), E.wn(10n, bs), E.wn(11n, bs), E.wn(12n, bs), E.wn(13n, bs), E.wn(14n, bs), E.wn(15n, bs)}, Equal.trans(Maybe<&1, Fulu_bitvector_512_d.Bitvector512>, None{}, Pair.snd(B.Buf, Maybe<&1, Fulu_bitvector_512_d.Bitvector512>, bitvector_512_r.bitvector_512_decode(B.fill_at(B.alloc(n), 0, bs), n)), Some{Fulu_bitvector_512_d.Bitvector512{E.wn(0n, bs), E.wn(1n, bs), E.wn(2n, bs), E.wn(3n, bs), E.wn(4n, bs), E.wn(5n, bs), E.wn(6n, bs), E.wn(7n, bs), E.wn(8n, bs), E.wn(9n, bs), E.wn(10n, bs), E.wn(11n, bs), E.wn(12n, bs), E.wn(13n, bs), E.wn(14n, bs), E.wn(15n, bs)}}, Equal.sym(Maybe<&1, Fulu_bitvector_512_d.Bitvector512>, Pair.snd(B.Buf, Maybe<&1, Fulu_bitvector_512_d.Bitvector512>, bitvector_512_r.bitvector_512_decode(B.fill_at(B.alloc(n), 0, bs), n)), None{}, dn), bitvector_512_d_some(bs, n, hn, hd, ec))))

def bitvector_512_d_rb(+bs: +List<U32>, +n: U32, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +hd: {SP.bytes_domain(bs) == True{} : Bool}, +c: Bool, +ec: {Nat.is_eq(List.length(&2, U32, bs), 64n) == c : Bool}, +an: {API.deserialize(GS.bitvector_512(), bs) == None{} : Maybe<&2, S.Value>}) -> {Pair.snd(B.Buf, Maybe<&1, Fulu_bitvector_512_d.Bitvector512>, bitvector_512_r.bitvector_512_decode(B.fill_at(B.alloc(n), 0, bs), n)) == None{} : Maybe<&1, Fulu_bitvector_512_d.Bitvector512>}:
  match c:
    case False{}: bitvector_512_d_none(bs, n, hn, ec)
    case True{}: Empty.absurd({Pair.snd(B.Buf, Maybe<&1, Fulu_bitvector_512_d.Bitvector512>, bitvector_512_r.bitvector_512_decode(B.fill_at(B.alloc(n), 0, bs), n)) == None{} : Maybe<&1, Fulu_bitvector_512_d.Bitvector512>}, FD.logic__none_some(S.Value, M3.v_bv512(Fulu_bitvector_512_d.Bitvector512{E.wn(0n, bs), E.wn(1n, bs), E.wn(2n, bs), E.wn(3n, bs), E.wn(4n, bs), E.wn(5n, bs), E.wn(6n, bs), E.wn(7n, bs), E.wn(8n, bs), E.wn(9n, bs), E.wn(10n, bs), E.wn(11n, bs), E.wn(12n, bs), E.wn(13n, bs), E.wn(14n, bs), E.wn(15n, bs)}), Equal.trans(Maybe<&2, S.Value>, None{}, API.deserialize(GS.bitvector_512(), bs), Some{M3.v_bv512(Fulu_bitvector_512_d.Bitvector512{E.wn(0n, bs), E.wn(1n, bs), E.wn(2n, bs), E.wn(3n, bs), E.wn(4n, bs), E.wn(5n, bs), E.wn(6n, bs), E.wn(7n, bs), E.wn(8n, bs), E.wn(9n, bs), E.wn(10n, bs), E.wn(11n, bs), E.wn(12n, bs), E.wn(13n, bs), E.wn(14n, bs), E.wn(15n, bs)})}, Equal.sym(Maybe<&2, S.Value>, API.deserialize(GS.bitvector_512(), bs), None{}, an), bitvector_512_d_asome(bs, hd, ec))))

# (ii) the object decoder returns o exactly when END_TO_END's deserialize returns VAL(o).
def bitvector_512_e2e_decode_accept(+bs: +List<U32>, +n: U32, +o: Fulu_bitvector_512_d.Bitvector512, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +hd: {SP.bytes_domain(bs) == True{} : Bool})
    -> ({Pair.snd(B.Buf, Maybe<&1, Fulu_bitvector_512_d.Bitvector512>, bitvector_512_r.bitvector_512_decode(B.fill_at(B.alloc(n), 0, bs), n)) == Some{o} : Maybe<&1, Fulu_bitvector_512_d.Bitvector512>} -> {API.deserialize(GS.bitvector_512(), bs) == Some{M3.v_bv512(o)} : Maybe<&2, S.Value>}) & ({API.deserialize(GS.bitvector_512(), bs) == Some{M3.v_bv512(o)} : Maybe<&2, S.Value>} -> {Pair.snd(B.Buf, Maybe<&1, Fulu_bitvector_512_d.Bitvector512>, bitvector_512_r.bitvector_512_decode(B.fill_at(B.alloc(n), 0, bs), n)) == Some{o} : Maybe<&1, Fulu_bitvector_512_d.Bitvector512>}):
  (da => bitvector_512_d_ia(bs, n, o, hn, hd, Nat.is_eq(List.length(&2, U32, bs), 64n), {==}, da), aa => bitvector_512_d_ib(bs, n, o, hn, Nat.is_eq(List.length(&2, U32, bs), 64n), {==}, aa))

# (iii) the object decoder fails exactly when END_TO_END's deserialize does.
def bitvector_512_e2e_decode_reject(+bs: +List<U32>, +n: U32, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +hd: {SP.bytes_domain(bs) == True{} : Bool})
    -> ({Pair.snd(B.Buf, Maybe<&1, Fulu_bitvector_512_d.Bitvector512>, bitvector_512_r.bitvector_512_decode(B.fill_at(B.alloc(n), 0, bs), n)) == None{} : Maybe<&1, Fulu_bitvector_512_d.Bitvector512>} -> {API.deserialize(GS.bitvector_512(), bs) == None{} : Maybe<&2, S.Value>}) & ({API.deserialize(GS.bitvector_512(), bs) == None{} : Maybe<&2, S.Value>} -> {Pair.snd(B.Buf, Maybe<&1, Fulu_bitvector_512_d.Bitvector512>, bitvector_512_r.bitvector_512_decode(B.fill_at(B.alloc(n), 0, bs), n)) == None{} : Maybe<&1, Fulu_bitvector_512_d.Bitvector512>}):
  (dn => bitvector_512_d_ra(bs, n, hn, hd, Nat.is_eq(List.length(&2, U32, bs), 64n), {==}, dn), an => bitvector_512_d_rb(bs, n, hn, hd, Nat.is_eq(List.length(&2, U32, bs), 64n), {==}, an))

