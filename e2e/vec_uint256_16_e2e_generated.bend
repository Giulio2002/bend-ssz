def vec_uint256_31_w2(+t: FD.array__Tree<U32>, +N: U32, +lf: {U32.to_nat(WO.len(O.Words{FD.array__thaw(U32, t), N})) == PK.e32(PK.cnt32(O.Words{FD.array__thaw(U32, t), N})) : Nat}, +cf: {Nat.is_eq(PK.cnt32(O.Words{FD.array__thaw(U32, t), N}), SH.Vector_length(GS.Gt6E9B243B7C())) == True{} : Bool}, +hc: {E3.at_depth(O.Words{FD.array__thaw(U32, t), N}, 8n) == True{} : Bool}) -> {Some{E.obytes(Pair.snd(O.Words, B.Buf, TG.Gt6E9B243B7C_encode(O.Words{FD.array__thaw(U32, t), N})))} == API.serialize(GS.Gt6E9B243B7C(), PK.vview32(O.Words{FD.array__thaw(U32, t), N})) : Maybe<&2, +List<U32>>}:
  +ec = FD.nat__eq_from_is_eq(PK.cnt32(O.Words{FD.array__thaw(U32, t), N}), SH.Vector_length(GS.Gt6E9B243B7C()), cf)
  +ln = Equal.trans(Nat, U32.to_nat(N), PK.e32(PK.cnt32(O.Words{FD.array__thaw(U32, t), N})), U32.to_nat(992), lf,
    Equal.trans(Nat, PK.e32(PK.cnt32(O.Words{FD.array__thaw(U32, t), N})), PK.e32(SH.Vector_length(GS.Gt6E9B243B7C())), U32.to_nat(992),
      Equal.cong(Nat, Nat, z => PK.e32(z), PK.cnt32(O.Words{FD.array__thaw(U32, t), N}), SH.Vector_length(GS.Gt6E9B243B7C()), ec), {==}))
