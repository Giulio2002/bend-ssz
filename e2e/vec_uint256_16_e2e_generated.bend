  +pf = FD.logic__subst(FD.array__Tree<U32>, z => {FD.array__perfect(U32, 8n, z) == True{} : Bool}, FD.array__freeze(U32, FD.array__thaw(U32, t)), t, FD.array__freeze_thaw(U32, t), hc)
