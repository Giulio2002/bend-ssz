    case CI.MW{+parent_hash, +fee_recipient, +state_root, +receipts_root, +dB_logs_bloom, +TB_logs_bloom, +prev_randao, +block_number, +gas_limit, +gas_used, +timestamp, +m_extra_data, +base_fee_per_gas, +block_hash, +t_transactions, +N_transactions, +A_withdrawals, +N_withdrawals, +blob_gas_used, +excess_blob_gas}: obC(parent_hash, fee_recipient, state_root, receipts_root, dB_logs_bloom, TB_logs_bloom, prev_randao, block_number, gas_limit, gas_used, timestamp, m_extra_data, base_fee_per_gas, block_hash, t_transactions, N_transactions, A_withdrawals, N_withdrawals, blob_gas_used, excess_blob_gas, hok, 29n, {==})

# (i) on a record
def enc_m(+m: CI.MW, +hok: {CI.OKW(m) == True{} : Bool}) -> {Some{E.obytes(Pair.snd(FuluExecutionPayload_d.ExecutionPayload, B.Buf, FuluExecutionPayload_e.ExecutionPayload_encode(CI.TH(m))))} == API.serialize(Spec.ExecutionPayload(), CI.VAL(m)) : Maybe<&2, +List<U32>>}:
  %Equal.sym(FuluExecutionPayload_d.ExecutionPayload & B.Buf, FuluExecutionPayload_e.ExecutionPayload_encode(CI.TH(m)), (CI.TH(m), B.Buf{FD.array__thaw(U32, EN.OUTE(m)), EN.SZSM(m)}), ENO.encode_evalO(m, hok)) :
    {Some{E.obytes(Pair.snd(FuluExecutionPayload_d.ExecutionPayload, B.Buf, _))} == API.serialize(Spec.ExecutionPayload(), CI.VAL(m)) : Maybe<&2, +List<U32>>}
  %Equal.sym(+List<U32>, E.obytes(B.Buf{FD.array__thaw(U32, EN.OUTE(m)), EN.SZSM(m)}), VSP.bt(U32.to_nat(EN.SZSM(m)), SF.limbs(FD.array__slots(U32, EN.OUTE(m)))), obM(m, hok)) : {Some{_} == API.serialize(Spec.ExecutionPayload(), CI.VAL(m)) : Maybe<&2, +List<U32>>}
  Equal.sym(Maybe<&2, +List<U32>>, API.serialize(Spec.ExecutionPayload(), CI.VAL(m)), Some{VSP.bt(U32.to_nat(EN.SZSM(m)), SF.limbs(FD.array__slots(U32, EN.OUTE(m))))},
    Equal.trans(Maybe<&2, +List<U32>>, API.serialize(Spec.ExecutionPayload(), CI.VAL(m)), Encoding.encoding_for_legal_type(Spec.ExecutionPayload(), CI.VAL(m)), Some{VSP.bt(U32.to_nat(EN.SZSM(m)), SF.limbs(FD.array__slots(U32, EN.OUTE(m))))},
      E.serialize_legal(Spec.ExecutionPayload(), CI.VAL(m), VS.public_sound(Spec.ExecutionPayload(), {==})), ENO.encode_specO(m, hok)))

# an object, as a record: o == TH(m), its view VAL(m), OK(m)
def via(-o: FuluExecutionPayload_d.ExecutionPayload, +m: CI.MW, +eo: {o == CI.TH(m) : FuluExecutionPayload_d.ExecutionPayload}, +ev: {RT.v_ExecutionPayload(CI.TH(m)) == CI.VAL(m) : S.Value}, +hok: {CI.OKW(m) == True{} : Bool}) -> {Some{E.obytes(Pair.snd(FuluExecutionPayload_d.ExecutionPayload, B.Buf, FuluExecutionPayload_e.ExecutionPayload_encode(o)))} == API.serialize(Spec.ExecutionPayload(), RT.v_ExecutionPayload(o)) : Maybe<&2, +List<U32>>}:
  %Equal.sym(FuluExecutionPayload_d.ExecutionPayload, o, CI.TH(m), eo) : {Some{E.obytes(Pair.snd(FuluExecutionPayload_d.ExecutionPayload, B.Buf, FuluExecutionPayload_e.ExecutionPayload_encode(_)))} == API.serialize(Spec.ExecutionPayload(), RT.v_ExecutionPayload(_)) : Maybe<&2, +List<U32>>}
  %Equal.sym(S.Value, RT.v_ExecutionPayload(CI.TH(m)), CI.VAL(m), ev) : {Some{E.obytes(Pair.snd(FuluExecutionPayload_d.ExecutionPayload, B.Buf, FuluExecutionPayload_e.ExecutionPayload_encode(CI.TH(m))))} == API.serialize(Spec.ExecutionPayload(), _) : Maybe<&2, +List<U32>>}
  enc_m(m, hok)

# (i) from the object's record
def fin(-o: FuluExecutionPayload_d.ExecutionPayload, +w: RC.R_P(o)) -> {Some{E.obytes(Pair.snd(FuluExecutionPayload_d.ExecutionPayload, B.Buf, FuluExecutionPayload_e.ExecutionPayload_encode(o)))} == API.serialize(Spec.ExecutionPayload(), RT.v_ExecutionPayload(o)) : Maybe<&2, +List<U32>>}:
  (+m, r1) = w
  (+eo, r2) = r1
  (+ev, r3) = r2
  (+ok, +eL) = r3
  via(o, m, eo, ev, ok)

# (i): for every object the root law represents whose storage is as the encode record asks (decoded-object gaps:
# hL the logs bloom and hW the withdrawals' tree at depth below 31, hB the extra data below 28, hT the transactions'
# tree and bytes (TX.sdt), hZ its bytes below 2^31 (SZOK, the OKW laws' bound))
def FuluExecutionPayload_e2e_encode(-o: FuluExecutionPayload_d.ExecutionPayload, +rep: RT.rep_ExecutionPayload(o, Spec.ExecutionPayload()), +hL: BL.sdk1(RT.pj_ExecutionPayload_4(o), 31n), +hB: BL.sdk(RT.pj_ExecutionPayload_10(o), 28n), +hT: TX.sdt(RT.pj_ExecutionPayload_13(o)),
    +hW: RLV.sda_l16_Withdrawal(RT.pj_ExecutionPayload_14(o), 31n), +hZ: {RC.SZOK(RT.pj_ExecutionPayload_10(o), RT.pj_ExecutionPayload_13(o), RT.pj_ExecutionPayload_14(o)) == True{} : Bool}) -> {Some{E.obytes(Pair.snd(FuluExecutionPayload_d.ExecutionPayload, B.Buf, FuluExecutionPayload_e.ExecutionPayload_encode(o)))} == API.serialize(Spec.ExecutionPayload(), RT.v_ExecutionPayload(o)) : Maybe<&2, +List<U32>>}:
  fin(o, RC.mk_P(o, rep, (hL, (hB, (hT, hW))), hZ))
