    %FuluVersion_d_pk(bs, hd, ec) : {Encoding.encoding_for_legal_type(Spec.Version(), M3.v_b4(T.Bytes4{E.wn(0n, bs)})) == Some{_} : Maybe<&2, +List<U32>>}
    M1.Version_spec_encode(E.wn(0n, bs))))

def FuluVersion_d_ia(+bs: +List<U32>, +n: U32, +o: T.Bytes4, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +hd: {SP.bytes_domain(bs) == True{} : Bool}, +c: Bool, +ec: {Nat.is_eq(List.length(&2, U32, bs), 4n) == c : Bool}, +da: {Pair.snd(B.Buf, Maybe<&1, T.Bytes4>, T.Version_decode(B.fill_at(B.alloc(n), 0, bs), n)) == Some{o} : Maybe<&1, T.Bytes4>}) -> {API.deserialize(Spec.Version(), bs) == Some{M3.v_b4(o)} : Maybe<&2, S.Value>}:
  match c:
    case False{}: Empty.absurd({API.deserialize(Spec.Version(), bs) == Some{M3.v_b4(o)} : Maybe<&2, S.Value>}, E.none_some1(T.Bytes4, o, Equal.trans(Maybe<&1, T.Bytes4>, None{}, Pair.snd(B.Buf, Maybe<&1, T.Bytes4>, T.Version_decode(B.fill_at(B.alloc(n), 0, bs), n)), Some{o}, Equal.sym(Maybe<&1, T.Bytes4>, Pair.snd(B.Buf, Maybe<&1, T.Bytes4>, T.Version_decode(B.fill_at(B.alloc(n), 0, bs), n)), None{}, FuluVersion_d_none(bs, n, hn, ec)), da)))
    case True{}:
      %E.some_inj1(T.Bytes4, T.Bytes4{E.wn(0n, bs)}, o, Equal.trans(Maybe<&1, T.Bytes4>, Some{T.Bytes4{E.wn(0n, bs)}}, Pair.snd(B.Buf, Maybe<&1, T.Bytes4>, T.Version_decode(B.fill_at(B.alloc(n), 0, bs), n)), Some{o}, Equal.sym(Maybe<&1, T.Bytes4>, Pair.snd(B.Buf, Maybe<&1, T.Bytes4>, T.Version_decode(B.fill_at(B.alloc(n), 0, bs), n)), Some{T.Bytes4{E.wn(0n, bs)}}, FuluVersion_d_some(bs, n, hn, hd, ec)), da)) :
        {API.deserialize(Spec.Version(), bs) == Some{M3.v_b4(_)} : Maybe<&2, S.Value>}
      FuluVersion_d_asome(bs, hd, ec)

def FuluVersion_d_ibt(+bs: +List<U32>, +n: U32, +o: T.Bytes4, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +ec: {Nat.is_eq(List.length(&2, U32, bs), 4n) == True{} : Bool}, +aa: {API.deserialize(Spec.Version(), bs) == Some{M3.v_b4(o)} : Maybe<&2, S.Value>}) -> {Pair.snd(B.Buf, Maybe<&1, T.Bytes4>, T.Version_decode(B.fill_at(B.alloc(n), 0, bs), n)) == Some{o} : Maybe<&1, T.Bytes4>}:
  match o:
    case T.Bytes4{+y0}:
      +eb = FD.logic__some_inj(+List<U32>, F.limbs([y0]), bs, Equal.trans(Maybe<&2, +List<U32>>, Some{F.limbs([y0])}, Encoding.encoding_for_legal_type(Spec.Version(), M3.v_b4(T.Bytes4{y0})), Some{bs},
        Equal.sym(Maybe<&2, +List<U32>>, Encoding.encoding_for_legal_type(Spec.Version(), M3.v_b4(T.Bytes4{y0})), Some{F.limbs([y0])}, M1.Version_spec_encode(y0)),
        E.acc_dec(Spec.Version(), bs, M3.v_b4(T.Bytes4{y0}), E2E.accepted_spec(Spec.Version(), bs, M3.v_b4(T.Bytes4{y0}), aa))))
      %Equal.sym(U32, n, 4, E.u32_len(n, List.length(&2, U32, bs), 4, hn, ec)) :
        {Pair.snd(B.Buf, Maybe<&1, T.Bytes4>, T.Version_decode(B.fill_at(B.alloc(_), 0, bs), _)) == Some{T.Bytes4{y0}} : Maybe<&1, T.Bytes4>}
      %eb :
        {Pair.snd(B.Buf, Maybe<&1, T.Bytes4>, T.Version_decode(B.fill_at(B.alloc(4), 0, _), 4)) == Some{T.Bytes4{y0}} : Maybe<&1, T.Bytes4>}
      Equal.cong(B.Buf & Maybe<&1, T.Bytes4>, Maybe<&1, T.Bytes4>, q => Pair.snd(B.Buf, Maybe<&1, T.Bytes4>, q), T.Version_decode(B.fill_at(B.alloc(4), 0, F.limbs([y0])), 4), (B.fill_at(B.alloc(4), 0, F.limbs([y0])), Some{T.Bytes4{y0}}),
        M0.Version_spec_input(y0))

def FuluVersion_d_ib(+bs: +List<U32>, +n: U32, +o: T.Bytes4, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +c: Bool, +ec: {Nat.is_eq(List.length(&2, U32, bs), 4n) == c : Bool}, +aa: {API.deserialize(Spec.Version(), bs) == Some{M3.v_b4(o)} : Maybe<&2, S.Value>}) -> {Pair.snd(B.Buf, Maybe<&1, T.Bytes4>, T.Version_decode(B.fill_at(B.alloc(n), 0, bs), n)) == Some{o} : Maybe<&1, T.Bytes4>}:
  match c:
    case False{}: Empty.absurd({Pair.snd(B.Buf, Maybe<&1, T.Bytes4>, T.Version_decode(B.fill_at(B.alloc(n), 0, bs), n)) == Some{o} : Maybe<&1, T.Bytes4>}, FD.logic__none_some(S.Value, M3.v_b4(o), Equal.trans(Maybe<&2, S.Value>, None{}, API.deserialize(Spec.Version(), bs), Some{M3.v_b4(o)}, Equal.sym(Maybe<&2, S.Value>, API.deserialize(Spec.Version(), bs), None{}, FuluVersion_d_anone(bs, ec)), aa)))
    case True{}: FuluVersion_d_ibt(bs, n, o, hn, ec, aa)

def FuluVersion_d_ra(+bs: +List<U32>, +n: U32, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +hd: {SP.bytes_domain(bs) == True{} : Bool}, +c: Bool, +ec: {Nat.is_eq(List.length(&2, U32, bs), 4n) == c : Bool}, +dn: {Pair.snd(B.Buf, Maybe<&1, T.Bytes4>, T.Version_decode(B.fill_at(B.alloc(n), 0, bs), n)) == None{} : Maybe<&1, T.Bytes4>}) -> {API.deserialize(Spec.Version(), bs) == None{} : Maybe<&2, S.Value>}:
  match c:
    case False{}: FuluVersion_d_anone(bs, ec)
    case True{}: Empty.absurd({API.deserialize(Spec.Version(), bs) == None{} : Maybe<&2, S.Value>}, E.none_some1(T.Bytes4, T.Bytes4{E.wn(0n, bs)}, Equal.trans(Maybe<&1, T.Bytes4>, None{}, Pair.snd(B.Buf, Maybe<&1, T.Bytes4>, T.Version_decode(B.fill_at(B.alloc(n), 0, bs), n)), Some{T.Bytes4{E.wn(0n, bs)}}, Equal.sym(Maybe<&1, T.Bytes4>, Pair.snd(B.Buf, Maybe<&1, T.Bytes4>, T.Version_decode(B.fill_at(B.alloc(n), 0, bs), n)), None{}, dn), FuluVersion_d_some(bs, n, hn, hd, ec))))

def FuluVersion_d_rb(+bs: +List<U32>, +n: U32, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +hd: {SP.bytes_domain(bs) == True{} : Bool}, +c: Bool, +ec: {Nat.is_eq(List.length(&2, U32, bs), 4n) == c : Bool}, +an: {API.deserialize(Spec.Version(), bs) == None{} : Maybe<&2, S.Value>}) -> {Pair.snd(B.Buf, Maybe<&1, T.Bytes4>, T.Version_decode(B.fill_at(B.alloc(n), 0, bs), n)) == None{} : Maybe<&1, T.Bytes4>}:
  match c:
    case False{}: FuluVersion_d_none(bs, n, hn, ec)
    case True{}: Empty.absurd({Pair.snd(B.Buf, Maybe<&1, T.Bytes4>, T.Version_decode(B.fill_at(B.alloc(n), 0, bs), n)) == None{} : Maybe<&1, T.Bytes4>}, FD.logic__none_some(S.Value, M3.v_b4(T.Bytes4{E.wn(0n, bs)}), Equal.trans(Maybe<&2, S.Value>, None{}, API.deserialize(Spec.Version(), bs), Some{M3.v_b4(T.Bytes4{E.wn(0n, bs)})}, Equal.sym(Maybe<&2, S.Value>, API.deserialize(Spec.Version(), bs), None{}, an), FuluVersion_d_asome(bs, hd, ec))))

# (ii) the object decoder returns o exactly when END_TO_END's deserialize returns VAL(o).
def FuluVersion_e2e_decode_accept(+bs: +List<U32>, +n: U32, +o: T.Bytes4, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +hd: {SP.bytes_domain(bs) == True{} : Bool})
    -> ({Pair.snd(B.Buf, Maybe<&1, T.Bytes4>, T.Version_decode(B.fill_at(B.alloc(n), 0, bs), n)) == Some{o} : Maybe<&1, T.Bytes4>} -> {API.deserialize(Spec.Version(), bs) == Some{M3.v_b4(o)} : Maybe<&2, S.Value>}) & ({API.deserialize(Spec.Version(), bs) == Some{M3.v_b4(o)} : Maybe<&2, S.Value>} -> {Pair.snd(B.Buf, Maybe<&1, T.Bytes4>, T.Version_decode(B.fill_at(B.alloc(n), 0, bs), n)) == Some{o} : Maybe<&1, T.Bytes4>}):
  (da => FuluVersion_d_ia(bs, n, o, hn, hd, Nat.is_eq(List.length(&2, U32, bs), 4n), {==}, da), aa => FuluVersion_d_ib(bs, n, o, hn, Nat.is_eq(List.length(&2, U32, bs), 4n), {==}, aa))

# (iii) the object decoder fails exactly when END_TO_END's deserialize does.
def FuluVersion_e2e_decode_reject(+bs: +List<U32>, +n: U32, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +hd: {SP.bytes_domain(bs) == True{} : Bool})
    -> ({Pair.snd(B.Buf, Maybe<&1, T.Bytes4>, T.Version_decode(B.fill_at(B.alloc(n), 0, bs), n)) == None{} : Maybe<&1, T.Bytes4>} -> {API.deserialize(Spec.Version(), bs) == None{} : Maybe<&2, S.Value>}) & ({API.deserialize(Spec.Version(), bs) == None{} : Maybe<&2, S.Value>} -> {Pair.snd(B.Buf, Maybe<&1, T.Bytes4>, T.Version_decode(B.fill_at(B.alloc(n), 0, bs), n)) == None{} : Maybe<&1, T.Bytes4>}):
  (dn => FuluVersion_d_ra(bs, n, hn, hd, Nat.is_eq(List.length(&2, U32, bs), 4n), {==}, dn), an => FuluVersion_d_rb(bs, n, hn, hd, Nat.is_eq(List.length(&2, U32, bs), 4n), {==}, an))

