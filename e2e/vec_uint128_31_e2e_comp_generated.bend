def gm(m: Maybe<&1, O.Words>, d: O.Words) -> O.Words:
  match m:
    case Some{x}: x
    case None{}: d
def isS(m: Maybe<&1, O.Words>) -> Bool:
  match m:
    case Some{x}: True{}
    case None{}: False{}

# the value deserialize gives for the accepted bytes is the decoded object's view
def acc(+bs: +List<U32>, +n: U32, -o: O.Words, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +hd: {SP.bytes_domain(bs) == True{} : Bool}, dec: {Pair.snd(B.Buf, Maybe<&1, O.Words>, vec_uint128_31_r.vec_uint128_31_decode(B.fill_at(B.alloc(n), 0, bs), n)) == Some{o} : Maybe<&1, O.Words>})
    -> {API.deserialize(GS.vec_uint128_31(), bs) == Some{PK.vview16(o)} : Maybe<&2, S.Value>}:
  Equal.trans(Maybe<&2, S.Value>, API.deserialize(GS.vec_uint128_31(), bs), DB.vec_uint128_31_mv(Pair.snd(B.Buf, Maybe<&1, O.Words>, vec_uint128_31_r.vec_uint128_31_decode(B.fill_at(B.alloc(n), 0, bs), n))), Some{PK.vview16(o)},
    Equal.sym(Maybe<&2, S.Value>, DB.vec_uint128_31_mv(Pair.snd(B.Buf, Maybe<&1, O.Words>, vec_uint128_31_r.vec_uint128_31_decode(B.fill_at(B.alloc(n), 0, bs), n))), API.deserialize(GS.vec_uint128_31(), bs), DB.vec_uint128_31_e2e_decode_view(bs, n, hn, hd)),
    Equal.cong(Maybe<&1, O.Words>, Maybe<&2, S.Value>, z => DB.vec_uint128_31_mv(z), Pair.snd(B.Buf, Maybe<&1, O.Words>, vec_uint128_31_r.vec_uint128_31_decode(B.fill_at(B.alloc(n), 0, bs), n)), Some{o}, dec))

