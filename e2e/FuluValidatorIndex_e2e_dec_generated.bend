def FuluVoluntaryExit_d_ibt(+bs: +List<U32>, +n: U32, +o: T.VoluntaryExit, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +ec: {Nat.is_eq(List.length(&2, U32, bs), 16n) == True{} : Bool}, +aa: {API.deserialize(Spec.VoluntaryExit(), bs) == Some{M3.v_VoluntaryExit(o)} : Maybe<&2, S.Value>}) -> {Pair.snd(B.Buf, Maybe<&1, T.VoluntaryExit>, T.VoluntaryExit_decode(B.fill_at(B.alloc(n), 0, bs), n)) == Some{o} : Maybe<&1, T.VoluntaryExit>}:
  match o:
    case T.VoluntaryExit{O.U64{+y0, +y1}, O.U64{+y2, +y3}}:
      +eb = FD.logic__some_inj(+List<U32>, F.limbs([y0, y1, y2, y3]), bs, Equal.trans(Maybe<&2, +List<U32>>, Some{F.limbs([y0, y1, y2, y3])}, Encoding.encoding_for_legal_type(Spec.VoluntaryExit(), M3.v_VoluntaryExit(T.VoluntaryExit{O.U64{y0, y1}, O.U64{y2, y3}})), Some{bs},
        Equal.sym(Maybe<&2, +List<U32>>, Encoding.encoding_for_legal_type(Spec.VoluntaryExit(), M3.v_VoluntaryExit(T.VoluntaryExit{O.U64{y0, y1}, O.U64{y2, y3}})), Some{F.limbs([y0, y1, y2, y3])}, M1.VoluntaryExit_spec_encode(y0, y1, y2, y3)),
        E.acc_dec(Spec.VoluntaryExit(), bs, M3.v_VoluntaryExit(T.VoluntaryExit{O.U64{y0, y1}, O.U64{y2, y3}}), E2E.accepted_spec(Spec.VoluntaryExit(), bs, M3.v_VoluntaryExit(T.VoluntaryExit{O.U64{y0, y1}, O.U64{y2, y3}}), aa))))
      %Equal.sym(U32, n, 16, E.u32_len(n, List.length(&2, U32, bs), 16, hn, ec)) :
        {Pair.snd(B.Buf, Maybe<&1, T.VoluntaryExit>, T.VoluntaryExit_decode(B.fill_at(B.alloc(_), 0, bs), _)) == Some{T.VoluntaryExit{O.U64{y0, y1}, O.U64{y2, y3}}} : Maybe<&1, T.VoluntaryExit>}
      %eb :
        {Pair.snd(B.Buf, Maybe<&1, T.VoluntaryExit>, T.VoluntaryExit_decode(B.fill_at(B.alloc(16), 0, _), 16)) == Some{T.VoluntaryExit{O.U64{y0, y1}, O.U64{y2, y3}}} : Maybe<&1, T.VoluntaryExit>}
      Equal.cong(B.Buf & Maybe<&1, T.VoluntaryExit>, Maybe<&1, T.VoluntaryExit>, q => Pair.snd(B.Buf, Maybe<&1, T.VoluntaryExit>, q), T.VoluntaryExit_decode(B.fill_at(B.alloc(16), 0, F.limbs([y0, y1, y2, y3])), 16), (B.fill_at(B.alloc(16), 0, F.limbs([y0, y1, y2, y3])), Some{T.VoluntaryExit{O.U64{y0, y1}, O.U64{y2, y3}}}),
        M0.VoluntaryExit_spec_input(y0, y1, y2, y3))

def FuluVoluntaryExit_d_ib(+bs: +List<U32>, +n: U32, +o: T.VoluntaryExit, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +c: Bool, +ec: {Nat.is_eq(List.length(&2, U32, bs), 16n) == c : Bool}, +aa: {API.deserialize(Spec.VoluntaryExit(), bs) == Some{M3.v_VoluntaryExit(o)} : Maybe<&2, S.Value>}) -> {Pair.snd(B.Buf, Maybe<&1, T.VoluntaryExit>, T.VoluntaryExit_decode(B.fill_at(B.alloc(n), 0, bs), n)) == Some{o} : Maybe<&1, T.VoluntaryExit>}:
  match c:
    case False{}: Empty.absurd({Pair.snd(B.Buf, Maybe<&1, T.VoluntaryExit>, T.VoluntaryExit_decode(B.fill_at(B.alloc(n), 0, bs), n)) == Some{o} : Maybe<&1, T.VoluntaryExit>}, FD.logic__none_some(S.Value, M3.v_VoluntaryExit(o), Equal.trans(Maybe<&2, S.Value>, None{}, API.deserialize(Spec.VoluntaryExit(), bs), Some{M3.v_VoluntaryExit(o)}, Equal.sym(Maybe<&2, S.Value>, API.deserialize(Spec.VoluntaryExit(), bs), None{}, FuluVoluntaryExit_d_anone(bs, ec)), aa)))
    case True{}: FuluVoluntaryExit_d_ibt(bs, n, o, hn, ec, aa)

def FuluVoluntaryExit_d_ra(+bs: +List<U32>, +n: U32, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +hd: {SP.bytes_domain(bs) == True{} : Bool}, +c: Bool, +ec: {Nat.is_eq(List.length(&2, U32, bs), 16n) == c : Bool}, +dn: {Pair.snd(B.Buf, Maybe<&1, T.VoluntaryExit>, T.VoluntaryExit_decode(B.fill_at(B.alloc(n), 0, bs), n)) == None{} : Maybe<&1, T.VoluntaryExit>}) -> {API.deserialize(Spec.VoluntaryExit(), bs) == None{} : Maybe<&2, S.Value>}:
  match c:
    case False{}: FuluVoluntaryExit_d_anone(bs, ec)
    case True{}: Empty.absurd({API.deserialize(Spec.VoluntaryExit(), bs) == None{} : Maybe<&2, S.Value>}, E.none_someT(T.VoluntaryExit, T.VoluntaryExit{O.U64{E.wn(0n, bs), E.wn(1n, bs)}, O.U64{E.wn(2n, bs), E.wn(3n, bs)}}, Equal.trans(Maybe<&1, T.VoluntaryExit>, None{}, Pair.snd(B.Buf, Maybe<&1, T.VoluntaryExit>, T.VoluntaryExit_decode(B.fill_at(B.alloc(n), 0, bs), n)), Some{T.VoluntaryExit{O.U64{E.wn(0n, bs), E.wn(1n, bs)}, O.U64{E.wn(2n, bs), E.wn(3n, bs)}}}, Equal.sym(Maybe<&1, T.VoluntaryExit>, Pair.snd(B.Buf, Maybe<&1, T.VoluntaryExit>, T.VoluntaryExit_decode(B.fill_at(B.alloc(n), 0, bs), n)), None{}, dn), FuluVoluntaryExit_d_some(bs, n, hn, hd, ec))))

def FuluVoluntaryExit_d_rb(+bs: +List<U32>, +n: U32, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +hd: {SP.bytes_domain(bs) == True{} : Bool}, +c: Bool, +ec: {Nat.is_eq(List.length(&2, U32, bs), 16n) == c : Bool}, +an: {API.deserialize(Spec.VoluntaryExit(), bs) == None{} : Maybe<&2, S.Value>}) -> {Pair.snd(B.Buf, Maybe<&1, T.VoluntaryExit>, T.VoluntaryExit_decode(B.fill_at(B.alloc(n), 0, bs), n)) == None{} : Maybe<&1, T.VoluntaryExit>}:
  match c:
    case False{}: FuluVoluntaryExit_d_none(bs, n, hn, ec)
    case True{}: Empty.absurd({Pair.snd(B.Buf, Maybe<&1, T.VoluntaryExit>, T.VoluntaryExit_decode(B.fill_at(B.alloc(n), 0, bs), n)) == None{} : Maybe<&1, T.VoluntaryExit>}, FD.logic__none_some(S.Value, M3.v_VoluntaryExit(T.VoluntaryExit{O.U64{E.wn(0n, bs), E.wn(1n, bs)}, O.U64{E.wn(2n, bs), E.wn(3n, bs)}}), Equal.trans(Maybe<&2, S.Value>, None{}, API.deserialize(Spec.VoluntaryExit(), bs), Some{M3.v_VoluntaryExit(T.VoluntaryExit{O.U64{E.wn(0n, bs), E.wn(1n, bs)}, O.U64{E.wn(2n, bs), E.wn(3n, bs)}})}, Equal.sym(Maybe<&2, S.Value>, API.deserialize(Spec.VoluntaryExit(), bs), None{}, an), FuluVoluntaryExit_d_asome(bs, hd, ec))))

# (ii) the object decoder returns o exactly when END_TO_END's deserialize returns VAL(o).
def FuluVoluntaryExit_e2e_decode_accept(+bs: +List<U32>, +n: U32, +o: T.VoluntaryExit, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +hd: {SP.bytes_domain(bs) == True{} : Bool})
    -> ({Pair.snd(B.Buf, Maybe<&1, T.VoluntaryExit>, T.VoluntaryExit_decode(B.fill_at(B.alloc(n), 0, bs), n)) == Some{o} : Maybe<&1, T.VoluntaryExit>} -> {API.deserialize(Spec.VoluntaryExit(), bs) == Some{M3.v_VoluntaryExit(o)} : Maybe<&2, S.Value>}) & ({API.deserialize(Spec.VoluntaryExit(), bs) == Some{M3.v_VoluntaryExit(o)} : Maybe<&2, S.Value>} -> {Pair.snd(B.Buf, Maybe<&1, T.VoluntaryExit>, T.VoluntaryExit_decode(B.fill_at(B.alloc(n), 0, bs), n)) == Some{o} : Maybe<&1, T.VoluntaryExit>}):
  (da => FuluVoluntaryExit_d_ia(bs, n, o, hn, hd, Nat.is_eq(List.length(&2, U32, bs), 16n), {==}, da), aa => FuluVoluntaryExit_d_ib(bs, n, o, hn, Nat.is_eq(List.length(&2, U32, bs), 16n), {==}, aa))

# (iii) the object decoder fails exactly when END_TO_END's deserialize does.
def FuluVoluntaryExit_e2e_decode_reject(+bs: +List<U32>, +n: U32, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +hd: {SP.bytes_domain(bs) == True{} : Bool})
    -> ({Pair.snd(B.Buf, Maybe<&1, T.VoluntaryExit>, T.VoluntaryExit_decode(B.fill_at(B.alloc(n), 0, bs), n)) == None{} : Maybe<&1, T.VoluntaryExit>} -> {API.deserialize(Spec.VoluntaryExit(), bs) == None{} : Maybe<&2, S.Value>}) & ({API.deserialize(Spec.VoluntaryExit(), bs) == None{} : Maybe<&2, S.Value>} -> {Pair.snd(B.Buf, Maybe<&1, T.VoluntaryExit>, T.VoluntaryExit_decode(B.fill_at(B.alloc(n), 0, bs), n)) == None{} : Maybe<&1, T.VoluntaryExit>}):
  (dn => FuluVoluntaryExit_d_ra(bs, n, hn, hd, Nat.is_eq(List.length(&2, U32, bs), 16n), {==}, dn), an => FuluVoluntaryExit_d_rb(bs, n, hn, hd, Nat.is_eq(List.length(&2, U32, bs), 16n), {==}, an))

