    -> {Some{D.bytes(Pair.snd(O.Words, D.Digest, Pair.snd(B.Buf, O.Words & D.Digest, vec_uint256_31_h.vec_uint256_31_hash_tree_root(h, o))))} == C.droot(GS.vec_uint256_31(), bs) : Maybe<&2, +List<U32>>}:
