    BX.ctwY(d, t, off, L, dz, x, K, eo, hy, hw, pf, hr, eL))

# the record read at byte y: its view is the window's value of that record
def ev(+d: Nat, +t: FD.array__Tree<U32>, +y: Nat, +h32: {Nat.is_lt(y, FD.spec_common__pow2(32n)) == True{} : Bool},
    +hw: {Nat.is_le(Nat.add(1240n, y), A.quad(VB.pw(d))) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool})
    -> {RT_L.v_Deposit_bx(W.RX(d, t, y)) == W.RVAL(t, y) : S.Value}:
  +eo = FD.u32__to_nat_from_nat(y, 32n, {==}, h32)
  +hw1 = FD.nat__le_trans(Nat.add(1056n, y), Nat.add(1240n, y), A.quad(VB.pw(d)), Order.add_right(1056n, 1240n, y, {==}), hw)
  +hw0 = FD.logic__subst(Nat, z => {Nat.is_le(z, A.quad(VB.pw(d))) == True{} : Bool}, Nat.add(1056n, y), Nat.add(y, 1056n), FD.nat__add_comm(1056n, y), hw1)
  +ec = Equal.cong(FD.array__Tree<U32>, S.Value, z => PV.pview(O.Words{FD.array__thaw(U32, z), 1056}), VXB.CTN(d, t, y, 1056, 9n), UCT.CT(d, t, U32.from_nat(y), 1056, 9n),
    Equal.sym(FD.array__Tree<U32>, UCT.CT(d, t, U32.from_nat(y), 1056, 9n), VXB.CTN(d, t, y, 1056, 9n), VXB.ct_n(d, t, U32.from_nat(y), y, 1056, 9n, eo)))
  +epv = Equal.trans(S.Value, PV.pview(O.Words{FD.array__thaw(U32, VXB.CTN(d, t, y, 1056, 9n)), 1056}), PV.pview(O.Words{FD.array__thaw(U32, UCT.CT(d, t, U32.from_nat(y), 1056, 9n)), 1056}), S.Sequence{WR.items(O.chunks_of(1056), VF.app(UR.RWS(264n, t, y), VB.wdr(264n, FD.array__slots(U32, UCT.CT(d, t, U32.from_nat(y), 1056, 9n)))), 0n)}, ec,
    pvxY(d, t, U32.from_nat(y), 1056, 9n, y, 264n, eo, VC.hyU(1056, 11n, {==}, {==}), hw0, pf, {==}, {==}))
  FD.logic__subst(S.Value, z => {S.Sequence{S.Items{z, S.Items{RT_L.v_DepositData_bx(FuluDepositData_d.DepositData_bx_wrap(FuluDepositData_d.DepositData{FuluBytes48_d.Bytes48{UR.RWN(t, 1056n+y), UR.RWN(t, 4n+1056n+y), UR.RWN(t, 8n+1056n+y), UR.RWN(t, 12n+1056n+y), UR.RWN(t, 16n+1056n+y), UR.RWN(t, 20n+1056n+y), UR.RWN(t, 24n+1056n+y), UR.RWN(t, 28n+1056n+y), UR.RWN(t, 32n+1056n+y), UR.RWN(t, 36n+1056n+y), UR.RWN(t, 40n+1056n+y), UR.RWN(t, 44n+1056n+y)}, FuluBytes32_d.Bytes32{UR.RWN(t, 48n+1056n+y), UR.RWN(t, 52n+1056n+y), UR.RWN(t, 56n+1056n+y), UR.RWN(t, 60n+1056n+y), UR.RWN(t, 64n+1056n+y), UR.RWN(t, 68n+1056n+y), UR.RWN(t, 72n+1056n+y), UR.RWN(t, 76n+1056n+y)}, O.U64{UR.RWN(t, 80n+1056n+y), UR.RWN(t, 84n+1056n+y)}, FuluBytes96_d.Bytes96{UR.RWN(t, 88n+1056n+y), UR.RWN(t, 92n+1056n+y), UR.RWN(t, 96n+1056n+y), UR.RWN(t, 100n+1056n+y), UR.RWN(t, 104n+1056n+y), UR.RWN(t, 108n+1056n+y), UR.RWN(t, 112n+1056n+y), UR.RWN(t, 116n+1056n+y), UR.RWN(t, 120n+1056n+y), UR.RWN(t, 124n+1056n+y), UR.RWN(t, 128n+1056n+y), UR.RWN(t, 132n+1056n+y), UR.RWN(t, 136n+1056n+y), UR.RWN(t, 140n+1056n+y), UR.RWN(t, 144n+1056n+y), UR.RWN(t, 148n+1056n+y), UR.RWN(t, 152n+1056n+y), UR.RWN(t, 156n+1056n+y), UR.RWN(t, 160n+1056n+y), UR.RWN(t, 164n+1056n+y), UR.RWN(t, 168n+1056n+y), UR.RWN(t, 172n+1056n+y), UR.RWN(t, 176n+1056n+y), UR.RWN(t, 180n+1056n+y)}})), S.EmptyItems{}}}} == W.RVAL(t, y) : S.Value}, S.Sequence{WR.items(O.chunks_of(1056), VF.app(UR.RWS(264n, t, y), VB.wdr(264n, FD.array__slots(U32, UCT.CT(d, t, U32.from_nat(y), 1056, 9n)))), 0n)}, PV.pview(O.Words{FD.array__thaw(U32, VXB.CTN(d, t, y, 1056, 9n)), 1056}),
    Equal.sym(S.Value, PV.pview(O.Words{FD.array__thaw(U32, VXB.CTN(d, t, y, 1056, 9n)), 1056}), S.Sequence{WR.items(O.chunks_of(1056), VF.app(UR.RWS(264n, t, y), VB.wdr(264n, FD.array__slots(U32, UCT.CT(d, t, U32.from_nat(y), 1056, 9n)))), 0n)}, epv), {==})

# element i < CC(len) of the window: its position is within the tree and below 2^32
def EVP(+d: Nat, +t: FD.array__Tree<U32>, +x: Nat, +len: U32, +i: Nat, +k: Nat, +ecc: {W.CC(len) == 1n+k : Nat}, +hchk: {W.CHKw(t, x, 0, len) == True{} : Bool},
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hq: {Nat.is_le(i, k) == True{} : Bool})
    -> {RT_L.v_Deposit_bx(RT_L.th_Deposit_bx(MX(d, t, VRL.pos(i, 1240n, x)))) == W.RVAL(t, VRL.pos(i, 1240n, x)) : S.Value}:
  +hcc = FD.logic__subst(Nat, z => {Nat.is_le(1n+i, z) == True{} : Bool}, 1n+k, W.CC(len), Equal.sym(Nat, W.CC(len), 1n+k, ecc), hq)
  +hm = VRL.mul_mono(1n+i, W.CC(len), 1240n, hcc)
  +hp = Order.add_right(Nat.mul(1n+i, 1240n), Nat.mul(W.CC(len), 1240n), x, hm)
  +el = W.ecw(len, hchk)
  +e2 = Equal.trans(Nat, Nat.add(Nat.mul(W.CC(len), 1240n), x), Nat.add(x, Nat.mul(W.CC(len), 1240n)), Nat.add(x, U32.to_nat(len)), FD.nat__add_comm(Nat.mul(W.CC(len), 1240n), x),
    Equal.cong(Nat, Nat, z => Nat.add(x, z), Nat.mul(W.CC(len), 1240n), U32.to_nat(len), Equal.sym(Nat, U32.to_nat(len), Nat.mul(W.CC(len), 1240n), el)))
  +h1 = FD.logic__subst(Nat, z => {Nat.is_le(VRL.pos(1n+i, 1240n, x), z) == True{} : Bool}, Nat.add(Nat.mul(W.CC(len), 1240n), x), Nat.add(x, U32.to_nat(len)), e2, hp)
  +h2 = FD.nat__le_trans(VRL.pos(1n+i, 1240n, x), Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d)), h1, hw)
  +h3 = FD.logic__subst(Nat, z => {Nat.is_le(z, A.quad(VB.pw(d))) == True{} : Bool}, VRL.pos(1n+i, 1240n, x), Nat.add(1240n, VRL.pos(i, 1240n, x)), Equal.sym(Nat, Nat.add(1240n, VRL.pos(i, 1240n, x)), VRL.pos(1n+i, 1240n, x), VRL.pnx0(i, 1240n, x)), h2)
  +h32 = FD.nat__lt_le_trans(VRL.pos(i, 1240n, x), Nat.add(1240n, VRL.pos(i, 1240n, x)), FD.spec_common__pow2(32n), FD.nat__le_lt_succ(VRL.pos(i, 1240n, x), Nat.add(1239n, VRL.pos(i, 1240n, x)), Order.left_below_sum(1239n, VRL.pos(i, 1240n, x))),
    FD.nat__le_trans(Nat.add(1240n, VRL.pos(i, 1240n, x)), A.quad(VB.pw(d)), FD.spec_common__pow2(32n), h3, FD.nat__pow2_mono(2n+d, 32n, FD.nat__lt_succ_le(d, 30n, hd))))
  %Equal.sym(O.Boxed<FuluDeposit_d.Deposit>, RT_L.th_Deposit_bx(MX(d, t, VRL.pos(i, 1240n, x))), W.RX(d, t, VRL.pos(i, 1240n, x)), thfz(d, t, VRL.pos(i, 1240n, x))) :
    {RT_L.v_Deposit_bx(_) == W.RVAL(t, VRL.pos(i, 1240n, x)) : S.Value}
  ev(d, t, VRL.pos(i, 1240n, x), h32, h3, pf)

# the root view's element walk over the record tree is the window's items
def xiR(+d: Nat, m: Nat, +i: Nat, +Q: Nat, +dd: Nat, +D: FD.array__Tree<RT_L.MB<RT_L.M_Deposit>>, +t: FD.array__Tree<U32>, +x: Nat, +pf: {FD.array__perfect(RT_L.MB<RT_L.M_Deposit>, dd, D) == True{} : Bool},
    +hb: {Nat.is_lt(Nat.add(Q, 0n), FD.spec_common__pow2(dd)) == True{} : Bool}, +hm: {Nat.is_le(Nat.add(m, i), 1n+Q) == True{} : Bool}, +len: U32, +ecc: {W.CC(len) == 1n+Q : Nat}, +hchk: {W.CHKw(t, x, 0, len) == True{} : Bool}, +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +pft: {FD.array__perfect(U32, d, t) == True{} : Bool})
    -> {RT_L.xi_l16_Deposit(m, FD.array__slots(RT_L.MB<RT_L.M_Deposit>, MT(d, Q, 0n, dd, D, t, x)), i) == W.RITEMS(m, t, VRL.pos(i, 1240n, x)) : S.Value}:
  match m:
    case 0n: {==}
    case 1n+ +k:
      +hq = FD.nat__le_trans(i, Nat.add(k, i), Q, Order.left_below_sum(k, i), hm)
      +hq0 = FD.logic__subst(Nat, z => {Nat.is_le(i, z) == True{} : Bool}, Q, Nat.add(Q, 0n), Equal.sym(Nat, Nat.add(Q, 0n), Q, FD.nat__add_zero(Q)), hq)
      +en = lemA(d, Q, 0n, i, dd, D, t, x, pf, Order.zero_le(i), hq0, hb)
      +hi = FD.logic__subst(Nat, z => {Nat.is_lt(i, z) == True{} : Bool}, FD.spec_common__pow2(dd), FD.spec_common__length(RT_L.MB<RT_L.M_Deposit>, FD.array__slots(RT_L.MB<RT_L.M_Deposit>, MT(d, Q, 0n, dd, D, t, x))),
        Equal.sym(Nat, FD.spec_common__length(RT_L.MB<RT_L.M_Deposit>, FD.array__slots(RT_L.MB<RT_L.M_Deposit>, MT(d, Q, 0n, dd, D, t, x))), FD.spec_common__pow2(dd), FD.array__slots_length(RT_L.MB<RT_L.M_Deposit>, dd, MT(d, Q, 0n, dd, D, t, x), pfRT(d, Q, 0n, dd, D, t, x, pf))),
        FD.nat__le_lt_trans(i, Nat.add(Q, 0n), FD.spec_common__pow2(dd), hq0, hb))
      +ex = some_inj(RT_L.xat_l16_Deposit(FD.array__slots(RT_L.MB<RT_L.M_Deposit>, MT(d, Q, 0n, dd, D, t, x)), i), MX(d, t, VRL.pos(i, 1240n, x)),
        Equal.trans(Maybe<&2, RT_L.MB<RT_L.M_Deposit>>, Some{RT_L.xat_l16_Deposit(FD.array__slots(RT_L.MB<RT_L.M_Deposit>, MT(d, Q, 0n, dd, D, t, x)), i)}, FD.spec_common__nth(RT_L.MB<RT_L.M_Deposit>, FD.array__slots(RT_L.MB<RT_L.M_Deposit>, MT(d, Q, 0n, dd, D, t, x)), i), Some{MX(d, t, VRL.pos(i, 1240n, x))},
          Equal.sym(Maybe<&2, RT_L.MB<RT_L.M_Deposit>>, FD.spec_common__nth(RT_L.MB<RT_L.M_Deposit>, FD.array__slots(RT_L.MB<RT_L.M_Deposit>, MT(d, Q, 0n, dd, D, t, x)), i), Some{RT_L.xat_l16_Deposit(FD.array__slots(RT_L.MB<RT_L.M_Deposit>, MT(d, Q, 0n, dd, D, t, x)), i)}, RT.nth_l16_Deposit(FD.array__slots(RT_L.MB<RT_L.M_Deposit>, MT(d, Q, 0n, dd, D, t, x)), i, hi)), en))
      +hm2 = FD.logic__subst(Nat, z => {Nat.is_le(z, 1n+Q) == True{} : Bool}, 1n+Nat.add(k, i), Nat.add(k, 1n+i), Equal.sym(Nat, Nat.add(k, 1n+i), 1n+Nat.add(k, i), FD.nat__add_succ(k, i)), hm)
      %Equal.sym(RT_L.MB<RT_L.M_Deposit>, RT_L.xat_l16_Deposit(FD.array__slots(RT_L.MB<RT_L.M_Deposit>, MT(d, Q, 0n, dd, D, t, x)), i), MX(d, t, VRL.pos(i, 1240n, x)), ex) :
        {S.Items{RT_L.v_Deposit_bx(RT_L.th_Deposit_bx(_)), RT_L.xi_l16_Deposit(k, FD.array__slots(RT_L.MB<RT_L.M_Deposit>, MT(d, Q, 0n, dd, D, t, x)), 1n+i)} == W.RITEMS(1n+k, t, VRL.pos(i, 1240n, x)) : S.Value}
      Equal.trans(S.Value, S.Items{RT_L.v_Deposit_bx(RT_L.th_Deposit_bx(MX(d, t, VRL.pos(i, 1240n, x)))), RT_L.xi_l16_Deposit(k, FD.array__slots(RT_L.MB<RT_L.M_Deposit>, MT(d, Q, 0n, dd, D, t, x)), 1n+i)}, S.Items{RT_L.v_Deposit_bx(RT_L.th_Deposit_bx(MX(d, t, VRL.pos(i, 1240n, x)))), W.RITEMS(k, t, VRL.pos(1n+i, 1240n, x))}, W.RITEMS(1n+k, t, VRL.pos(i, 1240n, x)),
        Equal.cong(S.Value, S.Value, z => S.Items{RT_L.v_Deposit_bx(RT_L.th_Deposit_bx(MX(d, t, VRL.pos(i, 1240n, x)))), z}, RT_L.xi_l16_Deposit(k, FD.array__slots(RT_L.MB<RT_L.M_Deposit>, MT(d, Q, 0n, dd, D, t, x)), 1n+i),
        W.RITEMS(k, t, VRL.pos(1n+i, 1240n, x)), xiR(d, k, 1n+i, Q, dd, D, t, x, pf, hb, hm2, len, ecc, hchk, hd, hw, pft)),
        Equal.cong(S.Value, S.Value, z => S.Items{z, W.RITEMS(k, t, VRL.pos(1n+i, 1240n, x))}, RT_L.v_Deposit_bx(RT_L.th_Deposit_bx(MX(d, t, VRL.pos(i, 1240n, x)))), W.RVAL(t, VRL.pos(i, 1240n, x)), EVP(d, t, x, len, i, Q, ecc, hchk, hd, hw, pft, hq)))

def subz(+k: Nat) -> {Nat.sub(1n+k, U32.to_nat(1)) == k : Nat}:
  match k:
    case 0n: {==}
    case 1n+ +p: {==}

# the list's element count is positive when its length is not 0
# the empty runtime array is am of the tree of MNone
def fillam(+dd: Nat) -> {RT_L.am_l16_Deposit(FD.array__trep(RT_L.MB<RT_L.M_Deposit>, dd, RT_L.MNone{})) == Fulu_list_Deposit_16_d.l16_Deposit_fill(dd) : Array<O.Boxed<FuluDeposit_d.Deposit>>}:
  match dd:
    case 0n: {==}
    case 1n+ +p:
      %Equal.sym(Array<O.Boxed<FuluDeposit_d.Deposit>>, RT_L.am_l16_Deposit(FD.array__trep(RT_L.MB<RT_L.M_Deposit>, p, RT_L.MNone{})), Fulu_list_Deposit_16_d.l16_Deposit_fill(p), fillam(p)) :
        {ANode{_, _} == ANode{Fulu_list_Deposit_16_d.l16_Deposit_fill(p), Fulu_list_Deposit_16_d.l16_Deposit_fill(p)} : Array<O.Boxed<FuluDeposit_d.Deposit>>}
      {==}

# i + 1 does not wrap below 2^dd, dd < 32
def inc(+i: U32, +dd: Nat, +hd: {Nat.is_lt(dd, 32n) == True{} : Bool}, +h: {Nat.is_le(1n+U32.to_nat(i), FD.spec_common__pow2(dd)) == True{} : Bool})
    -> {U32.to_nat(U32.add(i, 1)) == 1n+U32.to_nat(i) : Nat}:
  +hc = FD.logic__subst(Nat, z => {Nat.is_le(1n+U32.to_nat(i), z) == True{} : Bool}, FD.spec_common__pow2(dd), U32.to_nat(FD.u32__pow2u(dd)),
    Equal.sym(Nat, U32.to_nat(FD.u32__pow2u(dd)), FD.spec_common__pow2(dd), FD.u32__pow2u_value(dd, hd)), h)
  +hc2 = FD.logic__subst(Nat, z => {Nat.is_le(z, U32.to_nat(FD.u32__pow2u(dd))) == True{} : Bool}, 1n+U32.to_nat(i), Nat.add(U32.to_nat(i), U32.to_nat(1)),
    Equal.trans(Nat, 1n+U32.to_nat(i), 1n+Nat.add(U32.to_nat(i), 0n), Nat.add(U32.to_nat(i), U32.to_nat(1)),
      Equal.cong(Nat, Nat, z => 1n+z, U32.to_nat(i), Nat.add(U32.to_nat(i), 0n), Equal.sym(Nat, Nat.add(U32.to_nat(i), 0n), U32.to_nat(i), FD.nat__add_zero(U32.to_nat(i)))),
      Equal.sym(Nat, Nat.add(U32.to_nat(i), 1n), 1n+Nat.add(U32.to_nat(i), 0n), FD.nat__add_succ(U32.to_nat(i), 0n))), hc)
  Equal.trans(Nat, U32.to_nat(U32.add(i, 1)), Nat.add(U32.to_nat(i), U32.to_nat(1)), 1n+U32.to_nat(i), A.add_le(i, 1, FD.u32__pow2u(dd), hc2),
    Equal.trans(Nat, Nat.add(U32.to_nat(i), 1n), 1n+Nat.add(U32.to_nat(i), 0n), 1n+U32.to_nat(i), FD.nat__add_succ(U32.to_nat(i), 0n),
      Equal.cong(Nat, Nat, z => 1n+z, Nat.add(U32.to_nat(i), 0n), U32.to_nat(i), FD.nat__add_zero(U32.to_nat(i)))))

# one record write: the runtime Array.set is am of the tree write
def amst(+d: Nat, +i: U32, +j: Nat, +dd: Nat, +D: FD.array__Tree<RT_L.MB<RT_L.M_Deposit>>, +t: FD.array__Tree<U32>, +x: Nat, +ej: {U32.to_nat(i) == j : Nat},
    +hj: {Nat.is_lt(j, FD.spec_common__pow2(dd)) == True{} : Bool}, +hd: {Nat.is_lt(dd, 32n) == True{} : Bool}, +pf: {FD.array__perfect(RT_L.MB<RT_L.M_Deposit>, dd, D) == True{} : Bool})
    -> {Array.set(O.Boxed<FuluDeposit_d.Deposit>, RT_L.am_l16_Deposit(D), i, W.RX(d, t, VRL.pos(j, 1240n, x))) == RT_L.am_l16_Deposit(FD.array__upd(RT_L.MB<RT_L.M_Deposit>, dd, D, j, MX(d, t, VRL.pos(j, 1240n, x)))) : Array<O.Boxed<FuluDeposit_d.Deposit>>}:
  +hi = FD.logic__subst(Nat, z => {Nat.is_lt(z, FD.spec_common__pow2(dd)) == True{} : Bool}, j, U32.to_nat(i), Equal.sym(Nat, U32.to_nat(i), j, ej), hj)
  +hl = FD.logic__subst(Nat, z => {Nat.is_lt(U32.to_nat(i), z) == True{} : Bool}, FD.spec_common__pow2(dd), FD.spec_common__length(RT_L.MB<RT_L.M_Deposit>, FD.array__slots(RT_L.MB<RT_L.M_Deposit>, D)),
    Equal.sym(Nat, FD.spec_common__length(RT_L.MB<RT_L.M_Deposit>, FD.array__slots(RT_L.MB<RT_L.M_Deposit>, D)), FD.spec_common__pow2(dd), FD.array__slots_length(RT_L.MB<RT_L.M_Deposit>, dd, D, pf)), hi)
  %thfz(d, t, VRL.pos(j, 1240n, x)) :
    {Array.set(O.Boxed<FuluDeposit_d.Deposit>, RT_L.am_l16_Deposit(D), i, _) == RT_L.am_l16_Deposit(FD.array__upd(RT_L.MB<RT_L.M_Deposit>, dd, D, j, MX(d, t, VRL.pos(j, 1240n, x)))) : Array<O.Boxed<FuluDeposit_d.Deposit>>}
  %ej : {Array.set(O.Boxed<FuluDeposit_d.Deposit>, RT_L.am_l16_Deposit(D), i, RT_L.th_Deposit_bx(MX(d, t, VRL.pos(j, 1240n, x)))) == RT_L.am_l16_Deposit(FD.array__upd(RT_L.MB<RT_L.M_Deposit>, dd, D, _, MX(d, t, VRL.pos(j, 1240n, x)))) : Array<O.Boxed<FuluDeposit_d.Deposit>>}
  RT.amset_l16_Deposit(dd, D, i, MX(d, t, VRL.pos(j, 1240n, x)), RT_L.xat_l16_Deposit(FD.array__slots(RT_L.MB<RT_L.M_Deposit>, D), U32.to_nat(i)), hd, hi,
    RT.nth_l16_Deposit(FD.array__slots(RT_L.MB<RT_L.M_Deposit>, D), U32.to_nat(i), hl), pf)

# the window's record writes into am(D) are am of the mirror tree they build
def amrt(+d: Nat, k: Nat, +i: U32, +j: Nat, +dd: Nat, +D: FD.array__Tree<RT_L.MB<RT_L.M_Deposit>>, +t: FD.array__Tree<U32>, +x: Nat, +ej: {U32.to_nat(i) == j : Nat},
    +hb: {Nat.is_lt(Nat.add(k, j), FD.spec_common__pow2(dd)) == True{} : Bool}, +hd: {Nat.is_lt(dd, 32n) == True{} : Bool}, +pf: {FD.array__perfect(RT_L.MB<RT_L.M_Deposit>, dd, D) == True{} : Bool})
    -> {RT_L.am_l16_Deposit(MT(d, k, j, dd, D, t, x)) == W.RT(d, k, i, j, RT_L.am_l16_Deposit(D), t, x) : Array<O.Boxed<FuluDeposit_d.Deposit>>}:
  match k:
    case 0n: Equal.sym(Array<O.Boxed<FuluDeposit_d.Deposit>>, W.RT(d, 0n, i, j, RT_L.am_l16_Deposit(D), t, x), RT_L.am_l16_Deposit(MT(d, 0n, j, dd, D, t, x)), amst(d, i, j, dd, D, t, x, ej, hb, hd, pf))
    case 1n+ +p:
      +hj = hbj(p, j, dd, hb)
      +h1 = FD.logic__subst(Nat, z => {Nat.is_le(1n+z, FD.spec_common__pow2(dd)) == True{} : Bool}, j, U32.to_nat(i), Equal.sym(Nat, U32.to_nat(i), j, ej), FD.nat__lt_succ_le_succ(j, FD.spec_common__pow2(dd), hj))
      +ej2 = Equal.trans(Nat, U32.to_nat(U32.add(i, 1)), 1n+U32.to_nat(i), 1n+j, inc(i, dd, hd, h1), Equal.cong(Nat, Nat, z => 1n+z, U32.to_nat(i), j, ej))
      +ih = amrt(d, p, U32.add(i, 1), 1n+j, dd, FD.array__upd(RT_L.MB<RT_L.M_Deposit>, dd, D, j, MX(d, t, VRL.pos(j, 1240n, x))), t, x, ej2, hbs(p, j, dd, hb), hd,
        FD.array__upd_perfect(RT_L.MB<RT_L.M_Deposit>, dd, D, j, MX(d, t, VRL.pos(j, 1240n, x)), pf))
      %Equal.sym(Array<O.Boxed<FuluDeposit_d.Deposit>>, Array.set(O.Boxed<FuluDeposit_d.Deposit>, RT_L.am_l16_Deposit(D), i, W.RX(d, t, VRL.pos(j, 1240n, x))), RT_L.am_l16_Deposit(FD.array__upd(RT_L.MB<RT_L.M_Deposit>, dd, D, j, MX(d, t, VRL.pos(j, 1240n, x)))), amst(d, i, j, dd, D, t, x, ej, hj, hd, pf)) :
        {RT_L.am_l16_Deposit(MT(d, 1n+p, j, dd, D, t, x)) == W.RT(d, p, U32.add(i, 1), 1n+j, _, t, x) : Array<O.Boxed<FuluDeposit_d.Deposit>>}
      ih

def vlf(+d: Nat, +t: FD.array__Tree<U32>, +x: Nat, +len: U32, +hchk: {W.CHKw(t, x, 0, len) == True{} : Bool}, +c: Nat, +ecc: {W.CC(len) == c : Nat}, +eb: {U32.is_eq(len, 0) == False{} : Bool}, +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool})
    -> {RT_L.xv_l16_Deposit(W.LOBJ(d, False{}, t, x, len)) == W.VALw(t, x, len) : S.Value}:
  match c:
    case 0n:
      +e0 = FD.u32__injective(len, 0, Equal.trans(Nat, U32.to_nat(len), Nat.mul(W.CC(len), 1240n), 0n, W.ecw(len, hchk), Equal.cong(Nat, Nat, z => Nat.mul(z, 1240n), W.CC(len), 0n, ecc)))
      Empty.absurd({RT_L.xv_l16_Deposit(W.LOBJ(d, False{}, t, x, len)) == W.VALw(t, x, len) : S.Value}, FD.logic__false_true(Equal.sym(Bool, True{}, False{}, FD.logic__subst(U32, z => {U32.is_eq(z, 0) == False{} : Bool}, len, 0, e0, eb))))
    case 1n+ +k:
      +hN = FD.logic__subst(Nat, z => {Nat.is_le(U32.to_nat(1), z) == True{} : Bool}, 1n+k, U32.to_nat(W.NN(len)), Equal.sym(Nat, W.CC(len), 1n+k, ecc), FD.nat__zero_le(k))
      +eQ = FD.u32__sub_nat(W.NN(len), 1, hN)
      +hNk = FD.logic__subst(Nat, z => {Nat.is_le(U32.to_nat(W.NN(len)), z) == True{} : Bool}, FD.spec_common__pow2(32n), O.pow2n(32n), VD.s_pow2_eq(32n),
        FD.nat__lt_le(U32.to_nat(W.NN(len)), FD.spec_common__pow2(32n), VB.u32_lt(W.NN(len))))
      +hcov = VD.wd_cover(W.NN(len), 32n, {==}, hNk)
      +hcv = FD.logic__subst(Nat, z => {Nat.is_le(z, O.pow2n(B.words_depth(W.NN(len)))) == True{} : Bool}, U32.to_nat(W.NN(len)), 1n+k, ecc, hcov)
      +hb0 = FD.logic__subst(Nat, z => {Nat.is_le(1n+k, z) == True{} : Bool}, O.pow2n(B.words_depth(W.NN(len))), FD.spec_common__pow2(B.words_depth(W.NN(len))), Equal.sym(Nat, FD.spec_common__pow2(B.words_depth(W.NN(len))), O.pow2n(B.words_depth(W.NN(len))), VD.s_pow2_eq(B.words_depth(W.NN(len)))), hcv)
      +hb = FD.logic__subst(Nat, z => {Nat.is_lt(z, FD.spec_common__pow2(B.words_depth(W.NN(len)))) == True{} : Bool}, k, Nat.add(k, 0n), Equal.sym(Nat, Nat.add(k, 0n), k, FD.nat__add_zero(k)), FD.nat__succ_le_lt(k, FD.spec_common__pow2(B.words_depth(W.NN(len))), hb0))
      +hm = FD.logic__subst(Nat, z => {Nat.is_le(1n+z, 1n+k) == True{} : Bool}, k, Nat.add(k, 0n), Equal.sym(Nat, Nat.add(k, 0n), k, FD.nat__add_zero(k)), FD.nat__le_refl(1n+k))
      +hbQ = FD.logic__subst(Nat, z => {Nat.is_lt(Nat.add(z, 0n), FD.spec_common__pow2(B.words_depth(W.NN(len)))) == True{} : Bool}, k, U32.to_nat(U32.sub(W.NN(len), 1)), Equal.trans(Nat, k, Nat.sub(1n+k, U32.to_nat(1)), U32.to_nat(U32.sub(W.NN(len), 1)), Equal.sym(Nat, Nat.sub(1n+k, U32.to_nat(1)), k, subz(k)), Equal.trans(Nat, Nat.sub(1n+k, U32.to_nat(1)), Nat.sub(U32.to_nat(W.NN(len)), U32.to_nat(1)), U32.to_nat(U32.sub(W.NN(len), 1)), Equal.cong(Nat, Nat, z => Nat.sub(z, U32.to_nat(1)), 1n+k, U32.to_nat(W.NN(len)), Equal.sym(Nat, W.CC(len), 1n+k, ecc)), Equal.sym(Nat, U32.to_nat(U32.sub(W.NN(len), 1)), Nat.sub(U32.to_nat(W.NN(len)), U32.to_nat(1)), eQ))), hb)
      +hdw = FD.nat__le_lt_trans(B.words_depth(W.NN(len)), 5n, 32n, VD.wd_min(W.NN(len), 5n, FD.nat__le_trans(U32.to_nat(W.NN(len)), U32.to_nat(16), O.pow2n(5n), W.hcw(len, hchk), {==})), {==})
      %fillam(B.words_depth(W.NN(len))) :
        {RT_L.xv_l16_Deposit(Fulu_list_Deposit_16_d.l16_Deposit_Seq{W.RT(d, U32.to_nat(U32.sub(W.NN(len), 1)), 0, 0n, _, t, x), W.NN(len)}) == W.VALw(t, x, len) : S.Value}
      %amrt(d, U32.to_nat(U32.sub(W.NN(len), 1)), 0, 0n, B.words_depth(W.NN(len)), FD.array__trep(RT_L.MB<RT_L.M_Deposit>, B.words_depth(W.NN(len)), RT_L.MNone{}), t, x, {==}, hbQ, hdw, FD.array__trep_perfect(RT_L.MB<RT_L.M_Deposit>, B.words_depth(W.NN(len)), RT_L.MNone{})) :
        {RT_L.xv_l16_Deposit(Fulu_list_Deposit_16_d.l16_Deposit_Seq{_, W.NN(len)}) == W.VALw(t, x, len) : S.Value}
      %Equal.sym(FD.array__Tree<RT_L.MB<RT_L.M_Deposit>>, RT_L.tfz_l16_Deposit(RT_L.am_l16_Deposit(MT(d, U32.to_nat(U32.sub(W.NN(len), 1)), 0n, B.words_depth(W.NN(len)), FD.array__trep(RT_L.MB<RT_L.M_Deposit>, B.words_depth(W.NN(len)), RT_L.MNone{}), t, x))), MT(d, U32.to_nat(U32.sub(W.NN(len), 1)), 0n, B.words_depth(W.NN(len)), FD.array__trep(RT_L.MB<RT_L.M_Deposit>, B.words_depth(W.NN(len)), RT_L.MNone{}), t, x), RT.tfzam_l16_Deposit(MT(d, U32.to_nat(U32.sub(W.NN(len), 1)), 0n, B.words_depth(W.NN(len)), FD.array__trep(RT_L.MB<RT_L.M_Deposit>, B.words_depth(W.NN(len)), RT_L.MNone{}), t, x))) :
        {S.Sequence{RT_L.xi_l16_Deposit(U32.to_nat(W.NN(len)), FD.array__slots(RT_L.MB<RT_L.M_Deposit>, _), 0n)} == W.VALw(t, x, len) : S.Value}
      %Equal.sym(Nat, U32.to_nat(U32.sub(W.NN(len), 1)), Nat.sub(U32.to_nat(W.NN(len)), U32.to_nat(1)), eQ) : {S.Sequence{RT_L.xi_l16_Deposit(U32.to_nat(W.NN(len)), FD.array__slots(RT_L.MB<RT_L.M_Deposit>, MT(d, _, 0n, B.words_depth(W.NN(len)), FD.array__trep(RT_L.MB<RT_L.M_Deposit>, B.words_depth(W.NN(len)), RT_L.MNone{}), t, x)), 0n)} == W.VALw(t, x, len) : S.Value}
      %Equal.sym(Nat, W.CC(len), 1n+k, ecc) : {S.Sequence{RT_L.xi_l16_Deposit(_, FD.array__slots(RT_L.MB<RT_L.M_Deposit>, MT(d, Nat.sub(_, U32.to_nat(1)), 0n, B.words_depth(W.NN(len)), FD.array__trep(RT_L.MB<RT_L.M_Deposit>, B.words_depth(W.NN(len)), RT_L.MNone{}), t, x)), 0n)} == S.Sequence{W.RITEMS(_, t, x)} : S.Value}
      %Equal.sym(Nat, Nat.sub(1n+k, U32.to_nat(1)), k, subz(k)) : {S.Sequence{RT_L.xi_l16_Deposit(1n+k, FD.array__slots(RT_L.MB<RT_L.M_Deposit>, MT(d, _, 0n, B.words_depth(W.NN(len)), FD.array__trep(RT_L.MB<RT_L.M_Deposit>, B.words_depth(W.NN(len)), RT_L.MNone{}), t, x)), 0n)} == S.Sequence{W.RITEMS(1n+k, t, x)} : S.Value}
      Equal.cong(S.Value, S.Value, z => S.Sequence{z}, RT_L.xi_l16_Deposit(1n+k, FD.array__slots(RT_L.MB<RT_L.M_Deposit>, MT(d, k, 0n, B.words_depth(W.NN(len)), FD.array__trep(RT_L.MB<RT_L.M_Deposit>, B.words_depth(W.NN(len)), RT_L.MNone{}), t, x)), 0n), W.RITEMS(1n+k, t, x),
        xiR(d, 1n+k, 0n, k, B.words_depth(W.NN(len)), FD.array__trep(RT_L.MB<RT_L.M_Deposit>, B.words_depth(W.NN(len)), RT_L.MNone{}), t, x, FD.array__trep_perfect(RT_L.MB<RT_L.M_Deposit>, B.words_depth(W.NN(len)), RT_L.MNone{}), hb, hm, len, ecc, hchk, hd, hw, pf))

def vlc(+d: Nat, +t: FD.array__Tree<U32>, +x: Nat, +len: U32, +hchk: {W.CHKw(t, x, 0, len) == True{} : Bool}, +b: Bool, +eb: {U32.is_eq(len, 0) == b : Bool}, +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool})
    -> {RT_L.xv_l16_Deposit(W.LOBJ(d, b, t, x, len)) == W.VALw(t, x, len) : S.Value}:
  match b:
    case True{}:
      %Equal.sym(U32, len, 0, FD.u32alg__eq_of(len, 0, eb)) : {RT_L.xv_l16_Deposit(W.LOBJ(d, True{}, t, x, _)) == W.VALw(t, x, _) : S.Value}
      {==}
    case False{}: vlf(d, t, x, len, hchk, W.CC(len), {==}, eb, hd, hw, pf)

# the list object a window reads views as the window's value
def vl(+d: Nat, +t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat}, +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hchk: {W.CHKw(t, x, off, len) == True{} : Bool})
    -> {RT_L.xv_l16_Deposit(W.OBJw(d, t, x, off, len)) == W.VALw(t, x, len) : S.Value}:
  vlc(d, t, x, len, hchk, U32.is_eq(len, 0), {==}, hd, hw, pf)
