# ---- the same at any tree depth d < 31 (hw32: the window's end below 2^32) ----
def pbv256D(+d: Nat, +t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat}, +hd: {Nat.is_lt(d, 31n) == True{} : Bool},
    +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +hwN: {Nat.is_le(Nat.add(x, U32.to_nat(len)), U32.to_nat(VB.NMAX())) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +h: {CB256.CHKw(t, x, off, len) == True{} : Bool})
    -> {S.BitsValue{BO.bview(CB256.OBJw(d, t, x, off, len))} == CB256.VALw(t, x, len) : S.Value}:
  Equal.cong(+List<Bool>, S.Value, z => S.BitsValue{z}, BO.bview(CB256.OBJw(d, t, x, off, len)), VBL.bl(UW.WX(t, x, U32.to_nat(len))), GPB.pbvD(d, t, x, off, len, eo, hd, hw, hwN, pf, pchk256(t, x, off, len, h)))

def pbv257D(+d: Nat, +t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat}, +hd: {Nat.is_lt(d, 31n) == True{} : Bool},
    +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +hwN: {Nat.is_le(Nat.add(x, U32.to_nat(len)), U32.to_nat(VB.NMAX())) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +h: {CB257.CHKw(t, x, off, len) == True{} : Bool})
    -> {S.BitsValue{BO.bview(CB257.OBJw(d, t, x, off, len))} == CB257.VALw(t, x, len) : S.Value}:
  Equal.cong(+List<Bool>, S.Value, z => S.BitsValue{z}, BO.bview(CB257.OBJw(d, t, x, off, len)), VBL.bl(UW.WX(t, x, U32.to_nat(len))), GPB.pbvD(d, t, x, off, len, eo, hd, hw, hwN, pf, pchk257(t, x, off, len, h)))

def pbv1280D(+d: Nat, +t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat}, +hd: {Nat.is_lt(d, 31n) == True{} : Bool},
    +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +hwN: {Nat.is_le(Nat.add(x, U32.to_nat(len)), U32.to_nat(VB.NMAX())) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +h: {CB1280.CHKw(t, x, off, len) == True{} : Bool})
    -> {S.BitsValue{BO.bview(CB1280.OBJw(d, t, x, off, len))} == CB1280.VALw(t, x, len) : S.Value}:
  Equal.cong(+List<Bool>, S.Value, z => S.BitsValue{z}, BO.bview(CB1280.OBJw(d, t, x, off, len)), VBL.bl(UW.WX(t, x, U32.to_nat(len))), GPB.pbvD(d, t, x, off, len, eo, hd, hw, hwN, pf, pchk1280(t, x, off, len, h)))

def pbv1281D(+d: Nat, +t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat}, +hd: {Nat.is_lt(d, 31n) == True{} : Bool},
    +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +hwN: {Nat.is_le(Nat.add(x, U32.to_nat(len)), U32.to_nat(VB.NMAX())) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +h: {CB1281.CHKw(t, x, off, len) == True{} : Bool})
    -> {S.BitsValue{BO.bview(CB1281.OBJw(d, t, x, off, len))} == CB1281.VALw(t, x, len) : S.Value}:
