# the head of a byte list (0 when empty)
def hd8(xs: +List<U32>) -> U32:
  match xs:
    case Nil{}: 0
    case Con{+x0, r}: x0

# byte i of a list is byte i of its first 1 + i bytes
law nbt:
  for +i: Nat
  for +L: +List<U32>
  {VBL.nthb(VSP.bt(1n+i, L), i) == VBL.nthb(L, i) : U32}
def nbt(i, L):
  match i L:
    case _ Nil{}: {==}
    case 0n Con{+a, +r}: {==}
    case 1n+ +p Con{+a, +r}: nbt(p, r)

