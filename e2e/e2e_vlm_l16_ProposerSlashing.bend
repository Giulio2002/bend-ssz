    RT.nth_l16_ProposerSlashing(FD.array__slots(RT_L.MB<RT_L.M_ProposerSlashing>, D), U32.to_nat(i), hl), pf)

# the window's record writes into am(D) are am of the mirror tree they build
def amrt(k: Nat, +i: U32, +j: Nat, +dd: Nat, +D: FD.array__Tree<RT_L.MB<RT_L.M_ProposerSlashing>>, +t: FD.array__Tree<U32>, +x: Nat, +ej: {U32.to_nat(i) == j : Nat},
    +hb: {Nat.is_lt(Nat.add(k, j), FD.spec_common__pow2(dd)) == True{} : Bool}, +hd: {Nat.is_lt(dd, 32n) == True{} : Bool}, +pf: {FD.array__perfect(RT_L.MB<RT_L.M_ProposerSlashing>, dd, D) == True{} : Bool})
    -> {RT_L.am_l16_ProposerSlashing(MT(k, j, dd, D, t, x)) == W.RT(k, i, j, RT_L.am_l16_ProposerSlashing(D), t, x) : Array<O.Boxed<FuluProposerSlashing_d.ProposerSlashing>>}:
  match k:
    case 0n: Equal.sym(Array<O.Boxed<FuluProposerSlashing_d.ProposerSlashing>>, W.RT(0n, i, j, RT_L.am_l16_ProposerSlashing(D), t, x), RT_L.am_l16_ProposerSlashing(MT(0n, j, dd, D, t, x)), amst(i, j, dd, D, t, x, ej, hb, hd, pf))
    case 1n+ +p:
      +hj = hbj(p, j, dd, hb)
      +h1 = FD.logic__subst(Nat, z => {Nat.is_le(1n+z, FD.spec_common__pow2(dd)) == True{} : Bool}, j, U32.to_nat(i), Equal.sym(Nat, U32.to_nat(i), j, ej), FD.nat__lt_succ_le_succ(j, FD.spec_common__pow2(dd), hj))
      +ej2 = Equal.trans(Nat, U32.to_nat(U32.add(i, 1)), 1n+U32.to_nat(i), 1n+j, inc(i, dd, hd, h1), Equal.cong(Nat, Nat, z => 1n+z, U32.to_nat(i), j, ej))
      +ih = amrt(p, U32.add(i, 1), 1n+j, dd, FD.array__upd(RT_L.MB<RT_L.M_ProposerSlashing>, dd, D, j, MX(t, VRL.pos(j, 416n, x))), t, x, ej2, hbs(p, j, dd, hb), hd,
        FD.array__upd_perfect(RT_L.MB<RT_L.M_ProposerSlashing>, dd, D, j, MX(t, VRL.pos(j, 416n, x)), pf))
      %Equal.sym(Array<O.Boxed<FuluProposerSlashing_d.ProposerSlashing>>, Array.set(O.Boxed<FuluProposerSlashing_d.ProposerSlashing>, RT_L.am_l16_ProposerSlashing(D), i, W.RX(t, VRL.pos(j, 416n, x))), RT_L.am_l16_ProposerSlashing(FD.array__upd(RT_L.MB<RT_L.M_ProposerSlashing>, dd, D, j, MX(t, VRL.pos(j, 416n, x)))), amst(i, j, dd, D, t, x, ej, hj, hd, pf)) :
        {RT_L.am_l16_ProposerSlashing(MT(1n+p, j, dd, D, t, x)) == W.RT(p, U32.add(i, 1), 1n+j, _, t, x) : Array<O.Boxed<FuluProposerSlashing_d.ProposerSlashing>>}
      ih

