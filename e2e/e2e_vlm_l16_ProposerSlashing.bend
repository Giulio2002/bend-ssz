    Equal.sym(Nat, FD.spec_common__length(RT_L.MB<RT_L.M_ProposerSlashing>, FD.array__slots(RT_L.MB<RT_L.M_ProposerSlashing>, D)), FD.spec_common__pow2(dd), FD.array__slots_length(RT_L.MB<RT_L.M_ProposerSlashing>, dd, D, pf)), hi)
  %thfz(t, VRL.pos(j, 416n, x)) :
    {Array.set(O.Boxed<FuluProposerSlashing_d.ProposerSlashing>, RT_L.am_l16_ProposerSlashing(D), i, _) == RT_L.am_l16_ProposerSlashing(FD.array__upd(RT_L.MB<RT_L.M_ProposerSlashing>, dd, D, j, MX(t, VRL.pos(j, 416n, x)))) : Array<O.Boxed<FuluProposerSlashing_d.ProposerSlashing>>}
  %ej : {Array.set(O.Boxed<FuluProposerSlashing_d.ProposerSlashing>, RT_L.am_l16_ProposerSlashing(D), i, RT_L.th_ProposerSlashing_bx(MX(t, VRL.pos(j, 416n, x)))) == RT_L.am_l16_ProposerSlashing(FD.array__upd(RT_L.MB<RT_L.M_ProposerSlashing>, dd, D, _, MX(t, VRL.pos(j, 416n, x)))) : Array<O.Boxed<FuluProposerSlashing_d.ProposerSlashing>>}
