      +hbQ = FD.logic__subst(Nat, z => {Nat.is_lt(Nat.add(z, 0n), FD.spec_common__pow2(B.words_depth(W.NN(len)))) == True{} : Bool}, k, U32.to_nat(U32.sub(W.NN(len), 1)), Equal.trans(Nat, k, Nat.sub(1n+k, U32.to_nat(1)), U32.to_nat(U32.sub(W.NN(len), 1)), Equal.sym(Nat, Nat.sub(1n+k, U32.to_nat(1)), k, subz(k)), Equal.trans(Nat, Nat.sub(1n+k, U32.to_nat(1)), Nat.sub(U32.to_nat(W.NN(len)), U32.to_nat(1)), U32.to_nat(U32.sub(W.NN(len), 1)), Equal.cong(Nat, Nat, z => Nat.sub(z, U32.to_nat(1)), 1n+k, U32.to_nat(W.NN(len)), Equal.sym(Nat, W.CC(len), 1n+k, ecc)), Equal.sym(Nat, U32.to_nat(U32.sub(W.NN(len), 1)), Nat.sub(U32.to_nat(W.NN(len)), U32.to_nat(1)), eQ))), hb)
      +hdw = FD.nat__le_lt_trans(B.words_depth(W.NN(len)), 5n, 32n, VD.wd_min(W.NN(len), 5n, FD.nat__le_trans(U32.to_nat(W.NN(len)), U32.to_nat(16), O.pow2n(5n), W.hcw(len, hchk), {==})), {==})
