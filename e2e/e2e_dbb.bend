  FD.nat__le_trans(U32.to_nat(W.LJ5(t, x)), U32.to_nat(n), U32.to_nat(VB.NMAX()), lwn5(t, x, off, n, hchk), u2n(n, VB.NMAX(), hS))
def pay_hS(+t: FD.array__Tree<U32>, +x: Nat, +off: U32, +n: U32, +hS: {U32.is_le(n, VB.NMAX()) == True{} : Bool}, +hchk: {W.CHKw(t, x, off, n) == True{} : Bool}) -> {U32.is_le(W.LJ5(t, x), VB.NMAX()) == True{} : Bool}:
  n2u(W.LJ5(t, x), VB.NMAX(), pay_hSN(t, x, off, n, hS, hchk))

# the fixed part and the windows add up to n
def tot(+t: FD.array__Tree<U32>, +x: Nat, +off: U32, +n: U32, +hchk: {W.CHKw(t, x, off, n) == True{} : Bool}) -> {Nat.add(Nat.add(Nat.add(Nat.add(Nat.add(Nat.add(Nat.add(Nat.add(Nat.add(U32.to_nat(396), U32.to_nat(W.LJ0(t, x))), U32.to_nat(W.LJ1(t, x))), U32.to_nat(W.LJ2(t, x))), U32.to_nat(W.LJ3(t, x))), U32.to_nat(W.LJ4(t, x))), U32.to_nat(W.LJ5(t, x))), U32.to_nat(W.LJ6(t, x))), U32.to_nat(W.LJ7(t, x))), U32.to_nat(W.LJ8(t, x, n))) == U32.to_nat(n) : Nat}:
  %Equal.cong(U32, Nat, z => U32.to_nat(z), W.O0(t, x), 396, FD.u32alg__eq_of(W.O0(t, x), 396, W.it1(t, x, off, n, hchk))) : {Nat.add(Nat.add(Nat.add(Nat.add(Nat.add(Nat.add(Nat.add(Nat.add(Nat.add(_, U32.to_nat(W.LJ0(t, x))), U32.to_nat(W.LJ1(t, x))), U32.to_nat(W.LJ2(t, x))), U32.to_nat(W.LJ3(t, x))), U32.to_nat(W.LJ4(t, x))), U32.to_nat(W.LJ5(t, x))), U32.to_nat(W.LJ6(t, x))), U32.to_nat(W.LJ7(t, x))), U32.to_nat(W.LJ8(t, x, n))) == U32.to_nat(n) : Nat}
