# s_rng(3, 2^(3 + j)) = 2^j
def s3pw(+j: Nat) -> {VD.s_rng(3n, VB.pw(3n+j)) == VB.pw(j) : Nat}:
  %Equal.sym(Nat, VD.s_rng(2n, VB.pw(2n+(1n+j))), VB.pw(1n+j), VL.rp(1n+j)) : {VD.s_h2(_) == VB.pw(j) : Nat}
  VL.hd2(VB.pw(j))

