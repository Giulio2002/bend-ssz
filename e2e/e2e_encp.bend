def PBR(w: O.Bits) -> Data:
  DK.Ex(EXP.MB, m => DK.P2({w == EXP.TH(m) : O.Bits}, DK.P2({S.BitsValue{BO.bview(EXP.TH(m))} == EXP.VAL(m) : S.Value},
    DK.P2({EXP.OK(m) == True{} : Bool}, {Nat.is_le(LY.LN(EXP.ENC(m)), Nat.add(VB.pw(27n), 1n)) == True{} : Bool}))))

