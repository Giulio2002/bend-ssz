def pbb3(-w: O.Bits, +T: FD.array__Tree<U32>, +dw: Nat, +K: U32, +eo: {w == O.Bits{FD.array__thaw(U32, T), K} : O.Bits}, +f: PBF3(dw, T, K)) -> PBR(w):
