def bitlist_6_rt2(h: B.Buf, -o: O.Bits, +rep: BO.rep_bits(o, GS.bitlist_6()), +t: FD.array__Tree<U32>, +K: U32, +eo: {o == O.Bits{FD.array__thaw(U32, t), K} : O.Bits}) -> {Some{D.bytes(Pair.snd(O.Bits, D.Digest, Pair.snd(B.Buf, O.Bits & D.Digest, bitlist_6_h.bitlist_6_hash_tree_root(h, o))))} == API.hash_tree_root(GS.bitlist_6(), S.BitsValue{BO.bview(o)}) : Maybe<&2, +List<U32>>}:
