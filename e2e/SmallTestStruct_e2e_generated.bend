# (i) for every object the root law takes (rp: both fields below 65536).
def SmallTestStruct_e2e_encode(+o: SmallTestStruct_d.SmallTestStruct, +rp: M1.rp_SmallTestStruct(o)) -> {Some{E.obytes(SmallTestStruct_e.SmallTestStruct_encode(o))} == API.serialize(Spec.SmallTestStruct(), M1.v_SmallTestStruct(o)) : Maybe<&2, +List<U32>>}:
  match o:
    case SmallTestStruct_d.SmallTestStruct{+y0, +y1}:
      (+r0, +r1) = rp
      %Equal.sym(U32, y0, U32{WSp.join(16n, 16n, WSp.take(16n, 32n, PD.bits(y0)), Word.zero(16n))}, VL.half_shape(y0, r0)) : {Some{E.obytes(SmallTestStruct_e.SmallTestStruct_encode(SmallTestStruct_d.SmallTestStruct{_, y1}))} == API.serialize(Spec.SmallTestStruct(), M1.v_SmallTestStruct(SmallTestStruct_d.SmallTestStruct{_, y1})) : Maybe<&2, +List<U32>>}
      %Equal.sym(U32, y1, U32{WSp.join(16n, 16n, WSp.take(16n, 32n, PD.bits(y1)), Word.zero(16n))}, VL.half_shape(y1, r1)) : {Some{E.obytes(SmallTestStruct_e.SmallTestStruct_encode(SmallTestStruct_d.SmallTestStruct{U32{WSp.join(16n, 16n, WSp.take(16n, 32n, PD.bits(y0)), Word.zero(16n))}, _}))} == API.serialize(Spec.SmallTestStruct(), M1.v_SmallTestStruct(SmallTestStruct_d.SmallTestStruct{U32{WSp.join(16n, 16n, WSp.take(16n, 32n, PD.bits(y0)), Word.zero(16n))}, _})) : Maybe<&2, +List<U32>>}
      SmallTestStruct_w(WSp.take(16n, 32n, PD.bits(y0)), WSp.take(16n, 32n, PD.bits(y1)))

