# (i): for every object the root law represents (rep) whose bit list's storage satisfies the encode laws' premises (hs)
def FuluAttestation_e2e_encode(-o: FuluAttestation_d.Attestation, +rep: RT.rep_Attestation(o, Spec.Attestation()), +hs: BTV.sdbv(RT.pj_Attestation_0(o))) -> {Some{E.obytes(Pair.snd(FuluAttestation_d.Attestation, B.Buf, FuluAttestation_e.Attestation_encode(o)))} == API.serialize(Spec.Attestation(), RT.v_Attestation(o)) : Maybe<&2, +List<U32>>}:
  (+x1, q1) = rep
  (+x2, q2) = q1
  (+x3, q3) = q2
  (+eo, +rb) = q3
  (+T, s1) = hs
  (+dw, s2) = s1
  (+K, s3) = s2
  (+ew, s4) = s3
  (+pf, s5) = s4
  (+hdw, s6) = s5
  (+hcap, +hv) = s6
  +eo1 = Equal.trans(FuluAttestation_d.Attestation, o, FuluAttestation_d.Attestation{RT.pj_Attestation_0(o), x1, x2, x3}, FuluAttestation_d.Attestation{O.Bits{FD.array__thaw(U32, T), K}, x1, x2, x3}, eo, Equal.cong(O.Bits, FuluAttestation_d.Attestation, z => FuluAttestation_d.Attestation{z, x1, x2, x3}, RT.pj_Attestation_0(o), O.Bits{FD.array__thaw(U32, T), K}, ew))
  +rb1 = FD.logic__subst(O.Bits, z => BO.rep_bits(z, SH.Chain_head(SH.Container_fields(Spec.Attestation()))), RT.pj_Attestation_0(o), O.Bits{FD.array__thaw(U32, T), K}, ew, rb)
  e0(o, x1, x2, x3, dw, T, K, pf, hdw, rb1, hcap, hv, eo1)
