def e0(-o: FuluAttestation_d.Attestation, +x1: FuluAttestationData_d.AttestationData, +x2: FuluBytes96_d.Bytes96, +x3: Fulu_bitvector_64_d.Bitvector64, +dw: Nat, +T: FD.array__Tree<U32>, +K: U32, +pf: {FD.array__perfect(U32, dw, T) == True{} : Bool}, +hdw: {Nat.is_lt(dw, 31n) == True{} : Bool},
