# Composition of the bridges (e2e/<Name>_e2e_comp_generated.bend): bytes deserialize accepts are the canonical
# encoding of the value it returns (END_TO_END.accepted_spec, serialize_correct).

def gv(m: Maybe<&2, +List<U32>>, +d: +List<U32>) -> +List<U32>:
  match m:
    case Some{x}: x
    case None{}: d

def enc_legal(+s: S.Schema, +v: S.Value, lg: Legal.type_legal(s)) -> {API.serialize(s, v) == Codec.encoding_for_legal_type(s, v) : Maybe<&2, +List<U32>>}:
  Pair.fst(Legal.type_legal(s) -> {API.serialize(s, v) == Codec.encoding_for_legal_type(s, v) : Maybe<&2, +List<U32>>},
    (Legal.type_legal(s) -> Empty) -> {API.serialize(s, v) == None{} : Maybe<&2, +List<U32>>}, E2E.serialize_correct(s, v))(lg)

def enc_of(+s: S.Schema, +bs: +List<U32>, +v: S.Value, p: Legal.type_legal(s) & {Codec.encoding_for_legal_type(s, v) == Some{bs} : Maybe<&2, +List<U32>>})
    -> {API.serialize(s, v) == Some{bs} : Maybe<&2, +List<U32>>}:
  (lg, de) = p
  Equal.trans(Maybe<&2, +List<U32>>, API.serialize(s, v), Codec.encoding_for_legal_type(s, v), Some{bs}, enc_legal(s, v, lg), de)

# accepted bytes re-encode to themselves: an encoder whose output x the spec serializer gives for the value is bs
def dec_enc(+s: S.Schema, +bs: +List<U32>, +v: S.Value, +x: +List<U32>, +acc: {API.deserialize(s, bs) == Some{v} : Maybe<&2, S.Value>},
    +enc: {Some{x} == API.serialize(s, v) : Maybe<&2, +List<U32>>}) -> {x == bs : +List<U32>}:
  Equal.cong(Maybe<&2, +List<U32>>, +List<U32>, z => gv(z, x), Some{x}, Some{bs},
    Equal.trans(Maybe<&2, +List<U32>>, Some{x}, API.serialize(s, v), Some{bs}, enc, enc_of(s, bs, v, E2E.accepted_spec(s, bs, v, acc))))

# the spec root of what deserialize gives for bs (None when it rejects)
def droot_m(+s: S.Schema, m: Maybe<&2, S.Value>) -> Maybe<&2, +List<U32>>:
  match m:
    case Some{v}: API.hash_tree_root(s, v)
    case None{}: None{}
def droot(+s: S.Schema, +bs: +List<U32>) -> Maybe<&2, +List<U32>>: droot_m(s, API.deserialize(s, bs))

def dec_root(+s: S.Schema, +bs: +List<U32>, +v: S.Value, -r: +List<U32>, +acc: {API.deserialize(s, bs) == Some{v} : Maybe<&2, S.Value>},
    +rt: {Some{r} == API.hash_tree_root(s, v) : Maybe<&2, +List<U32>>}) -> {Some{r} == droot(s, bs) : Maybe<&2, +List<U32>>}:
