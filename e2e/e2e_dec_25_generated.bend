    -> ({Pair.snd(B.Buf, Maybe<&1, T.SigningData>, T.SigningData_decode(B.fill_at(B.alloc(n), 0, bs), n)) == Some{o} : Maybe<&1, T.SigningData>} -> {API.deserialize(Spec.SigningData(), bs) == Some{M3.v_SigningData(o)} : Maybe<&2, S.Value>}) & ({API.deserialize(Spec.SigningData(), bs) == Some{M3.v_SigningData(o)} : Maybe<&2, S.Value>} -> {Pair.snd(B.Buf, Maybe<&1, T.SigningData>, T.SigningData_decode(B.fill_at(B.alloc(n), 0, bs), n)) == Some{o} : Maybe<&1, T.SigningData>}):
  (da => FuluSigningData_d_ia(bs, n, o, hn, hd, Nat.is_eq(List.length(&2, U32, bs), 64n), {==}, da), aa => FuluSigningData_d_ib(bs, n, o, hn, Nat.is_eq(List.length(&2, U32, bs), 64n), {==}, aa))

# (iii) the object decoder fails exactly when END_TO_END's deserialize does.
def FuluSigningData_e2e_decode_reject(+bs: +List<U32>, +n: U32, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +hd: {SP.bytes_domain(bs) == True{} : Bool})
    -> ({Pair.snd(B.Buf, Maybe<&1, T.SigningData>, T.SigningData_decode(B.fill_at(B.alloc(n), 0, bs), n)) == None{} : Maybe<&1, T.SigningData>} -> {API.deserialize(Spec.SigningData(), bs) == None{} : Maybe<&2, S.Value>}) & ({API.deserialize(Spec.SigningData(), bs) == None{} : Maybe<&2, S.Value>} -> {Pair.snd(B.Buf, Maybe<&1, T.SigningData>, T.SigningData_decode(B.fill_at(B.alloc(n), 0, bs), n)) == None{} : Maybe<&1, T.SigningData>}):
  (dn => FuluSigningData_d_ra(bs, n, hn, hd, Nat.is_eq(List.length(&2, U32, bs), 64n), {==}, dn), an => FuluSigningData_d_rb(bs, n, hn, hd, Nat.is_eq(List.length(&2, U32, bs), 64n), {==}, an))

