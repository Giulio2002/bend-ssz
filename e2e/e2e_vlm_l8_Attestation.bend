        {S.Items{RT.v_Attestation_bx(RT.th_Attestation_bx(_)), RT.xi_l8_Attestation(p, FD.array__slots(RT.MB<RT.M_Attestation>, FK), 1n+s)} == W.VI(1n+p, c, m, t, x, len) : S.Value}
      %Equal.sym(S.Value, RT.v_Attestation_bx(RT.th_Attestation_bx(NV_l8_Attestation(c, m, d, t, x, off, len))), W.VE(t, x, W.WJ(t, x, c), nb), elv_l8_Attestation(d, t, x, off, len, eo, hd, hw, hw32, pf, W.WJ(t, x, c), nb, hc)) :
        {S.Items{_, RT.xi_l8_Attestation(p, FD.array__slots(RT.MB<RT.M_Attestation>, FK), 1n+s)} == W.VI(1n+p, c, m, t, x, len) : S.Value}
      Equal.cong(S.Value, S.Value, z => S.Items{W.VE(t, x, W.WJ(t, x, c), nb), z}, RT.xi_l8_Attestation(p, FD.array__slots(RT.MB<RT.M_Attestation>, FK), 1n+s), W.VI(p, U32.add(c, 1), m, t, x, len),
        xiW_l8_Attestation(p, U32.add(c, 1), 1n+s, m, d, t, x, off, len, eo, hd, hw, hw32, pf, dd, K, T0, u0, pf0, hm, invK, es1, W.inv_nx(p, c, m, invc), W.he_nx(p, c, m, t, x, off, len, invc, hE)))

# ---- a nonempty window ----
def vtf_l8_Attestation(+d: Nat, +t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat}, +hd: {Nat.is_lt(d, 31n) == True{} : Bool},
    +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +hw32: {Nat.is_lt(Nat.add(x, U32.to_nat(len)), FD.spec_common__pow2(32n)) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hc0: {W.CF(W.HC(W.W0(t, x), len), t, x, off, len) == True{} : Bool})
    -> {RT.xv_l8_Attestation(W.RZ(False{}, d, t, x, off, len)) == W.VZE(False{}, t, x, len) : S.Value}:
  +f = W.W0(t, x)
  +N = W.NN(t, x)
  +ec = W.cf_ok(W.HC(f, len), t, x, off, len, hc0)
  +hEV = FD.logic__subst(Bool, z => {W.CF(z, t, x, off, len) == True{} : Bool}, W.HC(f, len), True{}, ec, hc0)
  +hA = FD.logic__and_left(Bool.and(U32.is_eq(U32.and(f, 3), 0), U32.is_le(f, len)), Bool.and(U32.is_le(4, f), U32.is_le(U32.shrn(f, 2n), 8)), ec)
  +hB = FD.logic__and_right(Bool.and(U32.is_eq(U32.and(f, 3), 0), U32.is_le(f, len)), Bool.and(U32.is_le(4, f), U32.is_le(U32.shrn(f, 2n), 8)), ec)
  +e3 = VVU.eqt(U32.and(f, 3), 0, FD.logic__and_left(U32.is_eq(U32.and(f, 3), 0), U32.is_le(f, len), hA))
  +h4 = W.ule(4, f, FD.logic__and_left(U32.is_le(4, f), U32.is_le(U32.shrn(f, 2n), 8), hB))
  +hfl = W.ule(f, len, FD.logic__and_right(U32.is_eq(U32.and(f, 3), 0), U32.is_le(f, len), hA))
  +ew = Equal.trans(Nat, U32.to_nat(f), Nat.add(A.quad(U32.to_nat(N)), U32.to_nat(U32.and(f, 3))), A.quad(U32.to_nat(N)), VC.split4(f),
    Equal.trans(Nat, Nat.add(A.quad(U32.to_nat(N)), U32.to_nat(U32.and(f, 3))), Nat.add(A.quad(U32.to_nat(N)), 0n), A.quad(U32.to_nat(N)),
      Equal.cong(Nat, Nat, z => Nat.add(A.quad(U32.to_nat(N)), z), U32.to_nat(U32.and(f, 3)), 0n, e3), FD.nat__add_zero(A.quad(U32.to_nat(N)))))
  +h1 = W.quad_pos(U32.to_nat(N), FD.logic__subst(Nat, z => {Nat.is_le(4n, z) == True{} : Bool}, U32.to_nat(f), A.quad(U32.to_nat(N)), ew, h4))
  +es = FD.u32__sub_nat(N, 1, h1)
  +k0 = U32.to_nat(U32.sub(N, 1))
  +inv = Equal.trans(Nat, Nat.add(U32.to_nat(0), 1n+k0), 1n+Nat.sub(U32.to_nat(N), 1n), U32.to_nat(N),
    Equal.cong(Nat, Nat, z => 1n+z, k0, Nat.sub(U32.to_nat(N), 1n), es),
    FD.nat__sub_add(U32.to_nat(N), 1n, h1))
  +hc1 = W.ev_ok(k0, 0, N, t, x, off, len, W.EE(True{}, t, x, off, len, f, W.B1(t, x, len)), W.B1(t, x, len), hEV)
  +hE1 = FD.logic__subst(Bool, z => {W.EV(k0, 0, N, t, x, off, len, z, W.B1(t, x, len)) == True{} : Bool}, W.EE(True{}, t, x, off, len, f, W.B1(t, x, len)), True{}, hc1, hEV)
  +hE0 = W.he0(t, x, off, len, U32.is_eq(1, N), {==}, hE1)
  +hNq = FD.logic__subst(Nat, z => {Nat.is_le(z, A.quad(VB.pw(d))) == True{} : Bool}, U32.to_nat(f), A.quad(U32.to_nat(N)), ew,
    FD.nat__le_trans(U32.to_nat(f), U32.to_nat(len), A.quad(VB.pw(d)), hfl, W.hlen(d, x, len, hw, hw32)))
  +hN4 = FD.logic__subst(Nat, z => {Nat.is_le(U32.to_nat(N), z) == True{} : Bool}, VB.pw(d), O.pow2n(d), VD.s_pow2_eq(d), VC.quad_inv(U32.to_nat(N), VB.pw(d), hNq))
  +dd = B.words_depth(N)
  +hdd = FD.nat__le_lt_trans(dd, d, 32n, VD.wd_min(N, d, hN4), FD.nat__lt_trans(d, 31n, 32n, hd, {==}))
  +hm = FD.logic__subst(Nat, z => {Nat.is_le(U32.to_nat(N), z) == True{} : Bool}, O.pow2n(dd), FD.spec_common__pow2(dd), Equal.sym(Nat, FD.spec_common__pow2(dd), O.pow2n(dd), VD.s_pow2_eq(dd)),
    VD.wd_cover(N, d, FD.nat__lt_le(d, 32n, FD.nat__lt_trans(d, 31n, 32n, hd, {==})), hN4))
  +T0 = FD.array__trep(RT.MB<RT.M_Attestation>, dd, RT.MNone{})
  +pf0 = FD.array__trep_perfect(RT.MB<RT.M_Attestation>, dd, RT.MNone{})
  +u0 = ND_l8_Attestation(d, t, x, off, f, W.B1(t, x, len))
  +FK = FT_l8_Attestation(k0, 0, N, d, t, x, off, len, dd, T0, u0)
  +x0 = xat_of_l8_Attestation(dd, FK, 0n, u0, pfFT_l8_Attestation(k0, 0, N, d, t, x, off, len, dd, T0, u0, pf0), FD.nat__lt_le_trans(0n, U32.to_nat(N), FD.spec_common__pow2(dd), FD.nat__succ_le_lt(0n, U32.to_nat(N), h1), hm),
    lemV_l8_Attestation(k0, 0, N, d, t, x, off, len, dd, T0, u0, pf0, hm, inv))
  %Equal.sym(O.Boxed<FuluAttestation_d.Attestation>, W.OBJE(d, t, x, off, f, W.B1(t, x, len)), RT.th_Attestation_bx(u0), eqE_l8_Attestation(d, t, x, off, len, eo, hd, hw, hw32, pf, f, W.B1(t, x, len), hc1)) :
    {S.Sequence{RT.xi_l8_Attestation(U32.to_nat(N), FD.array__slots(RT.MB<RT.M_Attestation>, RT.tfz_l8_Attestation(W.RV(k0, 0, N, d, t, x, off, len, Fulu_list_Attestation_8_d.l8_Attestation_fill(dd), _))), 0n)} == W.VZE(False{}, t, x, len) : S.Value}
  %Equal.sym(Array<O.Boxed<FuluAttestation_d.Attestation>>, Fulu_list_Attestation_8_d.l8_Attestation_fill(dd), RT.am_l8_Attestation(T0), fillam_l8_Attestation(dd)) :
    {S.Sequence{RT.xi_l8_Attestation(U32.to_nat(N), FD.array__slots(RT.MB<RT.M_Attestation>, RT.tfz_l8_Attestation(W.RV(k0, 0, N, d, t, x, off, len, _, RT.th_Attestation_bx(u0)))), 0n)} == W.VZE(False{}, t, x, len) : S.Value}
  %Equal.sym(Array<O.Boxed<FuluAttestation_d.Attestation>>, W.RV(k0, 0, N, d, t, x, off, len, RT.am_l8_Attestation(T0), RT.th_Attestation_bx(u0)), RT.am_l8_Attestation(FK), rvF_l8_Attestation(k0, 0, N, d, t, x, off, len, eo, hd, hw, hw32, pf, dd, T0, u0, pf0, hdd, hm, inv, hE0)) :
    {S.Sequence{RT.xi_l8_Attestation(U32.to_nat(N), FD.array__slots(RT.MB<RT.M_Attestation>, RT.tfz_l8_Attestation(_)), 0n)} == W.VZE(False{}, t, x, len) : S.Value}
  %Equal.sym(FD.array__Tree<RT.MB<RT.M_Attestation>>, RT.tfz_l8_Attestation(RT.am_l8_Attestation(FK)), FK, RT.tfzam_l8_Attestation(FK)) :
    {S.Sequence{RT.xi_l8_Attestation(U32.to_nat(N), FD.array__slots(RT.MB<RT.M_Attestation>, _), 0n)} == W.VZE(False{}, t, x, len) : S.Value}
  %inv : {S.Sequence{RT.xi_l8_Attestation(_, FD.array__slots(RT.MB<RT.M_Attestation>, FK), 0n)} == W.VZE(False{}, t, x, len) : S.Value}
  %Equal.sym(RT.MB<RT.M_Attestation>, RT.xat_l8_Attestation(FD.array__slots(RT.MB<RT.M_Attestation>, FK), 0n), u0, x0) :
    {S.Sequence{S.Items{RT.v_Attestation_bx(RT.th_Attestation_bx(_)), RT.xi_l8_Attestation(k0, FD.array__slots(RT.MB<RT.M_Attestation>, FK), 1n)}} == W.VZE(False{}, t, x, len) : S.Value}
  %Equal.sym(S.Value, RT.v_Attestation_bx(RT.th_Attestation_bx(u0)), W.VE(t, x, f, W.B1(t, x, len)), elv_l8_Attestation(d, t, x, off, len, eo, hd, hw, hw32, pf, f, W.B1(t, x, len), hc1)) :
    {S.Sequence{S.Items{_, RT.xi_l8_Attestation(k0, FD.array__slots(RT.MB<RT.M_Attestation>, FK), 1n)}} == W.VZE(False{}, t, x, len) : S.Value}
  Equal.cong(S.Value, S.Value, z => S.Sequence{S.Items{W.VE(t, x, f, W.B1(t, x, len)), z}}, RT.xi_l8_Attestation(k0, FD.array__slots(RT.MB<RT.M_Attestation>, FK), 1n), W.VI(k0, 0, N, t, x, len),
    xiW_l8_Attestation(k0, 0, 1n, N, d, t, x, off, len, eo, hd, hw, hw32, pf, dd, k0, T0, u0, pf0, hm, inv, {==}, inv, hE0))

def vtc_l8_Attestation(+d: Nat, +t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat}, +hd: {Nat.is_lt(d, 31n) == True{} : Bool},
    +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +hw32: {Nat.is_lt(Nat.add(x, U32.to_nat(len)), FD.spec_common__pow2(32n)) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +b: Bool, +hc: {W.CZ(b, t, x, off, len) == True{} : Bool})
    -> {RT.xv_l8_Attestation(W.RZ(b, d, t, x, off, len)) == W.VZE(b, t, x, len) : S.Value}:
  match b:
    case True{}: {==}
    case False{}: vtf_l8_Attestation(d, t, x, off, len, eo, hd, hw, hw32, pf, hc)

# the list a window reads views as the window's value, when the window lies in the buffer and its check passed
def vw_l8_Attestation(+d: Nat, +t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat}, +hd: {Nat.is_lt(d, 31n) == True{} : Bool},
    +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +hw32: {Nat.is_lt(Nat.add(x, U32.to_nat(len)), FD.spec_common__pow2(32n)) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hc: {W.CHKw(t, x, off, len) == True{} : Bool})
    -> {RT.xv_l8_Attestation(W.OBJw(d, t, x, off, len)) == W.VALw(t, x, len) : S.Value}:
  vtc_l8_Attestation(d, t, x, off, len, eo, hd, hw, hw32, pf, U32.is_eq(len, 0), hc)


# ======== the law: the list a window reads views as the window's value ========
def vl(+d: Nat, +t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat}, +hd: {Nat.is_lt(d, 31n) == True{} : Bool},
    +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +hw32: {Nat.is_lt(Nat.add(x, U32.to_nat(len)), FD.spec_common__pow2(32n)) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hchk: {W.CHKw(t, x, off, len) == True{} : Bool})
    -> {RT.xv_l8_Attestation(W.OBJw(d, t, x, off, len)) == W.VALw(t, x, len) : S.Value}:
  vw_l8_Attestation(d, t, x, off, len, eo, hd, hw, hw32, pf, hchk)
