# ---- the reader's chain of writes is am of FT ----
def rvF_l8_Attestation(k: Nat, +i: U32, +m: U32, +d: Nat, +t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat}, +hd: {Nat.is_lt(d, 31n) == True{} : Bool},
    +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +hw32: {Nat.is_lt(Nat.add(x, U32.to_nat(len)), FD.spec_common__pow2(32n)) == True{} : Bool},
    +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +dd: Nat, +T: FD.array__Tree<RT.MB<RT.M_Attestation>>, +u: RT.MB<RT.M_Attestation>,
    +pfT: {FD.array__perfect(RT.MB<RT.M_Attestation>, dd, T) == True{} : Bool}, +hdd: {Nat.is_lt(dd, 32n) == True{} : Bool}, +hm: {Nat.is_le(U32.to_nat(m), FD.spec_common__pow2(dd)) == True{} : Bool},
    +inv: {Nat.add(U32.to_nat(i), 1n+k) == U32.to_nat(m) : Nat}, +hE: {W.EV(k, i, m, t, x, off, len, True{}, W.WJ(t, x, i)) == True{} : Bool})
    -> {W.RV(k, i, m, d, t, x, off, len, RT.am_l8_Attestation(T), RT.th_Attestation_bx(u)) == RT.am_l8_Attestation(FT_l8_Attestation(k, i, m, d, t, x, off, len, dd, T, u)) : Array<O.Boxed<FuluAttestation_d.Attestation>>}:
  match k:
    case 0n:
      +hi = hiq(i, 0n, m, dd, inv, hm)
      RT.amset_l8_Attestation(dd, T, i, u, RT.xat_l8_Attestation(FD.array__slots(RT.MB<RT.M_Attestation>, T), U32.to_nat(i)), hdd, hi, hx_at_l8_Attestation(dd, T, U32.to_nat(i), pfT, hi), pfT)
    case 1n+ +q:
      +hi = hiq(i, 1n+q, m, dd, inv, hm)
      +nb = W.NX(U32.is_eq(U32.add(i, 2), m), t, x, len, U32.add(i, 1))
      +hc = W.ev_ok(q, U32.add(i, 1), m, t, x, off, len, W.EE(True{}, t, x, off, len, W.WJ(t, x, i), nb), nb, hE)
