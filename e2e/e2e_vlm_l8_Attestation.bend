# i < i + 1 + k == m <= 2^dd
def hiq(+i: U32, +k: Nat, +m: U32, +dd: Nat, +inv: {Nat.add(U32.to_nat(i), 1n+k) == U32.to_nat(m) : Nat}, +hm: {Nat.is_le(U32.to_nat(m), FD.spec_common__pow2(dd)) == True{} : Bool})
