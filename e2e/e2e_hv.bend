    Equal.cong(List<&2, U32>, U32, z => FD.flat__nthc(z, U32.to_nat(U32.shrn(NB, 5n))), FD.array__slots(U32, FD.array__upd(U32, dz, ML, U32.to_nat(U32.shrn(NB, 5n)), U32.and(FD.flat__nthc(FD.array__slots(U32, ML), U32.to_nat(U32.shrn(NB, 5n))), U32.not(M.shl_by(1, U32.and(NB, 31)))))), FD.spec_common__update(U32, FD.array__slots(U32, ML), U32.to_nat(U32.shrn(NB, 5n)), U32.and(FD.flat__nthc(FD.array__slots(U32, ML), U32.to_nat(U32.shrn(NB, 5n))), U32.not(M.shl_by(1, U32.and(NB, 31))))), FD.array__upd_slots(U32, dz, ML, U32.to_nat(U32.shrn(NB, 5n)), U32.and(FD.flat__nthc(FD.array__slots(U32, ML), U32.to_nat(U32.shrn(NB, 5n))), U32.not(M.shl_by(1, U32.and(NB, 31)))), hq5, pML)),
