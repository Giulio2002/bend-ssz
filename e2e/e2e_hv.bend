# the last word masked to bytes 0 .. 0 with the delimiter bit a = 0 + high_bit(byte 0) cleared: no bit at or above a is set
def hvw0(+x: U32, +a: U32, +ea: {U32.to_nat(a) == Nat.add(0n, U32.to_nat(O.high_bit(U32.and(x, 255)))) : Nat}) -> {O.bits_above_zero(a, U32.and(O.keep(1, x), U32.not(M.shl_by(1, a)))) == True{} : Bool}:
  match x:
    case U32{WCon{+b0, WCon{+b1, WCon{+b2, WCon{+b3, WCon{+b4, WCon{+b5, WCon{+b6, WCon{+b7, +r}}}}}}}}}:
