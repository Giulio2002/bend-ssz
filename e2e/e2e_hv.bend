  +hr = FD.logic__subst(Nat, z => {Nat.is_le(z, VB.pw(dz)) == True{} : Bool}, 1n+U32.to_nat(U32.shrn(NB, 5n)), Nat.add(U32.to_nat(U32.shrn(NB, 5n)), 1n), FD.nat__add_comm(1n, U32.to_nat(U32.shrn(NB, 5n))), FD.nat__lt_succ_le_succ(U32.to_nat(U32.shrn(NB, 5n)), VB.pw(dz), hq5))
