    +ei: {U32.to_nat(U32.sub(U32.shrn((n + 3 : U32), 2n), 1)) == Q : Nat},
    +eNB: {U32.to_nat(NB) == Nat.add(BV.x32(Q), Nat.add(0n, h)) : Nat}, +hq: {Nat.is_lt(Q, FD.spec_common__pow2(dz)) == True{} : Bool},
