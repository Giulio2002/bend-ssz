# the last word masked to bytes 0 .. 2 with the delimiter bit a = 16 + high_bit(byte 2) cleared: no bit at or above a is set
def hvw2(+x: U32, +a: U32, +ea: {U32.to_nat(a) == Nat.add(16n, U32.to_nat(O.high_bit(U32.and(U32.shrn(x, 16n), 255)))) : Nat}) -> {O.bits_above_zero(a, U32.and(O.keep(3, x), U32.not(M.shl_by(1, a)))) == True{} : Bool}:
