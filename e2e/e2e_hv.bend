      +hq = FD.nat__succ_le_lt(Q, FD.spec_common__pow2(dz), FD.logic__subst(Nat, z => {Nat.is_le(z, FD.spec_common__pow2(dz)) == True{} : Bool}, C.nwn(U32.to_nat(U32{WCon{False{}, WCon{False{}, r}}})), 1n+Q,
        Equal.trans(Nat, C.nwn(U32.to_nat(U32{WCon{False{}, WCon{False{}, r}}})), Word.to_nat(30n, r), 1n+Q, C.rq(Word.to_nat(30n, r)), eq), hN))
    +hlen = FD.array__len_lt(U32, dz, M, Q, pf, hq)
    +eh2 = FD.logic__subst(Nat, z => {VY.hb(VBL.nthb(SF.limbs(FD.array__slots(U32, M)), z)) == h : Nat}, m, Nat.add(3n, A.quad(Q)), em, eh)
    +eb = Equal.trans(Nat, VY.hb(U32.shrn(FD.flat__nthc(FD.array__slots(U32, M), Q), 24n)), VY.hb(VBL.nthb(SF.limbs(FD.array__slots(U32, M)), Nat.add(3n, A.quad(Q)))), h,
      Equal.cong(U32, Nat, z => VY.hb(z), U32.shrn(FD.flat__nthc(FD.array__slots(U32, M), Q), 24n), VBL.nthb(SF.limbs(FD.array__slots(U32, M)), Nat.add(3n, A.quad(Q))), Equal.sym(U32, VBL.nthb(SF.limbs(FD.array__slots(U32, M)), Nat.add(3n, A.quad(Q))), U32.shrn(FD.flat__nthc(FD.array__slots(U32, M), Q), 24n), nlb3(FD.array__slots(U32, M), Q, hlen))), eh2)
      hcore3(dz, M, U32{WCon{False{}, WCon{False{}, r}}}, NB, Q, h, pf, hdz, hh, Equal.sym(U32, U32{WCon{False{}, WCon{False{}, Word.zero(30n)}}}, U32.and(U32{WCon{False{}, WCon{False{}, r}}}, 3), BF.low_sel(False{}, False{}, r)), eNB2, hq, eb)

# The decoder's bit list storage (the words copied into M, the last word masked to n bytes, the delimiter bit NB cleared),
# NB = 8 m + h, n = 1 + m, h the high bit of the last byte: a tree at M's depth with room for word NB >> 5, no bit set at or above NB.
def hvobj(+n: U32, +dz: Nat, +M: FD.array__Tree<U32>, +NB: U32, +m: Nat, +h: Nat, +pf: {FD.array__perfect(U32, dz, M) == True{} : Bool}, +hdz: {Nat.is_lt(dz, 32n) == True{} : Bool}, +hh: {Nat.is_le(h, 7n) == True{} : Bool}, +eNB: {U32.to_nat(NB) == Nat.add(VSP.x8(m), h) : Nat}, +hN: {Nat.is_le(C.nwn(U32.to_nat(n)), FD.spec_common__pow2(dz)) == True{} : Bool}, +hn3: {Nat.is_lt(Nat.add(3n, U32.to_nat(n)), FD.spec_common__pow2(32n)) == True{} : Bool}, +e1: {U32.to_nat(n) == 1n+m : Nat}, +eh: {VY.hb(VBL.nthb(SF.limbs(FD.array__slots(U32, M)), m)) == h : Nat}) -> SDX(O.clear_bit(O.mask_last(n, FD.array__thaw(U32, M)), NB), NB, dz):
  match n:
    case U32{WCon{False{}, WCon{False{}, +r}}}: hvn0q(r, Word.to_nat(30n, r), {==}, dz, M, NB, m, h, pf, hdz, hh, eNB, hN, hn3, e1, eh)
    case U32{WCon{True{}, WCon{False{}, +r}}}: hvn1(r, dz, M, NB, m, h, pf, hdz, hh, eNB, hN, hn3, e1, eh)
    case U32{WCon{False{}, WCon{True{}, +r}}}: hvn2(r, dz, M, NB, m, h, pf, hdz, hh, eNB, hN, hn3, e1, eh)
    case U32{WCon{True{}, WCon{True{}, +r}}}: hvn3(r, dz, M, NB, m, h, pf, hdz, hh, eNB, hN, hn3, e1, eh)

# ---- as the encode laws' premise forms ----
# word K >> 5 as the bit-list records index it
def qk5(+K: U32) -> {U32.to_nat(U32.shrn(K, 5n)) == VBT.QK(K) : Nat}:
  %Equal.sym(U32, U32.add(0, U32.shrn(K, 3n)), U32.shrn(K, 3n), FD.u32alg__zero_add(U32.shrn(K, 3n))) : {U32.to_nat(U32.shrn(K, 5n)) == U32.to_nat(U32.shrn(_, 2n)) : Nat}
  Equal.trans(Nat, U32.to_nat(U32.shrn(K, 5n)), VD.s_rng(5n, U32.to_nat(K)), U32.to_nat(U32.shrn(U32.shrn(K, 3n), 2n)), VD.shrk(5n, K),
    Equal.sym(Nat, U32.to_nat(U32.shrn(U32.shrn(K, 3n), 2n)), VD.s_rng(5n, U32.to_nat(K)),
      Equal.trans(Nat, U32.to_nat(U32.shrn(U32.shrn(K, 3n), 2n)), VD.s_rng(2n, U32.to_nat(U32.shrn(K, 3n))), VD.s_rng(5n, U32.to_nat(K)), VD.shrk(2n, U32.shrn(K, 3n)),
        Equal.cong(Nat, Nat, z => VD.s_rng(2n, z), U32.to_nat(U32.shrn(K, 3n)), VD.s_rng(3n, U32.to_nat(K)), VD.shrk(3n, K)))))

# the bit list's storage as e2e_bitv.sdbv (depth below 31)
def sdbx(-A_: Array<U32>, +K: U32, +dz: Nat, +hd: {Nat.is_lt(dz, 31n) == True{} : Bool}, +x: SDX(A_, K, dz)) -> BTV.sdbv(O.Bits{A_, K}):
  (+T, x1) = x
  (+eA, x2) = x1
  (+pT, x3) = x2
  (+hr, +hv) = x3
  (T, (dz, (K, (Equal.cong(Array<U32>, O.Bits, z => O.Bits{z, K}, A_, FD.array__thaw(U32, T), eA), (pT, (hd, (hr,
    FD.logic__subst(Nat, z => {O.bits_above_zero(U32.and(K, 31), VB.slot(T, z)) == True{} : Bool}, U32.to_nat(U32.shrn(K, 5n)), VBT.QK(K), qk5(K), hv))))))))
