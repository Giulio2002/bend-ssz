      baz31(U32.and(U32{WCon{c0, WCon{c1, WCon{c2, WCon{c3, WCon{c4, WCon{c5, WCon{c6, WCon{c7, WCon{c8, WCon{c9, WCon{c10, WCon{c11, WCon{c12, WCon{c13, WCon{c14, WCon{c15, WCon{c16, WCon{c17, WCon{c18, WCon{c19, WCon{c20, WCon{c21, WCon{c22, WCon{c23, WCon{True{}, WCon{False{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WNil{}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}, U32.not(M.shl_by(1, 31))), {==})
    case False{} True{} True{} True{} True{} True{} True{} True{}:
      %Equal.sym(U32, a, 31, FD.u32__injective(a, 31, ea)) : {O.bits_above_zero(_, U32.and(U32{WCon{c0, WCon{c1, WCon{c2, WCon{c3, WCon{c4, WCon{c5, WCon{c6, WCon{c7, WCon{c8, WCon{c9, WCon{c10, WCon{c11, WCon{c12, WCon{c13, WCon{c14, WCon{c15, WCon{c16, WCon{c17, WCon{c18, WCon{c19, WCon{c20, WCon{c21, WCon{c22, WCon{c23, WCon{False{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WNil{}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}, U32.not(M.shl_by(1, _)))) == True{} : Bool}
      baz31(U32.and(U32{WCon{c0, WCon{c1, WCon{c2, WCon{c3, WCon{c4, WCon{c5, WCon{c6, WCon{c7, WCon{c8, WCon{c9, WCon{c10, WCon{c11, WCon{c12, WCon{c13, WCon{c14, WCon{c15, WCon{c16, WCon{c17, WCon{c18, WCon{c19, WCon{c20, WCon{c21, WCon{c22, WCon{c23, WCon{False{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WNil{}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}, U32.not(M.shl_by(1, 31))), {==})
    case True{} True{} True{} True{} True{} True{} True{} True{}:
      %Equal.sym(U32, a, 31, FD.u32__injective(a, 31, ea)) : {O.bits_above_zero(_, U32.and(U32{WCon{c0, WCon{c1, WCon{c2, WCon{c3, WCon{c4, WCon{c5, WCon{c6, WCon{c7, WCon{c8, WCon{c9, WCon{c10, WCon{c11, WCon{c12, WCon{c13, WCon{c14, WCon{c15, WCon{c16, WCon{c17, WCon{c18, WCon{c19, WCon{c20, WCon{c21, WCon{c22, WCon{c23, WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WNil{}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}, U32.not(M.shl_by(1, _)))) == True{} : Bool}
      baz31(U32.and(U32{WCon{c0, WCon{c1, WCon{c2, WCon{c3, WCon{c4, WCon{c5, WCon{c6, WCon{c7, WCon{c8, WCon{c9, WCon{c10, WCon{c11, WCon{c12, WCon{c13, WCon{c14, WCon{c15, WCon{c16, WCon{c17, WCon{c18, WCon{c19, WCon{c20, WCon{c21, WCon{c22, WCon{c23, WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WNil{}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}, U32.not(M.shl_by(1, 31))), {==})

# the last word masked to bytes 0 .. 3 with the delimiter bit a = 24 + high_bit(byte 3) cleared: no bit at or above a is set
def hvw3(+x: U32, +a: U32, +ea: {U32.to_nat(a) == Nat.add(24n, U32.to_nat(O.high_bit(U32.shrn(x, 24n)))) : Nat}) -> {O.bits_above_zero(a, U32.and(x, U32.not(M.shl_by(1, a)))) == True{} : Bool}:
  match x:
    case U32{WCon{+c0, WCon{+c1, WCon{+c2, WCon{+c3, WCon{+c4, WCon{+c5, WCon{+c6, WCon{+c7, WCon{+c8, WCon{+c9, WCon{+c10, WCon{+c11, WCon{+c12, WCon{+c13, WCon{+c14, WCon{+c15, WCon{+c16, WCon{+c17, WCon{+c18, WCon{+c19, WCon{+c20, WCon{+c21, WCon{+c22, WCon{+c23, WCon{+b0, WCon{+b1, WCon{+b2, WCon{+b3, WCon{+b4, WCon{+b5, WCon{+b6, WCon{+b7, WNil{}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}:
      hvb3(c0, c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, c12, c13, c14, c15, c16, c17, c18, c19, c20, c21, c22, c23, b0, b1, b2, b3, b4, b5, b6, b7, a, ea)


# a word list updated at q holds v there
law nu:
  for +W: List<&2, U32>
  for +q: Nat
  for +v: U32
  for +h: {Nat.is_lt(q, FD.spec_common__length(U32, W)) == True{} : Bool}
  {FD.flat__nthc(FD.spec_common__update(U32, W, q, v), q) == v : U32}
def nu(W, q, v, h):
  match W q:
    case Nil{} _: Empty.absurd({FD.flat__nthc(FD.spec_common__update(U32, Nil{}, q, v), q) == v : U32}, FD.nat__lt_zero_absurd(q, h))
    case Con{+x, +t} 0n: {==}
    case Con{+x, +t} 1n+ +p: nu(t, p, v, h)

# byte 0 of word Q of a word list, among its bytes
law nlb0:
  for +W: List<&2, U32>
  for +Q: Nat
  for +h: {Nat.is_lt(Q, FD.spec_common__length(U32, W)) == True{} : Bool}
  {VBL.nthb(SF.limbs(W), Nat.add(0n, A.quad(Q))) == U32.and(FD.flat__nthc(W, Q), 255) : U32}
def nlb0(W, Q, h):
  match W Q:
    case Nil{} _: Empty.absurd({VBL.nthb(SF.limbs(Nil{}), Nat.add(0n, A.quad(Q))) == U32.and(FD.flat__nthc(Nil{}, Q), 255) : U32}, FD.nat__lt_zero_absurd(Q, h))
    case Con{+x, +t} 0n: {==}
    case Con{+x, +t} 1n+ +k: nlb0(t, k, h)

# byte 1 of word Q of a word list, among its bytes
law nlb1:
  for +W: List<&2, U32>
  for +Q: Nat
  for +h: {Nat.is_lt(Q, FD.spec_common__length(U32, W)) == True{} : Bool}
  {VBL.nthb(SF.limbs(W), Nat.add(1n, A.quad(Q))) == U32.and(U32.shrn(FD.flat__nthc(W, Q), 8n), 255) : U32}
def nlb1(W, Q, h):
  match W Q:
    case Nil{} _: Empty.absurd({VBL.nthb(SF.limbs(Nil{}), Nat.add(1n, A.quad(Q))) == U32.and(U32.shrn(FD.flat__nthc(Nil{}, Q), 8n), 255) : U32}, FD.nat__lt_zero_absurd(Q, h))
    case Con{+x, +t} 0n: {==}
    case Con{+x, +t} 1n+ +k: nlb1(t, k, h)

# byte 2 of word Q of a word list, among its bytes
law nlb2:
  for +W: List<&2, U32>
  for +Q: Nat
  for +h: {Nat.is_lt(Q, FD.spec_common__length(U32, W)) == True{} : Bool}
  {VBL.nthb(SF.limbs(W), Nat.add(2n, A.quad(Q))) == U32.and(U32.shrn(FD.flat__nthc(W, Q), 16n), 255) : U32}
def nlb2(W, Q, h):
  match W Q:
    case Nil{} _: Empty.absurd({VBL.nthb(SF.limbs(Nil{}), Nat.add(2n, A.quad(Q))) == U32.and(U32.shrn(FD.flat__nthc(Nil{}, Q), 16n), 255) : U32}, FD.nat__lt_zero_absurd(Q, h))
    case Con{+x, +t} 0n: {==}
    case Con{+x, +t} 1n+ +k: nlb2(t, k, h)

# byte 3 of word Q of a word list, among its bytes
law nlb3:
  for +W: List<&2, U32>
  for +Q: Nat
  for +h: {Nat.is_lt(Q, FD.spec_common__length(U32, W)) == True{} : Bool}
  {VBL.nthb(SF.limbs(W), Nat.add(3n, A.quad(Q))) == U32.shrn(FD.flat__nthc(W, Q), 24n) : U32}
def nlb3(W, Q, h):
  match W Q:
    case Nil{} _: Empty.absurd({VBL.nthb(SF.limbs(Nil{}), Nat.add(3n, A.quad(Q))) == U32.shrn(FD.flat__nthc(Nil{}, Q), 24n) : U32}, FD.nat__lt_zero_absurd(Q, h))
    case Con{+x, +t} 0n: {==}
    case Con{+x, +t} 1n+ +k: nlb3(t, k, h)

# clearing bit k of a perfect word tree is a tree update of word k >> 5
def cbt(+d: Nat, +T: FD.array__Tree<U32>, +k: U32, +pf: {FD.array__perfect(U32, d, T) == True{} : Bool}, +hd: {Nat.is_lt(d, 32n) == True{} : Bool},
    +hq: {Nat.is_lt(U32.to_nat(U32.shrn(k, 5n)), FD.spec_common__pow2(d)) == True{} : Bool})
    -> {O.clear_bit(FD.array__thaw(U32, T), k) == FD.array__thaw(U32, FD.array__upd(U32, d, T, U32.to_nat(U32.shrn(k, 5n)), U32.and(FD.flat__nthc(FD.array__slots(U32, T), U32.to_nat(U32.shrn(k, 5n))), U32.not(M.shl_by(1, U32.and(k, 31)))))) : Array<U32>}:
  +i = U32.shrn(k, 5n)
  +x = FD.flat__nthc(FD.array__slots(U32, T), U32.to_nat(i))
  +hx = FD.flat__nthc_nth(FD.array__slots(U32, T), U32.to_nat(i), FD.array__len_lt(U32, d, T, U32.to_nat(i), pf, hq))
  %Equal.sym(Array<U32> & U32, Array.get(U32, FD.array__thaw(U32, T), i), (FD.array__thaw(U32, T), x), FD.array__get(U32, d, T, i, x, hd, hq, hx, pf)) :
    {O.clear_at(i, M.shl_by(1, U32.and(k, 31)), _) == FD.array__thaw(U32, FD.array__upd(U32, d, T, U32.to_nat(i), U32.and(x, U32.not(M.shl_by(1, U32.and(k, 31)))))) : Array<U32>}
  FD.array__set(U32, d, T, i, U32.and(x, U32.not(M.shl_by(1, U32.and(k, 31)))), x, hd, hq, hx, pf)

# a word is 32 times its value shifted right by five, plus its low five bits
law split32:
  for +x: U32
  {U32.to_nat(x) == Nat.add(Nat.mul(U32.to_nat(U32.shrn(x, 5n)), 32n), U32.to_nat(U32.and(x, 31))) : Nat}
def split32(x):
  match x:
    case U32{WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, +r}}}}}}:
      %Equal.sym(Word(27n), Word.and(27n, r, Word.zero(27n)), Word.zero(27n), BF.and_zero(27n, r)) :
        {U32.to_nat(U32{WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, r}}}}}}) == Nat.add(Nat.mul(U32.to_nat(U32.shrn(U32{WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, r}}}}}}, 5n)), 32n), U32.to_nat(U32{WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, _}}}}}})) : Nat}
      %Equal.sym(Nat, U32.to_nat(U32.shrn(U32{WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, r}}}}}}, 5n)), Word.to_nat(27n, r), BV.sh5(False{}, False{}, False{}, False{}, False{}, r)) :
        {U32.to_nat(U32{WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, r}}}}}}) == Nat.add(Nat.mul(_, 32n), 0n) : Nat}
      %Equal.sym(Nat, Nat.mul(Word.to_nat(27n, r), 32n), Nat.double(Nat.double(Nat.double(Nat.double(Nat.double(Word.to_nat(27n, r)))))), VG.mul32(Word.to_nat(27n, r))) : {U32.to_nat(U32{WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, r}}}}}}) == Nat.add(_, 0n) : Nat}
      %Equal.sym(Nat, Nat.add(Nat.double(Nat.double(Nat.double(Nat.double(Nat.double(Word.to_nat(27n, r)))))), 0n), Nat.add(0n, Nat.double(Nat.double(Nat.double(Nat.double(Nat.double(Word.to_nat(27n, r))))))), FD.nat__add_comm(Nat.double(Nat.double(Nat.double(Nat.double(Nat.double(Word.to_nat(27n, r)))))), 0n)) : {U32.to_nat(U32{WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, r}}}}}}) == _ : Nat}
      {==}
    case U32{WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, +r}}}}}}:
      %Equal.sym(Word(27n), Word.and(27n, r, Word.zero(27n)), Word.zero(27n), BF.and_zero(27n, r)) :
        {U32.to_nat(U32{WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, r}}}}}}) == Nat.add(Nat.mul(U32.to_nat(U32.shrn(U32{WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, r}}}}}}, 5n)), 32n), U32.to_nat(U32{WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, _}}}}}})) : Nat}
      %Equal.sym(Nat, U32.to_nat(U32.shrn(U32{WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, r}}}}}}, 5n)), Word.to_nat(27n, r), BV.sh5(True{}, False{}, False{}, False{}, False{}, r)) :
        {U32.to_nat(U32{WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, r}}}}}}) == Nat.add(Nat.mul(_, 32n), 1n) : Nat}
      %Equal.sym(Nat, Nat.mul(Word.to_nat(27n, r), 32n), Nat.double(Nat.double(Nat.double(Nat.double(Nat.double(Word.to_nat(27n, r)))))), VG.mul32(Word.to_nat(27n, r))) : {U32.to_nat(U32{WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, r}}}}}}) == Nat.add(_, 1n) : Nat}
      %Equal.sym(Nat, Nat.add(Nat.double(Nat.double(Nat.double(Nat.double(Nat.double(Word.to_nat(27n, r)))))), 1n), Nat.add(1n, Nat.double(Nat.double(Nat.double(Nat.double(Nat.double(Word.to_nat(27n, r))))))), FD.nat__add_comm(Nat.double(Nat.double(Nat.double(Nat.double(Nat.double(Word.to_nat(27n, r)))))), 1n)) : {U32.to_nat(U32{WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, r}}}}}}) == _ : Nat}
      {==}
    case U32{WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, +r}}}}}}:
      %Equal.sym(Word(27n), Word.and(27n, r, Word.zero(27n)), Word.zero(27n), BF.and_zero(27n, r)) :
        {U32.to_nat(U32{WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, r}}}}}}) == Nat.add(Nat.mul(U32.to_nat(U32.shrn(U32{WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, r}}}}}}, 5n)), 32n), U32.to_nat(U32{WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, _}}}}}})) : Nat}
      %Equal.sym(Nat, U32.to_nat(U32.shrn(U32{WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, r}}}}}}, 5n)), Word.to_nat(27n, r), BV.sh5(False{}, True{}, False{}, False{}, False{}, r)) :
        {U32.to_nat(U32{WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, r}}}}}}) == Nat.add(Nat.mul(_, 32n), 2n) : Nat}
      %Equal.sym(Nat, Nat.mul(Word.to_nat(27n, r), 32n), Nat.double(Nat.double(Nat.double(Nat.double(Nat.double(Word.to_nat(27n, r)))))), VG.mul32(Word.to_nat(27n, r))) : {U32.to_nat(U32{WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, r}}}}}}) == Nat.add(_, 2n) : Nat}
      %Equal.sym(Nat, Nat.add(Nat.double(Nat.double(Nat.double(Nat.double(Nat.double(Word.to_nat(27n, r)))))), 2n), Nat.add(2n, Nat.double(Nat.double(Nat.double(Nat.double(Nat.double(Word.to_nat(27n, r))))))), FD.nat__add_comm(Nat.double(Nat.double(Nat.double(Nat.double(Nat.double(Word.to_nat(27n, r)))))), 2n)) : {U32.to_nat(U32{WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, r}}}}}}) == _ : Nat}
      {==}
    case U32{WCon{True{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, +r}}}}}}:
      %Equal.sym(Word(27n), Word.and(27n, r, Word.zero(27n)), Word.zero(27n), BF.and_zero(27n, r)) :
        {U32.to_nat(U32{WCon{True{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, r}}}}}}) == Nat.add(Nat.mul(U32.to_nat(U32.shrn(U32{WCon{True{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, r}}}}}}, 5n)), 32n), U32.to_nat(U32{WCon{True{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, _}}}}}})) : Nat}
      %Equal.sym(Nat, U32.to_nat(U32.shrn(U32{WCon{True{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, r}}}}}}, 5n)), Word.to_nat(27n, r), BV.sh5(True{}, True{}, False{}, False{}, False{}, r)) :
        {U32.to_nat(U32{WCon{True{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, r}}}}}}) == Nat.add(Nat.mul(_, 32n), 3n) : Nat}
      %Equal.sym(Nat, Nat.mul(Word.to_nat(27n, r), 32n), Nat.double(Nat.double(Nat.double(Nat.double(Nat.double(Word.to_nat(27n, r)))))), VG.mul32(Word.to_nat(27n, r))) : {U32.to_nat(U32{WCon{True{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, r}}}}}}) == Nat.add(_, 3n) : Nat}
      %Equal.sym(Nat, Nat.add(Nat.double(Nat.double(Nat.double(Nat.double(Nat.double(Word.to_nat(27n, r)))))), 3n), Nat.add(3n, Nat.double(Nat.double(Nat.double(Nat.double(Nat.double(Word.to_nat(27n, r))))))), FD.nat__add_comm(Nat.double(Nat.double(Nat.double(Nat.double(Nat.double(Word.to_nat(27n, r)))))), 3n)) : {U32.to_nat(U32{WCon{True{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, r}}}}}}) == _ : Nat}
      {==}
    case U32{WCon{False{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, +r}}}}}}:
      %Equal.sym(Word(27n), Word.and(27n, r, Word.zero(27n)), Word.zero(27n), BF.and_zero(27n, r)) :
        {U32.to_nat(U32{WCon{False{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, r}}}}}}) == Nat.add(Nat.mul(U32.to_nat(U32.shrn(U32{WCon{False{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, r}}}}}}, 5n)), 32n), U32.to_nat(U32{WCon{False{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, _}}}}}})) : Nat}
