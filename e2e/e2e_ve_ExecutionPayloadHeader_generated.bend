# the encoder's size for a byte list of N <= 32 bytes
def esfs(+N: U32) -> {U32.add(584, N) == EN.SFS(N) : U32}: {==}

def sb(+N: U32, +hN: {Nat.is_le(U32.to_nat(N), 32n) == True{} : Bool}) -> {Nat.is_le(U32.to_nat(EN.SFS(N)), 616n) == True{} : Bool}:
  +hi = hN
  +hs = FD.nat__le_trans(Nat.add(584n, U32.to_nat(N)), Nat.add(584n, 32n), O.pow2n(10n), Order.add_left(584n, U32.to_nat(N), 32n, hi), {==})
  %esfs(N) : {Nat.is_le(U32.to_nat(_), 616n) == True{} : Bool}
  %Equal.sym(Nat, U32.to_nat(U32.add(584, N)), Nat.add(U32.to_nat(584), U32.to_nat(N)), VD.s_add_nat(584, N, 10n, {==}, hs)) : {Nat.is_le(_, 616n) == True{} : Bool}
  Order.add_left(584n, U32.to_nat(N), 32n, hi)

