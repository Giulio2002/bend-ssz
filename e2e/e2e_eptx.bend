  +ok = FD.logic__subst(Nat, z => {Bool.and(Nat.is_lt(z, 31n), Bool.and(FD.array__perfect(FuluWithdrawal_d.Withdrawal, z, a), Bool.and(Nat.is_le(U32.to_nat(N), VB.pw(z)), U32.is_le(N, 16)))) == True{} : Bool}, dw, EWL.TDM_l16_Withdrawal(a), Equal.sym(Nat, EWL.TDM_l16_Withdrawal(a), dw, tdW(dw, a, pf)), okd)
