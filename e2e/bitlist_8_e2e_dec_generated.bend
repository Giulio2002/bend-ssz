# ---- the loaded buffer ----

# the words the loader fills, at the buffer's depth
def TT(+bs: +List<U32>, +n: U32) -> FD.array__Tree<U32>: AC.segt(B.capacity(n), 0n, L.wlp(bs))

def ld(+bs: +List<U32>, +n: U32, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +hd: {SP.bytes_domain(bs) == True{} : Bool}, +hS: {U32.is_le(n, VB.NMAX()) == True{} : Bool}) -> {B.fill_at(B.alloc(n), 0, bs) == DC.BF(TT(bs, n), n) : B.Buf}:
  L.bf(bs, n, B.capacity(n), hd, {==}, C.capM_32(n, hS), C.capM_w(bs, n, hn, hS))

def vwe(+bs: +List<U32>, +n: U32, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +hd: {SP.bytes_domain(bs) == True{} : Bool}, +hS: {U32.is_le(n, VB.NMAX()) == True{} : Bool}) -> {DC.VW(TT(bs, n), n) == bs : +List<U32>}:
  L.vw(bs, n, B.capacity(n), hd, hn, C.capM_w(bs, n, hn, hS))

def pfe(+bs: +List<U32>, +n: U32) -> {FD.array__perfect(U32, B.capacity(n), TT(bs, n)) == True{} : Bool}: L.seg_pf(B.capacity(n), L.wlp(bs))

# ---- the two sides on an accepted and a rejected buffer ----

def d_acc(+bs: +List<U32>, +n: U32, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +hd: {SP.bytes_domain(bs) == True{} : Bool}, +hS: {U32.is_le(n, VB.NMAX()) == True{} : Bool}, +hchk: {DC.CHK(TT(bs, n), n) == True{} : Bool}) -> {Pair.snd(B.Buf, Maybe<&1, O.Bits>, bitlist_8_r.bitlist_8_decode(B.fill_at(B.alloc(n), 0, bs), n)) == Some{DC.OBJ(TT(bs, n), n)} : Maybe<&1, O.Bits>}:
  %Equal.sym(B.Buf, B.fill_at(B.alloc(n), 0, bs), DC.BF(TT(bs, n), n), ld(bs, n, hn, hd, hS)) : {Pair.snd(B.Buf, Maybe<&1, O.Bits>, bitlist_8_r.bitlist_8_decode(_, n)) == Some{DC.OBJ(TT(bs, n), n)} : Maybe<&1, O.Bits>}
  Equal.cong(B.Buf & Maybe<&1, O.Bits>, Maybe<&1, O.Bits>, q => Pair.snd(B.Buf, Maybe<&1, O.Bits>, q), bitlist_8_r.bitlist_8_decode(DC.BF(TT(bs, n), n), n), (DC.BF(TT(bs, n), n), Some{DC.OBJ(TT(bs, n), n)}),
    DC.decode_accept(B.capacity(n), TT(bs, n), n, pfe(bs, n), FD.nat__le_lt_trans(B.capacity(n), 30n, 31n, C.capM_le(n, hS), {==}), C.capM_q(n, hS), hchk))

def d_none(+bs: +List<U32>, +n: U32, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +hd: {SP.bytes_domain(bs) == True{} : Bool}, +hS: {U32.is_le(n, VB.NMAX()) == True{} : Bool}, +hchk: {DC.CHK(TT(bs, n), n) == False{} : Bool}) -> {Pair.snd(B.Buf, Maybe<&1, O.Bits>, bitlist_8_r.bitlist_8_decode(B.fill_at(B.alloc(n), 0, bs), n)) == None{} : Maybe<&1, O.Bits>}:
  %Equal.sym(B.Buf, B.fill_at(B.alloc(n), 0, bs), DC.BF(TT(bs, n), n), ld(bs, n, hn, hd, hS)) : {Pair.snd(B.Buf, Maybe<&1, O.Bits>, bitlist_8_r.bitlist_8_decode(_, n)) == None{} : Maybe<&1, O.Bits>}
  Equal.cong(B.Buf & Maybe<&1, O.Bits>, Maybe<&1, O.Bits>, q => Pair.snd(B.Buf, Maybe<&1, O.Bits>, q), bitlist_8_r.bitlist_8_decode(DC.BF(TT(bs, n), n), n), (DC.BF(TT(bs, n), n), None{}),
    DC.decode_none(B.capacity(n), TT(bs, n), n, pfe(bs, n), FD.nat__le_lt_trans(B.capacity(n), 30n, 31n, C.capM_le(n, hS), {==}), C.capM_q(n, hS), hchk))

def s_dec(+bs: +List<U32>, +n: U32, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +hd: {SP.bytes_domain(bs) == True{} : Bool}, +hS: {U32.is_le(n, VB.NMAX()) == True{} : Bool}, +hchk: {DC.CHK(TT(bs, n), n) == True{} : Bool}) -> Decoding.decodes(GS.bitlist_8(), bs, DC.VAL(TT(bs, n), n)):
  %vwe(bs, n, hn, hd, hS) : Decoding.decodes(GS.bitlist_8(), _, DC.VAL(TT(bs, n), n))
  DC.decode_spec(B.capacity(n), TT(bs, n), n, pfe(bs, n), FD.nat__le_lt_trans(B.capacity(n), 30n, 31n, C.capM_le(n, hS), {==}), C.capM_q(n, hS), hchk)

def s_out(+bs: +List<U32>, +n: U32, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +hd: {SP.bytes_domain(bs) == True{} : Bool}, +hS: {U32.is_le(n, VB.NMAX()) == True{} : Bool}, +hchk: {DC.CHK(TT(bs, n), n) == False{} : Bool}) -> Decoding.outside_image(GS.bitlist_8(), bs):
  %vwe(bs, n, hn, hd, hS) : Decoding.outside_image(GS.bitlist_8(), _)
  DR.decode_reject(B.capacity(n), TT(bs, n), n, pfe(bs, n), FD.nat__le_lt_trans(B.capacity(n), 30n, 31n, C.capM_le(n, hS), {==}), C.capM_q(n, hS), hchk)

def a_acc(+bs: +List<U32>, +n: U32, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +hd: {SP.bytes_domain(bs) == True{} : Bool}, +hS: {U32.is_le(n, VB.NMAX()) == True{} : Bool}, +hchk: {DC.CHK(TT(bs, n), n) == True{} : Bool}) -> {API.deserialize(GS.bitlist_8(), bs) == Some{DC.VAL(TT(bs, n), n)} : Maybe<&2, S.Value>}:
  E2E.spec_accepted(GS.bitlist_8(), bs, DC.VAL(TT(bs, n), n), (TVS.public_sound(GS.bitlist_8(), {==}), s_dec(bs, n, hn, hd, hS, hchk)))

def a_none(+bs: +List<U32>, +n: U32, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +hd: {SP.bytes_domain(bs) == True{} : Bool}, +hS: {U32.is_le(n, VB.NMAX()) == True{} : Bool}, +hchk: {DC.CHK(TT(bs, n), n) == False{} : Bool}) -> {API.deserialize(GS.bitlist_8(), bs) == None{} : Maybe<&2, S.Value>}:
  E.outside_none(GS.bitlist_8(), bs, s_out(bs, n, hn, hd, hS, hchk))

# ---- (ii) on views, (iii) ----

def mv(m: Maybe<&1, O.Bits>) -> Maybe<&2, S.Value>:
  match m:
    case None{}: None{}
    case Some{o}: Some{bvw(o)}

def d_v(+bs: +List<U32>, +n: U32, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +hd: {SP.bytes_domain(bs) == True{} : Bool}, +hS: {U32.is_le(n, VB.NMAX()) == True{} : Bool}, +c: Bool, +ec: {DC.CHK(TT(bs, n), n) == c : Bool}) -> {mv(Pair.snd(B.Buf, Maybe<&1, O.Bits>, bitlist_8_r.bitlist_8_decode(B.fill_at(B.alloc(n), 0, bs), n))) == API.deserialize(GS.bitlist_8(), bs) : Maybe<&2, S.Value>}:
  match c:
    case False{}:
      %Equal.sym(Maybe<&1, O.Bits>, Pair.snd(B.Buf, Maybe<&1, O.Bits>, bitlist_8_r.bitlist_8_decode(B.fill_at(B.alloc(n), 0, bs), n)), None{}, d_none(bs, n, hn, hd, hS, ec)) : {mv(_) == API.deserialize(GS.bitlist_8(), bs) : Maybe<&2, S.Value>}
      %Equal.sym(Maybe<&2, S.Value>, API.deserialize(GS.bitlist_8(), bs), None{}, a_none(bs, n, hn, hd, hS, ec)) : {mv(None{}) == _ : Maybe<&2, S.Value>}
      {==}
    case True{}:
      %Equal.sym(Maybe<&1, O.Bits>, Pair.snd(B.Buf, Maybe<&1, O.Bits>, bitlist_8_r.bitlist_8_decode(B.fill_at(B.alloc(n), 0, bs), n)), Some{DC.OBJ(TT(bs, n), n)}, d_acc(bs, n, hn, hd, hS, ec)) : {mv(_) == API.deserialize(GS.bitlist_8(), bs) : Maybe<&2, S.Value>}
      %Equal.sym(Maybe<&2, S.Value>, API.deserialize(GS.bitlist_8(), bs), Some{DC.VAL(TT(bs, n), n)}, a_acc(bs, n, hn, hd, hS, ec)) : {mv(Some{DC.OBJ(TT(bs, n), n)}) == _ : Maybe<&2, S.Value>}
      Equal.cong(S.Value, Maybe<&2, S.Value>, z => Some{z}, bvw(DC.OBJ(TT(bs, n), n)), DC.VAL(TT(bs, n), n), vv(B.capacity(n), TT(bs, n), n, pfe(bs, n), FD.nat__le_lt_trans(B.capacity(n), 30n, 31n, C.capM_le(n, hS), {==}), C.capM_q(n, hS), ec))

def d_ra(+bs: +List<U32>, +n: U32, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +hd: {SP.bytes_domain(bs) == True{} : Bool}, +hS: {U32.is_le(n, VB.NMAX()) == True{} : Bool}, +c: Bool, +ec: {DC.CHK(TT(bs, n), n) == c : Bool}, +dn: {Pair.snd(B.Buf, Maybe<&1, O.Bits>, bitlist_8_r.bitlist_8_decode(B.fill_at(B.alloc(n), 0, bs), n)) == None{} : Maybe<&1, O.Bits>}) -> {API.deserialize(GS.bitlist_8(), bs) == None{} : Maybe<&2, S.Value>}:
  match c:
    case False{}: a_none(bs, n, hn, hd, hS, ec)
    case True{}: Empty.absurd({API.deserialize(GS.bitlist_8(), bs) == None{} : Maybe<&2, S.Value>}, E.none_someT(O.Bits, DC.OBJ(TT(bs, n), n), Equal.trans(Maybe<&1, O.Bits>, None{}, Pair.snd(B.Buf, Maybe<&1, O.Bits>, bitlist_8_r.bitlist_8_decode(B.fill_at(B.alloc(n), 0, bs), n)), Some{DC.OBJ(TT(bs, n), n)}, Equal.sym(Maybe<&1, O.Bits>, Pair.snd(B.Buf, Maybe<&1, O.Bits>, bitlist_8_r.bitlist_8_decode(B.fill_at(B.alloc(n), 0, bs), n)), None{}, dn), d_acc(bs, n, hn, hd, hS, ec))))

def d_rb(+bs: +List<U32>, +n: U32, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +hd: {SP.bytes_domain(bs) == True{} : Bool}, +hS: {U32.is_le(n, VB.NMAX()) == True{} : Bool}, +c: Bool, +ec: {DC.CHK(TT(bs, n), n) == c : Bool}, +an: {API.deserialize(GS.bitlist_8(), bs) == None{} : Maybe<&2, S.Value>}) -> {Pair.snd(B.Buf, Maybe<&1, O.Bits>, bitlist_8_r.bitlist_8_decode(B.fill_at(B.alloc(n), 0, bs), n)) == None{} : Maybe<&1, O.Bits>}:
  match c:
    case False{}: d_none(bs, n, hn, hd, hS, ec)
    case True{}: Empty.absurd({Pair.snd(B.Buf, Maybe<&1, O.Bits>, bitlist_8_r.bitlist_8_decode(B.fill_at(B.alloc(n), 0, bs), n)) == None{} : Maybe<&1, O.Bits>}, FD.logic__none_some(S.Value, DC.VAL(TT(bs, n), n), Equal.trans(Maybe<&2, S.Value>, None{}, API.deserialize(GS.bitlist_8(), bs), Some{DC.VAL(TT(bs, n), n)}, Equal.sym(Maybe<&2, S.Value>, API.deserialize(GS.bitlist_8(), bs), None{}, an), a_acc(bs, n, hn, hd, hS, ec))))

# (ii), on views: the view of the object the decoder returns is END_TO_END's deserialize.
def bitlist_8_e2e_decode_view(+bs: +List<U32>, +n: U32, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +hd: {SP.bytes_domain(bs) == True{} : Bool}, +hS: {U32.is_le(n, VB.NMAX()) == True{} : Bool}) -> {mv(Pair.snd(B.Buf, Maybe<&1, O.Bits>, bitlist_8_r.bitlist_8_decode(B.fill_at(B.alloc(n), 0, bs), n))) == API.deserialize(GS.bitlist_8(), bs) : Maybe<&2, S.Value>}:
  d_v(bs, n, hn, hd, hS, DC.CHK(TT(bs, n), n), {==})

# (iii) the object decoder fails exactly when END_TO_END's deserialize does.
def bitlist_8_e2e_decode_reject(+bs: +List<U32>, +n: U32, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +hd: {SP.bytes_domain(bs) == True{} : Bool}, +hS: {U32.is_le(n, VB.NMAX()) == True{} : Bool})
    -> ({Pair.snd(B.Buf, Maybe<&1, O.Bits>, bitlist_8_r.bitlist_8_decode(B.fill_at(B.alloc(n), 0, bs), n)) == None{} : Maybe<&1, O.Bits>} -> {API.deserialize(GS.bitlist_8(), bs) == None{} : Maybe<&2, S.Value>}) & ({API.deserialize(GS.bitlist_8(), bs) == None{} : Maybe<&2, S.Value>} -> {Pair.snd(B.Buf, Maybe<&1, O.Bits>, bitlist_8_r.bitlist_8_decode(B.fill_at(B.alloc(n), 0, bs), n)) == None{} : Maybe<&1, O.Bits>}):
  (dn => d_ra(bs, n, hn, hd, hS, DC.CHK(TT(bs, n), n), {==}, dn), an => d_rb(bs, n, hn, hd, hS, DC.CHK(TT(bs, n), n), {==}, an))
