  +hs = FD.nat__le_trans(Nat.add(244n, U32.to_nat(YE.SFS(N))), Nat.add(244n, 616n), O.pow2n(10n), Order.add_left(244n, U32.to_nat(YE.SFS(N)), 616n, hi), {==})
  %esfs(N) : {Nat.is_le(U32.to_nat(_), 860n) == True{} : Bool}
  %Equal.sym(Nat, U32.to_nat(U32.add(244, YE.SFS(N))), Nat.add(U32.to_nat(244), U32.to_nat(YE.SFS(N))), VD.s_add_nat(244, YE.SFS(N), 10n, {==}, hs)) : {Nat.is_le(_, 860n) == True{} : Bool}
  Order.add_left(244n, U32.to_nat(YE.SFS(N)), 616n, hi)

