def FuluPowBlock_d_rb(+bs: +List<U32>, +n: U32, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +hd: {SP.bytes_domain(bs) == True{} : Bool}, +c: Bool, +ec: {Nat.is_eq(List.length(&2, U32, bs), 96n) == c : Bool}, +an: {API.deserialize(Spec.PowBlock(), bs) == None{} : Maybe<&2, S.Value>}) -> {Pair.snd(B.Buf, Maybe<&1, T.PowBlock>, T.PowBlock_decode(B.fill_at(B.alloc(n), 0, bs), n)) == None{} : Maybe<&1, T.PowBlock>}:
  match c:
    case False{}: FuluPowBlock_d_none(bs, n, hn, ec)
    case True{}: Empty.absurd({Pair.snd(B.Buf, Maybe<&1, T.PowBlock>, T.PowBlock_decode(B.fill_at(B.alloc(n), 0, bs), n)) == None{} : Maybe<&1, T.PowBlock>}, FD.logic__none_some(S.Value, M3.v_PowBlock(T.PowBlock{T.Bytes32{E.wn(0n, bs), E.wn(1n, bs), E.wn(2n, bs), E.wn(3n, bs), E.wn(4n, bs), E.wn(5n, bs), E.wn(6n, bs), E.wn(7n, bs)}, T.Bytes32{E.wn(8n, bs), E.wn(9n, bs), E.wn(10n, bs), E.wn(11n, bs), E.wn(12n, bs), E.wn(13n, bs), E.wn(14n, bs), E.wn(15n, bs)}, T.Uint256{E.wn(16n, bs), E.wn(17n, bs), E.wn(18n, bs), E.wn(19n, bs), E.wn(20n, bs), E.wn(21n, bs), E.wn(22n, bs), E.wn(23n, bs)}}), Equal.trans(Maybe<&2, S.Value>, None{}, API.deserialize(Spec.PowBlock(), bs), Some{M3.v_PowBlock(T.PowBlock{T.Bytes32{E.wn(0n, bs), E.wn(1n, bs), E.wn(2n, bs), E.wn(3n, bs), E.wn(4n, bs), E.wn(5n, bs), E.wn(6n, bs), E.wn(7n, bs)}, T.Bytes32{E.wn(8n, bs), E.wn(9n, bs), E.wn(10n, bs), E.wn(11n, bs), E.wn(12n, bs), E.wn(13n, bs), E.wn(14n, bs), E.wn(15n, bs)}, T.Uint256{E.wn(16n, bs), E.wn(17n, bs), E.wn(18n, bs), E.wn(19n, bs), E.wn(20n, bs), E.wn(21n, bs), E.wn(22n, bs), E.wn(23n, bs)}})}, Equal.sym(Maybe<&2, S.Value>, API.deserialize(Spec.PowBlock(), bs), None{}, an), FuluPowBlock_d_asome(bs, hd, ec))))

# (ii) the object decoder returns o exactly when END_TO_END's deserialize returns VAL(o).
def FuluPowBlock_e2e_decode_accept(+bs: +List<U32>, +n: U32, +o: T.PowBlock, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +hd: {SP.bytes_domain(bs) == True{} : Bool})
    -> ({Pair.snd(B.Buf, Maybe<&1, T.PowBlock>, T.PowBlock_decode(B.fill_at(B.alloc(n), 0, bs), n)) == Some{o} : Maybe<&1, T.PowBlock>} -> {API.deserialize(Spec.PowBlock(), bs) == Some{M3.v_PowBlock(o)} : Maybe<&2, S.Value>}) & ({API.deserialize(Spec.PowBlock(), bs) == Some{M3.v_PowBlock(o)} : Maybe<&2, S.Value>} -> {Pair.snd(B.Buf, Maybe<&1, T.PowBlock>, T.PowBlock_decode(B.fill_at(B.alloc(n), 0, bs), n)) == Some{o} : Maybe<&1, T.PowBlock>}):
  (da => FuluPowBlock_d_ia(bs, n, o, hn, hd, Nat.is_eq(List.length(&2, U32, bs), 96n), {==}, da), aa => FuluPowBlock_d_ib(bs, n, o, hn, Nat.is_eq(List.length(&2, U32, bs), 96n), {==}, aa))

# (iii) the object decoder fails exactly when END_TO_END's deserialize does.
def FuluPowBlock_e2e_decode_reject(+bs: +List<U32>, +n: U32, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +hd: {SP.bytes_domain(bs) == True{} : Bool})
    -> ({Pair.snd(B.Buf, Maybe<&1, T.PowBlock>, T.PowBlock_decode(B.fill_at(B.alloc(n), 0, bs), n)) == None{} : Maybe<&1, T.PowBlock>} -> {API.deserialize(Spec.PowBlock(), bs) == None{} : Maybe<&2, S.Value>}) & ({API.deserialize(Spec.PowBlock(), bs) == None{} : Maybe<&2, S.Value>} -> {Pair.snd(B.Buf, Maybe<&1, T.PowBlock>, T.PowBlock_decode(B.fill_at(B.alloc(n), 0, bs), n)) == None{} : Maybe<&1, T.PowBlock>}):
  (dn => FuluPowBlock_d_ra(bs, n, hn, hd, Nat.is_eq(List.length(&2, U32, bs), 96n), {==}, dn), an => FuluPowBlock_d_rb(bs, n, hn, hd, Nat.is_eq(List.length(&2, U32, bs), 96n), {==}, an))

