  +h4 = FD.logic__subst(Nat, z => {Nat.is_le(Nat.add(237n, P), z) == True{} : Bool}, Nat.add(P, P), VB.pw(18n), VG.two_pw(P), Order.add_right(237n, P, P, h237))
