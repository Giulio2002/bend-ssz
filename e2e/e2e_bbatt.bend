    VG.pw_mono(18n, 30n, {==}))

# ---- the element conversion: root_types' mirror record to the encoder's record ----
def cvE(m: RT.MB<RT.M_Attestation>) -> W8.MB<EM.MW>:
  match m:
    case RT.MNone{}: W8.MNone{}
    case RT.MSome{+v}:
      match v:
        case RT.M_Attestation{+a0, +a1, +a2, +a3}:
          match a0:
            case RT.BMr{+tb, +k}: W8.MSome{EM.MW{EXb.MB{ER.LDEP(U32, tb), tb, k, U32.to_nat(131072), 18n, 18n}, a1, a2, a3}}

