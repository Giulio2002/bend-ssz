    case RT.MNone{}: {==}
    case RT.MSome{+v}:
      match v:
        case RT.M_Attestation{+a0, +a1, +a2, +a3}:
          match a0:
            case RT.BMr{+tb, +k}: {==}

def CV(t: FD.array__Tree<RT.MB<RT.M_Attestation>>) -> FD.array__Tree<W8.MB<EM.MW>>:
  match t:
    case FD.TLeaf{+x}: FD.TLeaf{cvE(x)}
    case FD.TNode{l, r}: FD.TNode{CV(l), CV(r)}

def LM(W: List<&2, RT.MB<RT.M_Attestation>>) -> List<&2, W8.MB<EM.MW>>:
  match W:
    case Nil{}: Nil{}
    case Con{+x, t}: Con{cvE(x), LM(t)}

def amcv(+t: FD.array__Tree<RT.MB<RT.M_Attestation>>) -> {W8.am_l8_Attestation(CV(t)) == RT.am_l8_Attestation(t) : Array<O.Boxed<FuluAttestation_d.Attestation>>}:
  match t:
    case FD.TLeaf{+x}: Equal.cong(O.Boxed<FuluAttestation_d.Attestation>, Array<O.Boxed<FuluAttestation_d.Attestation>>, z => ALeaf{z}, W8.th_Attestation_bx(cvE(x)), RT.th_Attestation_bx(x), thcv(x))
    case FD.TNode{+l, +r}:
      %Equal.sym(Array<O.Boxed<FuluAttestation_d.Attestation>>, W8.am_l8_Attestation(CV(l)), RT.am_l8_Attestation(l), amcv(l)) : {ANode{_, W8.am_l8_Attestation(CV(r))} == ANode{RT.am_l8_Attestation(l), RT.am_l8_Attestation(r)} : Array<O.Boxed<FuluAttestation_d.Attestation>>}
      %Equal.sym(Array<O.Boxed<FuluAttestation_d.Attestation>>, W8.am_l8_Attestation(CV(r)), RT.am_l8_Attestation(r), amcv(r)) : {ANode{RT.am_l8_Attestation(l), _} == ANode{RT.am_l8_Attestation(l), RT.am_l8_Attestation(r)} : Array<O.Boxed<FuluAttestation_d.Attestation>>}
      {==}

def pfcv(+d: Nat, +t: FD.array__Tree<RT.MB<RT.M_Attestation>>, +pf: {FD.array__perfect(RT.MB<RT.M_Attestation>, d, t) == True{} : Bool}) -> {FD.array__perfect(W8.MB<EM.MW>, d, CV(t)) == True{} : Bool}:
  match d t:
    case 0n FD.TLeaf{+x}: {==}
    case 0n FD.TNode{+l, +r}: Empty.absurd({FD.array__perfect(W8.MB<EM.MW>, 0n, CV(FD.TNode{l, r})) == True{} : Bool}, FD.logic__false_true(pf))
    case 1n+ +p FD.TLeaf{+x}: Empty.absurd({FD.array__perfect(W8.MB<EM.MW>, 1n+p, CV(FD.TLeaf{x})) == True{} : Bool}, FD.logic__false_true(pf))
    case 1n+ +p FD.TNode{+l, +r}:
      FD.logic__and_intro(FD.array__perfect(W8.MB<EM.MW>, p, CV(l)), FD.array__perfect(W8.MB<EM.MW>, p, CV(r)),
        pfcv(p, l, FD.array__pf_left(RT.MB<RT.M_Attestation>, p, l, r, pf)), pfcv(p, r, FD.array__pf_right(RT.MB<RT.M_Attestation>, p, l, r, pf)))

def tdmE(+d: Nat, +t: FD.array__Tree<W8.MB<EM.MW>>, +pf: {FD.array__perfect(W8.MB<EM.MW>, d, t) == True{} : Bool}) -> {W8.TDM(t) == d : Nat}:
  match d t:
    case 0n FD.TLeaf{+x}: {==}
    case 0n FD.TNode{+l, +r}: Empty.absurd({W8.TDM(FD.TNode{l, r}) == 0n : Nat}, FD.logic__false_true(pf))
    case 1n+ +p FD.TLeaf{+x}: Empty.absurd({W8.TDM(FD.TLeaf{x}) == 1n+p : Nat}, FD.logic__false_true(pf))
    case 1n+ +p FD.TNode{+l, +r}: Equal.cong(Nat, Nat, z => 1n+z, W8.TDM(l), p, tdmE(p, l, FD.array__pf_left(W8.MB<EM.MW>, p, l, r, pf)))

def lmapp(+X: List<&2, RT.MB<RT.M_Attestation>>, +Y: List<&2, RT.MB<RT.M_Attestation>>) -> {LM(FD.spec_common__append(RT.MB<RT.M_Attestation>, X, Y)) == FD.spec_common__append(W8.MB<EM.MW>, LM(X), LM(Y)) : List<&2, W8.MB<EM.MW>>}:
  match X:
    case Nil{}: {==}
    case Con{+x, +t}: Equal.cong(List<&2, W8.MB<EM.MW>>, List<&2, W8.MB<EM.MW>>, z => Con{cvE(x), z}, LM(FD.spec_common__append(RT.MB<RT.M_Attestation>, t, Y)), FD.spec_common__append(W8.MB<EM.MW>, LM(t), LM(Y)), lmapp(t, Y))

def slcv(+t: FD.array__Tree<RT.MB<RT.M_Attestation>>) -> {FD.array__slots(W8.MB<EM.MW>, CV(t)) == LM(FD.array__slots(RT.MB<RT.M_Attestation>, t)) : List<&2, W8.MB<EM.MW>>}:
  match t:
    case FD.TLeaf{+x}: {==}
    case FD.TNode{+l, +r}:
      %Equal.sym(List<&2, W8.MB<EM.MW>>, LM(FD.spec_common__append(RT.MB<RT.M_Attestation>, FD.array__slots(RT.MB<RT.M_Attestation>, l), FD.array__slots(RT.MB<RT.M_Attestation>, r))), FD.spec_common__append(W8.MB<EM.MW>, LM(FD.array__slots(RT.MB<RT.M_Attestation>, l)), LM(FD.array__slots(RT.MB<RT.M_Attestation>, r))),
          lmapp(FD.array__slots(RT.MB<RT.M_Attestation>, l), FD.array__slots(RT.MB<RT.M_Attestation>, r))) :
        {FD.spec_common__append(W8.MB<EM.MW>, FD.array__slots(W8.MB<EM.MW>, CV(l)), FD.array__slots(W8.MB<EM.MW>, CV(r))) == _ : List<&2, W8.MB<EM.MW>>}
      %Equal.sym(List<&2, W8.MB<EM.MW>>, FD.array__slots(W8.MB<EM.MW>, CV(l)), LM(FD.array__slots(RT.MB<RT.M_Attestation>, l)), slcv(l)) :
        {FD.spec_common__append(W8.MB<EM.MW>, _, FD.array__slots(W8.MB<EM.MW>, CV(r))) == FD.spec_common__append(W8.MB<EM.MW>, LM(FD.array__slots(RT.MB<RT.M_Attestation>, l)), LM(FD.array__slots(RT.MB<RT.M_Attestation>, r))) : List<&2, W8.MB<EM.MW>>}
      %Equal.sym(List<&2, W8.MB<EM.MW>>, FD.array__slots(W8.MB<EM.MW>, CV(r)), LM(FD.array__slots(RT.MB<RT.M_Attestation>, r)), slcv(r)) :
        {FD.spec_common__append(W8.MB<EM.MW>, LM(FD.array__slots(RT.MB<RT.M_Attestation>, l)), _) == FD.spec_common__append(W8.MB<EM.MW>, LM(FD.array__slots(RT.MB<RT.M_Attestation>, l)), LM(FD.array__slots(RT.MB<RT.M_Attestation>, r))) : List<&2, W8.MB<EM.MW>>}
      {==}

def xatlm(+W: List<&2, RT.MB<RT.M_Attestation>>, +i: Nat) -> {W8.xat_l8_Attestation(LM(W), i) == cvE(RT.xat_l8_Attestation(W, i)) : W8.MB<EM.MW>}:
  match W i:
    case Nil{} _: {==}
    case Con{+x, +t} 0n: {==}
    case Con{+x, +t} 1n+ +j: xatlm(t, j)

# ---- one element: its record's validity and its view, from rep and the premise SDE ----
def SDE(m: RT.MB<RT.M_Attestation>) -> Data:
  match m:
    case RT.MNone{}: {True{} == True{} : Bool}
    case RT.MSome{v}:
      match v:
        case RT.M_Attestation{a0, a1, a2, a3}: SDB(RT.th_b(a0), 31n)

def ELF(+m: RT.MB<RT.M_Attestation>) -> Data: DK.P2({W8.EOK(cvE(m)) == True{} : Bool}, {RT.v_Attestation_bx(RT.th_Attestation_bx(m)) == W8.EV(cvE(m)) : S.Value})

def isS(b: O.Boxed<FuluAttestation_d.Attestation>) -> Bool:
  match b:
    case O.BSome{v, rest}: True{}
    case O.BNone{}: False{}

def bta(o: O.Bits) -> FD.array__Tree<U32>:
  match o:
    case O.Bits{a, +k}: FD.array__freeze(U32, a)
def btk(o: O.Bits) -> U32:
  match o:
    case O.Bits{a, +k}: k

def lvAD(+o: FuluAttestationData_d.AttestationData) -> {RN_L.v_AttestationData(o) == EM.LV_AttestationData(o) : S.Value}:
  match o:
    case FuluAttestationData_d.AttestationData{O.U64{+w0, +w1}, O.U64{+w2, +w3}, FuluBytes32_d.Bytes32{+b0, +b1, +b2, +b3, +b4, +b5, +b6, +b7}, FuluCheckpoint_d.Checkpoint{O.U64{+w4, +w5}, FuluBytes32_d.Bytes32{+c0, +c1, +c2, +c3, +c4, +c5, +c6, +c7}}, FuluCheckpoint_d.Checkpoint{O.U64{+w6, +w7}, FuluBytes32_d.Bytes32{+e0, +e1, +e2, +e3, +e4, +e5, +e6, +e7}}}: {==}
def lv96(+o: FuluBytes96_d.Bytes96) -> {RN_L.v_b96(o) == EM.LV_b96(o) : S.Value}:
  match o:
    case FuluBytes96_d.Bytes96{+w0, +w1, +w2, +w3, +w4, +w5, +w6, +w7, +w8, +w9, +w10, +w11, +w12, +w13, +w14, +w15, +w16, +w17, +w18, +w19, +w20, +w21, +w22, +w23}: {==}
def lv64(+o: Fulu_bitvector_64_d.Bitvector64) -> {RN_L.v_bv64(o) == EM.LV_bv64(o) : S.Value}:
  match o:
    case Fulu_bitvector_64_d.Bitvector64{+w0, +w1}: Equal.cong(+List<Bool>, S.Value, z => S.BitsValue{z}, E2B.wcat([w0, w1]), FB.bitsof([w0, w1]), Equal.sym(+List<Bool>, FB.bitsof([w0, w1]), E2B.wcat([w0, w1]), E2B.bw([w0, w1])))

def elv(+tb: FD.array__Tree<U32>, +k: U32, +a1: FuluAttestationData_d.AttestationData, +a2: FuluBytes96_d.Bytes96, +a3: Fulu_bitvector_64_d.Bitvector64)
    -> {RT.v_Attestation(FuluAttestation_d.Attestation{O.Bits{FD.array__thaw(U32, tb), k}, a1, a2, a3}) == EM.VALC(EXb.MB{ER.LDEP(U32, tb), tb, k, U32.to_nat(131072), 18n, 18n}, a1, a2, a3) : S.Value}:
  %Equal.sym(S.Value, S.BitsValue{BO.bview(O.Bits{FD.array__thaw(U32, tb), k})}, EXb.VAL(EXb.MB{ER.LDEP(U32, tb), tb, k, U32.to_nat(131072), 18n, 18n}), bv131072(ER.LDEP(U32, tb), tb, k)) :
    {S.Sequence{S.Items{_, S.Items{RN_L.v_AttestationData(a1), S.Items{RN_L.v_b96(a2), S.Items{RN_L.v_bv64(a3), S.EmptyItems{}}}}}} == EM.VALC(EXb.MB{ER.LDEP(U32, tb), tb, k, U32.to_nat(131072), 18n, 18n}, a1, a2, a3) : S.Value}
  %Equal.sym(S.Value, RN_L.v_AttestationData(a1), EM.LV_AttestationData(a1), lvAD(a1)) :
    {S.Sequence{S.Items{EXb.VAL(EXb.MB{ER.LDEP(U32, tb), tb, k, U32.to_nat(131072), 18n, 18n}), S.Items{_, S.Items{RN_L.v_b96(a2), S.Items{RN_L.v_bv64(a3), S.EmptyItems{}}}}}} == EM.VALC(EXb.MB{ER.LDEP(U32, tb), tb, k, U32.to_nat(131072), 18n, 18n}, a1, a2, a3) : S.Value}
  %Equal.sym(S.Value, RN_L.v_b96(a2), EM.LV_b96(a2), lv96(a2)) :
    {S.Sequence{S.Items{EXb.VAL(EXb.MB{ER.LDEP(U32, tb), tb, k, U32.to_nat(131072), 18n, 18n}), S.Items{EM.LV_AttestationData(a1), S.Items{_, S.Items{RN_L.v_bv64(a3), S.EmptyItems{}}}}}} == EM.VALC(EXb.MB{ER.LDEP(U32, tb), tb, k, U32.to_nat(131072), 18n, 18n}, a1, a2, a3) : S.Value}
  %Equal.sym(S.Value, RN_L.v_bv64(a3), EM.LV_bv64(a3), lv64(a3)) :
    {S.Sequence{S.Items{EXb.VAL(EXb.MB{ER.LDEP(U32, tb), tb, k, U32.to_nat(131072), 18n, 18n}), S.Items{EM.LV_AttestationData(a1), S.Items{EM.LV_b96(a2), S.Items{_, S.EmptyItems{}}}}}} == EM.VALC(EXb.MB{ER.LDEP(U32, tb), tb, k, U32.to_nat(131072), 18n, 18n}, a1, a2, a3) : S.Value}
  {==}

# the element's validity: the bits record's (the premise's storage, moved to the mirror's tree tb and depth LDEP(tb)) and its size
def elo(+tb: FD.array__Tree<U32>, +k: U32, +a1: FuluAttestationData_d.AttestationData, +a2: FuluBytes96_d.Bytes96, +a3: Fulu_bitvector_64_d.Bitvector64,
    +hN: {Nat.is_le(U32.to_nat(k), U32.to_nat(131072)) == True{} : Bool}, +wf: BO.wfb(O.Bits{FD.array__thaw(U32, tb), k}), +sd: SDB(O.Bits{FD.array__thaw(U32, tb), k}, 31n))
    -> {EM.OKT(EXb.MB{ER.LDEP(U32, tb), tb, k, U32.to_nat(131072), 18n, 18n}, a1, a2, a3) == True{} : Bool}:
  (+T, +s1) = sd
  (+dw, +s2) = s1
  (+K, +s3) = s2
  (+eo, +s4) = s3
  (+pf, +s5) = s4
  (+hdw, +s6) = s5
  (+hroom, +hbz) = s6
  +eT = Equal.trans(FD.array__Tree<U32>, tb, FD.array__freeze(U32, FD.array__thaw(U32, tb)), T, Equal.sym(FD.array__Tree<U32>, FD.array__freeze(U32, FD.array__thaw(U32, tb)), tb, FD.array__freeze_thaw(U32, tb)),
    Equal.trans(FD.array__Tree<U32>, FD.array__freeze(U32, FD.array__thaw(U32, tb)), FD.array__freeze(U32, FD.array__thaw(U32, T)), T,
      Equal.cong(O.Bits, FD.array__Tree<U32>, z => bta(z), O.Bits{FD.array__thaw(U32, tb), k}, O.Bits{FD.array__thaw(U32, T), K}, eo), FD.array__freeze_thaw(U32, T)))
  +eK = Equal.cong(O.Bits, U32, z => btk(z), O.Bits{FD.array__thaw(U32, tb), k}, O.Bits{FD.array__thaw(U32, T), K}, eo)
  +pf1 = FD.logic__subst(FD.array__Tree<U32>, z => {FD.array__perfect(U32, dw, z) == True{} : Bool}, T, tb, Equal.sym(FD.array__Tree<U32>, tb, T, eT), pf)
  +ed = ER.pdep(U32, dw, tb, pf1)
  +D = ER.LDEP(U32, tb)
  +pf2 = FD.logic__subst(Nat, z => {FD.array__perfect(U32, z, tb) == True{} : Bool}, dw, D, Equal.sym(Nat, D, dw, ed), pf1)
  +hd2 = FD.logic__subst(Nat, z => {Nat.is_lt(z, 31n) == True{} : Bool}, dw, D, Equal.sym(Nat, D, dw, ed), hdw)
  +hr1 = FD.logic__subst(U32, z => {Nat.is_le(Nat.add(U32.to_nat(U32.shrn(z, 5n)), 1n), VB.pw(dw)) == True{} : Bool}, K, k, Equal.sym(U32, k, K, eK), hroom)
  +hr2 = FD.logic__subst(Nat, z => {Nat.is_le(Nat.add(U32.to_nat(U32.shrn(k, 5n)), 1n), VB.pw(z)) == True{} : Bool}, dw, D, Equal.sym(Nat, D, dw, ed), hr1)
  +hb1 = FD.logic__subst(U32, z => {O.bits_above_zero(U32.and(z, 31), RD.wd(T, dw, U32.shrn(z, 5n))) == True{} : Bool}, K, k, Equal.sym(U32, k, K, eK), hbz)
  +hb2 = FD.logic__subst(FD.array__Tree<U32>, z => {O.bits_above_zero(U32.and(k, 31), RD.wd(z, dw, U32.shrn(k, 5n))) == True{} : Bool}, T, tb, Equal.sym(FD.array__Tree<U32>, tb, T, eT), hb1)
  +hb3 = FD.logic__subst(Nat, z => {O.bits_above_zero(U32.and(k, 31), RD.wd(tb, z, U32.shrn(k, 5n))) == True{} : Bool}, dw, D, Equal.sym(Nat, D, dw, ed), hb2)
  +hok = ok131072(tb, D, k, pf2, hd2, hr2, hb3, hN, wf)
  +hsz = FD.logic__subst(Nat, z => {Nat.is_le(Nat.add(236n, z), A.quad(VB.pw(28n))) == True{} : Bool}, U32.to_nat(CO.NK(k)), LY.LN(EXb.ENC(EXb.MB{ER.LDEP(U32, tb), tb, k, U32.to_nat(131072), 18n, 18n})),
    Equal.sym(Nat, LY.LN(EXb.ENC(EXb.MB{ER.LDEP(U32, tb), tb, k, U32.to_nat(131072), 18n, 18n})), U32.to_nat(CO.NK(k)), EXb.eL(D, tb, k, U32.to_nat(131072), 18n, 18n, hok)), szA(k, hN))
  FD.logic__and_intro(EXb.OK(EXb.MB{ER.LDEP(U32, tb), tb, k, U32.to_nat(131072), 18n, 18n}), Nat.is_le(Nat.add(236n, LY.LN(EXb.ENC(EXb.MB{ER.LDEP(U32, tb), tb, k, U32.to_nat(131072), 18n, 18n}))), A.quad(VB.pw(28n))), hok, hsz)

def elx(+m: RT.MB<RT.M_Attestation>, +sE: S.Schema, +es: {SH.BitList_limit(SH.Chain_head(SH.Container_fields(sE))) == U32.to_nat(131072) : Nat},
    +r0: RT.rep_Attestation_bx(RT.th_Attestation_bx(m), sE), +h0: SDE(m)) -> ELF(m):
  match m:
    case RT.MNone{}:
      (+eb, +rl) = r0
      Empty.absurd(ELF(RT.MNone{}), FD.logic__false_true(Equal.cong(O.Boxed<FuluAttestation_d.Attestation>, Bool, z => isS(z), O.BNone{}, O.BSome{RT.pjb_Attestation_bx(O.BNone{}), O.BNone{}}, eb)))
    case RT.MSome{+v}:
      match v:
        case RT.M_Attestation{+a0, +a1, +a2, +a3}:
          match a0:
            case RT.BMr{+tb, +k}:
              (+eb, +ra) = r0
              (+x1, +q1) = ra
              (+x2, +q2) = q1
              (+x3, +q3) = q2
              (+eo, +rb) = q3
              (+wf, +rl) = rb
              (+hlim, +hch) = rl
              +hN = FD.logic__subst(Nat, z => {Nat.is_le(U32.to_nat(k), z) == True{} : Bool}, SH.BitList_limit(SH.Chain_head(SH.Container_fields(sE))), U32.to_nat(131072), es, hlim)
              (elo(tb, k, a1, a2, a3, hN, wf, h0), elv(tb, k, a1, a2, a3))

# ---- the elements from i on ----
def SDKS(k: Nat, +W: List<&2, RT.MB<RT.M_Attestation>>, +i: Nat) -> Data:
  match k:
    case 0n: {True{} == True{} : Bool}
    case 1n+q: DK.P2(SDE(RT.xat_l8_Attestation(W, i)), SDKS(q, W, 1n+i))

def wOK(k: Nat, +W: List<&2, RT.MB<RT.M_Attestation>>, +i: Nat, +sE: S.Schema, +es: {SH.BitList_limit(SH.Chain_head(SH.Container_fields(sE))) == U32.to_nat(131072) : Nat},
    +er: RT.ereps_l8_Attestation(k, W, i, sE), +hs: SDKS(k, W, i)) -> {W8.EOKS(k, LM(W), i) == True{} : Bool}:
  match k:
    case 0n: {==}
    case 1n+ +q:
      (+r0, +er1) = er
      (+h0, +hs1) = hs
      +x = RT.xat_l8_Attestation(W, i)
      +ok0 = PA({W8.EOK(cvE(x)) == True{} : Bool}, {RT.v_Attestation_bx(RT.th_Attestation_bx(x)) == W8.EV(cvE(x)) : S.Value}, elx(x, sE, es, r0, h0))
      FD.logic__and_intro(W8.EOK(W8.xat_l8_Attestation(LM(W), i)), W8.EOKS(q, LM(W), 1n+i),
        FD.logic__subst(W8.MB<EM.MW>, z => {W8.EOK(z) == True{} : Bool}, cvE(x), W8.xat_l8_Attestation(LM(W), i), Equal.sym(W8.MB<EM.MW>, W8.xat_l8_Attestation(LM(W), i), cvE(x), xatlm(W, i)), ok0),
        wOK(q, W, 1n+i, sE, es, er1, hs1))

def wV(k: Nat, +W: List<&2, RT.MB<RT.M_Attestation>>, +i: Nat, +sE: S.Schema, +es: {SH.BitList_limit(SH.Chain_head(SH.Container_fields(sE))) == U32.to_nat(131072) : Nat},
    +er: RT.ereps_l8_Attestation(k, W, i, sE), +hs: SDKS(k, W, i)) -> {RT.xi_l8_Attestation(k, W, i) == W8.XI(k, LM(W), i) : S.Value}:
  match k:
    case 0n: {==}
    case 1n+ +q:
      (+r0, +er1) = er
      (+h0, +hs1) = hs
      +x = RT.xat_l8_Attestation(W, i)
      +ev0 = PB({W8.EOK(cvE(x)) == True{} : Bool}, {RT.v_Attestation_bx(RT.th_Attestation_bx(x)) == W8.EV(cvE(x)) : S.Value}, elx(x, sE, es, r0, h0))
      %Equal.sym(W8.MB<EM.MW>, W8.xat_l8_Attestation(LM(W), i), cvE(x), xatlm(W, i)) :
        {S.Items{RT.v_Attestation_bx(RT.th_Attestation_bx(x)), RT.xi_l8_Attestation(q, W, 1n+i)} == S.Items{W8.EV(_), W8.XI(q, LM(W), 1n+i)} : S.Value}
      %Equal.sym(S.Value, RT.v_Attestation_bx(RT.th_Attestation_bx(x)), W8.EV(cvE(x)), ev0) :
        {S.Items{_, RT.xi_l8_Attestation(q, W, 1n+i)} == S.Items{W8.EV(cvE(x)), W8.XI(q, LM(W), 1n+i)} : S.Value}
      Equal.cong(S.Value, S.Value, z => S.Items{W8.EV(cvE(x)), z}, RT.xi_l8_Attestation(q, W, 1n+i), W8.XI(q, LM(W), 1n+i), wV(q, W, 1n+i, sE, es, er1, hs1))

# ---- the list ----
# the (i) premise (decoded-object gaps: the list's tree at depth below 31, each attestation's bit list storage SDB)
def sd8(w: Fulu_list_Attestation_8_d.l8_Attestation_Seq) -> Data:
  DK.Ex(FD.array__Tree<RT.MB<RT.M_Attestation>>, t => DK.Ex(Nat, dw => DK.Ex(U32, N =>
    DK.P2({w == Fulu_list_Attestation_8_d.l8_Attestation_Seq{RT.am_l8_Attestation(t), N} : Fulu_list_Attestation_8_d.l8_Attestation_Seq},
    DK.P2({FD.array__perfect(RT.MB<RT.M_Attestation>, dw, t) == True{} : Bool},
    DK.P2({Nat.is_lt(dw, 31n) == True{} : Bool},
