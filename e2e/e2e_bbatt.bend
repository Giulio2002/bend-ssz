  +e17 = VG.u32pow(131072, 17n, {==}, {==})
  +h1 = FD.logic__subst(Nat, z => {Nat.is_le(U32.to_nat(CO.NK(K)), Nat.add(z, 1n)) == True{} : Bool}, U32.to_nat(131072), P, e17, CO.nk_le(K, 18n, U32.to_nat(131072), {==}, hN, EAB.hNk0()))
