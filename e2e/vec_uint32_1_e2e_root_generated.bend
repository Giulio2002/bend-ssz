def vec_uint32_5_e2e_root(h: B.Buf, -o: O.Words, +rep: PK.rep_v4(o, GS.vec_uint32_5())) -> {Some{D.bytes(Pair.snd(O.Words, D.Digest, Pair.snd(B.Buf, O.Words & D.Digest, vec_uint32_5_h.vec_uint32_5_hash_tree_root(h, o))))} == API.hash_tree_root(GS.vec_uint32_5(), PK.vview4(o)) : Maybe<&2, +List<U32>>}:
  (+w, +rest) = rep
  vec_uint32_5_r1(h, o, w, rep)

# vec_uint32_8 (vec_uint32_8)
def vec_uint32_8_r2(h: B.Buf, +t: FD.array__Tree<U32>, +N: U32, +rep: PK.rep_v4(O.Words{FD.array__thaw(U32, t), N}, GS.vec_uint32_8())) -> {Some{D.bytes(Pair.snd(O.Words, D.Digest, Pair.snd(B.Buf, O.Words & D.Digest, vec_uint32_8_h.vec_uint32_8_hash_tree_root(h, O.Words{FD.array__thaw(U32, t), N}))))} == API.hash_tree_root(GS.vec_uint32_8(), PK.vview4(O.Words{FD.array__thaw(U32, t), N})) : Maybe<&2, +List<U32>>}:
