def vec_uint32_8_r1(h: B.Buf, -o: O.Words, +w: WO.wf1(o), +rep: PK.rep_v4(o, GS.vec_uint32_8())) -> {Some{D.bytes(Pair.snd(O.Words, D.Digest, Pair.snd(B.Buf, O.Words & D.Digest, vec_uint32_8_h.vec_uint32_8_hash_tree_root(h, o))))} == API.hash_tree_root(GS.vec_uint32_8(), PK.vview4(o)) : Maybe<&2, +List<U32>>}:
