    case False{}: FuluWithdrawalIndex_d_none(bs, n, hn, ec)
    case True{}: Empty.absurd({Pair.snd(B.Buf, Maybe<&1, O.U64>, T.WithdrawalIndex_decode(B.fill_at(B.alloc(n), 0, bs), n)) == None{} : Maybe<&1, O.U64>}, FD.logic__none_some(S.Value, M3.v_u64(O.U64{E.wn(0n, bs), E.wn(1n, bs)}), Equal.trans(Maybe<&2, S.Value>, None{}, API.deserialize(Spec.WithdrawalIndex(), bs), Some{M3.v_u64(O.U64{E.wn(0n, bs), E.wn(1n, bs)})}, Equal.sym(Maybe<&2, S.Value>, API.deserialize(Spec.WithdrawalIndex(), bs), None{}, an), FuluWithdrawalIndex_d_asome(bs, hd, ec))))

# (ii) the object decoder returns o exactly when END_TO_END's deserialize returns VAL(o).
def FuluWithdrawalIndex_e2e_decode_accept(+bs: +List<U32>, +n: U32, +o: O.U64, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +hd: {SP.bytes_domain(bs) == True{} : Bool})
    -> ({Pair.snd(B.Buf, Maybe<&1, O.U64>, T.WithdrawalIndex_decode(B.fill_at(B.alloc(n), 0, bs), n)) == Some{o} : Maybe<&1, O.U64>} -> {API.deserialize(Spec.WithdrawalIndex(), bs) == Some{M3.v_u64(o)} : Maybe<&2, S.Value>}) & ({API.deserialize(Spec.WithdrawalIndex(), bs) == Some{M3.v_u64(o)} : Maybe<&2, S.Value>} -> {Pair.snd(B.Buf, Maybe<&1, O.U64>, T.WithdrawalIndex_decode(B.fill_at(B.alloc(n), 0, bs), n)) == Some{o} : Maybe<&1, O.U64>}):
  (da => FuluWithdrawalIndex_d_ia(bs, n, o, hn, hd, Nat.is_eq(List.length(&2, U32, bs), 8n), {==}, da), aa => FuluWithdrawalIndex_d_ib(bs, n, o, hn, Nat.is_eq(List.length(&2, U32, bs), 8n), {==}, aa))

# (iii) the object decoder fails exactly when END_TO_END's deserialize does.
def FuluWithdrawalIndex_e2e_decode_reject(+bs: +List<U32>, +n: U32, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +hd: {SP.bytes_domain(bs) == True{} : Bool})
    -> ({Pair.snd(B.Buf, Maybe<&1, O.U64>, T.WithdrawalIndex_decode(B.fill_at(B.alloc(n), 0, bs), n)) == None{} : Maybe<&1, O.U64>} -> {API.deserialize(Spec.WithdrawalIndex(), bs) == None{} : Maybe<&2, S.Value>}) & ({API.deserialize(Spec.WithdrawalIndex(), bs) == None{} : Maybe<&2, S.Value>} -> {Pair.snd(B.Buf, Maybe<&1, O.U64>, T.WithdrawalIndex_decode(B.fill_at(B.alloc(n), 0, bs), n)) == None{} : Maybe<&1, O.U64>}):
  (dn => FuluWithdrawalIndex_d_ra(bs, n, hn, hd, Nat.is_eq(List.length(&2, U32, bs), 8n), {==}, dn), an => FuluWithdrawalIndex_d_rb(bs, n, hn, hd, Nat.is_eq(List.length(&2, U32, bs), 8n), {==}, an))

