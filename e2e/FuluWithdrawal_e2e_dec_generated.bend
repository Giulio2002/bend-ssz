def FuluWithdrawalIndex_d_anone(+bs: +List<U32>, +ec: {Nat.is_eq(List.length(&2, U32, bs), 8n) == False{} : Bool}) -> {API.deserialize(Spec.WithdrawalIndex(), bs) == None{} : Maybe<&2, S.Value>}:
  E.outside_none(Spec.WithdrawalIndex(), bs, M2.WithdrawalIndex_decode_reject(bs, ec))

def FuluWithdrawalIndex_d_pk(+bs: +List<U32>, +hd: {SP.bytes_domain(bs) == True{} : Bool}, +ec: {Nat.is_eq(List.length(&2, U32, bs), 8n) == True{} : Bool}) -> {F.limbs(E.wl(2n, bs)) == bs : +List<U32>}:
  E.pk(2n, bs, hd, FD.nat__eq_from_is_eq(List.length(&2, U32, bs), 8n, ec))

def FuluWithdrawalIndex_d_some(+bs: +List<U32>, +n: U32, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +hd: {SP.bytes_domain(bs) == True{} : Bool}, +ec: {Nat.is_eq(List.length(&2, U32, bs), 8n) == True{} : Bool}) -> {Pair.snd(B.Buf, Maybe<&1, O.U64>, T.WithdrawalIndex_decode(B.fill_at(B.alloc(n), 0, bs), n)) == Some{O.U64{E.wn(0n, bs), E.wn(1n, bs)}} : Maybe<&1, O.U64>}:
