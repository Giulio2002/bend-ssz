  Equal.cong(B.Buf & Maybe<&1, O.U64>, Maybe<&1, O.U64>, q => Pair.snd(B.Buf, Maybe<&1, O.U64>, q), T.WithdrawalIndex_decode(B.fill_at(B.alloc(8), 0, F.limbs([E.wn(0n, bs), E.wn(1n, bs)])), 8), (B.fill_at(B.alloc(8), 0, F.limbs([E.wn(0n, bs), E.wn(1n, bs)])), Some{O.U64{E.wn(0n, bs), E.wn(1n, bs)}}),
    M0.WithdrawalIndex_spec_input(E.wn(0n, bs), E.wn(1n, bs)))

def FuluWithdrawalIndex_d_asome(+bs: +List<U32>, +hd: {SP.bytes_domain(bs) == True{} : Bool}, +ec: {Nat.is_eq(List.length(&2, U32, bs), 8n) == True{} : Bool}) -> {API.deserialize(Spec.WithdrawalIndex(), bs) == Some{M3.v_u64(O.U64{E.wn(0n, bs), E.wn(1n, bs)})} : Maybe<&2, S.Value>}:
