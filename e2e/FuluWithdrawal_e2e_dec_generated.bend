def FuluWithdrawalIndex_d_ibt(+bs: +List<U32>, +n: U32, +o: O.U64, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +ec: {Nat.is_eq(List.length(&2, U32, bs), 8n) == True{} : Bool}, +aa: {API.deserialize(Spec.WithdrawalIndex(), bs) == Some{M3.v_u64(o)} : Maybe<&2, S.Value>}) -> {Pair.snd(B.Buf, Maybe<&1, O.U64>, T.WithdrawalIndex_decode(B.fill_at(B.alloc(n), 0, bs), n)) == Some{o} : Maybe<&1, O.U64>}:
  match o:
    case O.U64{+y0, +y1}:
      +eb = FD.logic__some_inj(+List<U32>, F.limbs([y0, y1]), bs, Equal.trans(Maybe<&2, +List<U32>>, Some{F.limbs([y0, y1])}, Encoding.encoding_for_legal_type(Spec.WithdrawalIndex(), M3.v_u64(O.U64{y0, y1})), Some{bs},
        Equal.sym(Maybe<&2, +List<U32>>, Encoding.encoding_for_legal_type(Spec.WithdrawalIndex(), M3.v_u64(O.U64{y0, y1})), Some{F.limbs([y0, y1])}, M1.WithdrawalIndex_spec_encode(y0, y1)),
        E.acc_dec(Spec.WithdrawalIndex(), bs, M3.v_u64(O.U64{y0, y1}), E2E.accepted_spec(Spec.WithdrawalIndex(), bs, M3.v_u64(O.U64{y0, y1}), aa))))
