def FuluWithdrawalIndex_d_ia(+bs: +List<U32>, +n: U32, +o: O.U64, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +hd: {SP.bytes_domain(bs) == True{} : Bool}, +c: Bool, +ec: {Nat.is_eq(List.length(&2, U32, bs), 8n) == c : Bool}, +da: {Pair.snd(B.Buf, Maybe<&1, O.U64>, T.WithdrawalIndex_decode(B.fill_at(B.alloc(n), 0, bs), n)) == Some{o} : Maybe<&1, O.U64>}) -> {API.deserialize(Spec.WithdrawalIndex(), bs) == Some{M3.v_u64(o)} : Maybe<&2, S.Value>}:
