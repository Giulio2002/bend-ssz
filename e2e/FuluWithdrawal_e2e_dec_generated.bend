        {Pair.snd(B.Buf, Maybe<&1, O.U64>, T.WithdrawalIndex_decode(B.fill_at(B.alloc(_), 0, bs), _)) == Some{O.U64{y0, y1}} : Maybe<&1, O.U64>}
      %eb :
        {Pair.snd(B.Buf, Maybe<&1, O.U64>, T.WithdrawalIndex_decode(B.fill_at(B.alloc(8), 0, _), 8)) == Some{O.U64{y0, y1}} : Maybe<&1, O.U64>}
      Equal.cong(B.Buf & Maybe<&1, O.U64>, Maybe<&1, O.U64>, q => Pair.snd(B.Buf, Maybe<&1, O.U64>, q), T.WithdrawalIndex_decode(B.fill_at(B.alloc(8), 0, F.limbs([y0, y1])), 8), (B.fill_at(B.alloc(8), 0, F.limbs([y0, y1])), Some{O.U64{y0, y1}}),
        M0.WithdrawalIndex_spec_input(y0, y1))

def FuluWithdrawalIndex_d_ib(+bs: +List<U32>, +n: U32, +o: O.U64, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +c: Bool, +ec: {Nat.is_eq(List.length(&2, U32, bs), 8n) == c : Bool}, +aa: {API.deserialize(Spec.WithdrawalIndex(), bs) == Some{M3.v_u64(o)} : Maybe<&2, S.Value>}) -> {Pair.snd(B.Buf, Maybe<&1, O.U64>, T.WithdrawalIndex_decode(B.fill_at(B.alloc(n), 0, bs), n)) == Some{o} : Maybe<&1, O.U64>}:
  match c:
    case False{}: Empty.absurd({Pair.snd(B.Buf, Maybe<&1, O.U64>, T.WithdrawalIndex_decode(B.fill_at(B.alloc(n), 0, bs), n)) == Some{o} : Maybe<&1, O.U64>}, FD.logic__none_some(S.Value, M3.v_u64(o), Equal.trans(Maybe<&2, S.Value>, None{}, API.deserialize(Spec.WithdrawalIndex(), bs), Some{M3.v_u64(o)}, Equal.sym(Maybe<&2, S.Value>, API.deserialize(Spec.WithdrawalIndex(), bs), None{}, FuluWithdrawalIndex_d_anone(bs, ec)), aa)))
    case True{}: FuluWithdrawalIndex_d_ibt(bs, n, o, hn, ec, aa)

def FuluWithdrawalIndex_d_ra(+bs: +List<U32>, +n: U32, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +hd: {SP.bytes_domain(bs) == True{} : Bool}, +c: Bool, +ec: {Nat.is_eq(List.length(&2, U32, bs), 8n) == c : Bool}, +dn: {Pair.snd(B.Buf, Maybe<&1, O.U64>, T.WithdrawalIndex_decode(B.fill_at(B.alloc(n), 0, bs), n)) == None{} : Maybe<&1, O.U64>}) -> {API.deserialize(Spec.WithdrawalIndex(), bs) == None{} : Maybe<&2, S.Value>}:
