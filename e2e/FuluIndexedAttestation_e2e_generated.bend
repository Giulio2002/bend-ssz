# the list's limit, read through the spec's schema without evaluating it
def lim_of(+e: S.Schema, +n: Nat) -> {SH.ListOf_limit(S.ListOf{e, n}) == n : Nat}: {==}

def eH() -> {SH.Chain_head(SH.Container_fields(Spec.IndexedAttestation())) == S.ListOf{Spec.Schema3(), U32.to_nat(131072)} : S.Schema}: {==}

def hcl(+c: Nat, +h: {Nat.is_le(c, SH.ListOf_limit(SH.Chain_head(SH.Container_fields(Spec.IndexedAttestation())))) == True{} : Bool}) -> {Nat.is_le(c, U32.to_nat(131072)) == True{} : Bool}:
  %lim_of(Spec.Schema3(), U32.to_nat(131072)) : {Nat.is_le(c, _) == True{} : Bool}
  %eH() : {Nat.is_le(c, SH.ListOf_limit(_)) == True{} : Bool}
  h

