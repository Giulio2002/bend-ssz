    case False{}: Empty.absurd({Pair.snd(B.Buf, Maybe<&1, T.SyncCommitteeMessage>, T.SyncCommitteeMessage_decode(B.fill_at(B.alloc(n), 0, bs), n)) == Some{o} : Maybe<&1, T.SyncCommitteeMessage>}, FD.logic__none_some(S.Value, M3.v_SyncCommitteeMessage(o), Equal.trans(Maybe<&2, S.Value>, None{}, API.deserialize(Spec.SyncCommitteeMessage(), bs), Some{M3.v_SyncCommitteeMessage(o)}, Equal.sym(Maybe<&2, S.Value>, API.deserialize(Spec.SyncCommitteeMessage(), bs), None{}, FuluSyncCommitteeMessage_d_anone(bs, ec)), aa)))
    case True{}: FuluSyncCommitteeMessage_d_ibt(bs, n, o, hn, ec, aa)

