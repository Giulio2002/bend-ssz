def FuluSyncCommitteeMessage_d_rb(+bs: +List<U32>, +n: U32, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +hd: {SP.bytes_domain(bs) == True{} : Bool}, +c: Bool, +ec: {Nat.is_eq(List.length(&2, U32, bs), 144n) == c : Bool}, +an: {API.deserialize(Spec.SyncCommitteeMessage(), bs) == None{} : Maybe<&2, S.Value>}) -> {Pair.snd(B.Buf, Maybe<&1, T.SyncCommitteeMessage>, T.SyncCommitteeMessage_decode(B.fill_at(B.alloc(n), 0, bs), n)) == None{} : Maybe<&1, T.SyncCommitteeMessage>}:
