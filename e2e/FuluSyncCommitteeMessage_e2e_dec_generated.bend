# (ii) the object decoder returns o exactly when END_TO_END's deserialize returns VAL(o).
def FuluSyncCommitteeMessage_e2e_decode_accept(+bs: +List<U32>, +n: U32, +o: T.SyncCommitteeMessage, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +hd: {SP.bytes_domain(bs) == True{} : Bool})
    -> ({Pair.snd(B.Buf, Maybe<&1, T.SyncCommitteeMessage>, T.SyncCommitteeMessage_decode(B.fill_at(B.alloc(n), 0, bs), n)) == Some{o} : Maybe<&1, T.SyncCommitteeMessage>} -> {API.deserialize(Spec.SyncCommitteeMessage(), bs) == Some{M3.v_SyncCommitteeMessage(o)} : Maybe<&2, S.Value>}) & ({API.deserialize(Spec.SyncCommitteeMessage(), bs) == Some{M3.v_SyncCommitteeMessage(o)} : Maybe<&2, S.Value>} -> {Pair.snd(B.Buf, Maybe<&1, T.SyncCommitteeMessage>, T.SyncCommitteeMessage_decode(B.fill_at(B.alloc(n), 0, bs), n)) == Some{o} : Maybe<&1, T.SyncCommitteeMessage>}):
  (da => FuluSyncCommitteeMessage_d_ia(bs, n, o, hn, hd, Nat.is_eq(List.length(&2, U32, bs), 144n), {==}, da), aa => FuluSyncCommitteeMessage_d_ib(bs, n, o, hn, Nat.is_eq(List.length(&2, U32, bs), 144n), {==}, aa))

# (iii) the object decoder fails exactly when END_TO_END's deserialize does.
def FuluSyncCommitteeMessage_e2e_decode_reject(+bs: +List<U32>, +n: U32, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +hd: {SP.bytes_domain(bs) == True{} : Bool})
    -> ({Pair.snd(B.Buf, Maybe<&1, T.SyncCommitteeMessage>, T.SyncCommitteeMessage_decode(B.fill_at(B.alloc(n), 0, bs), n)) == None{} : Maybe<&1, T.SyncCommitteeMessage>} -> {API.deserialize(Spec.SyncCommitteeMessage(), bs) == None{} : Maybe<&2, S.Value>}) & ({API.deserialize(Spec.SyncCommitteeMessage(), bs) == None{} : Maybe<&2, S.Value>} -> {Pair.snd(B.Buf, Maybe<&1, T.SyncCommitteeMessage>, T.SyncCommitteeMessage_decode(B.fill_at(B.alloc(n), 0, bs), n)) == None{} : Maybe<&1, T.SyncCommitteeMessage>}):
  (dn => FuluSyncCommitteeMessage_d_ra(bs, n, hn, hd, Nat.is_eq(List.length(&2, U32, bs), 144n), {==}, dn), an => FuluSyncCommitteeMessage_d_rb(bs, n, hn, hd, Nat.is_eq(List.length(&2, U32, bs), 144n), {==}, an))

