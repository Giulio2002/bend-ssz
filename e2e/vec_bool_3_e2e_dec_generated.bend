def vec_bool_3_d_v(+bs: +List<U32>, +n: U32, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +hd: {SP.bytes_domain(bs) == True{} : Bool}, +c: Bool, +ec: {Nat.is_eq(List.length(&2, U32, bs), 3n) == c : Bool}) -> {vec_bool_3_mv(Pair.snd(B.Buf, Maybe<&1, O.Words>, vec_bool_3_r.vec_bool_3_decode(B.fill_at(B.alloc(n), 0, bs), n))) == API.deserialize(Spec.vec_bool_3(), bs) : Maybe<&2, S.Value>}:
