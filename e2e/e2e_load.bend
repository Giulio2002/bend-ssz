    case Con{a, Con{b, Con{c, Con{d, r}}}}: Con{B.word_of(a, b, c, d), wlp(r)}
    case Con{a, Con{b, Con{c, Nil{}}}}: Con{B.word_of(a, b, c, 0), Nil{}}
    case Con{a, Con{b, Nil{}}}: Con{B.word_of(a, b, 0, 0), Nil{}}
    case Con{a, Nil{}}: Con{B.word_of(a, 0, 0, 0), Nil{}}
    case Nil{}: Nil{}

