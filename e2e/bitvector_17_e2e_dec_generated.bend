# (ii) through the view: the view of the decoder's result is END_TO_END's deserialize.
def bitvector_17_e2e_decode_view(+bs: +List<U32>, +n: U32, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +hd: {SP.bytes_domain(bs) == True{} : Bool}) -> {bitvector_17_mv(Pair.snd(B.Buf, Maybe<&1, bitvector_17_d.Bitvector17>, bitvector_17_r.bitvector_17_decode(B.fill_at(B.alloc(n), 0, bs), n))) == API.deserialize(Spec.bitvector_17(), bs) : Maybe<&2, S.Value>}:
  bitvector_17_d_v(bs, n, hn, hd, Nat.is_eq(List.length(&2, U32, bs), 3n), {==})

def bitvector_17_d_bn(m: Maybe<&1, bitvector_17_d.Bitvector17>, +e: {Maybe.is_some(&2, S.Value, bitvector_17_mv(m)) == False{} : Bool}) -> {m == None{} : Maybe<&1, bitvector_17_d.Bitvector17>}:
