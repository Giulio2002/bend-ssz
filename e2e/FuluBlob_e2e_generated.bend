    BL.Blob_spec_encode(AC.segt(dd, 0n, L.wlp(bs)), FD.logic__subst(Nat, z => {FD.array__perfect(U32, z, AC.segt(dd, 0n, L.wlp(bs))) == True{} : Bool}, dd, 15n, ed, L.seg_pf(dd, L.wlp(bs))), Spec.Blob(), {==})))

def d_br(+dd: Nat, +ed: {dd == 15n : Nat}, +bs: +List<U32>) -> {S.BytesValue{WO.wview(O.Words{ANode{FD.array__thaw(U32, AC.segt(dd, 0n, L.wlp(bs))), Array.new(U32, 15n, 0)}, 131072})} == S.BytesValue{F.limbs(FD.array__slots(U32, AC.segt(dd, 0n, L.wlp(bs))))} : S.Value}:
  Equal.trans(S.Value, S.BytesValue{WO.wview(O.Words{ANode{FD.array__thaw(U32, AC.segt(dd, 0n, L.wlp(bs))), Array.new(U32, 15n, 0)}, 131072})}, S.BytesValue{WO.wview(O.Words{ANode{FD.array__thaw(U32, AC.segt(dd, 0n, L.wlp(bs))), FD.array__thaw(U32, FD.array__trep(U32, dd, 0))}, 131072})}, S.BytesValue{F.limbs(FD.array__slots(U32, AC.segt(dd, 0n, L.wlp(bs))))},
    Equal.cong(Array<U32>, S.Value, z => S.BytesValue{WO.wview(O.Words{ANode{FD.array__thaw(U32, AC.segt(dd, 0n, L.wlp(bs))), z}, 131072})}, Array.new(U32, 15n, 0), FD.array__thaw(U32, FD.array__trep(U32, dd, 0)), Equal.trans(Array<U32>, Array.new(U32, 15n, 0), Array.new(U32, dd, 0), FD.array__thaw(U32, FD.array__trep(U32, dd, 0)), Equal.cong(Nat, Array<U32>, z => Array.new(U32, z, 0), 15n, dd, Equal.sym(Nat, dd, 15n, ed)), FD.array__new(U32, dd, 0))),
    Equal.cong(+List<U32>, S.Value, z => S.BytesValue{z}, WO.wview(O.Words{ANode{FD.array__thaw(U32, AC.segt(dd, 0n, L.wlp(bs))), FD.array__thaw(U32, FD.array__trep(U32, dd, 0))}, 131072}), F.limbs(FD.array__slots(U32, AC.segt(dd, 0n, L.wlp(bs)))),
      XW.vb(AC.segt(dd, 0n, L.wlp(bs)), FD.array__trep(U32, dd, 0), 131072, vlen(AC.segt(dd, 0n, L.wlp(bs)), FD.logic__subst(Nat, z => {FD.array__perfect(U32, z, AC.segt(dd, 0n, L.wlp(bs))) == True{} : Bool}, dd, 15n, ed, L.seg_pf(dd, L.wlp(bs)))))))

def d_v(+dd: Nat, +ed: {dd == 15n : Nat}, +bs: +List<U32>, +n: U32, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +hd: {SP.bytes_domain(bs) == True{} : Bool}, +c: Bool, +ec: {U32.is_eq(n, 131072) == c : Bool}) -> {blob_mv(Pair.snd(B.Buf, Maybe<&1, O.Words>, FuluBlob_r.Blob_decode(B.fill_at(B.alloc(n), 0, bs), n))) == API.deserialize(Spec.Blob(), bs) : Maybe<&2, S.Value>}:
  match c:
    case False{}:
      %Equal.sym(Maybe<&1, O.Words>, Pair.snd(B.Buf, Maybe<&1, O.Words>, FuluBlob_r.Blob_decode(B.fill_at(B.alloc(n), 0, bs), n)), None{}, d_none(bs, n, ec)) : {blob_mv(_) == API.deserialize(Spec.Blob(), bs) : Maybe<&2, S.Value>}
      %Equal.sym(Maybe<&2, S.Value>, API.deserialize(Spec.Blob(), bs), None{}, d_anone(bs, n, hn, ec)) : {blob_mv(None{}) == _ : Maybe<&2, S.Value>}
      {==}
    case True{}:
      +en = WF.u32_equal_sound(n, 131072, ec)
      %Equal.sym(Maybe<&1, O.Words>, Pair.snd(B.Buf, Maybe<&1, O.Words>, FuluBlob_r.Blob_decode(B.fill_at(B.alloc(n), 0, bs), n)), Some{O.Words{ANode{FD.array__thaw(U32, AC.segt(dd, 0n, L.wlp(bs))), Array.new(U32, 15n, 0)}, 131072}}, d_some(dd, ed, bs, n, hn, hd, en)) : {blob_mv(_) == API.deserialize(Spec.Blob(), bs) : Maybe<&2, S.Value>}
      %Equal.sym(Maybe<&2, S.Value>, API.deserialize(Spec.Blob(), bs), Some{S.BytesValue{F.limbs(FD.array__slots(U32, AC.segt(dd, 0n, L.wlp(bs))))}}, d_asome(dd, ed, bs, n, hn, hd, en)) : {blob_mv(Some{O.Words{ANode{FD.array__thaw(U32, AC.segt(dd, 0n, L.wlp(bs))), Array.new(U32, 15n, 0)}, 131072}}) == _ : Maybe<&2, S.Value>}
      Equal.cong(S.Value, Maybe<&2, S.Value>, v => Some{v}, S.BytesValue{WO.wview(O.Words{ANode{FD.array__thaw(U32, AC.segt(dd, 0n, L.wlp(bs))), Array.new(U32, 15n, 0)}, 131072})}, S.BytesValue{F.limbs(FD.array__slots(U32, AC.segt(dd, 0n, L.wlp(bs))))}, d_br(dd, ed, bs))

# (ii) through the view
def FuluBlob_e2e_decode_view(+bs: +List<U32>, +n: U32, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +hd: {SP.bytes_domain(bs) == True{} : Bool}) -> {blob_mv(Pair.snd(B.Buf, Maybe<&1, O.Words>, FuluBlob_r.Blob_decode(B.fill_at(B.alloc(n), 0, bs), n))) == API.deserialize(Spec.Blob(), bs) : Maybe<&2, S.Value>}:
  d_v(15n, {==}, bs, n, hn, hd, U32.is_eq(n, 131072), {==})

def d_bn(m: Maybe<&1, O.Words>, +e: {Maybe.is_some(&2, S.Value, blob_mv(m)) == False{} : Bool}) -> {m == None{} : Maybe<&1, O.Words>}:
  match m:
    case None{}: {==}
    case Some{x}: Empty.absurd({Some{x} == None{} : Maybe<&1, O.Words>}, FD.logic__false_true(Equal.sym(Bool, True{}, False{}, e)))

# (iii)
def FuluBlob_e2e_decode_reject(+bs: +List<U32>, +n: U32, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +hd: {SP.bytes_domain(bs) == True{} : Bool})
    -> ({Pair.snd(B.Buf, Maybe<&1, O.Words>, FuluBlob_r.Blob_decode(B.fill_at(B.alloc(n), 0, bs), n)) == None{} : Maybe<&1, O.Words>} -> {API.deserialize(Spec.Blob(), bs) == None{} : Maybe<&2, S.Value>}) & ({API.deserialize(Spec.Blob(), bs) == None{} : Maybe<&2, S.Value>} -> {Pair.snd(B.Buf, Maybe<&1, O.Words>, FuluBlob_r.Blob_decode(B.fill_at(B.alloc(n), 0, bs), n)) == None{} : Maybe<&1, O.Words>}):
  (dn => Equal.trans(Maybe<&2, S.Value>, API.deserialize(Spec.Blob(), bs), blob_mv(Pair.snd(B.Buf, Maybe<&1, O.Words>, FuluBlob_r.Blob_decode(B.fill_at(B.alloc(n), 0, bs), n))), None{}, Equal.sym(Maybe<&2, S.Value>, blob_mv(Pair.snd(B.Buf, Maybe<&1, O.Words>, FuluBlob_r.Blob_decode(B.fill_at(B.alloc(n), 0, bs), n))), API.deserialize(Spec.Blob(), bs), FuluBlob_e2e_decode_view(bs, n, hn, hd)),
     Equal.cong(Maybe<&1, O.Words>, Maybe<&2, S.Value>, q => blob_mv(q), Pair.snd(B.Buf, Maybe<&1, O.Words>, FuluBlob_r.Blob_decode(B.fill_at(B.alloc(n), 0, bs), n)), None{}, dn)),
   an => d_bn(Pair.snd(B.Buf, Maybe<&1, O.Words>, FuluBlob_r.Blob_decode(B.fill_at(B.alloc(n), 0, bs), n)), Equal.cong(Maybe<&2, S.Value>, Bool, z => Maybe.is_some(&2, S.Value, z), blob_mv(Pair.snd(B.Buf, Maybe<&1, O.Words>, FuluBlob_r.Blob_decode(B.fill_at(B.alloc(n), 0, bs), n))), None{}, Equal.trans(Maybe<&2, S.Value>, blob_mv(Pair.snd(B.Buf, Maybe<&1, O.Words>, FuluBlob_r.Blob_decode(B.fill_at(B.alloc(n), 0, bs), n))), API.deserialize(Spec.Blob(), bs), None{}, FuluBlob_e2e_decode_view(bs, n, hn, hd), an))))
