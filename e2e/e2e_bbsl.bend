      FD.logic__subst(Nat, z => {Nat.is_le(z, U32.to_nat(1048576)) == True{} : Bool}, VS.x8(k), U32.to_nat(n), Equal.sym(Nat, U32.to_nat(n), VS.x8(k), ex8), x8pw(k, hc))))
