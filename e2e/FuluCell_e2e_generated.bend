def FuluCell_w2(+t: FD.array__Tree<U32>, +N: U32, +cf: {Nat.is_eq(U32.to_nat(WO.len(O.Words{FD.array__thaw(U32, t), N})), SH.ByteVector_length(Spec.Cell())) == True{} : Bool}, +hc: {E3.at_depth(O.Words{FD.array__thaw(U32, t), N}, 10n) == True{} : Bool}) -> {Some{E.obytes(Pair.snd(O.Words, B.Buf, FuluCell_e.Cell_encode(O.Words{FD.array__thaw(U32, t), N})))} == API.serialize(Spec.Cell(), S.BytesValue{M1_WO.wview(O.Words{FD.array__thaw(U32, t), N})}) : Maybe<&2, +List<U32>>}:
  +ln = Equal.trans(Nat, U32.to_nat(N), SH.ByteVector_length(Spec.Cell()), U32.to_nat(2048), FD.nat__eq_from_is_eq(U32.to_nat(WO.len(O.Words{FD.array__thaw(U32, t), N})), SH.ByteVector_length(Spec.Cell()), cf), {==})
  +eN = FD.u32__injective(N, 2048, ln)
  +pf = FD.logic__subst(FD.array__Tree<U32>, z => {FD.array__perfect(U32, 10n, z) == True{} : Bool}, FD.array__freeze(U32, FD.array__thaw(U32, t)), t, FD.array__freeze_thaw(U32, t), hc)
  %Equal.sym(U32, N, 2048, eN) : {Some{E.obytes(Pair.snd(O.Words, B.Buf, FuluCell_e.Cell_encode(O.Words{FD.array__thaw(U32, t), _})))} == API.serialize(Spec.Cell(), S.BytesValue{M1_WO.wview(O.Words{FD.array__thaw(U32, t), _})}) : Maybe<&2, +List<U32>>}
  FuluCell_w3(t, pf)

