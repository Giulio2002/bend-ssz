# (i) under rep (the root law's invariant) with the storage at depth 10 (the decoder's).
def FuluCell_e2e_encode(-o: O.Words, +rep: M1_WO.rep_bv(o, Spec.Cell()), +hc: {E3.at_depth(o, 10n) == True{} : Bool}) -> {Some{E.obytes(Pair.snd(O.Words, B.Buf, FuluCell_e.Cell_encode(o)))} == API.serialize(Spec.Cell(), S.BytesValue{M1_WO.wview(o)}) : Maybe<&2, +List<U32>>}:
