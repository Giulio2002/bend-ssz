# (i) for every object the root law takes (e: the last word's bits above 31 are zero).
def bitvector_31_e2e_encode(+o: bitvector_31_d.Bitvector31, +e: {M1.bitvector_31_last(o) == U32{M1_WSp.join(31n, 1n, M1_WSp.take(31n, 32n, M1_PD.bits(M1.bitvector_31_last(o))), Word.zero(1n))} : U32}) -> {Some{E.obytes(bitvector_31_e.bitvector_31_encode(o))} == API.serialize(Spec.bitvector_31(), S.BitsValue{M1.bitvector_31_bits(o)}) : Maybe<&2, +List<U32>>}:
  match o:
    case bitvector_31_d.Bitvector31{+y0}:
      %Equal.sym(U32, y0, U32{WSp.join(31n, 1n, WSp.take(31n, 32n, PD.bits(y0)), Word.zero(1n))}, e) : {Some{E.obytes(bitvector_31_e.bitvector_31_encode(bitvector_31_d.Bitvector31{_}))} == API.serialize(Spec.bitvector_31(), S.BitsValue{M1.bitvector_31_bits(bitvector_31_d.Bitvector31{_})}) : Maybe<&2, +List<U32>>}
      bitvector_31_w(WSp.take(31n, 32n, PD.bits(y0)))

