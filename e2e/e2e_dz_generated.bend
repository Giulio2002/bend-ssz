# ---- any length ----

def sdk_go(+L: U32, +c: Bool, +ec: {U32.is_eq(L, 0) == c : Bool}, +dz: Nat, +i: Nat, +S: FD.array__Tree<U32>, +k: Nat, +hdk: {Nat.is_lt(dz, k) == True{} : Bool}, +hy: {Nat.is_le(VC.YL(L), U32.to_nat(VB.UMAX())) == True{} : Bool}, +hwc: {Nat.is_le(U32.to_nat(VC.WZ(L)), O.pow2n(dz)) == True{} : Bool})
    -> BL.sdk(O.Words{FD.array__thaw(U32, VY.MK(L, dz, VB.mone(VC.NW(L), i, 0n, dz, VC.ZT(dz), S))), L}, k):
  match c:
    case True{}: Inl{(VY.MK(L, dz, VB.mone(VC.NW(L), i, 0n, dz, VC.ZT(dz), S)), (dz, (L, ({==}, (VY.mk_perfect(L, dz, VB.mone(VC.NW(L), i, 0n, dz, VC.ZT(dz), S), VB.mone_perfect(VC.NW(L), i, 0n, dz, VC.ZT(dz), S, FD.array__trep_perfect(U32, dz, 0))), (hdk, FD.nat__eq_from_is_eq(U32.to_nat(L), 0n, FD.logic__subst(Bool, z => {z == True{} : Bool}, U32.is_eq(L, 0), Nat.is_eq(U32.to_nat(L), 0n), VD.eq0(L), ec))))))))}
    case False{}: Inr{sdk_dec(L, ec, dz, i, S, k, hdk, hy, hwc)}

# decoded byte storage (the copy of L bytes from word i of S into a zero tree of depth dz, the last word masked)
def sdk_any(+L: U32, +dz: Nat, +i: Nat, +S: FD.array__Tree<U32>, +k: Nat, +hdk: {Nat.is_lt(dz, k) == True{} : Bool}, +hy: {Nat.is_le(VC.YL(L), U32.to_nat(VB.UMAX())) == True{} : Bool}, +hwc: {Nat.is_le(U32.to_nat(VC.WZ(L)), O.pow2n(dz)) == True{} : Bool})
    -> BL.sdk(O.Words{FD.array__thaw(U32, VY.MK(L, dz, VB.mone(VC.NW(L), i, 0n, dz, VC.ZT(dz), S))), L}, k):
  sdk_go(L, U32.is_eq(L, 0), {==}, dz, i, S, k, hdk, hy, hwc)
# the decoders' byte storage: the depth VLS.DZ(L) of their zero tree (at most 30), for any bound k above 30
def dec_bytes(+L: U32, +i: Nat, +S: FD.array__Tree<U32>, +k: Nat, +hk: {Nat.is_lt(30n, k) == True{} : Bool},
    +hy: {Nat.is_le(VC.YL(L), U32.to_nat(VB.UMAX())) == True{} : Bool})
    -> BL.sdk(O.Words{FD.array__thaw(U32, VY.MK(L, VLS.DZ(L), VB.mone(VC.NW(L), i, 0n, VLS.DZ(L), VC.ZT(VLS.DZ(L)), S))), L}, k):
  sdk_any(L, VLS.DZ(L), i, S, k, FD.nat__le_lt_trans(VLS.DZ(L), 30n, k, VC.dz30(L, hy), hk), hy, VD.wd_cover(VC.WZ(L), 30n, {==}, VC.wz30(L, hy)))

def sdks_go(+L: U32, +c: Bool, +ec: {U32.is_eq(L, 0) == c : Bool}, +dz: Nat, +i: Nat, +S: FD.array__Tree<U32>, +sh: Nat, +ds: Nat, +k: Nat, +hdk: {Nat.is_lt(dz, k) == True{} : Bool}, +hy: {Nat.is_le(VC.YL(L), U32.to_nat(VB.UMAX())) == True{} : Bool}, +hwc: {Nat.is_le(U32.to_nat(VC.WZ(L)), O.pow2n(dz)) == True{} : Bool})
    -> BL.sdk(O.Words{FD.array__thaw(U32, VY.MK(L, dz, UC.smone(sh, VC.NW(L), i, 0n, dz, ds, VC.ZT(dz), S))), L}, k):
  match c:
    case True{}: Inl{(VY.MK(L, dz, UC.smone(sh, VC.NW(L), i, 0n, dz, ds, VC.ZT(dz), S)), (dz, (L, ({==}, (VY.mk_perfect(L, dz, UC.smone(sh, VC.NW(L), i, 0n, dz, ds, VC.ZT(dz), S), UC.smone_perfect(sh, VC.NW(L), i, 0n, dz, ds, VC.ZT(dz), S, FD.array__trep_perfect(U32, dz, 0))), (hdk, FD.nat__eq_from_is_eq(U32.to_nat(L), 0n, FD.logic__subst(Bool, z => {z == True{} : Bool}, U32.is_eq(L, 0), Nat.is_eq(U32.to_nat(L), 0n), VD.eq0(L), ec))))))))}
    case False{}: Inr{sdks_dec(L, ec, dz, i, S, sh, ds, k, hdk, hy, hwc)}

# decoded byte storage (the copy of L bytes from word i of S into a zero tree of depth dz, the last word masked)
def sdks_any(+L: U32, +dz: Nat, +i: Nat, +S: FD.array__Tree<U32>, +sh: Nat, +ds: Nat, +k: Nat, +hdk: {Nat.is_lt(dz, k) == True{} : Bool}, +hy: {Nat.is_le(VC.YL(L), U32.to_nat(VB.UMAX())) == True{} : Bool}, +hwc: {Nat.is_le(U32.to_nat(VC.WZ(L)), O.pow2n(dz)) == True{} : Bool})
    -> BL.sdk(O.Words{FD.array__thaw(U32, VY.MK(L, dz, UC.smone(sh, VC.NW(L), i, 0n, dz, ds, VC.ZT(dz), S))), L}, k):
  sdks_go(L, U32.is_eq(L, 0), {==}, dz, i, S, sh, ds, k, hdk, hy, hwc)

# ---- the decoders' copies at any byte offset (UCT.CT: aligned, VB.mone; unaligned, UC.smone) ----
def ct_go(+d: Nat, +t: FD.array__Tree<U32>, +off: U32, +L: U32, +dz: Nat, +k: Nat, +c: Nat, +ec: {VR.RX(off) == c : Nat},
    +hdk: {Nat.is_lt(dz, k) == True{} : Bool}, +hy: {Nat.is_le(VC.YL(L), U32.to_nat(VB.UMAX())) == True{} : Bool},
    +hwc: {Nat.is_le(U32.to_nat(VC.WZ(L)), O.pow2n(dz)) == True{} : Bool})
    -> BL.sdk(O.Words{FD.array__thaw(U32, UCT.CT(d, t, off, L, dz)), L}, k):
  match c:
    case 0n:
      %Equal.sym(Nat, VR.RX(off), 0n, ec) : BL.sdk(O.Words{FD.array__thaw(U32, UCT.cts(_, d, t, off, L, dz)), L}, k)
      sdk_any(L, dz, VR.QX(off), t, k, hdk, hy, hwc)
    case 1n+ +p:
      %Equal.sym(Nat, VR.RX(off), 1n+p, ec) : BL.sdk(O.Words{FD.array__thaw(U32, UCT.cts(_, d, t, off, L, dz)), L}, k)
      sdks_any(L, dz, VR.QX(off), t, 1n+p, d, k, hdk, hy, hwc)

def ct_any(+d: Nat, +t: FD.array__Tree<U32>, +off: U32, +L: U32, +dz: Nat, +k: Nat,
    +hdk: {Nat.is_lt(dz, k) == True{} : Bool}, +hy: {Nat.is_le(VC.YL(L), U32.to_nat(VB.UMAX())) == True{} : Bool},
    +hwc: {Nat.is_le(U32.to_nat(VC.WZ(L)), O.pow2n(dz)) == True{} : Bool})
    -> BL.sdk(O.Words{FD.array__thaw(U32, UCT.CT(d, t, off, L, dz)), L}, k):
  ct_go(d, t, off, L, dz, k, VR.RX(off), {==}, hdk, hy, hwc)

# the decoders' variable-length byte storage: depth VLS.DZ(L) (at most 30), for any bound k above 30
def ct_dec(+d: Nat, +t: FD.array__Tree<U32>, +off: U32, +L: U32, +k: Nat, +hk: {Nat.is_lt(30n, k) == True{} : Bool},
    +hy: {Nat.is_le(VC.YL(L), U32.to_nat(VB.UMAX())) == True{} : Bool})
    -> BL.sdk(O.Words{FD.array__thaw(U32, UCT.CT(d, t, off, L, VLS.DZ(L))), L}, k):
  ct_any(d, t, off, L, VLS.DZ(L), k, FD.nat__le_lt_trans(VLS.DZ(L), 30n, k, VC.dz30(L, hy), hk), hy, VD.wd_cover(VC.WZ(L), 30n, {==}, VC.wz30(L, hy)))
