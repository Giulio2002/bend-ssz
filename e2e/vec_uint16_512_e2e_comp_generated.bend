def gm(m: Maybe<&1, O.Words>, d: O.Words) -> O.Words:
  match m:
    case Some{x}: x
    case None{}: d
def isS(m: Maybe<&1, O.Words>) -> Bool:
  match m:
    case Some{x}: True{}
    case None{}: False{}

# the value deserialize gives for the accepted bytes is the decoded object's view
def acc(+bs: +List<U32>, +n: U32, -o: O.Words, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +hd: {SP.bytes_domain(bs) == True{} : Bool}, dec: {Pair.snd(B.Buf, Maybe<&1, O.Words>, vec_uint16_512_r.vec_uint16_512_decode(B.fill_at(B.alloc(n), 0, bs), n)) == Some{o} : Maybe<&1, O.Words>})
    -> {API.deserialize(Spec.vec_uint16_512(), bs) == Some{M1_PB.vview2(o)} : Maybe<&2, S.Value>}:
  Equal.trans(Maybe<&2, S.Value>, API.deserialize(Spec.vec_uint16_512(), bs), DB.vec_uint16_512_mv(Pair.snd(B.Buf, Maybe<&1, O.Words>, vec_uint16_512_r.vec_uint16_512_decode(B.fill_at(B.alloc(n), 0, bs), n))), Some{M1_PB.vview2(o)},
    Equal.sym(Maybe<&2, S.Value>, DB.vec_uint16_512_mv(Pair.snd(B.Buf, Maybe<&1, O.Words>, vec_uint16_512_r.vec_uint16_512_decode(B.fill_at(B.alloc(n), 0, bs), n))), API.deserialize(Spec.vec_uint16_512(), bs), DB.vec_uint16_512_e2e_decode_view(bs, n, hn, hd)),
    Equal.cong(Maybe<&1, O.Words>, Maybe<&2, S.Value>, z => DB.vec_uint16_512_mv(z), Pair.snd(B.Buf, Maybe<&1, O.Words>, vec_uint16_512_r.vec_uint16_512_decode(B.fill_at(B.alloc(n), 0, bs), n)), Some{o}, dec))

