        Equal.cong(Nat, Nat, z => Nat.add(z, U32.to_nat(WN.LJ0(t, x))), U32.to_nat(WN.O0(t, x)), 9n, e0)))),
    Equal.sym(Nat, U32.to_nat(len), Nat.add(U32.to_nat(WN.O1(t, x)), U32.to_nat(WN.LJ1(t, x, len))), e2))

def sz(+d: Nat, +t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32, +hchk: {WN.CHKw(t, x, off, len) == True{} : Bool}, +eo: {U32.to_nat(off) == x : Nat}, +hd: {Nat.is_lt(d, 31n) == True{} : Bool},
