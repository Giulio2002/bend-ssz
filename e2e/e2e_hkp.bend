# the window's layout: 9 + the list's bytes + the bit list's bytes
def ln9(+d: Nat, +t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32, +hchk: {WN.CHKw(t, x, off, len) == True{} : Bool})
