# the encoder's size for a byte list of N <= 32 bytes
def esfs(+N: U32) -> {U32.add(172, YE.SFS(N)) == EN.SFS(N) : U32}: {==}

def sb(+N: U32, +hN: {Nat.is_le(U32.to_nat(N), 32n) == True{} : Bool}) -> {Nat.is_le(U32.to_nat(EN.SFS(N)), 1032n) == True{} : Bool}:
  +hi = YEV.sb(N, hN)
  +hs = FD.nat__le_trans(Nat.add(172n, U32.to_nat(YE.SFS(N))), Nat.add(172n, 860n), O.pow2n(11n), Order.add_left(172n, U32.to_nat(YE.SFS(N)), 860n, hi), {==})
  %esfs(N) : {Nat.is_le(U32.to_nat(_), 1032n) == True{} : Bool}
  %Equal.sym(Nat, U32.to_nat(U32.add(172, YE.SFS(N))), Nat.add(U32.to_nat(172), U32.to_nat(YE.SFS(N))), VD.s_add_nat(172, YE.SFS(N), 11n, {==}, hs)) : {Nat.is_le(_, 1032n) == True{} : Bool}
  Order.add_left(172n, U32.to_nat(YE.SFS(N)), 860n, hi)

