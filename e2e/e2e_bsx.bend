  +hA = FD.logic__subst(Nat, z => {Nat.is_le(Nat.add(z, 3n), U32.to_nat(FD.u32__pow2u(s))) == True{} : Bool}, A.quad(PP), U32.to_nat(L), Equal.sym(Nat, U32.to_nat(L), A.quad(PP), eN), hA1)
