  +ew = Equal.trans(O.Words, po, O.Words{FD.array__thaw(U32, T), N}, O.Words{FD.array__thaw(U32, T), L}, eo, Equal.cong(U32, O.Words, z => O.Words{FD.array__thaw(U32, T), z}, N, L, eNL))
