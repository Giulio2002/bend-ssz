          VQ.l1_AttesterSlashing_xat_other(W, J, i0, e, WR.neq_sym(i0, J, FD.nat__is_eq_lt(i0, J, hlt)))) :
        {Nat.add(NRa(_), SUMN(q, FD.spec_common__update(RT.MB<RT.M_AttesterSlashing>, W, J, e), 1n+i0)) == SUMN(1n+q, W, i0) : Nat}
