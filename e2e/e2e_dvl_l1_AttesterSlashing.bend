    +pfw: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hchk: {V.CHKw(t, x, off, len) == True{} : Bool})
    -> {BBA.LN1(V.OBJw(d, t, x, off, len)) == U32.to_nat(len) : Nat}:
  szl_c(U32.is_eq(len, 0), d, t, x, off, len, {==}, eo, hd, hw, hw32, pfw, hchk)
