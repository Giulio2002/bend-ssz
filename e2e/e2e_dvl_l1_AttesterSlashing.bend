        Nat.add(Nat.add(NRa(RT.xat_l1_AttesterSlashing(W, i0)), SUMN(q, W, 1n+i0)), NRa(RT.xat_l1_AttesterSlashing(W, Nat.add(i0, 1n+q)))),
        Equal.cong(Nat, Nat, z => Nat.add(NRa(RT.xat_l1_AttesterSlashing(W, i0)), z), SUMN(1n+q, W, 1n+i0), Nat.add(SUMN(q, W, 1n+i0), NRa(RT.xat_l1_AttesterSlashing(W, Nat.add(1n+i0, q)))), sumn_snoc(q, W, 1n+i0)),
        Equal.trans(Nat, Nat.add(NRa(RT.xat_l1_AttesterSlashing(W, i0)), Nat.add(SUMN(q, W, 1n+i0), NRa(RT.xat_l1_AttesterSlashing(W, Nat.add(1n+i0, q))))), Nat.add(Nat.add(NRa(RT.xat_l1_AttesterSlashing(W, i0)), SUMN(q, W, 1n+i0)), NRa(RT.xat_l1_AttesterSlashing(W, Nat.add(1n+i0, q)))),
          Nat.add(Nat.add(NRa(RT.xat_l1_AttesterSlashing(W, i0)), SUMN(q, W, 1n+i0)), NRa(RT.xat_l1_AttesterSlashing(W, Nat.add(i0, 1n+q)))),
          Equal.sym(Nat, Nat.add(Nat.add(NRa(RT.xat_l1_AttesterSlashing(W, i0)), SUMN(q, W, 1n+i0)), NRa(RT.xat_l1_AttesterSlashing(W, Nat.add(1n+i0, q)))), Nat.add(NRa(RT.xat_l1_AttesterSlashing(W, i0)), Nat.add(SUMN(q, W, 1n+i0), NRa(RT.xat_l1_AttesterSlashing(W, Nat.add(1n+i0, q))))),
            FD.nat__add_assoc(NRa(RT.xat_l1_AttesterSlashing(W, i0)), SUMN(q, W, 1n+i0), NRa(RT.xat_l1_AttesterSlashing(W, Nat.add(1n+i0, q))))),
          Equal.cong(Nat, Nat, n => Nat.add(Nat.add(NRa(RT.xat_l1_AttesterSlashing(W, i0)), SUMN(q, W, 1n+i0)), NRa(RT.xat_l1_AttesterSlashing(W, n))), Nat.add(1n+i0, q), Nat.add(i0, 1n+q),
            Equal.sym(Nat, Nat.add(i0, 1n+q), Nat.add(1n+i0, q), FD.nat__add_succ(i0, q)))))

def NXk(+k: Nat, +t: FD.array__Tree<U32>, +x: Nat, +len: U32, +i: U32) -> U32:
  match k:
    case 0n: len
    case 1n+q: V.WJ(t, x, i)

def him2(+q: Nat, +i: U32, +m: U32, +inv: {Nat.add(U32.to_nat(i), 2n+q) == U32.to_nat(m) : Nat}) -> {Nat.is_le(Nat.add(2n, U32.to_nat(i)), U32.to_nat(m)) == True{} : Bool}:
  FD.logic__subst(Nat, z => {Nat.is_le(Nat.add(2n, U32.to_nat(i)), z) == True{} : Bool}, Nat.add(U32.to_nat(i), 2n+q), U32.to_nat(m), inv,
    FD.logic__subst(Nat, z => {Nat.is_le(Nat.add(2n, U32.to_nat(i)), z) == True{} : Bool}, Nat.add(2n+q, U32.to_nat(i)), Nat.add(U32.to_nat(i), 2n+q), FD.nat__add_comm(2n+q, U32.to_nat(i)),
      A.le_skip(q, U32.to_nat(i))))

def i2_val(+q: Nat, +i: U32, +m: U32, +inv: {Nat.add(U32.to_nat(i), 2n+q) == U32.to_nat(m) : Nat}) -> {U32.to_nat(U32.add(i, 2)) == Nat.add(2n, U32.to_nat(i)) : Nat}:
  VVU.addk(i, 2, m, him2(q, i, m, inv))

def nxk(+q: Nat, +i: U32, +m: U32, +t: FD.array__Tree<U32>, +x: Nat, +len: U32, +inv: {Nat.add(U32.to_nat(i), 2n+q) == U32.to_nat(m) : Nat})
    -> {V.NX(U32.is_eq(U32.add(i, 2), m), t, x, len, U32.add(i, 1)) == NXk(q, t, x, len, U32.add(i, 1)) : U32}:
