        {Nat.add(NRa(RT.xat_l1_AttesterSlashing(W, i0)), _) == SUMN(1n+q, W, i0) : Nat}
      {==}

def sumn_snoc(+k: Nat, +W: List<&2, RT.MB<RT.M_AttesterSlashing>>, +i0: Nat)
    -> {SUMN(1n+k, W, i0) == Nat.add(SUMN(k, W, i0), NRa(RT.xat_l1_AttesterSlashing(W, Nat.add(i0, k)))) : Nat}:
