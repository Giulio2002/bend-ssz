    +e0: {o == FuluAttesterSlashing_d.AttesterSlashing{RT_L.pj_AttesterSlashing_0(o), RT_L.pj_AttesterSlashing_1(o)} : FuluAttesterSlashing_d.AttesterSlashing}, +eb1: {RT_L.pj_AttesterSlashing_0(o) == O.BSome{RT_L.pjb_IndexedAttestation_bx(RT_L.pj_AttesterSlashing_0(o)), O.BNone{}} : O.Boxed<FuluIndexedAttestation_d.IndexedAttestation>}, +eb2: {RT_L.pj_AttesterSlashing_1(o) == O.BSome{RT_L.pjb_IndexedAttestation_bx(RT_L.pj_AttesterSlashing_1(o)), O.BNone{}} : O.Boxed<FuluIndexedAttestation_d.IndexedAttestation>}, +ec1: {RT_L.pjb_IndexedAttestation_bx(RT_L.pj_AttesterSlashing_0(o)) == FuluIndexedAttestation_d.IndexedAttestation{RT_L.pj_IndexedAttestation_0(RT_L.pjb_IndexedAttestation_bx(RT_L.pj_AttesterSlashing_0(o))), x1_1, x2_1} : FuluIndexedAttestation_d.IndexedAttestation}, +ec2: {RT_L.pjb_IndexedAttestation_bx(RT_L.pj_AttesterSlashing_1(o)) == FuluIndexedAttestation_d.IndexedAttestation{RT_L.pj_IndexedAttestation_0(RT_L.pjb_IndexedAttestation_bx(RT_L.pj_AttesterSlashing_1(o))), x1_2, x2_2} : FuluIndexedAttestation_d.IndexedAttestation}, +wf1: LO.wfl(RT_L.pj_IndexedAttestation_0(RT_L.pjb_IndexedAttestation_bx(RT_L.pj_AttesterSlashing_0(o)))), +wf2: LO.wfl(RT_L.pj_IndexedAttestation_0(RT_L.pjb_IndexedAttestation_bx(RT_L.pj_AttesterSlashing_1(o))))) -> {Some{D.bytes(Pair.snd(FuluAttesterSlashing_d.AttesterSlashing, D.Digest, Pair.snd(B.Buf, FuluAttesterSlashing_d.AttesterSlashing & D.Digest, FuluAttesterSlashing_h.AttesterSlashing_hash_tree_root(h, o))))} == API.hash_tree_root(Spec.AttesterSlashing(), RT_L.v_AttesterSlashing(o)) : Maybe<&2, +List<U32>>}:
  match wf1:
    case Inl{w}:
      (+t1, w1) = w
      (+dw1, w2) = w1
      (+N1, w3) = w2
      (+ew1, w4) = w3
      s2(h, o, rep, x1_1, x2_1, x1_2, x2_2, t1, N1, e0, eb1, eb2, ec1, ec2, ew1, wf2)
    case Inr{w}:
      (+t1, w1) = w
      (+dw1, w2) = w1
      (+N1, w3) = w2
      (+q1, w4) = w3
      (+r1, w5) = w4
      (+ew1, w6) = w5
