# (iv)
def FuluAttesterSlashing_e2e_root(h: B.Buf, -o: FuluAttesterSlashing_d.AttesterSlashing, +rep: RT_L.rep_AttesterSlashing(o, Spec.AttesterSlashing())) -> {Some{D.bytes(Pair.snd(FuluAttesterSlashing_d.AttesterSlashing, D.Digest, Pair.snd(B.Buf, FuluAttesterSlashing_d.AttesterSlashing & D.Digest, FuluAttesterSlashing_h.AttesterSlashing_hash_tree_root(h, o))))} == API.hash_tree_root(Spec.AttesterSlashing(), RT_L.v_AttesterSlashing(o)) : Maybe<&2, +List<U32>>}:
  (+e0, +q) = rep
