# vec_uint64_8: decoding a byte list against END_TO_END's deserialize, through the view.
def vec_uint64_8_mv(m: Maybe<&1, O.Words>) -> Maybe<&2, S.Value>:
  match m:
    case None{}: None{}
    case Some{o}: Some{PK.vview8(o)}

