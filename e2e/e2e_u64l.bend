    Equal.trans(FD.array__Tree<U32>, FD.array__freeze(U32, FD.array__thaw(U32, a)), FD.array__freeze(U32, FD.array__thaw(U32, b)), b, e1, FD.array__freeze_thaw(U32, b)))

def weN(+a: FD.array__Tree<U32>, +n: U32, +b: FD.array__Tree<U32>, +m: U32, +e: {O.Words{FD.array__thaw(U32, a), n} == O.Words{FD.array__thaw(U32, b), m} : O.Words}) -> {n == m : U32}:
  Equal.cong(O.Words, U32, z => wN(z), O.Words{FD.array__thaw(U32, a), n}, O.Words{FD.array__thaw(U32, b), m}, e)

def SFT(+tt: FD.array__Tree<U32>, +n: U32, +K: Nat) -> Data:
  DK.P2({FD.array__perfect(U32, LDEP(U32, tt), tt) == True{} : Bool},
  DK.P2({Nat.is_lt(LDEP(U32, tt), K) == True{} : Bool},
  DK.P2({Nat.is_le(U32.to_nat(n), A.quad(VB.pw(LDEP(U32, tt)))) == True{} : Bool},
        {O.tail_zero(U32.and(n, 3), VB.slot(tt, VY.QL(n))) == True{} : Bool})))

