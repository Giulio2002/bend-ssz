# chunk items of the words from word 8 i on, when those words are V then anything
def it8(+q: Nat, +W: List<&2, U32>, +i: Nat, +V: List<&2, U32>, +R: List<&2, U32>, +h: {WS.wdrop(O.e8(i), W) == FD.spec_common__append(U32, V, R) : List<&2, U32>},
    +hl: {FD.spec_common__length(U32, V) == AV.m8(q) : Nat}) -> {WR.items(q, W, i) == AV.ch8(V) : S.Value}:
  match q:
    case 0n: it8z(W, i, V, hl)
    case 1n+ +p: it8s(p, W, i, V, R, h, hl, V2 => h2 => hl2 => it8(p, W, 1n+i, V2, R, h2, hl2))

def pvb(+l: FD.array__Tree<U32>, +rT: FD.array__Tree<U32>, +N: U32, +q: Nat, +ec: {O.chunks_of(N) == q : Nat}, +hl: {FD.spec_common__length(U32, FD.array__slots(U32, l)) == AV.m8(q) : Nat})
    -> {PV.pview(O.Words{ANode{FD.array__thaw(U32, l), FD.array__thaw(U32, rT)}, N}) == S.Sequence{AV.ch8(FD.array__slots(U32, l))} : S.Value}:
  +S2 = FD.array__slots(U32, FD.array__freeze(U32, FD.array__thaw(U32, rT)))
  Equal.trans(S.Value, S.Sequence{WR.items(O.chunks_of(N), FD.spec_common__append(U32, FD.array__slots(U32, FD.array__freeze(U32, FD.array__thaw(U32, l))), S2), 0n)}, S.Sequence{WR.items(q, FD.spec_common__append(U32, FD.array__slots(U32, l), S2), 0n)}, S.Sequence{AV.ch8(FD.array__slots(U32, l))},
    Equal.trans(S.Value, S.Sequence{WR.items(O.chunks_of(N), FD.spec_common__append(U32, FD.array__slots(U32, FD.array__freeze(U32, FD.array__thaw(U32, l))), S2), 0n)}, S.Sequence{WR.items(O.chunks_of(N), FD.spec_common__append(U32, FD.array__slots(U32, l), S2), 0n)}, S.Sequence{WR.items(q, FD.spec_common__append(U32, FD.array__slots(U32, l), S2), 0n)},
      Equal.cong(FD.array__Tree<U32>, S.Value, z => S.Sequence{WR.items(O.chunks_of(N), FD.spec_common__append(U32, FD.array__slots(U32, z), S2), 0n)}, FD.array__freeze(U32, FD.array__thaw(U32, l)), l, FD.array__freeze_thaw(U32, l)),
      Equal.cong(Nat, S.Value, z => S.Sequence{WR.items(z, FD.spec_common__append(U32, FD.array__slots(U32, l), S2), 0n)}, O.chunks_of(N), q, ec)),
    Equal.cong(S.Value, S.Value, z => S.Sequence{z}, WR.items(q, FD.spec_common__append(U32, FD.array__slots(U32, l), S2), 0n), AV.ch8(FD.array__slots(U32, l)),
      it8(q, FD.spec_common__append(U32, FD.array__slots(U32, l), S2), 0n, FD.array__slots(U32, l), S2, {==}, hl)))

def ck(+N: U32, +K: Nat, +ek: {U32.to_nat(N) == K : Nat}, +q: Nat, +h: {Nat.is_eq(Nat.div(Nat.add(K, 31n), 32n), q) == True{} : Bool}) -> {O.chunks_of(N) == q : Nat}:
  Equal.trans(Nat, O.chunks_of(N), Nat.div(Nat.add(K, 31n), 32n), q, Equal.cong(Nat, Nat, z => Nat.div(Nat.add(z, 31n), 32n), U32.to_nat(N), K, ek), FD.nat__eq_from_is_eq(Nat.div(Nat.add(K, 31n), 32n), q, h))

def lm(+d: Nat, +q: Nat, +h: {Nat.is_eq(FD.spec_common__pow2(d), AV.m8(q)) == True{} : Bool}, +l: FD.array__Tree<U32>, +pl: {FD.array__perfect(U32, d, l) == True{} : Bool})
    -> {FD.spec_common__length(U32, FD.array__slots(U32, l)) == AV.m8(q) : Nat}:
  Equal.trans(Nat, FD.spec_common__length(U32, FD.array__slots(U32, l)), FD.spec_common__pow2(d), AV.m8(q), FD.array__slots_length(U32, d, l, pl), FD.nat__eq_from_is_eq(FD.spec_common__pow2(d), AV.m8(q), h))


# the left spine of a perfect tree of depth d: its left-most leaf, then each level's right subtree
def lsp(+d: Nat, +t: FD.array__Tree<U32>) -> FD.array__Tree<U32>:
  match d:
    case 0n: FD.TLeaf{E3.leaf(t)}
    case 1n+ +p: FD.TNode{lsp(p, E3.lo(t)), E3.hi(t)}

def lspe(+d: Nat, +t: FD.array__Tree<U32>, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}) -> {t == lsp(d, t) : FD.array__Tree<U32>}:
  match d t:
    case 0n FD.TLeaf{+x}: {==}
    case 0n FD.TNode{l, r}: Empty.absurd({FD.TNode{l, r} == lsp(0n, FD.TNode{l, r}) : FD.array__Tree<U32>}, FD.logic__false_true(pf))
    case 1n+ +p FD.TLeaf{x}: Empty.absurd({FD.TLeaf{x} == lsp(1n+p, FD.TLeaf{x}) : FD.array__Tree<U32>}, FD.logic__false_true(pf))
    case 1n+ +p FD.TNode{+l, +r}:
      Equal.cong(FD.array__Tree<U32>, FD.array__Tree<U32>, z => FD.TNode{z, r}, l, lsp(p, l), lspe(p, l, FD.logic__and_left(FD.array__perfect(U32, p, l), FD.array__perfect(U32, p, r), pf)))

# the left spine of a perfect tree down to a literal depth-4 subtree
def lsp4(+d: Nat, +t: FD.array__Tree<U32>) -> FD.array__Tree<U32>:
  match d:
    case 0n: E3.tf(4n, t)
    case 1n+ +p: FD.TNode{lsp4(p, E3.lo(t)), E3.hi(t)}

def lsp4e(+d: Nat, +t: FD.array__Tree<U32>, +pf: {FD.array__perfect(U32, 4n+d, t) == True{} : Bool}) -> {t == lsp4(d, t) : FD.array__Tree<U32>}:
  match d t:
    case 0n +t0: E3.eta(4n, t0, pf)
    case 1n+ +p FD.TLeaf{x}: Empty.absurd({FD.TLeaf{x} == lsp4(1n+p, FD.TLeaf{x}) : FD.array__Tree<U32>}, FD.logic__false_true(pf))
    case 1n+ +p FD.TNode{+l, +r}:
      Equal.cong(FD.array__Tree<U32>, FD.array__Tree<U32>, z => FD.TNode{z, r}, l, lsp4(p, l), lsp4e(p, l, FD.logic__and_left(FD.array__perfect(U32, 4n+p, l), FD.array__perfect(U32, 4n+p, r), pf)))
