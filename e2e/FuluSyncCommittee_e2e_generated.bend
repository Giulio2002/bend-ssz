# The storage taken apart along its left spine as variables, one node per def (sc_nd: a perfect tree of depth
# 1 + p is a node of two of depth p): each step rewrites one variable by its node once, so sc_w is applied to
# variables and no E3.lo / E3.hi chain reaches a compared type.
def sc_nd(+p: Nat, +t: FD.array__Tree<U32>, +pf: {FD.array__perfect(U32, 1n+p, t) == True{} : Bool}) -> DK.Ex(FD.array__Tree<U32>, l => DK.Ex(FD.array__Tree<U32>, r => DK.P2({FD.array__perfect(U32, p, l) == True{} : Bool}, DK.P2({FD.array__perfect(U32, p, r) == True{} : Bool}, {t == FD.TNode{l, r} : FD.array__Tree<U32>})))):
  match t:
    case FD.TLeaf{x}: Empty.absurd(DK.Ex(FD.array__Tree<U32>, l => DK.Ex(FD.array__Tree<U32>, r => DK.P2({FD.array__perfect(U32, p, l) == True{} : Bool}, DK.P2({FD.array__perfect(U32, p, r) == True{} : Bool}, {FD.TLeaf{x} == FD.TNode{l, r} : FD.array__Tree<U32>})))), FD.logic__false_true(pf))
    case FD.TNode{+l, +r}: (l, (r, (FD.logic__and_left(FD.array__perfect(U32, p, l), FD.array__perfect(U32, p, r), pf), (FD.logic__and_right(FD.array__perfect(U32, p, l), FD.array__perfect(U32, p, r), pf), {==}))))

def sc_lf(+t: FD.array__Tree<U32>, +pf: {FD.array__perfect(U32, 0n, t) == True{} : Bool}) -> DK.Ex(U32, y => {t == FD.TLeaf{y} : FD.array__Tree<U32>}):
  match t:
    case FD.TLeaf{+y}: (y, {==})
    case FD.TNode{l, r}: Empty.absurd(DK.Ex(U32, y => {FD.TNode{l, r} == FD.TLeaf{y} : FD.array__Tree<U32>}), FD.logic__false_true(pf))

