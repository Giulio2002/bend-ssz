def bitlist_31_rt2(h: B.Buf, -o: O.Bits, +rep: BO.rep_bits(o, GS.bitlist_31()), +t: FD.array__Tree<U32>, +K: U32, +eo: {o == O.Bits{FD.array__thaw(U32, t), K} : O.Bits}) -> {Some{D.bytes(Pair.snd(O.Bits, D.Digest, Pair.snd(B.Buf, O.Bits & D.Digest, bitlist_31_h.bitlist_31_hash_tree_root(h, o))))} == API.hash_tree_root(GS.bitlist_31(), S.BitsValue{BO.bview(o)}) : Maybe<&2, +List<U32>>}:
  %Equal.sym(O.Bits, o, O.Bits{FD.array__thaw(U32, t), K}, eo) : {Some{D.bytes(Pair.snd(O.Bits, D.Digest, Pair.snd(B.Buf, O.Bits & D.Digest, bitlist_31_h.bitlist_31_hash_tree_root(h, _))))} == API.hash_tree_root(GS.bitlist_31(), S.BitsValue{BO.bview(_)}) : Maybe<&2, +List<U32>>}
  bitlist_31_rt1(h, t, K, FD.logic__subst(O.Bits, z => BO.rep_bits(z, GS.bitlist_31()), o, O.Bits{FD.array__thaw(U32, t), K}, eo, rep))

# (iv)
def bitlist_31_e2e_root(h: B.Buf, -o: O.Bits, +rep: BO.rep_bits(o, GS.bitlist_31())) -> {Some{D.bytes(Pair.snd(O.Bits, D.Digest, Pair.snd(B.Buf, O.Bits & D.Digest, bitlist_31_h.bitlist_31_hash_tree_root(h, o))))} == API.hash_tree_root(GS.bitlist_31(), S.BitsValue{BO.bview(o)}) : Maybe<&2, +List<U32>>}:
  (+wf, +q0) = rep
  match wf:
    case Inl{w}:
      (+t, w1) = w
      (+dw, w2) = w1
      (+K, w3) = w2
      (+eo, w4) = w3
      bitlist_31_rt2(h, o, rep, t, K, eo)
    case Inr{w}:
      (+t, w1) = w
      (+dw, w2) = w1
      (+K, w3) = w2
      (+q, w4) = w3
      (+r, w5) = w4
      (+eo, w6) = w5
      bitlist_31_rt2(h, o, rep, t, K, eo)

