# ---- the view: the decoded object's first NB bits are the value bits of its bytes ----

def alg3(+K: Nat, +X: Nat, +h: Nat) -> {Nat.add(Nat.add(K, X), h) == Nat.add(X, Nat.add(K, h)) : Nat}:
  Equal.trans(Nat, Nat.add(Nat.add(K, X), h), Nat.add(Nat.add(X, K), h), Nat.add(X, Nat.add(K, h)),
    Equal.cong(Nat, Nat, z => Nat.add(z, h), Nat.add(K, X), Nat.add(X, K), FD.nat__add_comm(K, X)), FD.nat__add_assoc(X, K, h))

law nwr1:
  for +K: Nat
  {C.nwn(Nat.add(1n, A.quad(K))) == 1n+K : Nat}
def nwr1(K):
  match K:
    case 0n: {==}
    case 1n+ +p: Equal.cong(Nat, Nat, z => 1n+z, C.nwn(Nat.add(1n, A.quad(p))), 1n+p, nwr1(p))

law nwr2:
  for +K: Nat
  {C.nwn(Nat.add(2n, A.quad(K))) == 1n+K : Nat}
def nwr2(K):
  match K:
    case 0n: {==}
    case 1n+ +p: Equal.cong(Nat, Nat, z => 1n+z, C.nwn(Nat.add(2n, A.quad(p))), 1n+p, nwr2(p))

law nwr3:
  for +K: Nat
  {C.nwn(Nat.add(3n, A.quad(K))) == 1n+K : Nat}
def nwr3(K):
  match K:
    case 0n: {==}
    case 1n+ +p: Equal.cong(Nat, Nat, z => 1n+z, C.nwn(Nat.add(3n, A.quad(p))), 1n+p, nwr3(p))

