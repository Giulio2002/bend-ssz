def vn0q(+r: Word(30n), +Qn: Nat, +eq: {Word.to_nat(30n, r) == Qn : Nat}, +dz: Nat, +M: FD.array__Tree<U32>, +NB: U32, +m: Nat, +h: Nat, +pf: {FD.array__perfect(U32, dz, M) == True{} : Bool}, +hdz: {Nat.is_lt(dz, 32n) == True{} : Bool}, +hh: {Nat.is_le(h, 7n) == True{} : Bool}, +eNB: {U32.to_nat(NB) == Nat.add(VSP.x8(m), h) : Nat}, +hN: {Nat.is_le(C.nwn(U32.to_nat(U32{WCon{False{}, WCon{False{}, r}}})), FD.spec_common__pow2(dz)) == True{} : Bool}, +hn3: {Nat.is_lt(Nat.add(3n, U32.to_nat(U32{WCon{False{}, WCon{False{}, r}}})), FD.spec_common__pow2(32n)) == True{} : Bool}, +e1: {U32.to_nat(U32{WCon{False{}, WCon{False{}, r}}}) == 1n+m : Nat})
    -> {BK.btk(U32.to_nat(NB), BK.bitsof(FD.array__slots(U32, FD.array__freeze(U32, O.clear_bit(O.mask_last(U32{WCon{False{}, WCon{False{}, r}}}, FD.array__thaw(U32, M)), NB))))) == BK.btk(U32.to_nat(NB), BK.bitsof(FD.array__slots(U32, M))) : +List<Bool>}:
  match Qn:
    case 0n: Empty.absurd({BK.btk(U32.to_nat(NB), BK.bitsof(FD.array__slots(U32, FD.array__freeze(U32, O.clear_bit(O.mask_last(U32{WCon{False{}, WCon{False{}, r}}}, FD.array__thaw(U32, M)), NB))))) == BK.btk(U32.to_nat(NB), BK.bitsof(FD.array__slots(U32, M))) : +List<Bool>}, FD.nat__succ_zero(m, Equal.sym(Nat, 0n, 1n+m, FD.logic__subst(Nat, z => {A.quad(z) == 1n+m : Nat}, Word.to_nat(30n, r), 0n, eq, e1))))
    case 1n+ +Q:
      +em = FD.nat__succ_inj(m, Nat.add(3n, A.quad(Q)), Equal.sym(Nat, A.quad(1n+Q), 1n+m, FD.logic__subst(Nat, z => {A.quad(z) == 1n+m : Nat}, Word.to_nat(30n, r), 1n+Q, eq, e1)))
      +eNB2 = Equal.trans(Nat, U32.to_nat(NB), Nat.add(VSP.x8(m), h), Nat.add(x32(Q), Nat.add(24n, h)), eNB,
        Equal.trans(Nat, Nat.add(VSP.x8(m), h), Nat.add(Nat.add(24n, x32(Q)), h), Nat.add(x32(Q), Nat.add(24n, h)),
          Equal.cong(Nat, Nat, z => Nat.add(z, h), VSP.x8(m), Nat.add(24n, x32(Q)),
            Equal.trans(Nat, VSP.x8(m), VSP.x8(Nat.add(3n, A.quad(Q))), Nat.add(24n, x32(Q)), Equal.cong(Nat, Nat, z => VSP.x8(z), m, Nat.add(3n, A.quad(Q)), em),
              Equal.cong(Nat, Nat, z => Nat.add(24n, z), VSP.x8(A.quad(Q)), x32(Q), x8q(Q)))),
          alg3(24n, x32(Q), h)))
      +hq = FD.nat__succ_le_lt(Q, FD.spec_common__pow2(dz), FD.logic__subst(Nat, z => {Nat.is_le(z, FD.spec_common__pow2(dz)) == True{} : Bool}, C.nwn(U32.to_nat(U32{WCon{False{}, WCon{False{}, r}}})), 1n+Q,
        Equal.trans(Nat, C.nwn(U32.to_nat(U32{WCon{False{}, WCon{False{}, r}}})), Word.to_nat(30n, r), 1n+Q, C.rq(Word.to_nat(30n, r)), eq), hN))
      vcore0(dz, M, U32{WCon{False{}, WCon{False{}, r}}}, NB, Q, h, pf, hdz, hh, Equal.sym(U32, U32{WCon{False{}, WCon{False{}, Word.zero(30n)}}}, U32.and(U32{WCon{False{}, WCon{False{}, r}}}, 3), BF.low_sel(False{}, False{}, r)), eNB2, hq)

# The first NB bits of the decoder's object (the last word masked to n bytes, bit NB cleared) are the
# first NB bits of its words, for NB = 8 m + h, n = 1 + m, h <= 7.
def vobj(+n: U32, +dz: Nat, +M: FD.array__Tree<U32>, +NB: U32, +m: Nat, +h: Nat, +pf: {FD.array__perfect(U32, dz, M) == True{} : Bool}, +hdz: {Nat.is_lt(dz, 32n) == True{} : Bool}, +hh: {Nat.is_le(h, 7n) == True{} : Bool}, +eNB: {U32.to_nat(NB) == Nat.add(VSP.x8(m), h) : Nat}, +hN: {Nat.is_le(C.nwn(U32.to_nat(n)), FD.spec_common__pow2(dz)) == True{} : Bool}, +hn3: {Nat.is_lt(Nat.add(3n, U32.to_nat(n)), FD.spec_common__pow2(32n)) == True{} : Bool}, +e1: {U32.to_nat(n) == 1n+m : Nat}) -> {BK.btk(U32.to_nat(NB), BK.bitsof(FD.array__slots(U32, FD.array__freeze(U32, O.clear_bit(O.mask_last(n, FD.array__thaw(U32, M)), NB))))) == BK.btk(U32.to_nat(NB), BK.bitsof(FD.array__slots(U32, M))) : +List<Bool>}:
  match n:
    case U32{WCon{False{}, WCon{False{}, +r}}}: vn0q(r, Word.to_nat(30n, r), {==}, dz, M, NB, m, h, pf, hdz, hh, eNB, hN, hn3, e1)
    case U32{WCon{True{}, WCon{False{}, +r}}}: vn1(r, dz, M, NB, m, h, pf, hdz, hh, eNB, hN, hn3, e1)
    case U32{WCon{False{}, WCon{True{}, +r}}}: vn2(r, dz, M, NB, m, h, pf, hdz, hh, eNB, hN, hn3, e1)
    case U32{WCon{True{}, WCon{True{}, +r}}}: vn3(r, dz, M, NB, m, h, pf, hdz, hh, eNB, hN, hn3, e1)

# ... and those are the value bits of the byte list VW = the first n bytes of the words, h the high bit of its last byte.
def vbits(+M: FD.array__Tree<U32>, +m: Nat, +h: Nat, +VW: +List<U32>, +hh: {Nat.is_le(h, 7n) == True{} : Bool},
    +ew: {VSP.bt(1n+m, SF.limbs(FD.array__slots(U32, M))) == VW : +List<U32>},
    +hl: {Nat.is_lt(m, List.length(&2, U32, SF.limbs(FD.array__slots(U32, M)))) == True{} : Bool},
    +hlv: {List.length(&2, U32, VW) == 1n+m : Nat}, +eh: {VY.hb(VBL.lastb(VW)) == h : Nat})
    -> {BK.btk(Nat.add(VSP.x8(m), h), BK.bitsof(FD.array__slots(U32, M))) == VBL.bl(VW) : +List<Bool>}:
  +LM = SF.limbs(FD.array__slots(U32, M))
  +hh8 = FD.nat__le_trans(h, 7n, 8n, hh, {==})
  +elast = Equal.trans(U32, VBL.lastb(VW), VBL.lastb(VSP.bt(1n+m, LM)), VBL.nthb(LM, m), Equal.cong(+List<U32>, U32, z => VBL.lastb(z), VW, VSP.bt(1n+m, LM), Equal.sym(+List<U32>, VSP.bt(1n+m, LM), VW, ew)), lbt(m, LM, hl))
  +ebt = Equal.trans(+List<U32>, VSP.bt(m, VW), VSP.bt(m, VSP.bt(1n+m, LM)), VSP.bt(m, LM), Equal.cong(+List<U32>, +List<U32>, z => VSP.bt(m, z), VW, VSP.bt(1n+m, LM), Equal.sym(+List<U32>, VSP.bt(1n+m, LM), VW, ew)), btbt(m, LM))
  %Equal.sym(+List<Bool>, BK.bitsof(FD.array__slots(U32, M)), bb(LM), wbb(FD.array__slots(U32, M))) : {BK.btk(Nat.add(VSP.x8(m), h), _) == VBL.bl(VW) : +List<Bool>}
  %Equal.sym(+List<Bool>, BK.btk(Nat.add(VSP.x8(m), h), bb(LM)), List.append(&2, Bool, bb(VSP.bt(m, LM)), BK.btk(h, VY.bits8(VBL.nthb(LM, m)))), bl1(m, h, LM, hh8, hl)) :
    {_ == VBL.bl(VW) : +List<Bool>}
  %Equal.sym(+List<Bool>, VBL.bl(VW), List.append(&2, Bool, bb(VSP.bt(m, VW)), BK.btk(VY.hb(VBL.lastb(VW)), VY.bits8(VBL.lastb(VW)))), bl2(m, VW, hlv)) : {List.append(&2, Bool, bb(VSP.bt(m, LM)), BK.btk(h, VY.bits8(VBL.nthb(LM, m)))) == _ : +List<Bool>}
  %Equal.sym(Nat, VY.hb(VBL.lastb(VW)), h, eh) : {List.append(&2, Bool, bb(VSP.bt(m, LM)), BK.btk(h, VY.bits8(VBL.nthb(LM, m)))) == List.append(&2, Bool, bb(VSP.bt(m, VW)), BK.btk(_, VY.bits8(VBL.lastb(VW)))) : +List<Bool>}
  %Equal.sym(U32, VBL.lastb(VW), VBL.nthb(LM, m), elast) : {List.append(&2, Bool, bb(VSP.bt(m, LM)), BK.btk(h, VY.bits8(VBL.nthb(LM, m)))) == List.append(&2, Bool, bb(VSP.bt(m, VW)), BK.btk(h, VY.bits8(_))) : +List<Bool>}
  %Equal.sym(+List<U32>, VSP.bt(m, VW), VSP.bt(m, LM), ebt) : {List.append(&2, Bool, bb(VSP.bt(m, LM)), BK.btk(h, VY.bits8(VBL.nthb(LM, m)))) == List.append(&2, Bool, bb(_), BK.btk(h, VY.bits8(VBL.nthb(LM, m)))) : +List<Bool>}
  {==}

# ---- the list storage's bytes: the decoder copied the window's words ----

law btle:
  for +k: Nat
  for +j: Nat
  for +X: +List<U32>
  for +h: {Nat.is_le(k, j) == True{} : Bool}
  {VSP.bt(k, VSP.bt(j, X)) == VSP.bt(k, X) : +List<U32>}
def btle(k, j, X, h):
  match k j X:
    case 0n _ _: {==}
    case 1n+ +p 0n _: Empty.absurd({VSP.bt(1n+p, VSP.bt(0n, X)) == VSP.bt(1n+p, X) : +List<U32>}, FD.logic__false_true(h))
    case 1n+ +p 1n+ +q Nil{}: {==}
    case 1n+ +p 1n+ +q Con{+v, +t}: Equal.cong(+List<U32>, +List<U32>, z => v <> z, VSP.bt(p, VSP.bt(q, t)), VSP.bt(p, t), btle(p, q, t, h))

# The first 1 + m = n bytes of the copied words are the window's.
def win(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +m: Nat, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hn: {Nat.is_le(U32.to_nat(n), A.quad(VB.pw(d))) == True{} : Bool}, +e1: {U32.to_nat(n) == 1n+m : Nat},
    +hNW: {VC.NW(n) == C.nwn(U32.to_nat(n)) : Nat}, +hr0: {Nat.is_le(Nat.add(VC.NW(n), 0n), VB.pw(VL.DZ(n))) == True{} : Bool})
    -> {VSP.bt(1n+m, SF.limbs(FD.array__slots(U32, VL.MMg(t, n)))) == VR.WB(t, 0n, 1n+m) : +List<U32>}:
  +NW = VC.NW(n)
  +s = FD.array__slots(U32, t)
  +Z = FD.array__slots(U32, VC.ZT(VL.DZ(n)))
  +LM = VB.lm(NW, 0n, 0n, Z, s)
  +eS = VB.slots_mone(NW, 0n, 0n, VL.DZ(n), VC.ZT(VL.DZ(n)), t, FD.array__trep_perfect(U32, VL.DZ(n), 0), hr0)
  +hz = FD.logic__subst(Nat, z => {Nat.is_le(Nat.add(NW, 0n), z) == True{} : Bool}, VB.pw(VL.DZ(n)), VB.len(Z),
    Equal.sym(Nat, VB.len(Z), VB.pw(VL.DZ(n)), FD.array__slots_length(U32, VL.DZ(n), VC.ZT(VL.DZ(n)), FD.array__trep_perfect(U32, VL.DZ(n), 0))), hr0)
  +hnw = FD.logic__subst(Nat, z => {Nat.is_le(z, VB.pw(d)) == True{} : Bool}, C.nwn(U32.to_nat(n)), NW, Equal.sym(Nat, NW, C.nwn(U32.to_nat(n)), hNW), C.nle(U32.to_nat(n), VB.pw(d), hn))
  +hsl = FD.logic__subst(Nat, z => {Nat.is_le(Nat.add(NW, 0n), z) == True{} : Bool}, VB.pw(d), VB.len(s), Equal.sym(Nat, VB.len(s), VB.pw(d), FD.array__slots_length(U32, d, t, pf)),
    FD.logic__subst(Nat, z => {Nat.is_le(z, VB.pw(d)) == True{} : Bool}, NW, Nat.add(NW, 0n), Equal.sym(Nat, Nat.add(NW, 0n), NW, FD.nat__add_zero(NW)), hnw))
  +ewin = VB.lm_win(NW, 0n, 0n, Z, s, hz, hsl)
  +hq = FD.logic__subst(Nat, z => {Nat.is_le(z, A.quad(NW)) == True{} : Bool}, U32.to_nat(n), 1n+m, e1,
    FD.logic__subst(Nat, z => {Nat.is_le(U32.to_nat(n), A.quad(z)) == True{} : Bool}, C.nwn(U32.to_nat(n)), NW, Equal.sym(Nat, NW, C.nwn(U32.to_nat(n)), hNW), C.ng(U32.to_nat(n))))
  %Equal.sym(List<&2, U32>, FD.array__slots(U32, VL.MMg(t, n)), LM, eS) : {VSP.bt(1n+m, SF.limbs(_)) == VR.WB(t, 0n, 1n+m) : +List<U32>}
  %btle(1n+m, A.quad(NW), SF.limbs(LM), hq) : {_ == VR.WB(t, 0n, 1n+m) : +List<U32>}
  %Equal.sym(+List<U32>, VSP.bt(A.quad(NW), SF.limbs(LM)), SF.limbs(VSP.wtake(NW, LM)), VSP.bt_limbs(NW, LM)) : {VSP.bt(1n+m, _) == VR.WB(t, 0n, 1n+m) : +List<U32>}
  %Equal.sym(List<&2, U32>, VSP.wtake(NW, LM), VSP.wtake(NW, s), ewin) : {VSP.bt(1n+m, SF.limbs(_)) == VR.WB(t, 0n, 1n+m) : +List<U32>}
  %VSP.bt_limbs(NW, s) : {VSP.bt(1n+m, _) == VR.WB(t, 0n, 1n+m) : +List<U32>}
  btle(1n+m, A.quad(NW), SF.limbs(s), hq)

# ---- the same for a window starting at word i0 (a bit list inside a container) ----

law wdre:
  for +k: Nat
  for +W: List<&2, U32>
  {VB.wdr(k, W) == VSP.wdr0(k, W) : List<&2, U32>}
def wdre(k, W):
  match k W:
    case 0n _: {==}
    case 1n+ +p Nil{}: {==}
    case 1n+ +p Con{+h, +t}: wdre(p, t)

law nwq:
  for +k: Nat
  for +x: Nat
  {C.nwn(Nat.add(A.quad(k), x)) == Nat.add(k, C.nwn(x)) : Nat}
def nwq(k, x):
  match k:
    case 0n: {==}
    case 1n+ +p: Equal.cong(Nat, Nat, z => 1n+z, C.nwn(Nat.add(A.quad(p), x)), Nat.add(p, C.nwn(x)), nwq(p, x))

def winG(+d: Nat, +t: FD.array__Tree<U32>, +L: U32, +i0: Nat, +m: Nat, +dz: Nat, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hw: {Nat.is_le(Nat.add(A.quad(i0), U32.to_nat(L)), A.quad(VB.pw(d))) == True{} : Bool}, +e1: {U32.to_nat(L) == 1n+m : Nat},
    +hNW: {VC.NW(L) == C.nwn(U32.to_nat(L)) : Nat}, +hr0: {Nat.is_le(Nat.add(VC.NW(L), 0n), VB.pw(dz)) == True{} : Bool})
    -> {VSP.bt(1n+m, SF.limbs(FD.array__slots(U32, VB.mone(VC.NW(L), i0, 0n, dz, VC.ZT(dz), t)))) == VR.WB(t, i0, 1n+m) : +List<U32>}:
  +NW = VC.NW(L)
  +s = FD.array__slots(U32, t)
  +Z = FD.array__slots(U32, VC.ZT(dz))
  +LM = VB.lm(NW, i0, 0n, Z, s)
  +eS = VB.slots_mone(NW, i0, 0n, dz, VC.ZT(dz), t, FD.array__trep_perfect(U32, dz, 0), hr0)
  +hz = FD.logic__subst(Nat, z => {Nat.is_le(Nat.add(NW, 0n), z) == True{} : Bool}, VB.pw(dz), VB.len(Z),
    Equal.sym(Nat, VB.len(Z), VB.pw(dz), FD.array__slots_length(U32, dz, VC.ZT(dz), FD.array__trep_perfect(U32, dz, 0))), hr0)
  +hq0 = C.nle(Nat.add(A.quad(i0), U32.to_nat(L)), VB.pw(d), hw)
  +hq1 = FD.logic__subst(Nat, z => {Nat.is_le(z, VB.pw(d)) == True{} : Bool}, C.nwn(Nat.add(A.quad(i0), U32.to_nat(L))), Nat.add(NW, i0),
    Equal.trans(Nat, C.nwn(Nat.add(A.quad(i0), U32.to_nat(L))), Nat.add(i0, C.nwn(U32.to_nat(L))), Nat.add(NW, i0), nwq(i0, U32.to_nat(L)),
      Equal.trans(Nat, Nat.add(i0, C.nwn(U32.to_nat(L))), Nat.add(C.nwn(U32.to_nat(L)), i0), Nat.add(NW, i0), FD.nat__add_comm(i0, C.nwn(U32.to_nat(L))),
        Equal.cong(Nat, Nat, z => Nat.add(z, i0), C.nwn(U32.to_nat(L)), NW, Equal.sym(Nat, NW, C.nwn(U32.to_nat(L)), hNW)))), hq0)
  +hsl = FD.logic__subst(Nat, z => {Nat.is_le(Nat.add(NW, i0), z) == True{} : Bool}, VB.pw(d), VB.len(s), Equal.sym(Nat, VB.len(s), VB.pw(d), FD.array__slots_length(U32, d, t, pf)), hq1)
  +ewin = VB.lm_win(NW, i0, 0n, Z, s, hz, hsl)
  +hq = FD.logic__subst(Nat, z => {Nat.is_le(z, A.quad(NW)) == True{} : Bool}, U32.to_nat(L), 1n+m, e1,
    FD.logic__subst(Nat, z => {Nat.is_le(U32.to_nat(L), A.quad(z)) == True{} : Bool}, C.nwn(U32.to_nat(L)), NW, Equal.sym(Nat, NW, C.nwn(U32.to_nat(L)), hNW), C.ng(U32.to_nat(L))))
  %Equal.sym(List<&2, U32>, FD.array__slots(U32, VB.mone(NW, i0, 0n, dz, VC.ZT(dz), t)), LM, eS) : {VSP.bt(1n+m, SF.limbs(_)) == VR.WB(t, i0, 1n+m) : +List<U32>}
  %btle(1n+m, A.quad(NW), SF.limbs(LM), hq) : {_ == VR.WB(t, i0, 1n+m) : +List<U32>}
  %Equal.sym(+List<U32>, VSP.bt(A.quad(NW), SF.limbs(LM)), SF.limbs(VSP.wtake(NW, LM)), VSP.bt_limbs(NW, LM)) : {VSP.bt(1n+m, _) == VR.WB(t, i0, 1n+m) : +List<U32>}
  %Equal.sym(List<&2, U32>, VSP.wtake(NW, LM), VSP.wtake(NW, VB.wdr(i0, s)), ewin) : {VSP.bt(1n+m, SF.limbs(_)) == VR.WB(t, i0, 1n+m) : +List<U32>}
  %VSP.bt_limbs(NW, VB.wdr(i0, s)) : {VSP.bt(1n+m, _) == VR.WB(t, i0, 1n+m) : +List<U32>}
  %Equal.sym(+List<U32>, VSP.bt(1n+m, VSP.bt(A.quad(NW), SF.limbs(VB.wdr(i0, s)))), VSP.bt(1n+m, SF.limbs(VB.wdr(i0, s))), btle(1n+m, A.quad(NW), SF.limbs(VB.wdr(i0, s)), hq)) : {_ == VR.WB(t, i0, 1n+m) : +List<U32>}
  %Equal.sym(List<&2, U32>, VB.wdr(i0, s), VSP.wdr0(i0, s), wdre(i0, s)) : {VSP.bt(1n+m, SF.limbs(_)) == VR.WB(t, i0, 1n+m) : +List<U32>}
  %VSP.bdr_limbs(i0, s) : {VSP.bt(1n+m, _) == VR.WB(t, i0, 1n+m) : +List<U32>}
  {==}
