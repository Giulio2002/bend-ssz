  %Equal.sym(Bool, Bool.and(a22, True{}), a22, andT(a22)) : {a0 <> a1 <> a2 <> a3 <> a4 <> a5 <> a6 <> a7 <> a8 <> a9 <> a10 <> a11 <> a12 <> a13 <> a14 <> a15 <> a16 <> a17 <> a18 <> a19 <> a20 <> a21 <> a22 <> a23 <> a24 <> a25 <> a26 <> a27 <> a28 <> a29 <> a30 <> a31 <> R == a0 <> a1 <> a2 <> a3 <> a4 <> a5 <> a6 <> a7 <> a8 <> a9 <> a10 <> a11 <> a12 <> a13 <> a14 <> a15 <> a16 <> a17 <> a18 <> a19 <> a20 <> a21 <> _ <> Bool.and(a23, True{}) <> a24 <> a25 <> a26 <> a27 <> a28 <> a29 <> a30 <> a31 <> R : +List<Bool>}
  %Equal.sym(Bool, Bool.and(a23, True{}), a23, andT(a23)) : {a0 <> a1 <> a2 <> a3 <> a4 <> a5 <> a6 <> a7 <> a8 <> a9 <> a10 <> a11 <> a12 <> a13 <> a14 <> a15 <> a16 <> a17 <> a18 <> a19 <> a20 <> a21 <> a22 <> a23 <> a24 <> a25 <> a26 <> a27 <> a28 <> a29 <> a30 <> a31 <> R == a0 <> a1 <> a2 <> a3 <> a4 <> a5 <> a6 <> a7 <> a8 <> a9 <> a10 <> a11 <> a12 <> a13 <> a14 <> a15 <> a16 <> a17 <> a18 <> a19 <> a20 <> a21 <> a22 <> _ <> a24 <> a25 <> a26 <> a27 <> a28 <> a29 <> a30 <> a31 <> R : +List<Bool>}
  {==}
def bb(bs: +List<U32>) -> +List<Bool>:
  match bs:
    case Nil{}: []
    case Con{+h, t}: List.append(&2, Bool, VY.bits8(h), bb(t))

# A word's 32 bits, then R, are its four bytes' bits, then R.
def wbx(+x: U32, +R: +List<Bool>) -> {List.append(&2, Bool, BLf.wbits(x), R) == List.append(&2, Bool, VY.bits8(U32.and(x, 255)), List.append(&2, Bool, VY.bits8(U32.and(U32.shrn(x, 8n), 255)), List.append(&2, Bool, VY.bits8(U32.and(U32.shrn(x, 16n), 255)), List.append(&2, Bool, VY.bits8(U32.shrn(x, 24n)), R)))) : +List<Bool>}:
  match x:
    case U32{WCon{+a0, WCon{+a1, WCon{+a2, WCon{+a3, WCon{+a4, WCon{+a5, WCon{+a6, WCon{+a7, WCon{+a8, WCon{+a9, WCon{+a10, WCon{+a11, WCon{+a12, WCon{+a13, WCon{+a14, WCon{+a15, WCon{+a16, WCon{+a17, WCon{+a18, WCon{+a19, WCon{+a20, WCon{+a21, WCon{+a22, WCon{+a23, WCon{+a24, WCon{+a25, WCon{+a26, WCon{+a27, WCon{+a28, WCon{+a29, WCon{+a30, WCon{+a31, WNil{}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}: wbc(a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15, a16, a17, a18, a19, a20, a21, a22, a23, a24, a25, a26, a27, a28, a29, a30, a31, R)

law wbb:
  for +ws: +List<U32>
  {BK.bitsof(ws) == bb(SF.limbs(ws)) : +List<Bool>}
def wbb(ws):
  match ws:
    case Nil{}: {==}
    case Con{+x, +t}:
      %Equal.sym(+List<Bool>, BK.bitsof(t), bb(SF.limbs(t)), wbb(t)) : {List.append(&2, Bool, BLf.wbits(x), _) == bb(SF.limbs(Con{x, t})) : +List<Bool>}
      wbx(x, bb(SF.limbs(t)))

def b8len(+v: U32) -> {List.length(&2, Bool, VY.bits8(v)) == 8n : Nat}:
  match v:
    case U32{WCon{+a0, WCon{+a1, WCon{+a2, WCon{+a3, WCon{+a4, WCon{+a5, WCon{+a6, WCon{+a7, WCon{+a8, WCon{+a9, WCon{+a10, WCon{+a11, WCon{+a12, WCon{+a13, WCon{+a14, WCon{+a15, WCon{+a16, WCon{+a17, WCon{+a18, WCon{+a19, WCon{+a20, WCon{+a21, WCon{+a22, WCon{+a23, WCon{+a24, WCon{+a25, WCon{+a26, WCon{+a27, WCon{+a28, WCon{+a29, WCon{+a30, WCon{+a31, WNil{}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}: {==}

law vbk:
  for +k: Nat
  for +xs: +List<Bool>
  {VY.btk(k, xs) == BK.btk(k, xs) : +List<Bool>}
def vbk(k, xs):
  match k xs:
    case 0n _: {==}
    case 1n+ +p Nil{}: {==}
    case 1n+ +p Con{+b, +t}: Equal.cong(+List<Bool>, +List<Bool>, z => b <> z, VY.btk(p, t), BK.btk(p, t), vbk(p, t))

law btbt:
  for +m: Nat
  for +L: +List<U32>
  {VSP.bt(m, VSP.bt(1n+m, L)) == VSP.bt(m, L) : +List<U32>}
def btbt(m, L):
  match m L:
    case 0n _: {==}
    case 1n+ +k Nil{}: {==}
    case 1n+ +k Con{+v, +t}: Equal.cong(+List<U32>, +List<U32>, z => v <> z, VSP.bt(k, VSP.bt(1n+k, t)), VSP.bt(k, t), btbt(k, t))

law lbt:
  for +m: Nat
  for +L: +List<U32>
  for +hm: {Nat.is_lt(m, List.length(&2, U32, L)) == True{} : Bool}
  {VBL.lastb(VSP.bt(1n+m, L)) == VBL.nthb(L, m) : U32}
def lbt(m, L, hm):
  match m L:
    case _ Nil{}: Empty.absurd({VBL.lastb(VSP.bt(1n+m, Nil{})) == VBL.nthb(Nil{}, m) : U32}, FD.nat__lt_zero_absurd(m, hm))
    case 0n Con{+v, +t}: {==}
    case 1n+ +k Con{+v, Nil{}}: Empty.absurd({VBL.lastb(VSP.bt(2n+k, Con{v, Nil{}})) == VBL.nthb(Con{v, Nil{}}, 1n+k) : U32}, FD.nat__lt_zero_absurd(k, hm))
    case 1n+ +k Con{+v, Con{+w, +r}}: lbt(k, Con{w, r}, hm)

# The first 8 m + h bits (h <= 8) of a byte list: its first m bytes' bits, then h bits of byte m.
law bl1:
  for +m: Nat
  for +h: Nat
  for +L: +List<U32>
  for +hh: {Nat.is_le(h, 8n) == True{} : Bool}
  for +hm: {Nat.is_lt(m, List.length(&2, U32, L)) == True{} : Bool}
  {BK.btk(Nat.add(VSP.x8(m), h), bb(L)) == List.append(&2, Bool, bb(VSP.bt(m, L)), BK.btk(h, VY.bits8(VBL.nthb(L, m)))) : +List<Bool>}
def bl1(m, h, L, hh, hm):
  match m L:
    case _ Nil{}: Empty.absurd({BK.btk(Nat.add(VSP.x8(m), h), bb(Nil{})) == List.append(&2, Bool, bb(VSP.bt(m, Nil{})), BK.btk(h, VY.bits8(VBL.nthb(Nil{}, m)))) : +List<Bool>}, FD.nat__lt_zero_absurd(m, hm))
    case 0n Con{+v, +t}:
      btk_le(h, VY.bits8(v), bb(t), FD.logic__subst(Nat, z => {Nat.is_le(h, z) == True{} : Bool}, 8n, List.length(&2, Bool, VY.bits8(v)), Equal.sym(Nat, List.length(&2, Bool, VY.bits8(v)), 8n, b8len(v)), hh))
    case 1n+ +k Con{+v, +t}:
      +K = Nat.add(VSP.x8(k), h)
      %b8len(v) : {BK.btk(Nat.add(_, K), List.append(&2, Bool, VY.bits8(v), bb(t))) == List.append(&2, Bool, List.append(&2, Bool, VY.bits8(v), bb(VSP.bt(k, t))), BK.btk(h, VY.bits8(VBL.nthb(t, k)))) : +List<Bool>}
      %Equal.sym(+List<Bool>, BK.btk(Nat.add(List.length(&2, Bool, VY.bits8(v)), K), List.append(&2, Bool, VY.bits8(v), bb(t))), List.append(&2, Bool, VY.bits8(v), BK.btk(K, bb(t))), btk_ge(VY.bits8(v), bb(t), K)) :
        {_ == List.append(&2, Bool, List.append(&2, Bool, VY.bits8(v), bb(VSP.bt(k, t))), BK.btk(h, VY.bits8(VBL.nthb(t, k)))) : +List<Bool>}
      %Equal.sym(+List<Bool>, List.append(&2, Bool, List.append(&2, Bool, VY.bits8(v), bb(VSP.bt(k, t))), BK.btk(h, VY.bits8(VBL.nthb(t, k)))), List.append(&2, Bool, VY.bits8(v), List.append(&2, Bool, bb(VSP.bt(k, t)), BK.btk(h, VY.bits8(VBL.nthb(t, k))))), VBL.appB_assoc(VY.bits8(v), bb(VSP.bt(k, t)), BK.btk(h, VY.bits8(VBL.nthb(t, k))))) :
        {List.append(&2, Bool, VY.bits8(v), BK.btk(K, bb(t))) == _ : +List<Bool>}
      Equal.cong(+List<Bool>, +List<Bool>, z => List.append(&2, Bool, VY.bits8(v), z), BK.btk(K, bb(t)), List.append(&2, Bool, bb(VSP.bt(k, t)), BK.btk(h, VY.bits8(VBL.nthb(t, k)))), bl1(k, h, t, hh, hm))

# The value bits of a byte list of length 1 + m: its first m bytes' bits, then the last byte's cut at its high bit.
law bl2:
  for +m: Nat
  for +bs: +List<U32>
  for +hl: {List.length(&2, U32, bs) == 1n+m : Nat}
  {VBL.bl(bs) == List.append(&2, Bool, bb(VSP.bt(m, bs)), BK.btk(VY.hb(VBL.lastb(bs)), VY.bits8(VBL.lastb(bs)))) : +List<Bool>}
def bl2(m, bs, hl):
  match m bs:
    case _ Nil{}: Empty.absurd({VBL.bl(Nil{}) == List.append(&2, Bool, bb(VSP.bt(m, Nil{})), BK.btk(VY.hb(VBL.lastb(Nil{})), VY.bits8(VBL.lastb(Nil{})))) : +List<Bool>}, FD.nat__succ_zero(m, Equal.sym(Nat, 0n, 1n+m, hl)))
    case 0n Con{+v, Nil{}}: vbk(VY.hb(v), VY.bits8(v))
    case 0n Con{+v, Con{+w, +r}}: Empty.absurd({VBL.bl(Con{v, Con{w, r}}) == List.append(&2, Bool, bb(VSP.bt(0n, Con{v, Con{w, r}})), BK.btk(VY.hb(VBL.lastb(Con{v, Con{w, r}})), VY.bits8(VBL.lastb(Con{v, Con{w, r}})))) : +List<Bool>}, FD.nat__succ_zero(List.length(&2, U32, r), FD.nat__succ_inj(1n+List.length(&2, U32, r), 0n, hl)))
    case 1n+ +k Con{+v, Nil{}}: Empty.absurd({VBL.bl(Con{v, Nil{}}) == List.append(&2, Bool, bb(VSP.bt(1n+k, Con{v, Nil{}})), BK.btk(VY.hb(VBL.lastb(Con{v, Nil{}})), VY.bits8(VBL.lastb(Con{v, Nil{}})))) : +List<Bool>}, FD.nat__succ_zero(k, Equal.sym(Nat, 0n, 1n+k, FD.nat__succ_inj(0n, 1n+k, hl))))
    case 1n+ +k Con{+v, Con{+w, +r}}:
      +Y = BK.btk(VY.hb(VBL.lastb(Con{w, r})), VY.bits8(VBL.lastb(Con{w, r})))
      %Equal.sym(+List<Bool>, List.append(&2, Bool, List.append(&2, Bool, VY.bits8(v), bb(VSP.bt(k, Con{w, r}))), Y), List.append(&2, Bool, VY.bits8(v), List.append(&2, Bool, bb(VSP.bt(k, Con{w, r})), Y)), VBL.appB_assoc(VY.bits8(v), bb(VSP.bt(k, Con{w, r})), Y)) :
        {List.append(&2, Bool, VY.bits8(v), VBL.bl(Con{w, r})) == _ : +List<Bool>}
      Equal.cong(+List<Bool>, +List<Bool>, z => List.append(&2, Bool, VY.bits8(v), z), VBL.bl(Con{w, r}), List.append(&2, Bool, bb(VSP.bt(k, Con{w, r})), Y), bl2(k, Con{w, r}, FD.nat__succ_inj(List.length(&2, U32, Con{w, r}), 1n+k, hl)))

# ---- the decoder's object: the last word masked, then the delimiter bit cleared ----

def pk7(c: Bool, +x: U32, +y: U32, +hx: {Nat.is_le(U32.to_nat(x), 7n) == True{} : Bool}, +hy: {Nat.is_le(U32.to_nat(y), 7n) == True{} : Bool})
    -> {Nat.is_le(U32.to_nat(O.pick(c, x, y)), 7n) == True{} : Bool}:
  match c:
    case True{}: hx
    case False{}: hy

def hb7(+v: U32) -> {Nat.is_le(VY.hb(v), 7n) == True{} : Bool}:
  pk7(U32.is_ge(v, 128), 7, O.pick(U32.is_ge(v, 64), 6, O.pick(U32.is_ge(v, 32), 5, O.pick(U32.is_ge(v, 16), 4, O.pick(U32.is_ge(v, 8), 3, O.pick(U32.is_ge(v, 4), 2, O.pick(U32.is_ge(v, 2), 1, 0)))))), {==},
    pk7(U32.is_ge(v, 64), 6, O.pick(U32.is_ge(v, 32), 5, O.pick(U32.is_ge(v, 16), 4, O.pick(U32.is_ge(v, 8), 3, O.pick(U32.is_ge(v, 4), 2, O.pick(U32.is_ge(v, 2), 1, 0))))), {==},
      pk7(U32.is_ge(v, 32), 5, O.pick(U32.is_ge(v, 16), 4, O.pick(U32.is_ge(v, 8), 3, O.pick(U32.is_ge(v, 4), 2, O.pick(U32.is_ge(v, 2), 1, 0)))), {==},
        pk7(U32.is_ge(v, 16), 4, O.pick(U32.is_ge(v, 8), 3, O.pick(U32.is_ge(v, 4), 2, O.pick(U32.is_ge(v, 2), 1, 0))), {==},
          pk7(U32.is_ge(v, 8), 3, O.pick(U32.is_ge(v, 4), 2, O.pick(U32.is_ge(v, 2), 1, 0)), {==},
            pk7(U32.is_ge(v, 4), 2, O.pick(U32.is_ge(v, 2), 1, 0), {==}, pk7(U32.is_ge(v, 2), 1, 0, {==}, {==})))))))

def s5z(+p: Nat, +hp: {Nat.is_lt(p, 32n) == True{} : Bool}) -> {VD.s_rng(5n, p) == 0n : Nat}:
  FD.nat__le_antisym(VD.s_rng(5n, p), 0n, C.rgm(5n, p, 31n, FD.nat__lt_succ_le(p, 31n, hp)), FD.nat__zero_le(VD.s_rng(5n, p)))

law s5q:
  for +Q: Nat
  for +p: Nat
  for +hp: {Nat.is_lt(p, 32n) == True{} : Bool}
  {VD.s_rng(5n, Nat.add(x32(Q), p)) == Q : Nat}
def s5q(Q, p, hp):
  match Q:
    case 0n: s5z(p, hp)
    case 1n+ +k: Equal.cong(Nat, Nat, z => 1n+z, VD.s_rng(5n, Nat.add(x32(k), p)), k, s5q(k, p, hp))

law x8q:
  for +Q: Nat
  {VSP.x8(A.quad(Q)) == x32(Q) : Nat}
def x8q(Q):
  match Q:
    case 0n: {==}
    case 1n+ +k: Equal.cong(Nat, Nat, z => 32n+z, VSP.x8(A.quad(k)), x32(k), x8q(k))

# n & 3 = 1: word Q keeps its first 1 byte; the delimiter bit is 32 Q + 0 + h.
def vcore1(+dz: Nat, +M: FD.array__Tree<U32>, +n: U32, +NB: U32, +Q: Nat, +h: Nat, +pf: {FD.array__perfect(U32, dz, M) == True{} : Bool},
    +hdz: {Nat.is_lt(dz, 32n) == True{} : Bool}, +hh: {Nat.is_le(h, 7n) == True{} : Bool}, +eand: {U32.and(n, 3) == U32{WCon{True{}, WCon{False{}, Word.zero(30n)}}} : U32},
    +ei: {U32.to_nat(U32.sub(U32.shrn((n + 3 : U32), 2n), 1)) == Q : Nat}, +eNB: {U32.to_nat(NB) == Nat.add(x32(Q), Nat.add(0n, h)) : Nat},
    +hq: {Nat.is_lt(Q, FD.spec_common__pow2(dz)) == True{} : Bool})
    -> {BK.btk(U32.to_nat(NB), BK.bitsof(FD.array__slots(U32, FD.array__freeze(U32, O.clear_bit(O.mask_last(n, FD.array__thaw(U32, M)), NB))))) == BK.btk(U32.to_nat(NB), BK.bitsof(FD.array__slots(U32, M))) : +List<Bool>}:
  +i = U32.sub(U32.shrn((n + 3 : U32), 2n), 1)
  +ML = mlt(False{}, U32{WCon{True{}, WCon{False{}, Word.zero(30n)}}}, Q, dz, M)
  +hp = FD.nat__le_trans(Nat.add(0n, h), 7n, 32n, Order.add_left(0n, h, 7n, hh), {==})
  +hp8 = FD.nat__le_trans(Nat.add(0n, h), 7n, 8n, Order.add_left(0n, h, 7n, hh), {==})
  +hp32 = FD.nat__le_lt_trans(Nat.add(0n, h), 7n, 32n, Order.add_left(0n, h, 7n, hh), {==})
  +e5 = Equal.trans(Nat, U32.to_nat(U32.shrn(NB, 5n)), VD.s_rng(5n, U32.to_nat(NB)), Q, VD.shrk(5n, NB),
    Equal.trans(Nat, VD.s_rng(5n, U32.to_nat(NB)), VD.s_rng(5n, Nat.add(x32(Q), Nat.add(0n, h))), Q, Equal.cong(Nat, Nat, z => VD.s_rng(5n, z), U32.to_nat(NB), Nat.add(x32(Q), Nat.add(0n, h)), eNB), s5q(Q, Nat.add(0n, h), hp32)))
  +hq5 = FD.logic__subst(Nat, z => {Nat.is_lt(z, FD.spec_common__pow2(dz)) == True{} : Bool}, Q, U32.to_nat(U32.shrn(NB, 5n)), Equal.sym(Nat, U32.to_nat(U32.shrn(NB, 5n)), Q, e5), hq)
  %Equal.sym(U32, U32.and(n, 3), U32{WCon{True{}, WCon{False{}, Word.zero(30n)}}}, eand) :
    {BK.btk(U32.to_nat(NB), BK.bitsof(FD.array__slots(U32, FD.array__freeze(U32, O.clear_bit(O.ml_go(U32.is_eq(_, 0), _, i, FD.array__thaw(U32, M)), NB))))) == BK.btk(U32.to_nat(NB), BK.bitsof(FD.array__slots(U32, M))) : +List<Bool>}
  %Equal.sym(Array<U32>, O.ml_go(False{}, U32{WCon{True{}, WCon{False{}, Word.zero(30n)}}}, i, FD.array__thaw(U32, M)), FD.array__thaw(U32, ML), mlg(False{}, U32{WCon{True{}, WCon{False{}, Word.zero(30n)}}}, i, Q, dz, M, pf, hdz, ei, hq)) :
    {BK.btk(U32.to_nat(NB), BK.bitsof(FD.array__slots(U32, FD.array__freeze(U32, O.clear_bit(_, NB))))) == BK.btk(U32.to_nat(NB), BK.bitsof(FD.array__slots(U32, M))) : +List<Bool>}
  +e1 = clr(dz, ML, NB, mlp(False{}, U32{WCon{True{}, WCon{False{}, Word.zero(30n)}}}, Q, dz, M, pf), hdz, hq5)
  +e2 = mlb(U32{WCon{True{}, WCon{False{}, Word.zero(30n)}}}, Q, Nat.add(0n, h), dz, M, pf, hq, hp, kp1(FD.flat__nthc(FD.array__slots(U32, M), Q), Nat.add(0n, h), hp8))
  %Equal.sym(Nat, U32.to_nat(NB), Nat.add(x32(Q), Nat.add(0n, h)), eNB) :
    {BK.btk(U32.to_nat(NB), BK.bitsof(FD.array__slots(U32, FD.array__freeze(U32, O.clear_bit(FD.array__thaw(U32, ML), NB))))) == BK.btk(_, BK.bitsof(FD.array__slots(U32, M))) : +List<Bool>}
  Equal.trans(+List<Bool>, BK.btk(U32.to_nat(NB), BK.bitsof(FD.array__slots(U32, FD.array__freeze(U32, O.clear_bit(FD.array__thaw(U32, ML), NB))))), BK.btk(U32.to_nat(NB), BK.bitsof(FD.array__slots(U32, ML))), BK.btk(Nat.add(x32(Q), Nat.add(0n, h)), BK.bitsof(FD.array__slots(U32, M))), e1,
    FD.logic__subst(Nat, z => {BK.btk(z, BK.bitsof(FD.array__slots(U32, ML))) == BK.btk(Nat.add(x32(Q), Nat.add(0n, h)), BK.bitsof(FD.array__slots(U32, M))) : +List<Bool>}, Nat.add(x32(Q), Nat.add(0n, h)), U32.to_nat(NB), Equal.sym(Nat, U32.to_nat(NB), Nat.add(x32(Q), Nat.add(0n, h)), eNB), e2))

# n & 3 = 2: word Q keeps its first 2 bytes; the delimiter bit is 32 Q + 8 + h.
def vcore2(+dz: Nat, +M: FD.array__Tree<U32>, +n: U32, +NB: U32, +Q: Nat, +h: Nat, +pf: {FD.array__perfect(U32, dz, M) == True{} : Bool},
    +hdz: {Nat.is_lt(dz, 32n) == True{} : Bool}, +hh: {Nat.is_le(h, 7n) == True{} : Bool}, +eand: {U32.and(n, 3) == U32{WCon{False{}, WCon{True{}, Word.zero(30n)}}} : U32},
    +ei: {U32.to_nat(U32.sub(U32.shrn((n + 3 : U32), 2n), 1)) == Q : Nat}, +eNB: {U32.to_nat(NB) == Nat.add(x32(Q), Nat.add(8n, h)) : Nat},
    +hq: {Nat.is_lt(Q, FD.spec_common__pow2(dz)) == True{} : Bool})
    -> {BK.btk(U32.to_nat(NB), BK.bitsof(FD.array__slots(U32, FD.array__freeze(U32, O.clear_bit(O.mask_last(n, FD.array__thaw(U32, M)), NB))))) == BK.btk(U32.to_nat(NB), BK.bitsof(FD.array__slots(U32, M))) : +List<Bool>}:
  +i = U32.sub(U32.shrn((n + 3 : U32), 2n), 1)
  +ML = mlt(False{}, U32{WCon{False{}, WCon{True{}, Word.zero(30n)}}}, Q, dz, M)
  +hp = FD.nat__le_trans(Nat.add(8n, h), 15n, 32n, Order.add_left(8n, h, 7n, hh), {==})
  +hp8 = FD.nat__le_trans(Nat.add(8n, h), 15n, 16n, Order.add_left(8n, h, 7n, hh), {==})
  +hp32 = FD.nat__le_lt_trans(Nat.add(8n, h), 15n, 32n, Order.add_left(8n, h, 7n, hh), {==})
  +e5 = Equal.trans(Nat, U32.to_nat(U32.shrn(NB, 5n)), VD.s_rng(5n, U32.to_nat(NB)), Q, VD.shrk(5n, NB),
    Equal.trans(Nat, VD.s_rng(5n, U32.to_nat(NB)), VD.s_rng(5n, Nat.add(x32(Q), Nat.add(8n, h))), Q, Equal.cong(Nat, Nat, z => VD.s_rng(5n, z), U32.to_nat(NB), Nat.add(x32(Q), Nat.add(8n, h)), eNB), s5q(Q, Nat.add(8n, h), hp32)))
  +hq5 = FD.logic__subst(Nat, z => {Nat.is_lt(z, FD.spec_common__pow2(dz)) == True{} : Bool}, Q, U32.to_nat(U32.shrn(NB, 5n)), Equal.sym(Nat, U32.to_nat(U32.shrn(NB, 5n)), Q, e5), hq)
  %Equal.sym(U32, U32.and(n, 3), U32{WCon{False{}, WCon{True{}, Word.zero(30n)}}}, eand) :
    {BK.btk(U32.to_nat(NB), BK.bitsof(FD.array__slots(U32, FD.array__freeze(U32, O.clear_bit(O.ml_go(U32.is_eq(_, 0), _, i, FD.array__thaw(U32, M)), NB))))) == BK.btk(U32.to_nat(NB), BK.bitsof(FD.array__slots(U32, M))) : +List<Bool>}
  %Equal.sym(Array<U32>, O.ml_go(False{}, U32{WCon{False{}, WCon{True{}, Word.zero(30n)}}}, i, FD.array__thaw(U32, M)), FD.array__thaw(U32, ML), mlg(False{}, U32{WCon{False{}, WCon{True{}, Word.zero(30n)}}}, i, Q, dz, M, pf, hdz, ei, hq)) :
    {BK.btk(U32.to_nat(NB), BK.bitsof(FD.array__slots(U32, FD.array__freeze(U32, O.clear_bit(_, NB))))) == BK.btk(U32.to_nat(NB), BK.bitsof(FD.array__slots(U32, M))) : +List<Bool>}
  +e1 = clr(dz, ML, NB, mlp(False{}, U32{WCon{False{}, WCon{True{}, Word.zero(30n)}}}, Q, dz, M, pf), hdz, hq5)
  +e2 = mlb(U32{WCon{False{}, WCon{True{}, Word.zero(30n)}}}, Q, Nat.add(8n, h), dz, M, pf, hq, hp, kp2(FD.flat__nthc(FD.array__slots(U32, M), Q), Nat.add(8n, h), hp8))
  %Equal.sym(Nat, U32.to_nat(NB), Nat.add(x32(Q), Nat.add(8n, h)), eNB) :
    {BK.btk(U32.to_nat(NB), BK.bitsof(FD.array__slots(U32, FD.array__freeze(U32, O.clear_bit(FD.array__thaw(U32, ML), NB))))) == BK.btk(_, BK.bitsof(FD.array__slots(U32, M))) : +List<Bool>}
  Equal.trans(+List<Bool>, BK.btk(U32.to_nat(NB), BK.bitsof(FD.array__slots(U32, FD.array__freeze(U32, O.clear_bit(FD.array__thaw(U32, ML), NB))))), BK.btk(U32.to_nat(NB), BK.bitsof(FD.array__slots(U32, ML))), BK.btk(Nat.add(x32(Q), Nat.add(8n, h)), BK.bitsof(FD.array__slots(U32, M))), e1,
    FD.logic__subst(Nat, z => {BK.btk(z, BK.bitsof(FD.array__slots(U32, ML))) == BK.btk(Nat.add(x32(Q), Nat.add(8n, h)), BK.bitsof(FD.array__slots(U32, M))) : +List<Bool>}, Nat.add(x32(Q), Nat.add(8n, h)), U32.to_nat(NB), Equal.sym(Nat, U32.to_nat(NB), Nat.add(x32(Q), Nat.add(8n, h)), eNB), e2))

# n & 3 = 3: word Q keeps its first 3 bytes; the delimiter bit is 32 Q + 16 + h.
def vcore3(+dz: Nat, +M: FD.array__Tree<U32>, +n: U32, +NB: U32, +Q: Nat, +h: Nat, +pf: {FD.array__perfect(U32, dz, M) == True{} : Bool},
    +hdz: {Nat.is_lt(dz, 32n) == True{} : Bool}, +hh: {Nat.is_le(h, 7n) == True{} : Bool}, +eand: {U32.and(n, 3) == U32{WCon{True{}, WCon{True{}, Word.zero(30n)}}} : U32},
    +ei: {U32.to_nat(U32.sub(U32.shrn((n + 3 : U32), 2n), 1)) == Q : Nat}, +eNB: {U32.to_nat(NB) == Nat.add(x32(Q), Nat.add(16n, h)) : Nat},
    +hq: {Nat.is_lt(Q, FD.spec_common__pow2(dz)) == True{} : Bool})
    -> {BK.btk(U32.to_nat(NB), BK.bitsof(FD.array__slots(U32, FD.array__freeze(U32, O.clear_bit(O.mask_last(n, FD.array__thaw(U32, M)), NB))))) == BK.btk(U32.to_nat(NB), BK.bitsof(FD.array__slots(U32, M))) : +List<Bool>}:
  +i = U32.sub(U32.shrn((n + 3 : U32), 2n), 1)
  +ML = mlt(False{}, U32{WCon{True{}, WCon{True{}, Word.zero(30n)}}}, Q, dz, M)
  +hp = FD.nat__le_trans(Nat.add(16n, h), 23n, 32n, Order.add_left(16n, h, 7n, hh), {==})
  +hp8 = FD.nat__le_trans(Nat.add(16n, h), 23n, 24n, Order.add_left(16n, h, 7n, hh), {==})
  +hp32 = FD.nat__le_lt_trans(Nat.add(16n, h), 23n, 32n, Order.add_left(16n, h, 7n, hh), {==})
  +e5 = Equal.trans(Nat, U32.to_nat(U32.shrn(NB, 5n)), VD.s_rng(5n, U32.to_nat(NB)), Q, VD.shrk(5n, NB),
    Equal.trans(Nat, VD.s_rng(5n, U32.to_nat(NB)), VD.s_rng(5n, Nat.add(x32(Q), Nat.add(16n, h))), Q, Equal.cong(Nat, Nat, z => VD.s_rng(5n, z), U32.to_nat(NB), Nat.add(x32(Q), Nat.add(16n, h)), eNB), s5q(Q, Nat.add(16n, h), hp32)))
  +hq5 = FD.logic__subst(Nat, z => {Nat.is_lt(z, FD.spec_common__pow2(dz)) == True{} : Bool}, Q, U32.to_nat(U32.shrn(NB, 5n)), Equal.sym(Nat, U32.to_nat(U32.shrn(NB, 5n)), Q, e5), hq)
  %Equal.sym(U32, U32.and(n, 3), U32{WCon{True{}, WCon{True{}, Word.zero(30n)}}}, eand) :
    {BK.btk(U32.to_nat(NB), BK.bitsof(FD.array__slots(U32, FD.array__freeze(U32, O.clear_bit(O.ml_go(U32.is_eq(_, 0), _, i, FD.array__thaw(U32, M)), NB))))) == BK.btk(U32.to_nat(NB), BK.bitsof(FD.array__slots(U32, M))) : +List<Bool>}
  %Equal.sym(Array<U32>, O.ml_go(False{}, U32{WCon{True{}, WCon{True{}, Word.zero(30n)}}}, i, FD.array__thaw(U32, M)), FD.array__thaw(U32, ML), mlg(False{}, U32{WCon{True{}, WCon{True{}, Word.zero(30n)}}}, i, Q, dz, M, pf, hdz, ei, hq)) :
    {BK.btk(U32.to_nat(NB), BK.bitsof(FD.array__slots(U32, FD.array__freeze(U32, O.clear_bit(_, NB))))) == BK.btk(U32.to_nat(NB), BK.bitsof(FD.array__slots(U32, M))) : +List<Bool>}
  +e1 = clr(dz, ML, NB, mlp(False{}, U32{WCon{True{}, WCon{True{}, Word.zero(30n)}}}, Q, dz, M, pf), hdz, hq5)
  +e2 = mlb(U32{WCon{True{}, WCon{True{}, Word.zero(30n)}}}, Q, Nat.add(16n, h), dz, M, pf, hq, hp, kp3(FD.flat__nthc(FD.array__slots(U32, M), Q), Nat.add(16n, h), hp8))
  %Equal.sym(Nat, U32.to_nat(NB), Nat.add(x32(Q), Nat.add(16n, h)), eNB) :
