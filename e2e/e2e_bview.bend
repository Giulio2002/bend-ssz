# ---- mask_last: the last word keeps its first (n & 3) bytes ----

law btk_rep:
  for +p: Nat
  for +a: Nat
  for +R: +List<Bool>
  for +h: {Nat.is_le(p, a) == True{} : Bool}
  {BK.btk(p, List.append(&2, Bool, rep(a), R)) == rep(p) : +List<Bool>}
def btk_rep(p, a, R, h):
  match p a:
    case 0n _: {==}
    case 1n+ +k 0n: Empty.absurd({BK.btk(1n+k, List.append(&2, Bool, rep(0n), R)) == rep(1n+k) : +List<Bool>}, FD.logic__false_true(h))
    case 1n+ +k 1n+ +b: Equal.cong(+List<Bool>, +List<Bool>, z => True{} <> z, BK.btk(k, List.append(&2, Bool, rep(b), R)), rep(k), btk_rep(k, b, R, h))

def zb(+k: Nat) -> +List<Bool>:
  match k:
    case 0n: []
    case 1n+p: False{} <> zb(p)

# keep(r, x) has x's first 8 r bits (r = 1, 2, 3).
def kp1(+x: U32, +p: Nat, +hp: {Nat.is_le(p, 8n) == True{} : Bool}) -> {BK.btk(p, BLf.wbits(O.keep(1, x))) == BK.btk(p, BLf.wbits(x)) : +List<Bool>}:
  akU(x, 255, p, btk_rep(p, 8n, zb(24n), hp))
def kp2(+x: U32, +p: Nat, +hp: {Nat.is_le(p, 16n) == True{} : Bool}) -> {BK.btk(p, BLf.wbits(O.keep(2, x))) == BK.btk(p, BLf.wbits(x)) : +List<Bool>}:
  akU(x, 65535, p, btk_rep(p, 16n, zb(16n), hp))
def kp3(+x: U32, +p: Nat, +hp: {Nat.is_le(p, 24n) == True{} : Bool}) -> {BK.btk(p, BLf.wbits(O.keep(3, x))) == BK.btk(p, BLf.wbits(x)) : +List<Bool>}:
  akU(x, 16777215, p, btk_rep(p, 24n, zb(8n), hp))

def mlt(whole: Bool, +rem: U32, +q: Nat, +d: Nat, +T: FD.array__Tree<U32>) -> FD.array__Tree<U32>:
  match whole:
    case True{}: T
    case False{}: FD.array__upd(U32, d, T, q, O.keep(rem, FD.flat__nthc(FD.array__slots(U32, T), q)))

def mlg(+whole: Bool, +rem: U32, +i: U32, +q: Nat, +d: Nat, +T: FD.array__Tree<U32>, +pf: {FD.array__perfect(U32, d, T) == True{} : Bool},
    +hd: {Nat.is_lt(d, 32n) == True{} : Bool}, +eqi: {U32.to_nat(i) == q : Nat}, +hq: {Nat.is_lt(q, FD.spec_common__pow2(d)) == True{} : Bool})
    -> {O.ml_go(whole, rem, i, FD.array__thaw(U32, T)) == FD.array__thaw(U32, mlt(whole, rem, q, d, T)) : Array<U32>}:
  match whole:
    case True{}: {==}
    case False{}:
      +hi = FD.logic__subst(Nat, z => {Nat.is_lt(z, FD.spec_common__pow2(d)) == True{} : Bool}, q, U32.to_nat(i), Equal.sym(Nat, U32.to_nat(i), q, eqi), hq)
      +x = FD.flat__nthc(FD.array__slots(U32, T), U32.to_nat(i))
      +hx = FD.flat__nthc_nth(FD.array__slots(U32, T), U32.to_nat(i), FD.array__len_lt(U32, d, T, U32.to_nat(i), pf, hi))
      %Equal.sym(Array<U32> & U32, Array.get(U32, FD.array__thaw(U32, T), i), (FD.array__thaw(U32, T), x), FD.array__get(U32, d, T, i, x, hd, hi, hx, pf)) :
        {O.ml_set(rem, i, _) == FD.array__thaw(U32, mlt(False{}, rem, q, d, T)) : Array<U32>}
      %Equal.sym(Array<U32>, Array.set(U32, FD.array__thaw(U32, T), i, O.keep(rem, x)), FD.array__thaw(U32, FD.array__upd(U32, d, T, U32.to_nat(i), O.keep(rem, x))), FD.array__set(U32, d, T, i, O.keep(rem, x), x, hd, hi, hx, pf)) :
        {_ == FD.array__thaw(U32, mlt(False{}, rem, q, d, T)) : Array<U32>}
      %Equal.sym(Nat, U32.to_nat(i), q, eqi) :
        {FD.array__thaw(U32, FD.array__upd(U32, d, T, _, O.keep(rem, FD.flat__nthc(FD.array__slots(U32, T), _)))) == FD.array__thaw(U32, mlt(False{}, rem, q, d, T)) : Array<U32>}
      {==}

def mlp(+whole: Bool, +rem: U32, +q: Nat, +d: Nat, +T: FD.array__Tree<U32>, +pf: {FD.array__perfect(U32, d, T) == True{} : Bool})
    -> {FD.array__perfect(U32, d, mlt(whole, rem, q, d, T)) == True{} : Bool}:
  match whole:
    case True{}: pf
    case False{}: FD.array__upd_perfect(U32, d, T, q, O.keep(rem, FD.flat__nthc(FD.array__slots(U32, T), q)), pf)

# The masked tree keeps the first 32 q + p bits, p <= 8 rem.
def mlb(+rem: U32, +q: Nat, +p: Nat, +d: Nat, +T: FD.array__Tree<U32>, +pf: {FD.array__perfect(U32, d, T) == True{} : Bool},
    +hq: {Nat.is_lt(q, FD.spec_common__pow2(d)) == True{} : Bool}, +hp: {Nat.is_le(p, 32n) == True{} : Bool},
    +hk: {BK.btk(p, BLf.wbits(O.keep(rem, FD.flat__nthc(FD.array__slots(U32, T), q)))) == BK.btk(p, BLf.wbits(FD.flat__nthc(FD.array__slots(U32, T), q))) : +List<Bool>})
    -> {BK.btk(Nat.add(x32(q), p), BK.bitsof(FD.array__slots(U32, mlt(False{}, rem, q, d, T)))) == BK.btk(Nat.add(x32(q), p), BK.bitsof(FD.array__slots(U32, T))) : +List<Bool>}:
  +v = O.keep(rem, FD.flat__nthc(FD.array__slots(U32, T), q))
  %Equal.sym(List<&2, U32>, FD.array__slots(U32, FD.array__upd(U32, d, T, q, v)), FD.spec_common__update(U32, FD.array__slots(U32, T), q, v), FD.array__upd_slots(U32, d, T, q, v, hq, pf)) :
    {BK.btk(Nat.add(x32(q), p), BK.bitsof(_)) == BK.btk(Nat.add(x32(q), p), BK.bitsof(FD.array__slots(U32, T))) : +List<Bool>}
  bu2(q, p, FD.array__slots(U32, T), v, hp, FD.array__len_lt(U32, d, T, q, pf, hq), hk)

# ---- words and bytes: the bits of a word list are the bits of its bytes ----

