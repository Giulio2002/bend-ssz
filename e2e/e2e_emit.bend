# ---- the top word holds 3 bytes ----

law nw_3:
  for +K: Nat
  {C.nwn(Nat.add(3n, A.quad(K))) == 1n+K : Nat}
def nw_3(K):
  match K:
    case 0n: {==}
    case 1n+ +p: Equal.cong(Nat, Nat, z => 1n+z, C.nwn(Nat.add(3n, A.quad(p))), 1n+p, nw_3(p))

law gt_3:
  for +x: Nat
  {Nat.is_lt(x, Nat.add(3n, x)) == True{} : Bool}
def gt_3(x):
  match x:
    case 0n: {==}
    case 1n+ +p: gt_3(p)

law bt_3:
  for +K: Nat
  for +W: List<&2, U32>
  for +hl: {Nat.is_lt(K, FD.spec_common__length(U32, W)) == True{} : Bool}
  {AE.rl(FD.spec_common__take(U32, W, K), B.prepend_word(3, FD.flat__nthc(W, K), [])) == VSP.bt(Nat.add(3n, A.quad(K)), SF.limbs(W)) : +List<U32>}
def bt_3(K, W, hl):
  match K W:
    case _ Nil{}: Empty.absurd({AE.rl(FD.spec_common__take(U32, Nil{}, K), B.prepend_word(3, FD.flat__nthc(Nil{}, K), [])) == VSP.bt(Nat.add(3n, A.quad(K)), SF.limbs(Nil{})) : +List<U32>}, FD.nat__lt_zero_absurd(K, hl))
    case 0n Con{+x, +t}: {==}
    case 1n+ +p Con{+x, +t}:
      Equal.cong(+List<U32>, +List<U32>, z => B.byte_sel(0, x) <> B.byte_sel(1, x) <> B.byte_sel(2, x) <> B.byte_sel(3, x) <> z,
        AE.rl(FD.spec_common__take(U32, t, p), B.prepend_word(3, FD.flat__nthc(t, p), [])), VSP.bt(Nat.add(3n, A.quad(p)), SF.limbs(t)), bt_3(p, t, hl))
law nle_3:
  for +x: Nat
  {Nat.is_le(Nat.add(3n, x), x) == False{} : Bool}
def nle_3(x):
  match x:
    case 0n: {==}
    case 1n+ +p: nle_3(p)

law lt4_3:
  for +x: Nat
  {Nat.is_le(Nat.add(x, 4n), Nat.add(3n, x)) == False{} : Bool}
def lt4_3(x):
  match x:
    case 0n: {==}
    case 1n+ +p: lt4_3(p)

law sub_3:
  for +x: Nat
  {Nat.sub(Nat.add(3n, x), x) == 3n : Nat}
def sub_3(x):
  match x:
    case 0n: {==}
    case 1n+ +p: sub_3(p)

