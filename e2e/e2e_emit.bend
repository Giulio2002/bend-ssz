  +hj = FD.logic__subst(Nat, z => {Nat.is_lt(z, FD.spec_common__pow2(d)) == True{} : Bool}, K, U32.to_nat(j), Equal.sym(Nat, U32.to_nat(j), K, ej), hK)
  +hq = FD.nat__lt_le(A.quad(K), U32.to_nat(n), hlt)
  +hl = FD.logic__subst(Nat, z => {Nat.is_lt(K, z) == True{} : Bool}, FD.spec_common__pow2(d), FD.spec_common__length(U32, FD.array__slots(U32, T)), Equal.sym(Nat, FD.spec_common__length(U32, FD.array__slots(U32, T)), FD.spec_common__pow2(d), FD.array__slots_length(U32, d, T, pf)), hK)
