# ---- the top word holds 4 bytes ----

law nw_4:
  for +K: Nat
  {C.nwn(Nat.add(4n, A.quad(K))) == 1n+K : Nat}
def nw_4(K):
  match K:
    case 0n: {==}
    case 1n+ +p: Equal.cong(Nat, Nat, z => 1n+z, C.nwn(Nat.add(4n, A.quad(p))), 1n+p, nw_4(p))

law gt_4:
  for +x: Nat
  {Nat.is_lt(x, Nat.add(4n, x)) == True{} : Bool}
def gt_4(x):
  match x:
    case 0n: {==}
    case 1n+ +p: gt_4(p)

law bt_4:
  for +K: Nat
  for +W: List<&2, U32>
  for +hl: {Nat.is_lt(K, FD.spec_common__length(U32, W)) == True{} : Bool}
  {AE.rl(FD.spec_common__take(U32, W, K), B.prepend_word(4, FD.flat__nthc(W, K), [])) == VSP.bt(Nat.add(4n, A.quad(K)), SF.limbs(W)) : +List<U32>}
def bt_4(K, W, hl):
  match K W:
    case _ Nil{}: Empty.absurd({AE.rl(FD.spec_common__take(U32, Nil{}, K), B.prepend_word(4, FD.flat__nthc(Nil{}, K), [])) == VSP.bt(Nat.add(4n, A.quad(K)), SF.limbs(Nil{})) : +List<U32>}, FD.nat__lt_zero_absurd(K, hl))
    case 0n Con{+x, +t}: {==}
    case 1n+ +p Con{+x, +t}:
      Equal.cong(+List<U32>, +List<U32>, z => B.byte_sel(0, x) <> B.byte_sel(1, x) <> B.byte_sel(2, x) <> B.byte_sel(3, x) <> z,
        AE.rl(FD.spec_common__take(U32, t, p), B.prepend_word(4, FD.flat__nthc(t, p), [])), VSP.bt(Nat.add(4n, A.quad(p)), SF.limbs(t)), bt_4(p, t, hl))
def bi_4(+j: U32, +n: U32, +K: Nat, +d: Nat, +ej: {U32.to_nat(j) == K : Nat}, +hd: {Nat.is_lt(d, 29n) == True{} : Bool},
    +hK: {Nat.is_lt(K, FD.spec_common__pow2(d)) == True{} : Bool}, +eN: {U32.to_nat(n) == Nat.add(4n, A.quad(K)) : Nat}) -> {B.bytes_in(j, n) == 4 : U32}:
  AE.bin4(j, n, K, d, ej, FD.nat__lt_trans(d, 29n, 31n, hd, {==}), hK,
    FD.logic__subst(Nat, z => {Nat.is_le(A.quad(1n+K), z) == True{} : Bool}, A.quad(1n+K), U32.to_nat(n), Equal.sym(Nat, U32.to_nat(n), A.quad(1n+K), eN), FD.nat__le_refl(A.quad(1n+K))))
def core_4(+K: Nat, +d: Nat, +T: FD.array__Tree<U32>, +n: U32, +pf: {FD.array__perfect(U32, d, T) == True{} : Bool}, +hd: {Nat.is_lt(d, 29n) == True{} : Bool}, +hn: {Nat.is_le(U32.to_nat(n), A.quad(FD.spec_common__pow2(d))) == True{} : Bool}, +eN: {U32.to_nat(n) == Nat.add(4n, A.quad(K)) : Nat})
    -> {Pair.snd(B.Buf, +List<U32>, B.emit(B.Buf{FD.array__thaw(U32, T), n}, 0, C.nwu(n))) == VSP.bt(U32.to_nat(n), SF.limbs(FD.array__slots(U32, T))) : +List<U32>}:
  +hd31 = FD.nat__lt_trans(d, 29n, 31n, hd, {==})
  +hlt = FD.logic__subst(Nat, z => {Nat.is_lt(A.quad(K), z) == True{} : Bool}, Nat.add(4n, A.quad(K)), U32.to_nat(n), Equal.sym(Nat, U32.to_nat(n), Nat.add(4n, A.quad(K)), eN), gt_4(A.quad(K)))
  +hK = A.quad_lt(K, FD.spec_common__pow2(d), FD.nat__lt_le_trans(A.quad(K), U32.to_nat(n), A.quad(FD.spec_common__pow2(d)), hlt, hn))
  +ek = Equal.trans(Nat, U32.to_nat(C.nwu(n)), C.nwn(U32.to_nat(n)), 1n+K, C.nw(n, d, hd, hn),
    Equal.trans(Nat, C.nwn(U32.to_nat(n)), C.nwn(Nat.add(4n, A.quad(K))), 1n+K, Equal.cong(Nat, Nat, z => C.nwn(z), U32.to_nat(n), Nat.add(4n, A.quad(K)), eN), nw_4(K)))
  +k = C.nwu(n)
  +j = U32.sub(U32.add(0, k), 1)
  +e0 = FD.logic__subst(U32, z => {U32.to_nat(z) == 1n+K : Nat}, k, U32.add(0, k), Equal.sym(U32, U32.add(0, k), k, FD.u32alg__zero_add(k)), ek)
  +ej = AE.pred1(U32.add(0, k), K, e0)
  +hj = FD.logic__subst(Nat, z => {Nat.is_lt(z, FD.spec_common__pow2(d)) == True{} : Bool}, K, U32.to_nat(j), Equal.sym(Nat, U32.to_nat(j), K, ej), hK)
  +hq = FD.nat__lt_le(A.quad(K), U32.to_nat(n), hlt)
  +hl = FD.logic__subst(Nat, z => {Nat.is_lt(K, z) == True{} : Bool}, FD.spec_common__pow2(d), FD.spec_common__length(U32, FD.array__slots(U32, T)), Equal.sym(Nat, FD.spec_common__length(U32, FD.array__slots(U32, T)), FD.spec_common__pow2(d), FD.array__slots_length(U32, d, T, pf)), hK)
  %Equal.sym(Nat, U32.to_nat(k), 1n+K, ek) :
    {Pair.snd(B.Buf, +List<U32>, B.emit_go(_, j, n, [], B.word(B.Buf{FD.array__thaw(U32, T), n}, j))) == VSP.bt(U32.to_nat(n), SF.limbs(FD.array__slots(U32, T))) : +List<U32>}
  %Equal.sym(B.Buf & U32, B.word(B.Buf{FD.array__thaw(U32, T), n}, j), (B.Buf{FD.array__thaw(U32, T), n}, FD.flat__nthc(FD.array__slots(U32, T), U32.to_nat(j))), BF.word_read(d, T, n, j, FD.nat__lt_trans(d, 31n, 32n, hd31, {==}), hj, pf)) :
    {Pair.snd(B.Buf, +List<U32>, B.emit_go(1n+K, j, n, [], _)) == VSP.bt(U32.to_nat(n), SF.limbs(FD.array__slots(U32, T))) : +List<U32>}
  %Equal.sym(Nat, U32.to_nat(j), K, ej) :
    {Pair.snd(B.Buf, +List<U32>, B.emit_go(1n+K, j, n, [], (B.Buf{FD.array__thaw(U32, T), n}, FD.flat__nthc(FD.array__slots(U32, T), _)))) == VSP.bt(U32.to_nat(n), SF.limbs(FD.array__slots(U32, T))) : +List<U32>}
  %Equal.sym(U32, B.bytes_in(j, n), 4, bi_4(j, n, K, d, ej, hd, hK, eN)) :
    {Pair.snd(B.Buf, +List<U32>, B.emit_go(K, (j - 1 : U32), n, B.prepend_word(_, FD.flat__nthc(FD.array__slots(U32, T), K), []), B.word(B.Buf{FD.array__thaw(U32, T), n}, (j - 1 : U32)))) == VSP.bt(U32.to_nat(n), SF.limbs(FD.array__slots(U32, T))) : +List<U32>}
  %Equal.sym(Nat, U32.to_nat(n), Nat.add(4n, A.quad(K)), eN) : {Pair.snd(B.Buf, +List<U32>, B.emit_go(K, (j - 1 : U32), n, B.prepend_word(4, FD.flat__nthc(FD.array__slots(U32, T), K), []), B.word(B.Buf{FD.array__thaw(U32, T), n}, (j - 1 : U32)))) == VSP.bt(_, SF.limbs(FD.array__slots(U32, T))) : +List<U32>}
  Equal.trans(+List<U32>, Pair.snd(B.Buf, +List<U32>, B.emit_go(K, (j - 1 : U32), n, B.prepend_word(4, FD.flat__nthc(FD.array__slots(U32, T), K), []), B.word(B.Buf{FD.array__thaw(U32, T), n}, (j - 1 : U32)))),
    AE.rl(FD.spec_common__take(U32, FD.array__slots(U32, T), K), B.prepend_word(4, FD.flat__nthc(FD.array__slots(U32, T), K), [])), VSP.bt(Nat.add(4n, A.quad(K)), SF.limbs(FD.array__slots(U32, T))),
    tail(K, d, T, n, j, B.prepend_word(4, FD.flat__nthc(FD.array__slots(U32, T), K), []), ej, hd31, hK, hq, pf), bt_4(K, FD.array__slots(U32, T), hl))
# ---- n = 0, and the dispatch over n = M + 4K ----

def zero(+d: Nat, +T: FD.array__Tree<U32>, +n: U32, +eN: {U32.to_nat(n) == 0n : Nat})
    -> {Pair.snd(B.Buf, +List<U32>, B.emit(B.Buf{FD.array__thaw(U32, T), n}, 0, C.nwu(n))) == VSP.bt(U32.to_nat(n), SF.limbs(FD.array__slots(U32, T))) : +List<U32>}:
  +e = FD.u32__injective(n, 0, eN)
  %Equal.sym(U32, n, 0, e) : {Pair.snd(B.Buf, +List<U32>, B.emit(B.Buf{FD.array__thaw(U32, T), _}, 0, C.nwu(_))) == VSP.bt(U32.to_nat(_), SF.limbs(FD.array__slots(U32, T))) : +List<U32>}
  %Equal.sym(B.Buf & U32, B.word(B.Buf{FD.array__thaw(U32, T), 0}, U32.sub(U32.add(0, C.nwu(0)), 1)), (Pair.fst(B.Buf, U32, B.word(B.Buf{FD.array__thaw(U32, T), 0}, U32.sub(U32.add(0, C.nwu(0)), 1))), Pair.snd(B.Buf, U32, B.word(B.Buf{FD.array__thaw(U32, T), 0}, U32.sub(U32.add(0, C.nwu(0)), 1)))), peta(B.Buf, U32, B.word(B.Buf{FD.array__thaw(U32, T), 0}, U32.sub(U32.add(0, C.nwu(0)), 1)))) :
    {Pair.snd(B.Buf, +List<U32>, B.emit_go(U32.to_nat(C.nwu(0)), U32.sub(U32.add(0, C.nwu(0)), 1), 0, [], _)) == [] : +List<U32>}
  {==}

def z0(+K: Nat, +d: Nat, +T: FD.array__Tree<U32>, +n: U32, +pf: {FD.array__perfect(U32, d, T) == True{} : Bool}, +hd: {Nat.is_lt(d, 29n) == True{} : Bool}, +hn: {Nat.is_le(U32.to_nat(n), A.quad(FD.spec_common__pow2(d))) == True{} : Bool}, +eN: {U32.to_nat(n) == Nat.add(0n, A.quad(K)) : Nat})
    -> {Pair.snd(B.Buf, +List<U32>, B.emit(B.Buf{FD.array__thaw(U32, T), n}, 0, C.nwu(n))) == VSP.bt(U32.to_nat(n), SF.limbs(FD.array__slots(U32, T))) : +List<U32>}:
  match K:
    case 0n: zero(d, T, n, eN)
    case 1n+ +q: core_4(q, d, T, n, pf, hd, hn, eN)

law dsp:
  for +M: Nat
  for +K: Nat
  for +d: Nat
  for +T: FD.array__Tree<U32>
  for +n: U32
  for pf: {FD.array__perfect(U32, d, T) == True{} : Bool}
  for hd: {Nat.is_lt(d, 29n) == True{} : Bool}
  for hn: {Nat.is_le(U32.to_nat(n), A.quad(FD.spec_common__pow2(d))) == True{} : Bool}
  for +eN: {U32.to_nat(n) == Nat.add(M, A.quad(K)) : Nat}
  {Pair.snd(B.Buf, +List<U32>, B.emit(B.Buf{FD.array__thaw(U32, T), n}, 0, C.nwu(n))) == VSP.bt(U32.to_nat(n), SF.limbs(FD.array__slots(U32, T))) : +List<U32>}
def dsp(M, K, d, T, n, pf, hd, hn, eN):
  match M:
    case 0n: z0(K, d, T, n, pf, hd, hn, eN)
    case 1n: core_1(K, d, T, n, pf, hd, hn, eN)
    case 2n: core_2(K, d, T, n, pf, hd, hn, eN)
    case 3n: core_3(K, d, T, n, pf, hd, hn, eN)
    case 4n: core_4(K, d, T, n, pf, hd, hn, eN)
    case 5n+ +z:
      dsp(1n+z, 1n+K, d, T, n, pf, hd, hn,
        Equal.trans(Nat, U32.to_nat(n), Nat.add(5n+z, A.quad(K)), Nat.add(1n+z, A.quad(1n+K)), eN,
          Equal.cong(Nat, Nat, y => 1n+y, 4n+Nat.add(z, A.quad(K)), Nat.add(z, 4n+A.quad(K)), Equal.sym(Nat, Nat.add(z, 4n+A.quad(K)), 4n+Nat.add(z, A.quad(K)), sh4(z, A.quad(K))))))

# The output path's bytes: the first n bytes of the words (n <= 4 * 2^d, d < 29).
def ob(+d: Nat, +T: FD.array__Tree<U32>, +n: U32, +pf: {FD.array__perfect(U32, d, T) == True{} : Bool}, +hd: {Nat.is_lt(d, 29n) == True{} : Bool}, +hn: {Nat.is_le(U32.to_nat(n), A.quad(FD.spec_common__pow2(d))) == True{} : Bool})
    -> {Pair.snd(B.Buf, +List<U32>, B.emit(B.Buf{FD.array__thaw(U32, T), n}, 0, C.nwu(n))) == VSP.bt(U32.to_nat(n), SF.limbs(FD.array__slots(U32, T))) : +List<U32>}:
  dsp(U32.to_nat(n), 0n, d, T, n, pf, hd, hn, Equal.sym(Nat, Nat.add(U32.to_nat(n), 0n), U32.to_nat(n), FD.nat__add_zero(U32.to_nat(n))))


# ---- the same at the object API's own limit: depth d < 31, n <= VB.NMAX() (obN) ----

def biM_1(+j: U32, +n: U32, +K: Nat, +d: Nat, +ej: {U32.to_nat(j) == K : Nat}, +hd: {Nat.is_lt(d, 31n) == True{} : Bool}, +hM: {U32.is_le(n, VB.NMAX()) == True{} : Bool},
    +hK: {Nat.is_lt(K, FD.spec_common__pow2(d)) == True{} : Bool}, +eN: {U32.to_nat(n) == Nat.add(1n, A.quad(K)) : Nat}) -> {B.bytes_in(j, n) == 1 : U32}:
  +hd31 = hd
  +q4 = AE.quadv(j, K, d, ej, hd31, hK)
  +c1 = Equal.trans(Bool, U32.is_le(n, (4 * j : U32)), Nat.is_le(U32.to_nat(n), U32.to_nat((4 * j : U32))), False{}, AE.le_nat(n, (4 * j : U32)),
    FD.logic__subst(Nat, z => {Nat.is_le(U32.to_nat(n), z) == False{} : Bool}, A.quad(K), U32.to_nat((4 * j : U32)), Equal.sym(Nat, U32.to_nat((4 * j : U32)), A.quad(K), q4),
      FD.logic__subst(Nat, z => {Nat.is_le(z, A.quad(K)) == False{} : Bool}, Nat.add(1n, A.quad(K)), U32.to_nat(n), Equal.sym(Nat, U32.to_nat(n), Nat.add(1n, A.quad(K)), eN), nle_1(A.quad(K)))))
  +h4 = FD.nat__lt_succ_le_succ(K, FD.spec_common__pow2(d), hK)
  +hb = FD.logic__subst(Nat, z => {Nat.is_le(z, O.pow2n(2n+d)) == True{} : Bool}, A.quad(1n+K), Nat.add(U32.to_nat((4 * j : U32)), 4n),
    Equal.trans(Nat, A.quad(1n+K), Nat.add(A.quad(K), 4n), Nat.add(U32.to_nat((4 * j : U32)), 4n), FD.nat__add_comm(4n, A.quad(K)),
      Equal.cong(Nat, Nat, z => Nat.add(z, 4n), A.quad(K), U32.to_nat((4 * j : U32)), Equal.sym(Nat, U32.to_nat((4 * j : U32)), A.quad(K), q4))),
    FD.logic__subst(Nat, z => {Nat.is_le(A.quad(1n+K), z) == True{} : Bool}, FD.spec_common__pow2(2n+d), O.pow2n(2n+d), VD.s_pow2_eq(2n+d),
      AE.quad_le(1n+K, FD.spec_common__pow2(d), h4)))
  +hq4 = FD.nat__le_trans(Nat.add(4n, A.quad(K)), Nat.add(31n, A.quad(K)), Nat.add(31n, Nat.add(1n, A.quad(K))), Order.add_right(4n, 31n, A.quad(K), {==}),
    Order.add_left(31n, A.quad(K), Nat.add(1n, A.quad(K)), AC.le_addl(1n, A.quad(K))))
  +hq5 = FD.logic__subst(Nat, z => {Nat.is_le(Nat.add(4n, z), Nat.add(31n, U32.to_nat(n))) == True{} : Bool}, A.quad(K), U32.to_nat((4 * j : U32)), Equal.sym(Nat, U32.to_nat((4 * j : U32)), A.quad(K), q4),
    FD.logic__subst(Nat, z => {Nat.is_le(Nat.add(4n, A.quad(K)), Nat.add(31n, z)) == True{} : Bool}, Nat.add(1n, A.quad(K)), U32.to_nat(n), Equal.sym(Nat, U32.to_nat(n), Nat.add(1n, A.quad(K)), eN), hq4))
  +e4 = Equal.trans(Nat, U32.to_nat(((4 * j : U32) + 4 : U32)), Nat.add(4n, U32.to_nat((4 * j : U32))), Nat.add(U32.to_nat((4 * j : U32)), 4n),
    VB.add_lt32((4 * j : U32), 4, U32.to_nat((4 * j : U32)), {==}, FD.nat__le_lt_trans(Nat.add(4n, U32.to_nat((4 * j : U32))), Nat.add(31n, U32.to_nat(n)), FD.spec_common__pow2(32n), hq5, VB.nmax_lt(n, hM))),
    FD.nat__add_comm(4n, U32.to_nat((4 * j : U32))))
  +c2 = Equal.trans(Bool, U32.is_le(((4 * j : U32) + 4 : U32), n), Nat.is_le(U32.to_nat(((4 * j : U32) + 4 : U32)), U32.to_nat(n)), False{}, AE.le_nat(((4 * j : U32) + 4 : U32), n),
    FD.logic__subst(Nat, z => {Nat.is_le(z, U32.to_nat(n)) == False{} : Bool}, Nat.add(A.quad(K), 4n), U32.to_nat(((4 * j : U32) + 4 : U32)),
      Equal.sym(Nat, U32.to_nat(((4 * j : U32) + 4 : U32)), Nat.add(A.quad(K), 4n), Equal.trans(Nat, U32.to_nat(((4 * j : U32) + 4 : U32)), Nat.add(U32.to_nat((4 * j : U32)), 4n), Nat.add(A.quad(K), 4n), e4,
        Equal.cong(Nat, Nat, z => Nat.add(z, 4n), U32.to_nat((4 * j : U32)), A.quad(K), q4))),
