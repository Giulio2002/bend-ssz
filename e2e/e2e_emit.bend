def core_2(+K: Nat, +d: Nat, +T: FD.array__Tree<U32>, +n: U32, +pf: {FD.array__perfect(U32, d, T) == True{} : Bool}, +hd: {Nat.is_lt(d, 29n) == True{} : Bool}, +hn: {Nat.is_le(U32.to_nat(n), A.quad(FD.spec_common__pow2(d))) == True{} : Bool}, +eN: {U32.to_nat(n) == Nat.add(2n, A.quad(K)) : Nat})
