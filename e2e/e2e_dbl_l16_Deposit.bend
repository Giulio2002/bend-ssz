    case True{}: ((FD.array__trep(RT.MB<RT.M_Deposit>, 0n, RT.MNone{}), (0n, (0, ({==}, ({==}, ({==}, ({==}, {==}))))))), FD.nat__zero_le(SH.ListOf_limit(s)))
