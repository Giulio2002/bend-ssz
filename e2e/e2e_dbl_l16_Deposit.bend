def rep_c(+c: Bool, +d: Nat, +t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32, +ec: {U32.is_eq(len, 0) == c : Bool}, +hchk: {W.CHKw(t, x, off, len) == True{} : Bool}, +s: S.Schema, +es: {SH.ListOf_limit(s) == U32.to_nat(16) : Nat},
