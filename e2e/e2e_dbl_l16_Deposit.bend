      (((RTT(U32.to_nat(U32.sub(W.NN(len), 1)), 0, 0n, B.words_depth(W.NN(len)), d, t, x, FD.array__trep(RT.MB<RT.M_Deposit>, B.words_depth(W.NN(len)), RT.MNone{}))), (B.words_depth(W.NN(len)), (W.NN(len), (obj_eq(d, t, x, off, len, ec, hchk), (rtt_pf(U32.to_nat(U32.sub(W.NN(len), 1)), 0, 0n, B.words_depth(W.NN(len)), d, t, x, FD.array__trep(RT.MB<RT.M_Deposit>, B.words_depth(W.NN(len)), RT.MNone{}), FD.array__trep_perfect(RT.MB<RT.M_Deposit>, B.words_depth(W.NN(len)), RT.MNone{})),
          (FD.nat__lt_trans(B.words_depth(W.NN(len)), 31n, 32n, dw_lt(t, x, off, len, hchk), {==}), (dw_cov(t, x, off, len, hchk),
            rt_ereps(U32.to_nat(U32.sub(W.NN(len), 1)), 0, W.NN(len), 0n, B.words_depth(W.NN(len)), d, t, x, FD.array__trep(RT.MB<RT.M_Deposit>, B.words_depth(W.NN(len)), RT.MNone{}), FD.nat__lt_trans(B.words_depth(W.NN(len)), 31n, 32n, dw_lt(t, x, off, len, hchk), {==}), FD.array__trep_perfect(RT.MB<RT.M_Deposit>, B.words_depth(W.NN(len)), RT.MNone{}), dw_cov(t, x, off, len, hchk), inv0(t, x, off, len, ec, hchk), SH.ListOf_element(s), ee, {==})))))))),
          FD.logic__subst(Nat, z => {Nat.is_le(W.CC(len), z) == True{} : Bool}, U32.to_nat(16), SH.ListOf_limit(s), Equal.sym(Nat, SH.ListOf_limit(s), U32.to_nat(16), es), W.hcw(len, hchk)))

def rep(+d: Nat, +t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32, +s: S.Schema, +es: {SH.ListOf_limit(s) == U32.to_nat(16) : Nat}, +ee: {SH.ListOf_element(s) == Spec.Deposit() : S.Schema}, +hchk: {W.CHKw(t, x, off, len) == True{} : Bool})
    -> RT.rep_l16_Deposit(W.OBJw(d, t, x, off, len), s):
  rep_c(U32.is_eq(len, 0), d, t, x, off, len, {==}, hchk, s, es, ee)

# ---- the encode premise ----
def sdl_c(+c: Bool, +d: Nat, +t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32, +ec: {U32.is_eq(len, 0) == c : Bool}, +hchk: {W.CHKw(t, x, off, len) == True{} : Bool}) -> ML.sdt(W.LOBJ(d, c, t, x, len)):
  match c:
    case True{}: (FD.array__trep(RT.MB<RT.M_Deposit>, 0n, RT.MNone{}), (0n, (0, ({==}, ({==}, ({==}, ({==}, {==})))))))
    case False{}:
      (RTT(U32.to_nat(U32.sub(W.NN(len), 1)), 0, 0n, B.words_depth(W.NN(len)), d, t, x, FD.array__trep(RT.MB<RT.M_Deposit>, B.words_depth(W.NN(len)), RT.MNone{})), (B.words_depth(W.NN(len)), (W.NN(len), (obj_eq(d, t, x, off, len, ec, hchk), (rtt_pf(U32.to_nat(U32.sub(W.NN(len), 1)), 0, 0n, B.words_depth(W.NN(len)), d, t, x, FD.array__trep(RT.MB<RT.M_Deposit>, B.words_depth(W.NN(len)), RT.MNone{}), FD.array__trep_perfect(RT.MB<RT.M_Deposit>, B.words_depth(W.NN(len)), RT.MNone{})),
        (dw_lt(t, x, off, len, hchk), (dw_cov(t, x, off, len, hchk), rt_sdks(U32.to_nat(U32.sub(W.NN(len), 1)), 0, W.NN(len), 0n, B.words_depth(W.NN(len)), d, t, x, FD.array__trep(RT.MB<RT.M_Deposit>, B.words_depth(W.NN(len)), RT.MNone{}), FD.nat__lt_trans(B.words_depth(W.NN(len)), 31n, 32n, dw_lt(t, x, off, len, hchk), {==}), FD.array__trep_perfect(RT.MB<RT.M_Deposit>, B.words_depth(W.NN(len)), RT.MNone{}), dw_cov(t, x, off, len, hchk), inv0(t, x, off, len, ec, hchk), {==}))))))))

def sdl(+d: Nat, +t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32, +hchk: {W.CHKw(t, x, off, len) == True{} : Bool}) -> ML.sdt(W.OBJw(d, t, x, off, len)):
  sdl_c(U32.is_eq(len, 0), d, t, x, off, len, {==}, hchk)

# ---- the encoded byte count: the records are 1240 bytes, 310 words, each ----
def qadd(+a: Nat, +b: Nat) -> {A.quad(Nat.add(a, b)) == Nat.add(A.quad(a), A.quad(b)) : Nat}:
  Equal.trans(Nat, A.quad(Nat.add(a, b)), Nat.double(Nat.add(Nat.double(a), Nat.double(b))), Nat.add(A.quad(a), A.quad(b)),
    Equal.cong(Nat, Nat, z => Nat.double(z), Nat.double(Nat.add(a, b)), Nat.add(Nat.double(a), Nat.double(b)), Equal.sym(Nat, Nat.add(Nat.double(a), Nat.double(b)), Nat.double(Nat.add(a, b)), FD.nat__add_double(a, b))),
    Equal.sym(Nat, Nat.add(A.quad(a), A.quad(b)), Nat.double(Nat.add(Nat.double(a), Nat.double(b))), FD.nat__add_double(Nat.double(a), Nat.double(b))))

def qm(+c: Nat) -> {A.quad(Nat.mul(c, 310n)) == Nat.mul(c, 1240n) : Nat}:
  match c:
    case 0n: {==}
    case 1n+q:
      Equal.trans(Nat, A.quad(Nat.mul(1n+q, 310n)), Nat.add(A.quad(310n), A.quad(Nat.mul(q, 310n))), Nat.mul(1n+q, 1240n), qadd(310n, Nat.mul(q, 310n)),
        Equal.cong(Nat, Nat, z => Nat.add(A.quad(310n), z), A.quad(Nat.mul(q, 310n)), Nat.mul(q, 1240n), qm(q)))

def szl_c(+c: Bool, +d: Nat, +t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32, +ec: {U32.is_eq(len, 0) == c : Bool}, +hchk: {W.CHKw(t, x, off, len) == True{} : Bool}) -> {ML.LLX(W.LOBJ(d, c, t, x, len)) == U32.to_nat(len) : Nat}:
  match c:
    case True{}: Equal.sym(Nat, U32.to_nat(len), 0n, Equal.cong(U32, Nat, z => U32.to_nat(z), len, 0, FD.u32alg__eq_of(len, 0, ec)))
    case False{}: Equal.trans(Nat, ML.LLX(W.LOBJ(d, False{}, t, x, len)), Nat.mul(W.CC(len), 1240n), U32.to_nat(len), qm(W.CC(len)), Equal.sym(Nat, U32.to_nat(len), Nat.mul(W.CC(len), 1240n), W.ecw(len, hchk)))

def szl(+d: Nat, +t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32, +hchk: {W.CHKw(t, x, off, len) == True{} : Bool}) -> {ML.LLX(W.OBJw(d, t, x, off, len)) == U32.to_nat(len) : Nat}:
  szl_c(U32.is_eq(len, 0), d, t, x, off, len, {==}, hchk)
