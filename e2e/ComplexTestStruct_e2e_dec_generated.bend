# ---- (ii) on views, (iii) ----

def mv(m: Maybe<&1, ComplexTestStruct_d.ComplexTestStruct>) -> Maybe<&2, S.Value>:
  match m:
    case None{}: None{}
    case Some{o}: Some{RT.v_ComplexTestStruct(o)}

