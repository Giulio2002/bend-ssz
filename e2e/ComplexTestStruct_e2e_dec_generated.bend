# ---- the loaded buffer ----

# the words the loader fills, at the buffer's depth
def TT(+bs: +List<U32>, +n: U32) -> FD.array__Tree<U32>: AC.segt(B.capacity(n), 0n, L.wlp(bs))

def ld(+bs: +List<U32>, +n: U32, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +hd: {SP.bytes_domain(bs) == True{} : Bool}, +hS: {U32.is_le(n, VB.NMAX()) == True{} : Bool}) -> {B.fill_at(B.alloc(n), 0, bs) == DC.BF(TT(bs, n), n) : B.Buf}:
  L.bf(bs, n, B.capacity(n), hd, {==}, C.capM_32(n, hS), C.capM_w(bs, n, hn, hS))

def vwe(+bs: +List<U32>, +n: U32, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +hd: {SP.bytes_domain(bs) == True{} : Bool}, +hS: {U32.is_le(n, VB.NMAX()) == True{} : Bool}) -> {DC.VW(TT(bs, n), n) == bs : +List<U32>}:
  L.vw(bs, n, B.capacity(n), hd, hn, C.capM_w(bs, n, hn, hS))

def pfe(+bs: +List<U32>, +n: U32) -> {FD.array__perfect(U32, B.capacity(n), TT(bs, n)) == True{} : Bool}: L.seg_pf(B.capacity(n), L.wlp(bs))

