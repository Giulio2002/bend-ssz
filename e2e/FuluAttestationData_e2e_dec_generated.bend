# (ii) the object decoder returns o exactly when END_TO_END's deserialize returns VAL(o).
def FuluAttestationData_e2e_decode_accept(+bs: +List<U32>, +n: U32, +o: FuluAttestationData_d.AttestationData, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +hd: {SP.bytes_domain(bs) == True{} : Bool})
