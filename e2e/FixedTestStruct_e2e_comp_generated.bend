    -> {Some{D.bytes(Pair.snd(B.Buf, D.Digest, FixedTestStruct_h.FixedTestStruct_hash_tree_root(h, o)))} == C.droot(Spec.FixedTestStruct(), bs) : Maybe<&2, +List<U32>>}:
