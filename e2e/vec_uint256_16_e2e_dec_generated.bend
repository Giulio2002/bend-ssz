# (ii), on views: the view of the object the decoder returns is END_TO_END's deserialize.
def vec_uint256_16_e2e_decode_view(+bs: +List<U32>, +n: U32, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +hd: {SP.bytes_domain(bs) == True{} : Bool}) -> {vec_uint256_16_mv(Pair.snd(B.Buf, Maybe<&1, O.Words>, vec_uint256_16_r.vec_uint256_16_decode(B.fill_at(B.alloc(n), 0, bs), n))) == API.deserialize(GS.vec_uint256_16(), bs) : Maybe<&2, S.Value>}:
  vec_uint256_16_d_v(bs, n, hn, hd, Nat.is_eq(List.length(&2, U32, bs), 512n), {==})

# (iii) the object decoder fails exactly when END_TO_END's deserialize does.
