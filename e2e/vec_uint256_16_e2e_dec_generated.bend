  (dn => vec_uint256_16_d_ra(bs, n, hn, hd, Nat.is_eq(List.length(&2, U32, bs), 512n), {==}, dn), an => vec_uint256_16_d_rb(bs, n, hn, hd, Nat.is_eq(List.length(&2, U32, bs), 512n), {==}, an))

