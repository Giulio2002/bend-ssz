    -> ({Pair.snd(B.Buf, Maybe<&1, FuluSingleAttestation_d.SingleAttestation>, FuluSingleAttestation_r.SingleAttestation_decode(B.fill_at(B.alloc(n), 0, bs), n)) == None{} : Maybe<&1, FuluSingleAttestation_d.SingleAttestation>} -> {API.deserialize(Spec.SingleAttestation(), bs) == None{} : Maybe<&2, S.Value>}) & ({API.deserialize(Spec.SingleAttestation(), bs) == None{} : Maybe<&2, S.Value>} -> {Pair.snd(B.Buf, Maybe<&1, FuluSingleAttestation_d.SingleAttestation>, FuluSingleAttestation_r.SingleAttestation_decode(B.fill_at(B.alloc(n), 0, bs), n)) == None{} : Maybe<&1, FuluSingleAttestation_d.SingleAttestation>}):
  (dn => FuluSingleAttestation_d_ra(bs, n, hn, hd, Nat.is_eq(List.length(&2, U32, bs), 240n), {==}, dn), an => FuluSingleAttestation_d_rb(bs, n, hn, hd, Nat.is_eq(List.length(&2, U32, bs), 240n), {==}, an))

