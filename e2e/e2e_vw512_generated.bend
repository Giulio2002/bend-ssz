    case 0n +t0: E3.eta(1n, t0, pf)
    case 1n+ +p FD.TLeaf{x}: Empty.absurd({FD.TLeaf{x} == lspg1(1n+p, FD.TLeaf{x}) : FD.array__Tree<U32>}, FD.logic__false_true(pf))
