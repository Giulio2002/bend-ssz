      Equal.cong(FD.array__Tree<U32>, FD.array__Tree<U32>, z => FD.TNode{z, r}, l, lspg1(p, l), lspg1e(p, l, FD.logic__and_left(FD.array__perfect(U32, 1n+p, l), FD.array__perfect(U32, 1n+p, r), pf)))

