# a perfect tree's left spine down to a depth-J block, and its slots as the block's then the rest
def lod(+d: Nat, +t: FD.array__Tree<U32>) -> FD.array__Tree<U32>:
  match d:
    case 0n: t
    case 1n+ +p: lod(p, E3.lo(t))

def spg(+J: Nat, +d: Nat, +t: FD.array__Tree<U32>) -> FD.array__Tree<U32>:
  match d:
    case 0n: E3.tf(J, t)
    case 1n+ +p: FD.TNode{spg(J, p, E3.lo(t)), E3.hi(t)}

def rest(+d: Nat, +t: FD.array__Tree<U32>) -> List<&2, U32>:
  match d:
    case 0n: Nil{}
    case 1n+ +p: FD.spec_common__append(U32, rest(p, E3.lo(t)), FD.array__slots(U32, E3.hi(t)))

