# the byte of the word read at y is the byte at y
def bkeep(+d: Nat, +t: FD.array__Tree<U32>, +y: Nat, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hb: {Nat.is_le(Nat.add(y, 4n), A.quad(VB.pw(d))) == True{} : Bool})
    -> {O.keep(1, UR.RWN(t, y)) == VFB4.BX(t, y) : U32}:
  +e1 = UR.rwn_bytes(d, t, y, pf, hb)
  +e2 = Equal.cong(+List<U32>, +List<U32>, z => VS.bt(1n, z), FX.limbs([UR.RWN(t, y)]), VS.bt(4n, VS.bdr(y, UA.BYT(t))), e1)
  +e3 = Equal.trans(+List<U32>, VS.bt(1n, FX.limbs([UR.RWN(t, y)])), VS.bt(1n, VS.bdr(y, UA.BYT(t))), [VFB4.BX(t, y)],
    Equal.trans(+List<U32>, VS.bt(1n, FX.limbs([UR.RWN(t, y)])), VS.bt(1n, VS.bt(4n, VS.bdr(y, UA.BYT(t)))), VS.bt(1n, VS.bdr(y, UA.BYT(t))), e2, VS.bt_bt(1n, 3n, VS.bdr(y, UA.BYT(t)))),
    VFB4.wx1(d, t, y, pf, FD.nat__le_trans(Nat.add(y, 1n), Nat.add(y, 4n), A.quad(VB.pw(d)), Order.add_left(y, 1n, 4n, {==}), hb)))
  Equal.cong(+List<U32>, U32, z => VBL.nthb(z, 0n), [O.keep(1, UR.RWN(t, y))], [VFB4.BX(t, y)], e3)

# rp of a Bitvector4 holding the low byte of a word whose low byte passes the check
def rp4v(+w: U32, +h: {VFB4.CHKv(O.keep(1, w)) == True{} : Bool}) -> ST.rp_bv4(Fulu_bitvector_4_d.Bitvector4{O.keep(1, w)}):
  match w:
    case U32{+ww}:
      match ww:
        case WCon{+a0, WCon{+a1, WCon{+a2, WCon{+a3, WCon{+a4, WCon{+a5, WCon{+a6, WCon{+a7, +r}}}}}}}}:
          FD.logic__subst(U32, z => ST.rp_bv4(Fulu_bitvector_4_d.Bitvector4{z}), U32{HV.LOW8(ww)}, O.keep(1, w), Equal.sym(U32, O.keep(1, w), U32{HV.LOW8(ww)}, HV.lb8(ww)), rp4w7(a0, a1, a2, a3, a4, a5, a6, a7, FD.logic__subst(U32, z => {VFB4.CHKv(z) == True{} : Bool}, O.keep(1, w), U32{HV.LOW8(ww)}, HV.lb8(ww), h)))

def rp4(+d: Nat, +t: FD.array__Tree<U32>, +y: Nat, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hb: {Nat.is_le(Nat.add(y, 4n), A.quad(VB.pw(d))) == True{} : Bool},
    +hc: {VFB4.CHKv(VFB4.BX(t, y)) == True{} : Bool}) -> ST.rp_bv4(VFB4.OBJ(d, t, y)):
  rp4v(UR.RWN(t, y), FD.logic__subst(U32, z => {VFB4.CHKv(z) == True{} : Bool}, VFB4.BX(t, y), O.keep(1, UR.RWN(t, y)), Equal.sym(U32, O.keep(1, UR.RWN(t, y)), VFB4.BX(t, y), bkeep(d, t, y, pf, hb)), hc))

