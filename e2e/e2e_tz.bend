# the byte of a list at a position (0 past its end)
def bat(+k: Nat, +xs: +List<U32>) -> U32:
  match k xs:
    case 0n Nil{}: 0
    case 0n Con{+h, +t}: h
    case 1n+ +p Nil{}: 0
    case 1n+ +p Con{+h, +t}: bat(p, t)

