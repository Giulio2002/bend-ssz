    +h32: {Nat.is_le(r, 32n) == True{} : Bool}, +eN: {U32.to_nat(N) == Nat.add(e32q, r) : Nat}, +zb: {WS.bdrop(r, WS.cb(FD.array__slots(U32, t), q)) == SP.zero_bytes(Nat.sub(32n, r)) : +List<U32>}) -> {O.tail_zero(U32.and(N, 3), VB.slot(t, VY.QL(N))) == True{} : Bool}:
  match p:
    case 0n: lf3(t, N, q, e32q, ee, r, erp, eN, zb)
    case 1n+ +p1: tr4(t, N, q, e32q, ee, r, p1, erp, h32, eN, zb)

def tr2(+t: FD.array__Tree<U32>, +N: U32, +q: Nat, +e32q: Nat, +ee: {e32q == WS.e32(q) : Nat}, +r: Nat, +p: Nat, +erp: {r == Nat.add(2n, p) : Nat},
    +h32: {Nat.is_le(r, 32n) == True{} : Bool}, +eN: {U32.to_nat(N) == Nat.add(e32q, r) : Nat}, +zb: {WS.bdrop(r, WS.cb(FD.array__slots(U32, t), q)) == SP.zero_bytes(Nat.sub(32n, r)) : +List<U32>}) -> {O.tail_zero(U32.and(N, 3), VB.slot(t, VY.QL(N))) == True{} : Bool}:
  match p:
    case 0n: lf2(t, N, q, e32q, ee, r, erp, eN, zb)
    case 1n+ +p1: tr3(t, N, q, e32q, ee, r, p1, erp, h32, eN, zb)

def tr1(+t: FD.array__Tree<U32>, +N: U32, +q: Nat, +e32q: Nat, +ee: {e32q == WS.e32(q) : Nat}, +r: Nat, +p: Nat, +erp: {r == Nat.add(1n, p) : Nat},
    +h32: {Nat.is_le(r, 32n) == True{} : Bool}, +eN: {U32.to_nat(N) == Nat.add(e32q, r) : Nat}, +zb: {WS.bdrop(r, WS.cb(FD.array__slots(U32, t), q)) == SP.zero_bytes(Nat.sub(32n, r)) : +List<U32>}) -> {O.tail_zero(U32.and(N, 3), VB.slot(t, VY.QL(N))) == True{} : Bool}:
  match p:
    case 0n: lf1(t, N, q, e32q, ee, r, erp, eN, zb)
    case 1n+ +p1: tr2(t, N, q, e32q, ee, r, p1, erp, h32, eN, zb)

# the zero tail of byte storage in the root invariant, as the encode laws take it
def tz(+t: FD.array__Tree<U32>, +N: U32, +q: Nat, +r: Nat, +eN: {U32.to_nat(N) == Nat.add(WS.e32(q), r) : Nat}, +h1: {Nat.is_lt(0n, r) == True{} : Bool},
    +h32: {Nat.is_le(r, 32n) == True{} : Bool}, +zb: {WS.bdrop(r, WS.cb(FD.array__slots(U32, t), Nat.add(q, 0n))) == SP.zero_bytes(Nat.sub(32n, r)) : +List<U32>})
    -> {O.tail_zero(U32.and(N, 3), VB.slot(t, VY.QL(N))) == True{} : Bool}:
  match r:
    case 0n: Empty.absurd({O.tail_zero(U32.and(N, 3), VB.slot(t, VY.QL(N))) == True{} : Bool}, FD.logic__false_true(h1))
    case 1n+ +p: tr1(t, N, q, WS.e32(q), {==}, 1n+p, p, {==}, h32, eN,
      FD.logic__subst(Nat, z => {WS.bdrop(1n+p, WS.cb(FD.array__slots(U32, t), z)) == SP.zero_bytes(Nat.sub(32n, 1n+p)) : +List<U32>}, Nat.add(q, 0n), q, FD.nat__add_zero(q), zb))

