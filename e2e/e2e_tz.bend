# a word whose bytes 1..3 are zero
def tzw1(+w: U32, +e1: {U32.and(U32.shrn(w, 8n), 255) == 0 : U32}, +e2: {U32.and(U32.shrn(w, 16n), 255) == 0 : U32}, +e3: {U32.shrn(w, 24n) == 0 : U32}) -> {O.tail_zero(1, w) == True{} : Bool}:
