def vec_uint128_5_e2e_root(h: B.Buf, -o: O.Words, +rep: PK.rep_v16(o, GS.vec_uint128_5())) -> {Some{D.bytes(Pair.snd(O.Words, D.Digest, Pair.snd(B.Buf, O.Words & D.Digest, vec_uint128_5_h.vec_uint128_5_hash_tree_root(h, o))))} == API.hash_tree_root(GS.vec_uint128_5(), PK.vview16(o)) : Maybe<&2, +List<U32>>}:
  (+w, +rest) = rep
  vec_uint128_5_r1(h, o, w, rep)

# vec_uint128_8 (vec_uint128_8)
def vec_uint128_8_r2(h: B.Buf, +t: FD.array__Tree<U32>, +N: U32, +rep: PK.rep_v16(O.Words{FD.array__thaw(U32, t), N}, GS.vec_uint128_8())) -> {Some{D.bytes(Pair.snd(O.Words, D.Digest, Pair.snd(B.Buf, O.Words & D.Digest, vec_uint128_8_h.vec_uint128_8_hash_tree_root(h, O.Words{FD.array__thaw(U32, t), N}))))} == API.hash_tree_root(GS.vec_uint128_8(), PK.vview16(O.Words{FD.array__thaw(U32, t), N})) : Maybe<&2, +List<U32>>}:
