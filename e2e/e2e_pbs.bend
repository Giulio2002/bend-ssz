  (+hlim, +hch) = rq
  (+T, +s1) = hs
  (+dw, +s2) = s1
  (+K, +s3) = s2
  (+eo, +s4) = s3
  (+pf, +s5) = s4
  (+hdw, +s6) = s5
  (+hroom, +hbz) = s6
  +hN = FD.logic__subst(O.Bits, z => {Nat.is_le(U32.to_nat(BO.blen(z)), 1281n) == True{} : Bool}, w, O.Bits{FD.array__thaw(U32, T), K}, eo, hlim)
  bb1281b(w, T, dw, K, eo, pf, hdw, hroom, hbz, hN, FD.logic__subst(O.Bits, z => BO.wfb(z), w, O.Bits{FD.array__thaw(U32, T), K}, eo, wf))

# ---- the bit vectors' words (rep_bvb: wf1 and fct), with their premise: the storage's depth and room ----
# SDW: the words' tree at a depth d below Kd with room R <= quad(2^d) bytes (the record's dB)
def SDW(o: O.Words, +Kd: Nat, +R: Nat) -> Data:
  DK.Ex(Nat, d => DK.P2({E3.at_depth(o, d) == True{} : Bool}, DK.P2({Nat.is_lt(d, Kd) == True{} : Bool}, {Nat.is_le(R, A.quad(VB.pw(d))) == True{} : Bool})))

# ... and the 1281-bit vector's bits above bit 1281 zero in word 40 (what the record checks)
def HB81(o: O.Words, +d: Nat) -> Bool:
  match o:
    case O.Words{ws, +n}: V81.HBZ(d, FD.array__freeze(U32, ws))

def SDW81(o: O.Words) -> Data:
  DK.Ex(Nat, d => DK.P2({E3.at_depth(o, d) == True{} : Bool}, DK.P2({Nat.is_lt(d, 28n) == True{} : Bool}, DK.P2({Nat.is_le(161n, A.quad(VB.pw(d))) == True{} : Bool}, {HB81(o, d) == True{} : Bool}))))

# the words as a tree of 160 bytes at the premise's depth
def WR80(w: O.Words) -> Data:
  DK.Ex(Nat, dB => DK.Ex(FD.array__Tree<U32>, TB => DK.P2({w == O.Words{FD.array__thaw(U32, TB), 160} : O.Words}, DK.P2({S.BitsValue{WBV.wbits(O.Words{FD.array__thaw(U32, TB), 160}, 1280n)} == V2S8.V1280(TB) : S.Value},
    DK.P2({FD.array__perfect(U32, dB, TB) == True{} : Bool}, DK.P2({Nat.is_lt(dB, 31n) == True{} : Bool}, {Nat.is_le(40n, VB.pw(dB)) == True{} : Bool}))))))

def WR81(w: O.Words) -> Data:
  DK.Ex(Nat, dB => DK.Ex(FD.array__Tree<U32>, TB => DK.P2({w == O.Words{FD.array__thaw(U32, TB), 161} : O.Words}, DK.P2({S.BitsValue{WBV.wbits(O.Words{FD.array__thaw(U32, TB), 161}, 1281n)} == V2S8.V1281(TB) : S.Value},
    DK.P2({FD.array__perfect(U32, dB, TB) == True{} : Bool}, DK.P2({Nat.is_lt(dB, 28n) == True{} : Bool}, DK.P2({Nat.is_le(161n, A.quad(VB.pw(dB))) == True{} : Bool},
    DK.P2({V81.HTZ(TB) == True{} : Bool}, {V81.HBZ(dB, TB) == True{} : Bool}))))))))

def fcn1280(+t: FD.array__Tree<U32>, +N: U32, +fc: WBV.fct(O.Words{FD.array__thaw(U32, t), N}, 1280n)) -> {Nat.is_eq(U32.to_nat(N), 160n) == True{} : Bool}:
  (+a, +b) = fc
  a

def ww1280(-w: O.Words, +rp: WBV.rep_bvb(w, 1280n), +hs: SDW(w, 31n, 160n)) -> WR80(w):
  (+wf, +fc) = rp
  (+t, +a1) = wf
  (+dw, +a2) = a1
  (+N, +a3) = a2
  (+q, +a4) = a3
  (+r, +a5) = a4
  (+ew, +a6) = a5
  (+pfw, +a7) = a6
  (+hdw, +a8) = a7
  (+eN, +a9) = a8
  (+hr1, +a10) = a9
  (+hr32, +a11) = a10
  (+he8, +hpad) = a11
  (+d, +s1) = hs
  (+had, +s2) = s1
  (+hd, +hr0) = s2
  +fcN = fcn1280(t, N, FD.logic__subst(O.Words, z => WBV.fct(z, 1280n), w, O.Words{FD.array__thaw(U32, t), N}, ew, fc))
  +eNB = XW.ninj(N, 160, 160n, FD.nat__eq_from_is_eq(U32.to_nat(N), 160n, fcN), {==})
  +ew2 = Equal.trans(O.Words, w, O.Words{FD.array__thaw(U32, t), N}, O.Words{FD.array__thaw(U32, t), 160}, ew, Equal.cong(U32, O.Words, z => O.Words{FD.array__thaw(U32, t), z}, N, 160, eNB))
  +had2 = FD.logic__subst(O.Words, z => {E3.at_depth(z, d) == True{} : Bool}, w, O.Words{FD.array__thaw(U32, t), 160}, ew2, had)
  +pf = FD.logic__subst(FD.array__Tree<U32>, z => {FD.array__perfect(U32, d, z) == True{} : Bool}, FD.array__freeze(U32, FD.array__thaw(U32, t)), t, FD.array__freeze_thaw(U32, t), had2)
  +hr = FD.nat__le_trans(40n, 160n, A.quad(VB.pw(d)), {==}, hr0)
  +hr4 = A.quad_lt(39n, VB.pw(d), FD.nat__lt_le_trans(A.quad(39n), 160n, A.quad(VB.pw(d)), {==}, hr0))
  +hr5 = FD.nat__lt_succ_le_succ(39n, VB.pw(d), hr4)
  +ev = v1280(t)
  (d, (t, (ew2, (ev, (pf, (hd, hr5))))))

def fcn1281(+t: FD.array__Tree<U32>, +N: U32, +fc: WBV.fct(O.Words{FD.array__thaw(U32, t), N}, 1281n)) -> {Nat.is_eq(U32.to_nat(N), 161n) == True{} : Bool}:
  (+a, +b) = fc
  a

def ww1281(-w: O.Words, +rp: WBV.rep_bvb(w, 1281n), +hs: SDW81(w)) -> WR81(w):
  (+wf, +fc) = rp
  (+t, +a1) = wf
  (+dw, +a2) = a1
  (+N, +a3) = a2
  (+q, +a4) = a3
  (+r, +a5) = a4
  (+ew, +a6) = a5
  (+pfw, +a7) = a6
  (+hdw, +a8) = a7
  (+eN, +a9) = a8
  (+hr1, +a10) = a9
  (+hr32, +a11) = a10
  (+he8, +hpad) = a11
  (+d, +s1) = hs
  (+had, +s2) = s1
