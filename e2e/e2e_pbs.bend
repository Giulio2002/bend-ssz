def v1280(+TB: FD.array__Tree<U32>) -> {S.BitsValue{WBV.wbits(O.Words{FD.array__thaw(U32, TB), 160}, 1280n)} == V2S8.V1280(TB) : S.Value}:
  %Equal.sym(FD.array__Tree<U32>, FD.array__freeze(U32, FD.array__thaw(U32, TB)), TB, FD.array__freeze_thaw(U32, TB)) :
    {S.BitsValue{BK.btk(1280n, BK.bitsof(FD.array__slots(U32, _)))} == V2S8.V1280(TB) : S.Value}
  %Equal.sym(+List<Bool>, FB.bitsof(VS.wtake(40n, UW.SLW(TB))), BK.bitsof(VS.wtake(40n, UW.SLW(TB))), fbk(VS.wtake(40n, UW.SLW(TB)))) :
    {S.BitsValue{BK.btk(1280n, BK.bitsof(FD.array__slots(U32, TB)))} == S.BitsValue{_} : S.Value}
  Equal.cong(+List<Bool>, S.Value, z => S.BitsValue{z}, BK.btk(m32(40n), BK.bitsof(FD.array__slots(U32, TB))), BK.bitsof(VS.wtake(40n, FD.array__slots(U32, TB))), bk(40n, FD.array__slots(U32, TB)))

def v1281(+TB: FD.array__Tree<U32>, +h: {Nat.is_lt(40n, FD.spec_common__length(U32, FD.array__slots(U32, TB))) == True{} : Bool}) -> {S.BitsValue{WBV.wbits(O.Words{FD.array__thaw(U32, TB), 161}, 1281n)} == V2S8.V1281(TB) : S.Value}:
  %Equal.sym(FD.array__Tree<U32>, FD.array__freeze(U32, FD.array__thaw(U32, TB)), TB, FD.array__freeze_thaw(U32, TB)) :
    {S.BitsValue{BK.btk(1281n, BK.bitsof(FD.array__slots(U32, _)))} == V2S8.V1281(TB) : S.Value}
  %Equal.sym(+List<Bool>, FB.bitsof(VS.wtake(40n, UW.SLW(TB))), BK.bitsof(VS.wtake(40n, UW.SLW(TB))), fbk(VS.wtake(40n, UW.SLW(TB)))) :
    {S.BitsValue{BK.btk(1281n, BK.bitsof(FD.array__slots(U32, TB)))} == S.BitsValue{List.append(&2, Bool, _, [G81.LB(V2S8.W40(TB))])} : S.Value}
  Equal.cong(+List<Bool>, S.Value, z => S.BitsValue{z}, BK.btk(Nat.add(m32(40n), 1n), BK.bitsof(FD.array__slots(U32, TB))), List.append(&2, Bool, BK.bitsof(VS.wtake(40n, FD.array__slots(U32, TB))), [G81.LB(U32.and(FD.flat__nthc(FD.array__slots(U32, TB), 40n), 255))]), bk1(40n, FD.array__slots(U32, TB), h))

# ---- the size bound: 418 + 4 bit lists + 4 progressive bit lists (each <= P + 1) <= 4 (2 (2 P)) ----
def mono2(+x: Nat, +x2: Nat, +y: Nat, +y2: Nat, +hx: {Nat.is_le(x, x2) == True{} : Bool}, +hy: {Nat.is_le(y, y2) == True{} : Bool})
    -> {Nat.is_le(Nat.add(x, y), Nat.add(x2, y2)) == True{} : Bool}:
  FD.nat__le_trans(Nat.add(x, y), Nat.add(x2, y), Nat.add(x2, y2), Order.add_right(x, x2, y, hx), FD.nat__le_add_left(y, y2, x2, hy))

# c + (P + 1) <= P + P for c + 1 <= P
def cb(+c: Nat, +P: Nat, +hc: {Nat.is_le(Nat.add(c, 1n), P) == True{} : Bool}) -> {Nat.is_le(Nat.add(c, Nat.add(P, 1n)), Nat.add(P, P)) == True{} : Bool}:
  +e1 = Equal.trans(Nat, Nat.add(c, Nat.add(P, 1n)), Nat.add(c, Nat.add(1n, P)), Nat.add(Nat.add(c, 1n), P),
    Equal.cong(Nat, Nat, z => Nat.add(c, z), Nat.add(P, 1n), Nat.add(1n, P), FD.nat__add_comm(P, 1n)), Equal.sym(Nat, Nat.add(Nat.add(c, 1n), P), Nat.add(c, Nat.add(1n, P)), FD.nat__add_assoc(c, 1n, P)))
  FD.logic__subst(Nat, z => {Nat.is_le(z, Nat.add(P, P)) == True{} : Bool}, Nat.add(Nat.add(c, 1n), P), Nat.add(c, Nat.add(P, 1n)), Equal.sym(Nat, Nat.add(c, Nat.add(P, 1n)), Nat.add(Nat.add(c, 1n), P), e1),
    Order.add_right(Nat.add(c, 1n), P, P, hc))

# (A + c) + d <= M + (P + P) for A <= M, c <= cm, d <= P + 1, cm + 1 <= P
def stg(+A: Nat, +M: Nat, +c: Nat, +cm: Nat, +d: Nat, +P: Nat, +hA: {Nat.is_le(A, M) == True{} : Bool}, +hc: {Nat.is_le(c, cm) == True{} : Bool},
    +hd: {Nat.is_le(d, Nat.add(P, 1n)) == True{} : Bool}, +hcP: {Nat.is_le(Nat.add(cm, 1n), P) == True{} : Bool}) -> {Nat.is_le(Nat.add(Nat.add(A, c), d), Nat.add(M, Nat.add(P, P))) == True{} : Bool}:
  +h1 = mono2(Nat.add(A, c), Nat.add(M, cm), d, Nat.add(P, 1n), mono2(A, M, c, cm, hA, hc), hd)
  +h2 = FD.nat__le_add_left(Nat.add(cm, Nat.add(P, 1n)), Nat.add(P, P), M, cb(cm, P, hcP))
  +h3 = FD.logic__subst(Nat, z => {Nat.is_le(z, Nat.add(M, Nat.add(P, P))) == True{} : Bool}, Nat.add(M, Nat.add(cm, Nat.add(P, 1n))), Nat.add(Nat.add(M, cm), Nat.add(P, 1n)),
    Equal.sym(Nat, Nat.add(Nat.add(M, cm), Nat.add(P, 1n)), Nat.add(M, Nat.add(cm, Nat.add(P, 1n))), FD.nat__add_assoc(M, cm, Nat.add(P, 1n))), h2)
  FD.nat__le_trans(Nat.add(Nat.add(A, c), d), Nat.add(Nat.add(M, cm), Nat.add(P, 1n)), Nat.add(M, Nat.add(P, P)), h1, h3)

# ((D + D) + D) + D == quad(double P), D = P + P
def q8(+P: Nat) -> {Nat.add(Nat.add(Nat.add(Nat.add(P, P), Nat.add(P, P)), Nat.add(P, P)), Nat.add(P, P)) == A.quad(Nat.double(P)) : Nat}:
  +D = Nat.add(P, P)
  +dP = Nat.double(P)
  +ddP = Nat.double(Nat.double(P))
  +t1 = FD.nat__add_assoc(Nat.add(D, D), D, D)
  +t2 = Equal.cong(Nat, Nat, z => Nat.add(Nat.add(z, z), Nat.add(z, z)), D, dP, Equal.sym(Nat, dP, D, FD.lru_nat_algebra__double_self(P)))
  +t3 = Equal.cong(Nat, Nat, z => Nat.add(z, z), Nat.add(dP, dP), ddP, Equal.sym(Nat, ddP, Nat.add(dP, dP), FD.lru_nat_algebra__double_self(dP)))
  +t4 = Equal.sym(Nat, Nat.double(ddP), Nat.add(ddP, ddP), FD.lru_nat_algebra__double_self(ddP))
  Equal.trans(Nat, Nat.add(Nat.add(Nat.add(D, D), D), D), Nat.add(Nat.add(D, D), Nat.add(D, D)), Nat.double(ddP), t1,
    Equal.trans(Nat, Nat.add(Nat.add(D, D), Nat.add(D, D)), Nat.add(Nat.add(dP, dP), Nat.add(dP, dP)), Nat.double(ddP), t2,
    Equal.trans(Nat, Nat.add(Nat.add(dP, dP), Nat.add(dP, dP)), Nat.add(ddP, ddP), Nat.double(ddP), t3, t4)))

# the record's size bound, P = 2^27 symbolic
def sizeb(+P: Nat, +a: Nat, +b: Nat, +c: Nat, +d: Nat, +e: Nat, +f: Nat, +g: Nat, +h: Nat,
    +ha: {Nat.is_le(a, 33n) == True{} : Bool}, +hb: {Nat.is_le(b, Nat.add(P, 1n)) == True{} : Bool}, +hc: {Nat.is_le(c, 33n) == True{} : Bool}, +hd: {Nat.is_le(d, Nat.add(P, 1n)) == True{} : Bool},
    +he: {Nat.is_le(e, 161n) == True{} : Bool}, +hf: {Nat.is_le(f, Nat.add(P, 1n)) == True{} : Bool}, +hg: {Nat.is_le(g, 161n) == True{} : Bool}, +hh: {Nat.is_le(h, Nat.add(P, 1n)) == True{} : Bool},    +hP: {Nat.is_le(Nat.add(451n, 1n), P) == True{} : Bool}, +hQ: {Nat.is_le(Nat.add(161n, 1n), P) == True{} : Bool}, +hR: {Nat.is_le(Nat.add(33n, 1n), P) == True{} : Bool})
    -> {Nat.is_le(Nat.add(Nat.add(Nat.add(Nat.add(Nat.add(Nat.add(Nat.add(Nat.add(418n, a), b), c), d), e), f), g), h), A.quad(Nat.double(P))) == True{} : Bool}:
  +x1 = FD.nat__le_trans(Nat.add(Nat.add(418n, a), b), Nat.add(451n, Nat.add(P, 1n)), Nat.add(P, P), mono2(Nat.add(418n, a), 451n, b, Nat.add(P, 1n), FD.nat__le_add_left(a, 33n, 418n, ha), hb), cb(451n, P, hP))
  +x2 = stg(Nat.add(Nat.add(418n, a), b), Nat.add(P, P), c, 33n, d, P, x1, hc, hd, hR)
  +x3 = stg(Nat.add(Nat.add(Nat.add(Nat.add(418n, a), b), c), d), Nat.add(Nat.add(P, P), Nat.add(P, P)), e, 161n, f, P, x2, he, hf, hQ)
  +x4 = stg(Nat.add(Nat.add(Nat.add(Nat.add(Nat.add(Nat.add(418n, a), b), c), d), e), f), Nat.add(Nat.add(Nat.add(P, P), Nat.add(P, P)), Nat.add(P, P)), g, 161n, h, P, x3, hg, hh, hQ)
  FD.logic__subst(Nat, z => {Nat.is_le(Nat.add(Nat.add(Nat.add(Nat.add(Nat.add(Nat.add(Nat.add(Nat.add(418n, a), b), c), d), e), f), g), h), z) == True{} : Bool}, Nat.add(Nat.add(Nat.add(Nat.add(P, P), Nat.add(P, P)), Nat.add(P, P)), Nat.add(P, P)), A.quad(Nat.double(P)), q8(P), x4)

# ... at P = 2^27 (passed, never let-bound)
def sz28(+a: Nat, +b: Nat, +c: Nat, +d: Nat, +e: Nat, +f: Nat, +g: Nat, +h: Nat,
    +ha: {Nat.is_le(a, 33n) == True{} : Bool}, +hb: {Nat.is_le(b, Nat.add(VB.pw(27n), 1n)) == True{} : Bool}, +hc: {Nat.is_le(c, 33n) == True{} : Bool}, +hd: {Nat.is_le(d, Nat.add(VB.pw(27n), 1n)) == True{} : Bool},
    +he: {Nat.is_le(e, 161n) == True{} : Bool}, +hf: {Nat.is_le(f, Nat.add(VB.pw(27n), 1n)) == True{} : Bool}, +hg: {Nat.is_le(g, 161n) == True{} : Bool}, +hh: {Nat.is_le(h, Nat.add(VB.pw(27n), 1n)) == True{} : Bool})
    -> {Nat.is_le(Nat.add(Nat.add(Nat.add(Nat.add(Nat.add(Nat.add(Nat.add(Nat.add(418n, a), b), c), d), e), f), g), h), A.quad(VB.pw(28n))) == True{} : Bool}:
  sizeb(VB.pw(27n), a, b, c, d, e, f, g, h, ha, hb, hc, hd, he, hf, hg, hh,
    FD.nat__le_trans(Nat.add(451n, 1n), VB.pw(9n), VB.pw(27n), {==}, VBG.pw_mono(9n, 27n, {==})),
    FD.nat__le_trans(Nat.add(161n, 1n), VB.pw(9n), VB.pw(27n), {==}, VBG.pw_mono(9n, 27n, {==})),
    FD.nat__le_trans(Nat.add(33n, 1n), VB.pw(9n), VB.pw(27n), {==}, VBG.pw_mono(9n, 27n, {==})))

# ---- the 257-bit vector's last word holds one bit (rp_bv257): bv257_valid ----
def lt2b(+b: Bool) -> {U32.is_lt(U32{WSp.join(1n, 31n, WCon{b, WNil{}}, Word.zero(31n))}, 2) == True{} : Bool}:
  match b:
    case True{}: {==}
    case False{}: {==}

def lt2(+X: Word(1n)) -> {U32.is_lt(U32{WSp.join(1n, 31n, X, Word.zero(31n))}, 2) == True{} : Bool}:
  match X:
    case WCon{+b, WNil{}}: lt2b(b)

def v257ok(+x: bitvector_257_d.Bitvector257, +rp: RN.rp_bv257(x)) -> {bitvector_257_e.bv257_valid(x) == True{} : Bool}:
  match x:
    case bitvector_257_d.Bitvector257{+w0, +w1, +w2, +w3, +w4, +w5, +w6, +w7, +w8}:
      %Equal.sym(U32, w8, U32{WSp.join(1n, 31n, WSp.take(1n, 32n, PD.bits(w8)), Word.zero(31n))}, rp) : {U32.is_lt(_, 2) == True{} : Bool}
      lt2(WSp.take(1n, 32n, PD.bits(w8)))

# ---- a bit list the root law represents (wfb, within its limit), with its premise SDB: its encode record ----
# SDB: the storage's tree at a depth below Kd, room for word K / 32, zero bits above K in it (what wfb does not give)
def SDB(o: O.Bits, +Kd: Nat) -> Data:
  DK.Ex(FD.array__Tree<U32>, T => DK.Ex(Nat, dw => DK.Ex(U32, K => DK.P2({o == O.Bits{FD.array__thaw(U32, T), K} : O.Bits},
    DK.P2({FD.array__perfect(U32, dw, T) == True{} : Bool},
    DK.P2({Nat.is_lt(dw, Kd) == True{} : Bool},
    DK.P2({Nat.is_le(Nat.add(U32.to_nat(U32.shrn(K, 5n)), 1n), VB.pw(dw)) == True{} : Bool},
    {O.bits_above_zero(U32.and(K, 31), RD.wd(T, dw, U32.shrn(K, 5n))) == True{} : Bool})))))))

def k8_256() -> {Nat.is_le(Nat.add(256n, 8n), O.pow2n(9n)) == True{} : Bool}: {==}

def BR256(w: O.Bits) -> Data:
  DK.Ex(EX_bits256.MB, m => DK.P2({w == EX_bits256.TH(m) : O.Bits}, DK.P2({S.BitsValue{BO.bview(EX_bits256.TH(m))} == EX_bits256.VAL(m) : S.Value},
    DK.P2({EX_bits256.OK(m) == True{} : Bool}, {Nat.is_le(LY.LN(EX_bits256.ENC(m)), Nat.add(VD.s_rng(3n, 256n), 1n)) == True{} : Bool}))))

def bv256(+dw: Nat, +T: FD.array__Tree<U32>, +K: U32) -> {S.BitsValue{BO.bview(O.Bits{FD.array__thaw(U32, T), K})} == EX_bits256.VAL(EX_bits256.MB{dw, T, K, 256n, 9n, 9n}) : S.Value}:
  %Equal.sym(FD.array__Tree<U32>, FD.array__freeze(U32, FD.array__thaw(U32, T)), T, FD.array__freeze_thaw(U32, T)) :
    {S.BitsValue{BK.btk(U32.to_nat(K), BK.bitsof(FD.array__slots(U32, _)))} == EX_bits256.VAL(EX_bits256.MB{dw, T, K, 256n, 9n, 9n}) : S.Value}
