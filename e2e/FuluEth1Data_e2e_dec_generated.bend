    case True{}: Empty.absurd({Pair.snd(B.Buf, Maybe<&1, T.Eth1Data>, T.Eth1Data_decode(B.fill_at(B.alloc(n), 0, bs), n)) == None{} : Maybe<&1, T.Eth1Data>}, FD.logic__none_some(S.Value, M3.v_Eth1Data(T.Eth1Data{T.Bytes32{E.wn(0n, bs), E.wn(1n, bs), E.wn(2n, bs), E.wn(3n, bs), E.wn(4n, bs), E.wn(5n, bs), E.wn(6n, bs), E.wn(7n, bs)}, O.U64{E.wn(8n, bs), E.wn(9n, bs)}, T.Bytes32{E.wn(10n, bs), E.wn(11n, bs), E.wn(12n, bs), E.wn(13n, bs), E.wn(14n, bs), E.wn(15n, bs), E.wn(16n, bs), E.wn(17n, bs)}}), Equal.trans(Maybe<&2, S.Value>, None{}, API.deserialize(Spec.Eth1Data(), bs), Some{M3.v_Eth1Data(T.Eth1Data{T.Bytes32{E.wn(0n, bs), E.wn(1n, bs), E.wn(2n, bs), E.wn(3n, bs), E.wn(4n, bs), E.wn(5n, bs), E.wn(6n, bs), E.wn(7n, bs)}, O.U64{E.wn(8n, bs), E.wn(9n, bs)}, T.Bytes32{E.wn(10n, bs), E.wn(11n, bs), E.wn(12n, bs), E.wn(13n, bs), E.wn(14n, bs), E.wn(15n, bs), E.wn(16n, bs), E.wn(17n, bs)}})}, Equal.sym(Maybe<&2, S.Value>, API.deserialize(Spec.Eth1Data(), bs), None{}, an), FuluEth1Data_d_asome(bs, hd, ec))))

# (ii) the object decoder returns o exactly when END_TO_END's deserialize returns VAL(o).
def FuluEth1Data_e2e_decode_accept(+bs: +List<U32>, +n: U32, +o: T.Eth1Data, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +hd: {SP.bytes_domain(bs) == True{} : Bool})
    -> ({Pair.snd(B.Buf, Maybe<&1, T.Eth1Data>, T.Eth1Data_decode(B.fill_at(B.alloc(n), 0, bs), n)) == Some{o} : Maybe<&1, T.Eth1Data>} -> {API.deserialize(Spec.Eth1Data(), bs) == Some{M3.v_Eth1Data(o)} : Maybe<&2, S.Value>}) & ({API.deserialize(Spec.Eth1Data(), bs) == Some{M3.v_Eth1Data(o)} : Maybe<&2, S.Value>} -> {Pair.snd(B.Buf, Maybe<&1, T.Eth1Data>, T.Eth1Data_decode(B.fill_at(B.alloc(n), 0, bs), n)) == Some{o} : Maybe<&1, T.Eth1Data>}):
  (da => FuluEth1Data_d_ia(bs, n, o, hn, hd, Nat.is_eq(List.length(&2, U32, bs), 72n), {==}, da), aa => FuluEth1Data_d_ib(bs, n, o, hn, Nat.is_eq(List.length(&2, U32, bs), 72n), {==}, aa))

# (iii) the object decoder fails exactly when END_TO_END's deserialize does.
def FuluEth1Data_e2e_decode_reject(+bs: +List<U32>, +n: U32, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +hd: {SP.bytes_domain(bs) == True{} : Bool})
    -> ({Pair.snd(B.Buf, Maybe<&1, T.Eth1Data>, T.Eth1Data_decode(B.fill_at(B.alloc(n), 0, bs), n)) == None{} : Maybe<&1, T.Eth1Data>} -> {API.deserialize(Spec.Eth1Data(), bs) == None{} : Maybe<&2, S.Value>}) & ({API.deserialize(Spec.Eth1Data(), bs) == None{} : Maybe<&2, S.Value>} -> {Pair.snd(B.Buf, Maybe<&1, T.Eth1Data>, T.Eth1Data_decode(B.fill_at(B.alloc(n), 0, bs), n)) == None{} : Maybe<&1, T.Eth1Data>}):
  (dn => FuluEth1Data_d_ra(bs, n, hn, hd, Nat.is_eq(List.length(&2, U32, bs), 72n), {==}, dn), an => FuluEth1Data_d_rb(bs, n, hn, hd, Nat.is_eq(List.length(&2, U32, bs), 72n), {==}, an))

