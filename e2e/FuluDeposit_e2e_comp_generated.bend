# the value deserialize gives for the accepted bytes is the decoded object's view
def acc(+bs: +List<U32>, +n: U32, -o: FuluDeposit_d.Deposit, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +hd: {SP.bytes_domain(bs) == True{} : Bool}, dec: {Pair.snd(B.Buf, Maybe<&1, FuluDeposit_d.Deposit>, FuluDeposit_r.Deposit_decode(B.fill_at(B.alloc(n), 0, bs), n)) == Some{o} : Maybe<&1, FuluDeposit_d.Deposit>})
    -> {API.deserialize(Spec.Deposit(), bs) == Some{M1.v_Deposit(o)} : Maybe<&2, S.Value>}:
  Equal.trans(Maybe<&2, S.Value>, API.deserialize(Spec.Deposit(), bs), DB.FuluDeposit_mv(Pair.snd(B.Buf, Maybe<&1, FuluDeposit_d.Deposit>, FuluDeposit_r.Deposit_decode(B.fill_at(B.alloc(n), 0, bs), n))), Some{M1.v_Deposit(o)},
    Equal.sym(Maybe<&2, S.Value>, DB.FuluDeposit_mv(Pair.snd(B.Buf, Maybe<&1, FuluDeposit_d.Deposit>, FuluDeposit_r.Deposit_decode(B.fill_at(B.alloc(n), 0, bs), n))), API.deserialize(Spec.Deposit(), bs), DB.FuluDeposit_e2e_decode_view(bs, n, hn, hd)),
    Equal.cong(Maybe<&1, FuluDeposit_d.Deposit>, Maybe<&2, S.Value>, z => DB.FuluDeposit_mv(z), Pair.snd(B.Buf, Maybe<&1, FuluDeposit_d.Deposit>, FuluDeposit_r.Deposit_decode(B.fill_at(B.alloc(n), 0, bs), n)), Some{o}, dec))

