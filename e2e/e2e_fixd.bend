        Word.and(32n, w, WSp.join(16n, 16n, WSp.ones(16n), Word.zero(16n))),
        WSp.join(16n, 16n, WSp.take(16n, 32n, w), Word.zero(16n)), WSp.mask_take(16n, 16n, w))

def m16(+v: U32, +e: {U32.is_lt(v, 65536) == True{} : Bool}) -> {U32.and(v, 65535) == v : U32}:
