    Equal.sym(U32, v, PD.embed8(WSp.take(8n, 32n, PD.bits(v))), ID.byte_shape(v, e)))

def msk16(+x: U32) -> {U32.and(x, 65535) == U32{WSp.join(16n, 16n, WSp.take(16n, 32n, PD.bits(x)), Word.zero(16n))} : U32}:
