# Sub-word leaves (codegen/e2e_fix_d.py): a word below 256 is its low byte, a word below 65536 its low half.

def msk8(+x: U32) -> {U32.and(x, 255) == PD.embed8(WSp.take(8n, 32n, PD.bits(x))) : U32}:
