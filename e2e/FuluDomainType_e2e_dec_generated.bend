      +eb = FD.logic__some_inj(+List<U32>, F.limbs([y0, y1, y2, y3]), bs, Equal.trans(Maybe<&2, +List<U32>>, Some{F.limbs([y0, y1, y2, y3])}, Encoding.encoding_for_legal_type(Spec.Fork(), M3.v_Fork(T.Fork{T.Bytes4{y0}, T.Bytes4{y1}, O.U64{y2, y3}})), Some{bs},
        Equal.sym(Maybe<&2, +List<U32>>, Encoding.encoding_for_legal_type(Spec.Fork(), M3.v_Fork(T.Fork{T.Bytes4{y0}, T.Bytes4{y1}, O.U64{y2, y3}})), Some{F.limbs([y0, y1, y2, y3])}, M1.Fork_spec_encode(y0, y1, y2, y3)),
        E.acc_dec(Spec.Fork(), bs, M3.v_Fork(T.Fork{T.Bytes4{y0}, T.Bytes4{y1}, O.U64{y2, y3}}), E2E.accepted_spec(Spec.Fork(), bs, M3.v_Fork(T.Fork{T.Bytes4{y0}, T.Bytes4{y1}, O.U64{y2, y3}}), aa))))
      %Equal.sym(U32, n, 16, E.u32_len(n, List.length(&2, U32, bs), 16, hn, ec)) :
        {Pair.snd(B.Buf, Maybe<&1, T.Fork>, T.Fork_decode(B.fill_at(B.alloc(_), 0, bs), _)) == Some{T.Fork{T.Bytes4{y0}, T.Bytes4{y1}, O.U64{y2, y3}}} : Maybe<&1, T.Fork>}
      %eb :
        {Pair.snd(B.Buf, Maybe<&1, T.Fork>, T.Fork_decode(B.fill_at(B.alloc(16), 0, _), 16)) == Some{T.Fork{T.Bytes4{y0}, T.Bytes4{y1}, O.U64{y2, y3}}} : Maybe<&1, T.Fork>}
      Equal.cong(B.Buf & Maybe<&1, T.Fork>, Maybe<&1, T.Fork>, q => Pair.snd(B.Buf, Maybe<&1, T.Fork>, q), T.Fork_decode(B.fill_at(B.alloc(16), 0, F.limbs([y0, y1, y2, y3])), 16), (B.fill_at(B.alloc(16), 0, F.limbs([y0, y1, y2, y3])), Some{T.Fork{T.Bytes4{y0}, T.Bytes4{y1}, O.U64{y2, y3}}}),
        M0.Fork_spec_input(y0, y1, y2, y3))

def FuluFork_d_ib(+bs: +List<U32>, +n: U32, +o: T.Fork, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +c: Bool, +ec: {Nat.is_eq(List.length(&2, U32, bs), 16n) == c : Bool}, +aa: {API.deserialize(Spec.Fork(), bs) == Some{M3.v_Fork(o)} : Maybe<&2, S.Value>}) -> {Pair.snd(B.Buf, Maybe<&1, T.Fork>, T.Fork_decode(B.fill_at(B.alloc(n), 0, bs), n)) == Some{o} : Maybe<&1, T.Fork>}:
  match c:
    case False{}: Empty.absurd({Pair.snd(B.Buf, Maybe<&1, T.Fork>, T.Fork_decode(B.fill_at(B.alloc(n), 0, bs), n)) == Some{o} : Maybe<&1, T.Fork>}, FD.logic__none_some(S.Value, M3.v_Fork(o), Equal.trans(Maybe<&2, S.Value>, None{}, API.deserialize(Spec.Fork(), bs), Some{M3.v_Fork(o)}, Equal.sym(Maybe<&2, S.Value>, API.deserialize(Spec.Fork(), bs), None{}, FuluFork_d_anone(bs, ec)), aa)))
    case True{}: FuluFork_d_ibt(bs, n, o, hn, ec, aa)

def FuluFork_d_ra(+bs: +List<U32>, +n: U32, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +hd: {SP.bytes_domain(bs) == True{} : Bool}, +c: Bool, +ec: {Nat.is_eq(List.length(&2, U32, bs), 16n) == c : Bool}, +dn: {Pair.snd(B.Buf, Maybe<&1, T.Fork>, T.Fork_decode(B.fill_at(B.alloc(n), 0, bs), n)) == None{} : Maybe<&1, T.Fork>}) -> {API.deserialize(Spec.Fork(), bs) == None{} : Maybe<&2, S.Value>}:
  match c:
    case False{}: FuluFork_d_anone(bs, ec)
    case True{}: Empty.absurd({API.deserialize(Spec.Fork(), bs) == None{} : Maybe<&2, S.Value>}, E.none_some1(T.Fork, T.Fork{T.Bytes4{E.wn(0n, bs)}, T.Bytes4{E.wn(1n, bs)}, O.U64{E.wn(2n, bs), E.wn(3n, bs)}}, Equal.trans(Maybe<&1, T.Fork>, None{}, Pair.snd(B.Buf, Maybe<&1, T.Fork>, T.Fork_decode(B.fill_at(B.alloc(n), 0, bs), n)), Some{T.Fork{T.Bytes4{E.wn(0n, bs)}, T.Bytes4{E.wn(1n, bs)}, O.U64{E.wn(2n, bs), E.wn(3n, bs)}}}, Equal.sym(Maybe<&1, T.Fork>, Pair.snd(B.Buf, Maybe<&1, T.Fork>, T.Fork_decode(B.fill_at(B.alloc(n), 0, bs), n)), None{}, dn), FuluFork_d_some(bs, n, hn, hd, ec))))

def FuluFork_d_rb(+bs: +List<U32>, +n: U32, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +hd: {SP.bytes_domain(bs) == True{} : Bool}, +c: Bool, +ec: {Nat.is_eq(List.length(&2, U32, bs), 16n) == c : Bool}, +an: {API.deserialize(Spec.Fork(), bs) == None{} : Maybe<&2, S.Value>}) -> {Pair.snd(B.Buf, Maybe<&1, T.Fork>, T.Fork_decode(B.fill_at(B.alloc(n), 0, bs), n)) == None{} : Maybe<&1, T.Fork>}:
  match c:
    case False{}: FuluFork_d_none(bs, n, hn, ec)
    case True{}: Empty.absurd({Pair.snd(B.Buf, Maybe<&1, T.Fork>, T.Fork_decode(B.fill_at(B.alloc(n), 0, bs), n)) == None{} : Maybe<&1, T.Fork>}, FD.logic__none_some(S.Value, M3.v_Fork(T.Fork{T.Bytes4{E.wn(0n, bs)}, T.Bytes4{E.wn(1n, bs)}, O.U64{E.wn(2n, bs), E.wn(3n, bs)}}), Equal.trans(Maybe<&2, S.Value>, None{}, API.deserialize(Spec.Fork(), bs), Some{M3.v_Fork(T.Fork{T.Bytes4{E.wn(0n, bs)}, T.Bytes4{E.wn(1n, bs)}, O.U64{E.wn(2n, bs), E.wn(3n, bs)}})}, Equal.sym(Maybe<&2, S.Value>, API.deserialize(Spec.Fork(), bs), None{}, an), FuluFork_d_asome(bs, hd, ec))))

# (ii) the object decoder returns o exactly when END_TO_END's deserialize returns VAL(o).
def FuluFork_e2e_decode_accept(+bs: +List<U32>, +n: U32, +o: T.Fork, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +hd: {SP.bytes_domain(bs) == True{} : Bool})
    -> ({Pair.snd(B.Buf, Maybe<&1, T.Fork>, T.Fork_decode(B.fill_at(B.alloc(n), 0, bs), n)) == Some{o} : Maybe<&1, T.Fork>} -> {API.deserialize(Spec.Fork(), bs) == Some{M3.v_Fork(o)} : Maybe<&2, S.Value>}) & ({API.deserialize(Spec.Fork(), bs) == Some{M3.v_Fork(o)} : Maybe<&2, S.Value>} -> {Pair.snd(B.Buf, Maybe<&1, T.Fork>, T.Fork_decode(B.fill_at(B.alloc(n), 0, bs), n)) == Some{o} : Maybe<&1, T.Fork>}):
  (da => FuluFork_d_ia(bs, n, o, hn, hd, Nat.is_eq(List.length(&2, U32, bs), 16n), {==}, da), aa => FuluFork_d_ib(bs, n, o, hn, Nat.is_eq(List.length(&2, U32, bs), 16n), {==}, aa))

# (iii) the object decoder fails exactly when END_TO_END's deserialize does.
def FuluFork_e2e_decode_reject(+bs: +List<U32>, +n: U32, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +hd: {SP.bytes_domain(bs) == True{} : Bool})
    -> ({Pair.snd(B.Buf, Maybe<&1, T.Fork>, T.Fork_decode(B.fill_at(B.alloc(n), 0, bs), n)) == None{} : Maybe<&1, T.Fork>} -> {API.deserialize(Spec.Fork(), bs) == None{} : Maybe<&2, S.Value>}) & ({API.deserialize(Spec.Fork(), bs) == None{} : Maybe<&2, S.Value>} -> {Pair.snd(B.Buf, Maybe<&1, T.Fork>, T.Fork_decode(B.fill_at(B.alloc(n), 0, bs), n)) == None{} : Maybe<&1, T.Fork>}):
  (dn => FuluFork_d_ra(bs, n, hn, hd, Nat.is_eq(List.length(&2, U32, bs), 16n), {==}, dn), an => FuluFork_d_rb(bs, n, hn, hd, Nat.is_eq(List.length(&2, U32, bs), 16n), {==}, an))

