  %Equal.sym(U32, V.W0(t, x), 8, e8) : RT.rep_v2_VarTestStruct(vec_VarTestStruct_2_d.v2_VarTestStruct_Seq{V.RV(U32.to_nat(U32.sub(U32.shrn(_, 2n), 1)), 0, U32.shrn(_, 2n), d, t, x, off, len, vec_VarTestStruct_2_d.v2_VarTestStruct_fill(vec_VarTestStruct_2_d.v2_VarTestStruct_cap(U32.shrn(_, 2n))), V.OBJE(d, t, x, off, _, V.NX(U32.is_eq(1, U32.shrn(_, 2n)), t, x, len, 0))), U32.shrn(_, 2n)}, s)
  rep8(d, t, x, off, len, h8, s, es, ee)

def sdF(+d: Nat, +t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32, +h: {V.CF(V.HC(V.W0(t, x), len), t, x, off, len) == True{} : Bool})
    -> EV.sv2(V.RZ(False{}, d, t, x, off, len), 31n, 31n):
  +e8 = e8_of(d, t, x, off, len, h)
  +h8 = h8_of(d, t, x, off, len, h)
  %Equal.sym(U32, V.W0(t, x), 8, e8) : EV.sv2(vec_VarTestStruct_2_d.v2_VarTestStruct_Seq{V.RV(U32.to_nat(U32.sub(U32.shrn(_, 2n), 1)), 0, U32.shrn(_, 2n), d, t, x, off, len, vec_VarTestStruct_2_d.v2_VarTestStruct_fill(vec_VarTestStruct_2_d.v2_VarTestStruct_cap(U32.shrn(_, 2n))), V.OBJE(d, t, x, off, _, V.NX(U32.is_eq(1, U32.shrn(_, 2n)), t, x, len, 0))), U32.shrn(_, 2n)}, 31n, 31n)
  sd8(d, t, x, off, len, h8)

# ---- the window at its check: the empty window is rejected ----
def rep_c(+c: Bool, +d: Nat, +t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32, +ec: {U32.is_eq(len, 0) == c : Bool}, +hchk: {V.CHKw(t, x, off, len) == True{} : Bool}, +s: S.Schema, +es: {Nat.is_eq(2n, SH.Vector_length(s)) == True{} : Bool}, +ee: {SH.Vector_element(s) == Spec.VarTestStruct() : S.Schema})
    -> RT.rep_v2_VarTestStruct(V.RZ(c, d, t, x, off, len), s):
  match c:
    case True{}: Empty.absurd(RT.rep_v2_VarTestStruct(V.RZ(True{}, d, t, x, off, len), s), FD.logic__false_true(FD.logic__subst(Bool, z => {V.CZ(z, t, x, off, len) == True{} : Bool}, U32.is_eq(len, 0), True{}, ec, hchk)))
    case False{}: repF(d, t, x, off, len, FD.logic__subst(Bool, z => {V.CZ(z, t, x, off, len) == True{} : Bool}, U32.is_eq(len, 0), False{}, ec, hchk), s, es, ee)

def sd_c(+c: Bool, +d: Nat, +t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32, +ec: {U32.is_eq(len, 0) == c : Bool}, +hchk: {V.CHKw(t, x, off, len) == True{} : Bool})
    -> EV.sv2(V.RZ(c, d, t, x, off, len), 31n, 31n):
  match c:
    case True{}: Empty.absurd(EV.sv2(V.RZ(True{}, d, t, x, off, len), 31n, 31n), FD.logic__false_true(FD.logic__subst(Bool, z => {V.CZ(z, t, x, off, len) == True{} : Bool}, U32.is_eq(len, 0), True{}, ec, hchk)))
    case False{}: sdF(d, t, x, off, len, FD.logic__subst(Bool, z => {V.CZ(z, t, x, off, len) == True{} : Bool}, U32.is_eq(len, 0), False{}, ec, hchk))

# ---- the two laws ----
def sdl(+d: Nat, +t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat}, +hd: {Nat.is_lt(d, 31n) == True{} : Bool},
    +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +hw32: {Nat.is_lt(Nat.add(x, U32.to_nat(len)), FD.spec_common__pow2(32n)) == True{} : Bool},
    +pfw: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hchk: {V.CHKw(t, x, off, len) == True{} : Bool})
    -> EV.sv2(V.OBJw(d, t, x, off, len), 31n, 31n):
  sd_c(U32.is_eq(len, 0), d, t, x, off, len, {==}, hchk)

def rep(+d: Nat, +t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32, +eo: {U32.to_nat(off) == x : Nat}, +hd: {Nat.is_lt(d, 31n) == True{} : Bool},
    +hw: {Nat.is_le(Nat.add(x, U32.to_nat(len)), A.quad(VB.pw(d))) == True{} : Bool}, +hw32: {Nat.is_lt(Nat.add(x, U32.to_nat(len)), FD.spec_common__pow2(32n)) == True{} : Bool},
    +pfw: {FD.array__perfect(U32, d, t) == True{} : Bool}, +s: S.Schema, +es: {Nat.is_eq(2n, SH.Vector_length(s)) == True{} : Bool}, +ee: {SH.Vector_element(s) == Spec.VarTestStruct() : S.Schema}, +hchk: {V.CHKw(t, x, off, len) == True{} : Bool})
    -> RT.rep_v2_VarTestStruct(V.OBJw(d, t, x, off, len), s):
  rep_c(U32.is_eq(len, 0), d, t, x, off, len, {==}, hchk, s, es, ee)
