              match o_2:
                case FuluBytes32_d.Bytes32{+x10, +x11, +x12, +x13, +x14, +x15, +x16, +x17}:
                  {==}

def lv_Checkpoint(+o: FuluCheckpoint_d.Checkpoint) -> {RN_L.v_Checkpoint(o) == CI.LV_Checkpoint(o) : S.Value}:
  match o:
    case FuluCheckpoint_d.Checkpoint{+o_0, +o_1}:
      match o_0:
        case O.U64{+x0, +x1}:
          match o_1:
            case FuluBytes32_d.Bytes32{+x2, +x3, +x4, +x5, +x6, +x7, +x8, +x9}:
              {==}


# ---- the latest execution payload header (boxed): e2e_mw's record, with its encoded length from the object ----
def lenB(+m: EB.MW, +ok: {EB.OK(m) == True{} : Bool}) -> {U32.to_nat(WO_L.len(EB.TH(m))) == LY.LN(EB.ENC(m)) : Nat}:
  match m:
    case EB.MW{+dw, +T, +N}: EB.szx(EB.MW{dw, T, N}, ok)

def lnE(+m: EC_ExecutionPayloadHeader.MW, +ok: {EC_ExecutionPayloadHeader.OK(m) == True{} : Bool})
    -> {LY.LN(EC_ExecutionPayloadHeader.ENC(m)) == Nat.add(584n, U32.to_nat(WO_L.len(RT.pj_ExecutionPayloadHeader_10(EC_ExecutionPayloadHeader.TH(m))))) : Nat}:
  match m:
    case EC_ExecutionPayloadHeader.MW{+a0, +a1, +a2, +a3, +a4, +a5, +a6, +a7, +a8, +a9, +a10, +a11, +a12, +a13, +a14, +a15, +a16, +a17}:
      Equal.trans(Nat, LY.LN(IK.ENCC(a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15, a16, a17)), EC_ExecutionPayloadHeader.ENDC(a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15, a16, a17), Nat.add(584n, U32.to_nat(WO_L.len(EB.TH(a11)))),
        EC_ExecutionPayloadHeader.lenE(a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15, a16, a17, ok),
        Equal.cong(Nat, Nat, z => Nat.add(584n, z), LY.LN(EB.ENC(a11)), U32.to_nat(WO_L.len(EB.TH(a11))),
          Equal.sym(Nat, U32.to_nat(WO_L.len(EB.TH(a11))), LY.LN(EB.ENC(a11)), lenB(a11, EC_ExecutionPayloadHeader.ok_hok_extra_data(a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15, a16, a17, ok)))))

def LNEH(po: O.Boxed<FuluExecutionPayloadHeader_d.ExecutionPayloadHeader>) -> Nat: Nat.add(584n, U32.to_nat(WO_L.len(RT.pj_ExecutionPayloadHeader_10(RT.pjb_ExecutionPayloadHeader_bx(po)))))

def R_EB(po: O.Boxed<FuluExecutionPayloadHeader_d.ExecutionPayloadHeader>) -> Data:
  DK.Ex(EC_ExecutionPayloadHeader.MW, m => DK.P2({po == O.BSome{EC_ExecutionPayloadHeader.TH(m), O.BNone{}} : O.Boxed<FuluExecutionPayloadHeader_d.ExecutionPayloadHeader>},
    DK.P2({RT.v_ExecutionPayloadHeader_bx(O.BSome{EC_ExecutionPayloadHeader.TH(m), O.BNone{}}) == EC_ExecutionPayloadHeader.VAL(m) : S.Value},
    DK.P2({EC_ExecutionPayloadHeader.OKW(m) == True{} : Bool}, {LY.LN(EC_ExecutionPayloadHeader.ENC(m)) == LNEH(po) : Nat}))))

def pk_EB(-po: O.Boxed<FuluExecutionPayloadHeader_d.ExecutionPayloadHeader>, +m: EC_ExecutionPayloadHeader.MW, +e: {po == O.BSome{EC_ExecutionPayloadHeader.TH(m), O.BNone{}} : O.Boxed<FuluExecutionPayloadHeader_d.ExecutionPayloadHeader>},
    +v: {RT.v_ExecutionPayloadHeader_bx(O.BSome{EC_ExecutionPayloadHeader.TH(m), O.BNone{}}) == EC_ExecutionPayloadHeader.VAL(m) : S.Value},
    +ok: {EC_ExecutionPayloadHeader.OKW(m) == True{} : Bool}, +l: {LY.LN(EC_ExecutionPayloadHeader.ENC(m)) == LNEH(po) : Nat}) -> R_EB(po):
  (m, (e, (v, (ok, l))))

def kEB(-po: O.Boxed<FuluExecutionPayloadHeader_d.ExecutionPayloadHeader>, +eb: {po == O.BSome{RT.pjb_ExecutionPayloadHeader_bx(po), O.BNone{}} : O.Boxed<FuluExecutionPayloadHeader_d.ExecutionPayloadHeader>}, +w: MW.R_E(RT.pjb_ExecutionPayloadHeader_bx(po))) -> R_EB(po):
  (+m, w1) = w
  (+e, w2) = w1
  (+v, +ok) = w2
  +e2 = Equal.trans(O.Boxed<FuluExecutionPayloadHeader_d.ExecutionPayloadHeader>, po, O.BSome{RT.pjb_ExecutionPayloadHeader_bx(po), O.BNone{}}, O.BSome{EC_ExecutionPayloadHeader.TH(m), O.BNone{}}, eb,
    Equal.cong(FuluExecutionPayloadHeader_d.ExecutionPayloadHeader, O.Boxed<FuluExecutionPayloadHeader_d.ExecutionPayloadHeader>, z => O.BSome{z, O.BNone{}}, RT.pjb_ExecutionPayloadHeader_bx(po), EC_ExecutionPayloadHeader.TH(m), e))
  +l = Equal.trans(Nat, LY.LN(EC_ExecutionPayloadHeader.ENC(m)), Nat.add(584n, U32.to_nat(WO_L.len(RT.pj_ExecutionPayloadHeader_10(EC_ExecutionPayloadHeader.TH(m))))), LNEH(po), lnE(m, ok),
    Equal.cong(FuluExecutionPayloadHeader_d.ExecutionPayloadHeader, Nat, z => Nat.add(584n, U32.to_nat(WO_L.len(RT.pj_ExecutionPayloadHeader_10(z)))), EC_ExecutionPayloadHeader.TH(m), RT.pjb_ExecutionPayloadHeader_bx(po),
      Equal.sym(FuluExecutionPayloadHeader_d.ExecutionPayloadHeader, RT.pjb_ExecutionPayloadHeader_bx(po), EC_ExecutionPayloadHeader.TH(m), e)))
  pk_EB(po, m, e2, v, ECo.okwOfOkM(m, ok), l)

def mk_EB(-po: O.Boxed<FuluExecutionPayloadHeader_d.ExecutionPayloadHeader>, +s: S.Schema, +es: {s == Spec.ExecutionPayloadHeader() : S.Schema}, +r: RT.rep_ExecutionPayloadHeader_bx(po, s),
    +hs: MW.SHS_E(RT.pjb_ExecutionPayloadHeader_bx(po))) -> R_EB(po):
  (+eb, +ri) = r
  kEB(po, eb, MW.mk_E(RT.pjb_ExecutionPayloadHeader_bx(po), FD.logic__subst(S.Schema, z => RT.rep_ExecutionPayloadHeader(RT.pjb_ExecutionPayloadHeader_bx(po), z), s, Spec.ExecutionPayloadHeader(), es, ri), hs))

