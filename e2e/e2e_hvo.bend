  +eX = FD.logic__subst(U32, z => {VB.slot(CT, Word.to_nat(30n, r)) == O.keep(z, VB.slot(CT, Word.to_nat(30n, r))) : U32}, U32.and(U32{WCon{True{}, WCon{True{}, r}}}, 3), U32{WCon{True{}, WCon{True{}, Word.zero(30n)}}}, Equal.sym(U32, U32{WCon{True{}, WCon{True{}, Word.zero(30n)}}}, U32.and(U32{WCon{True{}, WCon{True{}, r}}}, 3), BF.low_sel(True{}, True{}, r)), kf1)
  HVG.hcoreG2(dz, CT, NB, Word.to_nat(30n, r), h, pf, hdz, hh, eNB2, hq, VB.slot(CT, Word.to_nat(30n, r)), eX, eb)

def hvcn0q(+r: Word(30n), +Qn: Nat, +eq: {Word.to_nat(30n, r) == Qn : Nat}, +dz: Nat, +CT: FD.array__Tree<U32>, +NB: U32, +m: Nat, +h: Nat, +pf: {FD.array__perfect(U32, dz, CT) == True{} : Bool}, +hdz: {Nat.is_lt(dz, 32n) == True{} : Bool}, +hh: {Nat.is_le(h, 7n) == True{} : Bool}, +eNB: {U32.to_nat(NB) == Nat.add(VSP.x8(m), h) : Nat}, +hN: {Nat.is_le(C.nwn(U32.to_nat(U32{WCon{False{}, WCon{False{}, r}}})), FD.spec_common__pow2(dz)) == True{} : Bool}, +hn3: {Nat.is_lt(Nat.add(3n, U32.to_nat(U32{WCon{False{}, WCon{False{}, r}}})), FD.spec_common__pow2(32n)) == True{} : Bool}, +e1: {U32.to_nat(U32{WCon{False{}, WCon{False{}, r}}}) == 1n+m : Nat}, +eh: {VY.hb(VBL.nthb(SF.limbs(FD.array__slots(U32, CT)), m)) == h : Nat}, +kf: {VB.slot(CT, VBY.KW(U32{WCon{False{}, WCon{False{}, r}}})) == O.keep(VBY.RM(U32{WCon{False{}, WCon{False{}, r}}}), VB.slot(CT, VBY.KW(U32{WCon{False{}, WCon{False{}, r}}}))) : U32})
    -> HV.SDX(O.clear_bit(FD.array__thaw(U32, CT), NB), NB, dz):
  match Qn:
    case 0n: Empty.absurd(HV.SDX(O.clear_bit(FD.array__thaw(U32, CT), NB), NB, dz), FD.nat__succ_zero(m, Equal.sym(Nat, 0n, 1n+m, FD.logic__subst(Nat, z => {A.quad(z) == 1n+m : Nat}, Word.to_nat(30n, r), 0n, eq, e1))))
    case 1n+ +Q:
      +em = FD.nat__succ_inj(m, Nat.add(3n, A.quad(Q)), Equal.sym(Nat, A.quad(1n+Q), 1n+m, FD.logic__subst(Nat, z => {A.quad(z) == 1n+m : Nat}, Word.to_nat(30n, r), 1n+Q, eq, e1)))
      +eNB2 = Equal.trans(Nat, U32.to_nat(NB), Nat.add(VSP.x8(m), h), Nat.add(BV.x32(Q), Nat.add(24n, h)), eNB,
        Equal.trans(Nat, Nat.add(VSP.x8(m), h), Nat.add(Nat.add(24n, BV.x32(Q)), h), Nat.add(BV.x32(Q), Nat.add(24n, h)),
          Equal.cong(Nat, Nat, z => Nat.add(z, h), VSP.x8(m), Nat.add(24n, BV.x32(Q)),
            Equal.trans(Nat, VSP.x8(m), VSP.x8(Nat.add(3n, A.quad(Q))), Nat.add(24n, BV.x32(Q)), Equal.cong(Nat, Nat, z => VSP.x8(z), m, Nat.add(3n, A.quad(Q)), em),
              Equal.cong(Nat, Nat, z => Nat.add(24n, z), VSP.x8(A.quad(Q)), BV.x32(Q), BV.x8q(Q)))),
          BV.alg3(24n, BV.x32(Q), h)))
      +hq = FD.nat__succ_le_lt(Q, FD.spec_common__pow2(dz), FD.logic__subst(Nat, z => {Nat.is_le(z, FD.spec_common__pow2(dz)) == True{} : Bool}, C.nwn(U32.to_nat(U32{WCon{False{}, WCon{False{}, r}}})), 1n+Q,
        Equal.trans(Nat, C.nwn(U32.to_nat(U32{WCon{False{}, WCon{False{}, r}}})), Word.to_nat(30n, r), 1n+Q, C.rq(Word.to_nat(30n, r)), eq), hN))
      +hlen = FD.array__len_lt(U32, dz, CT, Q, pf, hq)
      +eh2 = FD.logic__subst(Nat, z => {VY.hb(VBL.nthb(SF.limbs(FD.array__slots(U32, CT)), z)) == h : Nat}, m, Nat.add(3n, A.quad(Q)), em, eh)
      +eb = Equal.trans(Nat, VY.hb(U32.shrn(VB.slot(CT, Q), 24n)), VY.hb(VBL.nthb(SF.limbs(FD.array__slots(U32, CT)), Nat.add(3n, A.quad(Q)))), h,
        Equal.cong(U32, Nat, z => VY.hb(z), U32.shrn(VB.slot(CT, Q), 24n), VBL.nthb(SF.limbs(FD.array__slots(U32, CT)), Nat.add(3n, A.quad(Q))), Equal.sym(U32, VBL.nthb(SF.limbs(FD.array__slots(U32, CT)), Nat.add(3n, A.quad(Q))), U32.shrn(VB.slot(CT, Q), 24n), HV.nlb3(FD.array__slots(U32, CT), Q, hlen))), eh2)
      +eX = {{==} : {VB.slot(CT, Q) == VB.slot(CT, Q) : U32}}
      HVG.hcoreG3(dz, CT, NB, Q, h, pf, hdz, hh, eNB2, hq, VB.slot(CT, Q), eX, eb)

# The bit list on a masked copy CT (vua_ct / vbytes' MK: its last word already masked, kf), the delimiter bit NB cleared,
# NB = 8 m + h, n = 1 + m, h the high bit of the last byte: a tree at CT's depth with room for word NB >> 5, no bit set at or above NB.
def hvctobj(+n: U32, +dz: Nat, +CT: FD.array__Tree<U32>, +NB: U32, +m: Nat, +h: Nat, +pf: {FD.array__perfect(U32, dz, CT) == True{} : Bool}, +hdz: {Nat.is_lt(dz, 32n) == True{} : Bool}, +hh: {Nat.is_le(h, 7n) == True{} : Bool}, +eNB: {U32.to_nat(NB) == Nat.add(VSP.x8(m), h) : Nat}, +hN: {Nat.is_le(C.nwn(U32.to_nat(n)), FD.spec_common__pow2(dz)) == True{} : Bool}, +hn3: {Nat.is_lt(Nat.add(3n, U32.to_nat(n)), FD.spec_common__pow2(32n)) == True{} : Bool}, +e1: {U32.to_nat(n) == 1n+m : Nat}, +eh: {VY.hb(VBL.nthb(SF.limbs(FD.array__slots(U32, CT)), m)) == h : Nat}, +kf: {VB.slot(CT, VBY.KW(n)) == O.keep(VBY.RM(n), VB.slot(CT, VBY.KW(n))) : U32}) -> HV.SDX(O.clear_bit(FD.array__thaw(U32, CT), NB), NB, dz):
  match n:
    case U32{WCon{False{}, WCon{False{}, +r}}}: hvcn0q(r, Word.to_nat(30n, r), {==}, dz, CT, NB, m, h, pf, hdz, hh, eNB, hN, hn3, e1, eh, kf)
    case U32{WCon{True{}, WCon{False{}, +r}}}: hvcn1(r, dz, CT, NB, m, h, pf, hdz, hh, eNB, hN, hn3, e1, eh, kf)
    case U32{WCon{False{}, WCon{True{}, +r}}}: hvcn2(r, dz, CT, NB, m, h, pf, hdz, hh, eNB, hN, hn3, e1, eh, kf)
    case U32{WCon{True{}, WCon{True{}, +r}}}: hvcn3(r, dz, CT, NB, m, h, pf, hdz, hh, eNB, hN, hn3, e1, eh, kf)
