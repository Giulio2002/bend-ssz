          W.RT(U32.to_nat(U32.sub(W.NN(len), 1)), 0n, B.words_depth(W.NN(len)), FD.array__trep(FuluDepositRequest_d.DepositRequest, B.words_depth(W.NN(len)), FuluDepositRequest_d.DepositRequest_default()), t, x),
          FD.array__freeze_thaw(FuluDepositRequest_d.DepositRequest, W.RT(U32.to_nat(U32.sub(W.NN(len), 1)), 0n, B.words_depth(W.NN(len)), FD.array__trep(FuluDepositRequest_d.DepositRequest, B.words_depth(W.NN(len)), FuluDepositRequest_d.DepositRequest_default()), t, x))) :
        {S.Sequence{RT.xi_l8192_DepositRequest(U32.to_nat(W.NN(len)), FD.array__slots(FuluDepositRequest_d.DepositRequest, _), 0n)} == W.VALw(t, x, len) : S.Value}
      %Equal.sym(Nat, U32.to_nat(U32.sub(W.NN(len), 1)), Nat.sub(U32.to_nat(W.NN(len)), U32.to_nat(1)), eQ) : {S.Sequence{RT.xi_l8192_DepositRequest(U32.to_nat(W.NN(len)), FD.array__slots(FuluDepositRequest_d.DepositRequest, W.RT(_, 0n, B.words_depth(W.NN(len)), FD.array__trep(FuluDepositRequest_d.DepositRequest, B.words_depth(W.NN(len)), FuluDepositRequest_d.DepositRequest_default()), t, x)), 0n)} == W.VALw(t, x, len) : S.Value}
      %Equal.sym(Nat, W.CC(len), 1n+k, ecc) : {S.Sequence{RT.xi_l8192_DepositRequest(_, FD.array__slots(FuluDepositRequest_d.DepositRequest, W.RT(Nat.sub(_, U32.to_nat(1)), 0n, B.words_depth(W.NN(len)), FD.array__trep(FuluDepositRequest_d.DepositRequest, B.words_depth(W.NN(len)), FuluDepositRequest_d.DepositRequest_default()), t, x)), 0n)} == S.Sequence{W.RITEMS(_, t, x)} : S.Value}
      %Equal.sym(Nat, Nat.sub(1n+k, U32.to_nat(1)), k, subz(k)) : {S.Sequence{RT.xi_l8192_DepositRequest(1n+k, FD.array__slots(FuluDepositRequest_d.DepositRequest, W.RT(_, 0n, B.words_depth(W.NN(len)), FD.array__trep(FuluDepositRequest_d.DepositRequest, B.words_depth(W.NN(len)), FuluDepositRequest_d.DepositRequest_default()), t, x)), 0n)} == S.Sequence{W.RITEMS(1n+k, t, x)} : S.Value}
      Equal.cong(S.Value, S.Value, z => S.Sequence{z}, RT.xi_l8192_DepositRequest(1n+k, FD.array__slots(FuluDepositRequest_d.DepositRequest, W.RT(k, 0n, B.words_depth(W.NN(len)), FD.array__trep(FuluDepositRequest_d.DepositRequest, B.words_depth(W.NN(len)), FuluDepositRequest_d.DepositRequest_default()), t, x)), 0n), W.RITEMS(1n+k, t, x),
        xiR(1n+k, 0n, k, B.words_depth(W.NN(len)), FD.array__trep(FuluDepositRequest_d.DepositRequest, B.words_depth(W.NN(len)), FuluDepositRequest_d.DepositRequest_default()), t, x, FD.array__trep_perfect(FuluDepositRequest_d.DepositRequest, B.words_depth(W.NN(len)), FuluDepositRequest_d.DepositRequest_default()), hb, hm))

def vlc(+t: FD.array__Tree<U32>, +x: Nat, +len: U32, +hchk: {W.CHKw(t, x, 0, len) == True{} : Bool}, +b: Bool, +eb: {U32.is_eq(len, 0) == b : Bool})
    -> {RT.xv_l8192_DepositRequest(W.LOBJ(b, t, x, len)) == W.VALw(t, x, len) : S.Value}:
  match b:
    case True{}:
      %Equal.sym(U32, len, 0, FD.u32alg__eq_of(len, 0, eb)) : {RT.xv_l8192_DepositRequest(W.LOBJ(True{}, t, x, _)) == W.VALw(t, x, _) : S.Value}
      {==}
    case False{}: vlf(t, x, len, hchk, W.CC(len), {==}, eb)

# the list object a window reads views as the window's value
def vl(+d: Nat, +t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32, +hchk: {W.CHKw(t, x, off, len) == True{} : Bool})
    -> {RT.xv_l8192_DepositRequest(W.OBJw(d, t, x, off, len)) == W.VALw(t, x, len) : S.Value}:
  vlc(t, x, len, hchk, U32.is_eq(len, 0), {==})
