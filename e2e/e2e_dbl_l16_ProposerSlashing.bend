    case True{}: Equal.sym(Nat, U32.to_nat(len), 0n, Equal.cong(U32, Nat, z => U32.to_nat(z), len, 0, FD.u32alg__eq_of(len, 0, ec)))
    case False{}: Equal.trans(Nat, ML.LLX(W.LOBJ(False{}, t, x, len)), Nat.mul(W.CC(len), 416n), U32.to_nat(len), qm(W.CC(len)), Equal.sym(Nat, U32.to_nat(len), Nat.mul(W.CC(len), 416n), W.ecw(len, hchk)))

def szl(+d: Nat, +t: FD.array__Tree<U32>, +x: Nat, +off: U32, +len: U32, +hchk: {W.CHKw(t, x, off, len) == True{} : Bool}) -> {ML.LLX(W.OBJw(d, t, x, off, len)) == U32.to_nat(len) : Nat}:
  szl_c(U32.is_eq(len, 0), d, t, x, off, len, {==}, hchk)
