# (i) for every object the root law takes (e: the last word's bits above 31 are zero).
def bitvector_511_e2e_encode(+o: bitvector_511_d.Bitvector511, +e: {M2.bitvector_511_last(o) == U32{M2_WSp.join(31n, 1n, M2_WSp.take(31n, 32n, M2_PD.bits(M2.bitvector_511_last(o))), Word.zero(1n))} : U32}) -> {Some{E.obytes(bitvector_511_e.bitvector_511_encode(o))} == API.serialize(Spec.bitvector_511(), S.BitsValue{M2.bitvector_511_bits(o)}) : Maybe<&2, +List<U32>>}:
  match o:
    case bitvector_511_d.Bitvector511{+y0, +y1, +y2, +y3, +y4, +y5, +y6, +y7, +y8, +y9, +y10, +y11, +y12, +y13, +y14, +y15}:
      %Equal.sym(U32, y15, U32{WSp.join(31n, 1n, WSp.take(31n, 32n, PD.bits(y15)), Word.zero(1n))}, e) : {Some{E.obytes(bitvector_511_e.bitvector_511_encode(bitvector_511_d.Bitvector511{y0, y1, y2, y3, y4, y5, y6, y7, y8, y9, y10, y11, y12, y13, y14, _}))} == API.serialize(Spec.bitvector_511(), S.BitsValue{M2.bitvector_511_bits(bitvector_511_d.Bitvector511{y0, y1, y2, y3, y4, y5, y6, y7, y8, y9, y10, y11, y12, y13, y14, _})}) : Maybe<&2, +List<U32>>}
      bitvector_511_w(y0, y1, y2, y3, y4, y5, y6, y7, y8, y9, y10, y11, y12, y13, y14, WSp.take(31n, 32n, PD.bits(y15)))

