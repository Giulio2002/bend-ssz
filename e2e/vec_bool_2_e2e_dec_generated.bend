      %Equal.sym(Maybe<&2, S.Value>, API.deserialize(Spec.vec_bool_2(), bs), None{}, vec_bool_2_d_anone(bs, ec)) : {vec_bool_2_mv(None{}) == _ : Maybe<&2, S.Value>}
      {==}
    case True{}:
      vec_bool_2_d_vt(bs, n, hn, hd, ec, M2_SP2.lf([B.byte_sel(0, FD.flat__nthc(L.wlp(bs), 0n)), B.byte_sel(1, FD.flat__nthc(L.wlp(bs), 0n))], True{}), {==})

# (ii) through the view: the view of the decoder's result is END_TO_END's deserialize.
def vec_bool_2_e2e_decode_view(+bs: +List<U32>, +n: U32, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +hd: {SP.bytes_domain(bs) == True{} : Bool}) -> {vec_bool_2_mv(Pair.snd(B.Buf, Maybe<&1, O.Words>, vec_bool_2_r.vec_bool_2_decode(B.fill_at(B.alloc(n), 0, bs), n))) == API.deserialize(Spec.vec_bool_2(), bs) : Maybe<&2, S.Value>}:
  vec_bool_2_d_v(bs, n, hn, hd, Nat.is_eq(List.length(&2, U32, bs), 2n), {==})

def vec_bool_2_d_bn(m: Maybe<&1, O.Words>, +e: {Maybe.is_some(&2, S.Value, vec_bool_2_mv(m)) == False{} : Bool}) -> {m == None{} : Maybe<&1, O.Words>}:
  match m:
    case None{}: {==}
    case Some{x}: Empty.absurd({Some{x} == None{} : Maybe<&1, O.Words>}, FD.logic__false_true(Equal.sym(Bool, True{}, False{}, e)))

# (iii) the object decoder fails exactly when END_TO_END's deserialize does.
def vec_bool_2_e2e_decode_reject(+bs: +List<U32>, +n: U32, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +hd: {SP.bytes_domain(bs) == True{} : Bool})
    -> ({Pair.snd(B.Buf, Maybe<&1, O.Words>, vec_bool_2_r.vec_bool_2_decode(B.fill_at(B.alloc(n), 0, bs), n)) == None{} : Maybe<&1, O.Words>} -> {API.deserialize(Spec.vec_bool_2(), bs) == None{} : Maybe<&2, S.Value>}) & ({API.deserialize(Spec.vec_bool_2(), bs) == None{} : Maybe<&2, S.Value>} -> {Pair.snd(B.Buf, Maybe<&1, O.Words>, vec_bool_2_r.vec_bool_2_decode(B.fill_at(B.alloc(n), 0, bs), n)) == None{} : Maybe<&1, O.Words>}):
  (dn => Equal.trans(Maybe<&2, S.Value>, API.deserialize(Spec.vec_bool_2(), bs), vec_bool_2_mv(Pair.snd(B.Buf, Maybe<&1, O.Words>, vec_bool_2_r.vec_bool_2_decode(B.fill_at(B.alloc(n), 0, bs), n))), None{}, Equal.sym(Maybe<&2, S.Value>, vec_bool_2_mv(Pair.snd(B.Buf, Maybe<&1, O.Words>, vec_bool_2_r.vec_bool_2_decode(B.fill_at(B.alloc(n), 0, bs), n))), API.deserialize(Spec.vec_bool_2(), bs), vec_bool_2_e2e_decode_view(bs, n, hn, hd)),
     Equal.cong(Maybe<&1, O.Words>, Maybe<&2, S.Value>, q => vec_bool_2_mv(q), Pair.snd(B.Buf, Maybe<&1, O.Words>, vec_bool_2_r.vec_bool_2_decode(B.fill_at(B.alloc(n), 0, bs), n)), None{}, dn)),
   an => vec_bool_2_d_bn(Pair.snd(B.Buf, Maybe<&1, O.Words>, vec_bool_2_r.vec_bool_2_decode(B.fill_at(B.alloc(n), 0, bs), n)), Equal.cong(Maybe<&2, S.Value>, Bool, z => Maybe.is_some(&2, S.Value, z), vec_bool_2_mv(Pair.snd(B.Buf, Maybe<&1, O.Words>, vec_bool_2_r.vec_bool_2_decode(B.fill_at(B.alloc(n), 0, bs), n))), None{}, Equal.trans(Maybe<&2, S.Value>, vec_bool_2_mv(Pair.snd(B.Buf, Maybe<&1, O.Words>, vec_bool_2_r.vec_bool_2_decode(B.fill_at(B.alloc(n), 0, bs), n))), API.deserialize(Spec.vec_bool_2(), bs), None{}, vec_bool_2_e2e_decode_view(bs, n, hn, hd), an))))

