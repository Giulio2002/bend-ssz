# ---- the output buffer of a byte-storage encoder at depth DO(N) (vlist.OUTP), storage depth below 28 ----

def nwp(+dw: Nat, +N: U32, +hdw: {Nat.is_lt(dw, 28n) == True{} : Bool}, +hn: {Nat.is_le(U32.to_nat(N), A.quad(VB.pw(dw))) == True{} : Bool})
