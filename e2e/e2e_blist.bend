# ---- the (i) premise: byte storage as the root law's invariant (list_obj.wfl), at depth below k ----
# (the encode laws take storage depth below their own bound; the root law's invariant gives dw < 32)

def sdk0(w: O.Words, +k: Nat) -> Data:
  DK.Ex(FD.array__Tree<U32>, t => DK.Ex(Nat, dw => DK.Ex(U32, N =>
    DK.P2({w == O.Words{FD.array__thaw(U32, t), N} : O.Words},
    DK.P2({FD.array__perfect(U32, dw, t) == True{} : Bool},
    DK.P2({Nat.is_lt(dw, k) == True{} : Bool},
          {U32.to_nat(N) == 0n : Nat}))))))

def sdk1(w: O.Words, +k: Nat) -> Data:
  DK.Ex(FD.array__Tree<U32>, t => DK.Ex(Nat, dw => DK.Ex(U32, N => DK.Ex(Nat, q => DK.Ex(Nat, r =>
    DK.P2({w == O.Words{FD.array__thaw(U32, t), N} : O.Words},
    DK.P2({FD.array__perfect(U32, dw, t) == True{} : Bool},
    DK.P2({Nat.is_lt(dw, k) == True{} : Bool},
    DK.P2({U32.to_nat(N) == Nat.add(WS.e32(q), r) : Nat},
    DK.P2({Nat.is_lt(0n, r) == True{} : Bool},
    DK.P2({Nat.is_le(r, 32n) == True{} : Bool},
    DK.P2({Nat.is_le(O.e8(1n+q), FD.spec_common__pow2(dw)) == True{} : Bool},
          {WS.bdrop(r, WS.cb(FD.array__slots(U32, t), Nat.add(q, 0n))) == SP.zero_bytes(Nat.sub(32n, r)) : +List<U32>}))))))))))))

def sdk(w: O.Words, +k: Nat) -> Data: DK.Or2(sdk0(w, k), sdk1(w, k))

# a vector of Bytes32 (pv_obj.wfv at depth below k)
def sdpv(w: O.Words, +k: Nat) -> Data:
  DK.Ex(FD.array__Tree<U32>, t => DK.Ex(Nat, dw => DK.Ex(U32, N => DK.Ex(Nat, q =>
    DK.P2({w == O.Words{FD.array__thaw(U32, t), N} : O.Words},
    DK.P2({FD.array__perfect(U32, dw, t) == True{} : Bool},
    DK.P2({Nat.is_lt(dw, k) == True{} : Bool},
    DK.P2({U32.to_nat(N) == Nat.add(WS.e32(q), 32n) : Nat},
          {Nat.is_le(O.e8(1n+q), FD.spec_common__pow2(dw)) == True{} : Bool}))))))))
