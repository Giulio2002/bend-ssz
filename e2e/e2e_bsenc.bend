    Equal.sym(Nat, List.length(&2, U32, EX_bits6.ENC(EX_bits6.MB{dw, T, K, 6n, 4n, 6n})), U32.to_nat(CO.NK(K)), EX_bits6.eL(dw, T, K, 6n, 4n, 6n, hok)), hnk)
  (EX_bits6.MB{dw, T, K, 6n, 4n, 6n}, (eo, (bv6(dw, T, K), (hok, hl))))

def bb6(-w: O.Bits, +rp: BO.rep_bits(w, S.BitList{6n}), +hs: SDB(w, 31n)) -> BR6(w):
  (+wf, +rq) = rp
  (+hlim, +hch) = rq
  (+T, +s1) = hs
  (+dw, +s2) = s1
  (+K, +s3) = s2
  (+eo, +s4) = s3
  (+pf, +s5) = s4
  (+hdw, +s6) = s5
  (+hroom, +hbz) = s6
  +hN = FD.logic__subst(O.Bits, z => {Nat.is_le(U32.to_nat(BO.blen(z)), 6n) == True{} : Bool}, w, O.Bits{FD.array__thaw(U32, T), K}, eo, hlim)
  bb6b(w, T, dw, K, eo, pf, hdw, hroom, hbz, hN, FD.logic__subst(O.Bits, z => BO.wfb(z), w, O.Bits{FD.array__thaw(U32, T), K}, eo, wf))
