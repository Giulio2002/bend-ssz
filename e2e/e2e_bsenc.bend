# a word whose bits above 1 are zero is below 2
def lt1w(+X: Word(1n)) -> {U32.is_lt(U32{WSp.join(1n, 31n, X, Word.zero(31n))}, 2) == True{} : Bool}:
  match X:
    case WCon{+a0, WNil{}}: {==}

