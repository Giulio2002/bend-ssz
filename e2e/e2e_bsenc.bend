  lt1w(WSp.take(1n, 32n, PD.bits(w)))

# a word whose bits above 2 are zero is below 4
def lt2w(+X: Word(2n)) -> {U32.is_lt(U32{WSp.join(2n, 30n, X, Word.zero(30n))}, 4) == True{} : Bool}:
