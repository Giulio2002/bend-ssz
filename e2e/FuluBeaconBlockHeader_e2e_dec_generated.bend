  (da => FuluBeaconBlockHeader_d_ia(bs, n, o, hn, hd, Nat.is_eq(List.length(&2, U32, bs), 112n), {==}, da), aa => FuluBeaconBlockHeader_d_ib(bs, n, o, hn, Nat.is_eq(List.length(&2, U32, bs), 112n), {==}, aa))

# (iii) the object decoder fails exactly when END_TO_END's deserialize does.
