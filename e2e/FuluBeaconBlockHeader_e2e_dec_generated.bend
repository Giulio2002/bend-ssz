  (dn => FuluBeaconBlockHeader_d_ra(bs, n, hn, hd, Nat.is_eq(List.length(&2, U32, bs), 112n), {==}, dn), an => FuluBeaconBlockHeader_d_rb(bs, n, hn, hd, Nat.is_eq(List.length(&2, U32, bs), 112n), {==}, an))

