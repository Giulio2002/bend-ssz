  (dn => uint64_d_ra(bs, n, hn, hd, Nat.is_eq(List.length(&2, U32, bs), 8n), {==}, dn), an => uint64_d_rb(bs, n, hn, hd, Nat.is_eq(List.length(&2, U32, bs), 8n), {==}, an))

