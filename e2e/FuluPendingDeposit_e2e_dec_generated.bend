# (ii) the object decoder returns o exactly when END_TO_END's deserialize returns VAL(o).
def FuluPendingDeposit_e2e_decode_accept(+bs: +List<U32>, +n: U32, +o: T.PendingDeposit, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +hd: {SP.bytes_domain(bs) == True{} : Bool})
    -> ({Pair.snd(B.Buf, Maybe<&1, T.PendingDeposit>, T.PendingDeposit_decode(B.fill_at(B.alloc(n), 0, bs), n)) == Some{o} : Maybe<&1, T.PendingDeposit>} -> {API.deserialize(Spec.PendingDeposit(), bs) == Some{M3.v_PendingDeposit(o)} : Maybe<&2, S.Value>}) & ({API.deserialize(Spec.PendingDeposit(), bs) == Some{M3.v_PendingDeposit(o)} : Maybe<&2, S.Value>} -> {Pair.snd(B.Buf, Maybe<&1, T.PendingDeposit>, T.PendingDeposit_decode(B.fill_at(B.alloc(n), 0, bs), n)) == Some{o} : Maybe<&1, T.PendingDeposit>}):
  (da => FuluPendingDeposit_d_ia(bs, n, o, hn, hd, Nat.is_eq(List.length(&2, U32, bs), 192n), {==}, da), aa => FuluPendingDeposit_d_ib(bs, n, o, hn, Nat.is_eq(List.length(&2, U32, bs), 192n), {==}, aa))

# (iii) the object decoder fails exactly when END_TO_END's deserialize does.
def FuluPendingDeposit_e2e_decode_reject(+bs: +List<U32>, +n: U32, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +hd: {SP.bytes_domain(bs) == True{} : Bool})
    -> ({Pair.snd(B.Buf, Maybe<&1, T.PendingDeposit>, T.PendingDeposit_decode(B.fill_at(B.alloc(n), 0, bs), n)) == None{} : Maybe<&1, T.PendingDeposit>} -> {API.deserialize(Spec.PendingDeposit(), bs) == None{} : Maybe<&2, S.Value>}) & ({API.deserialize(Spec.PendingDeposit(), bs) == None{} : Maybe<&2, S.Value>} -> {Pair.snd(B.Buf, Maybe<&1, T.PendingDeposit>, T.PendingDeposit_decode(B.fill_at(B.alloc(n), 0, bs), n)) == None{} : Maybe<&1, T.PendingDeposit>}):
  (dn => FuluPendingDeposit_d_ra(bs, n, hn, hd, Nat.is_eq(List.length(&2, U32, bs), 192n), {==}, dn), an => FuluPendingDeposit_d_rb(bs, n, hn, hd, Nat.is_eq(List.length(&2, U32, bs), 192n), {==}, an))

