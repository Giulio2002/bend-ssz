# vua_ct's copy is masked storage (either copy: aligned or shifted)
def kct(+r: Nat, +d: Nat, +t: FD.array__Tree<U32>, +off: U32, +L: U32, +dz: Nat, +hy: {Nat.is_le(VC.YL(L), U32.to_nat(VB.UMAX())) == True{} : Bool}, +hr: {Nat.is_le(VC.NW(L), VB.pw(dz)) == True{} : Bool})
    -> {VB.slot(UCT.cts(r, d, t, off, L, dz), VBY.KW(L)) == O.keep(VBY.RM(L), VB.slot(UCT.cts(r, d, t, off, L, dz), VBY.KW(L))) : U32}:
  match r:
    case 0n: kmkG(L, dz, VB.mone(VC.NW(L), VR.QX(off), 0n, dz, VC.ZT(dz), t), VB.mone_perfect(VC.NW(L), VR.QX(off), 0n, dz, VC.ZT(dz), t, FD.array__trep_perfect(U32, dz, 0)), hy, hr)
    case 1n+ +q: kmkG(L, dz, UC.smone(1n+q, VC.NW(L), VR.QX(off), 0n, dz, d, VC.ZT(dz), t), UC.smone_perfect(1n+q, VC.NW(L), VR.QX(off), 0n, dz, d, VC.ZT(dz), t, FD.array__trep_perfect(U32, dz, 0)), hy, hr)

# the storage's words read as the runtime reads them (RD.wd) are its slots
def wd_slot(+d: Nat, +t: FD.array__Tree<U32>, +q: U32, +i: Nat, +eq: {U32.to_nat(q) == i : Nat}, +hd: {Nat.is_lt(d, 31n) == True{} : Bool},
    +hi: {Nat.is_lt(i, VB.pw(d)) == True{} : Bool}, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}) -> {RD.wd(t, d, q) == VB.slot(t, i) : U32}:
  +e = Equal.trans(Array<U32> & U32, (FD.array__thaw(U32, t), RD.wd(t, d, q)), Array.get(U32, FD.array__thaw(U32, t), q), (FD.array__thaw(U32, t), VB.slot(t, i)),
    Equal.sym(Array<U32> & U32, Array.get(U32, FD.array__thaw(U32, t), q), (FD.array__thaw(U32, t), RD.wd(t, d, q)), VE.get_any(d, t, q, VB.lt32(d, hd), pf)),
    VB.get_n(d, t, q, i, eq, VB.lt32(d, hd), hi, pf))
  Equal.cong(Array<U32> & U32, U32, p => Pair.snd(Array<U32>, U32, p), (FD.array__thaw(U32, t), RD.wd(t, d, q)), (FD.array__thaw(U32, t), VB.slot(t, i)), e)

# a window ending by NMAX ends below 2^32
def hwN32(+x: Nat, +len: U32, +hwN: {Nat.is_le(Nat.add(x, U32.to_nat(len)), U32.to_nat(VB.NMAX())) == True{} : Bool}) -> {Nat.is_lt(Nat.add(x, U32.to_nat(len)), FD.spec_common__pow2(32n)) == True{} : Bool}:
  VB.umax_lt(Nat.add(x, U32.to_nat(len)), FD.nat__le_trans(Nat.add(x, U32.to_nat(len)), U32.to_nat(VB.NMAX()), U32.to_nat(VB.UMAX()), hwN,
    FD.logic__subst(Bool, z => {z == True{} : Bool}, U32.is_le(VB.NMAX(), VB.UMAX()), Nat.is_le(U32.to_nat(VB.NMAX()), U32.to_nat(VB.UMAX())), VB.le_u32n(VB.NMAX(), VB.UMAX()), {==})))

# the hv part of the storage premise of a bit list of any depth
def SDXE(o: O.Bits) -> Data: DK.Ex(Nat, dz => SDXO(o, dz))

# the storage premise with the runtime's word read (e2e_bsenc.SDB / e2e_pbs.SDB / e2e_bbatt.SDB have this body)
def SDBW(o: O.Bits, +Kd: Nat) -> Data:
  DK.Ex(FD.array__Tree<U32>, T => DK.Ex(Nat, dw => DK.Ex(U32, K => DK.P2({o == O.Bits{FD.array__thaw(U32, T), K} : O.Bits},
    DK.P2({FD.array__perfect(U32, dw, T) == True{} : Bool},
    DK.P2({Nat.is_lt(dw, Kd) == True{} : Bool},
    DK.P2({Nat.is_le(Nat.add(U32.to_nat(U32.shrn(K, 5n)), 1n), VB.pw(dw)) == True{} : Bool},
    {O.bits_above_zero(U32.and(K, 31), RD.wd(T, dw, U32.shrn(K, 5n))) == True{} : Bool})))))))

# the hv part of the storage premise, for the bit list o (whatever the size bounds of the premise it goes into)
def SDXO(o: O.Bits, +dz: Nat) -> Data:
  DK.Ex(FD.array__Tree<U32>, T => DK.Ex(U32, K => DK.P2({o == O.Bits{FD.array__thaw(U32, T), K} : O.Bits},
    DK.P2({FD.array__perfect(U32, dz, T) == True{} : Bool},
    DK.P2({Nat.is_le(Nat.add(U32.to_nat(U32.shrn(K, 5n)), 1n), VB.pw(dz)) == True{} : Bool},
          {O.bits_above_zero(U32.and(K, 31), VB.slot(T, U32.to_nat(U32.shrn(K, 5n)))) == True{} : Bool})))))

def sdxo(-o: O.Bits, -A_: Array<U32>, +K: U32, +dz: Nat, +eo: {o == O.Bits{A_, K} : O.Bits}, +x: HV.SDX(A_, K, dz)) -> SDXO(o, dz):
  (+T, x1) = x
  (+eA, x2) = x1
  (T, (K, (Equal.trans(O.Bits, o, O.Bits{A_, K}, O.Bits{FD.array__thaw(U32, T), K}, eo, Equal.cong(Array<U32>, O.Bits, z => O.Bits{z, K}, A_, FD.array__thaw(U32, T), eA)), x2)))

def sdbw(-A_: Array<U32>, +K: U32, +dz: Nat, +Kd: Nat, +hd: {Nat.is_lt(dz, Kd) == True{} : Bool}, +hd31: {Nat.is_lt(dz, 31n) == True{} : Bool}, +x: HV.SDX(A_, K, dz)) -> SDBW(O.Bits{A_, K}, Kd):
  (+T, x1) = x
  (+eA, x2) = x1
  (+pT, x3) = x2
  (+hr, +hv) = x3
  +hi = FD.nat__succ_le_lt(U32.to_nat(U32.shrn(K, 5n)), VB.pw(dz), FD.logic__subst(Nat, z => {Nat.is_le(z, VB.pw(dz)) == True{} : Bool}, Nat.add(U32.to_nat(U32.shrn(K, 5n)), 1n), 1n+U32.to_nat(U32.shrn(K, 5n)), FD.nat__add_comm(U32.to_nat(U32.shrn(K, 5n)), 1n), hr))
