# A copy that already masked its last word (vbytes' MK, vua_ct's CT) keeps it masked (kmkG, kct); the runtime's word
# read RD.wd is the tree slot (wd_slot), so the storage premise SDB follows from SDX (sdbw).

# masking the last word twice is masking it once
def kk1(+y: U32) -> {O.keep(1, O.keep(1, y)) == O.keep(1, y) : U32}: VYS.and_assoc(y, 255, 255)
def kk2(+y: U32) -> {O.keep(2, O.keep(2, y)) == O.keep(2, y) : U32}: VYS.and_assoc(y, 65535, 65535)
def kk3(+y: U32) -> {O.keep(3, O.keep(3, y)) == O.keep(3, y) : U32}: VYS.and_assoc(y, 16777215, 16777215)

