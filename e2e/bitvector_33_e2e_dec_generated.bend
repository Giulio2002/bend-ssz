# (ii) through the view: the view of the decoder's result is END_TO_END's deserialize.
def bitvector_33_e2e_decode_view(+bs: +List<U32>, +n: U32, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +hd: {SP.bytes_domain(bs) == True{} : Bool}) -> {bitvector_33_mv(Pair.snd(B.Buf, Maybe<&1, bitvector_33_d.Bitvector33>, bitvector_33_r.bitvector_33_decode(B.fill_at(B.alloc(n), 0, bs), n))) == API.deserialize(Spec.bitvector_33(), bs) : Maybe<&2, S.Value>}:
  bitvector_33_d_v(bs, n, hn, hd, Nat.is_eq(List.length(&2, U32, bs), 5n), {==})

def bitvector_33_d_bn(m: Maybe<&1, bitvector_33_d.Bitvector33>, +e: {Maybe.is_some(&2, S.Value, bitvector_33_mv(m)) == False{} : Bool}) -> {m == None{} : Maybe<&1, bitvector_33_d.Bitvector33>}:
  match m:
    case None{}: {==}
    case Some{x}: Empty.absurd({Some{x} == None{} : Maybe<&1, bitvector_33_d.Bitvector33>}, FD.logic__false_true(Equal.sym(Bool, True{}, False{}, e)))

# (iii) the object decoder fails exactly when END_TO_END's deserialize does.
def bitvector_33_e2e_decode_reject(+bs: +List<U32>, +n: U32, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +hd: {SP.bytes_domain(bs) == True{} : Bool})
