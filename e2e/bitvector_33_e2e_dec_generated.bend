  (dn => Equal.trans(Maybe<&2, S.Value>, API.deserialize(Spec.bitvector_33(), bs), bitvector_33_mv(Pair.snd(B.Buf, Maybe<&1, bitvector_33_d.Bitvector33>, bitvector_33_r.bitvector_33_decode(B.fill_at(B.alloc(n), 0, bs), n))), None{}, Equal.sym(Maybe<&2, S.Value>, bitvector_33_mv(Pair.snd(B.Buf, Maybe<&1, bitvector_33_d.Bitvector33>, bitvector_33_r.bitvector_33_decode(B.fill_at(B.alloc(n), 0, bs), n))), API.deserialize(Spec.bitvector_33(), bs), bitvector_33_e2e_decode_view(bs, n, hn, hd)),
     Equal.cong(Maybe<&1, bitvector_33_d.Bitvector33>, Maybe<&2, S.Value>, q => bitvector_33_mv(q), Pair.snd(B.Buf, Maybe<&1, bitvector_33_d.Bitvector33>, bitvector_33_r.bitvector_33_decode(B.fill_at(B.alloc(n), 0, bs), n)), None{}, dn)),
   an => bitvector_33_d_bn(Pair.snd(B.Buf, Maybe<&1, bitvector_33_d.Bitvector33>, bitvector_33_r.bitvector_33_decode(B.fill_at(B.alloc(n), 0, bs), n)), Equal.cong(Maybe<&2, S.Value>, Bool, z => Maybe.is_some(&2, S.Value, z), bitvector_33_mv(Pair.snd(B.Buf, Maybe<&1, bitvector_33_d.Bitvector33>, bitvector_33_r.bitvector_33_decode(B.fill_at(B.alloc(n), 0, bs), n))), None{}, Equal.trans(Maybe<&2, S.Value>, bitvector_33_mv(Pair.snd(B.Buf, Maybe<&1, bitvector_33_d.Bitvector33>, bitvector_33_r.bitvector_33_decode(B.fill_at(B.alloc(n), 0, bs), n))), API.deserialize(Spec.bitvector_33(), bs), None{}, bitvector_33_e2e_decode_view(bs, n, hn, hd), an))))

