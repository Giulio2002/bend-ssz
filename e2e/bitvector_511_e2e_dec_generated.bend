  bitvector_511_d_v(bs, n, hn, hd, Nat.is_eq(List.length(&2, U32, bs), 64n), {==})

def bitvector_511_d_bn(m: Maybe<&1, bitvector_511_d.Bitvector511>, +e: {Maybe.is_some(&2, S.Value, bitvector_511_mv(m)) == False{} : Bool}) -> {m == None{} : Maybe<&1, bitvector_511_d.Bitvector511>}:
