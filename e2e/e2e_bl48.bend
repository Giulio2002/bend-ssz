  +ok = PB({E48.eview(EX.TH(EX.MW{dw, T, N})) == EX.VAL(EX.MW{dw, T, N}) : S.Value}, {EX.OK(EX.MW{dw, T, N}) == True{} : Bool}, r)
  +eL = Equal.trans(Nat, LY.LN(EX.ENC(EX.MW{dw, T, N})), U32.to_nat(N), U32.to_nat(WO.len(po)), lenK(T, dw, N, ok),
    Equal.sym(Nat, U32.to_nat(WO.len(po)), U32.to_nat(N), Equal.cong(O.Words, Nat, z => U32.to_nat(WO.len(z)), po, O.Words{FD.array__thaw(U32, T), N}, eo)))
  (EX.MW{dw, T, N}, (eo, (ev, (ok, eL))))

def mk_K(-po: O.Words, +s: S.Schema, +el: {SH.ListOf_limit(s) == U32.to_nat(4096) : Nat}, +rep: E48.rep_el(po, s), +hs: sdk48(po),
    +hv: {O.unit_ok(48, WO.len(po)) == True{} : Bool}) -> R_K(po):
  (+wf, +hl) = rep
  (+t1, a1) = wf
  (+dw1, a2) = a1
  (+N1, a3) = a2
  (+eo1, a4) = a3
  (+pf1, a5) = a4
  (+hd1, +hk1) = a5
  (+T, b1) = hs
  (+dw, b2) = b1
  (+N, b3) = b2
  (+eo, b4) = b3
  (+pf, +hd) = b4
  fK(po, s, el, hl, t1, dw1, N1, eo1, pf1, hk1, T, dw, N, eo, pf, hd, hv)
