# ---- bits_above_zero gives zw, per bit ----

def bzf0(+u: U32, +h: {O.bits_above_zero(0, u) == True{} : Bool}) -> {HV.ZF(0n, BLf.wbits(u)) == True{} : Bool}:
  match u:
    case U32{+w}:
      +e0 = FD.u32alg__eq_of(U32{Word.and(32n, w, HV.ZO(32n, 0n))}, 0, h)
      zaz(32n, 0n, w, Equal.cong(U32, Word(32n), z => HV.WD(z), U32{Word.and(32n, w, HV.ZO(32n, 0n))}, 0, e0))
def bzw0(+u: U32, +h: {O.bits_above_zero(0, u) == True{} : Bool}) -> {BK.zw(0n, u) == True{} : Bool}: zfw0(u, bzf0(u, h))

