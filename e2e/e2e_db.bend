# bits_above_zero(r, u), r below 32: BK.zw(c, u)
def bzw(+c: Nat, +r: U32, +u: U32, +er: {U32.to_nat(r) == c : Nat}, +hc: {Nat.is_lt(c, 32n) == True{} : Bool},
    +h: {O.bits_above_zero(r, u) == True{} : Bool}) -> {BK.zw(c, u) == True{} : Bool}:
  match c:
    case 0n: bzw0(u, FD.logic__subst(U32, z => {O.bits_above_zero(z, u) == True{} : Bool}, r, 0, FD.u32__injective(r, 0, er), h))
    case 1n: bzw1(u, FD.logic__subst(U32, z => {O.bits_above_zero(z, u) == True{} : Bool}, r, 1, FD.u32__injective(r, 1, er), h))
    case 2n: bzw2(u, FD.logic__subst(U32, z => {O.bits_above_zero(z, u) == True{} : Bool}, r, 2, FD.u32__injective(r, 2, er), h))
    case 3n: bzw3(u, FD.logic__subst(U32, z => {O.bits_above_zero(z, u) == True{} : Bool}, r, 3, FD.u32__injective(r, 3, er), h))
    case 4n: bzw4(u, FD.logic__subst(U32, z => {O.bits_above_zero(z, u) == True{} : Bool}, r, 4, FD.u32__injective(r, 4, er), h))
    case 5n: bzw5(u, FD.logic__subst(U32, z => {O.bits_above_zero(z, u) == True{} : Bool}, r, 5, FD.u32__injective(r, 5, er), h))
    case 6n: bzw6(u, FD.logic__subst(U32, z => {O.bits_above_zero(z, u) == True{} : Bool}, r, 6, FD.u32__injective(r, 6, er), h))
    case 7n: bzw7(u, FD.logic__subst(U32, z => {O.bits_above_zero(z, u) == True{} : Bool}, r, 7, FD.u32__injective(r, 7, er), h))
    case 8n: bzw8(u, FD.logic__subst(U32, z => {O.bits_above_zero(z, u) == True{} : Bool}, r, 8, FD.u32__injective(r, 8, er), h))
    case 9n: bzw9(u, FD.logic__subst(U32, z => {O.bits_above_zero(z, u) == True{} : Bool}, r, 9, FD.u32__injective(r, 9, er), h))
    case 10n: bzw10(u, FD.logic__subst(U32, z => {O.bits_above_zero(z, u) == True{} : Bool}, r, 10, FD.u32__injective(r, 10, er), h))
    case 11n: bzw11(u, FD.logic__subst(U32, z => {O.bits_above_zero(z, u) == True{} : Bool}, r, 11, FD.u32__injective(r, 11, er), h))
    case 12n: bzw12(u, FD.logic__subst(U32, z => {O.bits_above_zero(z, u) == True{} : Bool}, r, 12, FD.u32__injective(r, 12, er), h))
    case 13n: bzw13(u, FD.logic__subst(U32, z => {O.bits_above_zero(z, u) == True{} : Bool}, r, 13, FD.u32__injective(r, 13, er), h))
    case 14n: bzw14(u, FD.logic__subst(U32, z => {O.bits_above_zero(z, u) == True{} : Bool}, r, 14, FD.u32__injective(r, 14, er), h))
    case 15n: bzw15(u, FD.logic__subst(U32, z => {O.bits_above_zero(z, u) == True{} : Bool}, r, 15, FD.u32__injective(r, 15, er), h))
    case 16n: bzw16(u, FD.logic__subst(U32, z => {O.bits_above_zero(z, u) == True{} : Bool}, r, 16, FD.u32__injective(r, 16, er), h))
    case 17n: bzw17(u, FD.logic__subst(U32, z => {O.bits_above_zero(z, u) == True{} : Bool}, r, 17, FD.u32__injective(r, 17, er), h))
    case 18n: bzw18(u, FD.logic__subst(U32, z => {O.bits_above_zero(z, u) == True{} : Bool}, r, 18, FD.u32__injective(r, 18, er), h))
    case 19n: bzw19(u, FD.logic__subst(U32, z => {O.bits_above_zero(z, u) == True{} : Bool}, r, 19, FD.u32__injective(r, 19, er), h))
    case 20n: bzw20(u, FD.logic__subst(U32, z => {O.bits_above_zero(z, u) == True{} : Bool}, r, 20, FD.u32__injective(r, 20, er), h))
    case 21n: bzw21(u, FD.logic__subst(U32, z => {O.bits_above_zero(z, u) == True{} : Bool}, r, 21, FD.u32__injective(r, 21, er), h))
    case 22n: bzw22(u, FD.logic__subst(U32, z => {O.bits_above_zero(z, u) == True{} : Bool}, r, 22, FD.u32__injective(r, 22, er), h))
    case 23n: bzw23(u, FD.logic__subst(U32, z => {O.bits_above_zero(z, u) == True{} : Bool}, r, 23, FD.u32__injective(r, 23, er), h))
    case 24n: bzw24(u, FD.logic__subst(U32, z => {O.bits_above_zero(z, u) == True{} : Bool}, r, 24, FD.u32__injective(r, 24, er), h))
    case 25n: bzw25(u, FD.logic__subst(U32, z => {O.bits_above_zero(z, u) == True{} : Bool}, r, 25, FD.u32__injective(r, 25, er), h))
    case 26n: bzw26(u, FD.logic__subst(U32, z => {O.bits_above_zero(z, u) == True{} : Bool}, r, 26, FD.u32__injective(r, 26, er), h))
    case 27n: bzw27(u, FD.logic__subst(U32, z => {O.bits_above_zero(z, u) == True{} : Bool}, r, 27, FD.u32__injective(r, 27, er), h))
    case 28n: bzw28(u, FD.logic__subst(U32, z => {O.bits_above_zero(z, u) == True{} : Bool}, r, 28, FD.u32__injective(r, 28, er), h))
    case 29n: bzw29(u, FD.logic__subst(U32, z => {O.bits_above_zero(z, u) == True{} : Bool}, r, 29, FD.u32__injective(r, 29, er), h))
    case 30n: bzw30(u, FD.logic__subst(U32, z => {O.bits_above_zero(z, u) == True{} : Bool}, r, 30, FD.u32__injective(r, 30, er), h))
    case 31n: bzw31(u, FD.logic__subst(U32, z => {O.bits_above_zero(z, u) == True{} : Bool}, r, 31, FD.u32__injective(r, 31, er), h))
    case 32n+ +p: Empty.absurd({BK.zw(32n+p, u) == True{} : Bool}, FD.nat__lt_zero_absurd(p, hc))

