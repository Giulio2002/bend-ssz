    case 11n: bzf11(u, FD.logic__subst(U32, z => {O.bits_above_zero(z, u) == True{} : Bool}, r, 11, FD.u32__injective(r, 11, er), h))
    case 12n: bzf12(u, FD.logic__subst(U32, z => {O.bits_above_zero(z, u) == True{} : Bool}, r, 12, FD.u32__injective(r, 12, er), h))
    case 13n: bzf13(u, FD.logic__subst(U32, z => {O.bits_above_zero(z, u) == True{} : Bool}, r, 13, FD.u32__injective(r, 13, er), h))
    case 14n: bzf14(u, FD.logic__subst(U32, z => {O.bits_above_zero(z, u) == True{} : Bool}, r, 14, FD.u32__injective(r, 14, er), h))
    case 15n: bzf15(u, FD.logic__subst(U32, z => {O.bits_above_zero(z, u) == True{} : Bool}, r, 15, FD.u32__injective(r, 15, er), h))
    case 16n: bzf16(u, FD.logic__subst(U32, z => {O.bits_above_zero(z, u) == True{} : Bool}, r, 16, FD.u32__injective(r, 16, er), h))
    case 17n: bzf17(u, FD.logic__subst(U32, z => {O.bits_above_zero(z, u) == True{} : Bool}, r, 17, FD.u32__injective(r, 17, er), h))
    case 18n: bzf18(u, FD.logic__subst(U32, z => {O.bits_above_zero(z, u) == True{} : Bool}, r, 18, FD.u32__injective(r, 18, er), h))
    case 19n: bzf19(u, FD.logic__subst(U32, z => {O.bits_above_zero(z, u) == True{} : Bool}, r, 19, FD.u32__injective(r, 19, er), h))
    case 20n: bzf20(u, FD.logic__subst(U32, z => {O.bits_above_zero(z, u) == True{} : Bool}, r, 20, FD.u32__injective(r, 20, er), h))
