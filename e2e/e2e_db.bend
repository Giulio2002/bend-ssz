    case 31n: bzf31(u, FD.logic__subst(U32, z => {O.bits_above_zero(z, u) == True{} : Bool}, r, 31, FD.u32__injective(r, 31, er), h))
    case 32n+ +p: Empty.absurd({HV.ZF(32n+p, BLf.wbits(u)) == True{} : Bool}, FD.nat__lt_zero_absurd(p, hc))

# the low five bits are below 32
def lt32(+x: U32) -> {Nat.is_lt(U32.to_nat(U32.and(x, 31)), 32n) == True{} : Bool}:
  match x:
    case U32{WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, +r}}}}}}:
      %Equal.sym(Word(27n), Word.and(27n, r, Word.zero(27n)), Word.zero(27n), BF.and_zero(27n, r)) : {Nat.is_lt(U32.to_nat(U32{WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, _}}}}}}), 32n) == True{} : Bool}
      {==}
    case U32{WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, +r}}}}}}:
      %Equal.sym(Word(27n), Word.and(27n, r, Word.zero(27n)), Word.zero(27n), BF.and_zero(27n, r)) : {Nat.is_lt(U32.to_nat(U32{WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, _}}}}}}), 32n) == True{} : Bool}
      {==}
    case U32{WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, +r}}}}}}:
      %Equal.sym(Word(27n), Word.and(27n, r, Word.zero(27n)), Word.zero(27n), BF.and_zero(27n, r)) : {Nat.is_lt(U32.to_nat(U32{WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, _}}}}}}), 32n) == True{} : Bool}
      {==}
    case U32{WCon{True{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, +r}}}}}}:
      %Equal.sym(Word(27n), Word.and(27n, r, Word.zero(27n)), Word.zero(27n), BF.and_zero(27n, r)) : {Nat.is_lt(U32.to_nat(U32{WCon{True{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, _}}}}}}), 32n) == True{} : Bool}
      {==}
    case U32{WCon{False{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, +r}}}}}}:
      %Equal.sym(Word(27n), Word.and(27n, r, Word.zero(27n)), Word.zero(27n), BF.and_zero(27n, r)) : {Nat.is_lt(U32.to_nat(U32{WCon{False{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, _}}}}}}), 32n) == True{} : Bool}
      {==}
    case U32{WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, +r}}}}}}:
      %Equal.sym(Word(27n), Word.and(27n, r, Word.zero(27n)), Word.zero(27n), BF.and_zero(27n, r)) : {Nat.is_lt(U32.to_nat(U32{WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, _}}}}}}), 32n) == True{} : Bool}
      {==}
    case U32{WCon{False{}, WCon{True{}, WCon{True{}, WCon{False{}, WCon{False{}, +r}}}}}}:
      %Equal.sym(Word(27n), Word.and(27n, r, Word.zero(27n)), Word.zero(27n), BF.and_zero(27n, r)) : {Nat.is_lt(U32.to_nat(U32{WCon{False{}, WCon{True{}, WCon{True{}, WCon{False{}, WCon{False{}, _}}}}}}), 32n) == True{} : Bool}
      {==}
    case U32{WCon{True{}, WCon{True{}, WCon{True{}, WCon{False{}, WCon{False{}, +r}}}}}}:
      %Equal.sym(Word(27n), Word.and(27n, r, Word.zero(27n)), Word.zero(27n), BF.and_zero(27n, r)) : {Nat.is_lt(U32.to_nat(U32{WCon{True{}, WCon{True{}, WCon{True{}, WCon{False{}, WCon{False{}, _}}}}}}), 32n) == True{} : Bool}
      {==}
    case U32{WCon{False{}, WCon{False{}, WCon{False{}, WCon{True{}, WCon{False{}, +r}}}}}}:
