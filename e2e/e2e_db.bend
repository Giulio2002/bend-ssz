# zt at bit K from no bit set at or above K in word K >> 5
def ztb(+S: List<&2, U32>, +K: U32, +h: {O.bits_above_zero(U32.and(K, 31), FD.flat__nthc(S, U32.to_nat(U32.shrn(K, 5n)))) == True{} : Bool})
    -> {BK.zt(S, U32.to_nat(K)) == True{} : Bool}:
  +Q = U32.to_nat(U32.shrn(K, 5n))
  +c = U32.to_nat(U32.and(K, 31))
  +hc = lt32(K)
  +hz = bzw(c, U32.and(K, 31), FD.flat__nthc(S, Q), {==}, hc, h)
  +z1 = VBT.zt_at(S, Q, c, FD.nat__lt_le(c, 32n, hc), hz)
  +eK = Equal.trans(Nat, Nat.add(VBT.m32(Q), c), Nat.add(Nat.mul(Q, 32n), c), U32.to_nat(K), Equal.cong(Nat, Nat, z => Nat.add(z, c), VBT.m32(Q), Nat.mul(Q, 32n), m32_mul(Q)),
    Equal.sym(Nat, U32.to_nat(K), Nat.add(Nat.mul(Q, 32n), c), HV.split32(K)))
  FD.logic__subst(Nat, z => {BK.zt(S, z) == True{} : Bool}, Nat.add(VBT.m32(Q), c), U32.to_nat(K), eK, z1)

# ---- the bit view's length: K bits of a word list with room for word K >> 5 ----
law lbo:
  for +S: List<&2, U32>
  {List.length(&2, Bool, BK.bitsof(S)) == VBT.m32(FD.spec_common__length(U32, S)) : Nat}
def lbo(S):
  match S:
    case Nil{}: {==}
    case Con{+x, +r}:
      %Equal.sym(Nat, List.length(&2, Bool, List.append(&2, Bool, BLf.wbits(x), BK.bitsof(r))), Nat.add(32n, List.length(&2, Bool, BK.bitsof(r))), BLf.len_app_w(x, BK.bitsof(r))) :
        {_ == VBT.m32(FD.spec_common__length(U32, Con{x, r})) : Nat}
      Equal.cong(Nat, Nat, z => 32n+z, List.length(&2, Bool, BK.bitsof(r)), VBT.m32(FD.spec_common__length(U32, r)), lbo(r))

law btkl:
  for +n: Nat
  for +xs: +List<Bool>
  for +h: {Nat.is_le(n, List.length(&2, Bool, xs)) == True{} : Bool}
  {List.length(&2, Bool, BK.btk(n, xs)) == n : Nat}
def btkl(n, xs, h):
  match n:
    case 0n: {==}
    case 1n+ +p:
      match xs:
        case Nil{}: Empty.absurd({List.length(&2, Bool, BK.btk(1n+p, Nil{})) == 1n+p : Nat}, FD.logic__false_true(h))
        case Con{+b, +t}: Equal.cong(Nat, Nat, z => 1n+z, List.length(&2, Bool, BK.btk(p, t)), p, btkl(p, t, h))

law m32s:
  for +q: Nat
  {VBT.m32(Nat.add(q, 1n)) == Nat.add(VBT.m32(q), 32n) : Nat}
def m32s(q):
  match q:
    case 0n: {==}
    case 1n+ +p: Equal.cong(Nat, Nat, z => 32n+z, VBT.m32(Nat.add(p, 1n)), Nat.add(VBT.m32(p), 32n), m32s(p))

# all K bits are there
def bkl(+S: List<&2, U32>, +K: U32, +hQ: {Nat.is_le(Nat.add(U32.to_nat(U32.shrn(K, 5n)), 1n), FD.spec_common__length(U32, S)) == True{} : Bool})
    -> {List.length(&2, Bool, BK.btk(U32.to_nat(K), BK.bitsof(S))) == U32.to_nat(K) : Nat}:
  +Q = U32.to_nat(U32.shrn(K, 5n))
  +c = U32.to_nat(U32.and(K, 31))
  +eK = Equal.trans(Nat, U32.to_nat(K), Nat.add(Nat.mul(Q, 32n), c), Nat.add(VBT.m32(Q), c), HV.split32(K),
    Equal.cong(Nat, Nat, z => Nat.add(z, c), Nat.mul(Q, 32n), VBT.m32(Q), Equal.sym(Nat, VBT.m32(Q), Nat.mul(Q, 32n), m32_mul(Q))))
  +h1 = FD.nat__le_trans(Nat.add(VBT.m32(Q), c), Nat.add(VBT.m32(Q), 32n), VBT.m32(FD.spec_common__length(U32, S)), Order.add_left(VBT.m32(Q), c, 32n, FD.nat__lt_le(c, 32n, lt32(K))),
    FD.logic__subst(Nat, z => {Nat.is_le(z, VBT.m32(FD.spec_common__length(U32, S))) == True{} : Bool}, VBT.m32(Nat.add(Q, 1n)), Nat.add(VBT.m32(Q), 32n), m32s(Q), VBT.m32_mono(Nat.add(Q, 1n), FD.spec_common__length(U32, S), hQ)))
  +h2 = FD.logic__subst(Nat, z => {Nat.is_le(z, VBT.m32(FD.spec_common__length(U32, S))) == True{} : Bool}, Nat.add(VBT.m32(Q), c), U32.to_nat(K), Equal.sym(Nat, U32.to_nat(K), Nat.add(VBT.m32(Q), c), eK), h1)
  btkl(U32.to_nat(K), BK.bitsof(S), FD.logic__subst(Nat, z => {Nat.is_le(U32.to_nat(K), z) == True{} : Bool}, VBT.m32(FD.spec_common__length(U32, S)), List.length(&2, Bool, BK.bitsof(S)), Equal.sym(Nat, List.length(&2, Bool, BK.bitsof(S)), VBT.m32(FD.spec_common__length(U32, S)), lbo(S)), h2))

# ---- the byte count: the spec's byte_count is the runtime's bits_nbytes ----
def bc7(+b: Nat, +hb: {Nat.is_le(b, 7n) == True{} : Bool}) -> {Bp.byte_count(b) == Nat.add(0n, VD.s_rng(3n, Nat.add(b, 7n))) : Nat}:
  match b:
    case 0n: {==}
    case 1n: {==}
    case 2n: {==}
    case 3n: {==}
    case 4n: {==}
    case 5n: {==}
    case 6n: {==}
    case 7n: {==}
    case 8n+ +p: Empty.absurd({Bp.byte_count(8n+p) == Nat.add(0n, VD.s_rng(3n, Nat.add(8n+p, 7n))) : Nat}, FD.logic__false_true(hb))

law bcx:
  for +a: Nat
  for +b: Nat
  for +hb: {Nat.is_le(b, 7n) == True{} : Bool}
  {Bp.byte_count(Nat.add(VSP.x8(a), b)) == Nat.add(a, VD.s_rng(3n, Nat.add(b, 7n))) : Nat}
def bcx(a, b, hb):
  match a:
    case 0n: bc7(b, hb)
    case 1n+ +p: Equal.cong(Nat, Nat, z => 1n+z, Bp.byte_count(Nat.add(VSP.x8(p), b)), Nat.add(p, VD.s_rng(3n, Nat.add(b, 7n))), bcx(p, b, hb))

def bc(+K: U32, +kb: Nat, +hkb: {Nat.is_lt(kb, 33n) == True{} : Bool}, +hK: VBT.HK(K, kb)) -> {Bp.byte_count(U32.to_nat(K)) == U32.to_nat(O.bits_nbytes(K)) : Nat}:
  %Equal.sym(Nat, U32.to_nat(K), Nat.add(VSP.x8(VBT.AK(K)), VBT.BKk(K)), VBT.E1(K)) : {Bp.byte_count(_) == U32.to_nat(O.bits_nbytes(K)) : Nat}
  Equal.trans(Nat, Bp.byte_count(Nat.add(VSP.x8(VBT.AK(K)), VBT.BKk(K))), Nat.add(VBT.AK(K), VD.s_rng(3n, Nat.add(VBT.BKk(K), 7n))), U32.to_nat(O.bits_nbytes(K)),
    bcx(VBT.AK(K), VBT.BKk(K), RD.and_le(K, 7)), Equal.sym(Nat, U32.to_nat(O.bits_nbytes(K)), Nat.add(VBT.AK(K), VD.s_rng(3n, Nat.add(VBT.BKk(K), 7n))), VBT.E3(K, kb, hkb, hK)))

# ---- ZF is monotone; ZF(0) is a zero word ----
law zfa:
  for +j: Nat
  for +xs: +List<Bool>
  for +h: {HV.allF(xs) == True{} : Bool}
  {HV.ZF(j, xs) == True{} : Bool}
def zfa(j, xs, h):
  match j xs:
    case 0n _: h
    case 1n+ +i Nil{}: {==}
    case 1n+ +i Con{True{}, +t}: Empty.absurd({HV.ZF(1n+i, Con{True{}, t}) == True{} : Bool}, FD.logic__false_true(h))
    case 1n+ +i Con{False{}, +t}: zfa(i, t, h)

law zfm:
  for +k: Nat
  for +j: Nat
  for +xs: +List<Bool>
  for +h: {HV.ZF(k, xs) == True{} : Bool}
  for +hle: {Nat.is_le(k, j) == True{} : Bool}
  {HV.ZF(j, xs) == True{} : Bool}
def zfm(k, j, xs, h, hle):
  match k j xs:
    case 0n _ _: zfa(j, xs, h)
    case 1n+ +k1 0n _: Empty.absurd({HV.ZF(0n, xs) == True{} : Bool}, FD.logic__false_true(hle))
    case 1n+ +k1 1n+ +j1 Nil{}: {==}
    case 1n+ +k1 1n+ +j1 Con{+x, +t}: zfm(k1, j1, t, h, hle)

# E + a < E + b from a < b
law ltk:
  for +E: Nat
  for +a: Nat
  for +b: Nat
  for +h: {Nat.is_lt(a, b) == True{} : Bool}
  {Nat.is_lt(Nat.add(E, a), Nat.add(E, b)) == True{} : Bool}
def ltk(E, a, b, h):
  match E:
    case 0n: h
    case 1n+ +p: ltk(p, a, b, h)

def zgw0(+a0: Bool, +a1: Bool, +a2: Bool, +a3: Bool, +a4: Bool, +a5: Bool, +a6: Bool, +a7: Bool, +a8: Bool, +a9: Bool, +a10: Bool, +a11: Bool, +a12: Bool, +a13: Bool, +a14: Bool, +a15: Bool, +a16: Bool, +a17: Bool, +a18: Bool, +a19: Bool, +a20: Bool, +a21: Bool, +a22: Bool, +a23: Bool, +a24: Bool, +a25: Bool, +a26: Bool, +a27: Bool, +a28: Bool, +a29: Bool, +a30: Bool, +a31: Bool, +h: {HV.ZF(0n, a0 <> a1 <> a2 <> a3 <> a4 <> a5 <> a6 <> a7 <> a8 <> a9 <> a10 <> a11 <> a12 <> a13 <> a14 <> a15 <> a16 <> a17 <> a18 <> a19 <> a20 <> a21 <> a22 <> a23 <> a24 <> a25 <> a26 <> a27 <> a28 <> a29 <> a30 <> a31 <> []) == True{} : Bool})
