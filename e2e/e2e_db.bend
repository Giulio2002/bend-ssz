# ---- the decoded bit list's tree ----
# s_rng(3, 8 m + h) = m for h <= 7
def s3h(+h: Nat, +hh: {Nat.is_le(h, 7n) == True{} : Bool}) -> {VD.s_rng(3n, Nat.add(0n, h)) == 0n : Nat}:
  match h:
    case 0n: {==}
    case 1n: {==}
    case 2n: {==}
    case 3n: {==}
    case 4n: {==}
    case 5n: {==}
    case 6n: {==}
    case 7n: {==}
    case 8n+ +p: Empty.absurd({VD.s_rng(3n, Nat.add(0n, 8n+p)) == 0n : Nat}, FD.logic__false_true(hh))

law s3m:
  for +m: Nat
  for +h: Nat
  for +hh: {Nat.is_le(h, 7n) == True{} : Bool}
  {VD.s_rng(3n, Nat.add(VSP.x8(m), h)) == m : Nat}
def s3m(m, h, hh):
  match m:
    case 0n: s3h(h, hh)
    case 1n+ +p: Equal.cong(Nat, Nat, z => 1n+z, VD.s_rng(3n, Nat.add(VSP.x8(p), h)), p, s3m(p, h, hh))

# the delimiter's word: (8 m + h) >> 5 = m >> 2
def e5m(+NB: U32, +m: Nat, +h: Nat, +hh: {Nat.is_le(h, 7n) == True{} : Bool}, +eNB: {U32.to_nat(NB) == Nat.add(VSP.x8(m), h) : Nat})
    -> {U32.to_nat(U32.shrn(NB, 5n)) == VD.s_rng(2n, m) : Nat}:
  Equal.trans(Nat, U32.to_nat(U32.shrn(NB, 5n)), VD.s_rng(5n, U32.to_nat(NB)), VD.s_rng(2n, m), VD.shrk(5n, NB),
    Equal.trans(Nat, VD.s_rng(5n, U32.to_nat(NB)), VD.s_rng(2n, VD.s_rng(3n, Nat.add(VSP.x8(m), h))), VD.s_rng(2n, m),
      Equal.cong(Nat, Nat, z => VD.s_rng(5n, z), U32.to_nat(NB), Nat.add(VSP.x8(m), h), eNB),
      Equal.cong(Nat, Nat, z => VD.s_rng(2n, z), VD.s_rng(3n, Nat.add(VSP.x8(m), h)), m, s3m(m, h, hh))))

# how the decoder copied the list's bytes into its zero tree: aligned (VB.mone from word i of S) or shifted (UC.smone)
type CPD is Data:
  CPM{i: Nat, S: FD.array__Tree<U32>}
  CPS{s: Nat, i: Nat, ds: Nat, S: FD.array__Tree<U32>}

def CPT(+L: U32, +dz: Nat, +c: CPD) -> FD.array__Tree<U32>:
  match c:
    case CPM{+i, S}: VB.mone(VC.NW(L), i, 0n, dz, VC.ZT(dz), S)
    case CPS{+s, +i, +ds, S}: UC.smone(s, VC.NW(L), i, 0n, dz, ds, VC.ZT(dz), S)

def CPpf(+L: U32, +dz: Nat, +c: CPD) -> {FD.array__perfect(U32, dz, CPT(L, dz, c)) == True{} : Bool}:
  match c:
    case CPM{+i, S}: VB.mone_perfect(VC.NW(L), i, 0n, dz, VC.ZT(dz), S, FD.array__trep_perfect(U32, dz, 0))
    case CPS{+s, +i, +ds, S}: UC.smone_perfect(s, VC.NW(L), i, 0n, dz, ds, VC.ZT(dz), S, FD.array__trep_perfect(U32, dz, 0))

def CPout(+L: U32, +dz: Nat, +c: CPD, +x: Nat, +hn: {Nat.is_le(VC.NW(L), VB.pw(dz)) == True{} : Bool}, +hx: {Nat.is_le(VC.NW(L), x) == True{} : Bool}) -> {VB.slot(CPT(L, dz, c), x) == 0 : U32}:
  match c:
    case CPM{+i, S}: DZ.mone_out(VC.NW(L), i, dz, S, x, hn, hx)
    case CPS{+s, +i, +ds, S}: DZ.smone_out(s, VC.NW(L), i, dz, ds, S, x, hn, hx)

# the list's copy (L = 1 + m bytes from word i of S) masked (VY.MK) and its delimiter bit NB cleared, as a tree update
def UG(+L: U32, +dz: Nat, +c: CPD, +NB: U32) -> FD.array__Tree<U32>:
  FD.array__upd(U32, dz, VYB.MK(L, dz, CPT(L, dz, c)), U32.to_nat(U32.shrn(NB, 5n)),
    U32.and(FD.flat__nthc(FD.array__slots(U32, VYB.MK(L, dz, CPT(L, dz, c))), U32.to_nat(U32.shrn(NB, 5n))), U32.not(MF.shl_by(1, U32.and(NB, 31)))))

def eTU(+L: U32, +dz: Nat, +c: CPD, +NB: U32, +T: FD.array__Tree<U32>,
    +hy: {Nat.is_le(VC.YL(L), U32.to_nat(VB.UMAX())) == True{} : Bool}, +hwc: {Nat.is_le(U32.to_nat(VC.WZ(L)), O.pow2n(dz)) == True{} : Bool},
    +hdz: {Nat.is_lt(dz, 32n) == True{} : Bool}, +hq: {Nat.is_lt(U32.to_nat(U32.shrn(NB, 5n)), FD.spec_common__pow2(dz)) == True{} : Bool},
    +eA: {O.clear_bit(O.mask_last(L, FD.array__thaw(U32, CPT(L, dz, c))), NB) == FD.array__thaw(U32, T) : Array<U32>})
    -> {T == UG(L, dz, c, NB) : FD.array__Tree<U32>}:
  +M = CPT(L, dz, c)
  +pfM = CPpf(L, dz, c)
  +hn = FD.nat__le_trans(VC.NW(L), U32.to_nat(VC.WZ(L)), VB.pw(dz), VC.nw_le_wzu(L, hy),
    FD.logic__subst(Nat, z => {Nat.is_le(U32.to_nat(VC.WZ(L)), z) == True{} : Bool}, O.pow2n(dz), VB.pw(dz), Equal.sym(Nat, VB.pw(dz), O.pow2n(dz), VD.s_pow2_eq(dz)), hwc))
  +pfK = VYB.mk_perfect(L, dz, M, pfM)
  +e0 = VYB.mask_okU(L, dz, M, hy, hdz, hn, pfM)
  +eAU = Equal.trans(Array<U32>, O.clear_bit(O.mask_last(L, FD.array__thaw(U32, M)), NB), O.clear_bit(FD.array__thaw(U32, VYB.MK(L, dz, M)), NB), FD.array__thaw(U32, UG(L, dz, c, NB)),
    Equal.cong(Array<U32>, Array<U32>, z => O.clear_bit(z, NB), O.mask_last(L, FD.array__thaw(U32, M)), FD.array__thaw(U32, VYB.MK(L, dz, M)), e0),
    HV.cbt(dz, VYB.MK(L, dz, M), NB, pfK, hdz, hq))
  +eth = Equal.trans(Array<U32>, FD.array__thaw(U32, T), O.clear_bit(O.mask_last(L, FD.array__thaw(U32, M)), NB), FD.array__thaw(U32, UG(L, dz, c, NB)),
    Equal.sym(Array<U32>, O.clear_bit(O.mask_last(L, FD.array__thaw(U32, M)), NB), FD.array__thaw(U32, T), eA), eAU)
  Equal.trans(FD.array__Tree<U32>, T, FD.array__freeze(U32, FD.array__thaw(U32, T)), UG(L, dz, c, NB), Equal.sym(FD.array__Tree<U32>, FD.array__freeze(U32, FD.array__thaw(U32, T)), T, FD.array__freeze_thaw(U32, T)),
    Equal.trans(FD.array__Tree<U32>, FD.array__freeze(U32, FD.array__thaw(U32, T)), FD.array__freeze(U32, FD.array__thaw(U32, UG(L, dz, c, NB))), UG(L, dz, c, NB),
      Equal.cong(Array<U32>, FD.array__Tree<U32>, z => FD.array__freeze(U32, z), FD.array__thaw(U32, T), FD.array__thaw(U32, UG(L, dz, c, NB)), eth),
      FD.array__freeze_thaw(U32, UG(L, dz, c, NB))))

# the words past the delimiter's are zero
def past(+L: U32, +dz: Nat, +c: CPD, +NB: U32, +m: Nat, +h: Nat, +T: FD.array__Tree<U32>,
    +hy: {Nat.is_le(VC.YL(L), U32.to_nat(VB.UMAX())) == True{} : Bool}, +hwc: {Nat.is_le(U32.to_nat(VC.WZ(L)), O.pow2n(dz)) == True{} : Bool},
    +hdz: {Nat.is_lt(dz, 32n) == True{} : Bool}, +hq: {Nat.is_lt(U32.to_nat(U32.shrn(NB, 5n)), FD.spec_common__pow2(dz)) == True{} : Bool},
    +e1: {U32.to_nat(L) == 1n+m : Nat}, +hh: {Nat.is_le(h, 7n) == True{} : Bool}, +eNB: {U32.to_nat(NB) == Nat.add(VSP.x8(m), h) : Nat},
    +eT: {T == UG(L, dz, c, NB) : FD.array__Tree<U32>}, +x: Nat, +hx: {Nat.is_lt(U32.to_nat(U32.shrn(NB, 5n)), x) == True{} : Bool})
    -> {MR.wd(FD.array__slots(U32, T), x) == 0 : U32}:
  +M = CPT(L, dz, c)
  +K = VYB.MK(L, dz, M)
  +Q = U32.to_nat(U32.shrn(NB, 5n))
  +V = U32.and(FD.flat__nthc(FD.array__slots(U32, K), Q), U32.not(MF.shl_by(1, U32.and(NB, 31))))
  +pfM = CPpf(L, dz, c)
  +hn = FD.nat__le_trans(VC.NW(L), U32.to_nat(VC.WZ(L)), VB.pw(dz), VC.nw_le_wzu(L, hy),
    FD.logic__subst(Nat, z => {Nat.is_le(U32.to_nat(VC.WZ(L)), z) == True{} : Bool}, O.pow2n(dz), VB.pw(dz), Equal.sym(Nat, VB.pw(dz), O.pow2n(dz), VD.s_pow2_eq(dz)), hwc))
  +pfK = VYB.mk_perfect(L, dz, M, pfM)
  +eQ = e5m(NB, m, h, hh, eNB)
  +eNW = Equal.trans(Nat, VC.NW(L), VD.s_rng(2n, 3n+U32.to_nat(L)), 1n+Q, VC.eNWu(L, hy),
    Equal.trans(Nat, VD.s_rng(2n, 3n+U32.to_nat(L)), 1n+VD.s_rng(2n, m), 1n+Q, Equal.cong(Nat, Nat, z => VD.s_rng(2n, 3n+z), U32.to_nat(L), 1n+m, e1),
      Equal.cong(Nat, Nat, z => 1n+z, VD.s_rng(2n, m), Q, Equal.sym(Nat, Q, VD.s_rng(2n, m), eQ))))
  +h1 = VYB.FD_le1(VC.NW(L), Q, eNW)
  +eKW = Equal.trans(Nat, VYB.KW(L), Nat.sub(VC.NW(L), 1n), Q, FD.u32__sub_nat(VC.nwu(L), 1, h1),
    Equal.trans(Nat, Nat.sub(VC.NW(L), 1n), Nat.sub(1n+Q, 1n), Q, Equal.cong(Nat, Nat, z => Nat.sub(z, 1n), VC.NW(L), 1n+Q, eNW), FD.nat__sub_zero(Q)))
  +hkw = FD.logic__subst(Nat, z => {Nat.is_lt(z, VB.pw(dz)) == True{} : Bool}, Q, VYB.KW(L), Equal.sym(Nat, VYB.KW(L), Q, eKW), hq)
  +lkw = FD.logic__subst(Nat, z => {Nat.is_lt(z, x) == True{} : Bool}, Q, VYB.KW(L), Equal.sym(Nat, VYB.KW(L), Q, eKW), hx)
  +hxn = FD.logic__subst(Nat, z => {Nat.is_le(z, x) == True{} : Bool}, 1n+Q, VC.NW(L), Equal.sym(Nat, VC.NW(L), 1n+Q, eNW), FD.nat__lt_succ_le_succ(Q, x, hx))
  +eU = Equal.cong(List<&2, U32>, U32, z => FD.flat__nthc(z, x), FD.array__slots(U32, FD.array__upd(U32, dz, K, Q, V)), FD.spec_common__update(U32, FD.array__slots(U32, K), Q, V),
    FD.array__upd_slots(U32, dz, K, Q, V, hq, pfK))
  +z0 = Equal.trans(U32, FD.flat__nthc(FD.array__slots(U32, UG(L, dz, c, NB)), x), FD.flat__nthc(FD.spec_common__update(U32, FD.array__slots(U32, K), Q, V), x), 0, eU,
    Equal.trans(U32, FD.flat__nthc(FD.spec_common__update(U32, FD.array__slots(U32, K), Q, V), x), FD.flat__nthc(FD.array__slots(U32, K), x), 0,
      FD.flat__nthc_other(FD.array__slots(U32, K), Q, x, V, FD.nat__is_eq_lt(Q, x, hx)),
      Equal.trans(U32, VB.slot(K, x), VB.slot(M, x), 0, DZ.mk_out(L, dz, M, x, pfM, hkw, FD.nat__is_eq_lt(VYB.KW(L), x, lkw)), CPout(L, dz, c, x, hn, hxn))))
  FD.logic__subst(FD.array__Tree<U32>, z => {MR.wd(FD.array__slots(U32, z), x) == 0 : U32}, UG(L, dz, c, NB), T, Equal.sym(FD.array__Tree<U32>, T, UG(L, dz, c, NB), eT), z0)

# ---- arithmetic ----
law rot1:
  for +k: Nat
  for +E: Nat
  {Nat.add(Nat.add(k, E), 1n) == Nat.add(E, 1n+k) : Nat}
def rot1(k, E):
  match k:
    case 0n: {==}
    case 1n+ +j:
      Equal.trans(Nat, 1n+Nat.add(Nat.add(j, E), 1n), 1n+Nat.add(E, 1n+j), Nat.add(E, 1n+(1n+j)), Equal.cong(Nat, Nat, z => 1n+z, Nat.add(Nat.add(j, E), 1n), Nat.add(E, 1n+j), rot1(j, E)),
        Equal.sym(Nat, Nat.add(E, 1n+(1n+j)), 1n+Nat.add(E, 1n+j), FD.nat__add_succ(E, 1n+j)))

law x8q:
  for +Y: Nat
  {VSP.x8(A.quad(Y)) == BV.x32(Y) : Nat}
def x8q(Y):
  match Y:
    case 0n: {==}
    case 1n+ +p: Equal.cong(Nat, Nat, z => 32n+z, VSP.x8(A.quad(p)), BV.x32(p), x8q(p))

# k + (8 (4 Y) + h) = 32 Y + (k + h)
def kc(+k: Nat, +Y: Nat, +h: Nat) -> {Nat.add(k, Nat.add(VSP.x8(A.quad(Y)), h)) == Nat.add(BV.x32(Y), Nat.add(k, h)) : Nat}:
  %Equal.sym(Nat, VSP.x8(A.quad(Y)), BV.x32(Y), x8q(Y)) : {Nat.add(k, Nat.add(_, h)) == Nat.add(BV.x32(Y), Nat.add(k, h)) : Nat}
  Equal.trans(Nat, Nat.add(k, Nat.add(BV.x32(Y), h)), Nat.add(Nat.add(k, BV.x32(Y)), h), Nat.add(BV.x32(Y), Nat.add(k, h)), Equal.sym(Nat, Nat.add(Nat.add(k, BV.x32(Y)), h), Nat.add(k, Nat.add(BV.x32(Y), h)), FD.nat__add_assoc(k, BV.x32(Y), h)),
    Equal.trans(Nat, Nat.add(Nat.add(k, BV.x32(Y)), h), Nat.add(Nat.add(BV.x32(Y), k), h), Nat.add(BV.x32(Y), Nat.add(k, h)), Equal.cong(Nat, Nat, z => Nat.add(z, h), Nat.add(k, BV.x32(Y)), Nat.add(BV.x32(Y), k), FD.nat__add_comm(k, BV.x32(Y))),
      FD.nat__add_assoc(BV.x32(Y), k, h)))

# k + (Y + h) = Y + (k + h)
def km(+k: Nat, +Y: Nat, +h: Nat) -> {Nat.add(k, Nat.add(Y, h)) == Nat.add(Y, Nat.add(k, h)) : Nat}:
  Equal.trans(Nat, Nat.add(k, Nat.add(Y, h)), Nat.add(Nat.add(k, Y), h), Nat.add(Y, Nat.add(k, h)), Equal.sym(Nat, Nat.add(Nat.add(k, Y), h), Nat.add(k, Nat.add(Y, h)), FD.nat__add_assoc(k, Y, h)),
    Equal.trans(Nat, Nat.add(Nat.add(k, Y), h), Nat.add(Nat.add(Y, k), h), Nat.add(Y, Nat.add(k, h)), Equal.cong(Nat, Nat, z => Nat.add(z, h), Nat.add(k, Y), Nat.add(Y, k), FD.nat__add_comm(k, Y)),
      FD.nat__add_assoc(Y, k, h)))

# 32 q + 256 X as products
law em32:
  for +q: Nat
  {WS.e32(q) == Nat.mul(q, 32n) : Nat}
def em32(q):
  match q:
    case 0n: {==}
    case 1n+ +p: Equal.cong(Nat, Nat, z => 32n+z, WS.e32(p), Nat.mul(p, 32n), em32(p))

law em256:
  for +X: Nat
  {VSP.x8(WS.e32(X)) == Nat.mul(X, 256n) : Nat}
def em256(X):
  match X:
    case 0n: {==}
    case 1n+ +p: Equal.cong(Nat, Nat, z => 256n+z, VSP.x8(WS.e32(p)), Nat.mul(p, 256n), em256(p))

# the chunk count of 32 q + (1 + j) bytes is 1 + q (j <= 31)
def cq(+q: Nat, +j: Nat, +hj: {Nat.is_le(j, 31n) == True{} : Bool}) -> {Nat.div(Nat.add(Nat.add(WS.e32(q), 1n+j), 31n), 32n) == 1n+q : Nat}:
  +E = WS.e32(q)
  +e1 = Equal.trans(Nat, Nat.add(Nat.add(E, 1n+j), 31n), Nat.add(E, Nat.add(1n+j, 31n)), Nat.add(E, Nat.add(32n, j)), FD.nat__add_assoc(E, 1n+j, 31n),
    Equal.cong(Nat, Nat, z => Nat.add(E, 1n+z), Nat.add(j, 31n), Nat.add(31n, j), FD.nat__add_comm(j, 31n)))
  +e2 = Equal.trans(Nat, Nat.add(E, Nat.add(32n, j)), Nat.add(32n, Nat.add(E, j)), Nat.add(Nat.mul(1n+q, 32n), j), Equal.sym(Nat, Nat.add(32n, Nat.add(E, j)), Nat.add(E, Nat.add(32n, j)), km(32n, E, j)),
    Equal.trans(Nat, Nat.add(32n, Nat.add(E, j)), Nat.add(32n, Nat.add(Nat.mul(q, 32n), j)), Nat.add(Nat.mul(1n+q, 32n), j), Equal.cong(Nat, Nat, z => Nat.add(32n, Nat.add(z, j)), E, Nat.mul(q, 32n), em32(q)),
      Equal.sym(Nat, Nat.add(Nat.mul(1n+q, 32n), j), Nat.add(32n, Nat.add(Nat.mul(q, 32n), j)), FD.nat__add_assoc(32n, Nat.mul(q, 32n), j))))
  Equal.trans(Nat, Nat.div(Nat.add(Nat.add(E, 1n+j), 31n), 32n), Nat.div(Nat.add(Nat.mul(1n+q, 32n), j), 32n), 1n+q,
    Equal.cong(Nat, Nat, z => Nat.div(z, 32n), Nat.add(Nat.add(E, 1n+j), 31n), Nat.add(Nat.mul(1n+q, 32n), j), Equal.trans(Nat, Nat.add(Nat.add(E, 1n+j), 31n), Nat.add(E, Nat.add(32n, j)), Nat.add(Nat.mul(1n+q, 32n), j), e1, e2)),
    DV.div_exact(1n+q, j, 31n, hj))

# chunk_limit(256 X + 1) = 1 + X and chunk_limit(256 (1 + p)) = 1 + p
def cl1(+X: Nat) -> {Bm.chunk_limit(Nat.add(VSP.x8(WS.e32(X)), 1n)) == 1n+X : Nat}:
  +Y = VSP.x8(WS.e32(X))
  +M = Nat.mul(X, 256n)
  +e1 = Equal.trans(Nat, Nat.add(Nat.add(Y, 1n), 255n), Nat.add(Y, 256n), Nat.add(Nat.mul(1n+X, 256n), 0n), FD.nat__add_assoc(Y, 1n, 255n),
    Equal.trans(Nat, Nat.add(Y, 256n), Nat.add(256n, M), Nat.add(Nat.mul(1n+X, 256n), 0n), Equal.trans(Nat, Nat.add(Y, 256n), Nat.add(256n, Y), Nat.add(256n, M), FD.nat__add_comm(Y, 256n),
      Equal.cong(Nat, Nat, z => Nat.add(256n, z), Y, M, em256(X))), Equal.sym(Nat, Nat.add(Nat.mul(1n+X, 256n), 0n), Nat.add(256n, M), FD.nat__add_zero(Nat.mul(1n+X, 256n)))))
  Equal.trans(Nat, Nat.div(Nat.add(Nat.add(Y, 1n), 255n), 256n), Nat.div(Nat.add(Nat.mul(1n+X, 256n), 0n), 256n), 1n+X,
    Equal.cong(Nat, Nat, z => Nat.div(z, 256n), Nat.add(Nat.add(Y, 1n), 255n), Nat.add(Nat.mul(1n+X, 256n), 0n), e1), DV.div_exact(1n+X, 0n, 255n, {==}))

def cl0(+p: Nat) -> {Bm.chunk_limit(Nat.add(VSP.x8(WS.e32(1n+p)), 0n)) == 1n+p : Nat}:
  +Y = VSP.x8(WS.e32(1n+p))
  +e1 = Equal.cong(Nat, Nat, z => Nat.add(z, 255n), Nat.add(Y, 0n), Nat.mul(1n+p, 256n), Equal.trans(Nat, Nat.add(Y, 0n), Y, Nat.mul(1n+p, 256n), FD.nat__add_zero(Y), em256(1n+p)))
  Equal.trans(Nat, Nat.div(Nat.add(Nat.add(Y, 0n), 255n), 256n), Nat.div(Nat.add(Nat.mul(1n+p, 256n), 255n), 256n), 1n+p,
    Equal.cong(Nat, Nat, z => Nat.div(z, 256n), Nat.add(Nat.add(Y, 0n), 255n), Nat.add(Nat.mul(1n+p, 256n), 255n), e1), DV.div_exact(1n+p, 255n, 255n, {==}))

# 256 X + s <= NL with s >= 1: X + 1 chunks fit
def cbound(+X: Nat, +NL: Nat, +s: Nat, +hs: {Nat.is_le(1n, s) == True{} : Bool}, +h: {Nat.is_le(Nat.add(VSP.x8(WS.e32(X)), s), NL) == True{} : Bool})
    -> {Nat.is_le(1n+X, Bm.chunk_limit(NL)) == True{} : Bool}:
  +Y = VSP.x8(WS.e32(X))
  +h1 = FD.nat__le_trans(Nat.add(Y, 1n), Nat.add(Y, s), NL, Order.add_left(Y, 1n, s, hs), h)
  FD.logic__subst(Nat, z => {Nat.is_le(z, Bm.chunk_limit(NL)) == True{} : Bool}, Bm.chunk_limit(Nat.add(Y, 1n)), 1n+X, cl1(X), BCC.chunk_limit_monotone(Nat.add(Y, 1n), NL, h1))

# 256 (1 + p) <= NL: 1 + p chunks fit
def cbound0(+p: Nat, +NL: Nat, +h: {Nat.is_le(Nat.add(VSP.x8(WS.e32(1n+p)), 0n), NL) == True{} : Bool}) -> {Nat.is_le(1n+p, Bm.chunk_limit(NL)) == True{} : Bool}:
  FD.logic__subst(Nat, z => {Nat.is_le(z, Bm.chunk_limit(NL)) == True{} : Bool}, Bm.chunk_limit(Nat.add(VSP.x8(WS.e32(1n+p)), 0n)), 1n+p, cl0(p), BCC.chunk_limit_monotone(Nat.add(VSP.x8(WS.e32(1n+p)), 0n), NL, h))

def dlt(h: Nat) -> Nat:
  match h:
    case 0n: 0n
    case 1n+p: 1n

def nbd(+h: Nat, +hh: {Nat.is_le(h, 7n) == True{} : Bool}) -> {VD.s_rng(3n, Nat.add(h, 7n)) == dlt(h) : Nat}:
  match h:
    case 0n: {==}
    case 1n: {==}
    case 2n: {==}
    case 3n: {==}
    case 4n: {==}
    case 5n: {==}
    case 6n: {==}
    case 7n: {==}
    case 8n+ +p: Empty.absurd({VD.s_rng(3n, Nat.add(8n+p, 7n)) == dlt(8n+p) : Nat}, FD.logic__false_true(hh))

# NB >> 3 is m, NB & 7 is h, and the byte count m + (h > 0)
def eakm(+NB: U32, +m: Nat, +h: Nat, +hh: {Nat.is_le(h, 7n) == True{} : Bool}, +eNB: {U32.to_nat(NB) == Nat.add(VSP.x8(m), h) : Nat}) -> {U32.to_nat(U32.shrn(NB, 3n)) == m : Nat}:
  Equal.trans(Nat, U32.to_nat(U32.shrn(NB, 3n)), VD.s_rng(3n, U32.to_nat(NB)), m, VD.shrk(3n, NB),
    Equal.trans(Nat, VD.s_rng(3n, U32.to_nat(NB)), VD.s_rng(3n, Nat.add(VSP.x8(m), h)), m, Equal.cong(Nat, Nat, z => VD.s_rng(3n, z), U32.to_nat(NB), Nat.add(VSP.x8(m), h), eNB), s3m(m, h, hh)))

def enbl(+NB: U32, +m: Nat, +h: Nat, +hh: {Nat.is_le(h, 7n) == True{} : Bool}, +eNB: {U32.to_nat(NB) == Nat.add(VSP.x8(m), h) : Nat},
    +kb: Nat, +hkb: {Nat.is_lt(kb, 33n) == True{} : Bool}, +hK: VBT.HK(NB, kb)) -> {U32.to_nat(O.bits_nbytes(NB)) == Nat.add(m, dlt(h)) : Nat}:
  +eA = eakm(NB, m, h, hh, eNB)
  +e2 = Equal.trans(Nat, Nat.add(VSP.x8(m), VBT.BKk(NB)), U32.to_nat(NB), Nat.add(VSP.x8(m), h),
    Equal.sym(Nat, U32.to_nat(NB), Nat.add(VSP.x8(m), VBT.BKk(NB)), FD.logic__subst(Nat, z => {U32.to_nat(NB) == Nat.add(VSP.x8(z), VBT.BKk(NB)) : Nat}, VBT.AK(NB), m, eA, VBT.E1(NB))), eNB)
  +eB = FD.lru_subtraction_bounds__cancel_left(VSP.x8(m), VBT.BKk(NB), h, e2)
  Equal.trans(Nat, U32.to_nat(O.bits_nbytes(NB)), Nat.add(VBT.AK(NB), VD.s_rng(3n, Nat.add(VBT.BKk(NB), 7n))), Nat.add(m, dlt(h)), VBT.E3(NB, kb, hkb, hK),
