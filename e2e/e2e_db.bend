# Decoded bit lists: the storage facts of e2e_hv.bend (SDX: no bit set at or above NB in word NB >> 5) give
# bitlist_obj's representation invariant wfb.

# ---- a word ANDed with the mask of its bits from k is zero: those bits are clear ----
def whd(+n: Nat, w: Word(1n+n)) -> Bool:
  match w:
    case WCon{x, t}: x

def wtl(+n: Nat, w: Word(1n+n)) -> Word(n):
  match w:
    case WCon{x, t}: t

law zaz:
  for +n: Nat
  for +k: Nat
  for +w: Word(n)
  for +e: {Word.and(n, w, HV.ZO(n, k)) == Word.zero(n) : Word(n)}
  {HV.ZF(k, BLf.word_bits(n, w)) == True{} : Bool}
def zaz(n, k, w, e):
  match n k w:
    case 0n 0n WNil{}: {==}
    case 0n 1n+ +j WNil{}: {==}
    case 1n+ +m 0n WCon{True{}, +t}:
      Empty.absurd({HV.ZF(0n, BLf.word_bits(1n+m, WCon{True{}, t})) == True{} : Bool},
        FD.logic__true_false(Equal.cong(Word(1n+m), Bool, z => whd(m, z), Word.and(1n+m, WCon{True{}, t}, HV.ZO(1n+m, 0n)), Word.zero(1n+m), e)))
    case 1n+ +m 0n WCon{False{}, +t}:
      zaz(m, 0n, t, Equal.cong(Word(1n+m), Word(m), z => wtl(m, z), Word.and(1n+m, WCon{False{}, t}, HV.ZO(1n+m, 0n)), Word.zero(1n+m), e))
    case 1n+ +m 1n+ +j WCon{+x, +t}:
      zaz(m, j, t, Equal.cong(Word(1n+m), Word(m), z => wtl(m, z), Word.and(1n+m, WCon{x, t}, HV.ZO(1n+m, 1n+j)), Word.zero(1n+m), e))

# m32 is 32 times
law m32_mul:
  for +q: Nat
  {VBT.m32(q) == Nat.mul(q, 32n) : Nat}
def m32_mul(q):
  match q:
    case 0n: {==}
    case 1n+ +p: Equal.cong(Nat, Nat, z => 32n+z, VBT.m32(p), Nat.mul(p, 32n), m32_mul(p))

