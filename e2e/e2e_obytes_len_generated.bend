# GENERATED by output_bytes_length (codegen). Do not edit.
# the bytes list a loop returns has the length of the words it emitted: 4 per full word
def eg0(+i: U32, +n: U32, +acc: +List<U32>, q: B.Buf & U32)
    -> {Pair.snd(B.Buf, +List<U32>, B.emit_go(0n, i, n, acc, q)) == acc : +List<U32>}:
  match q:
    case Tuple{b, +w}: {==}

def pw4(+w: U32, +acc: +List<U32>) -> {List.length(&2, U32, B.prepend_word(4, w, acc)) == Nat.add(4n, List.length(&2, U32, acc)) : Nat}: {==}

def ar(+x: Nat, +l: Nat) -> {Nat.add(x, 4n+l) == 4n+Nat.add(x, l) : Nat}:
  match x:
    case 0n: {==}
    case 1n+ +y: Equal.cong(Nat, Nat, z => 1n+z, Nat.add(y, 4n+l), 4n+Nat.add(y, l), ar(y, l))

def qa(+r: Nat, +l: Nat) -> {Nat.add(A.quad(1n+r), Nat.add(4n, l)) == Nat.add(A.quad(2n+r), l) : Nat}:
  Equal.cong(Nat, Nat, z => 4n+z, Nat.add(A.quad(r), 4n+l), 4n+Nat.add(A.quad(r), l), ar(A.quad(r), l))

def egl(+p: Nat, +i: U32, +n: U32, +acc: +List<U32>, q: B.Buf & U32, +d: Nat,
    +ei: {U32.to_nat(i) == p : Nat}, +hd: {Nat.is_lt(d, 31n) == True{} : Bool},
    +hp: {Nat.is_lt(p, F.spec_common__pow2(d)) == True{} : Bool},
    +hn: {Nat.is_le(A.quad(1n+p), U32.to_nat(n)) == True{} : Bool})
    -> {List.length(&2, U32, Pair.snd(B.Buf, +List<U32>, B.emit_go(1n+p, i, n, acc, q))) == Nat.add(A.quad(1n+p), List.length(&2, U32, acc)) : Nat}:
  match p q:
        case 0n Tuple{b, +w}:
          %Equal.sym(U32, B.bytes_in(i, n), 4, AE.bin4(i, n, 0n, d, ei, hd, hp, hn)) :
            {List.length(&2, U32, Pair.snd(B.Buf, +List<U32>, B.emit_go(0n, (i - 1 : U32), n, B.prepend_word(_, w, acc), B.word(b, (i - 1 : U32))))) == Nat.add(A.quad(1n+0n), List.length(&2, U32, acc)) : Nat}
          %Equal.sym(+List<U32>, Pair.snd(B.Buf, +List<U32>, B.emit_go(0n, (i - 1 : U32), n, B.prepend_word(4, w, acc), B.word(b, (i - 1 : U32)))), B.prepend_word(4, w, acc), eg0((i - 1 : U32), n, B.prepend_word(4, w, acc), B.word(b, (i - 1 : U32)))) :
            {List.length(&2, U32, _) == Nat.add(A.quad(1n+0n), List.length(&2, U32, acc)) : Nat}
          pw4(w, acc)
        case 1n+ +r Tuple{b, +w}:
          +j = (i - 1 : U32)
          +ej = AE.pred1(i, r, ei)
          +hr = F.nat__lt_trans(r, 1n+r, F.spec_common__pow2(d), F.nat__lt_succ(r), hp)
          +hj = F.logic__subst(Nat, z => {Nat.is_lt(z, F.spec_common__pow2(d)) == True{} : Bool}, r, U32.to_nat(j), Equal.sym(Nat, U32.to_nat(j), r, ej), hr)
          +hn1 = F.nat__le_trans(A.quad(1n+r), 4n+A.quad(1n+r), U32.to_nat(n), AC.le_addl(4n, A.quad(1n+r)), hn)
          %Equal.sym(U32, B.bytes_in(i, n), 4, AE.bin4(i, n, 1n+r, d, ei, hd, hp, hn)) :
            {List.length(&2, U32, Pair.snd(B.Buf, +List<U32>, B.emit_go(1n+r, j, n, B.prepend_word(_, w, acc), B.word(b, j)))) == Nat.add(A.quad(2n+r), List.length(&2, U32, acc)) : Nat}
          Equal.trans(Nat, List.length(&2, U32, Pair.snd(B.Buf, +List<U32>, B.emit_go(1n+r, j, n, B.prepend_word(4, w, acc), B.word(b, j)))), Nat.add(A.quad(1n+r), Nat.add(4n, List.length(&2, U32, acc))), Nat.add(A.quad(2n+r), List.length(&2, U32, acc)),
            egl(r, j, n, B.prepend_word(4, w, acc), B.word(b, j), d, ej, hd, hr, hn1), qa(r, List.length(&2, U32, acc)))

# ---- the first (top) word of the buffer ----
def pos(+a: Nat, +b: Nat, +h: {Nat.is_lt(a, b) == True{} : Bool}) -> {Nat.is_lt(0n, Nat.sub(b, a)) == True{} : Bool}:
  match a b:
    case 0n 0n: Empty.absurd({Nat.is_lt(0n, Nat.sub(0n, 0n)) == True{} : Bool}, F.logic__false_true(h))
    case 0n 1n+ +q: {==}
    case 1n+ +p 0n: Empty.absurd({Nat.is_lt(0n, Nat.sub(0n, 1n+p)) == True{} : Bool}, F.logic__false_true(h))
    case 1n+ +p 1n+ +q: pos(p, q, h)

def pw_d(+k: U32, +d3: Nat, +w: U32, +acc: +List<U32>, +ek: {U32.to_nat(k) == 4n+d3 : Nat}, +h2: {Nat.is_lt(4n+d3, 4n) == True{} : Bool})
    -> {List.length(&2, U32, B.prepend_word(k, w, acc)) == Nat.add(4n+d3, List.length(&2, U32, acc)) : Nat}:
  Empty.absurd({List.length(&2, U32, B.prepend_word(k, w, acc)) == Nat.add(4n+d3, List.length(&2, U32, acc)) : Nat}, F.nat__lt_zero_absurd(d3, h2))

def pw_c(+k: U32, +d2: Nat, +w: U32, +acc: +List<U32>, +ek: {U32.to_nat(k) == 3n+d2 : Nat}, +h2: {Nat.is_lt(3n+d2, 4n) == True{} : Bool})
    -> {List.length(&2, U32, B.prepend_word(k, w, acc)) == Nat.add(3n+d2, List.length(&2, U32, acc)) : Nat}:
  match d2:
    case 0n:
      %Equal.sym(U32, k, 3, F.u32__injective(k, 3, ek)) : {List.length(&2, U32, B.prepend_word(_, w, acc)) == Nat.add(3n+0n, List.length(&2, U32, acc)) : Nat}
      {==}
    case 1n+ +d3: pw_d(k, d3, w, acc, ek, h2)

def pw_b(+k: U32, +d1: Nat, +w: U32, +acc: +List<U32>, +ek: {U32.to_nat(k) == 2n+d1 : Nat}, +h2: {Nat.is_lt(2n+d1, 4n) == True{} : Bool})
    -> {List.length(&2, U32, B.prepend_word(k, w, acc)) == Nat.add(2n+d1, List.length(&2, U32, acc)) : Nat}:
  match d1:
    case 0n:
      %Equal.sym(U32, k, 2, F.u32__injective(k, 2, ek)) : {List.length(&2, U32, B.prepend_word(_, w, acc)) == Nat.add(2n+0n, List.length(&2, U32, acc)) : Nat}
      {==}
    case 1n+ +d2: pw_c(k, d2, w, acc, ek, h2)

def pwl(+k: U32, +dd: Nat, +w: U32, +acc: +List<U32>, +ek: {U32.to_nat(k) == dd : Nat}, +h1: {Nat.is_lt(0n, dd) == True{} : Bool}, +h2: {Nat.is_lt(dd, 4n) == True{} : Bool})
    -> {List.length(&2, U32, B.prepend_word(k, w, acc)) == Nat.add(dd, List.length(&2, U32, acc)) : Nat}:
  match dd:
    case 0n: Empty.absurd({List.length(&2, U32, B.prepend_word(k, w, acc)) == Nat.add(0n, List.length(&2, U32, acc)) : Nat}, F.logic__false_true(h1))
    case 1n+ +d1:
      match d1:
        case 0n:
          %Equal.sym(U32, k, 1, F.u32__injective(k, 1, ek)) : {List.length(&2, U32, B.prepend_word(_, w, acc)) == Nat.add(1n+0n, List.length(&2, U32, acc)) : Nat}
          {==}
        case 1n+ +d2: pw_b(k, d2, w, acc, ek, h2)

# the bytes of word i, i the top word: 4P < n <= 4(P + 1). Its length plus the 4P bytes below is n.
def fst2(+c: Bool, +P: Nat, +i: U32, +n: U32, +w: U32,
    +ec: {U32.is_le(((4 * i : U32) + 4 : U32), n) == c : Bool},
    +hq: {U32.to_nat((4 * i : U32)) == A.quad(P) : Nat},
    +s4: {U32.to_nat(((4 * i : U32) + 4 : U32)) == Nat.add(A.quad(P), 4n) : Nat},
    +c1: {U32.is_le(n, (4 * i : U32)) == False{} : Bool},
    +hlo: {Nat.is_lt(A.quad(P), U32.to_nat(n)) == True{} : Bool},
    +hhi: {Nat.is_le(U32.to_nat(n), Nat.add(A.quad(P), 4n)) == True{} : Bool})
    -> {Nat.add(A.quad(P), List.length(&2, U32, B.prepend_word(B.bytes_in(i, n), w, []))) == U32.to_nat(n) : Nat}:
  match c:
    case True{}:
      +le4 = Equal.trans(Bool, Nat.is_le(Nat.add(A.quad(P), 4n), U32.to_nat(n)), Nat.is_le(U32.to_nat(((4 * i : U32) + 4 : U32)), U32.to_nat(n)), True{},
        Equal.sym(Bool, Nat.is_le(U32.to_nat(((4 * i : U32) + 4 : U32)), U32.to_nat(n)), Nat.is_le(Nat.add(A.quad(P), 4n), U32.to_nat(n)),
          Equal.cong(Nat, Bool, z => Nat.is_le(z, U32.to_nat(n)), U32.to_nat(((4 * i : U32) + 4 : U32)), Nat.add(A.quad(P), 4n), s4)),
        Equal.trans(Bool, Nat.is_le(U32.to_nat(((4 * i : U32) + 4 : U32)), U32.to_nat(n)), U32.is_le(((4 * i : U32) + 4 : U32), n), True{},
          Equal.sym(Bool, U32.is_le(((4 * i : U32) + 4 : U32), n), Nat.is_le(U32.to_nat(((4 * i : U32) + 4 : U32)), U32.to_nat(n)), AE.le_nat(((4 * i : U32) + 4 : U32), n)), ec))
      +eq4 = F.nat__le_antisym(U32.to_nat(n), Nat.add(A.quad(P), 4n), hhi, le4)
      %Equal.sym(Bool, U32.is_le(n, (4 * i : U32)), False{}, c1) :
        {Nat.add(A.quad(P), List.length(&2, U32, B.prepend_word(B.pick(_, 0, B.pick(U32.is_le(((4 * i : U32) + 4 : U32), n), 4, (n - (4 * i : U32) : U32))), w, []))) == U32.to_nat(n) : Nat}
      %Equal.sym(Bool, U32.is_le(((4 * i : U32) + 4 : U32), n), True{}, ec) :
        {Nat.add(A.quad(P), List.length(&2, U32, B.prepend_word(B.pick(False{}, 0, B.pick(_, 4, (n - (4 * i : U32) : U32))), w, []))) == U32.to_nat(n) : Nat}
      Equal.sym(Nat, U32.to_nat(n), Nat.add(A.quad(P), 4n), eq4)
    case False{}:
      +hn4 = F.nat__not_le_lt(Nat.add(A.quad(P), 4n), U32.to_nat(n),
        Equal.trans(Bool, Nat.is_le(Nat.add(A.quad(P), 4n), U32.to_nat(n)), Nat.is_le(U32.to_nat(((4 * i : U32) + 4 : U32)), U32.to_nat(n)), False{},
          Equal.sym(Bool, Nat.is_le(U32.to_nat(((4 * i : U32) + 4 : U32)), U32.to_nat(n)), Nat.is_le(Nat.add(A.quad(P), 4n), U32.to_nat(n)),
            Equal.cong(Nat, Bool, z => Nat.is_le(z, U32.to_nat(n)), U32.to_nat(((4 * i : U32) + 4 : U32)), Nat.add(A.quad(P), 4n), s4)),
          Equal.trans(Bool, Nat.is_le(U32.to_nat(((4 * i : U32) + 4 : U32)), U32.to_nat(n)), U32.is_le(((4 * i : U32) + 4 : U32), n), False{},
            Equal.sym(Bool, U32.is_le(((4 * i : U32) + 4 : U32), n), Nat.is_le(U32.to_nat(((4 * i : U32) + 4 : U32)), U32.to_nat(n)), AE.le_nat(((4 * i : U32) + 4 : U32), n)), ec)))
      +hle = F.nat__lt_le(A.quad(P), U32.to_nat(n), hlo)
      +hd4 = F.nat__sub_lt(U32.to_nat(n), A.quad(P), 4n, hle, hn4)
      +hd0 = pos(A.quad(P), U32.to_nat(n), hlo)
      +hsub = F.u32__sub_nat(n, (4 * i : U32), F.logic__subst(Nat, z => {Nat.is_le(z, U32.to_nat(n)) == True{} : Bool}, A.quad(P), U32.to_nat((4 * i : U32)), Equal.sym(Nat, U32.to_nat((4 * i : U32)), A.quad(P), hq), hle))
      +ek = Equal.trans(Nat, U32.to_nat((n - (4 * i : U32) : U32)), Nat.sub(U32.to_nat(n), U32.to_nat((4 * i : U32))), Nat.sub(U32.to_nat(n), A.quad(P)), hsub,
        Equal.cong(Nat, Nat, z => Nat.sub(U32.to_nat(n), z), U32.to_nat((4 * i : U32)), A.quad(P), hq))
      %Equal.sym(Bool, U32.is_le(n, (4 * i : U32)), False{}, c1) :
        {Nat.add(A.quad(P), List.length(&2, U32, B.prepend_word(B.pick(_, 0, B.pick(U32.is_le(((4 * i : U32) + 4 : U32), n), 4, (n - (4 * i : U32) : U32))), w, []))) == U32.to_nat(n) : Nat}
      %Equal.sym(Bool, U32.is_le(((4 * i : U32) + 4 : U32), n), False{}, ec) :
        {Nat.add(A.quad(P), List.length(&2, U32, B.prepend_word(B.pick(False{}, 0, B.pick(_, 4, (n - (4 * i : U32) : U32))), w, []))) == U32.to_nat(n) : Nat}
      %Equal.sym(Nat, List.length(&2, U32, B.prepend_word((n - (4 * i : U32) : U32), w, [])), Nat.add(Nat.sub(U32.to_nat(n), A.quad(P)), 0n),
        Equal.trans(Nat, List.length(&2, U32, B.prepend_word((n - (4 * i : U32) : U32), w, [])), Nat.add(Nat.sub(U32.to_nat(n), A.quad(P)), List.length(&2, U32, [])), Nat.add(Nat.sub(U32.to_nat(n), A.quad(P)), 0n),
          pwl((n - (4 * i : U32) : U32), Nat.sub(U32.to_nat(n), A.quad(P)), w, [], ek, hd0, hd4), {==})) :
        {Nat.add(A.quad(P), _) == U32.to_nat(n) : Nat}
      Equal.trans(Nat, Nat.add(A.quad(P), Nat.add(Nat.sub(U32.to_nat(n), A.quad(P)), 0n)), Nat.add(A.quad(P), Nat.sub(U32.to_nat(n), A.quad(P))), U32.to_nat(n),
        Equal.cong(Nat, Nat, z => Nat.add(A.quad(P), z), Nat.add(Nat.sub(U32.to_nat(n), A.quad(P)), 0n), Nat.sub(U32.to_nat(n), A.quad(P)), F.nat__add_zero(Nat.sub(U32.to_nat(n), A.quad(P)))),
        F.nat__sub_add(U32.to_nat(n), A.quad(P), hle))

def lt_nat(+a: U32, +b: U32) -> {U32.is_lt(a, b) == Nat.is_lt(U32.to_nat(a), U32.to_nat(b)) : Bool}:
  %Equal.sym(Cmp, U32.cmp(a, b), Nat.cmp(U32.to_nat(a), U32.to_nat(b)), F.u32__u32_cmp(a, b)) : {Cmp.is_lt(_) == Nat.is_lt(U32.to_nat(a), U32.to_nat(b)) : Bool}
  {==}

# the emit_go call of the top word, then the full words below it
def top1(+p: Nat, +i: U32, +n: U32, q: B.Buf & U32, +d: Nat,
    +ei: {U32.to_nat(i) == p : Nat}, +hd: {Nat.is_lt(d, 31n) == True{} : Bool},
    +hp: {Nat.is_lt(p, F.spec_common__pow2(d)) == True{} : Bool},
    +hq: {U32.to_nat((4 * i : U32)) == A.quad(p) : Nat},
    +s4: {U32.to_nat(((4 * i : U32) + 4 : U32)) == Nat.add(A.quad(p), 4n) : Nat},
    +c1: {U32.is_le(n, (4 * i : U32)) == False{} : Bool},
    +hlo: {Nat.is_lt(A.quad(p), U32.to_nat(n)) == True{} : Bool},
    +hhi: {Nat.is_le(U32.to_nat(n), Nat.add(A.quad(p), 4n)) == True{} : Bool})
    -> {List.length(&2, U32, Pair.snd(B.Buf, +List<U32>, B.emit_go(1n+p, i, n, [], q))) == U32.to_nat(n) : Nat}:
  match p q:
    case 0n Tuple{b, +w}:
      %Equal.sym(+List<U32>, Pair.snd(B.Buf, +List<U32>, B.emit_go(0n, (i - 1 : U32), n, B.prepend_word(B.bytes_in(i, n), w, []), B.word(b, (i - 1 : U32)))), B.prepend_word(B.bytes_in(i, n), w, []), eg0((i - 1 : U32), n, B.prepend_word(B.bytes_in(i, n), w, []), B.word(b, (i - 1 : U32)))) :
        {List.length(&2, U32, _) == U32.to_nat(n) : Nat}
      fst2(U32.is_le(((4 * i : U32) + 4 : U32), n), 0n, i, n, w, {==}, hq, s4, c1, hlo, hhi)
    case 1n+ +r Tuple{b, +w}:
      +j = (i - 1 : U32)
      +ej = AE.pred1(i, r, ei)
      +hr = F.nat__lt_trans(r, 1n+r, F.spec_common__pow2(d), F.nat__lt_succ(r), hp)
      +hn1 = F.nat__lt_le(A.quad(1n+r), U32.to_nat(n), hlo)
      +ft = fst2(U32.is_le(((4 * i : U32) + 4 : U32), n), 1n+r, i, n, w, {==}, hq, s4, c1, hlo, hhi)
      Equal.trans(Nat, List.length(&2, U32, Pair.snd(B.Buf, +List<U32>, B.emit_go(1n+r, j, n, B.prepend_word(B.bytes_in(i, n), w, []), B.word(b, j)))),
        Nat.add(A.quad(1n+r), List.length(&2, U32, B.prepend_word(B.bytes_in(i, n), w, []))), U32.to_nat(n),
        egl(r, j, n, B.prepend_word(B.bytes_in(i, n), w, []), B.word(b, j), d, ej, hd, hr, hn1), ft)

def topw(+p: Nat, +i: U32, +n: U32, q: B.Buf & U32, +d: Nat,
    +ei: {U32.to_nat(i) == p : Nat}, +hd: {Nat.is_lt(d, 31n) == True{} : Bool},
    +hp: {Nat.is_lt(p, F.spec_common__pow2(d)) == True{} : Bool},
    +hq: {U32.to_nat((4 * i : U32)) == A.quad(p) : Nat},
    +s4: {U32.to_nat(((4 * i : U32) + 4 : U32)) == Nat.add(A.quad(p), 4n) : Nat},
    +hlo: {Nat.is_lt(A.quad(p), U32.to_nat(n)) == True{} : Bool},
    +hhi: {Nat.is_le(U32.to_nat(n), Nat.add(A.quad(p), 4n)) == True{} : Bool})
    -> {List.length(&2, U32, Pair.snd(B.Buf, +List<U32>, B.emit_go(1n+p, i, n, [], q))) == U32.to_nat(n) : Nat}:
  +c1 = Equal.trans(Bool, U32.is_le(n, (4 * i : U32)), Nat.is_le(U32.to_nat(n), U32.to_nat((4 * i : U32))), False{}, AE.le_nat(n, (4 * i : U32)),
    F.logic__subst(Nat, z => {Nat.is_le(U32.to_nat(n), z) == False{} : Bool}, A.quad(p), U32.to_nat((4 * i : U32)), Equal.sym(Nat, U32.to_nat((4 * i : U32)), A.quad(p), hq), F.nat__lt_not_le(A.quad(p), U32.to_nat(n), hlo)))
  top1(p, i, n, q, d, ei, hd, hp, hq, s4, c1, hlo, hhi)

def add0(+k: U32) -> {(0 + k : U32) == k : U32}:
  match k:
    case U32{+w}:
      Equal.cong(Word(32n), U32, x => U32{x}, Word.add(32n, Word.zero(32n), w), w, WSp.add_zero_left(32n, w))

# 4(1 + P) is 4 + 4P for the quad, so the sum of 4P and 4 stays under it
def sc(+P: Nat) -> {Nat.is_le(Nat.add(A.quad(P), 4n), A.quad(1n+P)) == True{} : Bool}:
  F.logic__subst(Nat, z => {Nat.is_le(Nat.add(A.quad(P), 4n), z) == True{} : Bool}, Nat.add(A.quad(P), 4n), A.quad(1n+P), F.nat__add_comm(A.quad(P), 4n), F.nat__le_refl(Nat.add(A.quad(P), 4n)))

def obl(ws: Array<U32>, +n: U32, +d: Nat,
    +hd: {Nat.is_lt(d, 31n) == True{} : Bool},
    +h1: {U32.is_lt(U32.shrn((n + 3 : U32), 2n), F.u32__pow2u(d)) == True{} : Bool},
    +h4: {U32.is_le(1, U32.shrn((n + 3 : U32), 2n)) == True{} : Bool},
    +h2: {U32.is_lt((4 * (((0 + U32.shrn((n + 3 : U32), 2n) : U32) - 1 : U32)) : U32), n) == True{} : Bool},
    +h3: {U32.is_le(n, (4 * U32.shrn((n + 3 : U32), 2n) : U32)) == True{} : Bool})
    -> {List.length(&2, U32, E.obytes(B.Buf{ws, n})) == U32.to_nat(n) : Nat}:
  +k = U32.shrn((n + 3 : U32), 2n)
  +kk = (0 + k : U32)
  +i = (kk - 1 : U32)
  +hd32 = F.nat__lt_trans(d, 31n, 32n, hd, {==})
  +hk1 = F.array__lt_bridge(k, d, hd32, True{}, h1)
  +ekk = Equal.cong(U32, Nat, z => U32.to_nat(z), kk, k, add0(k))
  +hle = F.logic__subst(Nat, z => {Nat.is_le(1n, z) == True{} : Bool}, U32.to_nat(k), U32.to_nat(kk), Equal.sym(Nat, U32.to_nat(kk), U32.to_nat(k), ekk),
    Equal.trans(Bool, Nat.is_le(1n, U32.to_nat(k)), U32.is_le(1, k), True{}, Equal.sym(Bool, U32.is_le(1, k), Nat.is_le(1n, U32.to_nat(k)), AE.le_nat(1, k)), h4))
  +ps = F.u32__sub_nat(kk, 1, hle)
  +ek1 = Equal.trans(Nat, U32.to_nat(k), Nat.add(1n, Nat.sub(U32.to_nat(kk), 1n)), 1n+U32.to_nat(i),
    Equal.trans(Nat, U32.to_nat(k), U32.to_nat(kk), Nat.add(1n, Nat.sub(U32.to_nat(kk), 1n)), Equal.sym(Nat, U32.to_nat(kk), U32.to_nat(k), ekk), Equal.sym(Nat, Nat.add(1n, Nat.sub(U32.to_nat(kk), 1n)), U32.to_nat(kk), F.nat__sub_add(U32.to_nat(kk), 1n, hle))),
    Equal.cong(Nat, Nat, z => 1n+z, Nat.sub(U32.to_nat(kk), 1n), U32.to_nat(i), Equal.sym(Nat, U32.to_nat(i), Nat.sub(U32.to_nat(kk), 1n), ps)))
  +hk2 = F.logic__subst(Nat, z => {Nat.is_lt(z, F.spec_common__pow2(d)) == True{} : Bool}, U32.to_nat(k), 1n+U32.to_nat(i), ek1, hk1)
  +hp = F.nat__lt_trans(U32.to_nat(i), 1n+U32.to_nat(i), F.spec_common__pow2(d), F.nat__lt_succ(U32.to_nat(i)), hk2)
  +hq = AE.quadv(i, U32.to_nat(i), d, {==}, hd, hp)
  +q4k = AE.quadv(k, 1n+U32.to_nat(i), d, ek1, hd, hk2)
  +hs = F.logic__subst(Nat, z => {Nat.is_le(Nat.add(z, 4n), U32.to_nat((4 * k : U32))) == True{} : Bool}, A.quad(U32.to_nat(i)), U32.to_nat((4 * i : U32)), Equal.sym(Nat, U32.to_nat((4 * i : U32)), A.quad(U32.to_nat(i)), hq),
    F.logic__subst(Nat, z => {Nat.is_le(Nat.add(A.quad(U32.to_nat(i)), 4n), z) == True{} : Bool}, A.quad(1n+U32.to_nat(i)), U32.to_nat((4 * k : U32)), Equal.sym(Nat, U32.to_nat((4 * k : U32)), A.quad(1n+U32.to_nat(i)), q4k), sc(U32.to_nat(i))))
  +s4 = Equal.trans(Nat, U32.to_nat(((4 * i : U32) + 4 : U32)), Nat.add(U32.to_nat((4 * i : U32)), 4n), Nat.add(A.quad(U32.to_nat(i)), 4n),
    A.add_le((4 * i : U32), 4, (4 * k : U32), hs), Equal.cong(Nat, Nat, z => Nat.add(z, 4n), U32.to_nat((4 * i : U32)), A.quad(U32.to_nat(i)), hq))
  +hlo = F.logic__subst(Nat, z => {Nat.is_lt(z, U32.to_nat(n)) == True{} : Bool}, U32.to_nat((4 * i : U32)), A.quad(U32.to_nat(i)), hq,
    Equal.trans(Bool, Nat.is_lt(U32.to_nat((4 * i : U32)), U32.to_nat(n)), U32.is_lt((4 * i : U32), n), True{}, Equal.sym(Bool, U32.is_lt((4 * i : U32), n), Nat.is_lt(U32.to_nat((4 * i : U32)), U32.to_nat(n)), lt_nat((4 * i : U32), n)), h2))
  +hh0 = Equal.trans(Bool, Nat.is_le(U32.to_nat(n), U32.to_nat((4 * k : U32))), U32.is_le(n, (4 * k : U32)), True{}, Equal.sym(Bool, U32.is_le(n, (4 * k : U32)), Nat.is_le(U32.to_nat(n), U32.to_nat((4 * k : U32))), AE.le_nat(n, (4 * k : U32))), h3)
  +hh1 = F.logic__subst(Nat, z => {Nat.is_le(U32.to_nat(n), z) == True{} : Bool}, U32.to_nat((4 * k : U32)), A.quad(1n+U32.to_nat(i)), q4k, hh0)
  +hhi = F.logic__subst(Nat, z => {Nat.is_le(U32.to_nat(n), z) == True{} : Bool}, A.quad(1n+U32.to_nat(i)), Nat.add(A.quad(U32.to_nat(i)), 4n), F.nat__add_comm(4n, A.quad(U32.to_nat(i))), hh1)
  %Equal.sym(Nat, U32.to_nat(k), 1n+U32.to_nat(i), ek1) : {List.length(&2, U32, Pair.snd(B.Buf, +List<U32>, B.emit_go(_, i, n, [], B.word(B.Buf{ws, n}, i)))) == U32.to_nat(n) : Nat}
  topw(U32.to_nat(i), i, n, B.word(B.Buf{ws, n}, i), d, {==}, hd, hp, hq, s4, hlo, hhi)

# ---- one Bool for the four side conditions, so a caller evaluates the size once ----
def okb(+a: Bool, +b: Bool) -> Bool:
  match a:
    case True{}: b
    case False{}: False{}

def okb_a(+a: Bool, +b: Bool, +h: {okb(a, b) == True{} : Bool}) -> {a == True{} : Bool}:
  match a:
    case True{}: {==}
    case False{}: Empty.absurd({False{} == True{} : Bool}, F.logic__false_true(h))

def okb_b(+a: Bool, +b: Bool, +h: {okb(a, b) == True{} : Bool}) -> {b == True{} : Bool}:
  match a:
    case True{}: h
    case False{}: Empty.absurd({b == True{} : Bool}, F.logic__false_true(h))

def obl_ok(+n: U32) -> Bool:
  okb(U32.is_lt(U32.shrn((n + 3 : U32), 2n), F.u32__pow2u(29n)),
    okb(U32.is_le(1, U32.shrn((n + 3 : U32), 2n)),
      okb(U32.is_lt((4 * (((0 + U32.shrn((n + 3 : U32), 2n) : U32) - 1 : U32)) : U32), n),
        U32.is_le(n, (4 * U32.shrn((n + 3 : U32), 2n) : U32)))))

def obl_ws(ws: Array<U32>, +n: U32, +hc: {obl_ok(n) == True{} : Bool}) -> {List.length(&2, U32, E.obytes(B.Buf{ws, n})) == U32.to_nat(n) : Nat}:
  +r1 = okb_b(U32.is_lt(U32.shrn((n + 3 : U32), 2n), F.u32__pow2u(29n)), okb(U32.is_le(1, U32.shrn((n + 3 : U32), 2n)), okb(U32.is_lt((4 * (((0 + U32.shrn((n + 3 : U32), 2n) : U32) - 1 : U32)) : U32), n), U32.is_le(n, (4 * U32.shrn((n + 3 : U32), 2n) : U32)))), hc)
  +r2 = okb_b(U32.is_le(1, U32.shrn((n + 3 : U32), 2n)), okb(U32.is_lt((4 * (((0 + U32.shrn((n + 3 : U32), 2n) : U32) - 1 : U32)) : U32), n), U32.is_le(n, (4 * U32.shrn((n + 3 : U32), 2n) : U32))), r1)
  obl(ws, n, 29n, {==},
    okb_a(U32.is_lt(U32.shrn((n + 3 : U32), 2n), F.u32__pow2u(29n)), okb(U32.is_le(1, U32.shrn((n + 3 : U32), 2n)), okb(U32.is_lt((4 * (((0 + U32.shrn((n + 3 : U32), 2n) : U32) - 1 : U32)) : U32), n), U32.is_le(n, (4 * U32.shrn((n + 3 : U32), 2n) : U32)))), hc),
    okb_a(U32.is_le(1, U32.shrn((n + 3 : U32), 2n)), okb(U32.is_lt((4 * (((0 + U32.shrn((n + 3 : U32), 2n) : U32) - 1 : U32)) : U32), n), U32.is_le(n, (4 * U32.shrn((n + 3 : U32), 2n) : U32))), r1),
    okb_a(U32.is_lt((4 * (((0 + U32.shrn((n + 3 : U32), 2n) : U32) - 1 : U32)) : U32), n), U32.is_le(n, (4 * U32.shrn((n + 3 : U32), 2n) : U32)), r2),
    okb_b(U32.is_lt((4 * (((0 + U32.shrn((n + 3 : U32), 2n) : U32) - 1 : U32)) : U32), n), U32.is_le(n, (4 * U32.shrn((n + 3 : U32), 2n) : U32)), r2))

# length(E.obytes(buf)) == to_nat(size(buf)) for every buffer whose size passes obl_ok
def obl_buf(buf: B.Buf, +hc: {obl_ok(Pair.snd(B.Buf, U32, B.size(buf))) == True{} : Bool}) -> {List.length(&2, U32, E.obytes(buf)) == U32.to_nat(Pair.snd(B.Buf, U32, B.size(buf))) : Nat}:
  match buf:
    case B.Buf{ws, +n}: obl_ws(ws, n, hc)
