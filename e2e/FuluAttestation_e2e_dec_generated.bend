def d_none(+bs: +List<U32>, +n: U32, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +hd: {SP.bytes_domain(bs) == True{} : Bool}, +hS: {Nat.is_le(U32.to_nat(n), A.quad(FD.spec_common__pow2(27n))) == True{} : Bool}, +hchk: {DC.CHK(TT(bs, n), n) == False{} : Bool}) -> {Pair.snd(B.Buf, Maybe<&1, FuluAttestation_d.Attestation>, FuluAttestation_r.Attestation_decode(B.fill_at(B.alloc(n), 0, bs), n)) == None{} : Maybe<&1, FuluAttestation_d.Attestation>}:
  %Equal.sym(B.Buf, B.fill_at(B.alloc(n), 0, bs), DC.BF(TT(bs, n), n), ld(bs, n, hn, hd, hS)) : {Pair.snd(B.Buf, Maybe<&1, FuluAttestation_d.Attestation>, FuluAttestation_r.Attestation_decode(_, n)) == None{} : Maybe<&1, FuluAttestation_d.Attestation>}
  Equal.cong(B.Buf & Maybe<&1, FuluAttestation_d.Attestation>, Maybe<&1, FuluAttestation_d.Attestation>, q => Pair.snd(B.Buf, Maybe<&1, FuluAttestation_d.Attestation>, q), FuluAttestation_r.Attestation_decode(DC.BF(TT(bs, n), n), n), (DC.BF(TT(bs, n), n), None{}),
    DC.decode_none(B.capacity(n), TT(bs, n), n, pfe(bs, n), FD.nat__le_lt_trans(B.capacity(n), 27n, 28n, C.cap_le(n, 27n, {==}, hS), {==}), C.cap_q(n, 27n, {==}, hS), hchk))

def s_dec(+bs: +List<U32>, +n: U32, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +hd: {SP.bytes_domain(bs) == True{} : Bool}, +hS: {Nat.is_le(U32.to_nat(n), A.quad(FD.spec_common__pow2(27n))) == True{} : Bool}, +hchk: {DC.CHK(TT(bs, n), n) == True{} : Bool}) -> Decoding.decodes(Spec.Attestation(), bs, DC.VAL(TT(bs, n), n)):
  %vwe(bs, n, hn, hd, hS) : Decoding.decodes(Spec.Attestation(), _, DC.VAL(TT(bs, n), n))
  DC.decode_spec(B.capacity(n), TT(bs, n), n, pfe(bs, n), FD.nat__le_lt_trans(B.capacity(n), 27n, 28n, C.cap_le(n, 27n, {==}, hS), {==}), C.cap_q(n, 27n, {==}, hS), hchk)

def s_out(+bs: +List<U32>, +n: U32, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +hd: {SP.bytes_domain(bs) == True{} : Bool}, +hS: {Nat.is_le(U32.to_nat(n), A.quad(FD.spec_common__pow2(27n))) == True{} : Bool}, +hchk: {DC.CHK(TT(bs, n), n) == False{} : Bool}) -> Decoding.outside_image(Spec.Attestation(), bs):
  %vwe(bs, n, hn, hd, hS) : Decoding.outside_image(Spec.Attestation(), _)
  DR.decode_reject(B.capacity(n), TT(bs, n), n, pfe(bs, n), FD.nat__le_lt_trans(B.capacity(n), 27n, 28n, C.cap_le(n, 27n, {==}, hS), {==}), C.cap_q(n, 27n, {==}, hS), hchk)

def a_acc(+bs: +List<U32>, +n: U32, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +hd: {SP.bytes_domain(bs) == True{} : Bool}, +hS: {Nat.is_le(U32.to_nat(n), A.quad(FD.spec_common__pow2(27n))) == True{} : Bool}, +hchk: {DC.CHK(TT(bs, n), n) == True{} : Bool}) -> {API.deserialize(Spec.Attestation(), bs) == Some{DC.VAL(TT(bs, n), n)} : Maybe<&2, S.Value>}:
  E2E.spec_accepted(Spec.Attestation(), bs, DC.VAL(TT(bs, n), n), (TVS.public_sound(Spec.Attestation(), {==}), s_dec(bs, n, hn, hd, hS, hchk)))

def a_none(+bs: +List<U32>, +n: U32, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +hd: {SP.bytes_domain(bs) == True{} : Bool}, +hS: {Nat.is_le(U32.to_nat(n), A.quad(FD.spec_common__pow2(27n))) == True{} : Bool}, +hchk: {DC.CHK(TT(bs, n), n) == False{} : Bool}) -> {API.deserialize(Spec.Attestation(), bs) == None{} : Maybe<&2, S.Value>}:
  E.outside_none(Spec.Attestation(), bs, s_out(bs, n, hn, hd, hS, hchk))

# ---- (ii) on views, (iii) ----

def mv(m: Maybe<&1, FuluAttestation_d.Attestation>) -> Maybe<&2, S.Value>:
  match m:
    case None{}: None{}
    case Some{o}: Some{RT.v_Attestation(o)}

def d_v(+bs: +List<U32>, +n: U32, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +hd: {SP.bytes_domain(bs) == True{} : Bool}, +hS: {Nat.is_le(U32.to_nat(n), A.quad(FD.spec_common__pow2(27n))) == True{} : Bool}, +c: Bool, +ec: {DC.CHK(TT(bs, n), n) == c : Bool}) -> {mv(Pair.snd(B.Buf, Maybe<&1, FuluAttestation_d.Attestation>, FuluAttestation_r.Attestation_decode(B.fill_at(B.alloc(n), 0, bs), n))) == API.deserialize(Spec.Attestation(), bs) : Maybe<&2, S.Value>}:
  match c:
    case False{}:
      %Equal.sym(Maybe<&1, FuluAttestation_d.Attestation>, Pair.snd(B.Buf, Maybe<&1, FuluAttestation_d.Attestation>, FuluAttestation_r.Attestation_decode(B.fill_at(B.alloc(n), 0, bs), n)), None{}, d_none(bs, n, hn, hd, hS, ec)) : {mv(_) == API.deserialize(Spec.Attestation(), bs) : Maybe<&2, S.Value>}
      %Equal.sym(Maybe<&2, S.Value>, API.deserialize(Spec.Attestation(), bs), None{}, a_none(bs, n, hn, hd, hS, ec)) : {mv(None{}) == _ : Maybe<&2, S.Value>}
      {==}
    case True{}:
      %Equal.sym(Maybe<&1, FuluAttestation_d.Attestation>, Pair.snd(B.Buf, Maybe<&1, FuluAttestation_d.Attestation>, FuluAttestation_r.Attestation_decode(B.fill_at(B.alloc(n), 0, bs), n)), Some{DC.OBJ(TT(bs, n), n)}, d_acc(bs, n, hn, hd, hS, ec)) : {mv(_) == API.deserialize(Spec.Attestation(), bs) : Maybe<&2, S.Value>}
      %Equal.sym(Maybe<&2, S.Value>, API.deserialize(Spec.Attestation(), bs), Some{DC.VAL(TT(bs, n), n)}, a_acc(bs, n, hn, hd, hS, ec)) : {mv(Some{DC.OBJ(TT(bs, n), n)}) == _ : Maybe<&2, S.Value>}
      Equal.cong(S.Value, Maybe<&2, S.Value>, z => Some{z}, RT.v_Attestation(DC.OBJ(TT(bs, n), n)), DC.VAL(TT(bs, n), n), vv(B.capacity(n), TT(bs, n), n, pfe(bs, n), FD.nat__le_lt_trans(B.capacity(n), 27n, 28n, C.cap_le(n, 27n, {==}, hS), {==}), C.cap_q(n, 27n, {==}, hS), ec))

def d_ra(+bs: +List<U32>, +n: U32, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +hd: {SP.bytes_domain(bs) == True{} : Bool}, +hS: {Nat.is_le(U32.to_nat(n), A.quad(FD.spec_common__pow2(27n))) == True{} : Bool}, +c: Bool, +ec: {DC.CHK(TT(bs, n), n) == c : Bool}, +dn: {Pair.snd(B.Buf, Maybe<&1, FuluAttestation_d.Attestation>, FuluAttestation_r.Attestation_decode(B.fill_at(B.alloc(n), 0, bs), n)) == None{} : Maybe<&1, FuluAttestation_d.Attestation>}) -> {API.deserialize(Spec.Attestation(), bs) == None{} : Maybe<&2, S.Value>}:
  match c:
    case False{}: a_none(bs, n, hn, hd, hS, ec)
    case True{}: Empty.absurd({API.deserialize(Spec.Attestation(), bs) == None{} : Maybe<&2, S.Value>}, E.none_someT(FuluAttestation_d.Attestation, DC.OBJ(TT(bs, n), n), Equal.trans(Maybe<&1, FuluAttestation_d.Attestation>, None{}, Pair.snd(B.Buf, Maybe<&1, FuluAttestation_d.Attestation>, FuluAttestation_r.Attestation_decode(B.fill_at(B.alloc(n), 0, bs), n)), Some{DC.OBJ(TT(bs, n), n)}, Equal.sym(Maybe<&1, FuluAttestation_d.Attestation>, Pair.snd(B.Buf, Maybe<&1, FuluAttestation_d.Attestation>, FuluAttestation_r.Attestation_decode(B.fill_at(B.alloc(n), 0, bs), n)), None{}, dn), d_acc(bs, n, hn, hd, hS, ec))))

def d_rb(+bs: +List<U32>, +n: U32, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +hd: {SP.bytes_domain(bs) == True{} : Bool}, +hS: {Nat.is_le(U32.to_nat(n), A.quad(FD.spec_common__pow2(27n))) == True{} : Bool}, +c: Bool, +ec: {DC.CHK(TT(bs, n), n) == c : Bool}, +an: {API.deserialize(Spec.Attestation(), bs) == None{} : Maybe<&2, S.Value>}) -> {Pair.snd(B.Buf, Maybe<&1, FuluAttestation_d.Attestation>, FuluAttestation_r.Attestation_decode(B.fill_at(B.alloc(n), 0, bs), n)) == None{} : Maybe<&1, FuluAttestation_d.Attestation>}:
  match c:
    case False{}: d_none(bs, n, hn, hd, hS, ec)
    case True{}: Empty.absurd({Pair.snd(B.Buf, Maybe<&1, FuluAttestation_d.Attestation>, FuluAttestation_r.Attestation_decode(B.fill_at(B.alloc(n), 0, bs), n)) == None{} : Maybe<&1, FuluAttestation_d.Attestation>}, FD.logic__none_some(S.Value, DC.VAL(TT(bs, n), n), Equal.trans(Maybe<&2, S.Value>, None{}, API.deserialize(Spec.Attestation(), bs), Some{DC.VAL(TT(bs, n), n)}, Equal.sym(Maybe<&2, S.Value>, API.deserialize(Spec.Attestation(), bs), None{}, an), a_acc(bs, n, hn, hd, hS, ec))))

# (ii), on views: the view of the object the decoder returns is END_TO_END's deserialize.
def FuluAttestation_e2e_decode_view(+bs: +List<U32>, +n: U32, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +hd: {SP.bytes_domain(bs) == True{} : Bool}, +hS: {Nat.is_le(U32.to_nat(n), A.quad(FD.spec_common__pow2(27n))) == True{} : Bool}) -> {mv(Pair.snd(B.Buf, Maybe<&1, FuluAttestation_d.Attestation>, FuluAttestation_r.Attestation_decode(B.fill_at(B.alloc(n), 0, bs), n))) == API.deserialize(Spec.Attestation(), bs) : Maybe<&2, S.Value>}:
  d_v(bs, n, hn, hd, hS, DC.CHK(TT(bs, n), n), {==})

# (iii) the object decoder fails exactly when END_TO_END's deserialize does.
def FuluAttestation_e2e_decode_reject(+bs: +List<U32>, +n: U32, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +hd: {SP.bytes_domain(bs) == True{} : Bool}, +hS: {Nat.is_le(U32.to_nat(n), A.quad(FD.spec_common__pow2(27n))) == True{} : Bool})
    -> ({Pair.snd(B.Buf, Maybe<&1, FuluAttestation_d.Attestation>, FuluAttestation_r.Attestation_decode(B.fill_at(B.alloc(n), 0, bs), n)) == None{} : Maybe<&1, FuluAttestation_d.Attestation>} -> {API.deserialize(Spec.Attestation(), bs) == None{} : Maybe<&2, S.Value>}) & ({API.deserialize(Spec.Attestation(), bs) == None{} : Maybe<&2, S.Value>} -> {Pair.snd(B.Buf, Maybe<&1, FuluAttestation_d.Attestation>, FuluAttestation_r.Attestation_decode(B.fill_at(B.alloc(n), 0, bs), n)) == None{} : Maybe<&1, FuluAttestation_d.Attestation>}):
  (dn => d_ra(bs, n, hn, hd, hS, DC.CHK(TT(bs, n), n), {==}, dn), an => d_rb(bs, n, hn, hd, hS, DC.CHK(TT(bs, n), n), {==}, an))
