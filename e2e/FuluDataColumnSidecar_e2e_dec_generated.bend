# ---- (ii) on views, (iii) ----

def mv(m: Maybe<&1, FuluDataColumnSidecar_d.DataColumnSidecar>) -> Maybe<&2, S.Value>:
  match m:
    case None{}: None{}
    case Some{o}: Some{RT.v_DataColumnSidecar(o)}

