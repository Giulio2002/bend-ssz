def vwe(+bs: +List<U32>, +n: U32, +hn: {List.length(&2, U32, bs) == U32.to_nat(n) : Nat}, +hd: {SP.bytes_domain(bs) == True{} : Bool}, +hS: {Nat.is_le(U32.to_nat(n), A.quad(FD.spec_common__pow2(22n))) == True{} : Bool}) -> {DC.VW(TT(bs, n), n) == bs : +List<U32>}:
  L.vw(bs, n, B.capacity(n), hd, hn, C.cap_w(bs, n, 22n, hn, {==}, hS))

def pfe(+bs: +List<U32>, +n: U32) -> {FD.array__perfect(U32, B.capacity(n), TT(bs, n)) == True{} : Bool}: L.seg_pf(B.capacity(n), L.wlp(bs))

