# ---- a total size with a 2^29 + 1 term (a progressive bit list's bound): below 2^31, never walked in unary ----
# c + a < c + b from a < b, by c's structure
def lt_addl(+c: Nat, +a: Nat, +b: Nat, +h: {Nat.is_lt(a, b) == True{} : Bool}) -> {Nat.is_lt(Nat.add(c, a), Nat.add(c, b)) == True{} : Bool}:
  match c:
    case 0n: h
    case 1n+p: lt_addl(p, a, b, h)

# (u + q) + x == (u + x) + q
def swapq(+u: Nat, +q: Nat, +x: Nat) -> {Nat.add(Nat.add(u, q), x) == Nat.add(Nat.add(u, x), q) : Nat}:
  Equal.trans(Nat, Nat.add(Nat.add(u, q), x), Nat.add(u, Nat.add(q, x)), Nat.add(Nat.add(u, x), q), FD.nat__add_assoc(u, q, x),
    Equal.trans(Nat, Nat.add(u, Nat.add(q, x)), Nat.add(u, Nat.add(x, q)), Nat.add(Nat.add(u, x), q),
      Equal.cong(Nat, Nat, z => Nat.add(u, z), Nat.add(q, x), Nat.add(x, q), FD.nat__add_comm(q, x)),
      Equal.sym(Nat, Nat.add(Nat.add(u, x), q), Nat.add(u, Nat.add(x, q)), FD.nat__add_assoc(u, x, q))))

# R + (P + 1) < 4 P when R + 1 < P (P symbolic)
def totP(+R: Nat, +P: Nat, +h: {Nat.is_lt(Nat.add(R, 1n), P) == True{} : Bool})
    -> {Nat.is_lt(Nat.add(R, Nat.add(P, 1n)), Nat.double(Nat.double(P))) == True{} : Bool}:
  +t = Nat.add(R, Nat.add(P, 1n))
  +e1 = Equal.trans(Nat, t, Nat.add(Nat.add(R, P), 1n), Nat.add(P, Nat.add(R, 1n)),
    Equal.sym(Nat, Nat.add(Nat.add(R, P), 1n), t, FD.nat__add_assoc(R, P, 1n)),
    Equal.trans(Nat, Nat.add(Nat.add(R, P), 1n), Nat.add(Nat.add(P, R), 1n), Nat.add(P, Nat.add(R, 1n)),
      Equal.cong(Nat, Nat, z => Nat.add(z, 1n), Nat.add(R, P), Nat.add(P, R), FD.nat__add_comm(R, P)),
      FD.nat__add_assoc(P, R, 1n)))
  +l1 = lt_addl(P, Nat.add(R, 1n), P, h)
  +l2 = FD.logic__subst(Nat, z => {Nat.is_lt(z, Nat.add(P, P)) == True{} : Bool}, Nat.add(P, Nat.add(R, 1n)), t, Equal.sym(Nat, t, Nat.add(P, Nat.add(R, 1n)), e1), l1)
  +l3 = FD.logic__subst(Nat, z => {Nat.is_lt(t, z) == True{} : Bool}, Nat.add(P, P), Nat.double(P), Equal.sym(Nat, Nat.double(P), Nat.add(P, P), FD.lru_nat_algebra__double_self(P)), l2)
  FD.nat__lt_le_trans(t, Nat.double(P), Nat.double(Nat.double(P)), l3, FD.nat__double_self_le(Nat.double(P)))

# the same at P = 2^29, the bound 2^31 written as the spec's power
def tot29(+R: Nat, +q: Nat, +hq: {q == Nat.add(VB.pw(29n), 1n) : Nat}, +h: {Nat.is_lt(Nat.add(R, 1n), VB.pw(29n)) == True{} : Bool})
    -> {Nat.is_lt(Nat.add(R, q), VB.pw(31n)) == True{} : Bool}:
  %Equal.sym(Nat, q, Nat.add(VB.pw(29n), 1n), hq) : {Nat.is_lt(Nat.add(R, _), VB.pw(31n)) == True{} : Bool}
  totP(R, VB.pw(29n), h)

# 2x + 2k = 2(x + k), by x's structure (a big sum rewritten into doublings the checker compares level by level)
def dadd2(+x: Nat, +k: Nat) -> {Nat.add(Nat.double(x), Nat.double(k)) == Nat.double(Nat.add(x, k)) : Nat}:
  match x:
    case 0n: {==}
    case 1n+p: Equal.cong(Nat, Nat, z => 2n+z, Nat.add(Nat.double(p), Nat.double(k)), Nat.double(Nat.add(p, k)), dadd2(p, k))

# dadd2 with the doubled constant a literal (k2), so a caller's sum is compared syntactically, never evaluated
def daddk(+x: Nat, +k: Nat, +k2: Nat, +hk: {Nat.double(k) == k2 : Nat}) -> {Nat.add(Nat.double(x), k2) == Nat.double(Nat.add(x, k)) : Nat}:
  %hk : {Nat.add(Nat.double(x), _) == Nat.double(Nat.add(x, k)) : Nat}
  dadd2(x, k)

