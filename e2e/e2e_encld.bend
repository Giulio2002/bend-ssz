# ---- record lists: shared ----
# r bytes per record, r <= 4: x records within 4 x bytes
def mq(+x: Nat, +r: Nat, +hr: {Nat.is_le(r, 4n) == True{} : Bool}) -> {Nat.is_le(Nat.mul(x, r), A.quad(x)) == True{} : Bool}:
