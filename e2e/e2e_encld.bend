  +hs2 = FD.logic__subst(O.Words, z => BL.sdk(z, 31n), w, O.Words{FD.array__thaw(U32, tt), n}, ew, hs)
  +eN2 = FD.logic__subst(O.Words, z => {U32.to_nat(WO.len(z)) == O.e8(UL.ucnt(z)) : Nat}, w, O.Words{FD.array__thaw(U32, tt), n}, ew, eN)
