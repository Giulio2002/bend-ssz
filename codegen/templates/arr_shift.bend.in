    case Nil{} _: {==}
    case Con{h, t} 0n:
      match p:
        case 0n: {==}
        case 1n+q: Equal.sym(List<&2, U32>, dp(t, Nat.add(q, 0n)), dp(t, q), Equal.cong(Nat, List<&2, U32>, z => dp(t, z), Nat.add(q, 0n), q, F.nat__add_zero(q)))
    case Con{h, +t} 1n+ +b:
      %Equal.sym(Nat, Nat.add(p, 1n+b), 1n+Nat.add(p, b), F.nat__add_succ(p, b)) : {dp(dp(t, b), p) == dp(Con{h, t}, _) : List<&2, U32>}
      drop_drop(t, b, p)

law head_drop:
  for +xs: List<&2, U32>
  for +a: Nat
  {R.head0(dp(xs, a)) == F.flat__nthc(xs, a) : U32}
