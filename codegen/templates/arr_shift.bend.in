# ---- list facts with closed counts supplied as Bool facts ---------------------------------

def take_split_lit(+xs: List<&2, U32>, +r: Nat, +l: Nat, +m: Nat, +h: {Nat.is_le(l, r) == True{} : Bool},
    +hm: {Nat.is_eq(Nat.sub(r, l), m) == True{} : Bool})
    -> {tk(xs, r) == F.spec_common__append(U32, tk(xs, l), tk(dp(xs, l), m)) : List<&2, U32>}:
  %F.nat__eq_from_is_eq(Nat.sub(r, l), m, hm) :
    {tk(xs, r) == F.spec_common__append(U32, tk(xs, l), tk(dp(xs, l), _)) : List<&2, U32>}
  F.list__sc_take_split(U32, xs, l, r, h)

def drop_drop_lit(+xs: List<&2, U32>, +a: Nat, +p: Nat, +c: Nat, +h: {Nat.is_eq(Nat.add(p, a), c) == True{} : Bool})
    -> {dp(dp(xs, a), p) == dp(xs, c) : List<&2, U32>}:
  %F.nat__eq_from_is_eq(Nat.add(p, a), c, h) : {dp(dp(xs, a), p) == dp(xs, _) : List<&2, U32>}
  drop_drop(xs, a, p)

law drop_app:
  for +xs: List<&2, U32>
  for +ys: List<&2, U32>
  for +n: Nat
  for +h: {Nat.is_le(F.spec_common__length(U32, xs), n) == True{} : Bool}
  {dp(F.spec_common__append(U32, xs, ys), n) == dp(ys, Nat.sub(n, F.spec_common__length(U32, xs))) : List<&2, U32>}
def drop_app(xs, ys, n, h):
  match xs n:
    case Nil{} 0n: {==}
    case Nil{} 1n+m: {==}
    case Con{x, t} 0n: Empty.absurd({dp(F.spec_common__append(U32, Con{x, t}, ys), 0n) == dp(ys, Nat.sub(0n, F.spec_common__length(U32, Con{x, t}))) : List<&2, U32>}, F.logic__false_true(h))
    case Con{x, +t} 1n+ +m: drop_app(t, ys, m, h)

def drop_app_lit(+xs: List<&2, U32>, +ys: List<&2, U32>, +n: Nat, +L: Nat, +m: Nat,
    +hl: {F.spec_common__length(U32, xs) == L : Nat}, +h: {Nat.is_le(L, n) == True{} : Bool},
    +hm: {Nat.is_eq(Nat.sub(n, L), m) == True{} : Bool})
    -> {dp(F.spec_common__append(U32, xs, ys), n) == dp(ys, m) : List<&2, U32>}:
  +h2 = F.logic__subst(Nat, z => {Nat.is_le(z, n) == True{} : Bool}, L, F.spec_common__length(U32, xs), Equal.sym(Nat, F.spec_common__length(U32, xs), L, hl), h)
  %F.nat__eq_from_is_eq(Nat.sub(n, L), m, hm) : {dp(F.spec_common__append(U32, xs, ys), n) == dp(ys, _) : List<&2, U32>}
  %hl : {dp(F.spec_common__append(U32, xs, ys), n) == dp(ys, Nat.sub(n, _)) : List<&2, U32>}
  drop_app(xs, ys, n, h2)

# P + (a + Q) = C from a = A and a closed fact about P, A, Q, C.
def add_mid(+a: Nat, +A: Nat, +P: Nat, +Q: Nat, +C: Nat, +ea: {a == A : Nat},
    +h: {Nat.is_eq(Nat.add(P, Nat.add(A, Q)), C) == True{} : Bool}) -> {Nat.add(P, Nat.add(a, Q)) == C : Nat}:
  %Equal.sym(Nat, a, A, ea) : {Nat.add(P, Nat.add(_, Q)) == C : Nat}
  F.nat__eq_from_is_eq(Nat.add(P, Nat.add(A, Q)), C, h)

law len_drop:
  for +xs: List<&2, U32>
  for +n: Nat
  {F.spec_common__length(U32, dp(xs, n)) == Nat.sub(F.spec_common__length(U32, xs), n) : Nat}
def len_drop(xs, n):
  match xs n:
    case Nil{} 0n: {==}
    case Nil{} 1n+m: {==}
    case Con{x, t} 0n: {==}
    case Con{x, +t} 1n+ +m: len_drop(t, m)

# |take(drop(xs, a), K)| = K for |xs| = L and a + K <= L (closed facts)
def len_seg(+xs: List<&2, U32>, +a: Nat, +K: Nat, +L: Nat, +hl: {F.spec_common__length(U32, xs) == L : Nat},
    +h: {Nat.is_le(K, Nat.sub(L, a)) == True{} : Bool}) -> {F.spec_common__length(U32, tk(dp(xs, a), K)) == K : Nat}:
  +e = Equal.trans(Nat, F.spec_common__length(U32, dp(xs, a)), Nat.sub(F.spec_common__length(U32, xs), a), Nat.sub(L, a), len_drop(xs, a),
    Equal.cong(Nat, Nat, z => Nat.sub(z, a), F.spec_common__length(U32, xs), L, hl))
  F.list__sc_length_take(U32, dp(xs, a), K, F.logic__subst(Nat, z => {Nat.is_le(K, z) == True{} : Bool}, Nat.sub(L, a), F.spec_common__length(U32, dp(xs, a)), Equal.sym(Nat, F.spec_common__length(U32, dp(xs, a)), Nat.sub(L, a), e), h))

# The first two words of a list of at least two.
def tk2(+xs: List<&2, U32>, +h: {Nat.is_le(2n, F.spec_common__length(U32, xs)) == True{} : Bool})
    -> {tk(xs, 2n) == [F.flat__nthc(xs, 0n), F.flat__nthc(xs, 1n)] : List<&2, U32>}:
  match xs:
    case Nil{}: Empty.absurd({tk(Nil{}, 2n) == [F.flat__nthc(Nil{}, 0n), F.flat__nthc(Nil{}, 1n)] : List<&2, U32>}, F.logic__false_true(h))
    case Con{+a, r}:
      match r:
        case Nil{}: Empty.absurd({tk([a], 2n) == [a, F.flat__nthc([a], 1n)] : List<&2, U32>}, F.logic__false_true(h))
        case Con{+b, +t}: F.list__cons_cong(U32, a, F.spec_common__take(U32, Con{b, t}, 1n), [b], F.list__cons_cong(U32, b, F.spec_common__take(U32, t, 0n), Nil{}, F.list__sc_take_zero(U32, t)))
