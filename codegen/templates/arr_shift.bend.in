# The canonical tree of xs, waiting on a free tree T.
def bq(+p: Nat, +xs: List<&2, U32>, T: F.array__Tree<U32>) -> F.array__Tree<U32>:
  match T:
    case F.TLeaf{x}: R.build(p, xs)
    case F.TNode{l, r}: R.build(p, xs)

law bq_build:
  for +p: Nat
  for +xs: List<&2, U32>
  for +T: F.array__Tree<U32>
  {bq(p, xs, T) == R.build(p, xs) : F.array__Tree<U32>}
def bq_build(p, xs, T):
  match T:
    case F.TLeaf{x}: {==}
    case F.TNode{l, r}: {==}

