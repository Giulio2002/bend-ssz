def dp(+xs: List<&2, U32>, +n: Nat) -> List<&2, U32>: F.spec_common__drop(U32, xs, n)

law drop_drop:
  for +xs: List<&2, U32>
  for +a: Nat
  for +p: Nat
  {dp(dp(xs, a), p) == dp(xs, Nat.add(p, a)) : List<&2, U32>}
