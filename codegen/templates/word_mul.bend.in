# GENERATED by spec_laws (codegen: from word_mul.bend.in). Do not edit.
#
# U32.mul(w, 256) == U32.shln(w, 8n) for every word w. U32.mul recurses over its
# LEFT operand's bits, so for a symbolic w it does not reduce (byte_arithmetic
# proves the law with 256 on the left only). Here: the product accumulated from
# acc is acc plus the product from zero (mul_acc); doubling the right operand
# doubles the product (mul_shl); multiplying by one is the identity (mul_one, by
# induction on the width through `init`, the word without its top bit); and 256
# is one shifted 8 times.

def one(+n: Nat) -> Word(n):
  match n:
    case 0n: WNil{}
    case 1n+ +p: WCon{True{}, Word.zero(p)}

# the word without its top bit
def init(+n: Nat, w: Word(1n+n)) -> Word(n):
  match n:
    case 0n: WNil{}
    case 1n+ +p:
      match w:
        case WCon{b, t}: WCon{b, init(p, t)}

def add_zero_r(+n: Nat, +a: Word(n)) -> {Word.add(n, a, Word.zero(n)) == a : Word(n)}:
  Equal.trans(Word(n), Word.add(n, a, Word.zero(n)), Word.add(n, Word.zero(n), a), a, Word.add_comm(n, a, Word.zero(n)), F.u32alg__w_zero_add(n, a))

# (a + b) + (c + d) == (a + c) + (b + d)
def add4(+n: Nat, +a: Word(n), +b: Word(n), +c: Word(n), +d: Word(n))
    -> {Word.add(n, Word.add(n, a, b), Word.add(n, c, d)) == Word.add(n, Word.add(n, a, c), Word.add(n, b, d)) : Word(n)}:
  %Equal.sym(Word(n), Word.add(n, Word.add(n, a, b), Word.add(n, c, d)), Word.add(n, a, Word.add(n, b, Word.add(n, c, d))), F.u32alg__w_assoc(n, a, b, Word.add(n, c, d))) :
    {_ == Word.add(n, Word.add(n, a, c), Word.add(n, b, d)) : Word(n)}
  %Equal.sym(Word(n), Word.add(n, Word.add(n, a, c), Word.add(n, b, d)), Word.add(n, a, Word.add(n, c, Word.add(n, b, d))), F.u32alg__w_assoc(n, a, c, Word.add(n, b, d))) :
    {Word.add(n, a, Word.add(n, b, Word.add(n, c, d))) == _ : Word(n)}
  %F.u32alg__w_assoc(n, b, c, d) : {Word.add(n, a, _) == Word.add(n, a, Word.add(n, c, Word.add(n, b, d))) : Word(n)}
  %F.u32alg__w_assoc(n, c, b, d) : {Word.add(n, a, Word.add(n, Word.add(n, b, c), d)) == Word.add(n, a, _) : Word(n)}
  %Word.add_comm(n, c, b) : {Word.add(n, a, Word.add(n, _, d)) == Word.add(n, a, Word.add(n, Word.add(n, c, b), d)) : Word(n)}
  {==}

law put_zero:
  for +p: Nat
  {Word.shl.put(p, False{}, Word.zero(p)) == Word.zero(p) : Word(p)}
def put_zero(p):
  match p:
    case 0n: {==}
    case 1n+ +q: Equal.cong(Word(q), Word(1n+q), w => WCon{False{}, w}, Word.shl.put(q, False{}, Word.zero(q)), Word.zero(q), put_zero(q))

def shl_zero(+n: Nat) -> {Word.shl(n, Word.zero(n)) == Word.zero(n) : Word(n)}:
  match n:
    case 0n: {==}
    case 1n+ +p: Equal.cong(Word(p), Word(1n+p), w => WCon{False{}, w}, Word.shl.put(p, False{}, Word.zero(p)), Word.zero(p), put_zero(p))

law mul_acc:
  for +n: Nat
  for +m: Nat
  for +a: Word(m)
  for +b: Word(n)
  for +acc: Word(n)
  {Word.mul.go(n, m, a, b, acc) == Word.add(n, acc, Word.mul.go(n, m, a, b, Word.zero(n))) : Word(n)}
def mul_acc(n, m, a, b, acc):
