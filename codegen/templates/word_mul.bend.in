          %Equal.sym(Word(n), Word.mul.go(n, mp, at, sb, Word.add(n, z, b)), Word.add(n, Word.add(n, z, b), H), mul_acc(n, mp, at, sb, Word.add(n, z, b))) :
            {Word.add(n, Word.add(n, z, sb), K) == Word.shl(n, _) : Word(n)}
