    case 0n: Equal.sym(Word(n), Word.add(n, acc, Word.zero(n)), acc, add_zero_r(n, acc))
    case 1n+ +mp:
      match a:
        case WCon{False{}, +at}: mul_acc(n, mp, at, Word.shl(n, b), acc)
        case WCon{True{}, +at}:
          +sb = Word.shl(n, b)
          +G = Word.mul.go(n, mp, at, sb, Word.zero(n))
          %Equal.sym(Word(n), Word.mul.go(n, mp, at, sb, Word.add(n, acc, b)), Word.add(n, Word.add(n, acc, b), G), mul_acc(n, mp, at, sb, Word.add(n, acc, b))) :
            {_ == Word.add(n, acc, Word.mul.go(n, mp, at, sb, Word.add(n, Word.zero(n), b))) : Word(n)}
          %Equal.sym(Word(n), Word.add(n, Word.zero(n), b), b, F.u32alg__w_zero_add(n, b)) :
            {Word.add(n, Word.add(n, acc, b), G) == Word.add(n, acc, Word.mul.go(n, mp, at, sb, _)) : Word(n)}
          %Equal.sym(Word(n), Word.mul.go(n, mp, at, sb, b), Word.add(n, b, G), mul_acc(n, mp, at, sb, b)) :
            {Word.add(n, Word.add(n, acc, b), G) == Word.add(n, acc, _) : Word(n)}
