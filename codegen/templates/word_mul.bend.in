# ---- the width induction ----

law init_put:
  for +p: Nat
  for +c: Bool
  for +t: Word(p)
  {Word.shl.put(p, c, t) == init(p, WCon{c, t}) : Word(p)}
def init_put(p, c, t):
  match p:
    case 0n:
      match t:
        case WNil{}: {==}
    case 1n+ +q:
      match t:
        case WCon{+b, +u}: Equal.cong(Word(q), Word(1n+q), w => WCon{c, w}, Word.shl.put(q, b, u), init(q, WCon{b, u}), init_put(q, b, u))

def shl_init(+p: Nat, +w: Word(1n+p)) -> {Word.shl(1n+p, w) == WCon{False{}, init(p, w)} : Word(1n+p)}:
  match w:
    case WCon{+b, +t}: Equal.cong(Word(p), Word(1n+p), v => WCon{False{}, v}, Word.shl.put(p, b, t), init(p, WCon{b, t}), init_put(p, b, t))

law init_put2:
  for +p: Nat
  for +c: Bool
  for +t: Word(1n+p)
  {init(p, Word.shl.put(1n+p, c, t)) == Word.shl.put(p, c, init(p, t)) : Word(p)}
def init_put2(p, c, t):
  match p:
    case 0n: {==}
    case 1n+ +q:
      match t:
        case WCon{+b, +u}: Equal.cong(Word(q), Word(1n+q), w => WCon{c, w}, init(q, Word.shl.put(1n+q, b, u)), Word.shl.put(q, b, init(q, u)), init_put2(q, b, u))

def init_shl(+n: Nat, +w: Word(1n+n)) -> {init(n, Word.shl(1n+n, w)) == Word.shl(n, init(n, w)) : Word(n)}:
  match n:
    case 0n: {==}
    case 1n+ +p:
      match w:
        case WCon{+b, +t}: Equal.cong(Word(p), Word(1n+p), v => WCon{False{}, v}, init(p, Word.shl.put(1n+p, b, t)), Word.shl.put(p, b, init(p, t)), init_put2(p, b, t))

law init_zero:
  for +n: Nat
  {init(n, Word.zero(1n+n)) == Word.zero(n) : Word(n)}
def init_zero(n):
  match n:
    case 0n: {==}
    case 1n+ +p: Equal.cong(Word(p), Word(1n+p), v => WCon{False{}, v}, init(p, Word.zero(1n+p)), Word.zero(p), init_zero(p))

def init_one(+n: Nat) -> {init(n, one(1n+n)) == one(n) : Word(n)}:
  match n:
    case 0n: {==}
    case 1n+ +p: Equal.cong(Word(p), Word(1n+p), v => WCon{True{}, v}, init(p, Word.zero(1n+p)), Word.zero(p), init_zero(p))

def init_con(+p: Nat, +at: Word(1n+p), +bt: Word(1n+p), sk: Bool & Bool,
    ih: @+k: Bool -> {init(p, Word.adc(1n+p, at, bt, False{}, k)) == Word.adc(p, init(p, at), init(p, bt), False{}, k) : Word(p)})
    -> {init(1n+p, Word.adc.con(1n+p, at, bt, False{}, sk)) == Word.adc.con(p, init(p, at), init(p, bt), False{}, sk) : Word(1n+p)}:
  match sk:
    case (+s, +k): Equal.cong(Word(p), Word(1n+p), v => WCon{s, v}, init(p, Word.adc(1n+p, at, bt, False{}, k)), Word.adc(p, init(p, at), init(p, bt), False{}, k), ih(k))

law init_adc:
  for +n: Nat
  for +a: Word(1n+n)
  for +b: Word(1n+n)
  for +c: Bool
  {init(n, Word.adc(1n+n, a, b, False{}, c)) == Word.adc(n, init(n, a), init(n, b), False{}, c) : Word(n)}
def init_adc(n, a, b, c):
  match n:
    case 0n: {==}
    case 1n+ +p:
      match a b:
        case WCon{+ab, +at} WCon{+bb, +bt}: init_con(p, at, bt, Bool.full_add(ab, bb, c), k => init_adc(p, at, bt, k))

law init_mul:
  for +n: Nat
  for +m: Nat
  for +a: Word(m)
  for +b: Word(1n+n)
  for +acc: Word(1n+n)
  {init(n, Word.mul.go(1n+n, m, a, b, acc)) == Word.mul.go(n, m, a, init(n, b), init(n, acc)) : Word(n)}
def init_mul(n, m, a, b, acc):
  match m:
    case 0n: {==}
    case 1n+ +mp:
      match a:
        case WCon{False{}, +at}:
          %Equal.sym(Word(n), init(n, Word.mul.go(1n+n, mp, at, Word.shl(1n+n, b), acc)), Word.mul.go(n, mp, at, init(n, Word.shl(1n+n, b)), init(n, acc)), init_mul(n, mp, at, Word.shl(1n+n, b), acc)) : {_ == Word.mul.go(n, mp, at, Word.shl(n, init(n, b)), init(n, acc)) : Word(n)}
          %Equal.sym(Word(n), init(n, Word.shl(1n+n, b)), Word.shl(n, init(n, b)), init_shl(n, b)) : {Word.mul.go(n, mp, at, _, init(n, acc)) == Word.mul.go(n, mp, at, Word.shl(n, init(n, b)), init(n, acc)) : Word(n)}
          {==}
        case WCon{True{}, +at}:
          %Equal.sym(Word(n), init(n, Word.mul.go(1n+n, mp, at, Word.shl(1n+n, b), Word.add(1n+n, acc, b))), Word.mul.go(n, mp, at, init(n, Word.shl(1n+n, b)), init(n, Word.add(1n+n, acc, b))), init_mul(n, mp, at, Word.shl(1n+n, b), Word.add(1n+n, acc, b))) :
            {_ == Word.mul.go(n, mp, at, Word.shl(n, init(n, b)), Word.add(n, init(n, acc), init(n, b))) : Word(n)}
          %Equal.sym(Word(n), init(n, Word.shl(1n+n, b)), Word.shl(n, init(n, b)), init_shl(n, b)) : {Word.mul.go(n, mp, at, _, init(n, Word.add(1n+n, acc, b))) == Word.mul.go(n, mp, at, Word.shl(n, init(n, b)), Word.add(n, init(n, acc), init(n, b))) : Word(n)}
          %Equal.sym(Word(n), init(n, Word.add(1n+n, acc, b)), Word.add(n, init(n, acc), init(n, b)), init_adc(n, acc, b, False{})) : {Word.mul.go(n, mp, at, Word.shl(n, init(n, b)), _) == Word.mul.go(n, mp, at, Word.shl(n, init(n, b)), Word.add(n, init(n, acc), init(n, b))) : Word(n)}
          {==}

law mul_one:
  for +n: Nat
  for +x: Word(n)
  {Word.mul.go(n, n, x, one(n), Word.zero(n)) == x : Word(n)}
def mul_one(n, x):
  match n:
    case 0n:
      match x:
        case WNil{}: {==}
    case 1n+ +p:
      match x:
        case WCon{False{}, +t}:
          +W = Word.mul.go(1n+p, p, t, one(1n+p), Word.zero(1n+p))
          %Equal.sym(Word(1n+p), Word.mul.go(1n+p, p, t, Word.shl(1n+p, one(1n+p)), Word.zero(1n+p)), Word.shl(1n+p, W), mul_shl(1n+p, p, t, one(1n+p))) :
            {_ == WCon{False{}, t} : Word(1n+p)}
          %Equal.sym(Word(1n+p), Word.shl(1n+p, W), WCon{False{}, init(p, W)}, shl_init(p, W)) : {_ == WCon{False{}, t} : Word(1n+p)}
          %Equal.sym(Word(p), init(p, W), Word.mul.go(p, p, t, init(p, one(1n+p)), init(p, Word.zero(1n+p))), init_mul(p, p, t, one(1n+p), Word.zero(1n+p))) :
            {WCon{False{}, _} == WCon{False{}, t} : Word(1n+p)}
          %Equal.sym(Word(p), init(p, one(1n+p)), one(p), init_one(p)) :
            {WCon{False{}, Word.mul.go(p, p, t, _, init(p, Word.zero(1n+p)))} == WCon{False{}, t} : Word(1n+p)}
          %Equal.sym(Word(p), init(p, Word.zero(1n+p)), Word.zero(p), init_zero(p)) :
            {WCon{False{}, Word.mul.go(p, p, t, one(p), _)} == WCon{False{}, t} : Word(1n+p)}
          Equal.cong(Word(p), Word(1n+p), v => WCon{False{}, v}, Word.mul.go(p, p, t, one(p), Word.zero(p)), t, mul_one(p, t))
        case WCon{True{}, +t}:
          +o = one(1n+p)
          +z = Word.zero(1n+p)
          +W = Word.mul.go(1n+p, p, t, o, z)
          %Equal.sym(Word(1n+p), Word.mul.go(1n+p, p, t, Word.shl(1n+p, o), Word.add(1n+p, z, o)), Word.add(1n+p, Word.add(1n+p, z, o), Word.mul.go(1n+p, p, t, Word.shl(1n+p, o), z)), mul_acc(1n+p, p, t, Word.shl(1n+p, o), Word.add(1n+p, z, o))) :
            {_ == WCon{True{}, t} : Word(1n+p)}
          %Equal.sym(Word(1n+p), Word.add(1n+p, z, o), o, F.u32alg__w_zero_add(1n+p, o)) :
            {Word.add(1n+p, _, Word.mul.go(1n+p, p, t, Word.shl(1n+p, o), z)) == WCon{True{}, t} : Word(1n+p)}
          %Equal.sym(Word(1n+p), Word.mul.go(1n+p, p, t, Word.shl(1n+p, o), z), Word.shl(1n+p, W), mul_shl(1n+p, p, t, o)) :
            {Word.add(1n+p, o, _) == WCon{True{}, t} : Word(1n+p)}
          %Equal.sym(Word(1n+p), Word.shl(1n+p, W), WCon{False{}, init(p, W)}, shl_init(p, W)) : {Word.add(1n+p, o, _) == WCon{True{}, t} : Word(1n+p)}
          %Equal.sym(Word(p), init(p, W), Word.mul.go(p, p, t, init(p, o), init(p, z)), init_mul(p, p, t, o, z)) :
            {Word.add(1n+p, o, WCon{False{}, _}) == WCon{True{}, t} : Word(1n+p)}
          %Equal.sym(Word(p), init(p, o), one(p), init_one(p)) :
            {Word.add(1n+p, o, WCon{False{}, Word.mul.go(p, p, t, _, init(p, z))}) == WCon{True{}, t} : Word(1n+p)}
          %Equal.sym(Word(p), init(p, z), Word.zero(p), init_zero(p)) :
            {Word.add(1n+p, o, WCon{False{}, Word.mul.go(p, p, t, one(p), _)}) == WCon{True{}, t} : Word(1n+p)}
          %Equal.sym(Word(p), Word.mul.go(p, p, t, one(p), Word.zero(p)), t, mul_one(p, t)) :
            {Word.add(1n+p, o, WCon{False{}, _}) == WCon{True{}, t} : Word(1n+p)}
          Equal.cong(Word(p), Word(1n+p), v => WCon{True{}, v}, Word.add(p, Word.zero(p), t), t, F.u32alg__w_zero_add(p, t))

# 256 * w == w << 8 with the word on the left, as the encoders write it
def mul256(+e: U32) -> {U32.mul(e, 256) == U32.shln(e, 8n) : U32}:
  match e:
    case U32{+x}:
      %Equal.sym(Word(32n), Word.mul.go(32n, 32n, x, Word.shl(32n, Word.shl(32n, Word.shl(32n, Word.shl(32n, Word.shl(32n, Word.shl(32n, Word.shl(32n, Word.shl(32n, one(32n))))))))), Word.zero(32n)), Word.shl(32n, Word.mul.go(32n, 32n, x, Word.shl(32n, Word.shl(32n, Word.shl(32n, Word.shl(32n, Word.shl(32n, Word.shl(32n, Word.shl(32n, one(32n)))))))), Word.zero(32n))), mul_shl(32n, 32n, x, Word.shl(32n, Word.shl(32n, Word.shl(32n, Word.shl(32n, Word.shl(32n, Word.shl(32n, Word.shl(32n, one(32n)))))))))) :
        {U32{_} == U32.shln(U32{x}, 8n) : U32}
      %Equal.sym(Word(32n), Word.mul.go(32n, 32n, x, Word.shl(32n, Word.shl(32n, Word.shl(32n, Word.shl(32n, Word.shl(32n, Word.shl(32n, Word.shl(32n, one(32n)))))))), Word.zero(32n)), Word.shl(32n, Word.mul.go(32n, 32n, x, Word.shl(32n, Word.shl(32n, Word.shl(32n, Word.shl(32n, Word.shl(32n, Word.shl(32n, one(32n))))))), Word.zero(32n))), mul_shl(32n, 32n, x, Word.shl(32n, Word.shl(32n, Word.shl(32n, Word.shl(32n, Word.shl(32n, Word.shl(32n, one(32n))))))))) :
        {U32{Word.shl(32n, _)} == U32.shln(U32{x}, 8n) : U32}
      %Equal.sym(Word(32n), Word.mul.go(32n, 32n, x, Word.shl(32n, Word.shl(32n, Word.shl(32n, Word.shl(32n, Word.shl(32n, Word.shl(32n, one(32n))))))), Word.zero(32n)), Word.shl(32n, Word.mul.go(32n, 32n, x, Word.shl(32n, Word.shl(32n, Word.shl(32n, Word.shl(32n, Word.shl(32n, one(32n)))))), Word.zero(32n))), mul_shl(32n, 32n, x, Word.shl(32n, Word.shl(32n, Word.shl(32n, Word.shl(32n, Word.shl(32n, one(32n)))))))) :
        {U32{Word.shl(32n, Word.shl(32n, _))} == U32.shln(U32{x}, 8n) : U32}
