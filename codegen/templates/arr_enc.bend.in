  +c0 = Nat.add(cs(j), 0n)
  +c2 = Nat.add(cs(j), 2n)
  %e2 : {AC.cpt(2n+j, _, 0n, 2n, F.TNode{z, z}, sl) == F.TNode{S, rp(j, F.flat__nthc(sl, C), F.flat__nthc(sl, 1n+C))} : F.array__Tree<U32>}
  %Equal.sym(F.array__Tree<U32>, AC.cpt(2n+j, c2, 0n, 2n, F.TNode{z, z}, sl), AC.cpt(2n+j, 2n, c0, c2, AC.cpt(2n+j, cs(j), 0n, 2n, F.TNode{z, z}, sl), sl), AC.split(2n+j, cs(j), 2n, 0n, 2n, F.TNode{z, z}, sl)) :
    {_ == F.TNode{S, rp(j, F.flat__nthc(sl, C), F.flat__nthc(sl, 1n+C))} : F.array__Tree<U32>}
  %Equal.sym(F.array__Tree<U32>, AC.cpt(2n+j, cs(j), 0n, 2n, F.TNode{z, z}, sl), F.TNode{AC.cpt(1n+j, cs(j), 0n, 2n, z, sl), z}, AC.left(1n+j, cs(j), 0n, 2n, z, z, sl, F.nat__eq_le(c2, P, e2))) :
    {AC.cpt(2n+j, 2n, c0, c2, _, sl) == F.TNode{S, rp(j, F.flat__nthc(sl, C), F.flat__nthc(sl, 1n+C))} : F.array__Tree<U32>}
  %Equal.sym(F.array__Tree<U32>, AC.cpt(1n+j, cs(j), 0n, 2n, z, sl), S, l_sp(j, 0n, sl, T)) :
    {AC.cpt(2n+j, 2n, c0, c2, F.TNode{_, z}, sl) == F.TNode{S, rp(j, F.flat__nthc(sl, C), F.flat__nthc(sl, 1n+C))} : F.array__Tree<U32>}
  %Equal.sym(F.array__Tree<U32>, AC.cpt(2n+j, 2n, c0, c2, F.TNode{S, z}, sl), F.TNode{S, AC.cpt(1n+j, 2n, c0, Nat.sub(c2, P), z, sl)}, AC.right(1n+j, 2n, c0, c2, S, z, sl, F.nat__eq_le(P, c2, Equal.sym(Nat, c2, P, e2)))) :
    {_ == F.TNode{S, rp(j, F.flat__nthc(sl, C), F.flat__nthc(sl, 1n+C))} : F.array__Tree<U32>}
  %Equal.sym(Nat, c2, P, e2) : {F.TNode{S, AC.cpt(1n+j, 2n, c0, Nat.sub(_, P), z, sl)} == F.TNode{S, rp(j, F.flat__nthc(sl, C), F.flat__nthc(sl, 1n+C))} : F.array__Tree<U32>}
  %Equal.sym(Nat, Nat.sub(P, P), 0n, F.nat__sub_self(P)) : {F.TNode{S, AC.cpt(1n+j, 2n, c0, _, z, sl)} == F.TNode{S, rp(j, F.flat__nthc(sl, C), F.flat__nthc(sl, 1n+C))} : F.array__Tree<U32>}
  %Equal.sym(F.array__Tree<U32>, AC.cpt(1n+j, 2n, c0, 0n, z, sl), rp(j, F.flat__nthc(sl, c0), F.flat__nthc(sl, 1n+c0)), l_rp(j, c0, sl)) :
    {F.TNode{S, _} == F.TNode{S, rp(j, F.flat__nthc(sl, C), F.flat__nthc(sl, 1n+C))} : F.array__Tree<U32>}
  Equal.cong(Nat, F.array__Tree<U32>, c => F.TNode{S, rp(j, F.flat__nthc(sl, c), F.flat__nthc(sl, 1n+c))}, c0, C,
    Equal.trans(Nat, c0, cs(j), C, F.nat__add_zero(cs(j)), F.nat__eq_from_is_eq(cs(j), C, hC)))

# The encoder's copy of a whole blob: 2^(1+j) words from word 0 of S to word 2 of
# a new zero array of depth 2 + j.
def enc_copy(+j: Nat, +nw: U32, +a: U32, +b: U32, +ds: Nat, +S: F.array__Tree<U32>, +T: F.array__Tree<U32>, +C: Nat,
    +h7: {U32.and(nw, 7) == 0 : U32},
    +hk: {Nat.is_eq(AC.oct(U32.to_nat(U32.shrn(nw, 3n))), F.spec_common__pow2(1n+j)) == True{} : Bool},
    +ha: {Nat.is_eq(U32.to_nat(a), 0n) == True{} : Bool}, +hb: {Nat.is_eq(U32.to_nat(b), 2n) == True{} : Bool},
    +hs: {Nat.is_lt(ds, 32n) == True{} : Bool}, +hd: {Nat.is_lt(2n+j, 32n) == True{} : Bool},
    +hA: {Nat.is_le(Nat.add(F.spec_common__pow2(1n+j), 0n), F.spec_common__pow2(ds)) == True{} : Bool},
    +hB: {Nat.is_le(Nat.add(F.spec_common__pow2(1n+j), 2n), F.spec_common__pow2(2n+j)) == True{} : Bool},
    +pS: {F.array__perfect(U32, ds, S) == True{} : Bool},
    +hC: {Nat.is_eq(cs(j), C) == True{} : Bool})
    -> {O.acopy(nw, a, b, Array.new(U32, 2n+j, 0), F.array__thaw(U32, S)) == (F.array__thaw(U32, F.TNode{sp(j, 0n, F.array__slots(U32, S), T, 0, 0), rp(j, F.flat__nthc(F.array__slots(U32, S), C), F.flat__nthc(F.array__slots(U32, S), 1n+C))}), F.array__thaw(U32, S)) : Array<U32> & Array<U32>}:
  +sl = F.array__slots(U32, S)
  +D = F.array__trep(U32, 2n+j, 0)
  %Equal.sym(Array<U32>, Array.new(U32, 2n+j, 0), F.array__thaw(U32, D), F.array__new(U32, 2n+j, 0)) :
    {O.acopy(nw, a, b, _, F.array__thaw(U32, S)) == (F.array__thaw(U32, F.TNode{sp(j, 0n, sl, T, 0, 0), rp(j, F.flat__nthc(sl, C), F.flat__nthc(sl, 1n+C))}), F.array__thaw(U32, S)) : Array<U32> & Array<U32>}
  %Equal.sym(Array<U32> & Array<U32>, O.acopy(nw, a, b, F.array__thaw(U32, D), F.array__thaw(U32, S)), (F.array__thaw(U32, AC.cpt(2n+j, F.spec_common__pow2(1n+j), 0n, 2n, D, sl)), F.array__thaw(U32, S)),
      AC.acp(nw, F.spec_common__pow2(1n+j), a, b, 0n, 2n, ds, 2n+j, S, D, h7, hk, AC.u0(a, ha), AC.u0p(b, 2n, hb), hs, hd, hA, hB, pS, F.array__trep_perfect(U32, 2n+j, 0))) :
    {_ == (F.array__thaw(U32, F.TNode{sp(j, 0n, sl, T, 0, 0), rp(j, F.flat__nthc(sl, C), F.flat__nthc(sl, 1n+C))}), F.array__thaw(U32, S)) : Array<U32> & Array<U32>}
  %Equal.sym(F.array__Tree<U32>, AC.cpt(2n+j, F.spec_common__pow2(1n+j), 0n, 2n, D, sl), F.TNode{sp(j, 0n, sl, T, 0, 0), rp(j, F.flat__nthc(sl, C), F.flat__nthc(sl, 1n+C))}, l_top(j, sl, T, C, hC)) :
    {(F.array__thaw(U32, _), F.array__thaw(U32, S)) == (F.array__thaw(U32, F.TNode{sp(j, 0n, sl, T, 0, 0), rp(j, F.flat__nthc(sl, C), F.flat__nthc(sl, 1n+C))}), F.array__thaw(U32, S)) : Array<U32> & Array<U32>}
  {==}

# The words of [a0, a1 | the first C words of xs ++ ys | the next two | R]: [a0, a1] ++ xs ++ R
# when xs has C + 2 words.
def fin(+xs: List<&2, U32>, +ys: List<&2, U32>, +R: List<&2, U32>, +C: Nat, +N: Nat, +T: F.array__Tree<U32>,
    +hl: {F.spec_common__length(U32, xs) == N : Nat}, +hc: {Nat.is_eq(Nat.add(C, 2n), N) == True{} : Bool})
    -> {F.spec_common__append(U32, nsb(0n, C, F.spec_common__append(U32, xs, ys), T), Con{F.flat__nthc(F.spec_common__append(U32, xs, ys), C), Con{F.flat__nthc(F.spec_common__append(U32, xs, ys), 1n+C), R}}) == F.spec_common__append(U32, xs, R) : List<&2, U32>}:
  +sl = F.spec_common__append(U32, xs, ys)
  +G = F.spec_common__append(U32, xs, R)
  %Equal.sym(List<&2, U32>, nsb(0n, C, sl, T), ns(C, 0n, sl), nsb_ns(0n, C, sl, T)) :
    {F.spec_common__append(U32, _, F.spec_common__append(U32, ns(2n, C, sl), R)) == G : List<&2, U32>}
  %F.list__append_assoc(U32, ns(C, 0n, sl), ns(2n, C, sl), R) :
    {_ == G : List<&2, U32>}
  %Equal.trans(List<&2, U32>, ns(Nat.add(C, 2n), 0n, sl), F.spec_common__append(U32, ns(C, 0n, sl), ns(2n, Nat.add(C, 0n), sl)), F.spec_common__append(U32, ns(C, 0n, sl), ns(2n, C, sl)),
      ns_split(C, 0n, 2n, sl), Equal.cong(Nat, List<&2, U32>, c => F.spec_common__append(U32, ns(C, 0n, sl), ns(2n, c, sl)), Nat.add(C, 0n), C, F.nat__add_zero(C))) :
    {F.spec_common__append(U32, _, R) == G : List<&2, U32>}
  %Equal.sym(Nat, Nat.add(C, 2n), N, F.nat__eq_from_is_eq(Nat.add(C, 2n), N, hc)) :
    {F.spec_common__append(U32, ns(_, 0n, sl), R) == G : List<&2, U32>}
  %hl : {F.spec_common__append(U32, ns(_, 0n, sl), R) == G : List<&2, U32>}
  %Equal.sym(List<&2, U32>, ns(F.spec_common__length(U32, xs), 0n, sl), xs, ns_pre(xs, ys)) :
    {F.spec_common__append(U32, _, R) == G : List<&2, U32>}
  {==}

law take_app0:
  for +xs: List<&2, U32>
  for +ys: List<&2, U32>
  for +m: Nat
  {AH.tk(F.spec_common__append(U32, xs, ys), Nat.add(F.spec_common__length(U32, xs), m)) == F.spec_common__append(U32, xs, AH.tk(ys, m)) : List<&2, U32>}
def take_app0(xs, ys, m):
  match xs:
    case Nil{}: {==}
    case Con{+x, +t}: F.list__cons_cong(U32, x, AH.tk(F.spec_common__append(U32, t, ys), Nat.add(F.spec_common__length(U32, t), m)), F.spec_common__append(U32, t, AH.tk(ys, m)), take_app0(t, ys, m))

def take_app(+xs: List<&2, U32>, +ys: List<&2, U32>, +n: Nat, +L: Nat, +m: Nat,
    +hL: {F.spec_common__length(U32, xs) == L : Nat}, +h: {Nat.is_eq(Nat.add(L, m), n) == True{} : Bool})
    -> {AH.tk(F.spec_common__append(U32, xs, ys), n) == F.spec_common__append(U32, xs, AH.tk(ys, m)) : List<&2, U32>}:
  %F.nat__eq_from_is_eq(Nat.add(L, m), n, h) :
    {AH.tk(F.spec_common__append(U32, xs, ys), _) == F.spec_common__append(U32, xs, AH.tk(ys, m)) : List<&2, U32>}
  %hL : {AH.tk(F.spec_common__append(U32, xs, ys), Nat.add(_, m)) == F.spec_common__append(U32, xs, AH.tk(ys, m)) : List<&2, U32>}
  take_app0(xs, ys, m)

def len_nsb(+a: Nat, +n: Nat, +sl: List<&2, U32>, +T: F.array__Tree<U32>) -> {F.spec_common__length(U32, nsb(a, n, sl, T)) == n : Nat}:
  %Equal.sym(List<&2, U32>, nsb(a, n, sl, T), ns(n, a, sl), nsb_ns(a, n, sl, T)) : {F.spec_common__length(U32, _) == n : Nat}
  len_ns(n, a, sl)

# slots_sp with the literal count C = c(j), waiting on T
def slots_spb(+j: Nat, +A: Nat, +sl: List<&2, U32>, +T: F.array__Tree<U32>, +a0: U32, +a1: U32, +C: Nat,
    +hC: {Nat.is_eq(cs(j), C) == True{} : Bool})
    -> {F.array__slots(U32, sp(j, A, sl, T, a0, a1)) == Con{a0, Con{a1, nsb(A, C, sl, T)}} : List<&2, U32>}:
  %Equal.sym(List<&2, U32>, F.array__slots(U32, sp(j, A, sl, T, a0, a1)), Con{a0, Con{a1, ns(cs(j), A, sl)}}, slots_sp(j, A, sl, T, a0, a1)) :
    {_ == Con{a0, Con{a1, nsb(A, C, sl, T)}} : List<&2, U32>}
  %Equal.sym(List<&2, U32>, nsb(A, C, sl, T), ns(C, A, sl), nsb_ns(A, C, sl, T)) :
    {Con{a0, Con{a1, ns(cs(j), A, sl)}} == Con{a0, Con{a1, _}} : List<&2, U32>}
  Equal.cong(Nat, List<&2, U32>, c => Con{a0, Con{a1, ns(c, A, sl)}}, cs(j), C, F.nat__eq_from_is_eq(cs(j), C, hC))

# Emitting the first 2^d + M words of a tree [L | R] of depth 1 + d: the words of L,
# then the first M of R (so R's words beyond them are never listed).
def emit_split(+d: Nat, +L: F.array__Tree<U32>, +R: F.array__Tree<U32>, +n: U32, +k: U32, +K: Nat, +P: Nat, +M: Nat,
    +hk: {Nat.is_eq(U32.to_nat(k), 1n+K) == True{} : Bool}, +hd: {Nat.is_lt(1n+d, 31n) == True{} : Bool},
    +hK: {Nat.is_lt(K, F.spec_common__pow2(1n+d)) == True{} : Bool}, +hn: {Nat.is_le(A.quad(1n+K), U32.to_nat(n)) == True{} : Bool},
    +hP: {Nat.is_eq(F.spec_common__pow2(d), P) == True{} : Bool}, +hM: {Nat.is_eq(Nat.add(P, M), 1n+K) == True{} : Bool},
    +pf: {F.array__perfect(U32, 1n+d, F.TNode{L, R}) == True{} : Bool})
    -> {B.emit(B.Buf{F.array__thaw(U32, F.TNode{L, R}), n}, 0, k) == (B.Buf{F.array__thaw(U32, F.TNode{L, R}), n}, SF.limbs(F.spec_common__append(U32, F.array__slots(U32, L), AH.tk(F.array__slots(U32, R), M)))) : B.Buf & +List<U32>}:
  %take_app(F.array__slots(U32, L), F.array__slots(U32, R), 1n+K, P, M, AS.len_tree(d, L, P, F.array__pf_left(U32, d, L, R, pf), hP), hM) :
    {B.emit(B.Buf{F.array__thaw(U32, F.TNode{L, R}), n}, 0, k) == (B.Buf{F.array__thaw(U32, F.TNode{L, R}), n}, SF.limbs(_)) : B.Buf & +List<U32>}
  AE.emit_take(1n+d, F.TNode{L, R}, n, k, K, hk, hd, hK, hn, pf)

# ---- a whole tree then a few words (Vector[uintN, 513]) ----

law cpt_app:
  for +xs: List<&2, U32>
  for +dd: Nat
  for +k: Nat
  for +a: Nat
  for +b: Nat
  for +D: F.array__Tree<U32>
  for +ys: List<&2, U32>
  {AC.cpt(dd, k, Nat.add(F.spec_common__length(U32, xs), a), b, D, F.spec_common__append(U32, xs, ys)) == AC.cpt(dd, k, a, b, D, ys) : F.array__Tree<U32>}
def cpt_app(xs, dd, k, a, b, D, ys):
  match xs:
    case Nil{}: {==}
    case Con{+x, +t}:
      %Equal.sym(F.array__Tree<U32>, AC.cpt(dd, k, 1n+Nat.add(F.spec_common__length(U32, t), a), b, D, Con{x, F.spec_common__append(U32, t, ys)}), AC.cpt(dd, k, Nat.add(F.spec_common__length(U32, t), a), b, D, F.spec_common__append(U32, t, ys)), AE.cpt_shift(dd, k, Nat.add(F.spec_common__length(U32, t), a), b, D, x, F.spec_common__append(U32, t, ys))) :
        {_ == AC.cpt(dd, k, a, b, D, ys) : F.array__Tree<U32>}
      cpt_app(t, dd, k, a, b, D, ys)

# Copying a perfect tree A of depth p then E more words G into zero storage of
# depth 1 + p: [A | the words G at the start of zero storage of depth p].
def cpt_tail(+p: Nat, +E: Nat, +A: F.array__Tree<U32>, +G: List<&2, U32>, +pA: {F.array__perfect(U32, p, A) == True{} : Bool})
    -> {AC.cpt(1n+p, Nat.add(F.spec_common__pow2(p), E), 0n, 0n, F.array__trep(U32, 1n+p, 0), F.spec_common__append(U32, F.array__slots(U32, A), G)) == F.TNode{A, AC.cpt(p, E, 0n, 0n, F.array__trep(U32, p, 0), G)} : F.array__Tree<U32>}:
  +P = F.spec_common__pow2(p)
  +z = F.array__trep(U32, p, 0)
  +sl = F.spec_common__append(U32, F.array__slots(U32, A), G)
  +P0 = Nat.add(P, 0n)
  %Equal.sym(F.array__Tree<U32>, AC.cpt(1n+p, Nat.add(P, E), 0n, 0n, F.TNode{z, z}, sl), AC.cpt(1n+p, E, P0, P0, AC.cpt(1n+p, P, 0n, 0n, F.TNode{z, z}, sl), sl), AC.split(1n+p, P, E, 0n, 0n, F.TNode{z, z}, sl)) :
    {_ == F.TNode{A, AC.cpt(p, E, 0n, 0n, z, G)} : F.array__Tree<U32>}
  %Equal.sym(F.array__Tree<U32>, AC.cpt(1n+p, P, 0n, 0n, F.TNode{z, z}, sl), F.TNode{AC.cpt(p, P, 0n, 0n, z, sl), z}, AC.left(p, P, 0n, 0n, z, z, sl, AC.le_p0(P))) :
    {AC.cpt(1n+p, E, P0, P0, _, sl) == F.TNode{A, AC.cpt(p, E, 0n, 0n, z, G)} : F.array__Tree<U32>}
  %Equal.sym(F.array__Tree<U32>, AC.cpt(p, P, 0n, 0n, z, sl), AC.segt(p, 0n, sl), AC.full(p, 0n, z, sl, F.array__trep_perfect(U32, p, 0))) :
    {AC.cpt(1n+p, E, P0, P0, F.TNode{_, z}, sl) == F.TNode{A, AC.cpt(p, E, 0n, 0n, z, G)} : F.array__Tree<U32>}
  %Equal.sym(F.array__Tree<U32>, AC.segt(p, 0n, sl), A, AC.seg_self(p, A, G, pA)) :
    {AC.cpt(1n+p, E, P0, P0, F.TNode{_, z}, sl) == F.TNode{A, AC.cpt(p, E, 0n, 0n, z, G)} : F.array__Tree<U32>}
  %Equal.sym(F.array__Tree<U32>, AC.cpt(1n+p, E, P0, P0, F.TNode{A, z}, sl), F.TNode{A, AC.cpt(p, E, P0, Nat.sub(P0, P), z, sl)}, AC.right(p, E, P0, P0, A, z, sl, F.nat__eq_le(P, P0, Equal.sym(Nat, P0, P, F.nat__add_zero(P))))) :
    {_ == F.TNode{A, AC.cpt(p, E, 0n, 0n, z, G)} : F.array__Tree<U32>}
  %Equal.sym(Nat, P0, P, F.nat__add_zero(P)) : {F.TNode{A, AC.cpt(p, E, P0, Nat.sub(_, P), z, sl)} == F.TNode{A, AC.cpt(p, E, 0n, 0n, z, G)} : F.array__Tree<U32>}
  %Equal.sym(Nat, Nat.sub(P, P), 0n, F.nat__sub_self(P)) : {F.TNode{A, AC.cpt(p, E, P0, _, z, sl)} == F.TNode{A, AC.cpt(p, E, 0n, 0n, z, G)} : F.array__Tree<U32>}
  %F.array__slots_length(U32, p, A, pA) :
    {F.TNode{A, AC.cpt(p, E, Nat.add(_, 0n), 0n, z, sl)} == F.TNode{A, AC.cpt(p, E, 0n, 0n, z, G)} : F.array__Tree<U32>}
  %Equal.sym(F.array__Tree<U32>, AC.cpt(p, E, Nat.add(F.spec_common__length(U32, F.array__slots(U32, A)), 0n), 0n, z, sl), AC.cpt(p, E, 0n, 0n, z, G), cpt_app(F.array__slots(U32, A), p, E, 0n, 0n, z, G)) :
    {F.TNode{A, _} == F.TNode{A, AC.cpt(p, E, 0n, 0n, z, G)} : F.array__Tree<U32>}
  {==}

# cpt_tail with the outer depth as its own parameter q == 1 + p. An instance of
# `1n+p` at a literal p is not syntactically the literal 1 + p, so a use at
# literal depths would make the checker compare the two copy models by running
# them (2^p + E updates: 137 s at p = 12); with q the instance is exact.
law cpt_tail_q:
  for +p: Nat
  for +q: Nat
  for +eq: {q == 1n+p : Nat}
  for +E: Nat
  for +A: F.array__Tree<U32>
  for +G: List<&2, U32>
  for +pA: {F.array__perfect(U32, p, A) == True{} : Bool}
  {AC.cpt(q, Nat.add(F.spec_common__pow2(p), E), 0n, 0n, F.array__trep(U32, q, 0), F.spec_common__append(U32, F.array__slots(U32, A), G)) == F.TNode{A, AC.cpt(p, E, 0n, 0n, F.array__trep(U32, p, 0), G)} : F.array__Tree<U32>}
def cpt_tail_q(p, q, eq, E, A, G, pA):
  %Equal.sym(Nat, q, 1n+p, eq) :
    {AC.cpt(_, Nat.add(F.spec_common__pow2(p), E), 0n, 0n, F.array__trep(U32, _, 0), F.spec_common__append(U32, F.array__slots(U32, A), G)) == F.TNode{A, AC.cpt(p, E, 0n, 0n, F.array__trep(U32, p, 0), G)} : F.array__Tree<U32>}
  cpt_tail(p, E, A, G, pA)

# The first n words of [X | c] are the first n of X when X has at least n.
def tk_left(+d: Nat, +X: F.array__Tree<U32>, +c: F.array__Tree<U32>, +n: Nat, +pX: {F.array__perfect(U32, d, X) == True{} : Bool},
    +h: {Nat.is_le(n, F.spec_common__pow2(d)) == True{} : Bool})
    -> {AH.tk(F.array__slots(U32, F.TNode{X, c}), n) == AH.tk(F.array__slots(U32, X), n) : List<&2, U32>}:
  F.list__sc_take_append_left(U32, F.array__slots(U32, X), F.array__slots(U32, c), n,
    F.logic__subst(Nat, z => {Nat.is_le(n, z) == True{} : Bool}, F.spec_common__pow2(d), F.spec_common__length(U32, F.array__slots(U32, X)),
      Equal.sym(Nat, F.spec_common__length(U32, F.array__slots(U32, X)), F.spec_common__pow2(d), F.array__slots_length(U32, d, X, pX)), h))

# cpt_tail with the count as a literal K (a closed 2^p + E above 2^15 must not be unfolded)
def cpt_tail_lit(+p: Nat, +E: Nat, +K: Nat, +A: F.array__Tree<U32>, +G: List<&2, U32>, +pA: {F.array__perfect(U32, p, A) == True{} : Bool},
    +hK: {Nat.is_eq(Nat.add(F.spec_common__pow2(p), E), K) == True{} : Bool})
    -> {AC.cpt(1n+p, K, 0n, 0n, F.array__trep(U32, 1n+p, 0), F.spec_common__append(U32, F.array__slots(U32, A), G)) == F.TNode{A, AC.cpt(p, E, 0n, 0n, F.array__trep(U32, p, 0), G)} : F.array__Tree<U32>}:
  %F.nat__eq_from_is_eq(Nat.add(F.spec_common__pow2(p), E), K, hK) :
    {AC.cpt(1n+p, _, 0n, 0n, F.array__trep(U32, 1n+p, 0), F.spec_common__append(U32, F.array__slots(U32, A), G)) == F.TNode{A, AC.cpt(p, E, 0n, 0n, F.array__trep(U32, p, 0), G)} : F.array__Tree<U32>}
  cpt_tail(p, E, A, G, pA)

# The loader's buffer of the bytes of a perfect tree A then words G: [A | G then zeros],
# for every depth (no closed size is unfolded).
def load_tail(+p: Nat, +E: Nat, +n: U32, +A: F.array__Tree<U32>, +G: List<&2, U32>, +pA: {F.array__perfect(U32, p, A) == True{} : Bool},
    +hc: {B.capacity(n) == 1n+p : Nat}, +hd: {Nat.is_lt(1n+p, 32n) == True{} : Bool},
    +hG: {F.spec_common__length(U32, G) == E : Nat}, +hE: {Nat.is_le(E, F.spec_common__pow2(p)) == True{} : Bool})
    -> {B.fill_at(B.alloc(n), 0, SF.limbs(F.spec_common__append(U32, F.array__slots(U32, A), G))) == B.Buf{F.array__thaw(U32, F.TNode{A, AC.cpt(p, E, 0n, 0n, F.array__trep(U32, p, 0), G)}), n} : B.Buf}:
  +W = F.spec_common__append(U32, F.array__slots(U32, A), G)
  +z = F.array__trep(U32, 1n+p, 0)
  +P = F.spec_common__pow2(p)
  +hl = Equal.trans(Nat, F.spec_common__length(U32, W), Nat.add(F.spec_common__length(U32, F.array__slots(U32, A)), F.spec_common__length(U32, G)), Nat.add(P, E),
    F.list__length_append(U32, F.array__slots(U32, A), G),
    Equal.trans(Nat, Nat.add(F.spec_common__length(U32, F.array__slots(U32, A)), F.spec_common__length(U32, G)), Nat.add(P, F.spec_common__length(U32, G)), Nat.add(P, E),
      Equal.cong(Nat, Nat, q => Nat.add(q, F.spec_common__length(U32, G)), F.spec_common__length(U32, F.array__slots(U32, A)), P, F.array__slots_length(U32, p, A, pA)),
      Equal.cong(Nat, Nat, q => Nat.add(P, q), F.spec_common__length(U32, G), E, hG)))
  +hf = F.nat__le_trans(Nat.add(Nat.add(P, E), 0n), Nat.add(P, E), F.spec_common__pow2(1n+p), AC.le_p0(Nat.add(P, E)),
    F.logic__subst(Nat, q => {Nat.is_le(Nat.add(P, E), q) == True{} : Bool}, Nat.add(P, P), F.spec_common__pow2(1n+p), Equal.sym(Nat, F.spec_common__pow2(1n+p), Nat.add(P, P), F.flat__pow2_split(p)), F.nat__le_add_left(E, P, P, hE)))
  +h = F.logic__subst(Nat, q => {Nat.is_le(Nat.add(q, 0n), F.spec_common__pow2(1n+p)) == True{} : Bool}, Nat.add(P, E), F.spec_common__length(U32, W), Equal.sym(Nat, F.spec_common__length(U32, W), Nat.add(P, E), hl), hf)
  %Equal.sym(Nat, B.capacity(n), 1n+p, hc) : {B.Buf{B.fill_go(SF.limbs(W), Array.new(U32, _, 0), U32.shrn(0, 2n)), n} == B.Buf{F.array__thaw(U32, F.TNode{A, AC.cpt(p, E, 0n, 0n, F.array__trep(U32, p, 0), G)}), n} : B.Buf}
  %Equal.sym(Array<U32>, Array.new(U32, 1n+p, 0), F.array__thaw(U32, z), F.array__new(U32, 1n+p, 0)) : {B.Buf{B.fill_go(SF.limbs(W), _, 0), n} == B.Buf{F.array__thaw(U32, F.TNode{A, AC.cpt(p, E, 0n, 0n, F.array__trep(U32, p, 0), G)}), n} : B.Buf}
  %Equal.sym(Array<U32>, B.fill_go(SF.limbs(W), F.array__thaw(U32, z), 0), F.array__thaw(U32, AC.cpt(1n+p, F.spec_common__length(U32, W), 0n, 0n, z, W)), AE.fill(W, 1n+p, z, 0, 0n, {==}, hd, h, F.array__trep_perfect(U32, 1n+p, 0))) :
    {B.Buf{_, n} == B.Buf{F.array__thaw(U32, F.TNode{A, AC.cpt(p, E, 0n, 0n, F.array__trep(U32, p, 0), G)}), n} : B.Buf}
  %Equal.sym(Nat, F.spec_common__length(U32, W), Nat.add(P, E), hl) : {B.Buf{F.array__thaw(U32, AC.cpt(1n+p, _, 0n, 0n, z, W)), n} == B.Buf{F.array__thaw(U32, F.TNode{A, AC.cpt(p, E, 0n, 0n, F.array__trep(U32, p, 0), G)}), n} : B.Buf}
  %Equal.sym(F.array__Tree<U32>, AC.cpt(1n+p, Nat.add(P, E), 0n, 0n, z, W), F.TNode{A, AC.cpt(p, E, 0n, 0n, F.array__trep(U32, p, 0), G)}, cpt_tail(p, E, A, G, pA)) :
    {B.Buf{F.array__thaw(U32, _), n} == B.Buf{F.array__thaw(U32, F.TNode{A, AC.cpt(p, E, 0n, 0n, F.array__trep(U32, p, 0), G)}), n} : B.Buf}
  {==}
