# The bytes of words [0, 1 + K) of a buffer on a perfect tree of depth d < 31
# whose end is at least 4(1 + K) bytes.
law emit_take:
  for +d: Nat
  for +T: F.array__Tree<U32>
  for +n: U32
  for +k: U32
  for +K: Nat
  for +hk: {Nat.is_eq(U32.to_nat(k), 1n+K) == True{} : Bool}
  for +hd: {Nat.is_lt(d, 31n) == True{} : Bool}
  for +hK: {Nat.is_lt(K, F.spec_common__pow2(d)) == True{} : Bool}
  for +hn: {Nat.is_le(A.quad(1n+K), U32.to_nat(n)) == True{} : Bool}
  for +pf: {F.array__perfect(U32, d, T) == True{} : Bool}
  {B.emit(B.Buf{F.array__thaw(U32, T), n}, 0, k) == (B.Buf{F.array__thaw(U32, T), n}, SF.limbs(F.spec_common__take(U32, F.array__slots(U32, T), 1n+K))) : B.Buf & +List<U32>}
def emit_take(d, T, n, k, K, hk, hd, hK, hn, pf):
  +W = F.array__slots(U32, T)
  +ek = F.nat__eq_from_is_eq(U32.to_nat(k), 1n+K, hk)
  +j = U32.sub(U32.add(0, k), 1)
  +e0 = F.logic__subst(U32, z => {U32.to_nat(z) == 1n+K : Nat}, k, U32.add(0, k), Equal.sym(U32, U32.add(0, k), k, F.u32alg__zero_add(k)), ek)
  +ej = pred1(U32.add(0, k), K, e0)
  +hj = F.logic__subst(Nat, z => {Nat.is_lt(z, F.spec_common__pow2(d)) == True{} : Bool}, K, U32.to_nat(j), Equal.sym(Nat, U32.to_nat(j), K, ej), hK)
  %Equal.sym(Nat, U32.to_nat(k), 1n+K, ek) :
    {B.emit_go(_, j, n, [], B.word(B.Buf{F.array__thaw(U32, T), n}, j)) == (B.Buf{F.array__thaw(U32, T), n}, SF.limbs(F.spec_common__take(U32, W, 1n+K))) : B.Buf & +List<U32>}
  %Equal.sym(B.Buf & U32, B.word(B.Buf{F.array__thaw(U32, T), n}, j), (B.Buf{F.array__thaw(U32, T), n}, F.flat__nthc(W, U32.to_nat(j))), BF.word_read(d, T, n, j, AC.lt31(d, hd), hj, pf)) :
    {B.emit_go(1n+K, j, n, [], _) == (B.Buf{F.array__thaw(U32, T), n}, SF.limbs(F.spec_common__take(U32, W, 1n+K))) : B.Buf & +List<U32>}
  %Equal.sym(Nat, U32.to_nat(j), K, ej) : {B.emit_go(1n+K, j, n, [], (B.Buf{F.array__thaw(U32, T), n}, F.flat__nthc(W, _))) == (B.Buf{F.array__thaw(U32, T), n}, SF.limbs(F.spec_common__take(U32, W, 1n+K))) : B.Buf & +List<U32>}
  %rl_nil(F.spec_common__take(U32, W, 1n+K)) :
    {B.emit_go(1n+K, j, n, [], (B.Buf{F.array__thaw(U32, T), n}, F.flat__nthc(W, K))) == (B.Buf{F.array__thaw(U32, T), n}, _) : B.Buf & +List<U32>}
  eg(K, j, n, [], d, T, ej, hd, hK, hn, pf)

law take_all:
  for +xs: List<&2, U32>
  for +n: Nat
  for +h: {F.spec_common__length(U32, xs) == n : Nat}
  {F.spec_common__take(U32, xs, n) == xs : List<&2, U32>}
def take_all(xs, n, h):
  match xs n:
    case Nil{} _: {==}
    case Con{x, t} 0n: Empty.absurd({F.spec_common__take(U32, Con{x, t}, 0n) == Con{x, t} : List<&2, U32>}, F.nat__succ_zero(F.spec_common__length(U32, t), h))
    case Con{+x, +t} 1n+ +m: F.list__cons_cong(U32, x, F.spec_common__take(U32, t, m), t, take_all(t, m, F.nat__succ_inj(F.spec_common__length(U32, t), m, h)))

# All 2^d words of a perfect tree.
law emit_all:
  for +d: Nat
  for +T: F.array__Tree<U32>
  for +n: U32
  for +k: U32
  for +K: Nat
  for +hk: {Nat.is_eq(U32.to_nat(k), 1n+K) == True{} : Bool}
  for +hP: {Nat.is_eq(F.spec_common__pow2(d), 1n+K) == True{} : Bool}
  for +hd: {Nat.is_lt(d, 31n) == True{} : Bool}
  for +hn: {Nat.is_le(A.quad(1n+K), U32.to_nat(n)) == True{} : Bool}
  for +pf: {F.array__perfect(U32, d, T) == True{} : Bool}
  {B.emit(B.Buf{F.array__thaw(U32, T), n}, 0, k) == (B.Buf{F.array__thaw(U32, T), n}, SF.limbs(F.array__slots(U32, T))) : B.Buf & +List<U32>}
def emit_all(d, T, n, k, K, hk, hP, hd, hn, pf):
  +eP = F.nat__eq_from_is_eq(F.spec_common__pow2(d), 1n+K, hP)
  +hK = F.logic__subst(Nat, z => {Nat.is_lt(K, z) == True{} : Bool}, 1n+K, F.spec_common__pow2(d), Equal.sym(Nat, F.spec_common__pow2(d), 1n+K, eP), F.nat__lt_succ(K))
  +el = Equal.trans(Nat, F.spec_common__length(U32, F.array__slots(U32, T)), F.spec_common__pow2(d), 1n+K, F.array__slots_length(U32, d, T, pf), eP)
  %take_all(F.array__slots(U32, T), 1n+K, el) :
    {B.emit(B.Buf{F.array__thaw(U32, T), n}, 0, k) == (B.Buf{F.array__thaw(U32, T), n}, SF.limbs(_)) : B.Buf & +List<U32>}
  emit_take(d, T, n, k, K, hk, hd, hK, hn, pf)

# ---- the loader: B.fill_at of a word list's bytes ---------------------------------------

law cpt_shift:
  for +dd: Nat
  for +k: Nat
  for +a: Nat
  for +b: Nat
  for +D: F.array__Tree<U32>
  for +x: U32
  for +sl: List<&2, U32>
  {AC.cpt(dd, k, 1n+a, b, D, Con{x, sl}) == AC.cpt(dd, k, a, b, D, sl) : F.array__Tree<U32>}
def cpt_shift(dd, k, a, b, D, x, sl):
  match k:
    case 0n: {==}
    case 1n+ +q: cpt_shift(dd, q, 1n+a, 1n+b, F.array__upd(U32, dd, D, b, F.flat__nthc(sl, a)), x, sl)

# Filling the bytes of W from word I on is the model copy of W to I.
law fill:
  for +W: List<&2, U32>
  for +dd: Nat
  for +D: F.array__Tree<U32>
  for +i: U32
  for +I: Nat
  for +ei: {U32.to_nat(i) == I : Nat}
  for +hdd: {Nat.is_lt(dd, 32n) == True{} : Bool}
  for +h: {Nat.is_le(Nat.add(F.spec_common__length(U32, W), I), F.spec_common__pow2(dd)) == True{} : Bool}
  for +pd: {F.array__perfect(U32, dd, D) == True{} : Bool}
  {B.fill_go(SF.limbs(W), F.array__thaw(U32, D), i) == F.array__thaw(U32, AC.cpt(dd, F.spec_common__length(U32, W), 0n, I, D, W)) : Array<U32>}
def fill(W, dd, D, i, I, ei, hdd, h, pd):
  match W:
    case Nil{}: {==}
    case Con{+w, +t}:
      +hI = AC.lt_off(0n, 1n+F.spec_common__length(U32, t), I, F.spec_common__pow2(dd), {==}, h)
      +h1 = F.logic__subst(Nat, z => {Nat.is_le(z, F.spec_common__pow2(dd)) == True{} : Bool}, 1n+Nat.add(F.spec_common__length(U32, t), I), Nat.add(F.spec_common__length(U32, t), 1n+I), Equal.sym(Nat, Nat.add(F.spec_common__length(U32, t), 1n+I), 1n+Nat.add(F.spec_common__length(U32, t), I), F.nat__add_succ(F.spec_common__length(U32, t), I)), h)
      +hI1 = F.nat__le_trans(1n+I, 1n+Nat.add(F.spec_common__length(U32, t), I), F.spec_common__pow2(dd), AC.le_addl(F.spec_common__length(U32, t), I), h)
      +ei1 = AC.ix(i, 1, I, dd, ei, hdd, hI1)
      +D1 = F.array__upd(U32, dd, D, I, w)
      %Equal.sym(U32, B.word_of(B.byte_sel(0, w), B.byte_sel(1, w), B.byte_sel(2, w), B.byte_sel(3, w)), w, LD.word_of_bytes(w)) :
        {B.fill_go(SF.limbs(t), Array.set(U32, F.array__thaw(U32, D), i, _), (i + 1 : U32)) == F.array__thaw(U32, AC.cpt(dd, 1n+F.spec_common__length(U32, t), 0n, I, D, Con{w, t})) : Array<U32>}
      %Equal.sym(Array<U32>, Array.set(U32, F.array__thaw(U32, D), i, w), F.array__thaw(U32, D1), AC.setv(dd, D, i, I, w, ei, hdd, hI, pd)) :
        {B.fill_go(SF.limbs(t), _, (i + 1 : U32)) == F.array__thaw(U32, AC.cpt(dd, 1n+F.spec_common__length(U32, t), 0n, I, D, Con{w, t})) : Array<U32>}
      %Equal.sym(F.array__Tree<U32>, AC.cpt(dd, F.spec_common__length(U32, t), 1n, 1n+I, D1, Con{w, t}), AC.cpt(dd, F.spec_common__length(U32, t), 0n, 1n+I, D1, t), cpt_shift(dd, F.spec_common__length(U32, t), 0n, 1n+I, D1, w, t)) :
        {B.fill_go(SF.limbs(t), F.array__thaw(U32, D1), (i + 1 : U32)) == F.array__thaw(U32, _) : Array<U32>}
      fill(t, dd, D1, (i + 1 : U32), 1n+I, ei1, hdd, h1, F.array__upd_perfect(U32, dd, D, I, w, pd))

# The loader on the bytes of all the words of a perfect tree t of depth d: the buffer is t.
law load_all:
  for +d: Nat
  for +t: F.array__Tree<U32>
  for +n: U32
  for +hd: {Nat.is_lt(d, 32n) == True{} : Bool}
  for +hc: {B.capacity(n) == d : Nat}
  for +pf: {F.array__perfect(U32, d, t) == True{} : Bool}
  {B.fill_at(B.alloc(n), 0, SF.limbs(F.array__slots(U32, t))) == B.Buf{F.array__thaw(U32, t), n} : B.Buf}
def load_all(d, t, n, hd, hc, pf):
  +W = F.array__slots(U32, t)
  +z = F.array__trep(U32, d, 0)
  +el = F.array__slots_length(U32, d, t, pf)
  +h = F.logic__subst(Nat, q => {Nat.is_le(Nat.add(q, 0n), F.spec_common__pow2(d)) == True{} : Bool}, F.spec_common__pow2(d), F.spec_common__length(U32, W), Equal.sym(Nat, F.spec_common__length(U32, W), F.spec_common__pow2(d), el), AC.le_p0(F.spec_common__pow2(d)))
  %Equal.sym(Nat, B.capacity(n), d, hc) : {B.Buf{B.fill_go(SF.limbs(W), Array.new(U32, _, 0), U32.shrn(0, 2n)), n} == B.Buf{F.array__thaw(U32, t), n} : B.Buf}
  %Equal.sym(Array<U32>, Array.new(U32, d, 0), F.array__thaw(U32, z), F.array__new(U32, d, 0)) : {B.Buf{B.fill_go(SF.limbs(W), _, 0), n} == B.Buf{F.array__thaw(U32, t), n} : B.Buf}
  %Equal.sym(Array<U32>, B.fill_go(SF.limbs(W), F.array__thaw(U32, z), 0), F.array__thaw(U32, AC.cpt(d, F.spec_common__length(U32, W), 0n, 0n, z, W)), fill(W, d, z, 0, 0n, {==}, hd, h, F.array__trep_perfect(U32, d, 0))) :
    {B.Buf{_, n} == B.Buf{F.array__thaw(U32, t), n} : B.Buf}
  %Equal.sym(Nat, F.spec_common__length(U32, W), F.spec_common__pow2(d), el) : {B.Buf{F.array__thaw(U32, AC.cpt(d, _, 0n, 0n, z, W)), n} == B.Buf{F.array__thaw(U32, t), n} : B.Buf}
  %Equal.sym(F.array__Tree<U32>, AC.cpt(d, F.spec_common__pow2(d), 0n, 0n, z, W), AC.segt(d, 0n, W), AC.full(d, 0n, z, W, F.array__trep_perfect(U32, d, 0))) :
    {B.Buf{F.array__thaw(U32, _), n} == B.Buf{F.array__thaw(U32, t), n} : B.Buf}
  %F.list__append_nil(U32, W) : {B.Buf{F.array__thaw(U32, AC.segt(d, 0n, _)), n} == B.Buf{F.array__thaw(U32, t), n} : B.Buf}
  %Equal.sym(F.array__Tree<U32>, AC.segt(d, 0n, F.spec_common__append(U32, W, Nil{})), t, AC.seg_self(d, t, Nil{}, pf)) :
    {B.Buf{F.array__thaw(U32, _), n} == B.Buf{F.array__thaw(U32, t), n} : B.Buf}
  {==}
