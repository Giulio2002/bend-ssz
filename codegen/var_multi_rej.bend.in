
def leU(+a: U32, +b: U32, +x: Nat, +y: Nat, +ha: {U32.to_nat(a) == x : Nat}, +hb: {U32.to_nat(b) == y : Nat}, +h: {Nat.is_le(x, y) == True{} : Bool})
    -> {U32.is_le(a, b) == True{} : Bool}:
  VMR.u32le(a, b, FD.logic__subst(Nat, z => {Nat.is_le(z, U32.to_nat(b)) == True{} : Bool}, x, U32.to_nat(a), Equal.sym(Nat, U32.to_nat(a), x, ha),
    FD.logic__subst(Nat, z => {Nat.is_le(x, z) == True{} : Bool}, y, U32.to_nat(b), Equal.sym(Nat, U32.to_nat(b), y, hb), h)))

def eF(+x0: +List<U32>, +xh: +List<U32>, +xp: +List<U32>, +l0: {List.length(&2, U32, x0) == 8n : Nat},
    +lh: {List.length(&2, U32, xh) == 208n : Nat}, +lp: {List.length(&2, U32, xp) == 128n : Nat})
    -> {VMR.FR(x0, [xh, xp]) == 356n : Nat}:
  %Equal.sym(Nat, List.length(&2, U32, x0), 8n, l0) : {Nat.add(_, 12n+VR.lens([xh, xp])) == 356n : Nat}
  %Equal.sym(Nat, List.length(&2, U32, xh), 208n, lh) : {Nat.add(8n, 12n+Nat.add(_, Nat.add(List.length(&2, U32, xp), 0n))) == 356n : Nat}
  %Equal.sym(Nat, List.length(&2, U32, xp), 128n, lp) : {Nat.add(8n, 12n+Nat.add(208n, Nat.add(_, 0n))) == 356n : Nat}
  {==}

def enN(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool},
    +hn: {Nat.is_le(U32.to_nat(n), A.quad(VB.pw(d))) == True{} : Bool},
    +x0: +List<U32>, +y0: +List<U32>, +y1: +List<U32>, +y2: +List<U32>, +xh: +List<U32>, +xp: +List<U32>,
    +ef: {VMR.FR(x0, [xh, xp]) == 356n : Nat}, +eo: {VMR.OUTN(x0, y0, y1, y2, [xh, xp]) == DC.VW(t, n) : +List<U32>})
    -> {U32.to_nat(n) == Nat.add(356n, Nat.add(List.length(&2, U32, y0), Nat.add(List.length(&2, U32, y1), List.length(&2, U32, y2)))) : Nat}:
  +RHS = Nat.add(356n, Nat.add(List.length(&2, U32, y0), Nat.add(List.length(&2, U32, y1), List.length(&2, U32, y2))))
  %VMR.lenVW(d, t, n, pf, hn) : {_ == RHS : Nat}
  %eo : {List.length(&2, U32, _) == RHS : Nat}
  %Equal.sym(Nat, List.length(&2, U32, VMR.OUTN(x0, y0, y1, y2, [xh, xp])), Nat.add(VMR.FR(x0, [xh, xp]), Nat.add(List.length(&2, U32, y0), Nat.add(List.length(&2, U32, y1), List.length(&2, U32, y2)))),
      VMR.r_len(x0, y0, y1, y2, [xh, xp])) : {_ == RHS : Nat}
  %Equal.sym(Nat, VMR.FR(x0, [xh, xp]), 356n, ef) : {Nat.add(_, Nat.add(List.length(&2, U32, y0), Nat.add(List.length(&2, U32, y1), List.length(&2, U32, y2)))) == RHS : Nat}
  {==}

def ow0(+t: FD.array__Tree<U32>, +n: U32, +x0: +List<U32>, +y0: +List<U32>, +y1: +List<U32>, +y2: +List<U32>, +xh: +List<U32>, +xp: +List<U32>,
    +l0: {List.length(&2, U32, x0) == 8n : Nat}, +ef: {VMR.FR(x0, [xh, xp]) == 356n : Nat}, +eo: {VMR.OUTN(x0, y0, y1, y2, [xh, xp]) == DC.VW(t, n) : +List<U32>})
    -> {VS.bt(4n, VS.bdr(A.quad(2n), DC.VW(t, n))) == F.limbs([356]) : +List<U32>}:
  %eo : {VS.bt(4n, VS.bdr(A.quad(2n), _)) == F.limbs([356]) : +List<U32>}
  %Equal.sym(+List<U32>, VS.bt(4n, VS.bdr(8n, VMR.OUTN(x0, y0, y1, y2, [xh, xp]))), N.digits(4n, VMR.FR(x0, [xh, xp])), VMR.r_b0(x0, y0, y1, y2, [xh, xp], l0)) :
    {_ == F.limbs([356]) : +List<U32>}
  %Equal.sym(Nat, VMR.FR(x0, [xh, xp]), 356n, ef) : {N.digits(4n, _) == F.limbs([356]) : +List<U32>}
  {==}

def ow1(+t: FD.array__Tree<U32>, +n: U32, +x0: +List<U32>, +y0: +List<U32>, +y1: +List<U32>, +y2: +List<U32>, +xh: +List<U32>, +xp: +List<U32>,
    +l0: {List.length(&2, U32, x0) == 8n : Nat}, +ef: {VMR.FR(x0, [xh, xp]) == 356n : Nat}, +eo: {VMR.OUTN(x0, y0, y1, y2, [xh, xp]) == DC.VW(t, n) : +List<U32>})
    -> {VS.bt(4n, VS.bdr(A.quad(3n), DC.VW(t, n))) == N.digits(4n, Nat.add(356n, List.length(&2, U32, y0))) : +List<U32>}:
  %eo : {VS.bt(4n, VS.bdr(A.quad(3n), _)) == N.digits(4n, Nat.add(356n, List.length(&2, U32, y0))) : +List<U32>}
  %Equal.sym(+List<U32>, VS.bt(4n, VS.bdr(12n, VMR.OUTN(x0, y0, y1, y2, [xh, xp]))), N.digits(4n, Nat.add(VMR.FR(x0, [xh, xp]), List.length(&2, U32, y0))), VMR.r_b1(x0, y0, y1, y2, [xh, xp], l0)) :
    {_ == N.digits(4n, Nat.add(356n, List.length(&2, U32, y0))) : +List<U32>}
  %Equal.sym(Nat, VMR.FR(x0, [xh, xp]), 356n, ef) : {N.digits(4n, Nat.add(_, List.length(&2, U32, y0))) == N.digits(4n, Nat.add(356n, List.length(&2, U32, y0))) : +List<U32>}
  {==}

def ow2(+t: FD.array__Tree<U32>, +n: U32, +x0: +List<U32>, +y0: +List<U32>, +y1: +List<U32>, +y2: +List<U32>, +xh: +List<U32>, +xp: +List<U32>,
    +l0: {List.length(&2, U32, x0) == 8n : Nat}, +ef: {VMR.FR(x0, [xh, xp]) == 356n : Nat}, +eo: {VMR.OUTN(x0, y0, y1, y2, [xh, xp]) == DC.VW(t, n) : +List<U32>})
    -> {VS.bt(4n, VS.bdr(A.quad(4n), DC.VW(t, n))) == N.digits(4n, Nat.add(Nat.add(356n, List.length(&2, U32, y0)), List.length(&2, U32, y1))) : +List<U32>}:
  %eo : {VS.bt(4n, VS.bdr(A.quad(4n), _)) == N.digits(4n, Nat.add(Nat.add(356n, List.length(&2, U32, y0)), List.length(&2, U32, y1))) : +List<U32>}
  %Equal.sym(+List<U32>, VS.bt(4n, VS.bdr(16n, VMR.OUTN(x0, y0, y1, y2, [xh, xp]))), N.digits(4n, Nat.add(Nat.add(VMR.FR(x0, [xh, xp]), List.length(&2, U32, y0)), List.length(&2, U32, y1))), VMR.r_b2(x0, y0, y1, y2, [xh, xp], l0)) :
    {_ == N.digits(4n, Nat.add(Nat.add(356n, List.length(&2, U32, y0)), List.length(&2, U32, y1))) : +List<U32>}
  %Equal.sym(Nat, VMR.FR(x0, [xh, xp]), 356n, ef) : {N.digits(4n, Nat.add(Nat.add(_, List.length(&2, U32, y0)), List.length(&2, U32, y1))) == N.digits(4n, Nat.add(Nat.add(356n, List.length(&2, U32, y0)), List.length(&2, U32, y1))) : +List<U32>}
  {==}

# The shape of the bytes makes every check pass.
def contra(+d: Nat, +t: FD.array__Tree<U32>, +n: U32, +pf: {FD.array__perfect(U32, d, t) == True{} : Bool}, +hd: {Nat.is_lt(d, 31n) == True{} : Bool},
    +hn: {Nat.is_le(U32.to_nat(n), A.quad(VB.pw(d))) == True{} : Bool}, +hchk: {DC.CHK(t, n) == False{} : Bool},
    +x0: +List<U32>, +l0: {List.length(&2, U32, x0) == 8n : Nat},
    +y0: +List<U32>, f0: VMR.LF(y0, 2048n, U32.to_nat(4096)), +y1: +List<U32>, f1: VMR.LF(y1, 48n, U32.to_nat(4096)), +y2: +List<U32>, f2: VMR.LF(y2, 48n, U32.to_nat(4096)),
    +xh: +List<U32>, +lh: {List.length(&2, U32, xh) == 208n : Nat}, +xp: +List<U32>, +lp: {List.length(&2, U32, xp) == 128n : Nat},
    +eo0: {VMR.OUTR(x0, y0, y1, y2, [xh, xp]) == DC.VW(t, n) : +List<U32>}) -> Empty:
  (+k0, +pr0) = f0
  (+hl0, +hk0) = pr0
  (+k1, +pr1) = f1
  (+hl1, +hk1) = pr1
  (+k2, +pr2) = f2
  (+hl2, +hk2) = pr2
  +z0 = List.length(&2, U32, y0)
  +z1 = List.length(&2, U32, y1)
  +z2 = List.length(&2, U32, y2)
  +eo = Equal.trans(+List<U32>, VMR.OUTN(x0, y0, y1, y2, [xh, xp]), VMR.OUTR(x0, y0, y1, y2, [xh, xp]), DC.VW(t, n), Equal.sym(+List<U32>, VMR.OUTR(x0, y0, y1, y2, [xh, xp]), VMR.OUTN(x0, y0, y1, y2, [xh, xp]), VMR.out_n(x0, y0, y1, y2, [xh, xp])), eo0)
  +ef = eF(x0, xh, xp, l0, lh, lp)
  +en = enN(d, t, n, pf, hn, x0, y0, y1, y2, xh, xp, ef, eo)
  +A1 = Nat.add(356n, z0)
  +A2 = Nat.add(Nat.add(356n, z0), z1)
  +A3 = Nat.add(Nat.add(Nat.add(356n, z0), z1), z2)
  +en3 = Equal.trans(Nat, U32.to_nat(n), Nat.add(356n, Nat.add(z0, Nat.add(z1, z2))), A3, en,
    Equal.trans(Nat, Nat.add(356n, Nat.add(z0, Nat.add(z1, z2))), Nat.add(Nat.add(356n, z0), Nat.add(z1, z2)), A3,
      Equal.sym(Nat, Nat.add(Nat.add(356n, z0), Nat.add(z1, z2)), Nat.add(356n, Nat.add(z0, Nat.add(z1, z2))), FD.nat__add_assoc(356n, z0, Nat.add(z1, z2))),
      Equal.sym(Nat, A3, Nat.add(Nat.add(356n, z0), Nat.add(z1, z2)), FD.nat__add_assoc(Nat.add(356n, z0), z1, z2))))
  +l12 = FD.nat__le_trans(A1, A2, A3, Order.below_sum(A1, z1), Order.below_sum(A2, z2))
  +lA1 = FD.logic__subst(Nat, z => {Nat.is_le(A1, z) == True{} : Bool}, A3, U32.to_nat(n), Equal.sym(Nat, U32.to_nat(n), A3, en3), l12)
  +lA2 = FD.logic__subst(Nat, z => {Nat.is_le(A2, z) == True{} : Bool}, A3, U32.to_nat(n), Equal.sym(Nat, U32.to_nat(n), A3, en3), Order.below_sum(A2, z2))
  +N356 = FD.nat__le_trans(356n, A1, U32.to_nat(n), Order.below_sum(356n, z0), lA1)
  # word 2 is 356
  +b2 = VN.byteK2(d, t, n, 2n, pf, hn, FD.nat__le_trans(Nat.add(A.quad(2n), 4n), 356n, U32.to_nat(n), {==}, N356))
  +e0 = VN.wordc(DC.O0(t), 356, Equal.trans(+List<U32>, F.limbs([DC.O0(t)]), VS.bt(4n, VS.bdr(A.quad(2n), DC.VW(t, n))), F.limbs([356]),
    Equal.sym(+List<U32>, VS.bt(4n, VS.bdr(A.quad(2n), DC.VW(t, n))), F.limbs([DC.O0(t)]), b2), ow0(t, n, x0, y0, y1, y2, xh, xp, l0, ef, eo)))
  +e0n = Equal.cong(U32, Nat, z => U32.to_nat(z), DC.O0(t), 356, e0)
  # word 3 is 356 + |y0|, word 4 is 356 + |y0| + |y1|
  +b3 = VN.byteK2(d, t, n, 3n, pf, hn, FD.nat__le_trans(Nat.add(A.quad(3n), 4n), 356n, U32.to_nat(n), {==}, N356))
  +e1 = VG.digits_word(DC.O1(t), A1, VMR.fitsnA(n, A1, lA1),
    Equal.trans(+List<U32>, F.limbs([DC.O1(t)]), VS.bt(4n, VS.bdr(A.quad(3n), DC.VW(t, n))), N.digits(4n, A1),
      Equal.sym(+List<U32>, VS.bt(4n, VS.bdr(A.quad(3n), DC.VW(t, n))), F.limbs([DC.O1(t)]), b3), ow1(t, n, x0, y0, y1, y2, xh, xp, l0, ef, eo)))
  +b4 = VN.byteK2(d, t, n, 4n, pf, hn, FD.nat__le_trans(Nat.add(A.quad(4n), 4n), 356n, U32.to_nat(n), {==}, N356))
  +e2 = VG.digits_word(DC.O2(t), A2, VMR.fitsnA(n, A2, lA2),
    Equal.trans(+List<U32>, F.limbs([DC.O2(t)]), VS.bt(4n, VS.bdr(A.quad(4n), DC.VW(t, n))), N.digits(4n, A2),
      Equal.sym(+List<U32>, VS.bt(4n, VS.bdr(A.quad(4n), DC.VW(t, n))), F.limbs([DC.O2(t)]), b4), ow2(t, n, x0, y0, y1, y2, xh, xp, l0, ef, eo)))
  # the lists' lengths
  +eL0 = Equal.trans(Nat, U32.to_nat(DC.L0(t)), z0, Nat.mul(k0, 2048n), VMR.subL(DC.O1(t), DC.O0(t), 356n, z0, e0n, e1), hl0)
  +eL1 = Equal.trans(Nat, U32.to_nat(DC.L1(t)), z1, Nat.mul(k1, 48n), VMR.subL(DC.O2(t), DC.O1(t), A1, z1, e1, e2), hl1)
  +eL2 = Equal.trans(Nat, U32.to_nat(DC.L2(t, n)), z2, Nat.mul(k2, 48n), VMR.subL(n, DC.O2(t), A2, z2, e2, en3), hl2)
  +hA = VMR.u32le(356, n, N356)
  +hB = FD.u32alg__eq_true(DC.O0(t), 356, e0)
  +hC = FD.logic__and_intro(U32.is_le(DC.O0(t), DC.O1(t)), U32.is_le(DC.O1(t), n),
    leU(DC.O0(t), DC.O1(t), 356n, A1, e0n, e1, Order.below_sum(356n, z0)), leU(DC.O1(t), n, A1, A3, e1, en3, l12))
  +hD = FD.logic__and_intro(U32.is_le(DC.O1(t), DC.O2(t)), U32.is_le(DC.O2(t), n),
    leU(DC.O1(t), DC.O2(t), A1, A2, e1, e2, Order.below_sum(A1, z1)), leU(DC.O2(t), n, A2, A3, e2, en3, Order.below_sum(A2, z2)))
  +hE = VU.whole_i(DC.L0(t), 2048, 4096, DC.v2048(), {==}, {==}, {==}, k0, eL0, hk0)
  +hF = VU.whole_i(DC.L1(t), 48, 4096, DC.v48(), {==}, {==}, {==}, k1, eL1, hk1)
  +hG = VU.whole_i(DC.L2(t, n), 48, 4096, DC.v48(), {==}, {==}, {==}, k2, eL2, hk2)
  +chk = FD.logic__and_intro(DC.CA(n), DC.K1(t, n), hA, FD.logic__and_intro(DC.CB(t), DC.K2(t, n), hB, FD.logic__and_intro(DC.CC(t, n), DC.K3(t, n), hC,
    FD.logic__and_intro(DC.CD(t, n), DC.K4(t, n), hD, FD.logic__and_intro(DC.CE(t), DC.K5(t, n), hE, FD.logic__and_intro(DC.CF(t), DC.CG(t, n), hF, hG))))))
  FD.logic__true_false(Equal.trans(Bool, True{}, DC.CHK(t, n), False{}, Equal.sym(Bool, DC.CHK(t, n), True{}, chk), hchk))
